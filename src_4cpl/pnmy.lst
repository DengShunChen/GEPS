 External subroutine subprogram "pnmy"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine pnmy (jtrun,sinlj,pnm)
               2                     !
               3                     !  generate legendre polynomials and their derivatives on the
               4                     !  gaussian latitudes
               5                     !
               6                     ! ***input***
               7                     !
               8                     !  jtrun: zonal wavenumber truncation limit
               9                     !  sinlj: sin of gaussian latitudes
              10                     !
              11                     !  ***output***
              12                     !
              13                     ! ******************************************************************
              14                     !
              15                     !
              16                           use const, only: RTYPE
              17                     !
              18                           implicit  none
              19                     !
              20                           integer   jtrun
              21                           real(kind=RTYPE) sinlj
              22                           real(kind=RTYPE) pnm(jtrun+1,jtrun+1)
              23                     !
              24                     ! sinlj is sin(latitude) = cos(colatitude)
              25                     ! pnm(np,mp) is legendre polynomial p(n,m) with np=n+1, mp=m+1
              26                     ! pnm(mp,np+1) is x derivative of p(n,m) with np=n+1, mp=m+1
              27                     !
              28                           real      xx,sn,sn2i,rt2,c1,theta,fn,fn2,fn2s,c3,ang
              29                           real      s1,s2,c4,c5,c6,c7,c8,a,b,c,d,e,fk
              30                           real      fm,fm1,fm2,fm3
              31                           integer   jtrunp,n,np,kp,k,mp,m,nps
              32                     
              33                           jtrunp= jtrun+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
              34        pp   4v            pnm=0.0
              35                     !
              36                           xx= sinlj
              37                           sn= sqrt(1.0-xx*xx)
              38                           sn2i = 1.0/(1.0 - xx*xx)
              39                           rt2= sqrt(2.0)
              40                           c1 = rt2
              41                     !
              42                           pnm(1,1) = 1.0/rt2
              43                           theta=-atan(xx/sqrt(1.0-xx*xx))+2.0*atan(1.0)
              44                     !
              45     1                     do 20 n=1,jtrun
              46     1               	np = n + 1
              47     1                       fn=n
              48     1               	fn2 = fn + fn
              49     1               	fn2s = fn2*fn2
              50     1               ! eq 22
              51     1                       c1= c1*sqrt(1.0-1.0/fn2s)
              52     1                       c3= c1/sqrt(fn*(fn+1.0))
              53     1               	ang = fn*theta
              54     1               	s1 = 0.0
              55     1               	s2 = 0.0
              56     1               	c4 = 1.0
              57     1               	c5 = fn
              58     1               	a = -1.0
              59     1               	b = 0.0
              60     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              61     2   s    s            do 27 kp=1,np,2
              62     2   p    v      	k = kp - 1
              63     2   m    m              s2= s2+c5*sin(ang)*c4
              64     2   p    v              if (k.eq.n) c4 = 0.5*c4
              65     2   m    m              s1= s1+c4*cos(ang)
              66     2   s    s      	a = a + 2.0
              67     2   s    s      	b = b + 1.0
              68     2   p    v              fk=k
              69     2   m    m      	ang = theta*(fn - fk - 2.0)
              70     2   s    s      	c4 = (a*(fn - b + 1.0)/(b*(fn2 - a)))*c4
              71     2   s    s      	c5 = c5 - 2.0
              72     2   p    v         27 continue
              73     1               ! eq 19
              74     1               	pnm(np,1) = s1*c1
              75     1               ! eq 21
              76     1               	pnm(np,2) = s2*c3
              77     1                  20 continue
              78                     !
              79     1                     do 4 mp=3,jtrunp
              80     1               	m = mp - 1
              81     1                       fm= m
              82     1               	fm1 = fm - 1.0
              83     1               	fm2 = fm - 2.0
              84     1               	fm3 = fm - 3.0
              85     1                       c6= sqrt(1.0+1.0/(fm+fm))
              86     1               ! eq 23
              87     1               	pnm(mp,mp) = c6*sn*pnm(m,m)
              88     1                       if (mp - jtrunp) 3,4,4
              89     1                   3 continue
              90     1               	nps = mp + 1
              91     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
              92     2   s    s            do 41 np=nps,jtrunp
              93     2   p    v      	n = np - 1
              94     2   p    v              fn= n
              95     2   p    v      	fn2 = fn + fn
              96     2   p    v      	c7 = (fn2 + 1.0)/(fn2 - 1.0)
              97     2   p    v      	c8 = (fm1 + fn)/((fm + fn)*(fm2 + fn))
              98     2   p    v              c= sqrt((fn2+1.0)*c8*(fm3+fn)/(fn2-3.0))
              99     2   p    v              d= -sqrt(c7*c8*(fn-fm1))
             100     2   p    v              e= sqrt(c7*(fn-fm)/(fn+fm))
             101     2               ! eq 17
             102     2   m    m      	pnm(np,mp) = c*pnm(np-2,mp-2) + xx*(d*pnm(np-1,mp-2) + e*pnm(np - 1,mp))
             103     2   p    v         41 continue
             104     1                   4 continue
             105                     !
             106                           return
             107                           end


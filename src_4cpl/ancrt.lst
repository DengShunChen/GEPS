 External subroutine subprogram "ancrt"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine ancrt (m,pl,ancrit)
               2                     !
               3                     !  ancrt computes the climotological work function as a function of
               4                     !  pressure by linear interpolation between values defined at
               5                     !  predefined pressures.
               6                     !
               7                     !  formal parameters:
               8                     !
               9                     !  ancrit:  output work functions values at pressures pl
              10                     !
              11                     !  pl:  input pressures
              12                     !
              13                     !  m: no. of points
              14                     !
              15                           implicit none
              16                     
              17                           integer m,i,ipx
              18                           real    ancrit(m),pl(m),acrit(11),tem,ptem,pxmax
              19                     
              20                           data ptem/0.01/, pxmax/10.999999/
              21                     !
              22                           data acrit/2.0,1.8983,1.2425,.5162,.3252,.1915,.0924,.0577, &
              23                             .0350,.0220,.0150/
              24                     !
              25                     !  interpolate reference cloud work function to pressure levels
              26                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.66, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pl, ancrit
                                   <<< Loop-information  End >>>
              27     1  pp   2v            do 110 i=1,m
              28     1   p   2v            ancrit(i)= min(pxmax,1.0+ptem*pl(i))
              29     1   p   2v            ipx= int(ancrit(i))
              30     1   p   2v            tem= ancrit(i)-float(ipx)
              31     1   p   2v            ancrit(i)= acrit(ipx)+tem*(acrit(ipx+1)-acrit(ipx))
              32     1   p   2v        110 continue
              33                     !
              34                           return
              35                           end


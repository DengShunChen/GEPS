 External subroutine subprogram "landsmc"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine landsmc(nxj,mn,km,rhscnpy,rhsmc,ai,bi,ci,smc,land      &
               2                                             ,canopy,precip,runof,snowmt                     &
               3                                             ,zsoil,istyp,sigmaf,dt,dth,tsat)
               4                     !
               5                     !##################################################################
               6                     !                     subroutine description
               7                     !
               8                     ! 1. function description
               9                     !
              10                     !  nmcsfc_gwt is the second part of the soil model that is executed
              11                     !  after precipitation for the time step has been calculated.
              12                     !  In this subroutine canopy and soil moisture(smc) will be updated.
              13                     !
              14                     ! 2. parameter specification
              15                     !
              16                     !     mn : dimension of horizontal-direction
              17                     !     km : dimension of soil layer
              18                     !     dt : time step for ut, vt, tt, qt updates                  (s)
              19                     !    dth : time step for snr updates                             (s)
              20                     !   smc : volumetric soil moisture content (mn,km)
              21                     ! canopy : canopy moisture content (mn)                          (mm)
              22                     !rhscnpy : right hand side terms for  canopy prediction (mn)     (mm/s)
              23                     ! rhsmc  : right hand side terms for soil moisture prediction (mn,km)(/s)
              24                     ! ai     : first column of tri-diagnal matrix for solving smc (mn,km)
              25                     ! bi     : second column of tri-diagonal matrix for solving smc (mn,km)
              26                     ! ci     : third column of tri-diagonal matrix for solving smc (mn,km)
              27                     ! land   : logical array for land (mn)                    (true = land  )
              28                     ! drain  : drainage from bottom soil layer  (mn)                 (mm/s)
              29                     ! snowmt : snow meltin rate (mn)                                 (mm/s)
              30                     ! precip : total precipitation in each call(dth) (mn)            (mm)
              31                     ! runof  : run off rate from soil layers (mn)                    (mm/s)
              32                     ! canopy : canopy moisture content (mn)                          (mm)
              33                     ! sigmaf : vegetation fraction (mn)
              34                     ! istyp  : soil type(1-9) (mn)
              35                     ! zsoil  : soil layer depth(mn,km)                                (m)
              36                     ! tsat   : satuation point of 9 soil types (9)
              37                     !
              38                     ! 3. local variables
              39                     !
              40                     !  prcp  : precipitation rate  (mn)                           (mm/s)
              41                     !  inf   : infiltration rate   (mn)                           (mm/s)
              42                     ! infmax : maxmun infiltration rate (mn)                      (mm/s)
              43                     
              44                     ! 5. calling modules
              45                     !
              46                     !   pbltke
              47                     !
              48                     ! 6. usage
              49                     !
              50                     !     call landsmc(mn,km,rhscnpy,rhsmc,ai,bi,ci,smc,land,
              51                     !    &       canopy,precip,runof,snowmt,
              52                     !    &       zsoil,istyp,sigmaf,dt,dth)
              53                     ! 7. modules called
              54                     !
              55                     !
              56                     ! 8. limitation
              57                     !
              58                     ! 9. date
              59                     !
              60                     !     from ncep 2002
              61                     !     modified  2004
              62                     !
              63                     ! 10. author
              64                     !
              65                     ! 11. reference
              66                     !
              67                     !    Mahrt, L., and H. -L. Pan,1984: Atwo-layer model of soil hydrology.
              68                     !          Boundary Layer Meteorol., 29, 1-20.
              69                     !    Pan, H.-L., and L.Mahrt, 1987: Interaction between soil hydrology
              70                     !          and boundary-layer development. Boundary Layer Meteorol.,
              71                     !          38,185-202.
              72                     !#####################################################################
              73                     !
              74                           implicit   none
              75                     
              76                           real, parameter :: scanop=.5,rhoh2o=1000.
              77                           real, parameter :: ctfil1=.5,ctfil2=1.-ctfil1
              78                           real, parameter :: rffact=1.
              79                     
              80                     ! input & output variable
              81                           integer   nxj,mn,km
              82                           real      dt,dth
              83                     
              84                           real      rhscnpy(mn),rhsmc(mn,km)
              85                           real      ai(mn,km),bi(mn,km),ci(mn,km)
              86                           real      smc(mn,km),canopy(mn),precip(mn)
              87                           real      sigmaf(mn),runof(mn)
              88                           real      zsoil(mn,km),snowmt(mn)
              89                           integer   istyp(mn)
              90                           logical   flag(mn),land(mn)
              91                     !
              92                           real      prcp(mn),inf(mn),infmax(mn)
              93                           real      sat(mn),dsat(mn),ksat(mn)
              94                           real      smsoil(mn,km),cnpy(mn),dx(mn),conkdt(mn)
              95                     ! landpack
              96                           integer,  parameter :: ntype=9
              97                           real      tsat(ntype)
              98                     !
              99                           integer   i,k
             100                           real      delt2,delt,drip,cc,tdif
             101                     
             102                           delt2 = dt
             103                           delt  = dth
             104                     !
             105                     !  precipitation rate is needed in unit of kg m-2 s-1
             106                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 112
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 107,117,171)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      land, flag, istyp, canopy, sat, smc
                                   <<<      rhsmc, zsoil, infmax, cnpy, precip
                                   <<<      snowmt, sigmaf, rhscnpy, prcp, inf
                                   <<<    PREFETCH(SOFT) : 2
                                   <<<     SEQUENTIAL : 2
                                   <<<      runof: 2
                                   <<< Loop-information  End >>>
             107     1  pp    v            do i = 1, nxj
             108     1   p    v              prcp(i) = rhoh2o*( precip(i)/delt + snowmt(i) )/1000.
             109     1   p    v              runof(i) = 0.
             110     1   p    v              cnpy(i) = canopy(i)
             111     1   p    v            enddo
             112                     !
             113                     !  update canopy water content
             114                     !        ( updated by delt ,final blending is not necessary)
             115                     !
             116                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             117     1                     do i = 1, nxj
             118     2                       if(land(i)) then
             119     2                         rhscnpy(i) = rhscnpy(i) + sigmaf(i) * prcp(i)
             120     2                         canopy(i) = canopy(i) + delt * rhscnpy(i)
             121     2                         canopy(i) = max(canopy(i),0.)
             122     2                         prcp(i) = prcp(i) * (1. - sigmaf(i))
             123     3                         if(canopy(i).gt.scanop) then
             124     3                           drip = canopy(i) - scanop
             125     3                           canopy(i) = scanop
             126     3                           prcp(i) = prcp(i) + drip / delt
             127     3                         endif
             128     2               !
             129     2               !  calculate infiltration rate
             130     2               !
             131     2                         inf(i) = prcp(i)
             132     2                         sat(i) = tsat(istyp(i))
             133     2               !         dsat(i) = funcdf(tsat(i),soiltyp(i))
             134     2               !         ksat(i) = funckt(tsat(i),soiltyp(i))
             135     2               !         infmax(i) = -dsat(i) * (tsat(i) - smc(i,1))
             136     2               !    &                / (.5 * zsoil(i,1))
             137     2               !    &                + ksat(i)
             138     2                         infmax(i) = (-zsoil(i,1)) *                                 &
             139     2                                     ((sat(i) - smc(i,1)) / delt - rhsmc(i,1))       &
             140     2                                     * rhoh2o
             141     2                         infmax(i) = max(rffact*infmax(i),0.)
             142     2               !         if(smc(i,1).ge.tsat(i)) infmax(i) = ksat(i)
             143     2               !         if(smc(i,1).ge.tsat(i)) infmax(i) = zsoil(i,1) * rhsmc(i,1)
             144     2               !
             145     2               ! new(SWB model)-----------------------------------------------
             146     2               !         dx(i)=0.
             147     2               !         dx(i)=(-zsoil(i,1))*(sat(i)-smc(i,1))
             148     2               !         do k=2,km
             149     2               !         dx(i)=dx(i)+(zsoil(i,k-1)-zsoil(i,k))*(sat(i)-smc(i,k))
             150     2               !         enddo
             151     2               !
             152     2               ! conkdt=dt(in day)*Kdt_ref*Ks/K_ref
             153     2               !c                  Kdt_ref=3.   K_ref=2.0e-6
             154     2               !          conkdt(i)=delt/86400.*3.*ksat(i)/2.*1.0e+6
             155     2               !          xx2=exp(-conkdt(i))
             156     2               !          print*,'conkdt,xx=',conkdt(i),xx2
             157     2               !          infmax(i)=inf(i)*dx(i)*( 1.-xx2 )/
             158     2               !    +                     (inf(i)+dx(i)*(1.-xx2))
             159     2               !---------------------------------------------------------------
             160     3                         if(inf(i).gt.infmax(i)) then
             161     3                           runof(i) = inf(i) - infmax(i)
             162     3                           inf(i) = infmax(i)
             163     3                         endif
             164     2                         inf(i) = inf(i) / rhoh2o
             165     2                         rhsmc(i,1) = rhsmc(i,1) - inf(i) / zsoil(i,1)
             166     2                       endif
             167     1                     enddo
             168                     !
             169                     !  we currently ignore the effect of rain on sea ice
             170                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             171     1                     do i = 1, nxj
             172     1                       flag(i) = land(i)
             173     1                     enddo
             174                     !
             175                     !  solve the tri-diagonal matrix
             176                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, rhsmc, ai, bi, ci
                                   <<< Loop-information  End >>>
             177     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhsmc, ci, ai, flag, bi
                                   <<< Loop-information  End >>>
             178     2   p    v              do i = 1, nxj
             179     3   p    v                if(flag(i))  then
             180     3   p    v                  rhsmc(i,k) = rhsmc(i,k) * delt2
             181     3   p    v                  ai(i,k) = ai(i,k) * delt2
             182     3   p    v                  bi(i,k) = 1. + bi(i,k) * delt2
             183     3   p    v                  ci(i,k) = ci(i,k) * delt2
             184     3   p    v                endif
             185     2   p    v              enddo
             186     1   p                 enddo
             187                     !  forward elimination
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, ci, bi, rhsmc
                                   <<< Loop-information  End >>>
             188     1  pp    v            do i = 1, nxj
             189     2   p    v              if(flag(i)) then
             190     2   p    v                ci(i,1) = -ci(i,1) / bi(i,1)
             191     2   p    v                rhsmc(i,1) = rhsmc(i,1) / bi(i,1)
             192     2   p    v              endif
             193     1   p    v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, ai, ci, bi, rhsmc
                                   <<< Loop-information  End >>>
             194     1                     do k = 2, km
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.58, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ai, ci, bi, rhsmc, flag
                                   <<< Loop-information  End >>>
             195     2  pp    v              do i = 1, nxj
             196     3   p    v                if(flag(i)) then
             197     3   p    v                  cc = 1. / (bi(i,k) + ai(i,k) * ci(i,k-1))
             198     3   p    v                  ci(i,k) = -ci(i,k) * cc
             199     3   p    v                  rhsmc(i,k) = (rhsmc(i,k) - ai(i,k) * rhsmc(i,k-1)) * cc
             200     3   p    v                endif
             201     2   p    v              enddo
             202     1                     enddo
             203                     !  backward substituttion
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhsmc, flag, ci
                                   <<< Loop-information  End >>>
             204     1  pp   2v            do i = 1, nxj
             205     2   p   2v              if(flag(i)) then
             206     2   p   2v                ci(i,km) = rhsmc(i,km)
             207     2   p   2v              endif
             208     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, ci, rhsmc
                                   <<< Loop-information  End >>>
             209     1                     do k = km-1, 1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.75, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ci, rhsmc, flag
                                   <<< Loop-information  End >>>
             210     2  pp   2v              do i = 1, nxj
             211     3   p   2v                if(flag(i)) then
             212     3   p   2v                  ci(i,k) = ci(i,k) * ci(i,k+1) + rhsmc(i,k)
             213     3   p   2v                endif
             214     2   p   2v              enddo
             215     1                     enddo
             216                      100  continue
             217                     !
             218                     !  update soil moisture
             219                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, zsoil, ci, smc, sat, runof, smsoil
                                   <<< Loop-information  End >>>
             220     1                     do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 272
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sat, zsoil, runof, flag, ci, smc, smsoil
                                   <<< Loop-information  End >>>
             221     2  pp    v              do i = 1, nxj
             222     3   p    v                if(flag(i)) then
             223     3   p    v                  smsoil(i,k) = smc(i,k) + ci(i,k)
             224     3   p    v                  smsoil(i,k) = max(smsoil(i,k),0.)
             225     3   p    v                  tdif = max(smsoil(i,k) - sat(i),0.)
             226     3   p    v                  runof(i) = runof(i) -                           &
             227     3                                     rhoh2o * tdif * zsoil(i,k) / delt
             228     3   p    v                  smsoil(i,k) = smsoil(i,k) - tdif
             229     3   p    v                endif
             230     2   p    v              enddo
             231     1                     enddo
             232                     !
             233                     ! first update smc by delt2
             234                     ! then blend smsoil and smc to get (t+delt) smc
             235                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, smsoil, smc
                                   <<< Loop-information  End >>>
             236     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.53, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag, smsoil, smc
                                   <<< Loop-information  End >>>
             237     2   p   2v              do i = 1, nxj
             238     3   p   2v                if(flag(i)) then
             239     3   p   2v                  smc(i,k) = ctfil1 * smsoil(i,k) + ctfil2 * smc(i,k)
             240     3   p   2v                endif
             241     2   p   2v              enddo
             242     1   p                 enddo
             243                     !
             244                     !     do i = 1, nxj
             245                     !       if(flag(i)) then
             246                     !         canopy(i) = ctfil1 * canopy(i) + ctfil2 * cnpy(i)
             247                     !       endif
             248                     !     enddo
             249                     !     i = 1

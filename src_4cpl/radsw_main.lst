            2634     1               
            2635     1               !! --- ...  uv-b surface downward flux
            2636     1                       suvbfc = suvbf0
            2637     1                     else                        ! cloudy column, compute total-sky fluxes
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fxdn0, fxdnc, fxupc, fxup0
                                   <<< Loop-information  End >>>
            2638     2  pp                   do ib = 1, nbdsw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 104, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fxupc, fxdnc, fxdn0, fxup0
                                   <<< Loop-information  End >>>
            2639     3   p    v                do k = 1, nlp1
            2640     3   p    v                  fxupc(k,ib) = cf1*fxupc(k,ib) + cf0*fxup0(k,ib)
            2641     3   p    v                  fxdnc(k,ib) = cf1*fxdnc(k,ib) + cf0*fxdn0(k,ib)
            2642     3   p    v                enddo
            2643     2   p                   enddo
            2644     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2645     2   s    v              do ib = 1, nbdsw
            2646     2   p    v                ftoauc = ftoauc + fxupc(nlp1,ib)
            2647     2   p    v                fsfcuc = fsfcuc + fxupc(1,ib)
            2648     2   p    v                fsfcdc = fsfcdc + fxdnc(1,ib)
            2649     2   p    v              enddo
            2650     1               
            2651     1               !! --- ...  uv-b surface downward flux
            2652     1                       suvbfc = fxdnc(1,ibd)
            2653     1               
            2654     1               !! --- ...  surface downward beam/diffused flux components
            2655     1                       sfbmc(1) = cf1*sfbmc(1) + cf0*sfbm0(1)
            2656     1                       sfbmc(2) = cf1*sfbmc(2) + cf0*sfbm0(2)
            2657     1                       sfdfc(1) = cf1*sfdfc(1) + cf0*sfdf0(1)
            2658     1                       sfdfc(2) = cf1*sfdfc(2) + cf0*sfdf0(2)
            2659     1                     endif    ! end if_cf1_block
            2660                     
            2661                           return
            2662                     !...................................
            2663                           end subroutine spcvrtc
            2664                     !-----------------------------------
            2665                     
            2666                     
            2667                     !-----------------------------------
            2668                           subroutine spcvrtm                                                &
            2669                     !...................................
            2670                     !  ---  inputs:
            2671                          &     ( ssolar,cosz,sntz,albbm,albdf,sfluxzen,cldfmc,              &
            2672                          &       cf1,cf0,taug,taur,tauae,ssaae,asyae,taucw,ssacw,asycw,     &
            2673                          &       nlay, nlp1,                                                &
            2674                     !  ---  outputs:
            2675                          &       fxupc,fxdnc,fxup0,fxdn0,                                   &
            2676                          &       ftoauc,ftoau0,ftoadc,fsfcuc,fsfcu0,fsfcdc,fsfcd0,          &
            2677                          &       sfbmc,sfdfc,sfbm0,sfdf0,suvbfc,suvbf0                      &
            2678                          &     )
            2679                     
            2680                     !  ===================  program usage description  ===================  !
            2681                     !                                                                       !
            2682                     !   purpose:  computes the shortwave radiative fluxes using two-stream  !
            2683                     !             method of h. barker and mcica, the monte-carlo independent!
            2684                     !             column approximation, for the representation of sub-grid  !
            2685                     !             cloud variability (i.e. cloud overlap).                   !
            2686                     !                                                                       !
            2687                     !   subprograms called:  swflux                                         !
            2688                     !                                                                       !
            2689                     !  ====================  defination of variables  ====================  !
            2690                     !                                                                       !
            2691                     !  inputs:                                                        size  !
            2692                     !    ssolar  - real, incoming solar flux at top                    1    !
            2693                     !    cosz    - real, cosine solar zenith angle                     1    !
            2694                     !    sntz    - real, secant solar zenith angle                     1    !
            2695                     !    albbm   - real, surface albedo for direct beam radiation      2    !
            2696                     !    albdf   - real, surface albedo for diffused radiation         2    !
            2697                     !    sfluxzen- real, spectral distribution of incoming solar flux ngptsw!
            2698                     !    cldfmc  - real, layer cloud fraction for g-point        nlay*ngptsw!
            2699                     !    cf1     - real, >0: cloudy sky, otherwise: clear sky          1    !
            2700                     !    cf0     - real, =1-cf1                                        1    !
            2701                     !    taug    - real, spectral optical depth for gases        nlay*ngptsw!
            2702                     !    taur    - real, optical depth for rayleigh scattering   nlay*ngptsw!
            2703                     !    tauae   - real, aerosols optical depth                  nlay*nbdsw !
            2704                     !    ssaae   - real, aerosols single scattering albedo       nlay*nbdsw !
            2705                     !    asyae   - real, aerosols asymmetry factor               nlay*nbdsw !
            2706                     !    taucw   - real, weighted cloud optical depth            nlay*nbdsw !
            2707                     !    ssacw   - real, weighted cloud single scat albedo       nlay*nbdsw !
            2708                     !    asycw   - real, weighted cloud asymmetry factor         nlay*nbdsw !
            2709                     !    nlay,nlp1 - integer,  number of layers/levels                 1    !
            2710                     !                                                                       !
            2711                     !  output variables:                                                    !
            2712                     !    fxupc   - real, tot sky upward flux                     nlp1*nbdsw !
            2713                     !    fxdnc   - real, tot sky downward flux                   nlp1*nbdsw !
            2714                     !    fxup0   - real, clr sky upward flux                     nlp1*nbdsw !
            2715                     !    fxdn0   - real, clr sky downward flux                   nlp1*nbdsw !
            2716                     !    ftoauc  - real, tot sky toa upwd flux                         1    !
            2717                     !    ftoau0  - real, clr sky toa upwd flux                         1    !
            2718                     !    ftoadc  - real, toa downward (incoming) solar flux            1    !
            2719                     !    fsfcuc  - real, tot sky sfc upwd flux                         1    !
            2720                     !    fsfcu0  - real, clr sky sfc upwd flux                         1    !
            2721                     !    fsfcdc  - real, tot sky sfc dnwd flux                         1    !
            2722                     !    fsfcd0  - real, clr sky sfc dnwd flux                         1    !
            2723                     !    sfbmc   - real, tot sky sfc dnwd beam flux (nir/uv+vis)       2    !
            2724                     !    sfdfc   - real, tot sky sfc dnwd diff flux (nir/uv+vis)       2    !
            2725                     !    sfbm0   - real, clr sky sfc dnwd beam flux (nir/uv+vis)       2    !
            2726                     !    sfdf0   - real, clr sky sfc dnwd diff flux (nir/uv+vis)       2    !
            2727                     !    suvbfc  - real, tot sky sfc dnwd uv-b flux                    1    !
            2728                     !    suvbf0  - real, clr sky sfc dnwd uv-b flux                    1    !
            2729                     !                                                                       !
            2730                     !  internal variables:                                                  !
            2731                     !    zrefb   - real, direct beam reflectivity for clear/cloudy    nlp1  !
            2732                     !    zrefd   - real, diffuse reflectivity for clear/cloudy        nlp1  !
            2733                     !    ztrab   - real, direct beam transmissivity for clear/cloudy  nlp1  !
            2734                     !    ztrad   - real, diffuse transmissivity for clear/cloudy      nlp1  !
            2735                     !    zldbt   - real, layer beam transmittance for clear/cloudy    nlp1  !
            2736                     !    ztdbt   - real, lev total beam transmittance for clr/cld     nlp1  !
            2737                     !                                                                       !
            2738                     !  control parameters in module "physpara"                              !
            2739                     !    iswmode - control flag for 2-stream transfer schemes               !
            2740                     !              = 1 delta-eddington    (joseph et al., 1976)             !
            2741                     !              = 2 pifm               (zdunkowski et al., 1980)         !
            2742                     !              = 3 discrete ordinates (liou, 1973)                      !
            2743                     !                                                                       !
            2744                     !  *******************************************************************  !
            2745                     !  original code description                                            !
            2746                     !                                                                       !
            2747                     !  method:                                                              !
            2748                     !  -------                                                              !
            2749                     !     standard delta-eddington, p.i.f.m., or d.o.m. layer calculations. !
            2750                     !     kmodts  = 1 eddington (joseph et al., 1976)                       !
            2751                     !             = 2 pifm (zdunkowski et al., 1980)                        !
            2752                     !             = 3 discrete ordinates (liou, 1973)                       !
            2753                     !                                                                       !
            2754                     !  modifications:                                                       !
            2755                     !  --------------                                                       !
            2756                     !   original: h. barker                                                 !
            2757                     !   revision: merge with rrtmg_sw: j.-j.morcrette, ecmwf, feb 2003      !
            2758                     !   revision: add adjustment for earth/sun distance:mjiacono,aer,oct2003!
            2759                     !   revision: bug fix for use of palbp and palbd: mjiacono, aer, nov2003!
            2760                     !   revision: bug fix to apply delta scaling to clear sky: aer, dec2004 !
            2761                     !   revision: code modified so that delta scaling is not done in cloudy !
            2762                     !             profiles if routine cldprop is used; delta scaling can be !
            2763                     !             applied by swithcing code below if cldprop is not used to !
            2764                     !             get cloud properties. aer, jan 2005                       !
            2765                     !   revision: uniform formatting for rrtmg: mjiacono, aer, jul 2006     !
            2766                     !   revision: use exponential lookup table for transmittance: mjiacono, !
            2767                     !             aer, aug 2007                                             !
            2768                     !                                                                       !
            2769                     !  *******************************************************************  !
            2770                     !  ======================  end of description block  =================  !
            2771                     
            2772                     !  ---  constant parameters:
            2773                           real (kind=kind_phys), parameter :: zcrit = 0.9999995 ! thresold for conservative scattering
            2774                           real (kind=kind_phys), parameter :: zsr3  = sqrt(3.0)
            2775                           real (kind=kind_phys), parameter :: od_lo = 0.06
            2776                           real (kind=kind_phys), parameter :: eps1  = 1.0e-8
            2777                     
            2778                     !  ---  inputs:
            2779                           integer, intent(in) :: nlay, nlp1
            2780                     
            2781                           real (kind=kind_phys), dimension(nlay,ngptsw), intent(in) ::      &
            2782                          &       taug, taur, cldfmc
            2783                           real (kind=kind_phys), dimension(nlay,nbdsw),  intent(in) ::      &
            2784                          &       taucw, ssacw, asycw, tauae, ssaae, asyae
            2785                     
            2786                           real (kind=kind_phys), dimension(ngptsw), intent(in) :: sfluxzen
            2787                     
            2788                           real (kind=kind_phys), dimension(2),  intent(in) :: albbm, albdf
            2789                     
            2790                           real (kind=kind_phys), intent(in) :: cosz, sntz, cf1, cf0, ssolar
            2791                     
            2792                     !  ---  outputs:
            2793                           real (kind=kind_phys), dimension(nlp1,nbdsw), intent(out) ::      &
            2794                          &       fxupc, fxdnc, fxup0, fxdn0
            2795                     
            2796                           real (kind=kind_phys), dimension(2), intent(out) :: sfbmc, sfdfc, &
            2797                          &       sfbm0, sfdf0
            2798                     
            2799                           real (kind=kind_phys), intent(out) :: suvbfc, suvbf0, ftoadc,     &
            2800                          &       ftoauc, ftoau0, fsfcuc, fsfcu0, fsfcdc, fsfcd0
            2801                     
            2802                     !  ---  locals:
            2803                           real (kind=kind_phys), dimension(nlay) :: ztaus, zssas, zasys,    &
            2804                          &       zldbt0
            2805                     
            2806                           real (kind=kind_phys), dimension(nlp1) :: zrefb, zrefd, ztrab,    &
            2807                          &       ztrad, ztdbt, zldbt, zfu, zfd
            2808                     
            2809                           real (kind=kind_phys) :: ztau1, zssa1, zasy1, ztau0, zssa0,       &
            2810                          &       zasy0, zasy3, zssaw, zasyw, zgam1, zgam2, zgam3, zgam4,    &
            2811                          &       za1, za2, zb1, zb2, zrk, zrk2, zrp, zrp1, zrm1, zrpp,      &
            2812                          &       zrkg1, zrkg3, zrkg4, zexp1, zexm1, zexp2, zexm2, zden1,    &
            2813                          &       zexp3, zexp4, ze1r45, ftind, zsolar, ztdbt0, zr1, zr2,     &
            2814                          &       zr3, zr4, zr5, zt1, zt2, zt3, zf1, zf2
            2815                     
            2816                           integer :: ib, ibd, jb, jg, k, kp, itind
            2817                     !
            2818                     !===> ...  begin here
            2819                     !
            2820                     !  --- ... initialization of output fluxes
            2821                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fxup0, fxdn0, fxupc, fxdnc
                                   <<< Loop-information  End >>>
            2822     1  pp   2v            do ib = 1, nbdsw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2823     2   p   2               do k = 1, nlp1
            2824     2   p   2v                fxdnc(k,ib) = f_zero
            2825     2   p   2v                fxupc(k,ib) = f_zero
            2826     2   p   2v                fxdn0(k,ib) = f_zero
            2827     2   p   2v                fxup0(k,ib) = f_zero
            2828     2   p   2v              enddo
            2829     1   p                 enddo
            2830                     
            2831                           ftoadc = f_zero
            2832                           ftoauc = f_zero
            2833                           ftoau0 = f_zero
            2834                           fsfcuc = f_zero
            2835                           fsfcu0 = f_zero
            2836                           fsfcdc = f_zero
            2837                           fsfcd0 = f_zero
            2838                     
            2839                     !! --- ...  uv-b surface downward fluxes
            2840                           suvbfc  = f_zero
            2841                           suvbf0  = f_zero
            2842                     
            2843                     !! --- ...  output surface flux components
            2844                           sfbmc(1) = f_zero
            2845                           sfbmc(2) = f_zero
            2846                           sfdfc(1) = f_zero
            2847                           sfdfc(2) = f_zero
            2848                           sfbm0(1) = f_zero
            2849                           sfbm0(2) = f_zero
            2850                           sfdf0(1) = f_zero
            2851                           sfdf0(2) = f_zero
            2852                     
            2853                     !  --- ...  loop over all g-points in each band
            2854                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zfd, fxdn0, fxup0, zfu, fxdnc, fxupc
                                   <<< Loop-information  End >>>
            2855     1                     lab_do_jg : do jg = 1, ngptsw
            2856     1               
            2857     1                       jb = ngb(jg)
            2858     1                       ib = jb + 1 - nblow
            2859     1                       ibd = idxsfc(jb)         ! spectral band index
            2860     1               
            2861     1                       zsolar = ssolar * sfluxzen(jg)
            2862     1               
            2863     1               !  --- ...  set up toa direct beam and surface values (beam and diff)
            2864     1               
            2865     1                       ztdbt(nlp1) = f_one
            2866     1                       ztdbt0   = f_one
            2867     1               
            2868     1                       zldbt(1) = f_zero
            2869     2                       if (ibd /= 0) then
            2870     2                         zrefb(1) = albbm(ibd)
            2871     2                         zrefd(1) = albdf(ibd)
            2872     2                       else
            2873     2                         zrefb(1) = 0.5 * (albbm(1) + albbm(2))
            2874     2                         zrefd(1) = 0.5 * (albdf(1) + albdf(2))
            2875     2                       endif
            2876     1                       ztrab(1) = f_zero
            2877     1                       ztrad(1) = f_zero
            2878     1               
            2879     1               !  --- ...  compute clear-sky optical parameters, layer reflectance and transmittance
            2880     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taur, tauae, taug, ssaae, asyae, ztaus
                                   <<<      zssas, zasys, zrefd, ztrad, ztdbt, zldbt
                                   <<<      zldbt0
                                   <<< Loop-information  End >>>
            2881     2   s    s              do k = nlay, 1, -1
            2882     2   p    v                kp = k + 1
            2883     2               
            2884     2   p    v                ztau0 = max( ftiny, taur(k,jg)+taug(k,jg)+tauae(k,ib) )
            2885     2   p    v                zssa0 = taur(k,jg) + tauae(k,ib)*ssaae(k,ib)
            2886     2   p    v                zasy0 = asyae(k,ib)*ssaae(k,ib)*tauae(k,ib)
            2887     2   p    v                zssaw = min( oneminus, zssa0 / ztau0 )
            2888     2   p    v                zasyw = zasy0 / max( ftiny, zssa0 )
            2889     2               
            2890     2               !  --- ...  saving clear-sky quantities for later total-sky usage
            2891     2   p    v                ztaus(k) = ztau0
            2892     2   p    v                zssas(k) = zssa0
            2893     2   p    v                zasys(k) = zasy0
            2894     2               
            2895     2               !  --- ...  delta scaling for clear-sky condition
            2896     2   p    v                za1 = zasyw * zasyw
            2897     2   p    v                za2 = zssaw * za1
            2898     2               
            2899     2   p    v                ztau1 = (f_one - za2) * ztau0
            2900     2   p    v                zssa1 = (zssaw - za2) / (f_one - za2)
            2901     2               !org      zasy1 = (zasyw - za1) / (f_one - za1)   ! this line is replaced by the next
            2902     2   p    v                zasy1 = zasyw / (f_one + zasyw)         ! to reduce truncation error
            2903     2   p    v                zasy3 = 0.75 * zasy1
            2904     2               
            2905     2               !  --- ...  general two-stream expressions
            2906     3   p    v                if ( iswmode == 1 ) then
            2907     3                           zgam1 = 1.75 - zssa1 * (f_one + zasy3)
            2908     3                           zgam2 =-0.25 + zssa1 * (f_one - zasy3)
            2909     3                           zgam3 = 0.5  - zasy3 * cosz
            2910     3   p    v                elseif ( iswmode == 2 ) then               ! pifm
            2911     3   p    v                  zgam1 = 2.0 - zssa1 * (1.25 + zasy3)
            2912     3   p    v                  zgam2 = 0.75* zssa1 * (f_one- zasy1)
            2913     3   p    v                  zgam3 = 0.5 - zasy3 * cosz
            2914     3                         elseif ( iswmode == 3 ) then               ! discrete ordinates
            2915     3                           zgam1 = zsr3 * (2.0 - zssa1 * (1.0 + zasy1)) * 0.5
            2916     3                           zgam2 = zsr3 * zssa1 * (1.0 - zasy1) * 0.5
            2917     3                           zgam3 = (1.0 - zsr3 * zasy1 * cosz) * 0.5
            2918     3   p    v                endif
            2919     2   p    v                zgam4 = f_one - zgam3
            2920     2               
            2921     2               !  --- ...  compute homogeneous reflectance and transmittance
            2922     2               
            2923     3   p    s                if ( zssaw >= zcrit ) then    ! for conservative scattering
            2924     3   p    s                  za1 = zgam1 * cosz - zgam3
            2925     3   p    s                  za2 = zgam1 * ztau1
            2926     3               
            2927     3               !  --- ...  use exponential lookup table for transmittance, or expansion
            2928     3               !           of exponential for low optical depth
            2929     3               
            2930     3   p    s                  zb1 = min ( ztau1*sntz , 500.0 )
            2931     4   p    s                  if ( zb1 <= od_lo ) then
            2932     4   p    s                    zb2 = f_one - zb1 + 0.5*zb1*zb1
            2933     4   p    s                  else
            2934     4   p    s                    ftind = zb1 / (bpade + zb1)
            2935     4   p    s                    itind = ftind*ntbmx + 0.5
            2936     4   p    s                    zb2 = exp_tbl(itind)
            2937     4   p    s                  endif
            2938     3               
            2939     3               !      ...  collimated beam
            2940     3   p    s                  zrefb(kp) = max(f_zero, min(f_one,                          &
            2941     3                    &                  (za2 - za1*(f_one - zb2))/(f_one + za2) ))
            2942     3   p    s                  ztrab(kp) = max(f_zero, min(f_one, f_one-zrefb(kp) ))
            2943     3               
            2944     3               !      ...  isotropic incidence
            2945     3   p    s                  zrefd(kp) = max(f_zero, min(f_one, za2/(f_one + za2) ))
            2946     3   p    m                  ztrad(kp) = max(f_zero, min(f_one, f_one-zrefd(kp) ))
            2947     3               
            2948     3   p    s                else                          ! for non-conservative scattering
            2949     3   p    s                  za1 = zgam1*zgam4 + zgam2*zgam3
            2950     3   p    s                  za2 = zgam1*zgam3 + zgam2*zgam4
            2951     3   p    s                  zrk = sqrt ( (zgam1 - zgam2) * (zgam1 + zgam2) )
            2952     3   p    s                  zrk2= 2.0 * zrk
            2953     3               
            2954     3   p    s                  zrp  = zrk * cosz
            2955     3   p    s                  zrp1 = f_one + zrp
            2956     3   p    s                  zrm1 = f_one - zrp
            2957     3   p    s                  zrpp = f_one - zrp*zrp
            2958     3   p    s                  zrkg1= zrk + zgam1
            2959     3   p    s                  zrkg3= zrk * zgam3
            2960     3   p    s                  zrkg4= zrk * zgam4
            2961     3               
            2962     3   p    s                  zr1  = zrm1 * (za2 + zrkg3)
            2963     3   p    s                  zr2  = zrp1 * (za2 - zrkg3)
            2964     3   p    s                  zr3  = zrk2 * (zgam3 - za2*cosz)
            2965     3   p    s                  zr4  = zrpp * zrkg1
            2966     3   p    s                  zr5  = zrpp * (zrk - zgam1)
            2967     3               
            2968     3   p    s                  zt1  = zrp1 * (za1 + zrkg4)
            2969     3   p    s                  zt2  = zrm1 * (za1 - zrkg4)
            2970     3   p    s                  zt3  = zrk2 * (zgam4 + za1*cosz)
            2971     3               
            2972     3               !  --- ...  use exponential lookup table for transmittance, or expansion
            2973     3               !           of exponential for low optical depth
            2974     3               
            2975     3   p    s                  zb1 = min ( zrk*ztau1, 500.0 )
            2976     4   p    s                  if ( zb1 <= od_lo ) then
            2977     4   p    m                    zexm1 = f_one - zb1 + 0.5*zb1*zb1
            2978     4   p    s                  else
            2979     4   p    s                    ftind = zb1 / (bpade + zb1)
            2980     4   p    s                    itind = ftind*ntbmx + 0.5

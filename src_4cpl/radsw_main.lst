            4741     1   p    v            do k = 1, laytrop
            4742     1   p    v              speccomb = colamt(k,3) + strrat(28)*colamt(k,6)
            4743     1   p    v              specmult = 8.0 * min(oneminus, colamt(k,3) / speccomb)

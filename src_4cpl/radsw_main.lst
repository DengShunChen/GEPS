             257                     
             258                     !========================================!
             259                           module module_radsw_main           !
             260                     !........................................!
             261                     !
             262                           use physpara,         only : iswrate, iswrgas, iswcliq, iswcice,  &
             263                          &                             isubcsw, icldflg, iovrsw,  ivflip,   &
             264                          &                             iswmode, kind_phys
             265                           use physcons,         only : con_g, con_cp, con_avgd, con_amd,    &
             266                          &                             con_amw, con_amo3
             267                     
             268                           use module_radsw_parameters
             269                           use mersenne_twister, only : random_setseed, random_number,       &
             270                          &                             random_stat
             271                           use module_radsw_ref, only : preflog, tref
             272                           use module_radsw_sflux
             273                     !
             274                           implicit none
             275                     !
             276                           private
             277                     !
             278                     !  ---  version tag and last revision date
             279                           character(40), parameter ::                                       &
             280                          &   vtagsw='ncep sw v5.1  nov 2012 -rrtmg-sw v3.8   '
             281                     !    &   vtagsw='ncep sw v5.0  aug 2012 -rrtmg-sw v3.8   '
             282                     !    &   vtagsw='rrtmg-sw v3.8   nov 2009'
             283                     !    &   vtagsw='rrtmg-sw v3.7   nov 2009'
             284                     !    &   vtagsw='rrtmg-sw v3.61  oct 2008'
             285                     !    &   vtagsw='rrtmg-sw v3.5   oct 2008'
             286                     !    &   vtagsw='rrtm-sw 112v2.3 apr 2007'
             287                     !    &   vtagsw='rrtm-sw 112v2.3 mar 2005'
             288                     !    &   vtagsw='rrtm-sw 112v2.0 jul 2004'
             289                     
             290                     !  ---  constant values
             291                           real (kind=kind_phys), parameter :: eps     = 1.0e-6
             292                           real (kind=kind_phys), parameter :: oneminus= 1.0 - eps
             293                           real (kind=kind_phys), parameter :: bpade   = 1.0/0.278  ! pade approx constant
             294                           real (kind=kind_phys), parameter :: stpfac  = 296.0/1013.0
             295                           real (kind=kind_phys), parameter :: ftiny   = 1.0e-12
             296                           real (kind=kind_phys), parameter :: s0      = 1368.22    ! internal solar const
             297                                                                                    ! adj through input
             298                           real (kind=kind_phys), parameter :: f_zero  = 0.0
             299                           real (kind=kind_phys), parameter :: f_one   = 1.0
             300                     
             301                     !  ---  atomic weights for conversion from mass to volume mixing ratios
             302                           real (kind=kind_phys), parameter :: amdw    = con_amd/con_amw
             303                           real (kind=kind_phys), parameter :: amdo3   = con_amd/con_amo3
             304                     
             305                     !  ---  band indices
             306                           integer, dimension(nblow:nbhgh) :: nspa, nspb, idxebc, idxsfc
             307                     
             308                           data nspa(:) /  9, 9, 9, 9, 1, 9, 9, 1, 9, 1, 0, 1, 9, 1 /
             309                           data nspb(:) /  1, 5, 1, 1, 1, 5, 1, 0, 1, 0, 0, 1, 5, 1 /
             310                     
             311                     !     data idxsfc(:) / 1, 1, 1, 1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 1 /  ! band index for sfc flux
             312                           data idxsfc(:) / 1, 1, 1, 1, 1, 1, 1, 1, 0, 2, 2, 2, 2, 1 /  ! band index for sfc flux
             313                           data idxebc(:) / 5, 5, 4, 4, 3, 3, 2, 2, 1, 1, 1, 1, 1, 5 /  ! band index for cld prop
             314                     
             315                     !  ---  band wavenumber intervals
             316                     !     real (kind=kind_phys), dimension(nblow:nbhgh):: wavenum1,wavenum2
             317                     !     data wavenum1(:)  /                                               &
             318                     !    &         2600.0, 3250.0, 4000.0, 4650.0, 5150.0, 6150.0, 7700.0,  &
             319                     !    &         8050.0,12850.0,16000.0,22650.0,29000.0,38000.0,  820.0 /
             320                     !     data wavenum2(:)  /                                               &
             321                     !              3250.0, 4000.0, 4650.0, 5150.0, 6150.0, 7700.0, 8050.0,  &
             322                     !    &        12850.0,16000.0,22650.0,29000.0,38000.0,50000.0, 2600.0 /
             323                     !     real (kind=kind_phys), dimension(nblow:nbhgh) :: delwave
             324                     !     data delwave(:)   /                                               &
             325                     !    &          650.0,  750.0,  650.0,  500.0, 1000.0, 1550.0,  350.0,  &
             326                     !    &         4800.0, 3150.0, 6650.0, 6350.0, 9000.0,12000.0, 1780.0 /
             327                     
             328                           integer, parameter :: nuvb = 27            !uv-b band index
             329                     
             330                     !! ---  logical flags for optional output fields
             331                     
             332                           logical :: lhswb  = .false.
             333                           logical :: lhsw0  = .false.
             334                           logical :: lflxprf= .false.
             335                           logical :: lfdncmp= .false.
             336                     
             337                     !  ---  those data will be set up only once by "rswinit"
             338                     
             339                           real (kind=kind_phys) :: exp_tbl(0:ntbmx)
             340                     
             341                     !  ...  heatfac is the factor for heating rates
             342                     !       (in k/day, or k/sec set by subroutine 'rswinit')
             343                     
             344                           real (kind=kind_phys) :: heatfac
             345                     
             346                     !  ---  the following variables are used for sub-column cloud scheme
             347                     
             348                           integer, parameter :: ipsdsw0 = 1          ! initial permutation seed
             349                     
             350                     !  ---  public accessable subprograms
             351                     
             352                           public swrad, rswinit
             353                     
             354                     
             355                     ! =================
             356                           contains
             357                     ! =================
             358                     
             359                     
             360                     !-----------------------------------
             361                           subroutine swrad                                                  &
             362                     !...................................
             363                     
             364                     !  ---  inputs:
             365                          &     ( plyr,plvl,tlyr,tlvl,qlyr,olyr,gasvmr,                      &
             366                          &       clouds,icseed,aerosols,sfcalb,                             &
             367                          &       cosz,solcon,nday,idxday,                                   &
             368                          &       npts, nlay, nlp1, lprnt, myrank,                           &
             369                     !  ---  outputs:
             370                          &       hswc,topflx,sfcflx                                         &
             371                     !! ---  optional:
             372                          &,      hsw0,hswb,flxprf,fdncmp                                    &
             373                          &     )
             374                     
             375                     !  ====================  defination of variables  ====================  !
             376                     !                                                                       !
             377                     !  input variables:                                                     !
             378                     !   plyr (npts,nlay) : model layer mean pressure in mb                  !
             379                     !   plvl (npts,nlp1) : model level pressure in mb                       !
             380                     !   tlyr (npts,nlay) : model layer mean temperature in k                !
             381                     !   tlvl (npts,nlp1) : model level temperature in k    (not in use)     !
             382                     !   qlyr (npts,nlay) : layer specific humidity in gm/gm   *see inside   !
             383                     !   olyr (npts,nlay) : layer ozone concentration in gm/gm               !
             384                     !   gasvmr(npts,nlay,:): atmospheric constent gases:                    !
             385                     !                      (check module_radiation_gases for definition)    !
             386                     !      gasvmr(:,:,1)  - co2 volume mixing ratio                         !
             387                     !      gasvmr(:,:,2)  - n2o volume mixing ratio                         !
             388                     !      gasvmr(:,:,3)  - ch4 volume mixing ratio                         !
             389                     !      gasvmr(:,:,4)  - o2  volume mixing ratio                         !
             390                     !      gasvmr(:,:,5)  - co  volume mixing ratio        (not used)       !
             391                     !      gasvmr(:,:,6)  - cfc11 volume mixing ratio      (not used)       !
             392                     !      gasvmr(:,:,7)  - cfc12 volume mixing ratio      (not used)       !
             393                     !      gasvmr(:,:,8)  - cfc22 volume mixing ratio      (not used)       !
             394                     !      gasvmr(:,:,9)  - ccl4  volume mixing ratio      (not used)       !
             395                     !   clouds(npts,nlay,:): cloud profile                                  !
             396                     !                      (check module_radiation_clouds for definition)   !
             397                     !                ---  for  iswcliq > 0  ---                             !
             398                     !       clouds(:,:,1)  -   layer total cloud fraction                   !
             399                     !       clouds(:,:,2)  -   layer in-cloud liq water path   (g/m**2)     !
             400                     !       clouds(:,:,3)  -   mean eff radius for liq cloud   (micron)     !
             401                     !       clouds(:,:,4)  -   layer in-cloud ice water path   (g/m**2)     !
             402                     !       clouds(:,:,5)  -   mean eff radius for ice cloud   (micron)     !
             403                     !       clouds(:,:,6)  -   layer rain drop water path      (g/m**2)     !
             404                     !       clouds(:,:,7)  -   mean eff radius for rain drop   (micron)     !
             405                     !       clouds(:,:,8)  -   layer snow flake water path     (g/m**2)     !
             406                     !       clouds(:,:,9)  -   mean eff radius for snow flake  (micron)     !
             407                     !                ---  for  iswcliq = 0  ---                             !
             408                     !       clouds(:,:,1)  -   layer total cloud fraction                   !
             409                     !       clouds(:,:,2)  -   layer cloud optical depth                    !
             410                     !       clouds(:,:,3)  -   layer cloud single scattering albedo         !
             411                     !       clouds(:,:,4)  -   layer cloud asymmetry factor                 !
             412                     !     icseed(npts)   : auxiliary special cloud related array            !
             413                     !                      when module variable isubcsw=2, it provides      !
             414                     !                      permutation seed for each column profile that    !
             415                     !                      are used for generating random numbers.          !
             416                     !                      when isubcsw /=2, it will not be used.           !
             417                     !   aerosols(npts,nlay,nbdsw,:) : aerosol optical properties            !
             418                     !                      (check module_radiation_aerosols for definition) !
             419                     !         (:,:,:,1)   - optical depth                                   !
             420                     !         (:,:,:,2)   - single scattering albedo                        !
             421                     !         (:,:,:,3)   - asymmetry parameter                             !
             422                     !   sfcalb(npts, : ) : surface albedo in fraction                       !
             423                     !                      (check module_radiation_surface for definition)  !
             424                     !         ( :, 1 )    - near ir direct beam albedo                      !
             425                     !         ( :, 2 )    - near ir diffused albedo                         !
             426                     !         ( :, 3 )    - uv+vis direct beam albedo                       !
             427                     !         ( :, 4 )    - uv+vis diffused albedo                          !
             428                     !   cosz  (npts)     : cosine of solar zenith angle                     !
             429                     !   solcon           : solar constant                      (w/m**2)     !
             430                     !   nday             : num of daytime points                            !
             431                     !   idxday(npts)     : index array for daytime points                   !
             432                     !   npts             : number of horizontal points                      !
             433                     !   nlay,nlp1        : vertical layer/lavel numbers                     !
             434                     !   lprnt            : logical check print flag                         !
             435                     !                                                                       !
             436                     !  output variables:                                                    !
             437                     !   hswc  (npts,nlay): total sky heating rates (k/sec or k/day)         !
             438                     !   topflx(npts)     : radiation fluxes at toa (w/m**2), components:    !
             439                     !                      (check module_radsw_parameters for definition)   !
             440                     !     upfxc            - total sky upward flux at toa                   !
             441                     !     dnflx            - total sky downward flux at toa                 !
             442                     !     upfx0            - clear sky upward flux at toa                   !
             443                     !   sfcflx(npts)     : radiation fluxes at sfc (w/m**2), components:    !
             444                     !                      (check module_radsw_parameters for definition)   !
             445                     !     upfxc            - total sky upward flux at sfc                   !
             446                     !     dnfxc            - total sky downward flux at sfc                 !
             447                     !     upfx0            - clear sky upward flux at sfc                   !
             448                     !     dnfx0            - clear sky downward flux at sfc                 !
             449                     !                                                                       !
             450                     !!optional outputs variables:                                           !
             451                     !   hswb(npts,nlay,nbdsw): spectral band total sky heating rates        !
             452                     !   hsw0  (npts,nlay): clear sky heating rates (k/sec or k/day)         !
             453                     !   flxprf(npts,nlp1): level radiation fluxes (w/m**2), components:     !
             454                     !                      (check module_radsw_parameters for definition)   !
             455                     !     dnfxc            - total sky downward flux at interface           !
             456                     !     upfxc            - total sky upward flux at interface             !
             457                     !     dnfx0            - clear sky downward flux at interface           !
             458                     !     upfx0            - clear sky upward flux at interface             !
             459                     !   fdncmp(npts)     : component surface downward fluxes (w/m**2):      !
             460                     !                      (check module_radsw_parameters for definition)   !
             461                     !     uvbfc            - total sky downward uv-b flux at sfc            !
             462                     !     uvbf0            - clear sky downward uv-b flux at sfc            !
             463                     !     nirbm            - downward surface nir direct beam flux          !
             464                     !     nirdf            - downward surface nir diffused flux             !
             465                     !     visbm            - downward surface uv+vis direct beam flux       !
             466                     !     visdf            - downward surface uv+vis diffused flux          !
             467                     !                                                                       !
             468                     !  external module variables:  (in physpara)                            !
             469                     !   iswrgas - control flag for rare gases (ch4,n2o,o2, etc.)            !
             470                     !           =0: do not include rare gases                               !
             471                     !           >0: include all rare gases                                  !
             472                     !   iswcliq - control flag for liq-cloud optical properties             !
             473                     !           =0: input cloud optical depth, fixed ssa, asy               !
             474                     !           =1: use hu and stamnes(1993) method for liq cld             !
             475                     !           =2: not used                                                !
             476                     !   iswcice - control flag for ice-cloud optical properties             !
             477                     !           *** if iswcliq==0, iswcice is ignored                       !
             478                     !           =1: use ebert and curry (1992) scheme for ice clouds        !
             479                     !           =2: use streamer v3.0 (2001) method for ice clouds          !
             480                     !           =3: use fu's method (1996) for ice clouds                   !
             481                     !   iswmode - control flag for 2-stream transfer scheme                 !
             482                     !           =1; delta-eddington    (joseph et al., 1976)                !
             483                     !           =2: pifm               (zdunkowski et al., 1980)            !
             484                     !           =3: discrete ordinates (liou, 1973)                         !
             485                     !   isubcsw - sub-column cloud approximation control flag               !
             486                     !           =0: no sub-col cld treatment, use grid-mean cld quantities  !
             487                     !           =1: mcica sub-col, prescribed seeds to get random numbers   !
             488                     !           =2: mcica sub-col, providing array icseed for random numbers!
             489                     !   iovrsw  - cloud overlapping control flag                            !
             490                     !           =0: random overlapping clouds                               !
             491                     !           =1: maximum/random overlapping clouds                       !
             492                     !           =2: maximum overlap cloud                                   !
             493                     !   ivflip  - control flg for direction of vertical index               !
             494                     !           =0: index from toa to surface                               !
             495                     !           =1: index from surface to toa                               !
             496                     !                                                                       !
             497                     !  module parameters, control variables:                                !
             498                     !     nblow,nbhgh      - lower and upper limits of spectral bands       !
             499                     !     maxgas           - maximum number of absorbing gaseous            !
             500                     !     ngptsw           - total number of g-point subintervals           !
             501                     !     ng##             - number of g-points in band (##=16-29)          !
             502                     !     ngb(ngptsw)      - band indices for each g-point                  !
             503                     !     bpade            - pade approximation constant (1/0.278)          !
             504                     !     nspa,nspb(nblow:nbhgh)                                            !
             505                     !                      - number of lower/upper ref atm's per band       !
             506                     !     ipsdsw0          - permutation seed for mcica sub-col clds        !
             507                     !                                                                       !
             508                     !  major local variables:                                               !
             509                     !     pavel  (nlay)         - layer pressures (mb)                      !
             510                     !     delp   (nlay)         - layer pressure thickness (mb)             !
             511                     !     tavel  (nlay)         - layer temperatures (k)                    !
             512                     !     coldry (nlay)         - dry air column amount                     !
             513                     !                                   (1.e-20*molecules/cm**2)            !
             514                     !     cldfrc (nlay)         - layer cloud fraction (norm by tot cld)    !
             515                     !     cldfmc (nlay,ngptsw)  - layer cloud fraction for g-point          !
             516                     !     taucw  (nlay,nbdsw)   - cloud optical depth                       !
             517                     !     ssacw  (nlay,nbdsw)   - cloud single scattering albedo (weighted) !
             518                     !     asycw  (nlay,nbdsw)   - cloud asymmetry factor         (weighted) !
             519                     !     tauaer (nlay,nbdsw)   - aerosol optical depths                    !
             520                     !     ssaaer (nlay,nbdsw)   - aerosol single scattering albedo          !
             521                     !     asyaer (nlay,nbdsw)   - aerosol asymmetry factor                  !
             522                     !     colamt (nlay,maxgas)  - column amounts of absorbing gases         !
             523                     !                             1 to maxgas are for h2o, co2, o3, n2o,    !
             524                     !                             ch4, o2, co, respectively (mol/cm**2)     !
             525                     !     facij  (nlay)         - indicator of interpolation factors        !
             526                     !                             =0/1: indicate lower/higher temp & height !
             527                     !     selffac(nlay)         - scale factor for self-continuum, equals   !
             528                     !                          (w.v. density)/(atm density at 296k,1013 mb) !
             529                     !     selffrac(nlay)        - factor for temp interpolation of ref      !
             530                     !                             self-continuum data                       !
             531                     !     indself(nlay)         - index of the lower two appropriate ref    !
             532                     !                             temp for the self-continuum interpolation !
             533                     !     forfac (nlay)         - scale factor for w.v. foreign-continuum   !
             534                     !     forfrac(nlay)         - factor for temp interpolation of ref      !
             535                     !                             w.v. foreign-continuum data               !
             536                     !     indfor (nlay)         - index of the lower two appropriate ref    !
             537                     !                             temp for the foreign-continuum interp     !
             538                     !     laytrop               - layer at which switch is made from one    !
             539                     !                             combination of key species to another     !
             540                     !     jp(nlay),jt(nlay),jt1(nlay)                                       !
             541                     !                           - lookup table indexes                      !
             542                     !     flxucb(nlp1,nbdsw)    - spectral bnd total-sky upward flx (w/m2)  !
             543                     !     flxdcb(nlp1,nbdsw)    - spectral bnd total-sky downward flx (w/m2)!
             544                     !     flxu0b(nlp1,nbdsw)    - spectral bnd clear-sky upward flx (w/m2)  !
             545                     !     flxd0b(nlp1,nbdsw)    - spectral b d clear-sky downward flx (w/m2)!
             546                     !                                                                       !
             547                     !                                                                       !
             548                     !  =====================    end of definitions    ====================  !
             549                     
             550                     !  ---  inputs:
             551                           integer, intent(in) :: npts, nlay, nlp1, nday, myrank
             552                     
             553                           integer, dimension(:), intent(in) :: idxday, icseed
             554                     
             555                           logical, intent(in) :: lprnt
             556                     
             557                           real (kind=kind_phys), dimension(npts,nlp1), intent(in) ::        &
             558                          &       plvl, tlvl
             559                           real (kind=kind_phys), dimension(npts,nlay), intent(in) ::        &
             560                          &       plyr, tlyr, qlyr, olyr
             561                           real (kind=kind_phys), dimension(npts,4),    intent(in) :: sfcalb
             562                     
             563                           real (kind=kind_phys), dimension(npts,nlay,9),intent(in):: gasvmr
             564                           real (kind=kind_phys), dimension(npts,nlay,9),intent(in):: clouds
             565                           real (kind=kind_phys), dimension(npts,nlay,nbdsw,3),intent(in)::  &
             566                          &       aerosols
             567                     
             568                           real (kind=kind_phys), intent(in) :: cosz(npts), solcon
             569                     
             570                     !  ---  outputs:
             571                           real (kind=kind_phys), dimension(npts,nlay), intent(out) :: hswc
             572                     
             573                           type (topfsw_type),    dimension(npts), intent(out) :: topflx
             574                           type (sfcfsw_type),    dimension(npts), intent(out) :: sfcflx
             575                     
             576                     !! ---  optional outputs:
             577                           real (kind=kind_phys), dimension(npts,nlay,nbdsw), optional,      &
             578                          &       intent(out) :: hswb
             579                     
             580                           real (kind=kind_phys), dimension(npts,nlay),       optional,      &
             581                          &       intent(out) :: hsw0
             582                           type (profsw_type),    dimension(npts,nlp1),       optional,      &
             583                          &       intent(out) :: flxprf
             584                           type (cmpfsw_type),    dimension(npts),            optional,      &
             585                          &       intent(out) :: fdncmp
             586                     
             587                     !  ---  locals:
             588                           real (kind=kind_phys), dimension(nlay,ngptsw) :: cldfmc,          &
             589                          &       taug, taur
             590                           real (kind=kind_phys), dimension(nlp1,nbdsw):: fxupc, fxdnc,      &
             591                          &       fxup0, fxdn0
             592                     
             593                           real (kind=kind_phys), dimension(nlay,nbdsw)  ::                  &
             594                          &       tauae, ssaae, asyae, taucw, ssacw, asycw
             595                     
             596                           real (kind=kind_phys), dimension(ngptsw) :: sfluxzen
             597                     
             598                           real (kind=kind_phys), dimension(nlay)   :: cldfrc,     delp,     &
             599                          &       pavel, tavel, coldry, colmol, h2ovmr, o3vmr, temcol,       &
             600                          &       cliqp, reliq, cicep, reice, cdat1, cdat2, cdat3, cdat4,    &
             601                          &       cfrac, fac00, fac01, fac10, fac11, forfac, forfrac,        &
             602                          &       selffac, selffrac, rfdelp
             603                     
             604                           real (kind=kind_phys), dimension(nlp1) :: fnet, flxdc, flxuc,     &
             605                          &       flxd0, flxu0
             606                     
             607                           real (kind=kind_phys), dimension(2) :: albbm, albdf, sfbmc,       &
             608                          &       sfbm0, sfdfc, sfdf0
             609                     
             610                           real (kind=kind_phys) :: cosz1, sntz1, tem0, tem1, tem2, s0fac,   &
             611                          &       ssolar, zcf0, zcf1, ftoau0, ftoauc, ftoadc,                &
             612                          &       fsfcu0, fsfcuc, fsfcd0, fsfcdc, suvbfc, suvbf0
             613                     
             614                     !  ---  column amount of absorbing gases:
             615                     !       (:,m) m = 1-h2o, 2-co2, 3-o3, 4-n2o, 5-ch4, 6-o2, 7-co
             616                           real (kind=kind_phys) ::  colamt(nlay,maxgas)
             617                     
             618                           integer, dimension(npts) :: ipseed
             619                           integer, dimension(nlay) :: indfor, indself, jp, jt, jt1
             620                     
             621                           integer :: i, ib, ipt, j1, k, kk, laytrop, mb
             622                     !
             623                     !===> ... begin here
             624                     !
             625                     
             626                           lhswb  = present ( hswb )
             627                           lhsw0  = present ( hsw0 )
             628                           lflxprf= present ( flxprf )
             629                           lfdncmp= present ( fdncmp )
             630                     
             631                     !      if (myrank .eq. 0) print *,'$$$$ swrad start $$$$'
             632                     !      if (myrank .eq. 0) print *,'$$$$ lhswb   =',lhswb
             633                     !      if (myrank .eq. 0) print *,'$$$$ lhsw0   =',lhsw0
             634                     !      if (myrank .eq. 0) print *,'$$$$ lflxprf =',lflxprf
             635                     !      if (myrank .eq. 0) print *,'$$$$ lfdncmp =',lfdncmp
             636                     !      if (myrank .eq. 0) print *,'$$$$ nlp1    =',nlp1
             637                     
             638                     !  --- ...  compute solar constant adjustment factor according to solcon.
             639                     !      ***  s0, the solar constant at toa in w/m**2, is hard-coded with
             640                     !           each spectra band, the total flux is about 1368.22 w/m**2.
             641                     
             642                           s0fac = solcon / s0
             643                     
             644                     !  --- ...  initial output arrays
             645                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hswc
                                   <<< Loop-information  End >>>
             646        pp   4v            hswc(:,:) = f_zero
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.50, ITR: 6, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             647             2             topflx = topfsw_type ( f_zero, f_zero, f_zero )
             648             2             sfcflx = sfcfsw_type ( f_zero, f_zero, f_zero, f_zero )
             649                     
             650                     !! --- ...  initial optional outputs
             651     1                     if ( lflxprf ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.37, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             652     1       4               flxprf = profsw_type ( f_zero, f_zero, f_zero, f_zero )
             653     1                     endif
             654                     
             655     1                     if ( lfdncmp ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.33, ITR: 6, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             656     1       2               fdncmp = cmpfsw_type (f_zero,f_zero,f_zero,f_zero,f_zero,f_zero)
             657     1                     endif
             658                     
             659     1                     if ( lhsw0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hsw0
                                   <<< Loop-information  End >>>
             660     1  pp   4v              hsw0(:,:) = f_zero
             661     1                     endif
             662                     
             663     1                     if ( lhswb ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hswb
                                   <<< Loop-information  End >>>
             664     1  pp   4v              hswb(:,:,:) = f_zero
             665     1                     endif
             666                     
             667                     !  --- ...  change random number seed value for each radiation invocation
             668                     
             669     1                     if     ( isubcsw == 1 ) then     ! advance prescribed permutation seed
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 192, MVE: 3, POL: S)

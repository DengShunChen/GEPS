            3317     1                       ftoauc = ftoau0
            3318     1                       fsfcuc = fsfcu0
            3319     1                       fsfcdc = fsfcd0
            3320     1               
            3321     1               !! --- ...  surface downward beam/diffused flux components
            3322     1                       sfbmc(1) = sfbm0(1)
            3323     1                       sfdfc(1) = sfdf0(1)
            3324     1                       sfbmc(2) = sfbm0(2)
            3325     1                       sfdfc(2) = sfdf0(2)
            3326     1               
            3327     1               !! --- ...  uv-b surface downward flux
            3328     1                       suvbfc = suvbf0
            3329     1                     else                        ! cloudy column, compute total-sky fluxes
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3330     2   s    v              do ib = 1, nbdsw
            3331     2   p    v                ftoauc = ftoauc + fxupc(nlp1,ib)
            3332     2   p    v                fsfcuc = fsfcuc + fxupc(1,ib)
            3333     2   p    v                fsfcdc = fsfcdc + fxdnc(1,ib)
            3334     2   p    v              enddo
            3335     1               
            3336     1               !! --- ...  uv-b surface downward flux
            3337     1                       suvbfc = fxdnc(1,ibd)
            3338     1                     endif    ! end if_cf1_block
            3339                     
            3340                           return
            3341                     !...................................
            3342                           end subroutine spcvrtm
            3343                     !-----------------------------------
            3344                     
            3345                     
            3346                     !-----------------------------------
            3347                           subroutine swflux                                                 &
            3348                     !...................................
            3349                     !  ---  inputs:
            3350                          &     ( zrefb,zrefd,ztrab,ztrad,zldbt,ztdbt,                       &
            3351                          &       nlay, nlp1,                                                &
            3352                     !  ---  outputs:
            3353                          &       zfu, zfd                                                   &
            3354                          &     )
            3355                     
            3356                     !  ===================  program usage description  ===================  !
            3357                     !                                                                       !
            3358                     !   purpose:  computes the upward and downward radiation fluxes         !
            3359                     !                                                                       !
            3360                     !   interface:  "swflux" is called by "spcvrc" and "spcvrm"             !
            3361                     !                                                                       !
            3362                     !   subroutines called : none                                           !
            3363                     !                                                                       !
            3364                     !  ====================  defination of variables  ====================  !
            3365                     !                                                                       !
            3366                     !  input variables:                                                     !
            3367                     !    zrefb(nlp1)     - layer direct beam reflectivity                   !
            3368                     !    zrefd(nlp1)     - layer diffuse reflectivity                       !
            3369                     !    ztrab(nlp1)     - layer direct beam transmissivity                 !
            3370                     !    ztrad(nlp1)     - layer diffuse transmissivity                     !
            3371                     !    zldbt(nlp1)     - layer mean beam transmittance                    !
            3372                     !    ztdbt(nlp1)     - total beam transmittance at levels               !
            3373                     !    nlay, nlp1      - number of layers/levels                          !
            3374                     !                                                                       !
            3375                     !  output variables:                                                    !
            3376                     !    zfu  (nlp1)     - upward flux at layer interface                   !
            3377                     !    zfd  (nlp1)     - downward flux at layer interface                 !
            3378                     !                                                                       !
            3379                     !  *******************************************************************  !
            3380                     !  ======================  end of description block  =================  !
            3381                     
            3382                     !  ---  inputs:
            3383                           integer, intent(in) :: nlay, nlp1
            3384                     
            3385                           real (kind=kind_phys), dimension(nlp1), intent(in) :: zrefb,      &
            3386                          &       zrefd, ztrab, ztrad, ztdbt, zldbt
            3387                     
            3388                     !  ---  outputs:
            3389                           real (kind=kind_phys), dimension(nlp1), intent(out) :: zfu, zfd
            3390                     
            3391                     !  ---  locals:
            3392                           real (kind=kind_phys), dimension(nlp1) :: zrupb,zrupd,zrdnd,ztdn
            3393                     
            3394                           real (kind=kind_phys) :: zden1
            3395                     
            3396                           integer :: k, kp
            3397                     !
            3398                     !===> ... begin here
            3399                     !
            3400                     
            3401                     !  --- ...  link lowest layer with surface
            3402                     
            3403                             zrupb(1) = zrefb(1)        ! direct beam
            3404                             zrupd(1) = zrefd(1)        ! diffused
            3405                     
            3406                     !  --- ...  pass from bottom to top
            3407                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zrupd, zrefd, zldbt, zrupb, ztrad, ztrab
                                   <<<      zrefb
                                   <<< Loop-information  End >>>
            3408     1   s    s              do k = 1, nlay
            3409     1   p    v                kp = k + 1
            3410     1               
            3411     1   s    s                zden1 = f_one / ( f_one - zrupd(k)*zrefd(kp) )
            3412     1   m    m                zrupb(kp) = zrefb(kp) + ( ztrad(kp) *                         &
            3413     1                    &                ( (ztrab(kp) - zldbt(kp))*zrupd(k) +              &
            3414     1                    &                zldbt(kp)*zrupb(k)) ) * zden1
            3415     1   m    m                zrupd(kp) = zrefd(kp) + ztrad(kp)*ztrad(kp)*zrupd(k)*zden1
            3416     1   p    v              enddo
            3417                     
            3418                     !  --- ...  upper boundary conditions
            3419                     
            3420                             ztdn (nlp1) = f_one
            3421                             zrdnd(nlp1) = f_zero
            3422                             ztdn (nlay) = ztrab(nlp1)
            3423                             zrdnd(nlay) = zrefd(nlp1)
            3424                     
            3425                     !  --- ...  pass from top to bottom
            3426                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.30, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ztrad, zrdnd, zrefd, zrefb, ztrab, ztdbt
                                   <<<      ztdn
                                   <<< Loop-information  End >>>
            3427     1   s   2s              do k = nlay, 2, -1
            3428     1   s   2s                zden1 = f_one / (f_one - zrefd(k)*zrdnd(k))
            3429     1   m   2m                ztdn (k-1) = ztdbt(k)*ztrab(k) + ( ztrad(k) *                 &
            3430     1                    &                 ( (ztdn(k) - ztdbt(k)) + ztdbt(k) *              &
            3431     1                    &                 zrefb(k)*zrdnd(k) )) * zden1
            3432     1   m   2m                zrdnd(k-1) = zrefd(k) + ztrad(k)*ztrad(k)*zrdnd(k)*zden1
            3433     1   p   2v              enddo
            3434                     
            3435                     !  --- ...  up and down-welling fluxes at levels
            3436                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.58, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zrdnd, ztdbt, ztdn, zrupb, zrupd, zfu
                                   <<<      zfd
                                   <<< Loop-information  End >>>
            3437     1  pp    v              do k = 1, nlp1
            3438     1   p    v                zden1 = f_one / (f_one - zrdnd(k)*zrupd(k))
            3439     1   p    v                zfu(k) = ( ztdbt(k)*zrupb(k) +                                &
            3440     1                    &             (ztdn(k) - ztdbt(k))*zrupd(k) ) * zden1
            3441     1   p    v                zfd(k) = ztdbt(k) + ( ztdn(k) - ztdbt(k) +                    &
            3442     1                    &             ztdbt(k)*zrupb(k)*zrdnd(k) ) * zden1
            3443     1   p    v              enddo
            3444                     
            3445                           return
            3446                     !...................................
            3447                           end subroutine swflux
            3448                     !-----------------------------------
            3449                     
            3450                     
            3451                     !-----------------------------------
            3452                           subroutine taumol                                                 &
            3453                     !...................................
            3454                     !  ---  inputs:
            3455                          &     ( colamt,colmol,fac00,fac01,fac10,fac11,jp,jt,jt1,laytrop,   &
            3456                          &       forfac,forfrac,indfor,selffac,selffrac,indself, nlay,      &
            3457                     !  ---  outputs:
            3458                          &       sfluxzen, taug, taur                                       &
            3459                          &     )
            3460                     
            3461                     !  ==================   program usage description   ==================  !
            3462                     !                                                                       !
            3463                     !  description:                                                         !
            3464                     !    calculate optical depths for gaseous absorption and rayleigh       !
            3465                     !    scattering.                                                        !
            3466                     !                                                                       !
            3467                     !  subroutines called: taugb## (## = 16 - 29)                           !
            3468                     !                                                                       !
            3469                     !  ====================  defination of variables  ====================  !
            3470                     !                                                                       !
            3471                     !  inputs:                                                         size !
            3472                     !    colamt  - real, column amounts of absorbing gases the index        !
            3473                     !                    are for h2o, co2, o3, n2o, ch4, and o2,            !
            3474                     !                    respectively (molecules/cm**2)          nlay*maxgas!
            3475                     !    colmol  - real, total column amount (dry air+water vapor)     nlay !
            3476                     !    facij   - real, for each layer, these are factors that are         !
            3477                     !                    needed to compute the interpolation factors        !
            3478                     !                    that multiply the appropriate reference k-         !
            3479                     !                    values.  a value of 0/1 for i,j indicates          !
            3480                     !                    that the corresponding factor multiplies           !
            3481                     !                    reference k-value for the lower/higher of the      !
            3482                     !                    two appropriate temperatures, and altitudes,       !
            3483                     !                    respectively.                                 naly !
            3484                     !    jp      - real, the index of the lower (in altitude) of the        !
            3485                     !                    two appropriate ref pressure levels needed         !
            3486                     !                    for interpolation.                            nlay !
            3487                     !    jt, jt1 - integer, the indices of the lower of the two approp      !
            3488                     !                    ref temperatures needed for interpolation (for     !
            3489                     !                    pressure levels jp and jp+1, respectively)    nlay !
            3490                     !    laytrop - integer, tropopause layer index                       1  !
            3491                     !    forfac  - real, scale factor needed to foreign-continuum.     nlay !
            3492                     !    forfrac - real, factor needed for temperature interpolation   nlay !
            3493                     !    indfor  - integer, index of the lower of the two appropriate       !
            3494                     !                    reference temperatures needed for foreign-         !
            3495                     !                    continuum interpolation                       nlay !
            3496                     !    selffac - real, scale factor needed to h2o self-continuum.    nlay !
            3497                     !    selffrac- real, factor needed for temperature interpolation        !
            3498                     !                    of reference h2o self-continuum data          nlay !
            3499                     !    indself - integer, index of the lower of the two appropriate       !
            3500                     !                    reference temperatures needed for the self-        !
            3501                     !                    continuum interpolation                       nlay !
            3502                     !    nlay    - integer, number of vertical layers                    1  !
            3503                     !                                                                       !
            3504                     !  output:                                                              !
            3505                     !    sfluxzen- real, spectral distribution of incoming solar flux ngptsw!
            3506                     !    taug    - real, spectral optical depth for gases        nlay*ngptsw!
            3507                     !    taur    - real, opt depth for rayleigh scattering       nlay*ngptsw!
            3508                     !                                                                       !
            3509                     !  ===================================================================  !
            3510                     !  ************     original subprogram description    ***************  !
            3511                     !                                                                       !
            3512                     !                  optical depths developed for the                     !
            3513                     !                                                                       !
            3514                     !                rapid radiative transfer model (rrtm)                  !
            3515                     !                                                                       !
            3516                     !            atmospheric and environmental research, inc.               !
            3517                     !                        131 hartwell avenue                            !
            3518                     !                        lexington, ma 02421                            !
            3519                     !                                                                       !
            3520                     !                                                                       !
            3521                     !                           eli j. mlawer                               !
            3522                     !                         jennifer delamere                             !
            3523                     !                         steven j. taubman                             !
            3524                     !                         shepard a. clough                             !
            3525                     !                                                                       !
            3526                     !                                                                       !
            3527                     !                                                                       !
            3528                     !                       email:  mlawer@aer.com                          !
            3529                     !                       email:  jdelamer@aer.com                        !
            3530                     !                                                                       !
            3531                     !        the authors wish to acknowledge the contributions of the       !
            3532                     !        following people:  patrick d. brown, michael j. iacono,        !
            3533                     !        ronald e. farren, luke chen, robert bergstrom.                 !
            3534                     !                                                                       !
            3535                     !  *******************************************************************  !
            3536                     !                                                                       !
            3537                     !  taumol                                                               !
            3538                     !                                                                       !
            3539                     !    this file contains the subroutines taugbn (where n goes from       !
            3540                     !    16 to 29).  taugbn calculates the optical depths and planck        !
            3541                     !    fractions per g-value and layer for band n.                        !
            3542                     !                                                                       !
            3543                     !  output:  optical depths (unitless)                                   !
            3544                     !           fractions needed to compute planck functions at every layer !
            3545                     !           and g-value                                                 !
            3546                     !                                                                       !
            3547                     !  modifications:                                                       !
            3548                     !                                                                       !
            3549                     ! revised: adapted to f90 coding, j.-j.morcrette, ecmwf, feb 2003       !
            3550                     ! revised: modified for g-point reduction, mjiacono, aer, dec 2003      !
            3551                     ! revised: reformatted for consistency with rrtmg_lw, mjiacono, aer,    !
            3552                     !          jul 2006                                                     !
            3553                     !                                                                       !
            3554                     !  *******************************************************************  !
            3555                     !  ======================  end of description block  =================  !
            3556                     
            3557                     !  ---  inputs:
            3558                           integer,               intent(in) :: nlay, laytrop
            3559                     
            3560                           integer, dimension(nlay), intent(in) :: indfor, indself,          &
            3561                          &       jp, jt, jt1
            3562                     
            3563                           real (kind=kind_phys), dimension(nlay),  intent(in) :: colmol,    &
            3564                          &       fac00, fac01, fac10, fac11, forfac, forfrac, selffac,      &
            3565                          &       selffrac
            3566                     
            3567                           real (kind=kind_phys), dimension(nlay,maxgas),intent(in) :: colamt
            3568                     
            3569                     !  ---  outputs:
            3570                           real (kind=kind_phys), dimension(ngptsw), intent(out) :: sfluxzen
            3571                     
            3572                           real (kind=kind_phys), dimension(nlay,ngptsw), intent(out) ::     &
            3573                          &       taug, taur
            3574                     
            3575                     !  ---  locals:
            3576                           real (kind=kind_phys) :: fs, speccomb, specmult, colm1, colm2
            3577                     
            3578                           integer, dimension(nlay,nblow:nbhgh) :: id0, id1
            3579                     
            3580                           integer :: ibd, j, jb, js, k, klow, khgh, klim, ks, njb, ns
            3581                     !
            3582                     !===> ... begin here
            3583                     !
            3584                     !  --- ...  loop over each spectral band
            3585                     
            3586     1                     do jb = nblow, nbhgh
            3587     1               
            3588     1               !  --- ...  indices for layer optical depth
            3589     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp, jt1, id1, jt, id0
                                   <<< Loop-information  End >>>
            3590     2  pp    v              do k = 1, laytrop
            3591     2   p    v                id0(k,jb) = ((jp(k)-1)*5 + (jt (k)-1)) * nspa(jb)
            3592     2   p    v                id1(k,jb) = ( jp(k)   *5 + (jt1(k)-1)) * nspa(jb)
            3593     2   p    v              enddo
            3594     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 208, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp, id1, jt, jt1, id0
                                   <<< Loop-information  End >>>
            3595     2  pp    v              do k = laytrop+1, nlay
            3596     2   p    v                id0(k,jb) = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(jb)
            3597     2   p    v                id1(k,jb) = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(jb)
            3598     2   p    v              enddo
            3599     1               
            3600     1               !  --- ...  calculate spectral flux at toa
            3601     1               
            3602     1                       ibd = ibx(jb)
            3603     1                       njb = ng (jb)
            3604     1                       ns  = ngs(jb)
            3605     1               
            3606     2                       select case (jb)
            3607     2               
            3608     2                         case (16, 20, 23, 25, 26, 29)
            3609     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sfluxref01, sfluxzen
                                   <<< Loop-information  End >>>
            3610     3  pp   2v                  do j = 1, njb
            3611     3   p   2v                    sfluxzen(ns+j) = sfluxref01(j,1,ibd)
            3612     3   p   2v                  enddo
            3613     2               
            3614     2                         case (27)
            3615     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sfluxref01, sfluxzen
                                   <<< Loop-information  End >>>
            3616     3  pp   2v                  do j = 1, njb
            3617     3   p   2v                    sfluxzen(ns+j) = scalekur * sfluxref01(j,1,ibd)
            3618     3   p   2v                  enddo
            3619     2               
            3620     2                         case default
            3621     2               
            3622     3                           if (jb==17 .or. jb==28) then
            3623     3               
            3624     3                             ks = nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp
                                   <<< Loop-information  End >>>
            3625     4                             lab_do_k1 : do k = laytrop, nlay-1
            3626     5                               if (jp(k)<layreffr(jb) .and. jp(k+1)>=layreffr(jb)) then
            3627     5                                 ks = k + 1
            3628     5                                 exit lab_do_k1
            3629     5                               endif
            3630     4                             enddo  lab_do_k1
            3631     3               
            3632     3                             colm1 = colamt(ks,ix1(jb))
            3633     3                             colm2 = colamt(ks,ix2(jb))
            3634     3                             speccomb = colm1 + strrat(jb)*colm2
            3635     3                             specmult = specwt(jb) * min( oneminus, colm1/speccomb )
            3636     3                             js = 1 + int( specmult )
            3637     3                             fs = mod(specmult, f_one)
            3638     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sfluxref02, sfluxzen
                                   <<< Loop-information  End >>>
            3639     4  pp    v                    do j = 1, njb
            3640     4   p    v                      sfluxzen(ns+j) = sfluxref02(j,js,ibd)                   &
            3641     4                    &           + fs * (sfluxref02(j,js+1,ibd) - sfluxref02(j,js,ibd))
            3642     4   p    v                    enddo
            3643     3               
            3644     3                           else
            3645     3               
            3646     3                             ks = laytrop
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp
                                   <<< Loop-information  End >>>
            3647     4                             lab_do_k2 : do k = 1, laytrop-1
            3648     5                               if (jp(k)<layreffr(jb) .and. jp(k+1)>=layreffr(jb)) then
            3649     5                                 ks = k + 1
            3650     5                                 exit lab_do_k2
            3651     5                               endif
            3652     4                             enddo  lab_do_k2
            3653     3               
            3654     3                             colm1 = colamt(ks,ix1(jb))
            3655     3                             colm2 = colamt(ks,ix2(jb))
            3656     3                             speccomb = colm1 + strrat(jb)*colm2
            3657     3                             specmult = specwt(jb) * min( oneminus, colm1/speccomb )
            3658     3                             js = 1 + int( specmult )
            3659     3                             fs = mod(specmult, f_one)
            3660     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sfluxref03, sfluxzen
                                   <<< Loop-information  End >>>
            3661     4  pp    v                    do j = 1, njb
            3662     4   p    v                      sfluxzen(ns+j) = sfluxref03(j,js,ibd)                   &
            3663     4                    &           + fs * (sfluxref03(j,js+1,ibd) - sfluxref03(j,js,ibd))
            3664     4   p    v                    enddo
            3665     3               
            3666     3                           endif
            3667     2               
            3668     2                       end select
            3669     1               
            3670     1                     enddo
            3671                     
            3672                     !  --- ...  call taumol## to calculate layer optical depth
            3673                     
            3674                           call taumol16
            3675                           call taumol17
            3676                           call taumol18
            3677                           call taumol19
            3678                           call taumol20
            3679                           call taumol21
            3680                           call taumol22
            3681                           call taumol23
            3682                           call taumol24
            3683                           call taumol25
            3684          i                call taumol26
            3685                           call taumol27
            3686                           call taumol28
            3687                           call taumol29
            3688                     
            3689                     
            3690                     ! =================
            3691                           contains
            3692                     ! =================
            3693                     
            3694                     !-----------------------------------
            3695                           subroutine taumol16
            3696                     !...................................
            3697                     
            3698                     !  ------------------------------------------------------------------  !
            3699                     !     band 16:  2600-3250 cm-1 (low - h2o,ch4; high - ch4)             !
            3700                     !  ------------------------------------------------------------------  !
            3701                     !
            3702                           use module_radsw_kgb16
            3703                     
            3704                     !  ---  locals:
            3705                     
            3706                           real (kind=kind_phys) :: speccomb, specmult, tauray, fs, fs1,     &
            3707                          &       fac000,fac001,fac010,fac011, fac100,fac101,fac110,fac111
            3708                     
            3709                           integer :: ind01, ind02, ind03, ind04, ind11, ind12, ind13, ind14

            4286     2                    &        +   fac010 * absb(ind03,j) + fac110 * absb(ind04,j)       &
            4287     2                    &        +   fac001 * absb(ind11,j) + fac101 * absb(ind12,j)       &
            4288     2                    &        +   fac011 * absb(ind13,j) + fac111 * absb(ind14,j) )     &
            4289     2                    &        + colamt(k,1) * forfac(k) * (forref(indf,j)               &
            4290     2                    &        + forfrac(k) * (forref(indfp,j) - forref(indf,j)))
            4291     2   p    v              enddo
            4292     1   p                 enddo
            4293                     
            4294                     !...................................
            4295                           end subroutine taumol21

            4479                     
            4480                           integer :: ind01, ind02, ind03, ind04, ind11, ind12, ind13, ind14
            4481                           integer :: inds, indf, indsp, indfp, j, js, k
            4482                     
            4483                     !
            4484                     !===> ... begin here

            4486                     
            4487                     !  --- ...  compute the optical depth by interpolating in ln(pressure),
            4488                     !           temperature, and appropriate species.  below laytrop, the water
            4489                     !           vapor self-continuum is interpolated (in temperature) separately.
            4490                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      indfor, indself, colamt, id0, id1
                                   <<<      colmol, taur, (unknown)
                                   <<<    PREFETCH(SOFT) : 66
                                   <<<     SEQUENTIAL : 66
                                   <<<      fac00: 2, fac10: 2, fac01: 2, fac11: 2
                                   <<<      forfrac: 2, forfac: 2, selffrac: 2
                                   <<<      selffac: 2, colamt: 4, taug: 2
                                   <<<      (unknown): 44
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 76
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4491     1   p    v            do k = 1, laytrop
            4492     1   p    v              speccomb = colamt(k,1) + strrat(24)*colamt(k,6)
            4493     1   p    v              specmult = 8.0 * min(oneminus, colamt(k,1) / speccomb)
            4494     1               
            4495     1   p    v              js = 1 + int(specmult)
            4496     1   p    v              fs = mod(specmult, f_one)
            4497     1   p    v              fs1= f_one - fs
            4498     1   p    v              fac000 = fs1 * fac00(k)
            4499     1   p    v              fac010 = fs1 * fac10(k)
            4500     1   p    v              fac100 = fs  * fac00(k)
            4501     1   p    v              fac110 = fs  * fac10(k)
            4502     1   p    v              fac001 = fs1 * fac01(k)
            4503     1   p    v              fac011 = fs1 * fac11(k)
            4504     1   p    v              fac101 = fs  * fac01(k)
            4505     1   p    v              fac111 = fs  * fac11(k)
            4506     1               
            4507     1   p    v              ind01 = id0(k,24) + js
            4508     1   p    v              ind02 = ind01 + 1
            4509     1   p    v              ind03 = ind01 + 9
            4510     1   p    v              ind04 = ind01 + 10
            4511     1   p    v              ind11 = id1(k,24) + js
            4512     1   p    v              ind12 = ind11 + 1
            4513     1   p    v              ind13 = ind11 + 9
            4514     1   p    v              ind14 = ind11 + 10
            4515     1               
            4516     1   p    v              inds = indself(k)
            4517     1   p    v              indf = indfor (k)
            4518     1   p    v              indsp= inds + 1
            4519     1   m    v              indfp= indf + 1
            4520     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)

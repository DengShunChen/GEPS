            4299                     !-----------------------------------
            4300                           subroutine taumol22
            4301                     !...................................
            4302                     
            4303                     !  ------------------------------------------------------------------  !
            4304                     !     band 22:  7700-8050 cm-1 (low - h2o,o2; high - o2)               !
            4305                     !  ------------------------------------------------------------------  !
            4306                     !
            4307                           use module_radsw_kgb22
            4308                     
            4309                     !  ---  locals:
            4310                           real (kind=kind_phys) :: speccomb, specmult, tauray, fs, fs1,     &
            4311                          &       fac000,fac001,fac010,fac011, fac100,fac101,fac110,fac111,  &
            4312                          &       o2adj, o2cont, o2tem
            4313                     
            4314                           integer :: ind01, ind02, ind03, ind04, ind11, ind12, ind13, ind14
            4315                           integer :: inds, indf, indsp, indfp, j, js, k
            4316                     
            4317                     !
            4318                     !===> ... begin here
            4319                     !
            4320                     !  --- ...  the following factor is the ratio of total o2 band intensity (lines
            4321                     !           and mate continuum) to o2 band intensity (line only). it is needed
            4322                     !           to adjust the optical depths since the k's include only lines.
            4323                     
            4324                           o2adj = 1.6
            4325                           o2tem = 4.35e-4 / (350.0*2.0)
            4326                     
            4327                     !  --- ...  compute the optical depth by interpolating in ln(pressure),
            4328                     !           temperature, and appropriate species.  below laytrop, the water
            4329                     !           vapor self-continuum is interpolated (in temperature) separately.
            4330                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taur, colmol
                                   <<< Loop-information  End >>>
            4331     1  pp   2v            do k = 1, nlay
            4332     1   p   2v              tauray = colmol(k) * rayl
            4333     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4334     2   p   f               do j = 1, ng22
            4335     2   p   fv                taur(k,ns22+j) = tauray
            4336     2   p   fv              enddo
            4337     1   p   2v            enddo
            4338                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 50
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, fac11, fac01, fac10, fac00, id1
                                   <<<      id0, indself, selffrac, selffac, indfor
                                   <<<      forfac, forfrac, taug
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 2  FILL 3
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4339     1  pp    v            do k = 1, laytrop
            4340     1   p    v              o2cont   = o2tem * colamt(k,6)
            4341     1   p    v              speccomb = colamt(k,1) + strrat(22)*colamt(k,6)
            4342     1   p    v              specmult = 8.0 * min(oneminus, colamt(k,1) / speccomb)
            4343     1               
            4344     1   p    v              js = 1 + int(specmult)
            4345     1   p    v              fs = mod(specmult, f_one)
            4346     1   p    v              fs1= f_one - fs
            4347     1   p    v              fac000 = fs1 * fac00(k)
            4348     1   p    v              fac010 = fs1 * fac10(k)
            4349     1   p    v              fac100 = fs  * fac00(k)
            4350     1   p    v              fac110 = fs  * fac10(k)
            4351     1   p    v              fac001 = fs1 * fac01(k)
            4352     1   p    v              fac011 = fs1 * fac11(k)
            4353     1   p    v              fac101 = fs  * fac01(k)
            4354     1   p    v              fac111 = fs  * fac11(k)
            4355     1               
            4356     1   p    v              ind01 = id0(k,22) + js
            4357     1   p    v              ind02 = ind01 + 1
            4358     1   p    v              ind03 = ind01 + 9
            4359     1   p    v              ind04 = ind01 + 10
            4360     1   p    v              ind11 = id1(k,22) + js
            4361     1   p    v              ind12 = ind11 + 1
            4362     1   p    v              ind13 = ind11 + 9
            4363     1   p    v              ind14 = ind11 + 10
            4364     1               
            4365     1   p    v              inds = indself(k)
            4366     1   p    v              indf = indfor (k)
            4367     1   p    v              indsp= inds + 1
            4368     1   p    v              indfp= indf + 1
            4369     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4370     2   p   f               do j = 1, ng22
            4371     2   p   fv                taug(k,ns22+j) = speccomb                                     &
            4372     2                    &        * ( fac000 * absa(ind01,j) + fac100 * absa(ind02,j)       &
            4373     2                    &        +   fac010 * absa(ind03,j) + fac110 * absa(ind04,j)       &
            4374     2                    &        +   fac001 * absa(ind11,j) + fac101 * absa(ind12,j)       &
            4375     2                    &        +   fac011 * absa(ind13,j) + fac111 * absa(ind14,j) )     &
            4376     2                    &        + colamt(k,1) * (selffac(k) * (selfref(inds,j)            &
            4377     2                    &        + selffrac(k) * (selfref(indsp,j)-selfref(inds,j)))       &
            4378     2                    &        + forfac(k) * (forref(indf,j) + forfrac(k)                &
            4379     2                    &        * (forref(indfp,j) - forref(indf,j)))) + o2cont
            4380     2   p   fv              enddo
            4381     1   p    v            enddo
            4382                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 156
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.42, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fac01, fac00, id0, colamt, fac11, id1
                                   <<<      fac10, taug
                                   <<< Loop-information  End >>>
            4383     1  pp    v            do k = laytrop+1, nlay
            4384     1   p    v              o2cont = o2tem * colamt(k,6)
            4385     1               
            4386     1   p    v              ind01 = id0(k,22) + 1
            4387     1   p    v              ind02 = ind01 + 1
            4388     1   p    v              ind11 = id1(k,22) + 1
            4389     1   p    v              ind12 = ind11 + 1
            4390     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4391     2   p   f               do j = 1, ng22
            4392     2   p   fv                taug(k,ns22+j) = colamt(k,6) * o2adj                          &
            4393     2                    &        * ( fac00(k)*absb(ind01,j) + fac10(k)*absb(ind02,j)       &
            4394     2                    &        +   fac01(k)*absb(ind11,j) + fac11(k)*absb(ind12,j) )     &
            4395     2                    &        + o2cont
            4396     2   p   fv              enddo
            4397     1   p    v            enddo
            4398                     
            4399                           return
            4400                     !...................................
            4401                           end subroutine taumol22

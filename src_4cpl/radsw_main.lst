            1142                     !-----------------------------------
            1143                           subroutine rswinit                                                &
            1144                     !...................................
            1145                     
            1146                     !  ---  inputs:
            1147                          &     ( me ,myrank)
            1148                     !  ---  outputs: (none)
            1149                     
            1150                     !  ===================  program usage description  ===================  !
            1151                     !                                                                       !
            1152                     ! purpose:  initialize non-varying module variables, conversion factors,!
            1153                     ! and look-up tables.                                                   !
            1154                     !                                                                       !
            1155                     ! subprograms called:  none                                             !
            1156                     !                                                                       !
            1157                     !  ====================  defination of variables  ====================  !
            1158                     !                                                                       !
            1159                     !  inputs:                                                              !
            1160                     !    me       - print control for parallel process                      !
            1161                     !                                                                       !
            1162                     !  outputs: (none)                                                      !
            1163                     !                                                                       !
            1164                     !  external module variables:  (in physpara)                            !
            1165                     !   iswrate - heating rate unit selections                              !
            1166                     !           =1: output in k/day                                         !
            1167                     !           =2: output in k/second                                      !
            1168                     !   iswrgas - control flag for rare gases (ch4,n2o,o2, etc.)            !
            1169                     !           =0: do not include rare gases                               !
            1170                     !           >0: include all rare gases                                  !
            1171                     !   iswcliq - liquid cloud optical properties contrl flag               !
            1172                     !           =0: input cloud opt depth from diagnostic scheme            !
            1173                     !           >0: input cwp,rew, and other cloud content parameters       !
            1174                     !   isubcsw - sub-column cloud approximation control flag               !
            1175                     !           =0: no sub-col cld treatment, use grid-mean cld quantities  !
            1176                     !           =1: mcica sub-col, prescribed seeds to get random numbers   !
            1177                     !           =2: mcica sub-col, providing array icseed for random numbers!
            1178                     !   icldflg - cloud scheme control flag                                 !
            1179                     !           =0: diagnostic scheme gives cloud tau, omiga, and g.        !
            1180                     !           =1: prognostic scheme gives cloud liq/ice path, etc.        !
            1181                     !   iovrsw  - clouds vertical overlapping control flag                  !
            1182                     !           =0: random overlapping clouds                               !
            1183                     !           =1: maximum/random overlapping clouds                       !
            1184                     !           =2: maximum overlap cloud                                   !
            1185                     !   iswmode - control flag for 2-stream transfer scheme                 !
            1186                     !           =1; delta-eddington    (joseph et al., 1976)                !
            1187                     !           =2: pifm               (zdunkowski et al., 1980)            !
            1188                     !           =3: discrete ordinates (liou, 1973)                         !
            1189                     !                                                                       !
            1190                     !  *******************************************************************  !
            1191                     !                                                                       !
            1192                     ! definitions:                                                          !
            1193                     !     arrays for 10000-point look-up tables:                            !
            1194                     !     tau_tbl  clear-sky optical depth                                  !
            1195                     !     exp_tbl  exponential lookup table for transmittance               !
            1196                     !                                                                       !
            1197                     !  *******************************************************************  !
            1198                     !                                                                       !
            1199                     !  ======================  end of description block  =================  !
            1200                     
            1201                     !  ---  inputs:
            1202                           integer, intent(in) :: me, myrank
            1203                     
            1204                     !  ---  outputs: none
            1205                     
            1206                     !  ---  locals:
            1207                           real (kind=kind_phys), parameter :: expeps = 1.e-20
            1208                     
            1209                           integer :: i
            1210                     
            1211                           real (kind=kind_phys) :: tfn, tau
            1212                     
            1213                     !
            1214                     !===> ... begin here
            1215                     !
            1216     1                     if ( iovrsw<0 .or. iovrsw>2 ) then
            1217     1                       print *,'  *** error in specification of cloud overlap flag',   &
            1218     1                    &          ' iovrsw=',iovrsw,' in rswinit !!'
            1219     1                       stop
            1220     1                     endif
            1221                     
            1222     1                     if (me == 0 .and. myrank == 0 ) then
            1223     1                       print *,' - using aer shortwave radiation, version: ',vtagsw
            1224     1               
            1225     2                       if (iswmode == 1) then
            1226     2                         print *,'   --- delta-eddington 2-stream transfer scheme'
            1227     2                       else if (iswmode == 2) then
            1228     2                         print *,'   --- pifm 2-stream transfer scheme'
            1229     2                       else if (iswmode == 3) then
            1230     2                         print *,'   --- discrete ordinates 2-stream transfer scheme'
            1231     2                       endif
            1232     1               
            1233     2                       if (iswrgas <= 0) then
            1234     2                         print *,'   --- rare gases absorption is not included in sw'
            1235     2                       else
            1236     2                         print *,'   --- include rare gases n2o, ch4, o2, absorptions',&
            1237     2                    &            ' in sw'
            1238     2                       endif
            1239     1               
            1240     2                       if ( isubcsw == 0 ) then
            1241     2                         print *,'   --- using standard grid average clouds, no ',     &
            1242     2                    &            'sub-column clouds approximation applied'
            1243     2                       elseif ( isubcsw == 1 ) then
            1244     2                         print *,'   --- using mcica sub-colum clouds approximation ', &
            1245     2                    &            'with a prescribed sequence of permutation seeds'
            1246     2                       elseif ( isubcsw == 2 ) then
            1247     2                         print *,'   --- using mcica sub-colum clouds approximation ', &
            1248     2                    &            'with provided input array of permutation seeds'
            1249     2                       else
            1250     2                         print *,'  *** error in specification of sub-column cloud ',  &
            1251     2                    &            ' control flag isubcsw =',isubcsw,' !!'
            1252     2                         stop
            1253     2                       endif
            1254     1                     endif
            1255                     
            1256                     !  --- ...  check cloud flags for consistency
            1257                     
            1258     1                     if ((icldflg == 0 .and. iswcliq /= 0) .or.                        &
            1259     1                    &    (icldflg == 1 .and. iswcliq == 0)) then
            1260     1                       print *,'  *** model cloud scheme inconsistent with sw',        &
            1261     1                    &          ' radiation cloud radiative property setup !!'
            1262     1                       stop
            1263     1                     endif
            1264                     
            1265                     !  --- ...  setup constant factors for heating rate
            1266                     !           the 1.0e-2 is to convert pressure from mb to n/m**2
            1267                     
            1268     1                     if (iswrate == 1) then
            1269     1               !       heatfac = 8.4391
            1270     1               !       heatfac = con_g * 86400. * 1.0e-2 / con_cp  !   (in k/day)
            1271     1                       heatfac = con_g * 864.0 / con_cp            !   (in k/day)
            1272     1                     else
            1273     1                       heatfac = con_g * 1.0e-2 / con_cp           !   (in k/second)
            1274     1                     endif
            1275                     
            1276                     !  --- ...  define exponential lookup tables for transmittance. tau is
            1277                     !           computed as a function of the tau transition function, and
            1278                     !           transmittance is calculated as a function of tau.  all tables
            1279                     !           are computed at intervals of 0.0001.  the inverse of the
            1280                     !           constant used in the pade approximation to the tau transition
            1281                     !           function is set to bpade.
            1282                     
            1283                           exp_tbl(0) = 1.0
            1284                           exp_tbl(ntbmx) = expeps
            1285                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      exp_tbl
                                   <<< Loop-information  End >>>
            1286     1  pp    v            do i = 1, ntbmx-1
            1287     1   p    v              tfn = float(i) / float(ntbmx-i)
            1288     1   p    v              tau = bpade * tfn
            1289     1   p    v              exp_tbl(i) = exp( -tau )
            1290     1   p    v            enddo
            1291                     
            1292                           return
            1293                     !...................................
            1294                           end subroutine rswinit
            1295                     !-----------------------------------
            1296                     
            1297                     
            1298                     !-----------------------------------
            1299                           subroutine cldprop                                                &
            1300                     !...................................
            1301                     !  ---  inputs:
            1302                          &     ( cfrac,cliqp,reliq,cicep,reice,cdat1,cdat2,cdat3,cdat4,     &
            1303                          &       cf1, nlay, ipseed,                                         &
            1304                     !  ---  output:
            1305                          &       taucw, ssacw, asycw, cldfrc, cldfmc                        &
            1306                          &     )
            1307                     
            1308                     !  ===================  program usage description  ===================  !
            1309                     !                                                                       !
            1310                     ! purpose: compute the cloud optical properties for each cloudy layer   !
            1311                     ! and g-point interval.                                                 !
            1312                     !                                                                       !
            1313                     ! subprograms called:  none                                             !
            1314                     !                                                                       !
            1315                     !  ====================  defination of variables  ====================  !
            1316                     !                                                                       !
            1317                     !  inputs:                                                        size  !
            1318                     !    cfrac - real, layer cloud fraction                            nlay !
            1319                     !        .....  for  iswcliq > 0 (prognostic cloud sckeme)  - - -       !
            1320                     !    cliqp - real, layer in-cloud liq water path (g/m**2)          nlay !
            1321                     !    reliq - real, mean eff radius for liq cloud (micron)          nlay !
            1322                     !    cicep - real, layer in-cloud ice water path (g/m**2)          nlay !
            1323                     !    reice - real, mean eff radius for ice cloud (micron)          nlay !
            1324                     !    cdat1 - real, layer rain drop water path (g/m**2)             nlay !
            1325                     !    cdat2 - real, effective radius for rain drop (micron)         nlay !
            1326                     !    cdat3 - real, layer snow flake water path(g/m**2)             nlay !
            1327                     !    cdat4 - real, mean eff radius for snow flake(micron)          nlay !
            1328                     !        .....  for iswcliq = 0  (diagnostic cloud sckeme)  - - -       !
            1329                     !    cdat1 - real, layer cloud optical depth                       nlay !
            1330                     !    cdat2 - real, layer cloud single scattering albedo            nlay !
            1331                     !    cdat3 - real, layer cloud asymmetry factor                    nlay !
            1332                     !    cdat4 - real, optional use                                    nlay !
            1333                     !    cliqp - real, not used                                        nlay !
            1334                     !    cicep - real, not used                                        nlay !
            1335                     !    reliq - real, not used                                        nlay !
            1336                     !    reice - real, not used                                        nlay !
            1337                     !                                                                       !
            1338                     !    cf1   - real, effective total cloud cover at surface           1   !
            1339                     !    nlay  - integer, vertical layer number                         1   !
            1340                     !    ipseed- permutation seed for generating random numbers (isubcsw>0) !
            1341                     !                                                                       !
            1342                     !  outputs:                                                             !
            1343                     !    taucw  - real, cloud optical depth, w/o delta scaled    nlay*nbdsw !
            1344                     !    ssacw  - real, weighted cloud single scattering albedo  nlay*nbdsw !
            1345                     !                             (ssa = ssacw / taucw)                     !
            1346                     !    asycw  - real, weighted cloud asymmetry factor          nlay*nbdsw !
            1347                     !                             (asy = asycw / ssacw)                     !
            1348                     !    cldfrc - real, cloud fraction of grid mean value              nlay !
            1349                     !    cldfmc - real, cloud fraction for each sub-column       nlay*ngptsw!
            1350                     !                                                                       !
            1351                     !                                                                       !
            1352                     !  explanation of the method for each value of iswcliq, and iswcice.    !
            1353                     !  set up in module "physpara"                                          !
            1354                     !                                                                       !
            1355                     !     iswcliq=0  : input cloud optical property (tau, ssa, asy).        !
            1356                     !                  (used for diagnostic cloud method)                   !
            1357                     !     iswcliq>0  : input cloud liq/ice path and effective radius, also  !
            1358                     !                  require the user of 'iswcice' to specify the method  !
            1359                     !                  used to compute aborption due to water/ice parts.    !
            1360                     !  ...................................................................  !
            1361                     !                                                                       !
            1362                     !     iswcliq=1  : liquid water cloud optical properties are computed   !
            1363                     !                  as in hu and stamnes (1993), j. clim., 6, 728-742.   !
            1364                     !                                                                       !
            1365                     !     iswcice used only when iswcliq > 0                                !
            1366                     !                  the cloud ice path (g/m2) and ice effective radius   !
            1367                     !                  (microns) are inputs.                                !
            1368                     !     iswcice=1  : ice cloud optical properties are computed as in      !
            1369                     !                  ebert and curry (1992), jgr, 97, 3831-3836.          !
            1370                     !     iswcice=2  : ice cloud optical properties are computed as in      !
            1371                     !                  streamer v3.0 (2001), key, streamer user's guide,    !
            1372                     !                  cooperative institude for meteorological studies,95pp!
            1373                     !     iswcice=3  : ice cloud optical properties are computed as in      !
            1374                     !                  fu (1996), j. clim., 9.                              !
            1375                     !                                                                       !
            1376                     !  other cloud control module variables:                                !
            1377                     !     isubcsw =0: standard cloud scheme, no sub-col cloud approximation !
            1378                     !             >0: mcica sub-col cloud scheme using ipseed as permutation!
            1379                     !                 seed for generating rundom numbers                    !
            1380                     !                                                                       !
            1381                     !  ======================  end of description block  =================  !
            1382                     !
            1383                           use module_radsw_cldprtb
            1384                     
            1385                     !  ---  inputs:
            1386                           integer, intent(in) :: nlay, ipseed
            1387                           real (kind=kind_phys), intent(in) :: cf1
            1388                     
            1389                           real (kind=kind_phys), dimension(nlay), intent(in) :: cliqp,      &
            1390                          &       reliq, cicep, reice, cdat1, cdat2, cdat3, cdat4, cfrac
            1391                     
            1392                     !  ---  outputs:
            1393                           real (kind=kind_phys), dimension(nlay,ngptsw), intent(out) ::     &
            1394                          &       cldfmc
            1395                           real (kind=kind_phys), dimension(nlay,nbdsw),  intent(out) ::     &
            1396                          &       taucw, ssacw, asycw
            1397                           real (kind=kind_phys), dimension(nlay), intent(out) :: cldfrc
            1398                     
            1399                     !  ---  locals:
            1400                           real (kind=kind_phys), dimension(nblow:nbhgh) :: tauliq, tauice,  &
            1401                          &       ssaliq, ssaice, ssaran, ssasnw, asyliq, asyice,            &
            1402                          &       asyran, asysnw
            1403                           real (kind=kind_phys), dimension(nlay)       :: cldf
            1404                     
            1405                           real (kind=kind_phys) :: dgeice, factor, fint, tauran, tausnw,    &
            1406                          &       cldliq, refliq, cldice, refice, cldran, cldsnw, refsnw,    &
            1407                          &       extcoliq, ssacoliq, asycoliq, extcoice, ssacoice, asycoice,&
            1408                          &       dgesnw
            1409                     
            1410                           logical :: lcloudy(nlay,ngptsw)
            1411                           integer :: ia, ib, ig, jb, k, index
            1412                     
            1413                     !
            1414                     !===> ...  begin here
            1415                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      asycw, ssacw, taucw
                                   <<< Loop-information  End >>>
            1416     1  pp   2v            do ib = 1, nbdsw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1417     2   p   2               do k = 1, nlay
            1418     2   p   2v                taucw (k,ib) = f_zero
            1419     2   p   2v                ssacw (k,ib) = f_one
            1420     2   p   2v                asycw (k,ib) = f_zero
            1421     2   p   2v              enddo
            1422     1   p                 enddo
            1423                     
            1424                     !  --- ...  compute cloud radiative properties for a cloudy column
            1425                     
            1426     1                     lab_if_iswcliq : if (iswcliq > 0) then
            1427     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 27
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1428     2                       lab_do_k : do k = 1, nlay
            1429     3                         lab_if_cld : if (cfrac(k) > ftiny) then
            1430     3               
            1431     3               !  --- ...  optical properties for rain and snow
            1432     3                           cldran = cdat1(k)
            1433     3               !           refran = cdat2(k)
            1434     3                           cldsnw = cdat3(k)
            1435     3                           refsnw = cdat4(k)
            1436     3                           dgesnw = 1.0315 * refsnw        ! for fu's snow formula
            1437     3               
            1438     3                           tauran = cldran * a0r
            1439     3               !  ---  if use fu's formula it needs to be normalized by snow/ice density
            1440     3               !       !not use snow density = 0.1 g/cm**3 = 0.1 g/(mu * m**2)
            1441     3               !       use ice density = 0.9167 g/cm**3 = 0.9167 g/(mu * m**2)
            1442     3               !       1/0.9167 = 1.09087
            1443     3               !       factor 1.5396=8/(3*sqrt(3)) converts reff to generalized ice particle size
            1444     3               !       use newer factor value 1.0315
            1445     4                           if (cldsnw>f_zero .and. refsnw>10.0_kind_phys) then
            1446     4               !             tausnw = cldsnw * (a0s + a1s/refsnw)
            1447     4                             tausnw = cldsnw*1.09087*(a0s + a1s/dgesnw)     ! fu's formula
            1448     4                           else
            1449     4                             tausnw = f_zero
            1450     4                           endif
            1451     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1452     4   s    v                  do ib = nblow, nbhgh
            1453     4   p    v                    ssaran(ib) = tauran * (f_one - b0r(ib))
            1454     4   p    v                    ssasnw(ib) = tausnw * (f_one - (b0s(ib)+b1s(ib)*dgesnw))
            1455     4   p    v                    asyran(ib) = ssaran(ib) * c0r(ib)
            1456     4   p    v                    asysnw(ib) = ssasnw(ib) * c0s(ib)
            1457     4   p    v                  enddo
            1458     3               
            1459     3                           cldliq = cliqp(k)
            1460     3                           cldice = cicep(k)
            1461     3                           refliq = reliq(k)
            1462     3                           refice = reice(k)
            1463     3               
            1464     3               !  --- ...  calculation of absorption coefficients due to water clouds.
            1465     3               
            1466     4                           if ( cldliq <= f_zero ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1467     5   s    v                    do ib = nblow, nbhgh
            1468     5   p    v                      tauliq(ib) = f_zero
            1469     5   p    v                      ssaliq(ib) = f_zero
            1470     5   p    v                      asyliq(ib) = f_zero
            1471     5   p    v                    enddo
            1472     4                           else
            1473     5                             if ( iswcliq == 1 ) then
            1474     5                               factor = refliq - 1.5
            1475     5                               index  = max( 1, min( 57, int( factor ) ))
            1476     5                               fint   = factor - float(index)
            1477     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 187
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1478     6   s    v                      do ib = nblow, nbhgh
            1479     6   p    v                        extcoliq = max(f_zero,            extliq1(index,ib)   &
            1480     6                    &              + fint*(extliq1(index+1,ib)-extliq1(index,ib)) )
            1481     6   p    v                        ssacoliq = max(f_zero, min(f_one, ssaliq1(index,ib)   &
            1482     6                    &              + fint*(ssaliq1(index+1,ib)-ssaliq1(index,ib)) ))
            1483     6               
            1484     6   p    v                        asycoliq = max(f_zero, min(f_one, asyliq1(index,ib)   &
            1485     6                    &              + fint*(asyliq1(index+1,ib)-asyliq1(index,ib)) ))
            1486     6               !                 forcoliq = asycoliq * asycoliq
            1487     6               
            1488     6   p    v                        tauliq(ib) = cldliq     * extcoliq
            1489     6   p    v                        ssaliq(ib) = tauliq(ib) * ssacoliq
            1490     6   p    v                        asyliq(ib) = ssaliq(ib) * asycoliq
            1491     6   p    v                      enddo
            1492     5                             endif   ! end if_iswcliq_block
            1493     4                           endif   ! end if_cldliq_block
            1494     3               
            1495     3               !  --- ...  calculation of absorption coefficients due to ice clouds.
            1496     3               
            1497     4                           if ( cldice <= f_zero ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1498     5   s    v                    do ib = nblow, nbhgh
            1499     5   p    v                      tauice(ib) = f_zero
            1500     5   p    v                      ssaice(ib) = f_zero
            1501     5   p    v                      asyice(ib) = f_zero
            1502     5   p    v                    enddo
            1503     4                           else
            1504     4               
            1505     4               !  --- ...  ebert and curry approach for all particle sizes though somewhat
            1506     4               !           unjustified for large ice particles
            1507     4               
            1508     5                             if ( iswcice == 1 ) then
            1509     5                               refice = min(130.0_kind_phys,max(13.0_kind_phys,refice))
            1510     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 182
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1511     6   s    v                      do ib = nblow, nbhgh
            1512     6   p    v                        ia = idxebc(ib)           ! eb_&_c band index for ice cloud coeff
            1513     6               
            1514     6   p    v                        extcoice = max(f_zero, abari(ia)+bbari(ia)/refice )
            1515     6   p    v                        ssacoice = max(f_zero, min(f_one,                     &
            1516     6                    &                             f_one-cbari(ia)-dbari(ia)*refice ))
            1517     6   p    v                        asycoice = max(f_zero, min(f_one,                     &
            1518     6                    &                                   ebari(ia)+fbari(ia)*refice ))
            1519     6               !                 forcoice = asycoice * asycoice
            1520     6               
            1521     6   p    v                        tauice(ib) = cldice     * extcoice
            1522     6   p    v                        ssaice(ib) = tauice(ib) * ssacoice
            1523     6   p    v                        asyice(ib) = ssaice(ib) * asycoice
            1524     6   p    v                      enddo
            1525     5               
            1526     5               !  --- ...  streamer approach for ice effective radius between 5.0 and 131.0 microns
            1527     5               
            1528     5                             elseif ( iswcice == 2 ) then
            1529     5                               refice = min(131.0_kind_phys,max(5.0_kind_phys,refice))
            1530     5               
            1531     5                               factor = (refice - 2.0) / 3.0
            1532     5                               index  = max( 1, min( 42, int( factor ) ))
            1533     5                               fint   = factor - float(index)
            1534     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 187
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1535     6   s    v                      do ib = nblow, nbhgh
            1536     6   p    v                        extcoice = max(f_zero,            extice2(index,ib)   &
            1537     6                    &                + fint*(extice2(index+1,ib)-extice2(index,ib)) )
            1538     6   p    v                        ssacoice = max(f_zero, min(f_one, ssaice2(index,ib)   &
            1539     6                    &                + fint*(ssaice2(index+1,ib)-ssaice2(index,ib)) ))
            1540     6   p    v                        asycoice = max(f_zero, min(f_one, asyice2(index,ib)   &
            1541     6                    &                + fint*(asyice2(index+1,ib)-asyice2(index,ib)) ))
            1542     6               !                 forcoice = asycoice * asycoice
            1543     6               
            1544     6   p    v                        tauice(ib) = cldice     * extcoice
            1545     6   p    v                        ssaice(ib) = tauice(ib) * ssacoice
            1546     6   p    v                        asyice(ib) = ssaice(ib) * asycoice
            1547     6   p    v                      enddo
            1548     5               
            1549     5               !  --- ...  fu's approach for ice effective radius between 4.8 and 135 microns
            1550     5               !           (generalized effective size from 5 to 140 microns)
            1551     5               
            1552     5                             elseif ( iswcice == 3 ) then
            1553     5                               dgeice = max( 5.0, min( 140.0, 1.0315*refice ))
            1554     5               
            1555     5                               factor = (dgeice - 2.0) / 3.0
            1556     5                               index  = max( 1, min( 45, int( factor ) ))
            1557     5                               fint   = factor - float(index)
            1558     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 187
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1559     6   s    v                      do ib = nblow, nbhgh
            1560     6   p    v                        extcoice = max(f_zero,            extice3(index,ib)   &
            1561     6                    &                + fint*(extice3(index+1,ib)-extice3(index,ib)) )
            1562     6   p    v                        ssacoice = max(f_zero, min(f_one, ssaice3(index,ib)   &
            1563     6                    &                + fint*(ssaice3(index+1,ib)-ssaice3(index,ib)) ))
            1564     6   p    v                        asycoice = max(f_zero, min(f_one, asyice3(index,ib)   &
            1565     6                    &                + fint*(asyice3(index+1,ib)-asyice3(index,ib)) ))
            1566     6               !                 fdelta   = max(f_zero, min(f_one, fdlice3(index,ib)   &
            1567     6               !    &                + fint*(fdlice3(index+1,ib)-fdlice3(index,ib)) ))
            1568     6               !                 forcoice = min( asycoice, fdelta+0.5/ssacoice )           ! see fu 1996 p. 2067
            1569     6               
            1570     6   p    v                        tauice(ib) = cldice     * extcoice
            1571     6   p    v                        ssaice(ib) = tauice(ib) * ssacoice
            1572     6   p    v                        asyice(ib) = ssaice(ib) * asycoice
            1573     6   p    v                      enddo
            1574     5               
            1575     5                             endif   ! end if_iswcice_block
            1576     4                           endif   ! end if_cldice_block
            1577     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1578     4   s    v                  do ib = 1, nbdsw
            1579     4   p    v                    jb = nblow + ib - 1
            1580     4   p    v                    taucw(k,ib) = tauliq(jb)+tauice(jb)+tauran+tausnw
            1581     4   p    v                    ssacw(k,ib) = ssaliq(jb)+ssaice(jb)+ssaran(jb)+ssasnw(jb)
            1582     4   p    v                    asycw(k,ib) = asyliq(jb)+asyice(jb)+asyran(jb)+asysnw(jb)
            1583     4   p    v                  enddo
            1584     3               
            1585     3                         endif  lab_if_cld
            1586     2                       enddo  lab_do_k
            1587     1               
            1588     1                     else  lab_if_iswcliq
            1589     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 32
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac
                                   <<< Loop-information  End >>>
            1590     2  pp                   do k = 1, nlay
            1591     3   p                     if (cfrac(k) > ftiny) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1592     4   p    v                  do ib = 1, nbdsw
            1593     4   p    v                    taucw(k,ib) = cdat1(k)
            1594     4   p    v                    ssacw(k,ib) = cdat1(k)    * cdat2(k)
            1595     4   p    v                    asycw(k,ib) = ssacw(k,ib) * cdat3(k)
            1596     4   p    v                  enddo
            1597     3   p                     endif
            1598     2   p                   enddo
            1599     1               
            1600     1                     endif  lab_if_iswcliq
            1601                     
            1602                     !  ---  distribute cloud properties to each g-point
            1603                     
            1604     1                     if ( isubcsw > 0 ) then      ! mcica sub-col clouds approx
            1605     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac, cldf
                                   <<< Loop-information  End >>>
            1606     1  pp   4v              cldf(:) = cfrac(:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.25, ITR: 160, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldf
                                   <<< Loop-information  End >>>
            1607     1  pp   2v              where (cldf(:) < ftiny)
            1608     1   p   2v                cldf(:) = f_zero
            1609     1                       end where
            1610     1               
            1611     1               !  --- ...  call sub-column cloud generator
            1612     1               
            1613     1                       call mcica_subcol                                               &
            1614     1               !  ---  inputs:
            1615     1                    &     ( cldf, nlay, ipseed,                                        &
            1616     1               !  ---  outputs:
            1617     1                    &       lcloudy                                                    &
            1618     1                    &     )
            1619     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lcloudy, cldfmc
                                   <<< Loop-information  End >>>
            1620     2  pp                   do ig = 1, ngptsw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfmc, lcloudy
                                   <<< Loop-information  End >>>
            1621     3   p   2v                do k = 1, nlay
            1622     4   p   2v                  if ( lcloudy(k,ig) ) then
            1623     4   p   2v                    cldfmc(k,ig) = f_one
            1624     4   p   2v                  else
            1625     4   p   2v                    cldfmc(k,ig) = f_zero
            1626     4   p   2v                  endif
            1627     3   p   2v                enddo
            1628     2   p                   enddo
            1629     1               
            1630     1                     else                         ! non-mcica, normalize cloud
            1631     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac, cldfrc
                                   <<< Loop-information  End >>>
            1632     2  pp   2v              do k = 1, nlay
            1633     2   p   2v                cldfrc(k) = cfrac(k) / cf1
            1634     2   p   2v              enddo
            1635     1                     endif   ! end if_isubcsw_block
            1636                     
            1637                           return
            1638                     !...................................
            1639                           end subroutine cldprop
            1640                     !-----------------------------------
            1641                     
            1642                     
            1643                     ! ----------------------------------
            1644                           subroutine mcica_subcol                                           &
            1645                     ! ..................................
            1646                     !  ---  inputs:
            1647                          &    ( cldf, nlay, ipseed,                                         &
            1648                     !  ---  outputs:
            1649                          &      lcloudy                                                     &
            1650                          &    )
            1651                     
            1652                     !  ====================  defination of variables  ====================  !
            1653                     !                                                                       !
            1654                     !  input variables:                                                size !
            1655                     !   cldf    - real, layer cloud fraction                           nlay !
            1656                     !   nlay    - integer, number of model vertical layers               1  !
            1657                     !   ipseed  - integer, permute seed for random num generator         1  !
            1658                     !    ** note : if the cloud generator is called multiple times, need    !
            1659                     !              to permute the seed between each call; if between calls  !
            1660                     !              for lw and sw, use values differ by the number of g-pts. !
            1661                     !                                                                       !
            1662                     !  output variables:                                                    !
            1663                     !   lcloudy - logical, sub-colum cloud profile flag array    nlay*ngptsw!
            1664                     !                                                                       !
            1665                     !  other control flags from module variables:                           !
            1666                     !     iovrsw    : control flag for cloud overlapping method             !
            1667                     !                 =0:random; =1:maximum/random; =2:maximum              !
            1668                     !                                                                       !
            1669                     !                                                                       !
            1670                     !  =====================    end of definitions    ====================  !
            1671                     
            1672                           implicit none
            1673                     
            1674                     !  ---  inputs:
            1675                           integer, intent(in) :: nlay, ipseed
            1676                     
            1677                           real (kind=kind_phys), dimension(nlay), intent(in) :: cldf
            1678                     
            1679                     !  ---  outputs:
            1680                           logical, dimension(nlay,ngptsw), intent(out):: lcloudy
            1681                     
            1682                     !  ---  locals:
            1683                           real (kind=kind_phys) :: cdfunc(nlay,ngptsw), tem1,               &
            1684                          &       rand2d(nlay*ngptsw), rand1d(ngptsw)
            1685                     
            1686                           type (random_stat) :: stat          ! for thread safe random generator
            1687                     
            1688                           integer :: k, n, k1
            1689                     !
            1690                     !===> ...  begin here
            1691                     !
            1692                     !  --- ...  advance randum number generator by ipseed values
            1693                     
            1694                           call random_setseed                                               &
            1695                     !  ---  inputs:
            1696                          &    ( ipseed,                                                     &
            1697                     !  ---  outputs:
            1698                          &      stat                                                        &
            1699                          &    )
            1700                     
            1701                     !  --- ...  sub-column set up according to overlapping assumption
            1702                     
            1703     1                     select case ( iovrsw )
            1704     1               
            1705     1                       case( 0 )        ! random overlap, pick a random value at every level
            1706     1               
            1707     1                         call random_number                                            &
            1708     1               !  ---  inputs: ( none )
            1709     1               !  ---  outputs:
            1710     1                    &     ( rand2d, stat )
            1711     1               
            1712     1                         k1 = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d, cdfunc
                                   <<< Loop-information  End >>>
            1713     2   s                     do n = 1, ngptsw
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d, cdfunc
                                   <<< Loop-information  End >>>
            1714     3  pp   4v                  do k = 1, nlay
            1715     3   p   4v                    k1 = k1 + 1
            1716     3   p   4v                    cdfunc(k,n) = rand2d(k1)
            1717     3   p   4v                  enddo
            1718     2   p                     enddo
            1719     1               
            1720     1                       case( 1 )        ! max-ran overlap
            1721     1               
            1722     1                         call random_number                                            &
            1723     1               !  ---  inputs: ( none )
            1724     1               !  ---  outputs:
            1725     1                    &     ( rand2d, stat )
            1726     1               
            1727     1                         k1 = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d, cdfunc
                                   <<< Loop-information  End >>>
            1728     2   s                     do n = 1, ngptsw
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d, cdfunc
                                   <<< Loop-information  End >>>
            1729     3  pp   4v                  do k = 1, nlay
            1730     3   p   4v                    k1 = k1 + 1
            1731     3   p   4v                    cdfunc(k,n) = rand2d(k1)
            1732     3   p   4v                  enddo
            1733     2   p                     enddo
            1734     1               
            1735     1               !  ---  first pick a random number for bottom/top layer.
            1736     1               !       then walk up the column: (aer's code)
            1737     1               !       if layer below is cloudy, use the same rand num in the layer below
            1738     1               !       if layer below is clear,  use a new random number
            1739     1               
            1740     1               !  ---  from bottom up
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.62, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldf, cdfunc, (unknown)
                                   <<< Loop-information  End >>>
            1741     2   p   2m                do k = 2, nlay
            1742     2   p   2v                  k1 = k - 1
            1743     2   m   2v                  tem1 = f_one - cldf(k1)
            1744     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            1745     3  pp   2                   do n = 1, ngptsw
            1746     4   p   2m                    if ( cdfunc(k1,n) > tem1 ) then
            1747     4   p   2m                      cdfunc(k,n) = cdfunc(k1,n)
            1748     4   p   2s                    else
            1749     4   p   2s                      cdfunc(k,n) = cdfunc(k,n) * tem1
            1750     4   p   2v                    endif
            1751     3   p   2                   enddo
            1752     2   p   2v                enddo
            1753     1               
            1754     1               !  ---  then walk down the column: (if use original author's method)
            1755     1               !       if layer above is cloudy, use the same rand num in the layer above
            1756     1               !       if layer above is clear,  use a new random number
            1757     1               
            1758     1               !  ---  from top down
            1759     1               !         do k = nlay-1, 1, -1
            1760     1               !           k1 = k + 1
            1761     1               !           tem1 = f_one - cldf(k1)
            1762     1               
            1763     1               !           do n = 1, ngptsw
            1764     1               !             if ( cdfunc(k1,n) > tem1 ) then
            1765     1               !               cdfunc(k,n) = cdfunc(k1,n)
            1766     1               !             else
            1767     1               !               cdfunc(k,n) = cdfunc(k,n) * tem1
            1768     1               !             endif
            1769     1               !           enddo
            1770     1               !         enddo
            1771     1               
            1772     1                       case( 2 )        ! maximum overlap, pick same random numebr at every level
            1773     1               
            1774     1                         call random_number                                            &
            1775     1               !  ---  inputs: ( none )
            1776     1               !  ---  outputs:
            1777     1                    &     ( rand1d, stat )
            1778     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<< Loop-information  End >>>
            1779     2  pp                     do n = 1, ngptsw
            1780     2   p                       tem1 = rand1d(n)
            1781     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cdfunc
                                   <<< Loop-information  End >>>
            1782     3   p   4v                  do k = 1, nlay
            1783     3   p   4v                    cdfunc(k,n) = tem1
            1784     3   p   4v                  enddo
            1785     2   p                     enddo
            1786     1               
            1787     1                     end select
            1788                     
            1789                     !  --- ...  generate subcolumns for homogeneous clouds
            1790                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldf, cdfunc, lcloudy, (unknown)
                                   <<< Loop-information  End >>>
            1791     1   p   2v            do k = 1, nlay
            1792     1   p   2v              tem1 = f_one - cldf(k)
            1793     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cdfunc, lcloudy, (unknown)
                                   <<< Loop-information  End >>>
            1794     2  pp   2               do n = 1, ngptsw
            1795     2   p   2v                lcloudy(k,n) = cdfunc(k,n) >= tem1
            1796     2   p   2               enddo
            1797     1   p   2v            enddo
            1798                     
            1799                           return
            1800                     ! ..................................
            1801                           end subroutine mcica_subcol
            1802                     ! ----------------------------------
            1803                     
            1804                     
            1805                     ! ----------------------------------
            1806                           subroutine setcoef                                                &
            1807                     ! ..................................
            1808                     !  ---  inputs:
            1809                          &     ( pavel,tavel,h2ovmr, nlay,nlp1,                             &
            1810                     !  ---  outputs:
            1811                          &       laytrop,jp,jt,jt1,fac00,fac01,fac10,fac11,                 &
            1812                          &       selffac,selffrac,indself,forfac,forfrac,indfor             &
            1813                          &     )
            1814                     
            1815                     !  ===================  program usage description  ===================  !
            1816                     !                                                                       !
            1817                     ! purpose:  compute various coefficients needed in radiative transfer   !
            1818                     !    calculations.                                                      !
            1819                     !                                                                       !
            1820                     ! subprograms called:  none                                             !
            1821                     !                                                                       !
            1822                     !  ====================  defination of variables  ====================  !
            1823                     !                                                                       !
            1824                     !  inputs:                                                       -size- !
            1825                     !   pavel     - real, layer pressures (mb)                         nlay !
            1826                     !   tavel     - real, layer temperatures (k)                       nlay !
            1827                     !   h2ovmr    - real, layer w.v. volum mixing ratio (kg/kg)        nlay !
            1828                     !   nlay/nlp1 - integer, total number of vertical layers, levels    1   !
            1829                     !                                                                       !
            1830                     !  outputs:                                                             !
            1831                     !   laytrop   - integer, tropopause layer index (unitless)          1   !
            1832                     !   jp        - real, indices of lower reference pressure          nlay !
            1833                     !   jt, jt1   - real, indices of lower reference temperatures      nlay !
            1834                     !                 at levels of jp and jp+1                              !
            1835                     !   facij     - real, factors multiply the reference ks,           nlay !
            1836                     !                 i,j=0/1 for lower/higher of the 2 appropriate         !
            1837                     !                 temperatures and altitudes.                           !
            1838                     !   selffac   - real, scale factor for w. v. self-continuum        nlay !
            1839                     !                 equals (w. v. density)/(atmospheric density           !
            1840                     !                 at 296k and 1013 mb)                                  !
            1841                     !   selffrac  - real, factor for temperature interpolation of      nlay !
            1842                     !                 reference w. v. self-continuum data                   !
            1843                     !   indself   - integer, index of lower ref temp for selffac       nlay !
            1844                     !   forfac    - real, scale factor for w. v. foreign-continuum     nlay !
            1845                     !   forfrac   - real, factor for temperature interpolation of      nlay !
            1846                     !                 reference w.v. foreign-continuum data                 !
            1847                     !   indfor    - integer, index of lower ref temp for forfac        nlay !
            1848                     !                                                                       !
            1849                     !  ======================    end of definitions    ===================  !
            1850                     
            1851                     !  ---  inputs:
            1852                           integer, intent(in) :: nlay, nlp1
            1853                     
            1854                           real (kind=kind_phys), dimension(:), intent(in) :: pavel, tavel,  &
            1855                          &       h2ovmr
            1856                     
            1857                     !  ---  outputs:
            1858                           integer, dimension(nlay), intent(out) :: indself, indfor,         &
            1859                          &       jp, jt, jt1
            1860                           integer, intent(out) :: laytrop
            1861                     
            1862                           real (kind=kind_phys), dimension(nlay), intent(out) :: fac00,     &
            1863                          &       fac01, fac10, fac11, selffac, selffrac, forfac, forfrac
            1864                     
            1865                     !  ---  locals:
            1866                           real (kind=kind_phys) :: plog, fp, fp1, ft, ft1, tem1, tem2
            1867                     
            1868                           integer :: i, k, jp1
            1869                     !
            1870                     !===> ... begin here
            1871                     !
            1872                           laytrop= nlay
            1873                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 25
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1874     1  pp    v            do k = 1, nlay
            1875     1               
            1876     1   p    v              forfac(k) = pavel(k)*stpfac / (tavel(k)*(f_one + h2ovmr(k)))
            1877     1               
            1878     1               !  --- ...  find the two reference pressures on either side of the
            1879     1               !           layer pressure.  store them in jp and jp1.  store in fp the
            1880     1               !           fraction of the difference (in ln(pressure)) between these
            1881     1               !           two values that the layer pressure lies.
            1882     1               
            1883     1   p    v              plog  = log(pavel(k))
            1884     1   p    v              jp(k) = max(1, min(58, int(36.0 - 5.0*(plog+0.04)) ))
            1885     1   p    v              jp1   = jp(k) + 1
            1886     1   p    v              fp    = 5.0 * (preflog(jp(k)) - plog)
            1887     1               
            1888     1               !  --- ...  determine, for each reference pressure (jp and jp1), which
            1889     1               !          reference temperature (these are different for each reference
            1890     1               !          pressure) is nearest the layer temperature but does not exceed it.
            1891     1               !          store these indices in jt and jt1, resp. store in ft (resp. ft1)
            1892     1               !          the fraction of the way between jt (jt1) and the next highest
            1893     1               !          reference temperature that the layer temperature falls.
            1894     1               
            1895     1   p    v              tem1 = (tavel(k) - tref(jp(k))) / 15.0
            1896     1   p    v              tem2 = (tavel(k) - tref(jp1  )) / 15.0
            1897     1   p    v              jt (k) = max(1, min(4, int(3.0 + tem1) ))
            1898     1   p    v              jt1(k) = max(1, min(4, int(3.0 + tem2) ))
            1899     1   p    v              ft  = tem1 - float(jt (k) - 3)
            1900     1   p    v              ft1 = tem2 - float(jt1(k) - 3)
            1901     1               
            1902     1               !  --- ...  we have now isolated the layer ln pressure and temperature,
            1903     1               !           between two reference pressures and two reference temperatures
            1904     1               !           (for each reference pressure).  we multiply the pressure
            1905     1               !           fraction fp with the appropriate temperature fractions to get
            1906     1               !           the factors that will be needed for the interpolation that yields
            1907     1               !           the optical depths (performed in routines taugbn for band n).
            1908     1               
            1909     1   p    v              fp1 = f_one - fp
            1910     1   p    v              fac10(k) = fp1 * ft
            1911     1   p    v              fac00(k) = fp1 * (f_one - ft)
            1912     1   p    v              fac11(k) = fp  * ft1
            1913     1   p    v              fac01(k) = fp  * (f_one - ft1)
            1914     1               
            1915     1               !  --- ...  if the pressure is less than ~100mb, perform a different
            1916     1               !           set of species interpolations.
            1917     1               
            1918     2   p    v              if ( plog > 4.56 ) then
            1919     2               
            1920     2   p    v                laytrop =  k
            1921     2               
            1922     2               !  --- ...  set up factors needed to separately include the water vapor
            1923     2               !           foreign-continuum in the calculation of absorption coefficient.
            1924     2               
            1925     2   p    v                tem1 = (332.0 - tavel(k)) / 36.0
            1926     2   p    v                indfor (k) = min(2, max(1, int(tem1)))
            1927     2   p    v                forfrac(k) = tem1 - float(indfor(k))
            1928     2               
            1929     2               !  --- ...  set up factors needed to separately include the water vapor
            1930     2               !           self-continuum in the calculation of absorption coefficient.
            1931     2               
            1932     2   p    v                tem2 = (tavel(k) - 188.0) / 7.2
            1933     2   p    v                indself (k) = min(9, max(1, int(tem2)-7))
            1934     2   p    v                selffrac(k) = tem2 - float(indself(k) + 7)
            1935     2   p    v                selffac (k) = h2ovmr(k) * forfac(k)
            1936     2               
            1937     2   p                   else
            1938     2               
            1939     2               !  --- ...  set up factors needed to separately include the water vapor
            1940     2               !           foreign-continuum in the calculation of absorption coefficient.
            1941     2               
            1942     2   p    v                tem1 = (tavel(k) - 188.0) / 36.0
            1943     2   p    v                indfor (k) = 3
            1944     2   p    v                forfrac(k) = tem1 - f_one
            1945     2               
            1946     2   p    v                indself (k) = 0
            1947     2   p    v                selffrac(k) = f_zero
            1948     2   p    v                selffac (k) = f_zero
            1949     2               
            1950     2   p    v              endif
            1951     1               
            1952     1   p    v            enddo    ! end_do_k_loop
            1953                     
            1954                           return
            1955                     ! ..................................
            1956                           end subroutine setcoef
            1957                     ! ----------------------------------
            1958                     
            1959                     
            1960                     !-----------------------------------
            1961                           subroutine spcvrtc                                                &
            1962                     !...................................
            1963                     !  ---  inputs:
            1964                          &     ( ssolar,cosz,sntz,albbm,albdf,sfluxzen,cldfrc,              &
            1965                          &       cf1,cf0,taug,taur,tauae,ssaae,asyae,taucw,ssacw,asycw,     &
            1966                          &       nlay, nlp1,                                                &
            1967                     !  ---  outputs:
            1968                          &       fxupc,fxdnc,fxup0,fxdn0,                                   &
            1969                          &       ftoauc,ftoau0,ftoadc,fsfcuc,fsfcu0,fsfcdc,fsfcd0,          &
            1970                          &       sfbmc,sfdfc,sfbm0,sfdf0,suvbfc,suvbf0                      &
            1971                          &     )
            1972                     
            1973                     !  ===================  program usage description  ===================  !
            1974                     !                                                                       !
            1975                     !   purpose:  computes the shortwave radiative fluxes using two-stream  !
            1976                     !             method                                                    !
            1977                     !                                                                       !
            1978                     !   subprograms called:  swflux                                         !
            1979                     !                                                                       !
            1980                     !  ====================  defination of variables  ====================  !
            1981                     !                                                                       !
            1982                     !  inputs:                                                        size  !
            1983                     !    ssolar  - real, incoming solar flux at top                    1    !
            1984                     !    cosz    - real, cosine solar zenith angle                     1    !
            1985                     !    sntz    - real, secant solar zenith angle                     1    !
            1986                     !    albbm   - real, surface albedo for direct beam radiation      2    !
            1987                     !    albdf   - real, surface albedo for diffused radiation         2    !
            1988                     !    sfluxzen- real, spectral distribution of incoming solar flux ngptsw!
            1989                     !    cldfrc  - real, layer cloud fraction                         nlay  !
            1990                     !    cf1     - real, >0: cloudy sky, otherwise: clear sky          1    !
            1991                     !    cf0     - real, =1-cf1                                        1    !
            1992                     !    taug    - real, spectral optical depth for gases        nlay*ngptsw!
            1993                     !    taur    - real, optical depth for rayleigh scattering   nlay*ngptsw!
            1994                     !    tauae   - real, aerosols optical depth                  nlay*nbdsw !
            1995                     !    ssaae   - real, aerosols single scattering albedo       nlay*nbdsw !
            1996                     !    asyae   - real, aerosols asymmetry factor               nlay*nbdsw !
            1997                     !    taucw   - real, weighted cloud optical depth            nlay*nbdsw !
            1998                     !    ssacw   - real, weighted cloud single scat albedo       nlay*nbdsw !
            1999                     !    asycw   - real, weighted cloud asymmetry factor         nlay*nbdsw !
            2000                     !    nlay,nlp1 - integer,  number of layers/levels                 1    !
            2001                     !                                                                       !
            2002                     !  output variables:                                                    !
            2003                     !    fxupc   - real, tot sky upward flux                     nlp1*nbdsw !
            2004                     !    fxdnc   - real, tot sky downward flux                   nlp1*nbdsw !
            2005                     !    fxup0   - real, clr sky upward flux                     nlp1*nbdsw !
            2006                     !    fxdn0   - real, clr sky downward flux                   nlp1*nbdsw !
            2007                     !    ftoauc  - real, tot sky toa upwd flux                         1    !
            2008                     !    ftoau0  - real, clr sky toa upwd flux                         1    !
            2009                     !    ftoadc  - real, toa downward (incoming) solar flux            1    !
            2010                     !    fsfcuc  - real, tot sky sfc upwd flux                         1    !
            2011                     !    fsfcu0  - real, clr sky sfc upwd flux                         1    !
            2012                     !    fsfcdc  - real, tot sky sfc dnwd flux                         1    !
            2013                     !    fsfcd0  - real, clr sky sfc dnwd flux                         1    !
            2014                     !    sfbmc   - real, tot sky sfc dnwd beam flux (nir/uv+vis)       2    !
            2015                     !    sfdfc   - real, tot sky sfc dnwd diff flux (nir/uv+vis)       2    !
            2016                     !    sfbm0   - real, clr sky sfc dnwd beam flux (nir/uv+vis)       2    !
            2017                     !    sfdf0   - real, clr sky sfc dnwd diff flux (nir/uv+vis)       2    !
            2018                     !    suvbfc  - real, tot sky sfc dnwd uv-b flux                    1    !
            2019                     !    suvbf0  - real, clr sky sfc dnwd uv-b flux                    1    !
            2020                     !                                                                       !
            2021                     !  internal variables:                                                  !
            2022                     !    zrefb   - real, direct beam reflectivity for clear/cloudy    nlp1  !
            2023                     !    zrefd   - real, diffuse reflectivity for clear/cloudy        nlp1  !
            2024                     !    ztrab   - real, direct beam transmissivity for clear/cloudy  nlp1  !
            2025                     !    ztrad   - real, diffuse transmissivity for clear/cloudy      nlp1  !
            2026                     !    zldbt   - real, layer beam transmittance for clear/cloudy    nlp1  !
            2027                     !    ztdbt   - real, lev total beam transmittance for clr/cld     nlp1  !
            2028                     !                                                                       !
            2029                     !  control parameters in module "physpara"                              !
            2030                     !    iswmode - control flag for 2-stream transfer schemes               !
            2031                     !              = 1 delta-eddington    (joseph et al., 1976)             !
            2032                     !              = 2 pifm               (zdunkowski et al., 1980)         !
            2033                     !              = 3 discrete ordinates (liou, 1973)                      !
            2034                     !                                                                       !
            2035                     !  *******************************************************************  !
            2036                     !  original code description                                            !
            2037                     !                                                                       !
            2038                     !  method:                                                              !
            2039                     !  -------                                                              !
            2040                     !     standard delta-eddington, p.i.f.m., or d.o.m. layer calculations. !
            2041                     !     kmodts  = 1 eddington (joseph et al., 1976)                       !
            2042                     !             = 2 pifm (zdunkowski et al., 1980)                        !
            2043                     !             = 3 discrete ordinates (liou, 1973)                       !
            2044                     !                                                                       !
            2045                     !  modifications:                                                       !
            2046                     !  --------------                                                       !
            2047                     !   original: h. barker                                                 !
            2048                     !   revision: merge with rrtmg_sw: j.-j.morcrette, ecmwf, feb 2003      !
            2049                     !   revision: add adjustment for earth/sun distance:mjiacono,aer,oct2003!
            2050                     !   revision: bug fix for use of palbp and palbd: mjiacono, aer, nov2003!
            2051                     !   revision: bug fix to apply delta scaling to clear sky: aer, dec2004 !
            2052                     !   revision: code modified so that delta scaling is not done in cloudy !
            2053                     !             profiles if routine cldprop is used; delta scaling can be !
            2054                     !             applied by swithcing code below if cldprop is not used to !
            2055                     !             get cloud properties. aer, jan 2005                       !
            2056                     !   revision: uniform formatting for rrtmg: mjiacono, aer, jul 2006     !
            2057                     !   revision: use exponential lookup table for transmittance: mjiacono, !
            2058                     !             aer, aug 2007                                             !
            2059                     !                                                                       !
            2060                     !  *******************************************************************  !
            2061                     !  ======================  end of description block  =================  !
            2062                     
            2063                     !  ---  constant parameters:
            2064                           real (kind=kind_phys), parameter :: zcrit = 0.9999995 ! thresold for conservative scattering
            2065                           real (kind=kind_phys), parameter :: zsr3  = sqrt(3.0)
            2066                           real (kind=kind_phys), parameter :: od_lo = 0.06
            2067                           real (kind=kind_phys), parameter :: eps1  = 1.0e-8
            2068                     
            2069                     !  ---  inputs:
            2070                           integer, intent(in) :: nlay, nlp1
            2071                     
            2072                           real (kind=kind_phys), dimension(nlay,ngptsw), intent(in) ::      &
            2073                          &       taug, taur
            2074                           real (kind=kind_phys), dimension(nlay,nbdsw),  intent(in) ::      &
            2075                          &       taucw, ssacw, asycw, tauae, ssaae, asyae
            2076                     
            2077                           real (kind=kind_phys), dimension(ngptsw), intent(in) :: sfluxzen
            2078                           real (kind=kind_phys), dimension(nlay),   intent(in) :: cldfrc
            2079                     
            2080                           real (kind=kind_phys), dimension(2),  intent(in) :: albbm, albdf
            2081                     
            2082                           real (kind=kind_phys), intent(in) :: cosz, sntz, cf1, cf0, ssolar
            2083                     
            2084                     !  ---  outputs:
            2085                           real (kind=kind_phys), dimension(nlp1,nbdsw), intent(out) ::      &
            2086                          &       fxupc, fxdnc, fxup0, fxdn0
            2087                     
            2088                           real (kind=kind_phys), dimension(2), intent(out) :: sfbmc, sfdfc, &
            2089                          &       sfbm0, sfdf0
            2090                     
            2091                           real (kind=kind_phys), intent(out) :: suvbfc, suvbf0, ftoadc,     &
            2092                          &       ftoauc, ftoau0, fsfcuc, fsfcu0, fsfcdc, fsfcd0
            2093                     
            2094                     !  ---  locals:
            2095                           real (kind=kind_phys), dimension(nlay) :: ztaus, zssas, zasys,    &
            2096                          &       zldbt0
            2097                     
            2098                           real (kind=kind_phys), dimension(nlp1) :: zrefb, zrefd, ztrab,    &
            2099                          &       ztrad, ztdbt, zldbt, zfu, zfd
            2100                     
            2101                           real (kind=kind_phys) :: ztau1, zssa1, zasy1, ztau0, zssa0,       &
            2102                          &       zasy0, zasy3, zssaw, zasyw, zgam1, zgam2, zgam3, zgam4,    &
            2103                          &       zc0, zc1, za1, za2, zb1, zb2, zrk, zrk2, zrp, zrp1, zrm1,  &
            2104                          &       zrpp, zrkg1, zrkg3, zrkg4, zexp1, zexm1, zexp2, zexm2,     &
            2105                          &       zexp3, zexp4, zden1, ze1r45, ftind, zsolar, zrefb1,        &
            2106                          &       zrefd1, ztrab1, ztrad1, ztdbt0, zr1, zr2, zr3, zr4, zr5,   &
            2107                          &       zt1, zt2, zt3, zf1, zf2
            2108                     
            2109                           integer :: ib, ibd, jb, jg, k, kp, itind
            2110                     !
            2111                     !===> ...  begin here
            2112                     !
            2113                     !  --- ... initialization of output fluxes
            2114                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fxup0, fxdn0, fxupc, fxdnc
                                   <<< Loop-information  End >>>
            2115     1  pp   2v            do ib = 1, nbdsw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2116     2   p   2               do k = 1, nlp1
            2117     2   p   2v                fxdnc(k,ib) = f_zero
            2118     2   p   2v                fxupc(k,ib) = f_zero
            2119     2   p   2v                fxdn0(k,ib) = f_zero
            2120     2   p   2v                fxup0(k,ib) = f_zero
            2121     2   p   2v              enddo
            2122     1   p                 enddo
            2123                     
            2124                           ftoadc = f_zero
            2125                           ftoauc = f_zero
            2126                           ftoau0 = f_zero
            2127                           fsfcuc = f_zero
            2128                           fsfcu0 = f_zero
            2129                           fsfcdc = f_zero
            2130                           fsfcd0 = f_zero
            2131                     
            2132                     !! --- ...  uv-b surface downward fluxes
            2133                           suvbfc  = f_zero
            2134                           suvbf0  = f_zero
            2135                     
            2136                     !! --- ...  output surface flux components
            2137                           sfbmc(1) = f_zero
            2138                           sfbmc(2) = f_zero
            2139                           sfdfc(1) = f_zero
            2140                           sfdfc(2) = f_zero
            2141                           sfbm0(1) = f_zero
            2142                           sfbm0(2) = f_zero
            2143                           sfdf0(1) = f_zero
            2144                           sfdf0(2) = f_zero
            2145                     
            2146                     !  --- ...  loop over all g-points in each band
            2147                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zfd, fxdn0, fxup0, zfu, fxdnc, fxupc
                                   <<< Loop-information  End >>>
            2148     1                     lab_do_jg : do jg = 1, ngptsw
            2149     1               
            2150     1                       jb = ngb(jg)
            2151     1                       ib = jb + 1 - nblow
            2152     1                       ibd = idxsfc(jb)
            2153     1               
            2154     1                       zsolar = ssolar * sfluxzen(jg)
            2155     1               
            2156     1               !  --- ...  set up toa direct beam and surface values (beam and diff)
            2157     1               
            2158     1                       ztdbt(nlp1) = f_one
            2159     1                       ztdbt0   = f_one
            2160     1               
            2161     1                       zldbt(1) = f_zero
            2162     2                       if (ibd /= 0) then
            2163     2                         zrefb(1) = albbm(ibd)
            2164     2                         zrefd(1) = albdf(ibd)
            2165     2                       else
            2166     2                         zrefb(1) = 0.5 * (albbm(1) + albbm(2))
            2167     2                         zrefd(1) = 0.5 * (albdf(1) + albdf(2))
            2168     2                       endif
            2169     1                       ztrab(1) = f_zero
            2170     1                       ztrad(1) = f_zero
            2171     1               
            2172     1               !  --- ...  compute clear-sky optical parameters, layer reflectance and transmittance
            2173     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taur, tauae, taug, ssaae, asyae, ztaus
                                   <<<      zssas, zasys, zrefd, ztrad, ztdbt, zldbt
                                   <<<      zldbt0
                                   <<< Loop-information  End >>>
            2174     2   s    s              do k = nlay, 1, -1
            2175     2   p    v                kp = k + 1
            2176     2               
            2177     2   p    v                ztau0 = max( ftiny, taur(k,jg)+taug(k,jg)+tauae(k,ib) )
            2178     2   p    v                zssa0 = taur(k,jg) + tauae(k,ib)*ssaae(k,ib)
            2179     2   p    v                zasy0 = asyae(k,ib)*ssaae(k,ib)*tauae(k,ib)
            2180     2   p    v                zssaw = min( oneminus, zssa0 / ztau0 )
            2181     2   p    v                zasyw = zasy0 / max( ftiny, zssa0 )
            2182     2               
            2183     2               !  --- ...  saving clear-sky quantities for later total-sky usage
            2184     2   p    v                ztaus(k) = ztau0
            2185     2   p    v                zssas(k) = zssa0
            2186     2   p    v                zasys(k) = zasy0
            2187     2               
            2188     2               !  --- ...  delta scaling for clear-sky condition
            2189     2   p    v                za1 = zasyw * zasyw
            2190     2   p    v                za2 = zssaw * za1
            2191     2               
            2192     2   p    v                ztau1 = (f_one - za2) * ztau0
            2193     2   p    v                zssa1 = (zssaw - za2) / (f_one - za2)
            2194     2               !org      zasy1 = (zasyw - za1) / (f_one - za1)   ! this line is replaced by the next
            2195     2   p    v                zasy1 = zasyw / (f_one + zasyw)         ! to reduce truncation error
            2196     2   p    v                zasy3 = 0.75 * zasy1
            2197     2               
            2198     2               !  --- ...  general two-stream expressions
            2199     3   p    v                if ( iswmode == 1 ) then
            2200     3                           zgam1 = 1.75 - zssa1 * (f_one + zasy3)
            2201     3                           zgam2 =-0.25 + zssa1 * (f_one - zasy3)
            2202     3                           zgam3 = 0.5  - zasy3 * cosz
            2203     3   p    v                elseif ( iswmode == 2 ) then               ! pifm
            2204     3   p    v                  zgam1 = 2.0 - zssa1 * (1.25 + zasy3)
            2205     3   p    v                  zgam2 = 0.75* zssa1 * (f_one- zasy1)
            2206     3   p    v                  zgam3 = 0.5 - zasy3 * cosz
            2207     3                         elseif ( iswmode == 3 ) then               ! discrete ordinates
            2208     3                           zgam1 = zsr3 * (2.0 - zssa1 * (1.0 + zasy1)) * 0.5
            2209     3                           zgam2 = zsr3 * zssa1 * (1.0 - zasy1) * 0.5
            2210     3                           zgam3 = (1.0 - zsr3 * zasy1 * cosz) * 0.5
            2211     3   p    v                endif
            2212     2   p    v                zgam4 = f_one - zgam3
            2213     2               
            2214     2               !  --- ...  compute homogeneous reflectance and transmittance
            2215     2               
            2216     3   p    s                if ( zssaw >= zcrit ) then    ! for conservative scattering
            2217     3   p    s                  za1 = zgam1 * cosz - zgam3
            2218     3   p    s                  za2 = zgam1 * ztau1
            2219     3               
            2220     3               !  --- ...  use exponential lookup table for transmittance, or expansion
            2221     3               !           of exponential for low optical depth
            2222     3               
            2223     3   p    s                  zb1 = min ( ztau1*sntz , 500.0 )
            2224     4   p    s                  if ( zb1 <= od_lo ) then
            2225     4   p    s                    zb2 = f_one - zb1 + 0.5*zb1*zb1
            2226     4   p    s                  else
            2227     4   p    s                    ftind = zb1 / (bpade + zb1)
            2228     4   p    s                    itind = ftind*ntbmx + 0.5
            2229     4   p    s                    zb2 = exp_tbl(itind)
            2230     4   p    s                  endif
            2231     3               
            2232     3               !      ...  collimated beam
            2233     3   p    s                  zrefb(kp) = max(f_zero, min(f_one,                          &
            2234     3                    &                  (za2 - za1*(f_one - zb2))/(f_one + za2) ))
            2235     3   p    s                  ztrab(kp) = max(f_zero, min(f_one, f_one-zrefb(kp) ))
            2236     3               
            2237     3               !      ...  isotropic incidence
            2238     3   p    s                  zrefd(kp) = max(f_zero, min(f_one, za2/(f_one + za2) ))
            2239     3   p    m                  ztrad(kp) = max(f_zero, min(f_one, f_one-zrefd(kp) ))
            2240     3               
            2241     3   p    s                else                          ! for non-conservative scattering
            2242     3   p    s                  za1 = zgam1*zgam4 + zgam2*zgam3
            2243     3   p    s                  za2 = zgam1*zgam3 + zgam2*zgam4
            2244     3   p    s                  zrk = sqrt ( (zgam1 - zgam2) * (zgam1 + zgam2) )
            2245     3   p    s                  zrk2= 2.0 * zrk
            2246     3               
            2247     3   p    s                  zrp  = zrk * cosz
            2248     3   p    s                  zrp1 = f_one + zrp
            2249     3   p    s                  zrm1 = f_one - zrp
            2250     3   p    s                  zrpp = f_one - zrp*zrp
            2251     3   p    s                  zrkg1= zrk + zgam1
            2252     3   p    s                  zrkg3= zrk * zgam3
            2253     3   p    s                  zrkg4= zrk * zgam4
            2254     3               
            2255     3   p    s                  zr1  = zrm1 * (za2 + zrkg3)
            2256     3   p    s                  zr2  = zrp1 * (za2 - zrkg3)
            2257     3   p    s                  zr3  = zrk2 * (zgam3 - za2*cosz)
            2258     3   p    s                  zr4  = zrpp * zrkg1
            2259     3   p    s                  zr5  = zrpp * (zrk - zgam1)
            2260     3               
            2261     3   p    s                  zt1  = zrp1 * (za1 + zrkg4)
            2262     3   p    s                  zt2  = zrm1 * (za1 - zrkg4)
            2263     3   p    s                  zt3  = zrk2 * (zgam4 + za1*cosz)
            2264     3               
            2265     3               !  --- ...  use exponential lookup table for transmittance, or expansion
            2266     3               !           of exponential for low optical depth
            2267     3               
            2268     3   p    s                  zb1 = min ( zrk*ztau1, 500.0 )
            2269     4   p    s                  if ( zb1 <= od_lo ) then
            2270     4   p    m                    zexm1 = f_one - zb1 + 0.5*zb1*zb1
            2271     4   p    s                  else
            2272     4   p    s                    ftind = zb1 / (bpade + zb1)
            2273     4   p    s                    itind = ftind*ntbmx + 0.5
            2274     4   p    s                    zexm1 = exp_tbl(itind)
            2275     4   p    s                  endif
            2276     3   p    s                  zexp1 = f_one / zexm1
            2277     3               
            2278     3   p    s                  zb2 = min ( sntz*ztau1, 500.0 )
            2279     4   p    s                  if ( zb2 <= od_lo ) then
            2280     4   p    m                    zexm2 = f_one - zb2 + 0.5*zb2*zb2
            2281     4   p    s                  else
            2282     4   p    s                    ftind = zb2 / (bpade + zb2)
            2283     4   p    s                    itind = ftind*ntbmx + 0.5
            2284     4   p    s                    zexm2 = exp_tbl(itind)
            2285     4   p    s                  endif
            2286     3   p    s                  zexp2 = f_one / zexm2
            2287     3   p    s                  ze1r45 = zr4*zexp1 + zr5*zexm1
            2288     3               
            2289     3               !      ...  collimated beam
            2290     4   p    s                  if (ze1r45>=-eps1 .and. ze1r45<=eps1) then
            2291     4   p    s                    zrefb(kp) = eps1
            2292     4   p    m                    ztrab(kp) = zexm2
            2293     4   p    s                  else

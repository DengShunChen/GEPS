            4411                     !  ------------------------------------------------------------------  !
            4412                     !
            4413                           use module_radsw_kgb23
            4414                     
            4415                     !  ---  locals:
            4416                           integer :: ind01, ind02, ind11, ind12
            4417                           integer :: inds, indf, indsp, indfp, j, k
            4418                     
            4419                     !
            4420                     !===> ... begin here
            4421                     !
            4422                     
            4423                     !  --- ...  compute the optical depth by interpolating in ln(pressure),
            4424                     !           temperature, and appropriate species.  below laytrop, the water
            4425                     !           vapor self-continuum is interpolated (in temperature) separately.
            4426                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colmol, taur
                                   <<< Loop-information  End >>>
            4427     1   p   2v            do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colmol, taur
                                   <<< Loop-information  End >>>
            4428     2  pp   2               do j = 1, ng23
            4429     2   p   2v                taur(k,ns23+j) = colmol(k) * rayl(j)
            4430     2   p   2               enddo
            4431     1   p                 enddo
            4432                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8,16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.21, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      indfor, id1, indself, id0, forfrac
                                   <<<      forfac, fac11, fac10, fac00, fac01
                                   <<<      selffrac, selffac, (unknown)
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      colamt: 2, taug: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4433     1   p    v            do k = 1, laytrop
            4434     1   p    v              ind01 = id0(k,23) + 1
            4435     1   p    v              ind02 = ind01 + 1
            4436     1   p    v              ind11 = id1(k,23) + 1
            4437     1   p    v              ind12 = ind11 + 1
            4438     1               
            4439     1   p    v              inds = indself(k)
            4440     1   p    v              indf = indfor (k)
            4441     1   p    v              indsp= inds + 1
            4442     1   m    v              indfp= indf + 1
            4443     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            4444     2  pp                   do j = 1, ng23
            4445     2   p    v                taug(k,ns23+j) = colamt(k,1) * (givfac                        &
            4446     2                    &        * ( fac00(k)*absa(ind01,j) + fac10(k)*absa(ind02,j)       &
            4447     2                    &        +   fac01(k)*absa(ind11,j) + fac11(k)*absa(ind12,j) )     &
            4448     2                    &        + selffac(k) * (selfref(inds,j) + selffrac(k)             &
            4449     2                    &        * (selfref(indsp,j) - selfref(inds,j)))                   &
            4450     2                    &        + forfac(k) * (forref(indf,j) + forfrac(k)                &
            4451     2                    &        * (forref(indfp,j) - forref(indf,j))))
            4452     2   p                   enddo
            4453     1   p    v            enddo
            4454                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taug
                                   <<< Loop-information  End >>>
            4455     1   p   4v            do k = laytrop+1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            4456     2  pp   4               do j = 1, ng23
            4457     2   p   4v                taug(k,ns23+j) = f_zero
            4458     2   p   4               enddo
            4459     1   p                 enddo
            4460                     
            4461                     !...................................
            4462                           end subroutine taumol23

            4783     1   p                   fac010 = fs1 * fac10(k)
            4784     1   p                   fac100 = fs  * fac00(k)
            4785     1   p                   fac110 = fs  * fac10(k)
            4786     1   p                   fac001 = fs1 * fac01(k)
            4787     1   p                   fac011 = fs1 * fac11(k)
            4788     1   p                   fac101 = fs  * fac01(k)
            4789     1   p                   fac111 = fs  * fac11(k)

 External subroutine subprogram "tranrs_dp"
  (inc)(line-no.)(nest)(optimize)
             232                     !
             233                           subroutine tranrs_dp (jtrun,jtmax,nx,my,my_max,lev,poly,w,cc  &
             234                                             ,wss,num,nsize)
             235                     !
             236                     !  subroutine to transform a scalar grid point field to spectral
             237                     !  coefficients
             238                     !
             239                     ! *** input ***
             240                     !
             241                     !  jtrun: zonal wavenumber truncation limit
             242                     !  jtmax: maximum amount of zonal waves located in each pe
             243                     !  nx: e-w dimension no.
             244                     !  my: n-s dimension no.
             245                     !  my_max: maximum amount of n-s grids located in each pe
             246                     !  lev: number of vertical levels to transform
             247                     !  poly: legendre polynomials
             248                     !  w: gaussian quadrature weights
             249                     !  cc_r8: 3-dim input grid pt. field to be transformed
             250                     !  num: number of variables grouped together
             251                     !
             252                     ! *** output ***
             253                     !
             254                     !  wss: spectral coefficient fields
             255                     !
             256                     !  **********************************
             257                     !
             258                           use const, only : RTYPE
             259                           use index
             260                     !     use paramt
             261                           use fftcom
             262                           use fj_pad
             263                     !
             264                           implicit none
             265                     
             266                           integer jtrun,jtmax,nx,my,my_max,lev,num,nsize
             267                           integer mlx,myhalf,lev2,nxj,j,jj,mchk,jtrunj,m,mm,mp
             268                           integer mlst,ii,k,mm1,mp1,mlst1,mm2,mp2,mlst2,mm3,mp3,mlst3,mf
             269                           integer lchk,lle,jlistnum_fj,j_fj,j1,j2,l,l_fj,llistnum_fj
             270                     
             271                           real(kind=RTYPE)    poly(jtrun,my/2,jtmax),w(my)
             272                           real    wss(lev,2,num,jtrun,jtmax)
             273                     !
             274                           real    gwk1(nx+2,lev,num,my_max)
             275                     !
             276                           real    wcc_fk (lev,2,num,jtmax,my_max*nsize)
             277                           real    twcc_fk(lev,2,num,jtmax*nsize,my_max)
             278                           real(kind=RTYPE)    cc(nx+2,lev,num,my_max)
             279                           real    cc8(nx+2,lev,num,my_max)

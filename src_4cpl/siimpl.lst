                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wrk1, wrk3, wrk2, divavg
                                   <<< Loop-information  End >>>
             111     3  pp    v                do k=1,lev
             112     3   p    v                   divavg(k,1)= wrk1(k,1,m)+dd*wrk3(k,1,m)-wrk2(k,1,m)
             113     3   p    v                   divavg(k,2)= wrk1(k,2,m)+dd*wrk3(k,2,m)-wrk2(k,2,m)
             114     3   p    v                enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      divavg
                                   <<< Loop-information  End >>>
             115     3  pp                     do 130 k = 1, lev
             116     3   p                       s1= spalm(k)*(ploldL(m,1)+dd*pltenL(m,1)-plnowL(m,1))
             117     3   p                       s2= spalm(k)*(ploldL(m,2)+dd*pltenL(m,2)-plnowL(m,2))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.06, ITR: 512, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      divavg
                                   <<< Loop-information  End >>>
             118     4   p   8v                  do 125 L = 1, lev
             119     4   p   8v                    s1= s1+arrhyd(k,L)*divavg(L,1)
             120     4   p   8v                    s2= s2+arrhyd(k,L)*divavg(L,2)
             121     4   p   8v        125       continue
             122     3   p                       phiave(k,1,n)= eps4L(m)*s1
             123     3   p                       phiave(k,2,n)= eps4L(m)*s2
             124     3   p                       wrk6(k,1,m)= dd*(phiave(k,1,n)+wrk6(k,1,m))  &
             125     3                                          - wrk5(k,1,m)+wrk4(k,1,m)
             126     3   p                       wrk6(k,2,m)= dd*(phiave(k,2,n)+wrk6(k,2,m))  &
             127     3                                          - wrk5(k,2,m)+wrk4(k,2,m)
             128     3   p             130     continue
             129     2                       endif
             130     1               !
             131     1               ! transform time averaged divergence to eigenspace and compute
             132     1               ! semi-implicit values
             133     1               !
             134     2                       if (n.eq.1) then
             135     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wrk6
                                   <<< Loop-information  End >>>
             136     3  pp   2v                do 160 l = 1, lev

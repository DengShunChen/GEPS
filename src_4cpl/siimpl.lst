             175     4   p   8v                    s2= s2-arsddt(k,L)*wrk6(L,2,m)
             176     4   p   8v        200       continue
             177     3   p                       wrk3(k,1,m)= s1
             178     3   p                       wrk3(k,2,m)= s2

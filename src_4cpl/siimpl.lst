             148     4   p   8v                    d2= d2+evecin(L,k)*wrk6(k,2,m)
             149     4   p   8v        162       continue
             150     3   p                       divavg(L,1)= d1*eps4e(L,n)
             151     3   p                       divavg(L,2)= d2*eps4e(L,n)

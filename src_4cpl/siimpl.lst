             165     1               !
             166     1               ! add contributions of time averaged divergence to temperature
             167     1               ! tendency
             168     1               !
             169     2                       if (n.ne.1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wrk6
                                   <<< Loop-information  End >>>
             170     3  pp                     do 205 k = 1, lev
             171     3   p                       s1=wrk3(k,1,m)
             172     3   p                       s2=wrk3(k,2,m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.06, ITR: 512, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wrk6
                                   <<< Loop-information  End >>>

              76                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
              77                     #else
              78                           call mpe2d_reshape_pl(plten, pltenL)
              79                           call mpe2d_reshape_pl(plnow, plnowL)
              80                           call mpe2d_reshape_pl(plold, ploldL)
              81                     
              82                           call mpe2d_transpose_siimpl(temold, &
              83                                                        wrk1 , &
              84                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
              85                           call mpe2d_transpose_siimpl(temnow, &
              86                                                        wrk2 , &
              87                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
              88                           call mpe2d_transpose_siimpl(temten, &
              89                                                        wrk3 , &
              90                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
              91                           call mpe2d_transpose_siimpl(divold, &
              92                                                        wrk4 , &
              93                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
              94                           call mpe2d_transpose_siimpl(divnow, &
              95                                                        wrk5 , &
              96                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
              97                           call mpe2d_transpose_siimpl(divten, &
              98                                                        wrk6 , &
              99                                                        levp,jtrun,jtmax,lev,jtp,jtf,mlistnum,mlist,nsizex,row_comm)
             100                     #endif

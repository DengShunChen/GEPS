 External subroutine subprogram "siimpl"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine siimpl( jtrun,jtmax,lev,dta,ptmean,dsigma,spalm,eps4    &
               2                                     , eigval,evecin,evectr,arrhyd,arsddt,temold,divold,plold &
               3                                     , temnow,divnow,plnow,temten,divten,plten,alpha )
               4                     !
               5                     !
               6                     !  computes corrections to explicit tendencies to convert model to a
               7                     !  semi-implicit model
               8                     !
               9                     !  *** input ***
              10                     !
              11                     !  dta: time step in seconds
              12                     !  ptmean: mean terrain pressure chosen for best stability properties
              13                     !  dsigma: thickness of sigma layers
              14                     !  spalm: mean energy conversion terms for each level
              15                     !  eps4: spherical harmonic laplacian operator
              16                     !  eigval: gravity mode phase speed eigenvalues
              17                     !  evecin: inverse of gravity mode eigenvector matrix
              18                     !  evectr: gravity mode eigenvector matrix
              19                     !  arrhyd: linearized hydrostatic matrix
              20                     !  arsddt: linerized vertical temperature advection matrix
              21                     !  temold: (t-dt) spectral temperature
              22                     !  divold: (t-dt) spectral divergence
              23                     !  plold: (t-dt) spectral terrain pressure
              24                     !  temnow: current time temperature
              25                     !  divnow: current time divergence
              26                     !  plnow: current time terrain pressure
              27                     !  temten: explicit temperature tendency
              28                     !  divten: explicit divergence tendency
              29                     !  plten: explicit terrain pressure tendency
              30                     !
              31                     ! *** output ***
              32                     !
              33                     !  temten: semi-implicit temperature tendency
              34                     !  divten: semi-implicit divergence tendency
              35                     !  plten: semi-implicit terrain pressure tendency
              36                     !
              37                     ! **************************************************
              38                     !
              39                     
              40                     !CWB2017 2dMPI version
              41                     
              42                           use index
              43                           use paramt
              44                           use const,only : eps4L,RTYPE
              45                           use spec ,only : plnowL,ploldL,pltenL,jtwvp
              46                     
              47                           implicit  none
              48                           integer   jtrun,jtmax,lev
              49                     
              50                           real(kind=RTYPE) dsigma(lev,2),eps4(jtrun,jtmax),eigval(lev),evecin(lev,lev) &
              51                           ,     evectr(lev,lev),arrhyd(lev,lev),arsddt(lev,lev),spalm(lev)
              52                     
              53                           real(kind=RTYPE) temold(levp,2,jtrun,jtmax),divold(levp,2,jtrun,jtmax) &
              54                           ,                temnow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax) &
              55                           ,                temten(levp,2,jtrun,jtmax),divten(levp,2,jtrun,jtmax)
              56                           real(kind=RTYPE) plold(jtrun,jtmax,2),plnow(jtrun,jtmax,2),plten(jtrun,jtmax,2)
              57                     
              58                           real(kind=RTYPE) divavg(lev,2),phiave(lev,2,jtrun),eps4e(lev,jtrun)
              59                     
              60                           integer   m,mf,k,n,l,j
              61                           real      alpha
              62                           real(kind=RTYPE) dta,dd,odd,dd2,ptmean,tem,s1,s2,d1,d2,dp
              63                     
              64                           real(kind=RTYPE) wrk1(lev,2,jtp),wrk2(lev,2,jtp),wrk3(lev,2,jtp),&
              65                                            wrk4(lev,2,jtp),wrk5(lev,2,jtp),wrk6(lev,2,jtp)
              66                     
              67                           dd = alpha*dta
              68                           odd= 1.0/dd
              69                           dd2= dd*dd
              70                     
              71                     #ifdef MULTIPLE
              72                           call mpe2d_reshape_pl_multi(plten, plnow, plold, pltenL, plnowL, ploldL)
              73                     
              74                           call mpe2d_transpose_siimpl_multi(temold,temnow,temten,divold,divnow,divten, &

                                   <<<      divavg
                                   <<< Loop-information  End >>>
             157     4   p   8v                  do 193 L = 2, lev
             158     4   p   8v                    s1= s1+evectr(k,L)*divavg(L,1)
             159     4   p   8v                    s2= s2+evectr(k,L)*divavg(L,2)
             160     4   p   8v        193       continue
             161     3   p                       wrk6(k,1,m)= s1

             297                     
             298                     !***********************************************************************
             299                           subroutine sigmap(layer,aki,bki,psfc,p)
             300                     !
             301                           use const, only: RTYPE
             302                     !
             303                           implicit none
             304                           integer i, layer
             305                           real p(layer)
             306                           real(kind=RTYPE) psfc,aki(layer), bki(layer)
             307                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      bki, aki, p
                                   <<< Loop-information  End >>>
             308     1  pp   2v            do i=1,layer
             309     1   p   2v            p(i)=aki(i)+(bki(i)*psfc)
             310     1   p   2v            enddo
             311                           return
             312                           end


             439     4   p    v                    qnr2d(i,k) = qnr2d(i,k)/(1. - tem)
             440     4   p    v                  endif
             441     3               
             442     3                           ! Ensure non-negative mass mixing ratios of all water variables
             443     3   p    v                  if ( qv2d(i,k) .lt. 0. ) qv2d(i,k) = 1.E-10  !should *never* be identically zero
             444     3   p    v                  if ( qc2d(i,k) .lt. 0. ) qc2d(i,k) = 0.
             445     3   p    v                  if ( qr2d(i,k) .lt. 0. ) qr2d(i,k) = 0.
             446     3   p    v                  if ( qi2d(i,k) .lt. 0. ) qi2d(i,k) = 0.
             447     3   p    v                  if ( qs2d(i,k) .lt. 0. ) qs2d(i,k) = 0.
             448     3   p    v                  if ( qg2d(i,k) .lt. 0. ) qg2d(i,k) = 0.
             449     3               
             450     4   p    v                  if ( convert_dry_q ) then
             451     4                             ! dry air density : rho = 0.622*p/(Rd*T*(0.622+qv))
             452     4   p    v                    rho = con_eps*prsl(i,k)/                                  &
             453     4                                   (con_rd*t2d(i,k)*(con_eps+qv2d(i,k)))
             454     4                           else
             455     4                             ! moist air density : rho = p/(Rd*T*(1+0.608*qv))
             456     4                             rho = prsl(i,k)/(con_rd*t2d(i,k)*(1+con_fvirt*qv2d(i,k)))
             457     4   p    v                  endif
             458     3   p    v                  w2d(i,k) = - vvel(i,kc)*100./(rho*con_g)          !vertical velocity (m/s)
             459     3               
             460     3                           ! 1st guess number concentration where mass non-zero
             461     3               !            if ( kdt .eq. 1 ) then
             462     3               !              if ( qi2d(i,k) .gt. 0. )                                  &
             463     3               !                qni2d(i,k) = make_IceNumber(qi2d(i,k)*rho,t2d(i,k))/rho
             464     3               !              if ( qr2d(i,k) .gt. 0. )                                  &
             465     3               !                qnr2d(i,k) = make_RainNumber(qr2d(i,k)*rho,t2d(i,k))/rho
             466     3               !            endif
             467     3   p    v                enddo
             468     2   p                   enddo

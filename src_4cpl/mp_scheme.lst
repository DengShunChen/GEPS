            1011     3   p    v                do i = 1, nxj
            1012     3   p    v                  qv3d (i,k,1) = qt(i,             kc)
            1013     3   p    v                  qc3d (i,k,1) = qt(i,(ntcw-1)*lev+kc)
            1014     3   p    v                  qr3d (i,k,1) = qt(i,(ntrw-1)*lev+kc)
            1015     3   p    v                  qi3d (i,k,1) = qt(i,(ntiw-1)*lev+kc)
            1016     3   p    v                  qs3d (i,k,1) = qt(i,(ntsw-1)*lev+kc)
            1017     3   p    v                  qg3d (i,k,1) = qt(i,(ntgl-1)*lev+kc)
            1018     3   p    v                  if(nmmiph.eq.16) qh3d (i,k,1) = qt(i,(nthl-1)*lev+kc)
            1019     3               
            1020     3   p    v                  p3d  (i,k,1) = 100.0*plt(i,kc)                   !layer mean pressure (from mb to Pa)
            1021     3   p    v                  pii3d(i,k,1) = pk(i,kc)                          !exner function, =(plt/1000)**(Rd/cp)
            1022     3   p    v                  th3d (i,k,1) = tt(i,kc)/pk(i,kc)                 !potential temperature (K)
            1023     3   p    v                  z3d  (i,k,1) = phi(i,kc)/con_g                   !layer geopotential height above sea level (m)
            1024     3   p    v                  dz3d (i,k,1) = (phii(i,k+1)-phii(i,k))/con_g     !layer thickness (m)
            1025     3               
            1026     4   p    v                  if ( convert_dry_q ) then
            1027     5   p    v                    if ( q_remove_cond ) then
            1028     5                               ! q convert to : hydrometeor mass / ( dry mass )
            1029     5                               tem = qv3d(i,k,1) + qc3d(i,k,1) + qr3d(i,k,1) +         &
            1030     5                                     qi3d(i,k,1) + qs3d(i,k,1) + qg3d(i,k,1)
            1031     5                               if(nmmiph.eq.16) tem = tem + qh3d(i,k,1)
            1032     5   p    v                    else
            1033     5                               ! q convert to : hydrometeor mass / ( dry mass + condensates )
            1034     5   p    v                      tem = qv3d(i,k,1)
            1035     5   p    v                    endif
            1036     4   p    v                    qv3d (i,k,1) = qv3d(i,k,1)/(1.-tem)
            1037     4   p    v                    qc3d (i,k,1) = qc3d(i,k,1)/(1.-tem)
            1038     4   p    v                    qr3d (i,k,1) = qr3d(i,k,1)/(1.-tem)
            1039     4   p    v                    qi3d (i,k,1) = qi3d(i,k,1)/(1.-tem)
            1040     4   p    v                    qs3d (i,k,1) = qs3d(i,k,1)/(1.-tem)
            1041     4   p    v                    qg3d (i,k,1) = qg3d(i,k,1)/(1.-tem)
            1042     4   p    v                    if(nmmiph.eq.16) qh3d (i,k,1) = qh3d(i,k,1)/(1.-tem)
            1043     4                             ! dry air density : rho = 0.622*p/(Rd*T*(0.622+qv))
            1044     4   p    v                    rho3d(i,k,1) = con_eps*p3d(i,k,1)/                        &
            1045     4                                            (con_rd*tt(i,kc)*(con_eps+qv3d(i,k,1)))
            1046     4                           else
            1047     4                             ! moist air density : rho = p/(Rd*T*(1+0.608*qv))
            1048     4                             rho3d(i,k,1) = p3d(i,k,1)/                                &
            1049     4                                            (con_rd*tt(i,kc)*(1+con_fvirt*qv3d(i,k,1)))
            1050     4   p    v                  endif
            1051     3               
            1052     3   p    v                  w3d(i,k,1) = -vvel(i,kc)*100./(rho3d(i,k,1)*con_g)  !(m/s)
            1053     3   p    v                enddo

               4                     !--------------------------
               5                           subroutine mp_init                                               &
               6                     !--------------------------
               7                     !  ---  inputs:
               8                                ( nmmiph ,myrank)
               9                     !  ---  outputs: ( none )
              10                     
              11                     ! for WSM6
              12                           use module_mp_wsm6,     only : wsm6init
              13                     ! for Thompson
              14                           use module_mp_thompson, only : thompson_init => thompson_init
              15                     ! for 2M Thompson
              16                           use module_mp_thompson_new,                                       &
              17                                                   only : new_thompson_init => thompson_init
              18                     ! for GFDL MP v1
              19                           use module_mp_gfdl,     only : gfdl_cloud_microphys_init
              20                     ! for GFDL MP v2
              21                           use module_mp_gfdl_v2,  only : gfdlv2_init => gfdl_cld_mp_init
              22                     ! for GFDL MP v3
              23                           use module_mp_gfdl_v3,  only : gfdlv3_init => gfdl_cld_mp_init
              24                           use physpara, only : is_aerosol_aware,merra2_aerosol_aware
              25                     
              26                           implicit none
              27                     !  ---  input:
              28                           integer,  intent(in) :: nmmiph,myrank
              29                     !  ---  local:
              30                           integer   ntrac_req
              31                           integer   errflg
              32                           character errmsg
              33                     !-----------------------------------------------------------------------
              34                     !  for cloud microphysics
              35                     !-----------------------------------------------------------------------
              36                     ! WSM6
              37     1                       if ( nmmiph .eq. 6 ) then
              38     1                         call wsm6init()
              39     1                         if ( myrank .eq. 0 )                                         &
              40     1                            print *,'WSM6 cloud microphysics initialized'
              41     1                       endif
              42                     ! Thompson
              43     1                       if ( nmmiph .eq. 8 ) then
              44     1                         call thompson_init()
              45     1                         if ( myrank .eq. 0 )                                         &
              46     1                            print *,'Thompson cloud microphysics initialized'
              47     1                       endif
              48                     ! 2M Thompson
              49     1                       if ( nmmiph .eq. 18 ) then
              50     1                         call new_thompson_init ( is_aerosol_aware,                    &
              51     1                                  merra2_aerosol_aware, myrank, 0, errmsg, errflg )
              52     1                         if ( myrank .eq. 0 )                                          &
              53     1                            print *,'New Thompson cloud microphysics initialized'
              54     1                       endif
              55                     ! GFDL MP v1
              56     1                       if ( nmmiph .eq. 11 ) then
              57     1                         call gfdl_cloud_microphys_init()
              58     1                         if ( myrank .eq. 0 )                                         &
              59     1                            print *, 'GFDL cloud microphysics initialized'
              60     1                       endif
              61                     ! GFDL MP v2
              62     1                       if ( nmmiph .eq. 12 ) then
              63     1                         call gfdlv2_init()
              64     1                         if ( myrank .eq. 0 )                                         &
              65     1                            print *, 'GFDL cloud microphysics version 2 initialized'
              66     1                       endif
              67                     ! GFDL MP v3
              68     1                       if ( nmmiph .eq. 13 ) then
              69     1                         call gfdlv3_init()
              70     1                         if ( myrank .eq. 0 )                                         &
              71     1                            print *, 'GFDL cloud microphysics version 3 initialized'
              72     1                       endif
              73                     ! Goddard (GCE) 3ICE MP
              74     1                       if ( nmmiph .eq. 15 ) then
              75     1                         if ( myrank .eq. 0 )                                         &
              76     1                            print *,'Goddard (GCE) 3ICE cloud microphysics initialized'
              77     1                       endif
              78                     ! Goddard (GCE) 4ICE MP
              79     1                       if ( nmmiph .eq. 16 ) then
              80     1                         if ( myrank .eq. 0 )                                         &
              81     1                            print *,'Goddard (GCE) 4ICE cloud microphysics initialized'
              82     1                       endif
              83                     
              84                           return
              85                     !--------------------------
              86                           end subroutine mp_init


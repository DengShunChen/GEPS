              44     1                         if ( myrank .eq. 0 )                                         &
              45     1                            print *,'Thompson cloud microphysics initialized'
              46     1                       endif
              47                     ! 2M Thompson
              48     1                       if ( nmmiph .eq. 18 ) then
              49     1                         call new_thompson_init ( is_aerosol_aware,                    &
              50     1                                  merra2_aerosol_aware, myrank, 0, errmsg, errflg )
              51     1                         if ( myrank .eq. 0 )                                          &
              52     1                            print *,'New Thompson cloud microphysics initialized'
              53     1                       endif
              54                     ! GFDL MP v1
              55     1                       if ( nmmiph .eq. 11 ) then
              56     1                         call gfdl_cloud_microphys_init()
              57     1                         if ( myrank .eq. 0 )                                         &
              58     1                            print *, 'GFDL cloud microphysics initialized'
              59     1                       endif
              60                     ! GFDL MP v2
              61     1                       if ( nmmiph .eq. 12 ) then
              62     1                         call gfdlv2_init()
              63     1                         if ( myrank .eq. 0 )                                         &
              64     1                            print *, 'GFDL cloud microphysics version 2 initialized'
              65     1                       endif
              66                     ! GFDL MP v3
              67     1                       if ( nmmiph .eq. 13 ) then
              68     1                         call gfdlv3_init()
              69     1                         if ( myrank .eq. 0 )                                         &
              70     1                            print *, 'GFDL cloud microphysics version 3 initialized'
              71     1                       endif
              72                     ! Goddard (GCE) 3ICE MP
              73     1                       if ( nmmiph .eq. 15 ) then
              74     1                         if ( myrank .eq. 0 )                                         &
              75     1                            print *,'Goddard (GCE) 3ICE cloud microphysics initialized'
              76     1                       endif
              77                     ! Goddard (GCE) 4ICE MP
              78     1                       if ( nmmiph .eq. 16 ) then
              79     1                         if ( myrank .eq. 0 )                                         &
              80     1                            print *,'Goddard (GCE) 4ICE cloud microphysics initialized'
              81     1                       endif

             417     3   p    v                  t2d  (i,k) = tt(i,kc)
             418     3   p    v                  dz2d (i,k) = (phii(i,k+1)-phii(i,k))/con_g          !layer width (m)
             419     3               
             420     3                           !> - Convert specific humidity to water vapor mixing ratio.
             421     3                           !> - Also, hydrometeor variables are mass or number mixing ratio
             422     3                           !> - either kg of species per kg of dry air, or per kg of (dry + vapor).
             423     4   p    v                  if ( convert_dry_q ) then
             424     5   p    v                    if ( q_remove_cond ) then
             425     5                               ! q convert to : hydrometeor mass / ( dry mass )
             426     5                               tem = qv2d(i,k) + qc2d(i,k) + qr2d(i,k) + qi2d(i,k) +   &
             427     5                                     qs2d(i,k) + qg2d(i,k)
             428     5   p    v                    else
             429     5                               ! q convert to : hydrometeor mass / ( dry mass + condensates )
             430     5   p    v                      tem = qv2d(i,k)
             431     5   p    v                    endif
             432     4   p    v                    qv2d (i,k) = qv2d (i,k)/(1. - tem)
             433     4   p    v                    qc2d (i,k) = qc2d (i,k)/(1. - tem)
             434     4   p    v                    qr2d (i,k) = qr2d (i,k)/(1. - tem)

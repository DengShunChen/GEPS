             433     4   p    v                    qni2d(i,k) = qni2d(i,k)/(1. - tem)
             434     4   p    v                    qnr2d(i,k) = qnr2d(i,k)/(1. - tem)
             435     4   p    v                  endif
             436     3               
             437     3                           ! Ensure non-negative mass mixing ratios of all water variables
             438     3   p    v                  if ( qv2d(i,k) .lt. 0. ) qv2d(i,k) = 1.E-10  !should *never* be identically zero
             439     3   p    v                  if ( qc2d(i,k) .lt. 0. ) qc2d(i,k) = 0.
             440     3   p    v                  if ( qr2d(i,k) .lt. 0. ) qr2d(i,k) = 0.
             441     3   p    v                  if ( qi2d(i,k) .lt. 0. ) qi2d(i,k) = 0.
             442     3   p    v                  if ( qs2d(i,k) .lt. 0. ) qs2d(i,k) = 0.
             443     3   p    v                  if ( qg2d(i,k) .lt. 0. ) qg2d(i,k) = 0.
             444     3               
             445     4   p    v                  if ( convert_dry_q ) then
             446     4                             ! dry air density : rho = 0.622*p/(Rd*T*(0.622+qv))
             447     4   p    v                    rho = con_eps*prsl(i,k)/                                  &
             448     4                                   (con_rd*t2d(i,k)*(con_eps+qv2d(i,k)))
             449     4                           else
             450     4                             ! moist air density : rho = p/(Rd*T*(1+0.608*qv))
             451     4                             rho = prsl(i,k)/(con_rd*t2d(i,k)*(1+con_fvirt*qv2d(i,k)))
             452     4   p    v                  endif
             453     3   p    v                  w2d(i,k) = - vvel(i,kc)*100./(rho*con_g)          !vertical velocity (m/s)
             454     3               
             455     3                           ! 1st guess number concentration where mass non-zero
             456     3               !            if ( kdt .eq. 1 ) then
             457     3               !              if ( qi2d(i,k) .gt. 0. )                                  &
             458     3               !                qni2d(i,k) = make_IceNumber(qi2d(i,k)*rho,t2d(i,k))/rho
             459     3               !              if ( qr2d(i,k) .gt. 0. )                                  &
             460     3               !                qnr2d(i,k) = make_RainNumber(qr2d(i,k)*rho,t2d(i,k))/rho
             461     3               !            endif
             462     3   p    v                enddo
             463     2   p                   enddo

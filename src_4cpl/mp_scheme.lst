             412     3   p    v                  t2d  (i,k) = tt(i,kc)
             413     3   p    v                  dz2d (i,k) = (phii(i,k+1)-phii(i,k))/con_g          !layer width (m)
             414     3               
             415     3                           !> - Convert specific humidity to water vapor mixing ratio.
             416     3                           !> - Also, hydrometeor variables are mass or number mixing ratio
             417     3                           !> - either kg of species per kg of dry air, or per kg of (dry + vapor).
             418     4   p    v                  if ( convert_dry_q ) then
             419     5   p    v                    if ( q_remove_cond ) then
             420     5                               ! q convert to : hydrometeor mass / ( dry mass )
             421     5                               tem = qv2d(i,k) + qc2d(i,k) + qr2d(i,k) + qi2d(i,k) +   &
             422     5                                     qs2d(i,k) + qg2d(i,k)
             423     5   p    v                    else
             424     5                               ! q convert to : hydrometeor mass / ( dry mass + condensates )
             425     5   p    v                      tem = qv2d(i,k)
             426     5   p    v                    endif
             427     4   p    v                    qv2d (i,k) = qv2d (i,k)/(1. - tem)
             428     4   p    v                    qc2d (i,k) = qc2d (i,k)/(1. - tem)
             429     4   p    v                    qr2d (i,k) = qr2d (i,k)/(1. - tem)

            2127     1               !! \f]
            2128     1               !! \f$\Delta t_{cu}\f$ is the short timescale of the convection.
            2129     2   p    v              if(asqecflg(i)) then
            2130     2               !         xaa0(i) = max(xaa0(i),0.)
            2131     2   p    v                xk(i) = (xaa0(i) - aa1(i)) / mbdt(i)
            2132     3   p    v                if(xk(i) >= 0.) then

                                   <<< Loop-information  End >>>
            1773     2   s    s              do i = 1, im
            1774     3   p    v                if(asqecflg(i) .and. k <= kmax(i)-1) then
            1775     3   m    m                  qeso(i,k) = 0.01 * fpvs(to(i,k))      ! fpvs is in pa
            1776     3               !byl            call qsatq_cwb(1,to(i,k),po(i,k),qeso(i,k))
            1777     3   p    v                  qeso(i,k) = eps * qeso(i,k) / (po(i,k) + epsm1 * qeso(i,k))
            1778     3   p    v                  val1      =             1.e-8
            1779     3   p    v                  qeso(i,k) = max(qeso(i,k), val1)
            1780     3   p    v                  val2      =           1.e-10
            1781     3   p    v                  qo(i,k)   = max(qo(i,k), val2 )
            1782     3               !           qo(i,k)   = min(qo(i,k),qeso(i,k))
            1783     3   m    m                  heo(i,k)   = .5 * g * (zo(i,k) + zo(i,k+1)) + &
            1784     3                                         cp * to(i,k) + hvap * qo(i,k)
            1785     3   p    v                  heso(i,k) = .5 * g * (zo(i,k) + zo(i,k+1)) + &
            1786     3                                       cp * to(i,k) + hvap * qeso(i,k)
            1787     3   p    v                endif

            1790     1  pp    s            do i = 1, im
            1791     2   p    m              if(asqecflg(i)) then
            1792     2   p    s                k = kmax(i)
            1793     2   p    s                heo(i,k) = g * zo(i,k) + cp * to(i,k) + hvap * qo(i,k)
            1794     2   p    s                heso(i,k) = g * zo(i,k) + cp * to(i,k) + hvap * qeso(i,k)

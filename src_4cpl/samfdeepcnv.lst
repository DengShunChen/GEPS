            1607     2   p    v              do i = 1, im
            1608     3   p    v                if (cnvflg(i) .and. k < ktcon(i)) then
            1609     3   p    v                    aup = 1.
            1610     3   p    v                    if(k <= kb(i)) aup = 0.
            1611     3   p    v                    adw = 1.
            1612     3   p    v                    if(k > jmin(i)) adw = 0.
            1613     3   p    v                    dp = 1000. * del(i,k)
            1614     3   p    v                    dz = zi(i,k) - zi(i,k-1)
            1615     3               !
            1616     3   p    v                    dv1h = heo(i,k)
            1617     3   p    v                    dv2h = .5 * (heo(i,k) + heo(i,k-1))
            1618     3   p    v                    dv3h = heo(i,k-1)
            1619     3   p    v                    dv1q = qo(i,k)
            1620     3   p    v                    dv2q = .5 * (qo(i,k) + qo(i,k-1))
            1621     3   p    v                    dv3q = qo(i,k-1)
            1622     3               !
            1623     3   p    v                    tem  = 0.5 * (xlamue(i,k)+xlamue(i,k-1))
            1624     3   p    v                    tem1 = 0.5 * (xlamud(i,k)+xlamud(i,k-1))
            1625     3               !
            1626     4   p    v                    if(k <= kbcon(i)) then
            1627     4   p    v                      ptem  = xlamde
            1628     4   p    v                      ptem1 = xlamd(i)+xlamdd
            1629     4   p    v                    else
            1630     4   p    v                      ptem  = xlamde
            1631     4   p    v                      ptem1 = xlamdd
            1632     4   p    v                    endif
            1633     3               !cj
            1634     3   p    v                    dellah(i,k) = dellah(i,k) + &
            1635     3                          ((aup*eta(i,k)-adw*edto(i)*etad(i,k))*dv1h &
            1636     3                         - (aup*eta(i,k-1)-adw*edto(i)*etad(i,k-1))*dv3h &
            1637     3                         - (aup*tem*eta(i,k-1)+adw*edto(i)*ptem*etad(i,k))*dv2h*dz &
            1638     3                         +  aup*tem1*eta(i,k-1)*.5*(hcko(i,k)+hcko(i,k-1))*dz &
            1639     3                         +  adw*edto(i)*ptem1*etad(i,k)*.5*(hcdo(i,k)+hcdo(i,k-1))*dz &
            1640     3                              ) *g/dp
            1641     3               !cj
            1642     3   p    v                    dellaq(i,k) = dellaq(i,k) + &

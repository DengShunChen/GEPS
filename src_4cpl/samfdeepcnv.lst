                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1752     2   s    s              do i = 1, im
            1753     3   p    v                if(asqecflg(i) .and. k <= kmax(i)-1) then
            1754     3   p    v                  dz = .5 * (zo(i,k+1) - zo(i,k))
            1755     3   p    v                  dp = .5 * (pfld(i,k+1) - pfld(i,k))
            1756     3   s    s                  es = 0.01 * fpvs(to(i,k+1))      ! fpvs is in pa
            1757     3               !byl            call qsatq_cwb(1,to(i,k+1),pfld(i,k+1),es)
            1758     3   s    s                  pprime = pfld(i,k+1) + epsm1 * es
            1759     3   s    s                  qs = eps * es / pprime
            1760     3   s    s                  dqsdp = - qs / pprime
            1761     3   s    s                  desdt = es * (fact1 / to(i,k+1) + fact2 / (to(i,k+1)**2))
            1762     3   p    v                  dqsdt = qs * pfld(i,k+1) * desdt / (es * pprime)
            1763     3   m    m                  gamma = el2orc * qeso(i,k+1) / (to(i,k+1)**2)
            1764     3   m    m                  dt = (g * dz + hvap * dqsdp * dp) / (cp * (1. + gamma))
            1765     3   p    v                  dq = dqsdt * dt + dqsdp * dp
            1766     3   s    s                  to(i,k) = to(i,k+1) + dt
            1767     3   p    v                  qo(i,k) = qo(i,k+1) + dq
            1768     3   p    v                  po(i,k) = .5 * (pfld(i,k) + pfld(i,k+1))
            1769     3   p    v                endif
            1770     2   p    m              enddo
            1771     1                     enddo
            1772     1                     do k = 1, km1

             562     1                     enddo
             563                     !
             564                     !> - Recalculate saturation specific humidity, moist static energy, saturation moist static energy, and horizontal momentum on interface levels. Enforce minimum specific humidity and calculate \f$(1 - RH)\f$.
             565     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

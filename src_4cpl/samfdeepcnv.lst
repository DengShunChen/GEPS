            1645     3                         - (aup*tem*eta(i,k-1)+adw*edto(i)*ptem*etad(i,k))*dv2q*dz &
            1646     3                         +  aup*tem1*eta(i,k-1)*.5*(qrcko(i,k)+qcko(i,k-1))*dz &
            1647     3                         +  adw*edto(i)*ptem1*etad(i,k)*.5*(qrcdo(i,k)+qcdo(i,k-1))*dz &
            1648     3                              ) *g/dp
            1649     3               !cj
            1650     3   p    v                    tem1=eta(i,k)*(uo(i,k)-ucko(i,k))
            1651     3   p    v                    tem2=eta(i,k-1)*(uo(i,k-1)-ucko(i,k-1))
            1652     3   p    v                    ptem1=etad(i,k)*(uo(i,k)-ucdo(i,k))
            1653     3   p    v                    ptem2=etad(i,k-1)*(uo(i,k-1)-ucdo(i,k-1))
            1654     3   p    v                    dellau(i,k) = dellau(i,k) + &
            1655     3                                (aup*(tem1-tem2)-adw*edto(i)*(ptem1-ptem2))*g/dp
            1656     3               !cj
            1657     3   p    v                    tem1=eta(i,k)*(vo(i,k)-vcko(i,k))
            1658     3   p    v                    tem2=eta(i,k-1)*(vo(i,k-1)-vcko(i,k-1))
            1659     3   p    v                    ptem1=etad(i,k)*(vo(i,k)-vcdo(i,k))
            1660     3   p    v                    ptem2=etad(i,k-1)*(vo(i,k-1)-vcdo(i,k-1))
            1661     3   p    v                    dellav(i,k) = dellav(i,k) + &
            1662     3                                (aup*(tem1-tem2)-adw*edto(i)*(ptem1-ptem2))*g/dp
            1663     3               !cj
            1664     3   p    v                endif
            1665     2   p    v              enddo
            1666     1   p                 enddo

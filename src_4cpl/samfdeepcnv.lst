            2322     4                                      / (1. + el2orc * qeso(i,k) / t1(i,k)**2)
            2323     4   p    v                    dp = 1000. * del(i,k)
            2324     5   p    v                    if(rn(i) > 0. .and. qcond(i) < 0.) then
            2325     5   p    v                      qevap(i) = -qcond(i) * (1.-exp(-.32*sqrt(dt2*rn(i))))

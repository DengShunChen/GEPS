            2103     2   p    s                k = kbcon(i)
            2104     2   p    s                rho = po(i,k)*100. / (rd*to(i,k))
            2105     2   p    s                tfac = tauadv(i) / dtconv(i)
            2106     2   p    s                tfac = min(tfac, 1.)
            2107     2   p    s                xmb(i) = tfac*betaw*rho*wc(i)
            2108     2   p    v              endif

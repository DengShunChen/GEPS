            1736     2   s    s              do i = 1, im
            1737     3   p    v                if(asqecflg(i) .and. k <= kmax(i)) then
            1738     3   m    m                  qeso(i,k) = 0.01 * fpvs(to(i,k))      ! fpvs is in pa
            1739     3               !byl            call qsatq_cwb(1,to(i,k),pfld(i,k),qeso(i,k))
            1740     3   p    v                  qeso(i,k) = eps * qeso(i,k) / (pfld(i,k)+epsm1*qeso(i,k))
            1741     3   p    v                  val       =             1.e-8
            1742     3   p    v                  qeso(i,k) = max(qeso(i,k), val )
            1743     3               !           tvo(i,k)  = to(i,k) + delta * to(i,k) * qo(i,k)
            1744     3   p    v                endif
            1745     2   p    m              enddo
            1746     1                     enddo
            1747                     !
            1748                     !c--- moist static energy
            1749                     !
            1750                     !! - Recalculate moist static energy and saturation moist static energy.
            1751     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      asqecflg

            1590     1  pp    v            do i = 1, im
            1591     2   p    v              if(cnvflg(i)) then
            1592     2   p    v                dp = 1000. * del(i,1)
            1593     2   p    v                dellah(i,1) = edto(i) * etad(i,1) * (hcdo(i,1) &
            1594     2                                        - heo(i,1)) * g / dp

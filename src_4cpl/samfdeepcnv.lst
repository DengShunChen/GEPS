                                   <<< Loop-information  End >>>
             543     2   s    s              do i=1,im
             544     3   p    v                if (k <= kmax(i)-1) then
             545     3   p    v                  dz      = .5 * (zo(i,k+1) - zo(i,k))
             546     3   p    v                  dp      = .5 * (pfld(i,k+1) - pfld(i,k))
             547     3   s    s                  es      = 0.01 * fpvs(to(i,k+1))      ! fpvs is in pa
             548     3               !byl            call qsatq_cwb(1,to(i,k+1),pfld(i,k+1),es)
             549     3   s    s                  pprime  = pfld(i,k+1) + epsm1 * es
             550     3   s    s                  qs      = eps * es / pprime
             551     3   s    s                  dqsdp   = - qs / pprime
             552     3   s    s                  desdt   = es * (fact1 / to(i,k+1) + fact2 / (to(i,k+1)**2))
             553     3   p    v                  dqsdt   = qs * pfld(i,k+1) * desdt / (es * pprime)
             554     3   m    m                  gamma   = el2orc * qeso(i,k+1) / (to(i,k+1)**2)
             555     3   m    m                  dt      = (g * dz + hvap * dqsdp * dp) / (cp * (1. + gamma))
             556     3   p    v                  dq      = dqsdt * dt + dqsdp * dp
             557     3   s    s                  to(i,k) = to(i,k+1) + dt
             558     3   p    v                  qo(i,k) = qo(i,k+1) + dq
             559     3   p    v                  po(i,k) = .5 * (pfld(i,k) + pfld(i,k+1))
             560     3   p    v                endif

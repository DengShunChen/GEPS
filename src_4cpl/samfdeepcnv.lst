                                   <<< Loop-information  End >>>
             627     1  pp    s            do i=1,im
             628     2   p    m              if(cnvflg(i)) then
             629     3   p    s                if(islimsk(i) == 1) then
             630     3   p    s                  w1 = w1l
             631     3   p    s                  w2 = w2l
             632     3   p    s                  w3 = w3l
             633     3   p    s                  w4 = w4l
             634     3   p    s                else
             635     3   p    s                  w1 = w1s
             636     3   p    s                  w2 = w2s
             637     3   p    s                  w3 = w3s
             638     3   p    s                  w4 = w4s
             639     3   p    s                endif
             640     3   p    s                if(pdot(i) <= w4) then
             641     3   p    s                  tem = (pdot(i) - w4) / (w3 - w4)
             642     3   p    s                elseif(pdot(i) >= -w4) then
             643     3   p    s                  tem = - (pdot(i) + w4) / (w4 - w3)
             644     3   p    s                else
             645     3   p    s                  tem = 0.
             646     3   p    s                endif
             647     2   p    s                val1    =            -1.
             648     2   p    s                tem = max(tem,val1)
             649     2   p    s                val2    =             1.
             650     2   p    s                tem = min(tem,val2)

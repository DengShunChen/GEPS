            1713     4   p    v                    dellat = (dellah(i,k) - hvap * dellaq(i,k)) / cp
            1714     4   p    v                    to(i,k) = dellat * mbdt(i) + t1(i,k)
            1715     4   p    v                    val   =           1.e-10

                                   <<<      cnvflg, ktcon, kbcon, kb, xlamud, zi
                                   <<<      qcko, qrcko, eta, jmin, etad, edto, qo
                                   <<<      xlamue
                                   <<<    PREFETCH(SOFT) : 60
                                   <<<     SEQUENTIAL : 60
                                   <<<      xlamd: 2, xlamue: 2, etad: 2, qo: 2
                                   <<<      eta: 2, qcdo: 2, qrcdo: 2, del: 2

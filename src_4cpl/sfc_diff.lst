               1                           subroutine sfc_diff(imj,im,ps,u1,v1,t1,q1,z1,       &
               2                                        snwdph,tskin,z0rl,cm,ch,rb,            &
               3                                               prsl1,prslki,islimsk,           &
               4                                               stress,fm,fh,                   &
               5                                               ustar,wind,ddvel,fm10,fh2,fh10, &
               6                                               sigmaf,vegtype,shdmax,ivegsrc,  &
               7                                               tsurf,flag_iter,redrag,ustress,vstress,ssu,ssv)
               8                     !
               9                           use machine , only : kind_phys
              10                     !     use funcphys, only : fpvs
              11                           use physcons, grav => con_g,       cp => con_cp    &
              12                           ,             rvrdm1 => con_fvirt, rd => con_rd    &
              13                           ,             eps => con_eps, epsm1 => con_epsm1
              14                           use const,    only : RTYPE
              15                     
              16                           implicit none
              17                     !
              18                           integer              im, ivegsrc, imj
              19                           real(kind=RTYPE), dimension(im) ::     u1,  v1, t1, q1
              20                           real(kind=kind_phys), dimension(im) :: ps                            &
              21                           ,                                      z1, tskin, z0rl               &
              22                           ,                                      cm,  ch, rb, prsl1, prslki    &
              23                           ,                                      stress,  fm, fh, ustar        &
              24                           ,                                      wind, ddvel, fm10, fh2,fh10   &
              25                           ,                                      sigmaf, shdmax, tsurf, snwdph &
              26                           ,                                      ustress, vstress, ssu, ssv
              27                           integer, dimension(im) ::  vegtype, islimsk
              28                     
              29                           logical   flag_iter(im) ! added by s.lu
              30                           logical   redrag        ! reduced drag coeff. flag for high wind over sea (j.han)
              31                     !
              32                     !     locals
              33                     !
              34                           integer   i
              35                     !
              36                           real(kind=kind_phys) aa,     aa0,    bb,     bb0, dtv,   adtv,qs1,      &
              37                                                hl1,    hl12,   pm,     ph,  pm10,  ph2,ph10, rat, &
              38                                                thv1,   tvs,    z1i,    z0,  z0max, ztmax, &
              39                                                fms,    fhs,    hl0,    hl0inf, hlinf, &
              40                                                hl110,  hlt,    hltinf, olinf, &
              41                                                restar, czilc,  tem1,   tem2, &
              42                                                ztmin1, ztmax1, beta,   hmgn, fpvs, ttmp
              43                     !
              44                           real(kind=kind_phys), parameter ::    &
              45                                         charnock=.014, ca=.4    &! ca - von karman constant
              46                           ,             z0s_max=.317e-2         &! a limiting value at high winds over sea
              47                           ,             alpha=5.,   a0=-3.975, a1=12.32, alpha4=4.0*alpha &
              48                           ,             b1=-7.755,  b2=6.041    &
              49                           ,             a0p=-7.941, a1p=24.75, b1p=-8.705, b2p=7.899      &
              50                           ,             vis=1.4e-5, rnu=1.51e-5, visi=1.0/vis             &
              51                           ,             log01=log(0.01), log05=log(0.05), log07=log(0.07)
              52                     
              53                     !     parameter (charnock=.014,ca=.4)!c ca is the von karman constant
              54                     !     parameter (alpha=5.,a0=-3.975,a1=12.32,b1=-7.755,b2=6.041)
              55                     !     parameter (a0p=-7.941,a1p=24.75,b1p=-8.705,b2p=7.899,vis=1.4e-5)
              56                     
              57                     !     real(kind=kind_phys) aa1,bb1,bb2,cc,cc1,cc2,arnu
              58                     !     parameter (aa1=-1.076,bb1=.7045,cc1=-.05808)
              59                     !     parameter (bb2=-.1954,cc2=.009999)
              60                     !     parameter (arnu=.135*rnu)
              61                     !
              62                     !    z0s_max=.196e-2 for u10_crit=25 m/s
              63                     !    z0s_max=.317e-2 for u10_crit=30 m/s
              64                     !    z0s_max=.479e-2 for u10_crit=35 m/s
              65                     !
              66                     ! mbek -- toga-coare flux algorithm
              67                     !     parameter (rnu=1.51e-5,arnu=0.11*rnu)
              68                     !
              69                     !  initialize variables. all units are supposedly m.k.s. unless specified
              70                     !  ps is in pascals, wind is wind speed,
              71                     !  surface roughness length is converted to m from cm
              72                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag_iter
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 34
                                   <<<      SIMD&FP   : SPILL 13  FILL 21
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              73     1   s    s            do i=1,imj
              74     2   p    v              if(flag_iter(i)) then
              75     2   p    v                wind(i) = max(sqrt((u1(i)-ssu(i))**2 + (v1(i)-ssv(i))**2) &
              76     2                                     + max(0.0, min(ddvel(i), 30.0)), 1.0)
              77     2   p    v                tem1    = 1.0 + rvrdm1 * max(q1(i),1.e-8)
              78     2   p    v                thv1    = t1(i) * prslki(i) * tem1
              79     2   p    v                tvs     = 0.5 * (tsurf(i)+tskin(i)) * tem1
              80     2   s    s                ttmp    = t1(i)
              81     2   s    s                qs1     = fpvs(ttmp)
              82     2   p    v                qs1     = max(1.0e-8, eps * qs1 / (prsl1(i) + epsm1 * qs1))
              83     2               
              84     2   p    v                z0      = 0.01 * z0rl(i)
              85     2   p    v                z0max   = max(1.0e-6, min(z0,z1(i)))
              86     2   p    v                z1i     = 1.0 / z1(i)
              87     2               
              88     2               !  compute stability dependent exchange coefficients
              89     2               !  this portion of the code is presently suppressed
              90     2               !
              91     2               
              92     3   m    m                if(islimsk(i) == 0) then            ! over ocean
              93     3   p    v                  ustar(i) = sqrt(grav * z0 / charnock)
              94     3               
              95     3               !**  test xubin's new z0
              96     3               
              97     3               !           ztmax  = z0max
              98     3               
              99     3   p    v                  restar = max(ustar(i)*z0max*visi, 0.000001)
             100     3               
             101     3               !           restar = log(restar)
             102     3               !           restar = min(restar,5.)
             103     3               !           restar = max(restar,-5.)
             104     3               !           rat    = aa1 + (bb1 + cc1*restar) * restar
             105     3               !           rat    = rat    / (1. + (bb2 + cc2*restar) * restar))
             106     3               !  rat taken from zeng, zhao and dickinson 1997
             107     3               
             108     3   p    v                  rat    = min(7.0, 2.67 * sqrt(sqrt(restar)) - 2.57)
             109     3   p    v                  ztmax  = z0max * exp(-rat)
             110     3               
             111     3   s    s                else                                ! over land and sea ice
             112     3               !** xubin's new z0  over land and sea ice
             113     3   p    v                  tem1 = 1.0 - shdmax(i)
             114     3   p    v                  tem2 = tem1 * tem1
             115     3   p    v                  tem1 = 1.0  - tem2
             116     3               
             117     4   m    m               if( ivegsrc .ge. 1 ) then
             118     4               
             119     5   m    m                if (vegtype(i) == 10) then
             120     5   p    v                  z0max = exp( tem2*log01 + tem1*log07 )
             121     5   p    v                elseif (vegtype(i) == 6) then
             122     5   p    v                  z0max = exp( tem2*log01 + tem1*log05 )
             123     5   p    v                elseif (vegtype(i) == 7) then
             124     5               !           z0max = exp( tem2*log01 + tem1*log01 )
             125     5   p    v                  z0max = 0.01
             126     5   p    v                elseif (vegtype(i) == 16) then
             127     5               !           z0max = exp( tem2*log01 + tem1*log01 )
             128     5   p    v                  z0max = 0.01
             129     5   p    v                else
             130     5   p    v                  z0max = exp( tem2*log01 + tem1*log(z0max) )
             131     5   p    v                endif
             132     4               
             133     4   s    s               elseif (ivegsrc == 0 ) then
             134     4               
             135     5   m    m                  if (vegtype(i) == 7) then
             136     5   p    v                    z0max = exp( tem2*log01 + tem1*log07 )
             137     5   p    v                  elseif (vegtype(i) == 8) then
             138     5   p    v                    z0max = exp( tem2*log01 + tem1*log05 )
             139     5   p    v                  elseif (vegtype(i) == 9) then
             140     5               !             z0max = exp( tem2*log01 + tem1*log01 )
             141     5   p    v                    z0max = 0.01
             142     5   p    v                  elseif (vegtype(i) == 11) then
             143     5               !             z0max = exp( tem2*log01 + tem1*log01 )
             144     5   p    v                    z0max = 0.01
             145     5   p    v                  else
             146     5   p    v                    z0max = exp( tem2*log01 + tem1*log(z0max) )
             147     5   p    v                  endif
             148     4               
             149     4   p    v               endif
             150     3   p    v                  z0max = max(z0max,1.0e-6)
             151     3               !
             152     3               !           czilc = 10.0 ** (- (0.40/0.07) * z0) ! fei's canopy height dependance of czil
             153     3   p    v                  czilc = 0.8
             154     3               
             155     3   p    v                  tem1 = 1.0 - sigmaf(i)
             156     3   p    v                  ztmax = z0max*exp( - tem1*tem1 &
             157     3                                              * czilc*ca*sqrt(ustar(i)*(0.01/1.5e-05)))
             158     3               
             159     3   p    v                endif       ! end of if(islimsk(i) == 0) then
             160     2   p    v                ztmax = max(ztmax,1.0e-6)
             161     2   p    v                  ztmin1 = -999.0
             162     2   p    v                  beta   = 1.0
             163     2               !xb118>>
             164     2   p    v                tem1   = z0max/z1(i)
             165     3   p    v                if (abs(1.0-tem1) > 1.0e-6) then
             166     3   p    v                  hmgn = - beta*log(tem1)/(2.*alpha*(1.-tem1))
             167     3   p    v                else
             168     3   p    v                  hmgn = 99.0
             169     3   p    v                endif
             170     2               !            hmgn   = beta*log(z1(i)/z0max)/(2.*alpha*(1.-z0max/z1(i)))
             171     2               !xb118<<
             172     2   p    v                  if( z0max.lt.0.05 .and. snwdph(i).lt.10.0 ) hmgn = 99.0
             173     2               
             174     2               
             175     2               !  compute stability indices (rb and hlinf)
             176     2               
             177     2   p    v                dtv     = thv1 - tvs
             178     2   p    v                adtv    = max(abs(dtv),0.001)
             179     2   p    v                dtv     = sign(1.,dtv) * adtv
             180     2   p    v                rb(i)   = max(-5000.0, (grav+grav) * dtv * z1(i) &
             181     2                                 / ((thv1 + tvs) * wind(i) * wind(i)))
             182     2   p    v                tem1    = 1.0 / z0max
             183     2   p    v                tem2    = 1.0 / ztmax
             184     2   p    v                fm(i)   = log((z0max+z1(i)) * tem1)
             185     2   p    v                fh(i)   = log((ztmax+z1(i)) * tem2)
             186     2   p    v                fm10(i) = log((z0max+10.)   * tem1)
             187     2   p    v                fh2(i)  = log((ztmax+2.)    * tem2)
             188     2   p    v                fh10(i) = log((ztmax+10.)   * tem2)
             189     2   p    v                hlinf   = rb(i) * fm(i) * fm(i) / fh(i)
             190     2   p    v                ztmax1  = hmgn
             191     2   p    v                hlinf   = min(max(hlinf,ztmin1),ztmax1)
             192     2               !
             193     2               !  stable case
             194     2               !
             195     3   p    v                if (dtv >= 0.0) then
             196     3   p    v                  hl1 = hlinf
             197     4   p    v                  if(hlinf > .25) then
             198     4   p    v                    tem1   = hlinf * z1i
             199     4   p    v                    hl0inf = z0max * tem1
             200     4   p    v                    hltinf = ztmax * tem1
             201     4   p    v                    aa     = sqrt(1. + alpha4 * hlinf)
             202     4   p    v                    aa0    = sqrt(1. + alpha4 * hl0inf)
             203     4   p    v                    bb     = aa
             204     4   p    v                    bb0    = sqrt(1. + alpha4 * hltinf)
             205     4   p    v                    pm     = aa0 - aa + log( (aa + 1.)/(aa0 + 1.) )
             206     4   p    v                    ph     = bb0 - bb + log( (bb + 1.)/(bb0 + 1.) )
             207     4   p    v                    fms    = fm(i) - pm
             208     4   p    v                    fhs    = fh(i) - ph
             209     4   p    v                    hl1    = fms * fms * rb(i) / fhs
             210     4   p    v                    ztmax1 = hmgn
             211     4   p    v                    hl1    = min(max(hl1, ztmin1), ztmax1)
             212     4   p    v                  endif
             213     3               !
             214     3               !  second iteration
             215     3               !
             216     3   p    v                  tem1  = hl1 * z1i
             217     3   p    v                  hl0   = z0max * tem1
             218     3   p    v                  hlt   = ztmax * tem1
             219     3   p    v                  aa    = sqrt(1. + alpha4 * hl1)
             220     3   p    v                  aa0   = sqrt(1. + alpha4 * hl0)
             221     3   p    v                  bb    = aa
             222     3   p    v                  bb0   = sqrt(1. + alpha4 * hlt)
             223     3   p    v                  pm    = aa0 - aa + log( (1.0+aa)/(1.0+aa0) )
             224     3   p    v                  ph    = bb0 - bb + log( (1.0+bb)/(1.0+bb0) )
             225     3   p    v                  hl110 = hl1 * 10. * z1i
             226     3   p    v                  ztmax1= hmgn
             227     3   p    v                  hl110 = min(max(hl110, ztmin1), ztmax1)
             228     3   p    v                  aa    = sqrt(1. + alpha4 * hl110)
             229     3   p    v                  pm10  = aa0 - aa + log( (1.0+aa)/(1.0+aa0) )
             230     3   p    v                  hl12  = (hl1+hl1) * z1i
             231     3   p    v                  hl12  = min(max(hl12,ztmin1),ztmax1)
             232     3               !           aa    = sqrt(1. + alpha4 * hl12)
             233     3   p    v                  bb    = sqrt(1. + alpha4 * hl12)
             234     3   p    v                  ph2   = bb0 - bb + log( (1.0+bb)/(1.0+bb0) )
             235     3   p    v                  bb    = sqrt(1. + alpha4 * hl110)
             236     3   p    v                  ph10  = bb0 - bb + log( (1.0+bb)/(1.0+bb0) )
             237     3               !
             238     3               !  unstable case - check for unphysical obukhov length
             239     3               !
             240     3   p    v                else                          ! dtv < 0 case
             241     3   p    v                  olinf = z1(i) / hlinf
             242     3   p    v                  tem1  = 50.0 * z0max
             243     4   p    v                  if(abs(olinf) <= tem1) then
             244     4   p    v                    hlinf = -z1(i) / tem1
             245     4   p    v                    ztmax1=hmgn
             246     4   p    v                    hlinf = min(max(hlinf,ztmin1),ztmax1)
             247     4   p    v                  endif
             248     3               !
             249     3               !  get pm and ph
             250     3               !
             251     4   p    v                  if (hlinf >= -0.5) then
             252     4   p    v                    ztmax1= hmgn
             253     4   p    v                    hl1   = hlinf
             254     4   p    v                    pm    = (a0  + a1*hl1)  * hl1   / (1.+ (b1+b2*hl1)  *hl1)
             255     4   p    v                    ph    = (a0p + a1p*hl1) * hl1   / (1.+ (b1p+b2p*hl1)*hl1)
             256     4   p    v                    hl110 = hl1 * 10. * z1i
             257     4   p    v                    hl110 = min(max(hl110, ztmin1), ztmax1)
             258     4   p    v                    pm10  = (a0 + a1*hl110) * hl110 / (1.+(b1+b2*hl110)*hl110)
             259     4   p    v                    hl12  = (hl1+hl1) * z1i
             260     4   p    v                    hl12  = min(max(hl12, ztmin1), ztmax1)
             261     4   p    v                    ph2   = (a0p + a1p*hl12) * hl12 / (1.+(b1p+b2p*hl12)*hl12)
             262     4   p    v                    ph10  = (a0p +a1p*hl110) *hl110/(1.+(b1p+b2p*hl110)*hl110)
             263     4   p    v                  else                       ! hlinf < 0.05
             264     4   p    v                    hl1   = -hlinf
             265     4   p    v                    tem1  = 1.0 / sqrt(hl1)
             266     4   p    v                    pm    = log(hl1) + 2. * sqrt(tem1) - .8776
             267     4   p    v                    ph    = log(hl1) + .5 * tem1 + 1.386
             268     4               !             pm    = log(hl1) + 2.0 * hl1 ** (-.25) - .8776
             269     4               !             ph    = log(hl1) + 0.5 * hl1 ** (-.5) + 1.386
             270     4   p    v                    hl110 = hl1 * 10. * z1i
             271     4   p    v                    hl110 = min(max(hl110, ztmin1), ztmax1)
             272     4   p    v                    pm10  = log(hl110) + 2.0 / sqrt(sqrt(hl110)) - .8776
             273     4               !             pm10  = log(hl110) + 2. * hl110 ** (-.25) - .8776
             274     4   p    v                    hl12  = (hl1+hl1) * z1i
             275     4   p    v                    hl12  = min(max(hl12, ztmin1), ztmax1)
             276     4   p    v                    ph2   = log(hl12) + 0.5 / sqrt(hl12) + 1.386
             277     4   p    v                    ph10  = log(hl110) + 0.5 / sqrt(hl110) + 1.386
             278     4               !             ph2   = log(hl12) + .5 * hl12 ** (-.5) + 1.386
             279     4   p    v                  endif
             280     3               
             281     3   p    v                endif          ! end of if (dtv >= 0 ) then loop
             282     2               !
             283     2               !  finish the exchange coefficient computation to provide fm and fh
             284     2               !
             285     2   p    v                fm(i)     = fm(i) - pm
             286     2   p    v                fh(i)     = fh(i) - ph
             287     2   p    v                fm10(i)   = fm10(i) - pm10
             288     2   p    v                fh2(i)    = fh2(i) - ph2
             289     2   p    v                fh10(i)   = fh10(i) - ph10
             290     2   p    v                cm(i)     = ca * ca / (fm(i) * fm(i))
             291     2   p    v                ch(i)     = ca * ca / (fm(i) * fh(i))
             292     2   p    v                cm(i) = max(cm(i), 0.00001/z1(i))
             293     2   p    v                ch(i) = max(ch(i), 0.00001/z1(i))
             294     2   p    v                stress(i) = cm(i) * wind(i) * wind(i)
             295     2   p    v                ustar(i)  = sqrt(stress(i))
             296     2               !! jwhwu 20110311
             297     2   p    v               ustress(i) = - stress(i) * (u1(I)-ssu(I)) / wind(i)
             298     2   p    v               vstress(i) = - stress(i) * (v1(I)-ssv(I)) / wind(i)
             299     2               !
             300     2               !  update z0 over ocean
             301     2               !
             302     3   p    v                if(islimsk(i) == 0) then
             303     3   p    v                  z0 = (charnock / grav) * ustar(i) * ustar(i)
             304     3               
             305     3               ! mbek -- toga-coare flux algorithm
             306     3               !           z0 = (charnock / grav) * ustar(i)*ustar(i) +  arnu/ustar(i)
             307     3               !  new implementation of z0
             308     3               !           cc = ustar(i) * z0 / rnu
             309     3               !           pp = cc / (1. + cc)
             310     3               !           ff = grav * arnu / (charnock * ustar(i) ** 3)
             311     3               !           z0 = arnu / (ustar(i) * ff ** pp)
             312     3               
             313     4   p    v                  if (redrag) then
             314     4   p    v                    z0rl(i) = 100.0 * max(min(z0, z0s_max), 1.e-7)
             315     4   p    v                  else
             316     4   p    v                    z0rl(i) = 100.0 * max(min(z0,.1), 1.e-7)
             317     4   p    v                  endif
             318     3   p    v                endif
             319     2   p    v              endif                ! end of if(flagiter) loop
             320     1   p    v            enddo
             321                     
             322                           return
             323                           end


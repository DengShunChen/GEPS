                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pl_lat4, PL_LAT
                                   <<< Loop-information  End >>>
              52        pp   2v              pl_lat(:)  = pl_lat4(:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pl_time4, PL_TIME
                                   <<< Loop-information  End >>>
              53        pp   2v              pl_time(:) = pl_time4(:)
              54                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]

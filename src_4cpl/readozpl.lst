                                   <<<      tempin4, ozplin
                                   <<< Loop-information  End >>>
              75     3   p                     do k=1,levozp    ! k  = 1 (p_bottom)     to k = levozp (p_top)
              76     3   p                        k1=levozp-k+1 ! k1 = levozp(p_bottom) to k1= 1 (p_top)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tempin4, ozplin
                                   <<< Loop-information  End >>>
              77     4   p   2v                do j=1,latsozp
              78     4   p   2v                    ozplin(j,k1,n,i) = tempin4(j,k,n,i)
              79     4   p   2v                enddo
              80     3   p                   enddo
              81     2   p                 enddo
              82     1   p                 enddo
              83                     
              84     1                     if (myrank.eq.0 .and. me .eq. 0) then
              85     1                         print *,'*** in read_ozpl ****'
              86     1                         print *,' pl_coeff=',pl_coeff
              87     1                         print *,' latsozp=',latsozp,' levozp=',levozp,' timeoz=',timeoz
              88     1                         write(*,111)pl_lat
              89     1                         write(*,112)pl_pres
              90     1                         write(*,113)pl_time
              91     1               !
              92     1               
              93     1                     allocate(xmax(pl_coeff,timeoz))
              94     1                     allocate(xmin(pl_coeff,timeoz))
              95     1                     allocate(rmax(pl_coeff))
              96     1                     allocate(rmin(pl_coeff))
              97     1               
              98     2                     do i=1,pl_coeff
              99     2                        rmax(i)=-1.0e25
             100     2                        rmin(i)=1.0e25
             101     2                     enddo
             102     2                     do i=1,timeoz
             103     3                     do n=1,pl_coeff
             104     3                        xmax(n,i)=-1.0e25
             105     3                        xmin(n,i)=1.0e25
             106     3                     enddo
             107     2                     enddo
             108     1               
             109     1               
             110     1               !     print out max/min
             111     1               
             112     1                     amax=-1.0e25
             113     1                     amin=1.0e25
             114     2                     do i=1,timeoz
             115     3                       do n=1,pl_coeff
             116     4                         do k=1,levozp    ! k  = 1 (p_bottom)     to k = levozp (p_top)
             117     5                         do j=1,latsozp
             118     5                             if (ozplin(j,k,n,i) .ge. xmax(n,i)) xmax(n,i)=ozplin(j,k,n,i)
             119     5                             if (ozplin(j,k,n,i) .le. xmin(n,i)) xmin(n,i)=ozplin(j,k,n,i)
             120     5                             if (ozplin(j,k,n,i) .ge. rmax(n)) rmax(n)=ozplin(j,k,n,i)
             121     5                             if (ozplin(j,k,n,i) .le. rmin(n)) rmin(n)=ozplin(j,k,n,i)
             122     5                             if (ozplin(j,k,n,i) .ge. amax) amax=ozplin(j,k,n,i)
             123     5                             if (ozplin(j,k,n,i) .le. amin) amin=ozplin(j,k,n,i)
             124     5                         enddo
             125     4                       enddo
             126     3                     enddo
             127     2                     enddo
             128     1               
             129     1                     print *,'*** in read_ozplin ****'
             130     1                     print *,'*** ozplin: max=',amax,' amin=',amin
             131     2                     do n=1,pl_coeff
             132     2                        write(*,121)n,rmax(n),rmin(n)
             133     2                     enddo
             134     1               
             135     2                     do i=1,timeoz
             136     3                     do n=1,pl_coeff
             137     3                        write(*,122)i,n,xmax(n,i),xmin(n,i)
             138     3                     enddo
             139     2                     enddo
             140     1               
             141     1                     endif
             142                     
             143                      110  continue
             144                      111  format (' pl_lat=',10f6.1)
             145                      112  format (' pl_pres=',6f11.4)
             146                      113  format (' pl_time=',10f6.1)
             147                      121  format(' pl_coeff=',i2,' ozplin-max=',e15.4,                 &
             148                                  ' ozplin-min=',e15.4)
             149                      122  format(' month=',i2,' pl_coeff=',i2,' ozplin-max=',e15.4,    &

 External subroutine subprogram "read_ozplin"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine read_ozplin(myrank)
               2                     !######################################################################
               3                     ! subroutine to read the coefficients of ozone chemistry parametrization
               4                     ! The forecast model includes a prognostic equation for the ozone mass
               5                     ! mixing ration (kg/kg)
               6                     !   dO3/dt = C1 + C2(O3-O3mean) + C3(T-Tmean) + C4(O3F - O3Fmean)
               7                     ! The parameterization assumes that chemiscal changes in ozone can be
               8                     ! described by a linear relaxation towards a phtochemical equilibrium.
               9                     ! Here Ci are relaxation rates which comes from NCEP-CFSV2.
              10                     !
              11                     ! Modifie by : Mei-Yu Chang. 2014/6/20
              12                     ! #####################################################################
              13                     
              14                           use machine, only : kind_io4, kind_phys
              15                           use ozne_def
              16                           integer n,k,i,j,istat,myrank,k1,me
              17                     
              18                           real (kind=kind_io4), allocatable :: pl_lat4(:), pl_pres4(:),       &
              19                                                 pl_time4(:)
              20                           real (kind=kind_io4), allocatable :: tempin(:)
              21                           real (kind=kind_io4), allocatable :: tempin4(:,:,:,:)
              22                           real (kind=kind_phys), allocatable :: xmin(:,:), xmax(:,:)
              23                           real (kind=kind_phys), allocatable :: rmin(:), rmax(:)
              24                     
              25                           character*80 pathname,filename,truefile
              26                     
              27                           data pathname/'FIXDIR'/
              28                           data filename/'global_o3prdlos.f77'/
              29                           me=1
              30                     !
              31                           call getfname(pathname,filename,truefile,istat)
              32     1                     if(istat.ne.0)then
              33     1                       print *,'getfname : error',truefile
              34     1                       call mpe_finalize
              35     1                       call dmsexit(-1)
              36     1                     else
              37     1               !       if(myrank .eq. 0) print *,truefile
              38     1                     endif
              39                     !
              40                         open(kozpl,file=trim(truefile),form='unformatted',convert='BIG_ENDIAN')
              41                     !
              42                             rewind (kozpl)
              43                             read (kozpl) pl_coeff, latsozp, levozp, timeoz
              44                     
              45                             allocate (pl_lat(latsozp), pl_pres(levozp),pl_time(timeoz+1))
              46                             allocate (pl_lat4(latsozp), pl_pres4(levozp),pl_time4(timeoz+1))
              47                     
              48                             rewind (kozpl)
              49                             read (kozpl,end=110) pl_coeff, latsozp, levozp, timeoz, pl_lat4,   &
              50                                           pl_pres4, pl_time4
              51                     

                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tempin, tempin4
                                   <<< Loop-information  End >>>
              68     3  pp   2v                   tempin4(:,k,n,i) = tempin(:)
              69     3                         enddo
              70     2                       enddo
              71     1                     enddo
              72                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>

                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pl_pres4, PL_Pres
                                   <<< Loop-information  End >>>
              55     1  pp   2v              do k = 1, levozp
              56     1   p   2v                 k1=levozp-k+1
              57     1   p   2v                 pl_pres(k1) = pl_pres4(k)
              58     1   p   2v              enddo
              59                     !
              60                           allocate(ozplin(latsozp,levozp,pl_coeff,timeoz))!OZONE P-L coeffcients
              61                           allocate(tempin4(latsozp,levozp,pl_coeff,timeoz))!OZONE P-L coeffcients
              62                           allocate(tempin(latsozp))
              63                     
              64     1                     do i=1,timeoz
              65     2                       do n=1,pl_coeff
                                   <<< Loop-information Start >>>

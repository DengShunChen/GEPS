 External subroutine subprogram "nor_gwdp"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine nor_gwdp(j,nxj,nx,lev,u,v,t,q,plt,pk,pk2,hi,dt,grav,rgas,sinl &
               2                           ,                   cosl,avgdrag_u,avgdrag_v,cp,ptop)
               3                     !
               4                     ! reference : Scinocca(2002,2003) JAS and Andrew Orr(2010) J. of Climate
               5                     !
               6                     !---- input:
               7                     !---- nxj    : number of point in lontitude of reduced gauslian grid.
               8                     !---- nx     : dimension of lontitude.
               9                     !---- lev    : dimension of vertical.
              10                     !---- dt     : 2.*dt dt: time step of model integration
              11                     !---- grav   : gravity of earth
              12                     !     rgas   : dry gas constant (=287.)
              13                     !---- sinl   : sin of latitude
              14                     !     t     : temperature  (k)
              15                     !     q     : specific humidity (kg/kg)
              16                     !     plt   : pressure at odd-level (mb)
              17                     !     pk    : p**kcapa at odd-level ((=p/1000.)**0.286)
              18                     !     pk2   : p**kcapa at even-level ((=p/1000.)**0.286)
              19                     !     hi    : geopotential height (m2/s2)
              20                     !---- u      : velocity of x-component
              21                     !---- v      : velocity of y-component
              22                     !---- output:
              23                     !---  u,v
              24                     !-----------------------------------------
              25                     !---- den    : density of atmosphere
              26                     !---- sn2    : Brunt-Vasisla frequency
              27                     !---- p2     : pressure at even-level (mb)
              28                     !---- nc        : number of spectral elements of the gravity wave phase speed.
              29                     !---- nphi      : number of azimuths of the gravity waves.
              30                     !---- cmin      : minimun phase speed of the gravity waves(m/s).
              31                     !---- cmax      : the maximun phase speed of the gravity waves(m/s).
              32                     !---- taul      : constant=0.6 s/m
              33                     !---- cstar     : constant=1.
              34                     !---- pw        : constant=1.5 exponent power of gravity wave frequency
              35                     !---- s         : constant=1. low-m exponent
              36                     !---- lunch_lev     : lunch level of gravity wave
              37                     !---- wavelenth : characteric vertical wave-length
              38                     !---- fluxtoatl : total lunch E-P flux in each nc direction
              39                     !
              40                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              41                     !
              42                     
              43                     !ch>
              44                           use index, only : nxdef
              45                           use const, only : RTYPE
              46                     !ch<
              47                     
              48                           implicit  none
              49                     
              50                           integer   j,nxj,nx,lev
              51                           real      dt,grav,rgas,sinl,cosl,cp
              52                     
              53                           real      plt(nx,lev),                                  &
              54                                     avgdrag_u(lev),avgdrag_v(lev)
              55                           real(kind=RTYPE) u(nx,lev),v(nx,lev),t(nx,lev),         &
              56                                            q(nx,lev),hi(nx,lev),pk(nx,lev),       &
              57                                            pk2(nx,lev)
              58                     
              59                     ! local array
              60                           integer,  parameter :: nc=20,nphi=4
              61                           real      p2(nx,lev),den(nx,lev),sn2(nx,lev),pt(nx,lev)
              62                           real      fluxsat(nc,nx,lev,nphi),flux(nc,nx,lev,nphi),dflux(nx,lev,nphi),&
              63                                     fluxsat_nc(nx,lev,nphi),flux_nc(nx,lev,nphi),           &
              64                                     dflux_u(nx,lev),dflux_v(nx,lev),                        &
              65                                     a(nx),cn(nc),uv_lunch(nx,nphi),uv(nx,lev,nphi),         &
              66                                     fxin(nc,nphi),fxout(nc),drag_u(nx,lev),drag_v(nx,lev)
              67                           real      mstar
              68                     !
              69                           integer   ilon,jlat,kk,lunch_lev,ltop,i,k,nc1,n,nn,ndir
              70                           real      cmin,cmax,taul,cstar,pw,s,wavelenth,fluxtotal,ptop
              71                           real      pi,omega,acor,cor,wtcosl,dz1,s1,s2,p,corp,xmin,xmax
              72                           real      b1,b2,dc,xbar,x,s3,uhat,fxtotal,chat,flux1,flux2,dflux1
              73                           real      uhat_z0,uhat_z1,dpk,wsold,wsnew
              74                     
              75                     !      data cmin/0.25/, cmax/2000./ taul/0.6/
              76                     !      data cstar/1./, pw/1./, s/1./, wavelenth/2000./
              77                     !      data fluxtotal/3.75e-4/, lunch_lev/44/, ltop/1/
              78                           data cmin/0.25/, cmax/1000./ taul/0.25/, lunch_lev/44/
              79                           data cstar/1./, ltop/1/, wavelenth/2000./
              80                           data fluxtotal/3.75e-4/, pw/1.5/, s/0./    !CG1
              81                     !
              82                           ilon=1142
              83                           jlat=nx/4
              84                           kk=31
              85                     !
              86                           pi=4.*atan(1.)
              87                           omega=7.292e-5
              88                           cor=2.*omega*sinl
              89                           acor=abs(cor)
              90                     !
              91                     !ch   wtcosl=nxj*cosl
              92                           wtcosl=nxdef(j)*cosl
              93                     !
              94                     ! ... pressure at even-level (p2)
              95                     ! ... potential temperature (pt)
              96                     ! ... density (den)
              97                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sn2, den, pt, p2
                                   <<< Loop-information  End >>>
              98        pp   2v            p2=0.
              99         p   2v            pt=0.
             100         p   2v            den=0.
             101         p   2v            sn2=0.
             102                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, t, plt, pk, q, den, pt, p2
                                   <<< Loop-information  End >>>
             103     1  pp                 do k=1,lunch_lev+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, plt, pk, q, pk2, den, pt, p2
                                   <<< Loop-information  End >>>
             104     2   p    v            do i=1,nxj
             105     2   p    v              p2(i,k)=1000.0*pk2(i,k)*pk2(i,k)*pk2(i,k)*sqrt(pk2(i,k))
             106     2   p    v              pt(i,k)=t(i,k)*(1.0+0.608*q(i,k))/pk(i,k)
             107     2   p    v              den(i,k)=plt(i,k)*100./(rgas*t(i,k))
             108     2   p    v            enddo
             109     1   p                 enddo
             110                     !
             111                     ! ... brunt-vaisala frequency (sn2)
             112                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hi, pt, sn2
                                   <<< Loop-information  End >>>
             113     1  pp                 do k=1,lunch_lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hi, pt, sn2
                                   <<< Loop-information  End >>>
             114     2   p    v            do i=1,nxj
             115     2   p    v              dz1=(hi(i,k)-hi(i,k+1))/grav
             116     2   p    v              s1=pt(i,k)-pt(i,k+1)
             117     2   p    v              s2=(pt(i,k)+pt(i,k+1))/2.
             118     2   p    v              sn2(i,k)=grav*s1/(s2*dz1)
             119     2   p    v              if(sn2(i,k) .le. acor)sn2(i,k)=acor
             120     2   p    v            enddo
             121     1   p                 enddo
             122                     !      do i=1,nxj
             123                     !        sn2(i,lev)=sn2(i,lev-1)
             124                     !      enddo
             125                     !      if(j.eq.jlat)then
             126                     !          call findmaxf(nxj,nx,lev,sn2,vmax,iv,kv,vmin,ivm,kvm)
             127                     !          print *,' sn2=',vmax,iv,kv,' vmin=',vmin,ivm,kvm
             128                     !          call findmaxf(nxj,nx,lev,den,vmax,iv,kv,vmin,ivm,kvm)
             129                     !          print *,' den=',vmax,iv,kv,' vmin=',vmin,ivm,kvm
             130                     !      endif
             131                     !
             132                     !  coefficient of A(indepedent of height) in eq-(4) (Orr,2010)
             133                     !
             134                           mstar=2.*pi/wavelenth
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a
                                   <<< Loop-information  End >>>
             135        pp   4v            a=0.
             136                           p=2.-pw
             137                           corp=acor**p
             138                     !      if(j.eq.jlat)print *,'mstar,p,cor,corp=',mstar,p,cor,corp
             139                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.46, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sn2, a
                                   <<< Loop-information  End >>>
             140     1  pp   2v            do i=1,nxj
             141     1   p   2v              a(i)=cstar*mstar**3*(sn2(i,lunch_lev)**p-corp)/p
             142     1   p   2v              if(a(i).le.0.)a(i)=0.
             143     1   p   2v            enddo
             144                     !      if(j.eq.jlat)then
             145                     !          call findmaxf(nxj,nx,1,a,vmax,iv,kv,vmin,ivm,kvm)
             146                     !          print *,' a=',vmax,iv,kv,' vmin=',vmin,ivm,kvm
             147                     !      endif
             148                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uv_lunch
                                   <<< Loop-information  End >>>
             149        pp   4v            uv_lunch=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uv
                                   <<< Loop-information  End >>>
             150        pp   4v            uv=0.
             151                           k=lunch_lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uv, uv_lunch, v, u
                                   <<< Loop-information  End >>>
             152     1  pp    v            do i=1,nxj
             153     1   p    v              uv_lunch(i,1)=u(i,k)
             154     1   p    v              uv_lunch(i,2)=u(i,k)
             155     1   p    v              uv_lunch(i,3)=v(i,k)
             156     1   p    v              uv_lunch(i,4)=v(i,k)
             157     1   p    v              uv(i,k,1)=uv_lunch(i,1)
             158     1   p    v              uv(i,k,2)=uv_lunch(i,2)
             159     1   p    v              uv(i,k,3)=uv_lunch(i,3)
             160     1   p    v              uv(i,k,4)=uv_lunch(i,4)
             161     1   p    v            enddo
             162                     !      if(j.eq.jlat)then
             163                     !        do nn=1,nphi
             164                     !          print *,' lunch nn,u,v=',nn,uv_lunch(ilon,nn)
             165                     !        enddo
             166                     !      endif
             167                     !
             168                     ! do coordinate stretch, eq-(28),(29),(30) (Scinocca,2003)
             169                     ! cn: transformed wave phase speed
             170                     !
             171                           xmin=1./cmin
             172                           xmax=1./cmax
             173                           b1=(xmax-xmin)/(exp((xmax-xmin)/taul)-1)
             174                           b2=xmin-b1
             175                     !
             176                           dc=xmax-xmin
             177                           nc1=nc-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 43
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             178     1   s   fv            do n=1,nc
             179     1   p   fv              xbar=xmin+dc*(n-1)/nc1
             180     1   p   fv              x=b1*exp((xbar-xmin)/taul)+b2
             181     1   p   fv              cn(n)=1./x
             182     1   p   fv            enddo
             183                     !
             184                     !      if(j.eq.jlat)then
             185                     !          print *,' b1,b2=',b1,b2
             186                     !          print *,' cn=',(cn(n),n=1,nc)
             187                     !      endif
             188                     !
             189                           s3=s+3
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 190,192)
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flux, dflux, fluxsat_nc, flux_nc
                                   <<<      fluxsat
                                   <<< Loop-information  End >>>
             190        pp   2v            fluxsat=0.
             191         p   2v            flux=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             192         p                 dflux=0.
             193         p                 fluxsat_nc=0.
             194         p                 flux_nc=0.
             195                     !
             196                     !  for lunch level, assign fluxtotal value to spectral flux density and
             197                     !  saturate flux density and assign u,v at lunch  level to variable 'uv'
             198                     !  for pw=1,p=2-pw=1 and uhat=0, the formula of flux density is simply rewriten.
             199                     !
             200                           k=lunch_lev
             201                           uhat=0.
             202     1                     do nn=1,nphi
             203     1                       ndir=1.
             204     1                       if(nn.eq.2 .or. nn.eq.4)ndir=-1.
             205     1                       fxtotal=fluxtotal*ndir
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sn2, den, a, fluxsat, flux_nc
                                   <<<      fluxsat_nc, flux
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             206     2                       do i=1,nxj
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             207     3   s   fv                do n=1,nc
             208     3   p   fv                  chat=cn(n)*ndir
             209     3   p   fv                  flux1=cstar*den(i,k)*a(i)*(chat-uhat)/sn2(i,k) &
             210     3               !    &           *abs((chat-uhat)/chat)**p
             211     3                                *abs((chat-uhat)/chat)
             212     3   p   fv                  flux2=1./(1.+(mstar*(chat-uhat)/sn2(i,k))**s3)
             213     3   p   fv                  fluxsat(n,i,k,nn)=flux1
             214     3   p   fv                  fxin(n,nn)=flux1*flux2
             215     3   p   fv                enddo
             216     2               !
             217     2               !          if(j.eq.jlat .and. i.eq.ilon)then
             218     2               !          if(nn.eq.1)then
             219     2               !            print *,'bef norm fxin at lunch=',(fxin(n,nn),n=1,nc)
             220     2               !          endif
             221     2               !          endif
             222     2               !
             223     2                         call normalize(fxtotal,nc,fxin(1,nn),flux(1,i,k,nn))
             224     2               !
             225     2               !          if(j.eq.jlat .and. i.eq.ilon)then
             226     2               !          if(nn.eq.1)then
             227     2               !            print *,'aft norm fxin at lunch=',(flux(n,i,k,nn),n=1,nc)
             228     2               !          endif
             229     2               !          endif
             230     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

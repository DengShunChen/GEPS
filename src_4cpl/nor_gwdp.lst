 External subroutine subprogram "findmaxf"
  (inc)(line-no.)(nest)(optimize)
             410                     !
             411                           subroutine findmaxf(nxj,nx,lev,f,fmax,i1,k1,fmin,i1m,k1m)
             412                           implicit  none
             413                           integer   nxj,nx,lev,i1,k1,i1m,k1m
             414                           real      f(nx,lev),fmax,fmin
             415                           integer   k,i
             416                     
             417                           fmax=-99999.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             418     1  pp                 do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f
                                   <<< Loop-information  End >>>
             419     2   p   4s              do i=1,nxj
             420     3   p   4v                if(f(i,k).ge.fmax)then
             421     3   p   4s                  fmax=f(i,k)
             422     3   p   4m                  i1=i
             423     3   p   4v                  k1=k
             424     3   p   4m                endif
             425     2   p   4s              enddo
             426     1   p                 enddo
             427                           fmin=99999.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             428     1  pp                 do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f
                                   <<< Loop-information  End >>>
             429     2   p   4s              do i=1,nxj
             430     3   p   4v                if(f(i,k).le.fmin)then
             431     3   p   4s                  fmin=f(i,k)
             432     3   p   4m                  i1m=i
             433     3   p   4v                  k1m=k
             434     3   p   4m                endif
             435     2   p   4s              enddo
             436     1   p                 enddo
             437                           return
             438                           end


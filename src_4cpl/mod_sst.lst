             981                             SUBROUTINE read_ocaf0(nx,my,lkvl,ggdef,idtg1)
             982                     
             983                               use index
             984                               use rank
             985                     
             986                     
             987                               integer nx,my,lkvl
             988                               character*4 ggdef
             989                               integer*8 idtg1
             990                               character*12 cdtg
             991                     !          integer   iyyyy,mm,ddhhmn,iyy,imm,istat
             992                               integer istat,k,lncrec
             993                               integer j,jj,nxj,i,ii
             994                               character lrec*26
             995                               REAL, ALLOCATABLE, TARGET :: temp1(:,:),temp2(:,:)
             996                               logical flag
             997                     !
             998                               if(.not. ALLOCATED(temp1)) allocate (temp1(nx,my))
             999                               if(.not. ALLOCATED(temp2)) allocate (temp2(nx,my))
            1000                     
            1001                               if(.not. ALLOCATED(wdepths)) ALLOCATE(wdepths(1:lkvl+2))
            1002                               if(.not. ALLOCATED(wtfn1st)) ALLOCATE(wtfn1st(nxp,1:lkvl+2,my_max))
            1003                               if(.not. ALLOCATED(mask1st)) ALLOCATE(mask1st(nxp,my_max))
            1004                     
            1005                               nwdepth=lkvl+2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wdepths
                                   <<< Loop-information  End >>>
            1006        pp   4v                wdepths(1:lkvl+2)=sit_zdepth(0:lkvl+1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtfn1st
                                   <<< Loop-information  End >>>
            1007        pp   4v                wtfn1st=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mask1st
                                   <<< Loop-information  End >>>
            1008        pp   4v                mask1st=0.
            1009                     
            1010                               write(cdtg,'(i12)') idtg1
            1011                     !          read(cdtg,'(i4,i2,i8)')iyyyy,mm,ddhhmn
            1012                     
            1013                     
            1014                       11     format(i3.3,'TFN','0000',a4,a12)  ! ???TFM
            1015                       12     format(i3.3,'MSK','0000',a4,a12)  ! ???SFM
            1016                     
            1017                     !          do k=1,lkvl+2
            1018     1                         do k=1,1
            1019     1               
            1020     1                          lncrec=nx*my
            1021     1                          write(lrec,11) k-1,ggdef,cdtg
            1022     1                          if(myrank .eq. 0) print *, 'lrec11=',lrec
            1023     1                          call dmsread(nx,my,lrec,lncrec,'H',ifilin,temp1(:,:),istat)
            1024     1                          write(lrec,12) k-1,ggdef,cdtg
            1025     1                          if(myrank .eq. 0) print *, 'lrec12=',lrec
            1026     1                          call dmsread(nx,my,lrec,lncrec,'H',ifilin,temp2(:,:),istat)
            1027     1               
            1028     1               !           if( lreduce.eq.1 ) call reducepickr(temp1(1,1),nxdef,nx,my)
            1029     1               !           if( lreduce.eq.1 ) call reducepickr(temp2(1,1),nxdef,nx,my)
            1030     1               
            1031     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, temp1, mask1st, wtfn1st
                                   <<< Loop-information  End >>>
            1032     2                          do jj=1,jlistnum
            1033     2                             j=jlist1(jj)
            1034     2                             nxj=nxdef_2d(j)
            1035     3                             if( lreduce.eq.1 )then
            1036     3                               call reducepickr (temp1(1,j),nxdef(j),nx,1)
            1037     3                               call reducepickr (temp2(1,j),nxdef(j),nx,1)
            1038     3                             endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, temp1, mask1st, wtfn1st
                                   <<< Loop-information  End >>>
            1039     3  pp   2v                    do ii = 1, nxj
            1040     3   p   2v                       i=nxjstart(j)+ii-1
            1041     3   p   2v                       wtfn1st(ii,k,jj)=temp1(i,j)
            1042     3   p   2v                       mask1st(ii,jj)=temp2(i,j)
            1043     3   p   2v                    enddo   !end of ii
            1044     2                           enddo    !end of jj
            1045     1               
            1046     1                         enddo !end of k
            1047                     
            1048                               deallocate(temp1,temp2)
            1049                     
            1050                     !         call dmscls(ifilin_ocaf,istat)
            1051                     
            1052                             END SUBROUTINE read_ocaf0

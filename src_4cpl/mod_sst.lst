            1739                           SUBROUTINE read_dailygodas(idtg1,tau,dtx)
            1740                     
            1741                         ! U. Schulzweida, MPI, March 2007
            1742                         ! Ben-Jei Tsuang, NCHU, Sep 2015
            1743                     
            1744                     !ps       USE mo_doctor,        ONLY: nout
            1745                     !ps       USE mo_control,       ONLY: nist
            1746                     !ps       USE mo_exception,     ONLY: finish, message, message_text
            1747                     !ps       USE mo_io,           ONLY: io_open_unit, io_close, io_open, &
            1748                     !ps                                io_var_id, io_file_id, io_read, &
            1749                     !ps                                gpnc0, gpnc1, gpnc2
            1750                     !ps       USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            1751                     !ps       USE mo_transpose,     ONLY: scatter_gp
            1752                            USE mo_netcdf,        ONLY: io_open_unit, io_close, io_open, &
            1753                                                     io_inq_dimid, io_inq_dimlen,     &
            1754                                                     io_inq_varid, io_get_var_double, &
            1755                                                     io_get_vara_double, io_get_att_double
            1756                     
            1757                     
            1758                            REAL      :: ydate
            1759                            INTEGER, PARAMETER:: LAST_RECORD=-999
            1760                            INTEGER, PARAMETER:: DAY_MINUS1=1
            1761                            INTEGER, PARAMETER:: THE_DATE=2
            1762                            INTEGER, PARAMETER:: DAY_PLUS1=3
            1763                     
            1764                            CHARACTER (90) :: fn(3)
            1765                            INTEGER       :: ihy0, ihy1, ihy2
            1766                            INTEGER       :: yrori, modyhrmn
            1767                            INTEGER       :: yr, mo, dy, hr, mn
            1768                     !ps
            1769                            INTEGER*8 :: idtg1,idtg_temp
            1770                            REAL      :: tau,dtx,tauleft,hrleft
            1771                            INTEGER   :: icurrenttau
            1772                            INTEGER :: lnc
            1773                            TYPE (FILE_INFO), save :: gpnc0, gpnc1, gpnc2
            1774                            INTEGER :: io_var_id         !,IO_file_id,  IO_dim_id
            1775                            INTEGER, PARAMETER:: IO_READ=1
            1776                            LOGICAL :: flag=.false.
            1777                            character*12 cdtg
            1778                     !ps
            1779                     
            1780                     !ps       CALL get_date_components(next_date, yr, mo, dy, hr, mn, se)
            1781                     !ps       ydate = yr*10000.+mo*100.+dy+(hr+mn/60.+se/3600.)/24.
            1782                            icurrenttau=int(tau)
            1783                            tauleft=float(int((tau-int(tau)+0.001)*3600./dtx))*dtx   !(sec)
            1784     1                      if(tauleft .eq. 3600.) then
            1785     1                       icurrenttau=icurrenttau+1
            1786     1                       tauleft=0.
            1787     1                      endif
            1788                            call dtgfix12(idtg1,idtg_temp,icurrenttau)
            1789                            write(cdtg,'(i12)')idtg1
            1790                            read(cdtg,'(i4,i8)')yrori,modyhrmn
            1791                            write(cdtg,'(i12)')idtg_temp
            1792                            read(cdtg,'(i4,i2,i2,i2,i2)')yr,mo,dy,hr,mn
            1793                            ydate=float(yr*10000+mo*100+dy)+float(hr)/24.+tauleft/3600./24.
            1794                            if(myrank .eq. 0) print *,"read_dailygodas,ydate=",ydate
            1795                     
            1796     1                      IF (myrank .eq. 0) THEN
            1797     1               !ps         CALL set_years(ihy0, ihy1, ihy2)
            1798     1                        ihy1=idtg_temp/100000000
            1799     1                        ihy0=ihy1-1
            1800     1                        ihy2=ihy1+1
            1801     1                        CALL chlen (ifilin_nc,80,lnc)
            1802     1                        WRITE (fn(1), '(A,A11,i4)') ifilin_nc(1:lnc),'/dailygodas',ihy0
            1803     1                        WRITE (fn(2), '(A,A11,i4)') ifilin_nc(1:lnc),'/dailygodas',yrori !ihy1
            1804     1                        WRITE (fn(3), '(A,A11,i4)') ifilin_nc(1:lnc),'/dailygodas',ihy2
            1805     1               !ps         WRITE (fn(1), '("dailygodas",i4)') ihy0
            1806     1               !ps         WRITE (fn(2), '("dailygodas",i4)') ihy1
            1807     1               !ps         WRITE (fn(3), '("dailygodas",i4)') ihy2
            1808     1               !ps         WRITE (nerr, '(/)')
            1809     1               !ps         WRITE(nerr,*) 'dailygodas ydate: ', ydate
            1810     1               !ps         WRITE(nerr,*) 'dailygodas ydate: fn(1): ' &
            1811     1               !ps           , TRIM(fn(1)),' fn(2): ', TRIM(fn(2)),' fn(3): ', TRIM(fn(3))
            1812     1                      ENDIF
            1813                     
            1814                     !       IF (lresume .OR. lstart) THEN
            1815     1                      IF ((tau .eq. 0.) .OR. lsitstart) THEN
            1816     1                   !!! warm/cold start
            1817     1                        CALL read_godas_3days
            1818     1                      ELSEIF (ydate.LE.timevals_godas(2)) THEN
            1819     1                   ! data were read. Note that initial value of  timevals_godas=0.
            1820     1                        RETURN
            1821     1                      ELSEIF (ydate.LE.timevals_godas(3)) THEN
            1822     1                   ! note that initial value of  timevals_godas=0.
            1823     1                   ! Shift left
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ot12
                                   <<< Loop-information  End >>>
            1824     1  pp   2v              ot12(:,:,:,1)=ot12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      os12
                                   <<< Loop-information  End >>>
            1825     1  pp   2v              os12(:,:,:,1)=os12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ou12
                                   <<< Loop-information  End >>>
            1826     1  pp   2v              ou12(:,:,:,1)=ou12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ov12
                                   <<< Loop-information  End >>>
            1827     1  pp   2v              ov12(:,:,:,1)=ov12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mixedlayer12
                                   <<< Loop-information  End >>>
            1828     1  pp   2v              mixedlayer12(:,:,1)=mixedlayer12(:,:,2)
            1829     1                       timevals_godas(1)=timevals_godas(2)
            1830     1                       files_godas(1)=files_godas(2)
            1831     1                       nts_godas(1)=nts_godas(2)
            1832     1                       tsID_godas(1)=tsID_godas(2)
            1833     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ot12
                                   <<< Loop-information  End >>>
            1834     1  pp   2v              ot12(:,:,:,2)=ot12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      os12
                                   <<< Loop-information  End >>>
            1835     1  pp   2v              os12(:,:,:,2)=os12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ou12
                                   <<< Loop-information  End >>>
            1836     1  pp   2v              ou12(:,:,:,2)=ou12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ov12
                                   <<< Loop-information  End >>>
            1837     1  pp   2v              ov12(:,:,:,2)=ov12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mixedlayer12
                                   <<< Loop-information  End >>>
            1838     1  pp   2v              mixedlayer12(:,:,2)=mixedlayer12(:,:,3)
            1839     1                       timevals_godas(2)=timevals_godas(3)
            1840     1                       files_godas(2)=files_godas(3)
            1841     1                       nts_godas(2)=nts_godas(3)
            1842     1                       tsID_godas(2)=tsID_godas(3)
            1843     2                       if( (files_godas(3).eq.3) .AND. (yrori.lt.yr)) then
            1844     2                          files_godas(2)=2
            1845     2                       endif
            1846     1               
            1847     1               
            1848     1                       CALL read_godas_dayp1(DAY_PLUS1)    ! read day+1 data
            1849     1                     ELSE
            1850     1                       CALL read_godas_3days
            1851     1                     ENDIF
            1852                     
            1853                           CONTAINS
            1854                         !-----------------------------------
            1855                            SUBROUTINE read_godas_3days
            1856                     
            1857                            INTEGER               :: io_nlon  ! number of longitudes in NetCDF file
            1858                            INTEGER               :: io_ngl   ! number of latitudes in NetCDF file
            1859                            INTEGER               :: io_ndepth  ! number of odepths in NetCDF file
            1860                            REAL, ALLOCATABLE :: timevals1(:), timevals2(:)
            1861                     
            1862                            INTEGER       :: i, jk, k, j, m
            1863                            LOGICAL       :: lex1, lex2
            1864                            INTEGER       :: istat
            1865                            INTEGER       :: ndimid, nts1, tsID
            1866                            INTEGER       :: ndimid2, nts2
            1867                     
            1868                            REAL :: timevals_godas(3) = 0.  ! absoulte time (e.g., 19971003.25) GODAS PENTAD Data
            1869                     
            1870                            istat=0
            1871                            flag=.false.
            1872     1                      IF (myrank .eq. 0) THEN
            1873     1                        INQUIRE (file=fn(2), exist=lex1)
            1874     2                        IF ( .NOT. lex1 ) THEN
            1875     2                          WRITE (message_text,*) 'Could not open file <',fn(2),'>'
            1876     2               !ps           CALL message('',message_text)
            1877     2                          WRITE (nerr,*) message_text
            1878     2               !ps           CALL finish ('read_dailygodas', 'run terminated.')
            1879     2                          istat=-1
            1880     2                          nodepth=40               ! number of depths of daily fodas pentad data (=40)
            1881     2                        ELSE
            1882     2                          CALL IO_open (fn(2), gpnc1, IO_READ)
            1883     2                        !! WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 3.0 '
            1884     2                          ! Check resolution
            1885     2                          CALL io_inq_dimid  (gpnc1%file_id, 'lat', io_var_id)
            1886     2                          CALL io_inq_dimlen (gpnc1%file_id, io_var_id, io_ngl)
            1887     2                          CALL io_inq_dimid  (gpnc1%file_id, 'lon', io_var_id)
            1888     2                          CALL io_inq_dimlen (gpnc1%file_id, io_var_id, io_nlon)
            1889     2                          CALL io_inq_dimid  (gpnc1%file_id, 'time', io_var_id)
            1890     2                          !!! CALL io_inq_dimlen (gpnc1%file_id, io_var_id, io_ntime)
            1891     2                          !!      WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 4.0 '
            1892     2                          !!      WRITE(nerr,'(/,A,I2)') 'number of latitudes of world ocean atlas data = ',io_ngl
            1893     2               
            1894     2               !ps           IF ( (io_ngl/=lc%nlat).OR.(io_nlon/=lc%nlon) ) THEN
            1895     3                          IF ( (io_ngl/=nlat).OR.(io_nlon/=nlon) ) THEN
            1896     3                             WRITE(nerr,*) 'read_godas_3days: unexpected resolution ',io_nlon,io_ngl
            1897     3                             WRITE(nerr,*) 'expected number of latitudes = ',nlat
            1898     3                             WRITE(nerr,*) 'number of latitudes of pentad GODAS data data = ',io_ngl
            1899     3                             WRITE(nerr,*) 'expected number of longitude = ',nlon
            1900     3                             WRITE(nerr,*) 'number of latitudes of pentad GODAS data = ',io_nlon
            1901     3               !ps              CALL finish ('read_dailygodas','unexpected resolution')
            1902     3                             WRITE(nerr,*) 'read_godas_3days','unexpected resolution'
            1903     3                             istat=-1
            1904     3                          ELSE
            1905     3                            CALL io_inq_dimid  (gpnc1%file_id, 'depth', io_var_id)
            1906     3                            CALL io_inq_dimlen (gpnc1%file_id, io_var_id, nodepth)
            1907     3                          !!      WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 4.1 '
            1908     3                          !!      WRITE(nerr,'(/,A,I2)') 'number of odepths = ',nodepth
            1909     3                          ENDIF
            1910     2                        ENDIF
            1911     1                        flag=.true.
            1912     1                      ENDIF  !end if (myrank .eq. 0)
            1913                     
            1914                     !       CALL mpe_broadcast (istat, 1, flag, mpe_integer)
            1915                            CALL mpe_bcast (istat, 1, 0, mpe_integer)
            1916                            if (myrank.eq.3) print *,'myrank3 istat=',istat
            1917     1                      if(istat .ne. 0)then
            1918     1                       if(myrank.eq.0) print *,'read_godas_3days fn2',' terminated.'
            1919     1                       call mpe_finalize
            1920     1                       call dmsexit(-1)
            1921     1                       stop
            1922     1                      endif
            1923                     
            1924                     !       CALL p_bcast (nodepth, p_io)
            1925                     !       CALL mpe_broadcast (nodepth, 1, flag, mpe_integer)
            1926                            CALL mpe_bcast (nodepth, 1, 0, mpe_integer)
            1927                            if(myrank .eq. 0) print *,"broadcast nodepth"
            1928                     
            1929                            IF (.NOT. ALLOCATED(odepths)) ALLOCATE (odepths(nodepth))
            1930                            IF (.NOT. ALLOCATED(ot12)) ALLOCATE (ot12(nxp, nodepth, my_max,3))
            1931                            IF (.NOT. ALLOCATED(os12)) ALLOCATE (os12(nxp, nodepth, my_max,3))
            1932                            IF (.NOT. ALLOCATED(ou12)) ALLOCATE (ou12(nxp, nodepth, my_max,3))
            1933                            IF (.NOT. ALLOCATED(ov12)) ALLOCATE (ov12(nxp, nodepth, my_max,3))
            1934                            IF (.NOT. ALLOCATED(mixedlayer12)) ALLOCATE (mixedlayer12(nxp, my_max,3))
            1935                     
            1936                            ! Read odepths
            1937                            flag=.false.
            1938     1                      IF (myrank .eq. 0) THEN
            1939     2                        IF (lex1) THEN
            1940     2                          !!      WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 6.0 '
            1941     2                          CALL io_inq_dimid  (gpnc1%file_id, 'depth', io_var_id)
            1942     2                          CALL io_get_var_double (gpnc1%file_id, io_var_id, odepths)
            1943     2                        else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      odepth0, odepths
                                   <<< Loop-information  End >>>
            1944     2  pp   4v                 odepths=odepth0
            1945     2                        endif
            1946     1                        flag=.true.
            1947     1                      ENDIF
            1948                     !       CALL p_bcast (odepths(1:nodepth), p_io)
            1949                     !       CALL mpe_broadcast (odepths,nodepth, flag, mpe_double)
            1950                            CALL mpe_bcast (odepths,nodepth, 0, mpe_double)
            1951                            if(myrank .eq. 0) print *,"broadcast odepths",odepths(:)
            1952     1                      IF ( lwarning_msg.GE.3 ) THEN
            1953     1                          WRITE (nerr,*) 'read_godas:: pe=',p_pe,',  odepths=',odepths(1:nodepth)
            1954     1               !!       print *,'pe=',p_pe,',  odepths=',odepths(1:nodepth)
            1955     1                      ENDIF
            1956                     
            1957                            !     Read dailygodas-file
            1958                            istat=0
            1959                            flag=.false.
            1960     1                      IF (myrank .eq. 0) THEN
            1961     1                        CALL IO_INQ_DIMID (gpnc1%file_id, 'time', ndimid)
            1962     1                        CALL IO_INQ_DIMLEN (gpnc1%file_id, ndimid, nts1)
            1963     1                        CALL IO_INQ_VARID (gpnc1%file_id, 'time', io_var_id)
            1964     1               
            1965     2                        IF ( nts1 .lt. 1 ) then
            1966     2                          WRITE(nerr,*) 'read_godas_3days', 'To few time steps < 1'
            1967     2                          istat=-1
            1968     2                        ELSE
            1969     2                          ALLOCATE (timevals1(nts1))
            1970     2                          CALL IO_GET_VAR_DOUBLE(gpnc1%file_id, io_var_id, timevals1)
            1971     2                          tsID=1
            1972     3                          DO WHILE ( (ydate.GT.INT(timevals1(tsID))).AND.(tsID.LT.nts1) )
            1973     3                            tsID=tsID+1
            1974     3                          ENDDO
            1975     2                          if(myrank .eq. 0) print*,"tsID=",tsID,",nts1=",nts1
            1976     2               !           IF ( tsID .gt. nts1 ) THEN
            1977     2               !             INQUIRE (file=fn(3), exist=lex2)
            1978     2               !             IF ( .NOT. lex2 ) THEN
            1979     2               !               WRITE (message_text,*) 'Could not open file <',fn(3),'>'
            1980     2               !               WRITE(nerr,*) message_text
            1981     2               !               WRITE(nerr,*) 'read_godas_3days fn3 ', 'run terminated.'
            1982     2               !               istat=-1
            1983     2               !             ELSE
            1984     2               !               CALL IO_open (fn(3), gpnc2, IO_READ)
            1985     2               !               CALL IO_INQ_DIMID (gpnc2%file_id, 'time', ndimid2)
            1986     2               !               CALL IO_INQ_DIMLEN (gpnc2%file_id, ndimid2, nts2)
            1987     2               !               IF ( nts2 .lt. 1 ) THEN
            1988     2               !                 WRITE (message_text,*) 'File <',fn(3),'>'
            1989     2               !                 WRITE (nerr,*) message_text
            1990     2               !                 WRITE (nerr,*) 'read_dailygodas:','To few time steps<1'
            1991     2               !                 istat=-1
            1992     2               !               ELSE
            1993     2               !                 ALLOCATE (timevals2(nts2))
            1994     2               !                 CALL IO_INQ_VARID (gpnc2%file_id, 'time', io_var_id)
            1995     2               !                 CALL IO_GET_VAR_DOUBLE(gpnc2%file_id, io_var_id, timevals2)
            1996     2               !                 tsID=1
            1997     2               !                 DO WHILE ( (ydate.GT.INT(timevals2(tsID))).AND.(tsID.LE.nts2) )
            1998     2               !                   tsID=tsID+1
            1999     2               !                 ENDDO
            2000     2               !                 IF ( tsID .gt. nts2 ) THEN
            2001     2               !                   WRITE(nerr,*) 'read_dailygodas', 'Date not found'
            2002     2               !                   istat=-1
            2003     2               !                 ELSE
            2004     2               !                   IF ( lwarning_msg.GE.1 ) THEN
            2005     2               !                     WRITE (nerr,*) 'read_godas_3days: timevals2_date=',timevals2(tsID)
            2006     2               !                   ENDIF
            2007     2               !                   tsID_godas(2)=tsID
            2008     2               !                   files_godas(2)=3
            2009     2               !                   nts_godas(2)=nts2
            2010     2               !                 ENDIF
            2011     2               !               ENDIF
            2012     2               !               CALL IO_close(gpnc2)
            2013     2               !               IF (ALLOCATED(timevals2)) DEALLOCATE(timevals2)
            2014     2               !             ENDIF
            2015     2               !           ELSE
            2016     2                            tsID_godas(2)=tsID
            2017     2                            files_godas(2)=2
            2018     2                            nts_godas(2)=nts1
            2019     3                            IF ( lwarning_msg.GE.1 ) THEN
            2020     3                              WRITE (nerr,*) 'read_godas_3days: timevals1_date=',timevals1(tsID)
            2021     3                            ENDIF
            2022     2               !           ENDIF
            2023     2                        ENDIF
            2024     1                        CALL IO_close(gpnc1)
            2025     1                        IF (ALLOCATED(timevals1)) DEALLOCATE(timevals1)
            2026     1                        flag=.true.
            2027     1                      ENDIF
            2028                     
            2029                     !       CALL mpe_broadcast (istat, 1, flag, mpe_integer)
            2030                            CALL mpe_bcast (istat, 1, 0, mpe_integer)
            2031     1                      if(istat .ne. 0)then
            2032     1                       if(myrank.eq.0) print *,'read_godas_3days.2', 'run terminated.'
            2033     1                       call mpe_finalize
            2034     1                       call dmsexit(-1)
            2035     1                       stop
            2036     1                      endif
            2037                     
            2038                            if(myrank .eq. 0) print*,'read to read_goads_dayp1'
            2039                            !!! read day-1, day and day+1 data
            2040                            CALL read_godas_dayp1(THE_DATE)     ! day+0
            2041                            CALL read_godas_dayp1(DAY_MINUS1)   ! day-1
            2042                            CALL read_godas_dayp1(DAY_PLUS1)    ! day+1
            2043                            END SUBROUTINE read_godas_3days
            2044                     
            2045                         !-----------------------------------
            2046                     
            2047                            SUBROUTINE read_godas_dayp1(dayID)
            2048                     
            2049                            ! number of codes read from godas file
            2050                            INTEGER, PARAMETER :: nrec = 5
            2051                     
            2052                            INTEGER, INTENT(in):: dayID               ! dayID = DAY_MINUS1, THE_DAY_MINUS1, or DAY_PLUS1
            2053                            REAL, ALLOCATABLE, TARGET :: zin(:,:)
            2054                            REAL, ALLOCATABLE, TARGET :: zintemp(:,:)
            2055                     
            2056                            INTEGER jk,jj,j,nxj,i,ii
            2057                            INTEGER istat
            2058                     
            2059                            LOGICAL lex2
            2060                            INTEGER irec
            2061                            CHARACTER(12) :: cname, cgodas(nrec)
            2062                            INTEGER ndimid2,varid2
            2063                            REAL, ALLOCATABLE:: timevals2(:)
            2064                            REAL:: missing_value
            2065                            INTEGER zindepth
            2066                            INTEGER, DIMENSION(4) :: io_start ! start index for NetCDF-read
            2067                            INTEGER, DIMENSION(4) :: io_count ! number of iterations for NetCDF-read
            2068                     
            2069                     
            2070     1                      IF (dayID .EQ. DAY_PLUS1) THEN
            2071     1                      ! read Day+1 data
            2072     2                        IF (tsID_godas(2).EQ.nts_godas(2)) THEN
            2073     2                          files_godas(3)=files_godas(2)!+1
            2074     2                          tsID_godas(3)=nts_godas(2)         !first record of file 3
            2075     2                        ELSE
            2076     2                          files_godas(3)=files_godas(2)
            2077     2                          tsID_godas(3)=tsID_godas(2)+1
            2078     2                        ENDIF
            2079     1                      ELSEIF (dayID .EQ. DAY_MINUS1) THEN
            2080     1                      ! read Day-1 data
            2081     2                        IF (tsID_godas(2).EQ.1) THEN
            2082     2                          files_godas(1)=files_godas(2)!-1
            2083     2                          tsID_godas(1)=1 !LAST_RECORD     !last record of file
            2084     2                        ELSE
            2085     2                          files_godas(1)=files_godas(2)
            2086     2                          tsID_godas(1)=tsID_godas(2)-1
            2087     2                        ENDIF
            2088     1                      ENDIF
            2089                     
            2090                            flag=.false.
            2091                            istat=-1
            2092     1                      IF (myrank .eq. 0) THEN
            2093     1                      INQUIRE (file=fn(files_godas(dayID)), exist=lex2)
            2094     2                      IF ( .NOT. lex2 ) THEN
            2095     2                        WRITE (message_text,*) 'Could not open file<',files_godas(dayID),'>'
            2096     2                        WRITE (nerr,*) message_text
            2097     2                        WRITE (nerr,*) 'read_dailygodas', 'run terminated.'
            2098     2                        istat=-1
            2099     2                      ELSE
            2100     2                        CALL IO_open (fn(files_godas(dayID)), gpnc2, IO_READ)
            2101     2                        CALL IO_INQ_DIMID (gpnc2%file_id, 'time', ndimid2)
            2102     2                        CALL IO_INQ_DIMLEN (gpnc2%file_id, ndimid2, nts_godas(dayID))
            2103     3                        IF ( nts_godas(dayID) .lt. 1 ) THEN
            2104     3                          WRITE (message_text,*) 'File <',fn(files_godas(dayID)),'>'
            2105     3                          WRITE(nerr,*) message_text
            2106     3                          WRITE(nerr,*) 'read_godas_dayp1:', 'To few time steps < 1'
            2107     3                          istat=-1
            2108     3                        ELSE
            2109     3                          IF(.NOT. ALLOCATED(timevals2)) ALLOCATE(timevals2(nts_godas(dayID)))
            2110     3                          CALL IO_INQ_VARID (gpnc2%file_id, 'time', io_var_id)
            2111     3                          CALL IO_GET_VAR_DOUBLE(gpnc2%file_id, io_var_id, timevals2)
            2112     3                          !!! modify tsID for LAST_RECORD
            2113     3                          IF (tsID_godas(dayID).EQ.LAST_RECORD) tsID_godas(dayID)=nts_godas(dayID)
            2114     3                          timevals_godas(dayID)=timevals2(tsID_godas(dayID))
            2115     3                          !!! data out range, set to be missing value
            2116     4                          IF (tsID_godas(dayID) .gt. nts_godas(dayID)) THEN
            2117     4                            WRITE (nerr,*) 'read_dailygodas,date=',timevals_godas(dayID) &
            2118     4                                          ,'DATA out of range!!! Set to MISSING DATA!'
            2119     4                            istat=-1
            2120     4                          ELSE
            2121     4                            istat=0
            2122     4                          ENDIF
            2123     3                          DEALLOCATE (timevals2)
            2124     3                        ENDIF
            2125     2                      ENDIF
            2126     1                      flag=.true.
            2127     1                      ENDIF   !!endif (myrank.eq.0)
            2128                     
            2129                     !       CALL mpe_broadcast (istat, 1, flag, mpe_integer)
            2130                            CALL mpe_bcast (istat, 1, 0, mpe_integer)
            2131     1                      if(istat .ne. 0)then
            2132     1                        if(myrank.eq.0) print *,'read_dailygodas', 'run terminated.'
            2133     1                        call mpe_finalize
            2134     1                        call dmsexit(-1)
            2135     1                        stop
            2136     1                      endif
            2137                     
            2138                            CALL mpe_bcast(timevals_godas,3,0,mpe_double)
            2139                            CALL mpe_bcast(tsID_godas,3,0,mpe_integer)
            2140                            CALL mpe_bcast(files_godas,3,0,mpe_integer)
            2141                            CALL mpe_bcast(nts_godas,3,0,mpe_integer)
            2142                     
            2143                            IF(.NOT. ALLOCATED(zin)) ALLOCATE (zin(nx,my))
            2144                            ! Codes read from GODAS
            2145                            cgodas(1) = 'ot'    ! ocean temperature profile (K)
            2146                            cgodas(2) = 'os'    ! ocean salinity profile (0/00)
            2147                            cgodas(3) = 'ou'    ! ocean u-component current (m/s)
            2148                            cgodas(4) = 'ov'    ! ocean v-component current (m/s)
            2149                            cgodas(5) = 'mixedlayer'    ! ocean mixed layer (m)
            2150     1                      DO irec= 1, nrec
            2151     1                        cname=cgodas(irec)
            2152     1                        zindepth=nodepth
            2153     1                        if(irec.eq.5) zindepth=1
            2154     2                        DO jk=1, zindepth
            2155     2                          flag=.false.
            2156     3                          IF(myrank .eq. 0) then
            2157     3                            IF(.NOT. ALLOCATED(zintemp)) ALLOCATE (zintemp(nx,my))
            2158     3                            CALL IO_INQ_VARID (gpnc2%file_id, cname, varid2)
            2159     3                            CALL io_get_att_double (gpnc2%file_id,varid2,'_FillValue', missing_value)
            2160     3                            io_start(:) = (/ 1, 1, jk, tsID_godas(dayID) /)
            2161     3                            io_count(:) = (/ nlon, nlat, 1, 1 /)
            2162     3                            CALL IO_GET_VARA_DOUBLE(gpnc2%file_id,varid2,io_start,io_count,zintemp(1:nlon,1:nlat))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp
                                   <<< Loop-information  End >>>
            2163     3  pp   2v                   zintemp(1:nlon,:)=MERGE(zintemp(1:nlon,:),xmissing,zintemp(1:nlon,:).NE.missing_value)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            2164     4  pp                        Do j=1,nlat
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            2165     4   p   2v                     zin(:,j)=zintemp(:,nlat-j+1)
            2166     4   p                        ENDDO
            2167     3                            flag=.true.
            2168     3                          ENDIF   !end if (myrank .eq. 0)
            2169     2                          call mpe_bcast(zin(:,:),nx*my,0,mpe_double)
            2170     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, os12
                                   <<< Loop-information  End >>>
            2171     3                          DO jj = 1, jlistnum
            2172     3                            j=jlist1(jj)
            2173     3                            nxj=nxdef_2d(j)
            2174     3                            if( lreduce.eq.1 ) call reducepickr(zin(1,j),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, ot12, mixedlayer12, ov12, ou12
                                   <<<      os12
                                   <<< Loop-information  End >>>
            2175     4  pp   2v                   DO ii=1,nxj
            2176     4   p   2v                     i=nxjstart(j)+ii-1
            2177     5   p   2v                     if(irec .eq. 1) then
            2178     5   p   2v                       ot12(ii,jk,jj,dayID) = zin(i,j)
            2179     5       2v                     else if(irec .eq. 2) then
            2180     5   p   2v                       os12(ii,jk,jj,dayID) = zin(i,j)
            2181     5   p   2v                     else if(irec .eq. 3) then
            2182     5   p   2v                       ou12(ii,jk,jj,dayID) = zin(i,j)
            2183     5   p   2v                     else if(irec .eq. 4) then
            2184     5   p   2v                       ov12(ii,jk,jj,dayID) = zin(i,j)
            2185     5   p   2v                     else if(irec .eq. 5) then
            2186     5   p   2v                       mixedlayer12(ii,jj,dayID) = zin(i,j)
            2187     5   p   2v                     endif
            2188     4   p   2v                   ENDDO
            2189     3                          ENDDO  !!end jj
            2190     2                        ENDDO  !!end jk
            2191     1                      ENDDO   !!end irec
            2192                     
            2193     1                      IF(myrank .eq. 0) THEN
            2194     1                        CALL IO_close(gpnc2)
            2195     1                        DEALLOCATE (zintemp)
            2196     1                      ENDIF
            2197                     
            2198                            DEALLOCATE (zin)
            2199                     
            2200                            END SUBROUTINE read_godas_dayp1
            2201                     
            2202                           END SUBROUTINE read_dailygodas
            2203                     ! ----------------------------------------------------------------------
            2204                     
            2205                     !------------------------------------------------------------------------------
            2206                           SUBROUTINE fill_missing2(finout,io_nlon,io_ngl,ndepth,ldeep)
            2207                     !
            2208                     !   fill missing value using nearest data points
            2209                     !   Method: Inverse Distance Weighting Interpolation
            2210                     !   finout: input/output field
            2211                     !
            2212                           IMPLICIT NONE
            2213                           INTEGER, PARAMETER :: nerr = 6     ! error output stream
            2214                           INTEGER,INTENT(in):: io_nlon  ! number of longitudes in NetCDF file
            2215                           INTEGER,INTENT(in):: io_ngl   ! number of latitudes in NetCDF file
            2216                           INTEGER,INTENT(in):: ndepth   ! number of depths in NetCDF file
            2217                           LOGICAL,INTENT(in):: ldeep    ! fill missig for deeper levels
            2218                           REAL,INTENT(in out)::finout(io_nlon,ndepth,io_ngl)
            2219                           INTEGER::i,j,k,irad(io_nlon,io_ngl),jrad,nmissing,nfilled,nmax_lon_radius,nmax_lat_radius
            2220                           REAL::sumw,aspect,dlon,dlat
            2221                           REAL, DIMENSION(-io_nlon/2:(3*io_nlon)/2+1,-io_ngl/2:(3*io_ngl)/2+1):: finm
            2222                           INTEGER,  DIMENSION(-io_nlon/2:(3*io_nlon)/2+1,-io_ngl/2:(3*io_ngl)/2+1):: inm
            2223                           REAL, PARAMETER:: MAX_LAT_RADIUS=2.   !! maximum radius in lat dir. 2 deg
            2224                           REAL, PARAMETER:: MAX_LON_RADIUS=10.  !! maximum radius in lon dir. 10 deg
            2225                     !
            2226                           !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 0.0'
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finm
                                   <<< Loop-information  End >>>
            2227        pp   4v            finm=xmissing
            2228                           dlon=360./DBLE(io_nlon)
            2229                           dlat=180./DBLE(io_ngl)
            2230                           nmax_lon_radius=MAX_LON_RADIUS/dlon
            2231                           nmax_lat_radius=MAX_LAT_RADIUS/dlat
            2232                           aspect=(MAX_LAT_RADIUS/dlat)/(MAX_LON_RADIUS/dlon)
            2233                          !!! WRITE(nerr,'(/,A,I7,A,I7,A,F9.2)') ' fill_missing 1.0: nmax_lon_radius=',nmax_lon_radius, &
            2234                          !!!  ' nmax_lat_radius=',nmax_lat_radius,' aspect=',aspect
            2235                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      irad
                                   <<< Loop-information  End >>>
            2236        pp   4v            irad=0
            2237     1                     DO k = 1,ndepth
            2238     1                     nmissing=0
            2239     1                     nfilled=0
            2240     1                     !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 1.1: k=', k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finout, finm
                                   <<< Loop-information  End >>>
            2241     1  pp   2v            finm(1:io_nlon,1:io_ngl)=finout(:,k,:)
            2242     1                     !!! cylinic for longitude (-180 - 0)
            2243     1                     !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 1.2: k=', k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finout, finm
                                   <<< Loop-information  End >>>
            2244     1  pp   2v            finm(-io_nlon/2:0,1:io_ngl)=finout(io_nlon/2:io_nlon,k,:)
            2245     1                     !!! cylinic for longitude (360 - 720)
            2246     1                     !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 1.3: k=', k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finout, finm
                                   <<< Loop-information  End >>>
            2247     1  pp   2v            finm(io_nlon+1:(3*io_nlon)/2+1,1:io_ngl)=finout(1:io_nlon/2+1,k,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.70, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finm, inm
                                   <<< Loop-information  End >>>
            2248     1  pp   2v            inm=MERGE(1,0,finm.NE.xmissing) ! unit mask
            2249     2                     DO j = 1,io_ngl
            2250     3                       DO i = 1,io_nlon
            2251     4                         IF (finout(i,k,j).EQ.xmissing) THEN
            2252     4                           nmissing=nmissing+1
            2253     5                           IF (k.EQ.1) THEN
            2254     5                           ! Determine Radius
            2255     5                             sumw=0.
            2256     5               !!!              WRITE(nerr,'(/,A,6I7)') ' fill_missing 5.1:',i,j,k
            2257     5               !!!              DO WHILE ( (sumw.LE.0._dp).AND.(irad(i,j).LT.io_nlon/2-1) )
            2258     6                             DO WHILE ( (sumw.LE.0.).AND.(irad(i,j).LT.nmax_lon_radius) )
            2259     6                               irad(i,j)=irad(i,j)+1
            2260     6                               jrad=irad(i,j)*aspect
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      inm
                                   <<< Loop-information  End >>>
            2261     6  pp   8                       sumw=DBLE(SUM(inm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad)))
            2262     6                             ENDDO
            2263     5                           ELSE
            2264     5                             ! Using the same radius as surface grid, it assumes the depth of the missing value grid is the same as the maximun depth within the radius
            2265     5                             jrad=irad(i,j)*aspect
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      inm
                                   <<< Loop-information  End >>>
            2266     5  pp   8                     sumw=DBLE(SUM(inm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad)))
            2267     6                             IF (ldeep) THEN
            2268     7                               DO WHILE ( (sumw.LE.0.).AND.(irad(i,j).LT.nmax_lon_radius) )
            2269     7                                 irad(i,j)=irad(i,j)+1
            2270     7                                 jrad=irad(i,j)*aspect
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      inm
                                   <<< Loop-information  End >>>
            2271     7  pp   8                         sumw=DBLE(SUM(inm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad)))
            2272     7                               ENDDO
            2273     6                             ENDIF
            2274     5                           ENDIF
            2275     5                           IF (sumw.GT.0.) THEN
            2276     5                             nfilled=nfilled+1
            2277     5               !!!              WRITE(nerr,'(/,A,6I7)') ' fill_missing 5.2:',i,j,k,irad(i,j),jrad,INT(sumw)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finm
                                   <<< Loop-information  End >>>
            2278     5  pp   4                     finout(i,k,j)=SUM(finm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad),mask=finm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad).NE.xmissing)/sumw
            2279     5                           ELSE
            2280     5                             ! value of deeper layers are missing (not fill) as well.
            2281     5                             ! EXIT
            2282     5                           ENDIF
            2283     4               !!!            WRITE(nerr,'(/,A,6I7)') ' fill_missing 5.3:',i,j,k,irad(i,j),jrad,INT(sumw)
            2284     4                         ENDIF
            2285     3                       ENDDO
            2286     2                     ENDDO
            2287     1               !      IF ( lwarning_msg.GE.2 ) then
            2288     1               !        WRITE(nerr,'(/,A,I5,A,I9,A,I9,A)') ' fill_missing: k=',k,&
            2289     1               !             ',   ',nmissing,' missing value grids, where ',nfilled,&
            2290     1               !             ' grids filled.'
            2291     1               !      ENDIF
            2292     1                   ENDDO
            2293                       END SUBROUTINE fill_missing2

            1138     2                             ihy2=ihy1+1
            1139     2                             call chlen (ifilin_nc,80,lnc)
            1140     2                             WRITE (fn0, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy0
            1141     2                             WRITE (fn1, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy1
            1142     2                             WRITE (fn2, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy2
            1143     2               !ps              WRITE (fn0, '("godas",i4)') ihy0
            1144     2               !ps              WRITE (fn1, '("godas",i4)') ihy1
            1145     2               !ps              WRITE (fn2, '("godas",i4)') ihy2
            1146     2               

            1420     6   p   2v                          ENDIF
            1421     5   p   2v                        ENDDO
            1422     4                               ENDDO
            1423     3               
            1424     3               
            1425     3                               flag=.false.
            1426     4                               IF (myrank .eq.0 ) THEN
            1427     5                                 IF (lex2) THEN
            1428     5                                   status = NF_INQ_VARID (woanc2%file_id, cname, io_var_id)
            1429     6                                   IF (status /= NF_NOERR) THEN

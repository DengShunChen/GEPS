            1493                     !------------------------------------------------------------------------------
            1494                     !  woa0
            1495                     ! ----------------------------------------------------------------------
            1496                     !
            1497                     ! Ben-Jei Tsuang, NCHU, AUG 2008, Read WORLD OCEAN ATLAS 2005 data
            1498                     ! (woa05)
            1499                     ! (http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)
            1500                     ! Change woa ocean temperature variable from "t0112an1" to "ot".
            1501                     ! Change woa ocean salinity variable from "s0112an1" to "os"
            1502                     ! Change the unit of ocean temperature of woa05 from degree C to
            1503                     ! Kelvin
            1504                     ! ######### script >>
            1505                     ! cdo -f nc chname,t0112an1,ot t0112an1.nc xx
            1506                     ! cdo -f nc addc,273.15 xx ot.nc
            1507                     ! cdo -f nc chname,s0112an1,os s0112an1.nc os.nc
            1508                     ! cdo -f nc merge ot.nc os.nc woa05_clim.nc
            1509                     ! cdo -f nc interpolate,t21grid woa05_clim.nc T21_woa05_clim.nc
            1510                     ! cdo -f nc interpolate,t31grid woa05_clim.nc T31_woa05_clim.nc
            1511                     ! cdo -f nc interpolate,t42grid woa05_clim.nc T42_woa05_clim.nc
            1512                     ! cdo -f nc interpolate,t63grid woa05_clim.nc T63_woa05_clim.nc
            1513                     ! cdo -f nc interpolate,t85grid woa05_clim.nc T85_woa05_clim.nc
            1514                     ! cdo -f nc interpolate,t106grid woa05_clim.nc T106_woa05_clim.nc
            1515                     !
            1516                     ! cp -pr T21_woa05_clim.nc /u1/u40bjt00/MPI/T21/amip2/
            1517                     ! cp -pr T31_woa05_clim.nc /u1/u40bjt00/MPI/T31/amip2/
            1518                     ! cp -pr T42_woa05_clim.nc /u1/u40bjt00/MPI/T42/amip2/
            1519                     ! cp -pr T63_woa05_clim.nc /u1/u40bjt00/MPI/T63/amip2/
            1520                     ! cp -pr T85_woa05_clim.nc /u1/u40bjt00/MPI/T85/amip2/
            1521                     ! cp -pr T106_woa05_clim.nc /u1/u40bjt00/MPI/T106/amip2/
            1522                     ! ######### << script
            1523                     !
            1524                           SUBROUTINE read_woa0
            1525                     ! ----------------------------------------------------------------------
            1526                     ! Ben-Jei Tsuang, NCHU, June 2009, Read background initial WORLD OCEAN
            1527                     ! ATLAS 2005 data (woa05)
            1528                     ! (http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)
            1529                     ! An initial ocean dataset is generated by combining
            1530                     !   ishii (from surface to 700 m depth), woa monthy data (form > 700
            1531                     !   to
            1532                     !   1500 m depth), and woa annual data (form > 1500 to 5500 m depth).
            1533                     ! Ishii data: http://dss.ucar.edu/datasets/ds285.3/docs/
            1534                     ! script:  irish3::/tcrg/u40bjt00/data/woa05/interp_echam.sh
            1535                     !
            1536                     ! history:
            1537                     !   2009/6/10: modified the code from read_woa0
            1538                     !
            1539                     ! ----------------------------------------------------------------------
            1540                     !    USE mo_control,       ONLY: ngl, nlon, nwoa0, lamip, lmlo
            1541                     !    USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe,p_parallel,p_all_comm,p_barrier
            1542                     !    USE mo_exception,     ONLY: finish, message, message_text
            1543                     
            1544                     !    USE mo_io,            ONLY: io_open_unit, io_close, io_read, &
            1545                     !                                io_var_id, io_file_id, io_open, &
            1546                     !                                woa0nc1
            1547                          USE mo_netCDF,        ONLY: io_inq_dimid, io_inq_dimlen,     &
            1548                                                     io_inq_varid, io_get_var_double, &
            1549                                                     io_get_vara_double, io_get_att_double
            1550                     !    USE mo_decomposition, ONLY: lc => local_decomposition, &
            1551                     !                                gl_dc => global_decomposition
            1552                     !    USE mo_transpose,     ONLY: scatter_gp
            1553                     !    USE mo_filename,      ONLY: NETCDF
            1554                     
            1555                     
            1556                     !  Local scalars:
            1557                     
            1558                     ! number of codes read from WOA file
            1559                           INTEGER, PARAMETER :: nrec = 5
            1560                           CHARACTER (12) :: cname, cwoa0(nrec)
            1561                     
            1562                           REAL, ALLOCATABLE, TARGET :: zin(:,:)
            1563                           REAL, ALLOCATABLE, TARGET :: zintemp(:,:)
            1564                           REAL      :: missing_value
            1565                     
            1566                           INTEGER               :: io_nlon  ! number of longitudes in NetCDF file
            1567                           INTEGER               :: io_ngl   ! number of latitudes in NetCDF file
            1568                           INTEGER               :: io_ndepth  ! number of odepth0 in NetCDF file
            1569                           INTEGER, DIMENSION(4) :: io_start ! start index for NetCDF-read
            1570                           INTEGER, DIMENSION(4) :: io_count ! number of iterations for NetCDF-read
            1571                     
            1572                           INTEGER               :: jk ,i     ! loop index
            1573                           INTEGER               :: irec      ! variable index
            1574                          ! Read world ocean atlas data file
            1575                          ! ===============
            1576                           INTEGER :: IO_file_id0, IO_file_id1, IO_file_id2
            1577                     !      CHARACTER (12) :: fn0, fn1, fn2
            1578                           CHARACTER (80) :: fn0, fn1, fn2
            1579                           LOGICAL       :: lex1
            1580                           INTEGER       :: status, ncid, ndims, nvars, ngatts, unlimdimid
            1581                     
            1582                     !ps
            1583                           INTEGER, PARAMETER :: nerr = 6     ! error output stream
            1584                           TYPE (FILE_INFO), save :: woa0nc1
            1585                           INTEGER, PARAMETER:: IO_READ=1
            1586                           INTEGER :: io_var_id         !,IO_file_id,  IO_dim_id
            1587                           LOGICAL flag
            1588                           INTEGER :: j,jj,nxj,im,ii
            1589                           INTEGER :: lnc,istat
            1590                           INTEGER :: zindepth
            1591                     !ps
            1592                          ! Read world ocean atlas data file
            1593                          ! ===============
            1594                           flag=.false.
            1595     1                     IF (myrank .eq. 0) THEN
            1596     1                       WRITE(nerr,'(/,A,I2)') ' Read WOA0 from unit ', nwoa0
            1597     1                       WRITE(nerr,'(A,I2)') ' Read initial ocean temp. and sal. profiles from'
            1598     1                       WRITE(nerr,'(A,I2)') ' WORLD OCEAN ATLAS 2005 data (http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)'
            1599     1               
            1600     1                       INQUIRE (nwoa0, exist=lex1)
            1601     1                       ! unit nwoa0=97
            1602     2                       IF (lex1) THEN
            1603     2                         woa0nc1%format = NETCDF
            1604     2                         CALL IO_open_unit (nwoa0, woa0nc1, IO_READ)
            1605     2                       ! has to be fixed...
            1606     2                       !          CALL IO_read_header(sstnc1)
            1607     2                       !          CALL IO_info_print(sstnc1)
            1608     2                         WRITE(nerr,'(/,A,I2)') ' Read WOA0 2.0: open successfully!',woa0nc1%file_id
            1609     2                       ELSE
            1610     2                         WRITE (message_text,*) 'Could not open unit<',nwoa0,'>'
            1611     2                         WRITE(nerr,*) '',message_text
            1612     2                         WRITE(nerr,*) 'read_woa0', 'Could not open woa0 file'
            1613     2                         call dmsexit(-1)
            1614     2                         stop
            1615     2                       ENDIF
            1616     1                       WRITE(nerr,'(/,A,I2)') ' Read WOA0 3.0 '
            1617     1               
            1618     1                     ! Check resolution
            1619     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'lat', io_var_id)
            1620     1                       CALL io_inq_dimlen (woa0nc1%file_id, io_var_id, io_ngl)
            1621     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'lon', io_var_id)
            1622     1                       CALL io_inq_dimlen (woa0nc1%file_id, io_var_id, io_nlon)
            1623     1               !        print *,"read W0A0 4.0"
            1624     2                       IF (io_ngl/=ngl) THEN
            1625     2                         WRITE(nerr,*) 'read_WOA0: unexpected resolution',io_nlon,io_ngl
            1626     2                         WRITE(nerr,*) 'expected number of latitudes = ',ngl
            1627     2                        WRITE(nerr,*) 'number of latitudes of world ocean atlas data =',io_ngl
            1628     2                         WRITE(nerr,*) 'read_WOA0','unexpected resolution'
            1629     2                         call dmsexit(-1)
            1630     2                         stop
            1631     2                       END IF
            1632     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'depth', io_var_id)
            1633     1                       CALL io_inq_dimlen (woa0nc1%file_id, io_var_id, nodepth0)
            1634     1               
            1635     1                       print *,"read W0A0 4.0"
            1636     2                       IF ( lwarning_msg.GE.3 ) THEN
            1637     2                         WRITE (nerr,*) 'read_WOA0:: pe=',p_pe,',odepth0=',odepth0(1:nodepth0)
            1638     2                       ENDIF
            1639     1                       flag=.true.
            1640     1                     END IF  !end if(myrank .eq. 0)
            1641                          ! RETURN
            1642                           CALL mpe_bcast(nodepth0,1,0,mpe_integer)
            1643                          ! Allocate memory for ot0, os0, ou0, ov0 per PE
            1644                           IF (.NOT. ALLOCATED(odepth0)) ALLOCATE (odepth0(nodepth0))
            1645                           IF (.NOT. ALLOCATED(ot0)) ALLOCATE (ot0(nxp, nodepth0, my_max))
            1646                           IF (.NOT. ALLOCATED(os0)) ALLOCATE (os0(nxp, nodepth0, my_max))
            1647                           IF (.NOT. ALLOCATED(ou0)) ALLOCATE (ou0(nxp, nodepth0, my_max))
            1648                           IF (.NOT. ALLOCATED(ov0)) ALLOCATE (ov0(nxp, nodepth0, my_max))
            1649                           IF (.NOT. ALLOCATED(mixedlayer0)) ALLOCATE (mixedlayer0(nxp, my_max))
            1650                           if(myrank.eq.0) print *,"W0A0, end allocate"
            1651                     
            1652                           flag=.false.
            1653     1                     IF (myrank .eq. 0) THEN
            1654     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'depth', io_var_id)
            1655     1                       CALL io_get_var_double (woa0nc1%file_id, io_var_id, odepth0)
            1656     1               !!      WRITE(nerr,'(/,A,I2)') ' Read WOA0 6.0 '
            1657     1                       flag=.true.
            1658     1                     ENDIF
            1659                           CALL mpe_bcast(odepth0,nodepth0,0,mpe_double)
            1660                     
            1661                     
            1662                          ! Codes read from WORLD OCEAN ATLAS 2005
            1663                           cwoa0( 1) = 'ot'    ! ocean temperature profile (K)
            1664                           cwoa0( 2) = 'os'    ! ocean salinity profile (0/00)
            1665                           cwoa0( 3) = 'ou'    ! ocean u-component current (m/s)
            1666                           cwoa0( 4) = 'ov'    ! ocean v-component current (m/s)
            1667                           cwoa0( 5) = 'mixedlayer'    ! ocean mixed layer (m)
            1668                           IF (.NOT. ALLOCATED(zin)) ALLOCATE (zin(nlon,ngl))
            1669                     
            1670     1                     DO irec = 1, nrec
            1671     1                       cname = cwoa0(irec)
            1672     1                       zindepth=nodepth0
            1673     1                       if(irec .eq. 5) zindepth=1
            1674     2                       DO jk = 1, zindepth
            1675     2                         flag=.false.
            1676     3                         IF (myrank .eq. 0) THEN
            1677     3                           IF (.NOT. ALLOCATED(zintemp)) ALLOCATE (zintemp(nlon,ngl))
            1678     3                           ! read world ocean atlas data
            1679     3                           status = NF_INQ_VARID (woa0nc1%file_id, cname, io_var_id)
            1680     4                           IF (status /= NF_NOERR) THEN
            1681     4                             WRITE(nerr,*) 'IO_INQ_VARID :', woa0nc1%file_id, cname
            1682     4                             WRITE(nerr,*) 'IO_INQ_VARID', NF_STRERROR(status)
            1683     4                           ELSE
            1684     4                             CALL io_get_att_double (woa0nc1%file_id, io_var_id, &
            1685     4                                                 '_FillValue', missing_value)
            1686     4               
            1687     4                             io_start(:) = (/       1,  1, jk, 1 /)
            1688     4                             io_count(:) = (/ io_nlon, io_ngl ,  1, 1 /)
            1689     4                             ! for depth jk: read io_nlon longitudes, ngl latitudes and
            1690     4                             ! 12 months
            1691     4                             CALL io_get_vara_double(woa0nc1%file_id,io_var_id,io_start,io_count,&
            1692     4                                                     zintemp(1:io_nlon,1:io_ngl))
            1693     4                             print *,"woa0: irec=",irec,",jk=",jk,"zintemp:(768,277)=",zintemp(768,ngl+1-277)
            1694     4                           ENDIF
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp
                                   <<< Loop-information  End >>>
            1695     3  pp   2v                  zintemp(1:io_nlon,:)=MERGE(zintemp(1:io_nlon,:),xmissing,zintemp(1:io_nlon,:).NE.missing_value)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            1696     4  pp                       Do j=1,ngl
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            1697     4   p   2v                    zin(:,j)=zintemp(:,ngl-j+1)
            1698     4   p                       ENDDO
            1699     3                           flag=.true.
            1700     3                         ENDIF
            1701     2               
            1702     2                         call mpe_bcast(zin(:,:),nx*my,0,mpe_double)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, os0
                                   <<< Loop-information  End >>>
            1703     3                         DO jj = 1, jlistnum
            1704     3                           j=jlist1(jj)
            1705     3                           nxj=nxdef_2d(j)
            1706     3                           if( lreduce.eq.1 )call reducepickr (zin(1,j),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, ot0, mixedlayer0, ov0, ou0, os0
                                   <<< Loop-information  End >>>
            1707     4  pp   2v                  DO ii=1,nxj
            1708     4   p   2v                    i=nxjstart(j)+ii-1
            1709     5   p   2v                    IF (irec .eq. 1) THEN
            1710     5   p   2v                      ot0(ii,jk,jj)=zin(i,j)
            1711     5       2v                    ELSE IF(irec .eq. 2) THEN
            1712     5   p   2v                      os0(ii,jk,jj)=zin(i,j)
            1713     5   p   2v                    ELSE IF(irec .eq. 3) THEN
            1714     5   p   2v                      ou0(ii,jk,jj)=zin(i,j)
            1715     5   p   2v                    ELSE IF(irec .eq. 4) THEN
            1716     5   p   2v                      ov0(ii,jk,jj)=zin(i,j)
            1717     5   p   2v                    ELSE IF(irec .eq. 5) THEN
            1718     5   p   2v                      mixedlayer0(ii,jj)=zin(i,j)
            1719     5   p   2v                    ENDIF
            1720     4   p   2v                  ENDDO
            1721     3                         ENDDO
            1722     2               
            1723     2                       ENDDO  !end do jk
            1724     1                     END DO  !end do irec=1, nrec
            1725                     
            1726     1                     IF (myrank .eq. 0) THEN
            1727     1                       CALL io_close (woa0nc1)
            1728     1                       WRITE(nerr,*) 'end read WOA0'
            1729     1                       DEALLOCATE (zintemp)
            1730     1                     END IF
            1731                           DEALLOCATE (zin)
            1732                     
            1733                           END SUBROUTINE read_woa0
            1734                     
            1735                     

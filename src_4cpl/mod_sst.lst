            2507                             CONTAINS
            2508                     
            2509                               SUBROUTINE date2JulianDay(zdate,jd)
            2510                                 real, INTENT(IN):: zdate
            2511                                 real, INTENT(OUT):: jd
            2512                                 integer:: yr,mo,dy
            2513                                 real:: zsec
            2514                     
            2515          i                      call get_date_component(zdate, yr, mo, dy, zsec)
            2516                                 jd=Set_JulianDay(yr, mo, dy, zsec)
            2517                     
            2518                               END SUBROUTINE date2JulianDay
            2519                     
            2520                               SUBROUTINE get_date_component(zdate, kyr, kmo, kdy, zsec)
            2521                     
            2522                               real, INTENT(IN):: zdate
            2523                               integer:: kyr,kmo,kdy
            2524                               integer:: tmp,yyyy,mm,dd
            2525                               character*8 :: cdtg
            2526                               real:: zsec        !second [real] input (seconds of the day)
            2527                     
            2528                     
            2529                               tmp=int(zdate)
            2530                               write(cdtg,'(i8)')tmp
            2531                               read(cdtg,'(i4,i2,i2)')yyyy,mm,dd
            2532                               kyr=int(yyyy)
            2533                               kmo=int(mm)
            2534                               kdy=int(dd)
            2535                               zsec=zdate-real(tmp)
            2536                     
            2537                               END SUBROUTINE get_date_component
            2538                     
            2539                     

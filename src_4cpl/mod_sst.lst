            1323     6                                     io_start(:) = (/       1,   1, jk, im /)
            1324     6                                     io_count(:) = (/ io_nlon, ngl,  1,  1 /)
            1325     6                                   ! for depth jk: read io_nlon longitudes, ngl latitudes and 12 months
            1326     6                                     CALL io_get_vara_double(woanc1%file_id,io_var_id,io_start,io_count, &
            1327     6                                                       zintemp(1:io_nlon,1:ngl))
                                   <<< Loop-information Start >>>

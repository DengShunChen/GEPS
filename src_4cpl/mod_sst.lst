              61                             !! memory pointer for GODAS+Ishii WORLD OCEAN data (lgodas) (GODAS+Ishii)
              62                             INTEGER               :: nodepth        ! number of depths of the godas data (=24)
              63                             REAL, ALLOCATABLE :: odepths(:)     ! depths of the godas data (m)
              64                     !!!  INTEGER               :: gpdepth        ! number of depths of daily fodas pentad data (=40)
              65                     !!!  REAL(dp), ALLOCATABLE :: odepths(:)    ! depths of the godas pentad data (m)
              66                             REAL, ALLOCATABLE :: ot12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              67                                                                ! observed water tempeature profile (K): "ot"
              68                             REAL, ALLOCATABLE :: os12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              69                                                                ! observed salinity (0/00): "os"
              70                             REAL, ALLOCATABLE :: ou12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              71                                                                ! observed u current (m/s): "ou"
              72                             REAL, ALLOCATABLE :: ov12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              73                                                                ! observed v current (m/s): "ou"
              74                             REAL, ALLOCATABLE :: mixedlayer12(:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              75                                                                ! observed v current (m/s): "ou"
              76                     
              77                             !! memory pointer for Initial WORLD OCEAN ATLAS 2005 data (lwoa0)(http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)
              78                             INTEGER               :: nodepth0         ! number of depths of the woa data (=24)
              79                             REAL, ALLOCATABLE :: odepth0(:)       ! depths of the woa data (m)
              80                             REAL, ALLOCATABLE :: ot0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              81                                                                ! observed water tempeature profile (K): "ot"
              82                             REAL, ALLOCATABLE :: os0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              83                                                                ! observed salinity (0/00): "os"
              84                             REAL, ALLOCATABLE :: ou0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              85                                                                ! observed u-componet current (m/s): "ou"
              86                             REAL, ALLOCATABLE :: ov0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              87                                                                ! observed v-componet current (m/s): "ov"
              88                             REAL, ALLOCATABLE :: mixedlayer0(:,:) ! (nlon,ngl) in global coordinates,
              89                                                                ! observed mixedlayer (m): "ou"
              90                     
              91                             LOGICAL :: lou=.FALSE.                    ! u- current available ?
              92                             LOGICAL :: lov=.FALSE.                    ! v- current available ?
              93                     
              94                       !! memory pointer for sit flux correction term
              95                             INTEGER           :: nwdepth         ! number of depths of the woa data
              96                             REAL, ALLOCATABLE :: wdepths(:)      ! depths of the woa data (m)
              97                             REAL, ALLOCATABLE :: wtfn12(:,:,:,:) ! (nlon,nwdepth,ngl,0:13) in global coordinates,
              98                                                                  ! observed water tempeature profile (K): "ot"
              99                             REAL, ALLOCATABLE :: wsfn12(:,:,:,:) ! (nlon,nwdepth,ngl,0:13) in global coordinates,
             100                             REAL, ALLOCATABLE :: wtfn1st(:,:,:) ! (nlon,nwdepth,ngl) in global coordinates,
             101                                                                  ! observed water tempeature profile (K): "ot"
             102                             REAL, ALLOCATABLE :: mask1st(:,:) ! (nlon,nwdepth,ngl) in global coordinates,
             103                     
             104                       !! memory pointer for pentad GODAS OCEAN data (lgodas & ldailysst)
             105                             REAL      :: timevals_godas(3) = 0.  ! absoulte time (e.g., 19971003.25) GODAS PENTAD Data
             106                             INTEGER   :: files_godas(3)          ! fileid for pentad data at day-1, day+0 and day+1, respectively
             107                             INTEGER   :: tsID_godas(3)           ! record id for pentad data at day-1, day+0 and day+1, in its repective file, respectively
             108                             INTEGER   :: nts_godas(3)            ! # of timestamps for pentad data at day-1, day+0 and day+1, in its repective file, respectively
             109                     
             110                       !! memory pointer for daily FCTsst data (ldailyFCTsst)
             111                             REAL      :: timevals_dailyFCT(2)= 0.       ! absoulte time (e.g.,19971003.25) daily forecast sst Data
             112                             REAL, ALLOCATABLE :: dailyFCTsst(:,:,:)     ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             113                                                                         ! forecast daily water tempeature (K)
             114                             REAL, ALLOCATABLE :: dailyFCTcice(:,:,:)    ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             115                                                                         ! forecast sea ice fration
             116                             REAL, ALLOCATABLE :: dailyFCTsndepth(:,:,:) ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             117                                                                         ! forecast daily snow depth (mm)
             118                             REAL, ALLOCATABLE :: ANAsstT0(:,:)          ! (nlon,ngl), analysis SST at tau=0
             119                             REAL, ALLOCATABLE :: dailyClmANAsst(:,:,:)  ! (nlon,ngl,2) at tau=0, ydate, ydate+1 day in global coordinates,
             120                             REAL, ALLOCATABLE :: dailyClmFCTsst(:,:,:)  ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             121                                                                         ! forecast climatology daily water tempeature (K)
             122                             REAL, ALLOCATABLE :: dFCTsstdt(:,:)         ! d(dailyFCTsst)/dt (K/s)
             123                             REAL, ALLOCATABLE :: dFCTcicedt(:,:)        ! d(dailyFCTcice)/dt (K/s)
             124                             REAL, ALLOCATABLE :: dFCTsndepthdt(:,:)     ! d(dailyFCTsndepth)/dt (K/s)
             125                             REAL, ALLOCATABLE :: obswtbold(:,:)           ! calculated obs. sst per (n-1) timestep
             126                             REAL, ALLOCATABLE :: obswtbnow(:,:)           ! calculated obs. sst now (n) timestep
             127                             REAL, ALLOCATABLE :: obswtbnew(:,:)           ! calculated obs. sst next (n+1) timestep
             128                             REAL, ALLOCATABLE :: tseadiffFCT(:,:)       ! the change of tg from dta*dFCTsstdt
             129                             REAL, ALLOCATABLE :: tseadiffFCT24(:,:)     ! the average change of tg from dta*dFCTsstdt
             130                             REAL, ALLOCATABLE :: dtseadt(:,:)           ! the change rate of tg from FCTsst and SIT
             131                             REAL, ALLOCATABLE :: tseaold(:,:)             ! sst at pre. timestep (n-1)
             132                             REAL, ALLOCATABLE :: tseanow(:,:)             ! sst at now timestep (n)
             133                             REAL, ALLOCATABLE :: tseanew(:,:)             ! sst at next timestep (n+1)
             134                     
             135                     
             136                     !for opgsst
             137                           REAL, dimension(:,:,:),allocatable,save :: opgsst
             138                     !for time_interpolation
             139                           REAL wgt1,wgt2,obswtbwgt1,obswtbwgt2,wgto1,wgto2
             140                           INTEGER nmw1,nmw2,obswtbnmw1,obswtbnmw2,now1,now2
             141                     
             142                     
             143                       !*    1.0 COEFFICIENTS IN sit_ocean MODEL
             144                     
             145                             REAL :: albice = 0.2,             & ! albedo of glacier ice (0.2 - 0.4) (Pielke, 1984). Lake ice is the smallest.
             146                                     albsn  = 0.7,             & ! albedo of snow decreases with age (0.4 - 0.95) (Pielke, 1984)
             147                                     albw   = 0.06,            & !	  (Brutsaert, 1982; Tsuang, 1990; Gaspar et al., 1990)
             148                                     csn    = 2116.,           &
             149                                     cice   = 2116.,           & ! Cw = 4217.7-2.55*(Tw-tmelt) (4178.4 is used)
             150                                                           ! csn = cice=104.369+7.369*TSN (Marks, 1988)
             151                                                           ! csn = 2116 j kg k-1 at 0 ! is used for simplicity.
             152                                     rhosn  = 300.,            & !	rhosn = dry snow density. Although snow density changes with age,
             153                                                           !	it is not sensitive to snowmelt runoff. A constant value is assumed.
             154                                     rhoice = 917.,            & !	rhoice = density of ice (917 kg/m3)
             155                                     omegas = 2.*API/IDAYLEN,  & ! ANGULAR VELOCITY OF EARTH in respect to sun
             156                                     xkice = 1.2E-6,           & ! Dickinson et al. (1986)
             157                                     xksn = 2.0E-7,            & !	  Effect heat diffusivity of snow
             158                                                           !       (conduction heat diffusivity + vapor transfer)
             159                                                           ! xksn=kcon+De*Lv/cp*dqsat/dT
             160                                                           !	kcon (conduction) = (3.2238E-8)*rhosn/csn (Yeh, 1965)
             161                                                           ! This value increases with age of snow, and is an
             162                                                           ! important tunning parameter for snow melting rate.
             163                                                           !   =(1E-7 ~ 4E-7) (Dickinson et al., 1986)
             164                                     xkw = 1.50E-4,            & !  (Kondo, 1979, Tsuang, 1990)
             165                                     wcri = 0.1                    !     minimum thickness of a water layer. Thickness less than
             166                                                           !     this thickness is treated as thin layer. That is T,s,U,V,
             167                                                           !     TKE is the same as the layer underneath.
             168                     
             169                           INTEGER, PARAMETER :: nerr = 6     ! error output stream
             170                     
             171                     
             172                     
             173                     
             174                           CONTAINS
             175                     
             176                     
             177                     !---------------------------------------------------------
             178                             subroutine allocate_opgsst_array
             179                     
             180                               integer  ierr
             181                               allocate ( opgsst(nxp,my_max,0:13), stat=ierr)
             182     1                            if (ierr/= 0) then
             183     1                                write(6,*) 'mod_opgsst : allocate fail 1 '
             184     1                                call dmsexit(-1)
             185     1                                stop
             186     1                            end if
             187                     
             188                                  return
             189                     
             190                             end subroutine
             191                     
             192                     
             193                             subroutine deallocate_opgsst_array
             194                     
             195                                deallocate (opgsst)
             196                                return
             197                     
             198                             end subroutine
             199                     
             200                             SUBROUTINE read_opgsst(idtg1,ggdef,ocean,ice)
             201                     
             202                               use index
             203                               use rank
             204                     
             205                               character*4 ggdef
             206                               integer*8 idtg1
             207                               character*12 cdtg
             208                               integer   iyyyy,mm,ddhhmn,iyy,imm,istat
             209                               integer lncrec
             210                               character lrec*26
             211                               integer i,j,ii,jj,nxj,kmm
             212                               real,dimension(:,:), allocatable:: temp1
             213                               logical ocean(nxp,my_max),ice(nxp,my_max)
             214                     
             215                     
             216                               allocate(temp1(nx,my))
             217                     !
             218                       11     format('W00100','0000',a4,i4.4,i2.2,'010000')  ! W10
             219                     
             220                     !           if(myrank.eq.0) call dmsopn(ifilin_sst,"r",istat)
             221                     !           call mpe_broadcast(istat,1,flag,mpe_integer)
             222                     !           if(istat.ne.0)then
             223                     !             if(myrank.eq.0) print *,'dmsopn sst error'
             224                     !               call mpe_finalize
             225                     !               call dmsexit(-1)
             226                     !           endif
             227                     
             228                     
             229                                 write(cdtg,'(i12)') idtg1
             230                                 read(cdtg,'(i4,i2,i8)')iyyyy,mm,ddhhmn
             231                     
             232                     !              iy=idtg_sst/1000000
             233                     
             234                                lncrec=nx*my
             235                     
             236     1                          do kmm=0,13
             237     2                            if( kmm.eq.0 ) then
             238     2                              imm=12
             239     2                              iyy=iyyyy-1
             240     2                            elseif (kmm.gt.12) then
             241     2                              imm=1
             242     2                              iyy=iyyyy+1
             243     2                            else
             244     2                              imm=i
             245     2                              iyy=iyyyy
             246     2                            endif
             247     1               
             248     1                            write(lrec,11) ggdef,iyy,imm
             249     1                            call dmsread(nx,my,lrec,lncrec,'H',ifilin_sst,temp1(:,:),istat)
             250     1               !             if( lreduce.eq.1 ) call reducepickr(temp1(1,imm,1),nxdef,nx,my)
             251     2                            do jj = 1, jlistnum
             252     2                              j=jlist1(jj)
             253     2                              i=nxjstart(j)
             254     2                              nxj=nxdef_2d(j)
             255     2                              if( lreduce.eq.1 )call reducepickr (temp1(1,j),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ocean
                                   <<< Loop-information  End >>>
             256     3  pp   2s                     do ii = 1, nxj
             257     3   p   2v                       i=nxjstart(j)+ii-1
             258     4   p   2m                       if(ocean(ii,jj) .or. ice(ii,jj))then
             259     4   p   2s                        opgsst(ii,jj,kmm)=temp1(i,j)+273.16
             260     4   p   2v                       endif
             261     3   p   2v                     end do
             262     2                            end do
             263     1               
             264     1                          enddo
             265                     
             266                                deallocate(temp1)
             267                     
             268                             END SUBROUTINE read_opgsst
             269                     
             270                     !----------------------------------------------------------
             271                     
             272                             subroutine deallocate_dailyFCT_array
             273                     
             274                                deallocate (obswtbold,obswtbnow,obswtbnew)
             275                                deallocate (tseaold,tseanow,tseanew,dtseadt)
             276                                deallocate (tseadiffFCT,tseadiffFCT24)
             277                                deallocate (dailyFCTsst,dFCTsstdt)
             278     1                          if(ldailyFCTicesndpt) then
             279     1                            deallocate (dailyFCTcice,dailyFCTsndepth)
             280     1                            deallocate (dFCTcicedt,dFCTsndepthdt)
             281     1                          endif
             282     1                          if(dailyClm_option .ge. 1) then
             283     1                            deallocate (ANAsstT0)
             284     1                            deallocate (dailyClmANAsst)
             285     2                            if(dailyClm_option .eq. 2) then
             286     2                              deallocate (dailyClmFCTsst)
             287     2                            endif
             288     1                          endif
             289                                return
             290                     
             291                             end subroutine deallocate_dailyFCT_array
             292                     
             293                     
             294                             SUBROUTINE read_dailyFCT(idtg1,tau,dtx,tg1,cice1,sndepth1  &
             295                                                     ,plon,plat,locean)
             296                     
             297                               USE index
             298                               USE rank
             299                     
             300                               INTEGER*8 :: idtg1,idtg_temp,idtg_FCT
             301                               REAL      :: tau,dtx,tauleft
             302                               REAL      :: tautemp
             303                               INTEGER   :: icurrenttau
             304                               REAL      :: ydate,ydate2
             305                               INTEGER       :: yr, mo, dy, hr, mn
             306                               character*12 cdtg
             307                               real tg1(nxp,my_max),cice1(nxp,my_max),sndepth1(nxp,my_max)
             308                               real plon(nx,my_max),plat(my)
             309                               logical  locean(nxp,my_max)
             310                     
             311                               icurrenttau=int(tau)
             312                               tauleft=float(int((tau-int(tau)+0.001)*3600./dtx))*dtx   !(sec)
             313     1                         if(tauleft .eq. 3600.) then
             314     1                         icurrenttau=icurrenttau+1
             315     1                         tauleft=0.
             316     1                         endif
             317                               call dtgfix12(idtg1,idtg_temp,icurrenttau)
             318                               write(cdtg,'(i12)')idtg_temp
             319                               read(cdtg,'(i4,i2,i2,i2,i2)')yr,mo,dy,hr,mn
             320                               ydate=float(yr*10000+mo*100+dy)+float(hr)/24.+tauleft/3600./24.
             321                               if(myrank .eq. 0) print *,"read_dailyFCT,ydate=",ydate
             322                     
             323                     
             324                               tautemp=tau+24.     !tau +24 hr
             325                               icurrenttau=int(tautemp)
             326                               tauleft=float(int((tautemp-int(tautemp)+0.001)*3600./dtx))*dtx !(sec)
             327     1                         if(tauleft .eq. 3600.) then
             328     1                         icurrenttau=icurrenttau+1
             329     1                         tauleft=0.
             330     1                         endif
             331                               call dtgfix12(idtg1,idtg_FCT,icurrenttau)
             332                               write(cdtg,'(i12)')idtg_FCT
             333                               read(cdtg,'(i4,i2,i2,i2,i2)')yr,mo,dy,hr,mn
             334                     !          ydate2=float(yr*10000+mo*100+dy)+float(hr/24)
             335                               ydate2=float(yr*10000+mo*100+dy)
             336                               write(cdtg,'(i4,i2.2,i2.2,i2.2,i2.2)')yr,mo,dy,00,00
             337                               read(cdtg,'(i12)')idtg_FCT
             338                               if(myrank .eq. 0) print *,"read_dailyFCT,ydate2=",ydate2
             339                     
             340                     
             341                               IF (.NOT. ALLOCATED(dailyFCTsst)) ALLOCATE (dailyFCTsst(nxp,my_max,2))
             342                               IF (.NOT. ALLOCATED(dFCTsstdt)) ALLOCATE (dFCTsstdt(nxp,my_max))
             343                               IF (.NOT. ALLOCATED(obswtbold)) ALLOCATE (obswtbold(nxp,my_max))
             344                               IF (.NOT. ALLOCATED(obswtbnow)) ALLOCATE (obswtbnow(nxp,my_max))
             345                               IF (.NOT. ALLOCATED(obswtbnew)) ALLOCATE (obswtbnew(nxp,my_max))
             346                               IF (.NOT. ALLOCATED(tseaold)) ALLOCATE (tseaold(nxp,my_max))
             347                               IF (.NOT. ALLOCATED(tseanow)) ALLOCATE (tseanow(nxp,my_max))
             348                               IF (.NOT. ALLOCATED(tseanew)) ALLOCATE (tseanew(nxp,my_max))
             349     1                         IF (.NOT. ALLOCATED(dtseadt)) then
             350     1                           ALLOCATE (dtseadt(nxp,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtseadt
                                   <<< Loop-information  End >>>
             351     1  pp   4v                  dtseadt=0.
             352     1                         ENDIF
             353     1                         IF (.NOT. ALLOCATED(tseadiffFCT)) then
             354     1                           ALLOCATE (tseadiffFCT(nxp,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT
                                   <<< Loop-information  End >>>
             355     1  pp   4v                  tseadiffFCT=0.
             356     1                         ENDIF
             357     1                         IF (.NOT. ALLOCATED(tseadiffFCT24)) then
             358     1                           ALLOCATE (tseadiffFCT24(nxp,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24
                                   <<< Loop-information  End >>>
             359     1  pp   4v                  tseadiffFCT24=0.
             360     1                         ENDIF
             361                     
             362     1                         IF(ldailyFCTicesndpt) THEN
             363     1                           IF (.NOT. ALLOCATED(dailyFCTcice)) ALLOCATE (dailyFCTcice(nxp,my_max,2))
             364     1                           IF (.NOT. ALLOCATED(dailyFCTsndepth)) ALLOCATE (dailyFCTsndepth(nxp,my_max,2))
             365     1                           IF (.NOT. ALLOCATED(dFCTcicedt)) ALLOCATE (dFCTcicedt(nxp,my_max))
             366     1                           IF (.NOT. ALLOCATED(dFCTsndepthdt)) ALLOCATE (dFCTsndepthdt(nxp,my_max))
             367     1                         ENDIF
             368     1                         IF(dailyClm_option .ge. 1) THEN
             369     1                           IF (.NOT. ALLOCATED(ANAsstT0)) ALLOCATE (ANAsstT0(nxp,my_max))
             370     1                           IF (.NOT. ALLOCATED(dailyClmANAsst)) ALLOCATE (dailyClmANAsst(nxp,my_max,0:2))
             371     2                           if(dailyClm_option .eq. 2) then
             372     2                             IF (.NOT. ALLOCATED(dailyClmFCTsst)) ALLOCATE (dailyClmFCTsst(nxp,my_max,0:2))
             373     2                           endif
             374     1                         ENDIF
             375                     
             376                     
             377     1                         IF ( (tau .eq. 0.) .OR. lsitstart) THEN
             378     1                    !!! warm/cold start
             379     1                           timevals_dailyFCT(1)=ydate
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, dailyFCTsst
                                   <<< Loop-information  End >>>
             380     1  pp   2v                  dailyFCTsst(:,:,1)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, obswtbold
                                   <<< Loop-information  End >>>
             381     1  pp   2v                  obswtbold(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, obswtbnow
                                   <<< Loop-information  End >>>
             382     1  pp   2v                  obswtbnow(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, tseaold
                                   <<< Loop-information  End >>>
             383     1  pp   2v                  tseaold(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, tseanow
                                   <<< Loop-information  End >>>
             384     1  pp   2v                  tseanow(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, ANAsstT0
                                   <<< Loop-information  End >>>
             385     1  pp   2v                  if(dailyClm_option .ge. 1) ANAsstT0(:,:)=tg1(:,:)
             386     2                           if(ldailyFCTicesndpt) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cice1, dailyFCTcice
                                   <<< Loop-information  End >>>
             387     2  pp   2v                    dailyFCTcice(:,:,1)=cice1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sndepth1, dailyFCTsndepth
                                   <<< Loop-information  End >>>
             388     2  pp   2v                    dailyFCTsndepth(:,:,1)=sndepth1(:,:)
             389     2                           endif
             390     2                           if(ldailyFCTsst .or. ldailyFCTicesndpt)then
             391     2                             CALL read_dailyFCT_dayp1(idtg_FCT,locean)
             392     2                           endif
             393     2                           if(dailyClm_option .ge. 1)then
             394     2                             CALL read_dailyClm_2days(idtg1,idtg_FCT,icurrenttau,plon,plat,locean)
             395     2                           endif
             396     1               
             397     1                           timevals_dailyFCT(2)=ydate2
             398     1                         ELSEIF (ydate.LT.timevals_dailyFCT(2)) THEN
             399     1                    ! data were read. Note that initial value of  timevals_godas=0.
             400     1                           RETURN
             401     1                         ELSE
             402     1                    ! note that initial value of  timevals_godas=0.
             403     1                    ! Shift left
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTsst
                                   <<< Loop-information  End >>>
             404     1  pp   2v                  dailyFCTsst(:,:,1)=dailyFCTsst(:,:,2)
             405     2                           if(ldailyFCTicesndpt) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTcice
                                   <<< Loop-information  End >>>
             406     2  pp   2v                    dailyFCTcice(:,:,1)=dailyFCTcice(:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTsndepth
                                   <<< Loop-information  End >>>
             407     2  pp   2v                    dailyFCTsndepth(:,:,1)=dailyFCTsndepth(:,:,2)
             408     2                           endif
             409     1                           timevals_dailyFCT(1)=timevals_dailyFCT(2)
             410     2                           if(ldailyFCTsst .or. ldailyFCTicesndpt) then
             411     2                             CALL read_dailyFCT_dayp1(idtg_FCT,locean)    ! read next FCST data
             412     2                           endif
             413     2                           if(dailyClm_option .ge. 1)then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyClmANAsst
                                   <<< Loop-information  End >>>
             414     2  pp   2v                    dailyClmANAsst(:,:,1)=dailyClmANAsst(:,:,2)
             415     3                             if(dailyClm_option .eq. 2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyClmFCTsst
                                   <<< Loop-information  End >>>
             416     3  pp   2v                      dailyClmFCTsst(:,:,1)=dailyClmFCTsst(:,:,2)
             417     3                             endif
             418     2                             CALL read_dailyClm_dayp1(idtg1,idtg_FCT,icurrenttau,plon,plat,locean)
             419     2                           endif
             420     1               
             421     1                           timevals_dailyFCT(2)=ydate2
             422     1               
             423     1                         ENDIF
             424                     
             425                     
             426                     
             427                     
             428                           CONTAINS
             429                          !-----------------------------------
             430                             SUBROUTINE read_dailyFCT_dayp1(idtg1,locean)
             431                     
             432                               INTEGER*8 idtg1
             433                               INTEGER iyyyy,imm,idd,ihh,imn
             434                               INTEGER lncrec
             435                               character lrec*26
             436                               REAL ssttemp(nx,my),cicetemp(nx,my),sndpttemp(nx,my)
             437                               INTEGER ii,jj,nxj,i,j,istat,nxjtot
             438                               INTEGER itemp,jtemp
             439                               INTEGER iitemp,jjtemp
             440                               REAL sst_suntemp,sst_counttemp
             441                               REAL cice_suntemp,cice_counttemp,sndpt_suntemp,sndpt_counttemp
             442                               LOGICAL locean(nxp,my_max)
             443                     
             444                               write(cdtg,'(i12)') idtg1
             445                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy,imm,idd,ihh,imn
             446                     
             447                               lncrec=nx*my
             448                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sndpttemp, cicetemp, ssttemp
                                   <<< Loop-information  End >>>
             449        pp   2v                ssttemp=0.
             450         p   2v                cicetemp=0.
             451         p   2v                sndpttemp=0.
             452                     
             453                        11     format('W00100','0000',a4,i4.4,i2.2,i2.2,i2.2,'00')  ! sea surface temperature
             454                               write(lrec,11) ggdef,iyyyy,imm,idd,ihh
             455                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_sst,ssttemp(:,:),istat)
             456     1                         if(ldailyFCTicesndpt)then
             457     1                  12       format('W00091','0000',a4,i4.4,i2.2,i2.2,i2.2,'00')  ! sea ice fration
             458     1                           write(lrec,12) ggdef,iyyyy,imm,idd,ihh
             459     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ncep,cicetemp(:,:),istat)
             460     1                  13       format('B00650','0000',a4,i4.4,i2.2,i2.2,i2.2,'00')  ! water equivlent snow depth
             461     1                           write(lrec,13) ggdef,iyyyy,imm,idd,ihh
             462     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ncep,sndpttemp(:,:),istat)
             463     1                         endif
             464                     
             465                     !          if( lreduce.eq.1 ) then
             466                     !            call reducepick(ssttemp(1,1),nxdef,nx,my)
             467                     !            if(ldailyFCTicesndpt)then
             468                     !              call reducepick(cicetemp(1,1),nxdef,nx,my)
             469                     !              call reducepick(sndpttemp(1,1),nxdef,nx,my)
             470                     !            endif
             471                     !          endif
             472                     
             473     1                         DO jj = 1, jlistnum
             474     1                           j=jlist1(jj)
             475     1                           i=nxjstart(j)
             476     1                           nxj=nxdef_2d(j)
             477     2                           if( lreduce.eq.1 ) then
             478     2                             call reducepickr (ssttemp(1,j),nxdef(j),nx,1)
             479     3                             if(ldailyFCTicesndpt)then
             480     3                               call reducepickr (cicetemp(1,j),nxdef(j),nx,1)
             481     3                               call reducepickr (sndpttemp(1,j),nxdef(j),nx,1)
             482     3                             endif
             483     2                           endif
             484     1               
             485     2                           DO ii=1,nxj
             486     2                             i=nxjstart(j)+ii-1
             487     2                             dailyFCTsst(ii,jj,2)=MERGE(ssttemp(i,j),xmissing,  &
             488     2                                  (ssttemp(i,j).GE.sstmin .AND. ssttemp(i,j) .LE. 400.))
             489     3                             if(ldailyFCTicesndpt)then
             490     3                               dailyFCTcice(ii,jj,2)=MERGE(cicetemp(i,j),xmissing,  &
             491     3                                                        (cicetemp(i,j) .GE. 0))
             492     3                               dailyFCTsndepth(ii,jj,2)=MERGE(sndpttemp(i,j),xmissing, &
             493     3                                                        (sndpttemp(i,j) .GE. 0))
             494     3                             endif
             495     2               
             496     3                             if( (ssttemp(i,j).EQ.xmissing) .OR. (ldailyFCTicesndpt .AND. &
             497     3                               ((cicetemp(i,j).EQ.xmissing).OR.(sndpttemp(i,j).EQ.xmissing))) ) then
             498     3                               sst_suntemp=0.
             499     3                               sst_counttemp=0.
             500     3                               cice_suntemp=0.
             501     3                               cice_counttemp=0.
             502     3                               sndpt_suntemp=0.
             503     3                               sndpt_counttemp=0.
             504     3                               nxjtot=nxdef(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             505     4  pp                           do itemp=i-1, i+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 180
                                   <<< Loop-information  End >>>
             506     5  pp    s                        do jtemp=j-1, j+1
             507     6   p    v                          if (itemp .eq. 0) then
             508     6   p    m                            iitemp=nxjtot
             509     6   p    v                          elseif (itemp .gt. nxjtot) then
             510     6   p    m                            iitemp= 1
             511     6   p                               else
             512     6   p    m                            iitemp=itemp
             513     6   p    v                          endif
             514     6   p    v                          if (jtemp .eq. 0) then
             515     6   p    m                            jjtemp=1
             516     6   p    v                          elseif (jtemp .gt. my) then
             517     6   p    m                            jjtemp=my
             518     6   p                               else
             519     6   p    m                            jjtemp=jtemp
             520     6   p    m                          endif
             521     6   p    m                          if (ssttemp(iitemp,jjtemp).GE.sstmin .AND. ssttemp(iitemp,jjtemp) .LE. 400.)then
             522     6   p    v                            sst_suntemp=sst_suntemp+ssttemp(iitemp,jjtemp)
             523     6   p    v                            sst_counttemp=sst_counttemp+1.
             524     6   p    v                          endif
             525     6   p    v                          if(ldailyFCTicesndpt)then
             526     7   p    v                            if (cicetemp(iitemp,jjtemp).GE.0.)then
             527     7   p    v                              cice_suntemp=cice_suntemp+cicetemp(iitemp,jjtemp)
             528     7   p    v                              cice_counttemp=cice_counttemp+1.
             529     7   p    v                            endif
             530     7   p    v                            if (sndpttemp(iitemp,jjtemp).GE.0.)then
             531     7   p    v                              sndpt_suntemp=sndpt_suntemp+sndpttemp(iitemp,jjtemp)
             532     7   p    v                              sndpt_counttemp=sndpt_counttemp+1.
             533     7   p    v                            endif
             534     6   p    v                          endif
             535     5   p    v                        enddo
             536     4   p                           enddo
             537     4                               if(ssttemp(i,j).LT.sstmin .OR. ssttemp(i,j) .GT. 400.)then
             538     4                                 ssttemp(i,j)=sst_suntemp/sst_counttemp
             539     5                                 if (ssttemp(i,j).GE.sstmin .AND. ssttemp(i,j) .LE. 400.)then
             540     5                                   dailyFCTsst(ii,jj,2)=ssttemp(i,j)
             541     5                                 else
             542     5                                   dailyFCTsst(ii,jj,2)=dailyFCTsst(ii,jj,1)
             543     5                                 endif
             544     4                               endif
             545     4                               if(ldailyFCTicesndpt)then
             546     5                                 if(cicetemp(i,j).LT. 0.)then
             547     5                                   cicetemp(i,j)=cice_suntemp/cice_counttemp
             548     6                                   if(cicetemp(i,j).GE. 0.)then
             549     6                                     dailyFCTcice(ii,jj,2)=cicetemp(i,j)
             550     6                                   endif
             551     5                                 endif
             552     5                                 if(sndpttemp(i,j).LT. 0.)then
             553     5                                   sndpttemp(i,j)=sndpt_suntemp/sndpt_counttemp
             554     6                                   if(sndpttemp(i,j).GE. 0.)then
             555     6                                     dailyFCTsndepth(ii,jj,2)=sndpttemp(i,j)
             556     6                                   endif
             557     5                                 endif
             558     4                               endif
             559     3                             endif
             560     3                             if(locean(ii,jj) .AND. dailyFCTsst(ii,jj,1).ge.sstmin &
             561     3                                .AND. dailyFCTsst(ii,jj,2).ge.sstmin)then
             562     3                               dFCTsstdt(ii,jj)=(dailyFCTsst(ii,jj,2)-dailyFCTsst(ii,jj,1))/(24.*3600.)
             563     3                             else
             564     3                               dFCTsstdt(ii,jj)=0.
             565     3                             endif
             566     3                             if(ldailyFCTicesndpt)then
             567     3                               dFCTcicedt(ii,jj)=(dailyFCTcice(ii,jj,2)-dailyFCTcice(ii,jj,1))/(24.*3600.)
             568     3                               dFCTsndepthdt(ii,jj)=(dailyFCTsndepth(ii,jj,2)-dailyFCTsndepth(ii,jj,1))/(24.*3600.)
             569     3                             endif
             570     2               
             571     2                           ENDDO  !end do ii
             572     1                         ENDDO    !end do jj
             573                     
             574                     
             575                             END SUBROUTINE read_dailyFCT_dayp1
             576                     
             577                     
             578                             SUBROUTINE read_dailyClm_2days(idtg1,idtg_2,itau,plon,plat,locean)
             579                     
             580                               INTEGER*8 idtg1,idtg_2
             581                               INTEGER itau
             582                               INTEGER iyyyy,imm,idd,ihh,imn
             583                               INTEGER iyyyy2,imm2,idd2,ihh2,imn2
             584                               INTEGER lncrec
             585                               CHARACTER lrec*26
             586                               REAL sstANA0(nx,my),sstANA1(nx,my)
             587                               REAL sstFCT0(nx,my),sstFCT1(nx,my)
             588                               INTEGER i,j,ii,jj,nxj,istat
             589                               REAL wweight
             590                               REAL plon(nx,my_max),plat(my)
             591                               LOGICAL locean(nxp,my_max)
             592                     
             593                               write(cdtg,'(i12)') idtg1
             594                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy,imm,idd,ihh,imn
             595                               write(cdtg,'(i12)') idtg_2
             596                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy2,imm2,idd2,ihh2,imn2
             597                     
             598                               lncrec=nx*my
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT1, sstFCT0, sstANA1, sstANA0
                                   <<< Loop-information  End >>>
             599        pp   2v                sstANA0=0.
             600         p   2v                sstANA1=0.
             601         p   2v                sstFCT0=0.
             602         p   2v                sstFCT1=0.
             603                     
             604                               !dailyClm_option>=1, read climatology ana. sst
             605                        11     format('W00100',4x,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             606                               write(lrec,11) ggdef,imm,idd
             607                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmANA,sstANA0(:,:),istat)
             608                     
             609                        12     format('W00100',4x,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             610                               write(lrec,12) ggdef,imm2,idd2
             611                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmANA,sstANA1(:,:),istat)
             612                     
             613                     !          if( lreduce.eq.1 ) then
             614                     !            call reducepickr(sstANA0(1,1),nxdef,nx,my)
             615                     !            call reducepickr(sstANA1(1,1),nxdef,nx,my)
             616                     !          endif
             617                     
             618                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA1, sstANA0
                                   <<< Loop-information  End >>>
             619        pp    v                sstANA0=MERGE(sstANA0,xmissing,(sstANA0.GE.sstmin .AND. sstANA0.LE.400.))
             620         p    v                sstANA1=MERGE(sstANA1,xmissing,(sstANA1.GE.sstmin .AND. sstANA1.LE.400.))
             621                     
             622                     !ps          CALL fill_missing2(sstANA0(:,:),nx,my,1,.FALSE.)
             623                     !ps          CALL fill_missing2(sstANA1(:,:),nx,my,1,.FALSE.)
             624                     
             625                     
             626     1                         if(dailyClm_option .eq. 2) then     !dailyClm_option=2, read forcast climatology sst
             627     1                  13       format('W00100',i4.4,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             628     1                           write(lrec,13) itau,ggdef,imm,idd
             629     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmFCT,sstFCT0(:,:),istat)
             630     1               
             631     1                  14       format('W00100',i4.4,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             632     1                           write(lrec,14) itau+24,ggdef,imm,idd
             633     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmFCT,sstFCT1(:,:),istat)
             634     1               
             635     1               
             636     1               !            if( lreduce.eq.1 ) then
             637     1               !              call reducepickr(sstFCT0(1,1),nxdef,nx,my)
             638     1               !              call reducepickr(sstFCT1(1,1),nxdef,nx,my)
             639     1               !            endif
             640     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT1, sstFCT0
                                   <<< Loop-information  End >>>
             641     1  pp    v                  sstFCT0=MERGE(sstFCT0,xmissing,(sstFCT0.GE.sstmin .AND. sstFCT0.LE.400.))
             642     1   p    v                  sstFCT1=MERGE(sstFCT1,xmissing,(sstFCT1.GE.sstmin .AND. sstFCT1.LE.400.))
             643     1               
             644     1               !ps            CALL fill_missing2(sstFCT0(:,:),nx,my,1,.FALSE.)
             645     1               !ps            CALL fill_missing2(sstFCT1(:,:),nx,my,1,.FALSE.)
             646     1                         endif
             647                     
             648                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locean, dailyFCTsst, sstANA1, sstANA0
                                   <<<      dFCTsstdt, dailyClmANAsst
                                   <<< Loop-information  End >>>
             649     1                         DO jj = 1, jlistnum
             650     1                           j=jlist1(jj)
             651     1                           nxj=nxdef_2d(j)
             652     1                           i=nxjstart(j)
             653     2                           if( lreduce.eq.1 ) then
             654     2                             call reducepickr(sstANA0(1,j),nxdef(j),nx,1)
             655     2                             call reducepickr(sstANA1(1,j),nxdef(j),nx,1)
             656     2                             call reducepickr(sstFCT0(1,j),nxdef(j),nx,1)
             657     2                             call reducepickr(sstFCT1(1,j),nxdef(j),nx,1)
             658     2                           end if
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 145
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA0, sstANA1, locean, dailyClmANAsst
                                   <<<      dFCTsstdt
                                   <<< Loop-information  End >>>
             659     2  pp    s                  DO ii=1,nxj
             660     2   p    v                    wweight=0.
             661     2   p    v                    i=nxjstart(j)+ii-1
             662     2   p    v                    dailyClmANAsst(ii,jj,0)=sstANA0(i,j)
             663     2   p    v                    dailyClmANAsst(ii,jj,1)=sstANA0(i,j)
             664     2   p    v                    dailyClmANAsst(ii,jj,2)=sstANA1(i,j)
             665     3   p    m                    if(locean(ii,jj) .AND. dailyClm_option .eq. 1) then   !dailyClm_option=1
             666     4   p    s                      if(ldailyFCTsst)then
             667     4                               !similar to (Yuejian Zhu, operational)
             668     4                               !  wweight=min(float(itau)/24./35.,1.)
             669     4                               !do weigting when (tau>=14.*24. & abs(plat)>=40.)
             670     5   p    s                        if((itau .gt. 14*24) .AND. (abs(plat(j)) .gt. 40.)) then
             671     5   p    s                          wweight=min(max((float(itau)-14.*24.)/(24.*30.),0.),1.)
             672     5   p    s                        endif
             673     4   p    s                        dailyFCTsst(ii,jj,2)=(1.-wweight)*dailyFCTsst(ii,jj,2)    &
             674     4                                                     +wweight*dailyClmANAsst(ii,jj,2)
             675     4                               else
             676     4                               !persistent anomaly sst
             677     4                               !SSTf_t=[SSTa_t0-SSTc_t0]*exp(-(t-t0)/90)+SSTc_t
             678     4                               !(Yuejian Zhu, operational)
             679     4                                 wweight=min(max(exp(-float(itau)/(90.*24.)),0.),1.)
             680     4                                 dailyFCTsst(ii,jj,2)=wweight*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0))  &
             681     4                                                     +dailyClmANAsst(ii,jj,2)
             682     4   p    s                      endif
             683     3   p    v                    endif
             684     3   p    s                    if(ldailyFCTsst .AND. locean(ii,jj) .AND. dailyClm_option .eq. 2) then   !dailyClm_option=2
             685     3                               dailyClmFCTsst(ii,jj,0)=sstFCT0(i,j)
             686     3                               dailyClmFCTsst(ii,jj,1)=sstFCT0(i,j)
             687     3                               dailyClmFCTsst(ii,jj,2)=sstFCT1(i,j)
             688     3                               !idea from Yuejian Zhu(2018 JGR)
             689     3                                wweight=min(max(float(itau)/24./35.,1.),0.)
             690     3                                dailyFCTsst(ii,jj,2)=(1.-wweight)*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0)    &
             691     3                                    +dailyClmANAsst(ii,jj,2) )+wweight*(dailyFCTsst(ii,jj,2)    &
             692     3                                    -(dailyClmFCTsst(ii,jj,2)-dailyClmANAsst(ii,jj,2)))
             693     3   p    v                    endif
             694     3   p    s                    if(locean(ii,jj) .AND. dailyFCTsst(ii,jj,1).ge.sstmin &
             695     3                                .AND.dailyFCTsst(ii,jj,2).ge.sstmin)then
             696     3   p    s                      dFCTsstdt(ii,jj)=(dailyFCTsst(ii,jj,2)-dailyFCTsst(ii,jj,1))/(24.*3600.)
             697     3   p    s                    else
             698     3   p    s                      dFCTsstdt(ii,jj)=0.
             699     3   p    v                    endif
             700     2               
             701     2   p    v                  ENDDO  !end do ii
             702     1                         ENDDO    !end do jj
             703                     
             704                             END SUBROUTINE read_dailyClm_2days
             705                     
             706                     
             707                             SUBROUTINE read_dailyClm_dayp1(idtg1,idtg_2,itau,plon,plat,locean)
             708                     
             709                               INTEGER*8 idtg1,idtg_2
             710                               INTEGER itau
             711                               INTEGER iyyyy,imm,idd,ihh,imn
             712                               INTEGER iyyyy2,imm2,idd2,ihh2,imn2
             713                               INTEGER lncrec
             714                               CHARACTER lrec*26
             715                               REAL sstANA(nx,my),sstFCT(nx,my)
             716                               INTEGER i,j,ii,jj,nxj,istat
             717                               REAL wweight
             718                               REAL plon(nx,my_max),plat(my)
             719                               LOGICAL locean(nxp,my_max)
             720                               real::ssttend
             721                     
             722                               write(cdtg,'(i12)') idtg1
             723                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy,imm,idd,ihh,imn
             724                               write(cdtg,'(i12)') idtg_2
             725                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy2,imm2,idd2,ihh2,imn2
             726                     
             727                               lncrec=nx*my
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT, sstANA
                                   <<< Loop-information  End >>>
             728        pp   2v                sstANA=0.
             729         p   2v                sstFCT=0.
             730                     
             731                     
             732                        11     format('W00100',4x,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             733                               write(lrec,11) ggdef,imm2,idd2
             734                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmANA,sstANA(:,:),istat)
             735                     
             736                     !          if( lreduce.eq.1 ) then
             737                     !            call reducepickr(sstANA(1,1),nxdef,nx,my)
             738                     !          endif
             739                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.72, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA
                                   <<< Loop-information  End >>>
             740        pp   2v                sstANA=MERGE(sstANA,xmissing,(sstANA.GE.sstmin .AND. sstANA.LE.400.))
             741                     !ps          CALL fill_missing2(sstANA(:,:),nx,my,1,.FALSE.)
             742                     
             743                     
             744                     
             745     1                         if(dailyClm_option .eq. 2) then
             746     1                  13       format('W00100',i4.4,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             747     1                           write(lrec,13) itau,ggdef,imm,idd
             748     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmFCT,sstFCT(:,:),istat)
             749     1               
             750     1               !            if( lreduce.eq.1 ) then
             751     1               !              call reducepickr(sstFCT(1,1),nxdef,nx,my)
             752     1               !            endif
             753     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.72, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT
                                   <<< Loop-information  End >>>
             754     1  pp   2v                  sstFCT=MERGE(sstFCT,xmissing,(sstFCT.GE.sstmin .AND. sstFCT.LE.400.))
             755     1               !ps            CALL fill_missing2(sstFCT(:,:),nx,my,1,.FALSE.)
             756     1                         endif
             757                     
             758                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locean, dailyFCTsst, sstFCT
                                   <<<      dailyClmANAsst, sstANA, dailyClmFCTsst
                                   <<<      ANAsstT0, dFCTsstdt
                                   <<< Loop-information  End >>>
             759     1                         DO jj = 1, jlistnum
             760     1                           j=jlist1(jj)
             761     1                           nxj=nxdef_2d(j)
             762     2                           if( lreduce.eq.1 ) then
             763     2                             call reducepickr(sstANA(1,j),nxdef(j),nx,1)
             764     2                             call reducepickr(sstFCT(1,j),nxdef(j),nx,1)
             765     2                           end if
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 123
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.64, ITR: 40, MVE: 2, POL: L)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTsst, dFCTsstdt, sstFCT, sstANA
                                   <<<      dailyClmFCTsst, ANAsstT0, dailyClmANAsst
                                   <<<      locean
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             766     2  pp    v                  DO ii=1,nxj
             767     2   p    v                   wweight=0.
             768     2   p    v                   i=nxjstart(j)+ii-1
             769     2   p    v                   dailyClmANAsst(ii,jj,2)=sstANA(i,j)
             770     3   p    v                   if(locean(ii,jj) )then
             771     4   p    v                    if( dailyClm_option .eq. 1) then   !dailyClm_option=1
             772     5                               if(ldailyFCTsst)then
             773     5                               !similar to (Yuejian Zhu, operational)
             774     5                               !  wweight=min(float(itau)/24./35.,1.)
             775     5                               !do weigting when (tau>=14.*24. & abs(plat)>=40.)
             776     6                                 if((itau .gt. 14*24) .AND. (abs(plat(j)) .gt. 40.)) then
             777     6                                   wweight=min(max((float(itau)-14.*24.)/(24.*30.),0.),1.)
             778     6                                 endif
             779     5                                 dailyFCTsst(ii,jj,2)=(1.-wweight)*dailyFCTsst(ii,jj,2) &
             780     5                                                     +wweight*dailyClmANAsst(ii,jj,2)
             781     5                               else
             782     5                               !persistent anomaly sst
             783     5                               !SSTf_t=[SSTa_t0-SSTc_t0]*exp(-(t-t0)/90)+SSTc_t
             784     5                               !(Yuejian Zhu, operational)
             785     5                                 wweight=min(max(exp(-float(itau)/(90.*24.)),0.),1.)
             786     5                                 dailyFCTsst(ii,jj,2)=wweight*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0))  &
             787     5                                                      +dailyClmANAsst(ii,jj,2)
             788     5                               endif
             789     4   p    v                    elseif( ldailyFCTsst .AND. dailyClm_option .eq. 2) then   !dailyClm_option=2
             790     4   p    v                      dailyClmFCTsst(ii,jj,2)=sstFCT(i,j)
             791     4                               !idea from Yuejian Zhu(2018 JGR)
             792     4   p    v                       wweight=min(max(float(itau)/24./35.,0.),1.)
             793     4   p    v                       dailyFCTsst(ii,jj,2)=(1.-wweight)*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0)   &
             794     4                                    +dailyClmANAsst(ii,jj,2))+wweight*(dailyFCTsst(ii,jj,2)    &
             795     4                                    -(dailyClmFCTsst(ii,jj,2)-dailyClmANAsst(ii,jj,2)))
             796     4   p    v                    endif
             797     4   p    v                    if( dailyFCTsst(ii,jj,1).ge.sstmin .AND. &
             798     4                                 dailyFCTsst(ii,jj,2).ge.sstmin )then
             799     4                               !remove large tendency 20231207
             800     4   p    v                      ssttend =  dailyFCTsst(ii,jj,2)-dailyFCTsst(ii,jj,1)
             801     4   p    v                      ssttend = min( 10. , max( -10. , ssttend ))
             802     4   p    v                      dFCTsstdt(ii,jj)=ssttend/(24.*3600.)
             803     4   p    v                    else
             804     4   p    v                      dFCTsstdt(ii,jj)=0.
             805     4   p    v                    endif
             806     3   p    v                   endif !if locean
             807     2               
             808     2   p    v                  ENDDO
             809     1                         ENDDO
             810                     
             811                     
             812                             END SUBROUTINE read_dailyClm_dayp1
             813                     
             814                     
             815                           END SUBROUTINE read_dailyFCT
             816                     

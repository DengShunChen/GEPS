            2541                               FUNCTION Get_JulianMonLen(ky, km) RESULT(idmax)
            2542                             !+
            2543                             !
            2544                             ! Get_JulianMonLen [function, integer]
            2545                             !    get the length of a months in a Julian year
            2546                             !    (
            2547                             !    year  [integer] input (Calendar year)
            2548                             !    month [integer] input (month of the year)
            2549                             !    )
            2550                             !
            2551                             !-
            2552                                INTEGER, INTENT(in) :: km, ky
            2553                                INTEGER :: idmax
            2554                     
            2555     1                          SELECT CASE(km)
            2556     1                          CASE(1,3,5,7,8,10,12);  idmax = 31
            2557     1                          CASE(4,6,9,11);         idmax = 30
            2558     1                          CASE(2)
            2559     2                            IF ( (MOD(ky,4)==0 .AND. MOD(ky,100)/=0) .OR. MOD(ky,400)==0 ) THEN
            2560     2                              ! leap year found
            2561     2                              idmax = 29
            2562     2                            ELSE
            2563     2                              idmax = 28
            2564     2                            END IF
            2565     1               
            2566     1                          CASE default
            2567     1                            print*,'mo_time_weight:Get_JulianMonLen, month invalid'
            2568     1               
            2569     1                          END SELECT
            2570                     !           Get_JulianMonLen = idmax
            2571                     
            2572                               END FUNCTION Get_JulianMonLen
            2573                     
            2574                     
            2575                               FUNCTION Set_JulianDay(ky, km, kd, zsec) RESULT(zd)
            2576                          !+
            2577                          !
            2578                          ! Set_JulianDay  [subroutine]
            2579                          !    convert year, month, day, seconds into Julian calendar day
            2580                          !    (
            2581                          !    year   [integer] input (calendar year)
            2582                          !    month  [integer] input (month of the year)
            2583                          !    day    [integer] input (day of the month)
            2584                          !    second [integer] input (seconds of the day)
            2585                          !    date   [julian_date] output (Julian day)
            2586                          !    )
            2587                          !
            2588                          !-
            2589                          !
            2590                               INTEGER, INTENT(IN) :: ky
            2591                               INTEGER, INTENT(IN) :: km
            2592                               INTEGER, INTENT(IN) :: kd
            2593                               REAL,    INTENT(IN) :: zsec
            2594                          !
            2595                          ! for reference: 1. January 1998 00 UTC === Julian Day 2450814.5
            2596                          !
            2597                               INTEGER :: ib, iy, im, idmax
            2598                               REAL :: zd
            2599                     
            2600     1                         IF ( zsec > 1. ) THEN
            2601     1                           print*,'Set_JulianDay: invalid number of seconds'
            2602     1                         ENDIF
            2603                     
            2604                     
            2605     1                         IF (km <= 2) THEN
            2606     1                           iy = ky-1
            2607     1                           im = km+12
            2608     1                         ELSE
            2609     1                           iy = ky
            2610     1                           im = km
            2611     1                         ENDIF
            2612                     
            2613                              ib = INT(iy/400)-INT(iy/100)
            2614                             ! check the length of the month
            2615                              idmax = Get_JulianMonLen (ky, km)
            2616                     
            2617     1                        if(myrank==0)then
            2618     1                        IF (kd < 1 .OR. idmax < kd) &
            2619     1                          print *,'Set_JulianDay: day in months invalid' &
            2620     1                                 ,' kd=', kd,'idmax= ',idmax
            2621     1                        endif
            2622                     
            2623                              zd = real(365.25*iy)+INT(30.6001*(im+1)) &
            2624                                  +REAL(ib)+1720996.5+REAL(kd)+zsec
            2625                     
            2626                              END FUNCTION Set_JulianDay
            2627                     
            2628                     
            2629                             END SUBROUTINE time_weights

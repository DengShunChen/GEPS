     1      1633                     !
     1      1634                     ! netcdf data types:
     1      1635                     !
     1      1636                           integer ncbyte
     1      1637                           integer ncchar
     1      1638                           integer ncshort
     1      1639                           integer nclong
     1      1640                           integer ncfloat
     1      1641                           integer ncdouble
     1      1642                     
     1      1643                           parameter(ncbyte = 1)
     1      1644                           parameter(ncchar = 2)
     1      1645                           parameter(ncshort = 3)
     1      1646                           parameter(nclong = 4)
     1      1647                           parameter(ncfloat = 5)
     1      1648                           parameter(ncdouble = 6)
     1      1649                     
     1      1650                     !
     1      1651                     !     masks for the struct nc flag field; passed in as 'mode' arg to
     1      1652                     !     nccreate and ncopen.
     1      1653                     !
     1      1654                     
     1      1655                     !     read/write, 0 => readonly
     1      1656                           parameter(ncrdwr = 1)
     1      1657                     !     in create phase, cleared by ncendef
     1      1658                           parameter(nccreat = 2)
     1      1659                     !     on create destroy existing file
     1      1660                           parameter(ncexcl = 4)
     1      1661                     !     in define mode, cleared by ncendef
     1      1662                           parameter(ncindef = 8)
     1      1663                     !     synchronise numrecs on change (x'10')
     1      1664                           parameter(ncnsync = 16)
     1      1665                     !     synchronise whole header on change (x'20')
     1      1666                           parameter(nchsync = 32)
     1      1667                     !     numrecs has changed (x'40')
     1      1668                           parameter(ncndirty = 64)
     1      1669                     !     header info has changed (x'80')
     1      1670                           parameter(nchdirty = 128)
     1      1671                     !     prefill vars on endef and increase of record, the default behavior
     1      1672                           parameter(ncfill = 0)
     1      1673                     !     do not fill vars on endef and increase of record (x'100')
     1      1674                           parameter(ncnofill = 256)
     1      1675                     !     isa link (x'8000')
     1      1676                           parameter(nclink = 32768)
     1      1677                     
     1      1678                     !
     1      1679                     !     'mode' arguments for nccreate and ncopen
     1      1680                     !
     1      1681                           parameter(ncnowrit = 0)
     1      1682                           parameter(ncwrite = ncrdwr)
     1      1683                           parameter(ncclob = nf_clobber)
     1      1684                           parameter(ncnoclob = nf_noclobber)
     1      1685                     
     1      1686                     !
     1      1687                     !     'size' argument to ncdimdef for an unlimited dimension
     1      1688                     !
     1      1689                           integer ncunlim
     1      1690                           parameter(ncunlim = 0)
     1      1691                     
     1      1692                     !
     1      1693                     !     attribute id to put/get a global attribute
     1      1694                     !
     1      1695                           parameter(ncglobal  = 0)
     1      1696                     
     1      1697                     !
     1      1698                     !     advisory maximums:
     1      1699                     !
     1      1700                           parameter(maxncop = 64)
     1      1701                           parameter(maxncdim = 1024)
     1      1702                           parameter(maxncatt = 8192)
     1      1703                           parameter(maxncvar = 8192)
     1      1704                     !     not enforced
     1      1705                           parameter(maxncnam = 256)
     1      1706                           parameter(maxvdims = maxncdim)
     1      1707                     
     1      1708                     !
     1      1709                     !     global netcdf error status variable
     1      1710                     !     initialized in error.c
     1      1711                     !
     1      1712                     
     1      1713                     !     no error
     1      1714                           parameter(ncnoerr = nf_noerr)
     1      1715                     !     not a netcdf id
     1      1716                           parameter(ncebadid = nf_ebadid)
     1      1717                     !     too many netcdfs open
     1      1718                           parameter(ncenfile = -31)   ! nc_syserr
     1      1719                     !     netcdf file exists && ncnoclob
     1      1720                           parameter(nceexist = nf_eexist)
     1      1721                     !     invalid argument
     1      1722                           parameter(nceinval = nf_einval)
     1      1723                     !     write to read only
     1      1724                           parameter(nceperm = nf_eperm)
     1      1725                     !     operation not allowed in data mode
     1      1726                           parameter(ncenotin = nf_enotindefine )
     1      1727                     !     operation not allowed in define mode
     1      1728                           parameter(nceindef = nf_eindefine)
     1      1729                     !     coordinates out of domain
     1      1730                           parameter(ncecoord = nf_einvalcoords)
     1      1731                     !     maxncdims exceeded
     1      1732                           parameter(ncemaxds = nf_emaxdims)
     1      1733                     !     string match to name in use
     1      1734                           parameter(ncename = nf_enameinuse)
     1      1735                     !     attribute not found
     1      1736                           parameter(ncenoatt = nf_enotatt)
     1      1737                     !     maxncattrs exceeded
     1      1738                           parameter(ncemaxat = nf_emaxatts)
     1      1739                     !     not a netcdf data type
     1      1740                           parameter(ncebadty = nf_ebadtype)
     1      1741                     !     invalid dimension id
     1      1742                           parameter(ncebadd = nf_ebaddim)
     1      1743                     !     ncunlimited in the wrong index
     1      1744                           parameter(nceunlim = nf_eunlimpos)
     1      1745                     !     maxncvars exceeded
     1      1746                           parameter(ncemaxvs = nf_emaxvars)
     1      1747                     !     variable not found
     1      1748                           parameter(ncenotvr = nf_enotvar)
     1      1749                     !     action prohibited on ncglobal varid
     1      1750                           parameter(nceglob = nf_eglobal)
     1      1751                     !     not a netcdf file
     1      1752                           parameter(ncenotnc = nf_enotnc)
     1      1753                           parameter(ncests = nf_ests)
     1      1754                           parameter (ncentool = nf_emaxname)
     1      1755                           parameter(ncfoobar = 32)
     1      1756                           parameter(ncsyserr = -31)
     1      1757                     
     1      1758                     !
     1      1759                     !     global options variable. used to determine behavior of error handler.
     1      1760                     !     initialized in lerror.c
     1      1761                     !
     1      1762                           parameter(ncfatal = 1)
     1      1763                           parameter(ncverbos = 2)

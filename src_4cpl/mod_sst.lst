            1056                     
            1057                             SUBROUTINE read_godas(idtg1)
            1058                     ! Ben-Jei Tsuang, NCHU, June 2009, Read GODAS data
            1059                     ! (http://http://cfs.ncep.noaa.gov/cfs/godas/)
            1060                     ! An initial ocean dataset is generated by combining
            1061                     ! script:  irish3::/tcrg/u40bjt00/get/get_godas.sh
            1062                     !
            1063                     ! history:
            1064                     !   2008/8/19: modified the code from mo_so4.f90
            1065                     !   2009/10/23: modified the code from read_woa0
            1066                     
            1067                     !          USE mo_control,       ONLY: ngl, nlon, ngodas, lamip, lmlo
            1068                     !          USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            1069                     !          USE mo_exception,     ONLY: finish, message, message_text
            1070                     
            1071                     !          USE mo_io,            ONLY: io_open_unit, io_close, io_read, &

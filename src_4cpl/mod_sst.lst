            2299                             SUBROUTINE time_weights(idtg1,tauleft)
            2300                     !*****  *********************************************
            2301                     
            2302                             ! calculates weighting factores for clsst2 and ozone
            2303                             !-
            2304                     
            2305                     !            USE mo_interpo, ONLY : wgt1, wgt2, nmw1, nmw2, nmw1cl,
            2306                     !            nmw2cl, &
            2307                     !                               wgtasd1, wgtd2, ndw1, ndw2
            2308                     !         IMPLICIT NONE
            2309                     
            2310                     !        TYPE (time_native) :: date_monm1, date_mon, date_monp1
            2311                     !          INTEGER*8 :: idtg1
            2312                     !          REAL      :: tauleft
            2313                     !          REAL      :: wgt1,wgt2
            2314                     !          INTEGER   :: nmw1,nmw2
            2315                                use rank
            2316                     
            2317                               integer*8 idtg1
            2318                               real tauleft
            2319                               character*12 cdtg
            2320                               INTEGER   yyyy, mm, dd, hh, mn
            2321                               INTEGER   yr,mo,dy,hr
            2322                               INTEGER   seconds, isec
            2323                               INTEGER   imp1, imm1, imp1cl, imm1cl, imlenm1, imlen, imlenp1
            2324                               REAL      zdayl, zsec
            2325                               REAL      zmohlf, zmohlfp1, zmohlfm1
            2326                     !          REAL     zdh, zdhp1, zdhm1
            2327                               INTEGER, PARAMETER :: NDAYLEN=86400
            2328                               REAL      ydate,ydate1,ydate2,ydate3
            2329                               REAL      ydate_jd,ydate1_jd,ydate2_jd,ydate3_jd
            2330                     
            2331                               ! ***  set calendar related parameters
            2332                               ! -----------------------------------
            2333                     
            2334                               write(cdtg,'(i12)')idtg1
            2335                               read(cdtg,'(i4,i2,i2,i2,i2)')yyyy,mm,dd,hh,mn
            2336                               yr=int(yyyy)
            2337                               mo=int(mm)
            2338                               dy=int(dd)
            2339                               hr=int(hh)
            2340                               seconds=int(tauleft)
            2341                     
            2342                     !        CALL TC_get (date_mon, yr, mo, dy, hr, mn, se)
            2343                     
            2344                               ! month index for AMIP data  (0..13)
            2345                               imp1 = mo+1
            2346                               imm1 = mo-1
            2347                     
            2348                               ! month index for cyclic climatological data (1..12)
            2349                               imp1cl = mo+1
            2350                               imm1cl = mo-1
            2351                               IF (imp1cl > 12) imp1cl= 1
            2352                               IF (imm1cl <  1) imm1cl=12
            2353                     
            2354                               ! *** determine length of months and position within current
            2355                               ! month -------
            2356                     
            2357                     !        CALL TC_set(yr, imm1cl, 1, 0, 0, 0, date_monm1)
            2358                     !        CALL TC_set(yr, imp1cl, 1, 0, 0, 0, date_monp1)
            2359                               imlenm1 = Get_JulianMonLen(yr,imm1cl)
            2360                               imlen   = Get_JulianMonLen(yr,mo)
            2361                               imlenp1 = Get_JulianMonLen(yr,imp1cl)
            2362                     
            2363                               zdayl    = REAL(NDAYLEN)
            2364                               zmohlfm1 = REAL(imlenm1*zdayl*0.5)
            2365                               zmohlf   = REAL(imlen  *zdayl*0.5)
            2366                               zmohlfp1 = REAL(imlenp1*zdayl*0.5)
            2367                     
            2368                     
            2369                               ! *** weighting factors for first/second half of month
            2370                               ! -------------------
            2371                     
            2372                               nmw1   = mo
            2373                     !          nmw1cl = mo
            2374                     
            2375                               ! seconds in the present month
            2376                     !        CALL TC_get (next_date, days, seconds)
            2377                               isec = (dy-1)*NDAYLEN + hr*3600+ seconds
            2378                               zsec = REAL(isec)
            2379                     
            2380     1                         IF(zsec <= zmohlf) THEN                     ! first part of month
            2381     1                           wgt1   = (zmohlfm1+zsec)/(zmohlfm1+zmohlf)
            2382     1                           wgt2   = 1.-wgt1
            2383     1                           nmw2   = imm1
            2384     1               !            nmw2cl = imm1cl
            2385     1                         ELSE                                        ! second part of month
            2386     1                           wgt2   = (zsec-zmohlf)/(zmohlf+zmohlfp1)
            2387     1                           wgt1   = 1.-wgt2
            2388     1                           nmw2   = imp1
            2389     1               !            nmw2cl = imp1cl
            2390     1                         ENDIF
            2391                     
            2392                     !          ! *** weighting factors for first/second half of day
            2393                     !          -------------------
            2394                     !
            2395                     !          ndw1   = 2
            2396                     !
            2397                     !          zsec = REAL(seconds,dp)
            2398                     !          zdh   = 12._dp*3600._dp
            2399                     !          zdhm1 = zdh
            2400                     !          zdhp1 = zdh
            2401                     !          IF( zsec <= zdh ) THEN                     ! first part of day
            2402                     !            wgtd1  = (zdhm1+zsec)/(zdhm1+zdh)
            2403                     !            wgtd2  = 1._dp-wgtd1
            2404                     !            ndw2   = 1
            2405                     !          ELSE                                       ! second part of day
            2406                     !            wgtd2  = (zsec-zdh)/(zdh+zdhp1)
            2407                     !            wgtd1  = 1._dp-wgtd2
            2408                     !            ndw2   = 3
            2409                     !          ENDIF
            2410                     
            2411                     
            2412                           ! *** weighting factors for GODAS PENTAD data -------------------
            2413     1                        IF (lgodas) THEN
            2414     2                          IF (ldailysst) THEN
            2415     2               !ps          CALL get_date_components(next_date, yr, mo, dy, hr, mn, se)
            2416     2               !ps          ydate =yr*10000._dp+mo*100._dp+dy+(hr+mn/60._dp+se/3600._dp)/24._dp
            2417     2                            ydate=real(yr*10000.+mo*100.+dy)+real(hr/24.)+tauleft/3600./24.
            2418     2                            ydate1=timevals_godas(1)
            2419     2                            ydate2=timevals_godas(2)
            2420     2                            ydate3=timevals_godas(3)
            2421     2    i                       call date2JulianDay(ydate,ydate_jd)
            2422     2    i                       call date2JulianDay(ydate1,ydate1_jd)
            2423     2    i                       call date2JulianDay(ydate2,ydate2_jd)
            2424     2    i                       call date2JulianDay(ydate3,ydate3_jd)
            2425     2               
            2426     3                            IF (ydate_jd .LE. ydate2_jd) THEN
            2427     4                              IF (ydate_jd .EQ. ydate2_jd) THEN
            2428     4                                wgto2=1
            2429     4                              else
            2430     4                                wgto2=(ydate_jd-ydate1_jd)/(ydate2_jd-ydate1_jd)
            2431     4                              endif
            2432     3                              wgto1=1.-wgto2
            2433     3                              now1=1
            2434     3                              now2=2
            2435     3                            ELSEIF (ydate_jd .LE. ydate3_jd) THEN
            2436     3                              wgto2=(ydate_jd-ydate2_jd)/(ydate3_jd-ydate2_jd)
            2437     3                              wgto1=1.-wgto2
            2438     3                              now1=2
            2439     3                              now2=3
            2440     3                            ELSE
            2441     3               !ps               CALL finish('time_weights', 'GODAS PENTAD Date not found')
            2442     3                              print *,'ydate=',ydate,'timevals_godas(2)=',timevals_godas(2) &
            2443     3                                     ,'timevals_godas(3)=',timevals_godas(3)
            2444     3                              print *,'time_weights', 'GODAS PENTAD Date not found'
            2445     3                              CALL mpe_finalize
            2446     3                              CALL dmsexit(-1)
            2447     3                              stop
            2448     3                            ENDIF
            2449     2                         !!! IF(wgtd(1).GT.1._dp .OR. wgtd(2).GT.1._dp )THEN
            2450     2                         !!!   WRITE(nerr,*) 'get_5dwgtd yr, mo, dy, hr, mn, se=',yr,
            2451     2                         !mo, dy, hr, mn, se,' ydate=',ydate,' ID=',ID,'
            2452     2                         !timevals_godas=',INT(timevals_godas(0:2)),&
            2453     2                         !!!               ' JD(0:2)=',JD(0:2),' wgtd(1:2)=',wgtd(1:2)
            2454     2                         !!! ENDIF
            2455     2               !             if(myrank .eq. 49) then
            2456     2               !               print *,'time weight dailysst'    &
            2457     2               !                   ,',timevals_godas(1)=',timevals_godas(1)   &
            2458     2               !                   ,',timevals_godas(2)=',timevals_godas(2)   &
            2459     2               !                   ,',timevals_godas(3)=',timevals_godas(3)   &
            2460     2               !                   ,',now1=',now1,',now2=',now2        &
            2461     2               !                   ,',wgto1=',wgto1,',wgto2=',wgto2
            2462     2               !             endif
            2463     2               
            2464     2                          ELSE
            2465     2                         ! monthly godas data
            2466     2                            wgto2=wgt2
            2467     2                            wgto1=wgt1
            2468     2                            now1=nmw1
            2469     2                            now2=nmw2
            2470     2                          ENDIF
            2471     1                        ENDIF
            2472                     
            2473                              obswtbwgt1=wgto1
            2474                              obswtbwgt2=wgto2
            2475                              obswtbnmw1=now1
            2476                              obswtbnmw2=now2
            2477                     
            2478                           ! *** weighting factors for first/second half of day
            2479     1                        IF (ldailyFCTsst .OR. ldailyFCTicesndpt .OR. (dailyClm_option.ge. 1)) THEN
            2480     1                         ydate=real(yr*10000.+mo*100.+dy)+real(hr/24.)+tauleft/3600./24.
            2481     1                         ydate1=timevals_dailyFCT(1)
            2482     1                         ydate2=timevals_dailyFCT(2)
            2483     1    i                    call date2JulianDay(ydate,ydate_jd)
            2484     1    i                    call date2JulianDay(ydate1,ydate1_jd)
            2485     1    i                    call date2JulianDay(ydate2,ydate2_jd)
            2486     1               
            2487     1                         obswtbwgt1 = (ydate2_jd-ydate_jd)/(ydate2_jd-ydate1_jd)
            2488     1                         obswtbwgt2 = 1.-obswtbwgt1
            2489     1                         obswtbnmw1 = 1
            2490     1                         obswtbnmw2 = 2
            2491     1               
            2492     1               !          if(myrank .eq. 49) then
            2493     1               !            print *,'time weight, idtg1=',idtg1,',yr=',yr,',mo=',mo &
            2494     1               !                   ,',dy=',dy,',hr=',hr,',tauleft=',tauleft  &
            2495     1               !                   ,',ydate=',ydate,',ydate1=',ydate1        &
            2496     1               !                   ,',ydate2=',ydate2,',ydatejd=',ydate_jd   &
            2497     1               !                  ,',ydate1jd=',ydate1_jd,',ydate2jd=',ydate2_jd &
            2498     1               !                  ,',obswtbwgt1=',obswtbwgt1   &
            2499     1               !                  ,',obswtbwgt2=',obswtbwgt2
            2500     1               !          endif
            2501     1               
            2502     1                        ENDIF
            2503                     
            2504                     

             886                             SUBROUTINE read_ocaf(nx,my,lkvl,ggdef)
             887                     
             888                               use index
             889                               use rank
             890                     
             891                     
             892                               integer nx,my,lkvl
             893                               character*4 ggdef
             894                     !          integer*8 idtg1
             895                     !          character*12 cdtg
             896                     !          integer   iyyyy,mmddhhmn,iyy,imm,istat
             897                               integer istat,k,mm,lncrec
             898                               integer j,jj,nxj,i,ii
             899                               character lrec*26
             900                               REAL, ALLOCATABLE, TARGET :: temp1(:,:),temp2(:,:)
             901                               logical flag
             902                     !
             903                               if(.not. ALLOCATED(temp1)) allocate (temp1(nx,my))
             904                               if(.not. ALLOCATED(temp2)) allocate (temp2(nx,my))
             905                     
             906                               if(.not. ALLOCATED(wdepths)) ALLOCATE(wdepths(1:lkvl+2))
             907                               if(.not. ALLOCATED(wtfn12)) ALLOCATE(wtfn12(nxp,1:lkvl+2,my_max,0:13))
             908                               if(.not. ALLOCATED(wsfn12)) ALLOCATE(wsfn12(nxp,1:lkvl+2,my_max,0:13))
             909                     
             910                               nwdepth=lkvl+2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wdepths
                                   <<< Loop-information  End >>>
             911        pp   4v                wdepths(1:lkvl+2)=sit_zdepth(0:lkvl+1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtfn12
                                   <<< Loop-information  End >>>
             912        pp   4v                wtfn12=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wsfn12
                                   <<< Loop-information  End >>>
             913        pp   4v                wsfn12=0.
             914                     
             915                     
             916                       11     format(i3.3,'TFM','gbck',a4,4x,i2.2,6x)  ! ???TFM
             917                       12     format(i3.3,'SFM','gbck',a4,4x,i2.2,6x)  ! ???SFM
             918                     
             919                               flag=.false.
             920     1                         if(myrank.eq.0) then
             921     1                           call dmsmsg("ALL",istat)
             922     1                           print *,'ready to open ifilin_ocaf'
             923     1                           call dmsopn(ifilin_ocaf,"r",istat)
             924     1                           flag=.true.
             925     1                         endif
             926                     !          call mpe_broadcast(istat,1,flag,mpe_integer)
             927                               call mpe_bcast(istat,1,0,mpe_integer)
             928     1                         if(istat.ne.0)then
             929     1                           if(myrank.eq.0) print *,'dmsopn ocaf error'
             930     1                           call mpe_finalize
             931     1                           call dmsexit(-1)
             932     1                           stop
             933     1                         endif
             934                     
             935                     
             936                               lncrec=nx*my
             937     1                         do k=1,lkvl+2
             938     2                           do mm=1,12
             939     2                             write(lrec,11) k-1,ggdef,mm
             940     2                             if(myrank .eq. 0) print *, 'lrec11=',lrec
             941     2                             call dmsread(nx,my,lrec,lncrec,'H',ifilin_ocaf,temp1(:,:),istat)
             942     2                             write(lrec,12) k-1,ggdef,mm
             943     2                             if(myrank .eq. 0) print *, 'lrec12=',lrec
             944     2                             call dmsread(nx,my,lrec,lncrec,'H',ifilin_ocaf,temp2(:,:),istat)
             945     3                             if( myrank .eq. 72) then
             946     3                               print *,"ocaf: mm=",mm,",wtfn(914,265)=",temp1(914,265)
             947     3                               print *,"ocaf: mm=",mm,",wsfn(914,265)=",temp2(914,265)
             948     3                             endif
             949     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, temp1, wsfn12, wtfn12
                                   <<< Loop-information  End >>>
             950     3                             do jj=1,jlistnum
             951     3                               j=jlist1(jj)
             952     3                               nxj=nxdef_2d(j)
             953     4                               if( lreduce.eq.1 )then
             954     4                                 call reducepickr (temp1(1,j),nxdef(j),nx,1)
             955     4                                 call reducepickr (temp2(1,j),nxdef(j),nx,1)
             956     4                               endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, wsfn12, temp1, wtfn12
                                   <<< Loop-information  End >>>
             957     4  pp   2v                      do ii = 1, nxj
             958     4   p   2v                        i=nxjstart(j)+ii-1
             959     4   p   2v                        wtfn12(ii,k,jj,mm)=temp1(i,j)
             960     4   p   2v                        wsfn12(ii,k,jj,mm)=temp2(i,j)
             961     4               
             962     5   p   2v                        if(mm .eq. 1) then
             963     5   p   2v                          wtfn12(ii,k,jj,13)=temp1(i,j)
             964     5   p   2v                          wsfn12(ii,k,jj,13)=temp2(i,j)
             965     5   p   2v                        endif
             966     5   p   2v                        if(mm .eq. 12) then
             967     5       2v                          wtfn12(ii,k,jj,0)=temp1(i,j)
             968     5   p   2v                          wsfn12(ii,k,jj,0)=temp2(i,j)
             969     5   p   2v                        endif
             970     4   p   2v                      enddo  !end do ii
             971     3                             enddo    !end do jj
             972     2                           enddo    !end do mm
             973     1                         enddo !end of k
             974                     
             975                              deallocate(temp1,temp2)
             976                              call dmscls(ifilin_ocaf,istat)
             977                     
             978                             END SUBROUTINE read_ocaf
             979                     

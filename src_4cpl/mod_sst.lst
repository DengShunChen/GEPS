             818                           SUBROUTINE outtseadiffFCT24(nx,my,my_max,dt24,ifilout,itau,idtg,ggdef)
             819                     
             820                           use index
             821                           use mpe
             822                           use const, only: kflag,RTYPE,outdms,outgrb2
             823                           use mod_grb2_param,only: wrt_grb2_v2
             824                     
             825                           implicit none
             826                     
             827                           integer   nx,my,my_max,itau
             828                           real      dt24
             829                           real(kind=RTYPE) glob(nx,my),wrk(nxp,my_max)
             830                           integer*8 idtg
             831                           character*80 ifilout
             832                           character*26 ihdg
             833                           character*4  ggdef
             834                           integer   imax,jmax,lenc,j,nxj,i,istat,jj
             835                     
             836                           imax=nx
             837                           jmax=my
             838                           lenc= imax*jmax
             839                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24, wrk
                                   <<< Loop-information  End >>>
             840     1  pp                 do jj = 1,jlistnum
             841     1   p                   j=jlist1(jj)
             842     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24, wrk
                                   <<< Loop-information  End >>>
             843     2   p   2v              do i=1,nxj
             844     2   p   2v               wrk(i,jj)=tseadiffFCT24(i,jj)/dt24
             845     2   p   2v              enddo
             846     1   p                 enddo
             847                           call unify_reduceintp(nx,my,my_max,wrk,glob)
             848                           call syslbl ('w0001f',idtg,itau,ggdef,ihdg)
             849                           if(outdms.gt.0) &
             850                           call dmswrit(imax,jmax,ihdg,lenc,kflag,ifilout,glob,istat)
             851                           if( outgrb2==1.and.myrank==0 ) &
             852                           call wrt_grb2_v2(itau,10,3,199,6,168,0,2,glob,ihdg)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24
                                   <<< Loop-information  End >>>
             853        pp   4v            tseadiffFCT24=0.
             854                     
             855                           END SUBROUTINE

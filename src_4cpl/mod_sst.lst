            1270                               IF (.NOT. ALLOCATED(odepths)) ALLOCATE (odepths(nodepth))
            1271                               IF (.NOT. ALLOCATED(ot12)) ALLOCATE (ot12(nxp, nodepth, my_max, 0:13))

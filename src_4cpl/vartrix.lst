               1                           subroutine vartrix(vorten,divten,phiten,kk,k,          &
               2                                              x,nn,m,nbig,jtrun,jtmax,isym,iflag)
               3                     !
               4                     !  purpose: Scatter between vorten, divten, phiten and x vector
               5                     !-----------------------------------------------------------------------
               6                     !  ****  input ****
               7                     !  vorten  :  vorticity tendency(correction) array in spectrum domaon
               8                     !  divten  :  divergence tendency(correction) array in spectrum domain
               9                     !  phiten  :  geopotantial tendency(correction) array in spectrum domain
              10                     !  x       : vector matrix( when iflag=-2)
              11                     !  kk      : total vertical levels
              12                     !  nn      : total number of variables in one dimension
              13                     !            i.e. the size of the vector matrixs
              14                     !  m       : horizontal wave number
              15                     !  nbig    : how many  wave number for initialization
              16                     !  isym    : = +1   :  symmetric case
              17                     !            = -1   :  asymmetric case
              18                     !  iflag   : = +2   :  variable tendency  to x vector (5.43)
              19                     !              -2   :  x vector(correction) to (vors,divs,phis)
              20                     !
              21                     !  **** output ****
              22                     !  vorten  :  vorticity tendency(correction) array in spectrum domaon
              23                     !  divten  :  divergence tendency(correction) array in spectrum domain
              24                     !  phiten  :  geopotantial tendency(correction) array in spectrum domain
              25                     !  x       : vector matrix(when iglag=+2)
              26                     !-----------------------------------------------------------------------
              27                           use index
              28                           use const, only: RTYPE
              29                     
              30                           implicit none
              31                     
              32                           integer  iflag,isym,nbig,m,k,kk,jtrun,jtmax,nn,l,j,n,i
              33                     
              34                           real(kind=RTYPE) vorten(kk,2,jtrun,jtmax),  &
              35                                            divten(kk,2,jtrun,jtmax),  &
              36                                            phiten(kk,2,jtrun,jtmax)
              37                     !
              38                             real x(nn,2)
              39                     !
              40                     
              41                             l=mlist(m)
              42                     
              43                             j=0
              44                             n=nbig/2
              45                     
              46     1                       if(iflag.eq.2)then
              47     1               ! symmetric case
              48     2                         if(isym.eq.1)then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 250
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      x
                                   <<< Loop-information  End >>>
              49     3  pp    v                  do 100 i=1,n
              50     3   p    v                    j=j+1
              51     3   p    v                    x(j,1)=phiten(k,1,l,m)
              52     3   p    v                    x(j,2)=phiten(k,2,l,m)
              53     3   p    v                    j=j+1
              54     3   p    v                    x(j,1)=divten(k,1,l,m)
              55     3   p    v                    x(j,2)=divten(k,2,l,m)
              56     3   p    v                    j=j+1
              57     3   p    v                    x(j,1)=vorten(k,1,l+1,m)
              58     3   p    v                    x(j,2)=vorten(k,2,l+1,m)
              59     3   p    v                    l=l+2
              60     3   p    v       100        continue
              61     3                           if(mod(nbig,2).ne.0)then
              62     3                             j=j+1
              63     3                             x(j,1)=phiten(k,1,l,m)
              64     3                             x(j,2)=phiten(k,2,l,m)
              65     3                             j=j+1
              66     3                             x(j,1)=divten(k,1,l,m)
              67     3                             x(j,2)=divten(k,2,l,m)
              68     3                           endif
              69     2                         else if(isym.eq.-1)then
              70     2               !  antiaymmetrix case
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 250
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

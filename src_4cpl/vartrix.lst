             115     3  pp    v                  do 130 i=1,n
             116     3   p    v                    j=j+1
             117     3   p    v                    vorten(k,1,l,m)=x(j,1)
             118     3   p    v                    vorten(k,2,l,m)=x(j,2)
             119     3   p    v                    j=j+1
             120     3   p    v                    phiten(k,1,l+1,m)=x(j,1)
             121     3   p    v                    phiten(k,2,l+1,m)=x(j,2)
             122     3   p    v                    j=j+1
             123     3   p    v                    divten(k,1,l+1,m)=x(j,1)
             124     3   p    v                    divten(k,2,l+1,m)=x(j,2)
             125     3   p    v                    l=l+2
             126     3   p    v       130        continue
             127     3                           if(mod(nbig,2).ne.0)then
             128     3                             j=j+1
             129     3                             vorten(k,1,l,m)=x(j,1)
             130     3                             vorten(k,2,l,m)=x(j,2)
             131     3                           endif
             132     2                         endif
             133     1                       endif
             134                     !

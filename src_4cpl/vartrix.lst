                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      x
                                   <<< Loop-information  End >>>
              71     3  pp    v                  do 110 i=1,n
              72     3   p    v                    j=j+1
              73     3   p    v                    x(j,1)=vorten(k,1,l,m)
              74     3   p    v                    x(j,2)=vorten(k,2,l,m)
              75     3   p    v                    j=j+1
              76     3   p    v                    x(j,1)=phiten(k,1,l+1,m)
              77     3   p    v                    x(j,2)=phiten(k,2,l+1,m)
              78     3   p    v                    j=j+1
              79     3   p    v                    x(j,1)=divten(k,1,l+1,m)
              80     3   p    v                    x(j,2)=divten(k,2,l+1,m)
              81     3   p    v                    l=l+2
              82     3   p    v       110        continue
              83     3                           if(mod(nbig,2).ne.0)then
              84     3                             j=j+1
              85     3                             x(j,1)=vorten(k,1,l,m)
              86     3                             x(j,2)=vorten(k,2,l,m)
              87     3                           endif
              88     2                         endif
              89     1                       else if(iflag.eq.-2)then
              90     1               ! inverse transform
              91     2                         if(isym.eq.1)then
              92     2               ! symmmetrix case
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 250
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      x
                                   <<< Loop-information  End >>>
              93     3  pp    v                  do 120 i=1,n
              94     3   p    v                    j=j+1
              95     3   p    v                    phiten(k,1,l,m)=x(j,1)
              96     3   p    v                    phiten(k,2,l,m)=x(j,2)
              97     3   p    v                    j=j+1
              98     3   p    v                    divten(k,1,l,m)=x(j,1)
              99     3   p    v                    divten(k,2,l,m)=x(j,2)
             100     3   p    v                    j=j+1
             101     3   p    v                    vorten(k,1,l+1,m)=x(j,1)
             102     3   p    v                    vorten(k,2,l+1,m)=x(j,2)
             103     3   p    v                    l=l+2
             104     3   p    v       120        continue
             105     3                           if(mod(nbig,2).ne.0)then
             106     3                             j=j+1
             107     3                             phiten(k,1,l,m)=x(j,1)
             108     3                             phiten(k,2,l,m)=x(j,2)
             109     3                             j=j+1
             110     3                             divten(k,1,l,m)=x(j,1)
             111     3                             divten(k,2,l,m)=x(j,2)
             112     3                           endif
             113     2                         else if(isym.eq.-1)then
             114     2               !  antiammetrix case
                                   <<< Loop-information Start >>>

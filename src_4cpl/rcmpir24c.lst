                                   <<<      cminn, cminn0
                                   <<<    PREFETCH(SOFT) : 8
                                   <<<     SEQUENTIAL : 8
                                   <<<      tl: 2, caddn: 2, rl: 2, fz1: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3

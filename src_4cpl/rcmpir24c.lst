 External subroutine subprogram "rcmpir24c"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine rcmpir24c( nr,nx,lev,bf,ee,ww1,ww2,ww,ttau,cld,cldb &
               2                                                ,ffu,ffd )
               3                     !
               4                     ! **********************************************************************
               5                     ! (1)In this subroutine, the two- and four- stream combination scheme or
               6                     ! the source function technique (Toon et al. 1989) is used to calculate
               7                     ! the IR radiative fluxes. The exponential approximation for the Planck
               8                     ! function in optical depth is used ( Fu, 1991).
               9                     ! At IR wavelengths, the two-stream results are not exact in the limit
              10                     ! of no scattering. It also introduces large error in the case of sca-
              11                     ! ttering. Since the no-scattering limit is of considerable significance
              12                     ! at IR wavelengths, we have used  the source function technique  that
              13                     ! would be exact in the limit of the pure absorption and would also en-
              14                     ! hance the accuracy of the two-stream approach when scattering occurs
              15                     ! in the IR wavelengths.
              16                     ! Here, we use nq Gauss points to obtain the fluxes: when nq=2, we use
              17                     ! double Gaussian quadrature as in Fu and Liou (1993) for  four-stream
              18                     ! approximation; when nq = 3, we use the regular Gauss quadrature  but
              19                     ! u1*w1+u2*w2+u3*w3=1.0.
              20                     !
              21                     ! (2)The treatment of cloud overlapping for partial clouinesses is
              22                     !    included by Fong(1996), which is based on the method proposed
              23                     !    by Geleyn and Hollingsworth (1979, contrib. atmos. phys. ).
              24                     !
              25                     ! ++ input/output variables:
              26                     !    (1) input variables :
              27                     !        nr    : number of grid points to calculate ir flux
              28                     !        nx    : horizontal dimension of input array
              29                     !        lev   : number of vertical layers
              30                     !        bf    : blockbody intensity function integrated over
              31                     !                the band "ib"
              32                     !                bf(1~lev+1) : atmospheric levels
              33                     !                bf(lev+2)   : surface level
              34                     !        ee    : ground surface emissivity
              35                     !        ww1~2 : first two coeff. of legendre polynomials for
              36                     !                the scattering phase function
              37                     !        ww    : single scattering albedo
              38                     !        ttau(lev+1) : total optical depth from top to reference level
              39                     !
              40                     !    (2) output variables :
              41                     !        ffu
              42                     !        ffd
              43                     !
              44                     ! ++ auther :
              45                     !    c. t. fong and fu (1996, summer)
              46                     !    modify to f90 bt C-H Lee in 2015
              47                     !
              48                     ! **********************************************************************
              49                           use paramt
              50                           use fj_pad
              51                           use rank
              52                     
              53                           implicit  none
              54                     !
              55                     !fong parameter ( nq = 1 )  ! souce function techn. for two streams
              56                           integer,parameter :: nq = 2 ! ............... for four streams
              57                     !fong parameter ( nq = 3 )  ! ..................... for six streams
              58                     !
              59                           integer   nr,nx,lev
              60                     
              61                           real      bf(nx*(lev+2)),ee(nx),ww1(nx*lev,2),ww2(nx*lev,2), &
              62                                     ww(nx*lev,2),ttau(nx*(lev+1),2),cld(nx*lev),       &
              63                                     cldb(nx*lev,4)
              64                           real      ffu(nx*(lev+1)),ffd(nx*(lev+1))
              65                     !
              66                     !   local working arrays
              67                     !
              68                     !     include '../include/paramt.h'
              69                     !     include '../include/fj_pad.h'
              70                     !     include '../include/rank.h'
              71                     !
              72                           real      w1(ilm,2),w(ilm,2),tau(im*(lm+1),2)
              73                           real      ug(nq),wg(nq),ugwg(nq)
              74                           real      lamdan(ilm,2),gamman(ilm,2),caddn(ilm,2),          &
              75                                     cminn(ilm,2),caddn0(ilm,2),cminn0(ilm,2),          &
              76                                     rl(ilm,2),tl(ilm,2),asir(im),expn(ilm,2)
              77                     !fj     3         ,aa(im,4,4)
              78                     !fj      dimension amtx(im,lm*4,12),alfa(im*(lm+1)),beta(ilm,2)
              79                           real      amtx(im+npad,lm*4,12),alfa(im*(lm+1)),beta(ilm,2)
              80                           real      fiu(im*(lm+1),2,nq),fid(im*(lm+1),2,nq),           &
              81                                     fx(ilm,2,nq),fz1(ilm,2,nq),fz2(ilm,2,nq),          &
              82                                     fuq1(ilm,2),fuq2(ilm,2)
              83                           real      wk1(im)
              84                     !ibm
              85                           real      tmp1(nr*lev,2),tmp2(nr*lev,2),tmp3(nr*lev,2,nq),   &
              86                                     tmp4(nr*lev,2)
              87                     !fj
              88                           real      fj_dtau(nr*lev)
              89                     !
              90                     !6st  data ug / 0.238619, 0.661209, 0.932469 /
              91                     !6st  data wg / 0.467914, 0.360762, 0.171324 /
              92                     !6st  data ugwg / 0.109475, 0.233886, 0.156639 /
              93                           data ug / 0.2113248, 0.7886752 /
              94                           data wg / 0.5, 0.5 /
              95                           data ugwg / 0.105662, 0.394338 /
              96                     !2st  data ug / 0.5 /
              97                     !2st  data wg / 1.0 /
              98                     !2st  data ugwg / 0.5 /
              99                     !
             100                           integer   nrn,nrn1,lev4,i,m,nst,j,kini,jk,jj,k1,k2
             101                           real      sqrt3,rsqrt3,pi,ugts1
             102                           real      fxx,fw,q1,q2,x,gamma1,gamma2,z,fw1,fw2,xx1,xx2
             103                           real      axx,bxx,cxx,rug,ssfc_f,ssfc_c,rugts1,fp,fq,y1,y
             104                           real      fidm_f,fidm_c,fium_f,fium_c
             105                     
             106                           nrn  = nr*lev
             107                           nrn1 = nr*(lev+1)
             108                           lev4 = lev*4
             109                           sqrt3= sqrt(3.)
             110                           rsqrt3= 1./sqrt3
             111                           pi   = 4.*atan(1.)
             112                           ugts1 = 0.5
             113                     !
             114                     !fong01
             115                     ! incorporate a delta-function adjustment to account for the forward
             116                     ! diffraction  peak in the context of the two stream approximations.
             117                     ! w1(n),  w(n), and tau(n+1) are the adjusted parameters.
             118                     !
             119                     !  asir : surface albedo for infrared waves
             120                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ee, asir
                                   <<< Loop-information  End >>>
             121     1  pp   2v            do 8 i = 1, nr
             122     1   p   2v            asir(i) = 1.0 - ee(i)
             123     1   p   2v          8 continue
             124                     !
             125                     !
             126                     ! The following is used to calculate the coefficients for hemispheric
             127                     ! mean two streams.
             128                     ! The  hemispheric  mean scheme is derived by assuming that the phase
             129                     ! function is equal to 1 + g in  the forward scattering hemisphere
             130                     ! and 1 - g  in  the  backward scattering hemisphere where g is the
             131                     ! asymmetry factor.   The hemispheric mean is only used for infrared
             132                     ! wavelengths (Toon et al. 1989).
             133                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww2, ww, ww1, ttau, w1, w, fj_dtau, bf
                                   <<<      tmp2, beta, lamdan, tmp1, gamman, cminn
                                   <<<      cminn0, caddn, caddn0, tl, rl, (unknown)
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      expn: 4
                                   <<< Loop-information  End >>>
             134     1                     do 41 m = 1, 2
             135     1               !ibm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tau
                                   <<< Loop-information  End >>>
             136     2  pp   4v            do i = 1, nr
             137     2   p   4v             tau(i,m) = 0.
             138     2   p   4v            enddo
             139     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 140,148)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tau, ttau, ww1, ww2, fj_dtau, w, ww, w1
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             140     2   m    v            do i = 1, nrn
             141     2   p    v               fxx = ww2(i,m) / 5.0
             142     2   p    v               fw = 1.0 - fxx * ww(i,m)
             143     2   p    v               w1(i,m) = ( ww1(i,m) - 3.0 * fxx ) / ( 1.0 - fxx )
             144     2   p    v               w(i,m)  = ( 1.0 - fxx ) * ww(i,m) / fw
             145     2   p    v               fj_dtau(i) = (ttau(i+nr,m) - ttau(i,m)) * fw
             146     2   p    v            enddo
             147     1               !fj
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             148     2                     do i = 1, nrn
             149     2        s               tau(i+nr,m) = tau(i,m) + fj_dtau(i)
             150     2                     enddo
             151     1               !--
             152     1               !ocl simd,swp,norecurrence
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 19
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      bf, w, w1, fj_dtau, tmp2, lamdan, gamman
                                   <<<      beta, tmp1, cminn, cminn0, caddn, caddn0
                                   <<<      tl
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      rl: 2, expn: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             153     2  pp    v            do i = 1, nrn
             154     2   p    v               tmp2(i,m) = fj_dtau(i)
             155     2   p    v               fj_dtau(i) = max(0.000001, fj_dtau(i))
             156     2   p    v               q1 = log( bf(i+nr)/bf(i) )
             157     2   p    v               if( abs(q1) .lt. 1.0e-10 ) q1 = 1.0e-10
             158     2   p    v               q2 = 1.0 / fj_dtau(i)
             159     2   p    v               beta(i,m)= q1 * q2
             160     2               !--
             161     2   p    v               if(m.eq.2) w(i,m) = min ( w(i,m), 0.999999 )
             162     2   p    v               x = w(i,m) * w1(i,m) / 3.0
             163     2   p    v               gamma1 = 2.0 - w(i,m) - x
             164     2   p    v               gamma2 = w(i,m) - x
             165     2   p    v               tmp1(i,m) = (gamma1 + gamma2)*(gamma1 - gamma2)
             166     2               !
             167     2               !fj      call vsqrt(lamdan(1,m),tmp1(1,m),nrn)
             168     2   p    v               lamdan(i,m) = sqrt(tmp1(i,m))
             169     2               !fj   do i = 1,nrn
             170     2               !      tmp1(i,m) = -tmp2(i,m)*lamdan(i,m)
             171     2   p    v               expn(i,m) = -tmp2(i,m)*lamdan(i,m)
             172     2   p    v               z = lamdan(i,m) * lamdan(i,m) - beta(i,m) * beta(i,m)
             173     3   p    v               if(abs(z) .lt. 0.000001)then
             174     3   p    v                  beta(i,m) = beta(i,m)+beta(i,m)*0.01
             175     3   p    v                  z = lamdan(i,m) * lamdan(i,m) - beta(i,m) * beta(i,m)
             176     3   p    v               end if
             177     2   p    v               tmp1(i,m) = z
             178     2               !fj      enddo
             179     2               !     call vexp(expn(1,m),tmp1(1,m),nrn)
             180     2               !fj      call vexp(expn(1,m),expn(1,m),nrn)
             181     2   p    v               expn(i,m) = exp(expn(i,m))
             182     2               !fj      call vrec(tmp1(1,m),tmp1(1,m),nrn)
             183     2   p    v               tmp1(i,m) = 1.d0/tmp1(i,m)
             184     2               !ibm
             185     2               !fj      do 40 i = 1, nrn
             186     2   p    v            x = w(i,m) * w1(i,m) / 3.0
             187     2   p    v            gamma1 = 2.0 - w(i,m) - x
             188     2   p    v            gamma2 = w(i,m) - x
             189     2               !ibm  dtau = tau(i+nr,m) - tau(i,m)
             190     2               !ibm  lamdan(i,m) = sqrt((gamma1 + gamma2)*(gamma1 - gamma2))
             191     2               !vpp  lamdan(i,m) = exp( 0.5*log((gamma1 + gamma2)*(gamma1 - gamma2)) )
             192     2   p    v            gamman(i,m) = gamma2 / ( gamma1 + lamdan(i,m) )
             193     2               !ibm  expn(i,m) = exp ( - lamdan(i,m) * dtau )
             194     2   p    v            fw1 = pi * 2.0 * ( 1.0 - w(i,m) ) * bf(i)
             195     2   p    v            fw2 = pi * 2.0 * ( 1.0 - w(i,m) ) * bf(i+nr)
             196     2   p    v            xx1 = ( gamma1 + beta(i,m) ) + gamma2
             197     2   p    v            xx2 = ( gamma1 - beta(i,m) ) + gamma2
             198     2               !ibm
             199     2               !     z = lamdan(i,m) * lamdan(i,m) - beta(i,m) * beta(i,m)
             200     2               !     if(abs(z) .lt. 0.000001)then
             201     2               !      beta(i,m) = beta(i,m)+beta(i,m)*0.01
             202     2               !      z = lamdan(i,m) * lamdan(i,m) - beta(i,m) * beta(i,m)
             203     2               !     end if
             204     2               !     caddn0(i,m) = fw1 * xx1 / z
             205     2               !     cminn0(i,m) = fw1 * xx2 / z
             206     2               !     caddn(i,m) = fw2 * xx1 / z
             207     2               !     cminn(i,m) = fw2 * xx2 / z
             208     2               !ibm
             209     2   p    v            caddn0(i,m) = fw1 * xx1 * tmp1(i,m)
             210     2   p    v            cminn0(i,m) = fw1 * xx2 * tmp1(i,m)
             211     2   p    v            caddn(i,m) = fw2 * xx1 * tmp1(i,m)
             212     2   p    v            cminn(i,m) = fw2 * xx2 * tmp1(i,m)
             213     2   p    v            axx = gamman(i,m) * gamman(i,m)
             214     2   p    v            bxx = expn(i,m) * expn(i,m)
             215     2   p    v            cxx = axx * bxx - 1.0
             216     2   p    v            rl(i,m) = gamman(i,m) * ( bxx - 1.0 ) / cxx
             217     2   p    v            tl(i,m) = expn(i,m) * ( axx - 1.0 ) / cxx
             218     2   p    v            rl(i,m) = max ( 0., rl(i,m) )
             219     2   p    v            enddo
             220     1               
             221     1               !ocl simd,prefetch
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 240, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gamman, expn, tmp4
                                   <<< Loop-information  End >>>
             222     2  pp   2v            do i = 1, nrn
             223     2   p   2v            z = expn(i,m)*expn(i,m) - gamman(i,m)*gamman(i,m)
             224     3   p   2v            if( abs(z) .lt. 1.0e-10 ) then
             225     3   p   2v               z = 1.0e-10
             226     3   p   2v               tmp4(i,m) = z
             227     3   p   2v            else
             228     3   p   2v               tmp4(i,m) = z
             229     3   p   2v            endif
             230     2   p   2v            enddo
             231     1               !fj 40   continue
             232     1               !ibm
             233     1               !fj      call vrec(tmp4(1,m),tmp4(1,m),nrn)
             234     1               !ibm
             235     1               !ocl prefetch
                                   <<< Loop-information Start >>>

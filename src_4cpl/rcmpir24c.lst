             486     3   p    v            do 250 i = 1, nr
             487     3   p    v            fz1(i+jj,m,1) = (2-m)*(1.0 - cld(i+jj))+(m-1)*cld(i+jj)
             488     3   p    v            fp = amtx(i,k1+m,12) - caddn0(i+jj,m) * fz1(i+jj,m,1)
             489     3   p    v            fq = amtx(i,k2+m,12) - cminn(i+jj,m) * fz1(i+jj,m,1)
             490     3               !ibm  z = expn(i+jj,m)*expn(i+jj,m) - gamman(i+jj,m)*gamman(i+jj,m)
             491     3               !ibm  if( abs(z) .lt. 1.0e-10 ) z = 1.0e-10
             492     3               !ibm  rl(i+jj,m) = ( fp * expn(i+jj,m) - fq * gamman(i+jj,m) ) / z
             493     3               !ibm  tl(i+jj,m) = ( fq * expn(i+jj,m) - fp * gamman(i+jj,m) ) / z
             494     3   p    v            rl(i+jj,m) = ( fp * expn(i+jj,m) - fq * gamman(i+jj,m) )*tmp4(i+jj,m)
             495     3   p    v            tl(i+jj,m) = ( fq * expn(i+jj,m) - fp * gamman(i+jj,m) )*tmp4(i+jj,m)
             496     3               ! 250 continue
             497     3               !fong07
             498     3               !
             499     3               !fong08
             500     3               !
             501     3               !  compute parameters of the source function, eq(53) and (54)
             502     3               !  in toon et al. (1989)
             503     3               !  notice : there is a little difference here from original eqs.
             504     3               !           because of the different approximation to an emitting
             505     3               !           source of plank function used by fu(1992)
             506     3               !
             507     3               !  caddn0, cminn0, caddn, camin : parameter G, H, J, K of the table 3 i
             508     3               !  respectively
             509     3               !  fuq1 * (2*pi*bf) : the rest of terms for upward source function
             510     3               !  fuq2 * (2*pi*bf) : the rest of terms for downward source function
             511     3               !
             512     3               !     do 310 m = 1, 2
             513     3               !     do 310 i = 1, nrn
             514     3               !ibm  x = 2.0 * ( 1.0 - w(i+jj,m) ) * w(i+jj,m) / ( lamdan(i+jj,m) *
             515     3               !ibm 1    lamdan(i+jj,m) - beta(i+jj,m) * beta(i+jj,m) )
             516     3   p    v            x = 2.0 * ( 1.0 - w(i+jj,m) ) * w(i+jj,m) * tmp1(i+jj,m)
             517     3   p    v            y1 = w1(i+jj,m) / 3.0
             518     3   p    v            y = 2.0 * ( 1.0 - w(i+jj,m) * y1 )
             519     3   p    v            z = -y1 * beta(i+jj,m)
             520     3   p    v            fuq1(i+jj,m) = ( x * ( y - z ) + 1.0 - w(i+jj,m) ) * fz1(i+jj,m,1)
             521     3   p    v            fuq2(i+jj,m) = ( x * ( y + z ) + 1.0 - w(i+jj,m) ) * fz1(i+jj,m,1)
             522     3               ! 310 continue
             523     3               !
             524     3               !     rugts1 = 1.0 / ugts1
             525     3               !     do 330 m = 1, 2
             526     3               !     do 330 i = 1, nrn
             527     3   p    v            y = gamman(i+jj,m) * ( rugts1 + lamdan(i+jj,m) )
             528     3   p    v            z = rugts1 - lamdan(i+jj,m)
             529     3   p    v            caddn0(i+jj,m) = rl(i+jj,m) * z
             530     3   p    v            cminn0(i+jj,m) = tl(i+jj,m) * y
             531     3   p    v            caddn(i+jj,m)  = rl(i+jj,m) * y
             532     3   p    v            cminn(i+jj,m)  = tl(i+jj,m) * z
             533     3               ! 330 continue

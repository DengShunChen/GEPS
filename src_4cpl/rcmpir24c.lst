             463                     !
             464                           call mxslvc ( amtx, nx, nr, lev4 )
             465                     !
             466                     !fong04
             467                     !
             468                     !fong07
             469                     !
             470                     !  rl : Y1 + Y2 as in the table 3 of toon et al. (1989)
             471                     !  tl : Y1 - Y2    .......
             472                     !ibm
             473                     !     do 210 i = 1, nrn
             474                     !     fz1(i,1,1) = 1.0 - cld(i)
             475                     !     fz1(i,2,1) = cld(i)
             476                     ! 210 continue
             477                     !ibm
             478                           rugts1 = 1.0 / ugts1
             479                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

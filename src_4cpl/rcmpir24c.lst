             480     1  pp                 do 250 m = 1, 2
             481     2   p                 do 250 j = 1, lev
             482     2   p                 jk = j*nr
             483     2   p                 jj = jk-nr
             484     2   p                 k1 = (j-1)*4
             485     2   p                 k2 = k1 + 2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cld, w, tmp1, w1, beta, amtx, expn, fuq2

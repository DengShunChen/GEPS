 External subroutine subprogram "cubasmc_n"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine cubasmc_n &
               2                          &    (nxj,      klon,     klev,     klevm1,  kk,     pten,&
               3                          &     pqen,     pqsen,    puen,    pven,   pverv,&
               4                          &     pgeo,     pgeoh,    ldcum,   ktype,  klab,  plrain,&
               5                          &     pmfu,     pmfub,    kcbot,   ptu,&
               6                          &     pqu,      plu,      puu,     pvu,    pmfus,&
               7                          &     pmfuq,    pmful,    pdmfup)
               8                     !      m.tiedtke         e.c.m.w.f.     12/89
               9                     !      c.zhang           iprc           05/2012
              10                     !***purpose.
              11                     !   --------
              12                     !          this routine calculates cloud base values
              13                     !          for midlevel convection
              14                     !***interface
              15                     !   ---------
              16                     !          this routine is called from *cuasc*.
              17                     !          input are environmental values t,q etc
              18                     !          it returns cloudbase values for midlevel convection
              19                     !***method.
              20                     !   -------
              21                     !          s. tiedtke (1989)
              22                     !***externals
              23                     !   ---------
              24                     !          none
              25                     ! ----------------------------------------------------------------
              26                       USE mo_constants,    ONLY: cpd,     &! specific heat at constantpressure
              27                                                  rcpd,    &! rcpd=1./cpd
              28                                                  g,       &! gravity acceleration
              29                                                  zrg       ! 1.0/g
              30                       USE mo_cumulus_flux, ONLY: cmfcmin, &! minimum massflux value (for safety)
              31                                                  cmfcmax, &! maximum massflux value allowed for
              32                                                  entrmid, &! entrainment rate for midlevel convect.
              33                                                  lmfdudv, &! true if cumulus friction is switched on
              34                                                  lmfmid
              35                     
              36                     !-----------------------------------------------------------------
              37                           implicit none
              38                           real     pten(klon,klev),        pqen(klon,klev),&
              39                          &         puen(klon,klev),        pven(klon,klev),&
              40                          &         pqsen(klon,klev),       pverv(klon,klev),&
              41                          &         pgeo(klon,klev),        pgeoh(klon,klev+1)
              42                           real     ptu(klon,klev),         pqu(klon,klev),&
              43                          &         puu(klon,klev),         pvu(klon,klev),&
              44                          &         plu(klon,klev),         pmfu(klon,klev),&
              45                          &         pmfub(klon),   &
              46                          &         pmfus(klon,klev),       pmfuq(klon,klev),&
              47                          &         pmful(klon,klev),       pdmfup(klon,klev),&
              48                          &         plrain(klon,klev)
              49                           integer  ktype(klon),            kcbot(klon),&
              50                          &         klab(klon,klev)
              51                           logical  ldcum(klon)
              52                     ! local variabels
              53                           integer  jl,kk,klev,klon,klevp1,klevm1,nxj
              54                           real     zzzmb
              55                     !--------------------------------------------------------
              56                     !*    1.      calculate entrainment and detrainment rates
              57                     ! -------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, klab, pqsen, pqen, pgeo, pten
                                   <<<      pgeoh, ptu, pqu, plu, pverv, pmfub, pmfu
                                   <<<      pmfus, pmfuq, pmful
                                   <<<    PREFETCH(SOFT) : 8
                                   <<<     SEQUENTIAL : 8
                                   <<<      plrain: 2, pdmfup: 2, kcbot: 2, ktype: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              58     1  pp    s             do jl = 1, nxj
              59     2   p    s                if(.not.ldcum(jl) .and. klab(jl,kk+1).eq.0) then
              60     3   p    v                  if(lmfmid .and. pqen(jl,kk) .gt. 0.80*pqsen(jl,kk).and. &
              61     3                             pgeo(jl,kk)*zrg .gt. 5.0e2  .and.  &
              62     3                    &        pgeo(jl,kk)*zrg .lt. 1.0e4 )  then
              63     3   p    v                  ptu(jl,kk+1)=(cpd*pten(jl,kk)+pgeo(jl,kk)-pgeoh(jl,kk+1))&
              64     3                    &                          *rcpd
              65     3   p    v                  pqu(jl,kk+1)=pqen(jl,kk)
              66     3   p    v                  plu(jl,kk+1)=0.
              67     3   p    v                  zzzmb=max(cmfcmin,-pverv(jl,kk)*zrg)
              68     3   p    v                  zzzmb=min(zzzmb,cmfcmax)
              69     3   p    v                  pmfub(jl)=zzzmb
              70     3   p    v                  pmfu(jl,kk+1)=pmfub(jl)
              71     3   p    v                  pmfus(jl,kk+1)=pmfub(jl)*(cpd*ptu(jl,kk+1)+pgeoh(jl,kk+1))
              72     3   p    v                  pmfuq(jl,kk+1)=pmfub(jl)*pqu(jl,kk+1)
              73     3   p    v                  pmful(jl,kk+1)=0.
              74     3   p    v                  pdmfup(jl,kk+1)=0.
              75     3   p    v                  kcbot(jl)=kk
              76     3   p    v                  klab(jl,kk+1)=1
              77     3   p    v                  plrain(jl,kk+1)=0.0
              78     3   p    v                  ktype(jl)=3
              79     3   p    v                end if
              80     2   p    s               end if
              81     1   p    s              end do
              82                           return
              83                           end subroutine cubasmc_n


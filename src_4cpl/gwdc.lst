             921     3               !           14 --------  $$$
             922     3               !           15 ========  $$$  0
             923     3               !           15 --------  $$$
             924     3               !           16 ========  $$$  0
             925     3               ! kcldbot   16 --------  $$$
             926     3               !           17 ========       0
             927     3               !           17 --------
             928     3               !           18 ========       0
             929     3               !           18 --------
             930     3               !           19 ========       0
             931     3               !
             932     3               !-----------------------------------------------------------------------
             933     3               !
             934     3               !   even though the cloud top level obtained in deep convective para-
             935     3               !   meterization is defined in mid-level, the cloud top level for
             936     3               !   the gwdc calculation is assumed to be the interface level just
             937     3               !   above the mid-level cloud top vertical level index.
             938     3               !
             939     3               !-----------------------------------------------------------------------
             940     3               
             941     4   p    v                  if (k < kk .and. k > 1) then
             942     5   p    v                    if ( abs(taugwci(i,k+1)) > taumin ) then                  ! taugwci
             943     6   p    v                      if ( riloc(i,k) > ricrit ) then                         ! riloc
             944     7   p    v                        if ( rimin(i,k) > ricrit ) then                       ! rimin
             945     7   p    v                          taugwci(i,k) = taugwci(i,k+1)
             946     7   p    v                        elseif (rimin(i,k) > riminp) then
             947     7   p    v                          tem = 2.0 + 1.0 / sqrt(riloc(i,k))
             948     7   p    v                          nonlins = (1.0/abs(c2)) * (2.*sqrt(tem) - tem)
             949     7   p    v                          tem1 = basicui(i,k)
             950     7   p    v                          tem2 = c2*nonlins*tem1
             951     7   p    v                          taugwci(i,k) = - rhoi(i,k) * c1 * tem1 * tem2 * tem2   &
             952     7                                               /  (bruni(i,k)*dlen(i))
             953     7   p    v                        elseif (rimin(i,k) > riminm) then
             954     7   p    v                          taugwci(i,k) = zero
             955     7   p    v                        end if                                              ! rimin
             956     6   p    v                      else
             957     6               
             958     6               !!!!!!!!!! in the dynamically unstable environment, there is no gravity wave stress
             959     6               
             960     6   p    v                        taugwci(i,k) = zero

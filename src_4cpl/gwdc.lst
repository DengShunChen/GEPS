                                   <<<      ipt, basicum, vtgwcl, brunm, utgwcl
                                   <<<      dpmid, pmid, plnmid, spfh, rhom, t, v, u
                                   <<< Loop-information  End >>>
             364     1  pp                 do k=1,km
             365     1               !byl        k1 = km - k + 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

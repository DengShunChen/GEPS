             889     3               !
             890     3               !  assuming kcldtop(i)=10 and kcldbot=16,
             891     3               !
             892     3               !                             taugwci  riloc  rimin   utgwc
             893     3               !
             894     3               !  interface 1 ========       - 0.001         -1.e20
             895     3               !            1 --------                               0.000
             896     3               !            2 ========       - 0.001         -1.e20

                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taucty, tauctx
                                   <<< Loop-information  End >>>
             277     1  pp   2v            do i=1,im
             278     1   p   2v              tauctx(i) = 0.0
             279     1   p   2v              taucty(i) = 0.0
             280     1   p   2v            enddo
             281                     !
             282                     !      if (npt == 0) print *,' npt =0 no gwdc calculation done! '
             283                           if (npt == 0) return      ! no gwdc calculation done!

 External subroutine subprogram "gwdc"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gwdc(im,ix,iy,km,u1,v1,t1,q1,           &
               2                                           pmid1,pint1,dpmid1,                &
               3                                           ktop,kbot,kcnv,cldf,qmax,          &
               4                                           grav,cp,rd,fv,deltim,dlength,             &
               5                                           utgwc,vtgwc,tauctx,taucty,j)
               6                     !***********************************************************************
               7                     !        original code for parameterization of convectively forced
               8                     !        gravity wave drag from yonsei university, korea
               9                     !        based on the theory given by chun and baik (jas, 1998)
              10                     !        modified for implementation into the gfs/cfs by
              11                     !        ake johansson  --- aug 2005
              12                     !***********************************************************************
              13                     !lzl +add === #
              14                           use mpe
              15                           use rank
              16                           use index
              17                           use const, only: RTYPE
              18                     !lzl -end === #
              19                     
              20                     !lzl      use machine , only : kind_phys
              21                           implicit none
              22                     
              23                     !---------------------------- arguments --------------------------------
              24                     !
              25                     !  input variables
              26                     !
              27                     !  u        : midpoint zonal wind
              28                     !  v        : midpoint meridional wind
              29                     !  t        : midpoint temperatures
              30                     !  pmid     : midpoint pressures
              31                     !  pint     : interface pressures
              32                     !  dpmid    : midpoint delta p ( pi(k)-pi(k-1) )
              33                     !  lat      : latitude index
              34                     !  qmax     : deep convective heating
              35                     !  kcldtop  : vertical level index for cloud top    ( mid level )
              36                     !  kcldbot  : vertical level index for cloud bottom ( mid level )
              37                     !  kcnv     : (0,1) dependent on whether convection occur or not
              38                     !
              39                     !  output variables
              40                     !
              41                     !  utgwc    : zonal wind tendency
              42                     !  vtgwc    : meridional wind tendency
              43                     !
              44                     !-----------------------------------------------------------------------
              45                     
              46                           integer im, ix, iy, km, lat, ipr,j,iii,kkk,iinpt
              47                           integer ktop(im),kbot(im),kcnv(im)
              48                     
              49                     !lzl      real(kind=kind_phys) grav,cp,rd,fv,fhour,fhourpr
              50                     !lzl      real(kind=kind_phys), dimension(ix)      :: qmax
              51                     !lzl     &,                                           tauctx, taucty
              52                     !lzl      real(kind=kind_phys), dimension(im)      :: cldf,dlength
              53                     !lzl      real(kind=kind_phys), dimension(ix,km)   :: u1,v1,t1,q1,
              54                     !lzl     &                                            pmid1,dpmid1
              55                     !lzl!    &,                                           cumchr1
              56                     !lzl      real(kind=kind_phys), dimension(iy,km)   :: utgwc,vtgwc
              57                     !lzl      real(kind=kind_phys), dimension(ix,km+1) :: pint1
              58                     !lzl
              59                     !lzl      logical lprnt
              60                     !
              61                     !lzl add ---- ##
              62                           real  grav,cp,rd,fv,fhour,fhourpr,deltim
              63                           real, dimension(im)      :: qmax,tauctx, taucty
              64                           real, dimension(im)      :: cldf,dlength
              65                           real, dimension(ix,km)   :: u1,v1,t1,pmid1,dpmid1
              66                     !    &,                                           cumchr1
              67                           real, dimension(iy,km)   :: utgwc,vtgwc
              68                           real, dimension(ix,km+1) :: pint1
              69                           real(kind=RTYPE), dimension(ix,km) :: q1
              70                     
              71                           logical lprnt
              72                     !
              73                     !------------------------- local workspace -----------------------------
              74                     !
              75                     !  i, k     : loop index
              76                     !  kk       : loop index
              77                     !  cldf     : deep convective cloud fraction at the cloud top.
              78                     !  ugwdc    : zonal wind after gwdc paramterization
              79                     !  vgwdc    : meridional wind after gwdc parameterization
              80                     !  plnmid   : log(pmid) ( mid level )
              81                     !  plnint   : log(pint) ( interface level )
              82                     !  dpint    : delta pmid ( interface level )
              83                     !  tauct    : wave stress at the cloud top calculated using basic-wind
              84                     !             parallel to the wind vector at the cloud top ( mid level )
              85                     !  tauctx   : wave stress at the cloud top projected in the east
              86                     !  taucty   : wave stress at the cloud top projected in the north
              87                     !  qmax     : maximum deep convective heating rate ( k s-1 ) in a
              88                     !             horizontal grid point calculated from cumulus para-
              89                     !             meterization. ( mid level )
              90                     !  wtgwc    : wind tendency in direction to the wind vector at the cloud top level
              91                     !             due to convectively generated gravity waves ( mid level )
              92                     !  utgwcl   : zonal wind tendency due to convectively generated
              93                     !             gravity waves ( mid level )
              94                     !  vtgwcl   : meridional wind tendency due to convectively generated
              95                     !             gravity waves ( mid level )
              96                     !  taugwci  : profile of wave stress calculated using basic-wind
              97                     !             parallel to the wind vector at the cloud top
              98                     !  taugwcxi : profile of zonal component of gravity wave stress
              99                     !  taugwcyi : profile of meridional component of gravity wave stress
             100                     !
             101                     !  taugwci, taugwcxi, and taugwcyi are defined at the interface level
             102                     !
             103                     !  bruni    : brunt-vaisala frequency ( interface level )
             104                     !  brunm    : brunt-vaisala frequency ( mid level )
             105                     !  rhoi     : air density ( interface level )
             106                     !  rhom     : air density ( mid level )
             107                     !  ti       : temperature ( interface level )
             108                     !  basicum  : basic-wind profile. basic-wind is parallel to the wind
             109                     !             vector at the cloud top level. (mid level)
             110                     !  basicui  : basic-wind profile. basic-wind is parallel to the wind
             111                     !             vector at the cloud top level. ( interface level )
             112                     !  riloc    : local richardson number ( interface level )
             113                     !  rimin    : minimum richardson number including both the basic-state
             114                     !             and gravity wave effects ( interface level )
             115                     !  gwdcloc  : horizontal location where the gwdc scheme is activated.
             116                     !  break    : horizontal location where wave breaking is occurred.
             117                     !  critic   : horizontal location where critical level filtering is
             118                     !             occurred.
             119                     !  dogwdc   : logical flag whether the gwdc parameterization is
             120                     !             calculated at a grid point or not.
             121                     !
             122                     !  dogwdc is used in order to lessen cpu time for gwdc calculation.
             123                     !
             124                     !-----------------------------------------------------------------------
             125                     
             126                           integer i,ii,k,kk,kb,ilev,npt,kcb,kcldm,npr
             127                           integer, dimension(im) :: ipt
             128                     
             129                     !lzl      real(kind=kind_phys) tem, tem1,  tem2, qtem, wtgwc, tauct,
             130                     !lzl     &                     windcltop,  shear, nonlinct, nonlin, nonlins,
             131                     !lzl     &                     n2,   dtdp,  crit1, crit2, pi, p1, p2,
             132                     !lzl     &                     gsqr,  onebg
             133                     !lzl!    &                     taus, n2,   dtdp,  crit1, crit2, pi, p1, p2
             134                     
             135                     !lzl +add -------- ##
             136                           real tem, tem1,  tem2, qtem, wtgwc, tauct,                    &
             137                     !lzl c           windcltop,  shear, nonlinct, nonlin, nonlins,            &
             138                                shear, nonlinct, nonlin, nonlins,                        &
             139                                n2,   dtdp,  crit1, crit2, pi, p1, p2,                   &
             140                                gsqr,  onebg
             141                     !lzl -end -------- ##
             142                           integer,              allocatable :: kcldtop(:),kcldbot(:)
             143                           logical,              allocatable :: do_gwc(:)
             144                     !lzl      real(kind=kind_phys), allocatable :: tauctxl(:), tauctyl(:),
             145                     !lzl     &                                     gwdcloc(:), break(:),
             146                     !lzl     &                                     critic(:),
             147                     !lzl!    &                                     critic(:),  angle(:),
             148                     !lzl     &                                     cosphi(:),  sinphi(:),
             149                     !lzl     &                                     xstress(:), ystress(:),
             150                     !lzl     &                                     ucltop(:),  vcltop(:),
             151                     !lzl     &                                     wrk(:),
             152                     !lzl     &                                     dlen(:),       gqmcldlen(:)
             153                     !lzl!     real(kind=kind_phys), allocatable :: plnint(:,:),   dpint(:,:),
             154                     !lzl!    &                                     taugwci(:,:),  taugwcxi(:,:),
             155                     !lzl!    &                                     taugwcyi(:,:), bruni(:,:),
             156                     !lzl!    &                                     taugwcyi(:,:), bruni(:,:),
             157                     !lzl      real(kind=kind_phys), allocatable :: plnint(:,:),
             158                     !lzl     &                                     taugwci(:,:),  bruni(:,:),
             159                     !lzl     &                                     rhoi(:,:),     basicui(:,:),
             160                     !lzl     &                                     ti(:,:),       riloc(:,:),
             161                     !lzl     &                                     rimin(:,:),    pint(:,:)
             162                     !lzl!     real(kind=kind_phys), allocatable :: ugwdc(:,:),    vgwdc(:,:),
             163                     !lzl      real(kind=kind_phys), allocatable ::
             164                     !lzl!    &                                     plnmid(:,:),   wtgwc(:,:),
             165                     !lzl     &                                     plnmid(:,:),
             166                     !lzl     &                                     utgwcl(:,:),   vtgwcl(:,:),
             167                     !lzl     &                                     basicum(:,:),  u(:,:),v(:,:),
             168                     !lzl     &                                     t(:,:),        spfh(:,:),
             169                     !lzl     &                                     pmid(:,:),     dpmid(:,:),
             170                     !lzl!    &                                     pmid(:,:),     cumchr(:,:),
             171                     !lzl     &                                     brunm(:,:),    rhom(:,:)
             172                     !lzl!
             173                     !lzl +add -------- ##
             174                           real, allocatable :: tauctxl(:), tauctyl(:),                     &
             175                                  gwdcloc(:), break(:),                                     &
             176                                  critic(:),                                                &
             177                     !    &                                     critic(:),  angle(:),
             178                                  cosphi(:),  sinphi(:),                                    &
             179                                  xstress(:), ystress(:),                                   &
             180                                  ucltop(:),  vcltop(:),                                    &
             181                                  windcltop(:),tmpwindcltop(:),                             &
             182                                  wrk(:),     dtfac(:),                                     &
             183                                  dlen(:),       gqmcldlen(:)
             184                     !     real(kind=kind_phys), allocatable :: plnint(:,:),   dpint(:,:),
             185                     !    &                                     taugwci(:,:),  taugwcxi(:,:),
             186                     !    &                                     taugwcyi(:,:), bruni(:,:),
             187                     !    &                                     taugwcyi(:,:), bruni(:,:),
             188                           real, allocatable :: plnint(:,:), velco(:,:),                    &
             189                                 taugwci(:,:),  bruni(:,:),                                 &
             190                                 rhoi(:,:),     basicui(:,:),                               &
             191                                 ti(:,:),       riloc(:,:),                                 &
             192                                 rimin(:,:),    pint(:,:)
             193                     !     real(kind=kind_phys), allocatable :: ugwdc(:,:),    vgwdc(:,:),
             194                           real, allocatable ::                                             &
             195                     !    &                                     plnmid(:,:),   wtgwc(:,:),
             196                                 plnmid(:,:),   taugw(:,:),                                 &
             197                                 utgwcl(:,:),   vtgwcl(:,:),                                &
             198                                 basicum(:,:),  u(:,:),v(:,:),                              &
             199                                 t(:,:),        spfh(:,:),                                  &
             200                                 pmid(:,:),     dpmid(:,:),                                 &
             201                     !    &                                     pmid(:,:),     cumchr(:,:),
             202                                 brunm(:,:),    rhom(:,:)
             203                     
             204                     !lzl -end -------- ##
             205                     !-----------------------------------------------------------------------
             206                     !
             207                     !  ucltop    : zonal wind at the cloud top ( mid level )
             208                     !  vcltop    : meridional wind at the cloud top ( mid level )
             209                     !  windcltop : wind speed at the cloud top ( mid level )
             210                     !  shear     : vertical shear of basic wind
             211                     !  cosphi    : cosine of angle of wind vector at the cloud top
             212                     !  sinphi    : sine   of angle of wind vector at the cloud top
             213                     !  c1        : tunable parameter
             214                     !  c2        : tunable parameter
             215                     !  dlength   : grid spacing in the direction of basic wind at the cloud top
             216                     !  nonlinct  : nonlinear parameter at the cloud top
             217                     !  nonlin    : nonlinear parameter above the cloud top
             218                     !  nonlins   : saturation nonlinear parameter
             219                     !  taus      : saturation gravity wave drag == taugwci(i,k)
             220                     !  n2        : square of brunt-vaisala frequency
             221                     !  dtdp      : dt/dp
             222                     !  xstress   : vertically integrated zonal momentum change due to gwdc
             223                     !  ystress   : vertically integrated meridional momentum change due to gwdc
             224                     !  crit1     : variable 1 for checking critical level
             225                     !  crit2     : variable 2 for checking critical level
             226                     !
             227                     !-----------------------------------------------------------------------
             228                     
             229                     !lzl      real(kind=kind_phys), parameter ::
             230                     !lzl     &                      c1=1.41,          c2=-0.38,     ricrit=0.25
             231                     !lzl     &,                     n2min=1.e-32,     zero=0.0,     one=1.0
             232                     !lzl     &,                     taumin=1.0e-20,   tauctmax=-5.
             233                     !lzl     &,                     qmin=1.0e-10,     shmin=1.0e-20
             234                     !lzl     &,                     rimax=1.0e+20,    rimaxm=0.99e+20
             235                     !lzl     &,                     rimaxp=1.01e+20,  rilarge=0.9e+20
             236                     !lzl     &,                     riminx=-1.0e+20,  riminm=-1.01e+20
             237                     !lzl     &,                     riminp=-0.99e+20, rismall=-0.9e+20
             238                     !
             239                     !lzl +add -------- ##
             240                           real, parameter ::                                     &
             241                                c1=1.41,          c2=-0.38,     ricrit=0.25,      &
             242                                n2min=1.e-32,     zero=0.0,     one=1.0,          &
             243                     !           taumin=1.0e-20,   tauctmax=-5.,                   &
             244                                taumin=1.0e-20,   tauctmax=-20.,                   &
             245                                qmin=1.0e-10,     shmin=1.0e-20,                  &
             246                                rimax=1.0e+20,    rimaxm=0.99e+20,                &
             247                                rimaxp=1.01e+20,  rilarge=0.9e+20,                &
             248                                riminx=-1.0e+20,  riminm=-1.01e+20,               &
             249                               riminp=-0.99e+20, rismall=-0.9e+20
             250                     !
             251                            iii= 1132
             252                            kkk= 24
             253                     !
             254                     !       if(myrank.eq.0) print*,'inside gwdc '
             255                     
             256                           npt = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipt, kcnv
                                   <<< Loop-information  End >>>
             257     1       2s            do i = 1,im
             258     1       2s              ipt(i) = 0
             259     2       2v              if (kcnv(i) /= 0 .and. qmax(i) > zero) then
             260     2       2m                npt      = npt + 1
             261     2       2s                 ipt(npt) = i
             262     2               !              if(i.eq.iii)then
             263     2               !                print*,' npt = ',npt

             303                     !           write(*,9140) ilev,u1(ipr,ilev),v1(ipr,ilev),t1(ipr,ilev)
             304                     !         enddo
             305                     !
             306                     !         print *,' '
             307                     !         print *,' inside gwdc raw input end print'
             308                     !       endif

                                   <<<      dpmid, pmid, plnmid, spfh, rhom, t, v, u
                                   <<< Loop-information  End >>>
             366     2   p    v              do i=1,npt
             367     2   p    v                ii = ipt(i)
             368     2   p    v                u(i,k)        = u1(ii,k)
             369     2   p    v                v(i,k)        = v1(ii,k)
             370     2   p    v                t(i,k)        = t1(ii,k)
             371     2   p    v                spfh(i,k)     = max(q1(ii,k),qmin)
             372     2   p    v                pmid(i,k)     = pmid1(ii,k)
             373     2   p    v                dpmid(i,k)    = dpmid1(ii,k) * onebg
             374     2               !         cumchr(i,k)   = cumchr1(ii,k)
             375     2               
             376     2   p    v                rhom(i,k)     = pmid(i,k) / (rd*t(i,k)*(1.0+fv*spfh(i,k)))
             377     2   p    v                plnmid(i,k)   = log(pmid(i,k))
             378     2   p    v                utgwcl(i,k)   = zero
             379     2   p    v                vtgwcl(i,k)   = zero
             380     2               !         ugwdc(i,k)    = zero
             381     2               !         vgwdc(i,k)    = zero
             382     2   p    v                brunm(i,k)    = zero
             383     2   p    v                basicum(i,k)  = zero

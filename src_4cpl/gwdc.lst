             590     1  pp    v            do i = 1, npt
             591     1   p    v              kk        = kcldtop(i)
             592     1   p    v              kb        = kcldbot(i)
             593     1   p    v              kcldm     = max(kcldm,kk)
             594     1               
             595     1               !-----------------------------------------------------------------------
             596     1               !
             597     1               !  determine cloud top wind component, direction, and speed.
             598     1               !  here, ucltop, vcltop, and windcltop are wind components and
             599     1               !  wind speed at mid-level cloud top index
             600     1               !
             601     1               !-----------------------------------------------------------------------
             602     1               
             603     1   p    v              ucltop(i) = u(i,kk)
             604     1   p    v              vcltop(i) = v(i,kk)
             605     1               !       windcltop = sqrt( ucltop(i)*ucltop(i) + vcltop(i)*vcltop(i) )
             606     1               !lzl tmp        windcltop = 1.0 / sqrt( ucltop(i)*ucltop(i)                    &
             607     1               !lzl tmp                             + vcltop(i)*vcltop(i) )
             608     1               !
             609     1               !lzl tmp        cosphi(i) = ucltop(i)*windcltop
             610     1               !lzl tmp        sinphi(i) = vcltop(i)*windcltop
             611     1               !
             612     1               !lzl tmp 2        windcltop(i) = 1.0 / sqrt( ucltop(i)*ucltop(i)                 &
             613     1               !lzl tmp 2                             + vcltop(i)*vcltop(i) )
             614     1               !
             615     1   p    v              windcltop(i) = 1.0 / sqrt( ucltop(i)*ucltop(i) + vcltop(i)*vcltop(i) )
             616     1               
             617     1   p    v              cosphi(i) = ucltop(i)*windcltop(i)
             618     1   p    v              sinphi(i) = vcltop(i)*windcltop(i)
             619     1               
             620     1               !       angle(i)  = acos(cosphi)*180./pi
             621     1               !
             622     1   p    v            enddo
             623                     !
             624                     !-----------------------------------------------------------------------
             625                     !
             626                     !  calculate basic state wind projected in the direction of the cloud
             627                     !  top wind.
             628                     !  input u(i,k) and v(i,k) is defined at mid level
             629                     !
             630                     !-----------------------------------------------------------------------
             631                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cosphi, u, v, sinphi, basicum
                                   <<< Loop-information  End >>>
             632     1  pp                 do k=1,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :

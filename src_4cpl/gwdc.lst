                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      basicum, pmid, bruni, rhoi, riloc
                                   <<< Loop-information  End >>>
             686     2   p    v              do i=1,npt
             687     2   p    v                shear = grav*rhoi(i,k) * (basicum(i,k) - basicum(i,k-1))    &
             688     2                                               / (pmid(i,k) - pmid(i,k-1))
             689     3   p    v                if ( abs(shear) < shmin ) then
             690     3   p    v                  riloc(i,k) = rimax
             691     3   p    v                else
             692     3   p    v                  tem = bruni(i,k) / shear
             693     3   p    v                  riloc(i,k)  = tem * tem
             694     3   p    v                  if (riloc(i,k) >= rimax ) riloc(i,k) = rilarge
             695     3   p    v                end if
             696     2   p    v              enddo
             697     1   p                 enddo

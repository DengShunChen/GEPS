             389     2   p    v              do i=1,npt
             390     2   p    v                ii = ipt(i)
             391     2   p    v                pint(i,k)     = pint1(ii,k)
             392     2   p    v                taugwci(i,k)  = zero
             393     2   p    v                bruni(i,k)    = zero

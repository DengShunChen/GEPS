                                   <<< Loop-information  End >>>
             843     2  pp    v              do i=1,npt
             844     3   p    v                if (do_gwc(i)) then
             845     3   p    v                  kk = kcldtop(i)
             846     3   p    v                  if (k > kk) cycle
             847     4   p    v                  if ( k /= 1 ) then
             848     4   p    v                    tem1 = (u(i,k)+u(i,k-1))*0.5
             849     4   p    v                    tem2 = (v(i,k)+v(i,k-1))*0.5
             850     4   p    v                    crit1 = ucltop(i)*tem1
             851     4   p    v                    crit2 = vcltop(i)*tem2
             852     4   p    v                    velco(i,k) = tem1 * cosphi(i) + tem2 * sinphi(i)
             853     4   p    v                  else
             854     4   p    v                    crit1 = ucltop(i)*u(i,1)
             855     4   p    v                    crit2 = vcltop(i)*v(i,1)
             856     4   p    v                    velco(i,1) = u(i,1) * cosphi(i) + v(i,1) * sinphi(i)
             857     4   p    v                  end if
             858     3               
             859     4   p    v                  if ( abs(basicui(i,k)) > zero .and. crit1 > zero          &
             860     4                                                        .and. crit2 > zero ) then
             861     4   p    v                    tem = basicui(i,k) * basicui(i,k)
             862     4   p    v                    nonlin   = gqmcldlen(i) / (bruni(i,k)*ti(i,k)*tem)
             863     4   p    v                    tem  = nonlin*abs(c2)
             864     5   p    v                    if ( riloc(i,k)  <  rimaxm ) then
             865     5   p    v                      tem1 = 1 + tem*sqrt(riloc(i,k))
             866     5   p    v                      rimin(i,k) = riloc(i,k) * (1-tem) / (tem1*tem1)
             867     5   p    v                    else if((riloc(i,k) > rimaxm) .and.                     &
             868     5                                    (riloc(i,k) < rimaxp)) then
             869     5   p    v                      rimin(i,k) = ( 1 - tem) / (tem*tem)
             870     5   p    v                    end if
             871     5   p    v                    if ( rimin(i,k) <= riminx ) then
             872     5   p    v                      rimin(i,k) = rismall
             873     5   p    v                    end if
             874     4   p    v                  else
             875     4   p    v                    rimin(i,k) = riminx
             876     4   p    v                  end if

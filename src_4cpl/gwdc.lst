                                   <<<      do_gwc, kcldtop, taugwci, v, u, vcltop
                                   <<<      cosphi, ucltop, sinphi, riloc, velco
                                   <<<    PREFETCH(SOFT) : 24
                                   <<<     SEQUENTIAL : 24
                                   <<<      u: 2, basicui: 2, ti: 2, bruni: 2
                                   <<<      gqmcldlen: 2, dlen: 2, rimin: 2

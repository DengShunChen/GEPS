             285                     !***********************************************************************
             286                     !
             287                     !  begin gwdc
             288                     !
             289                     !***********************************************************************
             290                     
             291                     !-----------------------------------------------------------------------
             292                     !        write out incoming variables
             293                     !-----------------------------------------------------------------------
             294                           fhourpr = zero
             295                     !     if (lprnt) then
             296                     !       if (fhour >= fhourpr) then

             817                           ' in direction ',f6.2,4x,'kk = ',i2,/)
             818                     !-----------------------------------------------------------------------
             819                     !
             820                     !  at this point, mean wind at the cloud top is larger than zero and
             821                     !  local ri at the cloud top is larger than ricrit (=0.25)
             822                     !
             823                     !  calculate minimum of richardson number including both basic-state
             824                     !  condition and wave effects.
             825                     !
             826                     !          g*q_0*alpha*dx                  ri_loc*(1 - mu*|c2|)
             827                     !  mu  =  ----------------  ri_min =  -----------------------------
             828                     !           c_p*n*t*u^2                (1 + mu*ri_loc^(0.5)*|c2|)^2
             829                     !
             830                     !  minimum ri is calculated for the following two cases
             831                     !
             832                     !  (1)   riloc < 1.e+20
             833                     !  (2)   riloc = 1.e+20  ----> vertically uniform basic-state wind
             834                     !
             835                     !  riloc cannot be smaller than zero because n^2 becomes 1.e-32 in the
             836                     !  case of n^2 < 0.. thus the sign of rinum is determined by
             837                     !  1 - nonlin*|c2|.
             838                     !
             839                     !-----------------------------------------------------------------------
             840                     
             841     1                     do k=kcldm,1,-1
             842     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

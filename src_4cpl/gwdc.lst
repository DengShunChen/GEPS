             431                     !***********************************************************************
             432                     
             433                           pi     = 2.*asin(1.)
             434                     
             435                     !-----------------------------------------------------------------------
             436                     !
             437                     !                              pressure variables
             438                     !
             439                     !  interface 1 ======== pint(1)           *********
             440                     !  mid-level 1 --------          pmid(1)            dpmid(1)
             441                     !            2 ======== pint(2)           dpint(2)
             442                     !            2 --------          pmid(2)            dpmid(2)
             443                     !            3 ======== pint(3)           dpint(3)
             444                     !            3 --------          pmid(3)            dpmid(3)
             445                     !            4 ======== pint(4)           dpint(4)
             446                     !            4 --------          pmid(4)            dpmid(4)
             447                     !              ........
             448                     !           17 ======== pint(17)          dpint(17)
             449                     !           17 --------          pmid(17)           dpmid(17)
             450                     !           18 ======== pint(18)          dpint(18)
             451                     !           18 --------          pmid(18)           dpmid(18)
             452                     !           19 ======== pint(19)          *********
             453                     !
             454                     !-----------------------------------------------------------------------
             455                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 176
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, pint, tauctxl, ti, bruni, spfh, rhoi
                                   <<<      tauctyl
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             456     1  pp    v            do i = 1, npt
             457     1   p    v              tauctxl(i)    = zero
             458     1   p    v              tauctyl(i)    = zero
             459     1               
             460     1               !-----------------------------------------------------------------------
             461     1               !                              thermal variables
             462     1               !
             463     1               !  interface 1 ========       ti(1)           rhoi(1)            bruni(1)
             464     1               !            1 -------- t(1)         rhom(1)           brunm(1)
             465     1               !            2 ========       ti(2)           rhoi(2)            bruni(2)
             466     1               !            2 -------- t(2)         rhom(2)           brunm(2)
             467     1               !            3 ========       ti(3)           rhoi(3)            bruni(3)
             468     1               !            3 -------- t(3)         rhom(3)           brunm(3)
             469     1               !            4 ========       ti(4)           rhoi(4)            bruni(4)
             470     1               !            4 -------- t(4)         rhom(4)           brunm(4)
             471     1               !              ........
             472     1               !           17 ========
             473     1               !           17 -------- t(17)        rhom(17)          brunm(17)
             474     1               !           18 ========       ti(18)          rhoi(18)           bruni(18)
             475     1               !           18 -------- t(18)        rhom(18)          brunm(18)
             476     1               !           19 ========       ti(19)          rhoi(19)           bruni(19)
             477     1               !
             478     1               
             479     1               !
             480     1               !  top interface temperature is calculated assuming an isothermal
             481     1               !  atmosphere above the top mid level.
             482     1               
             483     1   p    v              ti(i,1)    = t(i,1)
             484     1   p    v              rhoi(i,1)  = pint(i,1)/(rd*ti(i,1))
             485     1   p    v              bruni(i,1) = sqrt ( gsqr / (cp*ti(i,1)) )
             486     1               !
             487     1               !  bottom interface temperature is calculated assuming an isothermal
             488     1               !  atmosphere below the bottom mid level
             489     1               
             490     1   p    v              ti(i,km+1)    = t(i,km)
             491     1   p    v              rhoi(i,km+1)  = pint(i,km+1)/(rd*ti(i,km+1)*(1.0+fv*spfh(i,km)))
             492     1   p    v              bruni(i,km+1) = sqrt ( gsqr / (cp*ti(i,km+1)) )
             493     1   p    v            enddo
             494                     
             495                     !-----------------------------------------------------------------------
             496                     !
             497                     !  calculate interface level temperature, density, and brunt-vaisala
             498                     !  frequencies based on linear interpolation of temp in ln(pressure)
             499                     !
             500                     !-----------------------------------------------------------------------
             501                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             502     1  pp                 do k = 2, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plnmid, plnint, t, spfh, pint, pmid
                                   <<<      bruni, rhoi, ti
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             503     2   p    v              do i = 1, npt
             504     2   p    v                tem1 = (plnmid(i,k)-plnint(i,k)) / (plnmid(i,k)-plnmid(i,k-1))
             505     2   p    v                tem2 = one - tem1
             506     2   p    v                ti(i,k)    = t(i,k-1)    * tem1 + t(i,k)    * tem2
             507     2   p    v                qtem       = spfh(i,k-1) * tem1 + spfh(i,k) * tem2
             508     2   p    v                rhoi(i,k)  = pint(i,k) / ( rd * ti(i,k)*(1.0+fv*qtem) )
             509     2   p    v                dtdp       = (t(i,k)-t(i,k-1)) / (pmid(i,k)-pmid(i,k-1))
             510     2   p    v                n2         = gsqr / ti(i,k) * ( 1./cp - rhoi(i,k)*dtdp )
             511     2   p    v                bruni(i,k) = sqrt (max (n2min, n2))
             512     2   p    v              enddo
             513     1   p                 enddo
             514                     
             515                           deallocate (spfh)
             516                     !-----------------------------------------------------------------------
             517                     !
             518                     !  determine the mid-level brunt-vaisala frequencies.
             519                     !             based on interpolated interface temperatures [ ti ]
             520                     !
             521                     !-----------------------------------------------------------------------
             522                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pint, rhom, t, ti, brunm
                                   <<< Loop-information  End >>>
             523     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, pint, rhom, ti, brunm
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             524     2   p    v              do i = 1, npt
             525     2   p    v                dtdp       = (ti(i,k+1)-ti(i,k)) / (pint(i,k+1)-pint(i,k))
             526     2   p    v                n2         = gsqr / t(i,k) * ( 1./cp - rhom(i,k)*dtdp )
             527     2   p    v                brunm(i,k) = sqrt (max (n2min, n2))
             528     2   p    v              enddo
             529     1   p                 enddo

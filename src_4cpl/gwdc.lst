                                   <<< Loop-information  End >>>
             654     2   p    v              do i=1,npt
             655     2   p    v                tem1 = (plnmid(i,k)-plnint(i,k)) / (plnmid(i,k)-plnmid(i,k-1))
             656     2   p    v                tem2 = one - tem1

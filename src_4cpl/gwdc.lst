             902     3               !            5 ========       - 0.001  2.500  2.000
             903     3               !            5 --------                               0.000
             904     3               !            6 ========       - 0.001  1.500  0.110
             905     3               !            6 --------                               +.xxx
             906     3               !            7 ========       - 0.005  2.000  3.000
             907     3               !            7 --------                               0.000
             908     3               !            8 ========       - 0.005  1.000  0.222
             909     3               !            8 --------                               +.xxx
             910     3               !            9 ========       - 0.010  1.000  2.000
             911     3               !            9 --------                               0.000
             912     3               ! kcldtopi  10 ========  $$$  - 0.010
             913     3               ! kcldtop   10 --------  $$$                          yyyyy
             914     3               !           11 ========  $$$  0
             915     3               !           11 --------  $$$
             916     3               !           12 ========  $$$  0
             917     3               !           12 --------  $$$
             918     3               !           13 ========  $$$  0
             919     3               !           13 --------  $$$

             661                     !-----------------------------------------------------------------------
             662                     !
             663                     !  calculate local richardson number
             664                     !
             665                     !  basicum   : u at mid level
             666                     !  basicui   : ui at interface level
             667                     !
             668                     !  interface 1 ========       ui(1)            rhoi(1)  bruni(1)  riloc(1)
             669                     !  mid-level 1 -------- u(1)
             670                     !            2 ========       ui(2)  dpint(2)  rhoi(2)  bruni(2)  riloc(2)
             671                     !            2 -------- u(2)
             672                     !            3 ========       ui(3)  dpint(3)  rhoi(3)  bruni(3)  riloc(3)
             673                     !            3 -------- u(3)
             674                     !            4 ========       ui(4)  dpint(4)  rhoi(4)  bruni(4)  riloc(4)
             675                     !            4 -------- u(4)
             676                     !              ........
             677                     !           17 ========       ui(17) dpint(17) rhoi(17) bruni(17) riloc(17)
             678                     !           17 -------- u(17)
             679                     !           18 ========       ui(18) dpint(18) rhoi(18) bruni(18) riloc(18)
             680                     !           18 -------- u(18)
             681                     !           19 ========       ui(19)           rhoi(19) bruni(19) riloc(19)
             682                     !
             683                     !-----------------------------------------------------------------------
             684                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

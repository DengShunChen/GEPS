             728                     
             729                     !-----------------------------------------------------------------------
             730                     !
             731                     !  calculate gravity wave stress at the interface level cloud top
             732                     !
             733                     !  kcldtopi  : the interface level cloud top index
             734                     !  kcldtop   : the midlevel cloud top index
             735                     !  kcldbot   : the midlevel cloud bottom index
             736                     !
             737                     !  a : find deep convective heating rate maximum
             738                     !
             739                     !      if kcldtop(i) is less than kcldbot(i) in a horizontal grid point,
             740                     !      it can be thought that there is deep convective cloud. however,
             741                     !      deep convective heating between kcldbot and kcldtop is sometimes
             742                     !      zero in spite of kcldtop less than kcldbot. in this case,
             743                     !      maximum deep convective heating is assumed to be 1.e-30.
             744                     !
             745                     !  b : kk is the vertical index for interface level cloud top
             746                     !
             747                     !  c : total convective fractional cover (cldf) is used as the
             748                     !      convective cloud cover for gwdc calculation instead of
             749                     !      convective cloud cover in each layer (concld).
             750                     !                       a1 = cldf*dlength
             751                     !      you can see the difference between cldf(i) and concld(i)
             752                     !      in (4.a.2) in description of the ncar community climate
             753                     !      model (ccm3).
             754                     !      in ncar ccm3, cloud fractional cover in each layer in a deep
             755                     !      cumulus convection is determined assuming total convective
             756                     !      cloud cover is randomly overlapped in each layer in the
             757                     !      cumulus convection.
             758                     !
             759                     !  d : wave stress at cloud top is calculated when the atmosphere
             760                     !      is dynamically stable at the cloud top
             761                     !
             762                     !  e : cloud top wave stress and nonlinear parameter are calculated
             763                     !      using density, temperature, and wind that are defined at mid
             764                     !      level just below the interface level in which cloud top wave
             765                     !      stress is defined.
             766                     !      nonlinct is defined at the interface level.
             767                     !
             768                     !  f : if the atmosphere is dynamically unstable at the cloud top,
             769                     !      gwdc calculation in current horizontal grid is skipped.
             770                     !
             771                     !  g : if mean wind at the cloud top is less than zero, gwdc
             772                     !      calculation in current horizontal grid is skipped.
             773                     !
             774                     !  h : maximum cloud top stress, tauctmax =  -20 n m^(-2),
             775                     !  h : max stress -5 (*j*)5/2015 tauctmax =  - 5 n m^(-2),
             776                     !      in order to prevent numerical instability.
             777                     !
             778                     !-----------------------------------------------------------------------
             779                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 123
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kcldtop, do_gwc
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             780     1  pp    s            do i=1,npt
             781     1   p    v              kk = kcldtop(i)
             782     2   p    m              if ( abs(basicui(i,kk)) > zero .and. riloc(i,kk) > ricrit) then
             783     2               !
             784     2   p    s                tem       = basicum(i,kk)
             785     2   p    s                tem1      = tem * tem
             786     2   p    s                nonlinct  = gqmcldlen(i) / (bruni(i,kk)*t(i,kk)*tem1)    ! mu
             787     2   p    s                tem2      = c2*nonlinct
             788     2               !                                  rhou^3c1(c2mu)^2/ndx
             789     2   p    s                tauct     = - rhom(i,kk) * tem * tem1 * c1 * tem2 * tem2   &
             790     2                                  /  (bruni(i,kk)*dlen(i))
             791     2               
             792     2   p    s                tauct         = max(tauctmax, tauct)
             793     2   p    s                tauctxl(i)    = tauct * cosphi(i)           ! x stress at cloud top
             794     2   p    s                tauctyl(i)    = tauct * sinphi(i)           ! y stress at cloud top
             795     2   p    s                taugwci(i,kk) = tauct                                    !  *1
             796     2   p    s                do_gwc(i)     = .true.
             797     2               !
             798     2   p    s              else
             799     2               !
             800     2   p    s                tauctxl(i) = zero
             801     2   p    s                tauctyl(i) = zero
             802     2   p    s                do_gwc(i) = .false.
             803     2   p    v              end if
             804     1               !
             805     1   p    v            enddo

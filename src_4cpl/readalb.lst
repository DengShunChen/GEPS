             196                     !         print *,'*** alnsf :'
             197                     !         call qmax2d(alnsf,1,1,nx,my)
             198                     !         print *,'*** alnwf :'
             199                     !         call qmax2d(alnwf,1,1,nx,my)
             200                     !         print *,'*** facsf :'
             201                     !         call qmax2d(facsf,1,1,nx,my)
             202                     !         print *,'*** facwf :'
             203                     !         call qmax2d(facwf,1,1,nx,my)
             204                     !     endif
             205                     !
             206                           return
             207                           end


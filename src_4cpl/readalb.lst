               1                           subroutine readalb(bckfile,nx,my,my_max,julian,ggdef,            &
               2                                              alvsf,alvwf,alnsf,alnwf,facsf,facwf)
               3                     !----------------------------------------------------------------
               4                     !
               5                     !  read climt data from data base
               6                     !
               7                     !----------------------------------------------------------------
               8                     !  input :
               9                     !         nx      : dimension of e-w direction
              10                     !         my      : dimension of s-n direction
              11                     !         julian  : julian day
              12                     !
              13                     !  -- 4 months data
              14                     !         alvsfcl : mean vis albedo with strong cosz dependency
              15                     !         alvwfcl : mean vis albedo with weak cosz dependency
              16                     !         alnsfcl : mean nir albedo with strong cosz dependency
              17                     !         alnwfcl : mean nir albedo with weak cosz dependency
              18                     !
              19                     !  output :
              20                     ! -- time intepolation to julian day
              21                     !         alvsf  : mean vis albedo with strong cosz dependency
              22                     !         alvwf  : mean vis albedo with weak cosz dependency
              23                     !         alnsf  : mean nir albedo with strong cosz dependency
              24                     !         alnwf  : mean nir albedo with weak cosz dependency
              25                     !  -- annual mean
              26                     !         facsf   : fractional coverage with strong cosz dependency
              27                     !         facwf   : fractional coverage with weak cosz dependency
              28                     !
              29                     !  By Mei-Yu Chang, 2014/09/07
              30                     !----------------------------------------------------------------
              31                     !
              32                           use rank
              33                           use mpe
              34                           use index
              35                           use physpara  ,only : ialbflg
              36                     
              37                           implicit none
              38                     
              39                           integer nx,my,my_max,julian,ii
              40                     
              41                           real  alvsf(nxp,my_max),alvwf(nxp,my_max), &
              42                                 alnsf(nxp,my_max),alnwf(nxp,my_max), &
              43                                 facsf(nxp,my_max),facwf(nxp,my_max)
              44                     ! local working array
              45                           integer i,j,jj,nxj,lncrec,mm,nn,k,jul,istat
              46                           real    coef1,coef2
              47                           real  alvsfcl(nxp,my_max,2),alvwfcl(nxp,my_max,2),   &
              48                                 alnsfcl(nxp,my_max,2),alnwfcl(nxp,my_max,2)
              49                           real work(nx,my)
              50                     !
              51                           character bckfile*80,lrec*26,blnk*1,ggdef*4
              52                           integer   mon(12),mmse(2),mmax,mmt,mon1(12),mon2(12)
              53                           data mon1/ 74,166,258,349,  0,  0,  0,  0,  0,  0,  0,  0/
              54                           data mon2/ 15, 46, 74,105,135,166,196,227,258,288,319,349/
              55                     
              56     1                     if ( ialbflg .eq. 0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
              57     1   s    v              mon  = mon1
              58     1                       mmax = 4
              59     1                       mmt  = 3
              60     1                     endif
              61                     
              62     1                     if ( ialbflg .eq. 1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
              63     1   s    v              mon  = mon2
              64     1                       mmax = 12
              65     1                       mmt  =  1
              66     1                     endif
              67                     !
              68                           data blnk/' '/
              69                     !
              70                           lncrec=nx*my
              71                     !
              72                           jul=julian
              73                           if(jul .ge. 366)jul=365
              74                     !----------------------------------------------------------------
              75                     !  to interpolat linearly based on julian day
              76                     !
              77                     !-- climate dataset has 12 months
              78                     
              79                           if(jul .le. mon(1))jul=jul+365
              80                     !
              81     1                     if(jul .gt. mon(mmax))then
              82     1                       mmse(1)= mmax * mmt
              83     1                       mmse(2)=    1 * mmt
              84     1                       coef1=float(jul-mon(mmax))/float(365+mon(1)-mon(mmax))
              85     1                       coef2=1.-coef1
              86     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
              87     2   m    m              do k=2,mmax
              88     3   p    m                if(jul .gt. mon(k-1) .and. jul .le. mon(k))then
              89     3   s    v                  mmse(1)= (k-1) * mmt
              90     3   s    v                  mmse(2)=    k  * mmt
              91     3   p    m                  coef1=float(jul-mon(k-1))/float(mon(k)-mon(k-1))
              92     3   p    v                  coef2=1.-coef1
              93     3   p    v                endif
              94     2   p    v              enddo
              95     1                     endif
              96                     !----------------------------------------------------------------
              97                     ! read albedo data
              98                     !----------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mmse
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 21
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              99     1                     do nn=1,2
             100     1                     mm=mmse(nn)
             101     1               
             102     1               
             103     1                     if (ialbflg.eq.0) write(lrec,31)ggdef,mm
             104     1                     if (ialbflg.eq.1) write(lrec,37)ggdef,mm
             105     1                     call dmsread(nx,my,lrec,lncrec,'H',bckfile,work,istat)
             106     1                     call unify_reducepick(nx,my,my_max,work,alvsfcl(1,1,nn))
             107     1               !     call qmax2d(work,1,1,nx,my)
             108     1               
             109     1               
             110     1                     if (ialbflg.eq.0) write(lrec,32)ggdef,mm
             111     1                     if (ialbflg.eq.1) write(lrec,38)ggdef,mm
             112     1                     call dmsread(nx,my,lrec,lncrec,'H',bckfile,work,istat)
             113     1                     call unify_reducepick(nx,my,my_max,work,alvwfcl(1,1,nn))
             114     1               !     call qmax2d(work,1,1,nx,my)
             115     1               
             116     1                     if (ialbflg.eq.0) write(lrec,33)ggdef,mm
             117     1                     if (ialbflg.eq.1) write(lrec,39)ggdef,mm
             118     1                     call dmsread(nx,my,lrec,lncrec,'H',bckfile,work,istat)
             119     1                     call unify_reducepick(nx,my,my_max,work,alnsfcl(1,1,nn))
             120     1               !     call qmax2d(work,1,1,nx,my)
             121     1               
             122     1                     if (ialbflg.eq.0) write(lrec,34)ggdef,mm
             123     1                     if (ialbflg.eq.1) write(lrec,40)ggdef,mm
             124     1                     call dmsread(nx,my,lrec,lncrec,'H',bckfile,work,istat)
             125     1                     call unify_reducepick(nx,my,my_max,work,alnwfcl(1,1,nn))
             126     1               !     call qmax2d(work,1,1,nx,my)
             127     1               
             128     1                     enddo ! end of nn
             129                     !
             130                     !-- facsf (0-100)
             131                     !
             132                           write(lrec,35)ggdef
             133                     !     write(*,*)'35, lrec=',lrec
             134                           call dmsread(nx,my,lrec,lncrec,'H',bckfile,work,istat)
             135                           call unify_reducepick(nx,my,my_max,work,facsf)
             136                     !     call qmax2d(work,1,1,nx,my)
             137                     !
             138                     !-- facwf (0-100)
             139                     !
             140                           write(lrec,36)ggdef
             141                     !     write(*,*)'35, lrec=',lrec
             142                           call dmsread(nx,my,lrec,lncrec,'H',bckfile,work,istat)
             143                           call unify_reducepick(nx,my,my_max,work,facwf)
             144                     !     call qmax2d(work,1,1,nx,my)
             145                     !
             146                     !----------------------------------------------------------------
             147                       31  format('S0003A','GBCK',a4,4x,i2.2,6x)  ! alvsfcl
             148                       32  format('S0003B','GBCK',a4,4x,i2.2,6x)  ! alvwfcl
             149                       33  format('S0003C','GBCK',a4,4x,i2.2,6x)  ! alnsfcl
             150                       34  format('S0003D','GBCK',a4,4x,i2.2,6x)  ! alnwfcl
             151                       35  format('S0003E','GBCK',a4,12x)         ! facsf
             152                       36  format('S0003F','GBCK',a4,12x)         ! facwf
             153                       37  format('S00X3A','GBCK',a4,4x,i2.2,6x)  ! alvsfcl
             154                       38  format('S00X3B','GBCK',a4,4x,i2.2,6x)  ! alvwfcl
             155                       39  format('S00X3C','GBCK',a4,4x,i2.2,6x)  ! alnsfcl
             156                       40  format('S00X3D','GBCK',a4,4x,i2.2,6x)  ! alnwfcl
             157                     !----------------------------------------------------------------
             158                     
             159                     !
             160                     !---  time interpolation
             161                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      alnwfcl, alnsfcl, alvwfcl, alvsfcl
                                   <<<      alnwf, alnsf, alvwf, alvsf
                                   <<< Loop-information  End >>>
             162     1  pp                 do jj=1,jlistnum
             163     1   p                    j=jlist1(jj)
             164     1   p                    nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      alnsfcl, alnwf, alnsf, alnwfcl, alvwfcl
                                   <<<      alvsfcl, alvwf, alvsf
                                   <<< Loop-information  End >>>
             165     2   p    v            do i=1,nxj
             166     2   p    v               alvsf(i,jj)=coef1*alvsfcl(i,jj,1)+coef2*alvsfcl(i,jj,2)
             167     2   p    v               alvwf(i,jj)=coef1*alvwfcl(i,jj,1)+coef2*alvwfcl(i,jj,2)
             168     2   p    v               alnsf(i,jj)=coef1*alnsfcl(i,jj,1)+coef2*alnsfcl(i,jj,2)
             169     2   p    v               alnwf(i,jj)=coef1*alnwfcl(i,jj,1)+coef2*alnwfcl(i,jj,2)
             170     2   p    v            enddo
             171     1   p                 enddo
             172                     
             173                     !
             174                     !---  unit change
             175                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      facsf, alvwf, alnwf, alvsf, alnsf, facwf
                                   <<< Loop-information  End >>>
             176     1  pp                 do jj=1,jlistnum
             177     1   p                   j=jlist1(jj)
             178     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.77, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      facsf, alvwf, alnwf, alvsf, alnsf, facwf
                                   <<< Loop-information  End >>>
             179     2   p    v              do i=1,nxj
             180     2   p    v                alvsf(i,jj)=alvsf(i,jj)*0.01
             181     2   p    v                alvwf(i,jj)=alvwf(i,jj)*0.01
             182     2   p    v                alnsf(i,jj)=alnsf(i,jj)*0.01
             183     2   p    v                alnwf(i,jj)=alnwf(i,jj)*0.01
             184     2   p    v                facsf(i,jj)=facsf(i,jj)*0.01
             185     2   p    v                facwf(i,jj)=facwf(i,jj)*0.01
             186     2   p    v              enddo
             187     1   p                 enddo
             188                     
             189                     !     if (myrank .eq. 0) then
             190                     !         print *,'*** for readalb.f ***'
             191                     !         print *,'julian :',julian
             192                     !         print *,'*** alvsf :'
             193                     !         call qmax2d(alvsf,1,1,nx,my)
             194                     !         print *,'*** alvwf :'

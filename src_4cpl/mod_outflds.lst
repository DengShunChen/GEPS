             764                       subroutine tempout(nx,my,my_max,lpout,lev,itau,ifilout,idtg  &
             765                           , plev,num,whtlev,pkout,pk,pklp,tt,ttbot,temp,ggdef,lwrite)
             766                     !
             767                           use index
             768                           use rank,   only : myrank
             769                           use mod_grb2_param
             770                           use const ,only:outdms,outgrb2 ,RTYPE,kflag
             771                     
             772                           implicit  none
             773                     
             774                           integer   nx,my,my_max,lpout,lev,itau,k,i,n,istat
             775                           integer   num,lpl,lenc,ncnt
             776                           real      tnshun
             777                     
             778                           real      pkout(lpout),pklp(nxp,my_max),pk(nxp,lev,my_max)        &
             779                           , tt(nxp,lev,my_max),ttbot(nxp,my_max),plev(lpout),whtlev(num)
             780                           real      tens(lev+1)
             781                           real(kind=RTYPE) pout(nx,my),glob(nx,my),slp(nx,my),temp(nxp,my_max,lpout)
             782                     
             783                     !
             784                           integer*8 idtg
             785                           character*80 ifilout
             786                           character*26 ihdg
             787                           character*26 ihdg2
             788                           character*6 lrec(lpout)
             789                           character*4 ggdef
             790                     !
             791                          logical :: lwrite
             792                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             793     1  pp   4v            do k = 1, lev+1
             794     1   p   4v             tens(k) = 1.0
             795     1   p   4v            end do
             796                           tens(lev+1)= 0.0
             797                           tens(lev)= 0.0
             798                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             799     1   m   2v            do k = 1, lpout-1
             800     1   p   2v             lpl = int(plev(k)+0.001)
             801     1   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'100'
             802     1   p   2v            end do
             803                           lrec(lpout) = 'h00100'
             804                     !
             805                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,tt,ttbot,pkout,temp,tens)
             806                     !
             807                           lenc= nx*my
             808                     !
             809                           tnshun= 1.0
             810                     !
             811                           ncnt=0
             812                     !
             813     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             814     2                     do 10 k=1,lpout
             815     2               !
             816     3                     if(plev(k).eq.whtlev(n)) then
             817     3               !
             818     3               !
             819     3                     call unify_reduceintp(nx,my,my_max,temp(1,1,k),glob)
             820     3               !!      do 11 i=1,lenc
             821     3               !!      glob(i,1)= temp(i,k)
             822     3               !!   11 continue
             823     3               !
             824     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             825     3               !
             826     3               !  reduceintp has been done in voterp (2011/5)
             827     3               !
             828     3                       call smth9(nx,my,glob,slp,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, glob
                                   <<< Loop-information  End >>>
             829     3  pp   4v              glob=slp
             830     3                       call smth9(nx,my,glob,slp,2)
             831     3               !!        glob=slp
             832     3               !
             833     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             834     4                     if(outgrb2==1.and.myrank==0)then
             835     4                       call wrt_grb2(itau,0,0,0,2,100,-2,plev(k),slp)
             836     4                     endif
             837     3               
             838     3                     call qmaxn3(slp,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             839     3                     call split(nx,my,lenc,ifilout,ncnt,slp,pout,ihdg,ihdg2)
             840     3                     go to 30
             841     3                     endif
             842     2                  10 continue
             843     1                  30 continue
             844     1                     if(outdms.gt.0)then
             845     1                     if(lwrite .and. myrank .lt. ncnt ) &
             846     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             847     1                     endif
             848                     !
             849                           return
             850                       end subroutine tempout

             643                       subroutine surfout(nx,my,my_max,ifilout,itau,idtg,taudir,ntau,pdiff  &
             644                            ,pt,ptop,slp,ptend,glob,ggdef,lwrite)
             645                     !
             646                           use index
             647                           use mpe
             648                           use rank
             649                           use mod_grb2_param
             650                           use const ,only:outdms,outgrb2 ,RTYPE,kflag ,domfc
             651                     !
             652                           implicit  none
             653                           integer   nx,my,my_max,i,j,jj,kk,n,lev,nxj,itau,ntau,num,lenc,istat
             654                     
             655                           real      pdiff(nxp,my_max)
             656                           real(kind=RTYPE) ptend(nxp,my_max),pt(nxp,my_max),glob(nx,my),   &
             657                                            slp(nxp,my_max),tmp(nxp,my_max)
             658                           character*16 taudir(ntau)
             659                           character*4 ggdef
             660                     !
             661                           real      ptop,tnshun
             662                     !
             663                           integer*8 idtg
             664                           character*80 ifilout
             665                           character*26 lrec
             666                           character*6 label(ntau),labx
             667                     
             668                           logical :: lwrite
             669                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptend, pt, pdiff, slp
                                   <<< Loop-information  End >>>
             670     1  pp                 do jj = 1, jlistnum
             671     1   p                   j=jlist1(jj)
             672     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, ptend, pdiff, pt
                                   <<< Loop-information  End >>>
             673     2   p   2v              do i=1,nxj
             674     2               !byl          slp(i,j)= pt(i,jj)+pdiff(i,jj)
             675     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             676     2   p   2v                ptend(i,jj)= ptend(i,jj)*3600.0
             677     2   p   2v              enddo
             678     1   p                 enddo
             679                     !
             680                     !byl      call unify_reduceintp(nx,my,my_max,tmp,slp)
             681                     !byl      call mpe_unify(slp,nx,my,2,mpe_double)
             682                     !byl      if( lreduce.eq.1 ) call reduceintp (slp,nxdef,nx,my)
             683                     !byl      call smth9(nx,my,slp,glob,1)
             684                     !byl      slp=glob
             685                     !byl      call smth9(nx,my,slp,glob,2)
             686                     !byl      slp=glob
             687                     !
             688                           num= 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             689     1                     do 20 n=1,ntau
             690     1                       read(taudir(n),'(a6,1x,i4)') labx,lev
             691     2                       if(lev.eq.0) then
             692     2                         num= num+1
             693     2                         label(num)= labx
             694     2                       endif
             695     1                  20 continue
             696                           if(num.eq.0) return
             697                     !
             698                           tnshun= 1.0
             699                           lenc= nx*my
             700                     !
             701     1                     do 100 kk=1,num
             702     1               !
             703     1               !  sea surface level pressure
             704     1               !
             705     1               
             706     2                     if(label(kk).eq.'SSL010' .or. label(kk).eq.'ssl010') then
             707     2                       call unify_reduceintp(nx,my,my_max,slp,glob)
             708     2                       call syslbl('ssl010',idtg,itau,ggdef,lrec)
             709     3                       if( itau==0 .or. itau .gt. nint(domfc) )then
             710     4                       if(outdms.gt.0)then
             711     4                         if(lwrite) call dmswrit(nx,my,lrec,lenc,kflag,ifilout,glob,istat)
             712     4                       endif
             713     4                       if(outgrb2==1.and.myrank==0)then
             714     4                         call wrt_grb2(itau,0,3,1,2,101,0,0.,glob)
             715     4                       endif
             716     3                       call qmaxn3(glob,lrec(1:14),lrec(15:26),1,1,1,nx,my,1)
             717     3                       endif !itau .gt. domfc
             718     2               !
             719     2               !  terrain pressure
             720     2               !
             721     2                     else if(label(kk).eq.'B00010' .or. label(kk).eq.'b00010') then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, tmp
                                   <<< Loop-information  End >>>
             722     3  pp                   do jj = 1, jlistnum
             723     3   p                     j=jlist1(jj)
             724     3   p                     nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, tmp
                                   <<< Loop-information  End >>>
             725     4   p   2v                do i=1,nxj
             726     4               !byl            glob(i,j) = pt(i,jj) + ptop
             727     4   p   2v                  tmp(i,jj) = pt(i,jj) + ptop
             728     4   p   2v                enddo
             729     3   p                   enddo
             730     2                       call unify_reduceintp(nx,my,my_max,tmp,glob)
             731     2               !     if(myrank.eq.0) then
             732     2               !       open(30,file='sfc_pres.bin',status='unknown', &
             733     2               !           form='unformatted',access='direct',recl=262656)
             734     2               !       write(30,rec=1) ((glob(i,j),i=432,647),j=410,561)
             735     2               !       close(30)
             736     2               !     endif
             737     2               !byl        call mpe_unify(glob,nx,my,2,mpe_double)
             738     2                       call syslbl('b00010',idtg,itau,ggdef,lrec)
             739     2               !byl        if( lreduce.eq.1 ) call reduceintp (glob,nxdef,nx,my)
             740     2                       if(lwrite) call dmswrit(nx,my,lrec,lenc,kflag,ifilout,glob,istat)
             741     3                       if(outgrb2==1.and.myrank==0)then
             742     3                         call wrt_grb2(itau,0,3,0,2,103,0,0.,glob)
             743     3                       endif
             744     2                       call qmaxn3(glob,lrec(1:14),lrec(15:26),1,1,1,nx,my,1)
             745     2               
             746     2               !
             747     2               !  terrain pressure tendency
             748     2               !
             749     2               !      else if(label(kk).eq.'B00011' .or. label(kk).eq.'b00011') then
             750     2               !        do i = 1, lenc
             751     2               !          glob(i,1) = ptend(i,1)
             752     2               !        end do
             753     2               !        call syslbl('b00011',idtg,itau,ggdef,lrec)
             754     2               !        if( lreduce.eq.1 ) call reduceintp (glob,nxdef,nx,my)
             755     2               !        if(lwrite) call dmswrit(nx,my,lrec,lenc,kflag,ifilout,glob,istat)
             756     2               !        call qmaxn3(glob,lrec(1:14),lrec(15:26),1,1,1,nx,my,1)
             757     2               !
             758     2                     endif
             759     1               !
             760     1                 100 continue
             761                           return
             762                       end subroutine surfout

             561                       subroutine cloudout(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             562                           , plev,num,whtlev,pkout,pk,pklp,clds,cldb,cldfc,glob,ggdef,lwrite)
             563                     !
             564                           use index
             565                           use rank, only : myrank
             566                           use param, only : ncld
             567                           use mod_grb2_param
             568                           use const ,only:outdms,outgrb2 , RTYPE,kflag
             569                     
             570                           implicit  none
             571                     
             572                           integer   nx,my,my_max,lpout,lev,itau,num,ntrac,ncnt,ntrchk
             573                     
             574                           real      pkout(lpout),pklp(nxp,my_max)                        &
             575                           , pk(nxp,lev,my_max),clds(nxp,lev,my_max),cldb(nxp,my_max)      &
             576                           , plev(lpout),whtlev(num),tens(lev+1)
             577                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)       &
             578                           , cldfc(nxp,my_max,lpout),ffx(nx,my_max)
             579                     !
             580                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             581                     
             582                           integer*8 idtg
             583                           character*80 ifilout
             584                           character*26 ihdg,ihdg2
             585                           character*6 lrec(lpout)
             586                           character*4 ggdef
             587                           logical :: lwrite
             588                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             589     1  pp   4v            do k = 1, lev+1
             590     1   p   4v             tens(k) = 1.0
             591     1   p   4v            end do
             592                           tens(lev)= 0.0
             593                           tens(lev+1)= 0.0
             594                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             595     1   m   2v            do k = 1, lpout-1
             596     1   p   2v             lpl = int(plev(k)+0.001)
             597     1   m   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'770'
             598     1   p   2v            end do
             599                           lrec(lpout) = 'h00770'
             600                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,clds,cldb,pkout,cldfc,tens)
             601                     !
             602                           lenc= nx*my
             603                           ncnt= 0
             604                     !
             605                           !for debug
             606                           !num=12
             607                           !whtlev(1:12)=(/100.,150.,200.,250.,300.,400.,500.,600.,700.,850.,925.,1000./)
             608     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             609     2                     do 10 k=1,lpout
             610     2               !
             611     3                     if(plev(k).eq.whtlev(n)) then
             612     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfc, tmp
                                   <<< Loop-information  End >>>
             613     4  pp                 do 11 jj=1, jlistnum
             614     4   p                 j=jlist1(jj)
             615     4   p                 nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfc, tmp
                                   <<< Loop-information  End >>>
             616     5   p   2v            do 11 i=1,nxj
             617     5   p   2v             tmp(i,jj)= cldfc(i,jj,k)
             618     4   p   2v         11 continue
             619     3                     call unify_reduceintp(nx,my,my_max,tmp,glob)
             620     3               
             621     4                     if(outgrb2==1.and.myrank==0)then
             622     4                         call wrt_grb2(itau,0,6,32,3,100,-2,plev(k),glob)   !cloud fraction
             623     4                     endif
             624     3               !
             625     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             626     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             627     3                     call split(nx,my,lenc,ifilout,ncnt,glob,pout,ihdg,ihdg2)
             628     3                     go to 30
             629     3                     endif
             630     2                  10 continue
             631     1                  30 continue
             632     1                     if(outdms.gt.0)then
             633     1                     if(lwrite .and. myrank .lt. ncnt ) &
             634     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             635     1                     endif
             636                     !
             637                        40 continue
             638                     
             639                           return
             640                       end subroutine cloudout

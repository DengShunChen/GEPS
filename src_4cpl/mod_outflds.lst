             852                       subroutine vortout(nx,my,my_max,lpout,lev,itau,ifilout,idtg     &
             853                           , plev,num,whtlev,pkout,pk,pklp,rvor,rvorb,vor,ggdef,v850,v700,lwrite)
             854                     !
             855                           use index
             856                           use rank, only : myrank
             857                           use mod_grb2_param
             858                           use const ,only:outdms,outgrb2 , RTYPE,kflag
             859                     
             860                           implicit  none
             861                     
             862                           integer   nx,my,my_max,lpout,lev,itau,num,ncnt
             863                     
             864                           real      pkout(lpout),pklp(nxp,my_max)                        &
             865                           , pk(nxp,lev,my_max),work3d(nxp,lev,my_max),rvorb(nxp,my_max)  &
             866                           , plev(lpout),whtlev(num)
             867                           real(kind=RTYPE) rvor(nxp,lev,my_max),vor(nxp,my_max,lpout)
             868                           real      tens(lev+1)
             869                           real(kind=RTYPE) v850(nxp,my_max),v700(nxp,my_max)
             870                           real(kind=RTYPE) wk1(nx,my),pout(nx,my)
             871                     
             872                     !
             873                           integer*8 idtg
             874                           character*80 ifilout
             875                           character*26 ihdg,ihdg2
             876                           character*6 lrec(lpout)
             877                           character*4 ggdef
             878                     
             879                           integer   k,lpl,lenc,i,n,istat,jj,j,nxj
             880                     !
             881                           logical :: lwrite
             882                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             883     1  pp   4v            do k = 1, lev+1
             884     1   p   4v             tens(k) = 1.0
             885     1   p   4v            end do
             886                           tens(lev)= 0.0
             887                           tens(lev+1)= 0.0
             888                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             889     1   m   2v            do k = 1, lpout-1
             890     1   p   2v             lpl = int(plev(k)+0.001)
             891     1   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'240'
             892     1   p   2v            end do
             893                           lrec(lpout) = 'h00240'
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2

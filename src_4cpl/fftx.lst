             392                           ENDIF
             393                           IF (isign.eq.1) THEN
             394                             y(1)=x(1)
             395                             DO i=2,n
             396                               y(i)=x(i+1)
             397                             ENDDO
             398                             CALL rfftb(n,y,table)
             399                             DO i=1,n

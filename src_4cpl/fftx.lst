             170                     !IBM-TWN   subroutine fft991(a,work,trigs,ifax,inc,jump,n,m,isign)
             171                           subroutine rfftmlt(a,work,trigs,ifax,inc,jump,n,m,isign)
             172                     
             173                     !     *******************************************************
             174                     !     *****   Sept 1995 - Zaphiris Christidis, IBM Res  *****
             175                     !     *******************************************************
             176                     !     *******************************************************
             177                     !     ****   Modified by Zhan Zhang, Met. FSU, Aug. 1996  ***
             178                     !     *******************************************************
             179                     !
             180                     !     *******************************************************
             181                     !     ****   Modified by IBM-TWN for CWB Aug. 2011        ***
             182                     !     *******************************************************
             183                     !
             184                     
             185                           Real*8 a,trigs,work,scale
             186                           DIMENSION A(*),WORK(N+2,M),TRIGS(*),IFAX(1)
             187                     !
             188                     !  ESSL fft wrapper routine.
             189                     !  Common containing fourier transform paramters for ESSL routines
             190                     !
             191                     !        parameter (naux1=2156,naux2=772)
             192                     !CWB2014
             193                     !       parameter (naux1=22000,naux2=20000)
             194                             parameter (naux1=44002,naux2=20000)
             195                             real*8 aux1(naux1),aux2(naux2),aux3(1)
             196                             common/ibmfft/aux1,aux2,aux3,ibmn,ibmm,ibmtype
             197                     !CWB    save /ibmfft/
             198                     !  2012-11-02 >>>
             199                     !$omp threadprivate(/ibmfft/)
             200                     !  2012-11-02 <<<
             201                     !
             202                     !--   Stride (jump) is a even number .......
             203                     !
             204                           if(mod(jump,2).eq.0) then
             205                              jump2=jump/2
             206                              if(isign.eq.1) then
             207                                 scale=1.0
             208                                 ibmsign=-1
             209                                 if(isign.ne.ibmtype.or.m.ne.ibmm.or.n.ne.ibmn) then
             210                     !
             211                     !     compute twiddle factors and save them. Never call it again.
             212                     !
             213                                    call dcrft(1,a,jump2,a,jump,n,m,ibmsign,scale,   &
             214                                               aux1,naux1,aux2,naux2,aux3,0)
             215                                    ibmn=n
             216                                    ibmm=m
             217                                    ibmtype=isign
             218                                 end if
             219                                 call dcrft(0,a,jump2,a,jump,n,m,ibmsign,scale,      &
             220                                            aux1,naux1,aux2,naux2,aux3,0)
             221                     !
             222                     !--    Initialize data for consistency with fft991
             223                     !
             224                                 ib=n*inc+1
             225                                 do i=1,m
             226                                    a(ib)=0.0
             227                                    a(ib+inc)=0.0
             228                                    ib=ib+jump
             229                                 end do
             230                              else
             231                                 scale=1.0/dfloat(n)
             232                                 ibmsign=1
             233                                 if(isign.ne.ibmtype.or.m.ne.ibmm.or.n.ne.ibmn) then
             234                     !
             235                     !     compute twiddle factors and save them. Never call it again.
             236                     !
             237                                    call drcft(1,a,jump,a,jump2,n,m,ibmsign,scale,    &
             238                                               aux1,naux1,aux2,naux2,aux3,0)
             239                                    ibmn=n
             240                                    ibmm=m
             241                                    ibmtype=isign
             242                                 end if
             243                     
             244                                 call drcft(0,a,jump,a,jump2,n,m,ibmsign,scale,       &
             245                                            aux1,naux1,aux2,naux2,aux3,0)
             246                              end if
             247                     !
             248                     !--   Stride (jump) is an odd number .......
             249                     !
             250                           else
             251                              jump2=(n/2)+1
             252                     
             253                              if(isign.eq.1) then
             254                                 scale=1.0
             255                                 ibmsign=-1
             256                     !
             257                     !---  Swap the data from a to work, while jump is an odd number
             258                     !
             259                                 i2=1
             260                                 do i=1,m
             261                                    do j=1,n+2
             262                                       work(j,i)=a(i2)
             263                                       i2=i2+1
             264                                    end do
             265                                    i2=jump*i+1
             266                                 end do
             267                     !
             268                                 if(isign.ne.ibmtype.or.m.ne.ibmm.or.n.ne.ibmn) then
             269                     !
             270                     !     compute twiddle factors and save them. Never call it again.
             271                     !
             272                                    call dcrft(1,work,jump2,a,jump,n,m,ibmsign,scale,    &
             273                                               aux1,naux1,aux2,naux2,aux3,0)
             274                                    ibmn=n
             275                                    ibmm=m
             276                                    ibmtype=isign
             277                                 end if
             278                     
             279                                 call dcrft(0,work,jump2,a,jump,n,m,ibmsign,scale,       &
             280                                            aux1,naux1,aux2,naux2,aux3,0)
             281                     
             282                              else
             283                                 scale=1.0/dfloat(n)
             284                                 ibmsign=+1
             285                                 if(isign.ne.ibmtype.or.m.ne.ibmm.or.n.ne.ibmn) then
             286                     !
             287                     !     compute twiddle factors and save them. Never call it again.
             288                     !
             289                                    call drcft(1,a,jump,work,jump2,n,m,ibmsign,scale,    &
             290                                               aux1,naux1,aux2,naux2,aux3,0)
             291                                    ibmn=n
             292                                    ibmm=m
             293                                    ibmtype=isign
             294                                 end if
             295                     
             296                                 call drcft(0,a,jump,work,jump2,n,m,ibmsign,scale,       &
             297                                            aux1,naux1,aux2,naux2,aux3,0)
             298                     !
             299                     !---  Swap the data from work to a
             300                     !
             301                                 i2=1
             302                                 do i=1,m
             303                                    do j=1,n+2
             304                                       a(i2)=work(j,i)
             305                                       i2=i2+1
             306                                    end do
             307                                    i2=jump*i+1
             308                                 end do
             309                              end if
             310                           end if
             311                     
             312                           return
             313                           end

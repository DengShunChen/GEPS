             384                           SUBROUTINE csfft(isign,n,scale,x,y,table,work,isys)
             385                     
             386                           implicit none
             387                           integer isign,n,isys,i
             388                           real scale,x(*),y(*),table(*),work(*)
             389                     
             390                           IF (isign.eq.0) THEN

             471                           SUBROUTINE scfft(isign,n,scale,x,y,table,work,isys)
             472                     
             473                           implicit none
             474                           integer isign,n,isys,i
             475                           real scale,x(*),y(*),table(*),work(*)
             476                     
             477                           IF (isign.eq.0) THEN
             478                             CALL rffti(n,table)
             479                           ENDIF
             480                           IF (isign.eq.-1) THEN
             481                             DO i=1,n
             482                               y(i)=x(i)
             483                             ENDDO
             484                             CALL rfftf(n,y,table)
             485                             DO i=1,n
             486                               y(i)=scale*y(i)
             487                             ENDDO
             488                             DO i=n,2,-1
             489                               y(i+1)=y(i)
             490                             ENDDO
             491                             y(2)=0.
             492                           ENDIF
             493                     
             494                           RETURN
             495                           END
             496                     !
             497                     !     ******************************************************************
             498                     !     ******************************************************************
             499                     !     ******                                                      ******
             500                     !     ******                        FFTPACK                       ******
             501                     !     ******                                                      ******
             502                     !     ******************************************************************
             503                     !     ******************************************************************
             504                     !
             505                           SUBROUTINE RFFTF (N,R,WSAVE)
             506                           DIMENSION       R(1)       ,WSAVE(1)
             507                           IF (N .EQ. 1) RETURN
             508                           CALL RFFTF1 (N,R,WSAVE,WSAVE(N+1),WSAVE(2*N+1))
             509                           RETURN
             510                           END
             511                           SUBROUTINE RFFTB (N,R,WSAVE)
             512                           DIMENSION       R(1)       ,WSAVE(1)
             513                           IF (N .EQ. 1) RETURN
             514                           CALL RFFTB1 (N,R,WSAVE,WSAVE(N+1),WSAVE(2*N+1))
             515                           RETURN
             516                           END
             517                           SUBROUTINE RFFTI (N,WSAVE)
             518                           DIMENSION       WSAVE(1)
             519                           IF (N .EQ. 1) RETURN
             520                           CALL RFFTI1 (N,WSAVE(N+1),WSAVE(2*N+1))
             521                           RETURN
             522                           END
             523                           SUBROUTINE RFFTB1 (N,C,CH,WA,IFAC)
             524                     !CWB2014
             525                     !     DIMENSION       CH(1)      ,C(1)       ,WA(1)      ,IFAC(*)
             526                           DIMENSION       CH(1)      ,C(1)       ,WA(1)
             527                           real*8                                              IFAC(*)
             528                     
             529                           NF = IFAC(2)
             530                           NA = 0
             531                           L1 = 1
             532                           IW = 1
             533                           DO 116 K1=1,NF
             534                              IP = IFAC(K1+2)
             535                              L2 = IP*L1
             536                              IDO = N/L2
             537                              IDL1 = IDO*L1
             538                              IF (IP .NE. 4) GO TO 103
             539                              IX2 = IW+IDO
             540                              IX3 = IX2+IDO
             541                              IF (NA .NE. 0) GO TO 101
             542                              CALL RADB4 (IDO,L1,C,CH,WA(IW),WA(IX2),WA(IX3))
             543                              GO TO 102
             544                       101    CALL RADB4 (IDO,L1,CH,C,WA(IW),WA(IX2),WA(IX3))
             545                       102    NA = 1-NA
             546                              GO TO 115
             547                       103    IF (IP .NE. 2) GO TO 106
             548                              IF (NA .NE. 0) GO TO 104
             549                              CALL RADB2 (IDO,L1,C,CH,WA(IW))
             550                              GO TO 105
             551                       104    CALL RADB2 (IDO,L1,CH,C,WA(IW))
             552                       105    NA = 1-NA
             553                              GO TO 115
             554                       106    IF (IP .NE. 3) GO TO 109
             555                              IX2 = IW+IDO
             556                              IF (NA .NE. 0) GO TO 107
             557                              CALL RADB3 (IDO,L1,C,CH,WA(IW),WA(IX2))
             558                              GO TO 108
             559                       107    CALL RADB3 (IDO,L1,CH,C,WA(IW),WA(IX2))
             560                       108    NA = 1-NA
             561                              GO TO 115
             562                       109    IF (IP .NE. 5) GO TO 112
             563                              IX2 = IW+IDO
             564                              IX3 = IX2+IDO
             565                              IX4 = IX3+IDO
             566                              IF (NA .NE. 0) GO TO 110
             567                              CALL RADB5 (IDO,L1,C,CH,WA(IW),WA(IX2),WA(IX3),WA(IX4))
             568                              GO TO 111
             569                       110    CALL RADB5 (IDO,L1,CH,C,WA(IW),WA(IX2),WA(IX3),WA(IX4))
             570                       111    NA = 1-NA
             571                              GO TO 115
             572                       112    IF (NA .NE. 0) GO TO 113
             573                              CALL RADBG (IDO,IP,L1,IDL1,C,C,C,CH,CH,WA(IW))
             574                              GO TO 114
             575                       113    CALL RADBG (IDO,IP,L1,IDL1,CH,CH,CH,C,C,WA(IW))
             576                       114    IF (IDO .EQ. 1) NA = 1-NA
             577                       115    L1 = L2
             578                              IW = IW+(IP-1)*IDO
             579                       116 CONTINUE
             580                           IF (NA .EQ. 0) RETURN
             581                           DO 117 I=1,N
             582                              C(I) = CH(I)
             583                       117 CONTINUE
             584                           RETURN
             585                           END
             586                     
             587                     
             588                           SUBROUTINE RFFTF1 (N,C,CH,WA,IFAC)
             589                     !CWB2014
             590                     !     DIMENSION       CH(1)      ,C(1)       ,WA(1)      ,IFAC(*)
             591                           DIMENSION       CH(1)      ,C(1)       ,WA(1)
             592                           real*8                                              IFAC(*)
             593                     
             594                           NF = IFAC(2)
             595                           NA = 1
             596                           L2 = N
             597                           IW = N
             598                           DO 111 K1=1,NF
             599                              KH = NF-K1
             600                              IP = IFAC(KH+3)
             601                              L1 = L2/IP
             602                              IDO = N/L2
             603                              IDL1 = IDO*L1
             604                              IW = IW-(IP-1)*IDO
             605                              NA = 1-NA
             606                              IF (IP .NE. 4) GO TO 102
             607                              IX2 = IW+IDO
             608                              IX3 = IX2+IDO
             609                              IF (NA .NE. 0) GO TO 101
             610                              CALL RADF4 (IDO,L1,C,CH,WA(IW),WA(IX2),WA(IX3))
             611                              GO TO 110
             612                       101    CALL RADF4 (IDO,L1,CH,C,WA(IW),WA(IX2),WA(IX3))
             613                              GO TO 110
             614                       102    IF (IP .NE. 2) GO TO 104
             615                              IF (NA .NE. 0) GO TO 103
             616                              CALL RADF2 (IDO,L1,C,CH,WA(IW))
             617                              GO TO 110
             618                       103    CALL RADF2 (IDO,L1,CH,C,WA(IW))
             619                              GO TO 110
             620                       104    IF (IP .NE. 3) GO TO 106
             621                              IX2 = IW+IDO
             622                              IF (NA .NE. 0) GO TO 105
             623                              CALL RADF3 (IDO,L1,C,CH,WA(IW),WA(IX2))
             624                              GO TO 110
             625                       105    CALL RADF3 (IDO,L1,CH,C,WA(IW),WA(IX2))
             626                              GO TO 110
             627                       106    IF (IP .NE. 5) GO TO 108
             628                              IX2 = IW+IDO
             629                              IX3 = IX2+IDO
             630                              IX4 = IX3+IDO
             631                              IF (NA .NE. 0) GO TO 107
             632                              CALL RADF5 (IDO,L1,C,CH,WA(IW),WA(IX2),WA(IX3),WA(IX4))
             633                              GO TO 110
             634                       107    CALL RADF5 (IDO,L1,CH,C,WA(IW),WA(IX2),WA(IX3),WA(IX4))
             635                              GO TO 110
             636                       108    IF (IDO .EQ. 1) NA = 1-NA
             637                              IF (NA .NE. 0) GO TO 109
             638                              CALL RADFG (IDO,IP,L1,IDL1,C,C,C,CH,CH,WA(IW))
             639                              NA = 1
             640                              GO TO 110
             641                       109    CALL RADFG (IDO,IP,L1,IDL1,CH,CH,CH,C,C,WA(IW))
             642                              NA = 0
             643                       110    L2 = L1
             644                       111 CONTINUE
             645                           IF (NA .EQ. 1) RETURN
             646                           DO 112 I=1,N
             647                              C(I) = CH(I)
             648                       112 CONTINUE
             649                           RETURN
             650                           END
             651                     
             652                     
             653                           SUBROUTINE RFFTI1 (N,WA,IFAC)
             654                     !CWB2014
             655                     !     DIMENSION       WA(1)      ,IFAC(*)    ,NTRYH(4)
             656                           DIMENSION       WA(1)                  ,NTRYH(4)
             657                           real*8                      IFAC(*)
             658                     
             659                           DATA NTRYH(1),NTRYH(2),NTRYH(3),NTRYH(4)/4,2,3,5/
             660                           NL = N
             661                           NF = 0
             662                           J = 0
             663                       101 J = J+1
             664                           IF (J-4) 102,102,103
             665                       102 NTRY = NTRYH(J)
             666                           GO TO 104
             667                       103 NTRY = NTRY+2
             668                       104 NQ = NL/NTRY
             669                           NR = NL-NTRY*NQ
             670                           IF (NR) 101,105,101
             671                       105 NF = NF+1
             672                           IFAC(NF+2) = NTRY
             673                           NL = NQ
             674                           IF (NTRY .NE. 2) GO TO 107
             675                           IF (NF .EQ. 1) GO TO 107
             676                           DO 106 I=2,NF
             677                              IB = NF-I+2
             678                              IFAC(IB+2) = IFAC(IB+1)
             679                       106 CONTINUE
             680                           IFAC(3) = 2
             681                       107 IF (NL .NE. 1) GO TO 104
             682                           IFAC(1) = N
             683                           IFAC(2) = NF
             684                           TPI = 6.28318530717959
             685                           ARGH = TPI/FLOAT(N)
             686                           IS = 0
             687                           NFM1 = NF-1
             688                           L1 = 1
             689                           IF (NFM1 .EQ. 0) RETURN
             690                     !OCL NOVREC
             691                           DO 110 K1=1,NFM1
             692                              IP = IFAC(K1+2)
             693                              LD = 0
             694                              L2 = L1*IP
             695                              IDO = N/L2
             696                              IPM = IP-1
             697                              DO 109 J=1,IPM
             698                                 LD = LD+L1
             699                                 I = IS
             700                                 ARGLD = FLOAT(LD)*ARGH
             701                                 FI = 0
             702                     !OCL SCALAR
             703                                 DO 108 II=3,IDO,2
             704                                    I = I+2
             705                                    FI = FI+1
             706                                    ARG = FI*ARGLD
             707                                    WA(I-1) = COS(ARG)
             708                                    WA(I) = SIN(ARG)
             709                       108       CONTINUE
             710                                 IS = IS+IDO
             711                       109    CONTINUE
             712                              L1 = L2
             713                       110 CONTINUE
             714                           RETURN
             715                           END
             716                     
             717                     
             718                           SUBROUTINE RADB2 (IDO,L1,CC,CH,WA1)
             719                           DIMENSION  CC(IDO,2,L1),CH(IDO,L1,2),WA1(1)
             720                           DO 101 K=1,L1
             721                              CH(1,K,1) = CC(1,1,K)+CC(IDO,2,K)
             722                              CH(1,K,2) = CC(1,1,K)-CC(IDO,2,K)
             723                       101 CONTINUE
             724                           IF (IDO-2) 107,105,102
             725                       102 IDP2 = IDO+2
             726                     !OCL NOVREC
             727                           DO 104 K=1,L1
             728                              DO 103 I=3,IDO,2
             729                                 IC = IDP2-I
             730                                 CH(I-1,K,1) = CC(I-1,1,K)+CC(IC-1,2,K)
             731                                 TR2 = CC(I-1,1,K)-CC(IC-1,2,K)
             732                                 CH(I,K,1) = CC(I,1,K)-CC(IC,2,K)
             733                                 TI2 = CC(I,1,K)+CC(IC,2,K)
             734                                 CH(I-1,K,2) = WA1(I-2)*TR2-WA1(I-1)*TI2
             735                                 CH(I,K,2) = WA1(I-2)*TI2+WA1(I-1)*TR2
             736                       103    CONTINUE
             737                       104 CONTINUE
             738                           IF (MOD(IDO,2) .EQ. 1) RETURN
             739                       105 DO 106 K=1,L1
             740                              CH(IDO,K,1) = CC(IDO,1,K)+CC(IDO,1,K)
             741                              CH(IDO,K,2) = -(CC(1,2,K)+CC(1,2,K))
             742                       106 CONTINUE
             743                       107 RETURN
             744                           END
             745                     
             746                     
             747                           SUBROUTINE RADB3 (IDO,L1,CC,CH,WA1,WA2)
             748                           DIMENSION  CC(IDO,3,L1),CH(IDO,L1,3),WA1(1),WA2(1)
             749                           DATA TAUR,TAUI /-.5,.866025403784439/
             750                           DO 101 K=1,L1
             751                              TR2 = CC(IDO,2,K)+CC(IDO,2,K)
             752                              CR2 = CC(1,1,K)+TAUR*TR2
             753                              CH(1,K,1) = CC(1,1,K)+TR2
             754                              CI3 = TAUI*(CC(1,3,K)+CC(1,3,K))
             755                              CH(1,K,2) = CR2-CI3
             756                              CH(1,K,3) = CR2+CI3
             757                       101 CONTINUE
             758                           IF (IDO .EQ. 1) RETURN
             759                           IDP2 = IDO+2
             760                     !OCL NOVREC
             761                           DO 103 K=1,L1
             762                              DO 102 I=3,IDO,2
             763                                 IC = IDP2-I
             764                                 TR2 = CC(I-1,3,K)+CC(IC-1,2,K)
             765                                 CR2 = CC(I-1,1,K)+TAUR*TR2
             766                                 CH(I-1,K,1) = CC(I-1,1,K)+TR2
             767                                 TI2 = CC(I,3,K)-CC(IC,2,K)
             768                                 CI2 = CC(I,1,K)+TAUR*TI2
             769                                 CH(I,K,1) = CC(I,1,K)+TI2
             770                                 CR3 = TAUI*(CC(I-1,3,K)-CC(IC-1,2,K))
             771                                 CI3 = TAUI*(CC(I,3,K)+CC(IC,2,K))
             772                                 DR2 = CR2-CI3
             773                                 DR3 = CR2+CI3
             774                                 DI2 = CI2+CR3
             775                                 DI3 = CI2-CR3
             776                                 CH(I-1,K,2) = WA1(I-2)*DR2-WA1(I-1)*DI2
             777                                 CH(I,K,2) = WA1(I-2)*DI2+WA1(I-1)*DR2
             778                                 CH(I-1,K,3) = WA2(I-2)*DR3-WA2(I-1)*DI3
             779                                 CH(I,K,3) = WA2(I-2)*DI3+WA2(I-1)*DR3
             780                       102    CONTINUE
             781                       103 CONTINUE
             782                           RETURN
             783                           END
             784                     
             785                     
             786                           SUBROUTINE RADB4 (IDO,L1,CC,CH,WA1,WA2,WA3)
             787                           DIMENSION  CC(IDO,4,L1),CH(IDO,L1,4),WA1(1),WA2(1),WA3(1)
             788                           DATA SQRT2 /1.414213562373095/
             789                           DO 101 K=1,L1
             790                              TR1 = CC(1,1,K)-CC(IDO,4,K)
             791                              TR2 = CC(1,1,K)+CC(IDO,4,K)
             792                              TR3 = CC(IDO,2,K)+CC(IDO,2,K)
             793                              TR4 = CC(1,3,K)+CC(1,3,K)
             794                              CH(1,K,1) = TR2+TR3
             795                              CH(1,K,2) = TR1-TR4
             796                              CH(1,K,3) = TR2-TR3
             797                              CH(1,K,4) = TR1+TR4
             798                       101 CONTINUE
             799                           IF (IDO-2) 107,105,102
             800                       102 IDP2 = IDO+2
             801                     !OCL NOVREC
             802                           DO 104 K=1,L1
             803                              DO 103 I=3,IDO,2
             804                                 IC = IDP2-I
             805                                 TI1 = CC(I,1,K)+CC(IC,4,K)
             806                                 TI2 = CC(I,1,K)-CC(IC,4,K)
             807                                 TI3 = CC(I,3,K)-CC(IC,2,K)
             808                                 TR4 = CC(I,3,K)+CC(IC,2,K)
             809                                 TR1 = CC(I-1,1,K)-CC(IC-1,4,K)
             810                                 TR2 = CC(I-1,1,K)+CC(IC-1,4,K)
             811                                 TI4 = CC(I-1,3,K)-CC(IC-1,2,K)
             812                                 TR3 = CC(I-1,3,K)+CC(IC-1,2,K)
             813                                 CH(I-1,K,1) = TR2+TR3
             814                                 CR3 = TR2-TR3
             815                                 CH(I,K,1) = TI2+TI3
             816                                 CI3 = TI2-TI3
             817                                 CR2 = TR1-TR4
             818                                 CR4 = TR1+TR4
             819                                 CI2 = TI1+TI4
             820                                 CI4 = TI1-TI4
             821                                 CH(I-1,K,2) = WA1(I-2)*CR2-WA1(I-1)*CI2
             822                                 CH(I,K,2) = WA1(I-2)*CI2+WA1(I-1)*CR2
             823                                 CH(I-1,K,3) = WA2(I-2)*CR3-WA2(I-1)*CI3
             824                                 CH(I,K,3) = WA2(I-2)*CI3+WA2(I-1)*CR3
             825                                 CH(I-1,K,4) = WA3(I-2)*CR4-WA3(I-1)*CI4
             826                                 CH(I,K,4) = WA3(I-2)*CI4+WA3(I-1)*CR4
             827                       103    CONTINUE
             828                       104 CONTINUE
             829                           IF (MOD(IDO,2) .EQ. 1) RETURN
             830                       105 CONTINUE
             831                           DO 106 K=1,L1
             832                              TI1 = CC(1,2,K)+CC(1,4,K)
             833                              TI2 = CC(1,4,K)-CC(1,2,K)
             834                              TR1 = CC(IDO,1,K)-CC(IDO,3,K)
             835                              TR2 = CC(IDO,1,K)+CC(IDO,3,K)
             836                              CH(IDO,K,1) = TR2+TR2
             837                              CH(IDO,K,2) = SQRT2*(TR1-TI1)
             838                              CH(IDO,K,3) = TI2+TI2
             839                              CH(IDO,K,4) = -SQRT2*(TR1+TI1)
             840                       106 CONTINUE
             841                       107 RETURN
             842                           END
             843                     
             844                     
             845                           SUBROUTINE RADB5 (IDO,L1,CC,CH,WA1,WA2,WA3,WA4)
             846                           DIMENSION  CC(IDO,5,L1),CH(IDO,L1,5),WA1(1),WA2(1),WA3(1),WA4(1)
             847                           DATA TR11,TI11,TR12,TI12 /.309016994374947,.951056516295154,    &
             848                           -.809016994374947,.587785252292473/
             849                           DO 101 K=1,L1
             850                              TI5 = CC(1,3,K)+CC(1,3,K)
             851                              TI4 = CC(1,5,K)+CC(1,5,K)
             852                              TR2 = CC(IDO,2,K)+CC(IDO,2,K)
             853                              TR3 = CC(IDO,4,K)+CC(IDO,4,K)
             854                              CH(1,K,1) = CC(1,1,K)+TR2+TR3
             855                              CR2 = CC(1,1,K)+TR11*TR2+TR12*TR3
             856                              CR3 = CC(1,1,K)+TR12*TR2+TR11*TR3
             857                              CI5 = TI11*TI5+TI12*TI4
             858                              CI4 = TI12*TI5-TI11*TI4
             859                              CH(1,K,2) = CR2-CI5
             860                              CH(1,K,3) = CR3-CI4
             861                              CH(1,K,4) = CR3+CI4
             862                              CH(1,K,5) = CR2+CI5
             863                       101 CONTINUE
             864                           IF (IDO .EQ. 1) RETURN
             865                           IDP2 = IDO+2
             866                           DO 103 K=1,L1
             867                              DO 102 I=3,IDO,2
             868                                 IC = IDP2-I
             869                                 TI5 = CC(I,3,K)+CC(IC,2,K)
             870                                 TI2 = CC(I,3,K)-CC(IC,2,K)
             871                                 TI4 = CC(I,5,K)+CC(IC,4,K)
             872                                 TI3 = CC(I,5,K)-CC(IC,4,K)
             873                                 TR5 = CC(I-1,3,K)-CC(IC-1,2,K)
             874                                 TR2 = CC(I-1,3,K)+CC(IC-1,2,K)
             875                                 TR4 = CC(I-1,5,K)-CC(IC-1,4,K)
             876                                 TR3 = CC(I-1,5,K)+CC(IC-1,4,K)
             877                                 CH(I-1,K,1) = CC(I-1,1,K)+TR2+TR3
             878                                 CH(I,K,1) = CC(I,1,K)+TI2+TI3
             879                                 CR2 = CC(I-1,1,K)+TR11*TR2+TR12*TR3
             880                                 CI2 = CC(I,1,K)+TR11*TI2+TR12*TI3
             881                                 CR3 = CC(I-1,1,K)+TR12*TR2+TR11*TR3
             882                                 CI3 = CC(I,1,K)+TR12*TI2+TR11*TI3
             883                                 CR5 = TI11*TR5+TI12*TR4
             884                                 CI5 = TI11*TI5+TI12*TI4
             885                                 CR4 = TI12*TR5-TI11*TR4
             886                                 CI4 = TI12*TI5-TI11*TI4
             887                                 DR3 = CR3-CI4
             888                                 DR4 = CR3+CI4
             889                                 DI3 = CI3+CR4
             890                                 DI4 = CI3-CR4
             891                                 DR5 = CR2+CI5
             892                                 DR2 = CR2-CI5
             893                                 DI5 = CI2-CR5
             894                                 DI2 = CI2+CR5
             895                                 CH(I-1,K,2) = WA1(I-2)*DR2-WA1(I-1)*DI2
             896                                 CH(I,K,2) = WA1(I-2)*DI2+WA1(I-1)*DR2
             897                                 CH(I-1,K,3) = WA2(I-2)*DR3-WA2(I-1)*DI3
             898                                 CH(I,K,3) = WA2(I-2)*DI3+WA2(I-1)*DR3
             899                                 CH(I-1,K,4) = WA3(I-2)*DR4-WA3(I-1)*DI4
             900                                 CH(I,K,4) = WA3(I-2)*DI4+WA3(I-1)*DR4
             901                                 CH(I-1,K,5) = WA4(I-2)*DR5-WA4(I-1)*DI5
             902                                 CH(I,K,5) = WA4(I-2)*DI5+WA4(I-1)*DR5
             903                       102    CONTINUE
             904                       103 CONTINUE
             905                           RETURN
             906                           END
             907                     
             908                     
             909                           SUBROUTINE RADBG (IDO,IP,L1,IDL1,CC,C1,C2,CH,CH2,WA)
             910                           DIMENSION       CH(IDO,L1,IP)          ,CC(IDO,IP,L1)          , &
             911                                           C1(IDO,L1,IP)          ,C2(IDL1,IP),             &
             912                                           CH2(IDL1,IP)           ,WA(1)
             913                           DATA TPI/6.28318530717959/
             914                           ARG = TPI/FLOAT(IP)
             915                           DCP = COS(ARG)
             916                           DSP = SIN(ARG)
             917                           IDP2 = IDO+2
             918                           NBD = (IDO-1)/2
             919                           IPP2 = IP+2
             920                           IPPH = (IP+1)/2
             921                           IF (IDO .LT. L1) GO TO 103
             922                           DO 102 K=1,L1
             923                              DO 101 I=1,IDO
             924                                 CH(I,K,1) = CC(I,1,K)
             925                       101    CONTINUE
             926                       102 CONTINUE
             927                           GO TO 106
             928                       103 DO 105 I=1,IDO
             929                              DO 104 K=1,L1
             930                                 CH(I,K,1) = CC(I,1,K)
             931                       104    CONTINUE
             932                       105 CONTINUE
             933                     !OCL NOVREC
             934                       106 DO 108 J=2,IPPH
             935                              JC = IPP2-J
             936                              J2 = J+J
             937                              DO 107 K=1,L1
             938                                 CH(1,K,J) = CC(IDO,J2-2,K)+CC(IDO,J2-2,K)
             939                                 CH(1,K,JC) = CC(1,J2-1,K)+CC(1,J2-1,K)
             940                       107    CONTINUE
             941                       108 CONTINUE
             942                           IF (IDO .EQ. 1) GO TO 116
             943                           IF (NBD .LT. L1) GO TO 112
             944                     !OCL NOVREC
             945                           DO 111 J=2,IPPH
             946                              JC = IPP2-J
             947                              DO 110 K=1,L1
             948                                 DO 109 I=3,IDO,2
             949                                    IC = IDP2-I
             950                                    CH(I-1,K,J) = CC(I-1,2*J-1,K)+CC(IC-1,2*J-2,K)
             951                                    CH(I-1,K,JC) = CC(I-1,2*J-1,K)-CC(IC-1,2*J-2,K)
             952                                    CH(I,K,J) = CC(I,2*J-1,K)-CC(IC,2*J-2,K)
             953                                    CH(I,K,JC) = CC(I,2*J-1,K)+CC(IC,2*J-2,K)
             954                       109       CONTINUE
             955                       110    CONTINUE
             956                       111 CONTINUE
             957                           GO TO 116
             958                       112 DO 115 J=2,IPPH
             959                              JC = IPP2-J
             960                              DO 114 I=3,IDO,2
             961                                 IC = IDP2-I
             962                                 DO 113 K=1,L1
             963                                    CH(I-1,K,J) = CC(I-1,2*J-1,K)+CC(IC-1,2*J-2,K)
             964                                    CH(I-1,K,JC) = CC(I-1,2*J-1,K)-CC(IC-1,2*J-2,K)
             965                                    CH(I,K,J) = CC(I,2*J-1,K)-CC(IC,2*J-2,K)
             966                                    CH(I,K,JC) = CC(I,2*J-1,K)+CC(IC,2*J-2,K)
             967                       113       CONTINUE
             968                       114    CONTINUE
             969                       115 CONTINUE
             970                       116 AR1 = 1.
             971                           AI1 = 0.
             972                     !OCL NOVREC
             973                           DO 120 L=2,IPPH
             974                              LC = IPP2-L
             975                              AR1H = DCP*AR1-DSP*AI1
             976                              AI1 = DCP*AI1+DSP*AR1
             977                              AR1 = AR1H
             978                              DO 117 IK=1,IDL1
             979                                 C2(IK,L) = CH2(IK,1)+AR1*CH2(IK,2)
             980                                 C2(IK,LC) = AI1*CH2(IK,IP)
             981                       117    CONTINUE
             982                              DC2 = AR1
             983                              DS2 = AI1
             984                              AR2 = AR1
             985                              AI2 = AI1
             986                     !OCL NOVREC
             987                              DO 119 J=3,IPPH
             988                                 JC = IPP2-J
             989                                 AR2H = DC2*AR2-DS2*AI2
             990                                 AI2 = DC2*AI2+DS2*AR2
             991                                 AR2 = AR2H
             992                                 DO 118 IK=1,IDL1
             993                                    C2(IK,L) = C2(IK,L)+AR2*CH2(IK,J)
             994                                    C2(IK,LC) = C2(IK,LC)+AI2*CH2(IK,JC)
             995                       118       CONTINUE
             996                       119    CONTINUE
             997                       120 CONTINUE
             998                     !OCL NOVREC
             999                           DO 122 J=2,IPPH
            1000                              DO 121 IK=1,IDL1
            1001                                 CH2(IK,1) = CH2(IK,1)+CH2(IK,J)
            1002                       121    CONTINUE
            1003                       122 CONTINUE
            1004                     !OCL NOVREC
            1005                           DO 124 J=2,IPPH
            1006                              JC = IPP2-J
            1007                              DO 123 K=1,L1
            1008                                 CH(1,K,J) = C1(1,K,J)-C1(1,K,JC)
            1009                                 CH(1,K,JC) = C1(1,K,J)+C1(1,K,JC)
            1010                       123    CONTINUE
            1011                       124 CONTINUE
            1012                           IF (IDO .EQ. 1) GO TO 132
            1013                           IF (NBD .LT. L1) GO TO 128
            1014                     !OCL NOVREC
            1015                           DO 127 J=2,IPPH
            1016                              JC = IPP2-J
            1017                              DO 126 K=1,L1
            1018                                 DO 125 I=3,IDO,2
            1019                                    CH(I-1,K,J) = C1(I-1,K,J)-C1(I,K,JC)
            1020                                    CH(I-1,K,JC) = C1(I-1,K,J)+C1(I,K,JC)
            1021                                    CH(I,K,J) = C1(I,K,J)+C1(I-1,K,JC)
            1022                                    CH(I,K,JC) = C1(I,K,J)-C1(I-1,K,JC)
            1023                       125       CONTINUE
            1024                       126    CONTINUE
            1025                       127 CONTINUE
            1026                           GO TO 132
            1027                       128 DO 131 J=2,IPPH
            1028                              JC = IPP2-J
            1029                              DO 130 I=3,IDO,2
            1030                                 DO 129 K=1,L1
            1031                                    CH(I-1,K,J) = C1(I-1,K,J)-C1(I,K,JC)
            1032                                    CH(I-1,K,JC) = C1(I-1,K,J)+C1(I,K,JC)
            1033                                    CH(I,K,J) = C1(I,K,J)+C1(I-1,K,JC)
            1034                                    CH(I,K,JC) = C1(I,K,J)-C1(I-1,K,JC)
            1035                       129       CONTINUE
            1036                       130    CONTINUE
            1037                       131 CONTINUE
            1038                       132 CONTINUE
            1039                           IF (IDO .EQ. 1) RETURN
            1040                           DO 133 IK=1,IDL1
            1041                              C2(IK,1) = CH2(IK,1)
            1042                       133 CONTINUE
            1043                           DO 135 J=2,IP
            1044                              DO 134 K=1,L1
            1045                                 C1(1,K,J) = CH(1,K,J)
            1046                       134    CONTINUE
            1047                       135 CONTINUE
            1048                           IF (NBD .GT. L1) GO TO 139
            1049                           IS = -IDO
            1050                           DO 138 J=2,IP
            1051                              IS = IS+IDO
            1052                              IDIJ = IS
            1053                              DO 137 I=3,IDO,2
            1054                                 IDIJ = IDIJ+2
            1055                                 DO 136 K=1,L1
            1056                                    C1(I-1,K,J) = WA(IDIJ-1)*CH(I-1,K,J)-WA(IDIJ)*CH(I,K,J)
            1057                                    C1(I,K,J) = WA(IDIJ-1)*CH(I,K,J)+WA(IDIJ)*CH(I-1,K,J)
            1058                       136       CONTINUE
            1059                       137    CONTINUE
            1060                       138 CONTINUE
            1061                           GO TO 143
            1062                       139 IS = -IDO
            1063                     !OCL NOVREC
            1064                           DO 142 J=2,IP
            1065                              IS = IS+IDO
            1066                              DO 141 K=1,L1
            1067                                 IDIJ = IS
            1068                                 DO 140 I=3,IDO,2
            1069                                    IDIJ = IDIJ+2
            1070                                    C1(I-1,K,J) = WA(IDIJ-1)*CH(I-1,K,J)-WA(IDIJ)*CH(I,K,J)
            1071                                    C1(I,K,J) = WA(IDIJ-1)*CH(I,K,J)+WA(IDIJ)*CH(I-1,K,J)
            1072                       140       CONTINUE
            1073                       141    CONTINUE
            1074                       142 CONTINUE
            1075                       143 RETURN
            1076                           END
            1077                     
            1078                     
            1079                           SUBROUTINE RADF2 (IDO,L1,CC,CH,WA1)
            1080                           DIMENSION  CH(IDO,2,L1),CC(IDO,L1,2),WA1(1)
            1081                           DO 101 K=1,L1
            1082                              CH(1,1,K) = CC(1,K,1)+CC(1,K,2)
            1083                              CH(IDO,2,K) = CC(1,K,1)-CC(1,K,2)
            1084                       101 CONTINUE
            1085                           IF (IDO-2) 107,105,102
            1086                       102 IDP2 = IDO+2
            1087                           DO 104 K=1,L1
            1088                              DO 103 I=3,IDO,2
            1089                                 IC = IDP2-I
            1090                                 TR2 = WA1(I-2)*CC(I-1,K,2)+WA1(I-1)*CC(I,K,2)
            1091                                 TI2 = WA1(I-2)*CC(I,K,2)-WA1(I-1)*CC(I-1,K,2)
            1092                                 CH(I,1,K) = CC(I,K,1)+TI2
            1093                                 CH(IC,2,K) = TI2-CC(I,K,1)
            1094                                 CH(I-1,1,K) = CC(I-1,K,1)+TR2
            1095                                 CH(IC-1,2,K) = CC(I-1,K,1)-TR2
            1096                       103    CONTINUE
            1097                       104 CONTINUE
            1098                           IF (MOD(IDO,2) .EQ. 1) RETURN
            1099                       105 DO 106 K=1,L1
            1100                              CH(1,2,K) = -CC(IDO,K,2)
            1101                              CH(IDO,1,K) = CC(IDO,K,1)
            1102                       106 CONTINUE
            1103                       107 RETURN
            1104                           END
            1105                     
            1106                     
            1107                           SUBROUTINE RADF3 (IDO,L1,CC,CH,WA1,WA2)
            1108                           DIMENSION       CH(IDO,3,L1)           ,CC(IDO,L1,3)           , &
            1109                                           WA1(1)     ,WA2(1)
            1110                           DATA TAUR,TAUI /-.5,.866025403784439/
            1111                           DO 101 K=1,L1
            1112                              CR2 = CC(1,K,2)+CC(1,K,3)
            1113                              CH(1,1,K) = CC(1,K,1)+CR2
            1114                              CH(1,3,K) = TAUI*(CC(1,K,3)-CC(1,K,2))
            1115                              CH(IDO,2,K) = CC(1,K,1)+TAUR*CR2
            1116                       101 CONTINUE
            1117                           IF (IDO .EQ. 1) RETURN
            1118                           IDP2 = IDO+2
            1119                           DO 103 K=1,L1
            1120                              DO 102 I=3,IDO,2
            1121                                 IC = IDP2-I
            1122                                 DR2 = WA1(I-2)*CC(I-1,K,2)+WA1(I-1)*CC(I,K,2)
            1123                                 DI2 = WA1(I-2)*CC(I,K,2)-WA1(I-1)*CC(I-1,K,2)
            1124                                 DR3 = WA2(I-2)*CC(I-1,K,3)+WA2(I-1)*CC(I,K,3)
            1125                                 DI3 = WA2(I-2)*CC(I,K,3)-WA2(I-1)*CC(I-1,K,3)
            1126                                 CR2 = DR2+DR3
            1127                                 CI2 = DI2+DI3
            1128                                 CH(I-1,1,K) = CC(I-1,K,1)+CR2
            1129                                 CH(I,1,K) = CC(I,K,1)+CI2
            1130                                 TR2 = CC(I-1,K,1)+TAUR*CR2
            1131                                 TI2 = CC(I,K,1)+TAUR*CI2
            1132                                 TR3 = TAUI*(DI2-DI3)
            1133                                 TI3 = TAUI*(DR3-DR2)
            1134                                 CH(I-1,3,K) = TR2+TR3
            1135                                 CH(IC-1,2,K) = TR2-TR3
            1136                                 CH(I,3,K) = TI2+TI3
            1137                                 CH(IC,2,K) = TI3-TI2
            1138                       102    CONTINUE
            1139                       103 CONTINUE
            1140                           RETURN
            1141                           END
            1142                           SUBROUTINE RADF4 (IDO,L1,CC,CH,WA1,WA2,WA3)
            1143                           DIMENSION       CC(IDO,L1,4)           ,CH(IDO,4,L1)           , &
            1144                                           WA1(1)     ,WA2(1)     ,WA3(1)
            1145                           DATA HSQT2 /.7071067811865475/
            1146                           DO 101 K=1,L1
            1147                              TR1 = CC(1,K,2)+CC(1,K,4)
            1148                              TR2 = CC(1,K,1)+CC(1,K,3)
            1149                              CH(1,1,K) = TR1+TR2
            1150                              CH(IDO,4,K) = TR2-TR1
            1151                              CH(IDO,2,K) = CC(1,K,1)-CC(1,K,3)
            1152                              CH(1,3,K) = CC(1,K,4)-CC(1,K,2)
            1153                       101 CONTINUE
            1154                           IF (IDO-2) 107,105,102
            1155                       102 IDP2 = IDO+2
            1156                     !OCL NOVREC
            1157                           DO 104 K=1,L1
            1158                              DO 103 I=3,IDO,2
            1159                                 IC = IDP2-I
            1160                                 CR2 = WA1(I-2)*CC(I-1,K,2)+WA1(I-1)*CC(I,K,2)
            1161                                 CI2 = WA1(I-2)*CC(I,K,2)-WA1(I-1)*CC(I-1,K,2)
            1162                                 CR3 = WA2(I-2)*CC(I-1,K,3)+WA2(I-1)*CC(I,K,3)
            1163                                 CI3 = WA2(I-2)*CC(I,K,3)-WA2(I-1)*CC(I-1,K,3)
            1164                                 CR4 = WA3(I-2)*CC(I-1,K,4)+WA3(I-1)*CC(I,K,4)
            1165                                 CI4 = WA3(I-2)*CC(I,K,4)-WA3(I-1)*CC(I-1,K,4)
            1166                                 TR1 = CR2+CR4
            1167                                 TR4 = CR4-CR2
            1168                                 TI1 = CI2+CI4
            1169                                 TI4 = CI2-CI4
            1170                                 TI2 = CC(I,K,1)+CI3
            1171                                 TI3 = CC(I,K,1)-CI3
            1172                                 TR2 = CC(I-1,K,1)+CR3
            1173                                 TR3 = CC(I-1,K,1)-CR3
            1174                                 CH(I-1,1,K) = TR1+TR2
            1175                                 CH(IC-1,4,K) = TR2-TR1
            1176                                 CH(I,1,K) = TI1+TI2
            1177                                 CH(IC,4,K) = TI1-TI2
            1178                                 CH(I-1,3,K) = TI4+TR3
            1179                                 CH(IC-1,2,K) = TR3-TI4
            1180                                 CH(I,3,K) = TR4+TI3
            1181                                 CH(IC,2,K) = TR4-TI3
            1182                       103    CONTINUE
            1183                       104 CONTINUE
            1184                           IF (MOD(IDO,2) .EQ. 1) RETURN
            1185                       105 CONTINUE
            1186                           DO 106 K=1,L1
            1187                              TI1 = -HSQT2*(CC(IDO,K,2)+CC(IDO,K,4))
            1188                              TR1 = HSQT2*(CC(IDO,K,2)-CC(IDO,K,4))
            1189                              CH(IDO,1,K) = TR1+CC(IDO,K,1)
            1190                              CH(IDO,3,K) = CC(IDO,K,1)-TR1
            1191                              CH(1,2,K) = TI1-CC(IDO,K,3)
            1192                              CH(1,4,K) = TI1+CC(IDO,K,3)
            1193                       106 CONTINUE
            1194                       107 RETURN
            1195                           END
            1196                     
            1197                     
            1198                           SUBROUTINE RADF5 (IDO,L1,CC,CH,WA1,WA2,WA3,WA4)
            1199                           DIMENSION       CC(IDO,L1,5)           ,CH(IDO,5,L1)           , &
            1200                                           WA1(1)     ,WA2(1)     ,WA3(1)     ,WA4(1)
            1201                           DATA TR11,TI11,TR12,TI12 /.309016994374947,.951056516295154,     &
            1202                           -.809016994374947,.587785252292473/
            1203                           DO 101 K=1,L1
            1204                              CR2 = CC(1,K,5)+CC(1,K,2)
            1205                              CI5 = CC(1,K,5)-CC(1,K,2)
            1206                              CR3 = CC(1,K,4)+CC(1,K,3)
            1207                              CI4 = CC(1,K,4)-CC(1,K,3)
            1208                              CH(1,1,K) = CC(1,K,1)+CR2+CR3
            1209                              CH(IDO,2,K) = CC(1,K,1)+TR11*CR2+TR12*CR3
            1210                              CH(1,3,K) = TI11*CI5+TI12*CI4
            1211                              CH(IDO,4,K) = CC(1,K,1)+TR12*CR2+TR11*CR3
            1212                              CH(1,5,K) = TI12*CI5-TI11*CI4
            1213                       101 CONTINUE
            1214                           IF (IDO .EQ. 1) RETURN
            1215                           IDP2 = IDO+2
            1216                           DO 103 K=1,L1
            1217                              DO 102 I=3,IDO,2
            1218                                 IC = IDP2-I
            1219                                 DR2 = WA1(I-2)*CC(I-1,K,2)+WA1(I-1)*CC(I,K,2)
            1220                                 DI2 = WA1(I-2)*CC(I,K,2)-WA1(I-1)*CC(I-1,K,2)
            1221                                 DR3 = WA2(I-2)*CC(I-1,K,3)+WA2(I-1)*CC(I,K,3)
            1222                                 DI3 = WA2(I-2)*CC(I,K,3)-WA2(I-1)*CC(I-1,K,3)
            1223                                 DR4 = WA3(I-2)*CC(I-1,K,4)+WA3(I-1)*CC(I,K,4)
            1224                                 DI4 = WA3(I-2)*CC(I,K,4)-WA3(I-1)*CC(I-1,K,4)
            1225                                 DR5 = WA4(I-2)*CC(I-1,K,5)+WA4(I-1)*CC(I,K,5)
            1226                                 DI5 = WA4(I-2)*CC(I,K,5)-WA4(I-1)*CC(I-1,K,5)
            1227                                 CR2 = DR2+DR5
            1228                                 CI5 = DR5-DR2
            1229                                 CR5 = DI2-DI5
            1230                                 CI2 = DI2+DI5
            1231                                 CR3 = DR3+DR4
            1232                                 CI4 = DR4-DR3
            1233                                 CR4 = DI3-DI4
            1234                                 CI3 = DI3+DI4
            1235                                 CH(I-1,1,K) = CC(I-1,K,1)+CR2+CR3
            1236                                 CH(I,1,K) = CC(I,K,1)+CI2+CI3
            1237                                 TR2 = CC(I-1,K,1)+TR11*CR2+TR12*CR3
            1238                                 TI2 = CC(I,K,1)+TR11*CI2+TR12*CI3
            1239                                 TR3 = CC(I-1,K,1)+TR12*CR2+TR11*CR3
            1240                                 TI3 = CC(I,K,1)+TR12*CI2+TR11*CI3
            1241                                 TR5 = TI11*CR5+TI12*CR4
            1242                                 TI5 = TI11*CI5+TI12*CI4
            1243                                 TR4 = TI12*CR5-TI11*CR4
            1244                                 TI4 = TI12*CI5-TI11*CI4
            1245                                 CH(I-1,3,K) = TR2+TR5
            1246                                 CH(IC-1,2,K) = TR2-TR5
            1247                                 CH(I,3,K) = TI2+TI5
            1248                                 CH(IC,2,K) = TI5-TI2
            1249                                 CH(I-1,5,K) = TR3+TR4
            1250                                 CH(IC-1,4,K) = TR3-TR4
            1251                                 CH(I,5,K) = TI3+TI4
            1252                                 CH(IC,4,K) = TI4-TI3
            1253                       102    CONTINUE
            1254                       103 CONTINUE
            1255                           RETURN
            1256                           END
            1257                     
            1258                     
            1259                           SUBROUTINE RADFG (IDO,IP,L1,IDL1,CC,C1,C2,CH,CH2,WA)
            1260                           DIMENSION       CH(IDO,L1,IP)          ,CC(IDO,IP,L1)          , &
            1261                                           C1(IDO,L1,IP)          ,C2(IDL1,IP),             &
            1262                                           CH2(IDL1,IP)           ,WA(1)
            1263                           DATA TPI/6.28318530717959/
            1264                           ARG = TPI/FLOAT(IP)
            1265                           DCP = COS(ARG)
            1266                           DSP = SIN(ARG)
            1267                           IPPH = (IP+1)/2
            1268                           IPP2 = IP+2
            1269                           IDP2 = IDO+2
            1270                           NBD = (IDO-1)/2
            1271                           IF (IDO .EQ. 1) GO TO 119
            1272                           DO 101 IK=1,IDL1
            1273                              CH2(IK,1) = C2(IK,1)
            1274                       101 CONTINUE
            1275                           DO 103 J=2,IP
            1276                              DO 102 K=1,L1
            1277                                 CH(1,K,J) = C1(1,K,J)
            1278                       102    CONTINUE
            1279                       103 CONTINUE
            1280                           IF (NBD .GT. L1) GO TO 107
            1281                           IS = -IDO
            1282                           DO 106 J=2,IP
            1283                              IS = IS+IDO
            1284                              IDIJ = IS
            1285                              DO 105 I=3,IDO,2
            1286                                 IDIJ = IDIJ+2
            1287                                 DO 104 K=1,L1
            1288                                    CH(I-1,K,J) = WA(IDIJ-1)*C1(I-1,K,J)+WA(IDIJ)*C1(I,K,J)
            1289                                    CH(I,K,J) = WA(IDIJ-1)*C1(I,K,J)-WA(IDIJ)*C1(I-1,K,J)
            1290                       104       CONTINUE
            1291                       105    CONTINUE
            1292                       106 CONTINUE
            1293                           GO TO 111
            1294                       107 IS = -IDO
            1295                           DO 110 J=2,IP
            1296                              IS = IS+IDO
            1297                              DO 109 K=1,L1
            1298                                 IDIJ = IS
            1299                                 DO 108 I=3,IDO,2
            1300                                    IDIJ = IDIJ+2
            1301                                    CH(I-1,K,J) = WA(IDIJ-1)*C1(I-1,K,J)+WA(IDIJ)*C1(I,K,J)
            1302                                    CH(I,K,J) = WA(IDIJ-1)*C1(I,K,J)-WA(IDIJ)*C1(I-1,K,J)
            1303                       108       CONTINUE
            1304                       109    CONTINUE
            1305                       110 CONTINUE
            1306                       111 IF (NBD .LT. L1) GO TO 115
            1307                           DO 114 J=2,IPPH
            1308                              JC = IPP2-J
            1309                              DO 113 K=1,L1
            1310                                 DO 112 I=3,IDO,2
            1311                                    C1(I-1,K,J) = CH(I-1,K,J)+CH(I-1,K,JC)
            1312                                    C1(I-1,K,JC) = CH(I,K,J)-CH(I,K,JC)
            1313                                    C1(I,K,J) = CH(I,K,J)+CH(I,K,JC)
            1314                                    C1(I,K,JC) = CH(I-1,K,JC)-CH(I-1,K,J)
            1315                       112       CONTINUE
            1316                       113    CONTINUE
            1317                       114 CONTINUE
            1318                           GO TO 121
            1319                       115 DO 118 J=2,IPPH
            1320                              JC = IPP2-J
            1321                              DO 117 I=3,IDO,2
            1322                                 DO 116 K=1,L1
            1323                                    C1(I-1,K,J) = CH(I-1,K,J)+CH(I-1,K,JC)
            1324                                    C1(I-1,K,JC) = CH(I,K,J)-CH(I,K,JC)
            1325                                    C1(I,K,J) = CH(I,K,J)+CH(I,K,JC)
            1326                                    C1(I,K,JC) = CH(I-1,K,JC)-CH(I-1,K,J)
            1327                       116       CONTINUE
            1328                       117    CONTINUE
            1329                       118 CONTINUE
            1330                           GO TO 121

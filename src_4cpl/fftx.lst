             408                     !
             409                           SUBROUTINE drcft(init,x,ldx,y,ldy,n,m,isign,scale,   &
             410                                            table,n1,wrk,n2,z,nz)
             411                     
             412                           implicit none
             413                           integer init,ldx,ldy,n,m,isign,n1,n2,nz,i,j
             414                     !CWB2014
             415                     !     real x(ldx,*),y(2*ldy,*),scale,table(44002),wrk,z
             416                           real x(ldx,*),y(2*ldy,*),scale,table(n1),wrk(n2),z(1)
             417                     
             418                           IF (init.ne.0) THEN
             419                             CALL rffti(n,table)
             420                           ELSE
             421                             DO j=1,m
             422                               DO i=1,n
             423                                 y(i,j)=x(i,j)
             424                               ENDDO
             425                               CALL rfftf(n,y(1,j),table)
             426                               DO i=1,n
             427                                 y(i,j)=scale*y(i,j)
             428                               ENDDO
             429                               DO i=n,2,-1
             430                                 y(i+1,j)=y(i,j)
             431                               ENDDO
             432                               y(2,j)=0.
             433                             ENDDO
             434                           ENDIF
             435                     
             436                           RETURN
             437                           END
             438                     
             439                           SUBROUTINE srcft(init,x,ldx,y,ldy,n,m,isign,scale,    &
             440                                            table,n1,wrk,n2,z,nz)
             441                     
             442                           implicit none
             443                           integer init,ldx,ldy,n,m,isign,n1,n2,nz,i,j
             444                     !CWB2014
             445                     !     real x(ldx,*),y(2*ldy,*),scale,table(44002),wrk,z
             446                           real x(ldx,*),y(2*ldy,*),scale,table(n1),wrk(n2),z(1)
             447                     
             448                           IF (init.ne.0) THEN
             449                             CALL rffti(n,table)
             450                           ELSE
             451                             DO j=1,m
             452                               DO i=1,n
             453                                 y(i,j)=x(i,j)
             454                               ENDDO
             455                               CALL rfftf(n,y(1,j),table)
             456                               DO i=1,n
             457                                 y(i,j)=scale*y(i,j)
             458                               ENDDO
             459                               DO i=n,2,-1
             460                                 y(i+1,j)=y(i,j)

             358                           integer init,ldx,ldy,n,m,isign,n1,n2,nz,i,j
             359                     !CWB2014
             360                     !     real x(2*ldx,*),y(ldy,*),scale,table(44002),wrk,z
             361                           real x(2*ldx,*),y(ldy,*),scale,table(n1),wrk(n2),z(1)
             362                     
             363                           IF (init.ne.0) THEN
             364                             CALL rffti(n,table)
             365                           ELSE
             366                     !OCL NOVREC
             367                             DO j=1,m
             368                               y(1,j)=x(1,j)
             369                               DO i=2,n

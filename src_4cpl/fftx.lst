             325                     
             326                           SUBROUTINE dcrft(init,x,ldx,y,ldy,n,m,isign,scale,         &
             327                                            table,n1,wrk,n2,z,nz)
             328                     
             329                           implicit none
             330                           integer init,ldx,ldy,n,m,isign,n1,n2,nz,i,j
             331                     !CWB2014
             332                     !     real x(2*ldx,*),y(ldy,*),scale,table(44002),wrk,z
             333                           real x(2*ldx,*),y(ldy,*),scale,table(n1),wrk(n2),z(1)
             334                     
             335                           IF (init.ne.0) THEN
             336                             CALL rffti(n,table)
             337                           ELSE
             338                     !OCL NOVREC
             339                             DO j=1,m
             340                               y(1,j)=x(1,j)
             341                               DO i=2,n
             342                                 y(i,j)=x(i+1,j)
             343                               ENDDO
             344                               CALL rfftb(n,y(1,j),table)
             345                               DO i=1,n
             346                                 y(i,j)=scale*y(i,j)
             347                               ENDDO
             348                             ENDDO
             349                           ENDIF
             350                     
             351                           RETURN
             352                           END
             353                     
             354                           SUBROUTINE scrft(init,x,ldx,y,ldy,n,m,isign,scale,      &
             355                                            table,n1,wrk,n2,z,nz)
             356                     

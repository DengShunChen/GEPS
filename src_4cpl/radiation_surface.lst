             581                     !-----------------------------------
             582                           subroutine setemis                                                &
             583                     !...................................
             584                     
             585                     !  ---  inputs:
             586                          &     ( xlon,xlat,slmsk,snowf,sncovr,zorlf,tsknf,tairf,hprif,      &
             587                          &       imax,                                                      &
             588                     !  ---  outputs:
             589                          &       sfcemis                                                    &
             590                          &     )
             591                     
             592                     !  ===================================================================  !
             593                     !                                                                       !
             594                     !  this program computes surface emissivity for lw radiation.           !
             595                     !                                                                       !
             596                     !  usage:         call setemis                                          !
             597                     !                                                                       !
             598                     !  subprograms called:  none                                            !
             599                     !                                                                       !
             600                     !  ====================  defination of variables  ====================  !
             601                     !                                                                       !
             602                     !  inputs:                                                              !
             603                     !     xlon  (imax)  - longitude in radiance, ok for both 0->2pi or      !
             604                     !                     -pi -> +pi ranges                                 !
             605                     !     xlat  (imax)  - latitude  in radiance, default to pi/2 -> -pi/2   !
             606                     !                     range, otherwise see in-line comment              !
             607                     !     slmsk (imax)  - sea(0),land(1),ice(2) mask on fcst model grid     !
             608                     !     snowf (imax)  - snow depth water equivalent in mm                 !
             609                     !     sncovr(imax)  - ialbflg=1: snow cover over land in fraction       !
             610                     !     zorlf (imax)  - surface roughness in cm                           !
             611                     !     tsknf (imax)  - ground surface temperature in k                   !
             612                     !     tairf (imax)  - lowest model layer air temperature in k           !
             613                     !     hprif (imax)  - topographic sdv in m                              !
             614                     !     imax          - array horizontal dimension                        !
             615                     !                                                                       !
             616                     !  outputs:                                                             !
             617                     !     sfcemis(imax) - surface emissivity                                !
             618                     !                                                                       !
             619                     !  -------------------------------------------------------------------  !
             620                     !                                                                       !
             621                     !  surface type definations:                                            !
             622                     !     1. open water                   2. grass/wood/shrub land          !
             623                     !     3. tundra/bare soil             4. sandy desert                   !
             624                     !     5. rocky desert                 6. forest                         !
             625                     !     7. ice                          8. snow                           !
             626                     !                                                                       !
             627                     !  input index data lon from 0 towards east, lat from n to s            !
             628                     !                                                                       !
             629                     !  ====================    end of description    =====================  !
             630                     !
             631                           implicit none
             632                     
             633                     !  ---  inputs
             634                           integer, intent(in) :: imax
             635                     
             636                           real (kind=kind_phys), dimension(:), intent(in) ::                &
             637                          &       xlon,xlat, slmsk, snowf,sncovr, zorlf, tsknf, tairf, hprif
             638                     
             639                     !  ---  outputs
             640                           real (kind=kind_phys), dimension(:), intent(out) :: sfcemis
             641                     
             642                     !  ---  locals:
             643                           integer :: i, i1, i2, j1, j2, idx
             644                     
             645                           real (kind=kind_phys) :: dltg, hdlt, tmp1, tmp2,                  &
             646                          &      asnow, argh, hrgh, fsno, fsno0, fsno1
             647                     
             648                     !  ---  reference emiss value for diff surface emiss index
             649                     !       1-open water, 2-grass/shrub land, 3-bare soil, tundra,
             650                     !       4-sandy desert, 5-rocky desert, 6-forest, 7-ice, 8-snow
             651                     
             652                           real (kind=kind_phys) ::  emsref(8)
             653                           data  emsref / 0.97, 0.95, 0.94, 0.90, 0.93, 0.96, 0.96, 0.99 /
             654                     
             655                     !
             656                     !===> ...  begin here
             657                     !
             658                     
             659     1                     if ( iemslw == 0 ) then        ! sfc emiss default to 1.0
             660     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             661     1  pp   4v              sfcemis(:) = f_one
             662     1                       return
             663     1               
             664     1                     else                           ! emiss set by sfc type and condition
             665     1               
             666     1                       dltg = 360.0 / float(imxems)
             667     1                       hdlt = 0.5 * dltg
             668     1               
             669     1               !  --- ...  mapping input data onto model grid
             670     1               !           note: this is a simple mapping method, an upgrade is needed if
             671     1               !           the model grid is much corcer than the 1-deg data resolution
             672     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             673     2  pp                   lab_do_imax : do i = 1, imax
             674     2               
             675     3   p                     if ( nint(slmsk(i)) == 0 ) then          ! sea point
             676     3               
             677     3   p                       sfcemis(i) = emsref(1)
             678     3               
             679     3   p                     else if ( nint(slmsk(i)) == 2 ) then     ! sea-ice
             680     3               
             681     3   p                       sfcemis(i) = emsref(7)
             682     3               
             683     3   p                     else                                     ! land
             684     3               
             685     3               !  ---  map grid in longitude direction
             686     3   p                       i2 = 1
             687     3   p                       j2 = 1
             688     3               
             689     3   p                       tmp1 = xlon(i) * rad2dg
             690     3   p                       if (tmp1 < f_zero) tmp1 = tmp1 + 360.0
             691     3               
             692     4   p                       lab_do_imxems : do i1 = 1, imxems
             693     4   p                         tmp2 = dltg * (i1 - 1) + hdlt
             694     4               
             695     5   p                         if (abs(tmp1-tmp2) <= hdlt) then
             696     5   p                          i2 = i1
             697     5   p                           exit lab_do_imxems
             698     5   p                         endif
             699     4   p                       enddo  lab_do_imxems
             700     3               
             701     3               !  ---  map grid in latitude direction
             702     3   p                       tmp1 = xlat(i) * rad2dg           ! if xlat in pi/2 -> -pi/2 range
             703     3               !           tmp1 = 90.0 - xlat(i)*rad2dg      ! if xlat in 0 -> pi range
             704     3               
             705     4   p                       lab_do_jmxems : do j1 = 1, jmxems
             706     4               !cmy          tmp2 = 90.0 - dltg * (j1 - 1)
             707     4   p                         tmp2 = -90.0 + dltg * (j1 - 1)
             708     4               
             709     5   p                         if (abs(tmp1-tmp2) <= hdlt) then
             710     5   p                           j2 = j1
             711     5   p                           exit lab_do_jmxems
             712     5   p                         endif
             713     4   p                       enddo  lab_do_jmxems
             714     3               
             715     3               
             716     3   p                       idx = max( 2, idxems(i2,j2) )
             717     3   p                       if ( idx >= 7 ) idx = 2
             718     3   p                       sfcemis(i) = emsref(idx)
             719     3               
             720     3   p                     endif   ! end if_slmsk_block
             721     2               
             722     2               !  ---  check for snow covered area
             723     2               
             724     3   p                     if ( ialbflg==1 .and. nint(slmsk(i))==1 ) then ! input land area snow cover
             725     3               
             726     3   p                       fsno0 = sncovr(i)
             727     3   p                       fsno1 = f_one - fsno0
             728     3   p                       sfcemis(i) = sfcemis(i)*fsno1 + emsref(8)*fsno0
             729     3               
             730     3   p                     else                                           ! compute snow cover from snow depth
             731     4   p                       if ( snowf(i) > f_zero ) then
             732     4   p                         asnow = 0.02*snowf(i)
             733     4   p                         argh  = min(0.50, max(.025, 0.01*zorlf(i)))
             734     4   p                         hrgh  = min(f_one, max(0.20, 1.0577-1.1538e-3*hprif(i) ) )
             735     4   p                         fsno0 = asnow / (argh + asnow) * hrgh
             736     4   p                         if (nint(slmsk(i)) == 0 .and. tsknf(i) > 271.2)           &
             737     4                    &                               fsno0=f_zero
             738     4   p                         fsno1 = f_one - fsno0
             739     4   p                         sfcemis(i) = sfcemis(i)*fsno1 + emsref(8)*fsno0
             740     4   p                       endif
             741     3               
             742     3   p                     endif                                          ! end if_ialbflg
             743     2               
             744     2   p                   enddo  lab_do_imax
             745     1               
             746     1                     endif   ! end if_iemslw_block
             747                     
             748                     !chk  print *,' in setemis, iemsflg, sfcemis =',iemsflg,sfcemis
             749                     
             750                     !
             751                           return
             752                     !...................................
             753                           end subroutine setemis
             754                     !-----------------------------------
             755                     
             756                     !
             757                     !.........................................!
             758                           end module module_radiation_surface !
             759                     !=========================================!


              88                          &   vtagsfc='ncep-radiation_surface   v5.1  nov 2012 '
              89                     !    &   vtagsfc='ncep-radiation_surface   v5.0  aug 2012 '
              90                     
              91                     !  ---  constant parameters
              92                           integer, parameter, public :: nf_albd = 4  ! num of sfc albedo components
              93                     
              94                           integer, parameter, public :: imxems = 360 ! num of lon-pts in glb emis-type map
              95                           integer, parameter, public :: jmxems = 180 ! num of lat-pts in glb emis-type map
              96                     
              97                           real (kind=kind_phys), parameter :: f_zero = 0.0
              98                           real (kind=kind_phys), parameter :: f_one  = 1.0
              99                           real (kind=kind_phys), parameter :: rad2dg= 180.0 / con_pi
             100                     
             101                     !  ---  global surface emissivity index array and control flag  set up in 'sfc_init'
             102                           integer, allocatable  ::  idxems(:,:)
             103                           integer, allocatable  ::  jdxems(:,:)
             104                           integer :: iemslw = 0
             105                     !
             106                           public  sfc_init, setalb, setemis
             107                     
             108                     ! =================
             109                           contains
             110                     ! =================

             113                     !-----------------------------------
             114                           subroutine sfc_init                                               &
             115                     !...................................
             116                     
             117                     !  ---  inputs:
             118                          &     ( me , myrank)
             119                     !  ---  outputs: ( none )
             120                     
             121                     !  ===================================================================  !
             122                     !                                                                       !
             123                     !  this program is the initialization program for surface radiation     !
             124                     !  related quantities (albedo, emissivity, etc.)                        !
             125                     !                                                                       !
             126                     ! usage:         call sfc_init                                          !
             127                     !                                                                       !
             128                     ! subprograms called:  none                                             !
             129                     !                                                                       !
             130                     !  ====================  defination of variables  ====================  !
             131                     !                                                                       !
             132                     !  inputs:                                                              !
             133                     !      me           - print control flag                                !
             134                     !                                                                       !
             135                     !  outputs: (none) to module variables only                             !
             136                     !                                                                       !
             137                     !  external module variables:                                           !
             138                     !     ialbflg       - control flag for surface albedo schemes           !
             139                     !                     =0: climatology, based on surface veg types       !
             140                     !                     =1:                                               !
             141                     !     iemsflg       - control flag for sfc emissivity schemes (ab:2-dig)!
             142                     !                     a:=0 set sfc air/ground t same for lw radiation   !
             143                     !                       =1 set sfc air/ground t diff for lw radiation   !
             144                     !                     b:=0 use fixed sfc emissivity=1.0 (black-body)    !
             145                     !                       =1 use varying climtology sfc emiss (veg based) !
             146                     !                                                                       !
             147                     !  ====================    end of description    =====================  !
             148                     !
             149                           implicit none
             150                     
             151                     !  ---  inputs:
             152                           integer, intent(in) :: me, myrank
             153                     
             154                     !  ---  outputs: ( none )
             155                     
             156                     !  ---  locals:
             157                           integer    :: i, k, j, jn
             158                     !     integer    :: ia, ja
             159                           logical    :: file_exist
             160                           character  :: cline*80
             161                     !
             162                     !===> ...  begin here
             163                     !
             164                           if ( me == 0 .and. myrank == 0) print *, vtagsfc   ! print out version tag
             165                     
             166                     !  --- ...  initialization of surface albedo section
             167                     
             168     1                     if ( ialbflg == 0  ) then
             169     1               
             170     2                       if ( me == 0 .and. myrank == 0 ) then
             171     2                         print *,' - using climatology surface albedo scheme for sw'
             172     2                       endif
             173     1               
             174     1                     else if ( ialbflg == 1 ) then
             175     1               
             176     2                       if ( me == 0 .and. myrank == 0 ) then
             177     2                         print *,' - using modis based land surface albedo for sw'
             178     2                       endif
             179     1               
             180     1                     else
             181     1                       print *,' !! error in albedo scheme setting, ialb=',ialbflg
             182     1                       stop
             183     1                     endif    ! end if_ialbflg_block
             184                     
             185                     !  --- ...  initialization of surface emissivity section
             186                     
             187                           iemslw = mod(iemsflg, 10)          ! emissivity control
             188     1                     if ( iemslw == 0 ) then            ! fixed sfc emis at 1.0
             189     1               
             190     2                       if ( me == 0 .and. myrank == 0 ) then
             191     2                         print *,' - using fixed surface emissivity = 1.0 for lw'
             192     2                       endif
             193     1               
             194     1                     elseif ( iemslw == 1 ) then        ! input sfc emiss type map
             195     1               
             196     1               !  ---  allocate data space
             197     2                       if ( .not. allocated(idxems) ) then
             198     2                         allocate ( idxems(imxems,jmxems)    )
             199     2                       endif
             200     1               !cmy
             201     2                       if ( .not. allocated(jdxems) ) then
             202     2                         allocate ( jdxems(imxems,jmxems)    )
             203     2                       endif
             204     1               !cmy
             205     1               
             206     1               !  ---  check to see if requested emissivity data file existed
             207     1               
             208     1                       inquire (file=semis_file, exist=file_exist)
             209     1               
             210     2                       if ( .not. file_exist ) then
             211     3                       if ( me == 0 .and. myrank == 0 ) then
             212     3                           print *,' - using varying surface emissivity for lw'
             213     3                           print *,'   requested data file "',semis_file,'" not found!'
             214     3                           print *,'   change to fixed surface emissivity = 1.0 !'
             215     3                         endif
             216     2               
             217     2                         iemslw = 0
             218     2                       else
             219     2                         close(niradsf)
             220     2                         open (niradsf,file=semis_file,form='formatted',status='old')
             221     2                         rewind niradsf
             222     2               
             223     2                         read (niradsf,12) cline
             224     2                 12      format(a80)
             225     2               
             226     2               !cmy      read (niradsf,14) idxems
             227     2                         read (niradsf,14) jdxems
             228     2                 14      format(80i1)
             229     2               
             230     2               !cmy
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jdxems, idxems
                                   <<< Loop-information  End >>>
             231     3  pp                     do j = 1,jmxems
             232     3   p                        jn = jmxems - j + 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 288, MVE: 7, POL: S)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             233     4   p   2v                do i = 1, imxems
             234     4   p   2v                   idxems(i,jn)=jdxems(i,j)
             235     4   p   2v                enddo
             236     3   p                     enddo
             237     2               !cmy
             238     2               
             239     3                         if ( me == 0 .and. myrank == 0 ) then
             240     3                           print *,' - using varying surface emissivity for lw'
             241     3                           print *,'   opened data file: ',semis_file
             242     3                           print *, cline
             243     3               !check      print *,' check: sample emissivity index data'
             244     3               !           ia = imxems / 5
             245     3               !           ja = jmxems / 5
             246     3               !           print *, idxems(1:imxems:ia,1:jmxems:ja)
             247     3                         endif
             248     2               
             249     2                         close(niradsf)
             250     2                       endif    ! end if_file_exist_block
             251     1               
             252     1                     else
             253     1                       print *,' !! error in emissivity scheme setting, iems=',iemsflg
             254     1                       stop
             255     1                     endif   ! end if_iemslw_block
             256                     
             257                     !
             258                           return
             259                     !...................................
             260                           end subroutine sfc_init
             261                     !-----------------------------------
             262                     
             263                     
             264                     !-----------------------------------
             265                           subroutine setalb                                                 &
             266                     !...................................
             267                     
             268                     !  ---  inputs:
             269                          &     ( slmsk,snowf,sncovr,snoalb,zorlf,coszf,tsknf,tairf,hprif,   &
             270                          &       alvsf,alnsf,alvwf,alnwf,facsf,facwf,fice,tisfc,            &
             271                          &       imax,                                                      &
             272                     !  ---  outputs:
             273                          &       sfcalb                                                     &
             274                          &     )
             275                     
             276                     !  ===================================================================  !
             277                     !                                                                       !
             278                     !  this program computes four components of surface albedos (i.e.       !
             279                     !  vis-nir, direct-diffused) according to controflag ialbflg.           !
             280                     !   1) climatological surface albedo scheme (briegleb 1992)             !
             281                     !   2) modis retrieval based scheme from boston univ.                   !
             282                     !                                                                       !
             283                     !                                                                       !
             284                     ! usage:         call setalb                                            !
             285                     !                                                                       !
             286                     ! subprograms called:  none                                             !
             287                     !                                                                       !
             288                     !  ====================  defination of variables  ====================  !
             289                     !                                                                       !
             290                     !  inputs:                                                              !
             291                     !     slmsk (imax)  - sea(0),land(1),ice(2) mask on fcst model grid     !
             292                     !     snowf (imax)  - snow depth water equivalent in mm                 !
             293                     !     sncovr(imax)  - ialgflg=0: not used                               !
             294                     !                     ialgflg=1: snow cover over land in fraction       !
             295                     !     snoalb(imax)  - ialbflg=0: not used                               !
             296                     !                     ialgflg=1: max snow albedo over land in fraction  !
             297                     !     zorlf (imax)  - surface roughness in cm                           !
             298                     !     coszf (imax)  - cosin of solar zenith angle                       !
             299                     !     tsknf (imax)  - ground surface temperature in k                   !
             300                     !     tairf (imax)  - lowest model layer air temperature in k           !
             301                     !     hprif (imax)  - topographic sdv in m                              !
             302                     !           ---  for ialbflg=0 climtological albedo scheme  ---         !
             303                     !     alvsf (imax)  - 60 degree vis albedo with strong cosz dependency  !
             304                     !     alnsf (imax)  - 60 degree nir albedo with strong cosz dependency  !
             305                     !     alvwf (imax)  - 60 degree vis albedo with weak cosz dependency    !
             306                     !     alnwf (imax)  - 60 degree nir albedo with weak cosz dependency    !
             307                     !           ---  for ialbflg=1 modis based land albedo scheme ---       !
             308                     !     alvsf (imax)  - visible black sky albedo at zenith 60 degree      !
             309                     !     alnsf (imax)  - near-ir black sky albedo at zenith 60 degree      !
             310                     !     alvwf (imax)  - visible white sky albedo                          !
             311                     !     alnwf (imax)  - near-ir white sky albedo                          !
             312                     !                                                                       !
             313                     !     facsf (imax)  - fractional coverage with strong cosz dependency   !
             314                     !     facwf (imax)  - fractional coverage with weak cosz dependency     !
             315                     !     fice  (imax)  - sea-ice fraction                                  !
             316                     !     tisfc (imax)  - sea-ice surface temperature                       !
             317                     !     imax          - array horizontal dimension                        !
             318                     !                                                                       !
             319                     !  outputs:                                                             !
             320                     !     sfcalb(imax,nf_albd)                                              !
             321                     !           ( :, 1) -     near ir direct beam albedo                    !
             322                     !           ( :, 2) -     near ir diffused albedo                       !
             323                     !           ( :, 3) -     uv+vis direct beam albedo                     !
             324                     !           ( :, 4) -     uv+vis diffused albedo                        !
             325                     !                                                                       !
             326                     !  module internal control variables:                                   !
             327                     !     ialbflg       - =0 use the default climatology surface albedo     !
             328                     !                     =1 use modis retrieved albedo and input snow cover!
             329                     !                        for land areas                                 !
             330                     !                                                                       !
             331                     !  ====================    end of description    =====================  !
             332                     !
             333                           implicit none
             334                     
             335                     !  ---  inputs
             336                           integer, intent(in) :: imax
             337                     
             338                           real (kind=kind_phys), dimension(:), intent(in) ::                &
             339                          &       slmsk, snowf, zorlf, coszf, tsknf, tairf, hprif,           &
             340                          &       alvsf, alnsf, alvwf, alnwf, facsf, facwf, fice, tisfc,     &
             341                          &       sncovr, snoalb
             342                     
             343                     !  ---  outputs
             344                           real (kind=kind_phys), dimension(:,:), intent(out) :: sfcalb
             345                     
             346                     !  ---  locals:
             347                           real (kind=kind_phys) :: asnvb, asnnb, asnvd, asnnd, asevb        &
             348                          &,     asenb, asevd, asend, fsno,  fsea,  rfcs,  rfcw,  flnd       &
             349                          &,     asnow, argh,  hrgh,  fsno0, fsno1, flnd0, fsea0, csnow      &
             350                          &,     a1, a2, b1, b2, b3, ab1bm, ab2bm
             351                     
             352                           real (kind=kind_phys) ffw, dtgd
             353                     
             354                           integer :: i, k
             355                     
             356                     !
             357                     !===> ...  begin here
             358                     !
             359                     
             360     1                     if ( ialbflg == 0 ) then   ! use climatological albedo scheme
             361     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 23
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 42
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 24
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             362     2  pp    v              do i = 1, imax
             363     2               
             364     2               ! --- modified snow albedo scheme - units convert to m
             365     2               !     (originally snowf in mm; zorlf in cm)
             366     2               
             367     2   p    v               asnow = 0.02*snowf(i)
             368     2   p    v               argh  = min(0.50, max(.025, 0.01*zorlf(i)))
             369     2   p    v               hrgh  = min(f_one, max(0.20, 1.0577-1.1538e-3*hprif(i) ) )
             370     2   p    v               fsno0 = asnow / (argh + asnow) * hrgh
             371     2   p    v               if (nint(slmsk(i))==0 .and. tsknf(i)>con_tice) fsno0 = f_zero
             372     2   p    v               fsno1 = f_one - fsno0
             373     2   p    v               flnd0 = min(f_one, facsf(i)+facwf(i))
             374     2   p    v               fsea0 = max(f_zero, f_one-flnd0)
             375     2   p    v               fsno  = fsno0
             376     2   p    v               fsea  = fsea0 * fsno1
             377     2   p    v               flnd  = flnd0 * fsno1
             378     2               
             379     2               ! --- diffused sea surface albedo
             380     2               
             381     3   p    v               if (tsknf(i) >= 271.5) then
             382     3   p    v                  asevd = 0.06
             383     3   p    v                  asend = 0.06
             384     3   p    v               elseif (tsknf(i) < 271.1) then
             385     3   p    v                  asevd = 0.70
             386     3   p    v                  asend = 0.65
             387     3   p    v               else
             388     3   p    v                  a1 = (tsknf(i) - 271.1)**2
             389     3   p    v                  asevd = 0.7 - 4.0*a1
             390     3   p    v                  asend = 0.65 - 3.6875*a1
             391     3   p    v               endif
             392     2               
             393     2               ! --- diffused snow albedo
             394     2               
             395     3   p    v               if (nint(slmsk(i)) == 2) then
             396     3   p    v                  ffw   = f_one - fice(i)
             397     4   p    v                  if (ffw < f_one) then
             398     4   p    v                     dtgd = max(f_zero, min(5.0, (con_ttp-tisfc(i)) ))
             399     4   p    v                     b1   = 0.03 * dtgd
             400     4   p    v                  else
             401     4   p    v                     b1 = f_zero
             402     4   p    v                  endif
             403     3               
             404     3   p    v                  b3   = 0.06 * ffw
             405     3   p    v                  asnvd = (0.70 + b1) * fice(i) + b3
             406     3   p    v                  asnnd = (0.60 + b1) * fice(i) + b3
             407     3   p    v                  asevd = 0.70        * fice(i) + b3
             408     3   p    v                  asend = 0.60        * fice(i) + b3
             409     3   p    v               else
             410     3   p    v                  asnvd = 0.90
             411     3   p    v                  asnnd = 0.75
             412     3   p    v               endif
             413     2               
             414     2               ! --- direct snow albedo
             415     2               
             416     3   p    v               if (coszf(i) < 0.5) then
             417     3   p    v                  csnow = 0.5 * (3.0 / (f_one+4.0*coszf(i)) - f_one)
             418     3   p    v                  asnvb = min( 0.98, asnvd+(1.0-asnvd)*csnow )
             419     3   p    v                  asnnb = min( 0.98, asnnd+(1.0-asnnd)*csnow )
             420     3   p    v               else
             421     3   p    v                  asnvb = asnvd
             422     3   p    v                  asnnb = asnnd
             423     3   p    v               endif
             424     2               
             425     2               ! --- direct sea surface albedo
             426     2               
             427     3   p    v               if (coszf(i) > 0.0001) then
             428     3               !           rfcs = 1.4 / (f_one + 0.8*coszf(i))
             429     3               !           rfcw = 1.3 / (f_one + 0.6*coszf(i))
             430     3   p    v                  rfcs = 2.14 / (f_one + 1.48*coszf(i))
             431     3   p    v                  rfcw = rfcs
             432     3               
             433     4   p    v                  if (tsknf(i) >= con_t0c) then
             434     4   p    v                    asevb = max(asevd, 0.026/(coszf(i)**1.7+0.065)            &
             435     4                    &              + 0.15 * (coszf(i)-0.1) * (coszf(i)-0.5)            &
             436     4                    &              * (coszf(i)-f_one))
             437     4   p    v                    asenb = asevb
             438     4   p    v                  else
             439     4   p    v                    asevb = asevd
             440     4   p    v                    asenb = asend
             441     4   p    v                  endif
             442     3   p    v               else
             443     3   p    v                  rfcs  = f_one
             444     3   p    v                  rfcw  = f_one
             445     3   p    v                  asevb = asevd
             446     3   p    v                  asenb = asend
             447     3   p    v               endif
             448     2               
             449     2   p    v               a1   = alvsf(i) * facsf(i)
             450     2   p    v               b1   = alvwf(i) * facwf(i)
             451     2   p    v               a2   = alnsf(i) * facsf(i)
             452     2   p    v               b2   = alnwf(i) * facwf(i)
             453     2   p    v               ab1bm = a1*rfcs + b1*rfcw
             454     2   p    v               ab2bm = a2*rfcs + b2*rfcw
             455     2   p    v               sfcalb(i,1) = min(0.99, ab2bm) *flnd + asenb*fsea + asnnb*fsno
             456     2   p    v               sfcalb(i,2) = (a2 + b2) * 0.96 *flnd + asend*fsea + asnnd*fsno
             457     2   p    v               sfcalb(i,3) = min(0.99, ab1bm) *flnd + asevb*fsea + asnvb*fsno
             458     2   p    v               sfcalb(i,4) = (a1 + b1) * 0.96 *flnd + asevd*fsea + asnvd*fsno
             459     2               !byl         sfcalb(i,1) = (a2*rfcs+b2*rfcw)*flnd + asenb*fsea + asnnb*fsno
             460     2               !byl         sfcalb(i,2) = (a2 + b2) * 0.96 *flnd + asend*fsea + asnnd*fsno
             461     2               !byl         sfcalb(i,3) = (a1*rfcs+b1*rfcw)*flnd + asevb*fsea + asnvb*fsno
             462     2               !byl         sfcalb(i,4) = (a1 + b1) * 0.96 *flnd + asevd*fsea + asnvd*fsno
             463     2               
             464     2   p    v              enddo    ! end_do_i_loop
             465     1               
             466     1                     else                       ! use modis based albedo for land area
             467     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 23
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 38
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 4  FILL 4
                                   <<< Loop-information  End >>>
             468     2  pp    v              do i = 1, imax
             469     2               
             470     2               ! --- snow cover input directly from land model, no conversion needed
             471     2               
             472     2   p    v               fsno0 = sncovr(i)
             473     2               
             474     2   p    v               if (nint(slmsk(i))==0 .and. tsknf(i)>con_tice) fsno0 = f_zero
             475     2               
             476     3   p    v               if (nint(slmsk(i)) == 2) then
             477     3   p    v                 asnow = 0.02*snowf(i)
             478     3   p    v                 argh  = min(0.50, max(.025, 0.01*zorlf(i)))
             479     3   p    v                 hrgh  = min(f_one, max(0.20, 1.0577-1.1538e-3*hprif(i) ) )
             480     3   p    v                 fsno0 = asnow / (argh + asnow) * hrgh
             481     3   p    v               endif
             482     2               
             483     2   p    v               fsno1 = f_one - fsno0
             484     2   p    v               flnd0 = min(f_one, facsf(i)+facwf(i))
             485     2   p    v               fsea0 = max(f_zero, f_one-flnd0)
             486     2   p    v               fsno  = fsno0
             487     2   p    v               fsea  = fsea0 * fsno1
             488     2   p    v               flnd  = flnd0 * fsno1
             489     2               
             490     2               ! --- diffused sea surface albedo
             491     2               
             492     3   p    v               if (tsknf(i) >= 271.5) then
             493     3   p    v                  asevd = 0.06
             494     3   p    v                  asend = 0.06
             495     3   p    v               elseif (tsknf(i) < 271.1) then
             496     3   p    v                  asevd = 0.70
             497     3   p    v                  asend = 0.65
             498     3   p    v               else
             499     3   p    v                  a1 = (tsknf(i) - 271.1)**2
             500     3   p    v                  asevd = 0.7 - 4.0*a1
             501     3   p    v                  asend = 0.65 - 3.6875*a1
             502     3   p    v               endif
             503     2               
             504     2               ! --- diffused snow albedo, land area use input max snow albedo
             505     2               
             506     3   p    v               if (nint(slmsk(i)) == 2) then
             507     3   p    v                  ffw   = f_one - fice(i)
             508     4   p    v                  if (ffw < f_one) then
             509     4   p    v                     dtgd = max(f_zero, min(5.0, (con_ttp-tisfc(i)) ))
             510     4   p    v                     b1   = 0.03 * dtgd
             511     4   p    v                  else
             512     4   p    v                     b1 = f_zero
             513     4   p    v                  endif
             514     3               
             515     3   p    v                  b3   = 0.06 * ffw
             516     3   p    v                  asnvd = (0.70 + b1) * fice(i) + b3
             517     3   p    v                  asnnd = (0.60 + b1) * fice(i) + b3
             518     3   p    v                  asevd = 0.70        * fice(i) + b3
             519     3   p    v                  asend = 0.60        * fice(i) + b3
             520     3   p    v               else
             521     3   p    v                  asnvd = snoalb(i)
             522     3   p    v                  asnnd = snoalb(i)
             523     3   p    v               endif
             524     2               
             525     2               ! --- direct snow albedo
             526     2               
             527     3   p    v               if (nint(slmsk(i)) == 2) then
             528     4   p    v                 if (coszf(i) < 0.5) then
             529     4   p    v                    csnow = 0.5 * (3.0 / (f_one+4.0*coszf(i)) - f_one)
             530     4   p    v                    asnvb = min( 0.98, asnvd+(f_one-asnvd)*csnow )
             531     4   p    v                    asnnb = min( 0.98, asnnd+(f_one-asnnd)*csnow )
             532     4   p    v                 else
             533     4   p    v                   asnvb = asnvd
             534     4   p    v                   asnnb = asnnd
             535     4   p    v                 endif
             536     3   p    v               else
             537     3   p    v                 asnvb = snoalb(i)
             538     3   p    v                 asnnb = snoalb(i)
             539     3   p    v               endif
             540     2               
             541     2               ! --- direct sea surface albedo, use fanglin's zenith angle treatment
             542     2               
             543     3   p    v               if (coszf(i) > 0.0001) then
             544     3               
             545     3               !           rfcs = 1.89 - 3.34*coszf(i) + 4.13*coszf(i)*coszf(i)        &
             546     3               !    &           - 2.02*coszf(i)*coszf(i)*coszf(i)
             547     3   p    v                  rfcs = 1.775/(1.0+1.55*coszf(i))
             548     3               
             549     4   p    v                  if (tsknf(i) >= con_t0c) then
             550     4   p    v                    asevb = max(asevd, 0.026/(coszf(i)**1.7+0.065)            &
             551     4                    &              + 0.15 * (coszf(i)-0.1) * (coszf(i)-0.5)            &
             552     4                    &              * (coszf(i)-f_one))
             553     4   p    v                    asenb = asevb
             554     4   p    v                  else
             555     4   p    v                    asevb = asevd
             556     4   p    v                    asenb = asend
             557     4   p    v                  endif
             558     3   p    v               else
             559     3   p    v                  rfcs  = f_one
             560     3   p    v                  asevb = asevd
             561     3   p    v                  asenb = asend
             562     3   p    v               endif
             563     2               
             564     2   p    v               ab1bm = min(0.99, alnsf(i)*rfcs)
             565     2   p    v               ab2bm = min(0.99, alvsf(i)*rfcs)
             566     2   p    v               sfcalb(i,1) = ab1bm   *flnd + asenb*fsea + asnnb*fsno
             567     2   p    v               sfcalb(i,2) = alnwf(i)     *flnd + asend*fsea + asnnd*fsno
             568     2   p    v               sfcalb(i,3) = ab2bm   *flnd + asevb*fsea + asnvb*fsno
             569     2   p    v               sfcalb(i,4) = alvwf(i)     *flnd + asevd*fsea + asnvd*fsno
             570     2               
             571     2   p    v              enddo    ! end_do_i_loop
             572     1               
             573     1                     endif   ! end if_ialbflg
             574                     !
             575                           return
             576                     !...................................
             577                           end subroutine setalb

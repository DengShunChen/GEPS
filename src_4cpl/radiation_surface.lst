              74                           module module_radiation_surface    !
              75                     !........................................!
              76                     !
              77                           use physpara,          only : ialbflg, iemsflg, semis_file,       &
              78                          &                              kind_phys
              79                           use physcons,          only : con_t0c, con_ttp, con_pi, con_tice
              80                           use module_iounitdef,  only : niradsf
              81                     !
              82                           implicit   none
              83                     !
              84                           private
              85                     

               1                           subroutine gscond (im,ix,km,dt,prsl,ps,q,cwm,t          &
               2                           ,                  tp, qp, psp,tp1,qp1,psp1, u, lprnt, fwd)
               3                     !
               4                     !     ******************************************************************
               5                     !     *                                                                *
               6                     !     *  subroutine for grid-scale condensation & evaporation          *
               7                     !     *  for the mrf model at ncep.                                    *
               8                     !     *                                                                *
               9                     !     ******************************************************************
              10                     !     *                                                                *
              11                     !     *  created by:   q.  zhao         jan. 1995                      *
              12                     !     *  modified by:  h.-l. pan        sep. 1998                      *
              13                     !     *  modified by:  s. moorthi       aug. 1999, 2000                *
              14                     !     *  modified by:  h. juang         jun. 2004                      *
              15                     !     *                                                                *
              16                     !     *  references:                                                   *
              17                     !     *                                                                *
              18                     !     ******************************************************************
              19                     !
              20                     !     ************ important note *************
              21                     !     in this code vertical indexing runs from surface to top of the
              22                     !     model
              23                     !
              24                     !----------------------------------------------------------------------
              25                     !----------------------------------------------------------------------
              26                     !
              27                           implicit none
              28                     
              29                           real  psat, hvap, grav, hfus, ttp, rd, rv, cp, eps, epsm1
              30                           parameter(  psat = 6.1078e+2 )
              31                           parameter(  hvap = 2.5000e+6 )
              32                           parameter(  grav = 9.80665e+0 )
              33                           parameter(  hfus = 3.3358e+5 )
              34                           parameter(   ttp = 2.7316e+2 )
              35                           parameter(    rd = 2.8705e+2 )
              36                           parameter(    rv = 4.6150e+2 )
              37                           parameter(    cp = 1.0046e+3 )
              38                           parameter(   eps = rd/rv )
              39                           parameter( epsm1 = eps-1 )
              40                           real fpvs
              41                     !
              42                           real                   g,    h1,   h2, h1000                      &
              43                           ,                     d00,  d125,  d5,   elwv, eliv               &
              44                           ,                     epsq, tm10,  eliw, arcp                     &
              45                           ,                     a1,   r,     cpr,  rcpr, rcp
              46                           parameter (h1=1.e0,       h2=2.e0,               h1000=1000.0     &
              47                           ,          d00=0.e0,      d125=.125e0,           d5=0.5e0         &
              48                           ,          a1=psat                                                &
              49                           ,          elwv=hvap,     eliv=hvap+hfus, g=grav                  &
              50                           ,          epsq=2.e-12,   tm10=ttp-10.,   r=rd                    &
              51                           ,          cpr=cp*r,      rcpr=h1/cpr,    rcp=h1/cp)
              52                     !
              53                           integer im, ix, km
              54                           real                  q(ix,km),    t(ix,km),    cwm(ix,km)        &
              55                           ,                     prsl(ix,km), ps(im), dt                     &
              56                           ,                     tp(ix,km),   qp(ix,km),   psp(im)           &
              57                           ,                     tp1(ix,km),  qp1(ix,km),   psp1(im)         &
              58                           ,                     u(ix,km)                                    &
              59                           ,                     t0(ix,km),   q0(ix,km),   ps0(im)
              60                     !
              61                           real                   qi(im), qint(im), ccrik, e0                &
              62                           ,                      cond,   rdt, us, cclimit, climit           &
              63                           ,                      u00b,   u00t, tmt0, tmt15, qik, cwmik      &
              64                           ,                      ai, bi, qw, u00ik, tik, pres, pp0, fi      &
              65                           ,                      at, aq, ap, fiw, elv, qc, rqik             &
              66                           ,                      rqikk, tx1, tx2, tx3, es, qs               &
              67                           ,                      tsq, delq, condi, cone0, us00, ccrik1      &
              68                           ,                      aa, ab, ac, ad, ae, af, ag                 &
              69                           ,                      el2orc, albycp, vprs(im), rdt2
              70                           integer iw(im,km), i, k, iwik
              71                           logical lprnt,fwd
              72                     !
              73                     !--- merge qsatq in here
              74                           real vpsat(191),pqs,qqq,tem,t1
              75                           integer ic
              76                           data vpsat/                                                       &
              77                               9.67165e-05,  1.15983e-04,  1.38819e-04,  1.65835e-04,        &
              78                               1.97736e-04,  2.35339e-04,  2.79584e-04,  3.31553e-04,        &
              79                               3.92489e-04,  4.63820e-04,  5.47177e-04,  6.44430e-04,        &
              80                               7.57710e-04,  8.89450e-04,  1.04242e-03,  1.21975e-03,        &
              81                               1.42503e-03,  1.66230e-03,  1.93614e-03,  2.25172e-03,        &
              82                               2.61488e-03,  3.03222e-03,  3.51113e-03,  4.05995e-03,        &
              83                               4.68804e-03,  5.40589e-03,  6.22523e-03,  7.15922e-03,        &
              84                               8.22253e-03,  9.43153e-03,  1.08045e-02,  1.23617e-02,        &
              85                               1.41258e-02,  1.61219e-02,  1.83779e-02,  2.09244e-02,        &
              86                               2.37959e-02,  2.70300e-02,  3.06684e-02,  3.47573e-02,        &
              87                               3.93475e-02,  4.44947e-02,  5.02607e-02,  5.67130e-02,        &
              88                               6.39258e-02,  7.19807e-02,  8.09670e-02,  9.09823e-02,        &
              89                               1.02134e-01,  1.14538e-01,  1.28323e-01,                      &
              90                     !
              91                                             1.45280e-01,  1.64189e-01,  1.85241e-01,        &
              92                               2.08643e-01,  2.34615e-01,  2.63398e-01,  2.95248e-01,        &
              93                               3.30441e-01,  3.69270e-01,  4.12053e-01,  4.59124e-01,        &
              94                               5.10843e-01,  5.67591e-01,  6.29773e-01,  6.97819e-01,        &
              95                               7.72185e-01,  8.53352e-01,  9.41827e-01,  1.03814e+00,        &
              96                               1.14287e+00,  1.25659e+00,  1.37992e+00,  1.51352e+00,        &
              97                               1.65806e+00,  1.81424e+00,  1.98279e+00,  2.16447e+00,        &
              98                               2.36006e+00,  2.57039e+00,  2.79628e+00,  3.03858e+00,        &
              99                               3.29819e+00,  3.57599e+00,  3.87289e+00,  4.18982e+00,        &
             100                               4.52773e+00,  4.88753e+00,  5.27019e+00,  5.67664e+00,        &
             101                     !
             102                               6.10780e+00,  6.56617e+00,  7.05475e+00,  7.57526e+00,        &
             103                               8.12946e+00,  8.71922e+00,  9.34647e+00,  1.00132e+01,        &
             104                               1.07216e+01,  1.14739e+01,  1.22723e+01,  1.31192e+01,        &
             105                               1.40172e+01,  1.49688e+01,  1.59767e+01,  1.70438e+01,        &
             106                               1.81729e+01,  1.93672e+01,  2.06298e+01,  2.19639e+01,        &
             107                               2.33729e+01,  2.48605e+01,  2.64302e+01,  2.80858e+01,        &
             108                               2.98314e+01,  3.16708e+01,  3.36085e+01,  3.56487e+01,        &
             109                               3.77959e+01,  4.00548e+01,  4.24303e+01,  4.49274e+01,        &
             110                               4.75511e+01,  5.03069e+01,  5.32001e+01,  5.62365e+01,        &
             111                               5.94220e+01,  6.27625e+01,  6.62643e+01,  6.99337e+01,        &
             112                     !
             113                               7.37774e+01,  7.78022e+01,  8.20150e+01,  8.64231e+01,        &
             114                               9.10338e+01,  9.58548e+01,  1.00894e+02,  1.06159e+02,        &
             115                               1.11659e+02,  1.17401e+02,  1.23395e+02,  1.29650e+02,        &
             116                               1.36174e+02,  1.42978e+02,  1.50070e+02,  1.57461e+02,        &
             117                               1.65161e+02,  1.73180e+02,  1.81529e+02,  1.90218e+02,        &
             118                               1.99260e+02,  2.08665e+02,  2.18446e+02,  2.28613e+02,        &
             119                               2.39180e+02,  2.50159e+02,  2.61562e+02,  2.73404e+02,        &
             120                               2.85696e+02,  2.98453e+02,  3.11689e+02,  3.25418e+02,        &
             121                               3.39655e+02,  3.54414e+02,  3.69711e+02,  3.85560e+02,        &
             122                               4.01979e+02,  4.18982e+02,  4.36586e+02,  4.54808e+02,        &
             123                     !
             124                               4.73665e+02,  4.93175e+02,  5.13354e+02,  5.34221e+02,        &
             125                               5.55795e+02,  5.78093e+02,  6.01135e+02,  6.24940e+02,        &
             126                               6.49527e+02,  6.74918e+02,  7.01131e+02,  7.28188e+02,        &
             127                               7.56110e+02,  7.84918e+02,  8.14633e+02,  8.45278e+02,        &
             128                               8.76876e+02,  9.09448e+02,  9.43018e+02,  9.77609e+02,        &
             129                               1.01325e+03/
             130                     !
             131                           tem = 1./1.622
             132                     !
             133                     
             134                     !
             135                     !-----------------prepare constants for later uses-----------------
             136                     !
             137                     
             138                           el2orc = hvap*hvap / (rv*cp)
             139                           albycp = hvap / cp
             140                     !
             141                     ! for 2 delta t
             142                           rdt     = h1/dt
             143                     !
             144                     ! for tendency caculation ,2-time level was used, just need 1 dt
             145                           rdt2    = h1/dt*2.
             146                     !
             147                           us      = h1
             148                           cclimit = 1.0e-3
             149                           climit  = 1.0e-20
             150                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      iw
                                   <<< Loop-information  End >>>
             151     1  pp   4             do  i = 1, im
             152     1   p   4               iw(i,km) = d00
             153     1   p   4             enddo
             154                     !
             155                     !  check for first time step
             156                     !
             157     1                     if (tp(1,1) .lt. 1.) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, tp, tp1, qp1, qp
                                   <<< Loop-information  End >>>
             158     2  pp                   do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, tp, qp, tp1, qp1
                                   <<< Loop-information  End >>>
             159     3   p   2                 do i = 1, im
             160     3   p   2                   tp(i,k) = t(i,k)
             161     3   p   2                   qp(i,k) = max(q(i,k),epsq)
             162     3   p   2                   tp1(i,k) = t(i,k)
             163     3   p   2                   qp1(i,k) = max(q(i,k),epsq)
             164     3   p   2                 enddo
             165     2   p                   enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, psp, psp1
                                   <<< Loop-information  End >>>
             166     2  pp   2               do i = 1, im
             167     2   p   2                 psp(i)  = ps(i)
             168     2   p   2                 psp1(i)  = ps(i)
             169     2   p   2               enddo
             170     1                     endif
             171                     
             172                     !-----------------------------------------
             173                     !
             174                     !*************************************************************
             175                     !*******begining of  grid-scale condensation/evap. loop*******
             176                     !*************************************************************
             177                     !
             178                     !     do k = km-1,2,-1
             179     1                     do k = km,1,-1
             180     1               !       vprs(:) = 0.001 * fpvs(t(:,k))       ! fpvs in pa
             181     1               !-----------------------------------------------------------------------
             182     1               !------------------qw, qi and qint--------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, cwm, iw, prsl, qi, qint
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             183     2   s                   do i = 1, im
             184     2   m                     tmt0  = t(i,k)-273.16
             185     2   p                     tmt15 = min(tmt0,-15.)
             186     2   p                     qik   = max(q(i,k),epsq)
             187     2   p                     cwmik = max(cwm(i,k),climit)
             188     2               !
             189     2               !  the global qsat computation is done in cb
             190     2   p                     pres    = prsl(i,k)
             191     2               !fpvs
             192     2   m                      qw      = min(pres, 0.001 * fpvs(t(i,k)))
             193     2   p                      qw      = eps * qw / (pres + epsm1 * qw)
             194     2               !qsatq
             195     2               !          call qsatq(1,t(i,k),pres*10.,qw)  !prsl in unit of cb
             196     2               !         t1 = max(1.00001, min(190.999, t(i,k)-182.16))
             197     2               !         ic = int(t1)
             198     2               !         pqs = pres*10.
             199     2               !         qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic))  &
             200     2               !                                    *(t1-float(ic)))
             201     2               !!         qw = 0.622*qqq/(pqs-qqq)
             202     2               !          qw = 0.622*qqq/(pqs+epsm1*qqq)
             203     2               !
             204     2   p                     qw      = max(qw,epsq)
             205     2   p                     qi(i)   = qw
             206     2   p                     qint(i) = qw
             207     2               !-------------------ice-water id number iw------------------------------
             208     2               !
             209     2   p                     iw(i,k) = 0
             210     2               !
             211     3   p                    if(tmt0.lt.-15.0) then
             212     3   p                      u00ik = u(i,k)
             213     3   p                      fi    = qik - u00ik*qi(i)
             214     4   p                      if(fi.gt.d00.or.cwmik.gt.climit) then
             215     4   p                         iw(i,k) = 1
             216     4   p                      else
             217     4   p                        iw(i,k) = 0
             218     4   p                      end if
             219     3   p                    end if
             220     2               
             221     3   p                    if(tmt0.ge.0.0) then
             222     3   p                      iw(i,k) = 0
             223     3   p                    end if
             224     2               
             225     3   p                    if (tmt0 .lt. 0.0 .and. tmt0 .ge. -15.0) then
             226     3   p                      iw(i,k) = 0
             227     4   p                      if (k .lt. km) then
             228     4   p                      if (iw(i,k+1) .eq. 1 .and. cwmik .gt. climit) iw(i,k) = 1
             229     4   p                      endif
             230     3   p                    end if
             231     2               !
             232     2   p                   enddo
             233     1               
             234     1               !--------------condensation and evaporation of cloud--------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, cwm, t, u, prsl, psp, ps, iw, tp, qp
                                   <<<      qint, qi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 5  FILL 9
                                   <<<      SIMD&FP   : SPILL 12  FILL 19
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             235     2   s                   do i = 1, im
             236     2               !------------------------at, aq and dp/dt-------------------------------
             237     2   p                     qik   = max(q(i,k),epsq)
             238     2   p                     cwmik = max(cwm(i,k),climit)
             239     2   p                     iwik  = iw(i,k)
             240     2   p                     u00ik = u(i,k)
             241     2   p                     tik   = t(i,k)
             242     2   p                     pres  = prsl(i,k)   * h1000
             243     3   p                     if ( fwd ) then
             244     3                           pp0   = (pres / ps(i)) * psp1(i)
             245     3                           at    = (tik-tp1(i,k)) * rdt
             246     3                           aq    = (qik-qp1(i,k)) * rdt
             247     3   p                     else
             248     3   p                      pp0   = (pres / ps(i)) * psp(i)
             249     3   p                      at    = (tik-tp(i,k)) * rdt
             250     3   p                      aq    = (qik-qp(i,k)) * rdt
             251     3   p                     endif
             252     2   p                     ap    = (pres-pp0)    * rdt
             253     2               ! tik and tp just across 2-time level
             254     2               !         at    = (tik-tp(i,k)) * rdt2
             255     2               !         aq    = (qik-qp(i,k)) * rdt2
             256     2               !         ap    = (pres-pp0)    * rdt2
             257     2               !----------------the satuation specific humidity------------------------
             258     2   p                     fiw   = float(iwik)
             259     2   p                     elv   = (h1-fiw)*elwv    + fiw*eliv
             260     2   p                     qc    = (h1-fiw)*qint(i) + fiw*qi(i)
             261     2               !     if (lprnt) print *,' qc=',qc,' qint=',qint(i),' qi=',qi(i)
             262     2               !----------------the relative humidity----------------------------------
             263     3   p                     if(qc.le.1.0e-10) then
             264     3   p                       rqik=d00
             265     3   p                     else
             266     3   p                       rqik = qik/qc
             267     3   p                     endif
             268     2               !----------------cloud cover ratio ccrik--------------------------------
             269     3   p                     if (rqik .lt. u00ik) then
             270     3   p                        ccrik = d00
             271     3   p                     elseif(rqik.ge.us) then
             272     3   p                        ccrik = us
             273     3   p                     else
             274     3   p                        rqikk  = min(us,rqik)
             275     3   p                        ccrik = h1-sqrt((us-rqikk)/(us-u00ik))      ! (b) eq(11)
             276     3   p                     endif
             277     2               !-----------correct ccr if it is too small in large cwm regions--------
             278     2               !         if(ccrik.ge.0.01.and.ccrik.le.0.2.and
             279     2               !    &          .cwmik.ge.0.2e-3) then
             280     2               !          ccrik=min(1.0,cwmik*1.0e3)
             281     2               !         end if
             282     2               !----------------------------------------------------------------------
             283     2               !   if no cloud exists then evaporate any existing cloud condensate
             284     2               !----------------evaporation of cloud water-----------------------------
             285     2   p                     e0 = d00
             286     2               !
             287     3   p                     if (ccrik.le.cclimit.and.cwmik.gt.climit)  then
             288     3               !
             289     3               !!            if(iwik.eq.1 .and. t(i,k).le.248.16)then                         !begin test
             290     3               !!              tmt0  = t(i,k)-248.16
             291     3               !!              u00ik=u00ik*exp(0.0015*tmt0)
             292     3               !!            endif                                       !end test
             293     3               !
             294     3               !   first iteration - increment halved
             295     3               !
             296     3   s                       tx1 = tik
             297     3   s                       tx3 = qik
             298     3               !fpvs
             299     3               !pres in unit pa
             300     3   s                        es   = min(pres, fpvs(tx1))
             301     3   m                        qs   = u00ik * eps * es / (pres + epsm1*es)
             302     3               !qsatq
             303     3               !!           call qsatq(1,tx1,pres/100.,qs)     !pres in unit of pa
             304     3               !           t1 = max(1.00001, min(190.999, tx1-182.16))
             305     3               !           ic = int(t1)
             306     3               !           pqs = pres*0.01
             307     3               !           qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic))  &
             308     3               !                                    *(t1-float(ic)))
             309     3               !!            qs = 0.622*qqq/(pqs-qqq)
             310     3               !!            qs = 0.622*qqq/(pqs+epsm1*qqq)
             311     3               !            qs   = u00ik*qs
             312     3               !
             313     3   s                       tsq  = tx1 * tx1
             314     3   s                       delq = 0.5 * (qs - tx3) * tsq / (tsq + el2orc * qs)
             315     3               !
             316     3   s                       tx2   = delq
             317     3   s                       tx1   = tx1 - delq * albycp
             318     3   s                       tx3   = tx3 + delq
             319     3               !
             320     3               !   second iteration
             321     3               !
             322     3   s                        es   = min(pres, fpvs(tx1))
             323     3   s                        qs   = u00ik * eps * es / (pres + epsm1*es)
             324     3               !
             325     3               !!           call qsatq(1,tx1,pres/100.,qs)     !pres in unit of pa
             326     3               !           t1 = max(1.00001, min(190.999, tx1-182.16))
             327     3               !           ic = int(t1)
             328     3               !           pqs = pres*0.01
             329     3               !           qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic)) &
             330     3               !                                    *(t1-float(ic)))
             331     3               !           qs = 0.622*qqq/(pqs-qqq)
             332     3               !           qs = 0.622*qqq/(pqs+epsm1*qqq)
             333     3               !            qs   = u00ik*qs
             334     3               !
             335     3   s                       tsq  = tx1 * tx1
             336     3   s                       delq = (qs - tx3) * tsq / (tsq + el2orc * qs)
             337     3               !
             338     3   p                       tx2  = tx2 + delq
             339     3   s                       tx1  = tx1 - delq * albycp
             340     3   p                       tx3  = tx3 + delq
             341     3               !
             342     3               !   third iteration
             343     3               !fpvs
             344     3   m                        es   = min(pres, fpvs(tx1))
             345     3   p                        qs   = u00ik * eps * es / (pres + epsm1*es)
             346     3               !qsatq
             347     3               !!            call qsatq(1,tx1,pres/100.,qs)     !pres in unit of pa
             348     3               !           t1 = max(1.00001, min(190.999, tx1-182.16))
             349     3               !           ic = int(t1)
             350     3               !           pqs = pres*0.01
             351     3               !           qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic))  &
             352     3               !                                    *(t1-float(ic)))
             353     3               !!           qs = 0.622*qqq/(pqs-qqq)
             354     3               !!           qs = 0.622*qqq/(pqs+epsm1*qqq)
             355     3               !            qs   = u00ik*qs
             356     3               !
             357     3   s                       tsq  = tx1 * tx1
             358     3   p                       delq = (qs - tx3) * tsq / (tsq + el2orc * qs)
             359     3   p                       tx2  = tx2 + delq
             360     3               !
             361     3   p                       e0   = max(tx2*rdt, 0.0)
             362     3               
             363     3               !           e0 = max(qc*(u00ik-rqik)*rdt, 0.0)
             364     3   p                       e0 = min(cwmik*rdt,   e0)
             365     3   p                       e0 = max(0.0,e0)
             366     3   p                     end if
             367     2               !
             368     2               !   if cloud cover > 0.2 condense water vapor in to cloud condensate
             369     2               !-----------the eqs. for cond. has been reorganized to reduce cpu------
             370     2               !
             371     2   p                     cond = d00
             372     2               !         if (ccrik .gt. 0.20 .and. qc .gt. epsq) then
             373     3   p                     if (ccrik .gt. cclimit .and. qc .gt. epsq) then
             374     3   p                        us00   = us  - u00ik
             375     3   p                        ccrik1 = 1.0 - ccrik
             376     3   p                        aa     = eps*elv*pres*qik
             377     3   p                        ab     = ccrik*ccrik1*qc*us00
             378     3   p                        ac     = ab + 0.5*cwmik
             379     3   p                        ad     = ab * ccrik1
             380     3   p                        ae     = cpr*tik*tik
             381     3   p                        af     = ae * pres
             382     3   p                        ag     = aa * elv
             383     3   p                        ai     = cp * aa
             384     3   p                        cond   = (ac-ad)*(af*aq-ai*at+ae*qik*ap)/(ac*(af+ag))
             385     3               !-----------check & correct if over condensation occurs-----------------
             386     3   p                        condi  = (qik   -u00ik   *qc*1.0)*rdt
             387     3   p                        cond   = min(cond, condi)
             388     3               !----------check & correct if supersatuation is too high----------------
             389     3               !             qtemp=qik-max(0.,(cond-e0))*dt
             390     3               !             if(qc.le.1.0e-10) then
             391     3               !               rqtmp=0.0
             392     3               !             else
             393     3               !               rqtmp=qtemp/qc
             394     3               !             end if
             395     3               !             if(rqtmp.ge.1.10) then
             396     3               !               cond=(qik-1.10*qc)*rdt
             397     3               !             end if
             398     3               !-----------------------------------------------------------------------
             399     3   p                        cond = max(cond, d00)
             400     3               !-------------------update of t, q and cwm------------------------------
             401     3               !
             402     3   p                     end if
             403     2   p                     cone0    = (cond-e0) * dt
             404     2   p                     cwm(i,k) = cwm(i,k) + cone0
             405     2   p                     t(i,k)   = t(i,k)   + elv*rcp*cone0
             406     2   p                     q(i,k)   = q(i,k)   - cone0
             407     2   p                   enddo                                  ! end of i-loop!
             408     1               
             409     1                     enddo                                    ! end of k-loop!
             410                     
             411                     !
             412                     !*********************************************************************
             413                     !****************end of the condensation/evaporation loop*************
             414                     !*********************************************************************
             415                     !----------------store t, q, ps for next time step

 External subroutine subprogram "gfcst"
  (inc)(line-no.)(nest)(optimize)
               1                     #ifndef TIMCOMCPL
               2                           program gfcst
               3                     #else
               4                           subroutine gfcst(compid, mpi_comm_mct)
               5                           use gfs_cpl, only:gfs_cpl_init
               6                     #endif
               7                     !
               8                     ! main program of CWBGFS
               9                     ! modify to f90 bt C-H Lee and sort by River Chen in 2015
              10                     !
              11                           use param
              12                           use const
              13                     !
              14                           implicit none
              15                     
              16                           integer  no
              17                     #ifdef TIMCOMCPL
              18                           integer, intent(in) :: compid, mpi_comm_mct
              19                     #endif
              20                     
              21                     !
              22                     !  logical io units:
              23                     !
              24                     !  input namelist file = 'namlsts'
              25                     !  date-time-group file = 'crdate'
              26                     !  output directives file = 'ocards'
              27                     !  model history file = 'cwbout'
              28                     !  output model history for diabatic variables='phyout'
              29                     !  input file of path/file names='filist'
              30                     !
              31                     
              32                     #ifdef TIMCOMCPL
              33                           call mpe_init(mpi_comm_mct)
              34                     #else
              35                           call mpe_init
              36                     #endif
              37                     !
              38                     !     get model constants
              39                     !
              40                           call cons
              41                     #ifdef TIMCOMCPL
              42                           call gfs_cpl_init(compid)
              43                     #endif
              44                     !
              45                     !  read in initial data and prepare for initialization/forecast
              46                     !
              47                           call getrdy
              48                     !
              49                     !  initialization would be done here, taking initial spectral fields
              50                     !  out of 'getrdy' and preparing them for 'intgrt'.  for identification
              51                     !  purposes only, initialization history file data is assigned
              52                     !  "tau"=1.0.
              53                     !
              54     1                     if (donnmi.and.taui.lt.1.0) then
              55     1                        no=2*((jtrun+1)/2)+(jtrun/2)+10
              56     1                        call initial(no,jtrun,jtmax,lev,nx,my,my_max,mlmax)
              57     1                     endif
              58                     !
              59                     !  recompute eigen value for semi-implicit scheme
              60                     !
              61                           call matrix_hybrid_cwb ( cp,sigma,dsigma,ptop,ptmeans,tmeans,spalm   &
              62                                       , eigval,evecin,evectr,arrhyd,arsddt,pmcor,tmcor )
              63                     !
              64                     !  time integration
              65                     !
              66                     #ifdef TIMCOMCPL
              67                           call intgrt(compid)
              68                     !
              69                           call mpe_finalize
              70                     #else
              71                           if ( ttl ) then
              72                             call intgrt
              73                           else
              74                             call intgrt_3tl
              75                           endif
              76                     
              77                     !
              78                           call mpe_finalize
              79                           call dmsexit(0)
              80                     !
              81                           stop
              82                     #endif
              83                           end


             528     1               !xb110> 20190711
             529     2   p    v             if (.not.ldcum(jl)) then
             530     2   p    v                kcbot(jl) = -1
             531     2   p    v                kctop(jl) = -1
             532     2   p    v             end if
             533     1               !xb110< 20190711
             534     1               
             535     2   p    v              if ( ldcum(jl) ) then
             536     2   p    v                wup(jl) = max(1.e-2,wup(jl)/max(1.,zdpmean(jl)))
             537     2   p    v                wup(jl) = sqrt(2.*wup(jl))
             538     2   p    v              end if
             539     1   p    v            end do
             540                     
             541                           return
             542                           end subroutine cuasc_n


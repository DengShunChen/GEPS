 External subroutine subprogram "cuasc_n"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine cuasc_n &
               2                          &    (nxj,      klon,     klev,     klevp1,   klevm1,   ptenh,&
               3                          &     pqenh,    pxenh,    puen,     pven,     pten,     pqen,&
               4                          &     pqsen,    pgeo,     pgeoh,    pap,      paph,&
               5                          &     pqte,     pverv,    klwmin,   ldcum,    phcbase,&
               6                          &     ktype,    klab,     ptu,      pqu,      plu,&
               7                          &     puu,      pvu,      pmfu,     pmfub,    pmfus,  &
               8                          &     pmfuq,    pmful,    plude,    pdmfup,   kcbot,  &
               9                          &     kctop,    kctop0,   kcum,     ztmst,    pqsenh, &
              10                          &     plglac,   lndj,     wup,      wbase,    kdpl,   &
              11                          &     pmfude_rate, zoentr1)
              12                     !     this routine does the calculations for cloud ascents
              13                     !     for cumulus parameterization
              14                     !     m.tiedtke         e.c.m.w.f.     7/86 modif.  12/89
              15                     !     y.wang            iprc           11/01 modif.
              16                     !     c.zhang           iprc           05/12 modif.
              17                     !***purpose.
              18                     !   --------
              19                     !          to produce cloud ascents for cu-parametrization
              20                     !          (vertical profiles of t,q,l,u and v and corresponding
              21                     !           fluxes as well as precipitation rates)
              22                     !***interface
              23                     !   ---------
              24                     !          this routine is called from *cumastr*.
              25                     !***method.
              26                     !  --------
              27                     !          lift surface air dry-adiabatically to cloud base
              28                     !          and then calculate moist ascent for
              29                     !          entraining/detraining plume.
              30                     !          entrainment and detrainment rates differ for
              31                     !          shallow and deep cumulus convection.
              32                     !          in case there is no penetrative or shallow convection
              33                     !          check for possibility of mid level convection
              34                     !          (cloud base values calculated in *cubasmc*)
              35                     !***externals
              36                     !   ---------
              37                     !          *cuadjtqn* adjust t and q due to condensation in ascent
              38                     !          *cuentrn*  calculate entrainment/detrainment rates
              39                     !          *cubasmcn* calculate cloud base values for midlevel convection
              40                     !***reference
              41                     !   ---------
              42                     !          (tiedtke,1989)
              43                     !***input variables:
              44                     !       ptenh [ztenh] - environ temperature on half levels. (cuini)
              45                     !       pqenh [zqenh] - env. specific humidity on half levels. (cuini)
              46                     !       puen - environment wind u-component. (mssflx)
              47                     !       pven - environment wind v-component. (mssflx)
              48                     !       pten - environment temperature. (mssflx)
              49                     !       pqen - environment specific humidity. (mssflx)
              50                     !       pqsen - environment saturation specific humidity. (mssflx)
              51                     !       pgeo - geopotential. (mssflx)
              52                     !       pgeoh [zgeoh] - geopotential on half levels, (mssflx)
              53                     !       pap - pressure in pa.  (mssflx)
              54                     !       paph - pressure of half levels. (mssflx)
              55                     !       pqte - moisture convergence (delta q/delta t). (mssflx)
              56                     !       pverv - large scale vertical velocity (omega). (mssflx)
              57                     !       klwmin [ilwmin] - level of minimum omega. (cuini)
              58                     !       klab [ilab] - level label - 1: sub-cloud layer.
              59                     !                                   2: condensation level (cloud base)
              60                     !       pmfub [zmfub] - updraft mass flux at cloud base. (cumastr)
              61                     !***variables modified by cuasc:
              62                     !       ldcum - logical denoting profiles. (cubase)
              63                     !       ktype - convection type - 1: penetrative  (cumastr)
              64                     !                                 2: stratocumulus (cumastr)
              65                     !                                 3: mid-level  (cuasc)
              66                     !       ptu - cloud temperature.
              67                     !       pqu - cloud specific humidity.
              68                     !       plu - cloud liquid water (moisture condensed out)
              69                     !       puu [zuu] - cloud momentum u-component.
              70                     !       pvu [zvu] - cloud momentum v-component.
              71                     !       pmfu - updraft mass flux.
              72                     !       pmfus [zmfus] - updraft flux of dry static energy. (cubasmc)
              73                     !       pmfuq [zmfuq] - updraft flux of specific humidity.
              74                     !       pmful [zmful] - updraft flux of cloud liquid water.
              75                     !       plude - liquid water returned to environment by detrainment.
              76                     !       pdmfup [zmfup] -
              77                     !       kcbot - cloud base level. (cubase)
              78                     !       kctop - cloud top level
              79                     !       kctop0 [ictop0] - estimate of cloud top. (cumastr)
              80                     !       kcum [icum] - flag to control the call
              81                     !-------------------------------------------------------------------
              82                       USE mo_constants,     ONLY: g,       & ! gravity acceleration
              83                                                   cpd,     & ! specific heat at constant pressure
              84                                                   rd,      & ! gas constant for dry air
              85                                                   rv,      & !   idem      for water vapour
              86                                                   alv,     & ! latent heat for vaporisation
              87                                                   vtmpc1,  & ! vtmpc1=rv/rd-1
              88                                                   rcpd,    & ! rcpd=1./cpd
              89                                                   zrg,     & ! 1.0/g
              90                                                   ralfdcp, &
              91                                                   rtber,   &
              92                                                   rtice
              93                       USE mo_cumulus_flux,  ONLY: lmfdudv, & !
              94                                                   lmfmid,  & !
              95                                                   cmfcmin, & !
              96                                                   cprcon_n,  & !xb110
              97                                                   cmfctop
              98                     
              99                     !-------------------------------------------------------------------
             100                           implicit none
             101                     
             102                           integer  klev,klon,klevp1,klevm1,nxj
             103                           real     ptenh(klon,klev),       pqenh(klon,klev), &
             104                          &         pxenh(klon,klev),                       &
             105                          &         puen(klon,klev),        pven(klon,klev),&
             106                          &         pten(klon,klev),        pqen(klon,klev),&
             107                          &         pgeo(klon,klev),        pgeoh(klon,klevp1),&
             108                          &         pap(klon,klev),         paph(klon,klevp1),&
             109                          &         pqsen(klon,klev),       pqte(klon,klev),&
             110                          &         pverv(klon,klev),       pqsenh(klon,klev)
             111                           real     ptu(klon,klev),         pqu(klon,klev),&
             112                          &         puu(klon,klev),         pvu(klon,klev),&
             113                          &         pmfu(klon,klev),        zph(klon),&
             114                          &         pmfub(klon),            &
             115                          &         pmfus(klon,klev),       pmfuq(klon,klev),&
             116                          &         plu(klon,klev),         plude(klon,klev),&
             117                          &         pmful(klon,klev),       pdmfup(klon,klev)
             118                           real     zdmfen(klon),           zdmfde(klon),&
             119                          &         zmfuu(klon),            zmfuv(klon),&
             120                          &         zpbase(klon),           zqold(klon)
             121                           real     phcbase(klon),          zluold(klon)
             122                           real     zprecip(klon),          zlrain(klon,klev)
             123                           real     zbuo(klon,klev),        kup(klon,klev)
             124                           real     wup(klon)
             125                           real     wbase(klon),            zodetr(klon,klev)
             126                           real     plglac(klon,klev)
             127                     
             128                           real     eta(klon),dz(klon)
             129                     
             130                           integer  klwmin(klon),           ktype(klon),&
             131                          &         klab(klon,klev),        kcbot(klon),&
             132                          &         kctop(klon),            kctop0(klon)
             133                           integer  lndj(klon)
             134                           logical  ldcum(klon),            loflag(klon)
             135                           logical  llo2,llo3,              llo1(klon)
             136                     
             137                           integer  kdpl(klon)
             138                           real     zoentr(klon),           zdpmean(klon)
             139                           real     pdmfen(klon,klev),      pmfude_rate(klon,klev)
             140                           real     ushear(klon,klev),      zoentr1(klon,klev)
             141                           integer  jl,jk
             142                           integer  ikb,icum,itopm2,ik,icall,is,kcum,jlm,jll
             143                           integer  jlx(klon)
             144                           real     ztmst,zcons2,zfacbuo,zprcdgw,z_cwdrag,z_cldmax,z_cwifrac,z_cprc2
             145                           real     zmftest,zmfmax,zqeen,zseen,zscde,zqude
             146                           real     zmfusk,zmfuqk,zmfulk
             147                           real     zbc,zbe,zkedke,zmfun,zwu,zprcon,zdt,zcbf,zzco
             148                           real     zlcrit,zdfi,zc,zd,zint,zlnew,zvw,zvi,zalfaw,zrold
             149                           real     zrnew,zz,zdmfeu,zdmfdu,dp
             150                           real     zfac,zbuoc,zdkbuo,zdken,zvv,zarg,zchange,zxe,zxs,zdshrd
             151                           real     atop1,atop2,abot
             152                           real     foealfa,ushmax
             153                     !--------------------------------
             154                     !*    1.       specify parameters
             155                     !--------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             156     1  pp                 do jk = 1, klev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ushear, zoentr1
                                   <<< Loop-information  End >>>
             157     2   p   2v              do jl = 1,nxj
             158     2   p   2v                zoentr1(jl,jk) = 0.
             159     2   p   2v                ushear(jl,jk) = 0.
             160     2   p   2v              enddo
             161     1   p                 enddo
             162                           zcons2=3./(g*ztmst)
             163                           zfacbuo = 0.5/(1.+0.5)
             164                           zprcdgw = cprcon_n*zrg
             165                           z_cldmax = 5.e-3
             166                           z_cwifrac = 0.5
             167                           z_cprc2 = 0.5
             168                           z_cwdrag = (3.0/8.0)*0.506/0.2
             169                     !---------------------------------
             170                     !     2.        set default values
             171                     !---------------------------------
             172                     !xb110>
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zph, jlx, kctop
                                   <<< Loop-information  End >>>
             173        pp   2v            kctop = 0.
             174         p   2v            jlx   = 0
             175         p   2v            zph   = 0.
             176                           zbuoc = 0.
             177                     !xb110<
             178                           llo3 = .false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.22, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, pmfub, kcbot, ktype, pqu, zluold
                                   <<<      wup, zdpmean, zoentr
                                   <<< Loop-information  End >>>
             179     1  pp    v             do jl = 1, nxj
             180     1   p    v              zluold(jl)=0.
             181     1   p    v              wup(jl)=0.
             182     1   p    v              zdpmean(jl)=0.
             183     1   p    v              zoentr(jl)=0.
             184     2   p    v              if(.not.ldcum(jl)) then
             185     2   p    v                ktype(jl)=0
             186     2   p    v                kcbot(jl) = -1
             187     2   p    v                pmfub(jl) = 0.
             188     2   p    v                pqu(jl,klev) = 0.
             189     2   p    v              end if
             190     1   p    v            end do
             191                     
             192                     ! initialize variout quantities
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, ktype, paph, klab, pmfude_rate

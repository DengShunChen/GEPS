                                   <<<      plglac, plude, pmful, pmfuq, pmfus
                                   <<<      kctop0
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      kcbot: 2, pmfu: 2, plu: 2
                                   <<< Loop-information  End >>>
             193     1                     do jk=1,klev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 217
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.24, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paph, ldcum, klab, kctop0, pmfude_rate
                                   <<<      pdmfen, kup, zbuo, zlrain, pdmfup
                                   <<<      plglac, plude, pmful, pmfuq, ktype
                                   <<<      pmfus
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      pmfu: 4, plu: 4, kcbot: 2
                                   <<< Loop-information  End >>>
             194     2  pp    v             do jl = 1, nxj
             195     2   p    v                if(jk.ne.kcbot(jl)) plu(jl,jk)=0.
             196     2   p    v                pmfu(jl,jk)=0.
             197     2   p    v                pmfus(jl,jk)=0.
             198     2   p    v                pmfuq(jl,jk)=0.
             199     2   p    v                pmful(jl,jk)=0.
             200     2   p    v                plude(jl,jk)=0.
             201     2   p    v                plglac(jl,jk)=0.
             202     2   p    v                pdmfup(jl,jk)=0.
             203     2   p    v                zlrain(jl,jk)=0.
             204     2   p    v                zbuo(jl,jk)=0.
             205     2   p    v                kup(jl,jk)=0.
             206     2   p    v                pdmfen(jl,jk) = 0.
             207     2   p    v                pmfude_rate(jl,jk) = 0.
             208     2   p    v                if(.not.ldcum(jl).or.ktype(jl).eq.3) klab(jl,jk)=0
             209     2   p    v                if(.not.ldcum(jl).and.paph(jl,jk).lt.4.e4) kctop0(jl)=jk
             210     2   p    v            end do
             211     1                     end do
             212                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 229
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 213,219)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ktype, kcbot, ldcum, kctop
                                   <<< Loop-information  End >>>
             213     1  pp    s             do jl = 1, nxj
             214     1   p    m              if ( ktype(jl) == 3 ) ldcum(jl) = .false.
             215     1   p    v            end do
             216                     !------------------------------------------------
             217                     !     3.0      initialize values at cloud base level
             218                     !------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             219     1                      do jl = 1, nxj
             220     1                       kctop(jl)=kcbot(jl)
             221     2                       if(ldcum(jl)) then
             222     2                         ikb = kcbot(jl)
             223     2                         kup(jl,ikb) = 0.5*wbase(jl)**2
             224     2                         pmfu(jl,ikb) = pmfub(jl)
             225     2                         pmfus(jl,ikb) = pmfub(jl)*(cpd*ptu(jl,ikb)+pgeoh(jl,ikb))
             226     2                         pmfuq(jl,ikb) = pmfub(jl)*pqu(jl,ikb)
             227     2                         pmful(jl,ikb) = pmfub(jl)*plu(jl,ikb)
             228     2                       end if
             229     1                     end do
             230                     !
             231                     !-----------------------------------------------------------------
             232                     !     4.       do ascent: subcloud layer (klab=1) ,clouds (klab=2)
             233                     !              by doing first dry-adiabatic ascent and then
             234                     !              by adjusting t,q and l accordingly in *cuadjtqn*,
             235                     !              then check for buoyancy and set flags accordingly
             236                     !-----------------------------------------------------------------
             237                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kdpl, ptenh, pqenh, ptu, zluold, pqu
                                   <<<      plu, jlx
                                   <<< Loop-information  End >>>
             238     1                     do jk=klevm1,3,-1
             239     1               !             specify cloud base values for midlevel convection
             240     1               !             in *cubasmc* in case there is not already convection
             241     1               ! ---------------------------------------------------------------------
             242     1                     ik=jk
             243     1                     call cubasmc_n&
             244     1                    &    (nxj,      klon,     klev,     klevm1,   ik,      pten,&
             245     1                    &     pqen,     pqsen,    puen,     pven,    pverv,&
             246     1                    &     pgeo,     pgeoh,    ldcum,   ktype,   klab,  zlrain,&
             247     1                    &     pmfu,     pmfub,    kcbot,   ptu,&
             248     1                    &     pqu,      plu,      puu,     pvu,      pmfus,&
             249     1                    &     pmfuq,    pmful,    pdmfup)
             250     1                     is = 0
             251     1                     jlm = 0
                                   <<< Loop-information Start >>>

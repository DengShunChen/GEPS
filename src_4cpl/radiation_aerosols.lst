            3017     6   p   fv                        tt0  = cm * ex00
            3018     6   p   fs                        ext1 = ext1 + tt0
            3019     6   p   fv                        sca1 = sca1 + cm * sc00
            3020     6   p   fv                        ssa1 = ssa1 + cm * ss00 * ex00
            3021     6   p   fv                        asy1 = asy1 + cm * as00 * sc00
            3022     6   p   fv                      endif  lab_if_ic

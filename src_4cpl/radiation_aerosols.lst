             216                     ! --------------------------------------------------------------------- !
             217                     !   section-2 : module variables for stratospheric volcanic aerosols    !
             218                     !               from historical data (sato et al. 1993)                 !
             219                     ! --------------------------------------------------------------------- !
             220                     
             221                     !  ---  parameter constants:
             222                           integer, parameter :: minvyr = 1850    ! lower lim (year) data available
             223                           integer, parameter :: maxvyr = 1999    ! upper lim (year) data available
             224                     
             225                     !  ---  monthly, 45-deg lat-zone aerosols data set in subroutine 'aer_init'
             226                           integer, allocatable, save :: ivolae(:,:,:)
             227                     
             228                     !  ---  static control variables:
             229                           integer :: kyrstr, kyrend, kyrsav, kmonsav
             230                     
             231                     ! --------------------------------------------------------------------- !
             232                     !   section-3 : module variables for opac climatological aerosols       !
             233                     !               optical properties (hess et al. 1989)                   !
             234                     ! --------------------------------------------------------------------- !
             235                     
             236                     !  ---  parameters and constants:
             237                           integer, parameter :: nxc = 5    ! num of max componets in a profile
             238                           integer, parameter :: nae = 7    ! num of aerosols profile structures
             239                           integer, parameter :: ndm = 5    ! num of atmos aerosols domains
             240                           integer, parameter :: imxae = 72 ! num of lon-points in glb aeros data set
             241                           integer, parameter :: jmxae = 37 ! num of lat-points in glb aeros data set
             242                           integer, parameter :: naerbnd=61 ! num of bands for clim aer data (opac)
             243                           integer, parameter :: nrhlev =8  ! num of rh levels for rh-dep components
             244                           integer, parameter :: ncm1 = 6   ! num of rh independent aeros species
             245                           integer, parameter :: ncm2 = 4   ! num of rh dependent aeros species
             246                           integer, parameter :: ncm  = ncm1+ncm2
             247                     
             248                           real (kind=kind_phys), dimension(nrhlev), save :: rhlev
             249                           data  rhlev (:) / 0.0, 0.5, 0.7, 0.8, 0.9, 0.95, 0.98, 0.99 /
             250                     
             251                     !  ---  the following arrays are for climatological data that are
             252                     !           allocated and read in subroutine 'clim_aerinit'.
             253                     !   - global aerosol distribution:
             254                     !      haer  (ndm,nae)  - scale height of aerosols (km)
             255                     !      prsref(ndm,nae)  - ref pressure lev (sfc to toa) in mb (100pa)
             256                     !      sigref(ndm,nae)  - ref sigma lev (sfc to toa)
             257                     
             258                           real (kind=kind_phys), save, dimension(ndm,nae) :: haer, prsref,  &
             259                          &                                                   sigref
             260                     
             261                     !  ---  the following arrays are allocate and setup in subr 'clim_aerinit'
             262                     !   - for relative humidity independent aerosol optical properties:
             263                     !      species : insoluble        (inso); soot             (soot);
             264                     !                mineral nuc mode (minm); mineral acc mode (miam);
             265                     !                mineral coa mode (micm); mineral transport(mitr).
             266                     !      extrhi(ncm1,nswlwbd) - extinction coefficient for sw+lw spectral band
             267                     !      scarhi(ncm1,nswlwbd) - scattering coefficient for sw+lw spectral band
             268                     !      ssarhi(ncm1,nswlwbd) - single scattering albedo for sw+lw spectral band
             269                     !      asyrhi(ncm1,nswlwbd) - asymmetry parameter for sw+lw spectral band
             270                     !   - for relative humidity dependent aerosol optical properties:
             271                     !      species : water soluble    (waso); sea salt acc mode(ssam);
             272                     !                sea salt coa mode(sscm); sulfate droplets (suso).
             273                     !      rh level: 00%, 50%, 70%, 80%, 90%, 95%, 98%, 99%
             274                     !      extrhd(nrhlev,ncm2,nswlwbd) - extinction coefficient for sw+lw band
             275                     !      scarhd(nrhlev,ncm2,nswlwbd) - scattering coefficient for sw+lw band
             276                     !      ssarhd(nrhlev,ncm2,nswlwbd) - single scattering albedo for sw+lw band
             277                     !      asyrhd(nrhlev,ncm2,nswlwbd) - asymmetry parameter for sw+lw band
             278                     !   - for stratospheric aerosols optical properties:
             279                     !      extstra(nswlwbd)            - extinction coefficient for sw+lw band
             280                     
             281                           real (kind=kind_phys), allocatable, save, dimension(:,:)   ::     &
             282                          &       extrhi, scarhi, ssarhi, asyrhi
             283                           real (kind=kind_phys), allocatable, save, dimension(:,:,:) ::     &
             284                          &       extrhd, scarhd, ssarhd, asyrhd
             285                           real (kind=kind_phys), allocatable, save, dimension(:)     ::     &
             286                          &       extstra
             287                     
             288                     !  ---  the following arrays are calculated in subr 'clim_aerinit'
             289                     !   - for topospheric aerosol profile distibution:
             290                     !      kprfg (    imxae*jmxae)   - aeros profile index
             291                     !      idxcg (nxc*imxae*jmxae)   - aeros component index
             292                     !      cmixg (nxc*imxae*jmxae)   - aeros component mixing ratio
             293                     !      denng ( 2 *imxae*jmxae)   - aerosols number density
             294                     
             295                           real (kind=kind_phys), dimension(nxc,imxae,jmxae), save :: cmixg
             296                           real (kind=kind_phys), dimension( 2 ,imxae,jmxae), save :: denng
             297                           integer,               dimension(nxc,imxae,jmxae), save :: idxcg
             298                           integer,               dimension(    imxae,jmxae), save :: kprfg
             299                     
             300                     ! --------------------------------------------------------------------- !
             301                     !   section-4 : module variables for gocart aerosol optical properties  !
             302                     ! --------------------------------------------------------------------- !
             303                     
             304                     !  ---  parameters and constants:
             305                     !   - kcm, kcm1, kcm2 are determined from subroutine 'set_aerspc'
             306                     !     integer, parameter :: kaerbnd=61 ! num of bands for aer data (gocart)
             307                     !     integer, parameter :: krhlev =36 ! num of rh levels for rh-dep components
             308                     !*    integer, parameter :: kcm1 = 8   ! num of rh independent aer !species
             309                     !*    integer, parameter :: kcm2 = 5   ! num of rh dependent aer species
             310                     !*    integer, parameter :: kcm  = kcm1 + kcm2
             311                     !     integer, save      :: kcm1 = 0   ! num of rh indep aerosols (set in subr set_aerspc)
             312                     !     integer, save      :: kcm2 = 0   ! num of rh dep aerosols   (set in subr set_aerspc)
             313                     !     integer, save      :: kcm        ! =kcm1+kcm2               (set in subr set_aerspc)
             314                     
             315                     !     real (kind=kind_phys), dimension(krhlev) :: rhlev_grt             &
             316                     !     data  rhlev_grt (:)/ .00, .05, .10, .15, .20, .25, .30, .35,      &
             317                     !    &      .40, .45, .50, .55, .60, .65, .70, .75, .80, .81, .82,      &
             318                     !    &      .83, .84, .85, .86, .87, .88, .89, .90, .91, .92, .93,      &
             319                     !    &      .94, .95, .96, .97, .98, .99 /
             320                     
             321                     !  ---  the following arrays are allocate and setup in subr 'gocrt_aerinit'
             322                     !  ------  gocart aerosol specification    ------
             323                     !  =>  transported aerosol species:
             324                     !      du (5-bins)
             325                     !      ss (4 bins for climo mode and 5 bins for fcst mode)
             326                     !      su (dms, so2, so4, msa)
             327                     !      oc (phobic, philic) and bc (phobic, philic)
             328                     !  =>  species and lumped species for aerosol optical properties
             329                     !      du (5-bins, with 4 sub-groups in the submicron bin )
             330                     !      ss (ssam for submicron, sscm for coarse mode)
             331                     !      su (so4)
             332                     !      oc (phobic, philic) and bc (phobic, philic)
             333                     !  =>  specification used for aerosol optical properties luts
             334                     !      du (8 bins)
             335                     !      ss (ssam, sscm)
             336                     !      su (suso)
             337                     !      oc (waso) and bc (soot)
             338                     !
             339                     !   - spectral band structure:
             340                     !      iendwv_grt(kaerbnd)      - ending wavenumber (cm**-1) for each band
             341                     !   - relative humidity independent aerosol optical properties:
             342                     !   ===> species : dust (8 bins)
             343                     !      rhidext0_grt(kaerbnd,kcm1) - extinction coefficient
             344                     !      rhidssa0_grt(kaerbnd,kcm1) - single scattering albedo
             345                     !      rhidasy0_grt(kaerbnd,kcm1) - asymmetry parameter
             346                     !   - relative humidity dependent aerosol optical properties:
             347                     !   ===> species : soot, suso, waso, ssam, sscm
             348                     !      rhdpext0_grt(kaerbnd,krhlev,kcm2) - extinction coefficient
             349                     !      rhdpssa0_grt(kaerbnd,krhlev,kcm2) - single scattering albedo
             350                     !      rhdpasy0_grt(kaerbnd,krhlev,kcm2) - asymmetry parameter
             351                     
             352                     !     integer,               allocatable, dimension(:) :: iendwv_grt
             353                     !     real (kind=kind_phys), allocatable, dimension(:,:)  ::            &
             354                     !    &                       rhidext0_grt, rhidssa0_grt, rhidasy0_grt
             355                     !     real (kind=kind_phys), allocatable, dimension(:,:,:)::            &
             356                     !    &                       rhdpext0_grt, rhdpssa0_grt, rhdpasy0_grt
             357                     
             358                     !   - relative humidity independent aerosol optical properties:
             359                     !      extrhi_grt(kcm1,nswlwbd) - extinction coefficient for sw+lw spectral band
             360                     !      ssarhi_grt(kcm1,nswlwbd) - single scattering albedo for sw+lw spectral band
             361                     !      asyrhi_grt(kcm1,nswlwbd) - asymmetry parameter for sw+lw spectral band
             362                     !   - relative humidity dependent aerosol optical properties:
             363                     !      extrhd_grt(krhlev,kcm2,nswlwbd) - extinction coefficient for sw+lw band
             364                     !      ssarhd_grt(krhlev,kcm2,nswlwbd) - single scattering albedo for sw+lw band
             365                     !      asyrhd_grt(krhlev,kcm2,nswlwbd) - asymmetry parameter for sw+lw band
             366                     
             367                     !     real (kind=kind_phys), allocatable, save, dimension(:,:)   ::     &
             368                     !    &       extrhi_grt, ssarhi_grt, asyrhi_grt
             369                     !     real (kind=kind_phys), allocatable, save, dimension(:,:,:) ::     &
             370                     !    &       extrhd_grt, ssarhd_grt, asyrhd_grt
             371                     
             372                     ! --------------------------------------------------------------------- !
             373                     !   section-5 : module variables for gocart aerosol climo data set      !
             374                     ! --------------------------------------------------------------------- !
             375                     !     this version only supports geos3-gocart data set (jan 2010)
             376                     !     modified to support geos4-gocart data set        (may 2010)
             377                     !
             378                     !  geos3-gocart vs geos4-gocart
             379                     !  (1) use the same module variables
             380                     !      imxg,jmxg,kmxg,nmxg,psclmg,dmclmg,geos_rlon,geos_rlat
             381                     !  (2) similarity between geos3 and geos 4:
             382                     !      identical lat/lon grids and aerosol specification;
             383                     !      direction of vertical index is bottom-up (sfc to toa)
             384                     !  (3) difference between geos3 and geos4
             385                     !      vertical coordinate (sigma for geos3/hybrid_sigma_pressure for geos4)
             386                     !      aerosol units (mass concentration for geos3/mixing ratio for geos4)
             387                     
             388                     !     integer, parameter :: imxg = 144 ! num of lon-points in geos dataset
             389                     !     integer, parameter :: jmxg = 91  ! num of lat-points in geos dataset
             390                     !     integer, parameter :: kmxg = 30  ! num of vertical layers in geos dataset
             391                     !*    integer, parameter :: nmxg = 12  ! num of gocart aer spec for opt calc
             392                     !     integer, save      :: nmxg       ! to be determined by set_aerspc
             393                     
             394                     !     real (kind=kind_phys), parameter :: dltx = 360.0 / float(imxg)
             395                     !     real (kind=kind_phys), parameter :: dlty = 180.0 / float(jmxg-1)
             396                     
             397                     !  --- the following arrays are allocated and setup in 'rd_gocart_clim'
             398                     !   - geos-gocart climo data (input dataset)
             399                     !     psclmg  - pressure in cb                   imxg*jmxg*kmxg
             400                     !     dmclmg  - aerosol dry mass in g/m3         imxg*jmxg*kmxg*nmxg
             401                     !               or aerosol mixing ratio in mol/mol or kg/kg
             402                     
             403                     !     real (kind=kind_phys),allocatable, save:: psclmg(:,:,:),          &
             404                     !    &                                          dmclmg(:,:,:,:)
             405                     
             406                     !   - geos-gocart lat/lon arrays
             407                     !     real (kind=kind_phys), allocatable, save, dimension(:)   ::       &
             408                     !    &                       geos_rlon, geos_rlat
             409                     
             410                     !   - control flag for gocart climo data set
             411                     !     xxxx as default; ver3 for geos3; ver4 for geos4; 0000 for unknown data
             412                     !     character*4, save  :: gocart_climo = 'xxxx'
             413                     
             414                     !   - molecular wght of gocart aerosol species
             415                     !     real (kind=kind_io4), allocatable :: molwgt(:)
             416                     
             417                     !! ---  the following are for diagnostic purpose to output aerosol optical depth
             418                     !       aod from 10 components are grouped into 5 major different species:
             419                     !      1:dust (inso,minm,miam,micm,mitr); 2:black carbon (soot)
             420                     !      3:water soluble (waso);            4:sulfate (suso);      5:sea salt (ssam,sscm)
             421                     !
             422                     !      idxspc (ncm)         - index conversion array
             423                     !      lspcaod              - logical flag for aod from individual species
             424                     !
             425                     !     integer, dimension(ncm) :: idxspc
             426                     !     data  idxspc / 1, 2, 1, 1, 1, 1, 3, 5, 5, 4 /
             427                     !     logical, save :: lspcaod = .false.
             428                     !
             429                     !   - wvn550 is the wavenumber (1/cm) of wavelenth 550nm for diagnostic aod output
             430                     !     nv_aod is the sw spectral band covering wvn550 (comp in aer_init)
             431                     !
             432                     !     real (kind=kind_phys), parameter :: wvn550 = 1.0e4/0.55
             433                     !     integer, save      :: nv_aod = 1
             434                     
             435                     !  ---  public interfaces
             436                     
             437                           public aer_init, aer_update, setaer
             438                     
             439                     
             440                     ! =================
             441                           contains
             442                     ! =================
             443                     
             444                     !-----------------------------------
             445                           subroutine aer_init                                               &
             446                     !...................................
             447                     !  ---  inputs:
             448                          &     ( nlay, me, myrank )
             449                     !  ---  outputs: ( to module variables )
             450                     
             451                     !  ==================================================================  !
             452                     !                                                                      !
             453                     !  aer_init is the initialization program to set up necessary          !
             454                     !    parameters and working arrays.                                    !
             455                     !                                                                      !
             456                     !  inputs:                                                             !
             457                     !     nlay    - number of model vertical layers  (not used)            !
             458                     !     me      - print message control flag                             !
             459                     !                                                                      !
             460                     !  outputs: (to module variables)                                      !
             461                     !                                                                      !
             462                     !  external module variables: (in physpara)                            !
             463                     !     iaermdl - tropospheric aerosol model scheme flag                 !
             464                     !               =0 opac-clim; =1 gocart-clim, =2 gocart-prognostic     !
             465                     !     lalwflg - logical lw aerosols effect control flag                !
             466                     !               =t compute lw aerosol optical prop                     !
             467                     !     laswflg - logical sw aerosols effect control flag                !
             468                     !               =t compute sw aerosol optical prop                     !
             469                     !     lavoflg - logical stratosphere volcanic aerosol control flag     !
             470                     !               =t include volcanic aerosol effect                     !
             471                     !     lalw1bd = logical lw aeros propty 1 band vs multi-band cntl flag !
             472                     !               =t use 1 broad band optical property                   !
             473                     !               =f use multi bands optical property                    !
             474                     !                                                                      !
             475                     !  module constants:                                                   !
             476                     !     nwvsol  - num of wvnum regions where solar flux is constant      !
             477                     !     nwvtot  - total num of wave numbers used in sw spectrum          !
             478                     !     nwvtir  - total num of wave numbers used in the ir region        !
             479                     !     nswbnd  - total number of sw spectral bands                      !
             480                     !     nlwbnd  - total number of lw spectral bands                      !
             481                     !                                                                      !
             482                     !  usage:    call aer_init                                             !
             483                     !                                                                      !
             484                     !  subprograms called:  clim_aerinit, gcrt_aerinit,                    !
             485                     !                       wrt_aerlog, set_volcaer, set_spectrum,         !
             486                     !                                                                      !
             487                     !  ==================================================================  !
             488                     
             489                     !  ---  inputs:
             490                           integer,  intent(in) :: nlay, me, myrank
             491                     
             492                     !  ---  output: ( none )
             493                     
             494                     !  ---  locals:
             495                           real (kind=kind_phys), dimension(nwvtot) :: solfwv        ! one wvn sol flux
             496                           real (kind=kind_phys), dimension(nwvtir) :: eirfwv        ! one wvn ir flux
             497                     !
             498                     !===>  ...  begin here
             499                     !
             500                           kyrstr  = 1
             501                           kyrend  = 1
             502                           kyrsav  = 1
             503                           kmonsav = 1
             504                     
             505                     !  --- ...  write aerosol parameter configuration to output logs
             506                     
             507     1                     if ( me == 0 .and. myrank == 0) then
             508     1               
             509     1                       call wrt_aerlog      ! write aerosol param info to log file
             510     1               !  ---  inputs:   (in scope variables)
             511     1               !  ---  outputs:  ( none )
             512     1               
             513     1                     endif
             514                     
             515                           if ( iaerflg == 0 ) return      ! return without any aerosol calculations
             516                     
             517                     !  --- ...  in sw, aerosols optical properties are computed for each radiation
             518                     !           spectral band; while in lw, optical properties can be calculated
             519                     !           for either only one broad band or for each of the lw radiation bands
             520                     
             521     1                     if ( laswflg ) then
             522     1                       nswbnd = nbdsw
             523     1                     else
             524     1                       nswbnd = 0
             525     1                     endif
             526                     
             527     1                     if ( lalwflg ) then
             528     2                       if ( lalw1bd ) then
             529     2                         nlwbnd = 1
             530     2                       else
             531     2                         nlwbnd = nbdlw
             532     2                       endif
             533     1                     else
             534     1                       nlwbnd = 0
             535     1                     endif
             536                     
             537                           nswlwbd = nswbnd + nlwbnd
             538                     
             539     1                     if ( iaerflg /= 100 ) then
             540     1               
             541     1               !  --- ...  set up spectral one wavenumber solar/ir fluxes
             542     1               
             543     1                       call set_spectrum
             544     1               !  ---  inputs:   (module constants)
             545     1               !  ---  outputs:  (in-scope variables)
             546     1               
             547     1               !  --- ...  invoke tropospheric aerosol initialization
             548     1               
             549     2                       if ( iaermdl == 0 ) then                    ! opac-climatology scheme
             550     2               
             551     2                         call clim_aerinit                                             &
             552     2               !  ---  inputs:
             553     2                    &     ( solfwv, eirfwv, me                                         &
             554     2               !  ---  outputs:
             555     2                    &     )
             556     2               
             557     2               !       elseif ( iaermdl == 1 ) then                ! gocart-climatology scheme
             558     2               !       elseif ( iaermdl==1 .or. iaermdl==2 ) then  ! gocart-clim/prog scheme
             559     2               
             560     2               !         call gcrt_climinit
             561     2               
             562     2               !       elseif ( iaermdl == 2 ) then                ! gocart-prognostic scheme
             563     2               
             564     2               !         call gcrt_aerinit
             565     2               
             566     2                       else
             567     3                         if ( me == 0 .and. myrank == 0) then
             568     3                           print *,'  !!! error in aerosol model scheme selection',    &
             569     3                    &              ' iaermdl =',iaermdl
             570     3                           stop
             571     3                         endif
             572     2                       endif
             573     1               
             574     1                     endif    ! end if_iaerflg_block
             575                     
             576                     !  --- ...  invoke stratosperic volcanic aerosol initialization
             577                     
             578     1                     if ( lavoflg ) then
             579     1               
             580     1                       call set_volcaer
             581     1               !  ---  inputs:  (module variables)
             582     1               !  ---  outputs: (module variables)
             583     1               
             584     1                     endif    ! end if_lavoflg_block
             585                     
             586                     
             587                     ! =================
             588                           contains
             589                     ! =================
             590                     
             591                     !--------------------------------
             592                           subroutine wrt_aerlog
             593                     !................................
             594                     !  ---  inputs:    (in scope variables)
             595                     !  ---  outputs:   ( none )
             596                     
             597                     !  ==================================================================  !
             598                     !                                                                      !
             599                     !  subprogram : wrt_aerlog                                             !
             600                     !                                                                      !
             601                     !    write aerosol parameter configuration to run log file.            !
             602                     !                                                                      !
             603                     !  ====================  defination of variables  ===================  !
             604                     !                                                                      !
             605                     !  external module variables:  (in physpara)                           !
             606                     !   iaermdl  - aerosol scheme flag: 0:opac-clm; 1:gocart-clim;         !
             607                     !                                   2:gocart-prog                      !
             608                     !   iaerflg  - aerosol effect control flag: 3-digits (volc,lw,sw)      !
             609                     !   lalwflg  - toposphere lw aerosol effect: =f:no; =t:yes             !
             610                     !   laswflg  - toposphere sw aerosol effect: =f:no; =t:yes             !
             611                     !   lavoflg  - stratospherer volcanic aeros effect: =f:no; =t:yes      !
             612                     !                                                                      !
             613                     !  outputs: ( none )                                                   !
             614                     !                                                                      !
             615                     !  subroutines called: none                                            !
             616                     !                                                                      !
             617                     !  usage:    call wrt_aerlog                                           !
             618                     !                                                                      !
             619                     !  ==================================================================  !
             620                     
             621                     !  ---  inputs: ( none )
             622                     !  ---  output: ( none )
             623                     !  ---  locals:
             624                     
             625                     !
             626                     !===>  ...  begin here
             627                     !
             628                           if ( me == 0 .and. myrank == 0) print *, vtagaer    ! print out version tag
             629                     
             630     1                     if ( iaermdl == 0 ) then
             631     1                     if ( me == 0 .and. myrank == 0)&
             632     1                    &  print *,' - using opac-seasonal climatology for tropospheric',  &
             633     1                    &          ' aerosol effect'
             634     1                     elseif ( iaermdl == 1 ) then
             635     1                     if ( me == 0 .and. myrank == 0)&
             636     1                       print *,' - using gocart-climatology for tropospheric',         &
             637     1                    &          ' aerosol effect'
             638     1                     elseif ( iaermdl == 2 ) then
             639     1                     if ( me == 0 .and. myrank == 0)&
             640     1                       print *,' - using gocart-prognostic aerosols for tropospheric', &
             641     1                    &          ' aerosol effect'
             642     1                     else
             643     1                     if ( me == 0 .and. myrank == 0)&
             644     1                       print *,' !!! error in selection of aerosol model scheme',      &
             645     1                    &          ' iaer_mdl =',iaermdl
             646     1                       stop
             647     1                     endif   ! end_if_iaermdl_block
             648                     
             649                           if ( me == 0 .and. myrank == 0)&
             650                           print *,'   iaer=',iaerflg,'  lw-trop-aer=',lalwflg,              &
             651                          &        '  sw-trop-aer=',laswflg,'  volc-aer=',lavoflg
             652                     
             653     1                     if ( iaerflg <= 0 ) then        ! turn off all aerosol effects
             654     1                       if ( me == 0 .and. myrank == 0)&
             655     1                       print *,' - no tropospheric/volcanic aerosol effect included'
             656     1                       if ( me == 0 .and. myrank == 0)&
             657     1                       print *,'      input values of aerosol optical properties to'   &
             658     1                    &         ,' both sw and lw radiations are set to zeros'
             659     1                     else
             660     2                       if ( iaerflg >= 100 ) then    ! incl stratospheric volcanic aerosols
             661     2                         if ( me == 0 .and. myrank == 0)&
             662     2                         print *,' - include stratospheric volcanic aerosol effect'
             663     2                       else                       ! no stratospheric volcanic aerosols
             664     2                         if ( me == 0 .and. myrank == 0)&
             665     2                         print *,' - no stratospheric volcanic aerosol effect'
             666     2                       endif
             667     1               
             668     2                       if ( laswflg ) then          ! chcek for sw effect
             669     2                         if ( me == 0 .and. myrank == 0)&
             670     2                         print *,'   - compute multi-band aerosol optical'             &
             671     2                    &           ,' properties for sw input parameters'
             672     2                       else
             673     2                     if ( me == 0 .and. myrank == 0)&
             674     2                         print *,'   - no sw radiation aerosol effect, values of'      &
             675     2                    &           ,' aerosol properties to sw input are set to zeros'
             676     2                       endif
             677     1               
             678     2                       if ( lalwflg ) then          ! check for lw effect
             679     3                         if ( lalw1bd ) then
             680     3                           if ( me == 0 .and. myrank == 0)&
             681     3                           print *,'   - compute 1 broad-band aerosol optical'         &
             682     3                    &           ,' properties for lw input parameters'
             683     3                         else
             684     3                           if ( me == 0 .and. myrank == 0)&
             685     3                           print *,'   - compute multi-band aerosol optical'           &
             686     3                    &           ,' properties for lw input parameters'
             687     3                         endif
             688     2                       else
             689     2                         if ( me == 0 .and. myrank == 0)&
             690     2                         print *,'   - no lw radiation aerosol effect, values of'      &
             691     2                    &           ,' aerosol properties to lw input are set to zeros'
             692     2                       endif
             693     1                     endif     ! end if_iaerflg_block
             694                     !
             695                           return
             696                     !................................
             697                           end subroutine wrt_aerlog
             698                     !--------------------------------
             699                     
             700                     
             701                     !--------------------------------
             702                           subroutine set_spectrum
             703                     !................................
             704                     !  ---  inputs:   (module constants)
             705                     !  ---  outputs:  (in-scope variables)
             706                     
             707                     !  ==================================================================  !
             708                     !                                                                      !
             709                     !  subprogram : set_spectrum                                           !
             710                     !                                                                      !
             711                     !    define the one wavenumber solar fluxes based on toa solar spectral!
             712                     !    distrobution, and define the one wavenumber ir fluxes based on    !
             713                     !    black-body emission distribution at a predefined temperature.     !
             714                     !                                                                      !
             715                     !  ====================  defination of variables  ===================  !
             716                     !                                                                      !
             717                     !  inputs:  (module constants)                                         !
             718                     !   nwvtot           - total num of wave numbers used in sw spectrum   !
             719                     !   nwvtir           - total num of wave numbers used in the ir region !
             720                     !                                                                      !
             721                     !  outputs: (in-scope variables)                                       !
             722                     !   solfwv(nwvtot)   - solar flux for each individual wavenumber (w/m2)!
             723                     !   eirfwv(nwvtir)   - ir flux(273k) for each individual wavenum (w/m2)!
             724                     !                                                                      !
             725                     !  subroutines called: none                                            !
             726                     !                                                                      !
             727                     !  usage:    call set_spectrum                                         !
             728                     !                                                                      !
             729                     !  ==================================================================  !
             730                     
             731                     !  ---  inputs: (module constants)
             732                     !     integer :: nwvtot, nwvtir
             733                     
             734                     !  ---  output: (in-scope variables)
             735                     !     real (kind=kind_phys), dimension(nwvtot) :: solfwv        ! one wvn sol flux
             736                     !     real (kind=kind_phys), dimension(nwvtir) :: eirfwv        ! one wvn ir flux
             737                     
             738                     !  ---  locals:
             739                           real (kind=kind_phys) :: soltot, tmp1, tmp2, tmp3
             740                     
             741                           integer :: nb, nw, nw1, nw2, nmax, nmin
             742                     !
             743                     !===>  ...  begin here
             744                     !
             745                     !     nmax = min( nwvtot, nint( maxval(wvnsw2) ))
             746                     !     nmin = max( 1,      nint( minval(wvnsw1) ))
             747                     
             748                     !  ---  check print
             749                     !     print *,' minwvn, maxwvn = ',nmin, nmax
             750                     !  --- ...  define the one wavenumber solar fluxes based on toa solar
             751                     !           spectral distribution
             752                     
             753                     !     soltot1 = f_zero
             754                     !     soltot  = f_zero
             755     1                     do nb = 1, nwvsol
             756     2                       if ( nb == 1 ) then
             757     2                         nw1 = 1
             758     2                       else
             759     2                         nw1 = nw1 + nwvns0(nb-1)
             760     2                       endif
             761     1               
             762     1                       nw2 = nw1 + nwvns0(nb) - 1
             763     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      solfwv
                                   <<< Loop-information  End >>>
             764     2  pp   4v              do nw = nw1, nw2
             765     2   p   4v                solfwv(nw) = s0intv(nb)
             766     2               !         soltot1 = soltot1 + s0intv(nb)
             767     2               !         if ( nw >= nmin .and. nw <= nmax ) then
             768     2               !           soltot = soltot + s0intv(nb)
             769     2               !         endif
             770     2   p   4v              enddo
             771     1                     enddo
             772                     
             773                     !  --- ...  define the one wavenumber ir fluxes based on black-body
             774                     !           emission distribution at a predefined temperature
             775                     
             776                           tmp1 = 2.0 * con_pi * con_plnk * (con_c**2)
             777                           tmp2 = con_plnk * con_c / (con_boltz * con_t0c)
             778                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 43
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 64, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eirfwv
                                   <<< Loop-information  End >>>
             779     1  pp    v            do nw = 1, nwvtir
             780     1   p    v              tmp3 = 100.0 * nw
             781     1   p    v              eirfwv(nw) = (tmp1 * tmp3**3) / (exp(tmp2*tmp3) - 1.0)
             782     1   p    v            enddo
             783                     !
             784                           return
             785                     !................................
             786                           end subroutine set_spectrum
             787                     !--------------------------------
             788                     
             789                     
             790                     !-----------------------------
             791                           subroutine set_volcaer
             792                     !.............................
             793                     !  ---  inputs:   ( none )
             794                     !  ---  outputs:  (module variables)
             795                     
             796                     !  ==================================================================  !
             797                     !                                                                      !
             798                     !  subprogram : set_volcaer                                            !
             799                     !                                                                      !
             800                     !    this is the initialization progrmam for stratospheric volcanic    !
             801                     !    aerosols.                                                         !
             802                     !                                                                      !
             803                     !  subroutines called: none                                            !
             804                     !                                                                      !
             805                     !  usage:    call set_volcaer                                          !
             806                     !                                                                      !
             807                     !  ==================================================================  !
             808                     
             809                     !  ---  inputs: (none)
             810                     
             811                     !  ---  output: (module variables)
             812                     !     integer :: ivolae(:,:,:)
             813                     
             814                     !  ---  locals:
             815                     !
             816                     !===>  ...  begin here
             817                     !
             818                     !  ---  allocate data space
             819                     
             820     1                     if ( .not. allocated(ivolae) ) then
             821     1                       allocate ( ivolae(12,4,10) )   ! for 12-mon,4-lat_zone,10-year
             822     1                     endif
             823                     !
             824                           return
             825                     !................................
             826                           end subroutine set_volcaer
             827                     !--------------------------------
             828                     !
             829                     !...................................
             830                           end subroutine aer_init
             831                     !-----------------------------------
             832                     
             833                     
             834                     !-----------------------------------
             835                           subroutine clim_aerinit                                           &
             836                     !...................................
             837                     !  ---  inputs:
             838                          &     ( solfwv, eirfwv, me                                         &
             839                     !  ---  outputs:
             840                          &     )
             841                     
             842                     !  ==================================================================  !
             843                     !                                                                      !
             844                     !  clim_aerinit is the opac-climatology aerosol initialization program !
             845                     !  to set up necessary parameters and working arrays.                  !
             846                     !                                                                      !
             847                     !  inputs:                                                             !
             848                     !   solfwv(nwvtot)   - solar flux for each individual wavenumber (w/m2)!
             849                     !   eirfwv(nwvtir)   - ir flux(273k) for each individual wavenum (w/m2)!
             850                     !   me               - print message control flag                      !
             851                     !                                                                      !
             852                     !  outputs: (to module variables)                                      !
             853                     !                                                                      !
             854                     !  external module variables: (in physpara)                            !
             855                     !     iaerflg - abc 3-digit integer aerosol flag (abc:volc,lw,sw)      !
             856                     !               a: =0 use background stratospheric aerosol             !
             857                     !                  =1 incl stratospheric vocanic aeros (minvyr-maxvyr) !
             858                     !               b: =0 no topospheric aerosol in lw radiation           !
             859                     !                  =1 include tropspheric aerosols for lw radiation    !
             860                     !               c: =0 no topospheric aerosol in sw radiation           !
             861                     !                  =1 include tropspheric aerosols for sw radiation    !
             862                     !     lalwflg - logical lw aerosols effect control flag                !
             863                     !               =t compute lw aerosol optical prop                     !
             864                     !     laswflg - logical sw aerosols effect control flag                !
             865                     !               =t compute sw aerosol optical prop                     !
             866                     !     lalw1bd = logical lw aeros propty 1 band vs multi-band cntl flag !
             867                     !               =t use 1 broad band optical property                   !
             868                     !               =f use multi bands optical property                    !
             869                     !                                                                      !
             870                     !  module constants:                                                   !
             871                     !     nwvsol  - num of wvnum regions where solar flux is constant      !
             872                     !     nwvtot  - total num of wave numbers used in sw spectrum          !
             873                     !     nwvtir  - total num of wave numbers used in the ir region        !
             874                     !     nswbnd  - total number of sw spectral bands                      !
             875                     !     nlwbnd  - total number of lw spectral bands                      !
             876                     !     naerbnd - number of bands for climatology aerosol data           !
             877                     !     ncm1    - number of rh independent aeros species                 !
             878                     !     ncm2    - number of rh dependent aeros species                   !
             879                     !                                                                      !
             880                     !  usage:    call clim_aerinit                                         !
             881                     !                                                                      !
             882                     !  subprograms called:  set_aercoef, optavg                            !
             883                     !                                                                      !
             884                     !  ==================================================================  !
             885                     
             886                     !  ---  inputs:
             887                           real (kind=kind_phys), dimension(:) :: solfwv        ! one wvn sol flux
             888                           real (kind=kind_phys), dimension(:) :: eirfwv        ! one wvn ir flux
             889                     
             890                           integer,  intent(in) :: me
             891                     
             892                     !  ---  output: ( none )
             893                     
             894                     !  ---  locals:
             895                           real (kind=kind_phys), dimension(naerbnd,ncm1)       ::           &
             896                          &       rhidext0, rhidsca0, rhidssa0, rhidasy0
             897                           real (kind=kind_phys), dimension(naerbnd,nrhlev,ncm2)::           &
             898                          &       rhdpext0, rhdpsca0, rhdpssa0, rhdpasy0
             899                           real (kind=kind_phys), dimension(naerbnd)            :: straext0
             900                     
             901                           real (kind=kind_phys), dimension(nswbnd,naerbnd) :: solwaer
             902                           real (kind=kind_phys), dimension(nswbnd)         :: solbnd
             903                           real (kind=kind_phys), dimension(nlwbnd,naerbnd) :: eirwaer
             904                           real (kind=kind_phys), dimension(nlwbnd)         :: eirbnd
             905                     
             906                           integer, dimension(nswbnd) :: nv1, nv2
             907                           integer, dimension(nlwbnd) :: nr1, nr2
             908                     !
             909                     !===>  ...  begin here
             910                     !
             911                     !  --- ...  invoke tropospheric aerosol initialization
             912                     
             913                           call set_aercoef
             914                     !  ---  inputs:   (in-scope variables, module constants)
             915                     !  ---  outputs:  (module variables)
             916                     
             917                     
             918                     ! =================
             919                           contains
             920                     ! =================
             921                     
             922                     !--------------------------------
             923                           subroutine set_aercoef
             924                     !................................
             925                     !  ---  inputs:   (in-scope variables, module constants)
             926                     !  ---  outputs:  (module variables)
             927                     
             928                     !  ==================================================================  !
             929                     !                                                                      !
             930                     !  subprogram : set_aercoef                                            !
             931                     !                                                                      !
             932                     !    this is the initialization progrmam for climatological aerosols   !
             933                     !                                                                      !
             934                     !    the program reads and maps the pre-tabulated aerosol optical      !
             935                     !    spectral data onto corresponding sw radiation spectral bands.     !
             936                     !                                                                      !
             937                     !  ====================  defination of variables  ===================  !
             938                     !                                                                      !
             939                     !  inputs:  (in-scope variables, module constants)                     !
             940                     !   solfwv(:)    - real, solar flux for individual wavenumber (w/m2)   !
             941                     !   eirfwv(:)    - real, lw flux(273k) for individual wavenum (w/m2)   !
             942                     !   me           - integer, select cpu number as print control flag    !
             943                     !                                                                      !
             944                     !  outputs: (to the module variables)                                  !
             945                     !                                                                      !
             946                     !  external module variables:  (in physpara)                           !
             947                     !   lalwflg   - module control flag for lw trop-aer: =f:no; =t:yes     !
             948                     !   laswflg   - module control flag for sw trop-aer: =f:no; =t:yes     !
             949                     !   aeros_file- external aerosol data file name                        !
             950                     !                                                                      !
             951                     !  internal module variables:                                          !
             952                     !     imxae   - number of longitude points in global aeros data set    !
             953                     !     jmxae   - number of latitude points in global aeros data set     !
             954                     !     wvnsw1,wvnsw2 (nswstr:nswend)                                    !
             955                     !             - start/end wavenumbers for each of sw bands             !
             956                     !     wvnlw1,wvnlw2 (     1:nbdlw)                                     !
             957                     !             - start/end wavenumbers for each of lw bands             !
             958                     !     nswlwbd - total num of bands (sw+lw) for aeros optical properties!
             959                     !     nswbnd  - number of sw spectral bands actually invloved          !
             960                     !     nlwbnd  - number of lw spectral bands actually invloved          !
             961                     !     niaercm - unit number for reading input data set                 !
             962                     !     extrhi  - extinction coef for rh-indep aeros         ncm1*nswlwbd!
             963                     !     scarhi  - scattering coef for rh-indep aeros         ncm1*nswlwbd!
             964                     !     ssarhi  - single-scat-alb for rh-indep aeros         ncm1*nswlwbd!
             965                     !     asyrhi  - asymmetry factor for rh-indep aeros        ncm1*nswlwbd!
             966                     !     extrhd  - extinction coef for rh-dep aeros    nrhlev*ncm2*nswlwbd!
             967                     !     scarhd  - scattering coef for rh-dep aeros    nrhlev*ncm2*nswlwbd!
             968                     !     ssarhd  - single-scat-alb for rh-dep aeros    nrhlev*ncm2*nswlwbd!
             969                     !     asyrhd  - asymmetry factor for rh-dep aeros   nrhlev*ncm2*nswlwbd!
             970                     !                                                                      !
             971                     !  major local variables:                                              !
             972                     !   for handling spectral band structures                              !
             973                     !     iendwv   - ending wvnum (cm**-1) for each band  naerbnd          !
             974                     !   for handling optical properties of rh independent species (ncm1)   !
             975                     !         1. insoluble        (inso); 2. soot             (soot);      !
             976                     !         3. mineral nuc mode (minm); 4. mineral acc mode (miam);      !
             977                     !         5. mineral coa mode (micm); 6. mineral transport(mitr).      !
             978                     !     rhidext0 - extinction coefficient             naerbnd*ncm1       !
             979                     !     rhidsca0 - scattering coefficient             naerbnd*ncm1       !
             980                     !     rhidssa0 - single scattering albedo           naerbnd*ncm1       !
             981                     !     rhidasy0 - asymmetry parameter                naerbnd*ncm1       !
             982                     !   for handling optical properties of rh ndependent species (ncm2)    !
             983                     !         1. water soluble    (waso); 2. sea salt acc mode(ssam);      !
             984                     !         3. sea salt coa mode(sscm); 4. sulfate droplets (suso).      !
             985                     !         rh level (nrhlev): 00%, 50%, 70%, 80%, 90%, 95%, 98%, 99%    !
             986                     !     rhdpext0 - extinction coefficient             naerbnd,nrhlev,ncm2!
             987                     !     rhdpsca0 - scattering coefficient             naerbnd,nrhlev,ncm2!
             988                     !     rhdpssa0 - single scattering albedo           naerbnd,nrhlev,ncm2!
             989                     !     rhdpasy0 - asymmetry parameter                naerbnd,nrhlev,ncm2!
             990                     !   for handling optical properties of stratospheric bkgrnd aerosols   !
             991                     !     straext0 - extingction coefficients             naerbnd          !
             992                     !                                                                      !
             993                     !  usage:    call set_aercoef                                          !
             994                     !                                                                      !
             995                     !  subprograms called:  optavg                                         !
             996                     !                                                                      !
             997                     !  ==================================================================  !
             998                     !
             999                     !  ---  inputs:  ( none )
            1000                     !  ---  output: ( none )
            1001                     
            1002                     !  ---  locals:
            1003                           integer, dimension(naerbnd) :: iendwv
            1004                     
            1005                           integer :: i, j, k, m, mb, ib, ii, id, iw, iw1, iw2
            1006                     
            1007                           real (kind=kind_phys) :: sumsol, sumir
            1008                     
            1009                           logical :: file_exist
            1010                           character :: cline*80
            1011                     !
            1012                     !===>  ...  begin here
            1013                     !
            1014                     !  --- ...  reading climatological aerosols data
            1015                     
            1016                           inquire (file=aeros_file, exist=file_exist)
            1017                     
            1018     1                     if ( file_exist ) then
            1019     1                       close (niaercm)
            1020     1                       open  (unit=niaercm,file=aeros_file,status='old',               &
            1021     1                    &        form='formatted')
            1022     1                       rewind (niaercm)
            1023     1                     else
            1024     1                       print *,'    requested aerosol data file "',aeros_file,         &
            1025     1                    &           '" not found!'
            1026     1                       print *,'    *** stopped in subroutine aero_init !!'
            1027     1                       stop
            1028     1                     endif     ! end if_file_exist_block
            1029                     
            1030                     !  --- ...  skip monthly global distribution
            1031                     
            1032     1                     do m = 1, 12
            1033     1                       read (niaercm,12) cline
            1034     1                 12    format(a80/)
            1035     1               
            1036     2                       do j = 1, jmxae
            1037     3   s    s                do i = 1, imxae
            1038     3   s    s                  read(niaercm,*) id
            1039     3   s    s                enddo
            1040     2                       enddo
            1041     1                     enddo   ! end do_m_block
            1042                     
            1043                     !  --- ...  aloocate and input aerosol optical data
            1044                     
            1045     1                     if ( .not. allocated( extrhi ) ) then
            1046     1                       allocate ( extrhi (       ncm1,nswlwbd) )
            1047     1                       allocate ( scarhi (       ncm1,nswlwbd) )
            1048     1                       allocate ( ssarhi (       ncm1,nswlwbd) )
            1049     1                       allocate ( asyrhi (       ncm1,nswlwbd) )
            1050     1                       allocate ( extrhd (nrhlev,ncm2,nswlwbd) )
            1051     1                       allocate ( scarhd (nrhlev,ncm2,nswlwbd) )
            1052     1                       allocate ( ssarhd (nrhlev,ncm2,nswlwbd) )
            1053     1                       allocate ( asyrhd (nrhlev,ncm2,nswlwbd) )
            1054     1                       allocate ( extstra(            nswlwbd) )
            1055     1                     endif
            1056                     
            1057                           read(niaercm,21) cline   ! ending wave num for 61 aeros spectral bands
            1058                       21  format(a80)
            1059                           read(niaercm,22) iendwv(:)
            1060                       22  format(13i6)
            1061                     
            1062                           read(niaercm,21) cline   ! atmos scale height for 5 domains, 7 profs
            1063                           read(niaercm,24) haer(:,:)
            1064                       24  format(20f4.1)
            1065                     
            1066                           read(niaercm,21) cline   ! reference pressure for 5 domains, 7 profs
            1067                           read(niaercm,26) prsref(:,:)
            1068                       26  format(10f7.2)
            1069                     
            1070                           read(niaercm,21) cline   ! rh indep ext coef for 61 bands, 6 species
            1071                           read(niaercm,28) rhidext0(:,:)
            1072                       28  format(8e10.3)
            1073                     
            1074                           read(niaercm,21) cline   ! rh indep sca coef for 61 bands, 6 species
            1075                           read(niaercm,28) rhidsca0(:,:)
            1076                     
            1077                           read(niaercm,21) cline   ! rh indep ssa coef for 61 bands, 6 species
            1078                           read(niaercm,28) rhidssa0(:,:)
            1079                     
            1080                           read(niaercm,21) cline   ! rh indep asy coef for 61 bands, 6 species
            1081                           read(niaercm,28) rhidasy0(:,:)
            1082                     
            1083                           read(niaercm,21) cline   ! rh dep ext coef for 61 bands, 8 rh lev, 4 species
            1084                           read(niaercm,28) rhdpext0(:,:,:)
            1085                     
            1086                           read(niaercm,21) cline   ! rh dep sca coef for 61 bands, 8 rh lev, 4 species
            1087                           read(niaercm,28) rhdpsca0(:,:,:)
            1088                     
            1089                           read(niaercm,21) cline   ! rh dep ssa coef for 61 bands, 8 rh lev, 4 species
            1090                           read(niaercm,28) rhdpssa0(:,:,:)
            1091                     
            1092                           read(niaercm,21) cline   ! rh dep asy coef for 61 bands, 8 rh lev, 4 species
            1093                           read(niaercm,28) rhdpasy0(:,:,:)
            1094                     
            1095                           read(niaercm,21) cline   ! stratospheric background aeros for 61 bands
            1096                           read(niaercm,28) straext0(:)
            1097                     
            1098                           close (niaercm)
            1099                     
            1100                     !  --- ...  convert pressure reference level (in mb) to sigma reference level
            1101                     !           assume an 1000mb reference surface pressure
            1102                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1103         s   fv            sigref(:,:) = 0.001 * prsref(:,:)
            1104                     
            1105                     !  --- ...  compute solar flux weights and interval indices for mapping
            1106                     !           spectral bands between sw radiation and aerosol data
            1107                     
            1108     1                     if ( laswflg ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      solbnd
                                   <<< Loop-information  End >>>
            1109     1  pp   4v              solbnd (:)   = f_zero
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      solwaer
                                   <<< Loop-information  End >>>
            1110     1  pp   4v              solwaer(:,:) = f_zero
            1111     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1112     2  pp                   do ib = 1, nswbnd
            1113     2   p                     mb = ib + nswstr - 1
            1114     2   p                     ii = 1
            1115     2   p                     iw1 = nint(wvnsw1(mb))
            1116     2   p                     iw2 = nint(wvnsw2(mb))
            1117     2               
            1118     2               !         if ( wvnsw2(mb)>=wvn550 .and. wvn550>=wvnsw1(mb) ) then
            1119     2               !           nv_aod = ib                  ! sw band number covering 550nm wavelenth
            1120     2               !         endif
            1121     2               
            1122     3   p                     lab_swdowhile : do while ( iw1 > iendwv(ii) )
            1123     3   p                       if ( ii == naerbnd ) exit lab_swdowhile
            1124     3   p                       ii = ii + 1
            1125     3   p                     enddo  lab_swdowhile
            1126     2               
            1127     2   p                     sumsol = f_zero
            1128     2   p                     nv1(ib) = ii
            1129     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      iendwv
                                   <<< Loop-information  End >>>
            1130     3   p   8s                do iw = iw1, iw2
            1131     3   p   8m                  solbnd(ib) = solbnd(ib) + solfwv(iw)
            1132     3   p   8s                  sumsol = sumsol + solfwv(iw)
            1133     3               
            1134     4   p   8s                  if ( iw == iendwv(ii) ) then
            1135     4   p   8s                    solwaer(ib,ii) = sumsol
            1136     4               
            1137     5   p   8s                    if ( ii < naerbnd ) then
            1138     5   p   8s                      sumsol = f_zero
            1139     5   p   8m                      ii = ii + 1
            1140     5   p   8v                    endif
            1141     4   p   8v                  endif
            1142     3   p   8v                enddo
            1143     2               
            1144     3   p                     if ( iw2 /= iendwv(ii) ) then
            1145     3   p                       solwaer(ib,ii) = sumsol
            1146     3   p                     endif
            1147     2               
            1148     2   p                     nv2(ib) = ii
            1149     2               !         frcbnd(ib) = solbnd(ib) / soltot
            1150     2   p                   enddo     ! end do_ib_block for sw
            1151     1                     endif    ! end if_laswflg_block
            1152                     
            1153                     !  --- ...  compute lw flux weights and interval indices for mapping
            1154                     !           spectral bands between lw radiation and aerosol data
            1155                     
            1156     1                     if ( lalwflg ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eirbnd
                                   <<< Loop-information  End >>>
            1157     1  pp   4v              eirbnd (:)   = f_zero
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eirwaer
                                   <<< Loop-information  End >>>
            1158     1  pp   4v              eirwaer(:,:) = f_zero
            1159     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1160     2  pp                   do ib = 1, nlwbnd
            1161     2   p                     ii = 1
            1162     3   p                     if ( nlwbnd == 1 ) then
            1163     3               !           iw1 = 250                   ! corresponding 40 mu
            1164     3   p                       iw1 = 400                   ! corresponding 25 mu
            1165     3   p                       iw2 = 2500                  ! corresponding 4  mu
            1166     3   p                     else
            1167     3   p                       mb = ib + nlwstr - 1
            1168     3   p                       iw1 = nint(wvnlw1(mb))
            1169     3   p                       iw2 = nint(wvnlw2(mb))
            1170     3   p                     endif
            1171     2               
            1172     3   p                     lab_lwdowhile : do while ( iw1 > iendwv(ii) )
            1173     3   p                       if ( ii == naerbnd ) exit lab_lwdowhile
            1174     3   p                       ii = ii + 1
            1175     3   p                     enddo  lab_lwdowhile
            1176     2               
            1177     2   p                     sumir = f_zero
            1178     2   p                     nr1(ib) = ii
            1179     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      iendwv
                                   <<< Loop-information  End >>>
            1180     3   p   8s                do iw = iw1, iw2
            1181     3   p   8m                  eirbnd(ib) = eirbnd(ib) + eirfwv(iw)
            1182     3   p   8s                  sumir  = sumir  + eirfwv(iw)
            1183     3               
            1184     4   p   8s                  if ( iw == iendwv(ii) ) then
            1185     4   p   8s                    eirwaer(ib,ii) = sumir
            1186     4               
            1187     5   p   8s                    if ( ii < naerbnd ) then
            1188     5   p   8s                      sumir = f_zero
            1189     5   p   8m                      ii = ii + 1
            1190     5   p   8v                    endif
            1191     4   p   8v                  endif
            1192     3   p   8v                enddo
            1193     2               
            1194     3   p                     if ( iw2 /= iendwv(ii) ) then
            1195     3   p                       eirwaer(ib,ii) = sumir
            1196     3   p                     endif
            1197     2               
            1198     2   p                     nr2(ib) = ii
            1199     2   p                   enddo     ! end do_ib_block for lw
            1200     1                     endif    ! end if_lalwflg_block
            1201                     
            1202                     !  ---  compute spectral band mean properties for each species
            1203                     
            1204                           call optavg
            1205                     !  ---  inputs:  (in-scope variables, module variables)
            1206                     !  ---  outputs: (module variables)
            1207                     
            1208                     !  ---  check print
            1209                     !     do ib = 1, nswbnd
            1210                     !       print *,' after optavg, for sw band:',ib
            1211                     !       print *,'  extrhi:', extrhi(:,ib)
            1212                     !       print *,'  scarhi:', scarhi(:,ib)
            1213                     !       print *,'  ssarhi:', ssarhi(:,ib)
            1214                     !       print *,'  asyrhi:', asyrhi(:,ib)
            1215                     !       mb = ib + nswstr - 1
            1216                     !       print *,'  wvnsw1,wvnsw2 :',wvnsw1(mb),wvnsw2(mb)
            1217                     !       do i = 1, nrhlev
            1218                     !         print *,'  extrhd for rhlev:',i
            1219                     !         print *,extrhd(i,:,ib)
            1220                     !         print *,'  scarhd for rhlev:',i
            1221                     !         print *,scarhd(i,:,ib)
            1222                     !         print *,'  ssarhd for rhlev:',i
            1223                     !         print *,ssarhd(i,:,ib)
            1224                     !         print *,'  asyrhd for rhlev:',i
            1225                     !         print *,asyrhd(i,:,ib)
            1226                     !       enddo
            1227                     !       print *,' extstra:', extstra(ib)
            1228                     !     enddo
            1229                     !     print *,'  wvnlw1 :',wvnlw1
            1230                     !     print *,'  wvnlw2 :',wvnlw2
            1231                     !     do ib = 1, nlwbnd
            1232                     !       ii = nswbnd + ib
            1233                     !       print *,' after optavg, for lw band:',ib
            1234                     !       print *,'  extrhi:', extrhi(:,ii)
            1235                     !       print *,'  scarhi:', scarhi(:,ii)
            1236                     !       print *,'  ssarhi:', ssarhi(:,ii)
            1237                     !       print *,'  asyrhi:', asyrhi(:,ii)
            1238                     !       do i = 1, nrhlev
            1239                     !         print *,'  extrhd for rhlev:',i
            1240                     !         print *,extrhd(i,:,ii)
            1241                     !         print *,'  scarhd for rhlev:',i
            1242                     !         print *,scarhd(i,:,ii)
            1243                     !         print *,'  ssarhd for rhlev:',i
            1244                     !         print *,ssarhd(i,:,ii)
            1245                     !         print *,'  asyrhd for rhlev:',i
            1246                     !         print *,asyrhd(i,:,ii)
            1247                     !       enddo
            1248                     !       print *,' extstra:', extstra(ii)
            1249                     !     enddo
            1250                     !
            1251                           return
            1252                     !................................
            1253                           end subroutine set_aercoef
            1254                     !--------------------------------
            1255                     
            1256                     !--------------------------------
            1257                           subroutine optavg
            1258                     !................................
            1259                     !  ---  inputs:  (in-scope variables, module variables
            1260                     !  ---  outputs: (module variables)
            1261                     
            1262                     ! ==================================================================== !
            1263                     !                                                                      !
            1264                     ! subprogram: optavg                                                   !
            1265                     !                                                                      !
            1266                     !   compute mean aerosols optical properties over each sw radiation    !
            1267                     !   spectral band for each of the species components.  this program    !
            1268                     !   follows gfdl's approach for thick cloud opertical property in      !
            1269                     !   sw radiation scheme (2000).                                        !
            1270                     !                                                                      !
            1271                     !  ====================  defination of variables  ===================  !
            1272                     !                                                                      !
            1273                     ! major input variables:                                               !
            1274                     !   nv1,nv2 (nswbnd) - start/end spectral band indices of aerosol data !
            1275                     !                      for each sw radiation spectral band             !
            1276                     !   nr1,nr2 (nlwbnd) - start/end spectral band indices of aerosol data !
            1277                     !                      for each ir radiation spectral band             !
            1278                     !   solwaer (nswbnd,naerbnd)                                           !
            1279                     !                    - solar flux weight over each sw radiation band   !
            1280                     !                      vs each aerosol data spectral band              !
            1281                     !   eirwaer (nlwbnd,naerbnd)                                           !
            1282                     !                    - ir flux weight over each lw radiation band      !
            1283                     !                      vs each aerosol data spectral band              !
            1284                     !   solbnd  (nswbnd) - solar flux weight over each sw radiation band   !
            1285                     !   eirbnd  (nlwbnd) - ir flux weight over each lw radiation band      !
            1286                     !   nswbnd           - total number of sw spectral bands               !
            1287                     !   nlwbnd           - total number of lw spectral bands               !
            1288                     !                                                                      !
            1289                     ! external module variables:  (in physpara)                            !
            1290                     !   laswflg          - control flag for sw spectral region             !
            1291                     !   lalwflg          - control flag for lw spectral region             !
            1292                     !                                                                      !
            1293                     ! output variables: (to module variables)                              !
            1294                     !                                                                      !
            1295                     !  ==================================================================  !
            1296                     
            1297                     !  ---  inputs:
            1298                     !  ---  output:
            1299                     
            1300                     !  ---  locals:
            1301                           real (kind=kind_phys) :: sumk, sums, sumok, sumokg, sumreft,      &
            1302                          &       sp, refb, reft, rsolbd, rirbd
            1303                     
            1304                           integer :: ib, nb, ni, nh, nc
            1305                     !
            1306                     !===> ...  begin here
            1307                     !
            1308                     !  --- ...  loop for each sw radiation spectral band
            1309                     
            1310     1                     if ( laswflg ) then
            1311     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      straext0
                                   <<< Loop-information  End >>>
            1312     2  pp                   do nb = 1, nswbnd
            1313     2   p                     rsolbd = f_one / solbnd(nb)
            1314     2               
            1315     2               !  ---  for rh independent aerosol species
            1316     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhidasy0, rhidssa0, rhidext0, rhidsca0
                                   <<< Loop-information  End >>>
            1317     3   p                     do nc = 1, ncm1
            1318     3   p                       sumk    = f_zero
            1319     3   p                       sums    = f_zero
            1320     3   p                       sumok   = f_zero
            1321     3   p                       sumokg  = f_zero
            1322     3   p                       sumreft = f_zero
            1323     3               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhidext0, rhidsca0, rhidasy0, rhidssa0
                                   <<< Loop-information  End >>>
            1324     4   p    v                  do ni = nv1(nb), nv2(nb)
            1325     4   p    v                    sp   = sqrt( (f_one - rhidssa0(ni,nc))                    &
            1326     4                    &             / (f_one - rhidssa0(ni,nc)*rhidasy0(ni,nc)) )
            1327     4   p    v                    reft = (f_one - sp) / (f_one + sp)
            1328     4   p    v                    sumreft = sumreft + reft*solwaer(nb,ni)
            1329     4               
            1330     4   p    v                    sumk    = sumk    + rhidext0(ni,nc)*solwaer(nb,ni)
            1331     4   p    v                    sums    = sums    + rhidsca0(ni,nc)*solwaer(nb,ni)
            1332     4   p    v                    sumok   = sumok   + rhidssa0(ni,nc)*solwaer(nb,ni)        &
            1333     4                    &                * rhidext0(ni,nc)
            1334     4   p    v                    sumokg  = sumokg  + rhidssa0(ni,nc)*solwaer(nb,ni)        &
            1335     4                    &                * rhidext0(ni,nc)*rhidasy0(ni,nc)
            1336     4   p    v                  enddo
            1337     3               
            1338     3   p                       refb = sumreft * rsolbd
            1339     3               
            1340     3   p                       extrhi(nc,nb) = sumk   * rsolbd
            1341     3   p                       scarhi(nc,nb) = sums   * rsolbd
            1342     3   p                       asyrhi(nc,nb) = sumokg / (sumok + 1.0e-10)
            1343     3   p                       ssarhi(nc,nb) = 4.0*refb                                    &
            1344     3                    &         / ( (f_one+refb)**2 - asyrhi(nc,nb)*(f_one-refb)**2 )
            1345     3   p                     enddo   ! end do_nc_block for rh-ind aeros
            1346     2               
            1347     2               !  ---  for rh dependent aerosols species
            1348     2               
            1349     3   p                     do nc = 1, ncm2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhdpasy0, rhdpssa0, rhdpext0, rhdpsca0
                                   <<< Loop-information  End >>>
            1350     4   p                       do nh = 1, nrhlev
            1351     4   p                         sumk    = f_zero
            1352     4   p                         sums    = f_zero
            1353     4   p                         sumok   = f_zero
            1354     4   p                         sumokg  = f_zero
            1355     4   p                         sumreft = f_zero
            1356     4               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhdpext0, rhdpsca0, rhdpasy0, rhdpssa0
                                   <<< Loop-information  End >>>
            1357     5   p    v                    do ni = nv1(nb), nv2(nb)
            1358     5   p    v                      sp   = sqrt( (f_one - rhdpssa0(ni,nh,nc))               &
            1359     5                    &               / (f_one - rhdpssa0(ni,nh,nc)*rhdpasy0(ni,nh,nc)) )
            1360     5   p    v                      reft = (f_one - sp) / (f_one + sp)
            1361     5   p    v                      sumreft = sumreft + reft*solwaer(nb,ni)
            1362     5               
            1363     5   p    v                      sumk    = sumk    + rhdpext0(ni,nh,nc)*solwaer(nb,ni)
            1364     5   p    v                      sums    = sums    + rhdpsca0(ni,nh,nc)*solwaer(nb,ni)
            1365     5   p    v                      sumok   = sumok   + rhdpssa0(ni,nh,nc)*solwaer(nb,ni)   &
            1366     5                    &                  * rhdpext0(ni,nh,nc)
            1367     5   p    v                      sumokg  = sumokg  + rhdpssa0(ni,nh,nc)*solwaer(nb,ni)   &
            1368     5                    &                  * rhdpext0(ni,nh,nc)*rhdpasy0(ni,nh,nc)
            1369     5   p    v                    enddo
            1370     4               
            1371     4   p                         refb = sumreft * rsolbd
            1372     4               
            1373     4   p                         extrhd(nh,nc,nb) = sumk   * rsolbd
            1374     4   p                         scarhd(nh,nc,nb) = sums   * rsolbd
            1375     4   p                         asyrhd(nh,nc,nb) = sumokg / (sumok + 1.0e-10)
            1376     4   p                         ssarhd(nh,nc,nb) = 4.0*refb                               &
            1377     4                    &         / ( (f_one+refb)**2 - asyrhd(nh,nc,nb)*(f_one-refb)**2 )
            1378     4   p                       enddo   ! end do_nh_block
            1379     3   p                     enddo   ! end do_nc_block for rh-dep aeros
            1380     2               
            1381     2               !  ---  for stratospheric background aerosols
            1382     2               
            1383     2   p                     sumk = f_zero
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.20, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      straext0
                                   <<< Loop-information  End >>>
            1384     3   p    v                do ni = nv1(nb), nv2(nb)
            1385     3   p    v                  sumk = sumk + straext0(ni)*solwaer(nb,ni)
            1386     3   p    v                enddo
            1387     2               
            1388     2   p                     extstra(nb) = sumk * rsolbd
            1389     2               
            1390     2               !  ---  check print
            1391     2               !         if ( nb > 6 .and. nb < 10) then
            1392     2               !           print *,' in optavg for sw band',nb
            1393     2               !           print *,'  nv1, nv2:',nv1(nb),nv2(nb)
            1394     2               !           print *,'  solwaer:',solwaer(nb,nv1(nb):nv2(nb))
            1395     2               !           print *,'  extrhi:', extrhi(:,nb)
            1396     2               !           do i = 1, nrhlev
            1397     2               !             print *,'  extrhd for rhlev:',i
            1398     2               !             print *,extrhd(i,:,nb)
            1399     2               !           enddo
            1400     2               !           print *,'  sumk, rsolbd, extstra:',sumk,rsolbd,extstra(nb)
            1401     2               !         endif
            1402     2               
            1403     2   p                   enddo   !  end do_nb_block for sw
            1404     1                     endif   !  end if_laswflg_block
            1405                     
            1406                     !  --- ...  loop for each lw radiation spectral band
            1407                     
            1408     1                     if ( lalwflg ) then
            1409     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      straext0
                                   <<< Loop-information  End >>>
            1410     2  pp                   do nb = 1, nlwbnd
            1411     2               
            1412     2   p                     ib = nswbnd + nb
            1413     2   p                     rirbd = f_one / eirbnd(nb)
            1414     2               
            1415     2               !  ---  for rh independent aerosol species
            1416     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhidasy0, rhidssa0, rhidext0, rhidsca0
                                   <<< Loop-information  End >>>
            1417     3   p                     do nc = 1, ncm1
            1418     3   p                       sumk    = f_zero
            1419     3   p                       sums    = f_zero
            1420     3   p                       sumok   = f_zero
            1421     3   p                       sumokg  = f_zero
            1422     3   p                       sumreft = f_zero
            1423     3               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhidext0, rhidsca0, rhidasy0, rhidssa0
                                   <<< Loop-information  End >>>
            1424     4   p    v                  do ni = nr1(nb), nr2(nb)
            1425     4   p    v                    sp   = sqrt( (f_one - rhidssa0(ni,nc))                    &
            1426     4                    &             / (f_one - rhidssa0(ni,nc)*rhidasy0(ni,nc)) )
            1427     4   p    v                    reft = (f_one - sp) / (f_one + sp)
            1428     4   p    v                    sumreft = sumreft + reft*eirwaer(nb,ni)
            1429     4               
            1430     4   p    v                    sumk    = sumk    + rhidext0(ni,nc)*eirwaer(nb,ni)
            1431     4   p    v                    sums    = sums    + rhidsca0(ni,nc)*eirwaer(nb,ni)
            1432     4   p    v                    sumok   = sumok   + rhidssa0(ni,nc)*eirwaer(nb,ni)        &
            1433     4                    &                * rhidext0(ni,nc)
            1434     4   p    v                    sumokg  = sumokg  + rhidssa0(ni,nc)*eirwaer(nb,ni)        &
            1435     4                    &                * rhidext0(ni,nc)*rhidasy0(ni,nc)
            1436     4   p    v                  enddo
            1437     3               
            1438     3   p                       refb = sumreft * rirbd
            1439     3               
            1440     3   p                       extrhi(nc,ib) = sumk   * rirbd
            1441     3   p                       scarhi(nc,ib) = sums   * rirbd
            1442     3   p                       asyrhi(nc,ib) = sumokg / (sumok + 1.0e-10)
            1443     3   p                       ssarhi(nc,ib) = 4.0*refb                                       &
            1444     3                    &         / ( (f_one+refb)**2 - asyrhi(nc,ib)*(f_one-refb)**2 )
            1445     3   p                     enddo   ! end do_nc_block for rh-ind aeros
            1446     2               
            1447     2               !  ---  for rh dependent aerosols species
            1448     2               
            1449     3   p                     do nc = 1, ncm2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhdpasy0, rhdpssa0, rhdpext0, rhdpsca0
                                   <<< Loop-information  End >>>
            1450     4   p                       do nh = 1, nrhlev
            1451     4   p                         sumk    = f_zero
            1452     4   p                         sums    = f_zero
            1453     4   p                         sumok   = f_zero
            1454     4   p                         sumokg  = f_zero
            1455     4   p                         sumreft = f_zero
            1456     4               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhdpext0, rhdpsca0, rhdpasy0, rhdpssa0
                                   <<< Loop-information  End >>>
            1457     5   p    v                    do ni = nr1(nb), nr2(nb)
            1458     5   p    v                      sp   = sqrt( (f_one - rhdpssa0(ni,nh,nc))               &
            1459     5                    &             / (f_one - rhdpssa0(ni,nh,nc)*rhdpasy0(ni,nh,nc)) )
            1460     5   p    v                      reft = (f_one - sp) / (f_one + sp)
            1461     5   p    v                      sumreft = sumreft + reft*eirwaer(nb,ni)
            1462     5               
            1463     5   p    v                      sumk    = sumk    + rhdpext0(ni,nh,nc)*eirwaer(nb,ni)
            1464     5   p    v                      sums    = sums    + rhdpsca0(ni,nh,nc)*eirwaer(nb,ni)
            1465     5   p    v                      sumok   = sumok   + rhdpssa0(ni,nh,nc)*eirwaer(nb,ni)   &
            1466     5                    &                  * rhdpext0(ni,nh,nc)
            1467     5   p    v                      sumokg  = sumokg  + rhdpssa0(ni,nh,nc)*eirwaer(nb,ni)   &
            1468     5                    &                  * rhdpext0(ni,nh,nc)*rhdpasy0(ni,nh,nc)
            1469     5   p    v                    enddo
            1470     4               
            1471     4   p                         refb = sumreft * rirbd
            1472     4               
            1473     4   p                         extrhd(nh,nc,ib) = sumk   * rirbd
            1474     4   p                         scarhd(nh,nc,ib) = sums   * rirbd
            1475     4   p                         asyrhd(nh,nc,ib) = sumokg / (sumok + 1.0e-10)
            1476     4   p                         ssarhd(nh,nc,ib) = 4.0*refb                               &
            1477     4                    &         / ( (f_one+refb)**2 - asyrhd(nh,nc,ib)*(f_one-refb)**2 )
            1478     4   p                       enddo   ! end do_nh_block
            1479     3   p                     enddo   ! end do_nc_block for rh-dep aeros
            1480     2               
            1481     2               !  ---  for stratospheric background aerosols
            1482     2               
            1483     2   p                     sumk = f_zero
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.20, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      straext0
                                   <<< Loop-information  End >>>
            1484     3   p    v                do ni = nr1(nb), nr2(nb)
            1485     3   p    v                  sumk = sumk + straext0(ni)*eirwaer(nb,ni)
            1486     3   p    v                enddo
            1487     2               
            1488     2   p                     extstra(ib) = sumk * rirbd
            1489     2               
            1490     2               !  ---  check print
            1491     2               !         if ( nb >= 1 .and. nb < 5) then
            1492     2               !           print *,' in optavg for ir band:',nb
            1493     2               !           print *,'  nr1, nr2:',nr1(nb),nr2(nb)
            1494     2               !           print *,'  eirwaer:',eirwaer(nb,nr1(nb):nr2(nb))
            1495     2               !           print *,'  extrhi:', extrhi(:,ib)
            1496     2               !           do i = 1, nrhlev
            1497     2               !             print *,'  extrhd for rhlev:',i
            1498     2               !             print *,extrhd(i,:,ib)
            1499     2               !           enddo
            1500     2               !           print *,'  sumk, rirbd, extstra:',sumk,rirbd,extstra(ib)
            1501     2               !         endif
            1502     2               
            1503     2   p                   enddo   !  end do_nb_block for lw
            1504     1                     endif   !  end if_lalwflg_block
            1505                     !
            1506                           return
            1507                     !................................
            1508                           end subroutine optavg
            1509                     !--------------------------------
            1510                     !
            1511                     !...................................
            1512                           end subroutine clim_aerinit
            1513                     !-----------------------------------
            1514                     
            1515                     
            1516                     
            1517                     !-----------------------------------
            1518                           subroutine aer_update                                             &
            1519                     !...................................
            1520                     !  ---  inputs:
            1521                          &     ( myrank, iyear, imon, me )
            1522                     !  ---  outputs: ( to module variables )
            1523                     
            1524                     !  ==================================================================  !
            1525                     !                                                                      !
            1526                     !  aer_update checks and update time varying climatology aerosol       !
            1527                     !    data sets.                                                        !
            1528                     !                                                                      !
            1529                     !  inputs:                                          size               !
            1530                     !     iyear   - 4-digit calender year                 1                !
            1531                     !     imon    - month of the year                     1                !
            1532                     !     me      - print message control flag            1                !
            1533                     !                                                                      !
            1534                     !  outputs: ( none )                                                   !
            1535                     !                                                                      !
            1536                     !  external module variables: (in physpara)                            !
            1537                     !     lalwflg     - control flag for tropospheric lw aerosol           !
            1538                     !     laswflg     - control flag for tropospheric sw aerosol           !
            1539                     !     lavoflg     - control flag for stratospheric volcanic aerosol    !
            1540                     !                                                                      !
            1541                     !  usage:    call aero_update                                          !
            1542                     !                                                                      !
            1543                     !  subprograms called:  trop_update, volc_update                       !
            1544                     !                                                                      !
            1545                     !  ==================================================================  !
            1546                     
            1547                     !  ---  inputs:
            1548                           integer,  intent(in) :: iyear, imon, me, myrank
            1549                     
            1550                     !  ---  output: ( none )
            1551                     
            1552                     !  ---  locals: ( none )
            1553                     !
            1554                     !===> ...  begin here
            1555                     !
            1556     1                     if ( imon < 1 .or. imon > 12 ) then
            1557     1                       if ( me == 0 .and. myrank == 0)&
            1558     1                       print *,' ***** error in specifying requested month !!! ',      &
            1559     1                    &          'imon=', imon
            1560     1                       if ( me == 0 .and. myrank == 0)&
            1561     1                       print *,' ***** stopped in subroutinte aer_update !!!'
            1562     1                       stop
            1563     1                     endif
            1564                     
            1565     1                     if ( lalwflg .or. laswflg ) then ! update monthly tropspheric aerosol data
            1566     1                       call trop_update
            1567     1                     endif
            1568                     
            1569     1                     if ( lavoflg ) then              ! update yearly stratospheric volcanic aerosol data
            1570     1                       call volc_update
            1571     1                     endif
            1572                     
            1573                     
            1574                     ! =================
            1575                           contains
            1576                     ! =================
            1577                     
            1578                     !--------------------------------
            1579                           subroutine trop_update
            1580                     !................................
            1581                     !  ---  inputs:    (in scope variables, module variables)
            1582                     !  ---  outputs:   (module variables)
            1583                     
            1584                     !  ==================================================================  !
            1585                     !                                                                      !
            1586                     !  subprogram : trop_update                                            !
            1587                     !                                                                      !
            1588                     !    updates the  monthly global distribution of aerosol profiles in   !
            1589                     !    five degree horizontal resolution.                                !
            1590                     !                                                                      !
            1591                     !  ====================  defination of variables  ===================  !
            1592                     !                                                                      !
            1593                     !  inputs:  (in-scope variables, module constants)                     !
            1594                     !   imon     - integer, month of the year                              !
            1595                     !   me       - integer, print message control flag                     !
            1596                     !                                                                      !
            1597                     !  outputs: (module variables)                                         !
            1598                     !                                                                      !
            1599                     !  external module variables: (in physpara)                            !
            1600                     !    aeros_file   - external aerosol data file name                    !
            1601                     !                                                                      !
            1602                     !  internal module variables:                                          !
            1603                     !    kprfg (    imxae*jmxae)   - aeros profile index                   !
            1604                     !    idxcg (nxc*imxae*jmxae)   - aeros component index                 !
            1605                     !    cmixg (nxc*imxae*jmxae)   - aeros component mixing ratio          !
            1606                     !    denng ( 2 *imxae*jmxae)   - aerosols number density               !
            1607                     !                                                                      !
            1608                     !    niaercm      - unit number for input data set                     !
            1609                     !                                                                      !
            1610                     !  subroutines called: none                                            !
            1611                     !                                                                      !
            1612                     !  usage:    call trop_update                                          !
            1613                     !                                                                      !
            1614                     !  ==================================================================  !
            1615                     
            1616                     !  ---  inputs: ( none )
            1617                     !  ---  output: ( none )
            1618                     
            1619                     !  ---  locals:
            1620                     !     real (kind=kind_io8) :: cmix(nxc), denn, tem
            1621                           real (kind=kind_phys) :: cmix(nxc), denn, tem
            1622                           integer              :: idxc(nxc), kprf
            1623                     
            1624                           integer :: i, id, j, k, m, nc
            1625                           logical :: file_exist
            1626                     
            1627                           character :: cline*80, ctyp*3
            1628                     !
            1629                     !===>  ...  begin here
            1630                     !
            1631                     !  --- ...  reading climatological aerosols data
            1632                     
            1633                           inquire (file=aeros_file, exist=file_exist)
            1634                     
            1635     1                     if ( file_exist ) then
            1636     1                       close(niaercm)
            1637     1                       open (unit=niaercm,file=aeros_file,status='old',                &
            1638     1                    &        form='formatted')
            1639     1                       rewind (niaercm)
            1640     1               
            1641     2                         if ( me == 0 .and. myrank == 0) then
            1642     2                         print *,'   opened aerosol data file: ',aeros_file
            1643     2                       endif
            1644     1                     else
            1645     1                       if ( me == 0 .and. myrank == 0)&
            1646     1                       print *,'    requested aerosol data file "',aeros_file,         &
            1647     1                    &          '" not found!'
            1648     1                       if ( me == 0 .and. myrank == 0)&
            1649     1                       print *,'    *** stopped in subroutine trop_update !!'
            1650     1                       stop
            1651     1                     endif      ! end if_file_exist_block
            1652                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cmixg
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      idxcg: 12
                                   <<< Loop-information  End >>>
            1653     1  pp                 do j = 1, jmxae
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1654     2   p   fv              do i = 1, imxae
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1655     3   p   f                 do m = 1, nxc
            1656     3   p   fv                  idxcg(m,i,j) = 0
            1657     3   p   fv                  cmixg(m,i,j) = f_zero
            1658     3   p   fv                enddo
            1659     2   p   fv              enddo
            1660     1   p                 enddo
            1661                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      denng
                                   <<< Loop-information  End >>>
            1662     1  pp                 do j = 1, jmxae
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1663     2   p   fv              do i = 1, imxae
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1664     3   p   f                 do m = 1, 2
            1665     3   p   fv                  denng(m,i,j) = f_zero
            1666     3   p   fv                enddo
            1667     2   p   fv              enddo
            1668     1   p                 enddo
            1669                     
            1670                     !  --- ...  loop over 12 month global distribution
            1671                     
            1672     1                     lab_do_12mon : do m = 1, 12
            1673     1               
            1674     1                       read(niaercm,12) cline
            1675     1                 12    format(a80/)
            1676     1               
            1677     2                       if ( m /= imon ) then
            1678     2                         if ( me == 0 .and. myrank == 0) print *,'  *** skipped ',cline
            1679     2               
            1680     3                         do j = 1, jmxae
            1681     4   s    s                do i = 1, imxae
            1682     4   s    s                  read(niaercm,*) id
            1683     4   s    s                enddo
            1684     3                         enddo
            1685     2                       else
            1686     2                         if ( me == 0  .and. myrank == 0 ) print *,'  --- reading ',cline
            1687     2               !cmy--------------------------------------------------------------------
            1688     2               !cmy tranfer j from N->S to S->N
            1689     2               !cmy--------------------------------------------------------------------
            1690     2               !cmy      do j = 1, jmxae !N->S
            1691     2               
            1692     3                         do j = jmxae, 1, -1  !N->S
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kprfg, denng, idxcg, cmixg
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1693     4   s    s                do i = 1, imxae
            1694     4   m    m                  read(niaercm,14) (idxc(k),cmix(k),k=1,nxc),kprf,denn,nc,ctyp
            1695     4                 14        format(5(i2,e11.4),i2,f8.2,i3,1x,a3)
            1696     4               
            1697     4   s    s                  kprfg(i,j)     = kprf
            1698     4   s    s                  denng(1,i,j)   = denn       ! num density of 1st layer
            1699     5   s    s                  if ( kprf >= 6 ) then
            1700     5   m    s                    denng(2,i,j) = cmix(nxc)  ! num density of 2dn layer
            1701     5   p    s                  else
            1702     5   p    s                    denng(2,i,j) = f_zero
            1703     5   p    v                  endif
            1704     4               
            1705     4   s    s                  tem = f_one
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1706     5   s   fs                  do k = 1, nxc-1
            1707     5   m   fs                    idxcg(k,i,j) = idxc(k)    ! component index
            1708     5   m   fs                    cmixg(k,i,j) = cmix(k)    ! component mixing ratio
            1709     5   p   fv                    tem          = tem - cmix(k)
            1710     5   m   fs                  enddo
            1711     4   s    s                  idxcg(nxc,i,j) = idxc(nxc)
            1712     4   p    v                  cmixg(nxc,i,j) = tem        ! to make sure all add to 1.
            1713     4   p    v                enddo
            1714     3                         enddo
            1715     2               
            1716     2                         close (niaercm)
            1717     2                         exit  lab_do_12mon
            1718     2                       endif     ! end if_m_block
            1719     1               
            1720     1                     enddo  lab_do_12mon
            1721                     
            1722                     !  --  check print
            1723                     
            1724                     !     print *,'  idxcg :'
            1725                     !     print 16,idxcg
            1726                     ! 16  format(40i3)
            1727                     !     print *,'  cmixg :'
            1728                     !     print 17,cmixg
            1729                     !     print *,'  denng :'
            1730                     !     print 17,denng
            1731                     !     print *,'  kprfg :'
            1732                     !     print 17,kprfg
            1733                     ! 17  format(8e16.9)
            1734                     !
            1735                           return
            1736                     !................................
            1737                           end subroutine trop_update
            1738                     !--------------------------------
            1739                     
            1740                     
            1741                     !--------------------------------
            1742                           subroutine volc_update
            1743                     !................................
            1744                     !  ---  inputs:    (in scope variables, module variables)
            1745                     !  ---  outputs:   (module variables)
            1746                     
            1747                     !  ==================================================================  !
            1748                     !                                                                      !
            1749                     !  subprogram : volc_update                                            !
            1750                     !                                                                      !
            1751                     !    searches historical volcanic data sets to find and read in        !
            1752                     !    monthly 45-degree lat-zone band data of optical depth.            !
            1753                     !                                                                      !
            1754                     !  ====================  defination of variables  ===================  !
            1755                     !                                                                      !
            1756                     !  inputs:  (in-scope variables, module constants)                     !
            1757                     !   iyear    - integer, 4-digit calender year                 1        !
            1758                     !   imon     - integer, month of the year                     1        !
            1759                     !   me       - integer, print message control flag            1        !
            1760                     !   niaercm  - integer, unit number for input data set        1        !
            1761                     !                                                                      !
            1762                     !  outputs: (module variables)                                         !
            1763                     !   ivolae   - integer, monthly, 45-deg lat-zone volc odp      12*4*10 !
            1764                     !   kyrstr   - integer, starting year of data in the input file        !
            1765                     !   kyrend   - integer, ending   year of data in the input file        !
            1766                     !   kyrsav   - integer, the year of data in use in the input file      !
            1767                     !   kmonsav  - integer, the month of data in use in the input file     !
            1768                     !                                                                      !
            1769                     !  subroutines called: none                                            !
            1770                     !                                                                      !
            1771                     !  usage:    call volc_aerinit                                         !
            1772                     !                                                                      !
            1773                     !  ==================================================================  !
            1774                     
            1775                     !  ---  inputs: (in-scope variables, module constants)
            1776                     !     integer :: iyear, imon, me, niaercm
            1777                     
            1778                     !  ---  output: (module variables)
            1779                     !     integer :: ivolae(:,:,:), kyrstr, kyrend, kyrsav, kmonsav
            1780                     
            1781                     !  ---  locals:
            1782                           integer :: i, j, k
            1783                           logical :: file_exist
            1784                     
            1785                           character :: cline*80, volcano_file*32
            1786                           data volcano_file / 'volcanic_aerosols_1850-1859.txt ' /
            1787                     !
            1788                     !===>  ...  begin here
            1789                     !
            1790                           kmonsav = imon
            1791                     
            1792     1                     if ( kyrstr<=iyear .and. iyear<=kyrend ) then   ! use previously input data
            1793     1                       kyrsav = iyear
            1794     1                       return
            1795     1                     else                                            ! need to input new data
            1796     1                       kyrsav = iyear
            1797     1                       kyrstr = iyear - mod(iyear,10)
            1798     1                       kyrend = kyrstr + 9
            1799     1               
            1800     1               !  ---  check print
            1801     1               !       print *,'  kyrstr, kyrend, kyrsav, kmonsav =',                  &
            1802     1               !    &          kyrstr,kyrend,kyrsav,kmonsav
            1803     1               
            1804     2                       if ( iyear < minvyr .or. iyear > maxvyr ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ivolae
                                   <<< Loop-information  End >>>
            1805     2  pp   4v                ivolae(:,:,:) = 1            ! set as lowest value
            1806     3                         if ( me == 0 .and. myrank == 0 ) then
            1807     3                           print *,'   request volcanic date out of range,',           &
            1808     3                    &              ' optical depth set to lowest value'
            1809     3                         endif
            1810     2                       else
            1811     2                         write(volcano_file(19:27),60) kyrstr,kyrend
            1812     2                 60      format(i4.4,'-',i4.4)
            1813     2               
            1814     2                         inquire (file=volcano_file, exist=file_exist)
            1815     3                         if ( file_exist ) then
            1816     3                           close(niaercm)
            1817     3                           open (unit=niaercm,file=volcano_file,status='old',          &
            1818     3                    &            form='formatted')
            1819     3               
            1820     3                           read(niaercm,62) cline
            1821     3                 62        format(a80)
            1822     3               
            1823     3               !  ---  check print
            1824     4                           if ( me == 0 .and. myrank == 0) then
            1825     4                             print *,'   opened volcanic data file: ',volcano_file
            1826     4                             print *, cline
            1827     4                           endif
            1828     3               
            1829     4                           do k = 1, 10
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1830     5   s    s                    do j = 4, 1, -1
            1831     5   s    s                      read(niaercm,64) (ivolae(i,j,k),i=1,12)
            1832     5                 64            format(12i5)
            1833     5   s    s                    enddo
            1834     4                           enddo
            1835     3               
            1836     3                           close (niaercm)
            1837     3                         else
            1838     3                           if ( me == 0 .and. myrank == 0)&
            1839     3                           print *,'   requested volcanic data file "',                &
            1840     3                    &              volcano_file,'" not found!'
            1841     3                           if ( me == 0 .and. myrank == 0)&
            1842     3                           print *,'   *** stopped in subroutine volc_aerinit !!'
            1843     3                           stop
            1844     3                         endif   ! end if_file_exist_block
            1845     2               
            1846     2                       endif   ! end if_iyear_block
            1847     1                     endif   ! end if_kyrstr_block
            1848                     
            1849                     !  ---  check print
            1850     1                     if ( me == 0 .and. myrank == 0) then
            1851     1                       k = mod(kyrsav,10) + 1
            1852     1                       print *,' check: sample volcanic data used for month, year:',   &
            1853     1                    &           imon, iyear
            1854     1                       print *,  ivolae(kmonsav,:,k)
            1855     1                     endif
            1856                     !
            1857                           return
            1858                     !................................
            1859                           end subroutine volc_update
            1860                     !--------------------------------
            1861                     !
            1862                     !...................................
            1863                           end subroutine aer_update
            1864                     !-----------------------------------
            1865                     
            1866                     
            1867                     
            1868                     !-----------------------------------
            1869                           subroutine setaer                                                 &
            1870                     !...................................
            1871                     
            1872                     !  ---  inputs:
            1873                          &     ( prsi,prsl,prslk,tvly,rhlay,slmsk,tracer,xlon,xlat,         &
            1874                          &       imax,nlay,nlp1,lsswr,lslwr,me,myrank,                      &
            1875                     !  ---  outputs:
            1876                          &       aerosw,aerolw                                              &
            1877                     !    &       aerosw,aerolw,aerodp                                       &
            1878                          &     )
            1879                     
            1880                     !  ==================================================================  !
            1881                     !                                                                      !
            1882                     !  setaer computes aerosols optical properties                         !
            1883                     !                                                                      !
            1884                     !  inputs:                                                   size      !
            1885                     !     prsi    - pressure at interface              mb      imax*nlp1   !
            1886                     !     prsl    - layer mean pressure                mb      imax*nlay   !
            1887                     !     prslk   - exner function = (p/p0)**rocp              imax*nlay   !
            1888                     !     tvly    - layer virtual temperature          k       imax*nlay   !
            1889                     !     rhlay   - layer mean relative humidity               imax*nlay   !
            1890                     !     slmsk   - sea/land mask (sea:0,land:1,sea-ice:2)       imax      !
            1891                     !     tracer  - aerosol tracer concentration           imax*nlay*ntrac !
            1892                     !     xlon    - longitude of given points in radiance        imax      !
            1893                     !               ok for both 0->2pi or -pi->+pi ranges                  !
            1894                     !     xlat    - latitude of given points in radiance         imax      !
            1895                     !               default to pi/2 -> -pi/2, otherwise see in-line comment!
            1896                     !     imax    - horizontal dimension of arrays                  1      !
            1897                     !     nlay,nlp1-vertical dimensions of arrays                   1      !
            1898                     !     lsswr,lslwr                                                      !
            1899                     !             - logical flags for sw/lw radiation calls         1      !
            1900                     !                                                                      !
            1901                     !  outputs:                                                            !
            1902                     !     aerosw - aeros opt properties for sw      imax*nlay*nbdsw*nf_aesw!
            1903                     !               (:,:,:,1): optical depth                               !
            1904                     !               (:,:,:,2): single scattering albedo                    !
            1905                     !               (:,:,:,3): asymmetry parameter                         !
            1906                     !     aerolw - aeros opt properties for lw      imax*nlay*nbdlw*nf_aelw!
            1907                     !               (:,:,:,1): optical depth                               !
            1908                     !               (:,:,:,2): single scattering albedo                    !
            1909                     !               (:,:,:,3): asymmetry parameter                         !
            1910                     !!    aerodp - vertically integrated optical depth         imax*nspc1  !
            1911                     !                                                                      !
            1912                     !  external module variable: (in physpara)                             !
            1913                     !     iaerflg - aerosol effect control flag (volc,lw,sw, 3-dig)        !
            1914                     !     laswflg - tropospheric aerosol control flag for sw radiation     !
            1915                     !               =f: no sw aeros calc.  =t: do sw aeros calc.           !
            1916                     !     lalwflg - tropospheric aerosol control flag for lw radiation     !
            1917                     !               =f: no lw aeros calc.  =t: do lw aeros calc.           !
            1918                     !     lavoflg - control flag for stratospheric vocanic aerosols        !
            1919                     !               =t: add volcanic aerosols to the background aerosols   !
            1920                     !     ivflip  - control flag for direction of vertical index           !
            1921                     !               =0: index from toa to surface                          !
            1922                     !               =1: index from surface to toa                          !
            1923                     !                                                                      !
            1924                     !  internal module variable: (set by subroutine aer_init)              !
            1925                     !     ivolae  - stratosphere volcanic aerosol optical depth (fac 1.e4) !
            1926                     !                                                     12*4*10          !
            1927                     !  usage:    call setaer                                               !
            1928                     !                                                                      !
            1929                     !  subprograms called:  aer_property                                   !
            1930                     !                                                                      !
            1931                     !  ==================================================================  !
            1932                     
            1933                     !  ---  inputs:
            1934                           integer, intent(in) :: imax, nlay, nlp1,me,myrank
            1935                     
            1936                           real (kind=kind_phys), dimension(:,:), intent(in) :: prsi, prsl,  &
            1937                          &       prslk, tvly, rhlay
            1938                           real (kind=kind_phys), dimension(:),   intent(in) :: xlon, xlat,  &
            1939                          &       slmsk
            1940                           real (kind=kind_phys), dimension(:,:,:),intent(in):: tracer
            1941                     
            1942                           logical, intent(in) :: lsswr, lslwr
            1943                     
            1944                     !  ---  outputs:
            1945                           real (kind=kind_phys), dimension(:,:,:,:), intent(out) ::         &
            1946                          &       aerosw, aerolw
            1947                     !     real (kind=kind_phys), dimension(:,:)    , intent(out) :: aerodp
            1948                     
            1949                     !  ---  locals:
            1950                           real (kind=kind_phys), parameter :: psrfh = 5.0    ! ref press (mb) for upper bound
            1951                     
            1952                           real (kind=kind_phys), dimension(imax) :: alon,alat,volcae,rdelp
            1953                     !     real (kind=kind_phys), dimension(imax) :: sumodp
            1954                           real (kind=kind_phys) :: prsln(nlp1),hz(imax,nlp1),dz(imax,nlay)
            1955                           real (kind=kind_phys) :: tmp1, tmp2, psrfl
            1956                     
            1957                           integer               :: kcutl(imax), kcuth(imax)
            1958                           integer               :: i, i1, j, k, m, mb, kh, kl
            1959                     
            1960                           logical               :: laddsw=.false.,  laersw=.false.
            1961                           logical               :: laddlw=.false.,  laerlw=.false.
            1962                     
            1963                     !  ---  conversion constants
            1964                           real (kind=kind_phys), parameter :: rdg  = 180.0 / con_pi
            1965                           real (kind=kind_phys), parameter :: rovg = 0.001 * con_rd / con_g
            1966                     
            1967                     !===>  ...  begin here
            1968                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1969     1  pp                 do m = 1, nf_aesw
            1970     2   p                   do j = 1, nbdsw
            1971     3   p                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1972     4   p   4v                  do i = 1, imax
            1973     4   p   4v                    aerosw(i,k,j,m) = f_zero
            1974     4   p   4v                  enddo
            1975     3   p                     enddo
            1976     2   p                   enddo
            1977     1   p                 enddo
            1978                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1979     1  pp                 do m = 1, nf_aelw
            1980     2   p                   do j = 1, nbdlw
            1981     3   p                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1982     4   p   4v                  do i = 1, imax
            1983     4   p   4v                    aerolw(i,k,j,m) = f_zero
            1984     4   p   4v                  enddo
            1985     3   p                     enddo
            1986     2   p                   enddo
            1987     1   p                 enddo
            1988                     
            1989                     !     aerodp = f_zero
            1990                     !     sumodp = f_zero
            1991                     
            1992     1                     if ( .not. (lsswr .or. lslwr) ) then
            1993     1                       return
            1994     1                     endif
            1995                     
            1996     1                     if ( iaerflg <= 0 ) then
            1997     1                       return
            1998     1                     endif
            1999                     
            2000                           laersw = lsswr .and. laswflg
            2001                           laerlw = lslwr .and. lalwflg
            2002                     
            2003                     !  ---  ...  convert lat/lon from radiance to degree
            2004                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      alon, alat
                                   <<< Loop-information  End >>>
            2005     1  pp   2v            do i = 1, imax
            2006     1   p   2v              alon(i) = xlon(i) * rdg
            2007     1               !       if (myrank == 0) print *,i,'alon=',alon(i),' xlon=',xlon(i),rdg
            2008     1   p   2v              if (alon(i) < f_zero) alon(i) = alon(i) + 360.0
            2009     1   p   2v              alat(i) = xlat(i) * rdg          ! if xlat in pi/2 -> -pi/2 range
            2010     1               !       if (myrank == 0) print *,i,'alat=',alat(i),' xlat=',xlat(i),rdg
            2011     1               !       alat(i) = 90.0 - xlat(i)*rdg     ! if xlat in 0 -> pi range
            2012     1   p   2v            enddo
            2013                     
            2014                     !  ---  ...  compute level height and layer thickness
            2015                     
            2016     1                     if ( laswflg .or. lalwflg ) then
            2017     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prsln
                                   <<< Loop-information  End >>>
            2018     2                       lab_do_imax : do i = 1, imax
            2019     2               
            2020     3                         lab_if_flip : if (ivflip == 1) then       ! input from sfc to toa
            2021     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.94, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prsln
                                   <<< Loop-information  End >>>
            2022     4  pp    v                  do k = 1, nlay
            2023     4   p    v                    prsln(k) = log(prsi(i,k))
            2024     4   p    v                  enddo
            2025     3                           prsln(nlp1)= log(prsl(i,nlay))
            2026     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.72, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prsln
                                   <<< Loop-information  End >>>
            2027     4  pp   2v                  do k = nlay, 1, -1
            2028     4   p   2v                    dz(i,k) = rovg * (prsln(k) - prsln(k+1)) * tvly(i,k)
            2029     4   p   2v                  enddo
            2030     3                           dz(i,nlay)  = 2.0 * dz(i,nlay)
            2031     3               
            2032     3                           hz(i,1) = f_zero
            2033     4   s   2s                  do k = 1, nlay
            2034     4   s   2s                    hz(i,k+1) = hz(i,k) + dz(i,k)
            2035     4   s   2s                  enddo
            2036     3               
            2037     3                         else  lab_if_flip                         ! input from toa to sfc
            2038     3               
            2039     3                           prsln(1) = log(prsl(i,1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.94, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prsln
                                   <<< Loop-information  End >>>
            2040     4  pp    v                  do k = 2, nlp1
            2041     4   p    v                    prsln(k) = log(prsi(i,k))
            2042     4   p    v                  enddo
            2043     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prsln
                                   <<< Loop-information  End >>>
            2044     4  pp   2v                  do k = 1, nlay
            2045     4   p   2v                    dz(i,k) = rovg * (prsln(k+1) - prsln(k)) * tvly(i,k)
            2046     4   p   2v                  enddo
            2047     3                           dz(i,1) = 2.0 * dz(i,1)
            2048     3               
            2049     3                           hz(i,nlp1) = f_zero
            2050     4   s   2s                  do k = nlay, 1, -1
            2051     4   s   2s                    hz(i,k) = hz(i,k+1) + dz(i,k)
            2052     4   s   2s                  enddo
            2053     3               
            2054     3                         endif  lab_if_flip
            2055     2               
            2056     2                       enddo  lab_do_imax
            2057     1               
            2058     1               !  ---  ...  calculate sw aerosol optical properties for the corresponding
            2059     1               !            frequency bands
            2060     1               
            2061     1                       call aer_property                                               &
            2062     1               !  ---  inputs:
            2063     1                    &     ( prsi,prsl,prslk,tvly,rhlay,dz,hz,tracer,                   &
            2064     1                    &       alon,alat,slmsk, laersw,laerlw,                            &
            2065     1                    &       imax,nlay,nlp1,                                            &
            2066     1               !    &       imax,nlay,nlp1,nspc1,                                      &
            2067     1               !  ---  outputs:
            2068     1                    &       aerosw,aerolw                                              &
            2069     1               !    &       aerosw,aerolw,aerodp                                       &
            2070     1                    &     )
            2071     1               
            2072     1               !  ---  check print
            2073     1               !       do m = 1, nbdsw
            2074     1               !         print *,'  ***  check aerosols properties for sw band =',m,   &
            2075     1               !    &            ' ***'
            2076     1               !         do k = 1, 10
            2077     1               !           print *,'  level :',k
            2078     1               !           print *,'  tauaer:',aerosw(:,k,m,1)
            2079     1               !           print *,'  ssaaer:',aerosw(:,k,m,2)
            2080     1               !           print *,'  asyaer:',aerosw(:,k,m,3)
            2081     1               !         enddo
            2082     1               !       enddo
            2083     1               !       print *,'  ***  check aerosols optical depth for 550nm region'
            2084     1               !       print *, aerodp(:,1)
            2085     1               !       if ( laod_out ) then
            2086     1               !         do m = 1, nspc1
            2087     1               !           print *,'  ***  check aerosols optical depth for species:', &
            2088     1               !    &              m
            2089     1               !           print *, aerodp(:,m)
            2090     1               !           sumodp(:) = sumodp(:) + aerodp(:,m)
            2091     1               !         enddo
            2092     1               !
            2093     1               !         print *,'  ***  check aerosols optical depth for all species:'
            2094     1               !         print *, sumodp(:)
            2095     1               !       endif
            2096     1               !       do m = 1, nbdlw
            2097     1               !         print *,'  ***  check aerosols properties for lw band =',m,   &
            2098     1               !    &            ' ***'
            2099     1               !         do k = 1, 10
            2100     1               !           print *,'  level :',k
            2101     1               !           print *,'  tauaer:',aerolw(:,k,m,1)
            2102     1               !           print *,'  ssaaer:',aerolw(:,k,m,2)
            2103     1               !           print *,'  asyaer:',aerolw(:,k,m,3)
            2104     1               !         enddo
            2105     1               !       enddo
            2106     1               
            2107     1                     endif   ! end if_laswflg_or_lalwflg_block
            2108                     
            2109                     !  ---  ...  stratosphere volcanic forcing
            2110                     
            2111     1                     if ( lavoflg ) then
            2112     1               
            2113     2                       if ( iaerflg == 100 ) then
            2114     2                         laddsw = lsswr
            2115     2                         laddlw = lslwr
            2116     2                       else
            2117     2                         laddsw = lsswr .and. laswflg
            2118     2                         laddlw = lslwr .and. lalwflg
            2119     2                       endif
            2120     1               
            2121     1                       i1 = mod(kyrsav, 10) + 1
            2122     1               
            2123     1               !  ---  select data in 4 lat bands, interpolation at the boundaires
            2124     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 116
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      alat, volcae
                                   <<< Loop-information  End >>>
            2125     2  pp    s              do i = 1, imax
            2126     3   p    m                if      ( alat(i) > 46.0 ) then
            2127     3   p    s                  volcae(i) = 1.0e-4 * ivolae(kmonsav,1,i1)
            2128     3   p    s                else if ( alat(i) > 44.0 ) then
            2129     3   p    s                  volcae(i) = 5.0e-5                                          &
            2130     3                    &                * (ivolae(kmonsav,1,i1) + ivolae(kmonsav,2,i1))
            2131     3   p    s                else if ( alat(i) >  1.0 ) then
            2132     3   p    s                  volcae(i) = 1.0e-4 * ivolae(kmonsav,2,i1)
            2133     3   p    s                else if ( alat(i) > -1.0 ) then
            2134     3   p    s                  volcae(i) = 5.0e-5                                          &
            2135     3                    &                * (ivolae(kmonsav,2,i1) + ivolae(kmonsav,3,i1))
            2136     3   p    s                else if ( alat(i) >-44.0 ) then
            2137     3   p    s                  volcae(i) = 1.0e-4 * ivolae(kmonsav,3,i1)
            2138     3   p    s                else if ( alat(i) >-46.0 ) then
            2139     3   p    s                  volcae(i) = 5.0e-5                                          &
            2140     3                    &                * (ivolae(kmonsav,3,i1) + ivolae(kmonsav,4,i1))
            2141     3   p    s                else
            2142     3   p    s                  volcae(i) = 1.0e-4 * ivolae(kmonsav,4,i1)
            2143     3   p    v                endif
            2144     2   p    v              enddo
            2145     1               
            2146     2                       if ( ivflip == 0 ) then         ! input data from toa to sfc
            2147     2               
            2148     2               !  ---  find lower boundary of stratosphere
            2149     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
            2150     3  pp                     do i = 1, imax
            2151     3               
            2152     3   p                       tmp1 = abs( alat(i) )
            2153     4   p                       if ( tmp1 > 70.0 ) then          ! polar, fixed at 25000pa (250mb)
            2154     4   p                         psrfl = 250.0
            2155     4   p                       elseif ( tmp1 < 20.0 ) then      ! tropic, fixed at 15000pa (150mb)
            2156     4   p                         psrfl = 150.0
            2157     4   p                       else                             ! mid-lat, interpolation
            2158     4   p                         psrfl = 110.0 + 2.0*tmp1
            2159     4   p                       endif
            2160     3               
            2161     3   p                       kcuth(i) = nlay - 1
            2162     3   p                       kcutl(i) = 2
            2163     3   p                       rdelp(i) = f_one / prsi(i,2)
            2164     3               
            2165     4   p                       lab_do_kcuth0 : do k = 2, nlay-2
            2166     5   p                         if ( prsi(i,k) >= psrfh ) then
            2167     5   p                           kcuth(i) = k - 1
            2168     5   p                           exit lab_do_kcuth0
            2169     5   p                         endif
            2170     4   p                       enddo  lab_do_kcuth0
            2171     3               
            2172     4   p                       lab_do_kcutl0 : do k = 2, nlay-2
            2173     5   p                         if ( prsi(i,k) >= psrfl ) then
            2174     5   p                           kcutl(i) = k - 1
            2175     5   p                           rdelp(i) = f_one / (prsi(i,k) - prsi(i,kcuth(i)))
            2176     5   p                           exit lab_do_kcutl0
            2177     5   p                         endif
            2178     4   p                       enddo  lab_do_kcutl0
            2179     3   p                     enddo
            2180     2               
            2181     2               !  ---  sw: add volcanic aerosol optical depth to the background value
            2182     2               
            2183     3                         if ( laddsw ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2184     4  pp                       do m = 1, nbdsw
            2185     4   p                         mb = nswstr + m - 1
            2186     4               
            2187     5   p                         if     ( wvnsw1(mb) > 20000 ) then   ! range of wvlth < 0.5mu
            2188     5   p                           tmp2 = 0.74
            2189     5   p                         elseif ( wvnsw2(mb) < 20000 ) then   ! range of wvlth > 0.5mu
            2190     5   p                           tmp2 = 1.14
            2191     5   p                         else                                 ! range of wvlth in btwn
            2192     5   p                           tmp2 = 0.94
            2193     5   p                         endif
            2194     4   p                         tmp1 = (0.275e-4 * (wvnsw2(mb)+wvnsw1(mb))) ** tmp2
            2195     4               
            2196     5   p                         do i = 1, imax
            2197     5   p                           kh = kcuth(i)
            2198     5   p                           kl = kcutl(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2199     6   p   2v                      do k = kh, kl
            2200     6   p   2v                        tmp2 = tmp1 * ((prsi(i,k+1) - prsi(i,k)) * rdelp(i))
            2201     6   p   2v                        aerosw(i,k,m,1) = aerosw(i,k,m,1) + tmp2*volcae(i)
            2202     6   p   2v                      enddo
            2203     5               
            2204     5               !  ---  smoothing profile at boundary if needed
            2205     5               
            2206     6   p                           if ( aerosw(i,kl,m,1) > 10.*aerosw(i,kl+1,m,1) ) then
            2207     6   p                             tmp2 = aerosw(i,kl,m,1) + aerosw(i,kl+1,m,1)
            2208     6   p                             aerosw(i,kl  ,m,1) = 0.8 * tmp2
            2209     6   p                             aerosw(i,kl+1,m,1) = 0.2 * tmp2
            2210     6   p                           endif
            2211     5   p                         enddo    ! end do_i_block
            2212     4   p                       enddo      ! end do_m_block
            2213     3               
            2214     3               !  ---  check print
            2215     3               !           do i = 1, imax
            2216     3               !             print *,' lev  press      tau      for profile:',i,       &
            2217     3               !    &                '  kcuth, kcutl =',kcuth(i),kcutl(i)
            2218     3               !             kh = kcuth(i) - 1
            2219     3               !             kl = kcutl(i) + 10
            2220     3               !             do k = kh, kl
            2221     3               !               write(6,71) k, prsl(i,k), aerosw(i,k,1,1)
            2222     3               ! 71            format(i3,2e11.4)
            2223     3               !             enddo
            2224     3               !           enddo
            2225     3               
            2226     3                         endif        ! end if_laddsw_block
            2227     2               
            2228     2               !  ---  lw: add volcanic aerosol optical depth to the background value
            2229     2               
            2230     3                         if ( laddlw ) then
            2231     4                           if ( nlwbnd == 1 ) then
            2232     4               
            2233     4                             tmp1 = (0.55 / 11.0) ** 1.2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2234     5  pp                         do i = 1, imax
            2235     5   p                           kh = kcuth(i)
            2236     5   p                           kl = kcutl(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.25, ITR: 24, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2237     6   p                           do k = kh, kl
            2238     6   p                             tmp2 = tmp1 * ((prsi(i,k+1) - prsi(i,k)) * rdelp(i))  &
            2239     6                    &                 * volcae(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            2240     7   p   fv                        do m = 1, nbdlw
            2241     7   p   fv                          aerolw(i,k,m,1) = aerolw(i,k,m,1) + tmp2
            2242     7   p   fv                        enddo
            2243     6   p                           enddo
            2244     5   p                         enddo    ! end do_i_block
            2245     4               
            2246     4                           else
            2247     4               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2248     5  pp                         do m = 1, nbdlw
            2249     5   p                           tmp1 = (0.275e-4 * (wvnlw2(m) + wvnlw1(m))) ** 1.2
            2250     5               
            2251     6   p                           do i = 1, imax
            2252     6   p                             kh = kcuth(i)
            2253     6   p                             kl = kcutl(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2254     7   p   2v                        do k = kh, kl
            2255     7   p   2v                          tmp2 = tmp1 * ((prsi(i,k+1)-prsi(i,k)) * rdelp(i))
            2256     7   p   2v                          aerolw(i,k,m,1) = aerolw(i,k,m,1) + tmp2*volcae(i)
            2257     7   p   2v                        enddo
            2258     6   p                           enddo    ! end do_i_block
            2259     5   p                         enddo      ! end do_m_block
            2260     4               
            2261     4                           endif      ! end if_nlwbnd_block
            2262     3                         endif        ! end if_laddlw_block
            2263     2               
            2264     2                       else                            ! input data from sfc to toa
            2265     2               
            2266     2               !  ---  find lower boundary of stratosphere
            2267     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
            2268     3  pp                     do i = 1, imax
            2269     3               
            2270     3   p                       tmp1 = abs( alat(i) )
            2271     4   p                       if ( tmp1 > 70.0 ) then          ! polar, fixed at 25000pa (250mb)
            2272     4   p                         psrfl = 250.0
            2273     4   p                       elseif ( tmp1 < 20.0 ) then      ! tropic, fixed at 15000pa (150mb)
            2274     4   p                         psrfl = 150.0
            2275     4   p                       else                             ! mid-lat, interpolation
            2276     4   p                         psrfl = 110.0 + 2.0*tmp1
            2277     4   p                       endif
            2278     3               
            2279     3   p                       kcuth(i) = 2
            2280     3   p                       kcutl(i) = nlay - 1
            2281     3   p                       rdelp(i) = f_one / prsi(i,nlay-1)
            2282     3               
            2283     4   p                       lab_do_kcuth1 : do k = nlay-1, 2, -1
            2284     5   p                         if ( prsi(i,k) >= psrfh ) then
            2285     5   p                           kcuth(i) = k
            2286     5   p                           exit lab_do_kcuth1
            2287     5   p                         endif
            2288     4   p                       enddo  lab_do_kcuth1
            2289     3               
            2290     4   p                       lab_do_kcutl1 : do k = nlay, 2, -1
            2291     5   p                         if ( prsi(i,k) >= psrfl ) then
            2292     5   p                           kcutl(i) = k
            2293     5   p                           rdelp(i) = f_one / (prsi(i,k) - prsi(i,kcuth(i)+1))
            2294     5   p                           exit lab_do_kcutl1
            2295     5   p                         endif
            2296     4   p                       enddo  lab_do_kcutl1
            2297     3   p                     enddo
            2298     2               
            2299     2               !  ---  sw: add volcanic aerosol optical depth to the background value
            2300     2               
            2301     3                         if ( laddsw ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2302     4  pp                       do m = 1, nbdsw
            2303     4   p                         mb = nswstr + m - 1
            2304     4               
            2305     5   p                         if     ( wvnsw1(mb) > 20000 ) then   ! range of wvlth < 0.5mu
            2306     5   p                           tmp2 = 0.74
            2307     5   p                         elseif ( wvnsw2(mb) < 20000 ) then   ! range of wvlth > 0.5mu
            2308     5   p                           tmp2 = 1.14
            2309     5   p                         else                                 ! range of wvlth in btwn
            2310     5   p                           tmp2 = 0.94
            2311     5   p                         endif
            2312     4   p                         tmp1 = (0.275e-4 * (wvnsw2(mb)+wvnsw1(mb))) ** tmp2
            2313     4               
            2314     5   p                         do i = 1, imax
            2315     5   p                           kh = kcuth(i)
            2316     5   p                           kl = kcutl(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2317     6   p   2v                      do k = kl, kh
            2318     6   p   2v                        tmp2 = tmp1 * ((prsi(i,k) - prsi(i,k+1)) * rdelp(i))
            2319     6   p   2v                        aerosw(i,k,m,1) = aerosw(i,k,m,1) + tmp2*volcae(i)
            2320     6   p   2v                      enddo
            2321     5               
            2322     5               !  ---  smoothing profile at boundary if needed
            2323     5               
            2324     6   p                           if ( aerosw(i,kl,m,1) > 10.*aerosw(i,kl-1,m,1) ) then
            2325     6   p                             tmp2 = aerosw(i,kl,m,1) + aerosw(i,kl-1,m,1)
            2326     6   p                             aerosw(i,kl  ,m,1) = 0.8 * tmp2
            2327     6   p                             aerosw(i,kl-1,m,1) = 0.2 * tmp2
            2328     6   p                           endif
            2329     5   p                         enddo    ! end do_i_block
            2330     4   p                       enddo      ! end do_m_block
            2331     3               
            2332     3               !  ---  check print
            2333     3               !           do i = 1, imax
            2334     3               !             print *,' lev  press      tau      for profile:',i,       &
            2335     3               !    &                '  kcuth, kcutl =',kcuth(i),kcutl(i)
            2336     3               !             kh = kcuth(i) + 1
            2337     3               !             kl = kcutl(i) - 10
            2338     3               !             do k = kh, kl, -1
            2339     3               !               write(6,71) nlp1-k,prsl(i,k),aerosw(i,k,1,1)
            2340     3               !             enddo
            2341     3               !           enddo
            2342     3               
            2343     3                         endif        ! end if_laddsw_block
            2344     2               
            2345     2               !  ---  lw: add volcanic aerosol optical depth to the background value
            2346     2               
            2347     3                         if ( laddlw ) then
            2348     4                           if ( nlwbnd == 1 ) then
            2349     4               
            2350     4                             tmp1 = (0.55 / 11.0) ** 1.2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2351     5  pp                         do i = 1, imax
            2352     5   p                           kh = kcuth(i)
            2353     5   p                           kl = kcutl(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.25, ITR: 24, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2354     6   p                           do k = kl, kh
            2355     6   p                             tmp2 = tmp1 * ((prsi(i,k) - prsi(i,k+1)) * rdelp(i))  &
            2356     6                    &                 * volcae(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            2357     7   p   fv                        do m = 1, nbdlw
            2358     7   p   fv                          aerolw(i,k,m,1) = aerolw(i,k,m,1) + tmp2
            2359     7   p   fv                        enddo
            2360     6   p                           enddo
            2361     5   p                         enddo    ! end do_i_block
            2362     4               
            2363     4                           else
            2364     4               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2365     5  pp                         do m = 1, nbdlw
            2366     5   p                           tmp1 = (0.275e-4 * (wvnlw2(m) + wvnlw1(m))) ** 1.2
            2367     5               
            2368     6   p                           do i = 1, imax
            2369     6   p                             kh = kcuth(i)
            2370     6   p                             kl = kcutl(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2371     7   p   2v                        do k = kl, kh
            2372     7   p   2v                          tmp2 = tmp1 * ((prsi(i,k)-prsi(i,k+1)) * rdelp(i))
            2373     7   p   2v                          aerolw(i,k,m,1) = aerolw(i,k,m,1) + tmp2*volcae(i)
            2374     7   p   2v                        enddo
            2375     6   p                           enddo    ! end do_i_block
            2376     5   p                         enddo      ! end do_m_block
            2377     4               
            2378     4                           endif      ! end if_nlwbnd_block
            2379     3                         endif        ! end if_laddlw_block
            2380     2               
            2381     2                       endif                           ! end if_ivflip_block
            2382     1               
            2383     1                     endif   ! end if_lavoflg_block
            2384                     !
            2385                           return
            2386                     !...................................
            2387                           end subroutine setaer
            2388                     !-----------------------------------
            2389                     
            2390                     
            2391                     
            2392                     !-----------------------------------
            2393                           subroutine aer_property                                           &
            2394                     !...................................
            2395                     
            2396                     !  ---  inputs:
            2397                          &     ( prsi,prsl,prslk,tvly,rhlay,dz,hz,tracer,                   &
            2398                          &       alon,alat,slmsk, laersw,laerlw,                            &
            2399                          &       imax,nlay,nlp1,                                            &
            2400                     !    &       imax,nlay,nlp1,nspc,                                       &
            2401                     !  ---  outputs:
            2402                          &       aerosw,aerolw                                              &
            2403                     !    &       aerosw,aerolw,aerodp                                       &
            2404                          &     )
            2405                     
            2406                     !  ==================================================================  !
            2407                     !                                                                      !
            2408                     !  aer_property maps the 5 degree global climatological aerosol data   !
            2409                     !  set onto model grids, and compute aerosol optical properties for sw !
            2410                     !  and lw radiations.                                                  !
            2411                     !                                                                      !
            2412                     !  inputs:                                                             !
            2413                     !     prsi    - pressure at interface              mb      imax*nlp1   !
            2414                     !     prsl    - layer mean pressure         (not used)     imax*nlay   !
            2415                     !     prslk   - exner function=(p/p0)**rocp (not used)     imax*nlay   !
            2416                     !     tvly    - layer virtual temperature   (not used)     imax*nlay   !
            2417                     !     rhlay   - layer mean relative humidity               imax*nlay   !
            2418                     !     dz      - layer thickness                    m       imax*nlay   !
            2419                     !     hz      - level high                         m       imax*nlp1   !
            2420                     !     tracer  - aer tracer concentrations   (not used)  imax*nlay*ntrac!
            2421                     !     alon, alat                                             imax      !
            2422                     !             - longitude and latitude of given points in degree       !
            2423                     !     slmsk   - sea/land mask (sea:0,land:1,sea-ice:2)       imax      !
            2424                     !     laersw,laerlw                                             1      !
            2425                     !             - logical flag for sw/lw aerosol calculations            !
            2426                     !     imax    - horizontal dimension of arrays                  1      !
            2427                     !     nlay,nlp1-vertical dimensions of arrays                   1      !
            2428                     !!    nspc    - num of species for optional aod output fields   1      !
            2429                     !                                                                      !
            2430                     !  outputs:                                                            !
            2431                     !     aerosw - aeros opt properties for sw      imax*nlay*nbdsw*nf_aesw!
            2432                     !               (:,:,:,1): optical depth                               !
            2433                     !               (:,:,:,2): single scattering albedo                    !
            2434                     !               (:,:,:,3): asymmetry parameter                         !
            2435                     !     aerolw - aeros opt properties for lw      imax*nlay*nbdlw*nf_aelw!
            2436                     !               (:,:,:,1): optical depth                               !
            2437                     !               (:,:,:,2): single scattering albedo                    !
            2438                     !               (:,:,:,3): asymmetry parameter                         !
            2439                     !!    aerodp - vertically integrated aer-opt-depth         imax*nspc+1 !
            2440                     !                                                                      !
            2441                     !  module parameters and constants:                                    !
            2442                     !     nswbnd  - total number of actual sw spectral bands computed      !
            2443                     !     nlwbnd  - total number of actual lw spectral bands computed      !
            2444                     !     nswlwbd - total number of sw+lw bands computed                   !
            2445                     !                                                                      !
            2446                     !  external module variables: (in physpara)                            !
            2447                     !     ivflip  - control flag for direction of vertical index           !
            2448                     !               =0: index from toa to surface                          !
            2449                     !               =1: index from surface to toa                          !
            2450                     !                                                                      !
            2451                     !  module variable: (set by subroutine aer_init)                       !
            2452                     !     kprfg   - aerosols profile index                imxae*jmxae      !
            2453                     !               1:ant  2:arc  3:cnt  4:mar  5:des  6:marme 7:cntme     !
            2454                     !     idxcg   - aerosols component index              nxc*imxae*jmxae  !
            2455                     !               1:inso    2:soot    3:minm    4:miam    5:micm         !
            2456                     !               6:mitr    7:waso    8:ssam    9:sscm   10:suso         !
            2457                     !     cmixg   - aerosols component mixing ratio       nxc*imxae*jmxae  !
            2458                     !     denng   - aerosols number density                2 *imxae*jmxae  !
            2459                     !               1:for domain-1   2:domain-2 (prof marme/cntme only)    !
            2460                     !                                                                      !
            2461                     !  usage:    call aer_property                                         !
            2462                     !                                                                      !
            2463                     !  subprograms called:  radclimaer                                     !
            2464                     !                                                                      !
            2465                     !  ==================================================================  !
            2466                     
            2467                     !  ---  inputs:
            2468                           integer, intent(in) :: imax, nlay, nlp1
            2469                     !     integer, intent(in) :: imax, nlay, nlp1, nspc
            2470                           logical, intent(in) :: laersw, laerlw
            2471                     
            2472                           real (kind=kind_phys), dimension(:,:), intent(in) :: prsi, prsl,  &
            2473                          &       prslk, tvly, rhlay, dz, hz
            2474                           real (kind=kind_phys), dimension(:),   intent(in) :: alon, alat,  &
            2475                          &       slmsk
            2476                           real (kind=kind_phys), dimension(:,:,:),intent(in):: tracer
            2477                     
            2478                     !  ---  outputs:
            2479                           real (kind=kind_phys), dimension(:,:,:,:), intent(out) ::         &
            2480                          &       aerosw, aerolw
            2481                     !     real (kind=kind_phys), dimension(:,:)    , intent(out) :: aerodp
            2482                     
            2483                     !  ---  locals:
            2484                           real (kind=kind_phys), dimension(ncm) :: cmix
            2485                           real (kind=kind_phys), dimension(  2) :: denn
            2486                     !     real (kind=kind_phys), dimension(nspc) :: spcodp
            2487                     
            2488                           real (kind=kind_phys), dimension(nlay) :: delz, rh1, dz1
            2489                           integer,               dimension(nlay) :: idmaer
            2490                     
            2491                           real (kind=kind_phys), dimension(nlay,nswlwbd):: tauae,ssaae,asyae
            2492                     !test real (kind=kind_phys), dimension(imax,nlay) :: aersav
            2493                     
            2494                           real (kind=kind_phys) :: tmp1, tmp2, rps, dtmp, h1
            2495                           real (kind=kind_phys) :: wi, wj, w11, w12, w21, w22
            2496                     
            2497                           integer :: i, ii, i1, i2, i3,  j1, j2, j3,  k, m, m1,             &
            2498                          &           kp, kpa, kpi, kpj
            2499                     
            2500                     !  ---  conversion constants
            2501                           real (kind=kind_phys), parameter :: dltg = 360.0 / float(imxae)
            2502                           real (kind=kind_phys), parameter :: hdlt = 0.5 * dltg
            2503                           real (kind=kind_phys), parameter :: rdlt = 1.0 / dltg
            2504                     
            2505                     !
            2506                     !===>  ...  begin here
            2507                     !
            2508                     !  ---  map aerosol data to model grids
            2509                     
            2510                           i1 = 1
            2511                           i2 = 2
            2512                           j1 = 1
            2513                           j2 = 2
            2514                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz1, rh1
                                   <<< Loop-information  End >>>
            2515     1                     lab_do_imax : do i = 1, imax
            2516     1               
            2517     1               !  ---  map grid in longitude direction, lon from 0 to 355 deg resolution
            2518     1               
            2519     1               !       print *,' seeking lon index for point i =',i
            2520     1                       i3 = i1
            2521     2                       lab_do_imxae : do while ( i3 <= imxae )
            2522     2                         tmp1 = dltg * (i3 - 1)
            2523     2                         dtmp = alon(i) - tmp1
            2524     2               !         print *,'   alon, i3, tlon, dlon =',alon(i),i3,tmp1,dtmp
            2525     2               
            2526     3                         if ( dtmp > dltg ) then
            2527     3                           i3 = i3 + 1
            2528     4                           if ( i3 > imxae ) then
            2529     4                             print *,' error! in setclimaer alon>360. ipt =',i,        &
            2530     4                    &           ',  dltg,alon,tlon,dlon =',dltg,alon(i),tmp1,dtmp
            2531     4                             stop
            2532     4                           endif
            2533     3                         elseif ( dtmp >= f_zero ) then
            2534     3                           i1 = i3
            2535     3                           i2 = mod(i3,imxae) + 1
            2536     3                           wi = dtmp * rdlt
            2537     4                           if ( dtmp <= hdlt ) then
            2538     4                             kpi = i3
            2539     4                           else
            2540     4                             kpi = i2
            2541     4                           endif
            2542     3               !           print *,'   found i1, i2, wi =',i1,i2,wi
            2543     3                           exit lab_do_imxae
            2544     3                         else
            2545     3                           i3 = i3 - 1
            2546     4                           if ( i3 < 1 ) then
            2547     4                             print *,' error! in setclimaer alon< 0. ipt =',i,         &
            2548     4                    &           ',  dltg,alon,tlon,dlon =',dltg,alon(i),tmp1,dtmp
            2549     4                             stop
            2550     4                           endif
            2551     3                         endif
            2552     2                       enddo  lab_do_imxae
            2553     1               
            2554     1               
            2555     1               !org--  map grid in latitude direction, lat from 90n to 90s in 5 deg resolution
            2556     1               !cmy--------------------------------------------------------------------
            2557     1               !cmy    map grid in latitude direction, lat from 90s to 90n in 5 deg resolution
            2558     1               !cmy--------------------------------------------------------------------
            2559     1               
            2560     1               !       print *,' seeking lat index for point i =',i
            2561     1                       j3 = j1
            2562     2                       lab_do_jmxae : do while ( j3 <= jmxae )
            2563     2               !cmy--------------------------------------------------------------------
            2564     2               !cmy      tmp2 = 90.0 - dltg * (j3 - 1)
            2565     2               !cmy      dtmp = tmp2 - alat(i)
            2566     2               !cmy--------------------------------------------------------------------
            2567     2               !         print *,'   alat, j3, tlat, dlat =',alat(i),j3,tmp2,dtmp
            2568     2               !cmy
            2569     2                         tmp2 = -90.0 + dltg * (j3 - 1)
            2570     2                         dtmp =  alat(i) - tmp2
            2571     2               
            2572     3                         if ( dtmp > dltg ) then
            2573     3                           j3 = j3 + 1
            2574     4                           if ( j3 >= jmxae ) then
            2575     4                             print *,' error! in setclimaer alat<-90. ipt =',i,        &
            2576     4                    &           ',  dltg,alat,tlat,dlat =',dltg,alat(i),tmp2,dtmp
            2577     4                             stop
            2578     4                           endif
            2579     3                         elseif ( dtmp >= f_zero ) then
            2580     3                           j1 = j3
            2581     3                           j2 = j3 + 1
            2582     3                           wj = dtmp * rdlt
            2583     4                           if ( dtmp <= hdlt ) then
            2584     4                             kpj = j3
            2585     4                           else
            2586     4                             kpj = j2
            2587     4                           endif
            2588     3               !           print *,'   found j1, j2, wj =',j1,j2,wj
            2589     3                           exit lab_do_jmxae
            2590     3                         else
            2591     3                           j3 = j3 - 1
            2592     4                           if ( j3 < 1 ) then
            2593     4                             print *,' error! in setclimaer alat>90. ipt =',i,         &
            2594     4                    &           ',  dltg,alat,tlat,dlat =',dltg,alat(i),tmp2,dtmp
            2595     4                             stop
            2596     4                           endif
            2597     3                         endif
            2598     2                       enddo  lab_do_jmxae
            2599     1               
            2600     1               !  ---  determin the type of aerosol profile (kp) and scale hight for domain 1 (h1)
            2601     1               !       to be used at this grid point
            2602     1               
            2603     1                       kp = kprfg(kpi,kpj)                     ! nearest typical aeros profile as default
            2604     1                       kpa = max( kprfg(i1,j1),kprfg(i1,j2),kprfg(i2,j1),kprfg(i2,j2) )
            2605     1                       h1 = haer(1,kp)
            2606     1                       denn(2) = f_zero
            2607     1                       ii = 1
            2608     1               
            2609     2                       if ( kp /= kpa ) then
            2610     3                         if ( kpa == 6 ) then                  ! if ocean prof with mineral aeros overlay
            2611     3                           ii = 2                              ! need 2 types of densities
            2612     4                           if ( slmsk(i) > f_zero ) then       ! but actually a land/sea-ice point
            2613     4                             kp = 7                            ! reset prof index to land
            2614     4                             h1 = 0.5*(haer(1,6) + haer(1,7))  ! use a transition scale hight
            2615     4                           else
            2616     4                             kp = kpa
            2617     4                             h1 = haer(1,6)
            2618     4                           endif
            2619     3                         elseif ( kpa == 7 ) then              ! if land prof with mineral aeros overlay
            2620     3                           ii = 2                              ! need 2 types of densities
            2621     4                           if ( slmsk(i) <= f_zero ) then      ! but actually an ocean point
            2622     4                             kp = 6                            ! reset prof index to ocean
            2623     4                             h1 = 0.5*(haer(1,6) + haer(1,7))  ! use a transition scale hight
            2624     4                           else
            2625     4                             kp = kpa
            2626     4                             h1 = haer(1,7)
            2627     4                           endif
            2628     3                         else                                  ! lower atmos without mineral aeros overlay
            2629     3               !           h1 = 0.5*(haer(1,kp) + haer(1,kpa)) ! use a transition scale hight
            2630     3                           h1 = haer(1,kpa)
            2631     3                           kp = kpa
            2632     3                         endif
            2633     2                       endif
            2634     1               
            2635     1               !  ---  compute horizontal bi-linear interpolation weights
            2636     1               
            2637     1                       w11 = (f_one-wi) * (f_one-wj)
            2638     1                       w12 = (f_one-wi) *       wj
            2639     1                       w21 =        wi  * (f_one-wj)
            2640     1                       w22 =        wi  * wj
            2641     1               
            2642     1               !  ---  check print
            2643     1               !       print *,'  grid pt', i,',   alon, alat =',alon(i),alat(i),      &
            2644     1               !    &                       ',   tlon, tlat =',tmp1,tmp2
            2645     1               !       print *,'   lon grid index i1, i2 =',i1,i2,',  weight wi =',wi
            2646     1               !       print *,'   lat grid index j1, j2 =',j1,j2,',  weight wj =',wj
            2647     1               !       print *,'   bi-linear weights w11,w21,w12,w22 =',w11,w21,w12,w22
            2648     1               !       print *,'   kp,kpa,slmsk,h1 =',kp,m1,slmsk(i),h1
            2649     1               
            2650     1               !  ---  do horizontal bi-linear interpolation on aerosol partical density (denn)
            2651     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      denng, (unknown)
                                   <<< Loop-information  End >>>
            2652     2   s    v              do m = 1, ii                            ! ii=1 for domain 1; =2 for domain 2.
            2653     2   p    v                denn(m) = w11*denng(m,i1,j1) + w12*denng(m,i1,j2)             &
            2654     2                    &            + w21*denng(m,i2,j1) + w22*denng(m,i2,j2)
            2655     2   p    v              enddo  ! end_do_m_loop
            2656     1               
            2657     1               !  ---  do horizontal bi-linear interpolation on mixing ratios
            2658     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2659     1   s    v              cmix(:) = f_zero
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            2660     2   s   fs              do m = 1, nxc
            2661     2   p   fv                ii = idxcg(m,i1,j1)
            2662     3   p   fs                if ( ii > 0 ) then
            2663     3   m   fs                  cmix(ii) = cmix(ii) + w11*cmixg(m,i1,j1)
            2664     3   p   fv                endif
            2665     2   p   fv                ii = idxcg(m,i1,j2)
            2666     3   p   fs                if ( ii > 0 ) then
            2667     3   m   fs                  cmix(ii) = cmix(ii) + w12*cmixg(m,i1,j2)
            2668     3   p   fv                endif
            2669     2   p   fv                ii = idxcg(m,i2,j1)
            2670     3   p   fs                if ( ii > 0 ) then
            2671     3   m   fs                  cmix(ii) = cmix(ii) + w21*cmixg(m,i2,j1)
            2672     3   p   fv                endif
            2673     2   p   fv                ii = idxcg(m,i2,j2)
            2674     3   p   fs                if ( ii > 0 ) then
            2675     3   m   fs                  cmix(ii) = cmix(ii) + w22*cmixg(m,i2,j2)
            2676     3   p   fv                endif
            2677     2   p   fv              enddo  ! end_do_m_loop
            2678     1               
            2679     1               !  ---  check print
            2680     1               !       print *,'   denn =',denn(:)
            2681     1               !       print *,'   cmix =',cmix(:)
            2682     1               
            2683     1               !  ---  prepare to setup domain index array and effective layer thickness
            2684     1               !       also convert pressure level to sigma level to follow the terrain
            2685     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz1, rh1
                                   <<< Loop-information  End >>>
            2686     2  pp   2v              do k = 1, nlay
            2687     2   p   2v                rh1(k) = rhlay(i,k)
            2688     2   p   2v                dz1(k) = dz   (i,k)
            2689     2   p   2v              enddo
            2690     1               
            2691     2                       lab_if_flip : if (ivflip == 1) then       ! input from sfc to toa
            2692     2               
            2693     3                         if ( prsi(i,1) > 100.0 ) then
            2694     3                           rps = f_one / prsi(i,1)
            2695     3                         else
            2696     3                           print *,' !!! error in subr radiation_aerosols:',           &
            2697     3                    &              ' unrealistic surface pressure =', prsi(i,1)
            2698     3                           stop
            2699     3                         endif
            2700     2               
            2701     2                         ii = 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idmaer, delz
                                   <<< Loop-information  End >>>
            2702     3   s    s                do k = 1, nlay
            2703     4   m    m                  if (prsi(i,k+1)*rps < sigref(ii,kp)) then
            2704     4   s    s                    ii = ii + 1
            2705     5   s    s                    if (ii == 2 .and. prsref(2,kp) == prsref(3,kp)) then
            2706     5   s    s                      ii = 3
            2707     5   p    s                    endif
            2708     4   p    v                  endif
            2709     3   s    s                  idmaer(k) = ii
            2710     3               
            2711     4   s    s                  if ( ii > 1 ) then
            2712     4   m    s                    tmp1 = haer(ii,kp)
            2713     4   p    s                  else
            2714     4   p    s                    tmp1 = h1
            2715     4   p    v                  endif
            2716     3               
            2717     4   p    s                  if (tmp1 > f_zero) then
            2718     4   p    s                    tmp2 = f_one / tmp1
            2719     4   p    s                    delz(k) = tmp1 * (exp(-hz(i,k)*tmp2)-exp(-hz(i,k+1)*tmp2))
            2720     4   p    s                  else
            2721     4   p    s                    delz(k) = dz1(k)
            2722     4   p    v                  endif
            2723     3   p    v                enddo
            2724     2               
            2725     2                       else  lab_if_flip                         ! input from toa to sfc
            2726     2               
            2727     3                         if ( prsi(i,nlp1) > 100.0 ) then
            2728     3                           rps =  1.0 / prsi(i,nlp1)
            2729     3                         else
            2730     3                           print *,' !!! error in subr radiation_aerosols:',           &
            2731     3                    &              ' unrealistic surface pressure =', prsi(i,nlp1)
            2732     3                           stop
            2733     3                         endif
            2734     2               
            2735     2                         ii = 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idmaer, delz
                                   <<< Loop-information  End >>>
            2736     3   s    s                do k = nlay, 1, -1
            2737     4   m    m                  if (prsi(i,k)*rps < sigref(ii,kp)) then
            2738     4   s    s                    ii = ii + 1
            2739     5   s    s                    if (ii == 2 .and. prsref(2,kp) == prsref(3,kp)) then
            2740     5   s    s                      ii = 3
            2741     5   p    s                    endif
            2742     4   p    v                  endif
            2743     3   s    s                  idmaer(k) = ii
            2744     3               
            2745     4   s    s                  if ( ii > 1 ) then
            2746     4   m    s                    tmp1 = haer(ii,kp)
            2747     4   p    s                  else
            2748     4   p    s                    tmp1 = h1
            2749     4   p    v                  endif
            2750     3               
            2751     4   p    s                  if (tmp1 > f_zero) then
            2752     4   p    s                    tmp2   = f_one / tmp1
            2753     4   p    s                    delz(k) = tmp1 * (exp(-hz(i,k+1)*tmp2)-exp(-hz(i,k)*tmp2))
            2754     4   p    s                  else
            2755     4   p    s                    delz(k) = dz1(k)
            2756     4   p    v                  endif
            2757     3   p    v                enddo
            2758     2               
            2759     2                       endif  lab_if_flip
            2760     1               
            2761     1               !  ---  check print
            2762     1               
            2763     1               !       print *,' in setclimaer, profile:',i
            2764     1               !       print *,'  rh   :',rh1
            2765     1               !       print *,'  dz   :',dz1
            2766     1               !       print *,'  delz :',delz
            2767     1               !       print *,'  idmaer:',idmaer
            2768     1               
            2769     1               !  ---  calculate sw/lw aerosol optical properties for the
            2770     1               !       corresponding frequency bands
            2771     1               
            2772     1                       call radclimaer
            2773     1               !  ---  inputs:  (in-scope variables)
            2774     1               !  ---  outputs: (in-scope variables)
            2775     1               
            2776     2                       if ( laersw ) then
            2777     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tauae, asyae, ssaae
                                   <<< Loop-information  End >>>
            2778     3  pp                     do m = 1, nbdsw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.77, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssaae, tauae, asyae
                                   <<< Loop-information  End >>>
            2779     4   p   2v                  do k = 1, nlay
            2780     4   p   2v                    aerosw(i,k,m,1) = tauae(k,m)
            2781     4   p   2v                    aerosw(i,k,m,2) = ssaae(k,m)
            2782     4   p   2v                    aerosw(i,k,m,3) = asyae(k,m)
            2783     4   p   2v                  enddo
            2784     3   p                     enddo
            2785     2               
            2786     2               !  ---  total aod (optional)
            2787     2               !         do k = 1, nlay
            2788     2               !           aerodp(i,1) = aerodp(i,1) + tauae(k,nv_aod)
            2789     2               !         enddo
            2790     2               
            2791     2               !  ---  for diagnostic output (optional)
            2792     2               !         if ( lspcaod ) then
            2793     2               !           do m = 1, nspc
            2794     2               !             aerodp(i,m+1) = spcodp(m)
            2795     2               !           enddo
            2796     2               !         endif
            2797     2               
            2798     2                       endif     ! end if_larsw_block
            2799     1               
            2800     2                       if ( laerlw ) then
            2801     2               
            2802     3                         if ( nlwbnd == 1 ) then
            2803     3                           m1 = nswbnd + 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tauae, ssaae, asyae
                                   <<< Loop-information  End >>>
            2804     4  pp                       do m = 1, nbdlw
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.77, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssaae, tauae, asyae
                                   <<< Loop-information  End >>>
            2805     5   p   2v                    do k = 1, nlay
            2806     5   p   2v                      aerolw(i,k,m,1) = tauae(k,m1)
            2807     5   p   2v                      aerolw(i,k,m,2) = ssaae(k,m1)
            2808     5   p   2v                      aerolw(i,k,m,3) = asyae(k,m1)
            2809     5   p   2v                    enddo
            2810     4   p                       enddo
            2811     3                         else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tauae, asyae, ssaae
                                   <<< Loop-information  End >>>
            2812     4  pp                       do m = 1, nbdlw
            2813     4   p                         m1 = nswbnd + m
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.77, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssaae, tauae, asyae
                                   <<< Loop-information  End >>>
            2814     5   p   2v                    do k = 1, nlay
            2815     5   p   2v                      aerolw(i,k,m,1) = tauae(k,m1)
            2816     5   p   2v                      aerolw(i,k,m,2) = ssaae(k,m1)
            2817     5   p   2v                      aerolw(i,k,m,3) = asyae(k,m1)
            2818     5   p   2v                    enddo
            2819     4   p                       enddo
            2820     3                         endif
            2821     2               
            2822     2                       endif     ! end if_laerlw_block
            2823     1               
            2824     1                     enddo  lab_do_imax
            2825                     
            2826                     ! =================
            2827                           contains
            2828                     ! =================
            2829                     
            2830                     !--------------------------------
            2831                           subroutine radclimaer
            2832                     !................................
            2833                     
            2834                     !  ---  inputs:  (in scope variables)
            2835                     !  ---  outputs: (in scope variables)
            2836                     
            2837                     !  ==================================================================  !
            2838                     !                                                                      !
            2839                     !  compute aerosols optical properties in nswlwbd bands. there are     !
            2840                     !  seven different vertical profile structures. in the troposphere,    !
            2841                     !  aerosol distribution at each grid point is composed from up to      !
            2842                     !  six components out of a total of ten different substances.          !
            2843                     !                                                                      !
            2844                     !  ref: wmo report wcp-112 (1986)                                      !
            2845                     !                                                                      !
            2846                     !  input variables:                                                    !
            2847                     !     cmix   - mixing ratioes of aerosol components  -     ncm         !
            2848                     !     denn   - aerosol number densities              -     2           !
            2849                     !     rh1    - relative humidity                     -     nlay        !
            2850                     !     delz   - effective layer thickness             km    nlay        !
            2851                     !     idmaer - aerosol domain index                  -     nlay        !
            2852                     !     nxc    - number of different aerosol components-     1           !
            2853                     !     nlay   - vertical dimensions                   -     1           !
            2854                     !                                                                      !
            2855                     !  output variables:                                                   !
            2856                     !     tauae  - optical depth                         -     nlay*nswlwbd!
            2857                     !     ssaae  - single scattering albedo              -     nlay*nswlwbd!
            2858                     !     asyae  - asymmetry parameter                   -     nlay*nswlwbd!
            2859                     !!    aerodp - vertically integrated aer-opt-depth   -     imax*nspc+1 !
            2860                     !                                                                      !
            2861                     !  ==================================================================  !
            2862                     !
            2863                           real (kind=kind_phys) :: crt1, crt2
            2864                           parameter (crt1=30.0, crt2=0.03333)
            2865                     
            2866                     !  ---  inputs:
            2867                     !  ---  outputs:
            2868                     
            2869                     !  ---  locals:
            2870                           real (kind=kind_phys) :: cm, hd, hdi, sig0l, ratio, tt0,          &
            2871                          &      ex00, sc00, ss00, as00, ex01, sc01, ss01, as01,     tt1,    &
            2872                          &      ex02, sc02, ss02, as02, ex03, sc03, ss03, as03,     tt2,    &
            2873                          &      ext1, sca1, ssa1, asy1, drh0, drh1, rdrh
            2874                     
            2875                           integer :: ih1, ih2, kk, idom, icmp, ib, ii, ic, ic1
            2876                     
            2877                     !===> ...  begin here
            2878                     
            2879                     !     spcodp = f_zero
            2880                     
            2881                     !===> ... loop over vertical layers from top to surface
            2882                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extstra
                                   <<< Loop-information  End >>>
            2883     1  pp                 lab_do_layer : do kk = 1, nlay
            2884     1               
            2885     1               ! --- linear interp coeffs for rh-dep species
            2886     1               
            2887     1   p                   ih2 = 1
            2888     2   p                   do while ( rh1(kk) > rhlev(ih2) )
            2889     2   p                     ih2 = ih2 + 1
            2890     2   p                     if ( ih2 > nrhlev ) exit
            2891     2   p                   enddo
            2892     1   p                   ih1 = max( 1, ih2-1 )
            2893     1   p                   ih2 = min( nrhlev, ih2 )
            2894     1               
            2895     1   p                   drh0 = rhlev(ih2) - rhlev(ih1)
            2896     1   p                   drh1 = rh1(kk) - rhlev(ih1)
            2897     2   p                   if ( ih1 == ih2 ) then
            2898     2   p                     rdrh = f_zero
            2899     2   p                   else
            2900     2   p                     rdrh = drh1 / drh0
            2901     2   p                   endif
            2902     1               
            2903     1               ! --- assign optical properties in each domain
            2904     1               
            2905     1   p                   idom = idmaer(kk)
            2906     1               
            2907     2   p                   lab_if_idom : if (idom == 5) then
            2908     2               ! --- 5th domain - upper stratosphere assume no aerosol
            2909     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.21, ITR: 64, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2910     3   p   2v                do ib = 1, nswlwbd
            2911     3   p   2v                  tauae(kk,ib) = f_zero
            2912     4   p   2v                  if ( ib <= nswbnd ) then
            2913     4   p   2v                    ssaae(kk,ib) = 0.99
            2914     4   p   2v                    asyae(kk,ib) = 0.696
            2915     4   p   2v                  else
            2916     4   p   2v                    ssaae(kk,ib) = 0.5
            2917     4   p   2v                    asyae(kk,ib) = 0.3
            2918     4   p   2v                  endif
            2919     3   p   2v                enddo
            2920     2               
            2921     2   p                   elseif (idom == 4) then    lab_if_idom
            2922     2               ! --- 4th domain - stratospheric layers
            2923     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.42, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extstra
                                   <<< Loop-information  End >>>
            2924     3   p    v                do ib = 1, nswlwbd
            2925     3   p    v                  tauae(kk,ib) = extstra(ib) * delz(kk)
            2926     4   p    v                  if ( ib <= nswbnd ) then
            2927     4   p    v                    ssaae(kk,ib) = 0.99
            2928     4   p    v                    asyae(kk,ib) = 0.696
            2929     4   p    v                  else
            2930     4   p    v                    ssaae(kk,ib) = 0.5
            2931     4   p    v                    asyae(kk,ib) = 0.3
            2932     4   p    v                  endif
            2933     3   p    v                enddo
            2934     2               
            2935     2               ! --- compute aod from individual species' contribution (optional)
            2936     2               !         idx = idxspc(10)             ! for sulfate
            2937     2               !         if ( lspcaod ) then
            2938     2               !           spcodp(idx) = spcodp(idx) + tauae(kk,nv_aod)
            2939     2               !         endif
            2940     2               
            2941     2   p                   elseif (idom == 3) then    lab_if_idom
            2942     2               ! --- 3rd domain - free tropospheric layers
            2943     2               !   1:inso 0.17e-3; 2:soot 0.4; 7:waso 0.59983; n:730
            2944     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 16
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2945     3   p    v                do ib = 1, nswlwbd
            2946     3   p    v                  ex01 = extrhi(1,ib)
            2947     3   p    v                  sc01 = scarhi(1,ib)
            2948     3   p    v                  ss01 = ssarhi(1,ib)
            2949     3   p    v                  as01 = asyrhi(1,ib)
            2950     3               
            2951     3   p    v                  ex02 = extrhi(2,ib)
            2952     3   p    v                  sc02 = scarhi(2,ib)
            2953     3   p    v                  ss02 = ssarhi(2,ib)
            2954     3   p    v                  as02 = asyrhi(2,ib)
            2955     3               
            2956     3   p    v                  ex03 = extrhd(ih1,1,ib)                                     &
            2957     3                    &           + rdrh * (extrhd(ih2,1,ib) - extrhd(ih1,1,ib))
            2958     3   p    v                  sc03 = scarhd(ih1,1,ib)                                     &
            2959     3                    &           + rdrh * (scarhd(ih2,1,ib) - scarhd(ih1,1,ib))
            2960     3   p    v                  ss03 = ssarhd(ih1,1,ib)                                     &
            2961     3                    &           + rdrh * (ssarhd(ih2,1,ib) - ssarhd(ih1,1,ib))
            2962     3   p    v                  as03 = asyrhd(ih1,1,ib)                                     &
            2963     3                    &           + rdrh * (asyrhd(ih2,1,ib) - asyrhd(ih1,1,ib))
            2964     3               
            2965     3   p    v                  ext1 = 0.17e-3*ex01 + 0.4*ex02 + 0.59983*ex03
            2966     3   p    v                  sca1 = 0.17e-3*sc01 + 0.4*sc02 + 0.59983*sc03
            2967     3   p    v                  ssa1 = 0.17e-3*ss01*ex01 + 0.4*ss02*ex02 + 0.59983*ss03*ex03
            2968     3   p    v                  asy1 = 0.17e-3*as01*sc01 + 0.4*as02*sc02 + 0.59983*as03*sc03
            2969     3               
            2970     3   p    v                  tauae(kk,ib) = ext1 * 730.0 * delz(kk)
            2971     3   p    v                  ssaae(kk,ib) = min(f_one, ssa1/ext1)
            2972     3   p    v                  asyae(kk,ib) = min(f_one, asy1/sca1)
            2973     3               
            2974     3               ! --- compute aod from individual species' contribution (optional)
            2975     3               !           if ( lspcaod .and. ib==nv_aod ) then
            2976     3               !             spcodp(1) = spcodp(1) + 0.17e-3*ex01*730.0*delz(kk)   ! dust (inso)   #1
            2977     3               !             spcodp(2) = spcodp(2) + 0.4    *ex02*730.0*delz(kk)   ! black carbon  #2
            2978     3               !             spcodp(3) = spcodp(3) + 0.59983*ex03*730.0*delz(kk)   ! water soluble #7
            2979     3               !           endif
            2980     3               
            2981     3   p    v                enddo
            2982     2               

              42                     !     q1       - real, surface layer mean specific humidity        im   !
              43                     !     soiltyp  - integer, soil type (integer index)                im   !
              44                     !     vegtype  - integer, vegetation type (integer index)          im   !
              45                     !     sigmaf   - real, areal fractional cover of green vegetation  im   !
              46                     !     sfcemis  - real, sfc lw emissivity ( fraction )              im   !
              47                     !     dlwflx   - real, total sky sfc downward lw flux ( w/m**2 )   im   !
              48                     !     dswflx   - real, total sky sfc downward sw flux ( w/m**2 )   im   !
              49                     !     snet     - real, total sky sfc netsw flx into ground(w/m**2) im   !
              50                     !     delt     - real, time interval (second)                      1    !
              51                     !     tg3      - real, deep soil temperature (k)                   im   !
              52                     !     cm       - real, surface exchange coeff for momentum (m/s)   im   !
              53                     !     ch       - real, surface exchange coeff heat & moisture(m/s) im   !
              54                     !     prsl1    - real, sfc layer 1 mean pressure (pa)              im   !
              55                     !     prslki   - real,                                             im   !
              56                     !     zf       - real, height of bottom layer (m)                  im   !
              57                     !     islimsk  - integer, sea/land/ice mask (=0/1/2)               im   !
              58                     !     ddvel    - real,                                             im   !
              59                     !     slopetyp - integer, class of sfc slope (integer index)       im   !
              60                     !     shdmin   - real, min fractional coverage of green veg        im   !
              61                     !     shdmax   - real, max fractnl cover of green veg (not used)   im   !
              62                     !     snoalb   - real, upper bound on max albedo over deep snow    im   !
              63                     !     sfalb    - real, mean sfc diffused sw albedo (fractional)    im   !
              64                     !     flag_iter- logical,                                          im   !
              65                     !     flag_guess-logical,                                          im   !
              66                     !     isot     - integer, sfc soil type data source zobler or statsgo   !
              67                     !     ivegsrc  - integer, sfc veg type data source umd or igbp          !
              68                     !                                                                       !
              69                     !  input/outputs:                                                       !
              70                     !     weasd    - real, water equivalent accumulated snow depth (mm) im  !
              71                     !     snwdph   - real, snow depth (water equiv) over land          im   !
              72                     !     tskin    - real, ground surface skin temperature ( k )       im   !
              73                     !     tprcp    - real, total precipitation                         im   !
              74                     !     srflag   - real, snow/rain flag for precipitation            im   !
              75                     !     smc      - real, total soil moisture content (fractional)   im,km !
              76                     !     stc      - real, soil temp (k)                              im,km !
              77                     !     slc      - real, liquid soil moisture                       im,km !
              78                     !     canopy   - real, canopy moisture content (m)                 im   !
              79                     !     trans    - real, total plant transpiration (m/s)             im   !
              80                     !     tsurf    - real, surface skin temperature (after iteration)  im   !
              81                     !                                                                       !

             516     1  pp    v            do i = 1, imj
             517     2   p    v              if (flag_iter(i) .and. flag(i)) then
             518     2   p    v                rch(i)   = rho(i) * cp * ch(i) * wind(i)
             519     2   p    v                qsurf(i) = q1(i)  + evap(i) / (elocp * rch(i))
             520     2   p    v              endif
             521     1   p    v            enddo

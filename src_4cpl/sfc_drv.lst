             280     1                     do i = 1, imj
             281     2                       if (flag_iter(i) .and. flag(i)) then
             282     2               
             283     2               !  --- ...  noah: prepare variables to run noah lsm
             284     2               !   1. configuration information (c):
             285     2               !      ------------------------------
             286     2               !    couple  - couple-uncouple flag (=1: coupled, =0: uncoupled)
             287     2               !    ffrozp  - flag for snow-rain detection (1.=snow, 0.=rain)
             288     2               !    ice     - sea-ice flag (=1: sea-ice, =0: land)
             289     2               !    dt      - timestep (sec) (dt should not exceed 3600 secs) = delt
             290     2               !    zlvl    - height (m) above ground of atmospheric forcing variables
             291     2               !    nsoil   - number of soil layers (at least 2)
             292     2               !    sldpth  - the thickness of each soil layer (m)
             293     2               
             294     2                         couple = 1                      ! run noah lsm in 'couple' mode
             295     2               
             296     3                         if     (srflag(i) == 1.0) then  ! snow phase
             297     3                           ffrozp = 1.0
             298     3                         elseif (srflag(i) == 0.0) then  ! rain phase
             299     3                           ffrozp = 0.0
             300     3                         endif
             301     2                         ice = 0
             302     2               
             303     2                         zlvl = zf(i)
             304     2               
             305     2                         nsoil = km
             306     2                         sldpth(1) = - zsoil(i,1)
                                   <<< Loop-information Start >>>

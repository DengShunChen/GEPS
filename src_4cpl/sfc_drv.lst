                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sldpth
                                   <<< Loop-information  End >>>
             307     3  pp   2v                do k = 2, km
             308     3   p   2v                  sldpth(k) = zsoil(i,k-1) - zsoil(i,k)
             309     3   p   2v                enddo
             310     2               
             311     2               !   2. forcing data (f):
             312     2               !      -----------------
             313     2               !    lwdn    - lw dw radiation flux (w/m2)
             314     2               !    solnet  - net sw radiation flux (dn-up) (w/m2)
             315     2               !    sfcprs  - pressure at height zlvl above ground (pascals)
             316     2               !    prcp    - precip rate (kg m-2 s-1)
             317     2               !    sfctmp  - air temperature (k) at height zlvl above ground
             318     2               !    th2     - air potential temperature (k) at height zlvl above ground
             319     2               !    q2      - mixing ratio at height zlvl above ground (kg kg-1)
             320     2               
             321     2                         lwdn   = dlwflx(i)         !..downward lw flux at sfc in w/m2
             322     2                         swdn   = dswsfc(i)         !..downward sw flux at sfc in w/m2
             323     2                         solnet = snet(i)           !..net sw rad flx (dn-up) at sfc in w/m2
             324     2                         sfcems = sfcemis(i)
             325     2               
             326     2                         sfcprs = prsl1(i)
             327     2                         prcp   = rhoh2o * tprcp(i) / delt
             328     2                         sfctmp = t1(i)
             329     2                         th2    = theta1(i)
             330     2                         q2     = q0(i)
             331     2               
             332     2               !   3. other forcing (input) data (i):
             333     2               !      ------------------------------
             334     2               !    sfcspd  - wind speed (m s-1) at height zlvl above ground
             335     2               !    q2sat   - sat mixing ratio at height zlvl above ground (kg kg-1)
             336     2               !    dqsdt2  - slope of sat specific humidity curve at t=sfctmp (kg kg-1 k-1)
             337     2               
             338     2                         sfcspd = wind(i)
             339     2                         q2sat =  qs1(i)
             340     2                         dqsdt2 = q2sat * a23m4/(sfctmp-a4)**2
             341     2               
             342     2               !   4. canopy/soil characteristics (s):
             343     2               !      --------------------------------
             344     2               !    vegtyp  - vegetation type (integer index)                       -> vtype
             345     2               !    soiltyp - soil type (integer index)                             -> stype
             346     2               !    slopetyp- class of sfc slope (integer index)                    -> slope
             347     2               !    shdfac  - areal fractional coverage of green vegetation (0.0-1.0)
             348     2               !    shdmin  - minimum areal fractional coverage of green vegetation -> shdmin1d
             349     2               !    ptu     - photo thermal unit (plant phenology for annuals/crops)
             350     2               !    alb     - backround snow-free surface albedo (fraction)
             351     2               !    snoalb  - upper bound on maximum albedo over deep snow          -> snoalb1d
             352     2               !    tbot    - bottom soil temperature (local yearly-mean sfc air temp)
             353     2               
             354     2                         vtype = vegtype(i)
             355     2                         stype = soiltyp(i)
             356     2                         slope = slopetyp(i)
             357     2                         shdfac= sigmaf(i)
             358     2               
             359     2                         shdmin1d = shdmin(i)
             360     2                         shdmax1d = shdmax(i)
             361     2                         snoalb1d = snoalb(i)
             362     2               
             363     2                         ptu  = 0.0
             364     2                         alb  = sfalb(i)
             365     2                         tbot = tg3(i)
             366     2               
             367     2               !   5. history (state) variables (h):
             368     2               !      ------------------------------
             369     2               !    cmc     - canopy moisture content (m)
             370     2               !    t1      - ground/canopy/snowpack) effective skin temperature (k)   -> tsea
             371     2               !    stc(nsoil) - soil temp (k)                                         -> stsoil
             372     2               !    smc(nsoil) - total soil moisture content (volumetric fraction)     -> smsoil
             373     2               !    sh2o(nsoil)- unfrozen soil moisture content (volumetric fraction)  -> slsoil
             374     2               !    snowh   - actual snow depth (m)
             375     2               !    sneqv   - liquid water-equivalent snow depth (m)
             376     2               !    albedo  - surface albedo including snow effect (unitless fraction)
             377     2               !    ch      - surface exchange coefficient for heat and moisture (m s-1) -> chx
             378     2               !    cm      - surface exchange coefficient for momentum (m s-1)          -> cmx
             379     2               
             380     2                         cmc = canopy(i) * 0.001            ! convert from mm to m
             381     2                         tsea = tsurf(i)                    ! clu_q2m_iter
             382     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

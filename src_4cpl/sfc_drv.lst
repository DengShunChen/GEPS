             107                           subroutine sfc_drv                                                &
             108                     !...................................
             109                     !  ---  inputs: &
             110                                ( imj,im, km, ps, u1, v1, t1, q1, soiltyp, vegtype, sigmaf,  &
             111                                  sfcemis, dlwflx, dswsfc, snet, delt, tg3, cm, ch,          &
             112                                  prsl1, prslki, zf, islimsk, ddvel, slopetyp,               &
             113                                  shdmin, shdmax, snoalb, sfalb, flag_iter, flag_guess,      &
             114                                  isot, ivegsrc,                                             &
             115                     !  ---  in/outs: &
             116                                  weasd, snwdph, tskin, tprcp, srflag, smc, stc, slc,        &
             117                                  canopy,  tsurf, zorl,                                &
             118                     !            canopy, trans, tsurf, zorl,                                &
             119                     !  ---  outputs: &
             120                                  sncovr1, qsurf, gflux, drain, evap, hflx, ep, runoff,      &
             121                     !    &       cmm, chh, evbs, evcw, sbsno, snowc, stm, snohf,            &
             122                     !    &       smcwlt2, smcref2, wet1                                     &
             123                                  albedo2, jj, io, jo)
             124                     !
             125                           use machine , only : kind_phys
             126                     !     use funcphys, only : fpvs
             127                           use physcons, only : grav   => con_g,    cp   => con_cp,          &
             128                                                hvap   => con_hvap, rd   => con_rd,          &
             129                                                eps    => con_eps, epsm1 => con_epsm1,       &
             130                                                rvrdm1 => con_fvirt
             131                           use const,    only : RTYPE
             132                     
             133                           implicit none
             134                     
             135                     !  ---  constant parameters:
             136                           real(kind=kind_phys), parameter :: cpinv   = 1.0/cp
             137                           real(kind=kind_phys), parameter :: hvapi   = 1.0/hvap
             138                           real(kind=kind_phys), parameter :: elocp   = hvap/cp
             139                           real(kind=kind_phys), parameter :: rhoh2o  = 1000.0
             140                           real(kind=kind_phys), parameter :: a2      = 17.2693882
             141                           real(kind=kind_phys), parameter :: a3      = 273.16
             142                           real(kind=kind_phys), parameter :: a4      = 35.86
             143                           real(kind=kind_phys), parameter :: a23m4   = a2*(a3-a4)
             144                     
             145                           real(kind=kind_phys), save         :: zsoil_noah(4)

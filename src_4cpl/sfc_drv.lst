             388     2               
             389     2                         snowh = snwdph(i) * 0.001         ! convert from mm to m
             390     2                         sneqv = weasd(i)  * 0.001         ! convert from mm to m
             391     3                         if (sneqv /= 0.0 .and. snowh == 0.0) then

             152                     
             153                           real (kind=RTYPE), dimension(im), intent(in) :: u1, v1, t1, q1
             154                           real (kind=kind_phys), dimension(im), intent(in) :: ps,           &
             155                                  sigmaf, sfcemis, dlwflx, dswsfc, snet, tg3, cm,            &
             156                                  ch, prsl1, prslki, ddvel, shdmin, shdmax,                  &
             157                                  snoalb, sfalb, zf
             158                     
             159                           integer, dimension(im), intent(in) :: islimsk
             160                           real (kind=kind_phys),  intent(in) :: delt
             161                     
             162                           logical, dimension(im), intent(in) :: flag_iter, flag_guess
             163                     
             164                     !  ---  in/out:
             165                     !     real (kind=kind_phys), dimension(im), intent(inout) :: weasd,     &
             166                           real (kind=kind_phys), dimension(im) :: weasd,     &
             167                                  snwdph, tskin, tprcp, srflag, canopy, trans, tsurf
             168                     
             169                           real (kind=kind_phys), dimension(im,km), intent(inout) ::         &
             170                                  smc, stc, slc
             171                     
             172                     !  ---  output:
             173                     !     real (kind=kind_phys), dimension(im), intent(out) :: sncovr1,     &
             174                           real (kind=kind_phys), dimension(im)  :: sncovr1,     &
             175                                  qsurf, gflux, drain, evap, hflx, ep, runoff, cmm, chh,     &
             176                                  evbs, evcw, sbsno, snowc, stm, snohf, smcwlt2, smcref2,    &
             177                                  zorl, wet1, albedo2
             178                     
             179                     !  ---  locals:
             180                           real (kind=kind_phys), dimension(im) :: rch, rho,                 &
             181                                  q0, qs1, theta1, wind, weasd_old, snwdph_old,              &
             182                                  tprcp_old, srflag_old, tskin_old, canopy_old
             183                     
             184                           real (kind=kind_phys), dimension(km) :: et, sldpth, stsoil,       &

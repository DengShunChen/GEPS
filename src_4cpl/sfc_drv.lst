              83                     !     sncovr1  - real, snow cover over land (fractional)           im   !
              84                     !     qsurf    - real, specific humidity at sfc                    im   !
              85                     !     gflux    - real, soil heat flux (w/m**2)                     im   !
              86                     !     drain    - real, subsurface runoff (mm/s)                    im   !
              87                     !     evap     - real, evaperation from latent heat flux           im   !
              88                     !     hflx     - real, sensible heat flux                          im   !
              89                     !     ep       - real, potential evaporation                       im   !
              90                     !     runoff   - real, surface runoff (m/s)                        im   !
              91                     !     cmm      - real,                                             im   !
              92                     !     chh      - real,                                             im   !
              93                     !     evbs     - real, direct soil evaporation (m/s)               im   !
              94                     !     evcw     - real, canopy water evaporation (m/s)              im   !
              95                     !     sbsno    - real, sublimation/deposit from snopack (m/s)      im   !
              96                     !     snowc    - real, fractional snow cover                       im   !
              97                     !     stm      - real, total soil column moisture content (m)      im   !
              98                     !     snohf    - real, snow/freezing-rain latent heat flux (w/m**2)im   !
              99                     !     smcwlt2  - real, dry soil moisture threshold                 im   !
             100                     !     smcref2  - real, soil moisture threshold                     im   !
             101                     !     zorl     - real, surface roughness                           im   !
             102                     !     wet1     - real, normalized soil wetness                     im   !

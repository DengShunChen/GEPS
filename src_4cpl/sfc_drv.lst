             189                     
             190                           real (kind=kind_phys) :: alb, albedo, beta, chx, cmx, cmc,        &
             191                                  dew, drip, dqsdt2, ec, edir, ett, eta, esnow, etp,         &
             192                                  flx1, flx2, flx3, ffrozp, lwdn, pc, prcp, ptu, q2,         &
             193                                  q2sat, solnet, rc, rcs, rct, rcq, rcsoil, rsmin,           &
             194                                  runoff1, runoff2, runoff3, sfcspd, sfcprs, sfctmp,         &
             195                                  sfcems, sheat, shdfac, shdmin1d, shdmax1d, smcwlt,         &
             196                                  smcdry, smcref, smcmax, sneqv, snoalb1d, snowh,            &
             197                                  snomlt, sncovr, soilw, soilm, ssoil, tsea, th2, tbot,      &
             198                                  xlai, zlvl, swdn, tem,z0,fpvs,ttmp
             199                     
             200                           integer :: couple, ice, nsoil, nroot, slope, stype, vtype
             201                           integer :: i, k
             202                           integer :: jj, io,jo
             203                     
             204                           logical :: flag(im)
             205                     !
             206                     !===> ...  begin here
             207                     !
             208                     
             209                     !  --- ...  set flag for land points
             210                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 192, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      islimsk, flag
                                   <<< Loop-information  End >>>
             211     1  pp   2v            do i = 1, imj
             212     1   p   2v              flag(i) = (islimsk(i) == 1)
             213     1   p   2v            enddo
             214                     
             215                     !  --- ...  save land-related prognostic fields for guess run
             216                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
             217     1  pp                 do i = 1, imj
             218     2   p                   if (flag(i) .and. flag_guess(i)) then
             219     2   p                     weasd_old(i)  = weasd(i)
             220     2   p                     snwdph_old(i) = snwdph(i)
             221     2   p                     tskin_old(i)  = tskin(i)
             222     2   p                     canopy_old(i) = canopy(i)
             223     2   p                     tprcp_old(i)  = tprcp(i)
             224     2   p                     srflag_old(i) = srflag(i)
             225     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.41, ITR: 80, MVE: 3, POL: S)
                                   <<< Loop-information  End >>>
             226     3   p   2v                do k = 1, km
             227     3   p   2v                  smc_old(i,k) = smc(i,k)
             228     3   p   2v                  stc_old(i,k) = stc(i,k)
             229     3   p   2v                  slc_old(i,k) = slc(i,k)
             230     3   p   2v                enddo
             231     2   p                   endif
             232     1   p                 enddo
             233                     
             234                     !  --- ...  initialization block
             235                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.11, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag_iter, ep, evap, hflx, flag, gflux
                                   <<<      drain, canopy, evbs, evcw, trans, sbsno
                                   <<<      snowc, snohf
                                   <<< Loop-information  End >>>
             236     1  pp    v            do i = 1, imj
             237     2   p    v              if (flag_iter(i) .and. flag(i)) then
             238     2   p    v                ep(i)     = 0.0
             239     2   p    v                evap (i)  = 0.0
             240     2   p    v                hflx (i)  = 0.0
             241     2   p    v                gflux(i)  = 0.0
             242     2   p    v                drain(i)  = 0.0
             243     2   p    v                canopy(i) = max(canopy(i), 0.0)
             244     2               
             245     2   p    v                evbs (i)  = 0.0
             246     2   p    v                evcw (i)  = 0.0
             247     2   p    v                trans(i)  = 0.0
             248     2   p    v                sbsno(i)  = 0.0
             249     2   p    v                snowc(i)  = 0.0
             250     2   p    v                snohf(i)  = 0.0
             251     2   p    v              endif
             252     1   p    v            enddo
             253                     
             254                     !  --- ...  initialize variables
             255                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flag_iter
                                   <<< Loop-information  End >>>
             256     1   s    s            do i = 1, imj
             257     2   p    v              if (flag_iter(i) .and. flag(i)) then
             258     2   p    v                wind(i) = max(sqrt( u1(i)*u1(i) + v1(i)*v1(i) )               &
             259     2                                     + max(0.0, min(ddvel(i), 30.0)), 1.0)
             260     2               
             261     2   p    v                q0(i)   = max(q1(i), 1.e-8)   !* q1=specific humidity at level 1 (kg/kg)
             262     2   p    v                theta1(i) = t1(i) * prslki(i) !* adiabatic temp at level 1 (k)
             263     2               
             264     2   p    v                rho(i) = prsl1(i) / (rd*t1(i)*(1.0+rvrdm1*q0(i)))
             265     2   s    s                ttmp   = t1(i)
             266     2   s    s                qs1(i) = fpvs( ttmp )        !* qs1=sat. humidity at level 1 (kg/kg)
             267     2   p    v                qs1(i) = max(eps*qs1(i) / (prsl1(i)+epsm1*qs1(i)), 1.e-8)
             268     2   p    v                q0 (i) = min(qs1(i), q0(i))
             269     2   p    v              endif
             270     1   p    v            enddo

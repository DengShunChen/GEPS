             416     2                            edir, et, ett, esnow, drip, dew, beta, etp, ssoil,         &
             417     2                            flx1, flx2, flx3, runoff1, runoff2, runoff3,               &
             418     2                            snomlt, sncovr, rc, pc, rsmin, xlai, rcs, rct, rcq,        &
             419     2                            rcsoil, soilw, soilm, smcwlt, smcdry, smcref, smcmax)
             420     2               
             421     2               !  --- ...  noah: prepare variables for return to parent mode
             422     2               !   6. output (o):

             543     4   p   2v                  do k = 1, km
             544     4   p   2v                    smc(i,k) = smc_old(i,k)
             545     4   p   2v                    stc(i,k) = stc_old(i,k)
             546     4   p   2v                    slc(i,k) = slc_old(i,k)

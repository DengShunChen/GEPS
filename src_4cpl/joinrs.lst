 External subroutine subprogram "joinrs_sp"
  (inc)(line-no.)(nest)(optimize)
             169                     !-----------------------------------------------------------------
             170                     !CWB2021 for single precision test
             171                     
             172                           subroutine joinrs_sp(cc,r1,r2,r3,r4,nx,my_max,lev,jlistnum,num,ncld)
             173                     !
             174                           implicit  none
             175                           real*4      cc(*), r1(*), r2(*), r3(*), r4(*)
             176                           integer   nx,my_max,lev,jlistnum,num,ncld
             177                     !
             178                           if(num .eq. 1) call join1rs_sp(cc,r1,nx,my_max,lev,jlistnum,ncld)
             179                           if(num .eq. 2) call join2rs_sp(cc,r1,r2,nx,my_max,lev,jlistnum,ncld)
             180                           if(num .eq. 3) call join3rs_sp(cc,r1,r2,r3,nx,my_max,lev,jlistnum,ncld)
             181                     !
             182                           return
             183                           end


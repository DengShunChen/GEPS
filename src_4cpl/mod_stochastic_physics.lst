             672                       subroutine get_stochy_physics(rpattern,nscale,nlev,vfact,n3d)
             673                     !------------------------------------------------------------------------!
             674                     !  purpose: To generate 3D SPPT strucutre
             675                     !  output: n3d
             676                     !------------------------------------------------------------------------!
             677                         implicit none
             678                         integer :: n, ii, i, jj, j, k, nxj, nlev
             679                         integer, intent(in) :: nscale
             680                         real, intent(in) :: vfact(nlev)
             681                         type(random_pattern), intent(inout) :: rpattern(nscale)
             682                         real(kind=RTYPE), intent(  out) :: n3d(nxp,nlev,my_max)
             683                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d
                                   <<< Loop-information  End >>>
             684        pp   4v          n3d = 0.
             685     1                   do n=1,nscale
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             686     2  pp                 do jj=1,jlistnum
             687     2   p                   j=jlist1(jj)
             688     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             689     3   p                   do k=1,nlev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 208, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             690     4   p   2v                do i=1,nxj
             691     4   p   2v                  n3d(i,k,jj)=n3d(i,k,jj)+rpattern(n)%n2d(i,jj)*vfact(k)
             692     4   p   2v                enddo
             693     3   p                   enddo
             694     2   p                 enddo
             695     1                   enddo
             696                     

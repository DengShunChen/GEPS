             313                       subroutine init_skeb(dtau)
             314                         implicit none
             315                         real :: dtau
             316                         integer :: n, k, k2
             317                         real, allocatable,dimension(:) :: skeb_vloc
             318                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             319     1       f           do n=1,size(skeb)
             320     2       f             if (skeb(n) > 0) then
             321     2       f               nskeb=nskeb+1
             322     2       f             else
             323     2       f               exit
             324     2       f             endif
             325     1       f           enddo
             326                     
             327         s   2s          allocate(rpattern_skeb(nskeb))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb, skeb_lscale, skeb_seed
                                   <<<      skeb_decort, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 9  FILL 22
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             328     1   m    s          do n=1,nskeb
             329     2   p    v            if ( skebnorm .eq. 0 ) then ! stream function norm
             330     2   p    v              rpattern_skeb(n)%stdev = skeb(n)*1.111e3*sqrt(dtau)
             331     2   p    v            endif
             332     2   p    v            if ( skebnorm .eq. 1 ) then ! kinectic energy function norm
             333     2        v              rpattern_skeb(n)%stdev = skeb(n)*0.00222e3*sqrt(dtau)
             334     2        v            endif
             335     2        v            if ( skebnorm .eq. 2 ) then ! vorticity function norm
             336     2                      rpattern_skeb(n)%stdev = skeb(n)*1.111e-9*sqrt(dtau)
             337     2   p    v            endif
             338     1   p    v            rpattern_skeb(n)%decortau = skeb_decort(n)
             339     1   p    v            rpattern_skeb(n)%lenscale = skeb_lscale(n)
             340     1   p    v            rpattern_skeb(n)%seed = int(skeb_seed(n))
             341     2   s    s            if (myrank .eq. 0 ) then
             342     2   s    m              write(6,*)'mod_stochastic_physics : skeb : stdev  ',skeb(n)
             343     2   s    m              write(6,*)'mod_stochastic_physics : skeb : decort ',skeb_decort(n)
             344     2   s    m              write(6,*)'mod_stochastic_physics : skeb : lscale ',skeb_lscale(n)
             345     2   s    s              write(6,*)'mod_stochastic_physics : skeb : seed   ',skeb_seed(n)
             346     2   p    v            endif
             347     1   p    v          enddo
             348                     
             349                         allocate(skeb3du(nxp,lev,my_max))
             350                         allocate(skeb3dv(nxp,lev,my_max))
             351                         allocate(diss_est(nxp,lev,my_max))
             352                         allocate(keb(nxp,lev,my_max))
             353                         allocate(kea(nxp,lev,my_max))
             354                     
             355                         ! for 3 time level scheme to keep skeblevs same and make sure can be
             356                         ! reproduced when restart ( restart function not ready yet ).
             357     1                   if ( first_call ) then
             358     1                     skeblevs=nint(rpattern_skeb(1)%decortau/(2.*dtau)*skeb_vdof)
             359     1                   else
             360     1                     skeblevs=nint(rpattern_skeb(1)%decortau/dtau*skeb_vdof)
             361     1                   endif
             362                     
             363                         call get_random_pattern_init(rpattern_skeb,nskeb,dtau,.true.)
             364                     
             365                         ! set up vfact_skeb
             366                         allocate(vfact_skeb(lev))
             367                         allocate(skeb_vloc(skeblevs))
             368                         allocate(skeb_vwts(lev,2))
             369                         allocate(skeb_vpts(lev,2))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_skeb
                                   <<< Loop-information  End >>>
             370     1  pp   2v          do k=1,lev
             371     2   p   2v            if (sl(k) .lt. skeb_sigtop1 .and. sl(k) .gt. skeb_sigtop2) then
             372     2   p   2v               vfact_skeb(k) = (sl(k)-skeb_sigtop2)/(skeb_sigtop1-skeb_sigtop2)
             373     2   p   2v            else if (sl(k) .lt. skeb_sigtop2) then
             374     2   p   2v                vfact_skeb(k) = 0.0
             375     2   p   2v            else
             376     2   p   2v                vfact_skeb(k) = 1.0
             377     2   p   2v            endif
             378     1   p   2v          enddo
             379                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vfact_skeb, sl
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             380     1   s    s          do k=1,lev
             381     1   p    v            if (myrank == 0) print *,'mod_stochastic_physics : k,sl,vfact_skeb',k,sl(k),vfact_skeb(k)
             382     1   p    v          enddo
             383                         ! calculate vertical interpolation weights
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vloc
                                   <<< Loop-information  End >>>
             384     1  pp   2v          do k=1,skeblevs
             385     1   p   2v            skeb_vloc(k)=sl(lev)-real(skeblevs-k)/real(skeblevs-1.0)*(sl(lev)-sl(1))
             386     1   p   2v          enddo
             387                         ! surface
             388                         skeb_vwts(lev,2)=0.
             389                         skeb_vpts(lev,1)=skeblevs-2
             390                         ! top
             391                         skeb_vwts(1,2)=1.
             392                         skeb_vpts(1,1)=1
             393                         ! internal
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl
                                   <<< Loop-information  End >>>
             394     1  pp   2s          do k=2,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             395     2       2             do k2=1,skeblevs-1
             396     3   p   2m              if (sl(k) .LE. skeb_vloc(k2+1) .AND. sl(k) .GT. skeb_vloc(k2)) then
             397     3   p   2s                skeb_vpts(k,1)=k2
             398     3   p   2s                skeb_vwts(k,2)=(sl(k)-skeb_vloc(k2))/(skeb_vloc(k2+1)-skeb_vloc(k2))
             399     3   p   2v              endif
             400     2       2             enddo
             401     1       2v          enddo
             402                         deallocate(skeb_vloc)
             403     1                   if (myrank .eq. 0) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vpts, skeb_vwts
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             404     2   s    s            do k=1,lev
             405     2   m    m              print*,'skeb vpts ',skeb_vpts(k,1),skeb_vwts(k,2)
             406     2   p    v            enddo
             407     1                   endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vwts
                                   <<< Loop-information  End >>>
             408        pp   2v          skeb_vwts(:,1)=1.0-skeb_vwts(:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 352, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vpts
                                   <<< Loop-information  End >>>
             409        pp   2v          skeb_vpts(:,2)=skeb_vpts(:,1)+1
             410                     
             411                       end subroutine init_skeb
             412                     

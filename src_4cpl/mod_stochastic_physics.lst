             699                       subroutine get_stochy_physics_vect(rpattern,nscale,nlev,vfact,n3du,n3dv)
             700                     !------------------------------------------------------------------------!
             701                     !  purpose: To generate 3D SKEB strucutre
             702                     !  output: n3du n3dv
             703                     !------------------------------------------------------------------------!
             704                         implicit none
             705                         integer :: n, ii, i, jj, j, k, nxj, nlev
             706                         integer, intent(in) :: nscale
             707                         real, intent(in) :: vfact(nlev)
             708                         type(random_pattern), intent(inout) :: rpattern(nscale)

            1547                       subroutine spectrun_inp2d(jcap1,jtr,jtm,mlsort,ns,speci,speco)
            1548                     !
            1549                     ! use spectral truncation to change resoltuion
            1550                     !
            1551                           implicit none
            1552                           integer lev,jtr,jcap1,jtm,ns,ml
            1553                           real(kind=RTYPE) speci(jcap1*(jcap1+1)/2,2)
            1554                           real(kind=RTYPE) speco(jtr,jtm*ns*2)
            1555                           integer i,j,k,jj,jp,jr,j1,j2
            1556                           integer mlsort(jcap1,jcap1)
            1557                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1558        pp   4v            speco(:,:) = 0.0
            1559     1                     if( jcap1.gt.jtr ) then
            1560     2                         do j=1,jcap1
            1561     3                           if( j.le.jtr ) then
            1562     3                             jj=nlist(j)
            1563     3                             jp=(jj-1)/jtm
            1564     3                             jr=mod(jj-1,jtm)+1
            1565     3                             j1=jp*jtm*2+jr
            1566     3                             j2=j1+jtm
            1567     3                           endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1568     3  pp   2s                  do i=j,jcap1
            1569     3   p   2v                    ml=mlsort(j,i)
            1570     4   p   2s                    if( i.le.jtr ) then
            1571     4   p   2s                      speco(i,j1) = speci(ml,1)
            1572     4   p   2s                      speco(i,j2) = speci(ml,2)
            1573     4   p   2v                    endif
            1574     3   p   2v                  enddo
            1575     2                         enddo
            1576     1                     else if( jcap1.lt.jtr ) then
            1577     2                         do j=1,jtr
            1578     2                           jj=nlist(j)
            1579     2                           jp=(jj-1)/jtm
            1580     2                           jr=mod(jj-1,jtm)+1
            1581     2                           j1=jp*jtm*2+jr
            1582     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1583     3  pp   2s                  do i=j,jtr
            1584     4   p   2m                    if( i.le.jcap1 ) then
            1585     4   p   2s                      ml=mlsort(j,i)
            1586     4   p   2s                      speco(i,j1) = speci(ml,1)
            1587     4   p   2s                      speco(i,j2) = speci(ml,2)
            1588     4   p   2v                    endif
            1589     3   p   2v                  enddo
            1590     2                         enddo
            1591     1                     else      ! jcap1=jtr
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1592     2                         do j=1,jtr
            1593     2                           jj=nlist(j)
            1594     2                           jp=(jj-1)/jtm
            1595     2                           jr=mod(jj-1,jtm)+1
            1596     2                           j1=jp*jtm*2+jr
            1597     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1598     3  pp   2v                  do i=j,jtr
            1599     3   p   2v                    ml=mlsort(j,i)
            1600     3   p   2v                    speco(i,j1) = speci(ml,1)
            1601     3   p   2v                    speco(i,j2) = speci(ml,2)
            1602     3   p   2v                  enddo
            1603     2                         enddo
            1604     1                     endif
            1605                     
            1606                           return
            1607                       end subroutine spectrun_inp2d

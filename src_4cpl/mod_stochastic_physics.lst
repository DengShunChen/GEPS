            1448                       subroutine skebctl(tau)
            1449                     !
            1450                         use const, only : idtg,sinl,sigma
            1451                         use rank, only : myrank
            1452                     
            1453                         integer :: nxj,j,k,itau,ch,iter,remd,js,je,kk,lev1, mn, n
            1454                         real :: pi, r2d, dlon, tau
            1455                         real, allocatable :: mlat(:),prsl(:)
            1456                         character(len=30) ::  forydef,forzdef
            1457                     
            1458                         character yy*4,dd*2,hh*2,mm*2,dtg*12
            1459                         character*3 mon(12)
            1460                         logical jrem
            1461                     
            1462                         data mon/'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep' &
            1463                                  ,'Oct','Nov','Dec'/
            1464                     
            1465                         allocate(mlat(my),prsl(lev))
            1466                     
            1467                         itau=tau
            1468                         ch=10
            1469                         lev1=1
            1470                         pi=4.0*atan(1.0)
            1471                         r2d=180./pi
            1472                         dlon=360./float(nx)
            1473                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    MULTI-OPERATION FUNCTION
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, mlat
                                   <<< Loop-information  End >>>
            1474     1  pp   2v          do j=1,my
            1475     1   p   2v            mlat(j)=asin(sinl(j))*r2d
            1476     1   p   2v          enddo
            1477                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.45, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, prsl
                                   <<< Loop-information  End >>>
            1478     1  pp   2v          do k=1,lev
            1479     1   p   2v            kk=lev-k+1
            1480     1   p   2v            prsl(kk)=sigma(k,2)+sigma(k+1,2)
            1481     1   p   2v            prsl(kk)=prsl(kk)+(sigma(k,1)+sigma(k+1,1))*1000.
            1482     1   p   2v            prsl(kk)=0.5*prsl(kk)/1000.
            1483     1   p   2v          enddo
            1484                     
            1485                           write(forydef,8) my
            1486                           write(forzdef,9) lev
            1487                     
            1488                           write(dtg,'(I12)') idtg
            1489                           read(dtg,'(A4,I2,A2,A2,A2)') yy,mn,dd,hh,mm
            1490                     
            1491     1                     if ( myrank .eq. 0 ) then
            1492     1                     OPEN(UNIT=ch, FILE='skeb.ctl', STATUS='UNKNOWN'             &
            1493     1                        , ACCESS='SEQUENTIAL')
            1494     1               
            1495     1                     write(ch,'(A23)') 'dset ^skeb.dat'
            1496     1                     write(ch,'(A18)') 'options big_endian'
            1497     1                     write(ch,'(A12)') 'undef -999.0'
            1498     1                     write(ch,12) 'ydef' ,my, 'levels'
            1499     1                     iter=my/8
            1500     1                     remd=mod(my,8)
            1501     1                     jrem=(remd .eq. 0)
            1502     1                     write(forydef,8) remd
            1503     2   s    s            do j=1,iter
            1504     2   p    v             js=1+8*(j-1)
            1505     2   p    v             je=js+7
            1506     2   m    s             write(10,10) mlat(js:je)
            1507     2   p    v            enddo
            1508     1                     if ( .not. jrem ) write(10,forydef) mlat(je+1:my)
            1509     1               
            1510     1                     write(ch,13) 'xdef'  ,nx, 'linear 0.0',dlon
            1511     1                     write(ch,14) 'tdef',itau, 'linear',hh,'Z',dd,mon(mn),yy,'1hr'
            1512     1                     write(ch,12) 'zdef' ,lev, 'levels '
            1513     1                     iter=lev/8
            1514     1                     remd=mod(lev,8)
            1515     1                     jrem=(remd .eq. 0)
            1516     1                     write(forzdef,9) remd
            1517     2   s    s            do j=1,iter
            1518     2   p    v             js=1+8*(j-1)
            1519     2   p    v             je=js+7
            1520     2   m    s             write(10,11) prsl(js:je)
            1521     2   p    v            enddo
            1522     1                     if ( .not. jrem ) write(10,forzdef) prsl(je+1:my)
            1523     1                     write(ch,'(A4,1X,I2)') 'vars',5
            1524     1                     write(ch,16) 'skebu  '   , lev,'99','U-dir 3D Random Pattern'
            1525     1                     write(ch,16) 'skebv  '   , lev,'99','V-dir 3D Random Pattern'
            1526     1                     write(ch,16) 'dissest'   , lev,'99','dissipation of KE      '
            1527     1                     write(ch,16) 'keb    '   , lev,'99','kE before SKEB         '
            1528     1                     write(ch,16) 'kea    '   , lev,'99','KE after SKEB          '
            1529     1                     write(ch,'(A7)') 'endvars'
            1530     1               
            1531     1                     close(ch)
            1532     1                     endif
            1533                     
            1534                     8     format("(",I4,"(2x,F11.7))")
            1535                     9     format("(",I4,"(2x,F7.5))")
            1536                     10    format(8(2x,F11.7))
            1537                     11    format(8(2x,F7.5))
            1538                     12    format(A4,1X,I4,1X,A6)
            1539                     13    format(A4,1X,I4,1X,A10,1X,F10.7)
            1540                     14    format(A4,1X,I4,1X,A6,1X,A2,A1,A2,A3,A4,1X,A3)
            1541                     15    format(A5,I1,3X,I3,1X,A2,1X,F7.1,A20)
            1542                     16    format(A7,3X,I3,1X,A2,1X,A23)
            1543                     
            1544                         deallocate(mlat,prsl)
            1545                       end subroutine skebctl

             315                       subroutine init_skeb(dtau)
             316                         implicit none
             317                         real :: dtau
             318                         integer :: n, k, k2
             319                         real, allocatable,dimension(:) :: skeb_vloc
             320                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             321     1       f           do n=1,size(skeb)
             322     2       f             if (skeb(n) > 0) then
             323     2       f               nskeb=nskeb+1
             324     2       f             else
             325     2       f               exit
             326     2       f             endif
             327     1       f           enddo
             328                     
             329         s   2s          allocate(rpattern_skeb(nskeb))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb, skeb_lscale, skeb_seed
                                   <<<      skeb_decort, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 9  FILL 22
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             330     1   m    s          do n=1,nskeb
             331     2   p    v            if ( skebnorm .eq. 0 ) then ! stream function norm
             332     2   p    v              rpattern_skeb(n)%stdev = skeb(n)*1.111e3*sqrt(dtau)
             333     2   p    v            endif
             334     2   p    v            if ( skebnorm .eq. 1 ) then ! kinectic energy function norm
             335     2        v              rpattern_skeb(n)%stdev = skeb(n)*0.00222e3*sqrt(dtau)
             336     2        v            endif
             337     2        v            if ( skebnorm .eq. 2 ) then ! vorticity function norm
             338     2                      rpattern_skeb(n)%stdev = skeb(n)*1.111e-9*sqrt(dtau)
             339     2   p    v            endif
             340     1   p    v            rpattern_skeb(n)%decortau = skeb_decort(n)
             341     1   p    v            rpattern_skeb(n)%lenscale = skeb_lscale(n)
             342     1   p    v            rpattern_skeb(n)%seed = int(skeb_seed(n))
             343     2   s    s            if (myrank .eq. 0 ) then
             344     2   s    m              write(6,*)'mod_stochastic_physics : skeb : stdev  ',skeb(n)
             345     2   s    m              write(6,*)'mod_stochastic_physics : skeb : decort ',skeb_decort(n)
             346     2   s    m              write(6,*)'mod_stochastic_physics : skeb : lscale ',skeb_lscale(n)
             347     2   s    s              write(6,*)'mod_stochastic_physics : skeb : seed   ',skeb_seed(n)
             348     2   p    v            endif
             349     1   p    v          enddo
             350                     
             351                         allocate(skeb3du(nxp,lev,my_max))
             352                         allocate(skeb3dv(nxp,lev,my_max))
             353                         allocate(diss_est(nxp,lev,my_max))
             354                         allocate(keb(nxp,lev,my_max))
             355                         allocate(kea(nxp,lev,my_max))
             356                     
             357                         ! for 3 time level scheme to keep skeblevs same and make sure can be
             358                         ! reproduced when restart ( restart function not ready yet ).
             359     1                   if ( first_call ) then
             360     1                     skeblevs=nint(rpattern_skeb(1)%decortau/(2.*dtau)*skeb_vdof)
             361     1                   else
             362     1                     skeblevs=nint(rpattern_skeb(1)%decortau/dtau*skeb_vdof)
             363     1                   endif
             364                     
             365                         call get_random_pattern_init(rpattern_skeb,nskeb,dtau,.true.)
             366                     
             367                         ! set up vfact_skeb
             368                         allocate(vfact_skeb(lev))
             369                         allocate(skeb_vloc(skeblevs))
             370                         allocate(skeb_vwts(lev,2))
             371                         allocate(skeb_vpts(lev,2))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_skeb
                                   <<< Loop-information  End >>>
             372     1  pp   2v          do k=1,lev
             373     2   p   2v            if (sl(k) .lt. skeb_sigtop1 .and. sl(k) .gt. skeb_sigtop2) then
             374     2   p   2v               vfact_skeb(k) = (sl(k)-skeb_sigtop2)/(skeb_sigtop1-skeb_sigtop2)
             375     2   p   2v            else if (sl(k) .lt. skeb_sigtop2) then
             376     2   p   2v                vfact_skeb(k) = 0.0
             377     2   p   2v            else
             378     2   p   2v                vfact_skeb(k) = 1.0
             379     2   p   2v            endif
             380     1   p   2v          enddo
             381                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vfact_skeb, sl
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             382     1   s    s          do k=1,lev
             383     1   p    v            if (myrank == 0) print 301,'mod_stochastic_physics : k,sl,vfact_skeb',k,sl(k),vfact_skeb(k)
             384     1   p    v          enddo
             385                         301 format ( A , I4 , 2F20.12 )
             386                         ! calculate vertical interpolation weights
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vloc
                                   <<< Loop-information  End >>>
             387     1  pp   2v          do k=1,skeblevs
             388     1   p   2v            skeb_vloc(k)=sl(lev)-real(skeblevs-k)/real(skeblevs-1.0)*(sl(lev)-sl(1))
             389     1   p   2v          enddo
             390                         ! surface
             391                         skeb_vwts(lev,2)=0.
             392                         skeb_vpts(lev,1)=skeblevs-2
             393                         ! top
             394                         skeb_vwts(1,2)=1.
             395                         skeb_vpts(1,1)=1
             396                         ! internal
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl
                                   <<< Loop-information  End >>>
             397     1  pp   2s          do k=2,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             398     2       2             do k2=1,skeblevs-1
             399     3   p   2m              if (sl(k) .LE. skeb_vloc(k2+1) .AND. sl(k) .GT. skeb_vloc(k2)) then
             400     3   p   2s                skeb_vpts(k,1)=k2
             401     3   p   2s                skeb_vwts(k,2)=(sl(k)-skeb_vloc(k2))/(skeb_vloc(k2+1)-skeb_vloc(k2))
             402     3   p   2v              endif
             403     2       2             enddo
             404     1       2v          enddo
             405                         deallocate(skeb_vloc)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vwts
                                   <<< Loop-information  End >>>
             406        pp   2v          skeb_vwts(:,1)=1.0-skeb_vwts(:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 352, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vpts
                                   <<< Loop-information  End >>>
             407        pp   2v          skeb_vpts(:,2)=skeb_vpts(:,1)+1
             408     1                   if (myrank .eq. 0) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb_vwts, skeb_vpts
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             409     2   s    s            do k=1,lev
             410     2   m    m              print*,'skeb vpts ',skeb_vpts(k,1),skeb_vwts(k,2)
             411     2   p    v            enddo
             412     1                   endif
             413                     
             414                       end subroutine init_skeb

            1356                       subroutine spptctl(tau)
            1357                     !
            1358                         use const, only : idtg,sinl,sigma
            1359                         use rank, only : myrank
            1360                     
            1361                         integer :: nxj,j,k,itau,ch,iter,remd,js,je,kk,lev1, mn, n
            1362                         real :: pi, r2d, dlon, tau
            1363                         real, allocatable :: mlat(:),prsl(:)
            1364                         character(len=30) ::  forydef,forzdef
            1365                     
            1366                         character yy*4,dd*2,hh*2,mm*2,dtg*12
            1367                         character*3 mon(12)
            1368                         logical jrem
            1369                     
            1370                         data mon/'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep' &
            1371                                  ,'Oct','Nov','Dec'/
            1372                     
            1373                         allocate(mlat(my),prsl(lev))
            1374                     
            1375                         itau=tau
            1376                         ch=10
            1377                         lev1=1
            1378                         pi=4.0*atan(1.0)
            1379                         r2d=180./pi
            1380                         dlon=360./float(nx)
            1381                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    MULTI-OPERATION FUNCTION
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, mlat
                                   <<< Loop-information  End >>>
            1382     1  pp   2v          do j=1,my
            1383     1   p   2v            mlat(j)=asin(sinl(j))*r2d
            1384     1   p   2v          enddo
            1385                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.14, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, prsl

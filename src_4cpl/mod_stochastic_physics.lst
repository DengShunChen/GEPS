             733                       subroutine get_noise(rpattern,noise)
             734                         implicit none
             735                         integer :: ml, ns, ms
             736                         type(random_pattern), intent(inout) :: rpattern
             737                         real(kind=RTYPE), intent(out) :: noise(rpattern%mlmax,2)
             738                         real :: noise_gauss(2*rpattern%mlmax)
             739                         real :: ave, var, std
             740                     
             741                         ! get white noise  with a gaussian (normal) distribution
             742                         call random_gauss(noise_gauss,rpattern%rstate)
             743                         noise_gauss(1) = 0.; noise_gauss(rpattern%mlmax+1) = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise_gauss
                                   <<< Loop-information  End >>>
             744        pp   2v          noise_gauss = noise_gauss*sqrt(1./float(rpattern%jtrun-1))
             745                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise
                                   <<< Loop-information  End >>>
             746        pp   4v          noise=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 229
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, noise_gauss, (unknown)
                                   <<< Loop-information  End >>>
             747     1  pp    v          do ml=1,rpattern%mlmax
             748     1                     ! set up to red noise
             749     1   p    v            noise(ml,1) = noise_gauss(ml)/sqrt(float(2*(rpattern%lsort(ml)-1)+1))
             750     1   p    v            noise(ml,2) = noise_gauss(rpattern%mlmax+ml)/sqrt(float(2*(rpattern%lsort(ml)-1)+1))
             751     1                     ! zero out the imagenary part when m(zonal wavenumber) equal to 1
             752     2   p    v            if (rpattern%msort(ml) .eq. 1) then
             753     2   p    v              noise(ml,1) = sqrt(2.)*noise(ml,1)
             754     2   p    v              noise(ml,2) = 0.
             755     2   p    v            endif
             756     1   p    v          enddo
             757                       end subroutine get_noise

             450                     
             451                       subroutine get_random_pattern_init(rpattern,nscale,dt,skebrun)
             452                     !---- documentation block
             453                     !  purpose: To generate 2D SPPT strucutre
             454                     !
             455                     !  SPPT 2D 500km example
             456                     !       parameter (ncx=128,mcy=ncx/2)
             457                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             458                     !  SPPT 2D 1000km example
             459                     !       parameter (ncx=64,mcy=ncx/2)
             460                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             461                     !  SPPT 2D 2000km example
             462                     !       parameter (ncx=32,mcy=ncx/2)
             463                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             464                     !---- end of documentation block
             465                     
             466                         implicit none
             467                         integer :: timearray(3),iseed
             468                         integer :: n, k, nscale, ncx, ml, ms, ns, i, j
             469                         real :: rerth, pi, var, radsq, correLsq, rkT, rnn1
             470                         type(random_pattern), intent(inout) :: rpattern(nscale)
             471                         integer :: irand
             472                         real :: dt
             473                         real(kind=RTYPE), allocatable :: noise(:,:)
             474                         integer(8) count, count_rate, count_max, count_trunc
             475                         integer(8) :: iscale = 10000000000
             476                         integer :: count4
             477                         logical :: skebrun
             478                     
             479                         rerth = 6.3712e+6      ! radius of earth (m)
             480                         pi = 4.*atan(1.)
             481                         radsq = rerth*rerth
             482                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             483     1                   do n=1,nscale
             484     1                     ncx = 2.*pi*rerth/rpattern(n)%lenscale
             485     1                  !  rpattern(n)%jtrun = 2*((1+(ncx-1)/3)/2)
             486     1                     rpattern(n)%jtrun = 2*((1+(4*ncx-1)/4)/2)
             487     1                     rpattern(n)%mlmax = rpattern(n)%jtrun*(rpattern(n)%jtrun+1)/2
             488     1               
             489     1                     allocate(rpattern(n)%n2d(nxp,my_max))
             490     2                     if ( doskeb ) then
             491     2                       allocate(rpattern(n)%n2du(nxp,my_max,skeblevs))
             492     2                       allocate(rpattern(n)%n2dv(nxp,my_max,skeblevs))
             493     2                       allocate(rpattern(n)%kenorm(rpattern(n)%mlmax,2))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             494     2  pp   4v              rpattern(n)%n2du(:,:,:)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             495     2  pp   4v              rpattern(n)%n2dv(:,:,:)=0.0
             496     2                     endif
             497     1                     allocate(rpattern(n)%spec(rpattern(n)%mlmax,2))
             498     1                     allocate(rpattern(n)%varspec(rpattern(n)%mlmax))
             499     1                     allocate(rpattern(n)%msort(rpattern(n)%mlmax))
             500     1                     allocate(rpattern(n)%lsort(rpattern(n)%mlmax))
             501     1                     allocate(rpattern(n)%mlsort(rpattern(n)%jtrun,rpattern(n)%jtrun))
             502     1                     allocate(noise(rpattern(n)%mlmax,2))
             503     1               
             504     1                     ! Real random seeds
             505     2                     if (myrank.eq.0) then
             506     3                       if(.not. ncep_seeds) then
             507     3                         call itime(timearray)
             508     3                         iseed=irand(0)
             509     3                         count4=irand(timearray(1)+(i*11467-iseed)*timearray(2) &
             510     3                             +(iseed-i*23)*timearray(3))
             511     3                       else
             512     3                         call system_clock(count, count_rate, count_max)
             513     3                         count_trunc = iscale*(count/iscale)
             514     3                         count4 = count - count_trunc
             515     3                       endif

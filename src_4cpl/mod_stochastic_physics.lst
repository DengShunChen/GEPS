            1347                     !
            1348                     !----
            1349                       subroutine spptctl(tau)
            1350                     !
            1351                         use const, only : idtg,sinl,sigma
            1352                         use rank, only : myrank
            1353                     
            1354                         integer :: nxj,j,k,itau,ch,iter,remd,js,je,kk,lev1, mn, n
            1355                         real :: pi, r2d, dlon, tau
            1356                         real, allocatable :: mlat(:),prsl(:)
            1357                         character(len=30) ::  forydef,forzdef
            1358                     
            1359                         character yy*4,dd*2,hh*2,mm*2,dtg*12
            1360                         character*3 mon(12)
            1361                         logical jrem
            1362                     
            1363                         data mon/'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep' &
            1364                                  ,'Oct','Nov','Dec'/
            1365                     
            1366                         allocate(mlat(my),prsl(lev))
            1367                     
            1368                         itau=tau
            1369                         ch=10
            1370                         lev1=1
            1371                         pi=4.0*atan(1.0)
            1372                         r2d=180./pi
            1373                         dlon=360./float(nx)
            1374                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    MULTI-OPERATION FUNCTION
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, mlat
                                   <<< Loop-information  End >>>
            1375     1  pp   2v          do j=1,my
            1376     1   p   2v            mlat(j)=asin(sinl(j))*r2d
            1377     1   p   2v          enddo
            1378                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.45, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, prsl
                                   <<< Loop-information  End >>>
            1379     1  pp   2v          do k=1,lev
            1380     1   p   2v            kk=lev-k+1
            1381     1   p   2v            prsl(kk)=sigma(k,2)+sigma(k+1,2)
            1382     1   p   2v            prsl(kk)=prsl(kk)+(sigma(k,1)+sigma(k+1,1))*1000.
            1383     1   p   2v            prsl(kk)=0.5*prsl(kk)/1000.
            1384     1   p   2v          enddo
            1385                     
            1386                           write(forydef,8) my
            1387                           write(forzdef,9) lev
            1388                     
            1389                           write(dtg,'(I12)') idtg
            1390                           read(dtg,'(A4,I2,A2,A2,A2)') yy,mn,dd,hh,mm
            1391                     
            1392     1                     if ( myrank .eq. 0 ) then
            1393     1                     OPEN(UNIT=ch, FILE='sppt.ctl', STATUS='UNKNOWN'             &
            1394     1                        , ACCESS='SEQUENTIAL')
            1395     1               
            1396     1                     write(ch,'(A23)') 'dset ^sppt.dat'
            1397     1                     write(ch,'(A18)') 'options big_endian'

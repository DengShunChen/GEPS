             666                       subroutine get_stochy_physics(rpattern,nscale,nlev,vfact,n3d)
             667                     !------------------------------------------------------------------------!
             668                     !  purpose: To generate 3D SPPT strucutre
             669                     !  output: n3d
             670                     !------------------------------------------------------------------------!
             671                         implicit none
             672                         integer :: n, ii, i, jj, j, k, nxj, nlev
             673                         integer, intent(in) :: nscale
             674                         real, intent(in) :: vfact(nlev)
             675                         type(random_pattern), intent(inout) :: rpattern(nscale)
             676                         real(kind=RTYPE), intent(  out) :: n3d(nxp,nlev,my_max)
             677                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d
                                   <<< Loop-information  End >>>
             678        pp   4v          n3d = 0.
             679     1                   do n=1,nscale
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             680     2  pp                 do jj=1,jlistnum
             681     2   p                   j=jlist1(jj)
             682     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             683     3   p                   do k=1,nlev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             684     4   p   2v                do i=1,nxj
             685     4   p   2v                  n3d(i,k,jj)=n3d(i,k,jj)+rpattern(n)%n2d(i,jj)*vfact(k)
             686     4   p   2v                enddo
             687     3   p                   enddo
             688     2   p                 enddo
             689     1                   enddo
             690                     
             691                       end subroutine get_stochy_physics
             692                     
             693                       subroutine get_stochy_physics_vect(rpattern,nscale,nlev,vfact,n3du,n3dv)
             694                     !------------------------------------------------------------------------!
             695                     !  purpose: To generate 3D SKEB strucutre
             696                     !  output: n3du n3dv
             697                     !------------------------------------------------------------------------!
             698                         implicit none
             699                         integer :: n, ii, i, jj, j, k, nxj, nlev
             700                         integer, intent(in) :: nscale
             701                         real, intent(in) :: vfact(nlev)
             702                         type(random_pattern), intent(inout) :: rpattern(nscale)
             703                         real(kind=RTYPE), intent(  out) :: n3du(nxp,nlev,my_max),n3dv(nxp,nlev,my_max)
             704                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3dv, n3du
                                   <<< Loop-information  End >>>
             705        pp   2v          n3du = 0.
             706         p   2v          n3dv = 0.
             707     1                   do n=1,nscale
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             708     2  pp                 do jj=1,jlistnum
             709     2   p                   j=jlist1(jj)
             710     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3dv, n3du, (unknown)
                                   <<< Loop-information  End >>>
             711     3   p                   do k=1,nlev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 120, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3dv, n3du, (unknown)
                                   <<< Loop-information  End >>>
             712     4   p    v                do i=1,nxj
             713     4   p    v                  n3du(i,k,jj)=n3du(i,k,jj)+vfact(k)                         &
             714     4                              *(skeb_vwts(k,1)*rpattern(n)%n2du(i,jj,skeb_vpts(k,1))  &
             715     4                              +skeb_vwts(k,2)*rpattern(n)%n2du(i,jj,skeb_vpts(k,2)))
             716     4   p    v                  n3dv(i,k,jj)=n3dv(i,k,jj)+vfact(k)                         &
             717     4                              *(skeb_vwts(k,1)*rpattern(n)%n2dv(i,jj,skeb_vpts(k,1))  &
             718     4                              +skeb_vwts(k,2)*rpattern(n)%n2dv(i,jj,skeb_vpts(k,2)))
             719     4   p    v                enddo
             720     3   p                   enddo
             721     2   p                 enddo
             722     1                   enddo
             723                     
             724                       end subroutine get_stochy_physics_vect

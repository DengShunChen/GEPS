             447                     
             448                       subroutine get_random_pattern_init(rpattern,nscale,dt,skebrun)
             449                     !---- documentation block
             450                     !  purpose: To generate 2D SPPT strucutre
             451                     !
             452                     !  SPPT 2D 500km example
             453                     !       parameter (ncx=128,mcy=ncx/2)
             454                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             455                     !  SPPT 2D 1000km example
             456                     !       parameter (ncx=64,mcy=ncx/2)
             457                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             458                     !  SPPT 2D 2000km example
             459                     !       parameter (ncx=32,mcy=ncx/2)
             460                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             461                     !---- end of documentation block
             462                     
             463                         implicit none
             464                         integer :: timearray(3),iseed
             465                         integer :: n, k, nscale, ncx, ml, ms, ns, i, j
             466                         real :: rerth, pi, var, radsq, correLsq, rkT, rnn1
             467                         type(random_pattern), intent(inout) :: rpattern(nscale)
             468                         integer :: irand
             469                         real :: dt
             470                         real(kind=RTYPE), allocatable :: noise(:,:)
             471                         integer(8) count, count_rate, count_max, count_trunc
             472                         integer(8) :: iscale = 10000000000
             473                         integer :: count4
             474                         logical :: skebrun
             475                     
             476                         rerth = 6.3712e+6      ! radius of earth (m)
             477                         pi = 4.*atan(1.)
             478                         radsq = rerth*rerth
             479                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             480     1                   do n=1,nscale
             481     1                     ncx = 2.*pi*rerth/rpattern(n)%lenscale
             482     1                  !  rpattern(n)%jtrun = 2*((1+(ncx-1)/3)/2)
             483     1                     rpattern(n)%jtrun = 2*((1+(4*ncx-1)/4)/2)
             484     1                     rpattern(n)%mlmax = rpattern(n)%jtrun*(rpattern(n)%jtrun+1)/2
             485     1               
             486     1                     allocate(rpattern(n)%n2d(nxp,my_max))
             487     2                     if ( doskeb ) then
             488     2                       allocate(rpattern(n)%n2du(nxp,my_max,skeblevs))
             489     2                       allocate(rpattern(n)%n2dv(nxp,my_max,skeblevs))
             490     2                       allocate(rpattern(n)%kenorm(rpattern(n)%mlmax,2))
             491     2                     endif
             492     1                     allocate(rpattern(n)%spec(rpattern(n)%mlmax,2))
             493     1                     allocate(rpattern(n)%varspec(rpattern(n)%mlmax))
             494     1                     allocate(rpattern(n)%msort(rpattern(n)%mlmax))
             495     1                     allocate(rpattern(n)%lsort(rpattern(n)%mlmax))
             496     1                     allocate(rpattern(n)%mlsort(rpattern(n)%jtrun,rpattern(n)%jtrun))
             497     1                     allocate(noise(rpattern(n)%mlmax,2))
             498     1               
             499     1                     ! Real random seeds
             500     2                     if (myrank.eq.0) then
             501     3                       if(.not. ncep_seeds) then
             502     3                         call itime(timearray)
             503     3                         iseed=irand(0)
             504     3                         count4=irand(timearray(1)+(i*11467-iseed)*timearray(2) &
             505     3                             +(iseed-i*23)*timearray(3))
             506     3                       else
             507     3                         call system_clock(count, count_rate, count_max)
             508     3                         count_trunc = iscale*(count/iscale)
             509     3                         count4 = count - count_trunc
             510     3                       endif
             511     2                     endif
             512     1                     call mpe_bcast(count4,1,0,mpe_double)
             513     2                     if (rpattern(n)%seed == -999 ) then
             514     2                       rpattern(n)%seed = count4
             515     2                     endif
             516     1                     if (myrank.eq.0) write(6,*)'scale',n,' : using seed :',rpattern(n)%seed
             517     1                     call random_setseed(rpattern(n)%seed,rpattern(n)%rstate)
             518     1               
             519     1                     ! horizontal decorrelation
             520     1                     correLsq = rpattern(n)%lenscale*rpattern(n)%lenscale
             521     1                     rkT = 0.25*correLsq/radsq
             522     1                     if (myrank.eq.0)  write(6,*)'mod_stochastic_physics : n,rkT = ',n,rkT
             523     1               
             524     1                     ! time decorrelation
             525     1                     rpattern(n)%phi = exp(-dt/rpattern(n)%decortau)
             526     1               
             527     1                     call sortml(rpattern(n)%jtrun,rpattern(n)%mlmax, &
             528     1                                 rpattern(n)%msort,rpattern(n)%lsort,rpattern(n)%mlsort)

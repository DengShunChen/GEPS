             759                       subroutine gen_random_pattern_2d(rpattern)
             760                     
             761                         use const, only : poly ,RTYPE
             762                         implicit none
             763                         type(random_pattern), intent(inout) :: rpattern
             764                         !real(kind=RTYPE), intent(out) :: sppt2d(nxp,my_max)
             765                         integer :: ml, ns, ms
             766                         real(kind=RTYPE), allocatable :: noise(:,:)
             767                         real(kind=RTYPE), allocatable :: specp(:,:,:),bufr2d(:,:,:)
             768                     
             769                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             770                         allocate(specp(jtrun,jtmax,2))
             771                     
             772     1                   if ( col_rank .eq. 0 ) then
             773     1                     ! get noise
             774     1                     allocate(noise(rpattern%mlmax,2))
             775     1                     call get_noise(rpattern,noise)
             776     1               
             777     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.54, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             778     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             779     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.70, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             780     1  pp   2v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             781     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             782     1               
             783     1                     ! ready for mpi_scatter random pattern
             784     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             785     1                                        ,rpattern%mlsort,nsizey             &
             786     1                                        ,rpattern%spec,bufr2d)
             787     1               
             788     1                     deallocate(noise)
             789     1                   endif
             790                     
             791                         !  mpi_scatter random pattern from root
             792                         call mpe_scatter_sppt(bufr2d,specp,2*jtrun*jtmax,nsizey)
             793                     
             794                         ! transform spectral to physical space
             795                         call transr1(jtrun,jtmax,nx,my,my_max,poly,specp,rpattern%n2d,nsizey)
             796                     
             797                         deallocate(bufr2d)
             798                         deallocate(specp)
             799                     
             800                       end subroutine gen_random_pattern_2d
             801                     
             802                       subroutine gen_random_pattern_2d_vect(rpattern,k)
             803                         use const, only : poly, dpoly, wdfac, wcfac, onocos,RTYPE
             804                         implicit none
             805                         type(random_pattern), intent(inout) :: rpattern
             806                         integer :: ml, ns, ms, k
             807                         real(kind=RTYPE), allocatable :: specpv(:,:,:),specpd(:,:,:)
             808                         real(kind=RTYPE), allocatable :: bufr2d(:,:,:) ,noise(:,:) ,specf(:,:)
             809                     
             810                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             811                         allocate(specpd(jtrun,jtmax,2)) !divergence
             812                         allocate(specpv(jtrun,jtmax,2)) !vorticity
             813                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specpd
                                   <<< Loop-information  End >>>
             814        pp   4v          specpd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specpv
                                   <<< Loop-information  End >>>
             815        pp   4v          specpv = 0.0
             816                     
             817     1                   if ( col_rank .eq. 0 ) then
             818     1                     ! get noise
             819     1                     allocate(noise(rpattern%mlmax,2))
             820     1                     allocate(specf(rpattern%mlmax,2))
             821     1                     call get_noise(rpattern,noise)
             822     1               
             823     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.54, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             824     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             825     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.54, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             826     1  pp   4v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             827     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             828     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.80, ITR: 136, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specf, (unknown)
                                   <<< Loop-information  End >>>
             829     1  pp    v            specf(:,1) = rpattern%kenorm(:,1) * rpattern%spec(:,1)
             830     1   p    v            specf(:,2) = rpattern%kenorm(:,2) * rpattern%spec(:,2)
             831     1               
             832     1                     ! ready for mpi_scatter random pattern
             833     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             834     1                                        ,rpattern%mlsort,nsizey             &
             835     1                                        ,specf,bufr2d)
             836     1               
             837     1                     deallocate(noise)
             838     1                     deallocate(specf)
             839     1                   endif
             840                     
             841                         !  mpi_scatter random pattern from root
             842                         call mpe_scatter_sppt(bufr2d,specpv,2*jtrun*jtmax,nsizey)
             843                     
             844                         !  spectral transform for velocity components
             845                         call tranuv1 (jtrun,jtmax,nx,my,my_max,1,onocos,wcfac,wdfac &
             846                                     , poly,dpoly,specpv,specpd,rpattern%n2du(1,1,k),rpattern%n2dv(1,1,k),nsizey)
             847                     
             848                         deallocate(bufr2d)
             849                         deallocate(specpd)
             850                         deallocate(specpv)
             851                     
             852                       end subroutine gen_random_pattern_2d_vect
             853                     
             854                       subroutine get_legendre_poly(mlmax,jtrun,poly)
             855                         implicit none
             856                         integer, intent(in) :: mlmax,jtrun
             857                         real(kind=RTYPE),intent(out)   ::  poly(mlmax,my/2)
             858                     
             859                         !   Spheric Harmonic Constants
             860                         integer ::  msort(mlmax),lsort(mlmax),mlsort(mlmax,jtrun)
             861                         real(kind=RTYPE) :: dpoly(mlmax,my/2),eps4(mlmax),cim(mlmax)
             862                         real(kind=RTYPE) :: cosl(my),onocos(my)
             863                         real(kind=RTYPE) :: weight(my),sinl(my)
             864                         real :: cp,capa,rgas,pi,radsq,rad,one,onem,irad
             865                         integer :: rl,rm,rlm,ml
             866                         integer :: j,my2
             867                     
             868                         !   prepare spheric harmonic coefficients
             869                         cp=1004.24
             870                         capa= 1.0/3.5
             871                         rgas= capa*cp
             872                         pi  = 4.0*atan(1.0)
             873                         rad = 6.371e6
             874                         radsq= rad*rad
             875                     !
             876                     !   build pointer arrays for locating zonal and total wavenumber
             877                     !   values in the one-dimensional spherical harmonic arrays.
             878                         call sortml (jtrun,mlmax,msort,lsort,mlsort)
             879                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 120, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lsort, cim, msort, eps4
                                   <<< Loop-information  End >>>
             880     1  pp    v          do ml = 1, mlmax
             881     1   p    v            rl = lsort(ml)
             882     1   p    v            rm = msort(ml)-1
             883     1   p    v            rlm= rl-1.0
             884     1   p    v            if (msort(ml).eq.1)  rm= 0.0
             885     1   p    v            if (lsort(ml).eq.1)  rlm= 0.0
             886     1   p    v            eps4(ml)= rl*rlm/radsq
             887     1   p    v            cim(ml)= rm
             888     1   p    v          enddo
             889                     
             890                     !   gaussian quadrature weights and latitudes
             891                         one = 1.0
             892                         onem= -one
             893                         call gausl3 (my,onem,one,weight,sinl)
             894                     !
             895                         my2= my/2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.50, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, onocos, weight, cosl
                                   <<< Loop-information  End >>>
             896     1   s    s          do j = 1, my2
             897     1   s    s            sinl(my+1-j)  = -sinl(j)
             898     1   s    s            weight(my+1-j)= weight(j)
             899     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             900     1   s    s            onocos(my+1-j)= onocos(j)
             901     1   m    m            cosl(j)       = 1.0/sqrt(onocos(j))
             902     1   s    s            cosl(my+1-j)  = cosl(j)
             903     1   p    v          enddo
             904                     !
             905                     !   define associated legendre polynomials and their derivatives
             906                         call lgndr_sppt(my2,jtrun,mlmax,mlsort,sinl,poly,dpoly)
             907                     
             908                       end subroutine get_legendre_poly
             909                     
             910                       SUBROUTINE avevar_sppt(data,n,ave,var,std)
             911                           INTEGER n
             912                           REAL ave,var,data(n)
             913                           INTEGER j
             914                           REAL s,ep,std
             915                           ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             916     1  pp    v            do j=1,n
             917     1   p    v              ave=ave+data(j)
             918     1   p    v            enddo
             919                           ave=ave/n
             920                           var=0.0
             921                           ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             922     1  pp    v            do j=1,n
             923     1   p    v              s=data(j)-ave
             924     1   p    v              ep=ep+s
             925     1   p    v              var=var+s*s
             926     1   p    v            enddo
             927                           var=(var-ep**2/n)/n
             928                           std=sqrt(var)
             929                     
             930                       end SUBROUTINE avevar_sppt
             931                     !
             932                     !
             933                       SUBROUTINE avevar_sppt2d(data2d,n,m,ave,var,std)
             934                         INTEGER :: n,m,nmdim
             935                         REAL :: ave,var,data(n*m)
             936                         REAL(kind=RTYPE) :: data2d(n,m)
             937                         INTEGER :: i,j
             938                         REAL :: s,ep,std
             939                     
             940                         nmdim=0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             941     1                   do j=1,m
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             942     2  pp   2v            do i=1,n
             943     2   p   2v            nmdim=nmdim+1
             944     2   p   2v            data(nmdim)=data2d(i,j)
             945     2   p   2v            enddo
             946     1                   enddo
             947                     
             948                         ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             949     1  pp    v          do j=1,nmdim
             950     1   p    v            ave=ave+data(j)
             951     1   p    v          enddo
             952                         ave=ave/nmdim
             953                         var=0.0
             954                         ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             955     1  pp    v          do j=1,nmdim
             956     1   p    v            s=data(j)-ave
             957     1   p    v            ep=ep+s
             958     1   p    v            var=var+s*s
             959     1   p    v          enddo
             960                     !   var=(var-ep**2/n)/(n-1)    ! sample numners < 30
             961                         var=(var-ep**2/nmdim)/nmdim
             962                         std=sqrt(var)
             963                       end SUBROUTINE avevar_sppt2d
             964                     
             965                       subroutine removegt2std(scaleval,nx,my,aves,stds)
             966                         integer i,j,nx,my
             967                         real scaleval(nx,my),aves,stds
             968                         real vcheck2p,vcheck2n
             969                     
             970                         vcheck2p=2.0*stds
             971                         vcheck2n=-2.0*stds
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      scaleval
                                   <<< Loop-information  End >>>
             972     1  pp   2v          do j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             973     2   p   2           do i=1,nx
             974     2   p   2v            if ((scaleval(i,j)-aves).gt.vcheck2p) scaleval(i,j)=vcheck2p
             975     2   p   2v            if ((scaleval(i,j)-aves).lt.vcheck2n) scaleval(i,j)=vcheck2n
             976     2   p   2v          enddo
             977     1   p               enddo
             978                       end subroutine removegt2std
             979                     
             980                       subroutine removegt3std(scaleval,nx,my,aves,stds)
             981                         integer i,j,nx,my

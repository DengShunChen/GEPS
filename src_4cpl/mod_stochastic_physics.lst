            1234     3   p   2v              enddo
            1235     2   p                 enddo
            1236     1                     call unify_reduceintp(nx,my,my_max,temp,glob)
            1237     2                     if ( myrank.eq.0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
            1238     2  pp   4v              glob4=glob
            1239     2                       write(ihead,rec=recnsppt) glob4
            1240     2                       recnsppt=recnsppt+1
            1241     2                     endif
            1242     1                   enddo
            1243                     
            1244                         if ( myrank.eq.0 ) close(ihead)
            1245                     
            1246                         !creating ctl file
            1247                         call spptctl(tau)
            1248                     

            1554                       subroutine spectrun_inp2d(jcap1,jtr,jtm,mlsort,ns,speci,speco)
            1555                     !
            1556                     ! use spectral truncation to change resoltuion
            1557                     !
            1558                           implicit none
            1559                           integer lev,jtr,jcap1,jtm,ns,ml
            1560                           real(kind=RTYPE) speci(jcap1*(jcap1+1)/2,2)
            1561                           real(kind=RTYPE) speco(jtr,jtm*ns*2)
            1562                           integer i,j,k,jj,jp,jr,j1,j2
            1563                           integer mlsort(jcap1,jcap1)
            1564                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1565        pp   4v            speco(:,:) = 0.0
            1566     1                     if( jcap1.gt.jtr ) then
            1567     2                         do j=1,jcap1
            1568     3                           if( j.le.jtr ) then
            1569     3                             jj=nlist(j)
            1570     3                             jp=(jj-1)/jtm
            1571     3                             jr=mod(jj-1,jtm)+1
            1572     3                             j1=jp*jtm*2+jr
            1573     3                             j2=j1+jtm
            1574     3                           endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1575     3  pp   2s                  do i=j,jcap1
            1576     3   p   2v                    ml=mlsort(j,i)
            1577     4   p   2s                    if( i.le.jtr ) then
            1578     4   p   2s                      speco(i,j1) = speci(ml,1)
            1579     4   p   2s                      speco(i,j2) = speci(ml,2)
            1580     4   p   2v                    endif
            1581     3   p   2v                  enddo
            1582     2                         enddo
            1583     1                     else if( jcap1.lt.jtr ) then
            1584     2                         do j=1,jtr
            1585     2                           jj=nlist(j)
            1586     2                           jp=(jj-1)/jtm
            1587     2                           jr=mod(jj-1,jtm)+1
            1588     2                           j1=jp*jtm*2+jr
            1589     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1590     3  pp   2s                  do i=j,jtr
            1591     4   p   2m                    if( i.le.jcap1 ) then
            1592     4   p   2s                      ml=mlsort(j,i)
            1593     4   p   2s                      speco(i,j1) = speci(ml,1)
            1594     4   p   2s                      speco(i,j2) = speci(ml,2)
            1595     4   p   2v                    endif
            1596     3   p   2v                  enddo
            1597     2                         enddo
            1598     1                     else      ! jcap1=jtr
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1599     2                         do j=1,jtr
            1600     2                           jj=nlist(j)
            1601     2                           jp=(jj-1)/jtm
            1602     2                           jr=mod(jj-1,jtm)+1
            1603     2                           j1=jp*jtm*2+jr
            1604     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 256, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1605     3  pp   2v                  do i=j,jtr
            1606     3   p   2v                    ml=mlsort(j,i)
            1607     3   p   2v                    speco(i,j1) = speci(ml,1)
            1608     3   p   2v                    speco(i,j2) = speci(ml,2)
            1609     3   p   2v                  enddo
            1610     2                         enddo
            1611     1                     endif
            1612                     
            1613                           return
            1614                       end subroutine spectrun_inp2d

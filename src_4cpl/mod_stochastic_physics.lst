             995                     
             996                       subroutine lgndr_sppt(my2,jtrun,mlmax,mlsort,sinl,poly,dpoly)
             997                     !
             998                     !   generate legendre polynomials and their derivatives on the
             999                     !   gaussian latitudes
            1000                     !
            1001                     !  ***input***
            1002                     !
            1003                     !   my2:  number of gaussian latitudes from south pole and equator
            1004                     !   jtrun:  zonal wavenumber truncation limit
            1005                     !   mlmax: total number of triangular truncation spherical harmonics
            1006                     !   mlsort: pointer array of 1-d indexs at functions of zonal and
            1007                     !           total wavenumbers
            1008                     !   sinl: sin of gaussian latitudes
            1009                     !
            1010                     !   ***output***
            1011                     !
            1012                     !   poly: associated legendre coefficients
            1013                     !   dpoly: d(poly)/d(sinl)
            1014                     !
            1015                     !  ******************************************************************
            1016                     !
            1017                     !  ref= belousov, s. l., 1962= tables of normalized associated
            1018                     !         legendre polynomials. pergamon press, new york
            1019                     !
            1020                           integer :: j, n, np, kp, k, mp, m, nps, l, ml, m1, mk
            1021                           integer :: my2, jtrun, mlmax, jtrunp
            1022                           real(kind=RTYPE) :: poly(mlmax,my2),dpoly(mlmax,my2),sinl(my2)
            1023                           integer :: mlsort(jtrun,jtrun)
            1024                     !
            1025                     !       parameter (jtrunx= 100)
            1026                           real :: pnm(jtrun+1,jtrun+1),dpnm(jtrun+1,jtrun+1)
            1027                           real :: xx, sn, sn2i, rt2, c1, fn, fn2, fn2s, c3, s1, s2, c4, c5, c6, cf
            1028                           real :: a, b, fk, fm, fm1, fm2, fm3, c7, c8, c, d, e, fms, fnp, fnp2
            1029                           real :: theta, ang
            1030                     !
            1031                     !  sinl is sin(latitude) = cos(colatitude)
            1032                     !  pnm(np,mp) is legendre polynomial p(n,m) with np=n+1, mp=m+1
            1033                     !  pnm(mp,np+1) is x derivative of p(n,m) with np=n+1, mp=m+1
            1034                     !
            1035                           jtrunp= jtrun+1
            1036     1                     do 1001 j=1,my2
            1037     1                     xx= sinl(j)
            1038     1                     sn= sqrt(1.0-xx*xx)
            1039     1                 sn2i = 1.0/(1.0 - xx*xx)
            1040     1                     rt2= sqrt(2.0)
            1041     1                 c1 = rt2
            1042     1               !
            1043     1                 pnm(1,1) = 1.0/rt2
            1044     1                     theta=-atan(xx/sqrt(1.0-xx*xx))+2.0*atan(1.0)
            1045     1               !
            1046     2                     do 20 n=1,jtrun
            1047     2                 np = n + 1
            1048     2                     fn=n
            1049     2                 fn2 = fn + fn
            1050     2                 fn2s = fn2*fn2
            1051     2               !  eq 22
            1052     2                     c1= c1*sqrt(1.0-1.0/fn2s)
            1053     2                     c3= c1/sqrt(fn*(fn+1.0))
            1054     2                 ang = fn*theta
            1055     2                 s1 = 0.0
            1056     2                 s2 = 0.0
            1057     2                 c4 = 1.0
            1058     2                 c5 = fn
            1059     2                 a = -1.0
            1060     2                 b = 0.0
            1061     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1062     3   s    s            do 27 kp=1,np,2
            1063     3   p    v        k = kp - 1
            1064     3   m    m            s2= s2+c5*sin(ang)*c4
            1065     3   p    v            if (k.eq.n) c4 = 0.5*c4
            1066     3   m    m            s1= s1+c4*cos(ang)
            1067     3   s    s        a = a + 2.0
            1068     3   s    s        b = b + 1.0
            1069     3   p    v            fk=k
            1070     3   m    m        ang = theta*(fn - fk - 2.0)
            1071     3   s    s        c4 = (a*(fn - b + 1.0)/(b*(fn2 - a)))*c4
            1072     3   s    s        c5 = c5 - 2.0
            1073     3   p    v         27 continue
            1074     2               !  eq 19
            1075     2                 pnm(np,1) = s1*c1
            1076     2               !  eq 21
            1077     2                 pnm(np,2) = s2*c3
            1078     2                  20 continue
            1079     1               !
            1080     2                     do 4 mp=3,jtrunp
            1081     2                 m = mp - 1
            1082     2                     fm= m
            1083     2                 fm1 = fm - 1.0
            1084     2                 fm2 = fm - 2.0
            1085     2                 fm3 = fm - 3.0
            1086     2                     c6= sqrt(1.0+1.0/(fm+fm))
            1087     2               !  eq 23
            1088     2                 pnm(mp,mp) = c6*sn*pnm(m,m)
            1089     2                     if (mp - jtrunp) 3,4,4
            1090     2                   3 continue
            1091     2                 nps = mp + 1
            1092     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
            1093     3   s    s            do 41 np=nps,jtrunp
            1094     3   p    v        n = np - 1
            1095     3   p    v            fn= n
            1096     3   p    v        fn2 = fn + fn
            1097     3   p    v        c7 = (fn2 + 1.0)/(fn2 - 1.0)
            1098     3   p    v        c8 = (fm1 + fn)/((fm + fn)*(fm2 + fn))
            1099     3   p    v            c= sqrt((fn2+1.0)*c8*(fm3+fn)/(fn2-3.0))
            1100     3   p    v            d= -sqrt(c7*c8*(fn-fm1))
            1101     3   p    v            e= sqrt(c7*(fn-fm)/(fn+fm))
            1102     3               !  eq 17
            1103     3   m    m        pnm(np,mp) = c*pnm(np-2,mp-2) &
            1104     3                                + xx*(d*pnm(np-1,mp-2) + e*pnm(np - 1,mp))
            1105     3   p    v         41 continue
            1106     2                   4 continue
            1107     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
            1108     2  pp                 do 50 mp=1,jtrun
            1109     2   p                 fm= mp-1.0
            1110     2   p             fms = fm*fm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
            1111     3   p    v            do 50 np=mp,jtrun
            1112     3   p    v            fnp= np
            1113     3   p    v        fnp2 = fnp + fnp
            1114     3   p    v        cf = (fnp*fnp - fms)*(fnp2 - 1.0)/(fnp2 + 1.0)
            1115     3   p    v            cf= sqrt(cf)
            1116     3               !  der
            1117     3   p    v            dpnm(np,mp)   = -sn2i*(cf*pnm(np+1,mp) - fnp*xx*pnm(np,mp))
            1118     2   p    v         50 continue
            1119     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpnm, pnm
                                   <<< Loop-information  End >>>
            1120     2                     do 71 m=1,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.40, ITR: 96, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
            1121     3   s    v            do 71 l=m,jtrun
            1122     3   p    v            ml= mlsort(m,l)
            1123     3   m    v            poly(ml,j)= pnm(l,m)
            1124     3   m    v            dpoly(ml,j)=dpnm(l,m)
            1125     2   p    v         71 continue
            1126     1                     dpoly(1,j)= 0.0
            1127     1                1001 continue
            1128                     
            1129                       end subroutine lgndr_sppt
            1130                     
            1131                       subroutine transr_sppt (jtrun,mlmax,nx,my,ll,poly,s,r)
            1132                     !   subroutine to transform a spectral coefficient field to
            1133                     !   grid point form
            1134                     !
            1135                     !  *** const ***
            1136                     !
            1137                     !   jtrun: zonal wavenumber resolution limit
            1138                     !   mlmax: number of spectral coefficients (horizontal field)
            1139                     !   nx: e-w dimension no.
            1140                     !   my: n-s dimension no.
            1141                     !   ll: number of levels to transform
            1142                     !   poly: legendre polynomials
            1143                     !
            1144                     !  *** input variable ***
            1145                     !
            1146                     !   s: spectral coefficient array to transform
            1147                     !
            1148                     !  *** output variable ***
            1149                     !
            1150                     !   r: 3-d output grid point fields
            1151                     !
            1152                     !   **************************************
            1153                     
            1154                           use fftcom
            1155                           real :: poly(mlmax,my/2),s(mlmax,2,ll),r(nx,ll,my)
            1156                           real :: cc(nx+2,my),work(nx*my,2)
            1157                           integer :: mlmax,my,nx,ll,jtrun
            1158                           integer :: mlx,i,k,m,j,jj,ml,mm,mp
            1159                           integer :: m1, l, mk, n
            1160                     
            1161                           mlx= (jtrun/2)*((jtrun+1)/2)
            1162     1                     do k=1,ll
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc
                                   <<< Loop-information  End >>>
            1163     2  pp   2v              do m=1,(nx+2)*my/2
            1164     2   p   2v                cc(m,1)= 0.0
            1165     2   p   2v                cc(m,my/2+1)= 0.0
            1166     2   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      s, poly, cc
                                   <<< Loop-information  End >>>
            1167     2                       do j=1,my/2
            1168     2                         jj = my+1-j
            1169     2                         ml = 2*mlx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, s, poly
                                   <<< Loop-information  End >>>
            1170     3  pp    v                do m=2,jtrun,2
            1171     3   p    v                  ml = ml+1
            1172     3   p    v                  mm = 2*m-1
            1173     3   p    v                  mp = mm+1
            1174     3   p    v                  cc(mm,j ) = poly(ml,j)*s(ml,1,k)
            1175     3   p    v                  cc(mp,j ) = poly(ml,j)*s(ml,2,k)
            1176     3   p    v                  cc(mm,jj) = cc(mm,j)
            1177     3   p    v                  cc(mp,jj) = cc(mp,j)
            1178     3   p    v                enddo
            1179     2               
            1180     2                         m1= 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      s, poly, cc
                                   <<< Loop-information  End >>>
            1181     3                         do l=jtrun-1,1,-2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 206
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.28, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      poly, s, cc
                                   <<< Loop-information  End >>>
            1182     4  pp    v                  do m=1,l
            1183     4   p    v                    mm = 2*m-1
            1184     4   p    v                    mp = mm+1
            1185     4   p    v                    ml = m+m1
            1186     4   p    v                    mk = ml+mlx
            1187     4   p    v                    cc(mm,j ) = cc(mm,j ) + poly(ml,j)*s(ml,1,k) + poly(mk,j)*s(mk,1,k)
            1188     4   p    v                    cc(mm,jj) = cc(mm,jj) + poly(ml,j)*s(ml,1,k) - poly(mk,j)*s(mk,1,k)
            1189     4   p    v                    cc(mp,j ) = cc(mp,j ) + poly(ml,j)*s(ml,2,k) + poly(mk,j)*s(mk,2,k)
            1190     4   p    v                    cc(mp,jj) = cc(mp,jj) + poly(ml,j)*s(ml,2,k) - poly(mk,j)*s(mk,2,k)
            1191     4   p    v                  enddo
            1192     3                           m1= m1+l
            1193     3                         enddo
            1194     2                       enddo
            1195     1               !       call fft991(cc,work,trigs,ifax,1,nx+3,nx,my,1)
            1196     1                       call rfftmlt(cc,work,trigs,ifax,1,nx+2,nx,my,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, r
                                   <<< Loop-information  End >>>
            1197     2  pp                   do j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, r
                                   <<< Loop-information  End >>>
            1198     3   p   2v                do i=1,nx
            1199     3   p   2v                  r(i,k,j)= cc(i,j)
            1200     3   p   2v                enddo
            1201     2   p                   enddo
            1202     1                     enddo
            1203                     
            1204                       end subroutine transr_sppt
            1205                     
            1206                       subroutine spptout(tau)
            1207                         implicit none
            1208                         integer      :: i, j, k, jj, nxj, ihead, n
            1209                         integer      :: nxmy4

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3du, n3dv, (unknown)
                                   <<< Loop-information  End >>>
             719     4   p    v                do i=1,nxj
             720     4   p    v                  n3du(i,k,jj)=n3du(i,k,jj)+vfact(k)                         &
             721     4                              *(skeb_vwts(k,1)*rpattern(n)%n2du(i,jj,skeb_vpts(k,1))  &
             722     4                              +skeb_vwts(k,2)*rpattern(n)%n2du(i,jj,skeb_vpts(k,2)))
             723     4   p    v                  n3dv(i,k,jj)=n3dv(i,k,jj)+vfact(k)                         &
             724     4                              *(skeb_vwts(k,1)*rpattern(n)%n2dv(i,jj,skeb_vpts(k,1))  &
             725     4                              +skeb_vwts(k,2)*rpattern(n)%n2dv(i,jj,skeb_vpts(k,2)))
             726     4   p    v                enddo

             274                       subroutine init_shum(dtau)
             275                         implicit none
             276                         real :: dtau
             277                         integer :: n, k
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             278     1       f             do n=1,size(shum)
             279     2       f               if (shum(n) > 0) then
             280     2       f                 nshum=nshum + 1
             281     2       f               else
             282     2       f                 exit
             283     2       f               endif
             284     1       f             enddo
             285                     
             286         s   2s            allocate(rpattern_shum(nshum))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      shum, shum_decort, shum_lscale
                                   <<<      shum_seed
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 5  FILL 14
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             287     1   m    s            do n=1,nshum
             288     1   p    v              rpattern_shum(n)%stdev = shum(n)
             289     1   p    v              rpattern_shum(n)%decortau = shum_decort(n)
             290     1   p    v              rpattern_shum(n)%lenscale = shum_lscale(n)
             291     1   p    v              rpattern_shum(n)%seed = int(shum_seed(n))
             292     2   s    s              if (myrank .eq. 0 ) then
             293     2   s    m                write(6,*)'mod_stochastic_physics : shum : stdev  ',shum(n)
             294     2   s    m                write(6,*)'mod_stochastic_physics : shum : decort ',shum_decort(n)
             295     2   s    m                write(6,*)'mod_stochastic_physics : shum : lscale ',shum_lscale(n)
             296     2   s    s                write(6,*)'mod_stochastic_physics : shum : seed   ',shum_seed(n)
             297     2   p    v              endif
             298     1   p    v            enddo
             299                     
             300                           allocate(shum3d(nxp,lev,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      shum3d
                                   <<< Loop-information  End >>>
             301        pp   4v            shum3d = 0.
             302                           call get_random_pattern_init(rpattern_shum,nshum,dtau,.false.)
             303                     
             304                           allocate(vfact_shum(lev))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.81, ITR: 48, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_shum, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             305     1   m    s            do k=1,lev
             306     1   p    v               vfact_shum(k) = exp((sl(k)-1.)/shum_sigefold)
             307     2   p    v               if (sl(k).LT. 2*shum_sigefold) then
             308     2   p    v                  vfact_shum(k)=0.0
             309     2   p    v               endif
             310     1   p    v              if (myrank == 0) print 301,'mod_stochastic_physics : k,sl,vfact_shum',k,sl(k),vfact_shum(k)
             311     1   p    v            enddo
             312                         301 format ( A , I4 , 2F20.12 )
             313                       end subroutine init_shum

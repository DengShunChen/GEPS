             247     2   p   2v               vfact_sppt(k) = (sl(k)-sppt_sigtop2)/(sppt_sigtop1-sppt_sigtop2)
             248     2   p   2v            else if (sl(k) .lt. sppt_sigtop2) then
             249     2   p   2v                vfact_sppt(k) = 0.0
             250     2   p   2v            else
             251     2   p   2v                vfact_sppt(k) = 1.0
             252     2   p   2v            endif
             253     1   p   2v          enddo
             254                     
             255     1                   if (sppt_sfclimit) then
             256     1                   ! vfact_sppt(lev-1)=vfact_sppt(lev-2)*0.5
             257     1                   ! vfact_sppt(lev)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_sppt
                                   <<< Loop-information  End >>>
             258     2  pp   2v            do k=1,lev
             259     3   p   2v              if (sl(k) .lt. sppt_sigbot1 .and. sl(k) .gt. sppt_sigbot2) then
             260     3   p   2v                 vfact_sppt(k) = 1. - (sl(k)-sppt_sigbot2)/(sppt_sigbot1-sppt_sigbot2)
             261     3   p   2v              else if (sl(k) .gt. sppt_sigbot1) then
             262     3   p   2v                  vfact_sppt(k) = 0.0
             263     3   p   2v              endif
             264     2   p   2v            enddo
             265     1                   endif
             266                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_sppt
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             267     1   s    s          do k=1,lev
             268     1   m    m            if (myrank == 0) print *,'mod_stochastic_physics : k,sl,vfact_sppt',k,sl(k),vfact_sppt(k)
             269     1   p    v          enddo
             270                     
             271                       end subroutine init_sppt

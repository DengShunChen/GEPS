                                   <<< Loop-information  End >>>
             982     2   p   2           do i=1,nx
             983     2   p   2v            if ((scaleval(i,j)-aves).gt.vcheck3p) scaleval(i,j)=vcheck3p
             984     2   p   2v            if ((scaleval(i,j)-aves).lt.vcheck3n) scaleval(i,j)=vcheck3n
             985     2   p   2v          enddo
             986     1   p               enddo
             987                       end subroutine removegt3std
             988                     
             989                       subroutine lgndr_sppt(my2,jtrun,mlmax,mlsort,sinl,poly,dpoly)
             990                     !
             991                     !   generate legendre polynomials and their derivatives on the
             992                     !   gaussian latitudes
             993                     !
             994                     !  ***input***
             995                     !
             996                     !   my2:  number of gaussian latitudes from south pole and equator
             997                     !   jtrun:  zonal wavenumber truncation limit
             998                     !   mlmax: total number of triangular truncation spherical harmonics
             999                     !   mlsort: pointer array of 1-d indexs at functions of zonal and
            1000                     !           total wavenumbers
            1001                     !   sinl: sin of gaussian latitudes
            1002                     !
            1003                     !   ***output***
            1004                     !
            1005                     !   poly: associated legendre coefficients
            1006                     !   dpoly: d(poly)/d(sinl)
            1007                     !
            1008                     !  ******************************************************************
            1009                     !
            1010                     !  ref= belousov, s. l., 1962= tables of normalized associated
            1011                     !         legendre polynomials. pergamon press, new york
            1012                     !
            1013                           integer :: j, n, np, kp, k, mp, m, nps, l, ml, m1, mk
            1014                           integer :: my2, jtrun, mlmax, jtrunp
            1015                           real(kind=RTYPE) :: poly(mlmax,my2),dpoly(mlmax,my2),sinl(my2)
            1016                           integer :: mlsort(jtrun,jtrun)
            1017                     !
            1018                     !       parameter (jtrunx= 100)
            1019                           real :: pnm(jtrun+1,jtrun+1),dpnm(jtrun+1,jtrun+1)
            1020                           real :: xx, sn, sn2i, rt2, c1, fn, fn2, fn2s, c3, s1, s2, c4, c5, c6, cf
            1021                           real :: a, b, fk, fm, fm1, fm2, fm3, c7, c8, c, d, e, fms, fnp, fnp2
            1022                           real :: theta, ang
            1023                     !
            1024                     !  sinl is sin(latitude) = cos(colatitude)
            1025                     !  pnm(np,mp) is legendre polynomial p(n,m) with np=n+1, mp=m+1
            1026                     !  pnm(mp,np+1) is x derivative of p(n,m) with np=n+1, mp=m+1
            1027                     !
            1028                           jtrunp= jtrun+1
            1029     1                     do 1001 j=1,my2
            1030     1                     xx= sinl(j)
            1031     1                     sn= sqrt(1.0-xx*xx)
            1032     1                 sn2i = 1.0/(1.0 - xx*xx)
            1033     1                     rt2= sqrt(2.0)
            1034     1                 c1 = rt2
            1035     1               !
            1036     1                 pnm(1,1) = 1.0/rt2
            1037     1                     theta=-atan(xx/sqrt(1.0-xx*xx))+2.0*atan(1.0)
            1038     1               !
            1039     2                     do 20 n=1,jtrun
            1040     2                 np = n + 1
            1041     2                     fn=n
            1042     2                 fn2 = fn + fn
            1043     2                 fn2s = fn2*fn2
            1044     2               !  eq 22
            1045     2                     c1= c1*sqrt(1.0-1.0/fn2s)
            1046     2                     c3= c1/sqrt(fn*(fn+1.0))
            1047     2                 ang = fn*theta
            1048     2                 s1 = 0.0
            1049     2                 s2 = 0.0
            1050     2                 c4 = 1.0
            1051     2                 c5 = fn
            1052     2                 a = -1.0
            1053     2                 b = 0.0
            1054     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1055     3   s    s            do 27 kp=1,np,2
            1056     3   p    v        k = kp - 1
            1057     3   m    m            s2= s2+c5*sin(ang)*c4
            1058     3   p    v            if (k.eq.n) c4 = 0.5*c4
            1059     3   m    m            s1= s1+c4*cos(ang)
            1060     3   s    s        a = a + 2.0
            1061     3   s    s        b = b + 1.0
            1062     3   p    v            fk=k
            1063     3   m    m        ang = theta*(fn - fk - 2.0)
            1064     3   s    s        c4 = (a*(fn - b + 1.0)/(b*(fn2 - a)))*c4
            1065     3   s    s        c5 = c5 - 2.0
            1066     3   p    v         27 continue
            1067     2               !  eq 19
            1068     2                 pnm(np,1) = s1*c1
            1069     2               !  eq 21
            1070     2                 pnm(np,2) = s2*c3
            1071     2                  20 continue
            1072     1               !
            1073     2                     do 4 mp=3,jtrunp
            1074     2                 m = mp - 1
            1075     2                     fm= m
            1076     2                 fm1 = fm - 1.0
            1077     2                 fm2 = fm - 2.0
            1078     2                 fm3 = fm - 3.0
            1079     2                     c6= sqrt(1.0+1.0/(fm+fm))
            1080     2               !  eq 23
            1081     2                 pnm(mp,mp) = c6*sn*pnm(m,m)
            1082     2                     if (mp - jtrunp) 3,4,4
            1083     2                   3 continue
            1084     2                 nps = mp + 1
            1085     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
            1086     3   s    s            do 41 np=nps,jtrunp
            1087     3   p    v        n = np - 1
            1088     3   p    v            fn= n
            1089     3   p    v        fn2 = fn + fn
            1090     3   p    v        c7 = (fn2 + 1.0)/(fn2 - 1.0)
            1091     3   p    v        c8 = (fm1 + fn)/((fm + fn)*(fm2 + fn))
            1092     3   p    v            c= sqrt((fn2+1.0)*c8*(fm3+fn)/(fn2-3.0))
            1093     3   p    v            d= -sqrt(c7*c8*(fn-fm1))
            1094     3   p    v            e= sqrt(c7*(fn-fm)/(fn+fm))
            1095     3               !  eq 17
            1096     3   m    m        pnm(np,mp) = c*pnm(np-2,mp-2) &
            1097     3                                + xx*(d*pnm(np-1,mp-2) + e*pnm(np - 1,mp))
            1098     3   p    v         41 continue
            1099     2                   4 continue
            1100     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
            1101     2  pp                 do 50 mp=1,jtrun
            1102     2   p                 fm= mp-1.0
            1103     2   p             fms = fm*fm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
            1104     3   p    v            do 50 np=mp,jtrun
            1105     3   p    v            fnp= np
            1106     3   p    v        fnp2 = fnp + fnp
            1107     3   p    v        cf = (fnp*fnp - fms)*(fnp2 - 1.0)/(fnp2 + 1.0)
            1108     3   p    v            cf= sqrt(cf)
            1109     3               !  der
            1110     3   p    v            dpnm(np,mp)   = -sn2i*(cf*pnm(np+1,mp) - fnp*xx*pnm(np,mp))
            1111     2   p    v         50 continue
            1112     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpnm, pnm
                                   <<< Loop-information  End >>>
            1113     2                     do 71 m=1,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpnm, pnm
                                   <<< Loop-information  End >>>
            1114     3   s   2v            do 71 l=m,jtrun
            1115     3   p   2v            ml= mlsort(m,l)
            1116     3   m   2v            poly(ml,j)= pnm(l,m)
            1117     3   s   2v            dpoly(ml,j)=dpnm(l,m)
            1118     2   p   2v         71 continue
            1119     1                     dpoly(1,j)= 0.0
            1120     1                1001 continue
            1121                     
            1122                       end subroutine lgndr_sppt
            1123                     
            1124                       subroutine transr_sppt (jtrun,mlmax,nx,my,ll,poly,s,r)
            1125                     !   subroutine to transform a spectral coefficient field to
            1126                     !   grid point form
            1127                     !
            1128                     !  *** const ***
            1129                     !
            1130                     !   jtrun: zonal wavenumber resolution limit
            1131                     !   mlmax: number of spectral coefficients (horizontal field)
            1132                     !   nx: e-w dimension no.
            1133                     !   my: n-s dimension no.
            1134                     !   ll: number of levels to transform
            1135                     !   poly: legendre polynomials
            1136                     !
            1137                     !  *** input variable ***
            1138                     !
            1139                     !   s: spectral coefficient array to transform
            1140                     !
            1141                     !  *** output variable ***
            1142                     !
            1143                     !   r: 3-d output grid point fields
            1144                     !
            1145                     !   **************************************
            1146                     
            1147                           use fftcom
            1148                           real :: poly(mlmax,my/2),s(mlmax,2,ll),r(nx,ll,my)
            1149                           real :: cc(nx+2,my),work(nx*my,2)
            1150                           integer :: mlmax,my,nx,ll,jtrun
            1151                           integer :: mlx,i,k,m,j,jj,ml,mm,mp
            1152                           integer :: m1, l, mk, n
            1153                     
            1154                           mlx= (jtrun/2)*((jtrun+1)/2)
            1155     1                     do k=1,ll
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc
                                   <<< Loop-information  End >>>
            1156     2  pp   2v              do m=1,(nx+2)*my/2
            1157     2   p   2v                cc(m,1)= 0.0
            1158     2   p   2v                cc(m,my/2+1)= 0.0
            1159     2   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      s, poly, cc
                                   <<< Loop-information  End >>>
            1160     2                       do j=1,my/2
            1161     2                         jj = my+1-j
            1162     2                         ml = 2*mlx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, s, poly
                                   <<< Loop-information  End >>>
            1163     3  pp    v                do m=2,jtrun,2
            1164     3   p    v                  ml = ml+1
            1165     3   p    v                  mm = 2*m-1
            1166     3   p    v                  mp = mm+1
            1167     3   p    v                  cc(mm,j ) = poly(ml,j)*s(ml,1,k)
            1168     3   p    v                  cc(mp,j ) = poly(ml,j)*s(ml,2,k)
            1169     3   p    v                  cc(mm,jj) = cc(mm,j)
            1170     3   p    v                  cc(mp,jj) = cc(mp,j)
            1171     3   p    v                enddo
            1172     2               
            1173     2                         m1= 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      s, poly, cc
                                   <<< Loop-information  End >>>
            1174     3                         do l=jtrun-1,1,-2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 206
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.28, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      poly, s, cc
                                   <<< Loop-information  End >>>
            1175     4  pp    v                  do m=1,l
            1176     4   p    v                    mm = 2*m-1
            1177     4   p    v                    mp = mm+1
            1178     4   p    v                    ml = m+m1
            1179     4   p    v                    mk = ml+mlx
            1180     4   p    v                    cc(mm,j ) = cc(mm,j ) + poly(ml,j)*s(ml,1,k) + poly(mk,j)*s(mk,1,k)
            1181     4   p    v                    cc(mm,jj) = cc(mm,jj) + poly(ml,j)*s(ml,1,k) - poly(mk,j)*s(mk,1,k)
            1182     4   p    v                    cc(mp,j ) = cc(mp,j ) + poly(ml,j)*s(ml,2,k) + poly(mk,j)*s(mk,2,k)
            1183     4   p    v                    cc(mp,jj) = cc(mp,jj) + poly(ml,j)*s(ml,2,k) - poly(mk,j)*s(mk,2,k)
            1184     4   p    v                  enddo
            1185     3                           m1= m1+l
            1186     3                         enddo
            1187     2                       enddo
            1188     1               !       call fft991(cc,work,trigs,ifax,1,nx+3,nx,my,1)
            1189     1                       call rfftmlt(cc,work,trigs,ifax,1,nx+2,nx,my,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, r
                                   <<< Loop-information  End >>>
            1190     2  pp                   do j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, r
                                   <<< Loop-information  End >>>
            1191     3   p   2v                do i=1,nx
            1192     3   p   2v                  r(i,k,j)= cc(i,j)
            1193     3   p   2v                enddo
            1194     2   p                   enddo
            1195     1                     enddo
            1196                     
            1197                       end subroutine transr_sppt
            1198                     
            1199                       subroutine spptout(tau)
            1200                         implicit none
            1201                         integer      :: i, j, k, jj, nxj, ihead, n
            1202                         integer      :: nxmy4
            1203                         real         :: tau
            1204                         real*4       :: glob4(nx,my)
            1205                         real(kind=RTYPE) :: glob(nx,my),temp(nxp,my_max)
            1206                     
            1207                         ihead=15
            1208                         nxmy4=nx*my*4
            1209     1                   if ( myrank .eq. 0 ) then
            1210     1                     open(ihead,file='sppt.dat',access='direct',form='unformatted',recl=nxmy4,status='unknown')
            1211     1                   endif
            1212                     
            1213     1                   do n=1,nsppt
            1214     1                     call unify_reduceintp(nx,my,my_max,rpattern_sppt(n)%n2d,glob)
            1215     2                     if ( myrank .eq. 0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
            1216     2  pp   2v              glob4=glob
            1217     2                       write(ihead,rec=recn) glob4
            1218     2                       recn=recn+1
            1219     2                     endif
            1220     1                   enddo
            1221     1                   do k=lev,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sppt3d, temp
                                   <<< Loop-information  End >>>
            1222     2  pp                 do jj=1,jlistnum
            1223     2   p                   j=jlist1(jj)
            1224     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sppt3d, temp
                                   <<< Loop-information  End >>>
            1225     3   p   2v              do i=1,nxj
            1226     3   p   2v              temp(i,jj)=sppt3d(i,k,jj)
            1227     3   p   2v              enddo
            1228     2   p                 enddo
            1229     1                     call unify_reduceintp(nx,my,my_max,temp,glob)
            1230     2                     if ( myrank.eq.0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
            1231     2  pp   2v              glob4=glob
            1232     2                       write(ihead,rec=recn) glob4
            1233     2                       recn=recn+1
            1234     2                     endif
            1235     1                   enddo
            1236                     
            1237                         if ( myrank.eq.0 ) close(ihead)
            1238                     
            1239                         !creating ctl file
            1240                         call spptctl(tau)
            1241                     
            1242                       end subroutine spptout

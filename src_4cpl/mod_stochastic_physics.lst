             726                       subroutine get_noise(rpattern,noise)
             727                         implicit none
             728                         integer :: ml, ns, ms
             729                         type(random_pattern), intent(inout) :: rpattern
             730                         real(kind=RTYPE), intent(out) :: noise(rpattern%mlmax,2)
             731                         real :: noise_gauss(2*rpattern%mlmax)
             732                         real :: ave, var, std
             733                     
             734                         ! get white noise  with a gaussian (normal) distribution
             735                         call random_gauss(noise_gauss,rpattern%rstate)
             736                         noise_gauss(1) = 0.; noise_gauss(rpattern%mlmax+1) = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise_gauss
                                   <<< Loop-information  End >>>
             737        pp   2v          noise_gauss = noise_gauss*sqrt(1./float(rpattern%jtrun-1))
             738                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise
                                   <<< Loop-information  End >>>
             739        pp   4v          noise=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 276
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, noise_gauss, (unknown)
                                   <<< Loop-information  End >>>
             740     1  pp    v          do ml=1,rpattern%mlmax
             741     1                     ! set up to red noise
             742     1   p    v            noise(ml,1) = noise_gauss(ml)/sqrt(float(2*(rpattern%lsort(ml)-1)+1))
             743     1   p    v            noise(ml,2) = noise_gauss(rpattern%mlmax+ml)/sqrt(float(2*(rpattern%lsort(ml)-1)+1))
             744     1                     ! zero out the imagenary part when m(zonal wavenumber) equal to 1
             745     2   p    v            if (rpattern%msort(ml) .eq. 1) then
             746     2   p    v              noise(ml,1) = sqrt(2.)*noise(ml,1)
             747     2   p    v              noise(ml,2) = 0.
             748     2   p    v            endif
             749     1   p    v          enddo
             750                       end subroutine get_noise
             751                     
             752                       subroutine gen_random_pattern_2d(rpattern)
             753                     
             754                         use const, only : poly ,RTYPE
             755                         implicit none
             756                         type(random_pattern), intent(inout) :: rpattern
             757                         !real(kind=RTYPE), intent(out) :: sppt2d(nxp,my_max)
             758                         integer :: ml, ns, ms
             759                         real(kind=RTYPE), allocatable :: noise(:,:)
             760                         real(kind=RTYPE), allocatable :: specp(:,:,:),bufr2d(:,:,:)
             761                     
             762                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             763                         allocate(specp(jtrun,jtmax,2))
             764                     
             765     1                   if ( col_rank .eq. 0 ) then
             766     1                     ! get noise
             767     1                     allocate(noise(rpattern%mlmax,2))
             768     1                     call get_noise(rpattern,noise)
             769     1               
             770     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             771     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             772     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             773     1  pp   2v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             774     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             775     1               
             776     1                     ! ready for mpi_scatter random pattern
             777     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             778     1                                        ,rpattern%mlsort,nsizey             &
             779     1                                        ,rpattern%spec,bufr2d)
             780     1               
             781     1                     deallocate(noise)
             782     1                   endif
             783                     
             784                         !  mpi_scatter random pattern from root
             785                         call mpe_scatter_sppt(bufr2d,specp,2*jtrun*jtmax,nsizey)
             786                     
             787                         ! transform spectral to physical space
             788                         call transr1(jtrun,jtmax,nx,my,my_max,poly,specp,rpattern%n2d,nsizey)
             789                     
             790                         deallocate(bufr2d)
             791                         deallocate(specp)
             792                     
             793                       end subroutine gen_random_pattern_2d
             794                     
             795                       subroutine gen_random_pattern_2d_vect(rpattern,k)
             796                         use const, only : poly, dpoly, wdfac, wcfac, onocos,RTYPE
             797                         implicit none
             798                         type(random_pattern), intent(inout) :: rpattern
             799                         integer :: ml, ns, ms, k
             800                         real, allocatable ::            specpv(:,:,:),specpd(:,:,:)
             801                         real(kind=RTYPE), allocatable :: bufr2d(:,:,:) ,noise(:,:) ,specf(:,:)
             802                     
             803                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             804                         allocate(specpd(jtrun,jtmax,2)) !divergence
             805                         allocate(specpv(jtrun,jtmax,2)) !vorticity
             806                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specpd
                                   <<< Loop-information  End >>>
             807        pp   4v          specpd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specpv
                                   <<< Loop-information  End >>>
             808        pp   4v          specpv = 0.0
             809                     
             810     1                   if ( col_rank .eq. 0 ) then
             811     1                     ! get noise
             812     1                     allocate(noise(rpattern%mlmax,2))
             813     1                     allocate(specf(rpattern%mlmax,2))
             814     1                     call get_noise(rpattern,noise)
             815     1               
             816     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             817     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             818     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             819     1  pp   4v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             820     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             821     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specf, (unknown)
                                   <<< Loop-information  End >>>
             822     1  pp   2v            specf(:,1) = rpattern%kenorm(:,1) * rpattern%spec(:,1)
             823     1   p   2v            specf(:,2) = rpattern%kenorm(:,2) * rpattern%spec(:,2)
             824     1               
             825     1                     ! ready for mpi_scatter random pattern
             826     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             827     1                                        ,rpattern%mlsort,nsizey             &
             828     1                                        ,specf,bufr2d)
             829     1               
             830     1                     deallocate(noise)
             831     1                     deallocate(specf)
             832     1                   endif
             833                     
             834                         !  mpi_scatter random pattern from root
             835                         call mpe_scatter_sppt(bufr2d,specpv,2*jtrun*jtmax,nsizey)
             836                     
             837                         !  spectral transform for velocity components
             838                         call tranuv1 (jtrun,jtmax,nx,my,my_max,1,onocos,wcfac,wdfac &
             839                                     , poly,dpoly,specpv,specpd,rpattern%n2du(1,1,k),rpattern%n2dv(1,1,k),nsizey)
             840                     
             841                         deallocate(bufr2d)
             842                         deallocate(specpd)
             843                         deallocate(specpv)
             844                     
             845                       end subroutine gen_random_pattern_2d_vect
             846                     
             847                       subroutine get_legendre_poly(mlmax,jtrun,poly)
             848                         implicit none
             849                         integer, intent(in) :: mlmax,jtrun
             850                         real(kind=RTYPE),intent(out)   ::  poly(mlmax,my/2)
             851                     
             852                         !   Spheric Harmonic Constants
             853                         integer ::  msort(mlmax),lsort(mlmax),mlsort(mlmax,jtrun)
             854                         real(kind=RTYPE) :: dpoly(mlmax,my/2),eps4(mlmax),cim(mlmax)
             855                         real(kind=RTYPE) :: cosl(my),onocos(my)
             856                         real(kind=RTYPE) :: weight(my),sinl(my)
             857                         real :: cp,capa,rgas,pi,radsq,rad,one,onem,irad
             858                         integer :: rl,rm,rlm,ml
             859                         integer :: j,my2
             860                     
             861                         !   prepare spheric harmonic coefficients
             862                         cp=1004.24
             863                         capa= 1.0/3.5
             864                         rgas= capa*cp
             865                         pi  = 4.0*atan(1.0)
             866                         rad = 6.371e6
             867                         radsq= rad*rad
             868                     !
             869                     !   build pointer arrays for locating zonal and total wavenumber
             870                     !   values in the one-dimensional spherical harmonic arrays.
             871                         call sortml (jtrun,mlmax,msort,lsort,mlsort)
             872                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 272
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.62, ITR: 112, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lsort, cim, msort, eps4
                                   <<< Loop-information  End >>>
             873     1  pp    v          do ml = 1, mlmax
             874     1   p    v            rl = lsort(ml)
             875     1   p    v            rm = msort(ml)-1
             876     1   p    v            rlm= rl-1.0
             877     1   p    v            if (msort(ml).eq.1)  rm= 0.0
             878     1   p    v            if (lsort(ml).eq.1)  rlm= 0.0
             879     1   p    v            eps4(ml)= rl*rlm/radsq
             880     1   p    v            cim(ml)= rm
             881     1   p    v          enddo
             882                     
             883                     !   gaussian quadrature weights and latitudes
             884                         one = 1.0
             885                         onem= -one
             886                         call gausl3 (my,onem,one,weight,sinl)
             887                     !
             888                         my2= my/2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.30, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, onocos, weight, cosl
                                   <<< Loop-information  End >>>
             889     1   s    s          do j = 1, my2
             890     1   s    s            sinl(my+1-j)  = -sinl(j)
             891     1   s    s            weight(my+1-j)= weight(j)
             892     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             893     1   s    s            onocos(my+1-j)= onocos(j)
             894     1   m    m            cosl(j)       = 1.0/sqrt(onocos(j))
             895     1   s    s            cosl(my+1-j)  = cosl(j)
             896     1   p    v          enddo
             897                     !
             898                     !   define associated legendre polynomials and their derivatives
             899                         call lgndr_sppt(my2,jtrun,mlmax,mlsort,sinl,poly,dpoly)
             900                     
             901                       end subroutine get_legendre_poly
             902                     
             903                       SUBROUTINE avevar_sppt(data,n,ave,var,std)
             904                           INTEGER n
             905                           REAL ave,var,data(n)
             906                           INTEGER j
             907                           REAL s,ep,std
             908                           ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             909     1  pp    v            do j=1,n
             910     1   p    v              ave=ave+data(j)
             911     1   p    v            enddo
             912                           ave=ave/n
             913                           var=0.0
             914                           ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             915     1  pp    v            do j=1,n
             916     1   p    v              s=data(j)-ave
             917     1   p    v              ep=ep+s
             918     1   p    v              var=var+s*s
             919     1   p    v            enddo
             920                           var=(var-ep**2/n)/n
             921                           std=sqrt(var)
             922                     
             923                       end SUBROUTINE avevar_sppt
             924                     !
             925                     !
             926                       SUBROUTINE avevar_sppt2d(data2d,n,m,ave,var,std)
             927                         INTEGER :: n,m,nmdim
             928                         REAL :: ave,var,data(n*m)
             929                         REAL(kind=RTYPE) :: data2d(n,m)
             930                         INTEGER :: i,j
             931                         REAL :: s,ep,std
             932                     
             933                         nmdim=0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             934     1                   do j=1,m
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             935     2  pp   2v            do i=1,n
             936     2   p   2v            nmdim=nmdim+1
             937     2   p   2v            data(nmdim)=data2d(i,j)
             938     2   p   2v            enddo
             939     1                   enddo
             940                     
             941                         ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             942     1  pp    v          do j=1,nmdim
             943     1   p    v            ave=ave+data(j)
             944     1   p    v          enddo
             945                         ave=ave/nmdim
             946                         var=0.0
             947                         ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             948     1  pp    v          do j=1,nmdim
             949     1   p    v            s=data(j)-ave
             950     1   p    v            ep=ep+s
             951     1   p    v            var=var+s*s
             952     1   p    v          enddo
             953                     !   var=(var-ep**2/n)/(n-1)    ! sample numners < 30
             954                         var=(var-ep**2/nmdim)/nmdim
             955                         std=sqrt(var)
             956                       end SUBROUTINE avevar_sppt2d
             957                     
             958                       subroutine removegt2std(scaleval,nx,my,aves,stds)
             959                         integer i,j,nx,my
             960                         real scaleval(nx,my),aves,stds
             961                         real vcheck2p,vcheck2n
             962                     
             963                         vcheck2p=2.0*stds
             964                         vcheck2n=-2.0*stds
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      scaleval
                                   <<< Loop-information  End >>>
             965     1  pp   2v          do j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             966     2   p   2           do i=1,nx
             967     2   p   2v            if ((scaleval(i,j)-aves).gt.vcheck2p) scaleval(i,j)=vcheck2p
             968     2   p   2v            if ((scaleval(i,j)-aves).lt.vcheck2n) scaleval(i,j)=vcheck2n
             969     2   p   2v          enddo
             970     1   p               enddo
             971                       end subroutine removegt2std
             972                     
             973                       subroutine removegt3std(scaleval,nx,my,aves,stds)
             974                         integer i,j,nx,my
             975                         real scaleval(nx,my),aves,stds
             976                         real vcheck3p,vcheck3n
             977                     
             978                         vcheck3p=3.0*stds
             979                         vcheck3n=-3.0*stds
             980                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      scaleval

            1455                       subroutine skebctl(tau)
            1456                     !
            1457                         use const, only : idtg,sinl,sigma
            1458                         use rank, only : myrank
            1459                     
            1460                         integer :: nxj,j,k,itau,ch,iter,remd,js,je,kk,lev1, mn, n

            1214     3  pp    v                do i = 1, nxj
            1215     3   p    v                  ps(i) = pt(i,jj) + ptop
            1216     3   p    v                  hs(i) = cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj))/grav
            1217     3   p    v                  ux(i) = ut(i,lev,jj) * xx  ! back to real velocity
            1218     3   p    v                  vx(i) = vt(i,lev,jj) * xx  ! back to real velocity
            1219     3   p    v                  tx(i) = tt(i,lev,jj) / (1.0+0.608*qt(i,lev,jj))
            1220     3   p    v                  qx(i) = qt(i,lev,jj)
            1221     3   p    v                  tsx(i) = tt(i,lev,jj) * pk2(i,lev,jj) / (1.0+0.608*qt(i,lev,jj))
            1222     3   p    v                  tgp(i) = tg(i,jj)/pk2(i,lev,jj)   ! tg in term of potential temp
            1223     3   p    v                enddo

               1                           subroutine lsp ( t,q,pl,pst,dsigma,g,nxj,nx,lev,evaprh,rlsp,cp,hltm &
               2                                          , lsppt,ipass )
               3                     !
               4                     !       large scale precipitation calculation     c.s. liou
               5                     !
               6                     !     input variables:  t, q, pl, pms, nx, lev
               7                     !       t: real temperature (nx,lev),                            (k)
               8                     !       q: specific humidity (nx,lev),                           (kg/kg)
               9                     !       pl: pressure on odd sigma levels                        (mb)
              10                     !      pst: (terrain pressure -ptop)                            (mb)
              11                     !     dsigma: sigma layer thickness
              12                     !        g: gravity
              13                     !       nx: horizontal dimension,   lev: vertical dimension,
              14                     !   evaprh: relative humidity that stops evaporation,
              15                     !           (set to zero if no evaporation is allowed)
              16                     !       cp: specific heat constant for air
              17                     !     hltm: latent heat relase constant for water vapor
              18                     !
              19                     !     output variables:  t, q, rlsp
              20                     !        t: adjusted real temperature after lsp process,        (k)
              21                     !        q: adjusted specific humidity after lsp process,       (kg/kg)
              22                     !     rlsp: lsp precipitation rate per call.                  (mm/call)
              23                     !    lsppt: no. of saturated points at each layer
              24                     !    ipass: no. of iterations at each layer for the converge
              25                     !
              26                     !     by c. s. liou     6/92
              27                     !     modify to f90 by C-H Lee and sort by River Chen in 2015
              28                     !
              29                     !     local work array:
              30                     !       pms: mass between even sigma levels= dsigma*pst*100.0/g  (kg)
              31                     !       ws,wq,wt,wp,qs,rain,cld,lsppt,ipass
              32                     !     external function called:  qsatq
              33                     !
              34                           use paramt
              35                           use const, only: RTYPE
              36                     
              37                           implicit  none
              38                     
              39                           integer   nxj,nx,lev,inx,ic
              40                           integer   lsppt(lev),ipass(lev)
              41                     
              42                           real      g,evaprh,cp,hltm
              43                           real      pl(nx,lev),rlsp(nx),ttmp(nx)
              44                           real(kind=RTYPE) t(nx,lev),q(nx,lev),pst(nx),dsigma(lev,2)
              45                     !
              46                     !     local work arrays
              47                     !
              48                           real      pms(im,lm)
              49                           real      ws(im),wq(im),wt(im),wp(im),qs(im)
              50                           logical   cld(im)
              51                     !
              52                           integer   icmax,l,i,nsat,nrain,lp
              53                           real      gamfac,ww,wmax,wev,hlcp
              54                     
              55                           gamfac = hltm * 5417.983 / cp
              56                           hlcp = hltm / cp
              57                           icmax = 5
              58                     !
              59                     !     compute mass in between sigma layer  (kg, = pst*dsig*100/g)
              60                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pst, pms
                                   <<< Loop-information  End >>>
              61     1  pp                 do 100 l = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pst, pms
                                   <<< Loop-information  End >>>
              62     2   p   2v            do 100 i = 1, nxj
              63     2   p   2v            pms(i,l) = (pst(i)*dsigma(l,1)+dsigma(l,2))*100.0/g
              64     1   p   2v       100  continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rlsp
                                   <<< Loop-information  End >>>
              65     1  pp   4v            do 150 i = 1, nxj
              66     1   p   4v            rlsp(i) = 0.0
              67     1   p   4v        150 continue
              68                     !
              69                     !     check saturated points for condensation level by level
              70                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, ttmp, pms, q, ws, rlsp, wp, wq, wt
                                   <<< Loop-information  End >>>
              71     1                     do 800 l = 1, lev
              72     1               !
              73     1               !     set up cloud index array 'cld'
              74     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, ttmp
                                   <<< Loop-information  End >>>
              75     1  pp   2v            ttmp(:)=t(:,l)
              76     1                     call qsatq (nxj,ttmp, pl(1,l), qs )
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, q, cld
                                   <<< Loop-information  End >>>
              77     2  pp   2v            do 200 i = 1, nxj
              78     2   p   2v            cld(i) = q(i,l) .gt. qs(i)
              79     2   p   2v        200 continue
              80     1                     nsat = 0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
              81     2  pp    v            do 220 i = 1, nxj
              82     2   p    v            if ( cld(i) )  nsat = nsat + 1
              83     2   p    v        220 continue
              84     1                     lsppt(l) = nsat
              85     1                     ipass(l) = 0
              86     1                     if ( nsat .eq. 0 )  go to 550
              87     1               !
              88     1               !     pack saturated points into work arrays ws, wq, wt, wp
              89     1               !
              90     1                     inx = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cld
                                   <<< Loop-information  End >>>
              91     2       2s            do 240 i = 1, nxj
              92     3       2v            if ( cld(i) )  then
              93     3       2m               inx = inx + 1
              94     3       2s               ws(inx) = qs(i)
              95     3       2s               wq(inx) = q(i,l)
              96     3       2s               wt(inx) = t(i,l)
              97     3       2s               wp(inx) = pl(i,l)
              98     3       2v            endif
              99     2       2v        240 continue
             100     1               !
             101     1               !     iterate for new saturation
             102     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ws, wt, wq
                                   <<< Loop-information  End >>>
             103     2                     do 390 ic = 1, icmax
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wq, ws, wt
                                   <<< Loop-information  End >>>
             104     3  pp    v            do 300 i = 1, nsat
             105     3   p    v            ww = (wq(i) - ws(i)) / (1.0 + gamfac*ws(i)/(wt(i)*wt(i)))
             106     3   p    v            wq(i) = wq(i) - ww
             107     3   p    v            wt(i) = wt(i) + ww*hlcp
             108     3   p    v        300 continue
             109     2                     call qsatq (nsat, wt, wp, ws )
             110     2                     wmax = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             111     3  pp    v            do 320 i = 1, nsat
             112     3   p    v            wmax = max( wmax, abs( wq(i)/ws(i) - 1.0 ) )
             113     3   p    v        320 continue
             114     2                     if ( wmax .lt. 0.002 )  go to 400
             115     2                 390 continue
             116     1                     print 992, l, wmax
             117     1                 992 format (1x,'***warning: lsp not converge in 5 iter, (l,wmax) = ' &
             118     1                            , i3,1x,e13.6 )
             119     1                 400 continue
             120     1                     ipass(l) = ic
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, ws
                                   <<< Loop-information  End >>>
             121     2  pp   2v            do 410 i = 1, nxj
             122     2   p   2v            ws(i) = q(i,l)
             123     2   p   2v        410 continue
             124     1               !
             125     1               !     expand adjusted q and t to full grids
             126     1               !
             127     1                     inx = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cld
                                   <<< Loop-information  End >>>
             128     2       2s            do 500 i = 1, nxj
             129     3       2v            if ( cld(i) )  then
             130     3       2m               inx = inx + 1
             131     3       2s               q(i,l) = wq(inx)
             132     3       2s               t(i,l) = wt(inx)
             133     3       2v            endif
             134     2       2v        500 continue
             135     1               !
             136     1               !     update rain fall amounts generated in this call only
             137     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.80, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, ws, pms, rlsp, wp
                                   <<< Loop-information  End >>>
             138     2  pp    v            do 520 i = 1, nxj
             139     2   p    v            wp(i) =  ws(i) - q(i,l)
             140     2   p    v            rlsp(i) = rlsp(i) + pms(i,l)*wp(i)
             141     2   p    v        520 continue
             142     1               !
             143     1                 550 continue
             144     1               !
             145     1                     nrain = 0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             146     2  pp    v            do 560 i = 1, nxj
             147     2   p                 if ( rlsp(i) .gt. 0.0 )  nrain = nrain + 1
             148     2   p    v        560 continue
             149     1               !
             150     1               !     evaporation into the next lower layer
             151     1               !
             152     1                     if ((nrain.eq.0).or.(evaprh.le.0.0).or.(l.ge.(lev-1))) go to 800
             153     1                     lp = l + 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, ttmp
                                   <<< Loop-information  End >>>
             154     1  pp   2v            ttmp(:)=t(:,lp)
             155     1                     call qsatq (nxj,ttmp, pl(1,lp), ws )
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.80, ITR: 88, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wp, pms, q, rlsp, ws, wt, wq
                                   <<< Loop-information  End >>>
             156     2  pp    v            do 600 i = 1, nxj
             157     2   p    v            wq(i) = pms(i,lp) * q(i,lp)
             158     2   p    v            wt(i) = wq(i) + rlsp(i)
             159     2   p    v            wp(i) = evaprh*ws(i)*pms(i,lp)
             160     2   p    v        600 continue
             161     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.86, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rlsp, pms, wp, wq, t, q, wt, ws
                                   <<< Loop-information  End >>>
             162     2  pp    v            do 700 i = 1, nxj
             163     3   p    v            if ( wq(i) .lt. wp(i) )  then
             164     4   p    v               if ( wt(i) .le. wp(i) )  then
             165     4               !
             166     4               !     case (1) all falling rain evapolates in the next lower layer
             167     4               !
             168     4   p    v                  ws(i) = rlsp(i)/pms(i,lp)
             169     4   p    v                  q(i,lp) = q(i,lp) + ws(i)
             170     4   p    v                  t(i,lp) = t(i,lp) - ws(i)*hlcp
             171     4   p    v                  rlsp(i) = 0.0
             172     4   p    v               else
             173     4               !
             174     4               !     case (2) part of falling rain evaporates in the next lower layer
             175     4               !     so that the relative humidity is evaprh, rest rain falls through
             176     4               !
             177     4   p    v                  wev = wp(i) - wq(i)
             178     4   p    v                  rlsp(i) = rlsp(i) - wev
             179     4   p    v                  ws(i) = wev / pms(i,lp)
             180     4   p    v                  q(i,lp) = q(i,lp) + ws(i)
             181     4   p    v                  t(i,lp) = t(i,lp) - ws(i)*hlcp
             182     4   p    v               endif
             183     3   p    v            endif
             184     2   p    v        700 continue
             185     1               !
             186     1                 800 continue
             187                     !
             188                     !
             189                           return
             190                           end


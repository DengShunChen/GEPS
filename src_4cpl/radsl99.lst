 External subroutine subprogram "radsl99"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine radsl99( ns,nx,lev,fluxcl,s0,u0,as            &
               2                                            ,pu,pa,ta,wa,oa,cld,clwc,cre,ciwc,cde   &
               3                                            ,cufrac,fusl,fdsl,fuslr,fdslr )
               4                     !
               5                     !#####################################################################
               6                     !
               7                     !  (1)Compute solar radiation heating rates and net fluxes at the top
               8                     !  and surface using the delta-eddington approximation.
               9                     !
              10                     !  (2)The treatment of spetral bands(11 bands), gas absorption and cloud
              11                     !  optical property totally follows the context of Chou and Suarez (1999).
              12                     !  But, for simplicity we ingor the minor gas absorption by co2 and o2,
              13                     !  aerosol and rain drop effects. They can be introduced into the code easily.
              14                     !
              15                     !  (3)The treatment of the cloud overlapping, however, is based on the
              16                     !  method proposed by Geleyn and Hollingsworth (1979, contrib. atmos. phys.).
              17                     !
              18                     !
              19                     !  ++ input/output variables :
              20                     !   (1) input :
              21                     !       ns    : number of grid points to calculate sw fluxes
              22                     !       nx    : horizontal dimension of input array
              23                     !       lev   : number of vertical layers
              24                     !       fluxcl : logical const. to calculate clear-sky sw fluxes for
              25                     !                performing cloud radiative forcing purpose
              26                     !       s0    : solar const.
              27                     !       u0(nx) : cos(zenith angle)
              28                     !       as(nx,ibsl) : ground surface albedo
              29                     !       pu(nx*(lev+1)) : presure at level levels
              30                     !       pa(nx*lev) : presure at odd levels ( prediction levels )
              31                     !       ta(nx*lev) : temperature at odd levels
              32                     !       wa(nx*lev) : moisture (mixing ratio) specific humility ( kg/kg )
              33                     !       oa(nx*lev) : ozone mixing ratio from climatology ( kg/kg )
              34                     !       cld(nx*lev) : cloud fraction at each layer
              35                     !       clwc(nx*lev): liquid water content at each layer ( g/m3 )
              36                     !       cre(nx*lev) : effective size of water clouds ( um )
              37                     !       ciwc(nx*lev): ice water content at each layer ( g/m3 )
              38                     !       cde(nx*lev) : effective size of ice clouds ( um )
              39                     !       cufrac(nx) : cumulus-related cloud fraction for chooseing
              40                     !                    cloud overlapping approximation
              41                     !
              42                     !  (2) output : (nx*(lev+1))
              43                     !     fusl  : all-sky solar upward flux at each level ( w/m2 )
              44                     !     fdsl  : all-sky solar downward flux at each level ( w/m2 )
              45                     !     fuslr : clear-sky solar upward flux at each level ( w/m2 )
              46                     !     fdslr : clear-sky solar downward flux at each level ( w/m2 )
              47                     !
              48                     !#########################################################################
              49                     !
              50                           implicit none
              51                           integer, parameter :: nk=10, ibo3=8, ibsl=11, igsl=38
              52                     !
              53                           integer  ns,nx,lev
              54                           logical fluxcl
              55                           real    s0
              56                           real    u0(nx),as(nx,ibsl),pu(nx*(lev+1)),pa(nx*lev),           &
              57                                   ta(nx*lev),wa(nx*lev),oa(nx*lev),cld(nx*lev),           &
              58                                   clwc(nx*lev),cre(nx*lev),ciwc(nx*lev),cde(nx*lev),      &
              59                                   cufrac(nx),fusl(nx*(lev+1)),fdsl(nx*(lev+1)),           &
              60                                   fuslr(nx*(lev+1)),fdslr(nx*(lev+1))
              61                     !
              62                     !  local working arrays
              63                     !
              64                     !cc   include 'param.h'
              65                     !
              66                           integer igb(ibsl)
              67                     
              68                           real    hks0(igsl),rayk(ibsl),co3k(ibo3),cwk(ibo3),             &
              69                                   ch2ok(nk)
              70                           real    zw1(nx*lev,2),zw2(nx*lev,2),zw(nx*lev,2),ztau(nx*lev,2),&
              71                                   zttau(nx*(lev+1),2),zffu(nx*(lev+1)),zffd(nx*(lev+1))
              72                           real    tauray(nx*lev),tauic(nx*lev),tauwc(nx*lev),             &
              73                                   taugas(nx*lev),taurn(nx*lev)
              74                           real    gic(nx*lev),gwc(nx*lev),grn(nx*lev),                    &
              75                                   wic(nx*lev),wwc(nx*lev),wrn(nx*lev)
              76                           real    cldb(nx*lev,4),waa(nx*lev),oaa(nx*lev),dp(nx*lev),      &
              77                                   dz(nx*lev),clwp(nx*lev),ciwp(nx*lev)
              78                           real    aib(ibsl,2),awb(ibsl,2),aia(ibsl,3),awa(ibsl,3),        &
              79                                   aig(ibsl,3),awg(ibsl,3),ara(ibsl),arg(ibsl)
              80                     
              81                           integer nsn,nsn1,i,j,jk,jj,m,igt,ib,ig
              82                           real    h476,cld_maxran,vmin,dzmax,dzz,scal
              83                           real    reffi,reffw,tics,twcs,ttts,ggc
              84                     !
              85                     !  igb : the number of k intervals contained in the band 1 to band 11
              86                     !
              87                           data igb /8*1,10,10,10/
              88                     !
              89                     !  hks0 : the frational extra-terrestrial solar flux in each k interval
              90                     !
              91                           data hks0/                                                        &
              92                     ! band 1 - band 8
              93                             .00057, .00367, .00083, .00417, .00600, .00556, .05913, .39081  &
              94                     ! band 9
              95                           , .20673, .03497, .03011, .02260, .01336, .00696, .00441, .00115  &
              96                           , .00026, .00000                                                  &
              97                     ! band 10
              98                           , .08236, .01157, .01133, .01143, .01240, .01258, .01381, .00650  &
              99                           , .00244, .00094                                                  &
             100                     ! band 11
             101                           , .01074, .00360, .00411, .00421, .00389, .00326, .00499, .00465  &
             102                           , .00245, .00145/
             103                     !
             104                     !  rayk : the extinction coefficient for Rayleigh scattering.
             105                     !         unit: 1/mb.
             106                     
             107                           data rayk /.00604, .00170, .00222, .00132, .00107, .00091         &
             108                                    , .00055, .00012, .000016, .0000018, .000000/
             109                     
             110                     !
             111                     !  co3k : the ozone absorption coefficient. unit=1/(cm-atm)stp
             112                     !
             113                     !     The effect of the absorption due to ozone in the region
             114                     !     with wavelength grester than 0.7 micron is taken into
             115                     !     consideration by adding the ozone absorption coefficient in
             116                     !     the 0.4-0.7 micron band by a value of 0.0033.  The effect is
             117                     !     to increase the atmospheric absorption by 0.5 W/m^2 for the MLS
             118                     !     and a solar zenith angle of 60 degrees.
             119                     !
             120                           data co3k /30.47, 187.2,  301.9,   42.83                          &
             121                                    , 7.09,  1.25,   0.0345,  0.0572/
             122                     !
             123                     !  cwk : the water vapor absorption coefficient. unit: cm**2/g
             124                     !
             125                           data cwk /7*0.0, 0.00070/
             126                     !
             127                     !  ch2ok: water vapor absorption coefficient for 10 k-intervals
             128                     !         for ir band.  unit: cm^2/gm
             129                     !
             130                           data ch2ok /0.0010, 0.0133, 0.0422, 0.1334, 0.4217                &
             131                                    , 1.334,  5.623,  31.62,  177.8,  1000.0/
             132                     !
             133                     !  coefficients for computing the extinction coefficient of
             134                     !  ice clouds from b=aib(*,1)+aib(*,2)/reff
             135                     !
             136                           data aib /11*0.000333, 11*2.52/
             137                     !
             138                     !  coefficients for computing the extinction coefficient of
             139                     !  water clouds from b=awb(*,1)+awb(*,2)/reff
             140                     
             141                           data awb /8*-0.00659, -0.0101, -0.0166, -0.0339                   &
             142                                   , 8*    1.65,    1.72,    1.85,    2.16/
             143                     !
             144                     !  coefficients for computing the single scattering albedo of
             145                     !  ice clouds from ssa=1-(aia(*,1)+aia(*,2)*reff+aia(*,3)*reff**2)
             146                     
             147                           data aia/8*0., -.00000260, .00215346, .08938331                   &
             148                                   ,8*0.,  .00000746, .00073709, .00299387                   &
             149                                   ,8*0.,  .00000000,-.00000134,-.00001038/
             150                     !
             151                     !  coefficients for computing the single scattering albedo of
             152                     !  liquid clouds from ssa=1-(awa(*,1)+awa(*,2)*reff+awa(*,3)*reff**2)
             153                     
             154                           data awa/8*0., .00000007,-.00019934, .01209318                    &
             155                                   ,8*0., .00000845, .00088757, .01784739                    &
             156                                   ,8*0.,-.00000004,-.00000650,-.00036910/
             157                     !
             158                     !  single-scattering coalbedo for rain drops fixed at a certain
             159                     !  drop distribution.  Data is provided by Q. Fu.
             160                     
             161                           data ara/8*0., .029, .342, .466/
             162                     !
             163                     !  coefficients for computing the asymmetry factor of ice clouds
             164                     !  from asycl=aig(*,1)+aig(*,2)*reff+aig(*,3)*reff**2
             165                     
             166                           data aig/8* .74625000, .74935228, .76098937, .84090400            &
             167                                   ,8* .00105410, .00119715, .00141864, .00126222            &
             168                                   ,8*-.00000264,-.00000367,-.00000396,-.00000385/
             169                     
             170                     !  coefficients for computing the asymmetry factor of liquid clouds
             171                     !  from asycl=awg(*,1)+awg(*,2)*reff+awg(*,3)*reff**2
             172                     
             173                           data awg/8* .82562000, .79375035, .74513197, .83530748            &
             174                                   ,8* .00529000, .00832441, .01370071, .00257181            &
             175                                   ,8*-.00014866,-.00023263,-.00038203, .00005519/
             176                     !
             177                     !  asymmetry factor for rain drops fixed at a certain
             178                     !  drop distribution.  Data is provided by Q. Fu.
             179                     
             180                           data arg/8* 0.883, 0.891, 0.948, 0.971/
             181                     !
             182                     !  476.16 = 2.24e4 / M * 10.0 / 9.8, where M = 48 for o3
             183                     !
             184                           data h476/476.16/
             185                     !
             186                     !  if "cufrac(i)" .gt. "cld_maxran", assume maximum-random cloud overlapping
             187                     !  if "cufrac(i)" .le. "cld_maxran", assume random cloud overlapping
             188                     !  so, set cld_maxran equal to less than 0. if assume the maximum-random cloud
             189                     !  overlapping approximation always
             190                     !
             191                           data cld_maxran / 0. /  ! zero means maximum-random overlap always
             192                     !
             193                           nsn  = ns*lev
             194                           nsn1 = ns*(lev+1)
             195                           vmin = 1.0e-8
             196                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fdslr, fuslr, fdsl, fusl
                                   <<< Loop-information  End >>>
             197     1  pp   2v            do 10 i = 1, nsn1
             198     1   p   2v            fusl(i) = 0.
             199     1   p   2v            fdsl(i) = 0.
             200     1   p   2v            fuslr(i) = 0.
             201     1   p   2v            fdslr(i) = 0.
             202     1   p   2v         10 continue
             203                     !
             204                     !  pu : pressure at even level
             205                     !  dp : layer thickness in pressure (hPa)
             206                     !  dz : layer thickness (m)
             207                     !
             208                           dzmax = 1000.    ! avoid too thick cloud depth
             209                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pu, dp, ciwc, ta, clwc, dz, clwp, ciwp
                                   <<< Loop-information  End >>>
             210     1                     do 25 j = 1, lev
             211     1                     jk = j*ns
             212     1                     jj = jk-ns
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 40
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.41, ITR: 80, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ciwp, dp, ta, dz, ciwc, clwc, clwp, pu
                                   <<< Loop-information  End >>>
             213     2  pp    v            do 25 i = 1, ns
             214     2   p    v            dp(i+jj) = pu(i+jk) - pu(i+jj)
             215     2   p    v            dz(i+jj) = 29.2674 * ta(i+jj) * log( pu(i+jk)/pu(i+jj) )
             216     2   p    v            dzz = min( dzmax, dz(i+jj) )
             217     2   p    v            clwp(i+jj) = dzz * clwc(i+jj)
             218     2   p    v            ciwp(i+jj) = dzz * ciwc(i+jj)
             219     1   p    v         25 continue
             220                     !
             221                     !  compute scaled water vapor amount, unit is g/cm**2
             222                     !  compute ozone amount,unit is (cm-atm)stp
             223                     !  the constant h476(476.16) is a conversion factor from g/cm**2
             224                     !  to (cm-atm)stp
             225                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.82, ITR: 72, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      oa, dp, wa, ta, oaa, pa, waa
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 39
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             226     1  pp    v            do 30 i = 1, nsn
             227     1   p    v            scal = exp( 0.8*log(pa(i)/300.) )
             228     1   p    v            waa(i) = 1.02*wa(i)*scal*(1.+0.00135*(ta(i)-240.))*dp(i)
             229     1   p    v            oaa(i) = h476*oa(i)*dp(i)
             230     1   p    v         30 continue
             231                     !
             232                     !  compute cloud overlapping variables depending on the overlapping
             233                     !  approximation
             234                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<< Loop-information  End >>>
             235     1  pp                 do 35 m = 1, 4
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldb
                                   <<< Loop-information  End >>>
             236     2   p   4v            do 35 i = 1, nsn
             237     2   p   4v            cldb(i,m) = 1.0
             238     1   p   4v         35 continue
             239                     !
             240                           jj = nsn - ns
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldb, cld
                                   <<< Loop-information  End >>>
             241     1  pp    v            do 40 i = 1, ns
             242     1   p    v            cldb(i,1) = 1.0 - cld(i)
             243     1   p    v            cldb(i,3) = cld(i)
             244     1   p    v            cldb(i+jj,2) = 1.0 - cld(i+jj)
             245     1   p    v            cldb(i+jj,4) = cld(i+jj)
             246     1   p    v         40 continue
             247                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cufrac, cld, cldb
                                   <<< Loop-information  End >>>
             248     1                     do 45 j = 1, lev-1
             249     1                     jk = j*ns
             250     1                     jj = jk-ns
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 118
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cufrac, cld, cldb
                                   <<< Loop-information  End >>>
             251     2  pp    v            do 45 i = 1, ns
             252     2               !
             253     3   p    v            if ( cufrac(i) .ge. cld_maxran ) then
             254     3               !
             255     3               !  maximum-random cloud overlapping approximation
             256     3               !
             257     3   p    v            cldb(i+jk,1) = max( vmin, 1.0-max( cld(i+jk),cld(i+jj) ) ) / &
             258     3                                    max( vmin, 1.0-cld(i+jj) )
             259     3   p    v            cldb(i+jk,3) = max( vmin, min( cld(i+jk),cld(i+jj) ) ) /     &

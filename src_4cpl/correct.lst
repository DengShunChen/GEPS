 External subroutine subprogram "correct"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine correct(vorten,divten,phiten,tmcor,pmcor,vornow,  &
               2                                              divnow,temnow,plnow,jtrun,jtmax,lev)
               3                     !
               4                     !  purpose :  add correction to variables for NNMI
               5                     !-----------------------------------------------------------------------
               6                     !  **** input ****
               7                     !  vorten  :  vorticity correction array in spectrum domaon
               8                     !  divten  :  divergence correction array in spectrum domain
               9                     !  phiten  :  geopotantial correction array in spectrum domain
              10                     !  pmcor   :  array for compute surface pressure correction
              11                     !  tmcor   :  array for compute temperature correction
              12                     !  lev     :  total vertical levels
              13                     !  **** output ****
              14                     !  vornow  : vorticity spectrum coefficient
              15                     !  divnow  : divergence spectrum coefficient
              16                     !  temnow  : temperature spectrum coefficient
              17                     !  plnow   : surface pressure spectrum coefficient
              18                     !
              19                     ! modify to f90 in 2015 by C-H Lee
              20                     ! modify 2015 by River Chen
              21                     !-------------------------------------------------------------------------
              22                     !
              23                           use const, only : RTYPE
              24                           use index
              25                     !
              26                           real(kind=RTYPE) vorten(levp,2,jtrun,jtmax),  &
              27                                            divten(levp,2,jtrun,jtmax),  &
              28                                            phiten(levp,2,jtrun,jtmax),  &
              29                                            vornow(levp,2,jtrun,jtmax),  &
              30                                            divnow(levp,2,jtrun,jtmax),  &
              31                                            temnow(levp,2,jtrun,jtmax),  &
              32                                            temnow1(lev,2,jtrun,jtmax),  &
              33                                            phiten1(lev,2,jtrun,jtmax),  &
              34                                            plnow(jtrun,jtmax,2)
              35                           real(kind=RTYPE) tmcor(lev,lev),pmcor(lev)
              36                     
              37                     !2dMPI >
              38                     
              39                     
              40                           call mpe2d_unify_spec_lev(phiten,phiten1,lev,levp,jtrun,jtmax,mlistnum,nsizex,row_comm)
              41                           call mpe2d_unify_spec_lev(temnow,temnow1,lev,levp,jtrun,jtmax,mlistnum,nsizex,row_comm)
              42                     !2dMPI <
              43                     
              44                     !
              45                     !  add vorticity and divergence correction to vorticity and divergence
              46                     !  spectrum array
              47                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              48     1  pp                 do 100 m=1,mlistnum
              49     1   p                    mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      divten, divnow, vorten, vornow
                                   <<< Loop-information  End >>>
              50     2   p                 do 100 n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      divnow, divten, vorten, vornow
                                   <<< Loop-information  End >>>
              51     3   p    v            do 100 k =1,levp
              52     3   p    v               vornow(k,1,n,m)=vornow(k,1,n,m)+vorten(k,1,n,m)
              53     3   p    v               vornow(k,2,n,m)=vornow(k,2,n,m)+vorten(k,2,n,m)
              54     3   p    v               divnow(k,1,n,m)=divnow(k,1,n,m)+divten(k,1,n,m)
              55     3   p    v               divnow(k,2,n,m)=divnow(k,2,n,m)+divten(k,2,n,m)
              56     1   p    v       100  continue
              57                     !
              58                     !
              59                     !  compute surface pressure correction from geopotential correction and
              60                     !  add to surface spectrum array
              61                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              62     1  pp                 do 110 m=1,mlistnum
              63     1   p                    mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phiten1, pmcor
                                   <<< Loop-information  End >>>
              64     2   p                 do 110 n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 24, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phiten1, pmcor
                                   <<< Loop-information  End >>>
              65     3   p   8             do 110 k =1,lev
              66     3               !        plnow(n,m,1)=plnow(n,m,1)+pmcor(k)*phiten(k,1,n,m)
              67     3               !        plnow(n,m,2)=plnow(n,m,2)+pmcor(k)*phiten(k,2,n,m)
              68     3   p   8                plnow(n,m,1)=plnow(n,m,1)+pmcor(k)*phiten1(k,1,n,m)
              69     3   p   8                plnow(n,m,2)=plnow(n,m,2)+pmcor(k)*phiten1(k,2,n,m)
              70     1   p   8        110  continue
              71                     !
              72                     !
              73                     !  compute temperature correction from geopotential correction and
              74                     !  add to temperature spectrum array
              75                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              76     1  pp                 do 140 m=1,mlistnum
              77     1   p                    mf=mlist(m)
              78     2   p                 do 140 n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmcor, temnow1
                                   <<< Loop-information  End >>>
              79     3   p                 do 140 i=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 14, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temnow1, tmcor
                                   <<< Loop-information  End >>>
              80     4   p   2             do 140 k=1,lev
              81     4               !       temnow(k,1,n,m)=temnow(k,1,n,m)+tmcor(k,i)*phiten(i,1,n,m)
              82     4               !       temnow(k,2,n,m)=temnow(k,2,n,m)+tmcor(k,i)*phiten(i,2,n,m)
              83     4   p   2               temnow1(k,1,n,m)=temnow1(k,1,n,m)+tmcor(k,i)*phiten1(i,1,n,m)
              84     4   p   2               temnow1(k,2,n,m)=temnow1(k,2,n,m)+tmcor(k,i)*phiten1(i,2,n,m)
              85     1   p   2        140  continue
              86                     !
              87                     
              88                     !2dMPI >
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              89     1  pp                 do m=1,mlistnum
              90     1   p                    mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Llist, temnow
                                   <<< Loop-information  End >>>
              91     2   p                 do n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.50, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Llist, temnow
                                   <<< Loop-information  End >>>
              92     3   p   2v            do k=1,levp
              93     3   p   2v               KK=Llist(k)
              94     3   p   2v               temnow(k,1,n,m)=temnow1(KK,1,n,m)
              95     3   p   2v               temnow(k,2,n,m)=temnow1(KK,2,n,m)
              96     3   p   2v            enddo
              97     2   p                 enddo
              98     1   p                 enddo
              99                     !2dMPI <
             100                     
             101                           return
             102                           end


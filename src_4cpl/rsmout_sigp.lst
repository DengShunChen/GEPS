                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      work, g2send
                                   <<< Loop-information  End >>>
             305     1  pp   2v              g2send(:,:)=work(x1:x2,y1:y2)
             306     1                     endif
             307                     #endif

            1525     2   p    m              if(cnvflg(i)) then
            1526     2               !       if(cnvflg(i).and.slimsk(i).ne.1.) then
            1527     3   p    s                if(pfld(i,ktcon(i)).lt.pcrit(15))then
            1528     3   p    s                  acrt(i)=acrit(15)*(975.-pfld(i,ktcon(i))) &
            1529     3                                   /(975.-pcrit(15))
            1530     3   p    s                else if(pfld(i,ktcon(i)).gt.pcrit(1))then
            1531     3   p    s                  acrt(i)=acrit(1)
            1532     3   p    s                else
            1533     3   p    s                  k =  int((850. - pfld(i,ktcon(i)))/50.) + 2
            1534     3   p    s                  k = min(k,15)
            1535     3   p    s                  k = max(k,2)
            1536     3   p    s                  acrt(i)=acrit(k)+(acrit(k-1)-acrit(k))*   &
            1537     3                                (pfld(i,ktcon(i))-pcrit(k))/(pcrit(k-1)-pcrit(k))
            1538     3   p    s                 endif

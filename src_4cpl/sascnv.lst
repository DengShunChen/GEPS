            1558     2               !         acrtfct(i) = pdot(i) / w3
            1559     2               !
            1560     2               !  modify critical cloud workfunction by cloud base vertical velocity
            1561     2               !
            1562     3   p    v                if(pdot(i).le.w4) then
            1563     3   p    v                  acrtfct(i) = (pdot(i) - w4) / (w3 - w4)
            1564     3   p    v                elseif(pdot(i).ge.-w4) then
            1565     3   p    v                  acrtfct(i) = - (pdot(i) + w4) / (w4 - w3)

            1166     4                                         - aup * deta * dv2q                           &
            1167     4                            +adw*edto(i)*detad*.5*(qrcdo(i,k)+qrcdo(i,k-1))) * g / dp
            1168     4   p    v                    dellau(i,k) = dellau(i,k) +                               &

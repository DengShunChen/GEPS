            1581     2               !  modify adjustment time scale by cloud base vertical velocity
            1582     2               !
            1583     2   p    v                dtconv(i) = dt2 + max((1800. - dt2),cons_0) *  &   !constant
            1584     2                                     (pdot(i) - w2) / (w1 - w2)
            1585     2               !         dtconv(i) = max(dtconv(i), dt2)

            1575     2               !  modify acrtfct(i) by colume mean rh if rhbar(i) is greater than 80 percent
            1576     2               !
            1577     2               !         if(rhbar(i).ge..8) then
            1578     2               !           acrtfct(i) = acrtfct(i) * (.9 - min(rhbar(i),.9)) * 10.
            1579     2               !         endif

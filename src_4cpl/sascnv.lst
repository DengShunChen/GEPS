             941     4   p    v                    shear=rcs(i) * sqrt((uo(i,k+1)-uo(i,k)) ** 2   &
             942     4                                               + (vo(i,k+1)-vo(i,k)) ** 2)
             943     4   p    v                    vshear(i) = vshear(i) + shear

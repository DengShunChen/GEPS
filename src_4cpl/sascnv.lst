             843     4   p    v                    dq = eta(i,k) * qcko(i,k) - eta(i,k) * qrch
             844     4   p    v                    rhbar(i) = rhbar(i) + qo(i,k) / qeso(i,k)
             845     4               !
             846     4               !  below lfc check if there is excess moisture to release latent heat
             847     4               !
             848     5   p    v                    if(dq.gt.0.) then

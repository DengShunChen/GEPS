             836     4   p    v                    dz = .5 * (zo(i,k+1) - zo(i,k-1))
             837     4   p    v                    dz1 = (zo(i,k) - zo(i,k-1))
             838     4   p    v                    gamma = el2orc * qeso(i,k) / (to(i,k)**2)
             839     4   p    v                    qrch = qeso(i,k) + gamma * dbyo(i,k) / (hvap * (1. + gamma))
             840     4   p    v                    factor = eta(i,k-1) / eta(i,k)
             841     4   p    v                    onemf = 1. - factor

 External subroutine subprogram "sortml"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine sortml (jtrun,mlmax,msort,lsort,mlsort)
               2                     !
               3                     !  sortml builds pointer arrays for functional dependency between
               4                     !  1-d spectral index and zonal and total wavenumber indices.  this
               5                     !  subroutine reflects the coefficient storage strategy used in the
               6                     !  model
               7                     !
               8                     ! ***input***
               9                     !
              10                     !  jtrun:  zonal and total wavenumber limit
              11                     !  mlmax:  total number of 1-d spectral index for triangular trunc
              12                     !
              13                     !  ***output***
              14                     !
              15                     !  msort:  zonal wavenumber as function of 1-d spectral index
              16                     !  lsort:  total wavenumber as function of 1-d spectral index
              17                     !  mlsort: total wavenumber index as function of zonal and total
              18                     !          wavenumber
              19                     !
              20                     ! *******************************************************************
              21                     !
              22                           implicit  none
              23                           integer   jtrun,mlmax
              24                           integer   msort(mlmax),lsort(mlmax),mlsort(jtrun,jtrun)
              25                           integer   mlx,ml,k,m,mlp
              26                     !
              27                           mlx= (jtrun/2)*((jtrun+1)/2)
              28                           ml= 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      msort, lsort
                                   <<< Loop-information  End >>>
              29     1                     do 1 k=1,jtrun-1,2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      msort, lsort
                                   <<< Loop-information  End >>>
              30     2   s   2s            do 1 m=1,jtrun-k
              31     2   p   2v            ml= ml+1
              32     2   p   2v            mlp= ml+mlx
              33     2   p   2v            mlsort(m,m+k)= mlp
              34     2   p   2v            mlsort(m,m+k-1)= ml
              35     2   s   2s            msort(ml)= m
              36     2   s   2s            lsort(ml)= m+k-1
              37     2   s   2s            msort(mlp)= m
              38     2   s   2s            lsort(mlp)= m+k
              39     1   p   2v          1 continue
              40                     !
              41                           ml= mlp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.70, ITR: 128, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      msort, mlsort, lsort
                                   <<< Loop-information  End >>>
              42     1  pp   2v            do 2 m=2,jtrun,2
              43     1   p   2v            ml= ml+1
              44     1   p   2v            mlsort(m,jtrun)= ml
              45     1   p   2v            msort(ml)= m
              46     1   p   2v            lsort(ml)= jtrun
              47     1   p   2v          2 continue
              48                           return
              49                           end


             381                     !      tsat=(/.421,.464,.468,.434,.406,.465,.404,.439,.421/)
             382                     !      ref=(/.283,.387,.412,.312,.338,.382,.315,.329,.283/)
             383                     !      wlt=(/.029,.119,.139,.047,.100,.103,.069,.066,.029/)
             384                     !---------------------------------------------------------------------------
             385                     ! Default values for some radiation controls
             386                     !---------------------------------------------------------------------------
             387                     ! radiation NCEP-RRTMG scheme
             388                     !     levr     = 60 ! vertical layers for radiation scheme
             389                     !     ictm     = 1  ! ictm=0 => use data at initial cond time, if not
             390                     !                   !           available, use latest, no extrapolation.
             391                     !                   ! ictm=1 => use data at the forecast time, if
             392                     !                   !           not available, use latest and extrapolation.
             393                     !                   ! ictm=yyyy0 => use yyyy data for the forecast time,
             394                     !                   !               no further data extrapolation.
             395                     !                   ! ictm=yyyy1 => use yyyy data for the fcst. if needed,
             396                     !                   !               do extrapolation to match the fcst time.
             397                     !                   ! ictm=-1 => use user provided external data.
             398                     !                   !            for the fcst time, no extrapolation.
             399                     !                   ! ictm=-2 => same as ictm=0, but add seasonal cycle
             400                     !                   !            from climatology. no extrapolation.
             401                     !                   !
             402                     !     isol     = 1  ! use noaa old yearly solar constant table with 11-year
             403                     !                   ! cycle (range : 1944-2006)
             404                     !     ico2     = 2  ! use observed co2 monthly 2-D data table in 15 degree
             405                     !                   ! horizontal resolution
             406                     !     iaer     =111 ! opac-climatology aerosol scheme, include recorded
             407                     !                   ! stratospheric volcanic aerosol effect and
             408                     !                   ! toposperic sw/lw areosol effects.
             409                     !     ialb     = 0  ! ialb=0, surface vegetation type based climatology scheme,
             410                     !                   !         monthly data in 1 degree horizontal resolution.
             411                     !                   ! ialb=1, use modis based alb
             412                     !     iems     = 1  ! surface type based on climatology in 1 degree horizontal
             413                     !                   ! resolution.
             414                     !     ntcw     = 1  ! ntcw=0, no cloud condensate calculated
             415                     !                   ! ntcw>0, include microphysics cloud scheme
             416                     !     num_p3d  = 4  ! num_p3d=4, Zhao Microphysics cloud scheme (default)
             417                     !              = 3  ! num_p3d=3, Brad Ferrier's Microphysics cloud scheme
             418                     !              = 5  ! num_p3d=5, WSM6 Microphysics cloud scheme
             419                     !              = 5  ! num_p3d=5, GFDL Microphysics cloud scheme with effective radii
             420                     !     ntoz     = 0  ! use climatological ozone profile
             421                     !              > 0  ! use interactive ozone profile
             422                     !     iovr_sw  = 1  ! sw: maximum-random overlapping vertical cloud layer
             423                     !     iovr_lw  = 1  ! lw: maximum-random overlapping vertical cloud layer
             424                     !     isubc_sw = 2  ! sw with mcica sub-col approximation provided random seed
             425                     !     isubc_lw = 2  ! lw with mcica sub-col approximation provided random seed
             426                     !                   ! =1 => sub-grid cloud with prescribed seeds
             427                     !                   ! =2 => sub-grid cloud with randomly generated
             428                     !     icice_sw = 3  ! sw cloud optical property for cloud ice
             429                     !     icice_lw = 3  ! lw cloud optical property for cloud ice
             430                     !                   ! =1 ,ebert & curry (1992) method
             431                     !                   ! =2 ,streamer v3 (2001) method
             432                     !                   ! =3 ,fu (1996) method
             433                     !     icliq_sw = 1  ! sw cloud optical property for cloud water
             434                     !     icliq_lw = 1  ! lw cloud optical property for cloud water
             435                     !                   ! =0 ,diagnostic cld opt depth
             436                     !                   ! =1 ,hu & stamnes (1993) method
             437                     !     idate(8)      ! ncep absolute date and time of initial conditions
             438                     !     iflip    = 0  ! = 0 ; index from toa to surface
             439                     !              = 1  ! = 1 ; index from surface to toa
             440                     !     me       = 0  ! = 0 ; print out control flag 'on'
             441                     !              = 1  ! = 1 ; print out control flag 'off'
             442                     !     ioutsigr = 0  ! = 0 ; output radiation sigma parameters
             443                     !              = 1  ! = 1 ; not output
             444                     !     sashal       = .true
             445                     !     crick_proof  = .false.
             446                     !     ccnorm       = .false.
             447                     !     norad_precip = .false.   ! This is effective only for
             448                     !     Ferrier/Moorthi
             449                     !
             450                     !---------------------------------------------------------------------------
             451                           levr=lev
             452                           ictm=1
             453                           isol=1
             454                           ico2=2
             455                           iaer=111
             456                           ialb=0
             457                           iems=1
             458                           ntcw=2
             459                           me=1
             460                     !---------------------------------------------------------------------------
             461                           irad=2
             462                           iflip=1
             463                           iovr_sw  = 1  ! sw: maximum-random overlapping vertical cloud layer
             464                           iovr_lw  = 1  ! lw: maximum-random overlapping vertical cloud layer
             465                           isubc_sw = 0  ! sw with mcica sub-col approximation provided random seed
             466                           isubc_lw = 0  ! lw with mcica sub-col approximation provided random seed
             467                           icice_sw = 3  ! sw cloud optical property for cloud ice
             468                           icice_lw = 3  ! lw cloud optical property for cloud ice
             469                           icliq_sw = 1  ! sw cloud optical property for cloud water
             470                           icliq_lw = 1  ! lw cloud optical property for cloud water
             471                           ntrw=3
             472                           ntiw=4
             473                           ntsw=5
             474                           ntgl=6
             475                           nthl=7  ! hail
             476                           ntoz=3
             477                           ioutsigr=0
             478                     !---------------------------------------------------------------------------
             479                           idate(1)=0
             480                           idate(2)=0
             481                           idate(3)=0
             482                           idate(4)=0
             483                           idate(5)=0
             484                           idate(6)=0
             485                           idate(7)=0
             486                           idate(8)=0
             487                     !---------------------------------------------------------------------------
             488                           sashal=.true.
             489                           crick_proof=.false.
             490                           ccnorm=.false.
             491                           norad_precip=.false.
             492                     !---------------------------------------------------------------------------
             493                           return
             494                           end


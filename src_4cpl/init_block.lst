             378                     !---------------------------------------------------------------------------
             379                     ! Default values for some radiation controls
             380                     !---------------------------------------------------------------------------
             381                     ! radiation NCEP-RRTMG scheme
             382                     !     levr     = 60 ! vertical layers for radiation scheme
             383                     !     ictm     = 1  ! ictm=0 => use data at initial cond time, if not
             384                     !                   !           available, use latest, no extrapolation.
             385                     !                   ! ictm=1 => use data at the forecast time, if
             386                     !                   !           not available, use latest and extrapolation.
             387                     !                   ! ictm=yyyy0 => use yyyy data for the forecast time,
             388                     !                   !               no further data extrapolation.
             389                     !                   ! ictm=yyyy1 => use yyyy data for the fcst. if needed,
             390                     !                   !               do extrapolation to match the fcst time.
             391                     !                   ! ictm=-1 => use user provided external data.
             392                     !                   !            for the fcst time, no extrapolation.
             393                     !                   ! ictm=-2 => same as ictm=0, but add seasonal cycle
             394                     !                   !            from climatology. no extrapolation.
             395                     !                   !
             396                     !     isol     = 1  ! use noaa old yearly solar constant table with 11-year
             397                     !                   ! cycle (range : 1944-2006)
             398                     !     ico2     = 2  ! use observed co2 monthly 2-D data table in 15 degree
             399                     !                   ! horizontal resolution
             400                     !     iaer     =111 ! opac-climatology aerosol scheme, include recorded
             401                     !                   ! stratospheric volcanic aerosol effect and
             402                     !                   ! toposperic sw/lw areosol effects.
             403                     !     ialb     = 0  ! ialb=0, surface vegetation type based climatology scheme,
             404                     !                   !         monthly data in 1 degree horizontal resolution.
             405                     !                   ! ialb=1, use modis based alb
             406                     !     iems     = 1  ! surface type based on climatology in 1 degree horizontal
             407                     !                   ! resolution.
             408                     !     ntcw     = 1  ! ntcw=0, no cloud condensate calculated
             409                     !                   ! ntcw>0, include microphysics cloud scheme
             410                     !     num_p3d  = 4  ! num_p3d=4, Zhao Microphysics cloud scheme (default)
             411                     !              = 3  ! num_p3d=3, Brad Ferrier's Microphysics cloud scheme
             412                     !              = 5  ! num_p3d=5, WSM6 Microphysics cloud scheme
             413                     !              = 5  ! num_p3d=5, GFDL Microphysics cloud scheme with effective radii
             414                     !     ntoz     = 0  ! use climatological ozone profile
             415                     !              > 0  ! use interactive ozone profile
             416                     !     iovr_sw  = 1  ! sw: maximum-random overlapping vertical cloud layer
             417                     !     iovr_lw  = 1  ! lw: maximum-random overlapping vertical cloud layer
             418                     !     isubc_sw = 2  ! sw with mcica sub-col approximation provided random seed
             419                     !     isubc_lw = 2  ! lw with mcica sub-col approximation provided random seed
             420                     !                   ! =1 => sub-grid cloud with prescribed seeds
             421                     !                   ! =2 => sub-grid cloud with randomly generated
             422                     !     icice_sw = 3  ! sw cloud optical property for cloud ice
             423                     !     icice_lw = 3  ! lw cloud optical property for cloud ice
             424                     !                   ! =1 ,ebert & curry (1992) method
             425                     !                   ! =2 ,streamer v3 (2001) method
             426                     !                   ! =3 ,fu (1996) method
             427                     !     icliq_sw = 1  ! sw cloud optical property for cloud water
             428                     !     icliq_lw = 1  ! lw cloud optical property for cloud water
             429                     !                   ! =0 ,diagnostic cld opt depth
             430                     !                   ! =1 ,hu & stamnes (1993) method
             431                     !     idate(8)      ! ncep absolute date and time of initial conditions
             432                     !     iflip    = 0  ! = 0 ; index from toa to surface
             433                     !              = 1  ! = 1 ; index from surface to toa
             434                     !     me       = 0  ! = 0 ; print out control flag 'on'
             435                     !              = 1  ! = 1 ; print out control flag 'off'
             436                     !     ioutsigr = 0  ! = 0 ; output radiation sigma parameters
             437                     !              = 1  ! = 1 ; not output
             438                     !     sashal       = .true
             439                     !     crick_proof  = .false.
             440                     !     ccnorm       = .false.
             441                     !     norad_precip = .false.   ! This is effective only for
             442                     !     Ferrier/Moorthi
             443                     !
             444                     !---------------------------------------------------------------------------
             445                           levr=lev
             446                           ictm=1
             447                           isol=1
             448                           ico2=2
             449                           iaer=111
             450                           ialb=0

               1                     MODULE mo_cumulus_flux
               2                     
               3                       use shr_kind_mod, only: r8 => shr_kind_r8
               4                       use param, only: jtrun
               5                     
               6                       IMPLICIT NONE
               7                     
               8                       ! ----------------------------------------------------------------
               9                       !
              10                       ! module *mo_cumulus_flux* - parameters for cumulus massflux scheme
              11                       !
              12                       ! ----------------------------------------------------------------
              13                     
              14                       REAL(r8) :: entrpen      !    entrainment rate for penetrative convection
              15                       REAL(r8) :: entrscv      !    entrainment rate for shallow convection
              16                       REAL(r8) :: entrmid      !    entrainment rate for midlevel convection
              17                       REAL(r8) :: entrdd       !    entrainment rate for cumulus downdrafts
              18                       REAL(r8) :: cmfctop      !    relat. cloud massflux at level above nonbuoyanc
              19                       REAL(r8) :: cmfcmax      !    maximum massflux value allowed for
              20                       REAL(r8) :: cmfcmin      !    minimum massflux value (for safety)
              21                       REAL(r8) :: cmfdeps      !    fractional massflux for downdrafts at lfs
              22                       REAL(r8) :: rhcdd        !    relative saturation in downdrafts
              23                       REAL(r8) :: cprcon       !    coefficients for determining conversion
              24                       REAL(r8) :: cprcon_n       !    coefficients for determining conversion
              25                                            !    from cloud water to rain
              26                     !> xb110
              27                       REAL(r8) :: zdnoprc  ! deep cloud is thicker than this height (Unit:Pa)
              28                       REAL(r8) :: momtrans ! momentum transport method
              29                     !< xb110
              30                       LOGICAL :: lmfpen    !    true if penetrative convection is switched on
              31                       LOGICAL :: lmfscv    !    true if shallow     convection is switched on
              32                       LOGICAL :: lmfmid    !    true if midlevel    convection is switched on
              33                       LOGICAL :: lmfdd     !    true if cumulus downdraft      is switched on
              34                       LOGICAL :: lmfdudv   !    true if cumulus friction       is switched on
              35                     
              36                     CONTAINS
              37                     
              38                     SUBROUTINE cuparam
              39                     
              40                       ! Description:
              41                       !
              42                       ! Defines disposable parameters for massflux scheme
              43                       !
              44                       ! Method:
              45                       !
              46                       ! This routine is called from *iniphy*
              47                       !
              48                       ! Authors:
              49                       !
              50                       ! M. Tiedtke, ECMWF, February 1989, original source
              51                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              52                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              53                       ! A. Rhodin, MPI, Jan 1999, subroutine cuparam -> module mo_cumulus_flux
              54                       !
              55                       ! for more details see file AUTHORS
              56                       !
              57                     
              58                     ! USE mo_control, ONLY: lamip2
              59                     
              60                       IMPLICIT NONE
              61                     
              62                     
              63                       !  Executable Statements
              64                     
              65                       lmfpen = .TRUE.
              66                       lmfscv = .TRUE.
              67                       lmfmid = .TRUE.
              68                       lmfdd = .TRUE.
              69                       lmfdudv = .TRUE.
              70                     
              71                     !-- 1. Specify parameters for massflux-scheme
              72                     
              73                       entrpen = 1.0E-4 ! Average entrainment rate for penetrative convection
              74                     
              75                     !  entrscv = 1.2E-3 ! Average entrainment rate for shallow convection (tie3)
              76                       entrscv = 3.0E-4 ! Average entrainment rate for shallow convection (Tie7 org)
              77                     !  entrscv = 6.0E-4 ! Average entrainment rate for shallow convection (Tie8)
              78                     
              79                       entrmid = 1.0E-4 ! Average entrainment rate for midlevel convection
              80                     
              81                       entrdd  = 2.0E-4 ! Average entrainment rate for downdrafts
              82                     
              83                       cmfctop = 0.3 ! Relative cloud massflux at level above nonbuoyancy level
              84                     
              85                       cmfcmax = 1.0    ! Maximum massflux value allowed for updrafts etc
              86                     
              87                       cmfcmin = 1.E-10 ! Minimum massflux value (for safety)
              88                     
              89                       cmfdeps = 0.3    ! Fractional massflux for downdrafts at lfs
              90                     
              91                       zdnoprc = 2.0e4  ! deep cloud is thicker than this height (Unit:Pa)     !xb110
              92                     
              93                     !  cprcon  = 6.E-4  ! Coefficients for determining conversion from cloud water   (org)
              94                     !  cprcon  = 1.122E-4  ! Coefficients for determining conversion from cloud water(tie4)
              95                     !  cprcon  = 1.0E-3  ! Coefficients for determining conversion from cloud water (tie5)
              96                        cprcon  = 1.0E-4  ! Coefficients for determining conversion from cloud water(tie7)   !xb110, for Tiedtke (1989)
              97                        cprcon_n  = 1.4e-3  !Coefficients for determining conversion from cloud water (MPAS) !xb110, for new Tiedtke
              98                        momtrans = 2  ! momentum transport method !xb110
              99                     
             100     1                 if(jtrun.eq.320)then
             101     1                   cmfctop = 0.35
             102     1                 endif
             103                     
             104                       ! Next value is relative saturation in downdrafrs
             105                       ! but is no longer used ( formulation implies saturation)
             106                     
             107                       rhcdd = 1.
             108                     
             109                       RETURN
             110                     END SUBROUTINE cuparam
             111                     
             112                     END MODULE mo_cumulus_flux


 External subroutine subprogram "qmaxn3"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine qmaxn3 (fld,t1,t2,i1,j1,k1,im,jm,lm)
               2                     !
               3                     !  subroutine to print max and min in 2-d layer (or a subarray)
               4                     !  within a 3-d field stored with n-s index slowest varying
               5                     !
               6                     !  ***input***
               7                     !
               8                     !  fld: input array
               9                     !  t1,t2: 2* 8 character caption
              10                     !  i1: starting index of first dimension (e-w)
              11                     !  j1: starting index of third dimension (n-s)
              12                     !  k1: starting index of second dimension (vertical)
              13                     !  im: first dimension
              14                     !  jm: third dimension
              15                     !  lm: second dimension
              16                     !
              17                     ! *****************************************************************
              18                     !
              19                           use rank
              20                           use index
              21                           use const, only: RTYPE
              22                     
              23                           implicit   none
              24                           integer    i1,j1,k1,im,jm,lm
              25                           real(kind=RTYPE) fld(im,lm,jm)
              26                     !ch   character*14 t1, t2
              27                           character t1*14, t2*12
              28                     
              29                           real       xmin,xmax
              30                           integer    imin,jmin,imax,jmax,j,i
              31                     !
              32                           xmin= 1.0e25
              33                           xmax= -1.0e25
              34                           imin=1
              35                           jmin=1
              36                           imax=1
              37                           jmax=1
              38                     !
              39     1                     do 10 j=j1,jm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<< Loop-information  End >>>
              40     2  pp    s            do 10 i=i1,im
              41     3   p    s            if (fld(i,k1,j).le.xmin) then
              42     3   p    s            xmin= fld(i,k1,j)
              43     3   p    m            jmin= j
              44     3   p    v            imin= i
              45     3   p    v            endif
              46     3   p    s            if (fld(i,k1,j).gt.xmax) then
              47     3   p    s            xmax= fld(i,k1,j)
              48     3   p    m            jmax= j
              49     3   p    v            imax= i
              50     3   p    m            endif
              51     1   p    s         10 continue
              52                     !
              53                           if(myrank .eq. 0) print 9000, t1, t2
              54                           if(myrank .eq. 0) print 8995, imax,jmax,xmax,imin,jmin,xmin
              55                     !
              56                     !ch 9000 format (2a14)
              57                      9000 format (a14,a12)
              58                      8995 format(' imax=',i4,' jmax=',i4,' xlarg=',g20.12  &
              59                           ,' imin=',i4,' jmin=',i4,' xsmal=',g20.12)
              60                     !
              61                           return
              62                           end


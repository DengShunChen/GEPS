 External subroutine subprogram "vstruc_hybrid_cwb"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine vstruc_hybrid_cwb (nxj,nx,lev,cp,radsq,sigma,dsigma   &
               2                                       ,pt,tt,qt,pk,pk2,spal,phi,ncld)
               3                     !
               4                     !  subroutine to compute several intermediate pressure dependent
               5                     !  variables and parameters
               6                     !
               7                     ! *** input ****
               8                     !
               9                     !  nx: e-w dimension no.
              10                     !  lev: number of vertical levels
              11                     !  pk: odd (full) level p**capa
              12                     !  pk2: even( half) level p**capa
              13                     !  cp: specific heat of air
              14                     !  radsq: (rad of earth)**2
              15                     !  dsig: sigma layer thicknesses
              16                     !  sig: sigma levels
              17                     !  pt: terrain pressure
              18                     !  tt: virtual potential temperature
              19                     !  qt: specific humidity
              20                     !
              21                     ! *** output ***
              22                     !
              23                     !  phi: geopotential
              24                     !  spal: energy conversion term (sigma*ps*alpha)
              25                     !  odpsig: reciprical of layer mass
              26                     !
              27                     ! **************************************************
              28                     !
              29                           use const, only : RTYPE
              30                     !
              31                           implicit  none
              32                     
              33                           integer   nxj,nx,lev,ncld
              34                     
              35                           real(kind=RTYPE) tt(nx,lev),qt(nx,lev*ncld),phi(nx,lev),pt(nx)   &
              36                           , odpsig(nx,lev),spal(nx,lev),that(nx,lev),dsigma(lev,2)         &
              37                           , sigma(lev+1,2),pk(nx,lev),pk2(nx,lev)
              38                     
              39                           real      cpr2,cp,radsq
              40                           integer   i,n,nk,k,kk
              41                     !
              42                     !  compute time dependent pressure variables
              43                     !
              44                           cpr2= cp/radsq
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.58, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk2, pk, pt, spal, odpsig
                                   <<< Loop-information  End >>>
              45     1  pp    v            do 115 i=1,nxj
              46     1   p    v            odpsig(i,1)= 1.0/(dsigma(1,2)+dsigma(1,1)*pt(i))
              47     1   p    v            spal(i,1)= cpr2*tt(i,1)*sigma(2,1)*(pk2(i,1)-pk(i,1))*odpsig(i,1)
              48     1               !      odpsig(i,1)= 1.0/(dsig(1)*pt(i))
              49     1               !      spal(i,1)= cpr2*tt(i,1)*sig(2)*(pk2(i,1)-pk(i,1))*odpsig(i,1)
              50     1   p    v        115 continue
              51                     !
              52                     !
              53                     !  half-level specific humidity, interpolate in p**capa
              54                     !
              55                     !      do n=1,ncld
              56                     !      nk=(n-1)*lev
              57                     !      do k=1,lev-1
              58                     !      kk=nk+k
              59                     !      do i=1,nxj
              60                     !      qhat(i,kk+1)= qt(i,kk+1)+(qt(i,kk)-qt(i,kk+1))     &
              61                     !       *(pk(i,k+1)-pk2(i,k))/(pk(i,k+1)-pk(i,k))
              62                     !      enddo
              63                     !      enddo
              64                     !      enddo
              65                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, pt, pk2, odpsig, that, phi, spal
                                   <<< Loop-information  End >>>
              66     1  pp                 do 160 k=1,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.02, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pt, tt, pk, phi, that, spal, odpsig
                                   <<< Loop-information  End >>>
              67     2   p    v            do 160 i=1,nxj
              68     2               !
              69     2               !  recipricol of layer pressure depth
              70     2               !
              71     2   p    v            odpsig(i,k+1)= 1.0/(dsigma(k+1,2)+dsigma(k+1,1)*pt(i))
              72     2               !      odpsig(i,k+1)= 1.0/(dsig(k+1)*pt(i))
              73     2               !
              74     2               !  half-level specific humidity, interpolate in p**capa
              75     2               !
              76     2               !x    qhat(i,k+1)= qt(i,k+1)+(qt(i,k)-qt(i,k+1))
              77     2               !x   * *(pk(i,k+1)-pk2(i,k))/(pk(i,k+1)-pk(i,k))
              78     2               !
              79     2               !  half level potential temperature, defined as weighted combination
              80     2               !  of full level thicknesses, not an interpolation
              81     2               !
              82     2   p    v            that(i,k)= tt(i,k)-(tt(i,k)-tt(i,k+1))   &
              83     2                      *(pk(i,k+1)-pk2(i,k))/(pk(i,k+1)-pk(i,k))
              84     2               !
              85     2               !  geopotential thicknesses
              86     2               !
              87     2   p    v            phi(i,k)= that(i,k)*(pk(i,k+1)-pk(i,k))
              88     2               !
              89     2               !  energy conversion term for terrain pressure contribution to
              90     2               !  horizontal pressure gradient
              91     2               !
              92     2   p    v            spal(i,k+1)= cpr2*tt(i,k+1)*(sigma(k+1,1)*(pk(i,k+1)-pk2(i,k)) &
              93     2                      +sigma(k+2,1)*(pk2(i,k+1)-pk(i,k+1)))*odpsig(i,k+1)
              94     2               !      spal(i,k+1)= cpr2*tt(i,k+1)*(sig(k+1)*(pk(i,k+1)-pk2(i,k))
              95     2               !     * +sig(k+2)*(pk2(i,k+1)-pk(i,k+1)))*odpsig(i,k+1)
              96     2               !
              97     1   p    v        160 continue
              98                     !
              99                     !  hydrostatic equation: note that terrain geopotential is excluded.
             100                     !  it it constant forcing term that is included when laplacian of
             101                     !  geopotential is computed in divergence equation.
             102                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 112, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk2, pk, phi
                                   <<< Loop-information  End >>>
             103     1  pp   2v            do 100 i=1,nxj
             104     1   p   2v            phi(i,lev)= cp*tt(i,lev)*(pk2(i,lev)-pk(i,lev))
             105     1   p   2v        100 continue
             106                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phi
                                   <<< Loop-information  End >>>
             107     1                     do 105 k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.60, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 8  FILL 19
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             108     2  pp   2v            do 105 i=1,nxj
             109     2   p   2v            phi(i,k)= phi(i,k+1)+cp*phi(i,k)
             110     1   p   2v        105 continue
             111                     !
             112                           return
             113                           end


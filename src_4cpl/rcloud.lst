 External subroutine subprogram "rcloud"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine rcloud ( nxj,im,lm,ls,ptop,ptopc,pst,pp,tt,rh,cufrac,plcl     &
               2                                             , cumtop,clds,cvclds,rhx,sdpbl,ncld,qtr                &
               3                                             , clwc,ciwc,cre,cde,cldmaxv )
               4                     !######################################################################c
               5                     ! a. function:                                                         c
               6                     !    (1)compute cloud fraction and cloud optical properties
               7                     !    (2)stable cloud fraction is diagnosed by input temperature,
               8                     !    specific humidity, and cloud water content, but convective cloud
               9                     !    fraction by convective precip, lcl, and cloud heights.
              10                     !
              11                     ! b. common block specification:                                       c
              12                     !    none                                                              c
              13                     !                                                                      c
              14                     ! c. parameter specification:                                          c
              15                     !    none                                                              c
              16                     !                                                                      c
              17                     ! d. input/output variables:                                           c
              18                     !   (1) input variables:                                               c
              19                     !     im    : model total number of horizontal grids                   c
              20                     !     lm    : model total number of vertical layers                    c
              21                     !     ls    : number of layers at model top where no clouds allowed    c
              22                     !     ptop  : pressure at top of model                                 c
              23                     !     pst    : (terrain pressure -ptop)                                c
              24                     !     pp    : model level pressures                                    c
              25                     !     tt    : model level temperatures                                 c
              26                     !     rh    : model level relative humidity                            c
              27                     !     cufrac: convective cloud fractions                               c
              28                     !     plcl  : pressure of lifting condensation level (lcl)             c
              29                     !     cumtop: pressure at top of deepest convective clouds             c
              30                     !     sdpbl : vertical velocity (omega) at the near 800hPa level
              31                     !                  to indicate the convergence in the pbl
              32                     !     rhx   : work array (reference rh for full grid stable clouds     c
              33                     !     qtr   : cloud water content
              34                     !                                                                      c
              35                     !   (2) output variables:                                              c
              36                     !     clds  : stable cloud fractions                                   c
              37                     !     cvclds: convective cloud fractions                               c
              38                     !     clwc/ciwc : cloud liquid/ice water content for radiation use(g/m3)
              39                     !     cre/cde   : cloud optical effective size (um)
              40                     !                                                                      c
              41                     !   first version : march, 2007
              42                     !                                                                      c
              43                     !   auther:                                                           c
              44                     !    c. t. fong
              45                     !    modif to f90 by C-H Lee and sort by River Chen in 2015
              46                     !                                                                      c
              47                     !######################################################################c
              48                     !
              49                           use const, only: RTYPE
              50                     !
              51                           implicit  none
              52                     
              53                           integer   nxj,im,lm,ls,ncld
              54                           real      ptop,ptopc
              55                     
              56                           real      pst(im),pp(im,lm),rh(im,lm),cufrac(im),                  &
              57                                     plcl(im),cumtop(im),clds(im,lm),cvclds(im,lm),rhx(im,lm),&
              58                                     qtr(im,lm),                                              &
              59                                     clwc(im,lm),ciwc(im,lm),cre(im,lm),cde(im,lm)
              60                           real(kind=RTYPE) sdpbl(im),tt(im,lm)
              61                     !
              62                           real      rhc(im,lm)
              63                           real      okk,cre_min,cre_max
              64                           integer   kk
              65                     !
              66                           real      qlwc(9),qlwcv(9),qiwc(15),qiwcv(15),deg(8)
              67                     
              68                           integer i,ls1,ls2,lmm1,k,nn,nwc,nic
              69                           real    cc1,cc2,sq3,cldmaxv,p850,anvil,pps,rrs,cld,fff,tem1,tem2,rgas,t273
              70                           real    t253,qtrc,fcld,ratio,aln10,ttc,cvf,cvf1,xxx,rlwcv,riwcv,rrr,ctt,rlwc,riwc
              71                     
              72                     !
              73                     !  create diagnostic formulation of liquid water content as functions
              74                     !  of temperature based on the moist thermodynamic relationship proposed
              75                     !  by betts and harshvardhan (1987), where assumes lwc proportional to
              76                     !  the change of saturation mixing ratio by lifting saturated air at
              77                     !  ambient temperature vertically through a small distance(dz) along the
              78                     !  moist adiabat.
              79                     !     dz = 120(meter) for stratus water clouds
              80                     !        = 180(meter) for convective  water clouds
              81                     !        = 120(meter) for stratus ice clouds
              82                     !        = 180 + 8./70. * (273.-tc)**2 for convective ice clouds
              83                     !     tc : cloud's temperature
              84                     !  ** the temperature range for the following data set (all with
              85                     !     a temperature interval equal to 5 K)
              86                     !     qlwc(liquid water content) : 20C to -20C
              87                     !     qiwc(ice water content, stratus) : 0C to -70C
              88                     !     qiwcv(ice water content, convective) : 0C to -70C
              89                     !
              90                           data qlwc /-0.6067,-0.6789,-0.7592,-0.8416,-0.9317,-1.0296,-1.1374       &
              91                                    , -1.2552,-1.3836/
              92                           data qlwcv /-0.6067,-0.6789,-0.7592,-0.8416,-0.9317,-1.0296,-1.1374      &
              93                                    , -1.2552,-1.3836/
              94                     !cc   data qlwcv/-0.4333,-0.5053,-0.5860,-0.6702,-0.7597,-0.8580,-0.9668
              95                     !cc  1         , -1.0853,-1.2153/
              96                           data qiwc /-0.9493,-1.0322,-1.1509,-1.2824,-1.4274,-1.5934,-1.7698       &
              97                                    , -1.9591,-2.1711,-2.3855,-2.6158,-2.8539,-3.1231,-3.3834       &
              98                                    , -3.6670/
              99                           data qiwcv /-0.9493,-1.0322,-1.1509,-1.2824,-1.4274,-1.5934,-1.7698      &
             100                                    , -1.9591,-2.1711,-2.3855,-2.6158,-2.8539,-3.1231,-3.3834       &
             101                                    , -3.6670/
             102                     !cc   data qiwcv/-0.7753,-0.8535,-0.9542,-1.0579,-1.1685,-1.2918,-1.4262
             103                     !cc  1         , -1.5714,-1.7344,-1.9080,-2.1012,-2.3038,-2.5388,-2.7737
             104                     !cc  2         , -3.0379/
             105                     !
             106                     !      data deg/ 72.4, 57.6, 82.7, 55.2, 28.8, 27.9, 21.0, 36.4 /
             107                           data deg/ 72.4, 57.6, 82.7, 55.2, 38.8, 32.9, 26.0, 42.4 /   !a4
             108                     !      data deg/ 72.4, 57.6, 82.7, 55.2, 38.8, 32.9, 29.7, 49.1 /   !a5
             109                     !
             110                     !cc   data anvil/0.2/
             111                           data anvil/0.25/
             112                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 10, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clds, rhc
                                   <<< Loop-information  End >>>
             113     1  pp   2             do k = 1, lm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             114     2   p   2             do i = 1, im
             115     2   p   2              rhc(i,k)=clds(i,k)
             116     2   p   2              clds(i,k) = 0.
             117     2   p   2             enddo
             118     1   p   2             enddo
             119                     !
             120                           cc1= 0.25
             121                           cc2= 1.0 -2.0*cc1
             122                     !
             123                     !  compute vertically filtered relative humidity and store in array rh
             124                     !
             125                     !  use rhx and cvclds as work space
             126                     !
             127                           ls1= ls+1
             128                           ls2= ls+2
             129                           lmm1 = lm-1
             130                     !xx      do 100 k=ls2,lmm1
             131                     !xx      do 100 i=1,im
             132                     !xx      cvclds(i,k)= cc1*(rh(i,k-1)+rh(i,k+1))
             133                     !xx  100 continue
             134                     !
             135                     !fong
             136                     !     do 110 k=ls2,lmm1
             137                     !     do 110 i=1,im
             138                     !     cvclds(i,k)= cc1*(rh(i,k-1)+rh(i,k+1))
             139                     !     rhx(i,k)= cc2*rh(i,k)+cvclds(i,k)
             140                     ! 110 continue
             141                     !     do 120 i=1,im
             142                     !     rhx(i,ls1)= rh(i,ls1)
             143                     !xx      rhx(i,lm)= rh(i,lm)
             144                     !     rhx(i,lm)= (rh(i,lm)+rh(i,lmm1))*0.5
             145                     ! 120 continue
             146                     !fong
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rh, rhx
                                   <<< Loop-information  End >>>
             147     1  pp                 do k = 1, lm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 14, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rh, rhx
                                   <<< Loop-information  End >>>
             148     2   p   2             do i = 1, nxj
             149     2   p   2              rhx(i,k) = min(0.999, max(0.,rh(i,k)))
             150     2   p   2             enddo
             151     1   p                 enddo
             152                     !fong
             153                     !
             154                     !  stable cloud fractions
             155                     !
             156                           sq3= sqrt(3.0)
             157                     
             158                     !
             159     1                     if( ncld .eq. 1 )then
             160     1               
             161     1               !      cldmaxv = 0.6   ! max one-layer cloudiness
             162     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             163     2  pp                 do 130 k = ls1, lm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pst, pp, rhx
                                   <<< Loop-information  End >>>
             164     3   p                 do 130 i = 1, nxj
             165     3   p                 pps = pp(i,k) / (pst(i)+ptop)
             166     3   p                 rrs = 1.0 + 2.0*(pps**2 -pps) + sq3*pps*(1.0 -3.0*pps+2.0*pps**2)
             167     3   p                 rrs = max( 0.7, min (rrs, 0.9995) )
             168     3   p                 cld = (rhx(i,k)-rrs)/(1.0-rrs)
             169     3   p                 cld = min (1.0, max(0.0, cld))
             170     4   p                 if( pp(i,k) .gt. ptopc ) then
             171     4               !cc   clds(i,k)= cld*cld
             172     4   p                 clds(i,k)= min(cldmaxv,cld*cld)
             173     4   p                 end if
             174     2   p             130 continue
             175     1               !
             176     1               !  reduce low cloudiness at ocean grids without significant upward
             177     1               !  motion
             178     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
             179     2  pp                 do 135 k = lm/2, lmm1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp
                                   <<< Loop-information  End >>>
             180     3   p   2             do 135 i = 1, nxj
             181     3               !lim
             182     4   p   2             if(pp(i,k) .gt. 850. .and. sdpbl(i) .gt. -0.000001 ) then
             183     4   p   2               clds(i,k) = clds(i,k) * 0.10
             184     4   p   2             end if
             185     3               !lim
             186     2   p   2         135 continue
             187     1               
             188     1                     else     ! (ncld.eq.2)
             189     1               
             190     1               !      cldmaxv = 0.6   ! max one-layer cloudiness
             191     1               !      cldmaxv = 0. 85  ! max one-layer cloudiness
             192     1                     p850 = 850.
             193     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             194     2  pp                 do 131 k = ls1, lm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qtr, rhx, rhc, pp
                                   <<< Loop-information  End >>>
             195     3   p                 do 131 i = 1, nxj
             196     3               ! Xu and Randall (1996)
             197     3   p                   fff=-100.*qtr(i,k)/(((1.-rhx(i,k))*rhc(i,k))**0.49)
             198     3   p                   cld=rhx(i,k)**0.25*(1.-exp(fff))
             199     3               ! original (fu and Liou)
             200     3               !         fff = 1000.*qtr(i,k)/(1.-rhx(i,k))
             201     3               !         cld = rhx(i,k)*(1.-exp(-fff))
             202     3               !
             203     3   p                 if(cld .lt. 0.05) cld=0.    ! avoid too small cloudiness
             204     4   p                 if( pp(i,k) .gt. ptopc ) then
             205     4               !       if(rhx(i,k) .gt. 0.5 .and. qtr(i,k).gt.10e-6)   &
             206     4   p                    clds(i,k)= min(cldmaxv,max(0.,cld))
             207     4   p                 end if
             208     3               !  limit cloudiness at lowest two layers
             209     4   p                 if( (pp(i,k).gt.p850) .and. (k.ge.lm-1) )then
             210     4   p                    clds(i,k) = min (0.2, clds(i,k))
             211     4   p                 endif
             212     2   p             131 continue
             213     1               
             214     1                     endif
             215                     
             216                     !
             217                     !  convective cloud fractions, function of convective precip, lifting
             218                     !  condensation level, level of vanishing cloud buoynacy, and ice cloud
             219                     !  enhancment at low temperatures.  stored in array cvclds.
             220                     !
             221                           tem1= 0.1
             222                           tem2= 0.8
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cufrac
                                   <<< Loop-information  End >>>
             223     1  pp   2             do 140 i = 1, nxj
             224     1   p   2             if ( cufrac(i) .lt. tem1 )  cufrac(i) = 0.0
             225     1   p   2             if ( cufrac(i) .gt. tem2 )  cufrac(i) = tem2 + 0.01
             226     1   p   2        140  continue
             227                     !
             228                     !     do i = 1, im*lm
             229                     !      cvclds(i,1) = 0.
             230                     !     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cvclds
                                   <<< Loop-information  End >>>
             231        pp   4              cvclds = 0.
             232                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             233     1  pp                 do i=1,nxj
             234     1   p                   kk=0
             235     2   p                   do k=lmm1,ls,-1
             236     3   p                     if ( (pp(i,k).le.plcl(i)) .and. (pp(i,k).ge.cumtop(i)) ) then
             237     4   p                       if(cufrac(i).gt.0.3 .and. pp(i,k).le.400.)then
             238     4   p                         kk=kk+1
             239     4   p                         okk=1.-0.225*(kk-1)
             240     4   p                         cvclds(i,k) = cufrac(i)**okk
             241     4   p                       else
             242     4   p                         cvclds(i,k) = cufrac(i)
             243     4   p                       endif
             244     3   p                       cvclds(i,k) = min(tem2,cvclds(i,k))
             245     3   p                     endif
             246     2   p                   enddo
             247     1   p                 enddo
             248                     !
             249                     !      do 150 i=1,nxj
             250                     !      if ( (pp(i,k).le.plcl(i)) .and. (pp(i,k).ge.cumtop(i)) )  &
             251                     !            cvclds(i,k) = cufrac(i)
             252                     !      if ( (cvclds(i,k).gt.0.0) .and. (tt(i,k).lt.233.0) )      &
             253                     !!ccc *      cvclds(i,k) = cvclds(i,k) + anvil
             254                     !            cvclds(i,k) = cvclds(i,k) + cvclds(i,k)*anvil
             255                     !  150 continue
             256                     !
             257                     !----
             258                     !
             259                     !  compute cloud microphysical parameters
             260                     !
             261                           rgas= 287.
             262                           t273 = 273.16
             263                           t253 = 253.16
             264                     !
             265                     !--ncld=2 begin
             266     1                     if( ncld .ge. 2 ) then
             267     1               !
             268     1               !  clwc/ciwc for stable cloud
             269     1               !  clwc/ciwc are nomalized by cloudiness to take account of real water
             270     1               !  content in clouds since qtr stands for grid average
             271     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             272     2  pp                 do k = 1, lm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clds
                                   <<< Loop-information  End >>>
             273     3   p                 do i = 1, nxj
             274     4   p                  if( clds(i,k) .gt. 0.01 )then
             275     4   p                  qtrc = qtr(i,k)*1000.*( 100.*pp(i,k)/(rgas*tt(i,k)) )
             276     4               ! test
             277     4               !      fcld = max(0.1, clds(i,k))
             278     4   p                  fcld = 1.
             279     4   p                  qtrc = qtrc / fcld
             280     5   p                    if( tt(i,k) .ge. t273 )then
             281     5   p                     clwc(i,k) = qtrc

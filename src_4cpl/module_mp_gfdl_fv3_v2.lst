            2608                     ! rain evaporation
            2609                     ! =======================================================================
            2610                     
            2611                     subroutine revap_rac1 (hydrostatic, is, ie, dt, tz, qv, ql, qr, qi, qs, qg, den, hvar)
            2612                     
            2613                         implicit none
            2614                     
            2615                         logical, intent (in) :: hydrostatic
            2616                     
            2617                         integer, intent (in) :: is, ie
            2618                     
            2619                         real, intent (in) :: dt ! time step (s)
            2620                     
            2621                         real, intent (in), dimension (is:ie) :: den, hvar, qi, qs, qg
            2622                     
            2623                         real, intent (inout), dimension (is:ie) :: tz, qv, qr, ql
            2624                     
            2625                         real, dimension (is:ie) :: lcp2, denfac, q_liq, q_sol, cvm, lhl
            2626                     
            2627                         real :: dqv, qsat, dqsdt, evap, qden, q_plus, q_minus, sink
            2628                         real :: tin, t2, qpz, dq, dqh
            2629                     
            2630                         integer :: i
            2631                     
            2632                         ! -----------------------------------------------------------------------
            2633                         ! define latend heat coefficient
            2634                         ! -----------------------------------------------------------------------
            2635                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, qg, tz, qs, q_sol, cvm, q_liq
                                   <<<      qi, qr, lcp2, lhl
                                   <<< Loop-information  End >>>
            2636     1  pp    v          do i = is, ie
            2637     1   p    v              lhl (i) = lv00 + d0_vap * tz (i)
            2638     1   p    v              q_liq (i) = ql (i) + qr (i)
            2639     1   p    v              q_sol (i) = qi (i) + qs (i) + qg (i)
            2640     1   p    v              cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2641     1   p    v              lcp2 (i) = lhl (i) / cvm (i)
            2642     1                       ! denfac (i) = sqrt (sfcrho / den (i))
            2643     1   p    v          enddo
            2644                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 5
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2645     1                   do i = is, ie
            2646     2                       if (qr (i) > qrmin .and. tz (i) > t_wfr) then
            2647     2                           qpz = qv (i) + ql (i)
            2648     2                           tin = tz (i) - lcp2 (i) * ql (i) ! presence of clouds suppresses the rain evap
            2649     2    i                      qsat = wqs2 (tin, den (i), dqsdt)
            2650     2                           dqh = max (ql (i), hvar (i) * max (qpz, qcmin))
            2651     2                           dqv = qsat - qv (i)
            2652     2                           q_minus = qpz - dqh
            2653     2                           q_plus = qpz + dqh
            2654     2               
            2655     2                           ! -----------------------------------------------------------------------
            2656     2                           ! qsat must be > q_minus to activate evaporation
            2657     2                           ! qsat must be < q_plus to activate accretion
            2658     2                           ! -----------------------------------------------------------------------
            2659     2               
            2660     2                           ! -----------------------------------------------------------------------
            2661     2                           ! rain evaporation
            2662     2                           ! -----------------------------------------------------------------------
            2663     2               
            2664     3                           if (dqv > qvmin .and. qsat > q_minus) then
            2665     4                               if (qsat > q_plus) then
            2666     4                                   dq = qsat - qpz
            2667     4                               else
            2668     4                                   ! q_minus < qsat < q_plus
            2669     4                                   ! dq == dqh if qsat == q_minus
            2670     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            2671     4                               endif
            2672     3                               qden = qr (i) * den (i)
            2673     3                               t2 = tin * tin
            2674     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * exp (0.725 * log (qden))) &
            2675     3                                    / (crevp (4) * t2 + crevp (5) * qsat * den (i))
            2676     3                               evap = min (qr (i), dt * evap, dqv / (1. + lcp2 (i) * dqsdt))
            2677     3                               qr (i) = qr (i) - evap
            2678     3                               qv (i) = qv (i) + evap
            2679     3                               q_liq (i) = q_liq (i) - evap
            2680     3                               cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2681     3                               tz (i) = tz (i) - evap * lhl (i) / cvm (i)
            2682     3                           endif
            2683     2               
            2684     2                           ! -----------------------------------------------------------------------
            2685     2                           ! accretion: pracc
            2686     2                           ! -----------------------------------------------------------------------
            2687     2               
            2688     3                           if (qr (i) > qrmin .and. ql (i) > 1.e-8 .and. qsat < q_plus) then
            2689     3                               denfac (i) = sqrt (sfcrho / den (i))
            2690     3                               sink = dt * denfac (i) * cracw * exp (0.95 * log (qr (i) * den (i)))
            2691     3                               sink = sink / (1. + sink) * ql (i)
            2692     3                               ql (i) = ql (i) - sink
            2693     3                               qr (i) = qr (i) + sink
            2694     3                           endif
            2695     2                       endif
            2696     1                   enddo
            2697                     
            2698                     end subroutine revap_rac1
            2699                     
            2700                     ! =======================================================================
            2701                     ! compute terminal fall speed

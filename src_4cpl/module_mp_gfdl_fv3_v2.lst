            2558     5                                   if (qstar < qpz) then
            2559     5                                       qa (k) = 1.
            2560     5                                   else
            2561     5                                       qa (k) = 0.
            2562     5                                   endif
            2563     4                               elseif (icloud_f .eq. 3) then
            2564     5                                   if (qstar < qpz) then
            2565     5                                       qa (k) = 1.
            2566     5                                   else
            2567     6                                       if (qstar < q_plus) then
            2568     6                                           qa (k) = (q_plus - qstar) / (dq * f_dq_p)
            2569     6                                       else
            2570     6                                           qa (k) = 0.
            2571     6                                       endif
            2572     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2573     6                                       if (q_cond (k) > qcldmin) then
            2574     6                                           qa (k) = max (cld_min, qa (k))
            2575     6                                       endif
            2576     5                                       qa (k) = min (1., qa (k))
            2577     5                                   endif
            2578     4                               else
            2579     5                                   if (qstar < q_minus) then
            2580     5                                       qa (k) = 1.
            2581     5                                   else
            2582     6                                       if (qstar < q_plus) then
            2583     7                                           if (icloud_f .eq. 0) then
            2584     7                                               qa (k) = (q_plus - qstar) / (dq * f_dq_p + dq * f_dq_m)
            2585     7                                           else
            2586     7                                               qa (k) = (q_plus - qstar) / ((dq * f_dq_p + dq * f_dq_m) * (1. - q_cond (k)))
            2587     7                                           endif
            2588     6                                       else
            2589     6                                           qa (k) = 0.
            2590     6                                       endif
            2591     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2592     6                                       if (q_cond (k) > qcldmin) then
            2593     6                                           qa (k) = max (cld_min, qa (k))
            2594     6                                       endif
            2595     5                                       qa (k) = min (1., qa (k))
            2596     5                                   endif
            2597     4                               endif
            2598     3                           else
            2599     3                               qa (k) = 0.
            2600     3                           endif
            2601     2                       endif
            2602     1               
            2603     1                   enddo
            2604                     
            2605                     end subroutine subgrid_z_proc

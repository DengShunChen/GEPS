             292                         logical :: const_vs = .false. ! if .t. the constants are specified by v * _fac
             293                         logical :: const_vg = .false. ! if .t. the constants are specified by v * _fac
             294                         logical :: const_vr = .false. ! if .t. the constants are specified by v * _fac
             295                     
             296                     !    real :: vi_fac = 1. ! ifs: if const_vi: 1 / 3
             297                         real :: vi_fac = 0.9 ! CWB FV3
             298                         real :: vs_fac = 1. ! ifs: if const_vs: 1.
             299                         real :: vg_fac = 1. ! ifs: if const_vg: 2.
             300                         real :: vr_fac = 1. ! ifs: if const_vr: 4.
             301                     
             302                         real :: vi_max = 0.5 ! max fall speed for ice
             303                         real :: vs_max = 5.0 ! max fall speed for snow
             304                         real :: vg_max = 8.0 ! max fall speed for graupel
             305                         real :: vr_max = 12. ! max fall speed for rain
             306                     
             307                         real :: xr_a = 0.25 ! p value in xu and randall, 1996
             308                         real :: xr_b = 100. ! alpha_0 value in xu and randall, 1996
             309                         real :: xr_c = 0.49 ! gamma value in xu and randall, 1996
             310                     
             311                         real :: te_err = 1.e-14 ! 64bit: 1.e-14, 32bit: 1.e-7
             312                     
             313                         logical :: do_sat_adj = .false. ! has fast saturation adjustments
             314                         logical :: z_slope_liq = .true. ! use linear mono slope for autocconversions
             315                         logical :: z_slope_ice = .false. ! use linear mono slope for autocconversions
             316                         logical :: use_ccn = .false. ! must be true when prog_ccn is false
             317                         logical :: use_ppm = .false. ! use ppm fall scheme
             318                         logical :: use_ppm_ice = .false. ! use ppm fall scheme for cloud ice
             319                     !    logical :: use_semi = .true. ! use Semi-Lagrangian sedimentation
             320                     !    logical :: use_semi_ice = .false. ! use Semi-Lagrangian sedimentation for cloud ice
             321                         logical :: mono_prof = .true. ! perform terminal fall with mono ppm scheme
             322                         logical :: do_hail = .false. ! use hail parameters instead of graupel
             323                         logical :: hd_icefall = .false. ! use heymsfield and donner, 1990's fall speed of cloud ice
             324                         logical :: gce_icefall = .false. ! use Goddard's fall speed of cloud ice
             325                         logical :: use_xr_cloud = .false. ! use xu and randall, 1996's cloud diagnosis
             326                         logical :: use_park_cloud = .false. ! park et al. 2016
             327                         logical :: use_gi_cloud = .false. ! gultepe and isaac (2007, grl)
             328                         logical :: use_rhc_cevap = .false. ! cap of rh for cloud water evaporation
             329                         logical :: use_rhc_revap = .false. ! cap of rh for rain evaporation
             330                         logical :: consv_checker = .false. ! turn on energy and water conservation checker
             331                         logical :: do_warm_rain_mp = .false. ! do warm rain cloud microphysics only
             332                         ! turn off to save time, turn on only in c48 64bit
             333                     
             334                         real :: g2, log_10
             335                     
             336                         real :: rh_thres = 0.75
             337                         real :: rhc_cevap = 0.85 ! cloud water
             338                         real :: rhc_revap = 0.85 ! rain
             339                     
             340                         real :: f_dq_p = 1.0
             341                         real :: f_dq_m = 1.0
             342                         logical :: do_cld_adj = .false.
             343                     
             344                         integer :: inflag = 1 ! ice nucleation scheme
             345                         ! 1: hong et al., 2004
             346                         ! 2: meyers et al., 1992
             347                         ! 3: meyers et al., 1992
             348                         ! 4: cooper, 1986
             349                         ! 5: flecther, 1962
             350                     
             351                         integer :: rewflag = 1
             352                         ! 1: martin et al., 1994
             353                         ! 2: martin et al., 1994, gfdl revision
             354                         ! 3: kiehl et al., 1994
             355                     
             356                         integer :: reiflag = 5
             357                         ! 1: heymsfield and mcfarquhar, 1996
             358                         ! 2: donner et al., 1997
             359                         ! 3: fu, 2007
             360                         ! 4: kristjansson et al., 2000
             361                         ! 5: wyser, 1998
             362                         ! 6: Heymsfield et al.,2014  !not finished (by xb141)
             363                     
             364                         integer :: ccnflag = 1
             365                         ! 1: default in GFDL MP v2
             366                         ! 2: same as use_ccn=f in GFDL MP v1, ccn=ccn0/den
             367                         ! 3: same as use_ccn=t in GFDL MP v1, ccn=ccn0/densfc
             368                         ! -----------------------------------------------------------------------
             369                         ! namelist
             370                         ! -----------------------------------------------------------------------
             371                     
             372                         namelist / gfdl_mp_nml / &
             373                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             374                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             375                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             376                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             377                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             378                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             379                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             380                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             381                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             382                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             383                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             384                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             385                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &
             386                             rh_thres, f_dq_p, f_dq_m, do_cld_adj
             387                     
             388                         public &
             389                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             390                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             391                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             392                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             393                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             394                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             395                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             396                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             397                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             398                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             399                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             400                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             401                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &
             402                             rh_thres, f_dq_p, f_dq_m, do_cld_adj, liq_ice_combine, snow_grauple_combine, &
             403                             rewflag, reiflag, ccnflag
             404                     
             405                     contains
             406                     
             407                     ! -----------------------------------------------------------------------
             408                     ! the driver of the gfdl cloud microphysics
             409                     ! -----------------------------------------------------------------------
             410                     
             411                     subroutine gfdl_cld_mp_driver                                              &
             412                                 ( qv, ql, qr, qi, qs, qg, qa, qnl, qni,                        &
             413                                   pt, w, ua, va, dz, delp, gsize, dts, hs,                     &
             414                                   land,                                                        &
             415                                   rain, snow, ice, graupel, hydrostatic,                       &
             416                                   is, ie, ks, ke, q_con, cappa, consv_te, te,                  &
             417                     #ifdef EXT_DIAG
             418                                   prefluxr, prefluxi, prefluxs, prefluxg,                      &
             419                                   condensation, deposition, evaporation, sublimation,          &
             420                     #endif
             421                                   rhc, last_step, do_inline_mp )
             422                     
             423                         implicit none
             424                     
             425                         logical, intent (in) :: hydrostatic
             426                         logical, intent (in) :: last_step
             427                         logical, intent (in) :: consv_te
             428                         logical, intent (in) :: do_inline_mp
             429                     
             430                         integer, intent (in) :: is, ie ! physics window
             431                         integer, intent (in) :: ks, ke ! vertical dimension
             432                     
             433                         real, intent (in) :: dts ! physics time step
             434                     
             435                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             436                     
             437                         real, intent (in), dimension (is:ie) :: hs, gsize, land
             438                     
             439                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             440                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             441                     
             442                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             443                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             444                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             445                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             446                         real, intent (inout), dimension (is:ie, ks:ke) :: te
             447                     #ifdef EXT_DIAG
             448                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             449                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             450                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             451                     #endif
             452                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             453                         ! logical :: used
             454                     !    real, dimension (is:ie) :: w_var
             455                     !    real, dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             456                         real, dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             457                     #ifndef EXT_DIAG
             458                         real, dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             459                         real, dimension (is:ie) :: condensation, deposition
             460                         real, dimension (is:ie) :: evaporation, sublimation
             461                     #endif
             462                     
             463     1                   if (last_step) then
             464     1                       p_min = p0_min ! final clean - up
             465     1                   else
             466     1                       p_min = 30.e2 ! time saving trick
             467     1                   endif
             468                     
             469                         ! -----------------------------------------------------------------------
             470                         ! define heat capacity of dry air and water vapor based on hydrostatical property
             471                         ! -----------------------------------------------------------------------
             472                     
             473     1                   if (hydrostatic) then
             474     1                       c_air = cp_air
             475     1                       c_vap = cp_vap
             476     1                       do_sedi_w = .false.
             477     1                   else
             478     1                       c_air = cv_air
             479     1                       c_vap = cv_vap
             480     1                   endif
             481                         d0_vap = c_vap - c_liq
             482                     
             483                         ! scaled constants (to reduce fp errors for 32 - bit) :
             484                         d1_vap = d0_vap / c_air
             485                         d1_ice = dc_ice / c_air
             486                     
             487                         ! lv0 = hlv0 - (c_vap - c_liq) * t_ice! 3.13905782e6, evaporation latent heat coefficient at 0 deg k
             488                         lv00 = (hlv0 - d0_vap * t_ice) / c_air
             489                         li00 = (hlf0 - dc_ice * t_ice) / c_air
             490                         li20 = lv00 + li00
             491                     
             492                         c1_vap = c_vap / c_air
             493                         c1_liq = c_liq / c_air
             494                         c1_ice = c_ice / c_air
             495                     
             496                         ! -----------------------------------------------------------------------
             497                         ! define latent heat coefficient used in wet bulb and bigg mechanism
             498                         ! -----------------------------------------------------------------------
             499                     
             500                         lat2 = (hlv + hlf) ** 2
             501                     
             502                         lcp = hlv / cp_air
             503                         icp = hlf / cp_air
             504                         tcp = (hlv + hlf) / cp_air
             505                     
             506                         ! tendency zero out for am moist processes should be done outside the driver
             507                     
             508                         ! -----------------------------------------------------------------------
             509                         ! major cloud microphysics
             510                         ! -----------------------------------------------------------------------
             511                     
             512                         call mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, qg, &
             513                             qa, qnl, qni, dz, is, ie, ks, ke, dts, &
             514                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             515                     #ifdef oldmask
             516                             land, &
             517                     #endif
             518                     !        w_var, vt_r, vt_s, vt_g, vt_i,
             519                             q_con, cappa, consv_te, te, &
             520                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             521                             evaporation, sublimation, rhc, last_step, do_inline_mp)
             522                     
             523                     end subroutine gfdl_cld_mp_driver
             524                     
             525                     ! -----------------------------------------------------------------------
             526                     ! gfdl cloud microphysics, major program
             527                     ! lin et al., 1983, jam, 1065 - 1092, and
             528                     ! rutledge and hobbs, 1984, jas, 2949 - 2972
             529                     ! terminal fall is handled lagrangianly by conservative fv algorithm
             530                     ! pt: temperature (k)
             531                     ! 6 water species:
             532                     ! 1) qv: water vapor (kg / kg)
             533                     ! 2) ql: cloud water (kg / kg)
             534                     ! 3) qr: rain (kg / kg)
             535                     ! 4) qi: cloud ice (kg / kg)
             536                     ! 5) qs: snow (kg / kg)
             537                     ! 6) qg: graupel (kg / kg)
             538                     ! -----------------------------------------------------------------------
             539                     
             540                     subroutine mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, &
             541                             qg, qa, qnl, qni, dz, is, ie, ks, ke, dt_in, &
             542                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             543                     #ifdef oldmask
             544                             land, &
             545                     #endif
             546                     !        w_var, vt_r, vt_s, vt_g, vt_i,
             547                             q_con, cappa, consv_te, te, &
             548                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             549                             evaporation, sublimation, rhc, last_step, do_inline_mp )
             550                     
             551                         implicit none
             552                     
             553                         logical, intent (in) :: hydrostatic
             554                         logical, intent (in) :: last_step
             555                         logical, intent (in) :: consv_te
             556                         logical, intent (in) :: do_inline_mp
             557                         integer, intent (in) :: is, ie, ks, ke
             558                         real, intent (in) :: dt_in
             559                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             560                         real, intent (in), dimension (is:ie) :: gsize
             561                         real, intent (in), dimension (is:ie) :: hs
             562                     #ifdef oldmask
             563                         real, intent (in), dimension (is:ie) :: land
             564                     #endif
             565                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             566                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             567                     
             568                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             569                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             570                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             571                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             572                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             573                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             574                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             575                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             576                     
             577                     !    real, intent (out), dimension (is:ie) :: w_var
             578                     !    real, intent (out), dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             579                         real, intent (out), dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             580                         real, intent (out), dimension (is:ie, ks:ke) :: te
             581                         ! local:
             582                         real, dimension (ks:ke) :: q_liq, q_sol
             583                         real, dimension (ks:ke) :: qvz, qlz, qrz, qiz, qsz, qgz, qaz
             584                         real, dimension (ks:ke) :: vtiz, vtsz, vtgz, vtrz, pfr, pfi, pfs, pfg
             585                         real, dimension (ks:ke) :: dp1, dz1
             586                         real, dimension (ks:ke) :: den, p1, denfac
             587                         real, dimension (ks:ke) :: ccn, cin, c_praut, m1_rain, m1_sol, m1
             588                         real, dimension (ks:ke) :: u0, v0, u1, v1, w1
             589                         real, dimension (ks:ke) :: rhcz
             590                     
             591                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg, te_end, tw_beg, tw_end
             592                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg_0, te_end_0, tw_beg_0, tw_end_0
             593                         real (kind = r8), dimension (is:ie) :: te_b_beg, te_b_end, tw_b_beg, tw_b_end, dte, te_loss
             594                         real (kind = r8), dimension (is:ie) :: te_b_beg_0, te_b_end_0, tw_b_beg_0, tw_b_end_0
             595                         real (kind = r8), dimension (ks:ke) :: te1, te2
             596                     
             597                         real :: cpaut, rh_adj, rh_rain
             598                         real :: r1, s1, i1, g1, rdt, ccn0
             599                         real :: dt_rain
             600                         real :: s_leng, t_land, t_ocean, h_var, tmp
             601                         real (kind = r8), dimension (ks:ke) :: dp0, tz, cvm
             602                         real (kind = r8) :: con_r8, c8
             603                         real :: convt
             604                         real :: dts, q_cond
             605                         real :: nl, ni
             606                         real :: cond, dep, reevap, sub
             607                     
             608                         integer :: i, k, n
             609                     
             610                         logical  :: last_step_cld=.false.
             611                     
             612                         ntimes = max (ntimes, int (dt_in / min (dt_in, mp_time)))
             613                         dts = dt_in / real (ntimes)
             614                     
             615                         dt_rain = dts * 0.5
             616                         rdt = one_r8 / dts
             617                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dte
                                   <<< Loop-information  End >>>
             618        pp   4v          dte = 0.0
             619                     
             620                         !! convert to mm / day (original)
             621                         ! convt = 86400. * rdt * rgrav
             622                     
             623                         !! convert to mm / s
             624                         ! convt = rdt * rgrav
             625                     
             626                         ! convert to mm
             627                         convt = rgrav
             628                     
             629                         ! -----------------------------------------------------------------------
             630                         ! use local variables
             631                         ! -----------------------------------------------------------------------
             632                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, q_liq, cvm, u1, qsz, v1, qiz
                                   <<<      qrz, qlz, qvz, qgz, w1, dp1, den, ccn
                                   <<<      c_praut, dp0, m1, v0, u0, qaz
                                   <<< Loop-information  End >>>
             633     1                   do i = is, ie
             634     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
             635     2  pp   4v              do k = ks, ke
             636     3   p   4v                  if (do_inline_mp) then
             637     3               #ifdef MOIST_CAPPA
             638     3                               tz (k) = pt (i, k) / ((1. + zvir * qv (i, k)) * (1. - (ql (i, k) + qr (i, k) + qi (i, k) + qs (i, k) + qg (i, k))))
             639     3               #else
             640     3       4                       tz (k) = pt (i, k) / (1. + zvir * qv (i, k))
             641     3               #endif
             642     3   p   4v                  else
             643     3   p   4v                      tz (k) = pt (i, k)
             644     3   p   4v                  endif
             645     2   p   4v              enddo
             646     1               
             647     1                       ! -----------------------------------------------------------------------
             648     1                       ! total energy checker
             649     1                       ! -----------------------------------------------------------------------
             650     1               
             651     2                       if (consv_checker) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 184
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.42, ITR: 40, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, cvm, q_liq
                                   <<< Loop-information  End >>>
             652     3  pp    v                  do k = ks, ke
             653     3   p    v                      q_liq (k) = ql (i, k) + qr (i, k)
             654     3   p    v                      q_sol (k) = qi (i, k) + qs (i, k) + qg (i, k)
             655     3   p    v                      cvm (k) = c_air * (1.0 - qv (i, k) - q_liq (k) - q_sol (k)) + &
             656     3                                   qv (i, k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
             657     3   p    v                      te_beg_0 (i, k) = cvm (k) * tz (k) + lv00 * c_air * qv (i, k) - li00 * c_air * q_sol (k)
             658     4   p    v                      if (hydrostatic) then
             659     4                                   te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2)
             660     4   p    v                      else
             661     4   p    v                          te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2 + w (i, k) ** 2)
             662     4   p    v                      endif
             663     3   p    v                      te_beg_0 (i, k) = rgrav * te_beg_0 (i, k) * delp (i, k) * gsize (i) ** 2.0
             664     3   p    v                      tw_beg_0 (i, k) = rgrav * (qv (i, k) + q_liq (k) + q_sol (k)) * delp (i, k) * gsize (i) ** 2.0

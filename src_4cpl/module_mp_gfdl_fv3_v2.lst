            2782     2   p    v              if (qi (k) > qcmin .and. tc > 0.) then
            2783     2   p    v                  sink = min (qi (k), fac_imlt * tc / icpk (k))
            2784     2   p    v                  tmp = min (sink, dim (ql_mlt, ql (k)))
            2785     2   p    v                  ql (k) = ql (k) + tmp

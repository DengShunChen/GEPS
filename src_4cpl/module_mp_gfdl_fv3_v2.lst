                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, p, dqdt
                                   <<< Loop-information  End >>>
            4778     3   p    v                  do i = 1, im
            4779     3   p    v                      ap1 = 10. * dim (t (i, k), tmin) + 1.
            4780     3   p    v                      ap1 = min (2621., ap1) - 0.5
            4781     3   p    v                      it = ap1
            4782     3   p    v                      dqdt (i, k) = eps10 * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) * (1. + zvir * q (i, k)) / p (i, k)
            4783     3   p    v                  enddo
            4784     2   p                   enddo
            4785     1                   endif
            4786                     
            4787                     end subroutine qsmith
            4788                     
            4789                     ! =======================================================================
            4790                     ! fix negative water species
            4791                     ! this is designed for 6 - class micro - physics schemes
            4792                     ! =======================================================================
            4793                     
            4794                     subroutine neg_adj (ks, ke, pt, dp, qv, ql, qr, qi, qs, qg, cond)
            4795                     
            4796                         implicit none
            4797                     
            4798                         integer, intent (in) :: ks, ke
            4799                         real, intent (in), dimension (ks:ke) :: dp
            4800                         real (kind = r8), intent (inout), dimension (ks:ke) :: pt
            4801                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4802                         real, intent (out) :: cond
            4803                     
            4804                         real, dimension (ks:ke) :: lcpk, icpk
            4805                     
            4806                         real :: dq, cvm
            4807                     
            4808                         integer :: k
            4809                     
            4810                         ! -----------------------------------------------------------------------
            4811                         ! define heat capacity and latent heat coefficient
            4812                         ! -----------------------------------------------------------------------
            4813                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg, pt, qv, qr, ql, lcpk, qi, qs, icpk
                                   <<< Loop-information  End >>>
            4814     1  pp    v          do k = ks, ke
            4815     1   p    v              cvm = 1. + qv (k) * c1_vap + (qr (k) + ql (k)) * c1_liq + (qi (k) + qs (k) + qg (k)) * c1_ice
            4816     1   p    v              lcpk (k) = (lv00 + d1_vap * pt (k)) / cvm
            4817     1   p    v              icpk (k) = (li00 + d1_ice * pt (k)) / cvm
            4818     1   p    v          enddo
            4819                     
            4820                         cond = 0
            4821                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 121
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4822     1  pp    v          do k = ks, ke
            4823     1               
            4824     1                       ! -----------------------------------------------------------------------
            4825     1                       ! ice phase:
            4826     1                       ! -----------------------------------------------------------------------
            4827     1               
            4828     1                       ! if cloud ice < 0, borrow from snow
            4829     2   p    v              if (qi (k) < 0.) then
            4830     2   p    v                  qs (k) = qs (k) + qi (k)
            4831     2   p    v                  qi (k) = 0.
            4832     2   p    v              endif
            4833     1                       ! if snow < 0, borrow from graupel
            4834     2   p    v              if (qs (k) < 0.) then
            4835     2   p    v                  qg (k) = qg (k) + qs (k)
            4836     2   p    v                  qs (k) = 0.
            4837     2   p    v              endif
            4838     1                       ! if graupel < 0, borrow from rain
            4839     2   p    v              if (qg (k) < 0.) then
            4840     2   p    v                  qr (k) = qr (k) + qg (k)
            4841     2   p    v                  pt (k) = pt (k) - qg (k) * icpk (k) ! heating
            4842     2   p    v                  qg (k) = 0.
            4843     2   p    v              endif
            4844     1               
            4845     1                       ! -----------------------------------------------------------------------
            4846     1                       ! liquid phase:
            4847     1                       ! -----------------------------------------------------------------------
            4848     1               
            4849     1                       ! if rain < 0, borrow from cloud water
            4850     2   p    v              if (qr (k) < 0.) then
            4851     2   p    v                  ql (k) = ql (k) + qr (k)
            4852     2   p    v                  qr (k) = 0.
            4853     2   p    v              endif
            4854     1                       ! if cloud water < 0, borrow from water vapor
            4855     2   p    v              if (ql (k) < 0.) then
            4856     2   p    v                  cond = cond - ql (k) * dp (k)
            4857     2   p    v                  qv (k) = qv (k) + ql (k)
            4858     2   p    v                  pt (k) = pt (k) - ql (k) * lcpk (k) ! heating
            4859     2   p    v                  ql (k) = 0.
            4860     2   p    v              endif
            4861     1               
            4862     1   p    v          enddo
            4863                     
            4864                         ! -----------------------------------------------------------------------
            4865                         ! fix water vapor; borrow from below
            4866                         ! -----------------------------------------------------------------------
            4867                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            4868     1   s   2s          do k = ks, ke - 1
            4869     2   s   2m              if (qv (k) < 0.) then
            4870     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            4871     2   s   2v                  qv (k) = 0.
            4872     2   s   2v              endif
            4873     1   s   2v          enddo
            4874                     
            4875                         ! -----------------------------------------------------------------------
            4876                         ! bottom layer; borrow from above
            4877                         ! -----------------------------------------------------------------------
            4878                     
            4879     1                   if (qv (ke) < 0. .and. qv (ke - 1) > 0.) then
            4880     1                       dq = min (- qv (ke) * dp (ke), qv (ke - 1) * dp (ke - 1))
            4881     1                       qv (ke - 1) = qv (ke - 1) - dq / dp (ke - 1)
            4882     1                       qv (ke) = qv (ke) + dq / dp (ke)
            4883     1                   endif
            4884                     
            4885                     end subroutine neg_adj
            4886                     
            4887                     !-------------------------------------------------------------------
            4888                           SUBROUTINE semi_lagrange_sedim(km,dzl,wwl,rql,precip,pfsan,dt,R1)
            4889                     !-------------------------------------------------------------------
            4890                     !
            4891                     ! This routine is a semi-Lagrangain forward advection for hydrometeors
            4892                     ! with mass conservation and positive definite advection
            4893                     ! 2nd order interpolation with monotonic piecewise parabolic method is used.
            4894                     ! This routine is under assumption of decfl < 1 for semi_Lagrangian
            4895                     !
            4896                     ! km     number of layers
            4897                     ! dzl    depth of model layer in meter (m)
            4898                     ! wwl    terminal velocity at model layer (m/s)
            4899                     ! rql    dry air density*mixing ratio
            4900                     ! precip precipitation at surface (mm)
            4901                     ! pfsan  precipitation fluxes (mm?)
            4902                     ! dt     time step (s)
            4903                     ! R1     minimum q, =1.E-12 in new Thompson MP
            4904                     !
            4905                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            4906                     !         implemented by song-you hong
            4907                     ! reference: Juang, H.-M., and S.-Y. Hong, 2010: Forward semi-Lagrangian advection
            4908                     !         with mass conservation and positive definiteness for falling
            4909                     !         hydrometeors. *Mon.  Wea. Rev.*, *138*, 1778-1791
            4910                     !
            4911                           implicit none
            4912                     
            4913                           integer, intent(in) :: km
            4914                           real, intent(in) ::  dt, R1
            4915                           real, intent(in) :: dzl(km),wwl(km)
            4916                           real, intent(out) :: precip
            4917                           real, intent(inout) :: rql(km)
            4918                           real, intent(out)  :: pfsan(km)
            4919                           integer  k,m,kk,kb,kt
            4920                           real  tl,tl2,qql,dql,qqd
            4921                           real  th,th2,qqh,dqh
            4922                           real  zsum,qsum,dim,dip,con1,fa1,fa2
            4923                           real  allold, decfl
            4924                           real  dz(km), ww(km), qq(km)
            4925                           real  wi(km+1), zi(km+1), za(km+2)
            4926                           real  qn(km)
            4927                           real  dza(km+1), qa(km+1), qmi(km+1), qpi(km+1)
            4928                           real  net_flx(km)
            4929                     !
            4930                           precip = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa
                                   <<< Loop-information  End >>>
            4931        pp   4v            qa(:) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, dz, wwl, dzl, qq
                                   <<< Loop-information  End >>>
            4932        pp   2v            qq(:) = 0.0
            4933         p   2v            dz(:) = dzl(:)
            4934         p   2v            ww(:) = wwl(:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rql, net_flx, ww, qq, pfsan
                                   <<< Loop-information  End >>>
            4935     1  pp   2v            do k = 1,km
            4936     2   p   2v              if(rql(k).gt.R1) then
            4937     2   p   2v                qq(k) = rql(k)
            4938     2   p   2v              else
            4939     2   p   2v                ww(k) = 0.0
            4940     2   p   2v              endif
            4941     1   p   2v              pfsan(k) = 0.0
            4942     1   p   2v              net_flx(k) = 0.0
            4943     1   p   2v            enddo
            4944                     ! skip for no precipitation for all layers
            4945                           allold = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4946     1  pp    v            do k=1,km
            4947     1   p    v              allold = allold + qq(k)
            4948     1   p    v            enddo
            4949     1                     if(allold.le.0.0) then
            4950     1                        return
            4951     1                     endif
            4952                     !
            4953                     ! compute interface values
            4954                           zi(1)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi
                                   <<< Loop-information  End >>>
            4955     1   s   2s            do k=1,km
            4956     1   s   2s              zi(k+1) = zi(k)+dz(k)
            4957     1   s   2s            enddo
            4958                     ! plm is 2nd order, we can use 2nd order wi or 3rd order wi
            4959                     ! 2nd order interpolation to get wi
            4960                     !      wi(1) = ww(1)
            4961                     !      wi(km+1) = ww(km)
            4962                     !      do k=2,km
            4963                     !        wi(k) = (ww(k)*dz(k-1)+ww(k-1)*dz(k))/(dz(k-1)+dz(k))
            4964                     !      enddo
            4965                     ! 3rd order interpolation to get wi
            4966                           fa1 = 9./16.
            4967                           fa2 = 1./16.
            4968                           wi(1) = ww(1)
            4969                           wi(2) = 0.5*(ww(2)+ww(1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            4970     1  pp   2v            do k=3,km-1
            4971     1   p   2v              wi(k) = fa1*(ww(k)+ww(k-1))-fa2*(ww(k+1)+ww(k-2))
            4972     1   p   2v            enddo
            4973                           wi(km) = 0.5*(ww(km)+ww(km-1))
            4974                           wi(km+1) = ww(km)
            4975                     
            4976                     ! terminate of top of raingroup
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            4977     1  pp   2v            do k=2,km
            4978     1   p   2v              if( ww(k).eq.0.0 ) wi(k)=ww(k-1)
            4979     1   p   2v            enddo
            4980                     
            4981                     ! diffusivity of wi
            4982                           con1 = 0.05
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, dz
                                   <<< Loop-information  End >>>
            4983     1   s   2s            do k=km,1,-1
            4984     1   m   2m              decfl = (wi(k+1)-wi(k))*dt/dz(k)
            4985     2   s   2s              if( decfl .gt. con1 ) then
            4986     2   s   2s                wi(k) = wi(k+1) - con1*dz(k)/dt
            4987     2   p   2v              endif
            4988     1   p   2v            enddo
            4989                     ! compute arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, zi, za
                                   <<< Loop-information  End >>>
            4990     1  pp   2v            do k=1,km+1
            4991     1   p   2v              za(k) = zi(k) - wi(k)*dt
            4992     1   p   2v            enddo
            4993                           za(km+2) = zi(km+1)
            4994                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za, dza
                                   <<< Loop-information  End >>>
            4995     1  pp   2v            do k=1,km+1
            4996     1   p   2v              dza(k) = za(k+1)-za(k)
            4997     1   p   2v            enddo
            4998                     
            4999                     ! computer deformation at arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qq, dza, qa
                                   <<< Loop-information  End >>>
            5000     1  pp   2v            do k=1,km
            5001     1   p   2v              qa(k) = qq(k)*dz(k)/dza(k)
            5002     1   p   2v            enddo
            5003                           qa(km+1) = 0.0
            5004                     
            5005                     ! estimate values at arrival cell interface with monotone
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qmi, qpi
                                   <<< Loop-information  End >>>
            5006     1  pp    v            do k=2,km
            5007     1   p    v              dip=(qa(k+1)-qa(k))/(dza(k+1)+dza(k))
            5008     1   p    v              dim=(qa(k)-qa(k-1))/(dza(k-1)+dza(k))
            5009     2   p    v              if( dip*dim.le.0.0 ) then
            5010     2   p    v                qmi(k)=qa(k)
            5011     2   p    v                qpi(k)=qa(k)
            5012     2   p    v              else
            5013     2   p    v                qpi(k)=qa(k)+0.5*(dip+dim)*dza(k)
            5014     2   p    v                qmi(k)=2.0*qa(k)-qpi(k)
            5015     3   p    v                if( qpi(k).lt.0.0 .or. qmi(k).lt.0.0 ) then
            5016     3   p    v                  qpi(k) = qa(k)
            5017     3   p    v                  qmi(k) = qa(k)
            5018     3   p    v                endif
            5019     2   p    v              endif
            5020     1   p    v            enddo
            5021                           qpi(1)=qa(1)
            5022                           qmi(1)=qa(1)
            5023                           qmi(km+1)=qa(km+1)
            5024                           qpi(km+1)=qa(km+1)
            5025                     
            5026                     ! interpolation to regular point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            5027        pp   4v            qn = 0.0
            5028                           kb=1
            5029                           kt=1
            5030     1                     intp : do k=1,km
            5031     1                            kb=max(kb-1,1)
            5032     1                            kt=max(kt-1,1)
            5033     1               ! find kb and kt
            5034     2                            if( zi(k).ge.za(km+1) ) then
            5035     2                              exit intp
            5036     2                            else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            5037     3                              find_kb : do kk=kb,km
            5038     4                                        if( zi(k).le.za(kk+1) ) then
            5039     4                                          kb = kk
            5040     4                                          exit find_kb
            5041     4                                        else
            5042     4                                          cycle find_kb
            5043     4                                        endif
            5044     3                              enddo find_kb
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            5045     3                              find_kt : do kk=kt,km+2
            5046     4                                        if( zi(k+1).le.za(kk) ) then
            5047     4                                          kt = kk
            5048     4                                          exit find_kt
            5049     4                                        else
            5050     4                                          cycle find_kt
            5051     4                                        endif
            5052     3                              enddo find_kt
            5053     2                              kt = kt - 1
            5054     2               ! compute q with piecewise constant method
            5055     3                              if( kt.eq.kb ) then
            5056     3                                tl=(zi(k)-za(kb))/dza(kb)
            5057     3                                th=(zi(k+1)-za(kb))/dza(kb)
            5058     3                                tl2=tl*tl
            5059     3                                th2=th*th
            5060     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            5061     3                                qqh=qqd*th2+qmi(kb)*th
            5062     3                                qql=qqd*tl2+qmi(kb)*tl
            5063     3                                qn(k) = (qqh-qql)/(th-tl)
            5064     3                                net_flx(k) = (qa(k)*dza(k)-(qqh-qql))  !xb141
            5065     3                              else if( kt.gt.kb ) then
            5066     3                                tl=(zi(k)-za(kb))/dza(kb)
            5067     3                                tl2=tl*tl
            5068     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            5069     3                                qql=qqd*tl2+qmi(kb)*tl
            5070     3                                dql = qa(kb)-qql
            5071     3                                zsum  = (1.-tl)*dza(kb)
            5072     3                                qsum  = dql*dza(kb)
            5073     4                                if( kt-kb.gt.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5074     5  pp    v                       do m=kb+1,kt-1
            5075     5   p    v                         zsum = zsum + dza(m)
            5076     5   p    v                         qsum = qsum + qa(m) * dza(m)
            5077     5   p    v                       enddo
            5078     4                                endif
            5079     3                                th=(zi(k+1)-za(kt))/dza(kt)
            5080     3                                th2=th*th
            5081     3                                qqd=0.5*(qpi(kt)-qmi(kt))
            5082     3                                dqh=qqd*th2+qmi(kt)*th
            5083     3                                zsum  = zsum + th*dza(kt)
            5084     3                                qsum  = qsum + dqh*dza(kt)
            5085     3                                qn(k) = qsum/zsum
            5086     3                                net_flx(k) = (qa(k)*dza(k)-qsum)  !xb141
            5087     3                              endif
            5088     2                              cycle intp
            5089     2                            endif
            5090     1               
            5091     1                      enddo intp
            5092                     
            5093                     ! rain out
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5094     1                     sum_precip: do k=1,km
            5095     2                                   if( za(k).lt.0.0 .and. za(k+1).le.0.0 ) then
            5096     2                                     precip = precip + qa(k)*dza(k)
            5097     2                                     cycle sum_precip
            5098     2                                   else if ( za(k).lt.0.0 .and. za(k+1).gt.0.0 ) then
            5099     2                                     th = (0.0-za(k))/dza(k)
            5100     2                                     th2 = th*th
            5101     2                                     qqd = 0.5*(qpi(k)-qmi(k))
            5102     2                                     qqh = qqd*th2+qmi(k)*th
            5103     2                                     precip = precip + qqh*dza(k)
            5104     2                                     exit sum_precip
            5105     2                                   endif
            5106     1                                   exit sum_precip
            5107     1                     enddo sum_precip
            5108                           precip = precip*grav  !xb141, because convt=1./grav
            5109                     

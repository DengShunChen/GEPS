            2560     3                               dq = h_var * qpz
            2561     4                               if (do_cld_adj) then
            2562     4                                   q_plus = qpz + dq * f_dq_p * min(1.0, max(0.0, (p1 (k) - 200.e2) / (1000.e2 - 200.e2)))
            2563     4                               else
            2564     4                                   q_plus = qpz + dq * f_dq_p
            2565     4                               endif
            2566     3                               q_minus = qpz - dq * f_dq_m
            2567     3               
            2568     4                               if (icloud_f .eq. 2) then
            2569     5                                   if (qstar < qpz) then
            2570     5                                       qa (k) = 1.
            2571     5                                   else
            2572     5                                       qa (k) = 0.
            2573     5                                   endif
            2574     4                               elseif (icloud_f .eq. 3) then
            2575     5                                   if (qstar < qpz) then
            2576     5                                       qa (k) = 1.
            2577     5                                   else
            2578     6                                       if (qstar < q_plus) then
            2579     6                                           qa (k) = (q_plus - qstar) / (dq * f_dq_p)
            2580     6                                       else
            2581     6                                           qa (k) = 0.
            2582     6                                       endif
            2583     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2584     6                                       if (q_cond (k) > qcldmin) then
            2585     6                                           qa (k) = max (cld_min, qa (k))
            2586     6                                       endif
            2587     5                                       qa (k) = min (1., qa (k))
            2588     5                                   endif
            2589     4                               else
            2590     5                                   if (qstar < q_minus) then
            2591     5                                       qa (k) = 1.
            2592     5                                   else
            2593     6                                       if (qstar < q_plus) then
            2594     7                                           if (icloud_f .eq. 0) then
            2595     7                                               qa (k) = (q_plus - qstar) / (dq * f_dq_p + dq * f_dq_m)
            2596     7                                           else
            2597     7                                               qa (k) = (q_plus - qstar) / ((dq * f_dq_p + dq * f_dq_m) * (1. - q_cond (k)))
            2598     7                                           endif
            2599     6                                       else
            2600     6                                           qa (k) = 0.
            2601     6                                       endif
            2602     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2603     6                                       if (q_cond (k) > qcldmin) then
            2604     6                                           qa (k) = max (cld_min, qa (k))
            2605     6                                       endif
            2606     5                                       qa (k) = min (1., qa (k))
            2607     5                                   endif
            2608     4                               endif
            2609     3                           else
            2610     3                               qa (k) = 0.
            2611     3                           endif
            2612     2                       endif
            2613     1               
            2614     1                   enddo
            2615                     
            2616                     end subroutine subgrid_z_proc
            2617                     
            2618                     ! =======================================================================
            2619                     ! rain evaporation
            2620                     ! =======================================================================
            2621                     
            2622                     subroutine revap_rac1 (hydrostatic, is, ie, dt, tz, qv, ql, qr, qi, qs, qg, den, hvar)
            2623                     
            2624                         implicit none
            2625                     
            2626                         logical, intent (in) :: hydrostatic
            2627                     
            2628                         integer, intent (in) :: is, ie
            2629                     
            2630                         real, intent (in) :: dt ! time step (s)
            2631                     
            2632                         real, intent (in), dimension (is:ie) :: den, hvar, qi, qs, qg
            2633                     
            2634                         real, intent (inout), dimension (is:ie) :: tz, qv, qr, ql
            2635                     
            2636                         real, dimension (is:ie) :: lcp2, denfac, q_liq, q_sol, cvm, lhl
            2637                     
            2638                         real :: dqv, qsat, dqsdt, evap, qden, q_plus, q_minus, sink
            2639                         real :: tin, t2, qpz, dq, dqh
            2640                     
            2641                         integer :: i
            2642                     
            2643                         ! -----------------------------------------------------------------------
            2644                         ! define latend heat coefficient
            2645                         ! -----------------------------------------------------------------------
            2646                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, qg, tz, qs, q_sol, cvm, q_liq
                                   <<<      qi, qr, lcp2, lhl
                                   <<< Loop-information  End >>>
            2647     1  pp    v          do i = is, ie
            2648     1   p    v              lhl (i) = lv00 + d0_vap * tz (i)
            2649     1   p    v              q_liq (i) = ql (i) + qr (i)
            2650     1   p    v              q_sol (i) = qi (i) + qs (i) + qg (i)
            2651     1   p    v              cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2652     1   p    v              lcp2 (i) = lhl (i) / cvm (i)
            2653     1                       ! denfac (i) = sqrt (sfcrho / den (i))
            2654     1   p    v          enddo
            2655                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 5
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2656     1                   do i = is, ie
            2657     2                       if (qr (i) > qrmin .and. tz (i) > t_wfr) then
            2658     2                           qpz = qv (i) + ql (i)
            2659     2                           tin = tz (i) - lcp2 (i) * ql (i) ! presence of clouds suppresses the rain evap
            2660     2    i                      qsat = wqs2 (tin, den (i), dqsdt)
            2661     2                           dqh = max (ql (i), hvar (i) * max (qpz, qcmin))
            2662     2                           dqv = qsat - qv (i)
            2663     2                           q_minus = qpz - dqh
            2664     2                           q_plus = qpz + dqh
            2665     2               
            2666     2                           ! -----------------------------------------------------------------------
            2667     2                           ! qsat must be > q_minus to activate evaporation
            2668     2                           ! qsat must be < q_plus to activate accretion
            2669     2                           ! -----------------------------------------------------------------------
            2670     2               
            2671     2                           ! -----------------------------------------------------------------------
            2672     2                           ! rain evaporation
            2673     2                           ! -----------------------------------------------------------------------
            2674     2               
            2675     3                           if (dqv > qvmin .and. qsat > q_minus) then
            2676     4                               if (qsat > q_plus) then
            2677     4                                   dq = qsat - qpz
            2678     4                               else
            2679     4                                   ! q_minus < qsat < q_plus
            2680     4                                   ! dq == dqh if qsat == q_minus
            2681     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            2682     4                               endif
            2683     3                               qden = qr (i) * den (i)
            2684     3                               t2 = tin * tin
            2685     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * exp (0.725 * log (qden))) &
            2686     3                                    / (crevp (4) * t2 + crevp (5) * qsat * den (i))
            2687     3                               evap = min (qr (i), dt * evap, dqv / (1. + lcp2 (i) * dqsdt))
            2688     3                               qr (i) = qr (i) - evap
            2689     3                               qv (i) = qv (i) + evap
            2690     3                               q_liq (i) = q_liq (i) - evap
            2691     3                               cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2692     3                               tz (i) = tz (i) - evap * lhl (i) / cvm (i)
            2693     3                           endif
            2694     2               
            2695     2                           ! -----------------------------------------------------------------------
            2696     2                           ! accretion: pracc
            2697     2                           ! -----------------------------------------------------------------------
            2698     2               
            2699     3                           if (qr (i) > qrmin .and. ql (i) > 1.e-8 .and. qsat < q_plus) then
            2700     3                               denfac (i) = sqrt (sfcrho / den (i))
            2701     3                               sink = dt * denfac (i) * cracw * exp (0.95 * log (qr (i) * den (i)))
            2702     3                               sink = sink / (1. + sink) * ql (i)
            2703     3                               ql (i) = ql (i) - sink
            2704     3                               qr (i) = qr (i) + sink
            2705     3                           endif
            2706     2                       endif
            2707     1                   enddo
            2708                     
            2709                     end subroutine revap_rac1
            2710                     
            2711                     ! =======================================================================
            2712                     ! compute terminal fall speed
            2713                     ! consider cloud ice, snow, and graupel's melting during fall
            2714                     ! =======================================================================
            2715                     
            2716                     subroutine terminal_fall (dtm, ks, ke, tz, qv, ql, qr, qg, qs, qi, dz, dp, &
            2717                             den, vtg, vts, vti, r1, g1, s1, i1, pfr, pfi, pfs, pfg, m1_sol, w1, dte)
            2718                     
            2719                         implicit none
            2720                     
            2721                         integer, intent (in) :: ks, ke
            2722                         real, intent (in) :: dtm ! time step (s)
            2723                         real, intent (in), dimension (ks:ke) :: vtg, vts, vti, den, dp, dz
            2724                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            2725                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qg, qs, qi, m1_sol, w1, pfr, pfi, pfs, pfg
            2726                         real (kind = r8), intent (inout) :: dte
            2727                         real, intent (out) :: r1, g1, s1, i1

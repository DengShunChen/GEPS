                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
            2769     1                   do k = ks, ke - 1
            2770     2                       if (tz (k) > tice) then
            2771     2                           k0 = k
            2772     2                           exit
            2773     2                       endif
            2774     1                   enddo
            2775                     
            2776                         ! -----------------------------------------------------------------------
            2777                         ! melting of cloud_ice (before fall) :

            4538                     ! =======================================================================
            4539                     ! saturation water vapor pressure table iii
            4540                     ! 2 - phase table
            4541                     ! =======================================================================
            4542                     
            4543                     subroutine qs_table2 (n)
            4544                     
            4545                         implicit none
            4546                     
            4547                         integer, intent (in) :: n
            4548                     
            4549                         real (kind = r8) :: delt = 0.1
            4550                         real (kind = r8) :: tmin, tem0, tem1, fac0, fac1, fac2
            4551                     
            4552                         integer :: i, i0, i1
            4553                     
            4554                         tmin = table_ice - 160.
            4555                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4556     1  pp    v          do i = 1, n
            4557     1   p    v              tem0 = tmin + delt * real (i - 1)
            4558     1   p    v              fac0 = (tem0 - t_ice) / (tem0 * t_ice)
            4559     2   p    v              if (i <= 1600) then
            4560     2                           ! -----------------------------------------------------------------------
            4561     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4562     2                           ! -----------------------------------------------------------------------
            4563     2   p    v                  fac1 = fac0 * li2
            4564     2   p    v                  fac2 = (d2ice * log (tem0 / t_ice) + fac1) / rvgas
            4565     2   p    v              else
            4566     2                           ! -----------------------------------------------------------------------
            4567     2                           ! compute es over water between 0 deg c and 102 deg c.
            4568     2                           ! -----------------------------------------------------------------------
            4569     2   p    v                  fac1 = fac0 * lv0
            4570     2   p    v                  fac2 = (dc_vap * log (tem0 / t_ice) + fac1) / rvgas
            4571     2   p    v              endif
            4572     1   p    v              table2 (i) = e00 * exp (fac2)
            4573     1   p    v          enddo
            4574                     
            4575                         ! -----------------------------------------------------------------------
            4576                         ! smoother around 0 deg c
            4577                         ! -----------------------------------------------------------------------
            4578                     
            4579                         i0 = 1600
            4580                         i1 = 1601
            4581                         tem0 = 0.25 * (table2 (i0 - 1) + 2. * table (i0) + table2 (i0 + 1))
            4582                         tem1 = 0.25 * (table2 (i1 - 1) + 2. * table (i1) + table2 (i1 + 1))
            4583                         table2 (i0) = tem0
            4584                         table2 (i1) = tem1
            4585                     
            4586                     end subroutine qs_table2
            4587                     
            4588                     ! =======================================================================
            4589                     ! saturation water vapor pressure table iv
            4590                     ! 2 - phase table with " - 2 c" as the transition point
            4591                     ! =======================================================================
            4592                     
            4593                     subroutine qs_table3 (n)
            4594                     
            4595                         implicit none
            4596                     
            4597                         integer, intent (in) :: n
            4598                     
            4599                         real (kind = r8) :: delt = 0.1
            4600                         real (kind = r8) :: esbasw, tbasw, esbasi, tmin, tem, aa, b, c, d, e
            4601                         real (kind = r8) :: tem0, tem1
            4602                     
            4603                         integer :: i, i0, i1
            4604                     
            4605                         esbasw = 1013246.0
            4606                         tbasw = table_ice + 100.
            4607                         esbasi = 6107.1
            4608                         tmin = table_ice - 160.
            4609                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 42
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4610     1  pp    v          do i = 1, n
            4611     1   p    v              tem = tmin + delt * real (i - 1)
            4612     1                       ! if (i <= 1600) then
            4613     2   p    v              if (i <= 1580) then ! change to - 2 c
            4614     2                           ! -----------------------------------------------------------------------
            4615     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4616     2                           ! see smithsonian meteorological tables page 350.
            4617     2                           ! -----------------------------------------------------------------------
            4618     2   p    v                  aa = - 9.09718 * (table_ice / tem - 1.)
            4619     2   p    v                  b = - 3.56654 * log10 (table_ice / tem)
            4620     2   p    v                  c = 0.876793 * (1. - tem / table_ice)
            4621     2   p    v                  e = log10 (esbasi)
            4622     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + e)
            4623     2   p    v              else
            4624     2                           ! -----------------------------------------------------------------------
            4625     2                           ! compute es over water between - 2 deg c and 102 deg c.
            4626     2                           ! see smithsonian meteorological tables page 350.
            4627     2                           ! -----------------------------------------------------------------------
            4628     2   p    v                  aa = - 7.90298 * (tbasw / tem - 1.)
            4629     2   p    v                  b = 5.02808 * log10 (tbasw / tem)
            4630     2   p    v                  c = - 1.3816e-7 * (10 ** ((1. - tem / tbasw) * 11.344) - 1.)
            4631     2   p    v                  d = 8.1328e-3 * (10 ** ((tbasw / tem - 1.) * (- 3.49149)) - 1.)
            4632     2   p    v                  e = log10 (esbasw)
            4633     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + d + e)
            4634     2   p    v              endif
            4635     1   p    v          enddo
            4636                     
            4637                         ! -----------------------------------------------------------------------
            4638                         ! smoother around - 2 deg c
            4639                         ! -----------------------------------------------------------------------
            4640                     
            4641                         i0 = 1580
            4642                         i1 = 1581
            4643                         tem0 = 0.25 * (table3 (i0 - 1) + 2. * table (i0) + table3 (i0 + 1))
            4644                         tem1 = 0.25 * (table3 (i1 - 1) + 2. * table (i1) + table3 (i1 + 1))
            4645                         table3 (i0) = tem0
            4646                         table3 (i1) = tem1
            4647                     
            4648                     end subroutine qs_table3
            4649                     
            4650                     ! =======================================================================
            4651                     ! compute the saturated specific humidity for table
            4652                     ! note: this routine is based on "moist" mixing ratio
            4653                     ! =======================================================================
            4654                     
            4655                     real function qs_blend (t, p, q)
            4656                     
            4657                         implicit none
            4658                     
            4659                         real, intent (in) :: t, p, q
            4660                     
            4661                         real :: es, ap1, tmin
            4662                     
            4663                         integer :: it
            4664                     
            4665                         tmin = table_ice - 160.
            4666                         ap1 = 10. * dim (t, tmin) + 1.
            4667                         ap1 = min (2621., ap1)
            4668                         it = ap1
            4669                         es = table (it) + (ap1 - it) * des (it)
            4670                         qs_blend = eps * es * (1. + zvir * q) / p
            4671                     
            4672                     end function qs_blend

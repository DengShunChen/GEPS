             247                     
             248                         ! -----------------------------------------------------------------------
             249                         ! wrf / wsm6 scheme: qi_gen = 4.92e-11 * (1.e3 * exp (0.1 * tmp)) ** 1.33
             250                         ! optimized: qi_gen = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp)))
             251                         ! qi_gen ~ 4.808e-7 at 0 c; 1.818e-6 at - 10 c, 9.82679e-5 at - 40c
             252                         ! the following value is constructed such that qc_crt = 0 at zero c and @ - 10c matches
             253                         ! wrf / wsm6 ice initiation scheme; qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den
             254                         ! -----------------------------------------------------------------------
             255                     
             256                         real :: sat_adj0 = 0.90 ! adjustment factor (0: no, 1: full) during fast_sat_adj
             257                     
             258                         real :: qc_crt = 5.0e-8 ! mini condensate mixing ratio to allow partial cloudiness
             259                     
             260                         real :: qi_lim = 1. ! cloud ice limiter to prevent large ice build up
             261                     
             262                         real :: ql_mlt = 2.0e-3 ! max value of cloud water allowed from melted cloud ice
             263                         real :: qs_mlt = 1.0e-6 ! max cloud water due to snow melt
             264                     
             265                         real :: ql_gen = 1.0e-3 ! max cloud water generation during remapping step if do_sat_adj = .t.
             266                         real :: qi_gen = 1.82e-6 ! max cloud ice generation during remapping step
             267                     
             268                         ! cloud condensate upper bounds: "safety valves" for ql & qi
             269                     
             270                         real :: ql0_max = 2.0e-3 ! max cloud water value (auto converted to rain)
             271                         real :: qi0_max = 1.0e-4 ! max cloud ice value (by other sources)
             272                     
             273                     !    real :: qi0_crt = 1.0e-4 ! cloud ice to snow autoconversion threshold (was 1.e-4)
             274                         real :: qi0_crt = 0.2e-4 ! cloud ice to snow autoconversion threshold (was 1.e-4)
             275                         ! qi0_crt if negative, its magnitude is used as the mixing ration threshold; otherwise, used as density
             276                         real :: qr0_crt = 1.0e-4 ! rain to snow or graupel / hail threshold
             277                         ! lin et al. (1983) used * mixing ratio * = 1.e-4 (hail)
             278                         real :: qs0_crt = 1.0e-3 ! snow to graupel density threshold (0.6e-3 in purdue lin scheme)
             279                     
             280                         real :: c_paut = 0.55 ! autoconversion cloud water to rain (use 0.5 to reduce autoconversion)
             281                         real :: c_psaci = 0.02 ! accretion: cloud ice to snow (was 0.1 in zetac)
             282                         real :: c_piacr = 5.0 ! accretion: rain to ice: (not used)
             283                         real :: c_cracw = 0.9 ! rain accretion efficiency
             284                         real :: c_pgacs = 2.0e-3 ! snow to graupel "accretion" eff. (was 0.1 in zetac)
             285                     

            3237                     ! =======================================================================
            3238                     ! lagrangian scheme
            3239                     ! developed by sj lin, around 2006
            3240                     ! =======================================================================
            3241                     
            3242                     subroutine lagrangian_fall_ppm (ks, ke, zs, ze, zt, dp, q, precip, m1, mono)
            3243                     
            3244                         implicit none
            3245                     
            3246                         integer, intent (in) :: ks, ke
            3247                         real, intent (in) :: zs
            3248                         logical, intent (in) :: mono
            3249                         real, intent (in), dimension (ks:ke + 1) :: ze, zt
            3250                         real, intent (in), dimension (ks:ke) :: dp
            3251                     
            3252                         ! m1: flux
            3253                         real, intent (inout), dimension (ks:ke) :: q, m1
            3254                         real, intent (out) :: precip
            3255                         real, dimension (ks:ke) :: qm, dz
            3256                     
            3257                         real :: a4 (4, ks:ke)
            3258                         real :: pl, pr, delz, esl
            3259                         integer :: k, k0, n, m
            3260                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            3261                     
            3262                         ! -----------------------------------------------------------------------
            3263                         ! density:
            3264                         ! -----------------------------------------------------------------------
            3265                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            3266     1  pp    v          do k = ks, ke
            3267     1   p    v              dz (k) = zt (k) - zt (k + 1) ! note: dz is positive
            3268     1   p    v              q (k) = q (k) * dp (k)
            3269     1   p    v              a4 (1, k) = q (k) / dz (k)
            3270     1   p    v              qm (k) = 0.
            3271     1   p    v          enddo
            3272                     
            3273                         ! -----------------------------------------------------------------------
            3274                         ! construct vertical profile with zt as coordinate
            3275                         ! -----------------------------------------------------------------------
            3276                     
            3277                         call cs_profile (a4 (1, ks), dz (ks), ke - ks + 1, mono)
            3278                     
            3279                         k0 = ks
            3280     1                   do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3281     2                       do n = k0, ke
            3282     3                           if (ze (k) <= zt (n) .and. ze (k) >= zt (n + 1)) then
            3283     3                               pl = (zt (n) - ze (k)) / dz (n)
            3284     4                               if (zt (n + 1) <= ze (k + 1)) then
            3285     4                                   ! entire new grid is within the original grid
            3286     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            3287     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            3288     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            3289     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            3290     4                                   k0 = n
            3291     4                                   goto 555
            3292     4                               else
            3293     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            3294     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            3295     5                                   if (n < ke) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3296     6                                       do m = n + 1, ke
            3297     6                                           ! locate the bottom edge: ze (k + 1)
            3298     7                                           if (ze (k + 1) < zt (m + 1)) then
            3299     7                                               qm (k) = qm (k) + q (m)
            3300     7                                           else
            3301     7                                               delz = zt (m) - ze (k + 1)
            3302     7                                               esl = delz / dz (m)
            3303     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            3304     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            3305     7                                               k0 = m
            3306     7                                               goto 555
            3307     7                                           endif
            3308     6                                       enddo
            3309     5                                   endif
            3310     4                                   goto 555
            3311     4                               endif
            3312     3                           endif
            3313     2                       enddo
            3314     1                       555 continue
            3315     1                   enddo
            3316                     
            3317                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3318     1   s   2s          do k = ks + 1, ke
            3319     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3320     1   p   2v          enddo
            3321                         precip = m1 (ke)
            3322                     
            3323                         ! convert back to * dry * mixing ratio:
            3324                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            3325                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3326     1  pp   2v          do k = ks, ke
            3327     1   p   2v              q (k) = qm (k) / dp (k)
            3328     1   p   2v          enddo
            3329                     
            3330                     end subroutine lagrangian_fall_ppm
            3331                     
            3332                     subroutine cs_profile (a4, del, km, do_mono)
            3333                     
            3334                         implicit none
            3335                     
            3336                         integer, intent (in) :: km ! vertical dimension
            3337                         real, intent (in) :: del (km)
            3338                         logical, intent (in) :: do_mono
            3339                         real, intent (inout) :: a4 (4, km)
            3340                         real, parameter :: qp_min = 1.e-6
            3341                         real :: gam (km)
            3342                         real :: q (km + 1)
            3343                         real :: d4, bet, a_bot, grat, pmp, lac
            3344                         real :: pmp_1, lac_1, pmp_2, lac_2
            3345                         real :: da1, da2, a6da
            3346                     
            3347                         integer :: k
            3348                     
            3349                         logical extm (km)
            3350                     
            3351                         grat = del (2) / del (1) ! grid ratio
            3352                         bet = grat * (grat + 0.5)
            3353                         q (1) = (2. * grat * (grat + 1.) * a4 (1, 1) + a4 (1, 2)) / bet
            3354                         gam (1) = (1. + grat * (grat + 1.5)) / bet
            3355                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 10, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, q, gam, del
                                   <<< Loop-information  End >>>
            3356     1   s   2s          do k = 2, km
            3357     1   p   2v              d4 = del (k - 1) / del (k)
            3358     1   m   2m              bet = 2. + 2. * d4 - gam (k - 1)
            3359     1   m   2m              q (k) = (3. * (a4 (1, k - 1) + d4 * a4 (1, k)) - q (k - 1)) / bet
            3360     1   s   2s              gam (k) = d4 / bet
            3361     1   p   2v          enddo
            3362                     
            3363                         a_bot = 1. + d4 * (d4 + 1.5)
            3364                         q (km + 1) = (2. * d4 * (d4 + 1.) * a4 (1, km) + a4 (1, km - 1) - a_bot * q (km)) &
            3365                              / (d4 * (d4 + 0.5) - a_bot * gam (km))
            3366                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, q
                                   <<< Loop-information  End >>>
            3367     1   s   2s          do k = km, 1, - 1
            3368     1   s   2s              q (k) = q (k) - gam (k) * q (k + 1)
            3369     1   s   2s          enddo
            3370                     
            3371                         ! -----------------------------------------------------------------------
            3372                         ! apply constraints
            3373                         ! -----------------------------------------------------------------------
            3374                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam
                                   <<< Loop-information  End >>>
            3375     1  pp   2v          do k = 2, km
            3376     1   p   2v              gam (k) = a4 (1, k) - a4 (1, k - 1)
            3377     1   p   2v          enddo
            3378                     
            3379                         ! -----------------------------------------------------------------------
            3380                         ! apply large - scale constraints to all fields if not local max / min
            3381                         ! -----------------------------------------------------------------------
            3382                     
            3383                         ! -----------------------------------------------------------------------
            3384                         ! top:
            3385                         ! -----------------------------------------------------------------------
            3386                     
            3387                         q (1) = max (q (1), 0.)
            3388                         q (2) = min (q (2), max (a4 (1, 1), a4 (1, 2)))
            3389                         q (2) = max (q (2), min (a4 (1, 1), a4 (1, 2)), 0.)
            3390                     
            3391                         ! -----------------------------------------------------------------------
            3392                         ! interior:
            3393                         ! -----------------------------------------------------------------------
            3394                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 127
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.62, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, q
                                   <<< Loop-information  End >>>
            3395     1  pp    v          do k = 3, km - 1
            3396     2   p    v              if (gam (k - 1) * gam (k + 1) > 0.) then
            3397     2   p    v                  q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3398     2   p    v                  q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3399     2   p    v              else
            3400     3   p    v                  if (gam (k - 1) > 0.) then
            3401     3                               ! there exists a local max
            3402     3   p    v                      q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3403     3   p    v                  else
            3404     3                               ! there exists a local min
            3405     3   p    v                      q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3406     3   p    v                      q (k) = max (q (k), 0.0)
            3407     3   p    v                  endif
            3408     2   p    v              endif
            3409     1   p    v          enddo
            3410                     
            3411                         ! -----------------------------------------------------------------------
            3412                         ! bottom :
            3413                         ! -----------------------------------------------------------------------
            3414                     
            3415                         q (km) = min (q (km), max (a4 (1, km - 1), a4 (1, km)))
            3416                         q (km) = max (q (km), min (a4 (1, km - 1), a4 (1, km)), 0.)
            3417                         ! q (km + 1) = max (q (km + 1), 0.)
            3418                     
            3419                         ! -----------------------------------------------------------------------
            3420                         ! f (s) = al + s * [ (ar - al) + a6 * (1 - s) ] (0 <= s <= 1)
            3421                         ! -----------------------------------------------------------------------
            3422                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, a4
                                   <<< Loop-information  End >>>
            3423     1  pp   2v          do k = 1, km - 1
            3424     1   p   2v              a4 (2, k) = q (k)
            3425     1   p   2v              a4 (3, k) = q (k + 1)
            3426     1   p   2v          enddo
            3427                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, extm
                                   <<< Loop-information  End >>>
            3428     1  pp   2v          do k = 2, km - 1
            3429     2   p   2v              if (gam (k) * gam (k + 1) > 0.0) then
            3430     2   p   2v                  extm (k) = .false.
            3431     2   p   2v              else
            3432     2   p   2v                  extm (k) = .true.
            3433     2   p   2v              endif
            3434     1   p   2v          enddo
            3435                     
            3436     1                   if (do_mono) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 88
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.98, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, extm
                                   <<< Loop-information  End >>>
            3437     2  pp    v              do k = 3, km - 2
            3438     3   p    v                  if (extm (k)) then
            3439     3                               ! positive definite constraint only if true local extrema
            3440     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3441     4   p    v                          a4 (2, k) = a4 (1, k)
            3442     4   p    v                          a4 (3, k) = a4 (1, k)
            3443     4   p    v                      endif
            3444     3   p    v                  else
            3445     3   p    v                      a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3446     4   p    v                      if (abs (a4 (4, k)) > abs (a4 (2, k) - a4 (3, k))) then
            3447     4                                   ! check within the smooth region if subgrid profile is non - monotonic
            3448     4   p    v                          pmp_1 = a4 (1, k) - 2.0 * gam (k + 1)
            3449     4   p    v                          lac_1 = pmp_1 + 1.5 * gam (k + 2)
            3450     4   p    v                          a4 (2, k) = min (max (a4 (2, k), min (a4 (1, k), pmp_1, lac_1)), &
            3451     4                                       max (a4 (1, k), pmp_1, lac_1))
            3452     4   p    v                          pmp_2 = a4 (1, k) + 2.0 * gam (k)
            3453     4   p    v                          lac_2 = pmp_2 - 1.5 * gam (k - 1)
            3454     4   p    v                          a4 (3, k) = min (max (a4 (3, k), min (a4 (1, k), pmp_2, lac_2)), &
            3455     4                                       max (a4 (1, k), pmp_2, lac_2))
            3456     4   p    v                      endif
            3457     3   p    v                  endif
            3458     2   p    v              enddo
            3459     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extm, a4
                                   <<< Loop-information  End >>>
            3460     2  pp    v              do k = 3, km - 2
            3461     3   p    v                  if (extm (k)) then
            3462     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3463     4   p    v                          a4 (2, k) = a4 (1, k)
            3464     4   p    v                          a4 (3, k) = a4 (1, k)
            3465     4   p    v                      endif
            3466     3   p    v                  endif
            3467     2   p    v              enddo
            3468     1                   endif
            3469                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3470     1  pp   2v          do k = 1, km - 1
            3471     1   p   2v              a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3472     1   p   2v          enddo
            3473                     
            3474                         k = km - 1
            3475     1                   if (extm (k)) then
            3476     1                       a4 (2, k) = a4 (1, k)
            3477     1                       a4 (3, k) = a4 (1, k)
            3478     1                       a4 (4, k) = 0.
            3479     1                   else
            3480     1                       da1 = a4 (3, k) - a4 (2, k)
            3481     1                       da2 = da1 ** 2
            3482     1                       a6da = a4 (4, k) * da1
            3483     2                       if (a6da < - da2) then
            3484     2                           a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3485     2                           a4 (3, k) = a4 (2, k) - a4 (4, k)
            3486     2                       elseif (a6da > da2) then
            3487     2                           a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3488     2                           a4 (2, k) = a4 (3, k) - a4 (4, k)
            3489     2                       endif
            3490     1                   endif
            3491                     
            3492                         call cs_limiters (km - 1, a4)
            3493                     
            3494                         ! -----------------------------------------------------------------------
            3495                         ! bottom layer:
            3496                         ! -----------------------------------------------------------------------
            3497                     
            3498                         a4 (2, km) = a4 (1, km)
            3499                         a4 (3, km) = a4 (1, km)
            3500                         a4 (4, km) = 0.
            3501                     
            3502                     end subroutine cs_profile
            3503                     
            3504                     subroutine cs_limiters (km, a4)
            3505                     
            3506                         implicit none
            3507                     
            3508                         integer, intent (in) :: km
            3509                     
            3510                         real, intent (inout) :: a4 (4, km) ! ppm array
            3511                     
            3512                         real, parameter :: r12 = 1. / 12.
            3513                     
            3514                         integer :: k
            3515                     
            3516                         ! -----------------------------------------------------------------------
            3517                         ! positive definite constraint
            3518                         ! -----------------------------------------------------------------------
            3519                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.59, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3520     1  pp    v          do k = 1, km
            3521     2   p    v              if (abs (a4 (3, k) - a4 (2, k)) < - a4 (4, k)) then
            3522     3   p    v                  if ((a4 (1, k) + 0.25 * (a4 (3, k) - a4 (2, k)) ** 2 / a4 (4, k) + a4 (4, k) * r12) < 0.) then
            3523     4   p    v                      if (a4 (1, k) < a4 (3, k) .and. a4 (1, k) < a4 (2, k)) then
            3524     4   p    v                          a4 (3, k) = a4 (1, k)
            3525     4   p    v                          a4 (2, k) = a4 (1, k)
            3526     4   p    v                          a4 (4, k) = 0.
            3527     4   p    v                      elseif (a4 (3, k) > a4 (2, k)) then
            3528     4   p    v                          a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3529     4   p    v                          a4 (3, k) = a4 (2, k) - a4 (4, k)
            3530     4   p    v                      else
            3531     4   p    v                          a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3532     4   p    v                          a4 (2, k) = a4 (3, k) - a4 (4, k)
            3533     4   p    v                      endif
            3534     3   p    v                  endif
            3535     2   p    v              endif
            3536     1   p    v          enddo
            3537                     
            3538                     end subroutine cs_limiters
            3539                     
            3540                     ! =======================================================================
            3541                     ! calculation of vertical fall speed
            3542                     ! =======================================================================
            3543                     
            3544                     subroutine fall_speed (ks, ke, den, qs, qi, qg, ql, tk, vts, vti, vtg)
            3545                     
            3546                         implicit none
            3547                     
            3548                         integer, intent (in) :: ks, ke
            3549                     
            3550                         real (kind = r8), intent (in), dimension (ks:ke) :: tk
            3551                         real, intent (in), dimension (ks:ke) :: den, qs, qi, qg, ql
            3552                         real, intent (out), dimension (ks:ke) :: vts, vti, vtg
            3553                     
            3554                         ! fall velocity constants:
            3555                     
            3556                         real, parameter :: thi = 1.0e-8 ! cloud ice threshold for terminal fall
            3557                         real, parameter :: thg = 1.0e-8
            3558                         real, parameter :: ths = 1.0e-8
            3559                     
            3560                         real, parameter :: aa = - 4.14122e-5
            3561                         real, parameter :: bb = - 0.00538922
            3562                         real, parameter :: cc = - 0.0516344
            3563                         real, parameter :: dd = 0.00216078
            3564                         real, parameter :: ee = 1.9714
            3565                     
            3566                         ! marshall - palmer constants
            3567                     
            3568                         real, parameter :: vcons = 6.6280504
            3569                         real, parameter :: vcong = 87.2382675
            3570                         real, parameter :: vconh = vcong * sqrt (rhoh / rhog) ! 132.087495104005
            3571                         real, parameter :: norms = 942477796.076938
            3572                         real, parameter :: normg = 5026548245.74367
            3573                         real, parameter :: normh = pi * rhoh * rnzh ! 115233618.533674
            3574                     
            3575                         real, dimension (ks:ke) :: qden, tc, rhof
            3576                     
            3577                         real :: vi0
            3578                         real :: y1, y2, r00, fv
            3579                     
            3580                         integer :: k
            3581                     
            3582                         ! -----------------------------------------------------------------------
            3583                         ! marshall - palmer formula
            3584                         ! -----------------------------------------------------------------------
            3585                     
            3586                         ! -----------------------------------------------------------------------
            3587                         ! try the local air density -- for global model; the true value could be
            3588                         ! much smaller than sfcrho over high mountains
            3589                         ! -----------------------------------------------------------------------
            3590                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.17, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, rhof
                                   <<< Loop-information  End >>>
            3591     1  pp   2v          do k = ks, ke
            3592     1   p   2v              rhof (k) = sqrt (min (10., sfcrho / den (k)))
            3593     1   p   2v          enddo
            3594                     
            3595                         ! -----------------------------------------------------------------------
            3596                         ! ice:
            3597                         ! -----------------------------------------------------------------------
            3598                     
            3599     1                   if (const_vi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vti
                                   <<< Loop-information  End >>>
            3600     1  pp   4v              vti (:) = vi_fac
            3601     1                   else
            3602     1                       ! -----------------------------------------------------------------------
            3603     1                       ! use deng and mace (2008, grl), which gives smaller fall speed than hd90 formula
            3604     1                       ! -----------------------------------------------------------------------
            3605     1                       vi0 = 0.01 * vi_fac
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, vti
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3606     2   s    s              do k = ks, ke
            3607     3   p    v                  if (qi (k) < thi) then ! this is needed as the fall - speed maybe problematic for small qi
            3608     3   m    m                      vti (k) = vf_min
            3609     3   p    v                  else
            3610     3   s    s                      tc (k) = tk (k) - tice
            3611     4   m    m                      if (hd_icefall) then
            3612     4                                   ! heymsfield and donner, 1990, jas
            3613     4   m    m                          vti (k) = vi_fac * 3.29 * (qi (k) * den (k)) ** 0.16
            3614     4   m    m                      elseif (gce_icefall) then
            3615     4                                   ! new codes from Steve's in cgs, module_mp_gsfcgce_4ice_nuwrf.f90
            3616     4   s    s                          vti (k) = 0.
            3617     4   s    s                          y1 = qi (k) * den (k) * 1000.   ! g/cm^3
            3618     5   s    s                          if (y1 .ge. 1.e-6) then
            3619     5   s    s                              y1 = qi (k)
            3620     5   s    s                              y2 = ql (k)
            3621     5   s    s                              r00 = den (k) / 1000.  !g/cm^3
            3622     5   s    s                              fv = sqrt (1.29 / ( den(k) * 1000.))
            3623     5   s    s                              call vqrqi (2, r00, fv, y1, y2, tk (k), vti (k))
            3624     5   s    s                          endif
            3625     4   m    m                          vti (k) = vti (k) * 0.01  !convert back to m/s
            3626     4   s    s                      else
            3627     4                                   ! deng and mace, 2008, grl
            3628     4   s    s                          vti (k) = (3. + log10 (qi (k) * den (k))) * (tc (k) * (aa * tc (k) + bb) + cc) + dd * tc (k) + ee
            3629     4   m    m                          vti (k) = vi0 * exp (log_10 * vti (k))
            3630     4   p    v                      endif
            3631     3   m    s                      vti (k) = min (vi_max, max (vf_min, vti (k)))
            3632     3   p    v                  endif
            3633     2   p    v              enddo
            3634     1                   endif
            3635                     
            3636                         ! -----------------------------------------------------------------------
            3637                         ! snow:
            3638                         ! -----------------------------------------------------------------------
            3639                     
            3640     1                   if (const_vs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vts
                                   <<< Loop-information  End >>>
            3641     1  pp   4v              vts (:) = vs_fac ! 1. ifs_2016
            3642     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, den, rhof, vts
                                   <<< Loop-information  End >>>
            3643     2  pp    v              do k = ks, ke
            3644     3   p    v                  if (qs (k) < ths) then
            3645     3   p    v                      vts (k) = vf_min
            3646     3   p    v                  else
            3647     3   p    v                      vts (k) = vs_fac * vcons * rhof (k) * exp (0.0625 * log (qs (k) * den (k) / norms))
            3648     3   p    v                      vts (k) = min (vs_max, max (vf_min, vts (k)))
            3649     3   p    v                  endif
            3650     2   p    v              enddo
            3651     1                   endif
            3652                     
            3653                         ! -----------------------------------------------------------------------
            3654                         ! graupel:
            3655                         ! -----------------------------------------------------------------------
            3656                     
            3657     1                   if (const_vg) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtg
                                   <<< Loop-information  End >>>
            3658     1  pp   4v              vtg (:) = vg_fac ! 2.
            3659     1                   else
            3660     2                       if (do_hail) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3661     3  pp    v                  do k = ks, ke
            3662     4   p    v                      if (qg (k) < thg) then
            3663     4   p    v                          vtg (k) = vf_min
            3664     4   p    v                      else
            3665     4   p    v                          vtg (k) = vg_fac * vconh * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normh)))
            3666     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3667     4   p    v                      endif
            3668     3   p    v                  enddo
            3669     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3670     3  pp    v                  do k = ks, ke
            3671     4   p    v                      if (qg (k) < thg) then
            3672     4   p    v                          vtg (k) = vf_min
            3673     4   p    v                      else
            3674     4   p    v                          vtg (k) = vg_fac * vcong * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normg)))
            3675     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3676     4   p    v                      endif
            3677     3   p    v                  enddo
            3678     2                       endif
            3679     1                   endif
            3680                     
            3681                     end subroutine fall_speed
            3682                     
            3683                     ! =======================================================================
            3684                     ! setup gfdl cloud microphysics parameters
            3685                     ! =======================================================================
            3686                     
            3687                     subroutine setupm
            3688                     
            3689                         implicit none
            3690                     
            3691                         real :: gcon, cd, scm3, pisq, act (8)
            3692                         real :: vdifu, tcond
            3693                         real :: visk
            3694                         real :: ch2o, hltf
            3695                         real :: hlts, hltc, ri50
            3696                     
            3697                         real, parameter :: gam263 = 1.456943, gam275 = 1.608355, gam290 = 1.827363, &
            3698                             gam325 = 2.54925, gam350 = 3.323363, gam380 = 4.694155, &
            3699                             gam425 = 8.285063, gam450 = 11.631769, gam480 = 17.837789, &
            3700                             gam625 = 184.860962, gam680 = 496.604067
            3701                     
            3702                         real, parameter :: acc (3) = (/ 5.0, 2.0, 0.5 /)
            3703                     
            3704                         real den_rc
            3705                     
            3706                         integer :: i, k
            3707                     
            3708                         pie = 4. * atan (1.0)
            3709                     
            3710                         ! s. klein's formular (eq 16) from am2
            3711                     
            3712                         fac_rc = (4. / 3.) * pie * rhor * rthresh ** 3
            3713                     
            3714     1                   if (prog_ccn) then
            3715     1                       ! if (master) write (*, *) 'prog_ccn option is .t.'
            3716     1                   else
            3717     1                       den_rc = fac_rc * ccn_o * 1.e6
            3718     1                       ! if (master) write (*, *) 'mp: for ccn_o = ', ccn_o, 'ql_rc = ', den_rc
            3719     1                       den_rc = fac_rc * ccn_l * 1.e6
            3720     1                       ! if (master) write (*, *) 'mp: for ccn_l = ', ccn_l, 'ql_rc = ', den_rc
            3721     1                   endif
            3722                     
            3723                         vdifu = 2.11e-5
            3724                         tcond = 2.36e-2
            3725                     
            3726                         visk = 1.259e-5
            3727                         hlts = hlv + hlf
            3728                         hltc = hlv
            3729                         hltf = hlf
            3730                     
            3731                         ch2o = c_liq
            3732                         ri50 = 1.e-4
            3733                     
            3734                         pisq = pie * pie
            3735                         scm3 = (visk / vdifu) ** (1. / 3.)
            3736                     
            3737                         cracs = pisq * rnzr * rnzs * rhos
            3738                         csacr = pisq * rnzr * rnzs * rhor
            3739     1                   if (do_hail) then
            3740     1                       cgacr = pisq * rnzr * rnzh * rhor
            3741     1                       cgacs = pisq * rnzh * rnzs * rhos
            3742     1                   else
            3743     1                       cgacr = pisq * rnzr * rnzg * rhor
            3744     1                       cgacs = pisq * rnzg * rnzs * rhos
            3745     1                   endif
            3746                         cgacs = cgacs * c_pgacs
            3747                     
            3748                         ! act: 1 - 2:racs (s - r) ; 3 - 4:sacr (r - s) ;
            3749                         ! 5 - 6:gacr (r - g) ; 7 - 8:gacs (s - g)
            3750                     
            3751                         act (1) = pie * rnzs * rhos
            3752                         act (2) = pie * rnzr * rhor
            3753     1                   if (do_hail) then
            3754     1                       act (6) = pie * rnzh * rhoh
            3755     1                   else
            3756     1                       act (6) = pie * rnzg * rhog
            3757     1                   endif
            3758                         act (3) = act (2)
            3759                         act (4) = act (1)
            3760                         act (5) = act (2)
            3761                         act (7) = act (1)
            3762                         act (8) = act (6)
            3763                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<< Loop-information  End >>>
            3764     1   s    v          do i = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3765     2   p   fv              do k = 1, 4
            3766     2   p   fv                  acco (i, k) = acc (i) / (act (2 * k - 1) ** ((7 - i) * 0.25) * act (2 * k) ** (i * 0.25))
            3767     2   p   fv              enddo
            3768     1   p    v          enddo
            3769                     
            3770                         gcon = 40.74 * sqrt (sfcrho) ! 44.628
            3771                     
            3772                         csacw = pie * rnzs * clin * gam325 / (4. * act (1) ** 0.8125)
            3773                         ! decreasing csacw to reduce cloud water --- > snow
            3774                     
            3775                         craci = pie * rnzr * alin * gam380 / (4. * act (2) ** 0.95)
            3776                         csaci = csacw * c_psaci
            3777                     
            3778     1                   if (do_hail) then
            3779     1                       cgacw = pie * rnzh * gam350 * gcon / (4. * act (6) ** 0.875)
            3780     1                   else
            3781     1                       cgacw = pie * rnzg * gam350 * gcon / (4. * act (6) ** 0.875)
            3782     1                   endif
            3783                         ! cgaci = cgacw * 0.1
            3784                     
            3785                         ! sjl, may 28, 2012
            3786                         cgaci = cgacw * 0.05
            3787                         ! sjl, may 28, 2012
            3788                     
            3789                         cracw = craci ! cracw = 3.27206196043822
            3790                         cracw = c_cracw * cracw
            3791                     
            3792                         ! subl and revp: five constants for three separate processes
            3793                     
            3794                         cssub (1) = 2. * pie * vdifu * tcond * rvgas * rnzs
            3795     1                   if (do_hail) then
            3796     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzh
            3797     1                   else
            3798     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzg
            3799     1                   endif
            3800                         crevp (1) = 2. * pie * vdifu * tcond * rvgas * rnzr
            3801                         cssub (2) = 0.78 / sqrt (act (1))
            3802                         cgsub (2) = 0.78 / sqrt (act (6))
            3803                         crevp (2) = 0.78 / sqrt (act (2))
            3804                         cssub (3) = 0.31 * scm3 * gam263 * sqrt (clin / visk) / act (1) ** 0.65625
            3805                         cgsub (3) = 0.31 * scm3 * gam275 * sqrt (gcon / visk) / act (6) ** 0.6875
            3806                         crevp (3) = 0.31 * scm3 * gam290 * sqrt (alin / visk) / act (2) ** 0.725
            3807                         cssub (4) = tcond * rvgas
            3808                         cssub (5) = hlts ** 2 * vdifu
            3809                         cgsub (4) = cssub (4)
            3810                         crevp (4) = cssub (4)
            3811                         cgsub (5) = cssub (5)
            3812                         crevp (5) = hltc ** 2 * vdifu
            3813                     
            3814                         cgfr (1) = 20.e2 * pisq * rnzr * rhor / act (2) ** 1.75
            3815                         cgfr (2) = 0.66
            3816                     
            3817                         ! smlt: five constants (lin et al. 1983)
            3818                     
            3819                         csmlt (1) = 2. * pie * tcond * rnzs / hltf
            3820                         csmlt (2) = 2. * pie * vdifu * rnzs * hltc / hltf
            3821                         csmlt (3) = cssub (2)
            3822                         csmlt (4) = cssub (3)
            3823                         csmlt (5) = ch2o / hltf
            3824                     
            3825                         ! gmlt: five constants
            3826                     
            3827     1                   if (do_hail) then
            3828     1                       cgmlt (1) = 2. * pie * tcond * rnzh / hltf
            3829     1                       cgmlt (2) = 2. * pie * vdifu * rnzh * hltc / hltf
            3830     1                   else
            3831     1                       cgmlt (1) = 2. * pie * tcond * rnzg / hltf
            3832     1                       cgmlt (2) = 2. * pie * vdifu * rnzg * hltc / hltf
            3833     1                   endif
            3834                         cgmlt (3) = cgsub (2)
            3835                         cgmlt (4) = cgsub (3)
            3836                         cgmlt (5) = ch2o / hltf
            3837                     
            3838                         es0 = e00
            3839                         ces0 = eps * es0
            3840                     
            3841                     end subroutine setupm
            3842                     

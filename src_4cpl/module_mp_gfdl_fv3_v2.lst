            3929                     
            3930                     ! =======================================================================
            3931                     ! accretion function (lin et al. 1983)
            3932                     ! =======================================================================
            3933                     
            3934                     real function acr3d (v1, v2, q1, q2, c, cac, rho)
            3935                     
            3936                         implicit none
            3937                     
            3938                         real, intent (in) :: v1, v2, c, rho
            3939                         real, intent (in) :: q1, q2 ! mixing ratio!!!
            3940                         real, intent (in) :: cac (3)
            3941                     
            3942                         real :: t1, s1, s2
            3943                     
            3944                         ! integer :: k
            3945                         !
            3946                         ! real :: a
            3947                         !
            3948                         ! a = 0.0
            3949                         ! do k = 1, 3
            3950                         ! a = a + cac (k) * ((q1 * rho) ** ((7 - k) * 0.25) * (q2 * rho) ** (k * 0.25))
            3951                         ! enddo
            3952                         ! acr3d = c * abs (v1 - v2) * a / rho
            3953                     
            3954                         ! optimized
            3955                     
            3956                         t1 = sqrt (q1 * rho)
            3957                         s1 = sqrt (q2 * rho)
            3958                         s2 = sqrt (s1) ! s1 = s2 ** 2
            3959                         acr3d = c * abs (v1 - v2) * q1 * s2 * (cac (1) * t1 + cac (2) * sqrt (t1) * s2 + cac (3) * s1)
            3960                     
            3961                     end function acr3d
            3962                     
            3963                     ! =======================================================================
            3964                     ! melting of snow function (lin et al. 1983)
            3965                     ! note: psacw and psacr must be calc before smlt is called
            3966                     ! =======================================================================
            3967                     
            3968                     real function smlt (tc, dqs, qsrho, psacw, psacr, c, rho, rhofac)
            3969                     
            3970                         implicit none
            3971                     
            3972                         real, intent (in) :: tc, dqs, qsrho, psacw, psacr, c (5), rho, rhofac
            3973                     
            3974                         smlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qsrho) + &
            3975                             c (4) * qsrho ** 0.65625 * sqrt (rhofac)) + c (5) * tc * (psacw + psacr)
            3976                     
            3977                     end function smlt
            3978                     
            3979                     ! =======================================================================
            3980                     ! melting of graupel function (lin et al. 1983)
            3981                     ! note: pgacw and pgacr must be calc before gmlt is called
            3982                     ! =======================================================================
            3983                     
            3984                     real function gmlt (tc, dqs, qgrho, pgacw, pgacr, c, rho)
            3985                     
            3986                         implicit none
            3987                     
            3988                         real, intent (in) :: tc, dqs, qgrho, pgacw, pgacr, c (5), rho
            3989                     
            3990                         gmlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qgrho) + &
            3991                             c (4) * qgrho ** 0.6875 / rho ** 0.25) + c (5) * tc * (pgacw + pgacr)
            3992                     
            3993                     end function gmlt
            3994                     
            3995                     ! =======================================================================
            3996                     ! initialization
            3997                     ! prepare saturation water vapor pressure tables
            3998                     ! =======================================================================
            3999                     
            4000                     subroutine qsmith_init
            4001                     
            4002                         implicit none
            4003                     
            4004                         integer, parameter :: length = 2621
            4005                     
            4006                         integer :: i
            4007                     
            4008     1                   if (.not. tables_are_initialized) then
            4009     1               
            4010     1                       allocate (table (length))
            4011     1                       allocate (table2 (length))
            4012     1                       allocate (table3 (length))
            4013     1                       allocate (tablew (length))
            4014     1                       allocate (des (length))
            4015     1                       allocate (des2 (length))
            4016     1                       allocate (des3 (length))
            4017     1                       allocate (desw (length))
            4018     1               
            4019     1                       call qs_table (length)
            4020     1                       call qs_table2 (length)
            4021     1                       call qs_table3 (length)
            4022     1    i                  call qs_tablew (length)
            4023     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.62, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3, table2, table, tablew, des, des3
                                   <<<      desw, des2
                                   <<< Loop-information  End >>>
            4024     2  pp    v              do i = 1, length - 1
            4025     2   p    v                  des (i) = max (0., table (i + 1) - table (i))
            4026     2   p    v                  des2 (i) = max (0., table2 (i + 1) - table2 (i))
            4027     2   p    v                  des3 (i) = max (0., table3 (i + 1) - table3 (i))
            4028     2   p    v                  desw (i) = max (0., tablew (i + 1) - tablew (i))
            4029     2   p    v              enddo
            4030     1                       des (length) = des (length - 1)
            4031     1                       des2 (length) = des2 (length - 1)
            4032     1                       des3 (length) = des3 (length - 1)
            4033     1                       desw (length) = desw (length - 1)
            4034     1               
            4035     1                       tables_are_initialized = .true.
            4036     1               
            4037     1                   endif
            4038                     
            4039                     end subroutine qsmith_init
            4040                     
            4041                     ! =======================================================================
            4042                     ! compute the saturated specific humidity for table ii
            4043                     ! =======================================================================
            4044                     
            4045                     real function wqs1 (ta, den)
            4046                     
            4047                         implicit none
            4048                     
            4049                         ! pure water phase; universal dry / moist formular using air density
            4050                         ! input "den" can be either dry or moist air density
            4051                     
            4052                         real, intent (in) :: ta, den
            4053                     
            4054                         real :: es, ap1, tmin
            4055                     
            4056                         integer :: it
            4057                     
            4058                         tmin = table_ice - 160.
            4059                         ap1 = 10. * dim (ta, tmin) + 1.
            4060                         ap1 = min (2621., ap1)
            4061                         it = ap1
            4062                         es = tablew (it) + (ap1 - it) * desw (it)
            4063                         wqs1 = es / (rvgas * ta * den)
            4064                     
            4065                     end function wqs1
            4066                     
            4067                     ! =======================================================================
            4068                     ! compute the gradient of saturated specific humidity for table ii
            4069                     ! =======================================================================
            4070                     
            4071                     real function wqs2 (ta, den, dqdt)
            4072                     
            4073                         implicit none
            4074                     
            4075                         ! pure water phase; universal dry / moist formular using air density
            4076                         ! input "den" can be either dry or moist air density
            4077                     
            4078                         real, intent (in) :: ta, den
            4079                         real, intent (out) :: dqdt
            4080                         real :: es, ap1, tmin
            4081                         integer :: it
            4082                     
            4083                         tmin = table_ice - 160.
            4084                     
            4085                         if (.not. tables_are_initialized) call qsmith_init
            4086                     
            4087                         ap1 = 10. * dim (ta, tmin) + 1.
            4088                         ap1 = min (2621., ap1)
            4089                         it = ap1
            4090                         es = tablew (it) + (ap1 - it) * desw (it)
            4091                         wqs2 = es / (rvgas * ta * den)
            4092                         it = ap1 - 0.5
            4093                         ! finite diff, del_t = 0.1:
            4094                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            4095                     
            4096                     end function wqs2
            4097                     
            4098                     !xb141 >>>>>>
            4099                     ! =======================================================================
            4100                     ! compute the gradient of saturated specific humidity for table ii
            4101                     ! which is tuned by rhc
            4102                     ! =======================================================================
            4103                     real function wqs2_rhc (ta, den, rhc, dqdt)
            4104                     
            4105                         implicit none
            4106                     
            4107                         ! pure water phase; universal dry / moist formular using air density
            4108                         ! input "den" can be either dry or moist air density
            4109                     
            4110                         real, intent (in) :: ta, den, rhc
            4111                         real, intent (out) :: dqdt
            4112                         real :: es, ap1, tmin
            4113                         integer :: it
            4114                     
            4115                         tmin = table_ice - 160.
            4116                     
            4117                         if (.not. tables_are_initialized) call qsmith_init
            4118                     
            4119                         ap1 = 10. * dim (ta, tmin) + 1.
            4120                         ap1 = min (2621., ap1)
            4121                         it = ap1
            4122                         es = tablew (it) + (ap1 - it) * desw (it)
            4123                         wqs2_rhc = es / (rvgas * ta * den) * rhc
            4124                         it = ap1 - 0.5
            4125                         ! finite diff, del_t = 0.1:
            4126                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            4127                     
            4128                     end function wqs2_rhc
            4129                     !xb141 <<<<<
            4130                     
            4131                     ! =======================================================================
            4132                     ! =======================================================================
            4133                     ! compute the gradient of saturated specific humidity for table ii
            4134                     ! it is the same as "wqs2", but written as vector function
            4135                     ! =======================================================================
            4136                     
            4137                     subroutine wqs2_vect (is, ie, ta, den, wqsat, dqdt)
            4138                     
            4139                         implicit none
            4140                     
            4141                         ! pure water phase; universal dry / moist formular using air density
            4142                         ! input "den" can be either dry or moist air density
            4143                     
            4144                         integer, intent (in) :: is, ie
            4145                     
            4146                         real, intent (in), dimension (is:ie) :: ta, den
            4147                     
            4148                         real, intent (out), dimension (is:ie) :: wqsat, dqdt
            4149                     
            4150                         real :: es, ap1, tmin
            4151                     
            4152                         integer :: i, it
            4153                     
            4154                         tmin = t_ice - 160.
            4155                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.90, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, den, wqsat, dqdt
                                   <<< Loop-information  End >>>
            4156     1  pp    v          do i = is, ie
            4157     1   p    v              ap1 = 10. * dim (ta (i), tmin) + 1.
            4158     1   p    v              ap1 = min (2621., ap1)
            4159     1   p    v              it = ap1
            4160     1   p    v              es = tablew (it) + (ap1 - it) * desw (it)
            4161     1   p    v              wqsat (i) = es / (rvgas * ta (i) * den (i))
            4162     1   p    v              it = ap1 - 0.5
            4163     1                       ! finite diff, del_t = 0.1:
            4164     1   p    v              dqdt (i) = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta (i) * den (i))
            4165     1   p    v          enddo
            4166                     
            4167                     end subroutine wqs2_vect
            4168                     
            4169                     ! =======================================================================
            4170                     ! compute wet buld temperature
            4171                     ! =======================================================================
            4172                     
            4173                     real function wet_bulb (q, t, den)
            4174                     
            4175                         implicit none
            4176                     
            4177                         real, intent (in) :: t, q, den
            4178                     
            4179                         real :: qs, tp, dqdt
            4180                     
            4181                         wet_bulb = t
            4182          i              qs = wqs2 (wet_bulb, den, dqdt)
            4183                         tp = 0.5 * (qs - q) / (1. + lcp * dqdt) * lcp
            4184                         wet_bulb = wet_bulb - tp
            4185                     
            4186                         ! tp is negative if super - saturated
            4187     1                   if (tp > 0.01) then
            4188     1    i                  qs = wqs2 (wet_bulb, den, dqdt)
            4189     1                       tp = (qs - q) / (1. + lcp * dqdt) * lcp
            4190     1                       wet_bulb = wet_bulb - tp
            4191     1                   endif
            4192                     
            4193                     end function wet_bulb
            4194                     
            4195                     ! =======================================================================
            4196                     ! compute the saturated specific humidity for table iii
            4197                     ! =======================================================================
            4198                     
            4199                     real function iqs1 (ta, den)
            4200                     
            4201                         implicit none
            4202                     
            4203                         ! water - ice phase; universal dry / moist formular using air density
            4204                         ! input "den" can be either dry or moist air density
            4205                     
            4206                         real, intent (in) :: ta, den
            4207                     
            4208                         real :: es, ap1, tmin
            4209                     
            4210                         integer :: it
            4211                     
            4212                         tmin = table_ice - 160.
            4213                         ap1 = 10. * dim (ta, tmin) + 1.
            4214                         ap1 = min (2621., ap1)
            4215                         it = ap1
            4216                         es = table2 (it) + (ap1 - it) * des2 (it)
            4217                         iqs1 = es / (rvgas * ta * den)
            4218                     
            4219                     end function iqs1
            4220                     
            4221                     ! =======================================================================
            4222                     ! compute the gradient of saturated specific humidity for table iii
            4223                     ! =======================================================================
            4224                     
            4225                     real function iqs2 (ta, den, dqdt)
            4226                     
            4227                         implicit none
            4228                     
            4229                         ! water - ice phase; universal dry / moist formular using air density
            4230                         ! input "den" can be either dry or moist air density
            4231                     
            4232                         real (kind = r8), intent (in) :: ta
            4233                         real, intent (in) :: den
            4234                         real, intent (out) :: dqdt
            4235                         real (kind = r8) :: tmin, es, ap1
            4236                         integer :: it
            4237                     
            4238                         tmin = table_ice - 160.
            4239                         ap1 = 10. * dim (ta, tmin) + 1.
            4240                         ap1 = min (2621., ap1)
            4241                         it = ap1
            4242                         es = table2 (it) + (ap1 - it) * des2 (it)
            4243                         iqs2 = es / (rvgas * ta * den)
            4244                         it = ap1 - 0.5
            4245                         dqdt = 10. * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) / (rvgas * ta * den)
            4246                     
            4247                     end function iqs2
            4248                     
            4249                     ! =======================================================================
            4250                     ! compute the gradient of saturated specific humidity for table iii
            4251                     ! =======================================================================
            4252                     
            4253                     real function qs1d_moist (ta, qv, pa, dqdt)
            4254                     
            4255                         implicit none
            4256                     
            4257                         real, intent (in) :: ta, pa, qv
            4258                     
            4259                         real, intent (out) :: dqdt
            4260                     
            4261                         real :: es, ap1, tmin, eps10
            4262                     
            4263                         integer :: it
            4264                     
            4265                         tmin = table_ice - 160.
            4266                         eps10 = 10. * eps
            4267                         ap1 = 10. * dim (ta, tmin) + 1.
            4268                         ap1 = min (2621., ap1)
            4269                         it = ap1
            4270                         es = table2 (it) + (ap1 - it) * des2 (it)
            4271                         qs1d_moist = eps * es * (1. + zvir * qv) / pa
            4272                         it = ap1 - 0.5
            4273                         dqdt = eps10 * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) * (1. + zvir * qv) / pa
            4274                     
            4275                     end function qs1d_moist
            4276                     
            4277                     ! =======================================================================
            4278                     ! compute the gradient of saturated specific humidity for table ii
            4279                     ! =======================================================================
            4280                     
            4281                     real function wqsat2_moist (ta, qv, pa, dqdt)
            4282                     
            4283                         implicit none
            4284                     
            4285                         real, intent (in) :: ta, pa, qv
            4286                     

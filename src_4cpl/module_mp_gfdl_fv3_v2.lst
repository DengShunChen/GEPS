            2705                     subroutine terminal_fall (dtm, ks, ke, tz, qv, ql, qr, qg, qs, qi, dz, dp, &
            2706                             den, vtg, vts, vti, r1, g1, s1, i1, pfr, pfi, pfs, pfg, m1_sol, w1, dte)
            2707                     
            2708                         implicit none
            2709                     
            2710                         integer, intent (in) :: ks, ke

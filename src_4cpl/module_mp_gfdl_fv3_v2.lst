            4365                     
            4366                     real function d_sat (ta, den)
            4367                     
            4368                         implicit none
            4369                     
            4370                         real, intent (in) :: ta, den
            4371                     
            4372                         real :: es_w, es_i, ap1, tmin
            4373                     
            4374                         integer :: it
            4375                     
            4376                         tmin = table_ice - 160.

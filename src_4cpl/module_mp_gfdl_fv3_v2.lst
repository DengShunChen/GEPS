            4747                     ! =======================================================================
            4748                     ! compute the saturated specific humidity and the gradient of saturated specific humidity
            4749                     ! input t in deg k, p in pa; p = rho rdry tv, moist pressure
            4750                     ! =======================================================================
            4751                     
            4752                     subroutine qsmith (im, km, ks, t, p, q, qs, dqdt)
            4753                     
            4754                         implicit none
            4755                     
            4756                         integer, intent (in) :: im, km, ks
            4757                     
            4758                         real, intent (in), dimension (im, km) :: t, p, q
            4759                     
            4760                         real, intent (out), dimension (im, km) :: qs
            4761                     
            4762                         real, intent (out), dimension (im, km), optional :: dqdt
            4763                     
            4764                         real :: eps10, ap1, tmin
            4765                     
            4766                         real, dimension (im, km) :: es
            4767                     
            4768                         integer :: i, k, it
            4769                     
            4770                         tmin = table_ice - 160.
            4771                         eps10 = 10. * eps
            4772                     
            4773     1                   if (.not. tables_are_initialized) then
            4774     1                       call qsmith_init
            4775     1                   endif
            4776                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, es, qs
                                   <<< Loop-information  End >>>
            4777     1  pp               do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, p, t, qs, es
                                   <<< Loop-information  End >>>
            4778     2   p    v              do i = 1, im
            4779     2   p    v                  ap1 = 10. * dim (t (i, k), tmin) + 1.
            4780     2   p    v                  ap1 = min (2621., ap1)
            4781     2   p    v                  it = ap1
            4782     2   p    v                  es (i, k) = table (it) + (ap1 - it) * des (it)
            4783     2   p    v                  qs (i, k) = eps * es (i, k) * (1. + zvir * q (i, k)) / p (i, k)
            4784     2   p    v              enddo
            4785     1   p               enddo
            4786                     
            4787     1                   if (present (dqdt)) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, dqdt
                                   <<< Loop-information  End >>>
            4788     2  pp                   do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, p, dqdt
                                   <<< Loop-information  End >>>
            4789     3   p    v                  do i = 1, im
            4790     3   p    v                      ap1 = 10. * dim (t (i, k), tmin) + 1.
            4791     3   p    v                      ap1 = min (2621., ap1) - 0.5
            4792     3   p    v                      it = ap1
            4793     3   p    v                      dqdt (i, k) = eps10 * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) * (1. + zvir * q (i, k)) / p (i, k)
            4794     3   p    v                  enddo
            4795     2   p                   enddo
            4796     1                   endif
            4797                     
            4798                     end subroutine qsmith
            4799                     
            4800                     ! =======================================================================
            4801                     ! fix negative water species
            4802                     ! this is designed for 6 - class micro - physics schemes
            4803                     ! =======================================================================
            4804                     
            4805                     subroutine neg_adj (ks, ke, pt, dp, qv, ql, qr, qi, qs, qg, cond)
            4806                     
            4807                         implicit none
            4808                     
            4809                         integer, intent (in) :: ks, ke
            4810                         real, intent (in), dimension (ks:ke) :: dp
            4811                         real (kind = r8), intent (inout), dimension (ks:ke) :: pt
            4812                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4813                         real, intent (out) :: cond
            4814                     
            4815                         real, dimension (ks:ke) :: lcpk, icpk
            4816                     
            4817                         real :: dq, cvm
            4818                     
            4819                         integer :: k
            4820                     
            4821                         ! -----------------------------------------------------------------------
            4822                         ! define heat capacity and latent heat coefficient
            4823                         ! -----------------------------------------------------------------------
            4824                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg, pt, qv, qr, ql, lcpk, qi, qs, icpk
                                   <<< Loop-information  End >>>
            4825     1  pp    v          do k = ks, ke
            4826     1   p    v              cvm = 1. + qv (k) * c1_vap + (qr (k) + ql (k)) * c1_liq + (qi (k) + qs (k) + qg (k)) * c1_ice
            4827     1   p    v              lcpk (k) = (lv00 + d1_vap * pt (k)) / cvm
            4828     1   p    v              icpk (k) = (li00 + d1_ice * pt (k)) / cvm
            4829     1   p    v          enddo
            4830                     
            4831                         cond = 0
            4832                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 121
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4833     1  pp    v          do k = ks, ke
            4834     1               
            4835     1                       ! -----------------------------------------------------------------------
            4836     1                       ! ice phase:
            4837     1                       ! -----------------------------------------------------------------------
            4838     1               
            4839     1                       ! if cloud ice < 0, borrow from snow
            4840     2   p    v              if (qi (k) < 0.) then
            4841     2   p    v                  qs (k) = qs (k) + qi (k)
            4842     2   p    v                  qi (k) = 0.
            4843     2   p    v              endif
            4844     1                       ! if snow < 0, borrow from graupel
            4845     2   p    v              if (qs (k) < 0.) then
            4846     2   p    v                  qg (k) = qg (k) + qs (k)
            4847     2   p    v                  qs (k) = 0.
            4848     2   p    v              endif
            4849     1                       ! if graupel < 0, borrow from rain
            4850     2   p    v              if (qg (k) < 0.) then
            4851     2   p    v                  qr (k) = qr (k) + qg (k)
            4852     2   p    v                  pt (k) = pt (k) - qg (k) * icpk (k) ! heating
            4853     2   p    v                  qg (k) = 0.
            4854     2   p    v              endif
            4855     1               
            4856     1                       ! -----------------------------------------------------------------------
            4857     1                       ! liquid phase:
            4858     1                       ! -----------------------------------------------------------------------
            4859     1               
            4860     1                       ! if rain < 0, borrow from cloud water
            4861     2   p    v              if (qr (k) < 0.) then
            4862     2   p    v                  ql (k) = ql (k) + qr (k)
            4863     2   p    v                  qr (k) = 0.
            4864     2   p    v              endif
            4865     1                       ! if cloud water < 0, borrow from water vapor
            4866     2   p    v              if (ql (k) < 0.) then
            4867     2   p    v                  cond = cond - ql (k) * dp (k)
            4868     2   p    v                  qv (k) = qv (k) + ql (k)
            4869     2   p    v                  pt (k) = pt (k) - ql (k) * lcpk (k) ! heating
            4870     2   p    v                  ql (k) = 0.
            4871     2   p    v              endif
            4872     1               
            4873     1   p    v          enddo
            4874                     
            4875                         ! -----------------------------------------------------------------------
            4876                         ! fix water vapor; borrow from below
            4877                         ! -----------------------------------------------------------------------
            4878                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            4879     1   s   2s          do k = ks, ke - 1
            4880     2   s   2m              if (qv (k) < 0.) then
            4881     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            4882     2   s   2v                  qv (k) = 0.
            4883     2   s   2v              endif
            4884     1   s   2v          enddo
            4885                     
            4886                         ! -----------------------------------------------------------------------
            4887                         ! bottom layer; borrow from above
            4888                         ! -----------------------------------------------------------------------
            4889                     
            4890     1                   if (qv (ke) < 0. .and. qv (ke - 1) > 0.) then
            4891     1                       dq = min (- qv (ke) * dp (ke), qv (ke - 1) * dp (ke - 1))
            4892     1                       qv (ke - 1) = qv (ke - 1) - dq / dp (ke - 1)
            4893     1                       qv (ke) = qv (ke) + dq / dp (ke)
            4894     1                   endif
            4895                     
            4896                     end subroutine neg_adj
            4897                     
            4898                     !-------------------------------------------------------------------
            4899                           SUBROUTINE semi_lagrange_sedim(km,dzl,wwl,rql,precip,pfsan,dt,R1)
            4900                     !-------------------------------------------------------------------
            4901                     !
            4902                     ! This routine is a semi-Lagrangain forward advection for hydrometeors
            4903                     ! with mass conservation and positive definite advection
            4904                     ! 2nd order interpolation with monotonic piecewise parabolic method is used.
            4905                     ! This routine is under assumption of decfl < 1 for semi_Lagrangian
            4906                     !
            4907                     ! km     number of layers
            4908                     ! dzl    depth of model layer in meter (m)
            4909                     ! wwl    terminal velocity at model layer (m/s)
            4910                     ! rql    dry air density*mixing ratio
            4911                     ! precip precipitation at surface (mm)
            4912                     ! pfsan  precipitation fluxes (mm?)
            4913                     ! dt     time step (s)
            4914                     ! R1     minimum q, =1.E-12 in new Thompson MP
            4915                     !
            4916                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            4917                     !         implemented by song-you hong
            4918                     ! reference: Juang, H.-M., and S.-Y. Hong, 2010: Forward semi-Lagrangian advection
            4919                     !         with mass conservation and positive definiteness for falling
            4920                     !         hydrometeors. *Mon.  Wea. Rev.*, *138*, 1778-1791
            4921                     !
            4922                           implicit none
            4923                     
            4924                           integer, intent(in) :: km
            4925                           real, intent(in) ::  dt, R1
            4926                           real, intent(in) :: dzl(km),wwl(km)
            4927                           real, intent(out) :: precip
            4928                           real, intent(inout) :: rql(km)
            4929                           real, intent(out)  :: pfsan(km)
            4930                           integer  k,m,kk,kb,kt
            4931                           real  tl,tl2,qql,dql,qqd
            4932                           real  th,th2,qqh,dqh
            4933                           real  zsum,qsum,dim,dip,con1,fa1,fa2
            4934                           real  allold, decfl
            4935                           real  dz(km), ww(km), qq(km)
            4936                           real  wi(km+1), zi(km+1), za(km+2)
            4937                           real  qn(km)
            4938                           real  dza(km+1), qa(km+1), qmi(km+1), qpi(km+1)
            4939                           real  net_flx(km)
            4940                     !
            4941                           precip = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa
                                   <<< Loop-information  End >>>
            4942        pp   4v            qa(:) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, dz, wwl, dzl, qq
                                   <<< Loop-information  End >>>
            4943        pp   2v            qq(:) = 0.0
            4944         p   2v            dz(:) = dzl(:)
            4945         p   2v            ww(:) = wwl(:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rql, net_flx, ww, qq, pfsan
                                   <<< Loop-information  End >>>
            4946     1  pp   2v            do k = 1,km
            4947     2   p   2v              if(rql(k).gt.R1) then
            4948     2   p   2v                qq(k) = rql(k)
            4949     2   p   2v              else
            4950     2   p   2v                ww(k) = 0.0
            4951     2   p   2v              endif
            4952     1   p   2v              pfsan(k) = 0.0
            4953     1   p   2v              net_flx(k) = 0.0
            4954     1   p   2v            enddo
            4955                     ! skip for no precipitation for all layers
            4956                           allold = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4957     1  pp    v            do k=1,km
            4958     1   p    v              allold = allold + qq(k)
            4959     1   p    v            enddo
            4960     1                     if(allold.le.0.0) then
            4961     1                        return
            4962     1                     endif
            4963                     !
            4964                     ! compute interface values
            4965                           zi(1)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi
                                   <<< Loop-information  End >>>
            4966     1   s   2s            do k=1,km
            4967     1   s   2s              zi(k+1) = zi(k)+dz(k)
            4968     1   s   2s            enddo
            4969                     ! plm is 2nd order, we can use 2nd order wi or 3rd order wi
            4970                     ! 2nd order interpolation to get wi
            4971                     !      wi(1) = ww(1)
            4972                     !      wi(km+1) = ww(km)
            4973                     !      do k=2,km
            4974                     !        wi(k) = (ww(k)*dz(k-1)+ww(k-1)*dz(k))/(dz(k-1)+dz(k))
            4975                     !      enddo
            4976                     ! 3rd order interpolation to get wi
            4977                           fa1 = 9./16.
            4978                           fa2 = 1./16.
            4979                           wi(1) = ww(1)
            4980                           wi(2) = 0.5*(ww(2)+ww(1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            4981     1  pp   2v            do k=3,km-1
            4982     1   p   2v              wi(k) = fa1*(ww(k)+ww(k-1))-fa2*(ww(k+1)+ww(k-2))
            4983     1   p   2v            enddo
            4984                           wi(km) = 0.5*(ww(km)+ww(km-1))
            4985                           wi(km+1) = ww(km)
            4986                     
            4987                     ! terminate of top of raingroup
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            4988     1  pp   2v            do k=2,km
            4989     1   p   2v              if( ww(k).eq.0.0 ) wi(k)=ww(k-1)
            4990     1   p   2v            enddo
            4991                     
            4992                     ! diffusivity of wi
            4993                           con1 = 0.05
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, dz
                                   <<< Loop-information  End >>>
            4994     1   s   2s            do k=km,1,-1
            4995     1   m   2m              decfl = (wi(k+1)-wi(k))*dt/dz(k)
            4996     2   s   2s              if( decfl .gt. con1 ) then
            4997     2   s   2s                wi(k) = wi(k+1) - con1*dz(k)/dt
            4998     2   p   2v              endif
            4999     1   p   2v            enddo
            5000                     ! compute arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, zi, za
                                   <<< Loop-information  End >>>
            5001     1  pp   2v            do k=1,km+1
            5002     1   p   2v              za(k) = zi(k) - wi(k)*dt
            5003     1   p   2v            enddo
            5004                           za(km+2) = zi(km+1)
            5005                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za, dza
                                   <<< Loop-information  End >>>
            5006     1  pp   2v            do k=1,km+1
            5007     1   p   2v              dza(k) = za(k+1)-za(k)
            5008     1   p   2v            enddo
            5009                     
            5010                     ! computer deformation at arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qq, dza, qa
                                   <<< Loop-information  End >>>
            5011     1  pp   2v            do k=1,km
            5012     1   p   2v              qa(k) = qq(k)*dz(k)/dza(k)
            5013     1   p   2v            enddo
            5014                           qa(km+1) = 0.0
            5015                     
            5016                     ! estimate values at arrival cell interface with monotone
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qmi, qpi
                                   <<< Loop-information  End >>>
            5017     1  pp    v            do k=2,km
            5018     1   p    v              dip=(qa(k+1)-qa(k))/(dza(k+1)+dza(k))
            5019     1   p    v              dim=(qa(k)-qa(k-1))/(dza(k-1)+dza(k))
            5020     2   p    v              if( dip*dim.le.0.0 ) then
            5021     2   p    v                qmi(k)=qa(k)
            5022     2   p    v                qpi(k)=qa(k)
            5023     2   p    v              else
            5024     2   p    v                qpi(k)=qa(k)+0.5*(dip+dim)*dza(k)
            5025     2   p    v                qmi(k)=2.0*qa(k)-qpi(k)
            5026     3   p    v                if( qpi(k).lt.0.0 .or. qmi(k).lt.0.0 ) then
            5027     3   p    v                  qpi(k) = qa(k)
            5028     3   p    v                  qmi(k) = qa(k)
            5029     3   p    v                endif
            5030     2   p    v              endif
            5031     1   p    v            enddo
            5032                           qpi(1)=qa(1)
            5033                           qmi(1)=qa(1)
            5034                           qmi(km+1)=qa(km+1)
            5035                           qpi(km+1)=qa(km+1)
            5036                     
            5037                     ! interpolation to regular point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            5038        pp   4v            qn = 0.0
            5039                           kb=1
            5040                           kt=1
            5041     1                     intp : do k=1,km
            5042     1                            kb=max(kb-1,1)
            5043     1                            kt=max(kt-1,1)
            5044     1               ! find kb and kt
            5045     2                            if( zi(k).ge.za(km+1) ) then
            5046     2                              exit intp
            5047     2                            else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            5048     3                              find_kb : do kk=kb,km
            5049     4                                        if( zi(k).le.za(kk+1) ) then
            5050     4                                          kb = kk
            5051     4                                          exit find_kb
            5052     4                                        else
            5053     4                                          cycle find_kb
            5054     4                                        endif
            5055     3                              enddo find_kb
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            5056     3                              find_kt : do kk=kt,km+2
            5057     4                                        if( zi(k+1).le.za(kk) ) then
            5058     4                                          kt = kk
            5059     4                                          exit find_kt
            5060     4                                        else
            5061     4                                          cycle find_kt
            5062     4                                        endif
            5063     3                              enddo find_kt
            5064     2                              kt = kt - 1
            5065     2               ! compute q with piecewise constant method
            5066     3                              if( kt.eq.kb ) then
            5067     3                                tl=(zi(k)-za(kb))/dza(kb)
            5068     3                                th=(zi(k+1)-za(kb))/dza(kb)
            5069     3                                tl2=tl*tl
            5070     3                                th2=th*th
            5071     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            5072     3                                qqh=qqd*th2+qmi(kb)*th
            5073     3                                qql=qqd*tl2+qmi(kb)*tl
            5074     3                                qn(k) = (qqh-qql)/(th-tl)
            5075     3                                net_flx(k) = (qa(k)*dza(k)-(qqh-qql))  !xb141
            5076     3                              else if( kt.gt.kb ) then
            5077     3                                tl=(zi(k)-za(kb))/dza(kb)
            5078     3                                tl2=tl*tl
            5079     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            5080     3                                qql=qqd*tl2+qmi(kb)*tl
            5081     3                                dql = qa(kb)-qql
            5082     3                                zsum  = (1.-tl)*dza(kb)
            5083     3                                qsum  = dql*dza(kb)
            5084     4                                if( kt-kb.gt.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5085     5  pp    v                       do m=kb+1,kt-1
            5086     5   p    v                         zsum = zsum + dza(m)
            5087     5   p    v                         qsum = qsum + qa(m) * dza(m)
            5088     5   p    v                       enddo
            5089     4                                endif
            5090     3                                th=(zi(k+1)-za(kt))/dza(kt)
            5091     3                                th2=th*th
            5092     3                                qqd=0.5*(qpi(kt)-qmi(kt))
            5093     3                                dqh=qqd*th2+qmi(kt)*th
            5094     3                                zsum  = zsum + th*dza(kt)
            5095     3                                qsum  = qsum + dqh*dza(kt)
            5096     3                                qn(k) = qsum/zsum
            5097     3                                net_flx(k) = (qa(k)*dza(k)-qsum)  !xb141
            5098     3                              endif
            5099     2                              cycle intp
            5100     2                            endif
            5101     1               
            5102     1                      enddo intp
            5103                     
            5104                     ! rain out
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1

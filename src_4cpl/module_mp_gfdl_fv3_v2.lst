            5105     1                     sum_precip: do k=1,km
            5106     2                                   if( za(k).lt.0.0 .and. za(k+1).le.0.0 ) then
            5107     2                                     precip = precip + qa(k)*dza(k)
            5108     2                                     cycle sum_precip
            5109     2                                   else if ( za(k).lt.0.0 .and. za(k+1).gt.0.0 ) then
            5110     2                                     th = (0.0-za(k))/dza(k)
            5111     2                                     th2 = th*th
            5112     2                                     qqd = 0.5*(qpi(k)-qmi(k))
            5113     2                                     qqh = qqd*th2+qmi(k)*th
            5114     2                                     precip = precip + qqh*dza(k)
            5115     2                                     exit sum_precip
            5116     2                                   endif
            5117     1                                   exit sum_precip

            3179                     
            3180                     subroutine implicit_fall (dt, ks, ke, ze, vt, dp, q, precip, m1)
            3181                     
            3182                         implicit none
            3183                     
            3184                         integer, intent (in) :: ks, ke
            3185                         real, intent (in) :: dt
            3186                         real, intent (in), dimension (ks:ke + 1) :: ze
            3187                         real, intent (in), dimension (ks:ke) :: vt, dp
            3188                         real, intent (inout), dimension (ks:ke) :: q
            3189                         real, intent (out), dimension (ks:ke) :: m1
            3190                         real, intent (out) :: precip
            3191                         real, dimension (ks:ke) :: dz, qm, dd
            3192                         integer :: k
            3193                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dp, vt, ze, dd, dz
                                   <<< Loop-information  End >>>
            3194     1  pp    v          do k = ks, ke
            3195     1   p    v              dz (k) = ze (k) - ze (k + 1)
            3196     1   p    v              dd (k) = dt * vt (k)
            3197     1   p    v              q (k) = q (k) * dp (k)
            3198     1   p    v          enddo
            3199                     
            3200                         ! -----------------------------------------------------------------------
            3201                         ! sedimentation: non - vectorizable loop
            3202                         ! -----------------------------------------------------------------------
            3203                     
            3204                         qm (ks) = q (ks) / (dz (ks) + dd (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.19, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qm, dz, dd, q
                                   <<< Loop-information  End >>>
            3205     1   s   2s          do k = ks + 1, ke
            3206     1   m   2m              qm (k) = (q (k) + dd (k - 1) * qm (k - 1)) / (dz (k) + dd (k))
            3207     1   p   2v          enddo
            3208                     
            3209                         ! -----------------------------------------------------------------------
            3210                         ! qm is density at this stage
            3211                         ! -----------------------------------------------------------------------
            3212                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qm
                                   <<< Loop-information  End >>>
            3213     1  pp   2v          do k = ks, ke
            3214     1   p   2v              qm (k) = qm (k) * dz (k)
            3215     1   p   2v          enddo
            3216                     
            3217                         ! -----------------------------------------------------------------------
            3218                         ! output mass fluxes: non - vectorizable loop
            3219                         ! -----------------------------------------------------------------------
            3220                     
            3221                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3222     1   s   2s          do k = ks + 1, ke
            3223     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3224     1   p   2v          enddo
            3225                         precip = m1 (ke)
            3226                     
            3227                         ! -----------------------------------------------------------------------
            3228                         ! update:
            3229                         ! -----------------------------------------------------------------------
            3230                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3231     1  pp   2v          do k = ks, ke
            3232     1   p   2v              q (k) = qm (k) / dp (k) !dry dp used inside MP
            3233     1   p   2v          enddo
            3234                     
            3235                     end subroutine implicit_fall

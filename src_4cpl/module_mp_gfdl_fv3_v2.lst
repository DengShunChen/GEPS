            2741                         integer :: k, k0, m
            2742                         logical :: no_fall
            2743                     
            2744                         dt5 = 0.5 * dtm
            2745                         fac_imlt = 1. - exp (- dt5 / tau_imlt)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfg, pfs, pfi, pfr
                                   <<< Loop-information  End >>>
            2746        pp   2v          pfr = 0.0
            2747         p   2v          pfi = 0.0
            2748         p   2v          pfs = 0.0
            2749         p   2v          pfg = 0.0
            2750                     
            2751                         ! -----------------------------------------------------------------------
            2752                         ! define heat capacity and latend heat coefficient
            2753                         ! -----------------------------------------------------------------------
            2754                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 250
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, qs, qi, qr, ql, qv, qg, q_sol, icpk
                                   <<<      lcpk, cvm, q_liq, m1_sol
                                   <<< Loop-information  End >>>
            2755     1  pp    v          do k = ks, ke
            2756     1   p    v              m1_sol (k) = 0.
            2757     1   p    v              q_liq (k) = ql (k) + qr (k)
            2758     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2759     1   p    v              cvm (k) = 1. + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2760     1   p    v              lcpk (k) = (lv00 + d1_vap * tz (k)) / cvm (k)
            2761     1   p    v              icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            2762     1   p    v          enddo
            2763                     

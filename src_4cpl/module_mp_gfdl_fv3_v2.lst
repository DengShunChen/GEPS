            4506                     ! =======================================================================
            4507                     ! saturation water vapor pressure table ii
            4508                     ! 1 - phase table
            4509                     ! =======================================================================
            4510                     
            4511                     subroutine qs_tablew (n)
            4512                     
            4513                         implicit none
            4514                     
            4515                         integer, intent (in) :: n
            4516                     
            4517                         real (kind = r8) :: delt = 0.1
            4518                         real (kind = r8) :: tmin, tem, fac0, fac1, fac2
            4519                     
            4520                         integer :: i
            4521                     
            4522                         tmin = table_ice - 160.
            4523                     
            4524                         ! -----------------------------------------------------------------------
            4525                         ! compute es over water
            4526                         ! -----------------------------------------------------------------------
            4527                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tablew
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4528     1  pp    v          do i = 1, n
            4529     1   p    v              tem = tmin + delt * real (i - 1)
            4530     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4531     1   p    v              fac1 = fac0 * lv0
            4532     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4533     1   p    v              tablew (i) = e00 * exp (fac2)
            4534     1   p    v          enddo
            4535                     
            4536                     end subroutine qs_tablew

            3871                     !        write (logunit, nml = gfdl_mp_nml)
            3872                     !    endif
            3873                     
            3874     1                   if (do_setup) then
            3875     1    i                  call setup_con
            3876     1                       call setupm
            3877     1                       do_setup = .false.
            3878     1                   endif
            3879                     
            3880                         g2 = 0.5 * grav
            3881                         log_10 = log (10.)
            3882                     
            3883     1                   if (do_warm_rain_mp) then

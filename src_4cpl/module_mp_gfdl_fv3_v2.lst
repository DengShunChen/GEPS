            3928                     
            3929                     subroutine setup_con
            3930                     
            3931                         implicit none
            3932                     
            3933                         ! master = (mpp_pe () .eq.mpp_root_pe ())
            3934                     
            3935                         if (.not. qsmith_tables_initialized) call qsmith_init
            3936                     
            3937                         qsmith_tables_initialized = .true.

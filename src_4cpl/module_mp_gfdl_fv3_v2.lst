            1140                     
            1141                     subroutine sedi_heat (ks, ke, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            1142                         ! revised with a precise energy conserving form: s. - j. lin, jan 22, 2018
            1143                         ! input q fields are dry mixing ratios, and dm is dry air mass
            1144                         implicit none
            1145                         integer, intent (in) :: ks, ke
            1146                         real, intent (in), dimension (ks:ke) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            1147                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1148                         real, intent (in) :: cw ! heat capacity
            1149                         ! local:
            1150                         real, dimension (ks:ke) :: dgz, cv0
            1151                         integer :: k
            1152                     
            1153                         ! this is the vectorized loop
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qlz, qrz, qiz, qsz, dz1, dp1, m1_sol
                                   <<<      cv0, qvz, qgz, dgz, ql, qr, qi, qs, dz
                                   <<<      dm, m1, qv, qg, dp, m1_rain
                                   <<< Loop-information  End >>>
            1154     1  pp    v          do k = ks + 1, ke
            1155     1   p    v              dgz (k) = - g2 * (dz (k - 1) + dz (k))
            1156     1   p    v              cv0 (k) = dm (k) * (cv_air + qv (k) * cv_vap + (qr (k) + ql (k)) * c_liq + &
            1157     1                            (qi (k) + qs (k) + qg (k)) * c_ice) + cw * (m1 (k) - m1 (k - 1))
            1158     1                       ! cvm_new + cw * m1 (k) = cvm_old + cw * m1 (k - 1)
            1159     1   p    v          enddo
            1160                         ! -----------------------------------------------------------------------
            1161                         ! implicit algorithm: can't be vectorized
            1162                         ! needs an inner i - loop for vectorization
            1163                         ! -----------------------------------------------------------------------
            1164                         ! top layer: cv0 = cvn + cw * m1 (k)
            1165                         ! tz (k) = cv0 (k) * tz (k) / (cvn (k) + cw * m1 (k)) = tz (k) -- > no change

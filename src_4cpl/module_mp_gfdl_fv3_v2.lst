            5135                     !     compute fall speed of cloud rain and ice
            5136                           SUBROUTINE vqrqi(isg,r00,fv,qri,ql,tair,ww1)
            5137                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            5138                     ! compute fall speed of cloud rain and ice
            5139                     ! isg=1, for rain
            5140                     ! isg=2, for ice
            5141                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            5142                           implicit none
            5143                     
            5144                           integer, intent(in) :: isg
            5145                           real, intent(in) :: r00, fv,qri,ql,tair
            5146                           real, intent(inout) :: ww1
            5147                     
            5148                     ! LOCAL variables
            5149                           integer :: ic
            5150                           real  :: y1,vr,vs,vg
            5151                           real  :: const_vt, const_d, const_m !cpi, cmin Di
            5152                           real  :: cmin, draimax, tnw, vrc0, vrc1, vrc2, vrc3, zrc, cpi, roqr
            5153                           real  :: bb1, bb2,ice_fall
            5154                           real  :: bin_factor, ftnw, ftnwmin
            5155                           real, dimension(7) ::  aice, vice
            5156                           data aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./
            5157                           data vice/5,15,30,35,40,45,50/
            5158                     
            5159                           ice_fall=0.
            5160                           const_vt=1.49e4
            5161                           const_d=11.9
            5162                           const_m=1./5.38e7
            5163                           cmin=1.E-20
            5164                           cpi=4.*atan(1.)
            5165                           roqr=1.  !rain density (g/cm^3)
            5166                           tnw=0.08
            5167                     
            5168                           draimax=0.0500 !maximum rain diameter (cm)
            5169                           draimax=draimax**4.*roqr*cpi
            5170                           zrc=(cpi*roqr*tnw)**0.25
            5171                           vrc0=-26.7
            5172                           vrc1=20600./zrc
            5173                           vrc2=-204500./(zrc*zrc)
            5174                           vrc3=906000./(zrc*zrc*zrc)
            5175                     
            5176                           y1=r00*qri
            5177                           ww1=0.
            5178                     
            5179     1                     if (y1 .gt. cmin) then
            5180     1               
            5181     2                     if (isg.eq.1) then                             !  rain
            5182     2               
            5183     2                        ftnw=1.
            5184     3                          if(ql.lt.cmin .and. tair .gt. t_ice)then
            5185     3                            bin_factor=0.11*(1000.*qri)**(-1.27) + 0.98
            5186     3                            bin_factor=min(bin_factor, 1.30)
            5187     3                            ftnw=1./bin_factor**3.35
            5188     3                            ftnwmin=r00*qri/draimax
            5189     3                            if(qri.le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            5190     3                          endif
            5191     2               
            5192     2                              vs=sqrt( y1 )
            5193     2                              vg=sqrt( vs)
            5194     2               !               vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
            5195     2                              vr=vrc0+vrc1*vg/ftnw**0.25+vrc2*vs/ftnw**0.50+vrc3*vg*vs/ftnw**0.75
            5196     2                              ww1=max(fv*vr, 0.e0)
            5197     2               
            5198     2               
            5199     2                     else if (isg.eq.2) then                         ! cloud ice
            5200     2               
            5201     2                           y1=1.e6*r00*qri                            ! to g/m**3
            5202     2               
            5203     3                           if (y1 .gt. 1.e-6) then
            5204     3                                 y1=y1*1.e-3
            5205     3                                 bb1=const_m*y1**0.25
            5206     3                                 bb2=const_d*bb1**0.5
            5207     3                                 ww1=max(const_vt*bb2**1.31, 0.0)
            5208     3                                 ww1=ww1*100. !cm/s
            5209     3                                 if (ww1 .gt. 50.) ww1=50.               ! SLang
            5210     3                           endif  !y1
            5211     2                     endif  !isg
            5212     1                     endif !y1
            5213                     
            5214                           end subroutine vqrqi

            1781     5   p    v                              psacw = factor / (1. + dts * factor) * ql ! rate
            1782     5   p    v                          else
            1783     5   p    v                              psacw = 0.
            1784     5   p    v                          endif
            1785     4               
            1786     4                                   ! -----------------------------------------------------------------------
            1787     4                                   ! psacr: accretion of rain by melted snow
            1788     4                                   ! pracs: accretion of snow by rain
            1789     4                                   ! -----------------------------------------------------------------------
            1790     4               
            1791     5   p    v                          if (qr > qrmin) then
            1792     5   pi   v                              psacr = min (acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), &
            1793     5                                           den (k)), qr * rdts)
            1794     5   pi   v                              pracs = acr3d (vtr (k), vts (k), qs, qr, cracs, acco (1, 1), den (k))
            1795     5   p    v                          else
            1796     5   p    v                              psacr = 0.
            1797     5   p    v                              pracs = 0.
            1798     5   p    v                          endif
            1799     4               
            1800     4                                   ! -----------------------------------------------------------------------
            1801     4                                   ! total snow sink:
            1802     4                                   ! psmlt: snow melt (due to rain accretion)
            1803     4                                   ! -----------------------------------------------------------------------
            1804     4               
            1805     4   pi   v                          psmlt = max (0., smlt (tc, dqs0, qs * den (k), psacw, psacr, csmlt, &
            1806     4                                       den (k), denfac (k)))
            1807     4   p    v                          sink = min (qs, dts * (psmlt + pracs), tc / icpk (k))
            1808     4   p    v                          qs = qs - sink
            1809     4   p    v                          tmp = min (sink, dim (qs_mlt, ql)) ! max ql due to snow melt
            1810     4   p    v                          ql = ql + tmp
            1811     4   p    v                          qr = qr + sink - tmp
            1812     4   p    v                          q_liq (k) = q_liq (k) + sink
            1813     4   p    v                          q_sol (k) = q_sol (k) - sink
            1814     4               
            1815     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1816     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1817     4   p    v                          tc = tz - tice
            1818     4   p    v                          icpk (k) = (li00 + d1_ice * tz) / cvm (k)
            1819     4               
            1820     4   p    v                      endif
            1821     3               
            1822     3                               ! -----------------------------------------------------------------------
            1823     3                               ! melting of graupel
            1824     3                               ! -----------------------------------------------------------------------
            1825     3               
            1826     4   p    v                      if (qg > qcmin .and. tc > 0.) then
            1827     4               
            1828     4                                   ! -----------------------------------------------------------------------
            1829     4                                   ! pgacr: accretion of rain by graupel
            1830     4                                   ! -----------------------------------------------------------------------
            1831     4               
            1832     4   p    v                          if (qr > qrmin) &
            1833     4                                       pgacr = min (acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1834     4                                       den (k)), rdts * qr)
            1835     4               
            1836     4                                   ! -----------------------------------------------------------------------
            1837     4                                   ! pgacw: accretion of cloud water by graupel
            1838     4                                   ! -----------------------------------------------------------------------
            1839     4               
            1840     4   p    v                          qden = qg * den (k)
            1841     5   p    v                          if (ql > qrmin) then
            1842     5   p    v                              factor = cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            1843     5   p    v                              pgacw = factor / (1. + dts * factor) * ql ! rate
            1844     5   p    v                          endif
            1845     4               
            1846     4                                   ! -----------------------------------------------------------------------
            1847     4                                   ! pgmlt: graupel melt
            1848     4                                   ! -----------------------------------------------------------------------
            1849     4               
            1850     4   pi   v                          pgmlt = dts * gmlt (tc, dqs0, qden, pgacw, pgacr, cgmlt, den (k))
            1851     4   p    v                          pgmlt = min (max (0., pgmlt), qg, tc / icpk (k))
            1852     4   p    v                          qg = qg - pgmlt
            1853     4   p    v                          qr = qr + pgmlt
            1854     4   p    v                          q_liq (k) = q_liq (k) + pgmlt
            1855     4   p    v                          q_sol (k) = q_sol (k) - pgmlt
            1856     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1857     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1858     4   p    v                      endif
            1859     3               
            1860     3   p    v                  else
            1861     3               
            1862     3                               ! -----------------------------------------------------------------------
            1863     3                               ! cloud ice proc:
            1864     3                               ! -----------------------------------------------------------------------
            1865     3               
            1866     3                               ! -----------------------------------------------------------------------
            1867     3                               ! psaci: accretion of cloud ice by snow
            1868     3                               ! -----------------------------------------------------------------------
            1869     3               
            1870     4   p    v                      if (qi > 3.e-7) then ! cloud ice sink terms
            1871     4               
            1872     5   p    v                          if (qs > 1.e-7) then
            1873     5                                       ! -----------------------------------------------------------------------
            1874     5                                       ! sjl added (following lin eq. 23) the temperature dependency
            1875     5                                       ! to reduce accretion, use esi = exp (0.05 * tc) as in hong et al 2004
            1876     5                                       ! -----------------------------------------------------------------------
            1877     5   p    v                              factor = dts * denfac (k) * csaci * exp (0.05 * tc + 0.8125 * log (qs * den (k)))
            1878     5   p    v                              psaci = factor / (1. + factor) * qi
            1879     5   p    v                          else
            1880     5   p    v                              psaci = 0.
            1881     5   p    v                          endif
            1882     4               
            1883     4                                   ! -----------------------------------------------------------------------
            1884     4                                   ! assuming linear subgrid vertical distribution of cloud ice
            1885     4                                   ! the mismatch computation following lin et al. 1994, mwr
            1886     4                                   ! -----------------------------------------------------------------------
            1887     4               
            1888     5   p    v                          if (const_vi) then
            1889     5   p    v                              tmp = fac_i2s
            1890     5   p    v                          else
            1891     5   p    v                              tmp = fac_i2s * exp (0.025 * tc)
            1892     5   p    v                          endif
            1893     4               
            1894     4   p    v                          di (k) = max (di (k), qrmin)
            1895     4   p    v                          q_plus = qi + di (k)
            1896     5   p    v                          if (q_plus > (qim (k) + qrmin)) then
            1897     6   p    v                              if (qim (k) > (qi - di (k))) then
            1898     6   p    v                                  dq = (0.25 * (q_plus - qim (k)) ** 2) / di (k)
            1899     6   p    v                              else
            1900     6   p    v                                  dq = qi - qim (k)
            1901     6   p    v                              endif
            1902     5   p    v                              psaut = tmp * dq
            1903     5   p    v                          else
            1904     5   p    v                              psaut = 0.
            1905     5   p    v                          endif
            1906     4                                   ! -----------------------------------------------------------------------
            1907     4                                   ! sink is no greater than 75% of qi
            1908     4                                   ! -----------------------------------------------------------------------
            1909     4   p    v                          sink = min (0.75 * qi, psaci + psaut)
            1910     4   p    v                          qi = qi - sink
            1911     4   p    v                          qs = qs + sink
            1912     4               
            1913     4                                   ! -----------------------------------------------------------------------
            1914     4                                   ! pgaci: accretion of cloud ice by graupel
            1915     4                                   ! -----------------------------------------------------------------------
            1916     4               
            1917     5   p    v                          if (qg > 1.e-6) then
            1918     5                                       ! -----------------------------------------------------------------------
            1919     5                                       ! factor = dts * cgaci / sqrt (den (k)) * exp (0.05 * tc + 0.875 * log (qg * den (k)))
            1920     5                                       ! simplified form: remove temp dependency & set the exponent "0.875" -- > 1
            1921     5                                       ! -----------------------------------------------------------------------
            1922     5   p    v                              factor = dts * cgaci / sqrt (den (k)) * exp (0.875 * log (qg * den (k)))
            1923     5   p    v                              pgaci = factor / (1. + factor) * qi
            1924     5   p    v                              qi = qi - pgaci
            1925     5   p    v                              qg = qg + pgaci
            1926     5   p    v                          endif
            1927     4               
            1928     4   p    v                      endif
            1929     3               
            1930     3                               ! -----------------------------------------------------------------------
            1931     3                               ! cold - rain proc:
            1932     3                               ! -----------------------------------------------------------------------
            1933     3               
            1934     3                               ! -----------------------------------------------------------------------
            1935     3                               ! rain to ice, snow, graupel processes:
            1936     3                               ! -----------------------------------------------------------------------
            1937     3               
            1938     3   p    v                      tc = tz - tice
            1939     3               
            1940     4   p    v                      if (qr > 1.e-7 .and. tc < 0.) then
            1941     4               
            1942     4                                   ! -----------------------------------------------------------------------
            1943     4                                   ! * sink * terms to qr: psacr + pgfr
            1944     4                                   ! source terms to qs: psacr
            1945     4                                   ! source terms to qg: pgfr
            1946     4                                   ! -----------------------------------------------------------------------
            1947     4               
            1948     4                                   ! -----------------------------------------------------------------------
            1949     4                                   ! psacr accretion of rain by snow
            1950     4                                   ! -----------------------------------------------------------------------
            1951     4               
            1952     5   p    v                          if (qs > 1.e-7) then ! if snow exists
            1953     5   pi   v                              psacr = dts * acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), den (k))
            1954     5   p    v                          else
            1955     5   p    v                              psacr = 0.
            1956     5   p    v                          endif
            1957     4               
            1958     4                                   ! -----------------------------------------------------------------------
            1959     4                                   ! pgfr: rain freezing -- > graupel
            1960     4                                   ! -----------------------------------------------------------------------
            1961     4               
            1962     4   p    v                          pgfr = dts * cgfr (1) / den (k) * (exp (- cgfr (2) * tc) - 1.) * &
            1963     4                                       exp (1.75 * log (qr * den (k)))
            1964     4               
            1965     4                                   ! -----------------------------------------------------------------------
            1966     4                                   ! total sink to qr
            1967     4                                   ! -----------------------------------------------------------------------
            1968     4               
            1969     4   p    v                          sink = psacr + pgfr
            1970     4   p    v                          factor = min (sink, qr, - tc / icpk (k)) / max (sink, qrmin)
            1971     4               
            1972     4   p    v                          psacr = factor * psacr
            1973     4   p    v                          pgfr = factor * pgfr
            1974     4               
            1975     4   p    v                          sink = psacr + pgfr
            1976     4   p    v                          qr = qr - sink
            1977     4   p    v                          qs = qs + psacr
            1978     4   p    v                          qg = qg + pgfr
            1979     4   p    v                          q_liq (k) = q_liq (k) - sink
            1980     4   p    v                          q_sol (k) = q_sol (k) + sink
            1981     4               
            1982     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1983     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1984     4   p    v                          icpk (k) = (li00 + d1_ice * tz) / cvm (k)
            1985     4   p    v                      endif
            1986     3               
            1987     3                               ! -----------------------------------------------------------------------
            1988     3                               ! graupel production terms:
            1989     3                               ! -----------------------------------------------------------------------
            1990     3               
            1991     4   p    v                      if (qs > 1.e-7) then
            1992     4               
            1993     4                                   ! -----------------------------------------------------------------------
            1994     4                                   ! accretion: snow -- > graupel
            1995     4                                   ! -----------------------------------------------------------------------
            1996     4               
            1997     5   p    v                          if (qg > qrmin) then
            1998     5   pi   v                              sink = dts * acr3d (vtg (k), vts (k), qs, qg, cgacs, acco (1, 4), den (k))
            1999     5   p    v                          else
            2000     5   p    v                              sink = 0.
            2001     5   p    v                          endif
            2002     4               
            2003     4                                   ! -----------------------------------------------------------------------
            2004     4                                   ! autoconversion snow -- > graupel
            2005     4                                   ! -----------------------------------------------------------------------
            2006     4               
            2007     4   p    v                          qsm = qs0_crt / den (k)
            2008     5   p    v                          if (qs > qsm) then
            2009     5   p    v                              factor = dts * 1.e-3 * exp (0.09 * (tz - tice))
            2010     5   p    v                              sink = sink + factor / (1. + factor) * (qs - qsm)
            2011     5   p    v                          endif
            2012     4   p    v                          sink = min (qs, sink)
            2013     4   p    v                          qs = qs - sink
            2014     4   p    v                          qg = qg + sink
            2015     4               
            2016     4   p    v                      endif ! snow existed
            2017     3               
            2018     4   p    v                      if (qg > 1.e-7 .and. tz < tice) then
            2019     4               
            2020     4                                   ! -----------------------------------------------------------------------
            2021     4                                   ! pgacw: accretion of cloud water by graupel
            2022     4                                   ! -----------------------------------------------------------------------
            2023     4               
            2024     5   p    v                          if (ql > 1.e-6) then
            2025     5   p    v                              qden = qg * den (k)
            2026     5   p    v                              factor = dts * cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            2027     5   p    v                              pgacw = factor / (1. + factor) * ql
            2028     5   p    v                          else
            2029     5   p    v                              pgacw = 0.
            2030     5   p    v                          endif
            2031     4               
            2032     4                                   ! -----------------------------------------------------------------------
            2033     4                                   ! pgacr: accretion of rain by graupel
            2034     4                                   ! -----------------------------------------------------------------------
            2035     4               
            2036     5   p    v                          if (qr > 1.e-6) then
            2037     5   pi   v                              pgacr = min (dts * acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            2038     5                                           den (k)), qr)
            2039     5   p    v                          else
            2040     5   p    v                              pgacr = 0.
            2041     5   p    v                          endif
            2042     4               
            2043     4   p    v                          sink = pgacr + pgacw
            2044     4   p    v                          factor = min (sink, dim (tice, tz) / icpk (k)) / max (sink, qrmin)
            2045     4   p    v                          pgacr = factor * pgacr
            2046     4   p    v                          pgacw = factor * pgacw
            2047     4               
            2048     4   p    v                          sink = pgacr + pgacw
            2049     4   p    v                          qg = qg + sink
            2050     4   p    v                          qr = qr - pgacr
            2051     4   p    v                          ql = ql - pgacw
            2052     4               
            2053     4   p    v                          q_liq (k) = q_liq (k) - sink
            2054     4   p    v                          q_sol (k) = q_sol (k) + sink
            2055     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / (one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            2056     4   p    v                      endif
            2057     3               
            2058     3   p    v                  endif
            2059     2               
            2060     2   p    v                  tzk (k) = tz
            2061     2   p    v                  qvk (k) = qv
            2062     2   p    v                  qlk (k) = ql
            2063     2   p    v                  qik (k) = qi
            2064     2   p    v                  qrk (k) = qr
            2065     2   p    v                  qsk (k) = qs
            2066     2   p    v                  qgk (k) = qg
            2067     2               
            2068     2   p    v              enddo
            2069     1               
            2070     1                   endif
            2071                     
            2072                         call subgrid_z_proc (ks, ke, p1, den, denfac, dts, rh_adj, tzk, qvk, qlk, &
            2073                             qrk, qik, qsk, qgk, qak, dp1, h_var, rh_rain, te8, ccn, cin, gsize, &
            2074                             cond, dep, reevap, sub, rhck, last_step)
            2075                     
            2076                     end subroutine icloud
            2077                     
            2078                     ! =======================================================================
            2079                     ! temperature sentive high vertical resolution processes
            2080                     ! =======================================================================
            2081                     
            2082                     subroutine subgrid_z_proc (ks, ke, p1, den, denfac, dts, rh_adj, tz, qv, ql, qr, &
            2083                             qi, qs, qg, qa, dp1, h_var, rh_rain, te8, ccn, cin, gsize, cond, dep, reevap, sub, rhcz, last_step)
            2084                     
            2085                         implicit none
            2086                     
            2087                         integer, intent (in) :: ks, ke
            2088                         real, intent (in) :: dts, rh_adj, h_var, rh_rain, gsize
            2089                         real, intent (in), dimension (ks:ke) :: rhcz
            2090                         real, intent (in), dimension (ks:ke) :: p1, den, denfac, ccn, dp1
            2091                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            2092                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            2093                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, qa
            2094                         real, intent (inout), dimension (ks:ke) :: cin
            2095                         logical, intent (in) :: last_step
            2096                         real, intent (out) :: cond, dep, reevap, sub
            2097                         ! local:
            2098                         real, dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            2099                         real, dimension (ks:ke) :: q_liq, q_sol, q_cond
            2100                         real (kind = r8), dimension (ks:ke) :: cvm
            2101                         real :: pidep, qi_crt
            2102                         real :: sigma, gam
            2103                         ! -----------------------------------------------------------------------
            2104                         ! qstar over water may be accurate only down to - 80 deg c with ~10% uncertainty
            2105                         ! must not be too large to allow psc
            2106                         ! -----------------------------------------------------------------------
            2107                         real :: rh, rqi, tin, qsw, qsi, qpz, qstar, rh_tem
            2108                         real :: dqsdt, dwsdt, dq, dq0, factor, tmp, liq, ice
            2109                         real :: q_plus, q_minus, dt_evap, dt_pisub
            2110                         real :: evap, sink, tc, dtmp, qa10, qa100
            2111                         real :: pssub, pgsub, tsq, qden
            2112                         real :: fac_l2v, fac_v2l, fac_g2v, fac_v2g
            2113                         integer :: k
            2114                     !    real, parameter :: qcldmin = 1.e-6   ! original
            2115                         real, parameter :: qcldmin = 1.e-8   ! GFDLMP_v1
            2116                     !    real, parameter :: qcldmin = 1.e-15  ! GFDLMP_v3
            2117                     
            2118     1                   if (do_sat_adj) then
            2119     1                       dt_evap = 0.5 * dts
            2120     1                   else
            2121     1                       dt_evap = dts
            2122     1                   endif
            2123                     
            2124                         ! -----------------------------------------------------------------------
            2125                         ! define conversion scalar / factor
            2126                         ! -----------------------------------------------------------------------
            2127                     
            2128                         fac_l2v = 1. - exp (- dt_evap / tau_l2v)
            2129                         fac_v2l = 1. - exp (- dt_evap / tau_v2l)
            2130                         fac_g2v = 1. - exp (- dts / tau_g2v)
            2131                         fac_v2g = 1. - exp (- dts / tau_v2g)
            2132                     
            2133                         ! -----------------------------------------------------------------------
            2134                         ! define heat capacity and latend heat coefficient
            2135                         ! -----------------------------------------------------------------------
            2136                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, qi, qr, ql, qv, qg, tz, q_sol, icpk
                                   <<<      tcp3, lcpk, cvm, q_liq
                                   <<< Loop-information  End >>>
            2137     1  pp    v          do k = ks, ke
            2138     1   p    v              q_liq (k) = ql (k) + qr (k)
            2139     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2140     1   p    v              cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2141     1   p    v              lcpk (k) = (lv00 + d1_vap * tz (k)) / cvm (k)
            2142     1   p    v              icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            2143     1   p    v              tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2144     1   p    v          enddo
            2145                     
            2146                         cond = 0
            2147                         dep = 0
            2148                         reevap = 0
            2149                         sub = 0
            2150                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p1
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 53
                                   <<<      SIMD&FP   : SPILL 5  FILL 21
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2151     1                   do k = ks, ke
            2152     1               
            2153     1                       if (p1 (k) < p_min) cycle
            2154     1               
            2155     2                       if (.not. do_warm_rain_mp) then
            2156     2               
            2157     2                           ! -----------------------------------------------------------------------
            2158     2                           ! instant deposit all water vapor to cloud ice when temperature is super low
            2159     2                           ! -----------------------------------------------------------------------
            2160     2               
            2161     3                           if (tz (k) < t_min) then
            2162     3                               sink = dim (qv (k), 1.e-7)
            2163     3                               dep = dep + sink * dp1 (k)
            2164     3                               qv (k) = qv (k) - sink
            2165     3                               qi (k) = qi (k) + sink
            2166     3                               q_sol (k) = q_sol (k) + sink
            2167     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / &
            2168     3                                    (one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            2169     3                               if (do_qa) qa (k) = 1. ! air fully saturated; 100 % cloud cover
            2170     3                               cycle
            2171     3                           endif
            2172     2               
            2173     2                           ! -----------------------------------------------------------------------
            2174     2                           ! instant evaporation / sublimation of all clouds if rh < rh_adj -- > cloud free
            2175     2                           ! -----------------------------------------------------------------------
            2176     2                           ! rain water is handled in warm - rain process.
            2177     2                           qpz = qv (k) + ql (k) + qi (k)
            2178     2                           tin = (te8 (k) - lv00 * qpz + li00 * (qs (k) + qg (k))) / &
            2179     2                                (one_r8 + qpz * c1_vap + qr (k) * c1_liq + (qs (k) + qg (k)) * c1_ice)
            2180     3                           if (tin > t_sub + 6.) then
            2181     3    i                          rh = qpz / iqs1 (tin, den (k))
            2182     4                               if (rh < rh_adj) then ! qpz / rh_adj < qs
            2183     4                                   reevap = reevap + ql (k) * dp1 (k)

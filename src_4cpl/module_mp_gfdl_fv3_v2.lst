            3226                     ! =======================================================================
            3227                     ! lagrangian scheme
            3228                     ! developed by sj lin, around 2006
            3229                     ! =======================================================================
            3230                     
            3231                     subroutine lagrangian_fall_ppm (ks, ke, zs, ze, zt, dp, q, precip, m1, mono)
            3232                     
            3233                         implicit none
            3234                     
            3235                         integer, intent (in) :: ks, ke
            3236                         real, intent (in) :: zs
            3237                         logical, intent (in) :: mono
            3238                         real, intent (in), dimension (ks:ke + 1) :: ze, zt
            3239                         real, intent (in), dimension (ks:ke) :: dp
            3240                     
            3241                         ! m1: flux
            3242                         real, intent (inout), dimension (ks:ke) :: q, m1
            3243                         real, intent (out) :: precip
            3244                         real, dimension (ks:ke) :: qm, dz
            3245                     
            3246                         real :: a4 (4, ks:ke)
            3247                         real :: pl, pr, delz, esl
            3248                         integer :: k, k0, n, m
            3249                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            3250                     
            3251                         ! -----------------------------------------------------------------------
            3252                         ! density:
            3253                         ! -----------------------------------------------------------------------
            3254                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            3255     1  pp    v          do k = ks, ke
            3256     1   p    v              dz (k) = zt (k) - zt (k + 1) ! note: dz is positive
            3257     1   p    v              q (k) = q (k) * dp (k)
            3258     1   p    v              a4 (1, k) = q (k) / dz (k)
            3259     1   p    v              qm (k) = 0.
            3260     1   p    v          enddo
            3261                     
            3262                         ! -----------------------------------------------------------------------
            3263                         ! construct vertical profile with zt as coordinate
            3264                         ! -----------------------------------------------------------------------
            3265                     
            3266                         call cs_profile (a4 (1, ks), dz (ks), ke - ks + 1, mono)
            3267                     
            3268                         k0 = ks
            3269     1                   do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3270     2                       do n = k0, ke
            3271     3                           if (ze (k) <= zt (n) .and. ze (k) >= zt (n + 1)) then
            3272     3                               pl = (zt (n) - ze (k)) / dz (n)
            3273     4                               if (zt (n + 1) <= ze (k + 1)) then
            3274     4                                   ! entire new grid is within the original grid
            3275     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            3276     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            3277     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            3278     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            3279     4                                   k0 = n
            3280     4                                   goto 555
            3281     4                               else
            3282     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            3283     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            3284     5                                   if (n < ke) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3285     6                                       do m = n + 1, ke
            3286     6                                           ! locate the bottom edge: ze (k + 1)
            3287     7                                           if (ze (k + 1) < zt (m + 1)) then
            3288     7                                               qm (k) = qm (k) + q (m)
            3289     7                                           else
            3290     7                                               delz = zt (m) - ze (k + 1)
            3291     7                                               esl = delz / dz (m)
            3292     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            3293     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            3294     7                                               k0 = m
            3295     7                                               goto 555
            3296     7                                           endif
            3297     6                                       enddo
            3298     5                                   endif
            3299     4                                   goto 555
            3300     4                               endif
            3301     3                           endif
            3302     2                       enddo
            3303     1                       555 continue
            3304     1                   enddo
            3305                     
            3306                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3307     1   s   2s          do k = ks + 1, ke
            3308     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3309     1   p   2v          enddo
            3310                         precip = m1 (ke)
            3311                     
            3312                         ! convert back to * dry * mixing ratio:
            3313                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            3314                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3315     1  pp   2v          do k = ks, ke
            3316     1   p   2v              q (k) = qm (k) / dp (k)
            3317     1   p   2v          enddo
            3318                     
            3319                     end subroutine lagrangian_fall_ppm
            3320                     
            3321                     subroutine cs_profile (a4, del, km, do_mono)
            3322                     
            3323                         implicit none
            3324                     
            3325                         integer, intent (in) :: km ! vertical dimension
            3326                         real, intent (in) :: del (km)
            3327                         logical, intent (in) :: do_mono
            3328                         real, intent (inout) :: a4 (4, km)
            3329                         real, parameter :: qp_min = 1.e-6
            3330                         real :: gam (km)
            3331                         real :: q (km + 1)
            3332                         real :: d4, bet, a_bot, grat, pmp, lac
            3333                         real :: pmp_1, lac_1, pmp_2, lac_2
            3334                         real :: da1, da2, a6da
            3335                     
            3336                         integer :: k
            3337                     
            3338                         logical extm (km)
            3339                     
            3340                         grat = del (2) / del (1) ! grid ratio
            3341                         bet = grat * (grat + 0.5)
            3342                         q (1) = (2. * grat * (grat + 1.) * a4 (1, 1) + a4 (1, 2)) / bet
            3343                         gam (1) = (1. + grat * (grat + 1.5)) / bet
            3344                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 10, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, q, gam, del
                                   <<< Loop-information  End >>>
            3345     1   s   2s          do k = 2, km
            3346     1   p   2v              d4 = del (k - 1) / del (k)
            3347     1   m   2m              bet = 2. + 2. * d4 - gam (k - 1)
            3348     1   m   2m              q (k) = (3. * (a4 (1, k - 1) + d4 * a4 (1, k)) - q (k - 1)) / bet
            3349     1   s   2s              gam (k) = d4 / bet
            3350     1   p   2v          enddo
            3351                     
            3352                         a_bot = 1. + d4 * (d4 + 1.5)
            3353                         q (km + 1) = (2. * d4 * (d4 + 1.) * a4 (1, km) + a4 (1, km - 1) - a_bot * q (km)) &
            3354                              / (d4 * (d4 + 0.5) - a_bot * gam (km))
            3355                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, q
                                   <<< Loop-information  End >>>
            3356     1   s   2s          do k = km, 1, - 1
            3357     1   s   2s              q (k) = q (k) - gam (k) * q (k + 1)
            3358     1   s   2s          enddo
            3359                     
            3360                         ! -----------------------------------------------------------------------
            3361                         ! apply constraints
            3362                         ! -----------------------------------------------------------------------
            3363                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam
                                   <<< Loop-information  End >>>
            3364     1  pp   2v          do k = 2, km
            3365     1   p   2v              gam (k) = a4 (1, k) - a4 (1, k - 1)
            3366     1   p   2v          enddo
            3367                     
            3368                         ! -----------------------------------------------------------------------
            3369                         ! apply large - scale constraints to all fields if not local max / min
            3370                         ! -----------------------------------------------------------------------
            3371                     
            3372                         ! -----------------------------------------------------------------------
            3373                         ! top:
            3374                         ! -----------------------------------------------------------------------
            3375                     
            3376                         q (1) = max (q (1), 0.)
            3377                         q (2) = min (q (2), max (a4 (1, 1), a4 (1, 2)))
            3378                         q (2) = max (q (2), min (a4 (1, 1), a4 (1, 2)), 0.)
            3379                     
            3380                         ! -----------------------------------------------------------------------
            3381                         ! interior:
            3382                         ! -----------------------------------------------------------------------
            3383                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 127
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.62, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, q
                                   <<< Loop-information  End >>>
            3384     1  pp    v          do k = 3, km - 1
            3385     2   p    v              if (gam (k - 1) * gam (k + 1) > 0.) then
            3386     2   p    v                  q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3387     2   p    v                  q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3388     2   p    v              else
            3389     3   p    v                  if (gam (k - 1) > 0.) then
            3390     3                               ! there exists a local max
            3391     3   p    v                      q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3392     3   p    v                  else
            3393     3                               ! there exists a local min
            3394     3   p    v                      q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3395     3   p    v                      q (k) = max (q (k), 0.0)
            3396     3   p    v                  endif
            3397     2   p    v              endif
            3398     1   p    v          enddo
            3399                     
            3400                         ! -----------------------------------------------------------------------
            3401                         ! bottom :
            3402                         ! -----------------------------------------------------------------------
            3403                     
            3404                         q (km) = min (q (km), max (a4 (1, km - 1), a4 (1, km)))
            3405                         q (km) = max (q (km), min (a4 (1, km - 1), a4 (1, km)), 0.)
            3406                         ! q (km + 1) = max (q (km + 1), 0.)
            3407                     
            3408                         ! -----------------------------------------------------------------------
            3409                         ! f (s) = al + s * [ (ar - al) + a6 * (1 - s) ] (0 <= s <= 1)
            3410                         ! -----------------------------------------------------------------------
            3411                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, a4
                                   <<< Loop-information  End >>>
            3412     1  pp   2v          do k = 1, km - 1
            3413     1   p   2v              a4 (2, k) = q (k)
            3414     1   p   2v              a4 (3, k) = q (k + 1)
            3415     1   p   2v          enddo
            3416                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, extm
                                   <<< Loop-information  End >>>
            3417     1  pp   2v          do k = 2, km - 1
            3418     2   p   2v              if (gam (k) * gam (k + 1) > 0.0) then
            3419     2   p   2v                  extm (k) = .false.
            3420     2   p   2v              else
            3421     2   p   2v                  extm (k) = .true.
            3422     2   p   2v              endif
            3423     1   p   2v          enddo
            3424                     
            3425     1                   if (do_mono) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 88
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.98, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, extm
                                   <<< Loop-information  End >>>
            3426     2  pp    v              do k = 3, km - 2
            3427     3   p    v                  if (extm (k)) then
            3428     3                               ! positive definite constraint only if true local extrema
            3429     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3430     4   p    v                          a4 (2, k) = a4 (1, k)
            3431     4   p    v                          a4 (3, k) = a4 (1, k)
            3432     4   p    v                      endif
            3433     3   p    v                  else
            3434     3   p    v                      a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3435     4   p    v                      if (abs (a4 (4, k)) > abs (a4 (2, k) - a4 (3, k))) then
            3436     4                                   ! check within the smooth region if subgrid profile is non - monotonic
            3437     4   p    v                          pmp_1 = a4 (1, k) - 2.0 * gam (k + 1)
            3438     4   p    v                          lac_1 = pmp_1 + 1.5 * gam (k + 2)
            3439     4   p    v                          a4 (2, k) = min (max (a4 (2, k), min (a4 (1, k), pmp_1, lac_1)), &
            3440     4                                       max (a4 (1, k), pmp_1, lac_1))
            3441     4   p    v                          pmp_2 = a4 (1, k) + 2.0 * gam (k)
            3442     4   p    v                          lac_2 = pmp_2 - 1.5 * gam (k - 1)
            3443     4   p    v                          a4 (3, k) = min (max (a4 (3, k), min (a4 (1, k), pmp_2, lac_2)), &
            3444     4                                       max (a4 (1, k), pmp_2, lac_2))
            3445     4   p    v                      endif
            3446     3   p    v                  endif
            3447     2   p    v              enddo
            3448     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extm, a4
                                   <<< Loop-information  End >>>
            3449     2  pp    v              do k = 3, km - 2
            3450     3   p    v                  if (extm (k)) then
            3451     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3452     4   p    v                          a4 (2, k) = a4 (1, k)
            3453     4   p    v                          a4 (3, k) = a4 (1, k)
            3454     4   p    v                      endif
            3455     3   p    v                  endif
            3456     2   p    v              enddo
            3457     1                   endif
            3458                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3459     1  pp   2v          do k = 1, km - 1
            3460     1   p   2v              a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3461     1   p   2v          enddo
            3462                     
            3463                         k = km - 1
            3464     1                   if (extm (k)) then
            3465     1                       a4 (2, k) = a4 (1, k)
            3466     1                       a4 (3, k) = a4 (1, k)
            3467     1                       a4 (4, k) = 0.
            3468     1                   else
            3469     1                       da1 = a4 (3, k) - a4 (2, k)
            3470     1                       da2 = da1 ** 2
            3471     1                       a6da = a4 (4, k) * da1
            3472     2                       if (a6da < - da2) then
            3473     2                           a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3474     2                           a4 (3, k) = a4 (2, k) - a4 (4, k)
            3475     2                       elseif (a6da > da2) then
            3476     2                           a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3477     2                           a4 (2, k) = a4 (3, k) - a4 (4, k)
            3478     2                       endif
            3479     1                   endif
            3480                     
            3481                         call cs_limiters (km - 1, a4)
            3482                     
            3483                         ! -----------------------------------------------------------------------
            3484                         ! bottom layer:
            3485                         ! -----------------------------------------------------------------------
            3486                     
            3487                         a4 (2, km) = a4 (1, km)
            3488                         a4 (3, km) = a4 (1, km)
            3489                         a4 (4, km) = 0.
            3490                     
            3491                     end subroutine cs_profile
            3492                     
            3493                     subroutine cs_limiters (km, a4)
            3494                     
            3495                         implicit none
            3496                     
            3497                         integer, intent (in) :: km
            3498                     
            3499                         real, intent (inout) :: a4 (4, km) ! ppm array
            3500                     
            3501                         real, parameter :: r12 = 1. / 12.
            3502                     
            3503                         integer :: k
            3504                     
            3505                         ! -----------------------------------------------------------------------
            3506                         ! positive definite constraint
            3507                         ! -----------------------------------------------------------------------
            3508                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.59, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3509     1  pp    v          do k = 1, km
            3510     2   p    v              if (abs (a4 (3, k) - a4 (2, k)) < - a4 (4, k)) then
            3511     3   p    v                  if ((a4 (1, k) + 0.25 * (a4 (3, k) - a4 (2, k)) ** 2 / a4 (4, k) + a4 (4, k) * r12) < 0.) then
            3512     4   p    v                      if (a4 (1, k) < a4 (3, k) .and. a4 (1, k) < a4 (2, k)) then
            3513     4   p    v                          a4 (3, k) = a4 (1, k)
            3514     4   p    v                          a4 (2, k) = a4 (1, k)
            3515     4   p    v                          a4 (4, k) = 0.
            3516     4   p    v                      elseif (a4 (3, k) > a4 (2, k)) then
            3517     4   p    v                          a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3518     4   p    v                          a4 (3, k) = a4 (2, k) - a4 (4, k)
            3519     4   p    v                      else
            3520     4   p    v                          a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3521     4   p    v                          a4 (2, k) = a4 (3, k) - a4 (4, k)
            3522     4   p    v                      endif
            3523     3   p    v                  endif
            3524     2   p    v              endif
            3525     1   p    v          enddo
            3526                     
            3527                     end subroutine cs_limiters
            3528                     
            3529                     ! =======================================================================
            3530                     ! calculation of vertical fall speed
            3531                     ! =======================================================================
            3532                     
            3533                     subroutine fall_speed (ks, ke, den, qs, qi, qg, ql, tk, vts, vti, vtg)
            3534                     
            3535                         implicit none
            3536                     
            3537                         integer, intent (in) :: ks, ke
            3538                     
            3539                         real (kind = r8), intent (in), dimension (ks:ke) :: tk
            3540                         real, intent (in), dimension (ks:ke) :: den, qs, qi, qg, ql
            3541                         real, intent (out), dimension (ks:ke) :: vts, vti, vtg
            3542                     
            3543                         ! fall velocity constants:
            3544                     
            3545                         real, parameter :: thi = 1.0e-8 ! cloud ice threshold for terminal fall
            3546                         real, parameter :: thg = 1.0e-8
            3547                         real, parameter :: ths = 1.0e-8
            3548                     
            3549                         real, parameter :: aa = - 4.14122e-5
            3550                         real, parameter :: bb = - 0.00538922
            3551                         real, parameter :: cc = - 0.0516344
            3552                         real, parameter :: dd = 0.00216078
            3553                         real, parameter :: ee = 1.9714
            3554                     
            3555                         ! marshall - palmer constants
            3556                     
            3557                         real, parameter :: vcons = 6.6280504
            3558                         real, parameter :: vcong = 87.2382675
            3559                         real, parameter :: vconh = vcong * sqrt (rhoh / rhog) ! 132.087495104005
            3560                         real, parameter :: norms = 942477796.076938
            3561                         real, parameter :: normg = 5026548245.74367
            3562                         real, parameter :: normh = pi * rhoh * rnzh ! 115233618.533674
            3563                     
            3564                         real, dimension (ks:ke) :: qden, tc, rhof
            3565                     
            3566                         real :: vi0
            3567                         real :: y1, y2, r00, fv
            3568                     
            3569                         integer :: k
            3570                     
            3571                         ! -----------------------------------------------------------------------
            3572                         ! marshall - palmer formula
            3573                         ! -----------------------------------------------------------------------
            3574                     
            3575                         ! -----------------------------------------------------------------------
            3576                         ! try the local air density -- for global model; the true value could be
            3577                         ! much smaller than sfcrho over high mountains
            3578                         ! -----------------------------------------------------------------------
            3579                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.17, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, rhof
                                   <<< Loop-information  End >>>
            3580     1  pp   2v          do k = ks, ke
            3581     1   p   2v              rhof (k) = sqrt (min (10., sfcrho / den (k)))
            3582     1   p   2v          enddo
            3583                     
            3584                         ! -----------------------------------------------------------------------
            3585                         ! ice:
            3586                         ! -----------------------------------------------------------------------
            3587                     
            3588     1                   if (const_vi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vti
                                   <<< Loop-information  End >>>
            3589     1  pp   4v              vti (:) = vi_fac
            3590     1                   else
            3591     1                       ! -----------------------------------------------------------------------
            3592     1                       ! use deng and mace (2008, grl), which gives smaller fall speed than hd90 formula
            3593     1                       ! -----------------------------------------------------------------------
            3594     1                       vi0 = 0.01 * vi_fac
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, vti
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3595     2   s    s              do k = ks, ke
            3596     3   p    v                  if (qi (k) < thi) then ! this is needed as the fall - speed maybe problematic for small qi
            3597     3   m    m                      vti (k) = vf_min
            3598     3   p    v                  else
            3599     3   s    s                      tc (k) = tk (k) - tice
            3600     4   m    m                      if (hd_icefall) then
            3601     4                                   ! heymsfield and donner, 1990, jas
            3602     4   m    m                          vti (k) = vi_fac * 3.29 * (qi (k) * den (k)) ** 0.16
            3603     4   m    m                      elseif (gce_icefall) then
            3604     4                                   ! new codes from Steve's in cgs, module_mp_gsfcgce_4ice_nuwrf.f90
            3605     4   s    s                          vti (k) = 0.
            3606     4   s    s                          y1 = qi (k) * den (k) * 1000.   ! g/cm^3
            3607     5   s    s                          if (y1 .ge. 1.e-6) then
            3608     5   s    s                              y1 = qi (k)
            3609     5   s    s                              y2 = ql (k)
            3610     5   s    s                              r00 = den (k) / 1000.  !g/cm^3
            3611     5   s    s                              fv = sqrt (1.29 / ( den(k) * 1000.))
            3612     5   s    s                              call vqrqi (2, r00, fv, y1, y2, tk (k), vti (k))
            3613     5   s    s                          endif
            3614     4   m    m                          vti (k) = vti (k) * 0.01  !convert back to m/s
            3615     4   s    s                      else
            3616     4                                   ! deng and mace, 2008, grl
            3617     4   s    s                          vti (k) = (3. + log10 (qi (k) * den (k))) * (tc (k) * (aa * tc (k) + bb) + cc) + dd * tc (k) + ee
            3618     4   m    m                          vti (k) = vi0 * exp (log_10 * vti (k))
            3619     4   p    v                      endif
            3620     3   m    s                      vti (k) = min (vi_max, max (vf_min, vti (k)))
            3621     3   p    v                  endif
            3622     2   p    v              enddo
            3623     1                   endif
            3624                     
            3625                         ! -----------------------------------------------------------------------
            3626                         ! snow:
            3627                         ! -----------------------------------------------------------------------
            3628                     
            3629     1                   if (const_vs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vts
                                   <<< Loop-information  End >>>
            3630     1  pp   4v              vts (:) = vs_fac ! 1. ifs_2016
            3631     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, den, rhof, vts
                                   <<< Loop-information  End >>>
            3632     2  pp    v              do k = ks, ke
            3633     3   p    v                  if (qs (k) < ths) then
            3634     3   p    v                      vts (k) = vf_min
            3635     3   p    v                  else
            3636     3   p    v                      vts (k) = vs_fac * vcons * rhof (k) * exp (0.0625 * log (qs (k) * den (k) / norms))
            3637     3   p    v                      vts (k) = min (vs_max, max (vf_min, vts (k)))
            3638     3   p    v                  endif
            3639     2   p    v              enddo
            3640     1                   endif
            3641                     
            3642                         ! -----------------------------------------------------------------------
            3643                         ! graupel:
            3644                         ! -----------------------------------------------------------------------
            3645                     
            3646     1                   if (const_vg) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtg
                                   <<< Loop-information  End >>>
            3647     1  pp   4v              vtg (:) = vg_fac ! 2.
            3648     1                   else
            3649     2                       if (do_hail) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3650     3  pp    v                  do k = ks, ke
            3651     4   p    v                      if (qg (k) < thg) then
            3652     4   p    v                          vtg (k) = vf_min
            3653     4   p    v                      else
            3654     4   p    v                          vtg (k) = vg_fac * vconh * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normh)))
            3655     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3656     4   p    v                      endif
            3657     3   p    v                  enddo
            3658     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3659     3  pp    v                  do k = ks, ke
            3660     4   p    v                      if (qg (k) < thg) then
            3661     4   p    v                          vtg (k) = vf_min
            3662     4   p    v                      else
            3663     4   p    v                          vtg (k) = vg_fac * vcong * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normg)))
            3664     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3665     4   p    v                      endif
            3666     3   p    v                  enddo
            3667     2                       endif
            3668     1                   endif
            3669                     
            3670                     end subroutine fall_speed
            3671                     
            3672                     ! =======================================================================
            3673                     ! setup gfdl cloud microphysics parameters
            3674                     ! =======================================================================
            3675                     
            3676                     subroutine setupm
            3677                     
            3678                         implicit none
            3679                     
            3680                         real :: gcon, cd, scm3, pisq, act (8)
            3681                         real :: vdifu, tcond
            3682                         real :: visk
            3683                         real :: ch2o, hltf
            3684                         real :: hlts, hltc, ri50
            3685                     
            3686                         real, parameter :: gam263 = 1.456943, gam275 = 1.608355, gam290 = 1.827363, &
            3687                             gam325 = 2.54925, gam350 = 3.323363, gam380 = 4.694155, &
            3688                             gam425 = 8.285063, gam450 = 11.631769, gam480 = 17.837789, &
            3689                             gam625 = 184.860962, gam680 = 496.604067
            3690                     
            3691                         real, parameter :: acc (3) = (/ 5.0, 2.0, 0.5 /)
            3692                     
            3693                         real den_rc
            3694                     
            3695                         integer :: i, k
            3696                     
            3697                         pie = 4. * atan (1.0)
            3698                     
            3699                         ! s. klein's formular (eq 16) from am2
            3700                     
            3701                         fac_rc = (4. / 3.) * pie * rhor * rthresh ** 3
            3702                     
            3703     1                   if (prog_ccn) then
            3704     1                       ! if (master) write (*, *) 'prog_ccn option is .t.'
            3705     1                   else
            3706     1                       den_rc = fac_rc * ccn_o * 1.e6
            3707     1                       ! if (master) write (*, *) 'mp: for ccn_o = ', ccn_o, 'ql_rc = ', den_rc
            3708     1                       den_rc = fac_rc * ccn_l * 1.e6
            3709     1                       ! if (master) write (*, *) 'mp: for ccn_l = ', ccn_l, 'ql_rc = ', den_rc
            3710     1                   endif
            3711                     
            3712                         vdifu = 2.11e-5
            3713                         tcond = 2.36e-2
            3714                     
            3715                         visk = 1.259e-5
            3716                         hlts = hlv + hlf
            3717                         hltc = hlv
            3718                         hltf = hlf
            3719                     
            3720                         ch2o = c_liq
            3721                         ri50 = 1.e-4
            3722                     
            3723                         pisq = pie * pie
            3724                         scm3 = (visk / vdifu) ** (1. / 3.)
            3725                     
            3726                         cracs = pisq * rnzr * rnzs * rhos
            3727                         csacr = pisq * rnzr * rnzs * rhor
            3728     1                   if (do_hail) then
            3729     1                       cgacr = pisq * rnzr * rnzh * rhor
            3730     1                       cgacs = pisq * rnzh * rnzs * rhos
            3731     1                   else
            3732     1                       cgacr = pisq * rnzr * rnzg * rhor
            3733     1                       cgacs = pisq * rnzg * rnzs * rhos
            3734     1                   endif
            3735                         cgacs = cgacs * c_pgacs
            3736                     
            3737                         ! act: 1 - 2:racs (s - r) ; 3 - 4:sacr (r - s) ;
            3738                         ! 5 - 6:gacr (r - g) ; 7 - 8:gacs (s - g)
            3739                     
            3740                         act (1) = pie * rnzs * rhos
            3741                         act (2) = pie * rnzr * rhor
            3742     1                   if (do_hail) then
            3743     1                       act (6) = pie * rnzh * rhoh
            3744     1                   else
            3745     1                       act (6) = pie * rnzg * rhog
            3746     1                   endif
            3747                         act (3) = act (2)
            3748                         act (4) = act (1)
            3749                         act (5) = act (2)
            3750                         act (7) = act (1)
            3751                         act (8) = act (6)
            3752                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<< Loop-information  End >>>
            3753     1   s    v          do i = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3754     2   p   fv              do k = 1, 4
            3755     2   p   fv                  acco (i, k) = acc (i) / (act (2 * k - 1) ** ((7 - i) * 0.25) * act (2 * k) ** (i * 0.25))
            3756     2   p   fv              enddo
            3757     1   p    v          enddo
            3758                     
            3759                         gcon = 40.74 * sqrt (sfcrho) ! 44.628
            3760                     
            3761                         csacw = pie * rnzs * clin * gam325 / (4. * act (1) ** 0.8125)
            3762                         ! decreasing csacw to reduce cloud water --- > snow
            3763                     
            3764                         craci = pie * rnzr * alin * gam380 / (4. * act (2) ** 0.95)
            3765                         csaci = csacw * c_psaci
            3766                     
            3767     1                   if (do_hail) then
            3768     1                       cgacw = pie * rnzh * gam350 * gcon / (4. * act (6) ** 0.875)
            3769     1                   else
            3770     1                       cgacw = pie * rnzg * gam350 * gcon / (4. * act (6) ** 0.875)
            3771     1                   endif
            3772                         ! cgaci = cgacw * 0.1
            3773                     
            3774                         ! sjl, may 28, 2012
            3775                         cgaci = cgacw * 0.05
            3776                         ! sjl, may 28, 2012
            3777                     
            3778                         cracw = craci ! cracw = 3.27206196043822
            3779                         cracw = c_cracw * cracw
            3780                     
            3781                         ! subl and revp: five constants for three separate processes
            3782                     
            3783                         cssub (1) = 2. * pie * vdifu * tcond * rvgas * rnzs
            3784     1                   if (do_hail) then
            3785     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzh
            3786     1                   else
            3787     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzg
            3788     1                   endif
            3789                         crevp (1) = 2. * pie * vdifu * tcond * rvgas * rnzr
            3790                         cssub (2) = 0.78 / sqrt (act (1))
            3791                         cgsub (2) = 0.78 / sqrt (act (6))
            3792                         crevp (2) = 0.78 / sqrt (act (2))
            3793                         cssub (3) = 0.31 * scm3 * gam263 * sqrt (clin / visk) / act (1) ** 0.65625
            3794                         cgsub (3) = 0.31 * scm3 * gam275 * sqrt (gcon / visk) / act (6) ** 0.6875
            3795                         crevp (3) = 0.31 * scm3 * gam290 * sqrt (alin / visk) / act (2) ** 0.725
            3796                         cssub (4) = tcond * rvgas
            3797                         cssub (5) = hlts ** 2 * vdifu
            3798                         cgsub (4) = cssub (4)
            3799                         crevp (4) = cssub (4)
            3800                         cgsub (5) = cssub (5)
            3801                         crevp (5) = hltc ** 2 * vdifu
            3802                     
            3803                         cgfr (1) = 20.e2 * pisq * rnzr * rhor / act (2) ** 1.75
            3804                         cgfr (2) = 0.66
            3805                     
            3806                         ! smlt: five constants (lin et al. 1983)
            3807                     
            3808                         csmlt (1) = 2. * pie * tcond * rnzs / hltf
            3809                         csmlt (2) = 2. * pie * vdifu * rnzs * hltc / hltf
            3810                         csmlt (3) = cssub (2)
            3811                         csmlt (4) = cssub (3)
            3812                         csmlt (5) = ch2o / hltf
            3813                     
            3814                         ! gmlt: five constants
            3815                     
            3816     1                   if (do_hail) then
            3817     1                       cgmlt (1) = 2. * pie * tcond * rnzh / hltf
            3818     1                       cgmlt (2) = 2. * pie * vdifu * rnzh * hltc / hltf
            3819     1                   else
            3820     1                       cgmlt (1) = 2. * pie * tcond * rnzg / hltf
            3821     1                       cgmlt (2) = 2. * pie * vdifu * rnzg * hltc / hltf
            3822     1                   endif
            3823                         cgmlt (3) = cgsub (2)
            3824                         cgmlt (4) = cgsub (3)
            3825                         cgmlt (5) = ch2o / hltf
            3826                     
            3827                         es0 = e00
            3828                         ces0 = eps * es0
            3829                     
            3830                     end subroutine setupm
            3831                     

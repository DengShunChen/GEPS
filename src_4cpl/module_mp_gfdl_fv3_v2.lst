            5122                           END SUBROUTINE semi_lagrange_sedim
            5123                     
            5124                     !     compute fall speed of cloud rain and ice
            5125                           SUBROUTINE vqrqi(isg,r00,fv,qri,ql,tair,ww1)
            5126                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            5127                     ! compute fall speed of cloud rain and ice
            5128                     ! isg=1, for rain
            5129                     ! isg=2, for ice
            5130                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            5131                           implicit none
            5132                     
            5133                           integer, intent(in) :: isg
            5134                           real, intent(in) :: r00, fv,qri,ql,tair
            5135                           real, intent(inout) :: ww1
            5136                     
            5137                     ! LOCAL variables
            5138                           integer :: ic
            5139                           real  :: y1,vr,vs,vg
            5140                           real  :: const_vt, const_d, const_m !cpi, cmin Di
            5141                           real  :: cmin, draimax, tnw, vrc0, vrc1, vrc2, vrc3, zrc, cpi, roqr
            5142                           real  :: bb1, bb2,ice_fall
            5143                           real  :: bin_factor, ftnw, ftnwmin
            5144                           real, dimension(7) ::  aice, vice
            5145                           data aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./
            5146                           data vice/5,15,30,35,40,45,50/
            5147                     
            5148                           ice_fall=0.
            5149                           const_vt=1.49e4
            5150                           const_d=11.9
            5151                           const_m=1./5.38e7
            5152                           cmin=1.E-20
            5153                           cpi=4.*atan(1.)
            5154                           roqr=1.  !rain density (g/cm^3)
            5155                           tnw=0.08
            5156                     
            5157                           draimax=0.0500 !maximum rain diameter (cm)
            5158                           draimax=draimax**4.*roqr*cpi
            5159                           zrc=(cpi*roqr*tnw)**0.25
            5160                           vrc0=-26.7
            5161                           vrc1=20600./zrc
            5162                           vrc2=-204500./(zrc*zrc)
            5163                           vrc3=906000./(zrc*zrc*zrc)
            5164                     
            5165                           y1=r00*qri
            5166                           ww1=0.
            5167                     
            5168     1                     if (y1 .gt. cmin) then
            5169     1               
            5170     2                     if (isg.eq.1) then                             !  rain
            5171     2               
            5172     2                        ftnw=1.
            5173     3                          if(ql.lt.cmin .and. tair .gt. t_ice)then
            5174     3                            bin_factor=0.11*(1000.*qri)**(-1.27) + 0.98
            5175     3                            bin_factor=min(bin_factor, 1.30)
            5176     3                            ftnw=1./bin_factor**3.35
            5177     3                            ftnwmin=r00*qri/draimax
            5178     3                            if(qri.le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            5179     3                          endif
            5180     2               
            5181     2                              vs=sqrt( y1 )
            5182     2                              vg=sqrt( vs)
            5183     2               !               vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
            5184     2                              vr=vrc0+vrc1*vg/ftnw**0.25+vrc2*vs/ftnw**0.50+vrc3*vg*vs/ftnw**0.75
            5185     2                              ww1=max(fv*vr, 0.e0)
            5186     2               
            5187     2               
            5188     2                     else if (isg.eq.2) then                         ! cloud ice
            5189     2               
            5190     2                           y1=1.e6*r00*qri                            ! to g/m**3
            5191     2               
            5192     3                           if (y1 .gt. 1.e-6) then
            5193     3                                 y1=y1*1.e-3
            5194     3                                 bb1=const_m*y1**0.25
            5195     3                                 bb2=const_d*bb1**0.5
            5196     3                                 ww1=max(const_vt*bb2**1.31, 0.0)
            5197     3                                 ww1=ww1*100. !cm/s
            5198     3                                 if (ww1 .gt. 50.) ww1=50.               ! SLang
            5199     3                           endif  !y1
            5200     2                     endif  !isg
            5201     1                     endif !y1
            5202                     
            5203                           end subroutine vqrqi

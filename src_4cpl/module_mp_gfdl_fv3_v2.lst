            3168                     
            3169                     subroutine implicit_fall (dt, ks, ke, ze, vt, dp, q, precip, m1)
            3170                     
            3171                         implicit none
            3172                     
            3173                         integer, intent (in) :: ks, ke
            3174                         real, intent (in) :: dt
            3175                         real, intent (in), dimension (ks:ke + 1) :: ze
            3176                         real, intent (in), dimension (ks:ke) :: vt, dp
            3177                         real, intent (inout), dimension (ks:ke) :: q
            3178                         real, intent (out), dimension (ks:ke) :: m1
            3179                         real, intent (out) :: precip
            3180                         real, dimension (ks:ke) :: dz, qm, dd
            3181                         integer :: k
            3182                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dp, vt, ze, dd, dz
                                   <<< Loop-information  End >>>
            3183     1  pp    v          do k = ks, ke
            3184     1   p    v              dz (k) = ze (k) - ze (k + 1)
            3185     1   p    v              dd (k) = dt * vt (k)
            3186     1   p    v              q (k) = q (k) * dp (k)
            3187     1   p    v          enddo
            3188                     
            3189                         ! -----------------------------------------------------------------------
            3190                         ! sedimentation: non - vectorizable loop
            3191                         ! -----------------------------------------------------------------------
            3192                     
            3193                         qm (ks) = q (ks) / (dz (ks) + dd (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.19, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qm, dz, dd, q
                                   <<< Loop-information  End >>>
            3194     1   s   2s          do k = ks + 1, ke
            3195     1   m   2m              qm (k) = (q (k) + dd (k - 1) * qm (k - 1)) / (dz (k) + dd (k))
            3196     1   p   2v          enddo
            3197                     
            3198                         ! -----------------------------------------------------------------------
            3199                         ! qm is density at this stage
            3200                         ! -----------------------------------------------------------------------
            3201                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qm
                                   <<< Loop-information  End >>>
            3202     1  pp   2v          do k = ks, ke
            3203     1   p   2v              qm (k) = qm (k) * dz (k)
            3204     1   p   2v          enddo
            3205                     
            3206                         ! -----------------------------------------------------------------------
            3207                         ! output mass fluxes: non - vectorizable loop
            3208                         ! -----------------------------------------------------------------------
            3209                     
            3210                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3211     1   s   2s          do k = ks + 1, ke
            3212     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3213     1   p   2v          enddo
            3214                         precip = m1 (ke)
            3215                     
            3216                         ! -----------------------------------------------------------------------
            3217                         ! update:
            3218                         ! -----------------------------------------------------------------------
            3219                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3220     1  pp   2v          do k = ks, ke
            3221     1   p   2v              q (k) = qm (k) / dp (k) !dry dp used inside MP
            3222     1   p   2v          enddo
            3223                     
            3224                     end subroutine implicit_fall

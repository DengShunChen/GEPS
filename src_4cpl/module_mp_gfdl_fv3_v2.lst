            4517                     ! =======================================================================
            4518                     ! saturation water vapor pressure table ii
            4519                     ! 1 - phase table
            4520                     ! =======================================================================
            4521                     
            4522                     subroutine qs_tablew (n)
            4523                     
            4524                         implicit none
            4525                     
            4526                         integer, intent (in) :: n
            4527                     
            4528                         real (kind = r8) :: delt = 0.1
            4529                         real (kind = r8) :: tmin, tem, fac0, fac1, fac2
            4530                     
            4531                         integer :: i
            4532                     
            4533                         tmin = table_ice - 160.
            4534                     
            4535                         ! -----------------------------------------------------------------------
            4536                         ! compute es over water
            4537                         ! -----------------------------------------------------------------------
            4538                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tablew
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4539     1  pp    v          do i = 1, n
            4540     1   p    v              tem = tmin + delt * real (i - 1)
            4541     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4542     1   p    v              fac1 = fac0 * lv0
            4543     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4544     1   p    v              tablew (i) = e00 * exp (fac2)
            4545     1   p    v          enddo
            4546                     
            4547                     end subroutine qs_tablew
            4548                     
            4549                     ! =======================================================================
            4550                     ! saturation water vapor pressure table iii
            4551                     ! 2 - phase table
            4552                     ! =======================================================================
            4553                     
            4554                     subroutine qs_table2 (n)
            4555                     
            4556                         implicit none
            4557                     
            4558                         integer, intent (in) :: n
            4559                     
            4560                         real (kind = r8) :: delt = 0.1
            4561                         real (kind = r8) :: tmin, tem0, tem1, fac0, fac1, fac2
            4562                     
            4563                         integer :: i, i0, i1
            4564                     
            4565                         tmin = table_ice - 160.
            4566                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4567     1  pp    v          do i = 1, n
            4568     1   p    v              tem0 = tmin + delt * real (i - 1)
            4569     1   p    v              fac0 = (tem0 - t_ice) / (tem0 * t_ice)
            4570     2   p    v              if (i <= 1600) then
            4571     2                           ! -----------------------------------------------------------------------
            4572     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4573     2                           ! -----------------------------------------------------------------------
            4574     2   p    v                  fac1 = fac0 * li2
            4575     2   p    v                  fac2 = (d2ice * log (tem0 / t_ice) + fac1) / rvgas
            4576     2   p    v              else
            4577     2                           ! -----------------------------------------------------------------------
            4578     2                           ! compute es over water between 0 deg c and 102 deg c.
            4579     2                           ! -----------------------------------------------------------------------
            4580     2   p    v                  fac1 = fac0 * lv0
            4581     2   p    v                  fac2 = (dc_vap * log (tem0 / t_ice) + fac1) / rvgas
            4582     2   p    v              endif
            4583     1   p    v              table2 (i) = e00 * exp (fac2)
            4584     1   p    v          enddo
            4585                     
            4586                         ! -----------------------------------------------------------------------
            4587                         ! smoother around 0 deg c
            4588                         ! -----------------------------------------------------------------------
            4589                     
            4590                         i0 = 1600
            4591                         i1 = 1601
            4592                         tem0 = 0.25 * (table2 (i0 - 1) + 2. * table (i0) + table2 (i0 + 1))
            4593                         tem1 = 0.25 * (table2 (i1 - 1) + 2. * table (i1) + table2 (i1 + 1))
            4594                         table2 (i0) = tem0
            4595                         table2 (i1) = tem1
            4596                     
            4597                     end subroutine qs_table2
            4598                     
            4599                     ! =======================================================================
            4600                     ! saturation water vapor pressure table iv
            4601                     ! 2 - phase table with " - 2 c" as the transition point
            4602                     ! =======================================================================
            4603                     
            4604                     subroutine qs_table3 (n)
            4605                     
            4606                         implicit none
            4607                     
            4608                         integer, intent (in) :: n
            4609                     
            4610                         real (kind = r8) :: delt = 0.1
            4611                         real (kind = r8) :: esbasw, tbasw, esbasi, tmin, tem, aa, b, c, d, e
            4612                         real (kind = r8) :: tem0, tem1
            4613                     
            4614                         integer :: i, i0, i1
            4615                     
            4616                         esbasw = 1013246.0
            4617                         tbasw = table_ice + 100.
            4618                         esbasi = 6107.1
            4619                         tmin = table_ice - 160.
            4620                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 42
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4621     1  pp    v          do i = 1, n
            4622     1   p    v              tem = tmin + delt * real (i - 1)
            4623     1                       ! if (i <= 1600) then
            4624     2   p    v              if (i <= 1580) then ! change to - 2 c
            4625     2                           ! -----------------------------------------------------------------------
            4626     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4627     2                           ! see smithsonian meteorological tables page 350.
            4628     2                           ! -----------------------------------------------------------------------
            4629     2   p    v                  aa = - 9.09718 * (table_ice / tem - 1.)
            4630     2   p    v                  b = - 3.56654 * log10 (table_ice / tem)
            4631     2   p    v                  c = 0.876793 * (1. - tem / table_ice)
            4632     2   p    v                  e = log10 (esbasi)
            4633     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + e)
            4634     2   p    v              else
            4635     2                           ! -----------------------------------------------------------------------
            4636     2                           ! compute es over water between - 2 deg c and 102 deg c.
            4637     2                           ! see smithsonian meteorological tables page 350.
            4638     2                           ! -----------------------------------------------------------------------
            4639     2   p    v                  aa = - 7.90298 * (tbasw / tem - 1.)
            4640     2   p    v                  b = 5.02808 * log10 (tbasw / tem)
            4641     2   p    v                  c = - 1.3816e-7 * (10 ** ((1. - tem / tbasw) * 11.344) - 1.)
            4642     2   p    v                  d = 8.1328e-3 * (10 ** ((tbasw / tem - 1.) * (- 3.49149)) - 1.)
            4643     2   p    v                  e = log10 (esbasw)
            4644     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + d + e)
            4645     2   p    v              endif
            4646     1   p    v          enddo
            4647                     
            4648                         ! -----------------------------------------------------------------------
            4649                         ! smoother around - 2 deg c
            4650                         ! -----------------------------------------------------------------------
            4651                     
            4652                         i0 = 1580
            4653                         i1 = 1581
            4654                         tem0 = 0.25 * (table3 (i0 - 1) + 2. * table (i0) + table3 (i0 + 1))
            4655                         tem1 = 0.25 * (table3 (i1 - 1) + 2. * table (i1) + table3 (i1 + 1))
            4656                         table3 (i0) = tem0
            4657                         table3 (i1) = tem1
            4658                     
            4659                     end subroutine qs_table3
            4660                     
            4661                     ! =======================================================================
            4662                     ! compute the saturated specific humidity for table
            4663                     ! note: this routine is based on "moist" mixing ratio
            4664                     ! =======================================================================
            4665                     
            4666                     real function qs_blend (t, p, q)
            4667                     
            4668                         implicit none
            4669                     
            4670                         real, intent (in) :: t, p, q
            4671                     
            4672                         real :: es, ap1, tmin
            4673                     
            4674                         integer :: it
            4675                     
            4676                         tmin = table_ice - 160.
            4677                         ap1 = 10. * dim (t, tmin) + 1.
            4678                         ap1 = min (2621., ap1)
            4679                         it = ap1
            4680                         es = table (it) + (ap1 - it) * des (it)
            4681                         qs_blend = eps * es * (1. + zvir * q) / p
            4682                     
            4683                     end function qs_blend
            4684                     
            4685                     ! =======================================================================
            4686                     ! saturation water vapor pressure table i
            4687                     ! 3 - phase table
            4688                     ! =======================================================================
            4689                     
            4690                     subroutine qs_table (n)
            4691                     
            4692                         implicit none
            4693                     
            4694                         integer, intent (in) :: n
            4695                     
            4696                         real (kind = r8) :: delt = 0.1
            4697                         real (kind = r8) :: tmin, tem, esh20
            4698                         real (kind = r8) :: wice, wh2o, fac0, fac1, fac2
            4699                         real (kind = r8) :: esupc (200)
            4700                     
            4701                         integer :: i
            4702                     
            4703                         tmin = table_ice - 160.
            4704                     
            4705                         ! -----------------------------------------------------------------------
            4706                         ! compute es over ice between - 160 deg c and 0 deg c.
            4707                         ! -----------------------------------------------------------------------
            4708                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.46, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 48
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4709     1  pp    v          do i = 1, 1600
            4710     1   p    v              tem = tmin + delt * real (i - 1)
            4711     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4712     1   p    v              fac1 = fac0 * li2
            4713     1   p    v              fac2 = (d2ice * log (tem / t_ice) + fac1) / rvgas
            4714     1   p    v              table (i) = e00 * exp (fac2)
            4715     1   p    v          enddo
            4716                     
            4717                         ! -----------------------------------------------------------------------
            4718                         ! compute es over water between - 20 deg c and 102 deg c.
            4719                         ! -----------------------------------------------------------------------
            4720                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            4721     1  pp    v          do i = 1, 1221
            4722     1   p    v              tem = 253.16 + delt * real (i - 1)
            4723     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4724     1   p    v              fac1 = fac0 * lv0
            4725     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4726     1   p    v              esh20 = e00 * exp (fac2)
            4727     2   p    v              if (i <= 200) then
            4728     2   p    v                  esupc (i) = esh20
            4729     2   p    v              else
            4730     2   p    v                  table (i + 1400) = esh20
            4731     2   p    v              endif
            4732     1   p    v          enddo
            4733                     
            4734                         ! -----------------------------------------------------------------------
            4735                         ! derive blended es over ice and supercooled water between - 20 deg c and 0 deg c
            4736                         ! -----------------------------------------------------------------------
            4737                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table, (unknown)
                                   <<< Loop-information  End >>>
            4738     1   s   2v          do i = 1, 200
            4739     1   p   2v              tem = 253.16 + delt * real (i - 1)
            4740     1   p   2v              wice = 0.05 * (table_ice - tem)
            4741     1   p   2v              wh2o = 0.05 * (tem - 253.16)
            4742     1   p   2v              table (i + 1400) = wice * table (i + 1400) + wh2o * esupc (i)
            4743     1   p   2v          enddo
            4744                     
            4745                     end subroutine qs_table

            4674                     ! =======================================================================
            4675                     ! saturation water vapor pressure table i
            4676                     ! 3 - phase table
            4677                     ! =======================================================================
            4678                     
            4679                     subroutine qs_table (n)
            4680                     
            4681                         implicit none
            4682                     
            4683                         integer, intent (in) :: n
            4684                     
            4685                         real (kind = r8) :: delt = 0.1
            4686                         real (kind = r8) :: tmin, tem, esh20
            4687                         real (kind = r8) :: wice, wh2o, fac0, fac1, fac2
            4688                         real (kind = r8) :: esupc (200)
            4689                     
            4690                         integer :: i
            4691                     
            4692                         tmin = table_ice - 160.
            4693                     
            4694                         ! -----------------------------------------------------------------------
            4695                         ! compute es over ice between - 160 deg c and 0 deg c.
            4696                         ! -----------------------------------------------------------------------
            4697                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.46, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 48
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4698     1  pp    v          do i = 1, 1600
            4699     1   p    v              tem = tmin + delt * real (i - 1)
            4700     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4701     1   p    v              fac1 = fac0 * li2
            4702     1   p    v              fac2 = (d2ice * log (tem / t_ice) + fac1) / rvgas
            4703     1   p    v              table (i) = e00 * exp (fac2)
            4704     1   p    v          enddo
            4705                     
            4706                         ! -----------------------------------------------------------------------
            4707                         ! compute es over water between - 20 deg c and 102 deg c.
            4708                         ! -----------------------------------------------------------------------
            4709                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            4710     1  pp    v          do i = 1, 1221
            4711     1   p    v              tem = 253.16 + delt * real (i - 1)
            4712     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4713     1   p    v              fac1 = fac0 * lv0
            4714     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4715     1   p    v              esh20 = e00 * exp (fac2)
            4716     2   p    v              if (i <= 200) then
            4717     2   p    v                  esupc (i) = esh20
            4718     2   p    v              else
            4719     2   p    v                  table (i + 1400) = esh20
            4720     2   p    v              endif
            4721     1   p    v          enddo
            4722                     
            4723                         ! -----------------------------------------------------------------------
            4724                         ! derive blended es over ice and supercooled water between - 20 deg c and 0 deg c
            4725                         ! -----------------------------------------------------------------------
            4726                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table, (unknown)
                                   <<< Loop-information  End >>>
            4727     1   s   2v          do i = 1, 200
            4728     1   p   2v              tem = 253.16 + delt * real (i - 1)
            4729     1   p   2v              wice = 0.05 * (table_ice - tem)
            4730     1   p   2v              wh2o = 0.05 * (tem - 253.16)
            4731     1   p   2v              table (i + 1400) = wice * table (i + 1400) + wh2o * esupc (i)
            4732     1   p   2v          enddo
            4733                     
            4734                     end subroutine qs_table

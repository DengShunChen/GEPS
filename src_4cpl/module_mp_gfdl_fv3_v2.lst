            4378                         ap1 = min (2621., ap1)
            4379                         it = ap1
            4380                         es_w = tablew (it) + (ap1 - it) * desw (it)
            4381                         es_i = table2 (it) + (ap1 - it) * des2 (it)
            4382                         d_sat = dim (es_w, es_i) / (rvgas * ta * den) ! take positive difference
            4383                     
            4384                     end function d_sat

                                   <<< Loop-information  End >>>
            5111     1   s   2s            do k=km,1,-1
            5112     2   p   2v               if(k == km) then
            5113     2   m   2v                 pfsan(k) = net_flx(k)*grav               !xb141, because convt=1./grav
            5114     2   p   2v               else
            5115     2   m   2m                 pfsan(k) = pfsan(k+1) + net_flx(k)*grav  !xb141, because convt=1./grav
            5116     2   p   2v               end if
            5117     1   p   2v            enddo

            4351                     ! =======================================================================
            4352                     ! computes the difference in saturation vapor * density * between water and ice
            4353                     ! =======================================================================
            4354                     
            4355                     real function d_sat (ta, den)
            4356                     
            4357                         implicit none
            4358                     
            4359                         real, intent (in) :: ta, den
            4360                     
            4361                         real :: es_w, es_i, ap1, tmin
            4362                     
            4363                         integer :: it
            4364                     
            4365                         tmin = table_ice - 160.
            4366                         ap1 = 10. * dim (ta, tmin) + 1.
            4367                         ap1 = min (2621., ap1)
            4368                         it = ap1
            4369                         es_w = tablew (it) + (ap1 - it) * desw (it)
            4370                         es_i = table2 (it) + (ap1 - it) * des2 (it)
            4371                         d_sat = dim (es_w, es_i) / (rvgas * ta * den) ! take positive difference
            4372                     
            4373                     end function d_sat

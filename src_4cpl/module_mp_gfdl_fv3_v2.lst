            4328                     ! =======================================================================
            4329                     ! compute the saturated specific humidity for table iii
            4330                     ! =======================================================================
            4331                     
            4332                     real function qs1d_m (ta, qv, pa)
            4333                     
            4334                         implicit none
            4335                     
            4336                         real, intent (in) :: ta, pa, qv
            4337                     
            4338                         real :: es, ap1, tmin
            4339                     
            4340                         integer :: it
            4341                     
            4342                         tmin = table_ice - 160.
            4343                         ap1 = 10. * dim (ta, tmin) + 1.
            4344                         ap1 = min (2621., ap1)
            4345                         it = ap1
            4346                         es = table2 (it) + (ap1 - it) * des2 (it)
            4347                         qs1d_m = eps * es * (1. + zvir * qv) / pa
            4348                     
            4349                     end function qs1d_m

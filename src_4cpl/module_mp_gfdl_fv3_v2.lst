            2788     2   p    v                  q_liq (k) = q_liq (k) + sink
            2789     2   p    v                  q_sol (k) = q_sol (k) - sink
            2790     2   p    v                  tz (k) = tz (k) * cvm (k) - li00 * sink
            2791     2   p    v                  cvm (k) = 1. + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2792     2   p    v                  tz (k) = tz (k) / cvm (k)
            2793     2   p    v                  tc = tz (k) - tice
            2794     2   p    v              endif
            2795     1   p    v          enddo

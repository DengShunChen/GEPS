            4288                     
            4289                         real :: es, ap1, tmin, eps10
            4290                     
            4291                         integer :: it
            4292                     
            4293                         tmin = table_ice - 160.
            4294                         eps10 = 10. * eps
            4295                         ap1 = 10. * dim (ta, tmin) + 1.
            4296                         ap1 = min (2621., ap1)
            4297                         it = ap1
            4298                         es = tablew (it) + (ap1 - it) * desw (it)
            4299                         wqsat2_moist = eps * es * (1. + zvir * qv) / pa
            4300                         it = ap1 - 0.5
            4301                         dqdt = eps10 * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) * (1. + zvir * qv) / pa
            4302                     
            4303                     end function wqsat2_moist
            4304                     
            4305                     ! =======================================================================
            4306                     ! compute the saturated specific humidity for table ii
            4307                     ! =======================================================================
            4308                     
            4309                     real function wqsat_moist (ta, qv, pa)
            4310                     
            4311                         implicit none
            4312                     
            4313                         real, intent (in) :: ta, pa, qv
            4314                     
            4315                         real :: es, ap1, tmin
            4316                     
            4317                         integer :: it
            4318                     

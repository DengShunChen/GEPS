             248                     
             249                         ! -----------------------------------------------------------------------
             250                         ! wrf / wsm6 scheme: qi_gen = 4.92e-11 * (1.e3 * exp (0.1 * tmp)) ** 1.33
             251                         ! optimized: qi_gen = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp)))
             252                         ! qi_gen ~ 4.808e-7 at 0 c; 1.818e-6 at - 10 c, 9.82679e-5 at - 40c
             253                         ! the following value is constructed such that qc_crt = 0 at zero c and @ - 10c matches
             254                         ! wrf / wsm6 ice initiation scheme; qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den
             255                         ! -----------------------------------------------------------------------
             256                     
             257                         real :: sat_adj0 = 0.90 ! adjustment factor (0: no, 1: full) during fast_sat_adj
             258                     
             259                         real :: qc_crt = 5.0e-8 ! mini condensate mixing ratio to allow partial cloudiness
             260                     
             261                         real :: qi_lim = 1. ! cloud ice limiter to prevent large ice build up
             262                     
             263                         real :: ql_mlt = 2.0e-3 ! max value of cloud water allowed from melted cloud ice
             264                         real :: qs_mlt = 1.0e-6 ! max cloud water due to snow melt
             265                     
             266                         real :: ql_gen = 1.0e-3 ! max cloud water generation during remapping step if do_sat_adj = .t.
             267                         real :: qi_gen = 1.82e-6 ! max cloud ice generation during remapping step
             268                     
             269                         ! cloud condensate upper bounds: "safety valves" for ql & qi
             270                     
             271                         real :: ql0_max = 2.0e-3 ! max cloud water value (auto converted to rain)
             272                         real :: qi0_max = 1.0e-4 ! max cloud ice value (by other sources)
             273                     
             274                     !    real :: qi0_crt = 1.0e-4 ! cloud ice to snow autoconversion threshold (was 1.e-4)
             275                         real :: qi0_crt = 0.2e-4 ! cloud ice to snow autoconversion threshold (was 1.e-4)
             276                         ! qi0_crt if negative, its magnitude is used as the mixing ration threshold; otherwise, used as density
             277                         real :: qr0_crt = 1.0e-4 ! rain to snow or graupel / hail threshold
             278                         ! lin et al. (1983) used * mixing ratio * = 1.e-4 (hail)
             279                         real :: qs0_crt = 1.0e-3 ! snow to graupel density threshold (0.6e-3 in purdue lin scheme)
             280                     
             281                         real :: c_paut = 0.55 ! autoconversion cloud water to rain (use 0.5 to reduce autoconversion)
             282                         real :: c_psaci = 0.02 ! accretion: cloud ice to snow (was 0.1 in zetac)
             283                         real :: c_piacr = 5.0 ! accretion: rain to ice: (not used)
             284                         real :: c_cracw = 0.9 ! rain accretion efficiency
             285                         real :: c_pgacs = 2.0e-3 ! snow to graupel "accretion" eff. (was 0.1 in zetac)
             286                     
             287                         ! decreasing clin to reduce csacw (so as to reduce cloud water --- > snow)
             288                     
             289                         real :: alin = 842.0 ! "a" in lin et al. (1983)
             290                         real :: clin = 4.8 ! "c" in lin et al. (1983), 4.8 -- > 6. (to ehance ql -- > qs)
             291                     
             292                         logical :: const_vi = .false. ! if .t. the constants are specified by v * _fac
             293                         logical :: const_vs = .false. ! if .t. the constants are specified by v * _fac
             294                         logical :: const_vg = .false. ! if .t. the constants are specified by v * _fac
             295                         logical :: const_vr = .false. ! if .t. the constants are specified by v * _fac
             296                     
             297                     !    real :: vi_fac = 1. ! ifs: if const_vi: 1 / 3
             298                         real :: vi_fac = 0.9 ! CWB FV3
             299                         real :: vs_fac = 1. ! ifs: if const_vs: 1.
             300                         real :: vg_fac = 1. ! ifs: if const_vg: 2.
             301                         real :: vr_fac = 1. ! ifs: if const_vr: 4.
             302                     
             303                         real :: vi_max = 0.5 ! max fall speed for ice
             304                         real :: vs_max = 5.0 ! max fall speed for snow
             305                         real :: vg_max = 8.0 ! max fall speed for graupel
             306                         real :: vr_max = 12. ! max fall speed for rain
             307                     
             308                         real :: xr_a = 0.25 ! p value in xu and randall, 1996
             309                         real :: xr_b = 100. ! alpha_0 value in xu and randall, 1996
             310                         real :: xr_c = 0.49 ! gamma value in xu and randall, 1996
             311                     
             312                         real :: te_err = 1.e-14 ! 64bit: 1.e-14, 32bit: 1.e-7
             313                     
             314                         logical :: do_sat_adj = .false. ! has fast saturation adjustments
             315                         logical :: z_slope_liq = .true. ! use linear mono slope for autocconversions
             316                         logical :: z_slope_ice = .false. ! use linear mono slope for autocconversions
             317                         logical :: use_ccn = .false. ! must be true when prog_ccn is false
             318                         logical :: use_ppm = .false. ! use ppm fall scheme
             319                         logical :: use_ppm_ice = .false. ! use ppm fall scheme for cloud ice
             320                     !    logical :: use_semi = .true. ! use Semi-Lagrangian sedimentation
             321                     !    logical :: use_semi_ice = .false. ! use Semi-Lagrangian sedimentation for cloud ice
             322                         logical :: mono_prof = .true. ! perform terminal fall with mono ppm scheme
             323                         logical :: do_hail = .false. ! use hail parameters instead of graupel
             324                         logical :: hd_icefall = .false. ! use heymsfield and donner, 1990's fall speed of cloud ice
             325                         logical :: gce_icefall = .false. ! use Goddard's fall speed of cloud ice
             326                         logical :: use_xr_cloud = .false. ! use xu and randall, 1996's cloud diagnosis
             327                         logical :: use_park_cloud = .false. ! park et al. 2016
             328                         logical :: use_gi_cloud = .false. ! gultepe and isaac (2007, grl)
             329                         logical :: use_rhc_cevap = .false. ! cap of rh for cloud water evaporation
             330                         logical :: use_rhc_revap = .false. ! cap of rh for rain evaporation
             331                         logical :: consv_checker = .false. ! turn on energy and water conservation checker
             332                         logical :: do_warm_rain_mp = .false. ! do warm rain cloud microphysics only
             333                         ! turn off to save time, turn on only in c48 64bit
             334                     
             335                         real :: g2, log_10
             336                     
             337                         real :: rh_thres = 0.75
             338                         real :: rhc_cevap = 0.85 ! cloud water
             339                         real :: rhc_revap = 0.85 ! rain
             340                     
             341                         real :: f_dq_p = 1.0
             342                         real :: f_dq_m = 1.0
             343                         logical :: do_cld_adj = .false.
             344                     
             345                         integer :: inflag = 1 ! ice nucleation scheme
             346                         ! 1: hong et al., 2004
             347                         ! 2: meyers et al., 1992
             348                         ! 3: meyers et al., 1992
             349                         ! 4: cooper, 1986
             350                         ! 5: flecther, 1962
             351                     
             352                         integer :: rewflag = 1
             353                         ! 1: martin et al., 1994
             354                         ! 2: martin et al., 1994, gfdl revision
             355                         ! 3: kiehl et al., 1994
             356                     
             357                         integer :: reiflag = 5
             358                         ! 1: heymsfield and mcfarquhar, 1996
             359                         ! 2: donner et al., 1997
             360                         ! 3: fu, 2007
             361                         ! 4: kristjansson et al., 2000
             362                         ! 5: wyser, 1998
             363                         ! 6: Heymsfield et al.,2014  !not finished (by xb141)
             364                     
             365                         integer :: ccnflag = 1
             366                         ! 1: default in GFDL MP v2
             367                         ! 2: same as use_ccn=f in GFDL MP v1, ccn=ccn0/den
             368                         ! 3: same as use_ccn=t in GFDL MP v1, ccn=ccn0/densfc
             369                         ! -----------------------------------------------------------------------
             370                         ! namelist
             371                         ! -----------------------------------------------------------------------
             372                     
             373                         namelist / gfdl_mp_nml / &
             374                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             375                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             376                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             377                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             378                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             379                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             380                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             381                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             382                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             383                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             384                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             385                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             386                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &
             387                             rh_thres, f_dq_p, f_dq_m, do_cld_adj
             388                     
             389                         public &
             390                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             391                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             392                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             393                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             394                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             395                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             396                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             397                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             398                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             399                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             400                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             401                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             402                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &
             403                             rh_thres, f_dq_p, f_dq_m, do_cld_adj, liq_ice_combine, snow_grauple_combine, &
             404                             rewflag, reiflag, ccnflag
             405                     
             406                     contains
             407                     
             408                     ! -----------------------------------------------------------------------
             409                     ! the driver of the gfdl cloud microphysics
             410                     ! -----------------------------------------------------------------------
             411                     
             412                     subroutine gfdl_cld_mp_driver                                              &
             413                                 ( qv, ql, qr, qi, qs, qg, qa, qnl, qni,                        &
             414                                   pt, w, ua, va, dz, delp, gsize, dts, hs,                     &
             415                                   land,                                                        &
             416                                   rain, snow, ice, graupel, hydrostatic,                       &
             417                                   is, ie, ks, ke, q_con, cappa, consv_te, te,                  &
             418                     #ifdef EXT_DIAG
             419                                   prefluxr, prefluxi, prefluxs, prefluxg,                      &
             420                                   condensation, deposition, evaporation, sublimation,          &
             421                     #endif
             422                                   rhc, last_step, do_inline_mp, me )
             423                     
             424                         implicit none
             425                     
             426                         logical, intent (in) :: hydrostatic
             427                         logical, intent (in) :: last_step
             428                         logical, intent (in) :: consv_te
             429                         logical, intent (in) :: do_inline_mp
             430                     
             431                         integer, intent (in) :: is, ie ! physics window
             432                         integer, intent (in) :: ks, ke ! vertical dimension
             433                     
             434                         real, intent (in) :: dts ! physics time step
             435                     
             436                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             437                     
             438                         real, intent (in), dimension (is:ie) :: hs, gsize, land
             439                     
             440                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             441                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             442                     
             443                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             444                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             445                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             446                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             447                         real, intent (inout), dimension (is:ie, ks:ke) :: te
             448                     #ifdef EXT_DIAG
             449                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             450                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             451                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             452                     #endif
             453                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             454                         ! logical :: used
             455                     !    real, dimension (is:ie) :: w_var
             456                     !    real, dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             457                         real, dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             458                     #ifndef EXT_DIAG
             459                         real, dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             460                         real, dimension (is:ie) :: condensation, deposition
             461                         real, dimension (is:ie) :: evaporation, sublimation
             462                     #endif
             463                         integer me
             464     1                   if (last_step) then
             465     1                       p_min = p0_min ! final clean - up
             466     1                   else
             467     1                       p_min = 30.e2 ! time saving trick
             468     1                   endif
             469                     
             470                         ! -----------------------------------------------------------------------
             471                         ! define heat capacity of dry air and water vapor based on hydrostatical property
             472                         ! -----------------------------------------------------------------------
             473                     
             474     1                   if (hydrostatic) then
             475     1                       c_air = cp_air
             476     1                       c_vap = cp_vap
             477     1                       do_sedi_w = .false.
             478     1                   else
             479     1                       c_air = cv_air
             480     1                       c_vap = cv_vap
             481     1                   endif
             482                         d0_vap = c_vap - c_liq
             483                     
             484                         ! scaled constants (to reduce fp errors for 32 - bit) :
             485                         d1_vap = d0_vap / c_air
             486                         d1_ice = dc_ice / c_air
             487                     
             488                         ! lv0 = hlv0 - (c_vap - c_liq) * t_ice! 3.13905782e6, evaporation latent heat coefficient at 0 deg k
             489                         lv00 = (hlv0 - d0_vap * t_ice) / c_air
             490                         li00 = (hlf0 - dc_ice * t_ice) / c_air
             491                         li20 = lv00 + li00
             492                     
             493                         c1_vap = c_vap / c_air
             494                         c1_liq = c_liq / c_air
             495                         c1_ice = c_ice / c_air
             496                     
             497                         ! -----------------------------------------------------------------------
             498                         ! define latent heat coefficient used in wet bulb and bigg mechanism
             499                         ! -----------------------------------------------------------------------
             500                     
             501                         lat2 = (hlv + hlf) ** 2
             502                     
             503                         lcp = hlv / cp_air
             504                         icp = hlf / cp_air
             505                         tcp = (hlv + hlf) / cp_air
             506                     
             507                         ! tendency zero out for am moist processes should be done outside the driver
             508                     
             509                         ! -----------------------------------------------------------------------
             510                         ! major cloud microphysics
             511                         ! -----------------------------------------------------------------------
             512                     
             513                         call mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, qg, &
             514                             qa, qnl, qni, dz, is, ie, ks, ke, dts, &
             515                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             516                     #ifdef oldmask
             517                             land, &
             518                     #endif
             519                     !        w_var, vt_r, vt_s, vt_g, vt_i,
             520                             q_con, cappa, consv_te, te, &
             521                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             522                             evaporation, sublimation, rhc, last_step, do_inline_mp, me)
             523                     
             524                     end subroutine gfdl_cld_mp_driver
             525                     
             526                     ! -----------------------------------------------------------------------
             527                     ! gfdl cloud microphysics, major program
             528                     ! lin et al., 1983, jam, 1065 - 1092, and
             529                     ! rutledge and hobbs, 1984, jas, 2949 - 2972
             530                     ! terminal fall is handled lagrangianly by conservative fv algorithm
             531                     ! pt: temperature (k)
             532                     ! 6 water species:
             533                     ! 1) qv: water vapor (kg / kg)
             534                     ! 2) ql: cloud water (kg / kg)
             535                     ! 3) qr: rain (kg / kg)
             536                     ! 4) qi: cloud ice (kg / kg)
             537                     ! 5) qs: snow (kg / kg)
             538                     ! 6) qg: graupel (kg / kg)
             539                     ! -----------------------------------------------------------------------
             540                     
             541                     subroutine mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, &
             542                             qg, qa, qnl, qni, dz, is, ie, ks, ke, dt_in, &
             543                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             544                     #ifdef oldmask
             545                             land, &
             546                     #endif
             547                     !        w_var, vt_r, vt_s, vt_g, vt_i,
             548                             q_con, cappa, consv_te, te, &
             549                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             550                             evaporation, sublimation, rhc, last_step, do_inline_mp, me )
             551                     
             552                         implicit none
             553                     
             554                         logical, intent (in) :: hydrostatic
             555                         logical, intent (in) :: last_step
             556                         logical, intent (in) :: consv_te
             557                         logical, intent (in) :: do_inline_mp
             558                         integer, intent (in) :: is, ie, ks, ke
             559                         real, intent (in) :: dt_in
             560                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             561                         real, intent (in), dimension (is:ie) :: gsize
             562                         real, intent (in), dimension (is:ie) :: hs
             563                     #ifdef oldmask
             564                         real, intent (in), dimension (is:ie) :: land
             565                     #endif
             566                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             567                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             568                     
             569                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             570                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             571                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             572                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             573                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             574                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             575                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             576                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             577                     
             578                     !    real, intent (out), dimension (is:ie) :: w_var
             579                     !    real, intent (out), dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             580                         real, intent (out), dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             581                         real, intent (out), dimension (is:ie, ks:ke) :: te
             582                         ! local:
             583                         real, dimension (ks:ke) :: q_liq, q_sol
             584                         real, dimension (ks:ke) :: qvz, qlz, qrz, qiz, qsz, qgz, qaz
             585                         real, dimension (ks:ke) :: vtiz, vtsz, vtgz, vtrz, pfr, pfi, pfs, pfg
             586                         real, dimension (ks:ke) :: dp1, dz1
             587                         real, dimension (ks:ke) :: den, p1, denfac
             588                         real, dimension (ks:ke) :: ccn, cin, c_praut, m1_rain, m1_sol, m1
             589                         real, dimension (ks:ke) :: u0, v0, u1, v1, w1
             590                         real, dimension (ks:ke) :: rhcz
             591                     
             592                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg, te_end, tw_beg, tw_end
             593                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg_0, te_end_0, tw_beg_0, tw_end_0
             594                         real (kind = r8), dimension (is:ie) :: te_b_beg, te_b_end, tw_b_beg, tw_b_end, dte, te_loss
             595                         real (kind = r8), dimension (is:ie) :: te_b_beg_0, te_b_end_0, tw_b_beg_0, tw_b_end_0
             596                         real (kind = r8), dimension (ks:ke) :: te1, te2
             597                     
             598                         real :: cpaut, rh_adj, rh_rain
             599                         real :: r1, s1, i1, g1, rdt, ccn0
             600                         real :: dt_rain
             601                         real :: s_leng, t_land, t_ocean, h_var, tmp
             602                         real (kind = r8), dimension (ks:ke) :: dp0, tz, cvm
             603                         real (kind = r8) :: con_r8, c8
             604                         real :: convt
             605                         real :: dts, q_cond
             606                         real :: nl, ni
             607                         real :: cond, dep, reevap, sub
             608                     
             609                         integer :: i, k, n, me
             610                     
             611                         logical  :: last_step_cld=.false.
             612                     
             613                         ntimes = max (ntimes, int (dt_in / min (dt_in, mp_time)))
             614                         dts = dt_in / real (ntimes)
             615                     
             616                         dt_rain = dts * 0.5
             617                         rdt = one_r8 / dts
             618                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dte
                                   <<< Loop-information  End >>>
             619        pp   4v          dte = 0.0
             620                     
             621                         !! convert to mm / day (original)
             622                         ! convt = 86400. * rdt * rgrav
             623                     
             624                         !! convert to mm / s
             625                         ! convt = rdt * rgrav
             626                     
             627                         ! convert to mm
             628                         convt = rgrav
             629                     
             630                         ! -----------------------------------------------------------------------
             631                         ! use local variables
             632                         ! -----------------------------------------------------------------------
             633                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, q_liq, cvm, u1, qsz, v1, qiz
                                   <<<      qrz, qlz, qvz, qgz, w1, dp1, den, ccn
                                   <<<      c_praut, dp0, m1, v0, u0, qaz
                                   <<< Loop-information  End >>>
             634     1                   do i = is, ie
             635     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
             636     2  pp   4v              do k = ks, ke
             637     3   p   4v                  if (do_inline_mp) then
             638     3               #ifdef MOIST_CAPPA
             639     3                               tz (k) = pt (i, k) / ((1. + zvir * qv (i, k)) * (1. - (ql (i, k) + qr (i, k) + qi (i, k) + qs (i, k) + qg (i, k))))
             640     3               #else
             641     3       4                       tz (k) = pt (i, k) / (1. + zvir * qv (i, k))
             642     3               #endif
             643     3   p   4v                  else
             644     3   p   4v                      tz (k) = pt (i, k)
             645     3   p   4v                  endif
             646     2   p   4v              enddo
             647     1               
             648     1                       ! -----------------------------------------------------------------------
             649     1                       ! total energy checker
             650     1                       ! -----------------------------------------------------------------------
             651     1               
             652     2                       if (consv_checker) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 184
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.42, ITR: 40, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, cvm, q_liq
                                   <<< Loop-information  End >>>
             653     3  pp    v                  do k = ks, ke
             654     3   p    v                      q_liq (k) = ql (i, k) + qr (i, k)
             655     3   p    v                      q_sol (k) = qi (i, k) + qs (i, k) + qg (i, k)
             656     3   p    v                      cvm (k) = c_air * (1.0 - qv (i, k) - q_liq (k) - q_sol (k)) + &
             657     3                                   qv (i, k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
             658     3   p    v                      te_beg_0 (i, k) = cvm (k) * tz (k) + lv00 * c_air * qv (i, k) - li00 * c_air * q_sol (k)
             659     4   p    v                      if (hydrostatic) then
             660     4                                   te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2)
             661     4   p    v                      else
             662     4   p    v                          te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2 + w (i, k) ** 2)
             663     4   p    v                      endif
             664     3   p    v                      te_beg_0 (i, k) = rgrav * te_beg_0 (i, k) * delp (i, k) * gsize (i) ** 2.0

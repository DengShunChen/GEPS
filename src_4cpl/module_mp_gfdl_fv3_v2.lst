            1151                     
            1152                         ! this is the vectorized loop
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qlz, qrz, qiz, qsz, dz1, dp1, m1_sol
                                   <<<      cv0, qvz, qgz, dgz, ql, qr, qi, qs, dz
                                   <<<      dm, m1, qv, qg, dp, m1_rain
                                   <<< Loop-information  End >>>
            1153     1  pp    v          do k = ks + 1, ke
            1154     1   p    v              dgz (k) = - g2 * (dz (k - 1) + dz (k))
            1155     1   p    v              cv0 (k) = dm (k) * (cv_air + qv (k) * cv_vap + (qr (k) + ql (k)) * c_liq + &
            1156     1                            (qi (k) + qs (k) + qg (k)) * c_ice) + cw * (m1 (k) - m1 (k - 1))
            1157     1                       ! cvm_new + cw * m1 (k) = cvm_old + cw * m1 (k - 1)
            1158     1   p    v          enddo
            1159                         ! -----------------------------------------------------------------------
            1160                         ! implicit algorithm: can't be vectorized
            1161                         ! needs an inner i - loop for vectorization
            1162                         ! -----------------------------------------------------------------------
            1163                         ! top layer: cv0 = cvn + cw * m1 (k)
            1164                         ! tz (k) = cv0 (k) * tz (k) / (cvn (k) + cw * m1 (k)) = tz (k) -- > no change
                                   <<< Loop-information Start >>>

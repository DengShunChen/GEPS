            1782     5   p    v                              psacw = factor / (1. + dts * factor) * ql ! rate
            1783     5   p    v                          else
            1784     5   p    v                              psacw = 0.
            1785     5   p    v                          endif
            1786     4               
            1787     4                                   ! -----------------------------------------------------------------------
            1788     4                                   ! psacr: accretion of rain by melted snow
            1789     4                                   ! pracs: accretion of snow by rain
            1790     4                                   ! -----------------------------------------------------------------------
            1791     4               
            1792     5   p    v                          if (qr > qrmin) then
            1793     5   pi   v                              psacr = min (acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), &
            1794     5                                           den (k)), qr * rdts)
            1795     5   pi   v                              pracs = acr3d (vtr (k), vts (k), qs, qr, cracs, acco (1, 1), den (k))
            1796     5   p    v                          else
            1797     5   p    v                              psacr = 0.
            1798     5   p    v                              pracs = 0.
            1799     5   p    v                          endif
            1800     4               
            1801     4                                   ! -----------------------------------------------------------------------
            1802     4                                   ! total snow sink:
            1803     4                                   ! psmlt: snow melt (due to rain accretion)
            1804     4                                   ! -----------------------------------------------------------------------
            1805     4               
            1806     4   pi   v                          psmlt = max (0., smlt (tc, dqs0, qs * den (k), psacw, psacr, csmlt, &
            1807     4                                       den (k), denfac (k)))
            1808     4   p    v                          sink = min (qs, dts * (psmlt + pracs), tc / icpk (k))
            1809     4   p    v                          qs = qs - sink
            1810     4   p    v                          tmp = min (sink, dim (qs_mlt, ql)) ! max ql due to snow melt
            1811     4   p    v                          ql = ql + tmp
            1812     4   p    v                          qr = qr + sink - tmp
            1813     4   p    v                          q_liq (k) = q_liq (k) + sink
            1814     4   p    v                          q_sol (k) = q_sol (k) - sink
            1815     4               
            1816     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1817     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1818     4   p    v                          tc = tz - tice
            1819     4   p    v                          icpk (k) = (li00 + d1_ice * tz) / cvm (k)
            1820     4               
            1821     4   p    v                      endif
            1822     3               
            1823     3                               ! -----------------------------------------------------------------------
            1824     3                               ! melting of graupel
            1825     3                               ! -----------------------------------------------------------------------
            1826     3               
            1827     4   p    v                      if (qg > qcmin .and. tc > 0.) then
            1828     4               
            1829     4                                   ! -----------------------------------------------------------------------
            1830     4                                   ! pgacr: accretion of rain by graupel
            1831     4                                   ! -----------------------------------------------------------------------
            1832     4               
            1833     4   p    v                          if (qr > qrmin) &
            1834     4                                       pgacr = min (acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1835     4                                       den (k)), rdts * qr)
            1836     4               
            1837     4                                   ! -----------------------------------------------------------------------
            1838     4                                   ! pgacw: accretion of cloud water by graupel
            1839     4                                   ! -----------------------------------------------------------------------
            1840     4               
            1841     4   p    v                          qden = qg * den (k)
            1842     5   p    v                          if (ql > qrmin) then
            1843     5   p    v                              factor = cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            1844     5   p    v                              pgacw = factor / (1. + dts * factor) * ql ! rate
            1845     5   p    v                          endif
            1846     4               
            1847     4                                   ! -----------------------------------------------------------------------
            1848     4                                   ! pgmlt: graupel melt
            1849     4                                   ! -----------------------------------------------------------------------
            1850     4               
            1851     4   pi   v                          pgmlt = dts * gmlt (tc, dqs0, qden, pgacw, pgacr, cgmlt, den (k))
            1852     4   p    v                          pgmlt = min (max (0., pgmlt), qg, tc / icpk (k))
            1853     4   p    v                          qg = qg - pgmlt
            1854     4   p    v                          qr = qr + pgmlt
            1855     4   p    v                          q_liq (k) = q_liq (k) + pgmlt
            1856     4   p    v                          q_sol (k) = q_sol (k) - pgmlt
            1857     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1858     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1859     4   p    v                      endif
            1860     3               
            1861     3   p    v                  else
            1862     3               
            1863     3                               ! -----------------------------------------------------------------------
            1864     3                               ! cloud ice proc:
            1865     3                               ! -----------------------------------------------------------------------
            1866     3               
            1867     3                               ! -----------------------------------------------------------------------
            1868     3                               ! psaci: accretion of cloud ice by snow
            1869     3                               ! -----------------------------------------------------------------------
            1870     3               
            1871     4   p    v                      if (qi > 3.e-7) then ! cloud ice sink terms
            1872     4               
            1873     5   p    v                          if (qs > 1.e-7) then
            1874     5                                       ! -----------------------------------------------------------------------
            1875     5                                       ! sjl added (following lin eq. 23) the temperature dependency
            1876     5                                       ! to reduce accretion, use esi = exp (0.05 * tc) as in hong et al 2004
            1877     5                                       ! -----------------------------------------------------------------------
            1878     5   p    v                              factor = dts * denfac (k) * csaci * exp (0.05 * tc + 0.8125 * log (qs * den (k)))
            1879     5   p    v                              psaci = factor / (1. + factor) * qi
            1880     5   p    v                          else
            1881     5   p    v                              psaci = 0.
            1882     5   p    v                          endif
            1883     4               
            1884     4                                   ! -----------------------------------------------------------------------
            1885     4                                   ! assuming linear subgrid vertical distribution of cloud ice
            1886     4                                   ! the mismatch computation following lin et al. 1994, mwr
            1887     4                                   ! -----------------------------------------------------------------------
            1888     4               
            1889     5   p    v                          if (const_vi) then
            1890     5   p    v                              tmp = fac_i2s
            1891     5   p    v                          else
            1892     5   p    v                              tmp = fac_i2s * exp (0.025 * tc)
            1893     5   p    v                          endif
            1894     4               
            1895     4   p    v                          di (k) = max (di (k), qrmin)
            1896     4   p    v                          q_plus = qi + di (k)
            1897     5   p    v                          if (q_plus > (qim (k) + qrmin)) then
            1898     6   p    v                              if (qim (k) > (qi - di (k))) then
            1899     6   p    v                                  dq = (0.25 * (q_plus - qim (k)) ** 2) / di (k)
            1900     6   p    v                              else
            1901     6   p    v                                  dq = qi - qim (k)
            1902     6   p    v                              endif
            1903     5   p    v                              psaut = tmp * dq
            1904     5   p    v                          else
            1905     5   p    v                              psaut = 0.
            1906     5   p    v                          endif
            1907     4                                   ! -----------------------------------------------------------------------
            1908     4                                   ! sink is no greater than 75% of qi
            1909     4                                   ! -----------------------------------------------------------------------
            1910     4   p    v                          sink = min (0.75 * qi, psaci + psaut)
            1911     4   p    v                          qi = qi - sink
            1912     4   p    v                          qs = qs + sink
            1913     4               
            1914     4                                   ! -----------------------------------------------------------------------
            1915     4                                   ! pgaci: accretion of cloud ice by graupel
            1916     4                                   ! -----------------------------------------------------------------------
            1917     4               
            1918     5   p    v                          if (qg > 1.e-6) then
            1919     5                                       ! -----------------------------------------------------------------------
            1920     5                                       ! factor = dts * cgaci / sqrt (den (k)) * exp (0.05 * tc + 0.875 * log (qg * den (k)))
            1921     5                                       ! simplified form: remove temp dependency & set the exponent "0.875" -- > 1
            1922     5                                       ! -----------------------------------------------------------------------
            1923     5   p    v                              factor = dts * cgaci / sqrt (den (k)) * exp (0.875 * log (qg * den (k)))
            1924     5   p    v                              pgaci = factor / (1. + factor) * qi
            1925     5   p    v                              qi = qi - pgaci
            1926     5   p    v                              qg = qg + pgaci
            1927     5   p    v                          endif
            1928     4               
            1929     4   p    v                      endif
            1930     3               
            1931     3                               ! -----------------------------------------------------------------------
            1932     3                               ! cold - rain proc:
            1933     3                               ! -----------------------------------------------------------------------
            1934     3               
            1935     3                               ! -----------------------------------------------------------------------
            1936     3                               ! rain to ice, snow, graupel processes:
            1937     3                               ! -----------------------------------------------------------------------
            1938     3               
            1939     3   p    v                      tc = tz - tice
            1940     3               
            1941     3               !                if (qr > 1.e-7 .and. tc < 0.) then
            1942     4   p    v                      if (qr > qrmin .and. tc < 0.) then
            1943     4               
            1944     4                                   ! -----------------------------------------------------------------------
            1945     4                                   ! * sink * terms to qr: psacr + pgfr
            1946     4                                   ! source terms to qs: psacr
            1947     4                                   ! source terms to qg: pgfr
            1948     4                                   ! -----------------------------------------------------------------------
            1949     4               
            1950     4                                   ! -----------------------------------------------------------------------
            1951     4                                   ! psacr accretion of rain by snow
            1952     4                                   ! -----------------------------------------------------------------------
            1953     4               
            1954     5   p    v                          if (qs > 1.e-7) then ! if snow exists
            1955     5   pi   v                              psacr = dts * acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), den (k))
            1956     5   p    v                          else
            1957     5   p    v                              psacr = 0.
            1958     5   p    v                          endif
            1959     4               
            1960     4                                   ! -----------------------------------------------------------------------
            1961     4                                   ! pgfr: rain freezing -- > graupel
            1962     4                                   ! -----------------------------------------------------------------------
            1963     4               
            1964     4   p    v                          pgfr = dts * cgfr (1) / den (k) * (exp (- cgfr (2) * tc) - 1.) * &
            1965     4                                       exp (1.75 * log (qr * den (k)))
            1966     4               
            1967     4                                   ! -----------------------------------------------------------------------
            1968     4                                   ! total sink to qr
            1969     4                                   ! -----------------------------------------------------------------------
            1970     4               
            1971     4   p    v                          sink = psacr + pgfr
            1972     4   p    v                          factor = min (sink, qr, - tc / icpk (k)) / max (sink, qrmin)
            1973     4               
            1974     4   p    v                          psacr = factor * psacr
            1975     4   p    v                          pgfr = factor * pgfr
            1976     4               
            1977     4   p    v                          sink = psacr + pgfr
            1978     4                                   !xb141 >>>
            1979     4                                   ! pgfr could be greater than 1.e-9, and lead to negative values of qr (about -1.e-25).
            1980     4                                   ! let psacr & pgfr divided in portion :
            1981     5   p    v                          if ( sink > qr ) then
            1982     5   p    v                             psacr = qr * psacr / sink
            1983     5   p    v                             pgfr = qr * pgfr / sink
            1984     5   p    v                             sink = qr
            1985     5   p    v                          endif
            1986     4                                   !xb141 <<<
            1987     4   p    v                          qr = qr - sink
            1988     4   p    v                          qs = qs + psacr
            1989     4   p    v                          qg = qg + pgfr
            1990     4   p    v                          q_liq (k) = q_liq (k) - sink
            1991     4   p    v                          q_sol (k) = q_sol (k) + sink
            1992     4               
            1993     4   p    v                          cvm (k) = one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            1994     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / cvm (k)
            1995     4   p    v                          icpk (k) = (li00 + d1_ice * tz) / cvm (k)
            1996     4   p    v                      endif
            1997     3               
            1998     3                               ! -----------------------------------------------------------------------
            1999     3                               ! graupel production terms:
            2000     3                               ! -----------------------------------------------------------------------
            2001     3               
            2002     4   p    v                      if (qs > 1.e-7) then
            2003     4               
            2004     4                                   ! -----------------------------------------------------------------------
            2005     4                                   ! accretion: snow -- > graupel
            2006     4                                   ! -----------------------------------------------------------------------
            2007     4               
            2008     5   p    v                          if (qg > qrmin) then
            2009     5   pi   v                              sink = dts * acr3d (vtg (k), vts (k), qs, qg, cgacs, acco (1, 4), den (k))
            2010     5   p    v                          else
            2011     5   p    v                              sink = 0.
            2012     5   p    v                          endif
            2013     4               
            2014     4                                   ! -----------------------------------------------------------------------
            2015     4                                   ! autoconversion snow -- > graupel
            2016     4                                   ! -----------------------------------------------------------------------
            2017     4               
            2018     4   p    v                          qsm = qs0_crt / den (k)
            2019     5   p    v                          if (qs > qsm) then
            2020     5   p    v                              factor = dts * 1.e-3 * exp (0.09 * (tz - tice))
            2021     5   p    v                              sink = sink + factor / (1. + factor) * (qs - qsm)
            2022     5   p    v                          endif
            2023     4   p    v                          sink = min (qs, sink)
            2024     4   p    v                          qs = qs - sink
            2025     4   p    v                          qg = qg + sink
            2026     4               
            2027     4   p    v                      endif ! snow existed
            2028     3               
            2029     4   p    v                      if (qg > 1.e-7 .and. tz < tice) then
            2030     4               
            2031     4                                   ! -----------------------------------------------------------------------
            2032     4                                   ! pgacw: accretion of cloud water by graupel
            2033     4                                   ! -----------------------------------------------------------------------
            2034     4               
            2035     5   p    v                          if (ql > 1.e-6) then
            2036     5   p    v                              qden = qg * den (k)
            2037     5   p    v                              factor = dts * cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            2038     5   p    v                              pgacw = factor / (1. + factor) * ql
            2039     5   p    v                          else
            2040     5   p    v                              pgacw = 0.
            2041     5   p    v                          endif
            2042     4               
            2043     4                                   ! -----------------------------------------------------------------------
            2044     4                                   ! pgacr: accretion of rain by graupel
            2045     4                                   ! -----------------------------------------------------------------------
            2046     4               
            2047     5   p    v                          if (qr > 1.e-6) then
            2048     5   pi   v                              pgacr = min (dts * acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            2049     5                                           den (k)), qr)
            2050     5   p    v                          else
            2051     5   p    v                              pgacr = 0.
            2052     5   p    v                          endif
            2053     4               
            2054     4   p    v                          sink = pgacr + pgacw
            2055     4   p    v                          factor = min (sink, dim (tice, tz) / icpk (k)) / max (sink, qrmin)
            2056     4   p    v                          pgacr = factor * pgacr
            2057     4   p    v                          pgacw = factor * pgacw
            2058     4               
            2059     4   p    v                          sink = pgacr + pgacw
            2060     4   p    v                          qg = qg + sink
            2061     4   p    v                          qr = qr - pgacr
            2062     4   p    v                          ql = ql - pgacw
            2063     4               
            2064     4   p    v                          q_liq (k) = q_liq (k) - sink
            2065     4   p    v                          q_sol (k) = q_sol (k) + sink
            2066     4   p    v                          tz = (te8 (k) - lv00 * qv + li00 * q_sol (k)) / (one_r8 + qv * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            2067     4   p    v                      endif
            2068     3               
            2069     3   p    v                  endif
            2070     2               
            2071     2   p    v                  tzk (k) = tz
            2072     2   p    v                  qvk (k) = qv
            2073     2   p    v                  qlk (k) = ql
            2074     2   p    v                  qik (k) = qi
            2075     2   p    v                  qrk (k) = qr
            2076     2   p    v                  qsk (k) = qs
            2077     2   p    v                  qgk (k) = qg
            2078     2               
            2079     2   p    v              enddo
            2080     1               
            2081     1                   endif
            2082                     
            2083                         call subgrid_z_proc (ks, ke, p1, den, denfac, dts, rh_adj, tzk, qvk, qlk, &
            2084                             qrk, qik, qsk, qgk, qak, dp1, h_var, rh_rain, te8, ccn, cin, gsize, &
            2085                             cond, dep, reevap, sub, rhck, last_step)
            2086                     
            2087                     end subroutine icloud
            2088                     
            2089                     ! =======================================================================
            2090                     ! temperature sentive high vertical resolution processes
            2091                     ! =======================================================================
            2092                     
            2093                     subroutine subgrid_z_proc (ks, ke, p1, den, denfac, dts, rh_adj, tz, qv, ql, qr, &
            2094                             qi, qs, qg, qa, dp1, h_var, rh_rain, te8, ccn, cin, gsize, cond, dep, reevap, sub, rhcz, last_step)
            2095                     
            2096                         implicit none
            2097                     
            2098                         integer, intent (in) :: ks, ke
            2099                         real, intent (in) :: dts, rh_adj, h_var, rh_rain, gsize
            2100                         real, intent (in), dimension (ks:ke) :: rhcz
            2101                         real, intent (in), dimension (ks:ke) :: p1, den, denfac, ccn, dp1
            2102                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            2103                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            2104                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, qa
            2105                         real, intent (inout), dimension (ks:ke) :: cin
            2106                         logical, intent (in) :: last_step
            2107                         real, intent (out) :: cond, dep, reevap, sub
            2108                         ! local:
            2109                         real, dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            2110                         real, dimension (ks:ke) :: q_liq, q_sol, q_cond
            2111                         real (kind = r8), dimension (ks:ke) :: cvm
            2112                         real :: pidep, qi_crt
            2113                         real :: sigma, gam
            2114                         ! -----------------------------------------------------------------------
            2115                         ! qstar over water may be accurate only down to - 80 deg c with ~10% uncertainty
            2116                         ! must not be too large to allow psc
            2117                         ! -----------------------------------------------------------------------
            2118                         real :: rh, rqi, tin, qsw, qsi, qpz, qstar, rh_tem
            2119                         real :: dqsdt, dwsdt, dq, dq0, factor, tmp, liq, ice
            2120                         real :: q_plus, q_minus, dt_evap, dt_pisub
            2121                         real :: evap, sink, tc, dtmp, qa10, qa100
            2122                         real :: pssub, pgsub, tsq, qden
            2123                         real :: fac_l2v, fac_v2l, fac_g2v, fac_v2g
            2124                         integer :: k
            2125                     !    real, parameter :: qcldmin = 1.e-6   ! original
            2126                         real, parameter :: qcldmin = 1.e-8   ! GFDLMP_v1
            2127                     !    real, parameter :: qcldmin = 1.e-15  ! GFDLMP_v3
            2128                     
            2129     1                   if (do_sat_adj) then
            2130     1                       dt_evap = 0.5 * dts
            2131     1                   else
            2132     1                       dt_evap = dts
            2133     1                   endif
            2134                     
            2135                         ! -----------------------------------------------------------------------
            2136                         ! define conversion scalar / factor
            2137                         ! -----------------------------------------------------------------------
            2138                     
            2139                         fac_l2v = 1. - exp (- dt_evap / tau_l2v)
            2140                         fac_v2l = 1. - exp (- dt_evap / tau_v2l)
            2141                         fac_g2v = 1. - exp (- dts / tau_g2v)
            2142                         fac_v2g = 1. - exp (- dts / tau_v2g)
            2143                     
            2144                         ! -----------------------------------------------------------------------
            2145                         ! define heat capacity and latend heat coefficient
            2146                         ! -----------------------------------------------------------------------
            2147                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, qi, qr, ql, qv, qg, tz, q_sol, icpk
                                   <<<      tcp3, lcpk, cvm, q_liq
                                   <<< Loop-information  End >>>
            2148     1  pp    v          do k = ks, ke
            2149     1   p    v              q_liq (k) = ql (k) + qr (k)
            2150     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2151     1   p    v              cvm (k) = one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice
            2152     1   p    v              lcpk (k) = (lv00 + d1_vap * tz (k)) / cvm (k)
            2153     1   p    v              icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            2154     1   p    v              tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2155     1   p    v          enddo
            2156                     
            2157                         cond = 0
            2158                         dep = 0
            2159                         reevap = 0
            2160                         sub = 0
            2161                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p1
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 53
                                   <<<      SIMD&FP   : SPILL 5  FILL 21
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2162     1                   do k = ks, ke
            2163     1               
            2164     1                       if (p1 (k) < p_min) cycle
            2165     1               
            2166     2                       if (.not. do_warm_rain_mp) then
            2167     2               
            2168     2                           ! -----------------------------------------------------------------------
            2169     2                           ! instant deposit all water vapor to cloud ice when temperature is super low
            2170     2                           ! -----------------------------------------------------------------------
            2171     2               
            2172     3                           if (tz (k) < t_min) then
            2173     3                               sink = dim (qv (k), 1.e-7)
            2174     3                               dep = dep + sink * dp1 (k)
            2175     3                               qv (k) = qv (k) - sink
            2176     3                               qi (k) = qi (k) + sink
            2177     3                               q_sol (k) = q_sol (k) + sink
            2178     3                               tz (k) = (te8 (k) - lv00 * qv (k) + li00 * q_sol (k)) / &
            2179     3                                    (one_r8 + qv (k) * c1_vap + q_liq (k) * c1_liq + q_sol (k) * c1_ice)
            2180     3                               if (do_qa) qa (k) = 1. ! air fully saturated; 100 % cloud cover
            2181     3                               cycle
            2182     3                           endif
            2183     2               
            2184     2                           ! -----------------------------------------------------------------------
            2185     2                           ! instant evaporation / sublimation of all clouds if rh < rh_adj -- > cloud free
            2186     2                           ! -----------------------------------------------------------------------
            2187     2                           ! rain water is handled in warm - rain process.
            2188     2                           qpz = qv (k) + ql (k) + qi (k)

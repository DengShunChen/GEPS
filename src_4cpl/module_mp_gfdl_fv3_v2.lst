            1140                     subroutine sedi_heat (ks, ke, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            1141                         ! revised with a precise energy conserving form: s. - j. lin, jan 22, 2018
            1142                         ! input q fields are dry mixing ratios, and dm is dry air mass
            1143                         implicit none
            1144                         integer, intent (in) :: ks, ke
            1145                         real, intent (in), dimension (ks:ke) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            1146                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1147                         real, intent (in) :: cw ! heat capacity

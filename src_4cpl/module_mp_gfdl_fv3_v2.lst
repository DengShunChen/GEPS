            3939                     end subroutine setup_con
            3940                     
            3941                     ! =======================================================================
            3942                     ! accretion function (lin et al. 1983)
            3943                     ! =======================================================================
            3944                     
            3945                     real function acr3d (v1, v2, q1, q2, c, cac, rho)
            3946                     
            3947                         implicit none
            3948                     
            3949                         real, intent (in) :: v1, v2, c, rho
            3950                         real, intent (in) :: q1, q2 ! mixing ratio!!!
            3951                         real, intent (in) :: cac (3)
            3952                     
            3953                         real :: t1, s1, s2
            3954                     
            3955                         ! integer :: k
            3956                         !
            3957                         ! real :: a
            3958                         !
            3959                         ! a = 0.0
            3960                         ! do k = 1, 3
            3961                         ! a = a + cac (k) * ((q1 * rho) ** ((7 - k) * 0.25) * (q2 * rho) ** (k * 0.25))
            3962                         ! enddo
            3963                         ! acr3d = c * abs (v1 - v2) * a / rho
            3964                     
            3965                         ! optimized
            3966                     
            3967                         t1 = sqrt (q1 * rho)
            3968                         s1 = sqrt (q2 * rho)
            3969                         s2 = sqrt (s1) ! s1 = s2 ** 2
            3970                         acr3d = c * abs (v1 - v2) * q1 * s2 * (cac (1) * t1 + cac (2) * sqrt (t1) * s2 + cac (3) * s1)
            3971                     
            3972                     end function acr3d
            3973                     
            3974                     ! =======================================================================
            3975                     ! melting of snow function (lin et al. 1983)
            3976                     ! note: psacw and psacr must be calc before smlt is called
            3977                     ! =======================================================================
            3978                     
            3979                     real function smlt (tc, dqs, qsrho, psacw, psacr, c, rho, rhofac)
            3980                     
            3981                         implicit none
            3982                     
            3983                         real, intent (in) :: tc, dqs, qsrho, psacw, psacr, c (5), rho, rhofac
            3984                     
            3985                         smlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qsrho) + &
            3986                             c (4) * qsrho ** 0.65625 * sqrt (rhofac)) + c (5) * tc * (psacw + psacr)
            3987                     
            3988                     end function smlt
            3989                     
            3990                     ! =======================================================================
            3991                     ! melting of graupel function (lin et al. 1983)
            3992                     ! note: pgacw and pgacr must be calc before gmlt is called
            3993                     ! =======================================================================
            3994                     
            3995                     real function gmlt (tc, dqs, qgrho, pgacw, pgacr, c, rho)
            3996                     
            3997                         implicit none
            3998                     
            3999                         real, intent (in) :: tc, dqs, qgrho, pgacw, pgacr, c (5), rho
            4000                     
            4001                         gmlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qgrho) + &
            4002                             c (4) * qgrho ** 0.6875 / rho ** 0.25) + c (5) * tc * (pgacw + pgacr)
            4003                     
            4004                     end function gmlt
            4005                     
            4006                     ! =======================================================================
            4007                     ! initialization
            4008                     ! prepare saturation water vapor pressure tables
            4009                     ! =======================================================================
            4010                     
            4011                     subroutine qsmith_init
            4012                     
            4013                         implicit none
            4014                     
            4015                         integer, parameter :: length = 2621
            4016                     
            4017                         integer :: i
            4018                     
            4019     1                   if (.not. tables_are_initialized) then
            4020     1               
            4021     1                       allocate (table (length))
            4022     1                       allocate (table2 (length))
            4023     1                       allocate (table3 (length))
            4024     1                       allocate (tablew (length))
            4025     1                       allocate (des (length))
            4026     1                       allocate (des2 (length))
            4027     1                       allocate (des3 (length))
            4028     1                       allocate (desw (length))
            4029     1               
            4030     1                       call qs_table (length)
            4031     1                       call qs_table2 (length)
            4032     1                       call qs_table3 (length)
            4033     1    i                  call qs_tablew (length)
            4034     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.62, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3, table2, table, tablew, des, des3
                                   <<<      desw, des2
                                   <<< Loop-information  End >>>
            4035     2  pp    v              do i = 1, length - 1
            4036     2   p    v                  des (i) = max (0., table (i + 1) - table (i))
            4037     2   p    v                  des2 (i) = max (0., table2 (i + 1) - table2 (i))
            4038     2   p    v                  des3 (i) = max (0., table3 (i + 1) - table3 (i))
            4039     2   p    v                  desw (i) = max (0., tablew (i + 1) - tablew (i))
            4040     2   p    v              enddo
            4041     1                       des (length) = des (length - 1)
            4042     1                       des2 (length) = des2 (length - 1)
            4043     1                       des3 (length) = des3 (length - 1)
            4044     1                       desw (length) = desw (length - 1)
            4045     1               
            4046     1                       tables_are_initialized = .true.
            4047     1               
            4048     1                   endif
            4049                     
            4050                     end subroutine qsmith_init
            4051                     
            4052                     ! =======================================================================
            4053                     ! compute the saturated specific humidity for table ii
            4054                     ! =======================================================================
            4055                     
            4056                     real function wqs1 (ta, den)
            4057                     
            4058                         implicit none
            4059                     
            4060                         ! pure water phase; universal dry / moist formular using air density
            4061                         ! input "den" can be either dry or moist air density
            4062                     
            4063                         real, intent (in) :: ta, den
            4064                     
            4065                         real :: es, ap1, tmin
            4066                     
            4067                         integer :: it
            4068                     
            4069                         tmin = table_ice - 160.
            4070                         ap1 = 10. * dim (ta, tmin) + 1.
            4071                         ap1 = min (2621., ap1)
            4072                         it = ap1
            4073                         es = tablew (it) + (ap1 - it) * desw (it)
            4074                         wqs1 = es / (rvgas * ta * den)
            4075                     
            4076                     end function wqs1
            4077                     
            4078                     ! =======================================================================
            4079                     ! compute the gradient of saturated specific humidity for table ii
            4080                     ! =======================================================================
            4081                     
            4082                     real function wqs2 (ta, den, dqdt)
            4083                     
            4084                         implicit none
            4085                     
            4086                         ! pure water phase; universal dry / moist formular using air density
            4087                         ! input "den" can be either dry or moist air density
            4088                     
            4089                         real, intent (in) :: ta, den
            4090                         real, intent (out) :: dqdt
            4091                         real :: es, ap1, tmin
            4092                         integer :: it
            4093                     
            4094                         tmin = table_ice - 160.
            4095                     
            4096                         if (.not. tables_are_initialized) call qsmith_init
            4097                     
            4098                         ap1 = 10. * dim (ta, tmin) + 1.
            4099                         ap1 = min (2621., ap1)
            4100                         it = ap1
            4101                         es = tablew (it) + (ap1 - it) * desw (it)
            4102                         wqs2 = es / (rvgas * ta * den)
            4103                         it = ap1 - 0.5
            4104                         ! finite diff, del_t = 0.1:
            4105                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            4106                     
            4107                     end function wqs2
            4108                     
            4109                     !xb141 >>>>>>
            4110                     ! =======================================================================
            4111                     ! compute the gradient of saturated specific humidity for table ii
            4112                     ! which is tuned by rhc
            4113                     ! =======================================================================
            4114                     real function wqs2_rhc (ta, den, rhc, dqdt)
            4115                     
            4116                         implicit none
            4117                     
            4118                         ! pure water phase; universal dry / moist formular using air density
            4119                         ! input "den" can be either dry or moist air density
            4120                     
            4121                         real, intent (in) :: ta, den, rhc
            4122                         real, intent (out) :: dqdt
            4123                         real :: es, ap1, tmin
            4124                         integer :: it
            4125                     
            4126                         tmin = table_ice - 160.
            4127                     
            4128                         if (.not. tables_are_initialized) call qsmith_init
            4129                     
            4130                         ap1 = 10. * dim (ta, tmin) + 1.
            4131                         ap1 = min (2621., ap1)
            4132                         it = ap1
            4133                         es = tablew (it) + (ap1 - it) * desw (it)
            4134                         wqs2_rhc = es / (rvgas * ta * den) * rhc
            4135                         it = ap1 - 0.5
            4136                         ! finite diff, del_t = 0.1:
            4137                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            4138                     
            4139                     end function wqs2_rhc
            4140                     !xb141 <<<<<
            4141                     
            4142                     ! =======================================================================
            4143                     ! =======================================================================
            4144                     ! compute the gradient of saturated specific humidity for table ii
            4145                     ! it is the same as "wqs2", but written as vector function
            4146                     ! =======================================================================
            4147                     
            4148                     subroutine wqs2_vect (is, ie, ta, den, wqsat, dqdt)
            4149                     
            4150                         implicit none
            4151                     
            4152                         ! pure water phase; universal dry / moist formular using air density
            4153                         ! input "den" can be either dry or moist air density
            4154                     
            4155                         integer, intent (in) :: is, ie
            4156                     
            4157                         real, intent (in), dimension (is:ie) :: ta, den
            4158                     
            4159                         real, intent (out), dimension (is:ie) :: wqsat, dqdt
            4160                     
            4161                         real :: es, ap1, tmin
            4162                     
            4163                         integer :: i, it
            4164                     
            4165                         tmin = t_ice - 160.
            4166                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.90, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, den, wqsat, dqdt
                                   <<< Loop-information  End >>>
            4167     1  pp    v          do i = is, ie
            4168     1   p    v              ap1 = 10. * dim (ta (i), tmin) + 1.
            4169     1   p    v              ap1 = min (2621., ap1)
            4170     1   p    v              it = ap1
            4171     1   p    v              es = tablew (it) + (ap1 - it) * desw (it)
            4172     1   p    v              wqsat (i) = es / (rvgas * ta (i) * den (i))
            4173     1   p    v              it = ap1 - 0.5
            4174     1                       ! finite diff, del_t = 0.1:
            4175     1   p    v              dqdt (i) = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta (i) * den (i))
            4176     1   p    v          enddo
            4177                     
            4178                     end subroutine wqs2_vect
            4179                     
            4180                     ! =======================================================================
            4181                     ! compute wet buld temperature
            4182                     ! =======================================================================
            4183                     
            4184                     real function wet_bulb (q, t, den)
            4185                     
            4186                         implicit none
            4187                     
            4188                         real, intent (in) :: t, q, den
            4189                     
            4190                         real :: qs, tp, dqdt
            4191                     
            4192                         wet_bulb = t
            4193          i              qs = wqs2 (wet_bulb, den, dqdt)
            4194                         tp = 0.5 * (qs - q) / (1. + lcp * dqdt) * lcp
            4195                         wet_bulb = wet_bulb - tp
            4196                     
            4197                         ! tp is negative if super - saturated
            4198     1                   if (tp > 0.01) then
            4199     1    i                  qs = wqs2 (wet_bulb, den, dqdt)
            4200     1                       tp = (qs - q) / (1. + lcp * dqdt) * lcp
            4201     1                       wet_bulb = wet_bulb - tp
            4202     1                   endif
            4203                     
            4204                     end function wet_bulb
            4205                     
            4206                     ! =======================================================================
            4207                     ! compute the saturated specific humidity for table iii
            4208                     ! =======================================================================
            4209                     
            4210                     real function iqs1 (ta, den)
            4211                     
            4212                         implicit none
            4213                     
            4214                         ! water - ice phase; universal dry / moist formular using air density
            4215                         ! input "den" can be either dry or moist air density
            4216                     
            4217                         real, intent (in) :: ta, den
            4218                     
            4219                         real :: es, ap1, tmin
            4220                     
            4221                         integer :: it
            4222                     
            4223                         tmin = table_ice - 160.
            4224                         ap1 = 10. * dim (ta, tmin) + 1.
            4225                         ap1 = min (2621., ap1)
            4226                         it = ap1
            4227                         es = table2 (it) + (ap1 - it) * des2 (it)
            4228                         iqs1 = es / (rvgas * ta * den)
            4229                     
            4230                     end function iqs1
            4231                     
            4232                     ! =======================================================================
            4233                     ! compute the gradient of saturated specific humidity for table iii
            4234                     ! =======================================================================
            4235                     
            4236                     real function iqs2 (ta, den, dqdt)
            4237                     
            4238                         implicit none
            4239                     
            4240                         ! water - ice phase; universal dry / moist formular using air density
            4241                         ! input "den" can be either dry or moist air density
            4242                     
            4243                         real (kind = r8), intent (in) :: ta
            4244                         real, intent (in) :: den
            4245                         real, intent (out) :: dqdt
            4246                         real (kind = r8) :: tmin, es, ap1
            4247                         integer :: it
            4248                     
            4249                         tmin = table_ice - 160.
            4250                         ap1 = 10. * dim (ta, tmin) + 1.
            4251                         ap1 = min (2621., ap1)
            4252                         it = ap1
            4253                         es = table2 (it) + (ap1 - it) * des2 (it)
            4254                         iqs2 = es / (rvgas * ta * den)
            4255                         it = ap1 - 0.5
            4256                         dqdt = 10. * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) / (rvgas * ta * den)
            4257                     
            4258                     end function iqs2
            4259                     
            4260                     ! =======================================================================
            4261                     ! compute the gradient of saturated specific humidity for table iii
            4262                     ! =======================================================================
            4263                     
            4264                     real function qs1d_moist (ta, qv, pa, dqdt)
            4265                     
            4266                         implicit none
            4267                     
            4268                         real, intent (in) :: ta, pa, qv
            4269                     
            4270                         real, intent (out) :: dqdt
            4271                     
            4272                         real :: es, ap1, tmin, eps10
            4273                     
            4274                         integer :: it
            4275                     
            4276                         tmin = table_ice - 160.
            4277                         eps10 = 10. * eps
            4278                         ap1 = 10. * dim (ta, tmin) + 1.
            4279                         ap1 = min (2621., ap1)
            4280                         it = ap1
            4281                         es = table2 (it) + (ap1 - it) * des2 (it)
            4282                         qs1d_moist = eps * es * (1. + zvir * qv) / pa
            4283                         it = ap1 - 0.5
            4284                         dqdt = eps10 * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) * (1. + zvir * qv) / pa
            4285                     
            4286                     end function qs1d_moist
            4287                     
            4288                     ! =======================================================================
            4289                     ! compute the gradient of saturated specific humidity for table ii
            4290                     ! =======================================================================
            4291                     
            4292                     real function wqsat2_moist (ta, qv, pa, dqdt)
            4293                     
            4294                         implicit none
            4295                     
            4296                         real, intent (in) :: ta, pa, qv
            4297                     
            4298                         real, intent (out) :: dqdt
            4299                     
            4300                         real :: es, ap1, tmin, eps10
            4301                     
            4302                         integer :: it
            4303                     
            4304                         tmin = table_ice - 160.
            4305                         eps10 = 10. * eps
            4306                         ap1 = 10. * dim (ta, tmin) + 1.
            4307                         ap1 = min (2621., ap1)
            4308                         it = ap1
            4309                         es = tablew (it) + (ap1 - it) * desw (it)
            4310                         wqsat2_moist = eps * es * (1. + zvir * qv) / pa
            4311                         it = ap1 - 0.5
            4312                         dqdt = eps10 * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) * (1. + zvir * qv) / pa
            4313                     
            4314                     end function wqsat2_moist
            4315                     
            4316                     ! =======================================================================
            4317                     ! compute the saturated specific humidity for table ii
            4318                     ! =======================================================================
            4319                     
            4320                     real function wqsat_moist (ta, qv, pa)
            4321                     
            4322                         implicit none
            4323                     
            4324                         real, intent (in) :: ta, pa, qv
            4325                     
            4326                         real :: es, ap1, tmin
            4327                     
            4328                         integer :: it
            4329                     
            4330                         tmin = table_ice - 160.
            4331                         ap1 = 10. * dim (ta, tmin) + 1.
            4332                         ap1 = min (2621., ap1)
            4333                         it = ap1
            4334                         es = tablew (it) + (ap1 - it) * desw (it)
            4335                         wqsat_moist = eps * es * (1. + zvir * qv) / pa
            4336                     
            4337                     end function wqsat_moist

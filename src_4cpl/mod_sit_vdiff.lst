            7641     1               
            7642     1               !     3.2 Nudging at each level
            7643     1               !      IF(GDCHK3) print *,"before restore,jk=",jk,",pwt(jl,jk)=",pwt(jl,jk),",restore_temp=",restore_temp
            7644     1                     pwt(jl,jk)= pwt(jl,jk)+restore_temp
            7645     1               !      IF(GDCHK3) print *,"after restore,jk=",jk,",pwt(jl,jk)=",pwt(jl,jk),",restore_temp=",restore_temp

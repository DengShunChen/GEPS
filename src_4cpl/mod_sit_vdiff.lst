            4292     2               &                     )                                                      &
            4293     2               &           +beta*( rhoice*cice*xkice*(SOL(3)-SOL(4))/(0.5*hice/pseaice(jl))             &
            4294     2               &             -rhowcw*pwkh(jl,nls+1)*(SOL(4)-SOL(5+nls))/(z(0)-z(nls+1))     &
            4295     2               &                 )                                                          &
            4296     2               &           )*zdtime                                                         &
            4297     2               &           +zdtime*(  zsoflw* ( FFN(0.)-FFN(-hw(0)) )                    &
            4298     2               &             -(pfluxw2+zsoflw) )

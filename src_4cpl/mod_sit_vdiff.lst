            7583     5                           !! no pobsws data, assume restore_temp to be that of the previous level
            7584     5                           ENDIF
            7585     4                         ENDIF
            7586     4                         IF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time.GT.0.)) THEN
            7587     4                           restore_u=(pobswu(jl,jk)-pwu(jl,jk))*(1.-0.5**(zdtime/suv_restore_time))
            7588     4                           ! obsws  vertical index start at 1
            7589     4                         ELSEIF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time.EQ.0.)) THEN
            7590     4                           restore_u=(pobswu(jl,jk)-pwu(jl,jk))
            7591     4                         ELSEIF (suv_restore_time.LT.0.) THEN

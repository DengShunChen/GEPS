            7542     1               !     3.1 Determining restore temperature at each level
            7543     2                     IF(lmixedlayer .and. jk .LT. jkmixing) THEN
            7544     2                     ! nudging to obstsw at [0m, 10m] or at waterbed(=nle)
            7545     2                       CALL nudging_sit_viff_gd_sfc(jl,jk,st_restore_time,ss_restore_time,restore_temp,restore_salt,&
            7546     2                                                    suv_restore_time,restore_u,restore_v,fratio,                    &
            7547     2                                                    st_restore_time_all,ss_restore_time_all,suv_restore_time_all)
            7548     2               !ps      ELSEIF ( jk.LE.jk10) THEN
            7549     2                     ELSEIF ( jk.LT.jk10) THEN
            7550     2                     ! nudging to obstsw at [0m, 10m] or at waterbed(=nle)
            7551     2                       CALL nudging_sit_viff_gd_sfc(jl,jk,st_restore_time,ss_restore_time,restore_temp,restore_salt,&
            7552     2                                                    suv_restore_time,restore_u,restore_v,fratio,                    &
            7553     2                                                    st_restore_time_all,ss_restore_time_all,suv_restore_time_all)
            7554     2                     ELSE

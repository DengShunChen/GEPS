            4378     1                     IF (lwf)THEN
            4379     1               !     water freeze/ice melt in the water-ice interface
            4380     1                       lwf=.FALSE.
            4381     1               !
            4382     2                       IF (fcew.LT.0.) THEN
            4383     2               !       freeze
            4384     2               !-----------------------------------------------------------------------
            4385     2                         fcewf=fcew

            2458                     ! optimal (Lotus: Case 9: WT0, EResRatio=3%,EMINMAX=1.E-4,EMINMIN=2.E-5,EMPOW=1., xldispmin=1., xlkmin=0.,d0=0.02,stderr=0.461), no warm-layer
            2459                     ! optimal (Lotus: Case 10: WT0, EResRatio=2%,EMINMAX=1.E-4,EMINMIN=1.E-6,EMPOW=0.8, xldispmin=1., xlkmin=0.,d0=0.02,stderr=0.537), no warm-layer
            2460                     

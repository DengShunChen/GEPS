            7392     3                         ss_restore_time=socn_restore_time
            7393     3                         suv_restore_time=socn_restore_time
            7394     3                       ELSE
            7395     3                       ! other SIT grids
            7396     3               !ps          ss_restore_time=ssit_restore_time
            7397     3                         st_restore_time=pssit_restore_time
            7398     3                         ss_restore_time=pssits_restore_time
            7399     3                         suv_restore_time=pssituv_restore_time
            7400     3                         st_restore_time_all=ssit_restore_time
            7401     3                         ss_restore_time_all=ssits_restore_time
            7402     3                         suv_restore_time_all=ssituv_restore_time
            7403     3                       ENDIF
            7404     2                     ELSEIF ( jk.LT.jk10) THEN
            7405     2                     ! [0m, 10m (or waterbed) )
            7406     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(obox_nudg_flag/100),2).EQ.1)) THEN
            7407     3                       ! obox grids
            7408     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=1xx
            7409     3                       !
            7410     3                         st_restore_time=obox_restore_time
            7411     3                         ss_restore_time=obox_restore_time
            7412     3                         suv_restore_time=obox_restore_time
            7413     3                       ELSEIF (pocnmask(jl).GT.0.) THEN
            7414     3                       ! ocn grids
            7415     3                         st_restore_time=socn_restore_time
            7416     3                         ss_restore_time=socn_restore_time
            7417     3                         suv_restore_time=socn_restore_time
            7418     3                       ELSE
            7419     3                       ! other SIT grids
            7420     3               !ps          ss_restore_time=ssit_restore_time
            7421     3                         st_restore_time=pssit_restore_time
            7422     3                         ss_restore_time=pssits_restore_time
            7423     3                         suv_restore_time=pssituv_restore_time
            7424     3                         st_restore_time_all=ssit_restore_time
            7425     3                         ss_restore_time_all=ssits_restore_time
            7426     3                         suv_restore_time_all=ssituv_restore_time
            7427     3                       ENDIF
            7428     2                     ELSEIF ( jk.LT.jk100) THEN
            7429     2                     ! [10m, 100m(waterbed) )
            7430     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(INT(obox_nudg_flag/100)/2),2).EQ.1)) THEN
            7431     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=2xx
            7432     3                       !
            7433     3                         st_restore_time=obox_restore_time
            7434     3                         ss_restore_time=obox_restore_time
            7435     3                       ELSEIF (pocnmask(jl).GT.0.) THEN

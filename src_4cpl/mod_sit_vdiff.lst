             299                     
             300                       !!! IMPLICIT NONE
             301                       !!! ! Standard i-o units
             302                       !!!
             303                       !!! INTEGER, PARAMETER :: nout = 0     ! standard output stream
             304                       !!! INTEGER, PARAMETER :: nerr = 0     ! error output stream
             305                       !!! INTEGER, PARAMETER :: nin  = 5     ! standard input stream
             306                       !!!
             307                       !!! INTEGER, PARAMETER:: dp=4
             308                       !!!
             309                       !!! SAVE
             310                       !!!
             311                       !!! PRIVATE
             312                     
             313                       ! variables public
             314                     
             315                       PUBLIC :: jptlucu1          ! lookup table lower bound
             316                       PUBLIC :: jptlucu2          ! lookup table upper bound
             317                       PUBLIC :: tlucua            ! table -- e_s*Rd/Rv
             318                       PUBLIC :: tlucub            ! table -- for derivative calculation: d es/ d t
             319                       PUBLIC :: tlucuc            ! table -- l/cp
             320                       PUBLIC :: tlucuaw           ! table
             321                       PUBLIC :: lookupoverflow    ! lookup table overflow flag
             322                     
             323                       ! subroutines public
             324                     
             325                       PUBLIC :: init_convect_tables ! initialize LUTs
             326                       PUBLIC :: lookuperror         ! error handling routine
             327                     
             328                       INTEGER, PARAMETER :: jptlucu1 =  50000  ! lookup table lower bound
             329                       INTEGER, PARAMETER :: jptlucu2 = 400000  ! lookup table upper bound
             330                     
             331                       LOGICAL :: lookupoverflow = .FALSE.          ! preset with false
             332                     
             333                       real :: tlucua(jptlucu1:jptlucu2)        ! table - e_s*Rd/Rv
             334                       real :: tlucub(jptlucu1:jptlucu2)        ! table - for derivative calculation
             335                       real :: tlucuc(jptlucu1:jptlucu2)        ! table - l/cp
             336                       real :: tlucuaw(jptlucu1:jptlucu2)       ! table

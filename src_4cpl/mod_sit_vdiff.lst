            7102     3                               (plat(jl) .LT. sitbox_nudg_n(isit_nudg)) ) THEN
            7103     3               
            7104     4   p    m                IF( ( (plon(jl) .GE. sitbox_nudg_w(isit_nudg)) .AND. &
            7105     4                               (plon(jl) .LT. sitbox_nudg_w(isit_nudg)+1.) ) .OR. &
            7106     4                             ( (plon(jl) .GE. sitbox_nudg_e(isit_nudg)-1.) .AND. &
            7107     4                               (plon(jl) .LT. sitbox_nudg_e(isit_nudg)) ) ) THEN
            7108     4   p    m                  lrestore_mix=.true.
            7109     4   p                     ENDIF
            7110     4   p    m                IF( ( (plat(jl) .GE. sitbox_nudg_s(isit_nudg)) .AND. &
            7111     4                                   (plat(jl) .LT. sitbox_nudg_s(isit_nudg)+1.) ) .OR. &
            7112     4                                 ( (plat(jl) .GE. sitbox_nudg_n(isit_nudg)-1.) .AND. &
            7113     4                                   (plat(jl) .LT. sitbox_nudg_n(isit_nudg)) ) ) THEN
            7114     4   p    m                  lrestore_mix=.true.
            7115     4   p                     ENDIF
            7116     3   p    v              ENDIF
            7117     2   p    v            ENDDO
            7118     1                   ENDIF
            7119                     
            7120     1                   IF(lrestore_mix) then
            7121     2                     IF ((pobswtb(jl).NE.xmissing).AND.(st_restore_time_all.GT.0.)) THEN
            7122     2                        restore_temp2=(pobswtb(jl)-pwt(jl,jk))*(1.-0.5**(zdtime/st_restore_time_all))
            7123     3                        IF(ltimeblending .AND. timebl_option .EQ. 1) THEN
            7124     3               !           restore_temp2=(pobswtb(jl)-pwt(jl,jk))*(1.-fratio)
            7125     3                          restore_temp2=(pobswtb(jl)-pwt(jl,jk))*(1.-fratio)+restore_temp2*fratio
            7126     3                        ENDIF
            7127     2                     ELSEIF ((pobswtb(jl).NE.xmissing).AND.(st_restore_time_all.EQ.0.)) THEN
            7128     2                        restore_temp2=(pobswtb(jl)-pwt(jl,jk))
            7129     2                     ELSEIF ((st_restore_time_all.LT.0.)) THEN

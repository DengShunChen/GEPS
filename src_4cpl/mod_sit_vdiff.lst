            2503                     !!#endif
            2504                     ! .TRUE. for with thermocline skin layer
            2505                     ! .FALSE. for without thermocline skin layer
            2506                     !!  LOGICAL, PARAMETER:: lsit_ice=.FALSE.
            2507                     !!  LOGICAL, PARAMETER:: lsit_salt=.FALSE.
            2508                       !! .FALSE.=turn off the salinity module
            2509                       LOGICAL, PARAMETER:: ldiag=.FALSE.
            2510                     ! LOGICAL, PARAMETER:: lwarning_msg=.TRUE.
            2511                     !!!  INTEGER, PARAMETER:: sit_ice_option=1
            2512                       LOGICAL, PARAMETER:: ldeep_water_nudg=.FALSE.
            2513                     !! deep water column nudging where obsevation data are not available
            2514                       real, PARAMETER:: QFLTI=0.2
            2515                       real, PARAMETER:: QFLTA=0.2
            2516                         ! QFLTI+QFLTA should be a value within 0-1., a security number
            2517                         ! for preventing ocillation. It should be modified with
            2518                         ! implicit coupling with the atmospehre for getting 1st order accuracy.
            2519                         ! QFLTI: weighting of current time step
            2520                         ! QFLTA: weighting of previous time step
            2521                         ! (1-QFLTI-QFLTA): weighting of previous time step

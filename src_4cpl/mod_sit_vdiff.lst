            7197     3                       ! assuming restore_temp to that of previous level
            7198     3                       ENDIF
            7199     2                     ENDIF
            7200     1               
            7201     1                     restore_temp=0.5*(restore_temp+restore_temp2)
            7202     1                     restore_salt=0.5*(restore_salt+restore_salt2)
            7203     1                     restore_u=0.5*(restore_u+restore_u2)
            7204     1                     restore_v=0.5*(restore_v+restore_v2)
            7205     1                   ENDIF
            7206                     

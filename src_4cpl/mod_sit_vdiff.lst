            7438     3                         ss_restore_time=uocn_restore_time
            7439     3                       ELSE
            7440     3               !ps          ss_restore_time=usit_restore_time
            7441     3                         st_restore_time=pusit_restore_time
            7442     3                         ss_restore_time=pusits_restore_time
            7443     3                         suv_restore_time=pusituv_restore_time
            7444     3                       ENDIF
            7445     2                     ELSE
            7446     2                     ! >= 100 m or at nle
            7447     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(INT(INT(obox_nudg_flag/100)/2)/2),2).EQ.1)) THEN
            7448     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=4xx
            7449     3                       !
            7450     3                         st_restore_time=obox_restore_time
            7451     3                         ss_restore_time=obox_restore_time
            7452     3                       ELSEIF (pocnmask(jl).GT.0.) THEN
            7453     3                       ! no nudging

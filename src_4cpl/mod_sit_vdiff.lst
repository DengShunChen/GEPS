            7455     3                         ss_restore_time=docn_restore_time
            7456     3                       ELSE
            7457     3               !ps          ss_restore_time=dsit_restore_time
            7458     3                         st_restore_time=pdsit_restore_time
            7459     3                         ss_restore_time=pdsits_restore_time
            7460     3                         suv_restore_time=pdsituv_restore_time
            7461     3                       ENDIF
            7462     2                     ENDIF
            7463     1               
            7464     2                     IF(ltimeblending) THEN
            7465     3                       IF(st_restore_time .GE. 0.) THEN

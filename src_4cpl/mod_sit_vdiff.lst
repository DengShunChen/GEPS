            7226                     ! **********************************************************************
            7227                       SUBROUTINE nudging_sit_viff_gd(jl,jrow,obox_restore_time, &
            7228                         socn_restore_time,uocn_restore_time,docn_restore_time,   &
            7229                         ssit_restore_time,ssits_restore_time,ssituv_restore_time, &
            7230                         pssit_restore_time,pusit_restore_time,pdsit_restore_time,   &
            7231                         pssits_restore_time,pusits_restore_time,pdsits_restore_time, &
            7232                         pssituv_restore_time,pusituv_restore_time,pdsituv_restore_time, tau, tauhr)
            7233                     
            7234                         IMPLICIT NONE
            7235                         INTEGER, INTENT(IN):: jl,jrow    ! lonitude index, and latitude index
            7236                         real, INTENT(IN):: obox_restore_time  ! nudging restore time for obox_mask(jl).GT.0. grids
            7237                         real, INTENT(IN):: socn_restore_time ! surface [0m,10m) ocean restore time for pocnmask(jl).GT.0. grids
            7238                         real, INTENT(IN):: uocn_restore_time ! upper [10m,100m) ocean restore time for pocnmask(jl).GT.0. grids
            7239                         real, INTENT(IN):: docn_restore_time ! deep (>100 m) ocean restore time for pocnmask(jl).GT.0. grids
            7240                         real, INTENT(IN):: ssit_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids
            7241                         real, INTENT(IN):: ssits_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for salinity
            7242                         real, INTENT(IN):: ssituv_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for u, v
            7243                         real, INTENT(IN):: pssit_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids
            7244                         real, INTENT(IN):: pusit_restore_time   ! upper [10m,100m) ocean temp/salt restore time for the rest SIT grids
            7245                         real, INTENT(IN):: pdsit_restore_time   ! deep (>100 m) ocean temp/salt restore time for the rest SIT grids
            7246                         real, INTENT(IN):: pssits_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for salinity
            7247                         real, INTENT(IN):: pusits_restore_time   ! upper [10m,100m) ocean temp/salt restore time for the rest SIT grids for salinity
            7248                         real, INTENT(IN):: pdsits_restore_time   ! deep (>100 m) ocean temp/salt restore time for the rest SIT grids for salinity
            7249                         real, INTENT(IN):: pssituv_restore_time   ! surface [0m,10m) ocean temp/salt restore time for the rest SIT grids for u, v
            7250                         real, INTENT(IN):: pusituv_restore_time   ! upper [10m,100m) ocean temp/salt restore time for the rest SIT grids for u, v
            7251                         real, INTENT(IN):: pdsituv_restore_time   ! deep (>100 m) ocean temp/salt restore time for the rest SIT grids for u, v
            7252                         INTEGER :: jk,jk10,jk100,jkmixing
            7253                         real:: restore_temp
            7254                         real:: restore_salt
            7255                         real:: restore_u
            7256                         real:: restore_v
            7257                         real:: st_restore_time, ss_restore_time, suv_restore_time
            7258                         real:: st_restore_time_all, ss_restore_time_all, suv_restore_time_all
            7259                     !ps
            7260                     ! time blending
            7261                         real:: tau,tauhr,tmpt0,tmpt1,tmpt2,xtau,gm,fratio
            7262                         real:: urand
            7263                         logical:: lbefore_bl
            7264                     
            7265                     !   nudging from surface to nudge_depth=100 m depth (default)
            7266     1                   IF (GDCHK2) then
            7267     1                      WRITE(nerr,*) ", I am in nudging_sit_viff_gd"
            7268     1               
            7269     1                      WRITE(nerr,*) "ssit_restore_time=",pssit_restore_time
            7270     1                      WRITE(nerr,*) "usit_restore_time=",pusit_restore_time
            7271     1                      WRITE(nerr,*) "dsit_restore_time=",pdsit_restore_time
            7272     1               
            7273     1                      WRITE(nerr,*) "socn_restore_time=",socn_restore_time
            7274     1                      WRITE(nerr,*) "uocn_restore_time=",uocn_restore_time
            7275     1                      WRITE(nerr,*) "docn_restore_time=",docn_restore_time
            7276     1                      WRITE(nerr,*) "pocnmask(",jl,",)=",pocnmask(jl)
            7277     1                   ENDIF
            7278                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            7279                     !!!    IF (pobswtb(jl).NE.xmissing) pobswtb(jl)=MAX(pobswtb(jl),pctfreez2(jl))
            7280                         IF (lsoil) RETURN
            7281     1                   IF (lgodas) THEN
            7282     1                     CALL interpolation_godas(jl,jrow,.TRUE.,.TRUE.,.TRUE.,.TRUE.)
            7283     1                   ELSE
            7284     1                     CALL interpolation_godas(jl,jrow,.FALSE.,.FALSE.,.FALSE.,.FALSE.)
            7285     1                   ENDIF
            7286                           IF (pobsws(jl,1).NE.xmissing) pobswsb(jl)=pobsws(jl,1)
            7287                     
            7288                         IF ((obox_restore_time.LT.0.).AND.(socn_restore_time.LT.0.).AND.    &
            7289                             ( uocn_restore_time.LT.0.).AND.( docn_restore_time.LT.0.).AND. &
            7290                             ( pssit_restore_time.LT.0.).AND.( pusit_restore_time.LT.0.).AND. &
            7291                             ( pdsit_restore_time.LT.0.) ) RETURN                               ! no nudging
            7292                     !
            7293                     !   1.0 Find jk at 10 m depth and nudge_depth (=100 m)
            7294                         jk=nls+1
            7295     1                   DO WHILE ( ((pwlvl(jl)-z(jk)).LT.nudge_depth_10).AND.(jk.LT.nle) )
            7296     1               !      nudging at depth just >= 10 m or at level nle (last water level)
            7297     1                      jk=jk+1
            7298     1                   END DO
            7299                         jk10=jk
            7300     1                   DO WHILE ( ((pwlvl(jl)-z(jk)).LT.mixedlayer(jl)).AND.(jk.LT.nle) )
            7301     1               !      nudging at depth just>= mixedlayer (55 m)
            7302     1                      jk=jk+1
            7303     1                   END DO
            7304                         jkmixing=jk
            7305     1                   IF (GDCHK3) then
            7306     1                     WRITE(nerr,*) ",mixedlayer=",mixedlayer(jl),",jkmixing=",jkmixing
            7307     1                   ENDIF
            7308     1                   DO WHILE ( ((pwlvl(jl)-z(jk)).LT.nudge_depth_100).AND.(jk.LT.nle) )
            7309     1               !      nudging at depth >= nudge_depth (100 m)
            7310     1                      jk=jk+1
            7311     1                   END DO
            7312                         jk100=jk
            7313                     
            7314                     
            7315                     !!! time blending
            7316                         tmpt0=0.
            7317                         fratio=1.
            7318     1                   IF(ltimeblending)THEN
            7319     1               ! unit day
            7320     1                     tmpt1=timebl_start*24. !(convert from day to hour)
            7321     1               
            7322     2                     IF(tau .le. tmpt1)then
            7323     2                       fratio=0.
            7324     2                       gm=-1.
            7325     2                       lbefore_bl=.true.
            7326     2                     ELSE
            7327     2                       lbefore_bl=.false.
            7328     3                       IF(timebl_option .EQ. 0) THEN
            7329     3                         tmpt0=(timebl_start+timebl_allsit)/2.*24.
            7330     3                         tmpt2=tmpt0-tmpt1
            7331     3                         xtau=tau-tmpt1
            7332     3               
            7333     3                         gm=abs(0.5*xtau/tmpt2-1.)
            7334     3               
            7335     4                         if(xtau .ge. timebl_allsit*24.)then
            7336     4                           fratio=1.                           !! use st/ss/suv_restore_time
            7337     4                         else if(gm.gt.0. .and. gm.lt.1.)then
            7338     4                           fratio=1.-exp(-1./gm*exp(0.5/(gm-1.)))
            7339     4                         else
            7340     4                           fratio=0.
            7341     4                         endif
            7342     3                       ENDIF
            7343     2               
            7344     3                       IF(timebl_option .EQ. 1)then
            7345     3                         fratio=(sin((tauhr-6.)/12.*api)+1.)*0.5
            7346     3                       ENDIF
            7347     2                     ENDIF
            7348     2                     IF(fratio .eq. 0.) then
            7349     2                       ltrigsit=.false.
            7350     2                     else
            7351     2                       ltrigsit=.true.
            7352     2                     endif
            7353     2                     IF(GDCHK3) then
            7354     2                      WRITE(nerr,*) "ltimeblending=",ltimeblending  &
            7355     2                                 ,",timebl_start=",timebl_start,",timebl_allsit=",timebl_allsit  &
            7356     2                                 ,",tmpt1=",tmpt1,",tmpt0=",tmpt0,",nls=",nls,",fratio=",fratio
            7357     2                     ENDIF
            7358     1                   ENDIF
            7359                     
            7360                     !!! end time blending
            7361                     
            7362                     !    IF(GDCHK3) print *,'in nudge_gd: nudge_depth_10=',nudge_depth_10,',jk10=',jk10
            7363                     !   3.0 Start nudging from 10 m (at nle, 10 m and >=100 m)
            7364                         restore_temp=0.
            7365                         restore_salt=0.
            7366                         restore_u=0.
            7367                         restore_v=0.
            7368                     !ps    jk=nls+1
            7369                         jk=nls
            7370                     !ps    DO WHILE ( jk.LE.nle )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 22
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            7371     1                   DO WHILE ( jk.LE.nle+1 )
            7372     1                     ! [0m, 10m (or waterbed) )
            7373     1                     ! .?: (first digit): T,S nudging. 0: no nudging, 1: nudging inside square boxes, 2: nudging outside the square boxes
            7374     1                     ! ?.: (decimal digit): high_damping coefficient for u,v currents in Sulu Sea, no nudging, 1: nudging inside square boxes, 2: nudging outside the square boxes
            7375     1                     ! obox_nudg_flag
            7376     1                     ! 0             |    0         |    0: no nudging
            7377     1                     ! 1:  0- 10 m   |    1: T,S    |    1: nudging inside
            7378     1                     ! 2: 10-100 m   |    2: U,V    |    2: nudging outside
            7379     1                     ! 4    >100 m   |              |
            7380     2                     IF(lmixedlayer .and. jk .LT. jkmixing) THEN
            7381     2                     ! [0m, mixing (or waterbed) )
            7382     3                       IF ((obox_mask(jl).GT.0.).AND.(MOD(INT(obox_nudg_flag/100),2).EQ.1)) THEN
            7383     3                       ! obox grids
            7384     3                       ! ie., obox_mask(jl).GT.0. .AND. obox_nudg_flag=1xx

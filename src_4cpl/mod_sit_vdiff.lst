            7467     3                       ELSE
            7468     4                         IF(timebl_option .EQ. 0 .AND. fratio .LT. 1) THEN
            7469     4                           st_restore_time=fratio*(2.*30.*24.*3600.) !2m
            7470     4                         ENDIF
            7471     4                         IF(timebl_option .EQ. 1 .AND. lbefore_bl ) THEN
            7472     4                           st_restore_time=0.
            7473     4                         ENDIF
            7474     3                       ENDIF
            7475     3                       IF(st_restore_time_all .GE. 0.) THEN

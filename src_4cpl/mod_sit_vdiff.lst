            7180     1               
            7181     2                     IF ((pobswv(jl,jk).NE.xmissing).AND.(suv_restore_time_all.GT.0.)) THEN
            7182     2                        restore_v2=(pobswv(jl,jk)-pwv(jl,jk))*(1.-0.5**(zdtime/suv_restore_time_all))
            7183     3                        IF(ltimeblending .AND. timebl_option .EQ. 1) THEN
            7184     3               !           restore_v2=(pobswv(jl,jk)-pwv(jl,jk))*(1.-fratio)
            7185     3                          restore_v2=(pobswv(jl,jk)-pwv(jl,jk))*(1.-fratio)+restore_v2*fratio

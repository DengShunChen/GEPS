            4547     2                         pfluxi2=0.
            4548     2                         zsoflw=zsoflw+zsofli
            4549     2                         zsofli=0.
            4550     3                         IF (.NOT.lsoil) THEN
            4551     3                           hw(nls+1)=hw(nls+1)+pzsi(jl,0)+pzsi(jl,1)+&
            4552     3               &             psilw(jl,0)+psilw(jl,1)
            4553     3                           zsf=zsf+(pzsi(jl,0)+psilw(jl,0))*wsm(nls+1)&
            4554     3               &             +(pzsi(jl,1)+psilw(jl,1))*salti*wsm(nls+1)
            4555     3                         ELSE
            4556     4                           IF (lwaterlevel) THEN
            4557     4                             pwlvl(jl)=pwlvl(jl)+pzsi(jl,0)+pzsi(jl,1)+&
            4558     4               &               psilw(jl,0)+psilw(jl,1)
            4559     4                           ENDIF
            4560     3                         ENDIF
            4561     2               !         reset snow/ice progonastic variables
            4562     2               !!!          DO jk=0,1
            4563     2               !!!            pzsi(jl,jk)=0.
            4564     2               !!!            psilw(jl,jk)=0.
            4565     2               !!!            ptsnic(jl,2*jk)=tmelt
            4566     2               !!!            ptsnic(jl,2*jk+1)=tmelt
            4567     2               !!!          ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4568     2       f                 pzsi(jl,:)=0.
            4569     2       f                 psilw(jl,:)=0.
            4570     2               !!! set to be underneath temp instead
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4571     2       f                 ptsnic(jl,:)=pwt(jl,0)
            4572     2               !!!
            4573     2    i                    CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            4574     2               
            4575     2               
            4576     2                         !!! hsn=HSNFN(pzsi(jl,0))
            4577     2                         !!! hesn=HEFN(hsn/4.,xksn,omegas)
            4578     2                         !!! hice=HICEFN(pzsi(jl,1))
            4579     2                         !!! heice=HEFN(hice/4.,xkice,omegas)
            4580     2               !
            4581     2                         lsm=.FALSE.
            4582     2                         irsv=irsv+1
            4583     2               !!!          CONTINUE
            4584     3                         IF (irsv.LT.4) THEN
            4585     3               !         recursive less than 4 times
            4586     3                           mas=4
            4587     3                           GOTO 830
            4588     3               !           prepare lvl3 matrix & recalculate temperature profile
            4589     3                         ELSE
            4590     3                           iderr=5
            4591     3    i                      CALL lkerr("Recursive more than 4 times.",hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,pctfreez2(jl),mas,mae,SOL)
            4592     3               !           The model is unable to judge melt or freeze, just arbitraily
            4593     3               !           pick one.
            4594     3                           CONTINUE
            4595     3                         ENDIF
            4596     2                       ELSE
            4597     2                         pzsi(jl,1)=pzsi(jl,1)-tmp
            4598     2                         psilw(jl,1)=psilw(jl,1)+tmp
            4599     2    i                    CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            4600     2               
            4601     2                         !!! hice=HICEFN(pzsi(jl,1))
            4602     2                         !!! heice=HEFN(hice/4.,xkice,omegas)
            4603     2                       ENDIF
            4604     1                     ENDIF
            4605                     !
            4606                     !*    10.3 Calc Melting Rate of snow
            4607                     !
            4608     1                     IF (lsm) THEN
            4609     1               !     snow melt on the surface
            4610     1                       lsm=.FALSE.
            4611     1               !       melts only
            4612     2                       IF (fces.LT.0.) THEN
            4613     2               !         numerical error
            4614     2                         iderr=3
            4615     2    i                    CALL lkerr("Snow melts but phase change energy <0.",hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,pctfreez2(jl),mas,mae,SOL)
            4616     2                         fces=0.
            4617     2                       ENDIF
            4618     1                       tmp= fces/rhoh2o/(alf+clw*(tmelt-ptsnic(jl,1)))
            4619     1               !       tmp is melted amount of SIWE
            4620     1               !       similar error chk routine as 11.1
            4621     2                       IF (tmp.GE.pzsi(jl,0)) THEN
            4622     2               !         snow melts completely
            4623     2                         iderr=12
            4624     2               !          CALL lkerr("Snow melts completely.",hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,pctfreez2(jl),mas,mae,SOL)
            4625     2                         pfluxi2=pfluxi2+(  pzsi(jl,0)*( alf+csn*(tmelt-tsim(1)) )&
            4626     2               &             )*rhoh2o/zdtime
            4627     2                         psilw(jl,1)=psilw(jl,1)+pzsi(jl,0)+psilw(jl,0)
            4628     2               !         reset snow progonastic variables
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4629     3       f                 DO jk=0,0
            4630     3       f                   pzsi(jl,jk)=0.
            4631     3       f                   psilw(jl,jk)=0.
            4632     3               !!            ptsnic(jl,2*jk)=tmelt
            4633     3               !!            ptsnic(jl,2*jk+1)=tmelt
            4634     3       f                 ENDDO
            4635     2               !!! set to be underneath temp instead
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4636     2       f                 ptsnic(jl,0:1)=ptsnic(jl,2)
            4637     2               !
            4638     2    i                    CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            4639     2               
            4640     2                         !!! hsn=HSNFN(pzsi(jl,0))
            4641     2                         !!! hesn=HEFN(hsn/4.,xksn,omegas)
            4642     2               !
            4643     2                         irsv=irsv+1
            4644     3                         IF (irsv.LT.4) THEN
            4645     3               !           recursive less than 4 times
            4646     3               !!!            CONTINUE
            4647     4                           IF (pzsi(jl,1) .GT.xicri) THEN
            4648     4                             mas=2
            4649     4                             GOTO 820
            4650     4                           ELSE
            4651     4                             mas=4
            4652     4                             GOTO 830
            4653     4                           ENDIF
            4654     3               !           prepare lvl2 matrix & recalculate temperature profile
            4655     3                         ELSE
            4656     3                           iderr=5
            4657     3    i                      CALL lkerr("Recursive more than 4 times.",hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,pctfreez2(jl),mas,mae,SOL)
            4658     3               !           The model is unable to judge melt or freeze, just arbitraily
            4659     3               !           pick one.
            4660     3                           CONTINUE
            4661     3                         ENDIF
            4662     2                       ELSE
            4663     2                         pzsi(jl,0)=pzsi(jl,0)-tmp
            4664     2                         psilw(jl,0)=psilw(jl,0)+tmp
            4665     2    i                    CALL update_snow_ice_property(pzsi(jl,0),pzsi(jl,1),hsn,hesn,hice,heice,pseaice(jl))
            4666     2               
            4667     2                         !!! hsn=HSNFN(pzsi(jl,0))
            4668     2                         !!! hesn=HEFN(hsn/4.,xksn,omegas)
            4669     2                       ENDIF
            4670     1                     ENDIF
            4671                     
            4672                     ! ----------------------------------------------------------------------
            4673     1                     IF ((.NOT.lsoil).AND.(lsit_salt)) THEN
            4674     1               ! ----------------------------------------------------------------------
            4675     1               !
            4676     1               !*   11. UPDATE SALINITY DUE TO VERTICAL MIXING
            4677     1               !        BY SOLVING A TRI-DIAGONAL MATRIX:
            4678     1               !
            4679     1               ! ----------------------------------------------------------------------
            4680     1                1100 CONTINUE
            4681     1               !      PRINT *, ", I am in 11) UPDATE Salinity."
            4682     1                       CALL LKDIFKH(hew,X,Y)
            4683     1               !
            4684     1               !
            4685     1               !* 11.0 Calc. the salinity flux
            4686     1               !
            4687     1               !
            4688     1               !*   pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            4689     1               !*   Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            4690     1               !
            4691     1               !!!     ppme2_int(jl)=(pbathy(jl)+SUM(hw(nls+1:nle))-wlvlm)/zdtime
            4692     1               !!! bjt 2010/2/22
            4693     1               !!!     IF(.NOT.lwaterlevel) THEN
            4694     1               !!!       zsf=-ppme2_int(jl)*wsm(nls+1)
            4695     1               !!!     ENDIF
            4696     1               !
            4697     1                    psaltwac(jl)=psaltwac(jl)-zsf
            4698     1               !
            4699     1               !* 11.1 SKIN LAYER
            4700     1               !
            4701     1                       jk = 0
            4702     2                       IF (.FALSE.) THEN
            4703     2                       !!! v7.5 for including runoff salt flux. (2010/5/8) (bjt)
            4704     2                       !!! Since runoff from river usually enters a water column in the top few meters,
            4705     2                       !!! not only in the skin layer
            4706     2               !!!        IF (lssst) THEN
            4707     2                         RHS(4)= wsm(0)-(1.-beta)*Y(4)*(wsm(0)-wsm(nls+1))-zsf/hew
            4708     2               !         Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            4709     2                         AA(4,1)=0.
            4710     2                         AA(4,3)=-beta*Y(4)
            4711     2                         AA(4,2)= 1. - AA(4,1) - AA(4,3)
            4712     2                       ELSE
            4713     2                         RHS(4)=0.
            4714     2                         AA(4,1)=0.
            4715     2                         AA(4,3)=-1.
            4716     2                         AA(4,2)= 1.
            4717     2                       ENDIF
            4718     1               !
            4719     1               !* 11.2 FIRST LAYER
            4720     1               !
            4721     1                       jk=1
            4722     2                       IF (.FALSE.) THEN
            4723     2                       !!! v7.5 for including runoff salt flux. (2010/5/8) (bjt)
            4724     2                       !!! Since runoff from river usually enters a water column in the top few meters,
            4725     2                       !!! not only in the skin layer
            4726     2               !!!        IF (lssst) THEN
            4727     2                         RHS(4+jk)= wsm(nls+jk)-hew/hw(nls+jk)*wsm(0)+ &
            4728     2               &          (1.-beta)*&
            4729     2               &          ( X(4+jk)*(wsm(0)-wsm(nls+jk))-&
            4730     2               &            Y(4+jk)*(wsm(nls+jk)-wsm(nls+jk+1)) )+ &
            4731     2               &          zdtime*pawsfl(jl,nls+jk)+zdtime*pawsfl0(jl,nls+jk)
            4732     2                         AA(4+jk,1)=-beta*X(4+jk)-hew/hw(nls+jk)
            4733     2                         AA(4+jk,3)=-beta*Y(4+jk)
            4734     2                         AA(4+jk,2)= 1. +beta*X(4+jk)+beta*Y(4+jk)
            4735     2                       ELSE
            4736     2                         RHS(4+jk)= wsm(nls+jk)-(1.-beta)*Y(4+jk)*(wsm(0)-wsm(nls+jk)) &
            4737     2               &          -zsf/hw(nls+jk)+zdtime*pawsfl(jl,nls+jk)+zdtime*pawsfl0(jl,nls+jk)
            4738     2                         AA(4+jk,1)=0.
            4739     2                         AA(4+jk,3)=-beta*Y(4+jk)
            4740     2                         AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)
            4741     2                       ENDIF
            4742     1               !
            4743     1               !       Note AA Matrix from jk=5 to nle is the same as pwt matrix
            4744     1               !
            4745     1               !* 11.3 MIDDLE LAYERS (jk=2,nle)
            4746     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.85, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      AA, X, Y, wsm, RHS
                                   <<< Loop-information  End >>>
            4747     2  pp    v              DO jk=2,nle-nls
            4748     2               !         If nle less than nls+2, do-loop won't do anything.
            4749     2   p    v                RHS(jk+4)= wsm(nls+jk)+(1.-beta)*(X(jk+4)*(wsm(nls+jk-1)-wsm(nls+jk))-&
            4750     2               &           Y(jk+4)*(wsm(nls+jk)-wsm(nls+jk+1)))+ &
            4751     2               &           zdtime*pawsfl(jl,nls+jk)+zdtime*pawsfl0(jl,nls+jk)
            4752     2   p    v                AA(4+jk,1)=-beta*X(4+jk)
            4753     2   p    v                AA(4+jk,3)=-beta*Y(4+jk)
            4754     2   p    v                AA(4+jk,2)= 1. - AA(4+jk,1) - AA(4+jk,3)
            4755     2               #ifdef DEBUG
            4756     2   p    v              if(GDCHK2) print *,"ps: 11.3, nle=",nle,",nls=",nls
            4757     2                       if(GDCHK2) print *,"ps: 11.3, wsm(nls+jk)=",wsm(nls+jk),",X(jk+4)=",X(jk+4)
            4758     2                       if(GDCHK2) print *,"ps: 11.3, wsm(nls+jk-1)=",wsm(nls+jk-1),", Y(jk+4)=",Y(jk+4)
            4759     2                       if(GDCHK2) print *,"ps: 11.3, zdtime=",zdtime,", pawsfl(jl,nls+jk)=",pawsfl(jl,nls+jk)
            4760     2                       if(GDCHK2) print *,"ps: 11.3, zdtime=",zdtime,", pawsfl0(jl,nls+jk)=",pawsfl0(jl,nls+jk)
            4761     2               #endif
            4762     2   p    v              END DO
            4763     1               !
            4764     1               !* 11.4 SOIL LAYER (jk=nle+1=G)
            4765     1               !
            4766     1               !       assume equal to the salinity of previous layer, LVL nle
            4767     1                       RHS(5+nle-nls)=0.
            4768     1                       AA(5+nle-nls,1)=-1.
            4769     1                       AA(5+nle-nls,3)=0.
            4770     1                       AA(5+nle-nls,2)=1.
            4771     1               !
            4772     1               !* 11.5 SOLVE THE TRIDIAGONAL MXTRIX
            4773     1               !
            4774     1               #ifdef DEBUG
            4775     1                       if(GDCHK2) print *,"ps: 11.5, RHS=", RHS(:)
            4776     1                       if(GDCHK2) print *,"ps: 11.5, AA(:,1)=", AA(:,1)
            4777     1                       if(GDCHK2) print *,"ps: 11.5, AA(:,2)=", AA(:,2)
            4778     1                       if(GDCHK2) print *,"ps: 11.5, AA(:,3)=", AA(:,3)
            4779     1               #endif
            4780     1                       CALL LU(4,5+nle-nls,AA,RHS,SOL)
            4781     1               !
            4782     1               !* 11.6 Restore salinity profile
            4783     1               !
            4784     1               #if defined DEBUG
            4785     1                       if(GDCHK2) print *,"ps: 11.6, SOL=", SOL(:)
            4786     1               #endif
            4787     1               
            4788     1                       pws(jl,0) = MIN(MAX(SOL(4),0.),SALT_MAX)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SOL
                                   <<< Loop-information  End >>>
            4789     2  pp   2v              DO jk = 1, nle+1-nls
            4790     2   p   2v                pws(jl,nls+jk) = MIN(MAX(SOL(jk+4),0.),SALT_MAX)
            4791     2   p   2v              END DO
            4792     1               !       Assume the missing layer salinity to be the first
            4793     1               !       available salinity, i.e., =pws(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4794     2  pp   4v              DO jk = 1, nls, 1
            4795     2   p   4v                pws(jl,jk) = pws(jl,nls+1)
            4796     2   p   4v              END DO
            4797     1               !
            4798     1                     ENDIF
            4799                     !
            4800                     !* 11.7 Update seawater density for new salinity and temperature
            4801                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z, pwrho
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 8
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4802     1   s    s           DO jk=0,nle+1
            4803     1                      !! pwrho(jk)=rho_from_theta(pws(jl,jk),pwt(jl,jk)-tmelt,0.)     ! density at surface (0 m depth)
            4804     1   m    m             pwrho(jk)=rho_from_theta(pws(jl,jk),pwt(jl,jk)-tmelt,pwlvl(jl)-z(jk))     ! in situ density
            4805     1   s    s             pwrho1000(jl,jk)=rho_from_theta(pws(jl,jk),pwt(jl,jk)-tmelt,1000.)     ! potential temperature at 1000 m depth
            4806     1   p    v             IF (jk.GE.1) pwrhoh(jk)=rho_from_theta(pws(jl,jk-1),pwt(jl,jk-1)-tmelt,pwlvl(jl)-z(jk))     ! in situ density
            4807     1   p    v           ENDDO
            4808                     
            4809                     !
            4810                     !*   12. UPDATE U, V DUE TO VERTICAL MIXING
            4811                     ! ----------------------------------------------------------------------
            4812                     !      IF (.NOT.(lsoil.OR.(locn.AND.(pocnmask(jl).GT.0.).AND.(ocn_couple_option.NE.11)))) THEN
            4813     1                     IF ( .NOT.lsoil.AND.(.NOT.locn.OR.(pocnmask(jl).LE.0.).OR.(ocn_couple_option.EQ.11)) ) THEN
            4814     1               ! ----------------------------------------------------------------------
            4815     1               !
            4816     1               !*   12. UPDATE U, V DUE TO VERTICAL MIXING
            4817     1               !          BY SOLVING A COMPLEX(dp) :: TRI-DIAGONAL MATRIX:
            4818     1               !
            4819     1               ! ----------------------------------------------------------------------
            4820     1               !      PRINT *, ", I am in 12) UPDATE U,V."
            4821     1               !
            4822     1               !*   12.1 Update Outflow Velocity & Water Level of Ocean
            4823     1               !
            4824     1               !      OUTFLW(jl)=OUTFLM(jl)+MAX(pwlvl(jl)-z(0),0.)
            4825     1               !      pwlvl(jl)=MIN(pwlvl(jl),z(0))
            4826     1               !
            4827     1                       CALL LKDIFKM(hew,X,Y)
            4828     1               !
            4829     1               !*    this line is moved to Ocean Sub
            4830     1               !
            4831     1               !!!        IF (lsit_ice.AND.mas.LT.4) THEN
            4832     2                       IF (mas.LT.4) THEN
            4833     2               !         set taucx and taucy to zero if snow/ice on top
            4834     2                         taucx(jl)=0.
            4835     2                         taucy(jl)=0.
            4836     2                       ENDIF
            4837     1                       tauc=taucx(jl)*(1.,0.)+taucy(jl)*(0.,1.)
            4838     1               !!
            4839     1               !
            4840     1               !*   12.2 PREPARE CURRENT VECTOR
            4841     1               !
            4842     1                1220   CONTINUE
            4843     2                       IF(locn.AND.(ocn_couple_option.EQ.11).AND.(pocnmask(jl).GT.0.)) THEN
            4844     2                       ! ocean grids: taking care in mo_ocean
            4845     2                         fr=0.
            4846     2                         zcor=0.
            4847     2                       ELSE
            4848     2               !          zcor=pcoriol(jl)
            4849     2               !          zcor=MAX(ABS(pcoriol(jl)),zepcor)  ! v9.8b: 20130822
            4850     2                         ! determining coriol, same as vdiff, but strange.
            4851     2                         ! It should have different in different hemisphere
            4852     2                         zcor=SIGN(MAX(ABS(pcoriol(jl)),zepcor),pcoriol(jl))  ! v9.8b: 20130822
            4853     2                         fr=7.E-5                                     ! = friction factor for current (1/s).
            4854     2                                                                      ! It is due to that one-column model neglect horizontal diffusion.
            4855     2                       ENDIF
            4856     1               !        PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.2."
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pawuflc, wum, wvm, wumc
                                   <<< Loop-information  End >>>
            4857     2  pp    v              DO jk=0,nle+1
            4858     2   p    v                wumc(jk)=wum(jk)*(1.,0.)+wvm(jk)*(0.,1.)
            4859     2   p    v                pawuflc(jk)=pawufl(jl,jk)*(1.,0.)+pawvfl(jl,jk)*(0.,1.)
            4860     2   p    v              ENDDO
            4861     1                       fr_corc=fr*(1.,0.)+zcor*(0.,1.)
            4862     1               !
            4863     1               !*   12.3 SKIN LAYER
            4864     1               !
            4865     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.3."
            4866     1                       jk=0
            4867     2                       IF (lssst) THEN
            4868     3                         IF (lv81) THEN
            4869     3                           RHSC(4)= wumc(0)&
            4870     3               &                   -(1.-beta2)*zdtime*fr_corc*wumc(0)&
            4871     3               &                   +zdtime*tauc/rhoh2o/hew&
            4872     3               &                   -(1.-beta)*Y(4)*(wumc(0)-wumc(nls+1))
            4873     3                           AAC(4,1)=(0.,0.)
            4874     3                           AAC(4,3)=-beta*Y(4)*(1.,0.)
            4875     3                           AAC(4,2)= (1.,0.) - AAC(4,1) - AAC(4,3)&
            4876     3               &                   +beta2*zdtime*fr_corc
            4877     3                         ELSE
            4878     3                           RHSC(4)= wumc(0)&
            4879     3               &                   +zdtime*tauc/rhoh2o/hew&
            4880     3               &                   -(1.-beta)*Y(4)*(wumc(0)-wumc(nls+1))
            4881     3                           AAC(4,1)=(0.,0.)
            4882     3                           AAC(4,3)=-beta*Y(4)*(1.,0.)
            4883     3                           AAC(4,2)= (1.,0.) - AAC(4,1) - AAC(4,3)
            4884     3                         ENDIF
            4885     2                       ELSE
            4886     2                         RHSC(4)=(0.,0.)
            4887     2                         AAC(4,1)=(0.,0.)
            4888     2                         AAC(4,3)=(-1.,0.)
            4889     2                         AAC(4,2)= (1.,0.)
            4890     2                       ENDIF
            4891     1               !
            4892     1               !     Note: In the equator, gl_coriol is too small to balance the wind
            4893     1               !     shear. Extra friction might be needed.
            4894     1               !
            4895     1               !*   12.5 FIRST LAYER
            4896     1               !
            4897     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.4."
            4898     1                       jk=1
            4899     2                       IF (lssst) THEN
            4900     3                         IF(lv81) THEN
            4901     3                           RHSC(4+jk)= wumc(nls+jk)-hew/hw(nls+jk)*wumc(0)&
            4902     3               &             -(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)*0.75&
            4903     3               &             +(1.-beta)*(X(4+jk)*(wumc(0)-wumc(nls+jk))&
            4904     3               &             -Y(4+jk)*(wumc(nls+jk)-wumc(nls+jk+1)))&
            4905     3               &             +zdtime*pawuflc(nls+jk)
            4906     3                           AAC(4+jk,1)=(-beta*X(4+jk)-hew/hw(nls+jk))*(1.,0.)
            4907     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4908     3                           AAC(4+jk,2)= (1.,0.) + (beta*X(4+jk)+beta*Y(4+jk))*(1.,0.)&
            4909     3               &             +beta2*zdtime*fr_corc*0.75
            4910     3                         ELSE
            4911     3                           RHSC(4+jk)= wumc(nls+jk)-hew/hw(nls+jk)*wumc(0)&
            4912     3               &             -(1.-beta2)*zdtime*fr_corc*wumc(nls+jk) &
            4913     3               &             +(1.-beta)*(X(4+jk)*(wumc(0)-wumc(nls+jk))&
            4914     3               &             -Y(4+jk)*(wumc(nls+jk)-wumc(nls+jk+1)))&
            4915     3               &             +zdtime*pawuflc(nls+jk)
            4916     3                           AAC(4+jk,1)=(-beta*X(4+jk)-hew/hw(nls+jk))*(1.,0.)
            4917     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4918     3                           AAC(4+jk,2)= (1.,0.) + (beta*X(4+jk)+beta*Y(4+jk))*(1.,0.)&
            4919     3               &             +beta2*zdtime*fr_corc
            4920     3                         ENDIF
            4921     2                       ELSE
            4922     3                         IF(lv81) THEN
            4923     3                           RHSC(4+jk)= wumc(nls+jk)-(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)&
            4924     3               &             -(1.-beta)*Y(4+jk)*(wumc(0)-wumc(nls+jk))&
            4925     3               &             +zdtime*pawuflc(nls+jk)
            4926     3                           AAC(4+jk,1)=(0.,0.)
            4927     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4928     3                           AAC(4+jk,2)= (1.,0.) - AAC(4+jk,1) - AAC(4+jk,3)&
            4929     3               &             +beta2*zdtime*fr_corc
            4930     3                         ELSE
            4931     3                           RHSC(4+jk)= wumc(nls+jk)-(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)&
            4932     3               &             +zdtime*tauc/rhoh2o/hw(nls+jk)&
            4933     3               &             -(1.-beta)*Y(4+jk)*(wumc(0)-wumc(nls+jk))&
            4934     3               &             +zdtime*pawuflc(nls+jk)
            4935     3                           AAC(4+jk,1)=(0.,0.)
            4936     3                           AAC(4+jk,3)=(-beta*Y(4+jk))*(1.,0.)
            4937     3                           AAC(4+jk,2)= (1.,0.) - AAC(4+jk,1) - AAC(4+jk,3)&
            4938     3               &             +beta2*zdtime*fr_corc
            4939     3                         ENDIF
            4940     2                       ENDIF
            4941     1               !
            4942     1               !       or
            4943     1               ! ----------------------------------------------------------------------
            4944     1               !         RHSC(5)= wumc(1)
            4945     1               !     1    -(1.-beta2)*zdtime*fr_corc*wumc(1)
            4946     1               !     2    +zdtime*tauc/rhoh2o/hw(1)
            4947     1               !     3    -(1.-beta)*Y(5)*(wumc(1)-wumc(2))
            4948     1               !
            4949     1               !        AAC(5,1)=(0.,0.)
            4950     1               !        AAC(5,3)=-beta*Y(5)*(1.,0.)
            4951     1               !        AAC(5,2)= (1.,0.) - AAC(5,1) - AAC(5,3)
            4952     1               !     1    +beta2*zdtime*fr_corc
            4953     1               ! ----------------------------------------------------------------------
            4954     1               !
            4955     1               !       Note both of the above two equations are identical. The one we
            4956     1               !       choose is still a tridigonal matrix while coupled with ATM PBL
            4957     1               !       directly. i.e. tauc can be implicitly determined by a coupled ATM
            4958     1               !       and ocean momentum matrix by solving a tri-diagonal matrix only. A
            4959     1               !       value of 0.75 to adjust coriolis force due to the physical thickness
            4960     1               !       of skin layer is 0.25 hw(1). Therefore only 75% remained to be
            4961     1               !       counted here.
            4962     1               !
            4963     1               !*   12.6 MIDDLE LAYERS (jk=2,nle)
            4964     1               !
            4965     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE U,V., 12.5."
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 18
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.06, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      AAC, X, Y, pawuflc, wumc, RHSC
                                   <<< Loop-information  End >>>
            4966     2  pp    v              DO jk=2,nle-nls
            4967     2   p    v                RHSC(4+jk)= wumc(nls+jk)&
            4968     2               &           -(1.-beta2)*zdtime*fr_corc*wumc(nls+jk)&
            4969     2               &           +(1.-beta)*(X(4+jk)*(wumc(nls+jk-1)-wumc(nls+jk))&
            4970     2               &           -Y(4+jk)*(wumc(nls+jk)-wumc(nls+jk+1)))&
            4971     2               &           +zdtime*pawuflc(nls+jk)
            4972     2   p    v                AAC(4+jk,1)=-beta*X(4+jk)*(1.,0.)
            4973     2   p    v                AAC(4+jk,3)=-beta*Y(4+jk)*(1.,0.)
            4974     2   p    v                AAC(4+jk,2)= (1.,0.) -AAC(4+jk,1) - AAC(4+jk,3)&
            4975     2               &           +beta2*zdtime*fr_corc
            4976     2               !         X,Y is the same as temperature's
            4977     2   p    v              END DO
            4978     1               !
            4979     1               !*   12.7 SOIL LAYER (jk=nle+1=G)
            4980     1               !
            4981     1               !     zero velocity is assumed.
            4982     1                       jk=nle+1-nls
            4983     1                       RHSC(4+jk)= (0.,0.)
            4984     1                       AAC(4+jk,1)=(0.,0.)
            4985     1                       AAC(4+jk,3)=(0.,0.)
            4986     1                       AAC(4+jk,2)= (1.,0.) - AAC(4+jk,1) - AAC(4+jk,3)
            4987     1               !
            4988     1               !*   12.8 SOLVE THE TRIDIAGONAL MATRIX
            4989     1               !
            4990     1               !      PRINT *, "I am going to LU2."
            4991     1                       CALL LU2(4,5+nle-nls,AAC,RHSC,SOLCMPLX)
            4992     1               !      PRINT *, "I left LU2."
            4993     1               !
            4994     1               !*   12.9 Restore velocity profile
            4995     1               !
            4996     1               !        IF(GDCHK3) THEN
            4997     1               !          WRITE(nerr,*) "I am in 12.9, 1:"
            4998     1               !          WRITE(nerr,*) "pwu=",pwu(jl,:)
            4999     1               !          WRITE(nerr,*) "pwv=",pwv(jl,:)
            5000     1               !        ENDIF
            5001     1                       pwu(jl,0) = REAL(SOLCMPLX(4))
            5002     1                       pwv(jl,0) = AIMAG(SOLCMPLX(4))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SOLCMPLX
                                   <<< Loop-information  End >>>
            5003     2  pp   2v              DO jk = 1, nle+1-nls
            5004     2   p   2v                pwu(jl,nls+jk) = REAL(SOLCMPLX(jk+4))
            5005     2   p   2v                pwv(jl,nls+jk) = AIMAG(SOLCMPLX(jk+4))
            5006     2   p   2v              END DO
            5007     1               !        IF(GDCHK3) THEN
            5008     1               !          WRITE(nerr,*) "I am in 12.9, 2:"
            5009     1               !          WRITE(nerr,*) "pwu=",pwu(jl,:)
            5010     1               !          WRITE(nerr,*) "pwv=",pwv(jl,:)
            5011     1               !        ENDIF
            5012     1               !         Assume the missing layer current to be the first
            5013     1               !         available current, i.e., =pwu(nls+1), pwv(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            5014     2  pp   2v              DO jk = 1, nls, 1
            5015     2   p   2v                pwu(jl,jk) = pwu(jl,nls+1)
            5016     2   p   2v                pwv(jl,jk) = pwv(jl,nls+1)
            5017     2   p   2v              END DO
            5018     1               ! ----------------------------------------------------------------------
            5019     1                     ENDIF
            5020                     ! ----------------------------------------------------------------------
            5021                     !
            5022                     !*   13. UPDATE TKE DUE TO VERTICAL MIXING
            5023                     !            BY SOLVING A TRI-DIAGONAL MATRIX:
            5024                     !
            5025                     ! ----------------------------------------------------------------------
            5026     1                     IF (.NOT.lsoil) THEN
            5027     1               ! ----------------------------------------------------------------------
            5028     1                1300   CONTINUE
            5029     1               !      PRINT *, "istep=",istep,"pe=",mpp_pe(),"jrow=",jrow,", I am in UPDATE TKE"
            5030     2                       IF (lsteady_TKE) THEN
            5031     2                         CALL calc_steady_tke
            5032     2                       ELSE
            5033     2                         CALL calc_unsteady_tke
            5034     2                       ENDIF
            5035     1               ! ----------------------------------------------------------------------
            5036     1                     ENDIF
            5037                     ! ----------------------------------------------------------------------
            5038                     !*   14. This is needed unless resolution is better than about 10 km; otherwise
            5039                     !        rotation does not allow proper and full convective adjustment. Should
            5040                     !        be applied stochastically, as the strong events leading to
            5041                     ! ----------------------------------------------------------------------
            5042     1                     IF (lpenetrative_convection) THEN !!v9.83 (MINOR=3), bjt, 20130824
            5043     1                       CALL penetrative_convection(jl)
            5044     1                     ENDIF
            5045                     ! ----------------------------------------------------------------------
            5046                     !
            5047                     !*   15. FINAL: PRINT DIAGNOSTIC VARIABLES
            5048                     !
            5049                     ! ----------------------------------------------------------------------
            5050                     !
            5051                     !*   15.1 Fluxes
            5052                     !
            5053                           CALL calc_flux
            5054                     !
            5055                     !*   15.2 Water Level
            5056                     !
            5057                     !!!      IF(.NOT.lsoil) THEN
            5058                     !!!        IF (lwaterlevel) THEN
            5059                     !!!          pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            5060                     !!!        ENDIF
            5061                     !!!      ENDIF
            5062                     !!!
            5063                     !!!  do not change the progonastic variable hw, lsoil during the iteration
            5064                     !!!      IF (lwaterlevel) THEN
            5065                     !!!      ! for both water and soil grid
            5066                     !!!          CALL pzcord(jl,jrow)                    ! bjt 2010/2/21
            5067                     !!!      ENDIF
            5068                       RETURN
            5069                      2100 FORMAT(1X,2(I4,1X),1(I8,1X),(I4,1X),5F8.3,2E9.2)
            5070                     !
            5071                     END SUBROUTINE thermocline
            5072                     ! **********************************************************************
            5073                     ! **********************************************************************
            5074                       real FUNCTION calc_tkewave(utauw,depth)
            5075                       !  utauw   : friction velocity of the water side (m/s)              I
            5076                       !  depth: depth (m), 0 at the surface and plus downward (+, always)
            5077                       !  calc_tkewave: tke due to wave (m2/s2)
            5078                       !  Mellor and Blumberg (2004)
            5079                       !
            5080                         IMPLICIT NONE
            5081                         real, INTENT(in):: utauw
            5082                         real, INTENT(in):: depth
            5083                         real,PARAMETER:: ccb=100.      ! constant for wave breaking proposed by Craig and Banner (1994) in Mellor and Blumberg (2004)
            5084                                                               ! Mellor and Blumberg (2004), 150 in Stacey (1999)
            5085                         real:: lambda
            5086     1                   IF (.NOT.lwave_breaking) THEN
            5087     1                     calc_tkewave=0.
            5088     1                   ELSE
            5089     1                     lambda=1.15925e-5*G/utauw**2.
            5090     1                     calc_tkewave=0.5*(15.8*ccb)**(2./3.)*utauw**2.*EXP(-lambda*depth)
            5091     1                   ENDIF
            5092     1                   IF(GDCHK2) THEN
            5093     1                     print *,"ccb=",ccb,",utauw=",utauw
            5094     1                     print *,"lambda=",lambda,",depth=",depth
            5095     1                   ENDIF
            5096                     
            5097                       END FUNCTION calc_tkewave
            5098                     ! **********************************************************************
            5099                       SUBROUTINE calc_steady_tke
            5100                       ! ----------------------------------------------------------------------
            5101                       !*   calc TKE at steady state
            5102                       ! ----------------------------------------------------------------------
            5103                         IMPLICIT NONE
            5104                         INTEGER:: jk,levelm,level
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z, pwrhoh, pwrho, zlk
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5105     1                   DO jk=1,nle+1-nls
            5106     1                     levelm=nls+jk-1
            5107     1                     IF (levelm.EQ.nls) levelm=0
            5108     1                     level=nls+jk
            5109     1                     pwtke(jl,level) = ck*pwlmx(jl,level)*pwldisp(jl,level)/ce*                            &
            5110     1                    &        (  ( (pwu(jl,levelm)-pwu(jl,level))/(z(levelm)-z(level)) )**2.+               &
            5111     1                    &           ( (pwv(jl,levelm)-pwv(jl,level))/(z(levelm)-z(level)) )**2.+               &
            5112     1                    &           G/rhoh2o/Prw*( pwrhoh(level)-pwrho(level) )/(z(levelm)-z(level))  )
            5113     1               #ifdef DEBUG
            5114     2                     IF (GDCHK2) THEN
            5115     2                       print *, "ck=",ck,"pwlmx=",pwlmx(jl,level),"pwldisp=",pwldisp(jl,level)
            5116     2                       print *, "ce=",ce,"pwu(jl,levelm)=",pwu(jl,levelm),"pwu(jl,level)=",pwu(jl,level)
            5117     2                       print *, "z(levelm)=",z(levelm),"z(level)=",z(level)
            5118     2                       print *, "G=",G,"rhoh2o=",rhoh2o,"Prw=",Prw
            5119     2                       print *, "pwrhoh(level)=",pwrhoh(level),"pwrho(level)=",pwrho(level)
            5120     2                       print *, "pwtke(",jl,",",level,")=", pwtke(jl,level)
            5121     2                       print *, "tkewave=",calc_tkewave(utauw,pwlvl(jl)-zlk(level))
            5122     2                       print *, "utauw=",utauw
            5123     2                       print *, "depth=",pwlvl(jl)-zlk(level)
            5124     2                     ENDIF
            5125     1               #endif
            5126     1                     pwtke(jl,level) = MAX(  pwtke(jl,level), emin )+ calc_tkewave(utauw,pwlvl(jl)-zlk(level))
            5127     1                   END DO
            5128                         !     Assume the skin layer and the missing layer TKE to be the first
            5129                         !     available TKE, i.e., =pwtke(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5130     1  pp   4v          DO jk = 0, nls, 1
            5131     1   p   4v            pwtke(jl,jk) = pwtke(jl,nls+1)
            5132     2   p   4v            IF(GDCHK2) THEN
            5133     2       4               print *, "pwtke(",jl,",",level,")=", pwtke(jl,level)
            5134     2   p   4v            ENDIF
            5135     1   p   4v          END DO
            5136                       END SUBROUTINE calc_steady_tke
            5137                     !***********************************************************************
            5138                       SUBROUTINE calc_unsteady_tke
            5139                       ! ----------------------------------------------------------------------
            5140                       !*   calc TKE at unsteady state
            5141                       ! ----------------------------------------------------------------------
            5142                         IMPLICIT NONE
            5143                         INTEGER:: jk,levelm,level,levelp
            5144                         real, DIMENSION(0:lkvl+5):: X,Y,RHS,SOL
            5145                         real, DIMENSION(0:lkvl+5,3):: AA
            5146                     !
            5147                     !*   13.1 Skin layer (jk = 0)
            5148                     !
            5149                             jk = 0
            5150     1                       IF (lwave_breaking) THEN
            5151     1                       ! set pwtke(0) to be those in Mellor and Blumberg (2004)
            5152     1                         RHS(4)= calc_tkewave(utauw,0.)
            5153     1                         AA(4,1)=0.
            5154     1                         AA(4,3)=0.
            5155     1                         AA(4,2)=1.
            5156     1                       ELSE
            5157     1                       ! assume to equal to the value of the first layer
            5158     1                         RHS(4)=0.
            5159     1                         AA(4,1)=0.
            5160     1                         AA(4,3)=-1.
            5161     1                         AA(4,2)= 1.
            5162     1                       ENDIF
            5163                     #ifdef DEBUG
            5164                               IF (GDCHK2) print *, "calc_tkewave=",RHS(4)
            5165                     #endif
            5166                     !
            5167                     !*   13.2 For first to bottom layers (jk = 1 - nle+1)
            5168                     !
            5169                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z, zlk, wtkem, X, Y, AA, RHS
                                   <<< Loop-information  End >>>
            5170     1  pp    s              DO jk=1,nle+1-nls
            5171     1   p    v                levelm=nls+jk-1
            5172     1   p    s                IF (levelm.EQ.nls) levelm=0
            5173     1   p    v                level=nls+jk
            5174     1   p    s                levelp=nls+jk+1
            5175     1               !!!          IF (levelm.EQ.nls) THEN
            5176     1               !!!          !! first layer
            5177     1               !!!            X(4+jk)= 0.
            5178     1               !!!            Y(4+jk)= zdtime*pwkm(jl,level)/&
            5179     1               !!!&             ( (z(levelm)-z(level))*(zlk(level)-zlk(levelp)) )
            5180     1               !!!            RHS(4+jk)= wtkem(level)&
            5181     1               !!!&             +(1.-beta)*(                                       &
            5182     1               !!!&                         -Y(4+jk)*(wtkem(level)-wtkem(levelp)) )&
            5183     1               !!!&             +beta2* (&
            5184     1               !!!&             +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5185     1               !!!&             +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5186     1               !!!&               rhom(level) )/(z(levelm)-z(level)) )                      &
            5187     1               !!!&             +(1-beta2)*(                                                                    &
            5188     1               !!!&             +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))                          &
            5189     1               !!!&                            /(z(levelm)-z(level)))**2.                                    &
            5190     1               !!!&             +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))                          &
            5191     1               !!!&                            /(z(levelm)-z(level)))**2.                                    &
            5192     1               !!!&             +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5193     1               !!!&               pwrho(level) )/(z(levelm)-z(level))    )             &
            5194     1               !!!&             -0.5_dp*ce*zdtime*wtkem(level)**(1.5_dp)/pwldisp(jl,level)                   &   ! bug, v0.9879
            5195     1               !!!&             +zdtime*pawtkefl(jl,level)
            5196     1               !!!
            5197     1               !!!          ELSE IF (levelp.EQ.(nle+2)) THEN
            5198     2   p    s                IF (levelp.EQ.(nle+2)) THEN
            5199     2                         !! bottom layer
            5200     2   p    s                  X(4+jk)= zdtime*pwkm(jl,level)/&
            5201     2               &             ( (z(levelm)-z(level))*(zlk(levelm)-zlk(level)) )
            5202     2   p    s                  Y(4+jk)= 0.
            5203     2   p    s                  RHS(4+jk)= wtkem(level)&
            5204     2               &             +(1.-beta)*( X(4+jk)*(wtkem(levelm)-wtkem(level))&
            5205     2               &                                                               )&
            5206     2               &             +beta2* (&
            5207     2               &             +pwkm(jl,level)*zdtime*((wum(levelm)-wum(level))/(z(levelm)-z(level)))**2.   &
            5208     2               &             +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5209     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5210     2               &               rhom(level) )/(z(levelm)-z(level)) )                      &
            5211     2               &             +(1-beta2)*(                                                                    &
            5212     2               &             +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))                          &
            5213     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5214     2               &             +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))                          &
            5215     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5216     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5217     2               &               pwrho(level) )/(z(levelm)-z(level))    )             &
            5218     2               &             -0.5*ce*zdtime*wtkem(level)**(1.5)/pwldisp(jl,level)                   &             ! bug, v0.9879
            5219     2               &             +zdtime*pawtkefl(jl,level)
            5220     2   p    s                ELSE
            5221     2                         !! middle layers
            5222     2   p    s                  X(4+jk)= zdtime*pwkm(jl,level)/                                                   &
            5223     2               &             ( (z(levelm)-z(level))*(zlk(levelm)-zlk(level)) )
            5224     2   p    s                  Y(4+jk)= zdtime*pwkm(jl,level)/&
            5225     2               &             ( (z(levelm)-z(level))*(zlk(level)-zlk(levelp)) )
            5226     2   p    s                  RHS(4+jk)= wtkem(level)&
            5227     2               &             +(1.-beta)*( X(4+jk)*(wtkem(levelm)-wtkem(level))                            &
            5228     2               &                         -Y(4+jk)*(wtkem(level)-wtkem(levelp)) )                             &
            5229     2               &             +beta2* (&
            5230     2               &             +pwkm(jl,level)*zdtime*((wum(levelm)-wum(level))/(z(levelm)-z(level)))**2.   &
            5231     2               &             +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5232     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5233     2               &               rhom(level) )/(z(levelm)-z(level)) )                      &
            5234     2               &             +(1-beta2)*(                                                                    &
            5235     2               &             +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))                          &
            5236     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5237     2               &             +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))                          &
            5238     2               &                            /(z(levelm)-z(level)))**2.                                    &
            5239     2               &             +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5240     2               &               pwrho(level) )/(z(levelm)-z(level))    )             &
            5241     2               &             -0.5*ce*zdtime*wtkem(level)**(1.5)/pwldisp(jl,level)                   &               ! bug, v0.9879
            5242     2               &             +zdtime*pawtkefl(jl,level)
            5243     2               
            5244     2               !            IF(GDCHK3)  then
            5245     2               !              print *,'jk=',jk,',level=',level,',levelm=',levelm
            5246     2               !              print *,'wtkem(levelm)=',wtkem(levelm),',wtkem(level)=',wtkem(level)
            5247     2               !              print *,'wtkem(levelp)=',wtkem(levelp),',pwkm(jl,level)=',pwkm(jl,level)
            5248     2               !              print *,'wum(levelm)=',wum(levelm),',wum(level)=',wum(level)
            5249     2               !              print *,'wvm(levelm)=',wvm(levelm),',wvm(level)=',wvm(level)
            5250     2               !              print *,'pwkh(jl,level)=',pwkh(jl,level),',rhomh(level)=',rhomh(level)
            5251     2               !              print *,'rhom(level)=',rhom(level),',z(levelm)=',z(levelm),',z(level)=',z(level)
            5252     2               !              print *,'pwu(jl,levelm)=',pwu(jl,levelm),',pwu(jl,level)=',pwu(jl,level)
            5253     2               !              print *,'pwv(jl,levelm)=',pwv(jl,levelm),',pwv(jl,level)=',pwv(jl,level)
            5254     2               !              print *,'pwrhoh(level)=',pwrhoh(level),',pwrho(level)=',pwrho(level)
            5255     2               !              print *,'pawtkefl(jl,level)=',pawtkefl(jl,level),',pwldisp(jl,level)=',pwldisp(jl,level)
            5256     2               !              print *,'zdtime=',zdtime,',ce=',ce,',beta=',beta,',beta2=',beta2
            5257     2               !              print *,'pstmp1=',(1.-beta)*( X(4+jk)*(wtkem(levelm)-wtkem(level))                            &
            5258     2               !&                         -Y(4+jk)*(wtkem(level)-wtkem(levelp)) )
            5259     2               !              print *,'pstmp2=',beta2* (&
            5260     2               !&                         +pwkm(jl,level)*zdtime*((wum(levelm)-wum(level))/(z(levelm)-z(level)))**2.   &
            5261     2               !&                         +pwkm(jl,level)*zdtime*((wvm(levelm)-wvm(level))/(z(levelm)-z(level)))**2.   &
            5262     2               !&                         +pwkh(jl,level)*zdtime*G/rhoh2o*( rhomh(level)-            &
            5263     2               !&                           rhom(level) )/(z(levelm)-z(level)) )
            5264     2               !             print *,'pstmp3=',(1-beta2)*(&
            5265     2               !&                         +pwkm(jl,level)*zdtime*((pwu(jl,levelm)-pwu(jl,level))&
            5266     2               !&                            /(z(levelm)-z(level)))**2.&
            5267     2               !&                         +pwkm(jl,level)*zdtime*((pwv(jl,levelm)-pwv(jl,level))&
            5268     2               !&                            /(z(levelm)-z(level)))**2.&
            5269     2               !&                         +pwkh(jl,level)*zdtime*G/rhoh2o*( pwrhoh(level)-      &
            5270     2               !&                           pwrho(level) )/(z(levelm)-z(level))    )
            5271     2               !              print *,'pstmp4=',0.5*ce*zdtime*wtkem(level)**(1.5)/pwldisp(jl,level)
            5272     2               !              print *,'RHS(4+jk)=',RHS(4+jk)
            5273     2               !            ENDIF
            5274     2   p    v                ENDIF
            5275     1               !
            5276     1               !
            5277     1               !     -- DO NOT ALLOW   zdtime*(TOTAL DAMPING) > pwtke   --
            5278     1               !
            5279     1   p    v                RHS(4+jk)=MAX(RHS(4+jk),0.)
            5280     1               !
            5281     1   p    v                AA(4+jk,1)=-beta*X(4+jk)
            5282     1   p    v                AA(4+jk,3)=-beta*Y(4+jk)
            5283     1   p    v                AA(4+jk,2)= 1.+1.5*ce*zdtime*SQRT(wtkem(level))/pwldisp(jl,level)&
            5284     1               &          -AA(4+jk,1)- AA(4+jk,3)
            5285     1   p    v              ENDDO
            5286                     !
            5287                     !*   13.4 SOLVE THE TRIDIAGONAL MATRIX
            5288                     !
            5289                     !        IF(GDCHK3) then
            5290                     !          print *,'before LU, RHS(:)=',RHS(:)
            5291                     !          print *,'AA(:,1)=',AA(:,1)
            5292                     !          print *,'AA(:,2)=',AA(:,2)
            5293                     !          print *,'AA(:,3)=',AA(:,3)
            5294                     !          print *,'SOL(:)=',SOL(:)
            5295                     !        ENDIF
            5296                             CALL LU(4,5+nle-nls,AA,RHS,SOL)
            5297                     !        IF(GDCHK3) then
            5298                     !          print *,'after LU, RHS(:)=',RHS(:)
            5299                     !          print *,'AA(:,1)=',AA(:,1)
            5300                     !          print *,'AA(:,2)=',AA(:,2)
            5301                     !          print *,'AA(:,3)=',AA(:,3)
            5302                     !          print *,'SOL(:)=',SOL(:)
            5303                     !        ENDIF
            5304                     !
            5305                     !*   13.5 Restore TKE profile
            5306                     !     limit tom emin (=1.0E-6) (GASPAR ET AL., 1990)
            5307                     !
            5308                             pwtke(jl,0) = MAX(SOL(4)+emin, tol)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SOL
                                   <<< Loop-information  End >>>
            5309     1  pp   2v              DO jk = 1, nle+1-nls
            5310     1   p   2v                pwtke(jl,nls+jk) = SOL(jk+4)
            5311     1               #ifdef DEBUG
            5312     1   p   2v                IF (GDCHK2) print *, "pwtke(",jl,",",nls+jk,")=", pwtke(jl,nls+jk)
            5313     1               #endif
            5314     1   p   2v                pwtke(jl,nls+jk) = MAX(pwtke(jl,nls+jk),emin)
            5315     1               !          IF (GDCHK3) print *, "pwtke(",jl,",",nls+jk,")=", pwtke(jl,nls+jk)
            5316     1   p   2v              END DO
            5317                     
            5318                     !        IF(GDCHK3) print *,'nls=',nls,',nle=',nle
            5319                     !         Assume the skin layer and the missing layer TKE to be the first
            5320                     !         available TKE, i.e., =pwtke(nls+1).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5321     1  pp   4v              DO jk = 0, nls, 1
            5322     1   p   4v                pwtke(jl,jk) = pwtke(jl,nls+1)
            5323     1   p   4v              END DO
            5324                       END SUBROUTINE calc_unsteady_tke
            5325                     !***********************************************************************
            5326                       SUBROUTINE calc_flux
            5327                       ! ----------------------------------------------------------------------
            5328                       !*   calc fluxes
            5329                       ! ----------------------------------------------------------------------
            5330                     !*   14.2 pgrndcapc, pgrndhflx_int, current, tsw
            5331                     !
            5332     1                  IF (hesn.GT.csncri) THEN
            5333     1               !  snow on top
            5334     1                    pgrndhflx_int(jl)=-rhosn*csn*xksn*                               &
            5335     1                      (  beta*(ptsnic(jl,0)-ptsnic(jl,1))                            &
            5336     1                        +(1.-beta)*(tsim(0)-tsim(1))                              &
            5337     1                        )/(0.5*hsn/pseaice(jl))
            5338     1                  ELSEIF (heice.GT.xicri) THEN
            5339     1               !  ice on top
            5340     1                    pgrndhflx_int(jl)=-rhoice*cice*xkice*                            &
            5341     1                      (  beta*(ptsnic(jl,2)-ptsnic(jl,3))                            &
            5342     1                        +(1.-beta)*(tsim(2)-tsim(3))                              &
            5343     1                        )/(0.5*hice/pseaice(jl))
            5344     1                  ELSEIF(.NOT.lsoil) THEN
            5345     1               !  water on top
            5346     1                    pgrndhflx_int(jl)=-rhowcw*pwkh(jl,nls+1)*                        &
            5347     1                      (  beta*(pwt(jl,0)-pwt(jl,nls+1))                              &
            5348     1                        +(1.-beta)*(wtm(0)-wtm(nls+1))                            &
            5349     1                        )/(z(0)-z(nls+1))-psoflw(jl)*FFN(-hw(0))
            5350     1                  ELSE
            5351     1               !  soil on top
            5352     1                    pgrndhflx_int(jl)=0.
            5353     1                    ! the flux below a soil layer of the infinity thickness is zero
            5354     1                  ENDIF
            5355                     !
            5356                     !    14.4 Calc cold content ccm (J/m2): the energy to melt snow + ice
            5357                     !         energy below liquid water at tmelt
            5358                     !
            5359                        pcc(jl)=pzsi(jl,0)*rhoh2o*( alf+csn*(tmelt-tsim(1)) )          &
            5360                          +pzsi(jl,1)*rhoh2o*( alf+cice*(tmelt-tsim(3)) )
            5361                     !
            5362                     !*   14.5 Calc net surface heat/fresh water flux into ocean
            5363                     !
            5364                     !!!     pfluxiw_int: net surface heat flux into ocean (W/m2, + downward)
            5365                     !!!     pfluxiw_int(jl)=-pfluxi2-pfluxw2+(cc-ccm)/zdtime
            5366                     !
            5367                     !    pfluxiw_int: net surface heat flux from ocean (W/m2, + upward)
            5368                     !    ppme2_int: net fresh water into ocean (m/s, + downward)
            5369                          pfluxiw_int(jl)=pfluxi2+pfluxw2-(pcc(jl)-ccm)/zdtime
            5370                     
            5371                     !!!     IF (pzsi(jl,1) .GT. 0.) THEN
            5372                     !!!       pfluxiw_int(jl)=-pfluxi2-pfluxw2+(cc-ccm)/zdtime
            5373                     !!!!!!       pfluxiw_int(jl)= rhowcw*hw(nls+1)*(pwt(jl,nls+1)-wtm(nls+1))/zdtime           &
            5374                     !!!!!!         +rhowcw*pwkh(jl,nls+2)*( beta*(pwt(jl,nls+1)-pwt(jl,nls+2))                  &
            5375                     !!!!!!            +(1.-beta)*(wtm(nls+1)-wtm(nls+2)) )/(z(nls+1)-z(nls+2))
            5376                     !!!!!!
            5377                     !!!!!!    Although the below Eq. is correcnt, it is numerically unstable. The above Eq is also correct.
            5378                     !!!!!!
            5379                     !!!!!!    pfluxiw_int(jl)= rhowcw*hew*(pwt(jl,0)-wtm(0))/zdtime          &
            5380                     !!!!!!      rhowcw*pwkh(jl,nls+1)*( beta*(pctfreez2(jl)-pwt(jl,nls+1))    &
            5381                     !!!!!!         +(1.-beta)*(wtm(0)-wtm(nls+1)) )/(z(0)-z(nls+1))
            5382                     !!!!!!
            5383                     !!!!!!    After second thought, the above Eq. is correct
            5384                     !!!!!!
            5385                     !!!!!!    the above Eq. is used for freeze/melt seaice
            5386                     !!!!!!     Since wt(jl,0) is fixed at pctfreez2, pfluxiw_int(jl)=0.
            5387                     !!!!!!
            5388                     !!!!!!       pfluxiw_int(jl)=0.
            5389                     !!!!!!
            5390                     !!!     ELSE
            5391                     !!!       pfluxiw_int(jl)=-pfluxi2-pfluxw2
            5392                     !!!     ENDIF
            5393                     !!!     IF (abs(pfluxiw_int(jl)).GT.2000.)  CALL output("fluxw > 2000 W/m2. ",hesn,hew,heice,pfluxwm,wtm,wsm,tsim)
            5394                     !!!     ppme2_int(jl)=-zsf/wsm(nls+1)/zdtime
            5395                     !
            5396                     !*   pwlvl(jl)=pbathy(jl)+SUM(hw(nls+1:nle))
            5397                     !*   Total Fresh Water Inflow = (pwlvl(jl)-wlvlm)/zdtime
            5398                     !
            5399                     !!!     ppme2_int(jl)=(pbathy(jl)+SUM(hw(nls+1:nle))-wlvlm)/zdtime
            5400                     
            5401                     !
            5402                     !*   14.6 Calc the uppermost bulk layer properties for coupling with 3-D ocean
            5403                     !
            5404                     !
            5405     1                  IF (locn) THEN
            5406     1                    ! Not valid for lwaterlevel=.TRUE.
            5407     1                    lstfn=MIN(nls+nfnlvl-1,nle)  ! index of last fine level
            5408     1               !
            5409     1               !
            5410     1               !    14.7 Calc net subsurface flux
            5411     1               !
            5412     1               !     pwsubflux_int: subsurface heat flux (W/m2, + upward)
            5413     1               !     pwsubsal_int: subsurface salinity flux (m*PSU/s, + upward)
            5414     1               !
            5415     1                    pwsubflux_int(jl)=-rhowcw*pwkh(jl,lstfn+1)*           &
            5416     1                        (  beta*(pwt(jl,lstfn)-pwt(jl,lstfn+1))      &
            5417     1                          +(1.-beta)*(wtm(lstfn)-wtm(lstfn+1))    &
            5418     1                          )/(z(lstfn)-z(lstfn+1))                    &
            5419     1                        -psoflw(jl)*FFN(zlk(nls+lstfn+1)-pwlvl(jl))
            5420     1                    pwsubsal_int(jl)=-pwkh(jl,lstfn+1)*                  &    ! unit:
            5421     1                        ( beta*(pws(jl,lstfn)-pws(jl,lstfn+1))       &
            5422     1                          +(1.-beta)*(wsm(lstfn)-wsm(lstfn+1))    &
            5423     1                          )/(z(lstfn)-z(lstfn+1))
            5424     1                  ENDIF
            5425                       END SUBROUTINE calc_flux
            5426                       !----------------------------------------------------------
            5427                       SUBROUTINE eddy(hcoolskin,utauw,wtkem,wtm,wsm)
            5428                       ! ----------------------------------------------------------------------
            5429                        real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wsm
            5430                        real, DIMENSION(0:lkvl+1), INTENT(in):: wtkem
            5431                        real, INTENT(out):: utauw,hcoolskin
            5432                        real:: XLD    ! downward mixing length   (m)
            5433                        real:: XLU    ! upward mixing length (m)
            5434                        real:: TKESTR ! =TKE*rho/G in (rho*z) (m2/s2*kg/m3/(m/s2))=(kg/m3*m)
            5435                        real:: POT    ! rho*z (potential energy difference) (kg/m3 *m)
            5436                        real:: wse,wte,RHOE   ! salinity, potential temp, density at TKE level (kg/m3)
            5437                        real:: dz     ! distance between two density levels/thickness for freeze (m)
            5438                        INTEGER  :: kk, jk
            5439                     
            5440     1                  IF (.NOT.lsoil) THEN
            5441     1                  !
            5442     1                  !   1.0 calc friction velocity of water side and thickness of cool skin (hcoolskin)
            5443     1                  !           = lamda * nu / uf
            5444     2                    IF(GDCHK2) THEN
            5445     2                      print *,"before frictionvelocity, taucx=",taucx(jl) &
            5446     2                             ,",taucx=",taucx(jl)
            5447     2                    ENDIF
            5448     1    i               utauw=frictionvelocity(taucx(jl),taucy(jl))
            5449     2                    IF (lcool_skin) THEN
            5450     2                      hcoolskin=cool_skin(pwind10w(jl),utauw)
            5451     2                    ELSE
            5452     2                      hcoolskin=0.
            5453     2                    ENDIF
            5454     2                    IF(GDCHK2) THEN
            5455     2                      print *,"after frictionvelocity, utauw=",utauw
            5456     2                    ENDIF
            5457     1                  !
            5458     1                  !   2.0 For the skin layer and the missing layers
            5459     1                  !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.31, ITR: 48, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            5460     1  pp   2v           pwldisp(jl,0:nls)=xldispmin
            5461     1   p   2v           pwlmx(jl,0:nls)=xlkmin
            5462     1   p   2v           pwkm(jl,0:nls)=xkmmin
            5463     1   p   2v           pwkh(jl,0:nls)=xkhmin
            5464     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtm, z, rhom
                                   <<< Loop-information  End >>>
            5465     2   s   2s           DO jk=0,nle+1
            5466     2               !!!      rhom(jk)=rhofn2(wtm(jk),wsm(jk),pwlvl(jl)-z(jk))
            5467     2               !!!       rhom(jk)=rho_from_theta(wsm(jk),wtm(jk)-tmelt,0.)
            5468     2   m   2m             rhom(jk)=rho_from_theta(wsm(jk),wtm(jk)-tmelt,pwlvl(jl)-z(jk))
            5469     2                      ! potential water density of one level higher (denoted as "h") at level jk
            5470     2   p   2v             IF (jk.GE.1) rhomh(jk)=rho_from_theta(wsm(jk-1),wtm(jk-1)-tmelt,pwlvl(jl)-z(jk))
            5471     3   p   2v             IF(GDCHK2) THEN
            5472     3       2                print *,"jk=",jk,",rhom=",rhom(jk),",rhomh=",rhomh(jk)
            5473     3   p   2v             ENDIF
            5474     2   p   2v           ENDDO
            5475     1                  !
            5476     1                  !   3.0 For layere nls+1 to nle+1
            5477     1                  !
            5478     2                    DO jk=nls+1,nle+1,1
            5479     2                      TKESTR         = wtkem(jk)*rhoh2o/G
            5480     2               !      density at TKE level
            5481     3                      IF (jk.EQ.(nls+1)) THEN
            5482     3                        wse     = (wsm(0)+wsm(jk))*.5
            5483     3                        wte     = (wtm(0)+wtm(jk))*.5
            5484     3                      ELSE
            5485     3                        wse     = (wsm(jk-1)+wsm(jk))*.5
            5486     3                        wte     = (wtm(jk-1)+wtm(jk))*.5
            5487     3                      ENDIF
            5488     3                      IF (GDCHK2) THEN
            5489     3                        print *,"jk=",jk,",TKESTR=",TKESTR,",wtkem=",wtkem(jk)
            5490     3                        print *,"rhoh2o=",rhoh2o,",G=",G,",wse=",wse,",wte=",wte
            5491     3                      ENDIF
            5492     2               !       Calc LD
            5493     2                      XLD        = 0.
            5494     2                      POT        = 0.
            5495     2                      kk         = jk
            5496     3                      DO WHILE ((POT.LT.TKESTR).AND.(kk.LE.nle+1))
            5497     4                       IF ((kk.LE.nls).AND.(kk.NE.0)) THEN
            5498     4               !         Do nothing & skip the layer!
            5499     4                         kk=kk+1
            5500     4                       ELSE
            5501     5                         IF (kk.EQ.nle+1) THEN
            5502     5                           dz=zlk(kk)-z(nle+1)     ! +, always
            5503     5                         ELSE
            5504     5                           dz=zlk(kk)-zlk(kk+1)    ! +, always
            5505     5                         ENDIF
            5506     4                         RHOE=rho_from_theta(wse,wte-tmelt,pwlvl(jl)-z(kk))
            5507     4                         XLD=XLD+dz
            5508     4                         POT=POT+dz*(rhom(kk)-RHOE)  ! increase along the depth
            5509     4                         kk=kk+1
            5510     4                       ENDIF
            5511     4                       IF(GDCHK2) THEN
            5512     4                         print *,"kk-1=",kk-1,",RHOE=",RHOE,",XLD=",XLD,",POT=",POT
            5513     4                       ENDIF
            5514     3                      ENDDO
            5515     3                      IF (POT.GT.TKESTR) THEN
            5516     3                      !! restore back slightlty
            5517     4                        IF(kk.EQ.0) THEN
            5518     4                          XLD  = MAX(XLD-(POT-TKESTR)/&
            5519     4               &            (rhom(0)-RHOE),tol)
            5520     4                        ELSE
            5521     4                          XLD  = MAX(XLD-(POT-TKESTR)/&
            5522     4               &            (rhom(kk-1)-RHOE),tol)
            5523     4                          IF(GDCHK2) print *,"1: XLD=",XLD
            5524     4                        ENDIF
            5525     3                      ELSE
            5526     3                        XLD  = MAX(XLD,tol)
            5527     3                        IF(GDCHK2) print *,"2: XLD=",XLD
            5528     3                      ENDIF
            5529     2                      IF(GDCHK2) print *,"3: XLD=",XLD
            5530     2               !
            5531     2                      ! add zero-dosplacement for reaching the bottom
            5532     2                      XLD  = MAX(XLD,d0)
            5533     2               !
            5534     2               !      Calc LU
            5535     2                      XLU        = 0.
            5536     2                      POT        = 0.
            5537     2                      kk         = jk
            5538     3                      DO WHILE ((POT.LT.TKESTR).AND.(kk.GE.nls+1))
            5539     4                        IF ((kk.LE.nls).AND.(kk.NE.0)) THEN
            5540     4               !          Do nothing & skip the layer!
            5541     4                          kk=kk-1
            5542     4                        ELSE
            5543     4                          RHOE=rho_from_theta(wse,wte-tmelt,pwlvl(jl)-z(kk-1))
            5544     4                          dz=zlk(kk-1)-zlk(kk)
            5545     4               !           dz=zlk(kk)-zlk(kk+1)
            5546     4                          XLU=XLU+dz
            5547     4                          POT=POT+dz*(RHOE-rhom(kk-1))
            5548     4                          kk=kk-1
            5549     4                        ENDIF
            5550     4                       IF(GDCHK2) THEN
            5551     4                         print *,"kk+1=",kk+1,",RHOE=",RHOE,",XLU=",XLU,",POT=",POT
            5552     4                       ENDIF
            5553     3                      ENDDO
            5554     3                      IF (POT.GT.TKESTR) THEN
            5555     3                      !! restore back slightlty
            5556     3                        XLU  = MAX(XLU-(POT-TKESTR)/&
            5557     3               &            (RHOE-rhom(kk+1)),tol)
            5558     3                        IF(GDCHK2) print *,"1: XLU=",XLU
            5559     3                      ELSE
            5560     3                        XLU  = MAX(XLU,tol)
            5561     3                        IF(GDCHK2) print *,"2: XLU=",XLU
            5562     3                      ENDIF
            5563     2                      IF(GDCHK2) print *,"3: XLU=",XLU
            5564     2                      ! add zero-dosplacement for reaching the top
            5565     2                      XLU  = MAX(XLU,d0)    ! add zero-dosplacement
            5566     2                      pwldisp(jl,jk)  = MAX(SQRT(XLD*XLU),xldispmin)        ! v.76, v76p
            5567     2                      pwlmx(jl,jk)    = MIN(XLD,XLU)
            5568     2               !      pwlmx(jl,jk)    = 2./(1./XLD+1./XLU)
            5569     2                     pwlmx(jl,jk)    = MAX(pwlmx(jl,jk),xlkmin)            !v.76p
            5570     2               !
            5571     2               !      4.0 Calc Momentum Diffusivity
            5572     2               !
            5573     2               !      Assunimg no skin layer for momentm since wind shear can enforce on the side. Note that the surface heat flux is from the top. (2011/8/29 bjt)
            5574     2               !!!       pwkm(jl,jk) = MIN(ck*pwlmx(jl,jk)*SQRT(wtkem(jk)),0.1_dp)*Prw+xkmmin                 !v9.7 or v.77
            5575     2               !!!       pwkm(jl,jk) = ck*pwlmx(jl,jk)*SQRT(wtkem(jk))*Prw+xkmmin                             !v9.8: bjt, 2013/5/2, crash
            5576     2                      pwkm(jl,jk) = MIN(ck*pwlmx(jl,jk)*SQRT(wtkem(jk)),100.)             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5577     2               !!!       IF ( (z(0)-zlk(jk)).LE. (2.*hcoolskin) ) THEN                       ! v.91, 2004.10.18, (pwu, 1971)
            5578     2               !!!         ! momentum within viscous layer(1mm)
            5579     2               !!!         pwkm(jl,jk)  = xkmmin
            5580     2               !!!       ELSE
            5581     2               !!!         pwkm(jl,jk) = MIN(ck*pwlmx(jl,jk)*SQRT(wtkem(jk)),0.1_dp)*Prw+xkmmin                 ! v.77
            5582     2               !!!       ENDIF
            5583     2               !!       PRINT *,"pwlmx=",pwlmx(jl,jk),"TKE=",wtkem(jk),"pwkm=",pwkm(jl,jk)
            5584     2               !      A maximum value of 10 m2/s is imposed on KM to prevent
            5585     2               !      numerical error.
            5586     2               !      1.4e-6 is the molecular momentum diffusivity of water
            5587     2               !       (Pond & Pickard, 1983).
            5588     2               !      1.34e-6 is the molecular momentum diffusivity of water (Chia and pwu, 1998; Mellor and Durbin, 1975)
            5589     2               !      1.34e-7 is the molecular heat diffusivity of water (Chia and pwu, 1998; Mellor and Durbin, 1975)
            5590     2               !
            5591     2               !      5.0 Calc Heat Diffusivity
            5592     2               !
            5593     3                      IF ( (z(0)-zlk(jk)).LT.hcoolskin) THEN                              !v.77
            5594     3                        ! heat within conduction sublayer (0.4mm)
            5595     3                        pwkh(jl,jk)   = xkhmin
            5596     3                      ELSE
            5597     4                        IF (.TRUE.) THEN
            5598     4                        !! KE due to molecular diffusion has been considered in TKESTR
            5599     4               !ps           pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)                             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5600     5                          IF( (z(0)-zlk(jk)).LE. mixing_depth) THEN
            5601     5                            pwkh(jl,jk)   = MIN(MAX(pwkm(jl,jk)/Prw,xkhmin),100.)                             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5602     5                          ELSE
            5603     5                            pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)
            5604     5                          ENDIF
            5605     4                        ELSEIF ( (z(0)-zlk(jk)).LE.10.) THEN                              !v.77
            5606     4                        ! heat within conduction sublayer (0.4mm)
            5607     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)+xkhmin                      ! otherwise it will crash
            5608     4                        ELSEIF (.TRUE.) THEN
            5609     4                        !! KE due to molecular diffusion has been considered in TKESTR
            5610     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)                             !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5611     4                        ELSEIF (.TRUE.) THEN
            5612     5                          IF (jk.GE.nle) THEN
            5613     5                            pwkh(jl,jk)   = pwkm(jl,jk)/Prw                                        !v9.8994: last 2 levels remain the same
            5614     5                          ELSE
            5615     5                            pwkh(jl,jk)   = SQRT(pwkm(jl,jk)*pwkm(jl,jk+1))/Prw                    !v9.8994: Artifically using diffusivity one-level below (usually very small)
            5616     5                                                                                                       !         (or geometric mean) to preventing heat cross thermocline
            5617     5                          ENDIF
            5618     4                        ELSEIF (.TRUE.) THEN                                                           !v9.83 (MINOR=3), bjt, 20130824
            5619     5                          IF (jk.EQ.nle+1) THEN
            5620     5                            pwkh(jl,jk)   = pwkm(jl,jk)/Prw+xkhmin                                 !v9.8994: last level remain the same
            5621     5                          ELSE
            5622     5                            pwkh(jl,jk)   = SQRT(pwkm(jl,jk)*pwkm(jl,jk+1))/Prw+xkhmin             !v9.8994: Artifically using diffusivity one-level below (usually very small)
            5623     5                                                                                                       !         (or geometric mean) to preventing heat cross thermocline
            5624     5                          ENDIF
            5625     4                        ELSEIF (.TRUE.) THEN                                                               !v9.83, v9.98998 (MINOR=3), bjt, 20130824
            5626     4                          pwkh(jl,jk)   = pwkm(jl,jk)/Prw+xkhmin                                   !v9.8: bjt, 2013/5/2, crash
            5627     4                        ELSEIF (.TRUE.) THEN                                                           !v9.83 (MINOR=3), bjt, 20130824
            5628     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)+xkhmin                       !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5629     4                        ELSEIF (lv81) THEN
            5630     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,0.1)+xkhmin                       !v9.7 or v.77
            5631     4                        ELSE
            5632     4                          pwkh(jl,jk)   = MIN(pwkm(jl,jk)/Prw,100.)+xkhmin                       !v9.8: Note that Lee JCL, 2001 set maximum pwkh to be 100 m^2/s
            5633     4                        ENDIF
            5634     3                      ENDIF
            5635     2                    END DO
            5636     1                  ENDIF
            5637                       END SUBROUTINE eddy
            5638                       ! **********************************************************************
            5639                       SUBROUTINE REGRID(  pbathy,     pctfreez2,  pwlvl,                      &
            5640                                           pzsi,       psilw,      ptsnic,                     &
            5641                                           pwt,        pwu,        pwv,                        &
            5642                                           pws,     pwtke,      pwlmx,                      &
            5643                                           pwldisp,    pwkm,       pwkh)
            5644                       ! ----------------------------------------------------------------------
            5645                     !!!    USE mo_sst,            ONLY: csn,rhosn,xksn,cice,rhoice,xkice,xkw,                   &
            5646                     !!!                                 omegas,wcri,tol,wlvlref,dpthmx
            5647                         IMPLICIT NONE
            5648                         real, INTENT(in):: pbathy(kbdim),   pctfreez2(kbdim)
            5649                       ! 3-d SIT vars: water column
            5650                         real, INTENT(in out) :: pwlvl(kbdim),                                   &
            5651                              pzsi(kbdim,0:1),   psilw(kbdim,0:1), ptsnic(kbdim,0:3),                &
            5652                              pwt(kbdim,0:lkvl+1), pwu(kbdim,0:lkvl+1), pwv(kbdim,0:lkvl+1),         &
            5653                              pws(kbdim,0:lkvl+1), pwtke(kbdim,0:lkvl+1), pwlmx(kbdim,0:lkvl+1),  &
            5654                              pwldisp(kbdim,0:lkvl+1), pwkm(kbdim,0:lkvl+1), pwkh(kbdim,0:lkvl+1)
            5655                     
            5656                       END SUBROUTINE REGRID
            5657                       ! ----------------------------------------------------------------------
            5658                       real FUNCTION frictionvelocity(taucx,taucy)
            5659                         !  taucx    : u-stress (Pa) over water                              I
            5660                         !  taucy    : v-stress (Pa) over water                              I
            5661                         !  frictionvelocity: friction velocity of water side (m/s)          O
            5662                         !   Tau/rho=N/m^2/(kg/m3)=(kg*m/s^2/m^2)/(kg/m3)=m^2/s^2
            5663                         !   frictionvelocity=sqrt(abs(taucx/rhoh2o)+abs(taucy/rhoh2o))
            5664                         !   or, frictionvelocity=sqrt((ustrw**2 + vstrw**2))
            5665                         !
            5666                         IMPLICIT NONE
            5667                         real, INTENT(in):: taucx,taucy
            5668                         frictionvelocity=sqrt(abs(taucx/rhoh2o)+abs(taucy/rhoh2o))
            5669     1                   IF(GDCHK2) THEN
            5670     1                    print *,"taucx=",taucx,",taucy=",taucy,",rhoh2o=",rhoh2o
            5671     1                   ENDIF
            5672                       END FUNCTION frictionvelocity
            5673                       ! ----------------------------------------------------------------------
            5674                       real FUNCTION cool_skin(wind10w,utauw)
            5675                         ! Description:
            5676                         !
            5677                         ! Calculates the thickness of cool skin by Saunders (1967) and Artale (2002)
            5678                         !
            5679                         !  wind10w  : 10m wind speed (m/s) over water                I
            5680                         !  utauw    : friction velocity of water side (m/s)          I
            5681                         !  cool_skin: thickness of cool skin (m)                     O
            5682                         !
            5683                         ! Method:
            5684                         !
            5685                         !   A. Gamma
            5686                         !      = 0.2u + 0.5  ; u <= 7.5m/s
            5687                         !      = 1.6u - 10   ; 7.5m/s < u < 10m/s
            5688                         !      = 6           ; 10 <= u
            5689                         !   Where u is the 10m wind speed
            5690                         !
            5691                         !   B. lamda
            5692                         !       = ( uf * k * C )/(gamma * rhoh2o * cw * h * nu )
            5693                         !
            5694                         !  Where ( for sea water of 20 degree Celsius at salinity 35 [g/kg] )
            5695                         !     uf = frictionl velocity of water (or stress)
            5696                         !     k = thermal conductivity = 0.596 [W/m K]
            5697                         !     C = 86400 s in a day
            5698                         !     rhoh2o = density of water = 1024.75 [kg/m**3]
            5699                         !     cw = specific heat of water = 3993  [kj/kg]
            5700                         !     h = reference depth = 10m
            5701                         !     nu = kinematic viscosity = 1.05*10**-6 [m**2/s]
            5702                         !
            5703                         !   C. hcoolskin  (Cool skin thickness)
            5704                         !       = lamda * nu / uf
            5705                         !
            5706                         !   D. Temperature difference across cool skin
            5707                         !       = Qn * hcoolskin / k
            5708                         !   Where
            5709                         !       Qn = net surface heat flux [W/m**2]
            5710                         !
            5711                         ! *skinsst* is called from *physc*.
            5712                         !
            5713                         ! Authors:
            5714                         !
            5715                         ! N. Keenlyside & Chia-Ying Tu, IFM-GEOMAR, June 2006, original source
            5716                     
            5717                         IMPLICIT NONE
            5718                         real, INTENT(in):: wind10w,utauw
            5719                     
            5720                         ! Local Physical Parameters
            5721                         real, PARAMETER:: k = 0.596      ! thermal conductivity  [W/m K]
            5722                         INTEGER, PARAMETER  :: C = 86400      ! s in a day
            5723                       !!!  real, PARAMETER:: rhoh2o = 1024.75 ! density of water [kg/m**3]
            5724                       !!!  real, PARAMETER:: cw = 3993      ! specific heat of water [kj/kg]
            5725                         real, PARAMETER:: refh = 10
            5726                         ! reference depth [m] in Artale's formula of lamda_d (Artale, 2002)
            5727                         real, PARAMETER:: nu = 1.05E-6   ! kinematic viscosity of water [m**2/s]
            5728                       !  real:: Qb                       !CYTu, v91
            5729                       !  real:: gamma            !CYTu, v91
            5730                       !  real:: lamda_d          ! nodimensional constant in determing cool skin depth (Sauners, 1967)
            5731                       !                                                       ! lamda_d = 5.8 (Jin sitwu, 1971)
            5732                       !  real:: lamda_h
            5733                       !  real:: nuw !/1.14E-6/           ! kinematic viscosity of seawater (m2 s-1) (Pauson and Simpson, 1981)
            5734                       !
            5735                         INTEGER, PARAMETER::  lsaunders=1     ! Artale et al.,2002 scheme
            5736                     
            5737                         ! Local variables
            5738                         real:: gamma, lamda, frictionvelocity, Qnet, Tdiff
            5739                         !
            5740                         !   A. Gamma
            5741                         !      = 0.2u + 0.5  ; u <= 7.5m/s
            5742                         !      = 1.6u - 10   ; 7.5m/s < u < 10m/s
            5743                         !      = 6           ; 10 <= u
            5744                         !   Where u is the 10m wind speed
            5745     1                   IF (lsaunders .EQ. 1) THEN !   Saunders Constant (Artale et al.,2002)
            5746     2                      IF ( wind10w <= 7.5 ) THEN
            5747     2                         gamma = 0.2 * wind10w  + 0.5
            5748     2                      ELSEIF (( 7.5 < wind10w).and.(wind10w < 10 )) THEN
            5749     2                         gamma = 1.6 * wind10w - 10
            5750     2                      ELSE
            5751     2                         gamma=6
            5752     2                      ENDIF
            5753     1                 !   B. lamda
            5754     1                 !           =( uf * k * C )/(gamma * rhoh2o * cw * h * nu )
            5755     1                 !                tauc/rhoh2o
            5756     1                      lamda=(utauw*0.596*86400)/(gamma*rhoh2o*clw*refh*nu)
            5757     1                 !
            5758     1                 !!!!      wsstrw=wsstra*SQRT(1.26/1020.)        ! density ratio of air/seawater (Paulson and Simpson, 1981)
            5759     1                   ELSE IF (lsaunders .EQ. 2)THEN !      Saunders Constant (pwu,1971)
            5760     1                      lamda=5.8
            5761     1                   ELSE IF (lsaunders .EQ. 3)THEN !      Saunders Constant (Paulson and Simpson,1981)
            5762     1                      lamda=6.5
            5763     1                   ELSE IF (lsaunders .EQ. 4)THEN !      Saunders Constant (pwu,1985)
            5764     2                      IF (wind10w.LE.7.)THEN
            5765     2                         lamda=2.+5.*wind10w/7.
            5766     2                      ELSE
            5767     2                         lamda=7.
            5768     2                      ENDIF
            5769     1                 !  ELSE IF (lsaunders .EQ. 5)THEN !     Saunders Constant (Fairall,1996)
            5770     1                 !     Qb=(-Rld+LE+H+Rlu)+((0.026*4.19E-3)/(alv*3.E-4))*H
            5771     1                 !     lamda=6.*(1.+((Qb*16.*g*3.E-4*rhowcw*(nuw**3.))/((wsstrw**4.)*(0.59**2.)))**(3./4.))**(-1./3.)
            5772     1                   ENDIF
            5773                       !
            5774                       ! Thickness of Thermal Sublayer (Saunders, 1967)
            5775                       !
            5776                       !   C. hcoolskin  (Cool skin thickness)
            5777                       !           = lamda * nu / uf
            5778                         cool_skin=lamda*nu/utauw
            5779                       !  !   D. Temperature difference across cool skin
            5780                       !  !           = Qn * hcoolskin / k
            5781                       !  Tdiff=-pfluxw2*hcoolskin/0.596
            5782                       !  !
            5783                       !  ptsw(jl)=pobswtb(jl)+Tdiff
            5784                         RETURN
            5785                       END FUNCTION cool_skin
            5786                       ! **********************************************************************
            5787                       SUBROUTINE LKDIFKH(hew,X,Y)
            5788                       !
            5789                       ! Calculate X, Y coefficient matrix for tmeperature and salinity with kh
            5790                       !
            5791                       ! Output: X,Y,hew
            5792                       !
            5793                       !*    0. Locate Space
            5794                       !
            5795                         IMPLICIT NONE
            5796                       !
            5797                         real, INTENT(out):: hew    ! effective skin thickness of water (m)
            5798                         real, DIMENSION(0:lkvl+5), INTENT(out):: X,Y
            5799                     
            5800                         INTEGER :: jk,levelm,level,levelp
            5801                     
            5802                       ! For the skin layer
            5803                     
            5804                         xkhskin=SQRT(pwkh(jl,0)*pwkh(jl,nls+1))         ! calc the heat diffusivity for skin layer
            5805          i              hew=HEFN(hw(0),xkhskin,omegas)
            5806                       !
            5807                       ! For skin layer, middle layers and bottom soil layers
            5808                       !
            5809     1   s    s          DO jk=0,nle+1-nls
            5810     1   p    v            levelm=nls+jk-1
            5811     1   p    s            IF (levelm.EQ.nls) levelm=0
            5812     1   p    v            level=nls+jk
            5813     1   p    s            IF (level.EQ.nls) level=0
            5814     1   p    v            levelp=nls+jk+1
            5815     1               
            5816     2   p    s            IF (level.EQ.0) THEN
            5817     2                     !! Skin layer
            5818     2   p    s              X(4+jk)=0.
            5819     2   m    s              Y(4) = zdtime/hew*pwkh(jl,levelp)/(z(level)-z(levelp))
            5820     2   p    s            ELSE IF (level.EQ.nle+1) THEN
            5821     2                     !! Soil layer
            5822     2   p    s              X(4+jk)= zdtime/(rhogcg*SQRT(xkg/omegas))*  &
            5823     2                         rhoh2o*clw*pwkh(jl,level)/(z(levelm)-z(level))
            5824     2   m    m              Y(4+jk)=0.
            5825     2   p    s            ELSE
            5826     2                     !! Middle water layers
            5827     2   p    s              X(4+jk)= zdtime/hw(level)*pwkh(jl,level)/(z(levelm)-z(level))
            5828     2   m    s              Y(4+jk)= zdtime/hw(level)*pwkh(jl,levelp)/(z(level)-z(levelp))
            5829     2   p    v            ENDIF
            5830     1   p    v          ENDDO
            5831                       END SUBROUTINE LKDIFKH
            5832                       ! ----------------------------------------------------------------------
            5833                       SUBROUTINE LKDIFKM(hew,X,Y)
            5834                       !
            5835                       ! Calculate X, Y coefficient (dimensionless) matrix for TKE with Km
            5836                       !
            5837                       ! Output: X,Y,hew
            5838                       !
            5839                       !*    0. Locate Space
            5840                       !
            5841                         IMPLICIT NONE
            5842                         real, INTENT(out):: hew    ! effective skin thickness of water (m)
            5843                         real, DIMENSION(0:lkvl+5), INTENT(out):: X,Y
            5844                       !
            5845                         INTEGER :: jk,levelm,level,levelp
            5846                         real:: xkmskin   ! skin layer momentum diffusivity (m2/s)
            5847                     
            5848                       ! For the skin layer
            5849                     
            5850                         xkmskin=SQRT(xkmmin*pwkm(jl,0))         ! calc the momentum diffusivity for skin layer
            5851          i              hew=HEFN(hw(0),xkmskin,omegas)
            5852                       !
            5853                       ! For skin layer, middle layers and bottom soil layers
            5854                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      z
                                   <<< Loop-information  End >>>
            5855     1   s    s          DO jk=0,nle-nls
            5856     1   p    v            levelm=nls+jk-1
            5857     1   p    s            IF (levelm.EQ.nls) levelm=0
            5858     1   p    v            level=nls+jk
            5859     1   p    s            IF (level.EQ.nls) level=0
            5860     1   p    v            levelp=nls+jk+1
            5861     1               
            5862     2   p    s            IF (level.EQ.0) THEN
            5863     2                     !! Skin layer
            5864     2   p    s              X(4+jk)=0.
            5865     2   m    s              Y(4) = zdtime/hew*pwkm(jl,levelp)/(z(level)-z(levelp))
            5866     2   p    s            ELSE
            5867     2                     !! Middle water layers
            5868     2   p    s              X(4+jk)= zdtime/hw(level)*pwkm(jl,level)/(z(levelm)-z(level))
            5869     2   m    s              Y(4+jk)= zdtime/hw(level)*pwkm(jl,levelp)/(z(level)-z(levelp))
            5870     2   p    v            ENDIF
            5871     1   p    v          ENDDO
            5872                       END SUBROUTINE LKDIFKM
            5873                       ! ----------------------------------------------------------------------
            5874                       SUBROUTINE LU(mas,mae,AA,RHS,SOL)
            5875                       ! ----------------------------------------------------------------------
            5876                       !  AA : MATRIX OF COEFFICIENTS A  (MN,kk,3)           I
            5877                       !       1ST COLUMN = ELEMENTS LEFT TO THE DIAGONAL,
            5878                       !       2ND COLUMN = DIAGONAL ELEMENTS,
            5879                       !       3RD COLUMN = ELEMENTS RIGHT TO THE DIAGONAL,
            5880                       !  RHS: RIGHT HAND SIDE OF THE MATRIX (FORCING)
            5881                       !  SOL: SOLUTION OF THE MATRIX
            5882                       !  WKK : WORKING ARRAY               (MN,kk,4)
            5883                       ! ----------------------------------------------------------------------
            5884                       !
            5885                     !!!    USE mo_kind
            5886                         IMPLICIT NONE
            5887                         real:: RHS(0:lkvl+5),AA(0:lkvl+5,3),SOL(0:lkvl+5)
            5888                         real:: WKK(0:lkvl+5,4)
            5889                         INTEGER jk,mas,mae
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.66, ITR: 48, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      RHS, AA, WKK
                                   <<< Loop-information  End >>>
            5890     1  pp    v          DO jk=mas,mae
            5891     1   p    v            WKK(jk,1)=DBLE(AA(jk,1))
            5892     1   p    v            WKK(jk,2)=DBLE(AA(jk,2))
            5893     1   p    v            WKK(jk,3)=DBLE(AA(jk,3))
            5894     1   p    v            WKK(jk,4)=DBLE(RHS(jk))
            5895     1   p    v          ENDDO
            5896                       !
            5897                       ! ----------------------------------------------------------------------
            5898                       !
            5899                       !*   SOLVE THE TRIDIAGONAL MXTRIX
            5900                       !
            5901                       !   [ 1  ]       [DR   ] [23  ]
            5902                       !   [ L1 ] * [ DR  ]=[123 ]
            5903                       !   [ L1 ]       [      DR ] [ 123]
            5904                       !-----------------------------------------------------------------
            5905                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.12, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5906     1   s   2s          DO jk = mas+1, mae
            5907     1   s   2s            WKK(jk,1) = WKK(jk,1) / WKK(jk-1,2)
            5908     1   s   2s            WKK(jk,2) = WKK(jk,2) - WKK(jk,1)*WKK(jk-1,3)
            5909     1   s   2s            WKK(jk,4) = WKK(jk,4) - WKK(jk,1)*WKK(jk-1,4)
            5910     1   s   2s          ENDDO
            5911                       !
            5912                       !     BACK SUBSTITUTION
            5913                       !
            5914                         WKK(mae,4) = WKK(mae,4) /WKK(mae,2)
            5915                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.16, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5916     1   s   2s          DO jk = mae-1, mas,-1
            5917     1   s   2s            WKK(jk,4) = (WKK(jk,4)-WKK(jk,3)*WKK(jk+1,4)) /WKK(jk,2)
            5918     1   s   2s          ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK, SOL
                                   <<< Loop-information  End >>>
            5919     1  pp   4v          DO jk=mas,mae
            5920     1   p   4v            SOL(jk)=REAL(WKK(jk,4))
            5921     1   p   4v          ENDDO
            5922                       END     SUBROUTINE LU
            5923                       ! ----------------------------------------------------------------------
            5924                       ! ----------------------------------------------------------------------
            5925                       SUBROUTINE LU2(mas,mae,AA,RHS,SOL)
            5926                       ! ----------------------------------------------------------------------
            5927                       !     same as LU, except for complex matrix
            5928                       ! ----------------------------------------------------------------------
            5929                       !
            5930                         IMPLICIT NONE
            5931                         INTEGER mas,mae
            5932                         COMPLEX :: RHS(0:lkvl+5),AA(0:lkvl+5,3),SOL(0:lkvl+5),WKK(0:lkvl+5,4)
            5933                         INTEGER jk
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.08, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      RHS, AA, WKK
                                   <<< Loop-information  End >>>
            5934     1  pp    v          DO jk=mas,mae
            5935     1   p    v                WKK(jk,1)=AA(jk,1)
            5936     1   p    v            WKK(jk,2)=AA(jk,2)
            5937     1   p    v            WKK(jk,3)=AA(jk,3)
            5938     1   p    v            WKK(jk,4)=RHS(jk)
            5939     1   p    v          ENDDO
            5940                       !
            5941                       !-----------------------------------------------------------------
            5942                       !*   SOLVE THE TRIDIAGONAL MXTRIX
            5943                       !
            5944                       !       [ 1      ]       [DR   ] [23  ]
            5945                       !    [ L1        ] * [ DR  ]=[123 ]
            5946                       !    [  L1 ]     [      DR ] [ 123]
            5947                       !-----------------------------------------------------------------
            5948                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5949     1   s    s          DO jk = mas+1, mae
            5950     1   m    s            WKK(jk,1) = WKK(jk,1) / WKK(jk-1,2)
            5951     1   m    s            WKK(jk,2) = WKK(jk,2) - WKK(jk,1)*WKK(jk-1,3)
            5952     1   m    s            WKK(jk,4) = WKK(jk,4) - WKK(jk,1)*WKK(jk-1,4)
            5953     1   p    s          ENDDO
            5954                       !
            5955                       !     BACK SUBSTITUTION
            5956                       !
            5957                           WKK(mae,4) = WKK(mae,4) /WKK(mae,2)
            5958                       !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK
                                   <<< Loop-information  End >>>
            5959     1   s   2s          DO jk = mae-1, mas,-1
            5960     1   m   2s            WKK(jk,4) = (WKK(jk,4)-WKK(jk,3)*WKK(jk+1,4)) /WKK(jk,2)
            5961     1   p   2s          ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      WKK, SOL
                                   <<< Loop-information  End >>>
            5962     1  pp   2v          DO jk=mas,mae
            5963     1   p   2v            SOL(jk)=WKK(jk,4)
            5964     1   p   2v          ENDDO
            5965                       END SUBROUTINE LU2
            5966                       ! ----------------------------------------------------------------------
            5967                       real FUNCTION levitus_t(tb,z)
            5968                       !  z=0. m at the surface (+ upward)
            5969                       !  tb: bulk sea temperature (K)
            5970                       !-----------------------------------------------------------------------
            5971                         IMPLICIT NONE
            5972                         real, INTENT(in)::  z, tb
            5973                         levitus_t   = tmelt+4+(tb-tmelt-4)*EXP(z/100.)  ! set initial profile to be expontential decay to tmelt+4 K
            5974                       END FUNCTION levitus_t
            5975                       ! ----------------------------------------------------------------------
            5976                       real FUNCTION levitus_s(obswsb,z)
            5977                       !  z=0. m at the surface (+ upward)
            5978                       !  obswsb: bulk sea salinity (PSU)
            5979                       !-----------------------------------------------------------------------
            5980                         IMPLICIT NONE
            5981                         real, INTENT(in)::  z, obswsb
            5982                         levitus_s   = obswsb
            5983                       END FUNCTION levitus_s
            5984                       ! ----------------------------------------------------------------------
            5985                       real FUNCTION FFN(z)
            5986                       !*** 2 components ***
            5987                       !*****************************************************************************
            5988                       ! CALC PENETRATION COEFFICIENT OF SOLAR RADIATION PAULSON AND SIMPSON 1977
            5989                       ! J. OF PHYSICAL OCEANOGRAPHY, VOL. 7, PP. 952- 956
            5990                       !*****************************************************************************
            5991                       ! CONSTANT (JERLOV's (1976) OPTICAL WATER TYPE I)
            5992                       !  z=0. M at the surface (+ upward)
            5993                       !-----------------------------------------------------------------------
            5994                       !  IMPLICIT NONE
            5995                       !  real:: z,R,D1,D2
            5996                       !  R    = 0.58
            5997                       !  D1   = 0.35
            5998                       !  D2   = 23.
            5999                       !  FFN   = R*EXP(+z/D1)+(1-R)*EXP(+z/D2)
            6000                       !END FUNCTION FFN
            6001                       !
            6002                       !*** 9 components ***
            6003                       !*****************************************************************************
            6004                       ! THE TEMPERATURE DIFFERENCE ACROSS COOL SKIN : PAULSON AND SIMPSON 1981
            6005                       ! J. OF GEOPHYSICAL RESEARCH, VOL. 86, PP. 11,044- 11,054
            6006                       !*****************************************************************************
            6007                       ! EVOLUTION OF COOL SKIN AND DIRECT SEA-AIR GAS TRANSFER COEFFICEINT DURING
            6008                       ! DAYTIME : SOLOVIEV AND SCHLUESSEL 1996
            6009                       ! BOUNDARY LAYER METEOROLOGY, VOL. 77, PP. 45- 68
            6010                       !*****************************************************************************
            6011                       ! SOLOVIEV AND SCHLUESSEL (1996) MODIFIED THE PAULSON AND SIMPSON (1981) EQUATION
            6012                       ! OF CLEAR WATER FRO VARIOUS TYPES OF WATER DEFINED BY JERLOV (1976)
            6013                       !*****************************************************************************
            6014                         IMPLICIT NONE
            6015                         real:: z ! depth (m), plus upward
            6016                         real:: F(9)      ! spectral distribution (ratio)
            6017                         real:: D(9)      ! absorption length (m)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6018         s    v          D(1:9)=(/34.795,2.27,3.15E-2,5.48E-3,8.32E-4,1.26E-4,3.13E-4,7.82E-5,1.44E-5/)
            6019         p    v          F(1:9)=(/0.237,0.36,0.179,0.087,0.08,0.0246,0.025,0.007,0.0004/)
            6020                     
            6021     1                   IF(wtype .EQ. 10)THEN
            6022     1                         D(1)    = 15.152                ! SOLOVIEV AND SCHLUESSEL (1996,type I)
            6023     1                   ELSE IF(wtype .EQ. 11)THEN
            6024     1                         D(1)    = 13.158                ! SOLOVIEV AND SCHLUESSEL (1996,type IA)
            6025     1                   ELSE IF(wtype .EQ. 12)THEN
            6026     1                         D(1)    = 11.364                ! SOLOVIEV AND SCHLUESSEL (1996,type IB)
            6027     1                   ELSE IF(wtype .EQ. 20)THEN
            6028     1                         D(1)    = 7.576                 ! SOLOVIEV AND SCHLUESSEL (1996,type II)
            6029     1                   ELSE IF(wtype .EQ. 30)THEN
            6030     1                         D(1)    = 2.618                 ! SOLOVIEV AND SCHLUESSEL (1996,type III)
            6031     1                   ELSE IF(wtype .EQ. 1)THEN
            6032     1                         D(1)    = 2.041                 ! SOLOVIEV AND SCHLUESSEL (1996,type 1)
            6033     1                   ELSE IF(wtype .EQ. 3)THEN
            6034     1                         D(1)    = 1.429                 ! SOLOVIEV AND SCHLUESSEL (1996,type 3)
            6035     1                   ELSE IF(wtype .EQ. 5)THEN
            6036     1                         D(1)    = 1.                   ! SOLOVIEV AND SCHLUESSEL (1996,type 5)
            6037     1                   ELSE IF(wtype .EQ. 7)THEN
            6038     1                         D(1)    = 0.917                 ! SOLOVIEV AND SCHLUESSEL (1996,type 7)
            6039     1                   ELSE IF(wtype .EQ. 9)THEN
            6040     1                         D(1)    = 0.625                 ! SOLOVIEV AND SCHLUESSEL (1996,type 9)
            6041     1                   ELSE
            6042     1                         D(1)    = 34.795                ! PAULSON AND SIMPSON (1981)
            6043     1                   ENDIF
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6044         s    v          FFN   = SUM(F*EXP(z/D))
            6045                       !  dFFN   = (F1/D1)+(F2/D2)+(F3/D3)+(F4/D4)+(F5/D5)+(F6/D6) &
            6046                       !                       +(F7/D7)+(F8/D8)+(F9/D9)
            6047                     
            6048                       END FUNCTION FFN
            6049                       ! ----------------------------------------------------------------------
            6050                       ! ----------------------------------------------------------------------
            6051                       real FUNCTION DFFN(z)
            6052                       !*** 2 components ***
            6053                       !*****************************************************************************
            6054                       ! CALC Derivative of PENETRATION COEFFICIENT OF SOLAR RADIATION PAULSON AND SIMPSON 1977
            6055                       ! J. OF PHYSICAL OCEANOGRAPHY, VOL. 7, PP. 952- 956
            6056                       !*****************************************************************************
            6057                       ! CONSTANT (JERLOV's (1976) OPTICAL WATER TYPE I)
            6058                       !  z=0. M at the surface (+ upward)
            6059                       !-----------------------------------------------------------------------
            6060                       !  IMPLICIT NONE
            6061                       !  real:: z,R,D1,D2
            6062                       !  R    = 0.58
            6063                       !  D1   = 0.35
            6064                       !  D2   = 23.
            6065                       !  FFN   = R*EXP(+z/D1)+(1-R)*EXP(+z/D2)
            6066                       !END FUNCTION FFN
            6067                       !
            6068                       !*** 9 components ***
            6069                       !*****************************************************************************
            6070                       ! THE TEMPERATURE DIFFERENCE ACROSS COOL SKIN : PAULSON AND SIMPSON 1981
            6071                       ! J. OF GEOPHYSICAL RESEARCH, VOL. 86, PP. 11,044- 11,054
            6072                       !*****************************************************************************
            6073                       ! EVOLUTION OF COOL SKIN AND DIRECT SEA-AIR GAS TRANSFER COEFFICEINT DURING
            6074                       ! DAYTIME : SOLOVIEV AND SCHLUESSEL 1996
            6075                       ! BOUNDARY LAYER METEOROLOGY, VOL. 77, PP. 45- 68
            6076                       !*****************************************************************************
            6077                       ! SOLOVIEV AND SCHLUESSEL (1996) MODIFIED THE PAULSON AND SIMPSON (1981) EQUATION
            6078                       ! OF CLEAR WATER FRO VARIOUS TYPES OF WATER DEFINED BY JERLOV (1976)
            6079                       !*****************************************************************************
            6080                         IMPLICIT NONE
            6081                         real:: z ! depth (m), plus upward
            6082                         real:: F(9)      ! spectral distribution (ratio)
            6083                         real:: D(9)      ! absorption length (m)
            6084                         D(1:9)=(/34.795,2.27,3.15E-2,5.48E-3,8.32E-4,1.26E-4,3.13E-4,7.82E-5,1.44E-5/)
            6085                         F(1:9)=(/0.237,0.36,0.179,0.087,0.08,0.0246,0.025,0.007,0.0004/)
            6086                     
            6087     1                   IF(wtype .EQ. 10)THEN
            6088     1                         D(1)    = 15.152                ! SOLOVIEV AND SCHLUESSEL (1996,type I)
            6089     1                   ELSE IF(wtype .EQ. 11)THEN
            6090     1                         D(1)    = 13.158                ! SOLOVIEV AND SCHLUESSEL (1996,type IA)
            6091     1                   ELSE IF(wtype .EQ. 12)THEN
            6092     1                         D(1)    = 11.364                ! SOLOVIEV AND SCHLUESSEL (1996,type IB)
            6093     1                   ELSE IF(wtype .EQ. 20)THEN
            6094     1                         D(1)    = 7.576                 ! SOLOVIEV AND SCHLUESSEL (1996,type II)
            6095     1                   ELSE IF(wtype .EQ. 30)THEN
            6096     1                         D(1)    = 2.618                 ! SOLOVIEV AND SCHLUESSEL (1996,type III)
            6097     1                   ELSE IF(wtype .EQ. 1)THEN
            6098     1                         D(1)    = 2.041                 ! SOLOVIEV AND SCHLUESSEL (1996,type 1)
            6099     1                   ELSE IF(wtype .EQ. 3)THEN
            6100     1                         D(1)    = 1.429                 ! SOLOVIEV AND SCHLUESSEL (1996,type 3)
            6101     1                   ELSE IF(wtype .EQ. 5)THEN
            6102     1                         D(1)    = 1.                   ! SOLOVIEV AND SCHLUESSEL (1996,type 5)
            6103     1                   ELSE IF(wtype .EQ. 7)THEN
            6104     1                         D(1)    = 0.917                 ! SOLOVIEV AND SCHLUESSEL (1996,type 7)
            6105     1                   ELSE IF(wtype .EQ. 9)THEN
            6106     1                         D(1)    = 0.625                 ! SOLOVIEV AND SCHLUESSEL (1996,type 9)
            6107     1                   ELSE
            6108     1                         D(1)    = 34.795                ! PAULSON AND SIMPSON (1981)
            6109     1                   ENDIF
            6110                         DFFN=SUM(F/D*EXP(z/D))
            6111                       !  DFFN   = (F1/D1)+(F2/D2)+(F3/D3)+(F4/D4)+(F5/D5)+(F6/D6) &
            6112                       !                       +(F7/D7)+(F8/D8)+(F9/D9)
            6113                     
            6114                       END FUNCTION DFFN
            6115                       !!! bjt >> too cold
            6116                       !!!  real, PARAMETER:: csiced=0.8     ! threshold sea ice depth, (= 0.8 m)
            6117                       !!!                                           ! seaice[siced]=1-Exp[-siced/csiced]
            6118                       !!!                                           ! seaice[2.]=0.91795
            6119                       !!! 1)
            6120                       !!!    ! Assuming sea ice fraction increases with siced
            6121                       !!!    ! sea ice fraction = 100% if siced > csiced (=1 m)
            6122                       !!!    ! Otherwise increase linearly with siced/csiced
            6123                       !!!    IF (pzsi(jl,1) .GT. csiced) THEN
            6124                       !!!      pseaice(jl)=1.
            6125                       !!!    ELSE
            6126                       !!!      pseaice(jl)=psiced(jl)/csiced
            6127                       !!!    ENDIF
            6128                       !!! 2)
            6129                       !!!    pseaice(jl)=1.-EXP(-psiced(jl)/csiced)
            6130                       !!!    seaice2[siced_, m_, c_] := N[Erf[c*(siced - m)]/2 - Erf[-c*m]/2]
            6131                       !!!    c=2
            6132                       !!!    m=1
            6133                       !!! cold bias is found for the above Eq.
            6134                       ! ----------------------------------------------------------------------
            6135                       SUBROUTINE lkerr(err_message,hesn,hew,heice,fcew,pfluxwm,wtm,wsm,tsim,ctfreeze,mas,mae,SOL)
            6136                       !   USE mo_memory_g3b,    ONLY: obswt,obsws
            6137                         IMPLICIT NONE
            6138                         real, INTENT(in):: hesn,heice,hew,fcew,pfluxwm,ctfreeze
            6139                         real, DIMENSION(0:3), INTENT(in):: tsim
            6140                         real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wsm
            6141                         real, DIMENSION(0:lkvl+5), INTENT(in):: SOL
            6142                         INTEGER, INTENT(in)  :: mas,mae
            6143                         CHARACTER(len = *) :: err_message
            6144                       !  CHARACTER(len = 80) :: err_message(12)={"Water freezes but phase change energy > 0.",         &  !  1
            6145                       !                                       "Ice melts but phase change energy < 0.",             &  !  2
            6146                       !                                       "Snow melts but phase change energy <0.",             &  !  3
            6147                       !                                       "Water freezes completely.",                           &  !  4
            6148                       !                                       "Recursive more than 4 times.",                       &  !  5
            6149                       !                                       "Depth is less than 0.2 M. Soil only is assumed.",    &  !  6
            6150                       !                                       "Ice melts completely due to level 4 forcing.",       &  !  7
            6151                       !                                       "Ice melts completely due to level 3 forcing.",       &  !  8
            6152                       !                                       "Recursive goto 830 skin water layer setup.",         &  !  9
            6153                       !                                       "Recursive goto 840 ice layer setup.",                &  ! 10
            6154                       !                                       "Water starts to freeze.",                             &  ! 11
            6155                       !                                       "Snow melts completely." }                               ! 12
            6156                     #ifdef DEBUG
            6157     1                   IF (GDCHK2) THEN
            6158     1               #else
            6159     1                   IF (lwarning_msg.GE.3) THEN
            6160     1               #endif
            6161     1                      WRITE(nerr,*) "sit_vdiff: ","jl=",jl,"jrow=",jrow,"istep=",istep,                        &
            6162     1                          "sit_step=",i_sit_step,                                                                &
            6163     1                          "lat=",plat(jl),"lon=",plon(jl), err_message,                      &
            6164     1                          "hew=",hew,"hesn=",hesn,                          &
            6165     1                          "rhoh2o=",rhoh2o,"rhosn=",rhosn,"xksn=",xksn,"omegas=",omegas,                         &
            6166     1                          "heice=",heice,"fcew=",fcew,"ctfreeze=",ctfreeze,                     &
            6167     1                          "pfluxw=",pfluxw2,"sn=",pzsi(jl,0),"ice=",pzsi(jl,1),"tsw=",pwt(jl,0),              &
            6168     1                          "pfluxwm=",pfluxwm,"pdfluxs=",pdfluxs(jl),"soflw=",psoflw(jl),                         &
            6169     1                          "evapw=",pevapw(jl),"rsf=",prsf(jl),"ssf=",pssf(jl),             &
            6170     1                          "silw(0)=",psilw(jl,0),"silw(1)=",psilw(jl,1),                       &
            6171     1                          "rainfall heat flux=",( prsf(jl) )*clw*(wtm(nls+1)-ptemp2(jl)),             &
            6172     1                          "snowfall heat flux=",( pssf(jl) )*( alf+csn*(tmelt-ptemp2(jl))+clw*(wtm(nls+1)-tmelt) ), &
            6173     1                          "snow heat flux=",pzsi(jl,0)*rhoh2o/zdtime*( alf+csn*(tmelt-tsim(1))+clw*(wtm(nls+1)-tmelt) ) &
            6174     1                            +psilw(jl,0)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt),                                   &
            6175     1                          "ice flux=", pzsi(jl,1)*rhoh2o/zdtime*( alf+cice*(tmelt-tsim(3))+clw*(wtm(nls+1)-tmelt) )     &
            6176     1                            +psilw(jl,1)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt),                                   &
            6177     1                          "temp2=",ptemp2(jl),"nls=",nls,"nle=",nle,                                             &
            6178     1                          "tsim(:)=",tsim(:),"tsi=",ptsi(jl),                                                    &
            6179     1                          "sittsi(:)=",ptsnic(jl,:),                                                             &
            6180     1                          "wtm(:)=",wtm(:),"sitwt(:)=",pwt(jl,:),                                                &
            6181     1                          "mas=",mas,"mae=",mae,"SOL=",SOL
            6182     1                 !!!         "mas=",mas,"mae=",mae,"AA(0)=",AA(0,:),"RHS=",RHS,"SQL=",SOL
            6183     1               
            6184     1                   ELSE
            6185     1                      RETURN
            6186     1                   ENDIF
            6187                     
            6188                       !  CALL write_date(current_date,' sit_vdiff Current date: ')
            6189                       !  WRITE(nerr,*) "sit_vdiff Pt. (jl,jrow,istep)=(",jl,jrow, istep,")"
            6190                       !  IF (iderr.EQ.1) THEN
            6191                       !    WRITE(nerr,*) "Water freezes but phase change energy > 0."
            6192                       !  ELSEIF (iderr.EQ.2) THEN
            6193                       !    WRITE(nerr,*) "Ice melts but phase change energy < 0."
            6194                       !  ELSEIF (iderr.EQ.3) THEN
            6195                       !    WRITE(nerr,*) "Snow melts but phase change energy <0."
            6196                       !  ELSEIF (iderr.EQ.4) THEN
            6197                       !    WRITE(nerr,*) "Water freezes completely."
            6198                       !  ELSEIF (iderr.EQ.5) THEN
            6199                       !    WRITE(nerr,*) "Recursive more than 4 times."
            6200                       !  ELSEIF (iderr.EQ.6) THEN
            6201                       !    WRITE(nerr,*) "Depth is less than 0.2 M. Soil only is assumed."
            6202                       !  ELSEIF (iderr.EQ.7) THEN
            6203                       !    WRITE(nerr,*) "Ice melts completely due to level 4 forcing."
            6204                       !  ELSEIF (iderr.EQ.8) THEN
            6205                       !    WRITE(nerr,*) "Ice melts completely due to level 3 forcing."
            6206                       !  ELSEIF (iderr.EQ.9) THEN
            6207                       !    WRITE(nerr,*) "Recursive goto 830 skin water layer setup."
            6208                       !  ELSEIF (iderr.EQ.10) THEN
            6209                       !    WRITE(nerr,*) "Recursive goto 840 ice layer setup."
            6210                       !  ELSEIF (iderr.EQ.11) THEN
            6211                       !    WRITE(nerr,*) "Water starts to freeze."
            6212                       !  ELSEIF (iderr.EQ.12) THEN
            6213                       !    WRITE(nerr,*) "Snow melts completely."
            6214                       !  ENDIF
            6215                       END SUBROUTINE lkerr
            6216                       ! ----------------------------------------------------------------------
            6217                       !!!SUBROUTINE OUTPUT(hesn,hew,heice,fcew,pfluxwm,wtm,wum,wvm,wsm,wtkem,tsim,mas,mae)
            6218                       SUBROUTINE output(err_message,hesn,hew,heice,pfluxwm,wtm,wsm,tsim)
            6219                       !
            6220                       !-----------------------------------------------------------------
            6221                       !
            6222                       !*    OUTPUT: WRITE DIAGNOSTIC VARIABLES
            6223                       !
            6224                       !-----------------------------------------------------------------
            6225                         !!! USE mo_mpi,           ONLY: mpp_pe()
            6226                         IMPLICIT NONE
            6227                         real, INTENT(in):: hesn,heice,hew,pfluxwm
            6228                         real, DIMENSION(0:3), INTENT(in):: tsim
            6229                         real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wsm
            6230                         CHARACTER(len = *) :: err_message
            6231                       !!!  real, INTENT(in):: hesn,heice,hew,fcew,pfluxwm
            6232                       !!!  real, DIMENSION(0:3), INTENT(in):: tsim
            6233                       !!!  real, DIMENSION(0:lkvl+1), INTENT(in):: wtm,wum,wvm,wsm,wtkem
            6234                       !!!  INTEGER, INTENT(in)  :: mas,mae
            6235                         INTEGER jk
            6236                         real:: tmp
            6237                     
            6238                       !!!  WRITE(nerr,*) "sit_vdiff: ","pe=",mpp_pe(),"jl=,",jl,"jrow=,",jrow,"istep=",istep,   &
            6239                       !!!     "lat=",plat(jl),"lon=",plon(jl), "SST overflow"
            6240                     !!!    CALL write_date(current_date,' sit_vdiff Current date: ')
            6241                       !  WRITE(nerr,*) "sit_vdiff Current date: ",current_date
            6242                         WRITE(nerr,*) "sit_vdiff: ","it=",istep,"pe=",mpp_pe(),"jl=",jl,"jrow=",jrow,                  &
            6243                             "sit_step=",i_sit_step,                                                                &
            6244                             "lat=",plat(jl),"lon=",plon(jl), err_message,                      &
            6245                             "fluxiw=",pfluxiw_int(jl),                                                              &
            6246                             "pfluxw=",pfluxw2,"pfluxwm=",pfluxwm,"pdfluxs=",pdfluxs(jl),"soflw=",psoflw(jl),       &
            6247                             "temp2=",ptemp2(jl),"tsw=",pwt(jl,0),"tsi=",ptsi(jl),                                  &
            6248                             "sn=",pzsi(jl,0),"ice=",pzsi(jl,1),"hew=",hew,"hesn=",hesn,                            &
            6249                             "rhoh2o=",rhoh2o,"rhosn=",rhosn,"xksn=",xksn,"omegas=",omegas,                         &
            6250                             "heice=",heice,                                                                        &
            6251                             "evapw=",pevapw(jl),"rsf=",prsf(jl),"ssf=",pssf(jl),                                   &
            6252                             "silw(0)=",psilw(jl,0),"silw(1)=",psilw(jl,1),                                         &
            6253                             "rainfall heat flux=",( prsf(jl) )*clw*(wtm(nls+1)-ptemp2(jl)),             &
            6254                             "snowfall heat flux=",( pssf(jl) )*( alf+csn*(tmelt-ptemp2(jl))+clw*(wtm(nls+1)-tmelt) ), &
            6255                             "snow heat flux=",pzsi(jl,0)*rhoh2o/zdtime*( alf+csn*(tmelt-tsim(1))+clw*(wtm(nls+1)-tmelt) ) &
            6256                               +psilw(jl,0)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt),                                   &
            6257                             "ice flux=", pzsi(jl,1)*rhoh2o/zdtime*( alf+cice*(tmelt-tsim(3))+clw*(wtm(nls+1)-tmelt) )     &
            6258                               +psilw(jl,1)*rhoh2o/zdtime*clw*(wtm(nls+1)-tmelt)
            6259                     
            6260                         WRITE(nerr,*) "sitmask=",psitmask(jl).EQ.1.
            6261                         WRITE(nerr,*) "lclass=",plclass(jl)
            6262                         WRITE(nerr,*) "slm=",pslm(jl)
            6263                         WRITE(nerr,*) "seaice=",pseaice(jl)
            6264                         WRITE(nerr,*) "siced=",psiced(jl)
            6265                         WRITE(nerr,*) "lsoil=",lsoil
            6266                         WRITE(nerr,*) "temp2=",ptemp2(jl)
            6267                         WRITE(nerr,*) "tsi=",ptsi(jl)
            6268                         WRITE(nerr,*) "tsw=",ptsw(jl)
            6269                         WRITE(nerr,*) "obstsw=",pobswtb(jl)
            6270                         WRITE(nerr,*) "tmelt=",pctfreez2(jl)
            6271                         WRITE(nerr,*) "fluxw=",pfluxw(jl)
            6272                         WRITE(nerr,*) "fluxw2=",pfluxw2
            6273                         WRITE(nerr,*) "fluxi=",pfluxi(jl)
            6274                         WRITE(nerr,*) "fluxi=",pfluxi2
            6275                         WRITE(nerr,*) "dfluxs=",pdfluxs(jl)
            6276                         WRITE(nerr,*) "soflw=",psoflw(jl)
            6277                         WRITE(nerr,*) "wtfn(10)=",pwtfn(jl,10)
            6278                         WRITE(nerr,*) "wsfn(10)=",pwsfn(jl,10)
            6279                         WRITE(nerr,*) "wtfn0(10)=",pwtfn0(jl,10)
            6280                         WRITE(nerr,*) "wsfn0(10)=",pwsfn0(jl,10)
            6281                         WRITE(nerr,*) "runtoc=",pdisch(jl)
            6282                         WRITE(nerr,*) "wind10w=",pwind10w(jl)
            6283                         WRITE(nerr,*) "wlvl=",pwlvl(jl)
            6284                         WRITE(nerr,*) "evapw=",pevapw(jl)
            6285                         WRITE(nerr,*) "rsf=",prsf(jl)
            6286                         WRITE(nerr,*) "ssf=",pssf(jl)
            6287                         WRITE(nerr,*) "nls=",nls,"nle=",nle,                                                       &
            6288                             "tsim(:)=",tsim(:),                                                                    &
            6289                             "sittsi(:)=",ptsnic(jl,:),                                                             &
            6290                             "wtm(:)=",wtm(:),"sitwt(:)=",pwt(jl,:)
            6291                       !
            6292                         CALL output2
            6293                       !
            6294                         WRITE(nerr,*) "Data in previous time step"
            6295     1                   DO jk = 0, nle+1
            6296     1                     WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),&
            6297     1                 &     wtm(jk),wum(jk),wvm(jk),wsm(jk),&
            6298     1                 &     wtkem(jk)
            6299     1                   END DO
            6300                       !
            6301                       !     calc. column mean temp
            6302     1                   IF (nle.GE.1)THEN
            6303     1                 !     water exists
            6304     1                     tmp=DOT_PRODUCT(pwt(jl,nls+1:nle),MAX(hw(nls+1:nle),0.))/SUM(MAX(hw(nls+1:nle),0.))
            6305     1                   ELSE
            6306     1                 !     soil only
            6307     1                     tmp=pwt(jl,0)
            6308     1                   ENDIF
            6309                         WRITE(nerr,*) "depth=",(z(0)-z(nle+1))
            6310                         WRITE(nerr,*) "mean column temp=",tmp
            6311                       !
            6312                       !ps 2301 FORMAT(1X,4(I3,","),1(I9,","),1(I3,","),1(F10.4,","),1(F8.3,","),2(F8.4,","),&
            6313                        2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),1(F8.3,","),2(F8.4,","),&
            6314                       &       1(F8.3,","),2(E9.2,","),10(F8.3,","))
            6315                     
            6316                       !
            6317                         RETURN
            6318                       !
            6319                       !
            6320                       END SUBROUTINE output
            6321                       !
            6322                       ! ----------------------------------------------------------------------
            6323                       !
            6324                       SUBROUTINE penetrative_convection(jl)
            6325                       !
            6326                       !
            6327                       !-----------------------------------------------------------------
            6328                       ! Parameterize penetrative convection by mixing unstable surface
            6329                       ! layer regions directly with deep water layer where density starts
            6330                       ! increasing with depth.
            6331                       ! This is needed unless resolution is better than about 10 km; otherwise
            6332                       ! rotation does not allow proper and full convective adjustment. Should
            6333                       ! be applied stochastically, as the strong events leading to
            6334                       ! vigorous convection are short lived and infrequent.
            6335                       ! This is especially designed for 18 deg water formation in Sargasso Sea.
            6336                       !
            6337                       !-----------------------------------------------------------------
            6338                       ! Corresponding variables:
            6339                       !  TIMCOM: SIT
            6340                       !  KB(I,J): nle
            6341                       !  K=1: K=nls+1
            6342                       ! original code:
            6343                       !  u40bjt00@alps6:/work/j07tyh00/PRODUCTION_RUNS/GLOBAL_1DEG_Z61_NOCN_HNUDGa/global.F
            6344                       !  line 759-774
            6345                       !
            6346                         IMPLICIT NONE
            6347                       ! 0.0 Calling Variables
            6348                         INTEGER, INTENT(IN):: jl    ! lonitude and latitude index
            6349                       ! 0.1 Local Variables
            6350                         real:: eps               ! exchange ratio for each zdtime time_step
            6351                         real:: sdif,tdif
            6352                         INTEGER  :: jk
            6353                       !!!      hw(nls+1)=Z(3)-Z(1)    ! calculated somewhere else
            6354                       ! one-day by half exchange time scale may be too fast for NUMERICAL stability
            6355                       ! Set one-day to desired vertical exchange time scale (such as six_hour, one_hour, ...)
            6356                         eps=(1.-0.5**(zdtime/one_day))
            6357                       ! find unstable top layer points
            6358     1                   IF (pwrho(nls+1).GT.pwrho(nls+2)) THEN
            6359     1                     jk=nls+1
            6360     1                     jk=jk+1
            6361     1                 ! find first layer below top layer having density more than top layer
            6362     2                     DO WHILE (pwrho(nls+1).GT.pwrho(jk).AND.jk.LT.nle)
            6363     2                       jk=jk+1
            6364     2                     END DO
            6365     1                 ! Vertically exchange heat and salt.
            6366     1                 ! This will usually destabilize next layer down, but that is more easily
            6367     1                 ! convectively adjusted by model due to deep layers being thicker than
            6368     1                 ! those near surface.
            6369     1                     sdif=pws(jl,jk)-pws(jl,nls+1)
            6370     1                     pws(jl,nls+1)=pws(jl,nls+1)+eps*sdif
            6371     1                     pws(jl,jk)=pws(jl,jk)-eps*sdif*hw(nls+1)/hw(nls+jk)
            6372     1                     tdif=pwt(jl,jk)-pwt(jl,nls+1)
            6373     1                     pwt(jl,nls+1)=pwt(jl,nls+1)+eps*tdif
            6374     1                     pwt(jl,jk)=pwt(jl,jk)-eps*tdif*hw(nls+1)/hw(nls+jk)
            6375     1                   ENDIF
            6376                       END SUBROUTINE penetrative_convection
            6377                       ! ----------------------------------------------------------------------
            6378                     
            6379                       SUBROUTINE interpolation_godas(jl,jrow,l_no_expolation_wt,l_no_expolation_ws,l_no_expolation_wu,l_no_expolation_wv)
            6380                     !
            6381                     !     input
            6382                     !      real:: obstsw, ot12, os12, ou12, ov12
            6383                     !     output
            6384                     !      real:: obswt(0:lkvl+1),obsws(0:lkvl+1),obswu(0:lkvl+1),obswv(0:lkvl+1)
            6385                     
            6386                       !!! USE mo_interpo,       ONLY: nmw1, nmw2, wgt1, wgt2, ndw1, ndw2, wgtd1, wgtd2
            6387                     !!!  USE mo_control,       ONLY: lgodas
            6388                     !!!  USE sit_constants_mod,     ONLY: tmelt
            6389                     !!!  USE mo_physc2,        ONLY: ctfreez
            6390                       !!! USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, mpp_pe()
            6391                       USE mod_sst,           ONLY: nodepth, odepths, ot12, os12, ou12, ov12
            6392                       USE mod_eos_ocean,     ONLY: tmaxden
            6393                     !ps
            6394                       USE mod_sst,        ONLY:now1,now2,wgto1,wgto2,obswtbnmw1,obswtbnmw2,obswtbwgt1,obswtbwgt2
            6395                     !ps
            6396                     
            6397                       IMPLICIT NONE
            6398                       LOGICAL, INTENT(IN):: l_no_expolation_wt   ! logical for missing data
            6399                       LOGICAL, INTENT(IN):: l_no_expolation_ws   ! logical for missing data
            6400                       LOGICAL, INTENT(IN):: l_no_expolation_wu   ! logical for missing data
            6401                       LOGICAL, INTENT(IN):: l_no_expolation_wv   ! logical for missing data
            6402                         ! .TRUE. no expolation, missing value returned
            6403                         ! .FALSE. expolation enforced, non-missing value returned
            6404                       INTEGER, INTENT(IN):: jl,jrow    ! lonitude index
            6405                       LOGICAL  :: l_upperdata            ! =TRUE, if data of an upper level is available
            6406                       INTEGER  :: jk,kkk
            6407                       real:: ttt,ttt1,sss,sss1,uuu,uuu1,vvv,vvv1,depth
            6408                     !ps
            6409                     !  real:: ttt0,sss0
            6410                       real:: t10m,t10m1,pobswt10m,rr,rf_obs
            6411                       INTEGER:: k10m,kmixdepth
            6412                     !ps
            6413     1                 IF (GDCHK2) then
            6414     1                   WRITE(nerr,*) "I am in interpolation_godas2"
            6415     1                   WRITE(nerr,*) "lwarning_msg=",lwarning_msg
            6416     1                 ENDIF
            6417                       IF ((.NOT.lgodas).AND.(pobswtb(jl).EQ.xmissing)) RETURN
            6418                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            6419                     !!
            6420                     !! Note that the vertical index of g3b starts from 1 although the index in the sit_vdiff
            6421                     !!   routine starts from 1,
            6422     1                 IF (GDCHK2) then
            6423     1                   WRITE(nerr,*) "I am in interpolation_godas2, line 6441"
            6424     1                   WRITE(nerr,*) "l_no_expolation_wt=",l_no_expolation_wt
            6425     1                   WRITE(nerr,*) "l_no_expolation_ws=",l_no_expolation_ws
            6426     1                   WRITE(nerr,*) "l_no_expolation_wu=",l_no_expolation_wu
            6427     1                   WRITE(nerr,*) "l_no_expolation_wv=",l_no_expolation_wv
            6428     1                   WRITE(nerr,*) "godas2: nmw1=",nmw1,",nmw2=",nmw2,",wgt1=",wgt1,",wgt2=",wgt2 &
            6429     1                                         ,",now1=",now1,",now2=",now2,",wgto1=",wgto1,",wgto2=",wgto2
            6430     1                   WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "ot1,", "ot2", "os1,", "os2"
            6431     1                   WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "obswt,", "obsws", "obswu", "obswv"
            6432     2                   DO jk = 0, nle+1
            6433     2                     WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),pobswt(jl,jk),pobsws(jl,jk),pobswu(jl,jk),pobswv(jl,jk)
            6434     2                   END DO
            6435     1                 ENDIF
            6436                     
            6437                     !find mixing_depth
            6438     1                 IF ( lgodas .AND. lmixedlayer .AND.              &
            6439     1                    (mixedlayer12(jl,jrow,now1).NE.xmissing) .AND. &
            6440     1                    (mixedlayer12(jl,jrow,now2).NE.xmissing)) THEN
            6441     1                   mixedlayer(jl)=max(wgto1*mixedlayer12(jl,jrow,now1)+wgto2*mixedlayer12(jl,jrow,now2),nudge_depth_10)
            6442     1                 ENDIF
            6443                     !find mixing_depth abs(t-t10m)<= (0.8) degree  (A.B. Kara et al., 2000)
            6444     1                 IF (lgodas) then
            6445     1                   k10m=1
            6446     2                   DO WHILE ( (odepths(k10m).LE. 10.) .AND. (k10m.LT.nodepth) )
            6447     2                     k10m=k10m+1
            6448     2                   END DO
            6449     1                   IF (k10m.GT.1) k10m=k10m-1              ! restore back one layer
            6450     1                 ENDIF
            6451     1                 IF ( lgodas .AND. (.not.lmixedlayer) .AND.              &
            6452     1                      (ot12(jl,k10m,jrow,now1).NE.xmissing)      .AND. &
            6453     1                      (ot12(jl,k10m,jrow,now2).NE.xmissing)      .AND. &
            6454     1                      (ot12(jl,k10m+1,jrow,now1).NE.xmissing)    .AND. &
            6455     1                      (ot12(jl,k10m+1,jrow,now2).NE.xmissing)    .AND. &
            6456     1                      (10. .LE.odepths(nodepth)) ) THEN
            6457     1                   t10m=wgto1*ot12(jl,k10m,jrow,now1)+wgto2*ot12(jl,k10m,jrow,now2)
            6458     1                   t10m1=wgto1*ot12(jl,k10m+1,jrow,now1)+wgto2*ot12(jl,k10m+1,jrow,now2)
            6459     1                   pobswt10m=t10m+ &                                    ! pobswt at 10 m
            6460     1                         (10.-odepths(k10m))/(odepths(k10m+1)-odepths(k10m))* (t10m1-t10m)
            6461     1               
            6462     1                   kmixdepth=k10m+1
            6463     2                   DO WHILE ( (ot12(jl,kmixdepth,jrow,now1).NE.xmissing) .AND. &
            6464     2                              (ot12(jl,kmixdepth,jrow,now2).NE.xmissing) .AND. &
            6465     2                              (kmixdepth.LT.nodepth) )
            6466     2                     tmixdown=wgto1*ot12(jl,kmixdepth,jrow,now1)+wgto2*ot12(jl,kmixdepth,jrow,now2)
            6467     3                     IF (abs(tmixdown-pobswt10m).LE. 0.8) THEN
            6468     3                       kmixdepth=kmixdepth+1
            6469     3                     ELSE
            6470     3                       exit
            6471     3                     ENDIF
            6472     2                   END DO
            6473     1                   IF(kmixdepth.GT.1) kmixdepth=kmixdepth-1
            6474     1                     tmixup=wgto1*ot12(jl,kmixdepth,jrow,now1)+wgto2*ot12(jl,kmixdepth,jrow,now2)
            6475     1                     mixlayer=((pobswt10m-0.8)-tmixup)/(tmixdown-tmixup)*(odepths(kmixdepth+1)-odepths(kmixdepth))&
            6476     1                               +odepths(kmixdepth)
            6477     1                     mixedlayer(jl)=max(mixlayer,nudge_depth_10)
            6478     1                   IF(GDCHK3) print *,"1. kmixdepth=",kmixdepth,",mixedlayer=",mixedlayer(jl) &
            6479     1                                     ,",obswt10m=",pobswt10m
            6480     1                 ENDIF
            6481                     
            6482                     
            6483     1                 DO jk=0,nle+1
            6484     1                   depth=(pwlvl(jl)-z(jk))
            6485     2                   IF (lgodas) THEN
            6486     2                     !! initialized the water profile according to world ocean altas data (woa) data
            6487     2                     kkk=1
            6488     3                     DO WHILE ( (odepths(kkk).LE.depth) .AND. (kkk.LT.nodepth) )
            6489     3                        kkk=kkk+1
            6490     3                     END DO
            6491     2                     IF (kkk.GT.1) kkk=kkk-1              ! restore back one layer
            6492     2                   ENDIF
            6493     1               !
            6494     1               ! 1.0 water salinity
            6495     1               !
            6496     1                   l_upperdata=.FALSE.
            6497     1                   sss=pobswsb(jl)
            6498     1                   sss1=pobswsb(jl)
            6499     2                   IF ( lgodas .AND.                                    &
            6500     2                        (os12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6501     2                        (os12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6502     2                        (os12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6503     2                        (os12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6504     2                        (depth.LE.odepths(nodepth)) ) THEN
            6505     2                     ! depth < max. obs. depth
            6506     2                     ! linearly interpolation (no extrapolation)
            6507     2                     l_upperdata=.TRUE.
            6508     2               !      sss0=obswtbwgt1*os12(jl,1,jrow,obswtbnmw1)+obswtbwgt2*os12(jl,1,jrow,obswtbnmw2)
            6509     2                     sss=wgto1*os12(jl,kkk,jrow,now1)+wgto2*os12(jl,kkk,jrow,now2)
            6510     2                     sss1=wgto1*os12(jl,kkk+1,jrow,now1)+wgto2*os12(jl,kkk+1,jrow,now2)
            6511     2                     pobsws(jl,jk)=sss+ &
            6512     2                       (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (sss1-sss)
            6513     2                   ELSE
            6514     2                     ! depth > max obs. depth or missing observed data
            6515     2                     ! water salinity
            6516     3                     IF (l_no_expolation_ws) THEN
            6517     3                     ! no extrapolation
            6518     3                       pobsws(jl,jk)=xmissing
            6519     3                     ELSE
            6520     3                     ! assume to be sss1
            6521     3                       pobsws(jl,jk)=sss1
            6522     3               !!!      ! extrapolation
            6523     3               !!!        pobsws(jl,jk)=sss+ &
            6524     3               !!!           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (sss1-sss)
            6525     3                     ENDIF
            6526     2                   ENDIF
            6527     1               !
            6528     1               ! 1.1 modify pobswsb/freezing temp again according to initial ocean T/S profile.
            6529     1               !     Note that pobswsb/freezing temp were firstly setup in ioinitial.f90
            6530     1               !
            6531     2                   IF (lsitstart.AND.jk.EQ.0) THEN
            6532     2                     pobswsb(jl)=MERGE(pobsws(jl,jk),pobswsb(jl),pobsws(jl,jk).NE.xmissing)
            6533     2               #if defined (V9897)
            6534     2                       pctfreez2(jl)=tmelt+3.
            6535     2               #elif defined (TMELTS0)
            6536     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl)),tmelt,pobswsb(jl).NE.xmissing)
            6537     2               #elif defined (TMELTS1)
            6538     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+1.,tmelt+1.,pobswsb(jl).NE.xmissing)
            6539     2               #elif defined (TMELTS15)
            6540     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+1.5_dp,tmelt+1.5_dp,pobswsb(jl).NE.xmissing)
            6541     2               #elif defined (TMELTS2)
            6542     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+2.,tmelt+2.,pobswsb(jl).NE.xmissing)  ! v9.9003, there is 7600 ice grids, while the observation is 760 ice grid.
            6543     2               #elif defined (TMELTS25)
            6544     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+2.,tmelt+2.,pobswsb(jl).NE.xmissing)  ! v9.9007.
            6545     2               #elif defined (TMELTS3)
            6546     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl))+3.,tmelt+3.,pobswsb(jl).NE.xmissing)  ! v9.898 (too hot and too salty in S.H.)
            6547     2               #else
            6548     2                       pctfreez2(jl)=MERGE(tmelts(pobswsb(jl)),tmelt,pobswsb(jl).NE.xmissing)
            6549     2               #endif
            6550     2                   ENDIF
            6551     1               !
            6552     1               ! 2.0 water temperature
            6553     1               !
            6554     1               !
            6555     1               !
            6556     1                   l_upperdata=.FALSE.
            6557     1                   ttt=pobswtb(jl)
            6558     1                   ttt1=pobswtb(jl)
            6559     2                   IF(GDCHK2) then
            6560     2                     print *,"lgodas=",lgodas,",ttt=",ttt,",kkk=",kkk          &
            6561     2                            ,",ot12(jl,kkk,jrow,now1)=",ot12(jl,kkk,jrow,now1) &
            6562     2                            ,",ot12(jl,kkk,jrow,now2)=",ot12(jl,kkk,jrow,now2) &
            6563     2                            ,",ot12(jl,kkk+1,jrow,now1)=",ot12(jl,kkk+1,jrow,now1) &
            6564     2                            ,",ot12(jl,kkk+1,jrow,now2)=",ot12(jl,kkk+1,jrow,now2) &
            6565     2                            ,",depth=",depth,",nodepth=",nodepth                   &
            6566     2                            ,",odepths(nodepth)=",odepths(nodepth)
            6567     2               
            6568     2                   ENDIF
            6569     2                   IF ( lgodas .AND.                                    &
            6570     2                        (ot12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6571     2                        (ot12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6572     2                        (ot12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6573     2                        (ot12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6574     2                        (depth.LE.odepths(nodepth)) ) THEN
            6575     2                     ! depth < max. obs. depth
            6576     2                     l_upperdata=.TRUE.
            6577     2               !      ttt0=obswtbwgt1*ot12(jl,1,jrow,obswtbnmw1)+obswtbwgt2*ot12(jl,1,jrow,obswtbnmw2)
            6578     2                     ttt=wgto1*ot12(jl,kkk,jrow,now1)+wgto2*ot12(jl,kkk,jrow,now2)
            6579     2                     ttt1=wgto1*ot12(jl,kkk+1,jrow,now1)+wgto2*ot12(jl,kkk+1,jrow,now2)
            6580     2               
            6581     3                     IF(mixedlayer(jl) .ge. nudge_depth_10 .AND. pobswtb(jl) .NE. xmissing   &
            6582     3                        .AND. pobswt10m .NE. xmissing)then
            6583     4                       IF(depth .LE. nudge_depth_10)THEN
            6584     4                         rf_obs=1.
            6585     4                       ELSEIF(depth .GT. mixedlayer(jl) .AND. depth .LT. nudge_depth_100) THEN
            6586     4                         rr=(depth-mixedlayer(jl))/(nudge_depth_100-mixedlayer(jl))
            6587     4                         rf_obs=1.-exp(-0.5/rr*exp(0.5/(rr-1.)))
            6588     4                       ELSE
            6589     4                         rf_obs=0.
            6590     4                       ENDIF
            6591     3               
            6592     4                       if(jk .le. 0)then
            6593     4                          pobswt(jl,jk)=MAX(pctfreez2(jl), ttt+ &
            6594     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6595     5                         if(lsftobswt) then
            6596     5                           psftobswt(jl,0)=(pobswtb(jl)-pobswt(jl,0))
            6597     5                         endif
            6598     5                         if(GDCHK3)then
            6599     5                           print*,"int_godas: jk=",jk,",pobswtb=",pobswtb(jl),",pobswt_jk=",pobswt(jl,jk)
            6600     5                         endif
            6601     4                       endif
            6602     4                       if(lsftobswt) then
            6603     4                         psftobswt(jl,jk)=psftobswt(jl,0)
            6604     4                       endif
            6605     3               
            6606     4                       IF(depth .LE. mixedlayer(jl) ) THEN
            6607     4                         pobswt(jl,jk)=MAX(pctfreez2(jl), psftobswt(jl,jk)+ttt+ &
            6608     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6609     4                       ELSEIF(depth .GT. mixedlayer(jl) .AND. depth .LT. nudge_depth_100) THEN
            6610     4                         rr=(depth-mixedlayer(jl))/(nudge_depth_100-mixedlayer(jl))
            6611     4                         rf_obs=1.-exp(-0.5/rr*exp(0.5/(rr-1.)))
            6612     4                         psftobswt(jl,jk)=rf_obs*psftobswt(jl,jk)
            6613     4                         pobswt(jl,jk)=MAX(pctfreez2(jl), psftobswt(jl,jk)+ttt+ &
            6614     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6615     4                       ELSE
            6616     4                         psftobswt(jl,jk)=0.
            6617     4                         pobswt(jl,jk)=MAX(pctfreez2(jl), ttt+ &
            6618     4                           (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6619     4                       ENDIF
            6620     3                     ELSE
            6621     4                       IF ( depth.LE. nudge_depth_10 ) THEN
            6622     4                     ! depth < 10 m, note daily SST is avaiable from satellite
            6623     5                         IF (pobswtb(jl).NE.xmissing) THEN
            6624     5                           pobswt(jl,jk)=MAX(pctfreez2(jl),pobswtb(jl))
            6625     5                         ELSE
            6626     5                          pobswt(jl,jk)=xmissing
            6627     5                        ENDIF
            6628     4                       ELSE
            6629     4                     ! depth < max. obs. depth
            6630     4                     ! linearly interpolation (no extrapolation)
            6631     4                       pobswt(jl,jk)=MAX(pctfreez2(jl), ttt+ &
            6632     4                         (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6633     4               !ps        pobswt(jl,jk)=MAX(pctfreez2(jl), ttt &
            6634     4               !ps            +(depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) &
            6635     4               !ps            +rf_obs*(pobswtb(jl)-ttt0) )
            6636     4               
            6637     4               !          IF (GDCHK3) then
            6638     4               !            print *,'now1=',now1,',now2=',now2,'wgto1=',wgto1,',wgto2=',wgto2
            6639     4               !            print *,'kkk=',kkk,',ttt0=',ttt0,',ttt=',ttt,',ttt1=',ttt1
            6640     4               !            print *,'pobsws(',jl,',',jk,')=',pobsws(jl,jk)
            6641     4               !            print *,'pobswt(',jl,',',jk,')=',pobswt(jl,jk)
            6642     4               !            print *,'pobswtb(',jl,')=',pobswtb(jl)
            6643     4               !            print *,'obswtbwgt1=',obswtbwgt1,'obswtbwgt2=',obswtbwgt2
            6644     4               !            print *,'obswtbnmw1=',obswtbnmw1,'obswtbnmw2=',obswtbnmw2
            6645     4               !          ENDIF
            6646     4                       ENDIF
            6647     3                     ENDIF
            6648     3                     IF (GDCHK2) then
            6649     3                       WRITE(nerr,*) "godas2.1, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6650     3                     ENDIF
            6651     2                   ELSE
            6652     2                     ! depth > max obs. depth or on observation
            6653     2                     ! water temperature
            6654     3                     IF (l_no_expolation_wt) THEN
            6655     3                     ! no extrapolation
            6656     3                       pobswt(jl,jk)=xmissing
            6657     4                       IF (GDCHK2) then
            6658     4                         WRITE(nerr,*) "godas2.2, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6659     4                       ENDIF
            6660     3                     ELSE
            6661     3                     ! extrapolation
            6662     4                       IF (l_upperdata) THEN
            6663     4                         pobswt(jl,jk)=MAX(pctfreez2(jl),ttt+ &
            6664     4                            (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (ttt1-ttt) )
            6665     5                         IF (GDCHK2) then
            6666     5                           WRITE(nerr,*) "godas2.3, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6667     5                         ENDIF
            6668     5                         IF ((tmaxden(pobswsb(jl)).GT.ttt1).AND.(tmaxden(pobswsb(jl)).GT.ttt)) THEN
            6669     5                           pobswt(jl,jk)=MIN(tmaxden(pobsws(jl,jk)),pobswt(jl,jk))
            6670     6                           IF (GDCHK2) then
            6671     6                             WRITE(nerr,*) "godas2.4, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6672     6                           ENDIF
            6673     5                         ELSEIF ((tmaxden(pobswsb(jl)).LT.ttt1).AND.(tmaxden(pobswsb(jl)).LT.ttt)) THEN
            6674     5                           pobswt(jl,jk)=MAX(tmaxden(pobsws(jl,jk)),pobswt(jl,jk))
            6675     6                           IF (GDCHK2) then
            6676     6                             WRITE(nerr,*) "godas2.5, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6677     6                           ENDIF
            6678     5                         ELSE
            6679     5                           pobswt(jl,jk)=tmaxden(pobsws(jl,jk))
            6680     6                           IF (GDCHK2) then
            6681     6                             WRITE(nerr,*) "godas2.6, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6682     6                           ENDIF
            6683     5                         ENDIF
            6684     4                       ELSE
            6685     4                         ! set initial profile to be expontential decay to tmaxden
            6686     4    i                    pobswt(jl,jk)=wt_maxden(depth,pobswtb(jl),pobswsb(jl),mixing_depth)
            6687     5                         IF (GDCHK2) then
            6688     5                           WRITE(nerr,*) "godas2.7, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6689     5                         ENDIF
            6690     4                       ENDIF
            6691     3                       ! range check
            6692     3                       pobswt(jl,jk)=MAX(pctfreez2(jl),pobswt(jl,jk))
            6693     4                       IF (GDCHK2) then
            6694     4                         WRITE(nerr,*) "godas2.8, pobswt(",jl,",",jk,")=",pobswt(jl,jk)
            6695     4                       ENDIF
            6696     3                     ENDIF
            6697     2                   ENDIF
            6698     1               !=================================================
            6699     1               !
            6700     1               ! 3.0 water u current
            6701     1               !
            6702     1                   l_upperdata=.FALSE.
            6703     1                   uuu=0.
            6704     1                   uuu1=0.
            6705     2                   IF ( lgodas .AND.                                    &
            6706     2                        (ou12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6707     2                        (ou12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6708     2                        (ou12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6709     2                        (ou12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6710     2                        (depth.LE.odepths(nodepth)) ) THEN
            6711     2                     ! depth < max. obs. depth
            6712     2                     l_upperdata=.TRUE.
            6713     2                     uuu=wgto1*ou12(jl,kkk,jrow,now1)+wgto2*ou12(jl,kkk,jrow,now2)
            6714     2                     uuu1=wgto1*ou12(jl,kkk+1,jrow,now1)+wgto2*ou12(jl,kkk+1,jrow,now2)
            6715     2                     ! linearly interpolation (no extrapolation)
            6716     2                     pobswu(jl,jk)=uuu+ &
            6717     2                       (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (uuu1-uuu)
            6718     2                   ELSE
            6719     3                     IF (l_no_expolation_wu) THEN
            6720     3                       ! no extrapolation
            6721     3                       pobswu(jl,jk)=xmissing
            6722     3                     ELSE
            6723     3                       pobswu(jl,jk)=0.
            6724     3               !!!     ! extrapolation
            6725     3               !!!       pobswu(jl,jk)=uuu+ &
            6726     3               !!!          (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (uuu1-uuu)
            6727     3                     ENDIF
            6728     2                   ENDIF
            6729     1               !
            6730     1               ! 4.0 water v current
            6731     1               !
            6732     1                   l_upperdata=.FALSE.
            6733     1                   vvv=0.
            6734     1                   vvv1=0.
            6735     2                   IF ( lgodas .AND.                                    &
            6736     2                        (ov12(jl,kkk,jrow,now1).NE.xmissing)      .AND. &
            6737     2                        (ov12(jl,kkk,jrow,now2).NE.xmissing)      .AND. &
            6738     2                        (ov12(jl,kkk+1,jrow,now1).NE.xmissing)    .AND. &
            6739     2                        (ov12(jl,kkk+1,jrow,now2).NE.xmissing)    .AND. &
            6740     2                        (depth.LE.odepths(nodepth)) ) THEN
            6741     2                     ! depth < max. obs. depth
            6742     2                     l_upperdata=.TRUE.
            6743     2                     vvv=wgto1*ov12(jl,kkk,jrow,now1)+wgto2*ov12(jl,kkk,jrow,now2)
            6744     2                     vvv1=wgto1*ov12(jl,kkk+1,jrow,now1)+wgto2*ov12(jl,kkk+1,jrow,now2)
            6745     2                     ! linearly interpolation (no extrapolation)
            6746     2                     pobswv(jl,jk)=vvv+ &
            6747     2                       (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (vvv1-vvv)
            6748     2                   ELSE
            6749     3                     IF (l_no_expolation_wu) THEN
            6750     3                       ! no extrapolation
            6751     3                       pobswv(jl,jk)=xmissing
            6752     3                     ELSE
            6753     3                       pobswv(jl,jk)=0.
            6754     3               !!!     ! extrapolation
            6755     3               !!!       pobswv(jl,jk)=vvv+ &
            6756     3               !!!          (depth-odepths(kkk))/(odepths(kkk+1)-odepths(kkk))* (vvv1-vvv)
            6757     3                     ENDIF
            6758     2                   ENDIF
            6759     1                 ENDDO
            6760                     !
            6761                     ! 5.0 Adjust pwt for accounting the ice grid for depth <= 10 m and the limit of pctfreez2
            6762                     !
            6763                     !  IF (.NOT.lsoil) pobswt(jl,0:nle+1)=MERGE(MAX(pctfreez2(jl),pobswt(jl,0:nle+1)),xmissing,pobswt(jl,0:nle+1).NE.xmissing)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<< Loop-information  End >>>
            6764     1  pp   2s        DO jk=0,nle+1
            6765     2   p   2m          IF (pobsseaice(jl).GT.0.) THEN
            6766     2   p   2s            depth=(pwlvl(jl)-z(jk))
            6767     2   p   2s            IF ((depth.LE.10.).AND.(pobswt(jl,jk).NE.xmissing)) pobswt(jl,jk)=pctfreez2(jl)
            6768     2   p   2v          ENDIF
            6769     1   p   2v        END DO
            6770                     
            6771     1                 IF (GDCHK2) then
            6772     1                   WRITE(nerr,*) "tmaxden=",tmaxden(pobswsb(jl))
            6773     1                   WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "obswt,", "obsws", "obswu", "obswv"
            6774     2                   DO jk = 0, nle+1
            6775     2                     WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),pobswt(jl,jk),pobsws(jl,jk),pobswu(jl,jk),pobswv(jl,jk)
            6776     2                   END DO
            6777     1                   WRITE(nerr,*) "I am leaving interpolation_godas"
            6778     1                 ENDIF
            6779                      2300 FORMAT(1X,3A4,2A9,2A4,1A11,4A9,2A10,10A9)
            6780                      2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),10(F8.3,","),2(E10.2,","),&
            6781                     &       1(F8.3,","),2(E9.2,","),10(F8.3,","))
            6782                       END SUBROUTINE interpolation_godas
            6783                     ! **********************************************************************
            6784                       SUBROUTINE interpolation_ocaf(jl,jrow,l_no_expolation_wt,l_no_expolation_ws)
            6785                     !
            6786                     !     input
            6787                     !      real:: wtfn12, wsfn12
            6788                     !     output
            6789                     !      real:: awtfl(0:lkvl+1),awsfl(0:lkvl+1)
            6790                     
            6791                       USE mod_sst,       ONLY: nmw1, nmw2, wgt1, wgt2
            6792                       USE mod_sit_control,       ONLY: locaf
            6793                     !!!  USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            6794                       USE mod_sst,           ONLY: nwdepth, wdepths, wtfn12, wsfn12
            6795                     
            6796                     
            6797                       IMPLICIT NONE
            6798                       LOGICAL, INTENT(IN):: l_no_expolation_wt   ! logical for missing data
            6799                       LOGICAL, INTENT(IN):: l_no_expolation_ws   ! logical for missing data
            6800                         ! .TRUE. no expolation, missing value returned
            6801                         ! .FALSE. expolation enforced, non-missing value returned
            6802                       INTEGER, INTENT(IN):: jl,jrow    ! lonitude index
            6803                       INTEGER  :: jk,kkk
            6804                       real:: ttt,ttt1,sss,sss1,depth
            6805                     
            6806     1                 IF(lwarning_msg.GE.4) then
            6807     1                   WRITE(nerr,*) ", I am in interpolation_ocaf"
            6808     1                 ENDIF
            6809                       IF (.NOT.locaf) RETURN
            6810                     !!!  CALL pzcord(jl,jrow)  ! bjt 2010/2/21
            6811                     !!
            6812                     !! Note that the vertical index of g3b starts from 1 although the index in the sit_vdiff
            6813                     !!   routine starts from 1,
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            6814     1  pp             DO jk=0,nle+1
            6815     1   p               depth=(pwlvl(jl)-z(jk))
            6816     1                   !! initialized the water profile according to world ocean altas data (woa) data
            6817     1   p               kkk=1
            6818     2   p               DO WHILE ( (wdepths(kkk).LE.depth) .AND. (kkk.LT.nwdepth) )
            6819     2   p                  kkk=kkk+1
            6820     2   p               END DO
            6821     1   p               IF (kkk.GT.1) kkk=kkk-1  ! restore back one layer
            6822     2   p               IF (  &
            6823     2                        (wtfn12(jl,kkk,jrow,nmw1).NE.xmissing) .AND. &
            6824     2                        (wtfn12(jl,kkk,jrow,nmw2).NE.xmissing) .AND. &
            6825     2                        (wtfn12(jl,kkk+1,jrow,nmw1).NE.xmissing) .AND. &
            6826     2                        (wtfn12(jl,kkk+1,jrow,nmw2).NE.xmissing) .AND. &
            6827     2                        (wsfn12(jl,kkk,jrow,nmw1).NE.xmissing) .AND. &
            6828     2                        (wsfn12(jl,kkk,jrow,nmw2).NE.xmissing) .AND. &
            6829     2                        (wsfn12(jl,kkk+1,jrow,nmw1).NE.xmissing) .AND. &
            6830     2                        (wsfn12(jl,kkk+1,jrow,nmw2).NE.xmissing) ) THEN
            6831     2   p                 ttt=wgt1*wtfn12(jl,kkk,jrow,nmw1)+wgt2*wtfn12(jl,kkk,jrow,nmw2)
            6832     2   p                 ttt1=wgt1*wtfn12(jl,kkk+1,jrow,nmw1)+wgt2*wtfn12(jl,kkk+1,jrow,nmw2)
            6833     2   p                 sss=wgt1*wsfn12(jl,kkk,jrow,nmw1)+wgt2*wsfn12(jl,kkk,jrow,nmw2)
            6834     2   p                 sss1=wgt1*wsfn12(jl,kkk+1,jrow,nmw1)+wgt2*wsfn12(jl,kkk+1,jrow,nmw2)
            6835     3   p                 IF ( (depth.LE.wdepths(nwdepth)) ) THEN
            6836     3                     ! depth < max. obs. depth
            6837     3                     ! linearly interpolation (no extrapolation)
            6838     3   p                   pawtfl(jl,jk)=ttt+ &
            6839     3                         (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (ttt1-ttt)
            6840     3   p                   pawsfl(jl,jk)=sss+ &
            6841     3                         (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6842     3   p                 ELSE
            6843     3                     ! depth > max obs. depth
            6844     3                     ! water temperature flux
            6845     4   p                   IF (l_no_expolation_wt) THEN
            6846     4                       ! no extrapolation
            6847     4   p                     pawtfl(jl,jk)=0.
            6848     4   p                   ELSE
            6849     4                       ! extrapolation
            6850     4   p                     pawtfl(jl,jk)=ttt+ &
            6851     4                            (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (ttt1-ttt)
            6852     4   p                   ENDIF
            6853     3                     ! water salinity flux
            6854     4   p                   IF (l_no_expolation_ws) THEN
            6855     4                       ! no extrapolation
            6856     4   p                     pawsfl(jl,jk)=0.
            6857     4   p                   ELSE
            6858     4                       ! extrapolation
            6859     4   p                     pawsfl(jl,jk)=sss+ &
            6860     4                            (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6861     4   p                   ENDIF
            6862     3   p                 ENDIF
            6863     2   p               ELSE
            6864     3   p                 IF (l_no_expolation_wt) THEN
            6865     3                       ! no extrapolation
            6866     3   p                   pawtfl(jl,jk)=0.
            6867     3   p                 ELSE
            6868     3   p                   pawtfl(jl,jk)=0.
            6869     3   p                 ENDIF
            6870     3   p                 IF (l_no_expolation_ws) THEN
            6871     3                       ! no extrapolation
            6872     3   p                   pawsfl(jl,jk)=0.
            6873     3   p                 ELSE
            6874     3   p                   pawsfl(jl,jk)=0.
            6875     3   p                 ENDIF
            6876     2   p               ENDIF
            6877     1   p             ENDDO
            6878     1                 IF (GDCHK2) then
            6879     2                   DO jk=1,nle
            6880     2                     WRITE(nerr,*) 'pe=',mpp_pe(),',jl=',jl,',z=',z(jk),',pawtfl=',pawtfl(jl,jk),',pawsfl=',pawsfl(jl,jk)
            6881     2                   ENDDO
            6882     1                   WRITE(nerr,*) "I am leaving interpolation_ocaf"
            6883     1                 ENDIF
            6884                       END SUBROUTINE interpolation_ocaf
            6885                     
            6886                     ! **********************************************************************
            6887                       SUBROUTINE interpolation_ocaf0(jl,jrow,l_no_expolation_wt,l_no_expolation_ws)
            6888                     !
            6889                     !     input
            6890                     !      real:: wtfn12, wsfn12
            6891                     !     output
            6892                     !      real:: awtfl0(0:lkvl+1),awsfl(0:lkvl+1)
            6893                     
            6894                       USE mod_sst,       ONLY: nmw1, nmw2, wgt1, wgt2
            6895                       USE mod_sit_control,       ONLY: locaf0
            6896                     !!!  USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            6897                       USE mod_sst,           ONLY: nwdepth, wdepths, wtfn1st, mask1st
            6898                     
            6899                     
            6900                       IMPLICIT NONE
            6901                       LOGICAL, INTENT(IN):: l_no_expolation_wt   ! logical for missing data
            6902                       LOGICAL, INTENT(IN):: l_no_expolation_ws   ! logical for missing data
            6903                         ! .TRUE. no expolation, missing value returned
            6904                         ! .FALSE. expolation enforced, non-missing value returned
            6905                       INTEGER, INTENT(IN):: jl,jrow    ! lonitude index
            6906                       INTEGER  :: jk,kkk
            6907                       real:: ttt,ttt1,sss,sss1,depth
            6908                     
            6909     1                 IF(lwarning_msg.GE.4) then
            6910     1                   WRITE(nerr,*) ", I am in interpolation_ocaf"
            6911     1                 ENDIF
            6912                       IF (.NOT.locaf0) RETURN
            6913                     !!   routine starts from 1,
            6914                     !ps  DO jk=0,nle+1
            6915                     !ps    depth=(pwlvl(jl)-z(jk))
            6916                     !ps    !! initialized the water profile according to world ocean altas data (woa)
            6917                     !ps    !data
            6918                     !ps    kkk=1
            6919                     !ps    DO WHILE ( (wdepths(kkk).LE.depth) .AND. (kkk.LT.nwdepth) )
            6920                     !ps       kkk=kkk+1
            6921                     !ps    END DO
            6922                     !ps    IF (kkk.GT.1) kkk=kkk-1  ! restore back one layer
            6923                     !ps    IF (  &
            6924                     !ps         (wtfn0(jl,kkk,jrow).NE.xmissing) .AND. &
            6925                     !ps         (wtfn0(jl,kkk+1,jrow).NE.xmissing) .AND. &
            6926                     !ps         (wsfn0(jl,kkk,jrow).NE.xmissing) .AND. &
            6927                     !ps         (wsfn0(jl,kkk+1,jrow).NE.xmissing) ) THEN
            6928                     !ps      ttt=wtfn0(jl,kkk,jrow)
            6929                     !ps      ttt1=wtfn0(jl,kkk+1,jrow)
            6930                     !ps      sss=wsfn0(jl,kkk,jrow)
            6931                     !ps      sss1=wsfn0(jl,kkk+1,jrow)
            6932                     !ps      IF ( (depth.LE.wdepths(nwdepth)) ) THEN
            6933                     !ps      ! depth < max. obs. depth
            6934                     !ps      ! linearly interpolation (no extrapolation)
            6935                     !ps        pawtfl0(jl,jk)=ttt+ &
            6936                     !ps          (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (ttt1-ttt)
            6937                     !ps        pawsfl0(jl,jk)=sss+ &
            6938                     !ps          (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6939                     !ps      ELSE
            6940                     !ps      ! depth > max obs. depth
            6941                     !ps      ! water temperature flux
            6942                     !ps        IF (l_no_expolation_wt) THEN
            6943                     !ps        ! no extrapolation
            6944                     !ps          pawtfl0(jl,jk)=0.
            6945                     !ps        ELSE
            6946                     !ps        ! extrapolation
            6947                     !ps          pawtfl0(jl,jk)=ttt+ &
            6948                     !ps             (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))*(ttt1-ttt)
            6949                     !ps        ENDIF
            6950                     !ps      ! water salinity flux
            6951                     !ps        IF (l_no_expolation_ws) THEN
            6952                     !ps        ! no extrapolation
            6953                     !ps          pawsfl0(jl,jk)=0.
            6954                     !ps        ELSE
            6955                     !ps        ! extrapolation
            6956                     !ps          pawsfl0(jl,jk)=sss+ &
            6957                     !ps             (depth-wdepths(kkk))/(wdepths(kkk+1)-wdepths(kkk))* (sss1-sss)
            6958                     !ps        ENDIF
            6959                     !ps      ENDIF
            6960                     !ps    ELSE
            6961                     !ps      IF (l_no_expolation_wt) THEN
            6962                     !ps        ! no extrapolation
            6963                     !ps        pawtfl0(jl,jk)=0.
            6964                     !ps      ELSE
            6965                     !ps        pawtfl0(jl,jk)=0.
            6966                     !ps      ENDIF
            6967                     !ps      IF (l_no_expolation_ws) THEN
            6968                     !ps        ! no extrapolation
            6969                     !ps        pawsfl0(jl,jk)=0.
            6970                     !ps      ELSE
            6971                     !ps        pawsfl0(jl,jk)=0.
            6972                     !ps      ENDIF
            6973                     !ps    ENDIF
            6974                     !ps  ENDDO
            6975                       pawtfl0(jl,0)=wtfn1st(jl,1,jrow)
            6976     1                 IF (GDCHK3) then
            6977     2                   DO jk=0,0
            6978     2                     WRITE(nerr,*)'pe=',mpp_pe(),',jl=',jl,',z=',z(jk),',pawtfl0=',pawtfl0(jl,jk),',pawsfl0=',pawsfl0(jl,jk)
            6979     2                   ENDDO
            6980     1                   WRITE(nerr,*) "I am leaving interpolation_ocaf0"
            6981     1                 ENDIF
            6982                     
            6983                       END SUBROUTINE interpolation_ocaf0
            6984                     
            6985                     

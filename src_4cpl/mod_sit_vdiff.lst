            7015     3               !        restore_temp=(pobswtb(jl)-pwt(jl,jk))*(1.-fratio)
            7016     3                         restore_temp=(pobswtb(jl)-pwt(jl,jk))*(1.-fratio)+restore_temp*fratio
            7017     3                       ENDIF
            7018     2                     ENDIF
            7019     1                   ELSEIF ((pobswtb(jl).NE.xmissing).AND.(st_restore_time.EQ.0.)) THEN
            7020     1                     restore_temp=(pobswtb(jl)-pwt(jl,jk))
            7021     1                   ELSEIF ((st_restore_time.LT.0.)) THEN
            7022     1                     restore_temp=0.
            7023     1                   ELSE
            7024     1                     ! no pobswtb data
            7025     2                     IF (.NOT.ldeep_water_nudg) THEN
            7026     2                     ! no nudging
            7027     2                       restore_temp=0.
            7028     2                     ELSE
            7029     2                     ! assuming restore_temp to that of previous level
            7030     2                     ENDIF
            7031     1                   ENDIF
            7032                     
            7033                     
            7034     1                   IF ((pobswsb(jl).NE.xmissing).AND.(ss_restore_time.GT.0.)) THEN

            7556     3                       IF (lgodas .OR. lwoa0) THEN
            7557     4                         IF ((pobswt(jl,jk).NE.xmissing).AND.(st_restore_time.GT.0.)) THEN
            7558     4                           restore_temp=(pobswt(jl,jk)-pwt(jl,jk))*(1.-0.5**(zdtime/st_restore_time))
            7559     4                           ! obsws  vertical index start at 1
            7560     4                         ELSEIF ((pobswt(jl,jk).NE.xmissing).AND.(st_restore_time.EQ.0.)) THEN
            7561     4                           restore_temp=(pobswt(jl,jk)-pwt(jl,jk))
            7562     4                         ELSEIF (st_restore_time.LT.0.) THEN
            7563     4                         !! no nudging

            6987                       SUBROUTINE nudging_sit_viff_gd_sfc(jl,jk,st_restore_time,ss_restore_time,restore_temp,restore_salt &
            6988                                                          ,suv_restore_time,restore_u,restore_v,fratio    &
            6989                                                          ,st_restore_time_all,ss_restore_time_all,suv_restore_time_all)
            6990                         IMPLICIT NONE

            7652     1               !ps      call random_number(urand)
            7653     1               !ps      urand=0.01*(urand*2.-1.)      !-0.05<=urand<0.05
            7654     1               !ps      pwu(jl,jk)=pwu(jl,jk)*(1.+urand)

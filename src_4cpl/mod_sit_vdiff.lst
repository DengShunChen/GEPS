            2431                       real,PARAMETER::emin=1.0E-6 !limit min pwtke to 1.0E-6 (v9.865, v9.885) (1.0E-6 in GASPAR ET AL., 1990)
            2432                     !  real,PARAMETER::emin=1.0E-4 !limit min pwtke to 1.0E-4 (v9.866),(v9.868)
            2433                     !  real,PARAMETER::emin=1.0E-5 !limit min pwtke to 1.0E-5 (v9.867) (v9.873)
            2434                       real,PARAMETER::xkmmin=1.2E-6     ! molecular momentum diffusivity (Paulson and Simpson, 1981; Chia and pwu, 1998; Mellor and Durbin, 1975)
            2435                       real,PARAMETER::xkhmin=1.34E-7    ! molecular heat diffusivity (Paulson and Simpson, 1981; Chia and pwu, 1998; Mellor and Durbin, 1975)
            2436                     !  real,PARAMETER::hcoolskin=4.E-4 ! thickness of conductive sublayer (m), where only molecular transfer exists (m) (Khundzuha et al., 1977; Paulson and Simpson, 1981)
            2437                     !ps  real,PARAMETER::d0=0.03  ! zero-displacement (m) (0.02,0.05) (v0.9871)

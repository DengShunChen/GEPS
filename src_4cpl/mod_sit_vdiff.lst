             448                     
             449                     !!!  real,PARAMETER::emin=0. !limit min pwtke to 0. to avoid too warm below mixing depth (20090710) (v5.4)(v9.913)
             450                       real,PARAMETER:: emin=1.0E-6 !limit min pwtke to 1.0E-6 (v9.865, v9.885) (1.0E-6 in GASPAR ET AL., 1990)
             451                     !  real,PARAMETER:: emin=1.0E-4 !limit min pwtke to 1.0E-4 (v9.866),(v9.868)
             452                     !  real,PARAMETER:: emin=1.0E-5 !limit min pwtke to 1.0E-5 (v9.867) (v9.873)
             453                       real,PARAMETER:: xkmmin=1.2E-6     ! molecular momentum diffusivity (Paulson and Simpson, 1981; Chia and pwu, 1998; Mellor and Durbin, 1975)
             454                       real,PARAMETER:: xkhmin=1.34E-7    ! molecular heat diffusivity (Paulson and Simpson, 1981; Chia and pwu, 1998; Mellor and Durbin, 1975)
             455                     !ps  real,PARAMETER:: e_mixing=1.0E-1      ! default ini TKE within mixing depth (1.0E-3=still some spikes)
             456                       real,PARAMETER:: e_mixing=1.0E-4      ! default ini TKE within mixing depth (1.0E-3=still some spikes)
             457                       real,PARAMETER:: wlmx_mixing=50.      ! default ini wlmx within mixing depth (50 m)
             458                       real,PARAMETER:: pwldisp_mixing=50.   ! default ini wldisp within mixing depth (50 m)
             459                       real,PARAMETER:: xkm_mixing=1.0E-1    ! default ini km within mixing depth (1E-3 m2/s=still some spikes)
             460                       real,PARAMETER:: xkh_mixing=1.0E-1    ! default ini kh within mixing depth  (1E-3 m2/s=still some spikes)

            7565     4                         ELSE
            7566     5                           IF (.NOT.ldeep_water_nudg) THEN
            7567     5                             restore_temp=0.
            7568     5                           ELSE
            7569     5                           !! no pobswt data, assume restore_temp to be that of the previous level
            7570     5                           ENDIF
            7571     4                         ENDIF
            7572     4                         IF ((pobsws(jl,jk).NE.xmissing).AND.(ss_restore_time.GT.0.)) THEN
            7573     4                           restore_salt=(pobsws(jl,jk)-pws(jl,jk))*(1.-0.5**(zdtime/ss_restore_time))
            7574     4                           ! obsws  vertical index start at 1
            7575     4                         ELSEIF ((pobsws(jl,jk).NE.xmissing).AND.(ss_restore_time.EQ.0.)) THEN
            7576     4                           restore_salt=(pobsws(jl,jk)-pws(jl,jk))
            7577     4                         ELSEIF (ss_restore_time.LT.0.) THEN
            7578     4                           restore_salt=0.

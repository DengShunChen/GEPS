            2391                       INTEGER nls ! first water level -1,
            2392                                   ! starting water level of the water body point.
            2393                                   ! z(k)=sitwlvl, IF k is <= nls.
            2394                       INTEGER nle ! nle: last water level (excluding skin level)
            2395                                   ! nle: maximum water levels of the water body point.
            2396                                   ! Note nle=-1 IF water level is below point water body bed.
            2397                                   ! Soil layer always is sitwt(nle+1). If there is no water,
            2398                                   ! sitwt(nle+1)=sitwt(0,jrow). In addition, z(k)=bathy IF k >= nle.
            2399                       !!! INTEGER nlv ! number of water levels (excluding water surface &
            2400                       !!!             ! soil layer). Note nlv=-1 IF water level is below
            2401                       !!!             ! water bed.
            2402                       real, DIMENSION(0:lkvl+1):: z   ! coordinates of the water body point.
            2403                       real, DIMENSION(0:lkvl+1):: zlk ! standard z coordinates of a water body
            2404                       real, DIMENSION(0:lkvl):: hw    ! thickness of each layer
            2405                       LOGICAL lshlw  ! .true. = shallow water mode (due to evaportion or freezing)
            2406                                   ! (one layer water body)
            2407                       LOGICAL lsoil  ! .true. = soil grid

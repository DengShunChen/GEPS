            7094     1                   ENDIF
            7095                     
            7096                         lrestore_mix=.false.
            7097     1                   IF (nsit_nudg .GE. 1) THEN
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 122
                                   <<< Loop-information  End >>>
            7098     2  pp    s            DO isit_nudg= 1, nsit_nudg
            7099     3   p    m              IF( (plon(jl) .GE. sitbox_nudg_w(isit_nudg)) .AND. &
            7100     3                               (plon(jl) .LT. sitbox_nudg_e(isit_nudg)) .AND. &

            7159     2                     ENDIF
            7160     1               
            7161     2                     IF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time_all.GT.0.)) THEN
            7162     2                        restore_u2=(pobswu(jl,jk)-pwu(jl,jk))*(1.-0.5**(zdtime/suv_restore_time_all))
            7163     3                        IF(ltimeblending .AND. timebl_option .EQ. 1) THEN
            7164     3               !           restore_u2=(pobswu(jl,jk)-pwu(jl,jk))*(1.-fratio)
            7165     3                          restore_u2=(pobswu(jl,jk)-pwu(jl,jk))*(1.-fratio)+restore_u2*fratio
            7166     3                        ENDIF
            7167     2                     ELSEIF ((pobswu(jl,jk).NE.xmissing).AND.(suv_restore_time_all.EQ.0.)) THEN
            7168     2                        restore_u2=(pobswu(jl,jk)-pwu(jl,jk))
            7169     2                     ELSEIF ((suv_restore_time_all.LT.0.)) THEN

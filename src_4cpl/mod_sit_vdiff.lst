            7658     1               !ps      ENDIF
            7659     1               
            7660     1               !     calc acc. nudging flux (positive into the water column)
            7661     1               !     Note that energy in skin layer (jk=0) has been accounted in the first water layer (jk=1)
            7662     1               !ps      IF ((jk.NE.0).AND.(hw(jk).NE.xmissing)) THEN
            7663     1               !ps
            7664     1               !      IF(GDCHK3) then
            7665     1               !        WRITE(nerr,*) "before,myrank=",myrank,",pwtfn(",jl,",",jk,")=",pwtfn(jl,jk)&
            7666     1               !                ,",restore_temp=",restore_temp,"pawtfl(jl,jk)=",pawtfl(jl,jk)&
            7667     1               !                ,",zdtime=",zdtime,",pobswt(jl,jk)=",pobswt(jl,jk)&
            7668     1               !                ,"pwt(jl,jk)=",pwt(jl,jk),"st_restore_time=",st_restore_time
            7669     1               !      ENDIF
            7670     1               !ps
            7671     1                       pwtfn(jl,jk)=pwtfn(jl,jk)+restore_temp+pawtfl(jl,jk)*zdtime           ! v9.8 including added pawtfl
            7672     1                       pwsfn(jl,jk)=pwsfn(jl,jk)+restore_salt+pawsfl(jl,jk)*zdtime           ! v9.8 including added pawsfl
            7673     1                       pwtfn0(jl,jk)=pwtfn0(jl,jk)+restore_temp                              ! v9.8 including added pawtfl
            7674     1                       pwsfn0(jl,jk)=pwsfn0(jl,jk)+restore_salt                              ! v9.8 including added pawsfl
            7675     1               !ps      ENDIF
            7676     1               !ps
            7677     2                     IF(GDCHK2) then
            7678     2                       WRITE(nerr,*) "after,myrank=",myrank,",pwtfn(",jl,",",jk,")=",pwtfn(jl,jk) &
            7679     2                                    ,",pawtfl=",pawtfl(jl,jk)
            7680     2                       WRITE(nerr,*) "after,myrank=",myrank,",pwtfn0(",jl,",",jk,")=",pwtfn0(jl,jk)
            7681     2                     ENDIF
            7682     1               !ps
            7683     1                     jk=jk+1
            7684     1                   END DO
            7685                     
            7686     1                   IF (GDCHK2) then
            7687     1                      WRITE(nerr,*) "I am leaving nudging_sit_viff_gd"
            7688     1                   ENDIF
            7689                       END SUBROUTINE nudging_sit_viff_gd
            7690                       ! ----------------------------------------------------------------------
            7691                       SUBROUTINE output2
            7692                       !!!! A DUPLICATE VERSION of sit_vdiff_init
            7693                       !
            7694                       !-----------------------------------------------------------------
            7695                       !
            7696                       !*    OUTPUT: WRITE DIAGNOSTIC VARIABLES
            7697                       !
            7698                       !-----------------------------------------------------------------
            7699                         !!! USE mo_mpi,           ONLY: mpp_pe()
            7700                         IMPLICIT NONE
            7701                     
            7702                         INTEGER jk
            7703                         real:: tmp
            7704                     
            7705                       !
            7706                       !!!  CALL pzcord(jl,jrow)   ! bjt 2010/02/21
            7707                         WRITE(nerr,*) "kbdim=", kbdim, "kproma=",kproma
            7708     1                   IF (nle.GE.1) THEN
            7709     1                 !     water exists
            7710     1                     WRITE(nerr,*) "Water exist, nle=", nle
            7711     1                   ELSE
            7712     1                 !     soil only
            7713     1                     WRITE(nerr,*) "Soil only, nle=", nle
            7714     1                   ENDIF
            7715                         WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","","","we,","lw,","tsi0,","tsi1,","","","obswtb,","ptsw,"
            7716                         WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,0,0.,pzsi(jl,0),psilw(jl,0),&
            7717                       &  ptsnic(jl,0),ptsnic(jl,1),0.,0.,pobswtb(jl),ptsw(jl)
            7718                     
            7719                         WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,1,1.,pzsi(jl,1),psilw(jl,1),&
            7720                       &  ptsnic(jl,2),ptsnic(jl,3),0.,0.,pobswtb(jl),ptsw(jl)
            7721                       !
            7722                         WRITE(nerr,2300) "pe,","jl,","row,","lat,","lon,","step,","k,","z,", "wt,", "ws,", "wu,", "wv,",&
            7723                       &  "wtke,", "wkh,","wldisp,","wlmx,","awtfl,","awtfl0,","awufl,","awvfl,","awsfl,","awtkefl,","obswt,",",rhom,","sftobswt,"
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhom, z
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            7724     1   s    s          DO jk = 0, nle+1
            7725     1   m    m            WRITE(nerr,2301) mpp_pe(),jl,jrow,plat(jl),plon(jl),istep,jk,z(jk),&
            7726     1                 &     pwt(jl,jk),pws(jl,jk),pwu(jl,jk),pwv(jl,jk),&
            7727     1                 &     pwtke(jl,jk),pwkh(jl,jk),pwldisp(jl,jk),pwlmx(jl,jk), &
            7728     1                 &     pawtfl(jl,jk)*1000.,pawtfl0(jl,jk),pawufl(jl,jk)*1000.,pawvfl(jl,jk)*1000.,pawsfl(jl,jk)*1000.,pawtkefl(jl,jk), &
            7729     1                 &     pobswt(jl,jk),rhom(jk),psftobswt(jl,jk)
            7730     1   p    v          END DO
            7731                     
            7732                       !
            7733                         RETURN
            7734                       !
            7735                        2200 FORMAT(1X,3(A4),2(A9),1(A4),2(2(A10),2(A9)),1(A9), 1(A10))
            7736                       !ps 2201 FORMAT(1X,4(I3,","),1(I9,","),2(2(E9.2,","),2(F8.3,",")),&
            7737                        2201 FORMAT(1X,3(I3,","),2(F8.2,","),1(I3,","),4(F10.3,","),1(I9,","),2(2(E9.2,","),2(F8.3,",")),&
            7738                       &       1(F8.3,","), 1(E10.3,","))
            7739                       !
            7740                     !ps   2300 FORMAT(1X,4A4,     1A10,1A4,1A11,4A9,2A10,10A9)
            7741                           2300 FORMAT(1X, A4,A5,A4,2A8,A6,A4,1A11,4A9,2A10,11A9)
            7742                       !ps 2301 FORMAT(1X,4(I3,","),1(I9,","),1(I3,","),1(F10.4,","),1(F8.3,","),2(F8.4,","),&
            7743                       !!! 2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),1(F8.3,","),1(F8.4,","),&
            7744                       !!!&       2(F8.3,","),2(E9.2,","),10(F8.3,","))
            7745                     !ps   2301 FORMAT(1X,3(I3,","),2(F8.2,","),2(I3,","),1(F10.0,","),1(F8.3,","),1(F8.3,","),&
            7746                     !ps  &       2(F8.2,","),2(E9.2,","),10(F8.3,","))
            7747                           2301 FORMAT(1X,(I3,","),(I4,","),(I3,","),2(F7.2,","),(I5,","),(I3,","),1(F10.4,","),1(F8.3,","),1(F8.4,","),&
            7748                       &       2(F8.4,","),2(E9.2,","),11(F8.3,","))
            7749                       !
            7750                       END SUBROUTINE output2
            7751                     END SUBROUTINE sit_vdiff
            7752                     ! **********************************************************************
            7753                     
            7754                     !!!  SUBROUTINE sit_vdiff_end (Sit)
            7755                       SUBROUTINE sit_vdiff_end ()
            7756                         IMPLICIT NONE
            7757                         !!! type (sit_vdiff_data_type), intent(inout) :: Sit
            7758                         integer           :: k
            7759                         integer           :: unit
            7760                         character(len=22) :: restart='RESTART/sit_vdiff.res'
            7761                     
            7762                         !!!if (conservation_check) then
            7763                         !!!   do k=1,4
            7764                         !!!      CALL mpp_sum(h2o(k))
            7765                         !!!      CALL mpp_sum(heat(k))
            7766                         !!!   end do
            7767                         !!!   if (mpp_pe()==mpp_root_pe()) then
            7768                         !!!      print *
            7769                         !!!      print '(a10,5a13)',   'ICE MODEL ','   AT START  ', &
            7770                         !!!           ' TOP FLUX DN.', &
            7771                         !!!           ' BOT FLUX DN.', &
            7772                         !!!           '   AT END    ', &
            7773                         !!!           '   ERROR     '
            7774                         !!!      print '(a10,5es13.5)','WATER     ', h2o , h2o (4)-(h2o (1)+h2o (2)-h2o (3))
            7775                         !!!      print '(a10,5es13.5)','HEAT      ', heat, heat(4)-(heat(1)+heat(2)-heat(3))
            7776                         !!!      print *
            7777                         !!!   end if
            7778                         !!!end if
            7779                     
            7780                         CALL sit_vdiff_restart()
            7781                     
            7782                         !--- release memory ------------------------------------------------
            7783                     
            7784                     
            7785                         !!!! Interpolation array
            7786                         !!!!nxj,                    !  nxj      : number of local longitudes (echam, =nproma=nbdim)
            7787                         !!!!!!  gauss grid description
            7788                         !!!!krow,                   !  krow     : sequential index (=1)
            7789                         !!!!!! - water body or ml_ocean variables
            7790                         !!!!echam, check GFS    DEALLOCATE (Sit%slm)             !  pslm      : sea land fraction (1. = land, 0. = sea/lakes)
            7791                         !!!!echam, check GFS    DEALLOCATE (Sit%seaice)          !  pseaice   : ice cover (fraction of 1-SLM) (0-1)                                                I/O
            7792                         !!!!echam, check GFS    DEALLOCATE (Sit%alake)           !  palake    : lake fraction of grid box
            7793                         !!!!echam, check GFS    DEALLOCATE (Sit%sni)             !  psni      : snow thickness over ice (m in water equivalent)                                    I/O
            7794                         !!!!echam, check GFS    DEALLOCATE (Sit%siced)           !  psiced    : ice thickness (m in water equivalent)                                              I/O
            7795                         !!!!echam, check GFS    DEALLOCATE (Sit%tsi)             !  ptsi      : surface temperature of ice (K)
            7796                         !!!!echam, check GFS    DEALLOCATE (Sit%tsw)             !  ptsw      : skin temperatrue (K) over water                                                    O
            7797                         !!!!echam, check GFS    DEALLOCATE (Sit%ssw)             !  pssw      : skin salinity (PSU) over water                                                    O
            7798                         !!!!echam, check GFS    DEALLOCATE (Sit%tsl)             !  ptsl      : calcuated Earth's skin temperature from vdiff/tsurf at t+dt (K)                    I/O
            7799                         !!!!echam, check GFS    DEALLOCATE (Sit%tslm)            !  ptslm     : calcuated Earth's skin temperature from vdiff/tsurf at t (K)                       I/O
            7800                         !!!!echam, check GFS    DEALLOCATE (Sit%tslm1)           !  ptslm1    : calcuated Earth's skin temperature from vdiff/tsurf at t-dt (K)                    I/O
            7801                         !!!!echam, check GFS    DEALLOCATE (Sit%fluxw)           !  pfluxw    : net surface energy flux over open water per water fraction                         I
            7802                         !!!!echam, check GFS                                 !              (icesheet+openwater) (w/m2) (positive upward)
            7803                         !!!!echam, check GFS                                 !              = -(net solar + net longwave - sensible heat - latent heat)
            7804                         !!!!echam, check GFS    DEALLOCATE (Sit%dfluxs)          !  pdfluxs   : dG/dT (W/m2/K) (positive upward)                                                   I
            7805                         !!!!echam, check GFS    DEALLOCATE (Sit%soflw)           !  psoflw    : net SW flux over open water per water fraction (w/m2) (positive downward)          I
            7806                         !!!!echam, check GFS    DEALLOCATE (Sit%fluxi)           !  pfluxi    : net surface energy flux over icesheet per water fraction                           I
            7807                         !!!!echam, check GFS                                 !              (icesheet+openwater) (w/m2) (positive upward)
            7808                         !!!!echam, check GFS                                 !              = -(net solar + net longwave - sensible heat - latent heat)
            7809                         !!!!echam, check GFS    DEALLOCATE (Sit%sofli)           !  psofli    : net SW flux over over icesheet per water fraction (w/m2) (positive downward)       I
            7810                         !!!!echam, check GFS
            7811                         !!!!echam, check GFS!!! 2-d SIT vars
            7812                         !!!!echam, check GFS    DEALLOCATE (Sit%disch)           !  pdisch   : surface runoff into ocean (m/s)                                                     I
            7813                         !!!!echam, check GFS    DEALLOCATE (Sit%ustrw)           !  taucx    : u-stress (Pa) over water at current time step                                       I/O
            7814                         !!!!echam, check GFS                                 !              (set to zero if snow/ice on top)
            7815                         !!!!echam, check GFS    DEALLOCATE (Sit%vstrw)           !  taucy    : v-stress (Pa) over water at current time step                                       I
            7816                         !!!!echam, check GFS                                 !              (set to zero if snow/ice on top)
            7817                         !!!!echam, check GFS    DEALLOCATE (Sit%temp2)           !  ptemp2    : 2 m temperature (K) at current time step                                           I
            7818                         !!!!echam, check GFS    DEALLOCATE (Sit%wind10w)         !  pwind10w     : 10m windspeed over water (m/s)                                                  I
            7819                         !!!!echam, check GFS    DEALLOCATE (Sit%ocu)             !  pocu      : ocean eastw. velocity (m/s)                                                        O
            7820                         !!!!echam, check GFS    DEALLOCATE (Sit%ocv)             !  pocv      : ocean northw. velocity (m/s)                                                       O
            7821                         !!!
            7822                         !!!!!! 2-d SIT vars (sit variable, allocate as 2D)
            7823                         !!!DEALLOCATE (Sit%obsseaice)       !  pobsseaice  : observed sea ice fraction (fraction)                                             I
            7824                         !!!DEALLOCATE (Sit%obstsw)          !  pobswtb     : observed bulk sea surface temperature (K)                                        I
            7825                         !!!DEALLOCATE (Sit%obswsb)          !  pobswsb    : observed salinity (PSU, 0/00)                                                     I
            7826                         !!!DEALLOCATE (Sit%sitmask)         !  psitmask : mask for sit(1=.TRUE., 0=.FALSE.                                                    I
            7827                         !!!DEALLOCATE (Sit%bathy)           !  pbathy  : bathymeter (topography or orography) of ocean (m)                                    I
            7828                         !!!DEALLOCATE (Sit%ctfreez2)        !  pctfreez2 : ref water freezing temperature (K)                                                 I
            7829                         !!!DEALLOCATE (Sit%wlvl)         !  pwlvl  : current water level (ice/water interface) a water body grid                           I/O
            7830                         !!!DEALLOCATE (Sit%ocnmask)         !  pocnmask : fractional mask for 3-D ocean grid (0-1)                                            I
            7831                         !!!DEALLOCATE (Sit%obox_mask)       !  obox_mask : 3-D ocean nudging mask, =0: nudging, = 1 (>0): nudging                             I
            7832                         !!!DEALLOCATE (Sit%wtb)          !  pwtb: bulk water temperature (K)                                                               O
            7833                         !!!DEALLOCATE (Sit%wub)          !  pwub: bulk water u current (m/s)                                                               O
            7834                         !!!DEALLOCATE (Sit%wvb)          !  pwvb: bulk water v current (m/s)                                                               O
            7835                         !!!DEALLOCATE (Sit%wsb)          !  pwsb: bulk water salinity (PSU)                                                                O
            7836                         !!!DEALLOCATE (Sit%fluxiw)          !  pfluxiw: over-water net surface heat flux (W/m2, + upward, i.e., from ocean))                  O
            7837                         !!!DEALLOCATE (Sit%pme2)            !  ppme2: net fresh water into ocean (P-E+ice_corr) (m/s, + downward)                             O
            7838                         !!!DEALLOCATE (Sit%subfluxw)        !  psubfluxw: subsurface ocean heat flux (W/m2, + upward)                                         O
            7839                         !!!DEALLOCATE (Sit%wsubsal)         !  pwsubsal: subsurface ocean salinity flux (m*PSU/s, + upward)                                   O
            7840                         !!!DEALLOCATE (Sit%cc)              !  pcc: cold content per water fraction (ice sheet+openwater) (J/m2)
            7841                         !!!                                !    (energy need to melt snow and ice, i.e., energy below liquid water at tmelt)                 I/O
            7842                         !!!DEALLOCATE (Sit%hc)              !  phc: heat content per water fraction (ice sheet+openwater) (J/m2)
            7843                         !!!                                !    (energy of a water column above tmelt)                                                       I/O
            7844                         !!!DEALLOCATE (Sit%engwac)          !  pengwac: accumulated energy per water fraction (ice sheet+openwater) (+ downward, J/m2)
            7845                         !!!                             !           (pfluxw+pfluxi+rain/snow advected energy in respect to liquid water at
            7846                         !!!                             !           tmelt)*dt                                                                             I/O
            7847                         !!!                             !!!  pengw: mean net surface heat flux per water fraction (ice sheet+openwater)
            7848                         !!!                             !!!    (+ downward, W/m2)                                                                         I/O
            7849                         !!!                             !!!  pengw2: mean snow corrected net surface heat flux per water fraction
            7850                         !!!                             !!!    (ice sheet+openwater) (+ downward, W/m2)
            7851                         !!!                             !!!    (pfluxw+pfluxi+rain/snow advected heat flux in respect to liquid water at
            7852                         !!!                             !!!     tmelt)                                                                                    I/O
            7853                         !!!!!!              engw(:,:)engw2(:,:)                              &
            7854                         !!!DEALLOCATE (Sit%sc)              !  psc: salinity content per water fraction (ice sheet+openwater) (PSU*m)                         I/O
            7855                         !!!DEALLOCATE (Sit%saltwac)         !  psaltwac: accumulated salt into water fraction (+ downward, PSU*m)                             I/O
            7856                         !!!
            7857                         !!!! implicit with vdiff
            7858                         !!!!echam, check GFS    DEALLOCATE (Sit%slm)             !  pslm: land fraction [0-1]                                                                      I
            7859                         !!!!echam, check GFS    DEALLOCATE (Sit%grndcapc)        !  pgrndcapc: areal heat capacity of the uppermost sit layer (snow/ice/water)
            7860                         !!!!echam, check GFS                                    !       (J/m**2/K)                                                                                I/O
            7861                         !!!!echam, check GFS    DEALLOCATE (Sit%grndhflx)        !  pgrndhflx: ground heat flux below the surface (W/m**2)
            7862                         !!!!echam, check GFS                                    !          (+ upward, into the skin layer)                                                        I/O
            7863                         !!!!echam, check GFS    DEALLOCATE (Sit%grndflux)        !  pgrndflx:  acc. ground heat flux below the surface (W/m**2*s)
            7864                         !!!                                    !          (+ upward, into the skin layer)                                                        I/O
            7865                         !!!
            7866                         !!!! - 2D from mo_memory_g3b (sit variables, allocate as 3D)
            7867                         !!!DEALLOCATE (Sit%obswt)         !  pobswt: observed potentail water temperature (K)                                          I/O
            7868                         !!!DEALLOCATE (Sit%obsws)         !  pobsws: observed salinity (PSU, 0/00)                                                     I/O
            7869                         !!!DEALLOCATE (Sit%obswu)         !  pobswu: observed u-current (m/s)                                                          I/O
            7870                         !!!DEALLOCATE (Sit%obswv)         !  pobswv: observed v-current (m/s)                                                          I/O
            7871                         !!!DEALLOCATE (Sit%zsi)        !  pzsi  :
            7872                         !!!                           !        pzsi(jl,0): dry snow water equivalent (m)                                           I/O
            7873                         !!!                           !        pzsi(jl,1): dry ice water equivalent (m)                                            I/O
            7874                         !!!DEALLOCATE (Sit%silw)       !  psilw  :
            7875                         !!!                           !        psilw(jl,0): snow liquid water storage (m)                                          I/O
            7876                         !!!                           !        psilw(jl,1): ice liquid water storage (m)                                           I/O
            7877                         !!!DEALLOCATE (Sit%tsi)        !  ptsnic   :
            7878                         !!!                           !        ptsnic(jl,0): snow skin temperatrue (jk)                                            I/O
            7879                         !!!                           !        ptsnic(jl,1): mean snow temperatrue (jk)                                            I/O
            7880                         !!!                           !        ptsnic(jl,2): ice skin temperatrue (jk)                                             I/O
            7881                         !!!                           !        ptsnic(jl,3): mean ice temperatrue (jk)                                             I/O
            7882                         !!!
            7883                         !!!DEALLOCATE (Sit%wt)         !  pwt      : potential water temperature (K)                                                I/O
            7884                         !!!DEALLOCATE (Sit%wu)         !  pwu      : u current (m/s)                                                                I/O
            7885                         !!!DEALLOCATE (Sit%wv)         !  pwv      : v current (m/s)                                                                I/O
            7886                         !!!DEALLOCATE (Sit%ww)         !  pww      : w current (m/s)                                                                I/O
            7887                         !!!DEALLOCATE (Sit%ws)         !  pws      : practical salinity (0/00)                                                      I/O
            7888                         !!!DEALLOCATE (Sit%wtke)       !  pwtke    : turbulent kinetic energy (M2/S2)                                               I/O
            7889                         !!!DEALLOCATE (Sit%wlmx)       !  pwlmx    : mixing length (m)                                                              O
            7890                         !!!DEALLOCATE (Sit%wldisp)     !  pwldisp  : dissipation length (m)                                                         O
            7891                         !!!DEALLOCATE (Sit%wkm)        !  pwkm     : eddy diffusivity for momentum (m2/s)                                           O
            7892                         !!!DEALLOCATE (Sit%wkh)        !  pwkh     : eddy diffusivity for heat (m2/s)                                               O
            7893                         !!!DEALLOCATE (Sit%wrho)          !  pwrho1000: potential temperature at 1000 m (PSU)                                          O
            7894                         !!!DEALLOCATE (Sit%wtfn)          !  pwtfn  : nudging flux into sit-ocean at each level (W/m**2)                               I/O
            7895                         !!!DEALLOCATE (Sit%wsfn)          !  pwsfn  : nudging salinity flux into sit-ocean at each level (PSU*m/s)                     I/O
            7896                         !!!DEALLOCATE (Sit%wtfns)         !  pwtfns : nudging flux into sit-ocean for an entire column (W/m**2), i.e.
            7897                         !!!                           !        pwtfns=SUM(pwtfn(jl,:))                                                             I/O
            7898                         !!!DEALLOCATE (Sit%wsfns)         !  pwsfn  : nudging salinity flux into sit-ocean for an entire column (PSU*m/s),
            7899                         !!!                           !        i.e., pwsfns=SUM(pwsfn(jl,:)                                                        I/O
            7900                         !!!DEALLOCATE (Sit%awufl)         !  pawufl : advected u flux at each level (positive into ocean) (m/s*m/s)                    I
            7901                         !!!DEALLOCATE (Sit%awvfl)         !  pawvfl : advected v flux at each level (positive into ocean) (m/s*m/s)                    I
            7902                         !!!DEALLOCATE (Sit%awtfl)         !  pawtfl : advected temperature flux at each level (positive into ocean) (W/m2)             I
            7903                         !!!DEALLOCATE (Sit%awsfl)         !  pawsfl : advected salinity flux at each level (positive into ocean) (PSU*m/s)             I
            7904                         !!!DEALLOCATE (Sit%awtkefl)       !  pawtkefl : advected tke at each level (positive into ocean) (m3/s3)                       I
            7905                         !!!
            7906                         !!!!!! - variables internal to physics
            7907                         !!!!!!echam, check GFS    DEALLOCATE (Sit%zevapw)        !  pevapw   : evaporation from water surface (kg/m2/s) (positive downward)                   I
            7908                         !!!!!!echam, check GFS    DEALLOCATE (Sit%rsfl)          !  prsfl    : large scale rain flux at the surface (kg/m2/s) (positive downward)             I
            7909                         !!!!!!echam, check GFS    DEALLOCATE (Sit%rsfc)          !  prsfc    : convective rain flux at the surface (kg/m2/s) (positive downward)              I
            7910                         !!!!!!echam, check GFS    DEALLOCATE (Sit%ssfl)          !  pssfl    : large scale snow flux at the surface (kg/m2/s) (positive downward)             I
            7911                         !!!!!!echam, check GFS    DEALLOCATE (Sit%ssfc)          !  pssfc    : convective snow flux at the surface (kg/m2/s) (positive downward)              I
            7912                         !!!!end sit_vdiff variable
            7913                         !#######################################################################
            7914                         CONTAINS
            7915                         !#######################################################################
            7916                         ! <SUBROUTINE NAME="sit_vdiff_restart">
            7917                         ! <DESCRIPTION>
            7918                         !  Write out restart files registered through register_restart_file
            7919                         ! </DESCRIPTION>
            7920                         !SUBROUTINE sit_vdiff_restart(Sit, time_stamp)
            7921                         SUBROUTINE sit_vdiff_restart( time_stamp)
            7922                           IMPLICIT NONE
            7923                           !!! type (sit_vdiff_data_type), intent(inout), optional :: Sit
            7924                           character(len=*),         intent(in), optional :: time_stamp
            7925                     
            7926                           !!! CALL save_restart(Sit_restart, time_stamp)
            7927                          !CALL icebergs_save_restart(Ice%icebergs)
            7928                          ! This should go here but since "Ice" is not available we have to
            7929                          ! rely on the restart written via sit_vdiff_end() -AJA
            7930                     
            7931                         END SUBROUTINE sit_vdiff_restart
            7932                         ! </SUBROUTINE>
            7933                         !#######################################################################
            7934                       END SUBROUTINE sit_vdiff_end
            7935                       !#######################################################################
            7936                     
            7937                       SUBROUTINE init_convect_tables
            7938                     
            7939                         !!! USE sit_constants_mod, ONLY: alv, als, cpd, rd, rv, tmelt, &
            7940                         !!!                         c3les, c3ies, c4les, c4ies, c5les, c5ies
            7941                     
            7942                         real, PARAMETER :: zavl1 = -6096.9385
            7943                         real, PARAMETER :: zavl2 =    21.2409642
            7944                         real, PARAMETER :: zavl3 =    -2.711193
            7945                         real, PARAMETER :: zavl4 =     1.673952
            7946                         real, PARAMETER :: zavl5 =     2.433502
            7947                     
            7948                         real, PARAMETER :: zavi1 = -6024.5282
            7949                         real, PARAMETER :: zavi2 =    29.32707
            7950                         real, PARAMETER :: zavi3 =     1.0613868
            7951                         real, PARAMETER :: zavi4 =    -1.3198825
            7952                         real, PARAMETER :: zavi5 =    -0.49382577
            7953                     
            7954                         real :: z5alvcp, z5alscp, zalvdcp, zalsdcp
            7955                         real :: ztt, zldcp
            7956                         real :: zcvm3, zcvm4, zcvm5
            7957                         real :: zavm1, zavm2, zavm3, zavm4, zavm5
            7958                     
            7959                         INTEGER :: it
            7960                     
            7961                         z5alvcp = c5les*alv/cpd
            7962                         z5alscp = c5ies*als/cpd
            7963                     
            7964                         zalvdcp = alv/cpd
            7965                         zalsdcp = als/cpd
            7966                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tlucuc, tlucua, tlucub, tlucuaw
                                   <<< Loop-information  End >>>
            7967     1  pp    v          DO it = jptlucu1, jptlucu2
            7968     1   p    v            ztt = 0.001*it
            7969     2   p    v            IF ((ztt-tmelt) > 0.0) THEN
            7970     2   p    v              zcvm3 = c3les
            7971     2   p    v              zcvm4 = c4les
            7972     2   p    v              zcvm5 = z5alvcp
            7973     2   p    v              zldcp = zalvdcp
            7974     2   p    v              zavm1 = zavl1
            7975     2   p    v              zavm2 = zavl2
            7976     2   p    v              zavm3 = zavl3
            7977     2   p    v              zavm4 = zavl4
            7978     2   p    v              zavm5 = zavl5
            7979     2   p    v            ELSE
            7980     2   p    v              zcvm3 = c3ies
            7981     2   p    v              zcvm4 = c4ies
            7982     2   p    v              zcvm5 = z5alscp
            7983     2   p    v              zldcp = zalsdcp
            7984     2   p    v              zavm1 = zavi1
            7985     2   p    v              zavm2 = zavi2
            7986     2   p    v              zavm3 = zavi3
            7987     2   p    v              zavm4 = zavi4
            7988     2   p    v              zavm5 = zavi5
            7989     2   p    v            END IF
            7990     1   p    v            tlucuc(it)  = zldcp
            7991     1   p    v            tlucua(it)  = EXP((zavm1/ztt+zavm2+zavm3*0.01*ztt+zavm4*ztt*ztt*1.e-5+zavm5*LOG(ztt)))*rd/rv
            7992     1   p    v            tlucub(it)  = zcvm5*(1.0/(ztt-zcvm4))**2
            7993     1   p    v            tlucuaw(it) = EXP((zavl1/ztt+zavl2+zavl3*0.01*ztt+zavl4*ztt*ztt*1.e-5+zavl5*LOG(ztt)))*rd/rv
            7994     1   p    v          END DO
            7995                     
            7996                       END SUBROUTINE init_convect_tables
            7997                     
            7998                       SUBROUTINE lookuperror (name)
            7999                     
            8000                         !!! USE mo_exception,  ONLY: message, finish
            8001                     
            8002                         CHARACTER(len=*), INTENT(in) :: name
            8003                     
            8004                         ! normal run informs only
            8005                         ! CALL message (name, ' lookup table overflow')
            8006                         ! debug run, so stop at problem
            8007                         !!! CALL finish (name, ' lookup table overflow')
            8008                         WRITE (nerr,*) name, ' lookup table overflow'
            8009                         ! reset lookupoverflow for next test
            8010                     
            8011                         lookupoverflow = .FALSE.
            8012                     
            8013                       END SUBROUTINE lookuperror
            8014                     
            8015                       !#######################################################################
            8016                     
            8017                     
            8018                     SUBROUTINE update_snow_ice_property(swe,iwe,hsn,hesn,hice,heice,seaice)
            8019                       IMPLICIT NONE
            8020                       real, INTENT(IN):: swe    ! snow water equivalent of the grid (m)
            8021                       real, INTENT(IN):: iwe    ! iwe water equivalent of the grid (m)
            8022                       real, INTENT(OUT):: hsn,    & ! physical snow thickness of the grid (m)
            8023                                               hesn,   & ! effictive snow thickness of the grid (m)
            8024                                               hice,   & ! physical ice thickness of the grid (m)
            8025                                               heice,  & ! effective ice thickness of the grid (m)
            8026                                               seaice    ! sea ice fraction of the grid [0-1]
            8027          i            hsn=HSNFN(swe)
            8028          i            hesn=HEFN(hsn/4.,xksn,omegas)
            8029          i            hice=HICEFN(iwe)
            8030          i            heice=HEFN(hice/4.,xkice,omegas)
            8031                       seaice=SEAICEFN(iwe)
            8032                     END SUBROUTINE update_snow_ice_property
            8033                     
            8034                     ! ----------------------------------------------------------------------
            8035                     real FUNCTION HASTRFN(hstr)
            8036                     !*********************
            8037                     ! CALCUL Effective thickness
            8038                     ! h0: physical thickness of the skin layer (m)
            8039                     ! kh: heat diffusivity (m2/s)
            8040                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8041                     ! HEFN: effective thickness of the skin layer (m)
            8042                     !*********************
            8043                       IMPLICIT NONE
            8044                       real:: hstr
            8045                       hastrfn=SQRT( 1.-2.*COS(hstr)*EXP(-hstr)+EXP(-hstr)**2. )/SQRT(2.)
            8046                     END FUNCTION HASTRFN
            8047                     ! ----------------------------------------------------------------------
            8048                     real FUNCTION HEFN(h0,kh,omegas)
            8049                     !*********************
            8050                     ! CALCUL Effective thickness
            8051                     ! h0: physical thickness of the skin layer (m)
            8052                     ! kh: heat diffusivity (m2/s)
            8053                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8054                     ! HEFN: effective thickness of the skin layer (m)
            8055                     !*********************
            8056                       IMPLICIT NONE
            8057                       real:: kh,omegas,h0
            8058                       real:: h_ref,hstr,hastr
            8059                       h_ref=SQRT(2.*kh/omegas)
            8060                       hstr=h0/h_ref
            8061          i            hastr=HASTRFN(hstr)
            8062                       HEFN=h_ref*hastr
            8063                     END FUNCTION HEFN
            8064                     ! ----------------------------------------------------------------------
            8065                     real FUNCTION TASTRFN(hstr)
            8066                     !*********************
            8067                     ! CALCUL Effective thickness
            8068                     ! h0: physical thickness of the skin layer (m)
            8069                     ! kh: heat diffusivity (m2/s)
            8070                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8071                     ! HEFN: effective thickness of the skin layer (m)
            8072                     !*********************
            8073                       USE mod_eos_ocean,    ONLY: api
            8074                       IMPLICIT NONE
            8075                       real:: hstr
            8076                     !!!  TASTRFN=api/4.-ARCTAN( SIN(hstr)*EXP(-hstr)/(1.-Cos(hstr)*EXP(-hstr)) )
            8077                       TASTRFN=api/4.-ATAN( SIN(hstr)/(EXP(hstr)-Cos(hstr)) )
            8078                     END FUNCTION TASTRFN
            8079                     ! ----------------------------------------------------------------------
            8080                     real FUNCTION SSTRFN(zkm1str,zkstr,zkp1str)
            8081                     !*********************
            8082                     ! CALCUL dimensionless elasticity of numerical layer k
            8083                     ! zkm1,zk,zkp1: vertical coordinates of k-1, k, k+1 (m) (positive upward)
            8084                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8085                     ! sstr: dimensionless elasticity
            8086                     ! sstr=s/rhogcg/SQRT(kh*omegas)
            8087                     ! kh: heat diffusivity (m2/s)
            8088                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8089                     !*********************
            8090                       IMPLICIT NONE
            8091                       real, INTENT(in):: zkm1str,zkstr,zkp1str
            8092                       SSTRFN=(1./(zkm1str-zkstr)+1./(zkstr-zkp1str))/SQRT(2.)
            8093                     END FUNCTION SSTRFN
            8094                     ! ----------------------------------------------------------------------
            8095                     real FUNCTION dGdTFN(em,ra,rc,T0,ps,rhoa)
            8096                     !*********************
            8097                     ! CALCUL dG/dT of land surface (W/m2/K)
            8098                     ! em: emissivity of land surface
            8099                     ! ra: aerodynamic resistsnce (s/m)
            8100                     ! rc: canopy resistance (s/m)
            8101                     ! T0: land skin temperature (K)
            8102                     ! ps: surface pressure (Pa)
            8103                     ! rhoa: air density (kg/m3)
            8104                     ! dGdT:
            8105                     !*********************
            8106                       USE mod_eos_ocean,      ONLY: stbo,cpd,alv
            8107                     !!!  USE convect_tables_mod,   ONLY: jptlucu1,jptlucu2,tlucub
            8108                     !!!  USE convect_tables_mod, ONLY : lookuperror, lookupoverflow, jptlucu1    &
            8109                     !!!                              , jptlucu2, tlucua, tlucub, tlucuaw
            8110                       IMPLICIT NONE
            8111                       real, INTENT(in):: em,ra,rc,T0,ps,rhoa
            8112                       INTEGER  :: it
            8113                       real:: dqsatdT
            8114                       it = MAX(MIN(NINT(T0*1000.),jptlucu2),jptlucu1)
            8115                       dqsatdT=0.622*tlucub(it)/ps
            8116                       dGdTFN=4.*em*stbo*T0**3+rhoa*cpd/ra+rhoa*alv/(ra+rc)*dqsatdT
            8117                     END FUNCTION dGdTFN
            8118                     ! ----------------------------------------------------------------------
            8119                     real FUNCTION SSTR0FN(rhogcg,kh,omegas,dGdT,z0str,z1str)
            8120                     !*********************
            8121                     ! CALCUL dimensionless elasticity of numerical layer k
            8122                     ! rhogcg: volume heat capacity (kg/m3*J/kg/K)=(J/m3/K)
            8123                     ! kh: heat diffusivity (m2/s)
            8124                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8125                     ! dGdT:
            8126                     ! z0str,z1str: dimensionless vertical coordinates of k=0, k=1 (positive upward)
            8127                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8128                     ! sstr: dimensionless elasticity
            8129                     ! sstr=s/rhogcg/SQRT(kh*omegas)
            8130                     !*********************
            8131                       IMPLICIT NONE
            8132                       real, INTENT(in):: rhogcg,kh,omegas,dGdT,z0str,z1str
            8133                       SSTR0FN=dGdT/rhogcg/SQRT(kh*omegas)+1./(z0str-z1str)/SQRT(2.)
            8134                     END FUNCTION SSTR0FN
            8135                     ! ----------------------------------------------------------------------
            8136                     real FUNCTION HEPSTRFN(ha,ht,s,ta)
            8137                       IMPLICIT NONE
            8138                       real:: ha,ht,s,ta
            8139                       HEPSTRFN=( 2.*ha**2-EXP(-ht)**2*s**2                                                  &
            8140                           +SQRT(4.*ha**4+4.*Cos(2.*(ta-ht))*EXP(-ht)**2*s**2+EXP(-ht)**4*s**4)        &
            8141                         )/(4.*Cos(ta-ht)*EXP(-ht)*ha)
            8142                     END FUNCTION HEPSTRFN
            8143                     ! ----------------------------------------------------------------------
            8144                     real FUNCTION HEPFN(h,ht,s,kh,omegas,rhogcg)
            8145                     !*********************
            8146                     ! CALCUL Effective thickness
            8147                     ! h: physical thickness of the numerial layer (m)
            8148                     ! ht: center of temperature below upper interface (m)
            8149                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8150                     ! kh: heat diffusivity (m2/s)
            8151                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8152                     ! rhogcg: volume heat capacity (kg/m3*J/kg/K)=(J/m3/K)
            8153                     ! HEPFN: effective thickness of the numerical layer (m)
            8154                     !*********************
            8155                       IMPLICIT NONE
            8156                       real, INTENT(in):: h,ht,s,kh,omegas,rhogcg
            8157                       real:: h_ref,hstr,htstr,hastr,tastr,sstr,hepstr
            8158                       h_ref=SQRT(2.*kh/omegas)
            8159                       hstr=h/h_ref
            8160                       htstr=ht/h_ref
            8161          i            hastr=HASTRFN(hstr)
            8162          i            tastr=TASTRFN(hstr)
            8163                       sstr=s/rhogcg/SQRT(kh*omegas)
            8164          i            hepstr=HEPSTRFN(hastr,htstr,sstr,tastr)
            8165                       HEPFN=h_ref*hepstr
            8166                     END FUNCTION HEPFN
            8167                     ! ----------------------------------------------------------------------
            8168                     real FUNCTION HE0PFN(h,s,kh,omegas,rhogcg)
            8169                     !*********************
            8170                     ! CALCUL Effective thickness of the surface numerical layer
            8171                     ! h: physical thickness of the numerial layer (m)
            8172                     ! s: elasticity (dGk/dTk-dGk+1/dTk)
            8173                     ! kh: heat diffusivity (m2/s)
            8174                     ! omegas: Earth's angular velocity respect to Sun (2*pi/86400 s-1)
            8175                     ! rhogcg: volume heat capacity (kg/m3*J/kg/K)=(J/m3/K)
            8176                     ! HE0PFN: optimal effective thickness of the skin layer (m)
            8177                     !*********************
            8178                       IMPLICIT NONE
            8179                       real, INTENT(in):: h,s,kh,omegas,rhogcg
            8180                       HE0PFN=HEPFN(h,0.,s,kh,omegas,rhogcg)
            8181                     END FUNCTION HE0PFN
            8182                     ! ----------------------------------------------------------------------
            8183                     real FUNCTION SEAICEFN(siced)
            8184                     !*********************
            8185                     ! CALCUL sea ice cover fraction of a grid basen on mean sea ice depth
            8186                     ! siced: mean sea ice depth of a grid (m, swe)
            8187                     ! SEAICEFN: sea ice cover fraction [0-1] (dimensionless)
            8188                     ! assume to be lognormal distribution
            8189                     ! seaice[0.]=0.
            8190                     ! seaice[csiced]=0.5
            8191                     ! seaice[2*csiced]=0.84
            8192                     !*********************
            8193                       IMPLICIT NONE
            8194                     ! threshold sea ice depth, (= 2 m)
            8195                     ! this value should be resolution dependent
            8196                     ! 0 to be infinity fine resolution
            8197                     ! seaice[csiced]=50%
            8198                     !  real:: csiced      ! seaice[csiced]=0.5
            8199                     
            8200                       real, INTENT(in):: siced
            8201     1                 IF (csiced.GT.TOL) THEN
            8202     1               #ifdef __ibm__
            8203     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8204     1               #else
            8205     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8206     1                   !!! SEAICEFN=0.5_dp*(DERF(LOG(siced/csiced))+1.)
            8207     1               #endif
            8208     1                 ELSEIF (.FALSE.) THEN
            8209     1                   ! csiced=3.      !
            8210     1                   ! csiced=2.      ! seaice fraction is estimated to be 2.8%, while the observation 3.7% (T31)
            8211     1                   ! csiced=0.5_dp     ! seaice fraction is estimated to be 6.8%, while the observation 3.7% m (v9.9003, T31)
            8212     1                   ! csiced=1.0_dp     ! seaice fraction is estimated to be still as high as 6.8%, while the observation 3.7% m (v9.9004, T31, T63)
            8213     1                     csiced=2.0
            8214     1                   !!!   IF (GDCHK2) then
            8215     1                   !!!     WRITE(nerr,*) "csiced: Truncation is not tested in T',nn,' runs."
            8216     1                   !!!   ENDIF
            8217     1               #ifdef __ibm__
            8218     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8219     1               #else
            8220     1                   !!! SEAICEFN=0.5_dp*(DERF(LOG(siced/csiced))+1.)
            8221     1                   SEAICEFN=0.5*(ERF(LOG(siced/csiced))+1.)
            8222     1               #endif
            8223     1                 ELSE
            8224     2                   IF (siced.GT.0.) THEN
            8225     2                   ! seaice mask: Winner wins!
            8226     2                   ! seaice fraction is estimated to be 5.6%, while the observation 3.7% (T31)(cob10dnnnn, cob10d10dnn, cob10d10d10d)
            8227     2                   ! there is 660 ice grids, while the observation is 760 ice grid.
            8228     2                     SEAICEFN=1.
            8229     2                   ELSE
            8230     2                     SEAICEFN=0.
            8231     2                   ENDIF
            8232     1                 ENDIF
            8233                     END FUNCTION SEAICEFN
            8234                     ! ----------------------------------------------------------------------
            8235                     real FUNCTION SICEDFN(seaice)
            8236                     !*********************
            8237                     ! CALCUL sea ice cover fraction of a grid basen on mean sea ice depth
            8238                     ! siced: mean sea ice depth of a grid (m, swe)
            8239                     ! SEAICEFN: sea ice cover fraction [0-1] (dimensionless)
            8240                     ! assume to be lognormal distribution
            8241                     ! seaice[0.]=0.
            8242                     ! seaice[csiced]=0.5
            8243                     ! seaice[2*csiced]=0.84
            8244                     !*********************
            8245                       IMPLICIT NONE
            8246                     ! threshold sea ice depth, (= 2 m)
            8247                     ! this value should be resolution dependent
            8248                     ! 0 to be infinity fine resolution
            8249                     ! seaice[csiced]=50%
            8250                     !!!  real:: csiced      ! seaice[csiced]=0.5
            8251                     
            8252                       real, INTENT(in):: seaice
            8253                     !!!  IF (csiced.GT.TOL) THEN
            8254                     !!!#ifdef __ibm__
            8255                     !!!    !!! SICEDFN=csiced*EXP(ERFINV(2.*seaice-1.))
            8256                     !!!    SICEDFN=csiced*EXP(ERFINV(2.*seaice-1.))
            8257                     !!!#else
            8258                     !!!    !!! SICEDFN=csiced*EXP(DERFINV(2.*seaice-1.))
            8259                     !!!    SICEDFN=csiced*EXP(ERFINV(2.*seaice-1.))
            8260                     !!!#endif
            8261                     !!!  ELSE
            8262     1                   IF (seaice.GT.0.5) THEN
            8263     1                   !!! IF (seaice.GT.TOL) THEN
            8264     1                   ! seaice mask: Winner wins!
            8265     1                   ! seaice fraction is estimated to be 5.6%, while the observation 3.7% (T31)(cob10dnnnn, cob10d10dnn, cob10d10d10d)
            8266     1                   ! there is 660 ice grids, while the observation is 760 ice grid.
            8267     1                     SICEDFN=1.
            8268     1                   ELSE
            8269     1                     SICEDFN=0.
            8270     1                   ENDIF
            8271                     !!!  ENDIF
            8272                     END FUNCTION SICEDFN
            8273                     ! ----------------------------------------------------------------------
            8274                       real FUNCTION HSNFN(sni)
            8275                       !*********************
            8276                       ! CALCU snow thickness of the grid (m), based on grid mean snow depth in swe (sni)
            8277                       !*********************
            8278                         IMPLICIT NONE
            8279                         real, INTENT(in):: sni
            8280                         HSNFN=sni*rhoh2o/rhosn
            8281                       END FUNCTION HSNFN
            8282                       !---------------------
            8283                       real FUNCTION HICEFN(siced)
            8284                       !*********************
            8285                       ! CALCUL mean ice thickness of the grid (m), based on grid mean sea ice depth in swe (siced)
            8286                       !*********************
            8287                         IMPLICIT NONE
            8288                         real, INTENT(in):: siced
            8289                         HICEFN=siced*rhoh2o/rhoice
            8290                       END FUNCTION HICEFN
            8291                     ! ----------------------------------------------------------------------
            8292                       real FUNCTION wt_maxden(depth,obswtb,obswsb,mixing_depth)
            8293                       !*********************
            8294                       ! CALCUL water temperature based on max density water temperature approach
            8295                       ! set initial profile to be expontential decay to tmaxden
            8296                       !   =  3.73 C for fresh water s=0
            8297                       !   = -4.35 C for ocena water s=36.3 0/00.
            8298                       !*********************
            8299                         IMPLICIT NONE
            8300                         real, INTENT(in):: depth           ! depth (m, positive downward)
            8301                         real, INTENT(in):: obswtb          ! observed bulk water temperature (K)
            8302                         real, INTENT(in):: obswsb          ! observed bulk salinity (PSU)
            8303                         real, INTENT(in):: mixing_depth    ! mixing depth
            8304                     !ps    IF ( depth.LE.mixing_depth) then
            8305                     !ps      wt_maxden=obswtb
            8306                     !ps    ELSE
            8307                     !ps      wt_maxden=tmaxden(obswsb)+(obswtb-tmaxden(obswsb))*EXP(-(depth-mixing_depth)/100.)
            8308                     !ps      wt_maxden=tmaxden(obswsb)+(obswtb-tmaxden(obswsb))*EXP(-(depth-mixing_depth)/mixing_depth)
            8309                           wt_maxden=tmaxden(obswsb)+(obswtb-tmaxden(obswsb))*EXP(-depth/mixing_depth)
            8310                     !ps    ENDIF
            8311                       END FUNCTION wt_maxden
            8312                     ! ----------------------------------------------------------------------
            8313                       SUBROUTINE pzcord(zwlvl,bathy,nls,nle,z,zlk,hw,lsoil,lshlw)
            8314                     !
            8315                     !     WATER BODY POINT VERTICAL LEVELS
            8316                     !     zlk: coordinates of a water body flux (m ASL).
            8317                     !     z: z coordinates of the water body temperature (m ASL).
            8318                     !     nls: starting water level of the water body point.
            8319                     !       z(k)=zwlvl, IF k is <= nls.
            8320                     !     nle: maximum water levels of the water body point.
            8321                     !        Note nle=-1 IF water level is below point water body bed.
            8322                     !        Soil layer always is sitwt(nle+1). If there is no water,
            8323                     !        sitwt(nle+1)=sitwt(0,jrow). In addition, z(k)=bathy IF k >= nle.
            8324                     !     hw: thickness of each layer
            8325                     !     lshlw = shallow water mode (due to evaportion or freezing)
            8326                     !       (one layer water body)
            8327                     !     lsoil = soil grid
            8328                     !     zwlvl  : current water level (ice/water interface) a water body grid            I
            8329                     !----------------------------------------------------------
            8330                     !*    0 Locate Space
            8331                           IMPLICIT NONE
            8332                     !     0.1 Calling Variables
            8333                           real, INTENT(IN):: zwlvl,bathy
            8334                     
            8335                     !     input
            8336                     !v77      INTEGER oceanid,jl
            8337                     !     output
            8338                           INTEGER, INTENT(OUT):: nls,nle
            8339                           real, INTENT(OUT):: z(0:lkvl+1),zlk(0:lkvl+1),hw(0:lkvl)
            8340                           LOGICAL, INTENT(OUT):: lsoil, lshlw
            8341                     !     0.2 local variables
            8342                           INTEGER k
            8343                           REAL :: tmp
            8344                           real:: zdepth(0:lkvl)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zdepth
                                   <<< Loop-information  End >>>
            8345        pp   4v            zdepth(0:lkvl)=sit_zdepth(0:lkvl)
            8346                     !     0.3 Initial	(default)
            8347                           nls=-999
            8348                           nle=-999
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zlk, z
                                   <<< Loop-information  End >>>
            8349        pp   2v            z=xmissing
            8350         p   2v            zlk=xmissing
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hw
                                   <<< Loop-information  End >>>
            8351        pp   4v            hw=xmissing
            8352                           lshlw = .FALSE.
            8353                           lsoil = .FALSE.
            8354                     !
            8355                     !*    1.0 Determine Ocean Coordinate
            8356                     !
            8357                     !
            8358     1                     IF ( (zwlvl.GE.bathy+wcri) )  THEN
            8359     1               !
            8360     1               !     2. Water
            8361     1               !
            8362     1                       nls=0
            8363     1                       nle=lkvl
            8364     1                       z(lkvl+1)=bathy
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            8365     2  pp    v              DO k = 0,lkvl
            8366     2   p    v                tmp=zwlvl-zdepth(k)
            8367     3   p    v                IF ( tmp.GT.(bathy+wcri) ) THEN
            8368     3   p    v                  z(k)=tmp
            8369     3   p    v                  nle=k
            8370     3   p                     ELSE
            8371     3   p    v                  z(k)=bathy
            8372     3   p    v                ENDIF
            8373     2   p    v              ENDDO
            8374     1               !
            8375     1               !*    3. Determine Thickness (hw) and zlk of Each Layer
            8376     1               !
            8377     1                       zlk(0)=zwlvl
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            8378     2   s    v              DO k = 1,nls
            8379     2                         !! vanisih top layers when waterlevel is lower than the reference level
            8380     2   p    v                zlk(k)=zwlvl
            8381     2   p    v              ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 224, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zlk
                                   <<< Loop-information  End >>>
            8382     2  pp   2v              DO k = nls+1,lkvl+1
            8383     2               !!!          zlk(k)=(z(k-1)+z(k))/2.
            8384     2   p   2v                zlk(k)=zwlvl-sit_fluxdepth(k)
            8385     2   p   2v              ENDDO
            8386     1               
            8387     1                       hw(0)=zlk(0)-zlk(nls+1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            8388     2   s    v              DO k = 1,nls
            8389     2   p    v                hw(k)=0.
            8390     2   p    v              ENDDO
            8391     1                       hw(nls+1)=zlk(0)-zlk(nls+2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zlk, hw
                                   <<< Loop-information  End >>>
            8392     2  pp   2v              DO k = nls+2,nle-1
            8393     2   p   2v                hw(k)=zlk(k)-zlk(k+1)
            8394     2   p   2v              ENDDO
            8395     1                       hw(nle)=zlk(nle)-z(nle+1)
            8396     1               
            8397     1               !
            8398     1               !*    4. Determine Current Existence of Water
            8399     1               !
            8400     2                       IF ((nle-nls).EQ.1) THEN
            8401     2                         lshlw = .TRUE.
            8402     2               !         shallow water body
            8403     2                       ENDIF
            8404     1               !
            8405     1                     ELSE
            8406     1               !
            8407     1               !     5.0 Not a Ocean Grid (Soil)
            8408     1               !
            8409     1                       nle=-1
            8410     1                       z(nle+1)=bathy
            8411     1                       lsoil = .TRUE.
            8412     1                     ENDIF
            8413     1                  IF(lwarning_msg.GE.4) then
            8414     1                     WRITE(nerr,*) "lshlw=",lshlw,"lsoil=",lsoil,"nls=",nls,"nle=",nle
            8415     1                  ENDIF
            8416                     
            8417                       END SUBROUTINE pzcord
            8418                     ! **********************************************************************
            8419                     
            8420                       SUBROUTINE cal_ratioBlending(pmyrank,pii,pjj,plat,inlon,outratio)
            8421                     
            8422                           use mod_sit_control,  only: sit_domain_w,sit_domain_e &
            8423                                                    ,sit_domain_s,sit_domain_n &
            8424                                                    ,sit_domain_extgrd
            8425                     ! location blending
            8426                           real:: plat,inlon
            8427                           real:: plon
            8428                           real:: outratio
            8429                           real:: rrn,rrs,rre,rrw,rr_sn,rr_we,rrtmp
            8430                     !    real, PARAMETER:: rf=10._dp
            8431                           real, PARAMETER:: rf=5.
            8432                           integer:: pmyrank,pii,pjj
            8433                     
            8434                     
            8435     1                     IF(inlon .LT. 0.) THEN
            8436     1                       plon=inlon + 360.
            8437     1                     else
            8438     1                       plon=inlon
            8439     1                     ENDIF
            8440                     
            8441     1                     IF((plon .GE. sit_domain_w) .AND. &
            8442     1                        (plon .LE. sit_domain_e) ) then
            8443     1                       rre=1.
            8444     1                       rrw=1.
            8445     1                     ELSEIF( (plon .GT. sit_domain_e) .AND. &
            8446     1                             (plon .LE. sit_domain_e+sit_domain_extgrd) ) THEN
            8447     1                       rre=min(sit_domain_e+sit_domain_extgrd,360.)
            8448     1                       rrw=sit_domain_e
            8449     1                     ELSEIF( (plon .GT. sit_domain_w-sit_domain_extgrd) .AND. &
            8450     1                             (plon .LE. sit_domain_w) ) THEN
            8451     1                       rre=max(sit_domain_w-sit_domain_extgrd,0.)
            8452     1                       rrw=sit_domain_w
            8453     1                     ELSE
            8454     1                       rre=0.
            8455     1                       rrw=0.
            8456     1                     ENDIF
            8457                     
            8458     1                     IF((plat .GE. sit_domain_s) .AND. &
            8459     1                        (plat .LE. sit_domain_n) ) then
            8460     1                       rrn=1.
            8461     1                       rrs=1.
            8462     1                     ELSEIF( (plat .GT. sit_domain_n) .AND. &
            8463     1                             (plat .LE. sit_domain_n+sit_domain_extgrd)  ) THEN
            8464     1                       rrn=min(sit_domain_n+sit_domain_extgrd,90.)
            8465     1                       rrs=sit_domain_n
            8466     1                     ELSEIF( (plat .GE. sit_domain_s-sit_domain_extgrd) .AND. &
            8467     1                             (plat .LT. sit_domain_s) ) THEN
            8468     1                       rrn=max(sit_domain_s-sit_domain_extgrd,-90.)
            8469     1                       rrs=sit_domain_s
            8470     1                     ELSE
            8471     1                       rrn=0.
            8472     1                       rrs=0.
            8473     1                     ENDIF
            8474                     
            8475     1                     IF(rrw .EQ. 1.) THEN
            8476     1                       rr_we=1.
            8477     1                     ELSEIF(rrw .EQ. 0.) THEN
            8478     1                       rr_we=0.
            8479     1                     ELSE
            8480     1                       rr_we=1.-ABS((plon-rrw)/(rre-rrw))
            8481     1                     ENDIF
            8482                     
            8483     1                     IF(rrs .EQ. 1.) THEN
            8484     1                       rr_sn=1.
            8485     1                     ELSEIF(rrs .EQ. 0.) THEN
            8486     1                       rr_sn=0.
            8487     1                     ELSE
            8488     1                       rr_sn=1.-ABS((plat-rrs)/(rrn-rrs))
            8489     1                     ENDIF
            8490                     
            8491     1                     if(rr_sn .eq. 1.) then
            8492     1                       rrtmp=rr_we
            8493     1                     elseif(rr_we .eq. 1.)then
            8494     1                       rrtmp=rr_sn
            8495     1                     else
            8496     1                       rrtmp=0.5*(rr_sn+rr_we)
            8497     1                     endif
            8498                     
            8499     1                     IF(rrtmp .EQ. 1.) THEN
            8500     1                       outratio=1.
            8501     1                     ELSE if(rrtmp .eq. 0.) then
            8502     1                       outratio=0.
            8503     1                     ELSE
            8504     1                       outratio=exp(-rf/rrtmp*exp(1./(rrtmp-1.)))
            8505     1                     ENDIF
            8506                     
            8507     1                     if(pmyrank.eq.6 .AND. pii.eq.1 .AND. pjj.eq.12) then
            8508     1                       print *,'in ratio: myrank=',pmyrank,',ii=',pii &
            8509     1                              ,',jj=',pjj,',rre=',rre,',rrw=',rrw    &
            8510     1                              ,',rr_we=',rr_we,',rrn=',rrn,',rrs=',rrs &
            8511     1                              ,',rr_sn=',rr_sn,',rrtmp=',rrtmp      &
            8512     1                              ,',outratio=',outratio
            8513     1                     endif
            8514                     
            8515                     
            8516                       END SUBROUTINE cal_ratioBlending
            8517                     

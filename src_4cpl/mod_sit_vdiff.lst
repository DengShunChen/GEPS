            7008     1                     restore_temp=(pobswtb(jl)-pwt(jl,jk))*(1.-0.5**(zdtime/st_restore_time))
            7009     2                     IF(lgodas .AND. ltimeblending .AND. timebl_option .EQ. 1 ) THEN
            7010     2               !        restore_temp=(pobswt(jl,jk)-pwt(jl,jk))*(1.-fratio)
            7011     2                       restore_temp=(pobswt(jl,jk)-pwt(jl,jk))*(1.-0.5**(zdtime/st_restore_time))
            7012     2                       restore_temp=(pobswt(jl,jk)-pwt(jl,jk))*(1.-fratio)+restore_temp*fratio
            7013     2                     ELSE

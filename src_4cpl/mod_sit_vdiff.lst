            7146     3                       ENDIF
            7147     2                     ELSEIF ((pobswsb(jl).NE.xmissing).AND.(ss_restore_time_all.EQ.0.)) THEN
            7148     2                       restore_salt2=(pobswsb(jl)-pws(jl,jk))

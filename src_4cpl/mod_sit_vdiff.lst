            7598     5                           !level
            7599     5                           ENDIF
            7600     4                         ENDIF
            7601     4                         IF ((pobswv(jl,jk).NE.xmissing).AND.(suv_restore_time.GT.0.)) THEN
            7602     4                           restore_v=(pobswv(jl,jk)-pwv(jl,jk))*(1.-0.5**(zdtime/suv_restore_time))
            7603     4                           ! obsws  vertical index start at 1

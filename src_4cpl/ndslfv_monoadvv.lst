 External subroutine subprogram "ndslfv_monoadvv_fgnl"
  (inc)(line-no.)(nest)(optimize)
             282                     !
             283                     ! -------------------------------
             284                           subroutine ndslfv_monoadvv_fgnl(vdzonl,vdmerd,ddtemp,pdot      &
             285                                                     , pt,lonsperlat,deltim,nvars,forward)
             286                     !
             287                     ! a routine to do non-iteration semi-Lagrangain advection
             288                     ! considering advection  with monotonicity in interpolation
             289                     ! contact: hann-ming henry juang
             290                     ! program log:
             291                     ! 2011 02 20 : henry juang, initial implemented into nems as NDSL with mass_dp
             292                     ! 2013 09 30 : henry juang, add option of theta advection, (used later)
             293                     !
             294                     !
             295                           use param
             296                           use grid, only : latpart
             297                           use index
             298                           use rank
             299                           use const
             300                     
             301                           implicit none
             302                     
             303                           real(kind=RTYPE) pdot(nxp,    lev+1,latpart)
             304                           real(kind=RTYPE) plev(nxp,    lev+1)
             305                           real(kind=RTYPE) pt(nxp,latpart)
             306                           integer,intent(in):: lonsperlat(my)
             307                           real(kind=RTYPE),   intent(in):: deltim
             308                     
             309                           real(kind=RTYPE)      qqlon(nxp,    lev*nvars,latpart)
             310                           real(kind=RTYPE)      vdmerd(nxp,lev,my_max),vdzonl(nxp,lev,my_max)
             311                           real(kind=RTYPE)      ddtemp(nxp,lev,my_max)
             312                           real(kind=RTYPE)      rdt2,dt2
             313                     
             314                           integer mono,mass,nvars
             315                           integer ii,i,n,k,kk,lon,lan,lat,lons_lat
             316                           integer kuu, kvv, ktt
             317                           integer ku , kv, kt
             318                           logical forward
             319                     !
             320                     !     lprint = .false.
             321                     
             322                     !     if( lprint ) then
             323                     !       print *,' enter ndslfv_advect  with monotonicity '
             324                     !     endif
             325                     !
             326                           mono  = 1
             327                           mass  = 0
             328                     !      cons0 = 0.0
             329                     !      cons1 = 1.0
             330                     !
             331                     !      levh = ncld * lev
             332                     !
             333                           kuu = 1
             334                           kvv = kuu + lev
             335                           ktt = kvv + lev
             336                     
             337                     !      nvars = 2
             338                     !
             339                           rdt2 = 0.5 / deltim
             340                           dt2 =  2. * deltim
             341                     !
             342                     !$omp parallel do                                                &
             343                     !$omp private(lan,lat,lons_lat,plev,i,k,n,kk,mass,ku,kv,kt)      &
             344                     !$omp schedule(dynamic)
             345                     
             346                     !      do lan=1,lats_node_a
             347     1   p                 do lan=1,jlistnum
             348     1               
             349     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
             350     1   p                   lat = jlist1(lan)
             351     1   p                   lons_lat = lonsperlat(lat)
             352     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             353     1   p   4v              plev(:,lev+1) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, (unknown)
                                   <<< Loop-information  End >>>
             354     2   p                   do k=lev,1,-1
             355     2   p                     kk=lev-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.20, ITR: 288, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, (unknown)
                                   <<< Loop-information  End >>>
             356     3   p   2v                do i=1,lons_lat
             357     3   p   2v                  plev(i,k)=plev(i,k+1)+dsigma(kk,1)*pt(i,lan)+dsigma(kk,2)
             358     3   p   2v                enddo
             359     2   p                   enddo
             360     1               
             361     1               !       if( lprint ) then
             362     1               !       do k=1,lev
             363     1               !       print *,' k= ',k
             364     1               !       call mymaxmin(pdot(1,k,lan),lons_lat,lonfull,1,' pdot ')
             365     1               !       call mymaxmin(plev(1,k),lons_lat,lonfull,1,' plev ')
             366     1               !       enddo
             367     1               !       endif
             368     1               !
             369     1               ! d z t at n+1*
             370     1               !       kappa = con_rd / con_cp
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
             371     2   p                   do k=1,lev
             372     2   p                     kk=lev-k+1
             373     2   p                     ku=kuu+k-1
             374     2   p                     kv=kvv+k-1
             375     2   p                     kt=ktt+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
             376     3   p    v                do i=1,lons_lat
             377     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,kk,lan)
             378     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,kk,lan)
             379     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,kk,lan)
             380     3   p    v                enddo
             381     2   p                   enddo
             382     1               !
             383     1               !
             384     1   p                   mass=0
             385     1               !
             386     1   p                   call vertical_cell_advect (lons_lat,nxp,    lev,nvars, &
             387     1                                 deltim,plev,pdot(1,1,lan),qqlon(1,1,lan),mass,forward)
             388     1               !
             389     1               !
             390     1               ! u v t tendency at n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, ddtemp, vdmerd, vdzonl
                                   <<< Loop-information  End >>>
             391     2   p                   do k=1,lev
             392     2   p                     kk=lev-k+1
             393     2   p                     ku=kuu+k-1
             394     2   p                     kv=kvv+k-1
             395     2   p                     kt=ktt+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ddtemp, qqlon, vdmerd, vdzonl
                                   <<< Loop-information  End >>>
             396     3   p    v                do i=1,lons_lat
             397     3   p    v                  vdzonl(i,kk,lan) = qqlon(i,ku,lan)
             398     3   p    v                  vdmerd(i,kk,lan) = qqlon(i,kv,lan)
             399     3   p    v                  if ( nvars .ge. 3 ) ddtemp(i,kk,lan) = qqlon(i,kt,lan)
             400     3   p    v                enddo
             401     2   p                   enddo
             402     1               !
             403     1               !       if( lprint ) then
             404     1               !       call mymaxmin(qqlon(1,kqq,lan),lons_lat,lonfull,1,' q vertadv')
             405     1               !       print *,' ------------------------------------------- '
             406     1               !       print *,' finish updating n+1* in grid_gr at lan=',lan
             407     1               !       endif
             408     1               !
             409     1   p                 enddo
             410                     !$omp end parallel do
             411                     
             412                     !
             413                     ! ===============================
             414                     !
             415                           return
             416                           end


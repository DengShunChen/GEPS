               1                           subroutine unify_reducepick(nx,my,my_max,ff,fp)
               2                           use mpe
               3                           use index
               4                           ! pick the reduce-grid value from the nearest regular grid.
               5                           ! this is only for changing low boundary data to reducegrid from
               6                           ! regular grid.
               7                     
               8                           implicit none
               9                     

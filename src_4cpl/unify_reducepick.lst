                                   <<< Loop-information  End >>>
              14     1                     do jj = 1, jlistnum
              15     1                      j=jlist1(jj)
              16     1                      ii=nxjstart(j)
              17     1                      nxj=nxdef_2d(j)
              18     1                      if( lreduce.eq.1 )call reducepickr (ff(1,j),nxdef(j),nx,1)

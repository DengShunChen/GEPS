             706     2   p   2v              do i=1,im
             707     3   p   2v                if(cnvflg(i) .and. k < kmax(i)) then
             708     3   p   2v                  xlamud(i,k) = xlamx(i)
             709     3               !           xlamud(i,k) = crtlamd
             710     3   p   2v                endif

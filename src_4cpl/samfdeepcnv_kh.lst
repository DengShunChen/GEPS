            1548     4   p    v                       tem1 = 0.5 * (xlamd(i)+xlamdd) * dz
            1549     4   p    v                    endif
            1550     3   p    v                    factor = 1. + tem - tem1
            1551     3   p    v                    qcdo(i,k) = ((1.-tem1)*qrcdo(i,k+1)+tem*0.5* &
            1552     3                                          (qo(i,k)+qo(i,k+1)))/factor
            1553     3               !cj
            1554     3               !             pwdo(i,k)  = etad(i,k+1) * qcdo(i,k+1) -
            1555     3               !    &                     etad(i,k) * qrcdo(i,k)

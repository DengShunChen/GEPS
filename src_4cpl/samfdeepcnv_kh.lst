                                   <<< Loop-information  End >>>
             733     2   p    v              do i=1,im
             734     3   p    v                if(cnvflg(i) .and. &
             735     3                           (k > kbcon(i) .and. k < kmax(i))) then
             736     3   p    v                    tem = cxlamu * frh(i,k) * fent2(i,k)
             737     3   p    v                    xlamue(i,k) = xlamue(i,k)*fent1(i,k) + tem
             738     3               !             tem1 = cxlamd * frh(i,k)
             739     3               !             xlamud(i,k) = xlamud(i,k) + tem1
             740     3   p    v                endif
             741     2   p    v              enddo
             742     1   p                 enddo
             743                     !
             744                     !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
             745                     !
             746                     !  determine updraft mass flux for the subcloud layers
             747                     !
             748                     !> - Calculate the normalized mass flux for subcloud and in-cloud layers according to Pan and Wu (1995) \cite pan_and_wu_1995 equation 1:
             749                     !!  \f[
             750                     !!  \frac{1}{\eta}\frac{\partial \eta}{\partial z} = \lambda_e - \lambda_d
             751                     !!  \f]
             752                     !!  where \f$\eta\f$ is the normalized mass flux, \f$\lambda_e\f$ is the entrainment rate and \f$\lambda_d\f$ is the detrainment rate.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kbcon, kb, zi, xlamud, xlamue
                                   <<<      eta
                                   <<< Loop-information  End >>>
             753     1                     do k = km1, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.80, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zi, kb, cnvflg, eta, xlamud, xlamue
                                   <<<      kbcon
                                   <<< Loop-information  End >>>
             754     2  pp    v              do i = 1, im
             755     3   p    v                if (cnvflg(i)) then
             756     4   p    v                  if(k < kbcon(i) .and. k >= kb(i)) then
             757     4   p    v                    dz       = zi(i,k+1) - zi(i,k)
             758     4   p    v                    tem      = 0.5*(xlamud(i,k)+xlamud(i,k+1))
             759     4   p    v                    ptem     = 0.5*(xlamue(i,k)+xlamue(i,k+1))-tem
             760     4   p    v                    eta(i,k) = eta(i,k+1) / (1. + ptem * dz)
             761     4   p    v                  endif
             762     3   p    v                endif
             763     2   p    v              enddo
             764     1                     enddo
             765                     !
             766                     !  compute mass flux above cloud base
             767                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :

             533     3   p    v                  tem       = phil(i,k) + cp * to(i,k)
             534     3   p    v                  heo(i,k)  = tem  + hvap * qo(i,k)
             535     3   p    v                  heso(i,k) = tem  + hvap * qeso(i,k)
             536     3               !           heo(i,k)  = min(heo(i,k),heso(i,k))
             537     3   p    v                endif
             538     2   p    v              enddo
             539     1   p                 enddo
             540                     !
             541                     !  determine level with largest moist static energy
             542                     !  this is the level where updraft starts
             543                     !
             544                     !> ## Perform calculations related to the updraft of the entraining/detraining cloud model ("static control").
             545                     !> - Search below index "kbm" for the level of maximum moist static energy.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      heo, hmax, kb
                                   <<< Loop-information  End >>>
             546     1  pp   2v            do i=1,im
             547     1   p   2v              hmax(i) = heo(i,1)
             548     1   p   2v              kb(i)   = 1
             549     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kbm, heo, hmax, kb
                                   <<< Loop-information  End >>>
             550     1                     do k = 2, km
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.75, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kbm, heo, hmax, kb
                                   <<< Loop-information  End >>>
             551     2  pp   2v              do i=1,im
             552     3   p   2v                if (k <= kbm(i)) then
             553     4   p   2v                  if(heo(i,k) > hmax(i)) then
             554     4   p   2v                    kb(i)   = k
             555     4   p   2v                    hmax(i) = heo(i,k)
             556     4   p   2v                  endif
             557     3   p   2v                endif
             558     2   p   2v              enddo
             559     1                     enddo
             560                     !
             561                     !> - Calculate the temperature, specific humidity, and pressure at interface levels.
             562     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kmax
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             563     2   s    s              do i=1,im
             564     3   p    v                if (k <= kmax(i)-1) then
             565     3   p    v                  dz      = .5 * (zo(i,k+1) - zo(i,k))
             566     3   p    v                  dp      = .5 * (pfld(i,k+1) - pfld(i,k))
             567     3   s    s                  es      = 0.01 * fpvs(to(i,k+1))      ! fpvs is in pa
             568     3               !byl            call qsatq_cwb(1,to(i,k+1),pfld(i,k+1),es)
             569     3   s    s                  pprime  = pfld(i,k+1) + epsm1 * es
             570     3   s    s                  qs      = eps * es / pprime
             571     3   s    s                  dqsdp   = - qs / pprime
             572     3   s    s                  desdt   = es * (fact1 / to(i,k+1) + fact2 / (to(i,k+1)**2))
             573     3   p    v                  dqsdt   = qs * pfld(i,k+1) * desdt / (es * pprime)
             574     3   m    m                  gamma   = el2orc * qeso(i,k+1) / (to(i,k+1)**2)
             575     3   m    m                  dt      = (g * dz + hvap * dqsdp * dp) / (cp * (1. + gamma))
             576     3   p    v                  dq      = dqsdt * dt + dqsdp * dp
             577     3   s    s                  to(i,k) = to(i,k+1) + dt
             578     3   p    v                  qo(i,k) = qo(i,k+1) + dq
             579     3   p    v                  po(i,k) = .5 * (pfld(i,k) + pfld(i,k+1))
             580     3   p    v                endif
             581     2   p    m              enddo
             582     1                     enddo
             583                     !
             584                     !> - Recalculate saturation specific humidity, moist static energy, saturation moist static energy, and horizontal momentum on interface levels. Enforce minimum specific humidity and calculate \f$(1 - RH)\f$.
             585     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kmax
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 6  FILL 11
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             586     2   s    s              do i=1,im
             587     3   p    v                if (k <= kmax(i)-1) then
             588     3   m    m                  qeso(i,k) = 0.01 * fpvs(to(i,k))      ! fpvs is in pa
             589     3               !byl            call qsatq_cwb(1,to(i,k),po(i,k),qeso(i,k))
             590     3   p    v                  qeso(i,k) = eps * qeso(i,k) / (po(i,k) + epsm1*qeso(i,k))
             591     3   p    v                  val1      =             1.e-8
             592     3   p    v                  qeso(i,k) = max(qeso(i,k), val1)
             593     3   p    v                  val2      =           1.e-10
             594     3   p    v                  qo(i,k)   = max(qo(i,k), val2 )
             595     3               !           qo(i,k)   = min(qo(i,k),qeso(i,k))
             596     3   p    v                  frh(i,k)  = 1. - min(qo(i,k)/qeso(i,k), 1.)
             597     3   m    m                  heo(i,k)  = .5 * g * (zo(i,k) + zo(i,k+1)) + &
             598     3                                       cp * to(i,k) + hvap * qo(i,k)
             599     3   p    v                  heso(i,k) = .5 * g * (zo(i,k) + zo(i,k+1)) + &
             600     3                                       cp * to(i,k) + hvap * qeso(i,k)
             601     3   p    v                  uo(i,k)   = .5 * (uo(i,k) + uo(i,k+1))
             602     3   p    v                  vo(i,k)   = .5 * (vo(i,k) + vo(i,k+1))
             603     3   p    v                endif
             604     2   p    m              enddo
             605     1                     enddo
             606                     !
             607                     !  look for the level of free convection as cloud base
             608                     !
             609                     !> - Search below the index "kbmax" for the level of free convection (LFC) where the condition \f$h_b > h^*\f$ is first met, where \f$h_b, h^*\f$ are the state moist static energy at the parcel's starting level and saturation moist static energy, respecti
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kbcon, flg, kmax
                                   <<< Loop-information  End >>>
             610     1  pp   2v            do i=1,im
             611     1   p   2v              flg(i)   = .true.
             612     1   p   2v              kbcon(i) = kmax(i)
             613     1   p   2v            enddo
             614     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flg
                                   <<< Loop-information  End >>>
             615     2  pp    s              do i=1,im
             616     3   p    m                if (flg(i) .and. k <= kbmax(i)) then
             617     4   p    s                  if(k > kb(i) .and. heo(i,kb(i)) > heso(i,k)) then
             618     4   p    s                    kbcon(i) = k
             619     4   p    s                    flg(i)   = .false.
             620     4   p    s                  endif
             621     3   p    v                endif
             622     2   p    v              enddo
             623     1                     enddo
             624                     !
             625                     !> - If no LFC, return to the calling routine without modifying state variables.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 288, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kbcon, kmax
                                   <<< Loop-information  End >>>
             626     1  pp   2v            do i=1,im
             627     1   p   2v              if(kbcon(i) == kmax(i)) cnvflg(i) = .false.
             628     1   p   2v            enddo
             629                     !!
             630                           totflg = .true.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
             631     1  pp    v            do i=1,im
             632     1   p    v              totflg = totflg .and. (.not. cnvflg(i))
             633     1   p    v            enddo
             634                           if(totflg) return
             635                     !!
             636                     !> - Determine the vertical pressure velocity at the LFC. After Han and Pan (2011) \cite han_and_pan_2011 , determine the maximum pressure thickness between a parcel's starting level and the LFC. If a parcel doesn't reach the LFC within the critical thick
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             637     1  pp   2s            do i=1,im
             638     2   p   2m              if(cnvflg(i)) then
             639     2   p   2s                pdot(i)  = 10.* dot(i,kbcon(i))
             640     2               !          pdot(i)  = 0.01 * dot(i,kbcon(i)) ! Now dot is in Pa/s
             641     2   p   2v              endif
             642     1   p   2v            enddo
             643                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kb, kbcon, frh, frh_sum
                                   <<< Loop-information  End >>>
             644     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kb, frh, frh_sum, kbcon, cnvflg
                                   <<< Loop-information  End >>>
             645     2  pp    v             do i = 1, im
             646     3   p    v               if (cnvflg(i)) then
             647     4   p    v                if (k.ge.kb(i).and.k.le.kbcon(i)) then
             648     4   p    v                 frh_sum(i) = frh_sum(i) + (1-frh(i,k))
             649     4   p    v                endif
             650     3   p    v               endif
             651     2   p    v             enddo
             652     1                     enddo
             653                     !
             654                     !   turn off convection if pressure depth between parcel source level
             655                     !      and cloud base is larger than a critical value, cinpcr
             656                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 37
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             657     1  pp    s            do i=1,im
             658     2   p    m              if(cnvflg(i)) then
             659     2   p    s                sigma_con = tan(0.4*pi)/(dx5km-dx1km)           !7.7e-4 m-1
             660     2   p    s                sigma(i)  = (1.-1./pi*(atan(sigma_con*(gdx(i)-dx5km))+pi/2.)) !1(1km),0.1(10km)
             661     3   p    s                if (gdx(i).lt.dx5km) then
             662     3   p    s                 sigma(i) = min(sigma(i)-0.01684*gdx(i)/1000.+0.0842,1.0)
             663     3   p    s                endif
             664     2   p    s                cinpcr = cinpcrmn + 0.5*(cinpcrmx-cinpcrmn) * (1.-sigma(i))
             665     2   p    s                cinpcri(i) = cinpcr * frh_sum(i)/(kbcon(i)-kb(i)+1)
             666     2   p    s                tem1 = pfld(i,kb(i)) - pfld(i,kbcon(i))
             667     3   p    s                if(tem1 > cinpcri(i)) then
             668     3   p    s                   cnvflg(i) = .false.
             669     3   p    s                endif
             670     2   p    v              endif
             671     1   p    v            enddo
             672                     !!
             673                           totflg = .true.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
             674     1  pp    v            do i=1,im
             675     1   p    v              totflg = totflg .and. (.not. cnvflg(i))
             676     1   p    v            enddo
             677                           if(totflg) return
             678                     !!
             679                     !
             680                     !  assume that updraft entrainment rate above cloud base is
             681                     !    same as that at cloud base
             682                     !
             683                     !> - Calculate the entrainment rate according to Han and Pan (2011) \cite han_and_pan_2011 , equation 8, after Bechtold et al. (2008) \cite bechtold_et_al_2008, equation 2 given by:
             684                     !!  \f[
             685                     !!  \epsilon = \epsilon_0F_0 + d_1\left(1-RH\right)F_1
             686                     !!  \f]
             687                     !!  where \f$\epsilon_0\f$ is the cloud base entrainment rate, \f$d_1\f$ is a tunable constant, and \f$F_0=\left(\frac{q_s}{q_{s,b}}\right)^2\f$ and \f$F_1=\left(\frac{q_s}{q_{s,b}}\right)^3\f$ where \f$q_s\f$ and \f$q_{s,b}\f$ are the saturation specific
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             688     1  pp   2s            do i=1,im
             689     2   p   2m              if(cnvflg(i)) then
             690     2   p   2s                xlamx(i) = xlamue(i,kbcon(i))
             691     2   p   2v              endif
             692     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kbcon, kmax, xlamx, xlamue
                                   <<< Loop-information  End >>>
             693     1  pp                 do k = 2, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kmax, cnvflg, kbcon, xlamx, xlamue
                                   <<< Loop-information  End >>>
             694     2   p   2v              do i=1,im
             695     3   p   2v                if(cnvflg(i).and. &
             696     3                           (k > kbcon(i) .and. k < kmax(i))) then
             697     3   p   2v                    xlamue(i,k) = xlamx(i)
             698     3   p   2v                endif

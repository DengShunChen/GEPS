            2171     1               !! \f]
            2172     1               !! \f$\Delta t_{cu}\f$ is the short timescale of the convection.
            2173     2   p    v              if(asqecflg(i)) then
            2174     2               !         xaa0(i) = max(xaa0(i),0.)
            2175     2   p    v                xk(i) = (xaa0(i) - aa1(i)) / mbdt(i)
            2176     3   p    v                if(xk(i) >= 0.) then
            2177     3   p    v                  asqecflg(i) = .false.
            2178     3   p    v                  cnvflg(i) = .false.
            2179     3   p    v                endif
            2180     2   p    v              endif
            2181     1               !
            2182     1               !c--- kernel, cloud base mass flux
            2183     1               !
            2184     1               !> - The cloud base mass flux (xmb) is then calculated from equation 7 of Pan and Wu (1995) \cite pan_and_wu_1995
            2185     1               !! \f[

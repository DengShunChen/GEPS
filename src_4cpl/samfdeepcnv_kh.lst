                                   <<<      fent2
                                   <<< Loop-information  End >>>
             732     1  pp                 do k = 2, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.62, ITR: 32, MVE: 2, POL: S)

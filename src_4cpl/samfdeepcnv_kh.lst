            1535     2  pp    v              do i = 1, im
            1536     3   p    v                if (cnvflg(i) .and. k < jmin(i)) then
            1537     3   p    v                    gamma      = el2orc * qeso(i,k) / (to(i,k)**2)
            1538     3   p    v                    qrcdo(i,k) = qeso(i,k)+ &
            1539     3                                     (1./hvap)*(gamma/(1.+gamma))*dbyo(i,k)
            1540     3               !             detad      = etad(i,k+1) - etad(i,k)
            1541     3               !cj
            1542     3   p    v                    dz = zi(i,k+1) - zi(i,k)
            1543     4   p    v                    if(k >= kbcon(i)) then
            1544     4   p    v                       tem  = xlamde * dz
            1545     4   p    v                       tem1 = 0.5 * xlamdd * dz

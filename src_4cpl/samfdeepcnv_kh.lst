                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             718     2   p    s              do i=1,im
             719     3   p    m                if(cnvflg(i).and. &
             720     3                           (k > kbcon(i) .and. k < kmax(i))) then
             721     3   p    s                    tem = qeso(i,k)/qeso(i,kbcon(i))
             722     3   p    s                    fent1(i,k) = tem**2
             723     3   p    s                    fent2(i,k) = tem**3

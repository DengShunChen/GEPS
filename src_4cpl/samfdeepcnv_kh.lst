            1559     3   p    v                    pwdo(i,k)  = etad(i,k) * (qcdo(i,k) - qrcdo(i,k))
            1560     3   p    v                    pwevo(i)   = pwevo(i) + pwdo(i,k)
            1561     3   p    v                endif

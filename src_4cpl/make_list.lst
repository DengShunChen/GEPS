 External subroutine subprogram "make_list_nx"
  (inc)(line-no.)(nest)(optimize)
             268                     
             269                     !-------------------------------------------------------
             270                           subroutine make_list_nx
             271                     
             272                     !
             273                     !  decompose nx for 2dMPI
             274                     !
             275                           use param
             276                           use mpe
             277                           use rank
             278                           use index
             279                     
             280                           implicit  none
             281                           integer   i,ii,j,n1,n2,nxj,tmp(my,nsizex)
             282                     
             283                     ! nxp  : nx  partial
             284                     ! nxjp : nxj partial
             285                     
             286                     ! nxjstart : nxj start
             287                     ! nxjend   : nxj end
             288                     
             289                     ! map2to1  : 2d local index to 1d global index
             290                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      map2to1
                                   <<< Loop-information  End >>>
             291     1  pp                    do j=1,my
             292     1   p                       nxj=nxdef(j)
             293     1               
             294     1   p                       n1=nxj/nsizex
             295     1   p                       n2=mod(nxj,nsizex)
             296     1               
             297     1   p                       nxjstart(j)=row_rank*n1+1+min(row_rank,n2)
             298     1   p                       nxjend(j)=nxjstart(j)+n1-1
             299     1   p                       if(row_rank < n2)nxjend(j)=nxjend(j)+1
             300     1               
             301     1   p                       nxjlen(j)=nxjend(j)-nxjstart(j)+1
             302     1   p                       nxjp(j)=nxjlen(j)
             303     1   p                       nxdef_2d(j)=nxjlen(j)
             304     1               
             305     1   p                       ii=nxjstart(j)
             306     1               !ch         do i=1,nxjlen(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      map2to1
                                   <<< Loop-information  End >>>
             307     2   p   2v                  do i=1,nxp
             308     2   p   2v                     map2to1(i,j)=ii
             309     2   p   2v                     ii=ii+1
             310     2   p   2v                  enddo
             311     1   p                    enddo
             312                     
             313                           call mpe2d_get_allrow(my,nxjstart,tmp)  ! gather all nxjstart of a row
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 512, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nxjstart_all
                                   <<< Loop-information  End >>>
             314        pp   4v            nxjstart_all=transpose(tmp)
             315                           call mpe2d_get_allrow(my,nxjend,tmp)    ! gather all nxjend of a row
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 512, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nxjend_all
                                   <<< Loop-information  End >>>
             316        pp   4v            nxjend_all=transpose(tmp)
             317                           call mpe2d_get_allrow(my,nxjlen,tmp)    ! gather all nxjlen of a row
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 512, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      nxjlen_all
                                   <<< Loop-information  End >>>
             318        pp   4v            nxjlen_all=transpose(tmp)
             319                     
             320     1                     do j=1,my
             321     1                        nxj=nxdef(j)
             322     1               !        print 101, j,nxj,nxjstart(j),nxjend(j),nxjlen(j)
             323     2                        do i=1,nsizex
             324     2               !        print 102, j,i,nxjstart_all(i,j),nxjend_all(i,j),nxjlen_all(i,j)
             325     2                        enddo
             326     1                     enddo
             327                     !     stop
             328                     
             329                     101   format('j,nxj,nxjstart,nxjend,nxjlen=',5I6)
             330                     102   format('j,i,nxjstart,nxjend,nxjlen=',5I6)
             331                     
             332                           return
             333                           end


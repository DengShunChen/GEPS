               2                           subroutine cuadjtq_n                 &
               3                          &    (nxj, klon, klev, kk, psp, pt, pq, ldflag,  kcall)
               4                     !          m.tiedtke         e.c.m.w.f.     12/89
               5                     !          purpose.
               6                     !          --------
               7                     !          to produce t,q and l values for cloud ascent
               8                     
               9                     !          interface
              10                     !          ---------
              11                     !          this routine is called from subroutines:
              12                     !              *cond*     (t and q at condensation level)
              13                     !              *cubase*   (t and q at condensation level)
              14                     !              *cuasc*    (t and q at cloud levels)
              15                     !              *cuini*    (environmental t and qs values at half levels)
              16                     !          input are unadjusted t and q values,
              17                     !          it returns adjusted values of t and q
              18                     
              19                     !     parameter     description                                   units
              20                     !     ---------     -----------                                   -----
              21                     !     input parameters (integer):
              22                     
              23                     !    *klon*         number of grid points per packet
              24                     !    *klev*         number of levels
              25                     !    *kk*           level
              26                     !    *kcall*        defines calculation as
              27                     !                      kcall=0  env. t and qs in*cuini*
              28                     !                      kcall=1  condensation in updrafts  (e.g. cubase, cuasc)
              29                     !                      kcall=2  evaporation in downdrafts (e.g. cudlfs,cuddraf)
              30                     !     input parameters (real):
              31                     !    *psp*          pressure                                        pa
              32                     !     updated parameters (real):
              33                     !    *pt*           temperature                                     k
              34                     !    *pq*           specific humidity                             kg/kg
              35                     !          externals
              36                     !          ---------
              37                     !          for condensation calculations.
              38                     !          the tables are initialised in *suphec*.
              39                     !----------------------------------------------------------------------
              40                       USE mo_constants,      ONLY: vtmpc1,   &
              41                                                    r5alvcp,  &
              42                                                    r5alscp,  &
              43                                                    c4les,    &
              44                                                    c4ies,    &
              45                                                    c3ies,    &
              46                                                    tmelt,    &
              47                                                    c3les,    &
              48                                                    c2es
              49                       USE mo_convect_tables, ONLY: tlucua,   & ! table a
              50                                                    tlucub,   & ! table b
              51                                                    tlucuc,   & ! table c
              52                                                    jptlucu1, jptlucu2, &
              53                                                    lookuperror, lookupoverflow
              54                     
              55                           implicit none
              56                     
              57                           integer  klev,klon
              58                     
              59                           real     pt(klon,klev),          pq(klon,klev),  &
              60                          &         psp(klon)
              61                           logical  ldflag(klon)
              62                     ! local variables
              63                           integer  jl,jk,nxj
              64                           integer  isum,kcall,kk
              65                           real     zqmax,zqsat,zcor,zqp,zcond,zcond1,zl,zi,zf
              66                           real     foealfa,foeldcpm,foeewm,foedem
              67                     !------------- ---------------------------------------------------------
              68                     !     1.           define constants
              69                     !                  ----------------
              70                           zqmax=0.5
              71                     !     2.           calculate condensation and adjust t and q accordingly
              72                     !                  -----------------------------------------------------
              73     1                     if ( kcall == 1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldflag
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 8
                                   <<<      SIMD&FP   : SPILL 3  FILL 3
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              74     2   s    s             do jl = 1, nxj
              75     3   p    v              if ( ldflag(jl) ) then
              76     3   p    v                zqp = 1./psp(jl)
              77     3   s    s                zl = 1./(pt(jl,kk)-c4les)
              78     3   s    s                zi = 1./(pt(jl,kk)-c4ies)
              79     3   s    s                zqsat = c2es*(foealfa(pt(jl,kk))*exp(c3les*(pt(jl,kk)-tmelt)*zl) + &
              80     3                               (1.-foealfa(pt(jl,kk)))*exp(c3ies*(pt(jl,kk)-tmelt)*zi))
              81     3   s    s                zqsat = zqsat*zqp
              82     3   s    s                zqsat = min(0.5,zqsat)
              83     3   s    s                zcor = 1. - vtmpc1*zqsat
              84     3   s    s                zf = foealfa(pt(jl,kk))*r5alvcp*zl**2 + &
              85     3                              (1.-foealfa(pt(jl,kk)))*r5alscp*zi**2
              86     3   s    s                zcond = (pq(jl,kk)*zcor**2-zqsat*zcor)/(zcor**2+zqsat*zf)
              87     4   s    s                if ( zcond > 0. ) then
              88     4   s    s                  pt(jl,kk) = pt(jl,kk) + foeldcpm(pt(jl,kk))*zcond
              89     4   s    s                  pq(jl,kk) = pq(jl,kk) - zcond
              90     4   s    s                  zl = 1./(pt(jl,kk)-c4les)
              91     4   s    s                  zi = 1./(pt(jl,kk)-c4ies)
              92     4   s    s                  zqsat = c2es*(foealfa(pt(jl,kk)) * &
              93     4                             exp(c3les*(pt(jl,kk)-tmelt)*zl)+(1.-foealfa(pt(jl,kk))) * &
              94     4                             exp(c3ies*(pt(jl,kk)-tmelt)*zi))
              95     4   s    s                  zqsat = zqsat*zqp
              96     4   s    s                  zqsat = min(0.5,zqsat)
              97     4   s    s                  zcor = 1. - vtmpc1*zqsat
              98     4   s    s                  zf = foealfa(pt(jl,kk))*r5alvcp*zl**2 + &
              99     4                                (1.-foealfa(pt(jl,kk)))*r5alscp*zi**2
             100     4   s    s                  zcond1 = (pq(jl,kk)*zcor**2-zqsat*zcor)/(zcor**2+zqsat*zf)
             101     4   s    s                  if ( abs(zcond) < 1.e-20 ) zcond1 = 0.
             102     4   s    s                  pt(jl,kk) = pt(jl,kk) + foeldcpm(pt(jl,kk))*zcond1
             103     4   p    v                  pq(jl,kk) = pq(jl,kk) - zcond1
             104     4   p    v                end if
             105     3   p    v              end if
             106     2   p    v            end do
             107     1                     elseif ( kcall == 2 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldflag
                                   <<< Loop-information  End >>>
             108     2   s    s            do jl = 1, nxj
             109     3   p    v              if ( ldflag(jl) ) then
             110     3   p    v                zqp = 1./psp(jl)
             111     3   s    s                zqsat = foeewm(pt(jl,kk))*zqp
             112     3   s    s                zqsat = min(0.5,zqsat)
             113     3   s    s                zcor = 1./(1.-vtmpc1*zqsat)
             114     3   s    s                zqsat = zqsat*zcor
             115     3   s    s                zcond = (pq(jl,kk)-zqsat)/(1.+zqsat*zcor*foedem(pt(jl,kk)))
             116     3   s    s                zcond = min(zcond,0.)
             117     3   s    s                pt(jl,kk) = pt(jl,kk) + foeldcpm(pt(jl,kk))*zcond
             118     3   s    s                pq(jl,kk) = pq(jl,kk) - zcond
             119     3   s    s                zqsat = foeewm(pt(jl,kk))*zqp
             120     3   s    s                zqsat = min(0.5,zqsat)
             121     3   s    s                zcor = 1./(1.-vtmpc1*zqsat)
             122     3   s    s                zqsat = zqsat*zcor
             123     3   s    s                zcond1 = (pq(jl,kk)-zqsat)/(1.+zqsat*zcor*foedem(pt(jl,kk)))
             124     3   s    s                if ( abs(zcond) < 1.e-20 ) zcond1 = min(zcond1,0.)
             125     3   m    m                pt(jl,kk) = pt(jl,kk) + foeldcpm(pt(jl,kk))*zcond1
             126     3   p    v                pq(jl,kk) = pq(jl,kk) - zcond1
             127     3   p    v              end if
             128     2   p    v            end do
             129     1                     else if ( kcall == 0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      psp, pq, pt
                                   <<< Loop-information  End >>>
             130     2   s    s             do jl = 1, nxj
             131     2   p    v              zqp = 1./psp(jl)
             132     2   s    s              zqsat = foeewm(pt(jl,kk))*zqp
             133     2   s    s              zqsat = min(0.5,zqsat)
             134     2   s    s              zcor = 1./(1.-vtmpc1*zqsat)
             135     2   s    s              zqsat = zqsat*zcor
             136     2   s    s              zcond1 = (pq(jl,kk)-zqsat)/(1.+zqsat*zcor*foedem(pt(jl,kk)))
             137     2   s    s              pt(jl,kk) = pt(jl,kk) + foeldcpm(pt(jl,kk))*zcond1
             138     2   s    s              pq(jl,kk) = pq(jl,kk) - zcond1
             139     2   s    s              zqsat = foeewm(pt(jl,kk))*zqp
             140     2   s    s              zqsat = min(0.5,zqsat)
             141     2   s    s              zcor = 1./(1.-vtmpc1*zqsat)
             142     2   s    s              zqsat = zqsat*zcor
             143     2   s    s              zcond1 = (pq(jl,kk)-zqsat)/(1.+zqsat*zcor*foedem(pt(jl,kk)))
             144     2   s    s              pt(jl,kk) = pt(jl,kk) + foeldcpm(pt(jl,kk))*zcond1
             145     2   p    v              pq(jl,kk) = pq(jl,kk) - zcond1
             146     2   p    v            end do
             147     1                     end if
             148                     
             149                           return
             150                           end subroutine cuadjtq_n


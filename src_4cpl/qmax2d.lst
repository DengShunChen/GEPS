 External subroutine subprogram "qmax2d"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine qmax2d (fld,i1,j1,im,jm)
               2                     !
               3                     !  subroutine to print max and min in 2-d layer (or a subarray)
               4                     !  within a 3-d field stored with n-s index slowest varying
               5                     !
               6                     !  ***input***
               7                     !
               8                     !  fld: input array
               9                     !  i1: starting index of first dimension (e-w)
              10                     !  j1: starting index of third dimension (n-s)
              11                     !  im: first dimension
              12                     !  jm: third dimension
              13                     !
              14                     ! *****************************************************************
              15                     !
              16                           use rank
              17                           use index
              18                     
              19                           real fld(im,jm)
              20                     !
              21                           xmin= 1.0e25
              22                           xmax= -1.0e25
              23                           imin=1
              24                           jmin=1
              25                           imax=1
              26                           jmax=1
              27                     !
              28     1                     do 10 j=j1,jm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<< Loop-information  End >>>
              29     2  pp    s            do 10 i=i1,im
              30     3   p    s            if (fld(i,j).lt.xmin) then
              31     3   p    s            xmin= fld(i,j)
              32     3   p    m            jmin= j
              33     3   p    v            imin= i
              34     3   p    v            endif
              35     3   p    s            if (fld(i,j).gt.xmax) then
              36     3   p    s            xmax= fld(i,j)
              37     3   p    m            jmax= j
              38     3   p    v            imax= i
              39     3   p    m            endif
              40     1   p    s         10 continue
              41                     !
              42                           if(myrank .eq. 0) print 8995, imax,jmax,xmax,imin,jmin,xmin
              43                     !
              44                      8995 format(' imax=',i4,' jmax=',i4,' xmax=',g20.12                   &
              45                           ,' imin=',i4,' jmin=',i4,' xmin=',g20.12)
              46                     !
              47                           return
              48                           end


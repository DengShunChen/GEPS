 External subroutine subprogram "drychk"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine drychk (j,tt,plk,dp,nxj,nx,lev,ncon )
               2                     !
               3                     !     perform dry convective adjustment check and collect
               4                     !     all unsatble points together for the adjustment
               5                     !
               6                     !     tt(nx,lev)    : real temperature (k),
               7                     !     plk(nx,lev)   : pl**kapa at model odd levels,
               8                     !     dp(lev)       : sigma thickness of layers,
               9                     !     nx           : horizontal dimension
              10                     !     lev           : vertical dimension
              11                     !
              12                     !     by c.s. liou  6/92
              13                     !     modify to f90 by C-H Lee and sort by River Chen in 2015
              14                     !
              15                           use const, only: RTYPE
              16                     !
              17                           implicit  none
              18                     
              19                           integer   j,nxj,nx,lev,ncon
              20                           real      dp(lev)
              21                           real(kind=RTYPE) tt(nx,lev),plk(nx,lev)
              22                     !
              23                     !     local work array
              24                     !
              25                           integer   indx(nx)
              26                           real      store(nx,lev)
              27                           logical   unstbl(nx)
              28                     !
              29                           integer   nxlev,lm1,i,k,l,il
              30                           real      eps
              31                     
              32                           eps   = 0.1
              33                           nxlev = nx*lev
              34                           lm1   = lev - 1
              35                     !
              36                     !     compute potential temperature
              37                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plk, tt, store
                                   <<< Loop-information  End >>>
              38     1  pp                 do 50 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plk, tt, store
                                   <<< Loop-information  End >>>
              39     2   p   2v            do 50 i = 1, nxj
              40     2   p   2v            store(i,k) = tt(i,k)/plk(i,k)
              41     1   p   2v        50  continue
              42                     !
              43                     !     detect unstable points
              44                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 112, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      unstbl, store
                                   <<< Loop-information  End >>>
              45     1  pp   2v            do 100 i = 1, nxj
              46     1   p   2v            unstbl(i) = (store(i,2)-store(i,1)) .ge. eps
              47     1   p   2v        100 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      store, unstbl
                                   <<< Loop-information  End >>>
              48     1                     do 200 l = 2, lm1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      store, unstbl
                                   <<< Loop-information  End >>>
              49     2  pp   2v            do 200 i = 1, nxj
              50     2   p   2v            unstbl(i) = unstbl(i) .or. ( (store(i,l+1)-store(i,l)).ge.eps )
              51     1   p   2v        200 continue
              52                           ncon = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      unstbl
                                   <<< Loop-information  End >>>
              53     1   s   2s            do 300 i = 1, nxj
              54     2   p   2v            if ( unstbl(i) ) then
              55     2   m   2m            ncon = ncon + 1
              56     2   m   2v            indx(ncon)= i
              57     2   p   2v            endif
              58     1   p   2v        300 continue
              59                           if ( ncon .eq. 0 )  return
              60                     !
              61                     !     pack 'tt/plk' of unstable points into work array 'store'
              62                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      indx, store
                                   <<< Loop-information  End >>>
              63     1                     do 400 l=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.46, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      indx, store
                                   <<< Loop-information  End >>>
              64     2  pp   2v            do 400 i = 1, ncon
              65     2   p   2v               il = (l-1)*ncon + i
              66     2   p   2v               store(il,1) = tt(indx(i),l)/plk(indx(i),l)
              67     1   p   2v        400 continue
              68                     !
              69                     !     adjust real temperature tt to dry adiabatic profile
              70                     !
              71                           call drycon (j,indx,store,dp,ncon,lev )
              72                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      indx, store
                                   <<< Loop-information  End >>>
              73     1  pp                 do 500 l=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.90, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      store, indx
                                   <<< Loop-information  End >>>
              74     2   p   2v            do 500 i = 1, ncon
              75     2   p   2v               il = (l-1)*ncon + i
              76     2   p   2v               tt(indx(i),l) = store(il,1)*plk(indx(i),l)
              77     1   p   2v        500 continue
              78                     !
              79                           return
              80                           end


             919     4  pp    v                  do n = 1, ncld-1
             920     4   p    v                     kk=k+(n-1)*lev
             921     4   p    v                     qtot(i,jj)=qtot(i,jj)+qt(i,kk,jj)
             922     4   p    v                  enddo
             923     3                           sumtott(i,jj) = sumtott(i,jj)+dsigp
             924     3                           sumwatt(i,jj) = sumwatt(i,jj)+dsigp*qtot(i,jj)

             808                     !ch<
             809                     
             810                     !
             811                     !  the gaussian quadrature loop for spectral tendencies.  subroutine
             812                     !  'gridnl' is called for companion mirror image gaussian latitudes
             813                     !  these non-linear contributions are then combined in 'rstran' using
             814                     !  the symmetry properties of the spherical harmonics
             815                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 28  FILL 42
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             816     1                     do jj = 1, jlistnum
             817     1               
             818     1                       j=jlist1(jj)

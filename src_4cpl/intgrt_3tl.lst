               5                            subroutine intgrt_3tl
               6                     !
               7                     !***********************************************************************
               8                     !  this subroutine is the basic time stepping driver.  it does the
               9                     !  gaussian quadrature integrations to compute the adiabatic spectral
              10                     !  tendencies for the model variables. these tendencies are adjusted
              11                     !  with a semi-implicit method to make the model stable for long
              12                     !  time steps.  time steps are made with a time filter to remove
              13                     !  any computational modes.
              14                     !
              15                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              16                     !
              17                     !***********************************************************************
              18                     !

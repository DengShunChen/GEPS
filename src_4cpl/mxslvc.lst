               1                           subroutine mxslvc ( aa, mn, mt, kk )
               2                     !
               3                     !###############################################################
               4                     !
               5                     !  1. function specification
               6                     !
               7                     !    solve a matrix of a band-structured type coming from
               8                     !    two-stream approximations with cloud overlapping treatment
               9                     !
              10                     !  2. input/output variables :
              11                     !
              12                     !    aa (in) : matrix of coefficients and r.h.s. forcing
              13                     !              1st-5th  columns = elements left to the diagonal
              14                     !                  6th  column  = diagonal elements
              15                     !             7th-11th  columns = elements right to the diagonal
              16                     !                 12th  column  = r.h.s. forcings
              17                     !                                 need change two lows each other
              18                     !    aa (out): 6th-11th columns = upper tri-diagonal matrix
              19                     !                  12th colimn  = solutions of the matrix
              20                     !     mn   : horizontal dimension of aa
              21                     !     mt   : number of matrix sets (horizontal points) to be updated
              22                     !     kk   : vertical dimension of aa,
              23                     !            4 * lev ,  lev : number of model layers
              24                     !
              25                     !  3. date & author
              26                     !
              27                     !     c. t. fong   july, 1996
              28                     !     modify to f90 by C-H Lee and sort by River Chen in 2015
              29                     !
              30                     !#####################################################################
              31                     !
              32                     
              33                           use fj_pad
              34                     
              35                           implicit  none
              36                     
              37                           integer   mn, mt, kk
              38                           real      aa(mn+npad,kk,12)
              39                     !
              40                     !  local working arrays
              41                     !
              42                           integer   lev,k,kini,i,m,km,jm,j,ln,kl,jl,jj
              43                           real      vmin,tmp,zzz
              44                     
              45                           lev = kk / 4
              46                           vmin = 1.0e-5
              47                     !
              48                     !    eliminate all elements below the diagonal
              49                     !
              50     1                     if ( lev .eq. 1 ) then
              51     1                     print*,' only one model layer not allowed, job stop '
              52     1                     stop
              53     1                     end if
              54                     !
              55     1                     do 500 k = 2, lev-1
              56     1                     kini = (k-1)*4
              57     1               !
              58     1               !ocl norecurrence

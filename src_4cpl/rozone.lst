               1                           subroutine rozone (nxj,im,lm,pp,o3l,sinl,julian)
               2                     !
               3                     !######################################################################c
               4                     !  --- for application sinl is a constant  (faster) ---                c
               5                     !  --- this is new version using new ozone data source --              c
               6                     !                                                                      c
               7                     ! a. function:                                                         c
               8                     !  subroutine rozone generates  a seasonal varying, zonal mean         c
               9                     !  clmotology of atmospheric ozone for use in long and short wave      c
              10                     !  radiation.                                                          c
              11                     !  climatology of new ozone concentrations from r. d. mcpeters,        c
              12                     !  heath, d.f., and bhartia, p.k. paper: average ozone profiles        c
              13                     !  for 1979 from the nimbus 7 sbuv instrument, journal of geophysical  c
              14                     !  research, vol. 89, no. d4, pages 5199-5214, june 30, 1984           c
              15                     !                                                                      c
              16                     ! b. common block specification:                                       c
              17                     !    none                                                              c
              18                     !                                                                      c
              19                     ! c. parameter specification:                                          c
              20                     !    none                                                              c
              21                     !                                                                      c
              22                     ! d. input/output variables:                                           c
              23                     !    im    : longitudial dimension of the model                        c
              24                     !    lm    : vertical layers of the model                              c
              25                     !    pp(im,lm) : pressures at odd levels (mb)                          c
              26                     !    o3l(im,lm): climatology ozone concentration at the model grids    c
              27                     !    sinl      : sin of latitude of the grids                          c
              28                     !    julian: julian day                                                c
              29                     !                                                                      c
              30                     !  e. calling modules:                                                 c
              31                     !     outside radtn                                                    c
              32                     !                                                                      c
              33                     !  f. usage:                                                           c
              34                     !     call rozone( im,lm,pp,o3l,sinl,julian )                          c
              35                     !                                                                      c
              36                     !  g. modules called:                                                  c
              37                     !     lninth                                                           c
              38                     !                                                                      c
              39                     !  h. limitation:                                                      c
              40                     !     none                                                             c
              41                     !                                                                      c
              42                     !  i. date:                                                            c
              43                     !     created: jul 15, 1993                                            c
              44                     !                                                                      c
              45                     !  j. auther:                                                          c

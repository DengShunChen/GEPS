            1437                     !----------------------------------------------------------------------------------------
            1438                           subroutine mpe2d_reshape_pl_back_sp(plin,plout)
            1439                     
            1440                     ! reshape spec coef back
            1441                     
            1442                           use mpi
            1443                           use param
            1444                           use index
            1445                     
            1446                           implicit none
            1447                     
            1448                           integer n,i,j,m,mf,ierr
            1449                     
            1450                           real*4 plin(jtp,2)
            1451                           real*4 plout(jtrun,jtmax,2)
            1452                           real*4 b2(jtp,2,nsizex)
            1453                     
            1454                           call MPI_ALLGATHER( plin, jtp*2, MPI_REAL4, &
            1455                                               b2,   jtp*2, MPI_REAL4, &
            1456                                               row_comm, IERR )
            1457                     
            1458                           i=1
            1459                           j=1
            1460                     
            1461     1                     do m=1,mlistnum
            1462     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jtlen_all, plout
                                   <<< Loop-information  End >>>
            1463     2       2s            do n=mf,jtrun
            1464     2       2m               plout(n,m,1)=b2(i,1,j)
            1465     2       2v               plout(n,m,2)=b2(i,2,j)
            1466     2       2s               i=i+1
            1467     3       2s               if(i.gt.jtlen_all(j))then
            1468     3       2s                  i=1
            1469     3       2m                  j=j+1
            1470     3       2v               endif
            1471     2       2v            enddo
            1472     1                     enddo
            1473                     
            1474                           return
            1475                           end


  (inc)(line-no.)(nest)(optimize)
             297                     !-------------------------------------------------------------------------------------------------
             298                           subroutine mpe2d_reshape_eps4(eps4in,eps4out)
             299                     
             300                     ! reshape eps4, used in siimpl
             301                     
             302                           use mpi
             303                           use param
             304                           use index
             305                           use const, only: RTYPE
             306                     
             307                           implicit none
             308                     
             309                           integer i,j,m,mf,nl
             310                     
             311                           real(kind=RTYPE) eps4in(jtrun,jtmax)
             312                           real(kind=RTYPE) eps4out(jtp)
             313                           real(kind=RTYPE) b1(jtf)
             314                     
             315                           i=1
             316                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4in, b1
                                   <<< Loop-information  End >>>
             317     1                     do m=1,mlistnum
             318     1                        mf=mlist(m)
             319     1                        NL=jtrun-mf+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4in, b1
                                   <<< Loop-information  End >>>
             320     1  pp   2v               b1(i:i+nl-1)=eps4in(mf:jtrun,m)
             321     1                        i=i+NL
             322     1                     enddo
             323                     
             324                           i=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b1, eps4out
                                   <<< Loop-information  End >>>
             325     1  pp   2v            do j=jtstart,jtend
             326     1   p   2v               i=i+1
             327     1   p   2v               eps4out(i)=b1(j)
             328     1   p   2v            enddo
             329                     
             330                           return
             331                           end


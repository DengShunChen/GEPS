 External subroutine subprogram "mpe2d_get_allrow"
  (inc)(line-no.)(nest)(optimize)
             332                     !----------------------------------------------------------------------------------------
             333                           subroutine mpe2d_get_allrow(n,a,a_all)
             334                     
             335                     ! gather all data of a row
             336                     
             337                           use index,only : row_comm
             338                           use mpi
             339                     
             340                           integer a(*),a_all(*)
             341                     
             342                           call MPI_ALLGATHER( a,     n, MPI_INTEGER, &
             343                                               a_all, n, MPI_INTEGER, &
             344                                               row_comm,  IERR )
             345                           return
             346                           end


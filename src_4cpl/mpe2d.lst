             364                           subroutine mpe2d_unify(work,a,opt)
             365                     
             366                     ! unify a(nx_partial,my_partial) into work(nx_full,my_full)
             367                     
             368                           use param
             369                           use rank
             370                           use index
             371                           use mpi
             372                           use const, only: RTYPE,MPI_RTYPE
             373                     
             374                           real(kind=RTYPE) work(nx,my)
             375                           real(kind=RTYPE) a(nxp,my_max)
             376                           real(kind=RTYPE) b(nxp,my_max*nsize)
             377                           logical, optional :: opt
             378                     
             379                           call MPI_ALLGATHER( a,nxp*my_max, MPI_RTYPE, &
             380                                               b,nxp*my_max, MPI_RTYPE, &
             381                                               MPI_COMM_gfs, IERR )
             382                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             383     1  pp                 do j=1,my
             384     1   p                    ii=1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b, work
                                   <<< Loop-information  End >>>
             385     2   p                 do i=1,nsizex
             386     2   p                    jf=jlist2_2d(i,j)
             387     2   p                    nn=nxjlen_all(i,j)
             388     2   p                    if(present(opt)) nn=nxp
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b, work
                                   <<< Loop-information  End >>>
             389     2   p   2v               work(ii:ii+nn-1,j)=b(1:nn,jf)
             390     2   p                    ii=ii+nn
             391     2   p                 enddo
             392     1   p                 enddo
             393                     
             394                           return
             395                           end


 External subroutine subprogram "mpe2d_unify_lev"
  (inc)(line-no.)(nest)(optimize)
            1021                     !----------------------------------------------------------------------------------------
            1022                           subroutine mpe2d_unify_lev(ain,aout,lev,levp,jtrun,jtmax,mlistnum,proc,comm)
            1023                     
            1024                     ! unify lev of spectrum var
            1025                     
            1026                           use mpi
            1027                           use const,only : RTYPE,MPI_RTYPE
            1028                     
            1029                           implicit none
            1030                     
            1031                           integer lev,levp,jtrun,jtmax,mlistnum,proc,comm,ii,j,jj,k,kk,ierr
            1032                     
            1033                           real(kind=RTYPE) ain(levp,2,jtrun,jtmax)
            1034                           real(kind=RTYPE) aout(lev,2,jtrun,jtmax)
            1035                           real(kind=RTYPE) b1(levp,2,jtrun,jtmax)
            1036                           real(kind=RTYPE) b2(levp,2,jtrun,jtmax,proc)
            1037                     
            1038                           call MPI_ALLGATHER( ain, levp*2*jtrun*jtmax, MPI_RTYPE, &
            1039                                                b2, levp*2*jtrun*jtmax, MPI_RTYPE, &
            1040                                               comm,IERR )
            1041                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1042     1  pp                 do jj=1,mlistnum
            1043     2   p                 do j=1,jtrun
            1044     2   p                    kk=1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b2, aout
                                   <<< Loop-information  End >>>
            1045     3   p                 do ii=1,proc
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b2, aout
                                   <<< Loop-information  End >>>
            1046     3   p   2v               aout(kk:kk+levp-1,1,j,jj)=b2(1:levp,1,j,jj,ii)
            1047     3   p   2v               aout(kk:kk+levp-1,2,j,jj)=b2(1:levp,2,j,jj,ii)
            1048     3   p                    kk=kk+levp
            1049     3   p                 enddo
            1050     2   p                 enddo
            1051     1   p                 enddo
            1052                     
            1053                           return
            1054                           end


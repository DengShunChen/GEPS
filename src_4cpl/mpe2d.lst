 External subroutine subprogram "mpe2d_reshape_pl_back"
  (inc)(line-no.)(nest)(optimize)
             683                     !----------------------------------------------------------------------------------------
             684                           subroutine mpe2d_reshape_pl_back(plin,plout)
             685                     
             686                     ! reshape spec coef back
             687                     
             688                           use mpi
             689                           use param
             690                           use index
             691                           use const,only : RTYPE,MPI_RTYPE
             692                     
             693                           implicit none
             694                     
             695                           integer n,i,j,m,mf,ierr
             696                     
             697                           real(kind=RTYPE) plin(jtp,2)
             698                           real(kind=RTYPE) plout(jtrun,jtmax,2)
             699                           real(kind=RTYPE) b2(jtp,2,nsizex)
             700                     
             701                           call MPI_ALLGATHER( plin, jtp*2, MPI_RTYPE, &
             702                                               b2,   jtp*2, MPI_RTYPE, &
             703                                               row_comm, IERR )
             704                     
             705                           i=1
             706                           j=1
             707                     
             708     1                     do m=1,mlistnum
             709     1                        mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jtlen_all, plout
                                   <<< Loop-information  End >>>
             710     2       2s            do n=mf,jtrun
             711     2       2m               plout(n,m,1)=b2(i,1,j)
             712     2       2v               plout(n,m,2)=b2(i,2,j)
             713     2       2s               i=i+1
             714     3       2s               if(i.gt.jtlen_all(j))then
             715     3       2s                  i=1

               1                           subroutine maxp ( mn,aa,amx,imx )
               2                     !
               3                     !     find out the max value and location of the array aa
               4                     !
               5                           implicit  none
               6                           integer   mn,imx,i
               7                           real      aa(mn),amx
               8                     !
               9                           imx = 1
              10                           amx = aa(1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<< Loop-information  End >>>
              11     1  pp    s            do 100 i = 2, mn
              12     2   p    v            if ( aa(i) .gt. amx )  then
              13     2   p    m               imx = i
              14     2   p    s               amx = aa(i)
              15     2   p    m            endif
              16     1   p    s        100 continue
              17                     !
              18                     !ccc  imx = ismax ( mn,aa,1 )
              19                     !ccc  amx = aa(imx)
              20                     !
              21                           return
              22                           end


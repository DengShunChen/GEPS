               1                           MODULE module_microphysics
               2                     !
               3                           USE MACHINE , ONLY : kind_phys
               4                           USE FUNCPHYS
               5                           USE PHYSCONS, CP => con_CP, RD => con_RD, RV => con_RV            &
               6                          &,             T0C => con_T0C, HVAP => con_HVAP, HFUS => con_HFUS  &
               7                          &,             EPS => con_EPS, EPSM1 => con_EPSM1                  &
               8                          &,             EPS1 => con_FVirt, pi => con_pi, grav => con_g
               9                           implicit none
              10                     !
              11                     !--- Common block of constants used in column microphysics
              12                     !
              13                           real,private ::  ABFR, CBFR, CIACW, CIACR, C_N0r0,                 &
              14                          &CN0r0, CN0r_DMRmin, CN0r_DMRmax, CRACW, CRAUT, ESW0,               &
              15                     !    &QAUT0, RFmax, RHgrd, RQR_DR1, RQR_DR2, RQR_DR3, RQR_DRmin,         &
              16                          &QAUTx, RFmax,        RQR_DR1, RQR_DR2, RQR_DR3, RQR_DRmin,         &
              17                          &RQR_DRmax, RR_DRmin, RR_DR1, RR_DR2, RR_DR3, RR_DRmax
              18                     !
              19                           real,private :: mic_step
              20                     !
              21                     !--- Common block for lookup table used in calculating growth rates of
              22                     !    nucleated ice crystals growing in water saturated conditions
              23                     !--- Discretized growth rates of small ice crystals after their nucleation
              24                     !     at 1 C intervals from -1 C to -35 C, based on calculations by Miller
              25                     !     and Young (1979, JAS) after 600 s of growth.  Resultant growth rates
              26                     !     are multiplied by physics time step in GSMCONST.
              27                     !
              28                           INTEGER, PRIVATE,PARAMETER :: MY_T1=1, MY_T2=35
              29                           REAL,PRIVATE,DIMENSION(MY_T1:MY_T2) :: MY_GROWTH
              30                     !
              31                     !--- Parameters for ice lookup tables, which establish the range of mean ice particle
              32                     !      diameters; from a minimum mean diameter of 0.05 mm (DMImin) to a
              33                     !      maximum mean diameter of 1.00 mm (DMImax).  The tables store solutions
              34                     !      at 1 micron intervals (DelDMI) of mean ice particle diameter.
              35                     !
              36                           REAL, PRIVATE,PARAMETER :: DMImin=.05e-3, DMImax=1.e-3,             &
              37                          &      DelDMI=1.e-6,XMImin=1.e6*DMImin, XMImax=1.e6*DMImax
              38                           INTEGER, PRIVATE,PARAMETER :: MDImin=XMImin, MDImax=XMImax
              39                     !
              40                     !--- Various ice lookup tables
              41                     !
              42                           REAL, PRIVATE,DIMENSION(MDImin:MDImax) ::                           &
              43                          &      ACCRI,MASSI,SDENS,VSNOWI,VENTI1,VENTI2
              44                     !
              45                     !--- Mean rain drop diameters varying from 50 microns (0.05 mm) to 450 microns
              46                     !      (0.45 mm), assuming an exponential size distribution.
              47                     !
              48                           REAL, PRIVATE,PARAMETER :: DMRmin=.05e-3, DMRmax=.45e-3,            &
              49                          &      DelDMR=1.e-6,XMRmin=1.e6*DMRmin, XMRmax=1.e6*DMRmax           &
              50                          &,     NLImin=100.
              51                     !    &,     NLImin=100., NLImax=20.E3
              52                           INTEGER, PRIVATE,PARAMETER :: MDRmin=XMRmin, MDRmax=XMRmax
              53                     !
              54                         !--- Factor of 1.5 for RECImin, RESNOWmin, & RERAINmin accounts for
              55                         !    integrating exponential distributions for effective radius
              56                         !    (i.e., the r**3/r**2 moments).
              57                         !
              58                     !     INTEGER, PRIVATE, PARAMETER :: INDEXSmin=300
              59                     !!    INTEGER, PRIVATE, PARAMETER :: INDEXSmin=200
              60                           INTEGER, PRIVATE, PARAMETER :: INDEXSmin=100
              61                           REAL, PRIVATE, PARAMETER :: RERAINmin=1.5*XMRmin                  &
              62                     !    &, RECImin=1.5*XMImin, RESNOWmin=1.5*INDEXSmin, RECWmin=8.0
              63                     !    &, RECImin=1.5*XMImin, RESNOWmin=1.5*INDEXSmin, RECWmin=7.5
              64                          &, RECImin=1.5*XMImin, RESNOWmin=1.5*INDEXSmin, RECWmin=10.
              65                     !    &, RECImin=1.5*XMImin, RESNOWmin=1.5*INDEXSmin, RECWmin=15.
              66                     !    &, RECImin=1.5*XMImin, RESNOWmin=1.5*INDEXSmin, RECWmin=5.
              67                     
              68                     !
              69                     !--- Various rain lookup tables
              70                     !--- Rain lookup tables for mean rain drop diameters from DMRmin to DMRmax,
              71                     !      assuming exponential size distributions for the rain drops
              72                     !
              73                           REAL, PRIVATE,DIMENSION(MDRmin:MDRmax)::                          &
              74                          &      ACCRR,MASSR,RRATE,VRAIN,VENTR1,VENTR2
              75                     !
              76                     !--- Common block for riming tables
              77                     !--- VEL_RF - velocity increase of rimed particles as functions of crude
              78                     !      particle size categories (at 0.1 mm intervals of mean ice particle
              79                     !      sizes) and rime factor (different values of Rime Factor of 1.1**N,
              80                     !      where N=0 to Nrime).
              81                     !
              82                           INTEGER, PRIVATE,PARAMETER :: Nrime=40
              83                           REAL, DIMENSION(2:9,0:Nrime),PRIVATE :: VEL_RF
              84                     !
              85                     !--- The following variables are for microphysical statistics
              86                     !
              87                           INTEGER, PARAMETER :: ITLO=-60, ITHI=40
              88                           INTEGER  NSTATS(ITLO:ITHI,4)
              89                           REAL     QMAX(ITLO:ITHI,5),  QTOT(ITLO:ITHI,22)
              90                     !
              91                           REAL, PRIVATE,  PARAMETER ::                                      &
              92                     !    &  T_ICE=-10., T_ICE_init=-5.      !- Ver1
              93                     !!!  &, T_ICE=-20.                      !- Ver2
              94                          &  T_ICE=-40., T_ICE_init=-15.     !- Ver2
              95                     !    &  T_ICE=-30., T_ICE_init=-5.      !- Ver2
              96                     !
              97                     !     Some other miscellaneous parameters
              98                     !
              99                           REAL, PRIVATE, PARAMETER :: Thom=T_ICE, TNW=50., TOLER=1.0E-20    &
             100                     !     REAL, PRIVATE, PARAMETER :: Thom=T_ICE, TNW=50., TOLER=5.E-7
             101                     !     REAL, PRIVATE, PARAMETER :: Thom=-35., TNW=50., TOLER=5.E-7
             102                     !    &, emisCU=.75/1.66       ! Used for convective cloud l/w emissivity
             103                     ! Assume fixed cloud ice effective radius
             104                          &, RECICE=RECImin                                                  &
             105                          &, EPSQ=1.0E-20                                                    &
             106                     !    &, EPSQ=1.E-12                                                     &
             107                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.16                 &
             108                          &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0
             109                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.15
             110                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.170                &
             111                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.175                &
             112                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.18
             113                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.2   ! 20060512     &
             114                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.25                 &
             115                     !    &, FLG0P1=0.1, FLG0P2=0.2, FLG1P0=1.0, FLGmin=0.3                  &
             116                     !
             117                     !
             118                           CONTAINS
             119                     !
             120                     !#######################################################################
             121                     !------- Initialize constants & lookup tables for microphysics ---------
             122                     !#######################################################################
             123                     !
             124                           SUBROUTINE GSMCONST (DTPG,mype,first)
             125                     !
             126                           implicit none
             127                     !-------------------------------------------------------------------------------
             128                     !---  SUBPROGRAM DOCUMENTATION BLOCK
             129                     !   PRGRMMR: Ferrier         ORG: W/NP22     DATE: February 2001
             130                     !-------------------------------------------------------------------------------
             131                     ! ABSTRACT:
             132                     !   * Reads various microphysical lookup tables used in COLUMN_MICRO
             133                     !   * Lookup tables were created "offline" and are read in during execution
             134                     !   * Creates lookup tables for saturation vapor pressure w/r/t water & ice
             135                     !-------------------------------------------------------------------------------
             136                     !
             137                     ! USAGE: CALL GSMCONST FROM SUBROUTINE GSMDRIVE AT MODEL START TIME
             138                     !
             139                     !   INPUT ARGUMENT LIST:
             140                     !       DTPH - physics time step (s)
             141                     !
             142                     !   OUTPUT ARGUMENT LIST:
             143                     !     NONE
             144                     !
             145                     !   OUTPUT FILES:
             146                     !     NONE
             147                     !
             148                     !
             149                     !   SUBROUTINES:
             150                     !     MY_GROWTH_RATES - lookup table for growth of nucleated ice
             151                     !
             152                     !   UNIQUE: NONE
             153                     !
             154                     !   LIBRARY: NONE
             155                     !
             156                     !
             157                     ! ATTRIBUTES:
             158                     !   LANGUAGE: FORTRAN 90
             159                     !   MACHINE : IBM SP
             160                     !
             161                           integer mype
             162                           real    dtpg
             163                           logical first
             164                     !
             165                     !--- Parameters & data statement for local calculations
             166                     !
             167                           REAL, PARAMETER :: C1=1./3., DMR1=.1E-3, DMR2=.2E-3, DMR3=.32E-3, &
             168                          & N0r0=8.E6, N0s0=4.E6, RHOL=1000., RHOS=100.,                     &
             169                          & XMR1=1.e6*DMR1, XMR2=1.e6*DMR2, XMR3=1.e6*DMR3
             170                           INTEGER, PARAMETER :: MDR1=XMR1, MDR2=XMR2, MDR3=XMR3
             171                     !
             172                           real dtph, etime1, etime2, timef, bbfr
             173                           integer i
             174                     !
             175                     !--- Added on 5/16/01 for Moorthi
             176                     !
             177                           logical, parameter :: read_lookup=.false., write_lookup=.false.
             178                     !
             179                     !------------------------------------------------------------------------
             180                     !  *************  Parameters used in ETA model -- Not used in Global Model *****
             181                     !
             182                     !--- DPHD, DLMD are delta latitude and longitude at the model (NOT geodetic) equator
             183                     !    => "DX" is the hypotenuse of the model zonal & meridional grid increments.
             184                     !
             185                     !     DX=111.*(DPHD**2+DLMD**2)**.5         ! Resolution at MODEL equator (km)
             186                     !     DX=MIN(100., MAX(5., DX) )
             187                     !
             188                     !--- Assume the following functional relationship for key constants that
             189                     !    depend on grid resolution from DXmin (5 km) to DXmax (100 km) resolution:
             190                     !
             191                     !     DXmin=5.
             192                     !     DXmax=100.
             193                     !     DX=MIN(DXmax, MAX(DXmin, DX) )
             194                     !
             195                     !--- EXtune determines the degree to which the coefficients change with resolution.
             196                     !    The larger EXtune is, the more sensitive the parameter.
             197                     !
             198                     !     EXtune=1.
             199                     
             200                     !
             201                     !--- FXtune ==> F(DX) is the grid-resolution tuning parameter (from 0 to 1)
             202                     !
             203                     !     FXtune=((DXmax-DX)/(DXmax-DXmin))**EXtune
             204                     !     FXtune=MAX(0., MIN(1., FXtune))
             205                     !
             206                     !--- Calculate grid-averaged RH for the onset of condensation (RHgrd) based on
             207                     !    simple ***ASSUMED*** (user-specified) values at DXmax and at DXmin.
             208                     !
             209                     !     RH_DXmax=.90              !-- 90% RH at DXmax=100 km
             210                     !     RH_DXmin=.98              !-- 98% RH at DXmin=5 km
             211                     !
             212                     !--- Note that RHgrd is right now fixed throughout the domain!!
             213                     !
             214                     !     RHgrd=RH_DXmax+(RH_DXmin-RH_DXmax)*FXtune
             215                     !   ********************************************************************************
             216                     !
             217                     !
             218     1                     if (first) then
             219     1               !
             220     1               !--- Read in various lookup tables
             221     1               !
             222     2                     if ( read_lookup ) then
             223     2                       OPEN (UNIT=1,FILE="eta_micro_lookup.dat",FORM="UNFORMATTED")
             224     2                       READ(1) VENTR1
             225     2                       READ(1) VENTR2
             226     2                       READ(1) ACCRR
             227     2                       READ(1) MASSR
             228     2                       READ(1) VRAIN
             229     2                       READ(1) RRATE
             230     2                       READ(1) VENTI1
             231     2                       READ(1) VENTI2
             232     2                       READ(1) ACCRI
             233     2                       READ(1) MASSI
             234     2                       READ(1) VSNOWI
             235     2                       READ(1) VEL_RF
             236     2               !       read(1) my_growth    ! Applicable only for DTPH=180 s for offline testing
             237     2                       CLOSE (1)
             238     2                     else
             239     2                       etime1=timef()
             240     2                       CALL ICE_LOOKUP                   ! Lookup tables for ice
             241     2                       etime2=timef()
             242     2                       if (mype .eq. 0)                                                &
             243     2                    &  print *,'CPU time (sec) in ICE_LOOKUP = ',(etime2-etime1)*0.001
             244     2                       CALL RAIN_LOOKUP                  ! Lookup tables for rain
             245     2                       etime1=timef()
             246     2                       if (mype .eq. 0)                                                &
             247     2                    &  print *,'CPU time (sec) in RAIN_LOOKUP = ',(etime1-etime2)*0.001
             248     3                       if (write_lookup) then
             249     3                         open(unit=1,file='micro_lookup.dat',form='unformatted')
             250     3                         write(1) ventr1
             251     3                         write(1) ventr2
             252     3                         write(1) accrr
             253     3                         write(1) massr
             254     3                         write(1) vrain
             255     3                         write(1) rrate
             256     3                         write(1) venti1
             257     3                         write(1) venti2
             258     3                         write(1) accri
             259     3                         write(1) massi
             260     3                         write(1) vsnowi
             261     3                         write(1) vel_rf
             262     3               !         write(1) my_growth    ! Applicable only for DTPH=180 s ????
             263     3                         CLOSE (1)
             264     3                       endif
             265     2                     endif
             266     1               !!
             267     1               !--- Constants associated with Biggs (1953) freezing of rain, as parameterized
             268     1               !    following Lin et al. (JCAM, 1983) & Reisner et al. (1998, QJRMS).
             269     1               !
             270     1                     ABFR=-0.66
             271     1                     BBFR=100.
             272     1                     CBFR=20.*PI*PI*BBFR*RHOL*1.E-21
             273     1               !
             274     1               !--- QAUT0 is the threshold cloud content for autoconversion to rain
             275     1               !      needed for droplets to reach a diameter of 20 microns (following
             276     1               !      Manton and Cotton, 1977; Banta and Hanson, 1987, JCAM).  It is
             277     1               !      **STRONGLY** affected by the assumed droplet number concentrations
             278     1               !     XNCW!  For example, QAUT0=1.2567, 0.8378, or 0.4189 g/m**3 for
             279     1               !     droplet number concentrations of 300, 200, and 100 cm**-3, respectively.
             280     1               !
             281     1               !--- Calculate grid-averaged XNCW based on simple ***ASSUMED*** (user-specified)
             282     1               !    values at DXmax and at DXmin.
             283     1               !
             284     1               !     XNCW_DXmax=50.E6          !--  50 /cm**3 at DXmax=100 km
             285     1               !     XNCW_DXmin=200.E6         !-- 200 /cm**3 at DXmin=5 km
             286     1               !
             287     1               !--- Note that XNCW is right now fixed throughout the domain!!
             288     1               !
             289     1               !     XNCW=XNCW_DXmax+(XNCW_DXmin-XNCW_DXmax)*FXtune
             290     1               !
             291     1               !     QAUT0=PI*RHOL*XNCW*(20.E-6)**3/6.
             292     1                     QAUTx=PI*RHOL*1.0E6*(20.E-6)**3/6.
             293     1               !
             294     1               !--- Based on rain lookup tables for mean diameters from 0.05 to 0.45 mm
             295     1               !    * Four different functional relationships of mean drop diameter as
             296     1               !      a function of rain rate (RR), derived based on simple fits to
             297     1               !      mass-weighted fall speeds of rain as functions of mean diameter
             298     1               !      from the lookup tables.
             299     1               !
             300     1                     RR_DRmin=N0r0*RRATE(MDRmin)     ! RR for mean drop diameter of .05 mm
             301     1                     RR_DR1=N0r0*RRATE(MDR1)         ! RR for mean drop diameter of .10 mm
             302     1                     RR_DR2=N0r0*RRATE(MDR2)         ! RR for mean drop diameter of .20 mm
             303     1                     RR_DR3=N0r0*RRATE(MDR3)         ! RR for mean drop diameter of .32 mm
             304     1                     RR_DRmax=N0r0*RRATE(MDRmax)     ! RR for mean drop diameter of .45 mm
             305     1               !
             306     1                     RQR_DRmin=N0r0*MASSR(MDRmin)    ! Rain content for mean drop diameter of .05 mm
             307     1                     RQR_DR1=N0r0*MASSR(MDR1)        ! Rain content for mean drop diameter of .10 mm
             308     1                     RQR_DR2=N0r0*MASSR(MDR2)        ! Rain content for mean drop diameter of .20 mm
             309     1                     RQR_DR3=N0r0*MASSR(MDR3)        ! Rain content for mean drop diameter of .32 mm
             310     1                     RQR_DRmax=N0r0*MASSR(MDRmax)    ! Rain content for mean drop diameter of .45 mm
             311     1                     C_N0r0=PI*RHOL*N0r0
             312     1                     CN0r0=1.E6/C_N0r0**.25
             313     1                     CN0r_DMRmin=1./(PI*RHOL*DMRmin**4)
             314     1                     CN0r_DMRmax=1./(PI*RHOL*DMRmax**4)
             315     1               !
             316     1                     endif                     !  If (first) then loop ends here
             317                     !
             318                     !     Find out what microphysics time step should be
             319                     !
             320                           mic_step = max(1, int(dtpg/600.0+0.5))
             321                     !     mic_step = max(1, int(dtpg/300.0+0.5))
             322                           dtph     = dtpg / mic_step
             323                           if (mype .eq. 0) print *,' DTPG=',DTPG,' mic_step=',mic_step      &
             324                          &,                ' dtph=',dtph
             325                     !
             326                     !--- Calculates coefficients for growth rates of ice nucleated in water
             327                     !    saturated conditions, scaled by physics time step (lookup table)
             328                     !
             329          i                CALL MY_GROWTH_RATES (DTPH)
             330                     !
             331                     !--- CIACW is used in calculating riming rates
             332                     !      The assumed effective collection efficiency of cloud water rimed onto
             333                     !      ice is =0.5 below:
             334                     !
             335                     !Moor CIACW=DTPH*0.25*PI*0.5*(1.E5)**C1   ! commented on 20050422
             336                     !      ice is =0.1 below:
             337                           CIACW=DTPH*0.25*PI*0.1*(1.E5)**C1
             338                     !     CIACW = 0.0      ! Brad's suggestion 20040614
             339                     !
             340                     !--- CIACR is used in calculating freezing of rain colliding with large ice
             341                     !      The assumed collection efficiency is 1.0
             342                     !
             343                           CIACR=PI*DTPH
             344                     !
             345                     !--- CRACW is used in calculating collection of cloud water by rain (an
             346                     !      assumed collection efficiency of 1.0)
             347                     !
             348                     !Moor CRACW=DTPH*0.25*PI*1.0                 ! commented on 20050422
             349                     !
             350                     !      assumed collection efficiency of 0.1)
             351                           CRACW=DTPH*0.25*PI*0.1
             352                     !     CRACW = 0.0      ! Brad's suggestion 20040614
             353                     !
             354                           ESW0=FPVSL(T0C)           ! Saturation vapor pressure at 0C
             355                           RFmax=1.1**Nrime          ! Maximum rime factor allowed
             356                     !
             357                     !------------------------------------------------------------------------
             358                     !--------------- Constants passed through argument list -----------------
             359                     !------------------------------------------------------------------------
             360                     !
             361                     !--- Important parameters for self collection (autoconversion) of
             362                     !    cloud water to rain.
             363                     !
             364                     !--- CRAUT is proportional to the rate that cloud water is converted by
             365                     !      self collection to rain (autoconversion rate)
             366                     !
             367                           CRAUT=1.-EXP(-1.E-3*DTPH)
             368                     !
             369                     !     IF (MYPE .EQ. 0)
             370                     !    & WRITE(6,"(A, A,F6.2,A, A,F5.4, A,F7.3,A, A,F6.2,A, A,F5.3,A)")
             371                     !    &   'KEY MICROPHYSICAL PARAMETERS FOR '
             372                     !    &  ,'DX=',DX,' KM:'
             373                     !    &  ,'   FXtune=',FXtune
             374                     !    &  ,'   RHgrd=',100.*RHgrd,' %'
             375                     !    &  ,'   NCW=',1.E-6*XNCW,' /cm**3'
             376                     !    &  ,'   QAUT0=',1.E3*QAUT0,' g/kg'
             377                     !
             378                     !--- For calculating snow optical depths by considering bulk density of
             379                     !      snow based on emails from Q. Fu (6/27-28/01), where optical
             380                     !      depth (T) = 1.5*SWP/(Reff*DENS), SWP is snow water path, Reff
             381                     !      is effective radius, and DENS is the bulk density of snow.
             382                     !
             383                     !    SWP (kg/m**2)=(1.E-3 kg/g)*SWPrad, SWPrad in g/m**2 used in radiation
             384                     !    T = 1.5*1.E3*SWPrad/(Reff*DENS)
             385                     !
             386                     !    See derivation for MASSI(INDEXS), note equal to RHO*QSNOW/NSNOW
             387                     !
             388                     !    SDENS=1.5e3/DENS, DENS=MASSI(INDEXS)/[PI*(1.E-6*INDEXS)**3]
             389                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.73, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      MASSI, SDENS
                                   <<< Loop-information  End >>>
             390     1  pp   2v            DO I=MDImin,MDImax
             391     1               !MoorthiSDENS(I)=PI*1.5E-15*FLOAT(I*I*I)/MASSI(I)
             392     1   p   2v              SDENS(I)=PI*1.0E-15*FLOAT(I*I*I)/MASSI(I)
             393     1   p   2v            ENDDO
             394                     !
             395                     !-----------------------------------------------------------------------
             396                     !
             397                           END subroutine gsmconst
             398                     
             399                     !
             400                     !#######################################################################
             401                     !--- Sets up lookup table for calculating initial ice crystal growth ---
             402                     !#######################################################################
             403                     !
             404                           SUBROUTINE MY_GROWTH_RATES (DTPH)
             405                     !
             406                           implicit none
             407                     !
             408                     !--- Below are tabulated values for the predicted mass of ice crystals
             409                     !    after 600 s of growth in water saturated conditions, based on
             410                     !    calculations from Miller and Young (JAS, 1979).  These values are
             411                     !    crudely estimated from tabulated curves at 600 s from Fig. 6.9 of
             412                     !    Young (1993).  Values at temperatures colder than -27C were
             413                     !    assumed to be invariant with temperature.
             414                     !
             415                     !--- Used to normalize Miller & Young (1979) calculations of ice growth
             416                     !    over large time steps using their tabulated values at 600 s.
             417                     !    Assumes 3D growth with time**1.5 following eq. (6.3) in Young (1993).
             418                     !
             419                           real dtph, dt_ice
             420                           REAL MY_600(MY_T1:MY_T2)
             421                     !
             422                           DATA MY_600 /                                                     &
             423                          & 5.5e-8,  1.4E-7,  2.8E-7, 6.E-7,   3.3E-6,                       & !  -1 to  -5 deg C
             424                          & 2.E-6,   9.E-7,   8.8E-7, 8.2E-7,  9.4e-7,                       & !  -6 to -10 deg C
             425                          & 1.2E-6,  1.85E-6, 5.5E-6, 1.5E-5,  1.7E-5,                       & ! -11 to -15 deg C
             426                          & 1.5E-5,  1.E-5,   3.4E-6, 1.85E-6, 1.35E-6,                      & ! -16 to -20 deg C
             427                          & 1.05E-6, 1.E-6,   9.5E-7, 9.0E-7 , 9.5E-7,                       &  ! -21 to -25 deg C
             428                          & 9.5E-7,  9.E-7,   9.E-7,  9.E-7,   9.E-7,                        &  ! -26 to -30 deg C
             429                          & 9.E-7,   9.E-7,   9.E-7,  9.E-7,   9.E-7 /                         ! -31 to -35 deg C
             430                     !
             431                     !-----------------------------------------------------------------------
             432                     !
             433                           DT_ICE=(DTPH/600.)**1.5
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             434         s   fv            MY_GROWTH=DT_ICE*MY_600
             435                     !
             436                     !-----------------------------------------------------------------------
             437                     !
             438                           END subroutine MY_GROWTH_RATES
             439                     !
             440                     !#######################################################################
             441                     !--------------- Creates lookup tables for ice processes ---------------
             442                     !#######################################################################
             443                     !
             444                           subroutine ice_lookup
             445                     !
             446                           implicit none
             447                     !-----------------------------------------------------------------------------------
             448                     !
             449                     !---- Key diameter values in mm
             450                     !
             451                     !-----------------------------------------------------------------------------------
             452                     !
             453                     !---- Key concepts:
             454                     !       - Actual physical diameter of particles (D)
             455                     !       - Ratio of actual particle diameters to mean diameter (x=D/MD)
             456                     !       - Mean diameter of exponentially distributed particles, which is the
             457                     !         same as 1./LAMDA of the distribution (MD)
             458                     !       - All quantitative relationships relating ice particle characteristics as
             459                     !         functions of their diameter (e.g., ventilation coefficients, normalized
             460                     !         accretion rates, ice content, and mass-weighted fall speeds) are a result
             461                     !         of using composite relationships for ice crystals smaller than 1.5 mm
             462                     !         diameter merged with analogous relationships for larger sized aggregates.
             463                     !         Relationships are derived as functions of mean ice particle sizes assuming
             464                     !         exponential size spectra and assuming the properties of ice crystals at
             465                     !         sizes smaller than 1.5 mm and aggregates at larger sizes.
             466                     !
             467                     !-----------------------------------------------------------------------------------
             468                     !
             469                     !---- Actual ice particle diameters for which integrated distributions are derived
             470                     !       - DminI - minimum diameter for integration (.02 mm, 20 microns)
             471                     !       - DmaxI - maximum diameter for integration (2 cm)
             472                     !       - DdelI - interval for integration (1 micron)
             473                     !
             474                           real, parameter :: DminI=.02e-3, DmaxI=20.e-3, DdelI=1.e-6,       &
             475                          &  XImin=1.e6*DminI, XImax=1.e6*DmaxI
             476                           integer, parameter :: IDImin=XImin, IDImax=XImax
             477                     !
             478                     !---- Meaning of the following arrays:
             479                     !        - diam - ice particle diameter (m)
             480                     !        - mass - ice particle mass (kg)
             481                     !        - vel  - ice particle fall speeds (m/s)
             482                     !        - vent1 - 1st term in ice particle ventilation factor
             483                     !        - vent2 - 2nd term in ice particle ventilation factor
             484                     !
             485                           real diam(IDImin:IDImax),mass(IDImin:IDImax),vel(IDImin:IDImax),  &
             486                          & vent1(IDImin:IDImax),vent2(IDImin:IDImax)
             487                     !
             488                     !-----------------------------------------------------------------------------------
             489                     !
             490                     !---- Found from trial & error that the m(D) & V(D) mass & velocity relationships
             491                     !       between the ice crystals and aggregates overlapped & merged near a particle
             492                     !       diameter sizes of 1.5 mm.  Thus, ice crystal relationships are used for
             493                     !       sizes smaller than 1.5 mm and aggregate relationships for larger sizes.
             494                     !
             495                           real, parameter :: d_crystal_max=1.5
             496                     !
             497                     !---- The quantity xmax represents the maximum value of "x" in which the
             498                     !       integrated values are calculated.  For xmax=20., this means that
             499                     !       integrated ventilation, accretion, mass, and precipitation rates are
             500                     !       calculated for ice particle sizes less than 20.*mdiam, the mean particle diameter.
             501                     !
             502                           real, parameter :: xmax=20.
             503                     !
             504                     !-----------------------------------------------------------------------------------
             505                     !
             506                     !---- Meaning of the following arrays:
             507                     !        - mdiam - mean diameter (m)
             508                     !        - VENTI1 - integrated quantity associated w/ ventilation effects
             509                     !                   (capacitance only) for calculating vapor deposition onto ice
             510                     !        - VENTI2 - integrated quantity associated w/ ventilation effects
             511                     !                   (with fall speed) for calculating vapor deposition onto ice
             512                     !        - ACCRI  - integrated quantity associated w/ cloud water collection by ice
             513                     !        - MASSI  - integrated quantity associated w/ ice mass
             514                     !        - VSNOWI - mass-weighted fall speed of snow, used to calculate precip rates
             515                     !
             516                     !--- Mean ice-particle diameters varying from 50 microns to 1000 microns (1 mm),
             517                     !      assuming an exponential size distribution.
             518                     !
             519                           real mdiam
             520                     !
             521                     !-----------------------------------------------------------------------------------
             522                     !------------- Constants & parameters for ventilation factors of ice ---------------
             523                     !-----------------------------------------------------------------------------------
             524                     !
             525                     !---- These parameters are used for calculating the ventilation factors for ice
             526                     !       crystals between 0.2 and 1.5 mm diameter (Hall and Pruppacher, JAS, 1976).
             527                     !       From trial & error calculations, it was determined that the ventilation
             528                     !       factors of smaller ice crystals could be approximated by a simple linear
             529                     !       increase in the ventilation coefficient from 1.0 at 50 microns (.05 mm) to
             530                     !       1.1 at 200 microns (0.2 mm), rather than using the more complex function of
             531                     !       1.0 + .14*(Sc**.33*Re**.5)**2 recommended by Hall & Pruppacher.
             532                     !
             533                           real, parameter :: cvent1i=.86, cvent2i=.28
             534                     !
             535                     !---- These parameters are used for calculating the ventilation factors for larger
             536                     !       aggregates, where D>=1.5 mm (see Rutledge and Hobbs, JAS, 1983;
             537                     !       Thorpe and Mason, 1966).
             538                     !
             539                           real, parameter :: cvent1a=.65, cvent2a=.44
             540                     !
             541                           real m_agg,m_bullet,m_column,m_ice,m_plate
             542                     !
             543                     !---- Various constants
             544                     !
             545                           real, parameter :: c1=2./3., cexp=1./3.
             546                     !
             547                           logical :: iprint
             548                           logical, parameter :: print_diag=.false.
             549                     !
             550                     !-----------------------------------------------------------------------------------
             551                     !- Constants & parameters for calculating the increase in fall speed of rimed ice --
             552                     !-----------------------------------------------------------------------------------
             553                     !
             554                     !---- Constants & arrays for estimating increasing fall speeds of rimed ice.
             555                     !     Based largely on theory and results from Bohm (JAS, 1989, 2419-2427).
             556                     !
             557                     !-------------------- Standard atmosphere conditions at 1000 mb --------------------
             558                     !
             559                           real, parameter :: t_std=288., dens_std=1000.e2/(287.04*288.)
             560                     !
             561                     !---- These "bulk densities" are the actual ice densities in the ice portion of the
             562                     !     lattice.  They are based on text associated w/ (12) on p. 2425 of Bohm (JAS,
             563                     !     1989).  Columns, plates, & bullets are assumed to have an average bulk density
             564                     !     of 850 kg/m**3.  Aggregates were assumed to have a slightly larger bulk density
             565                     !     of 600 kg/m**3 compared with dendrites (i.e., the least dense, most "lacy" &
             566                     !     tenous ice crystal, which was assumed to be ~500 kg/m**3 in Bohm).
             567                     !
             568                           real, parameter :: dens_crystal=850., dens_agg=600.
             569                     !
             570                     !--- A value of Nrime=40 for a logarithmic ratio of 1.1 yields a maximum rime factor
             571                     !      of 1.1**40 = 45.26 that is resolved in these tables.  This allows the largest
             572                     !      ice particles with a mean diameter of MDImax=1000 microns to achieve bulk
             573                     !      densities of 900 kg/m**3 for rimed ice.
             574                     !
             575                     !     integer, parameter :: Nrime=40
             576                           real m_rime,                                                      &
             577                          &     rime_factor(0:Nrime), rime_vel(0:Nrime),                     &
             578                          &     vel_rime(IDImin:IDImax,Nrime), ivel_rime(MDImin:MDImax,Nrime)
             579                     !
             580                           integer i, j, jj, k, icount
             581                           real c2,      cbulk, cbulk_ice, px, dynvis_std, crime1            &
             582                          &,    crime2,  crime3, crime4, crime5, d, c_avg, c_agg             &
             583                          &,    c_bullet, c_column, c_plate, cl_agg, cl_bullet               &
             584                          &,    cl_column, cl_plate, v_agg, v_bullet, v_column               &
             585                          &,    v_plate,   wd,       ecc_column                              &
             586                          &,    cvent1,    cvent2, crime_best, rime_m1, rime_m2              &
             587                          &,    x_rime,    re_rime, smom3, pratei, expf                      &
             588                          &,    bulk_dens, xmass,  xmdiam, ecc_plate, dx
             589                     !
             590                     !-----------------------------------------------------------------------------------
             591                     !----------------------------- BEGIN EXECUTION -------------------------------------
             592                     !-----------------------------------------------------------------------------------
             593                     !
             594                     !
             595                           c2=1./sqrt(3.)
             596                     !     pi=acos(-1.)
             597                           cbulk=6./pi
             598                           cbulk_ice=900.*pi/6.    ! Maximum bulk ice density allowed of 900 kg/m**3
             599                           px=.4**cexp             ! Convert fall speeds from 400 mb (Starr & Cox) to 1000 mb
             600                     !
             601                     !--------------------- Dynamic viscosity (1000 mb, 288 K) --------------------------
             602                     !
             603                           dynvis_std=1.496e-6*t_std**1.5/(t_std+120.)
             604                           crime1=pi/24.
             605                           crime2=8.*9.81*dens_std/(pi*dynvis_std**2)
             606                           crime3=crime1*dens_crystal
             607                           crime4=crime1*dens_agg
             608                           crime5=dynvis_std/dens_std
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    MULTI-OPERATION FUNCTION
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             609     1   s   fv            do i=0,Nrime
             610     1   p   fv              rime_factor(i)=1.1**i
             611     1   p   fv            enddo
             612                     !
             613                     !#######################################################################
             614                     !      Characteristics as functions of actual ice particle diameter
             615                     !#######################################################################
             616                     !
             617                     !----   M(D) & V(D) for 3 categories of ice crystals described by Starr
             618                     !----   & Cox (1985).
             619                     !
             620                     !----   Capacitance & characteristic lengths for Reynolds Number calculations
             621                     !----   are based on Young (1993; p. 144 & p. 150).  c-axis & a-axis
             622                     !----   relationships are from Heymsfield (JAS, 1972; Table 1, p. 1351).
             623                     !
             624                           icount=60
             625                     !
             626                           if (print_diag)                                                   &
             627                          &  write(7,"(2a)") '---- Increase in fall speeds of rimed ice',    &
             628                          &    ' particles as function of ice particle diameter ----'
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mass, vent1, vent2, diam
                                   <<<    PREFETCH(SOFT) : 80
                                   <<<     SEQUENTIAL : 80
                                   <<<      vel_rime: 80
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 13  FILL 28
                                   <<<      SCALABLE  : SPILL 5  FILL 17
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             629     1                     do i=IDImin,IDImax
             630     2                       if (icount.eq.60 .and. print_diag) then
             631     2                         write(6,"(/2a/3a)") 'Particle masses (mg), fall speeds ',     &
             632     2                    &      '(m/s), and ventilation factors',                           &
             633     2                    &      '  D(mm)  CR_mass   Mass_bull   Mass_col  Mass_plat ',      &
             634     2                    &      '  Mass_agg   CR_vel  V_bul CR_col CR_pla Aggreg',          &
             635     2                    &      '    Vent1      Vent2 '
             636     2                         write(7,"(3a)") '        <----------------------------------',&
             637     2                    &      '---------------  Rime Factor  --------------------------', &
             638     2                    &      '--------------------------->'
             639     2                         write(7,"(a,23f5.2)") '  D(mm)',(rime_factor(k), k=1,5),      &
             640     2                    &       (rime_factor(k), k=6,40,2)
             641     2                         icount=0
             642     2                       endif
             643     1                       d=(float(i)+.5)*1.e-3    ! in mm
             644     1                       c_avg=0.
             645     1                       c_agg=0.
             646     1                       c_bullet=0.
             647     1                       c_column=0.
             648     1                       c_plate=0.
             649     1                       cl_agg=0.
             650     1                       cl_bullet=0.
             651     1                       cl_column=0.
             652     1                       cl_plate=0.
             653     1                       m_agg=0.
             654     1                       m_bullet=0.
             655     1                       m_column=0.
             656     1                       m_plate=0.
             657     1                       v_agg=0.
             658     1                       v_bullet=0.
             659     1                       v_column=0.
             660     1                       v_plate=0.
             661     2                       if (d .lt. d_crystal_max) then
             662     2               !
             663     2               !---- This block of code calculates bulk characteristics based on average
             664     2               !     characteristics of bullets, plates, & column ice crystals <1.5 mm size
             665     2               !
             666     2               !---- Mass-diameter relationships from Heymsfield (1972) & used
             667     2               !       in Starr & Cox (1985), units in mg
             668     2               !---- "d" is maximum dimension size of crystal in mm,
             669     2               !
             670     2               ! Mass of pure ice for spherical particles, used as an upper limit for the
             671     2               !   mass of small columns (<~ 80 microns) & plates (<~ 35 microns)
             672     2               !
             673     2                         m_ice=.48*d**3   ! Mass of pure ice for spherical particle
             674     2               !
             675     2                         m_bullet=min(.044*d**3, m_ice)
             676     2                         m_column=min(.017*d**1.7, m_ice)
             677     2                         m_plate=min(.026*d**2.5, m_ice)
             678     2               !
             679     2                         mass(i)=m_bullet+m_column+m_plate
             680     2               !
             681     2               !---- These relationships are from Starr & Cox (1985), applicable at 400 mb
             682     2               !---- "d" is maximum dimension size of crystal in mm, dx in microns
             683     2               !
             684     2                         dx=1000.*d            ! Convert from mm to microns
             685     3                         if (dx .le. 200.) then
             686     3                           v_column=8.114e-5*dx**1.585
             687     3                           v_bullet=5.666e-5*dx**1.663
             688     3                           v_plate=1.e-3*dx
             689     3                         else if (dx .le. 400.) then
             690     3                           v_column=4.995e-3*dx**.807
             691     3                           v_bullet=3.197e-3*dx**.902
             692     3                           v_plate=1.48e-3*dx**.926
             693     3                         else if (dx .le. 600.) then
             694     3                           v_column=2.223e-2*dx**.558
             695     3                           v_bullet=2.977e-2*dx**.529
             696     3                           v_plate=9.5e-4*dx
             697     3                         else if (dx .le. 800.) then
             698     3                           v_column=4.352e-2*dx**.453
             699     3                           v_bullet=2.144e-2*dx**.581
             700     3                           v_plate=3.161e-3*dx**.812
             701     3                         else
             702     3                           v_column=3.833e-2*dx**.472
             703     3                           v_bullet=3.948e-2*dx**.489
             704     3                           v_plate=7.109e-3*dx**.691
             705     3                         endif
             706     2               !
             707     2               !---- Reduce fall speeds from 400 mb to 1000 mb
             708     2               !
             709     2                         v_column=px*v_column
             710     2                         v_bullet=px*v_bullet
             711     2                         v_plate=px*v_plate
             712     2               !
             713     2               !---- DIFFERENT VERSION!  CALCULATES MASS-WEIGHTED CRYSTAL FALL SPEEDS
             714     2               !
             715     2                         vel(i)=(m_bullet*v_bullet+m_column*v_column+m_plate*v_plate)/ &
             716     2                    &           mass(i)
             717     2                         mass(i)=mass(i)/3.
             718     2               !
             719     2               !---- Shape factor and characteristic length of various ice habits,
             720     2               !     capacitance is equal to 4*PI*(Shape factor)
             721     2               !       See Young (1993, pp. 143-152 for guidance)
             722     2               !
             723     2               !---- Bullets:
             724     2               !
             725     2               !---- Shape factor for bullets (Heymsfield, 1975)
             726     2                         c_bullet=.5*d
             727     2               !---- Length-width functions for bullets from Heymsfield (JAS, 1972)
             728     3                         if (d .gt. 0.3) then
             729     3                           wd=.25*d**.7856     ! Width (mm); a-axis
             730     3                         else
             731     3                           wd=.185*d**.552
             732     3                         endif
             733     2               !---- Characteristic length for bullets (see first multiplicative term on right
             734     2               !       side of eq. 7 multiplied by crystal width on p. 821 of Heymsfield, 1975)
             735     2                         cl_bullet=.5*pi*wd*(.25*wd+d)/(d+wd)
             736     2               !
             737     2               !---- Plates:
             738     2               !
             739     2               !---- Length-width function for plates from Heymsfield (JAS, 1972)
             740     2                         wd=.0449*d**.449      ! Width or thickness (mm); c-axis
             741     2               !---- Eccentricity & shape factor for thick plates following Young (1993, p. 144)
             742     2                         ecc_plate=sqrt(1.-wd*wd/(d*d))         ! Eccentricity
             743     2                         c_plate=d*ecc_plate/asin(ecc_plate)    ! Shape factor
             744     2               !---- Characteristic length for plates following Young (1993, p. 150, eq. 6.6)
             745     2                         cl_plate=d+2.*wd      ! Characteristic lengths for plates
             746     2               !
             747     2               !---- Columns:
             748     2               !
             749     2               !---- Length-width function for columns from Heymsfield (JAS, 1972)
             750     3                         if (d .gt. 0.2) then
             751     3                           wd=.1973*d**.414    ! Width (mm); a-axis
             752     3                         else
             753     3                           wd=.5*d             ! Width (mm); a-axis
             754     3                         endif
             755     2               !---- Eccentricity & shape factor for columns following Young (1993, p. 144)
             756     2                         ecc_column=sqrt(1.-wd*wd/(d*d))                     ! Eccentricity
             757     2               !CWB2016  c_column=ecc_column*d/alog((1.+ecc_column)*d/wd)    ! Shape factor
             758     2                         c_column=ecc_column*d/dlog((1.+ecc_column)*d/wd)    ! Shape factor
             759     2               !---- Characteristic length for columns following Young (1993, p. 150, eq. 6.7)
             760     2                         cl_column=(wd+2.*d)/(c1+c2*d/wd)       ! Characteristic lengths for columns
             761     2               !
             762     2               !---- Convert shape factor & characteristic lengths from mm to m for
             763     2               !       ventilation calculations
             764     2               !
             765     2                         c_bullet=.001*c_bullet
             766     2                         c_plate=.001*c_plate
             767     2                         c_column=.001*c_column
             768     2                         cl_bullet=.001*cl_bullet
             769     2                         cl_plate=.001*cl_plate
             770     2                         cl_column=.001*cl_column
             771     2               !
             772     2               !---- Make a smooth transition between a ventilation coefficient of 1.0 at 50 microns
             773     2               !       to 1.1 at 200 microns
             774     2               !
             775     3                         if (d .gt. 0.2) then
             776     3                           cvent1=cvent1i
             777     3                           cvent2=cvent2i/3.
             778     3                         else
             779     3                           cvent1=1.0+.1*max(0., d-.05)/.15
             780     3                           cvent2=0.
             781     3                         endif
             782     2               !
             783     2               !---- Ventilation factors for ice crystals:
             784     2               !
             785     2                         vent1(i)=cvent1*(c_bullet+c_plate+c_column)/3.
             786     2                         vent2(i)=cvent2*(c_bullet*sqrt(v_bullet*cl_bullet)            &
             787     2                    &                    +c_plate*sqrt(v_plate*cl_plate)               &
             788     2                    &                    +c_column*sqrt(v_column*cl_column) )
             789     2                         crime_best=crime3     ! For calculating Best No. of rimed ice crystals
             790     2                       else
             791     2               !
             792     2               !---- This block of code calculates bulk characteristics based on average
             793     2               !     characteristics of unrimed aggregates >= 1.5 mm using Locatelli &
             794     2               !     Hobbs (JGR, 1974, 2185-2197) data.
             795     2               !
             796     2               !----- This category is a composite of aggregates of unrimed radiating
             797     2               !-----   assemblages of dendrites or dendrites; aggregates of unrimed
             798     2               !-----   radiating assemblages of plates, side planes, bullets, & columns;
             799     2               !-----   aggregates of unrimed side planes (mass in mg, velocity in m/s)
             800     2               !
             801     2                         m_agg=(.073*d**1.4+.037*d**1.9+.04*d**1.4)/3.
             802     2                         v_agg=(.8*d**.16+.69*d**.41+.82*d**.12)/3.
             803     2                         mass(i)=m_agg
             804     2                         vel(i)=v_agg
             805     2               !
             806     2               !---- Assume spherical aggregates
             807     2               !
             808     2               !---- Shape factor is the same as for bullets, = D/2
             809     2                         c_agg=.001*.5*d         ! Units of m
             810     2               !---- Characteristic length is surface area divided by perimeter
             811     2               !       (.25*PI*D**2)/(PI*D**2) = D/4
             812     2                         cl_agg=.5*c_agg         ! Units of m
             813     2               !
             814     2               !---- Ventilation factors for aggregates:
             815     2               !
             816     2                         vent1(i)=cvent1a*c_agg
             817     2                         vent2(i)=cvent2a*c_agg*sqrt(v_agg*cl_agg)
             818     2                         crime_best=crime4     ! For calculating Best No. of rimed aggregates
             819     2                       endif
             820     1               !
             821     1               !---- Convert from shape factor to capacitance for ventilation factors
             822     1               !
             823     1                       vent1(i)=4.*pi*vent1(i)
             824     1                       vent2(i)=4.*pi*vent2(i)
             825     1                       diam(i)=1.e-3*d             ! Convert from mm to m
             826     1                       mass(i)=1.e-6*mass(i)       ! Convert from mg to kg
             827     1               !
             828     1               !---- Calculate increase in fall speeds of individual rimed ice particles
             829     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             830     2   s   fv              do k=0,Nrime
             831     2               !---- Mass of rimed ice particle associated with rime_factor(k)
             832     2   p   fv                rime_m1=rime_factor(k)*mass(i)
             833     2   p   fv                rime_m2=cbulk_ice*diam(i)**3
             834     2   p   fv                m_rime=min(rime_m1, rime_m2)
             835     2               !---- Best Number (X) of rimed ice particle combining eqs. (8) & (12) in Bohm
             836     2   p   fv                x_rime=crime2*m_rime*(crime_best/m_rime)**.25
             837     2               !---- Reynolds Number for rimed ice particle using eq. (11) in Bohm
             838     2   p   fv                re_rime=8.5*(sqrt(1.+.1519*sqrt(x_rime))-1.)**2
             839     2   p   fv                rime_vel(k)=crime5*re_rime/diam(i)
             840     2   p   fv              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             841     2   s   fv              do k=1,Nrime
             842     2   p   fv                vel_rime(i,k)=rime_vel(k)/rime_vel(0)
             843     2   p   fv              enddo
             844     2                       if (print_diag) then
             845     2                  !
             846     2                  !---- Determine if statistics should be printed out.
             847     2                  !
             848     2                         iprint=.false.
             849     3                         if (d .le. 1.) then
             850     3                           if (mod(i,10) .eq. 0) iprint=.true.
             851     3                         else
             852     3                           if (mod(i,100) .eq. 0) iprint=.true.
             853     3                         endif
             854     3                         if (iprint) then
             855     3                           write(6,"(f7.4,5e11.4,1x,5f7.4,1x,2e11.4)")                 &
             856     3                    &        d,1.e6*mass(i),m_bullet,m_column,m_plate,m_agg,           &
             857     3                    &        vel(i),v_bullet,v_column,v_plate,v_agg,                   &
             858     3                    &        vent1(i),vent2(i)
             859     3                           write(7,"(f7.4,23f5.2)") d,(vel_rime(i,k), k=1,5),          &
             860     3                    &        (vel_rime(i,k), k=6,40,2)
             861     3                           icount=icount+1
             862     3                         endif
             863     2                       endif
             864     1                     enddo
             865                     !
             866                     !#######################################################################
             867                     !      Characteristics as functions of mean particle diameter
             868                     !#######################################################################
             869                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      VSNOWI, MASSI, ACCRI, VENTI2, VENTI1
                                   <<< Loop-information  End >>>
             870        pp   2v            VENTI1=0.
             871         p   2v            VENTI2=0.
             872         p   2v            ACCRI=0.
             873         p   2v            MASSI=0.
             874         p   2v            VSNOWI=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      VEL_RF
                                   <<< Loop-information  End >>>
             875         s   4v            VEL_RF=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ivel_rime
                                   <<< Loop-information  End >>>
             876        pp   4v            ivel_rime=0.
             877                           icount=0
             878     1                     if (print_diag) then
             879     1                       icount=60
             880     1                       write(6,"(/2a)") '------------- Statistics as functions of ',   &
             881     1                    &    'mean particle diameter -------------'
             882     1                       write(7,"(/2a)") '------ Increase in fall speeds of rimed ice', &
             883     1                    &    ' particles as functions of mean particle diameter -----'
             884     1                     endif
             885     1                     do j=MDImin,MDImax
             886     2                       if (icount.eq.60 .AND. print_diag) then
             887     2                         write(6,"(/2a)") 'D(mm)    Vent1      Vent2    ',             &
             888     2                    &       'Accrete       Mass     Vel  Dens  '
             889     2                         write(7,"(3a)") '      <----------------------------------',  &
             890     2                    &      '---------------  Rime Factor  --------------------------', &
             891     2                    &      '--------------------------->'
             892     2                         write(7,"(a,23f5.2)") 'D(mm)',(rime_factor(k), k=1,5),        &
             893     2                    &       (rime_factor(k), k=6,40,2)
             894     2                         icount=0
             895     2                       endif
             896     1                       mdiam=DelDMI*float(j)       ! in m
             897     1                       smom3=0.
             898     1                       pratei=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             899     1   s   fv              rime_vel=0.                 ! Note that this array is being reused!
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      diam
                                   <<< Loop-information  End >>>
             900     2                       do i=IDImin,IDImax
             901     2                         dx=diam(i)/mdiam
             902     3                         if (dx .le. xmax) then    ! To prevent arithmetic underflows
             903     3                           expf=exp(-dx)*DdelI
             904     3                           VENTI1(J)=VENTI1(J)+vent1(i)*expf
             905     3                           VENTI2(J)=VENTI2(J)+vent2(i)*expf
             906     3                           ACCRI(J)=ACCRI(J)+diam(i)*diam(i)*vel(i)*expf
             907     3                           xmass=mass(i)*expf
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             908     4   s   fv                  do k=1,Nrime
             909     4   p   fv                    rime_vel(k)=rime_vel(k)+xmass*vel_rime(i,k)
             910     4   p   fv                  enddo
             911     3                           MASSI(J)=MASSI(J)+xmass
             912     3                           pratei=pratei+xmass*vel(i)
             913     3                           smom3=smom3+diam(i)**3*expf
             914     3                         else
             915     3                           exit
             916     3                         endif
             917     2                       enddo
             918     1                  !
             919     1                  !--- Increased fall velocities functions of mean diameter (j),
             920     1                  !      normalized by ice content, and rime factor (k)
             921     1                  !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             922     2   s   fv              do k=1,Nrime
             923     2   p   fv                ivel_rime(j,k)=rime_vel(k)/MASSI(J)
             924     2   p   fv              enddo
             925     1                  !
             926     1                  !--- Increased fall velocities functions of ice content at 0.1 mm
             927     1                  !      intervals (j_100) and rime factor (k); accumulations here
             928     1                  !
             929     1                       jj=j/100
             930     2                       if (jj.ge.2 .AND. jj.le.9) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             931     3   s   fv                do k=1,Nrime
             932     3   p   fv                  VEL_RF(jj,k)=VEL_RF(jj,k)+ivel_rime(j,k)
             933     3   p   fv                enddo
             934     2                       endif
             935     1                       bulk_dens=cbulk*MASSI(J)/smom3
             936     1                       VENTI1(J)=VENTI1(J)/mdiam
             937     1                       VENTI2(J)=VENTI2(J)/mdiam
             938     1                       ACCRI(J)=ACCRI(J)/mdiam
             939     1                       VSNOWI(J)=pratei/MASSI(J)
             940     1                       MASSI(J)=MASSI(J)/mdiam
             941     2                       if (mod(j,10).eq.0 .AND. print_diag) then
             942     2                         xmdiam=1.e3*mdiam
             943     2                         write(6,"(f5.3,4e11.4,f6.3,f8.3)") xmdiam,VENTI1(j),VENTI2(j),&
             944     2                    &      ACCRI(j),MASSI(j),VSNOWI(j),bulk_dens
             945     2                         write(7,"(f5.3,23f5.2)") xmdiam,(ivel_rime(j,k), k=1,5),      &
             946     2                    &       (ivel_rime(j,k), k=6,40,2)
             947     2                         icount=icount+1
             948     2                       endif
             949     1                     enddo
             950                     !
             951                     !--- Average increase in fall velocities rimed ice as functions of mean
             952                     !      particle diameter (j, only need 0.1 mm intervals) and rime factor (k)
             953                     !
             954     1                     if (print_diag) then
             955     1                       write(7,"(/2a)") ' ------- Increase in fall speeds of rimed ',  &
             956     1                    &    'ice particles at reduced, 0.1-mm intervals  --------'
             957     1                       write(7,"(3a)") '        <----------------------------------',  &
             958     1                    &    '---------------  Rime Factor  --------------------------',   &
             959     1                    &    '--------------------------->'
             960     1                       write(7,"(a,23f5.2)") 'D(mm)',(rime_factor(k), k=1,5),          &
             961     1                    &    (rime_factor(k), k=6,40,2)
             962     1                     endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 28
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             963     1   s   f             do j=2,9
             964     1   p   f               VEL_RF(j,0)=1.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             965     2   s   fv              do k=1,Nrime
             966     2   p   fv                VEL_RF(j,k)=.01*VEL_RF(j,k)
             967     2   p   fv              enddo
             968     1       f               if (print_diag) write(7,"(f3.1,2x,23f5.2)") 0.1*j,              &
             969     1                    &    (VEL_RF(j,k), k=1,5),(VEL_RF(j,k), k=6,40,2)
             970     1   p   f             enddo
             971                     !
             972                     !-----------------------------------------------------------------------------------
             973                     !
             974                           end subroutine ice_lookup
             975                     !
             976                     !#######################################################################
             977                     !-------------- Creates lookup tables for rain processes ---------------
             978                     !#######################################################################
             979                     !
             980                           subroutine rain_lookup
             981                           implicit none
             982                     !
             983                     !--- Parameters & arrays for fall speeds of rain as a function of rain drop
             984                     !      diameter.  These quantities are integrated over exponential size
             985                     !      distributions of rain drops at 1 micron intervals (DdelR) from minimum
             986                     !      drop sizes of .05 mm (50 microns, DminR) to maximum drop sizes of 10 mm
             987                     !      (DmaxR).
             988                     !
             989                           real, parameter :: DminR=.05e-3, DmaxR=10.e-3, DdelR=1.e-6,       &
             990                          & XRmin=1.e6*DminR, XRmax=1.e6*DmaxR
             991                           integer, parameter :: IDRmin=XRmin, IDRmax=XRmax
             992                           real diam(IDRmin:IDRmax), vel(IDRmin:IDRmax)
             993                     !
             994                     !--- Parameters rain lookup tables, which establish the range of mean drop
             995                     !      diameters; from a minimum mean diameter of 0.05 mm (DMRmin) to a
             996                     !      maximum mean diameter of 0.45 mm (DMRmax).  The tables store solutions
             997                     !      at 1 micron intervals (DelDMR) of mean drop diameter.
             998                     !
             999                           real mdiam, mass
            1000                     !
            1001                           logical, parameter :: print_diag=.false.
            1002                     !
            1003                           real d, cmass, pi2, expf
            1004                           integer i, j, i1, i2
            1005                     !
            1006                     !-----------------------------------------------------------------------
            1007                     !------- Fall speeds of rain as function of rain drop diameter ---------
            1008                     !-----------------------------------------------------------------------
            1009                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 308
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.03, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vel, diam
                                   <<< Loop-information  End >>>
            1010     1  pp    v            do i=IDRmin,IDRmax
            1011     1   p    v              diam(i)=float(i)*DdelR
            1012     1   p    v              d=100.*diam(i)         ! Diameter in cm
            1013     2   p    v              if (d .le. .42) then
            1014     2                  !
            1015     2                  !--- Rutledge & Hobbs (1983); vel (m/s), d (cm)
            1016     2                  !
            1017     2   p    v                vel(i)=max(0., -.267+51.5*d-102.25*d*d+75.7*d**3)
            1018     2   p    v              else if (d.gt.0.42 .and. d.le..58) then
            1019     2                  !
            1020     2                  !--- Linear interpolation of Gunn & Kinzer (1949) data
            1021     2                  !
            1022     2   p    v                vel(i)=8.92+.25/(.58-.42)*(d-.42)
            1023     2   p    v              else
            1024     2   p    v                vel(i)=9.17
            1025     2   p    v              endif
            1026     1   p    v            enddo
            1027     1                     do i=1,100
            1028     1                       i1=(i-1)*100+IDRmin
            1029     1                       i2=i1+90
            1030     1                  !
            1031     1                  !--- Print out rain fall speeds only for D<=5.8 mm (.58 cm)
            1032     1                  !
            1033     1                       if (diam(i1) .gt. .58e-2) exit
            1034     2                       if (print_diag) then
            1035     2                         write(6,"(1x)")
            1036     2                         write(6,"('D(mm)->  ',10f7.3)") (1000.*diam(j), j=i1,i2,10)
            1037     2                         write(6,"('V(m/s)-> ',10f7.3)") (vel(j), j=i1,i2,10)
            1038     2                       endif
            1039     1                     enddo
            1040                     !
            1041                     !-----------------------------------------------------------------------
            1042                     !------------------- Lookup tables for rain processes ------------------
            1043                     !-----------------------------------------------------------------------
            1044                     !
            1045                     !     pi=acos(-1.)
            1046                           pi2=2.*pi
            1047                           cmass=1000.*pi/6.
            1048     1                     if (print_diag) then
            1049     1                       write(6,"(/'Diam - Mean diameter (mm)'                          &
            1050     1                    &          /'VENTR1 - 1st ventilation coefficient (m**2)'          &
            1051     1                    &          /'VENTR2 - 2nd ventilation coefficient (m**3/s**.5)'    &
            1052     1                    &          /'ACCRR - accretion moment (m**4/s)'                    &
            1053     1                    &          /'RHO*QR - mass content (kg/m**3) for N0r=8e6'          &
            1054     1                    &          /'RRATE - rain rate moment (m**5/s)'                    &
            1055     1                    &          /'VR - mass-weighted rain fall speed (m/s)'             &
            1056     1                    &    /' Diam      VENTR1      VENTR2       ACCRR      ',           &
            1057     1                    &    'RHO*QR       RRATE    VR')")
            1058     1                     endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      diam, vel
                                   <<< Loop-information  End >>>
            1059     1  pp                 do j=MDRmin,MDRmax
            1060     1   p                   mdiam=float(j)*DelDMR
            1061     1   p                   VENTR2(J)=0.
            1062     1   p                   ACCRR(J)=0.
            1063     1   p                   MASSR(J)=0.
            1064     1   p                   RRATE(J)=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.86, ITR: 48, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vel, diam
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 24
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1065     2   p    v              do i=IDRmin,IDRmax
            1066     2   p    v                expf=exp(-diam(i)/mdiam)*DdelR
            1067     2   p    v                VENTR2(J)=VENTR2(J)+diam(i)**1.5*vel(i)**.5*expf
            1068     2   p    v                ACCRR(J)=ACCRR(J)+diam(i)*diam(i)*vel(i)*expf
            1069     2   p    v                MASSR(J)=MASSR(J)+diam(i)**3*expf
            1070     2   p    v                RRATE(J)=RRATE(J)+diam(i)**3*vel(i)*expf
            1071     2   p    v              enddo
            1072     1                  !
            1073     1                  !--- Derived based on ventilation, F(D)=0.78+.31*Schmidt**(1/3)*Reynold**.5,
            1074     1                  !      where Reynold=(V*D*rho/dyn_vis), V is velocity, D is particle diameter,
            1075     1                  !      rho is air density, & dyn_vis is dynamic viscosity.  Only terms
            1076     1                  !      containing velocity & diameter are retained in these tables.
            1077     1                  !
            1078     1   p                   VENTR1(J)=.78*pi2*mdiam**2
            1079     1   p                   VENTR2(J)=.31*pi2*VENTR2(J)
            1080     1                  !
            1081     1   p                   MASSR(J)=cmass*MASSR(J)
            1082     1   p                   RRATE(J)=cmass*RRATE(J)
            1083     1   p                   VRAIN(J)=RRATE(J)/MASSR(J)
            1084     1   p                   if (print_diag) write(6,"(f5.3,5g12.5,f6.3)") 1000.*mdiam,     &
            1085     1                    &    ventr1(j),ventr2(j),accrr(j),8.e6*massr(j),rrate(j),vrain(j)
            1086     1   p                 enddo
            1087                     !
            1088                     !-----------------------------------------------------------------------
            1089                     !
            1090                           end subroutine rain_lookup
            1091                     !
            1092                     !###############################################################################
            1093                     ! ***** VERSION OF MICROPHYSICS DESIGNED FOR HIGHER RESOLUTION MESO ETA MODEL
            1094                     !       (1) Represents sedimentation by preserving a portion of the precipitation
            1095                     !           through top-down integration from cloud-top.  Modified procedure to
            1096                     !           Zhao and Carr (1997).
            1097                     !       (2) Microphysical equations are modified to be less sensitive to time
            1098                     !           steps by use of Clausius-Clapeyron equation to account for changes in
            1099                     !           saturation mixing ratios in response to latent heating/cooling.
            1100                     !       (3) Prevent spurious temperature oscillations across 0C due to
            1101                     !           microphysics.
            1102                     !       (4) Uses lookup tables for: calculating two different ventilation
            1103                     !           coefficients in condensation and deposition processes; accretion of
            1104                     !           cloud water by precipitation; precipitation mass; precipitation rate
            1105                     !           (and mass-weighted precipitation fall speeds).
            1106                     !       (5) Assumes temperature-dependent variation in mean diameter of large ice
            1107                     !           (Houze et al., 1979; Ryan et al., 1996).
            1108                     !        -> 8/22/01: This relationship has been extended to colder temperatures
            1109                     !           to parameterize smaller large-ice particles down to mean sizes of MDImin,
            1110                     !           which is 50 microns reached at -55.9C.
            1111                     !       (6) Attempts to differentiate growth of large and small ice, mainly for
            1112                     !           improved transition from thin cirrus to thick, precipitating ice
            1113                     !           anvils.
            1114                     !        -> 8/22/01: This feature has been diminished by effectively adjusting to
            1115                     !           ice saturation during depositional growth at temperatures colder than
            1116                     !           -10C.  Ice sublimation is calculated more explicitly.  The logic is
            1117                     !           that sources of are either poorly understood (e.g., nucleation for NWP)
            1118                     !           or are not represented in the Eta model (e.g., detrainment of ice from
            1119                     !           convection).  Otherwise the model is too wet compared to the radiosonde
            1120                     !           observations based on 1 Feb - 18 March 2001 retrospective runs.
            1121                     !       (7) Top-down integration also attempts to treat mixed-phase processes,
            1122                     !           allowing a mixture of ice and water.  Based on numerous observational
            1123                     !           studies, ice growth is based on nucleation at cloud top &
            1124                     !           subsequent growth by vapor deposition and riming as the ice particles
            1125                     !           fall through the cloud.  Effective nucleation rates are a function
            1126                     !           of ice supersaturation following Meyers et al. (JAM, 1992).
            1127                     !        -> 8/22/01: The simulated relative humidities were far too moist compared
            1128                     !           to the rawinsonde observations.  This feature has been substantially
            1129                     !           diminished, limited to a much narrower temperature range of 0 to -10C.
            1130                     !       (8) Depositional growth of newly nucleated ice is calculated for large time
            1131                     !           steps using Fig. 8 of Miller and Young (JAS, 1979), at 1 deg intervals
            1132                     !           using their ice crystal masses calculated after 600 s of growth in water
            1133                     !           saturated conditions.  The growth rates are normalized by time step
            1134                     !           assuming 3D growth with time**1.5 following eq. (6.3) in Young (1993).
            1135                     !        -> 8/22/01: This feature has been effectively limited to 0 to -10C.
            1136                     !       (9) Ice precipitation rates can increase due to increase in response to
            1137                     !           cloud water riming due to (a) increased density & mass of the rimed
            1138                     !           ice, and (b) increased fall speeds of rimed ice.
            1139                     !        -> 8/22/01: This feature has been effectively limited to 0 to -10C.
            1140                     !###############################################################################
            1141                     !###############################################################################
            1142                     !
            1143                           SUBROUTINE GSMCOLUMN ( ARAING, ASNOWG, DTPG, I_index, J_index,    &
            1144                          & LSFC, P_col, QI_col, QR_col, QV_col, QW_col, RimeF_col, T_col,   &
            1145                          & THICK_col, WC_col, LM, RHC_col, XNCW, FLGmin, PRINT_diag, psfc)
            1146                     !
            1147                           implicit none
            1148                     !
            1149                     !###############################################################################
            1150                     !###############################################################################
            1151                     !
            1152                     !-------------------------------------------------------------------------------
            1153                     !----- NOTE:  Code is currently set up w/o threading!
            1154                     !-------------------------------------------------------------------------------
            1155                     !$$$  SUBPROGRAM DOCUMENTATION BLOCK
            1156                     !                .      .    .
            1157                     ! SUBPROGRAM:  Grid-scale microphysical processes - condensation & precipitation
            1158                     !   PRGRMMR: Ferrier         ORG: W/NP22     DATE: 08-2001
            1159                     !-------------------------------------------------------------------------------
            1160                     ! ABSTRACT:
            1161                     !   * Merges original GSCOND & PRECPD subroutines.
            1162                     !   * Code has been substantially streamlined and restructured.
            1163                     !   * Exchange between water vapor & small cloud condensate is calculated using
            1164                     !     the original Asai (1965, J. Japan) algorithm.  See also references to
            1165                     !     Yau and Austin (1979, JAS), Rutledge and Hobbs (1983, JAS), and Tao et al.
            1166                     !     (1989, MWR).  This algorithm replaces the Sundqvist et al. (1989, MWR)
            1167                     !     parameterization.
            1168                     !-------------------------------------------------------------------------------
            1169                     !
            1170                     ! USAGE:
            1171                     !   * CALL GSMCOLUMN FROM SUBROUTINE GSMDRIVE
            1172                     !   * SUBROUTINE GSMDRIVE CALLED FROM MAIN PROGRAM EBU
            1173                     !
            1174                     ! INPUT ARGUMENT LIST:
            1175                     !   DTPH       - physics time step (s)
            1176                     !   I_index    - I index
            1177                     !   J_index    - J index
            1178                     !   LSFC       - Eta level of level above surface, ground
            1179                     !   P_col      - vertical column of model pressure (Pa)
            1180                     !   QI_col     - vertical column of model ice mixing ratio (kg/kg)
            1181                     !   QR_col     - vertical column of model rain ratio (kg/kg)
            1182                     !   QV_col     - vertical column of model water vapor specific humidity (kg/kg)
            1183                     !   QW_col     - vertical column of model cloud water mixing ratio (kg/kg)
            1184                     !   RimeF_col  - vertical column of rime factor for ice in model (ratio, defined below)
            1185                     !   T_col      - vertical column of model temperature (deg K)
            1186                     !   THICK_col  - vertical column of model mass thickness (density*height increment)
            1187                     !   WC_col     - vertical column of model mixing ratio of total condensate (kg/kg)
            1188                     !
            1189                     !
            1190                     ! OUTPUT ARGUMENT LIST:
            1191                     !   ARAIN      - accumulated rainfall at the surface (kg)
            1192                     !   ASNOW      - accumulated snowfall at the surface (kg)
            1193                     !   QV_col     - vertical column of model water vapor specific humidity (kg/kg)
            1194                     !   WC_col     - vertical column of model mixing ratio of total condensate (kg/kg)
            1195                     !   QW_col     - vertical column of model cloud water mixing ratio (kg/kg)
            1196                     !   QI_col     - vertical column of model ice mixing ratio (kg/kg)
            1197                     !   QR_col     - vertical column of model rain ratio (kg/kg)
            1198                     !   RimeF_col  - vertical column of rime factor for ice in model (ratio, defined below)
            1199                     !   T_col      - vertical column of model temperature (deg K)
            1200                     !
            1201                     ! OUTPUT FILES:
            1202                     !     NONE
            1203                     !
            1204                     ! Subprograms & Functions called:
            1205                     !   * Real Function CONDENSE  - cloud water condensation
            1206                     !   * Real Function DEPOSIT   - ice deposition (not sublimation)
            1207                     !
            1208                     ! UNIQUE: NONE
            1209                     !
            1210                     ! LIBRARY: NONE
            1211                     !
            1212                     ! ATTRIBUTES:
            1213                     !   LANGUAGE: FORTRAN 90
            1214                     !   MACHINE : IBM SP
            1215                     !
            1216                     !-------------------------------------------------------------------------
            1217                     !--------------- Arrays & constants in argument list ---------------------
            1218                     !-------------------------------------------------------------------------
            1219                     !
            1220                     !     INCLUDE "parmeta"
            1221                     !     INCLUDE "mpp.h"
            1222                           integer lm
            1223                           REAL ARAING, ASNOWG, P_col(LM), QI_col(LM), QR_col(LM), QV_col(LM)&
            1224                          &, QW_col(LM), RimeF_col(LM), T_col(LM), THICK_col(LM),            &
            1225                          &  WC_col(LM), RHC_col(LM), XNCW(LM), ARAIN, ASNOW, dtpg, psfc
            1226                           real flgmin
            1227                     !
            1228                           INTEGER I_index, J_index, LSFC
            1229                     !
            1230                     !
            1231                     !-------------------------------------------------------------------------
            1232                     !
            1233                     !--- Mean ice-particle diameters varying from 50 microns to 1000 microns
            1234                     !      (1 mm), assuming an exponential size distribution.
            1235                     !
            1236                     !---- Meaning of the following arrays:
            1237                     !        - mdiam - mean diameter (m)
            1238                     !        - VENTI1 - integrated quantity associated w/ ventilation effects
            1239                     !                   (capacitance only) for calculating vapor deposition onto ice
            1240                     !        - VENTI2 - integrated quantity associated w/ ventilation effects
            1241                     !                   (with fall speed) for calculating vapor deposition onto ice
            1242                     !        - ACCRI  - integrated quantity associated w/ cloud water collection by ice
            1243                     !        - MASSI  - integrated quantity associated w/ ice mass
            1244                     !        - VSNOWI - mass-weighted fall speed of snow (large ice), used to calculate
            1245                     !                   precipitation rates
            1246                     !
            1247                           REAL, PARAMETER :: DMImin=.05e-3, DMImax=1.e-3, DelDMI=1.e-6,     &
            1248                          &  XMImin=1.e6*DMImin, XMImax=1.e6*DMImax
            1249                           INTEGER, PARAMETER :: MDImin=XMImin, MDImax=XMImax
            1250                     !
            1251                     !-------------------------------------------------------------------------
            1252                     !------- Key parameters, local variables, & important comments ---------
            1253                     !-----------------------------------------------------------------------
            1254                     !
            1255                     !--- KEY Parameters:
            1256                     !
            1257                     !---- Comments on 14 March 2002
            1258                     !    * Set EPSQ to the universal value of 1.e-12 throughout the code
            1259                     !      condensate.  The value of EPSQ will need to be changed in the other
            1260                     !      subroutines in order to make it consistent throughout the Eta code.
            1261                     !    * Set CLIMIT=10.*EPSQ as the lower limit for the total mass of
            1262                     !      condensate in the current layer and the input flux of condensate
            1263                     !      from above (TOT_ICE, TOT_ICEnew, TOT_RAIN, and TOT_RAINnew).
            1264                     !
            1265                     !-- NLImax - maximum number concentration of large ice crystals (20,000 /m**3, 20 per liter)
            1266                     !-- NLImin - minimum number concentration of large ice crystals (100 /m**3, 0.1 per liter)
            1267                     !
            1268                           REAL, PARAMETER ::   RHOL=1000.,  XLS=HVAP+HFUS                   &
            1269                     !    &, T_ICE=-10.          !- Ver1
            1270                     !    &, T_ICE_init=-5.      !- Ver1
            1271                     !!!  &, T_ICE=-20.          !- Ver2
            1272                     !    &, T_ICE=-40.          !- Ver2
            1273                     !    &, T_ICE_init=-15.,    !- Ver2
            1274                     !
            1275                     !    & CLIMIT=10.*EPSQ, EPS1=RV/RD-1., RCP=1./CP,
            1276                          &,CLIMIT=10.*EPSQ, RCP=1./CP,                                      &
            1277                          & RCPRV=RCP/RV, RRHOL=1./RHOL, XLS1=XLS*RCP, XLS2=XLS*XLS*RCPRV,   &
            1278                          & XLS3=XLS*XLS/RV,                                                 &
            1279                          & C1=1./3., C2=1./6., C3=3.31/6.,                                  &
            1280                          & DMR1=.1E-3, DMR2=.2E-3, DMR3=.32E-3, N0r0=8.E6, N0rmin=1.e4,     &
            1281                          & N0s0=4.E6, RHO0=1.194, XMR1=1.e6*DMR1, XMR2=1.e6*DMR2,           &
            1282                          & XMR3=1.e6*DMR3, Xratio=.025
            1283                           INTEGER, PARAMETER :: MDR1=XMR1, MDR2=XMR2, MDR3=XMR3
            1284                     !
            1285                     !--- If BLEND=1:
            1286                     !      precipitation (large) ice amounts are estimated at each level as a
            1287                     !      blend of ice falling from the grid point above and the precip ice
            1288                     !      present at the start of the time step (see TOT_ICE below).
            1289                     !--- If BLEND=0:
            1290                     !      precipitation (large) ice amounts are estimated to be the precip
            1291                     !      ice present at the start of the time step.
            1292                     !
            1293                     !--- Extended to include sedimentation of rain on 2/5/01
            1294                     !
            1295                           REAL, PARAMETER :: BLEND=1.
            1296                     !
            1297                     !--- This variable is for debugging purposes (if .true.)
            1298                     !
            1299                     !     LOGICAL, PARAMETER :: PRINT_diag=.TRUE.
            1300                           LOGICAL  PRINT_diag
            1301                     !
            1302                     !--- Local variables
            1303                     !
            1304                           REAL EMAIRI, N0r, NLICE, NSmICE, NLImax, pfac
            1305                           LOGICAL CLEAR, ICE_logical, DBG_logical, RAIN_logical
            1306                     
            1307                           integer lbef, ipass, ixrf, ixs, itdx, idr                         &
            1308                          &,       index_my, indexr, indexr1, indexs                         &
            1309                          &,       i, j, k, l, ntimes
            1310                     !    &,       i, j, k, my_600, i1, i2, l, ntimes
            1311                           real flimass,  xlimass, vsnow,   qi_min, dum,    piloss           &
            1312                          &,    tot_ice,  xsimass, vel_inc, vrimef, rimef1, dum1             &
            1313                          &,    dum2,     fws,     denomi,  dwv                              &
            1314                          &,    xrf,      qw0,     dli,     xli,    fsmall                   &
            1315                          &,    prevp,    tk2,     dtph                                      &
            1316                          &,    pievp,    picnd,   piacr,   pracw                            &
            1317                          &,    praut,    pimlt,   qtice,   qlice                            &
            1318                          &,    gammar,   flarge,  wvqw,    dynvis                           &
            1319                          &,    tfactor,  denom,   gammas,  diffus, therm_cond               &
            1320                          &,    wvnew,    delv,    tnew,    tot_icenew, rimef                &
            1321                          &,    deli,     fwr,     crevp,   ventr,      delt                 &
            1322                          &,    delw,     fir,     delr,    qsinew,     qswnew               &
            1323                          &,    budget,   wsnew,   vrain2,  tot_rainnew                      &
            1324                          &,    qtnew,    qt,      wcnew,   abw                              &
            1325                          &,    aievp,    tcc,     denomf,  abi                              &
            1326                          &,    sfactor,  pidep_max,        didep,      ventis, ventil       &
            1327                          &,    dievp,    rqr,     rfactor, dwvr,       rr,     tot_rain     &
            1328                          &,    dwv0,     qsw0,    prloss,  qtrain,     vrain1               &
            1329                          &,    qsw,      ws,      esi,     esw, wv, wc, rhgrd, rho          &
            1330                          &,    rrho,     dtrho,   wsgrd,   qsi, qswgrd, qsigrd              &
            1331                          &,    tk,       tc,      pp,      bldtrh                           &
            1332                          &,    xlv,      xlv1,    xlf,     xlf1,  xlv2, denomw, denomwi     &
            1333                          &,    qwnew,    pcond,   pidep,   qrnew, qi,   qr,     qw          &
            1334                          &,    piacw,    piacwi,  piacwr,  qv,    dwvi                      &
            1335                          &,    arainnew, thick,   asnownew                                  &
            1336                          &,    qinew,    qi_min_0c, QSW_l, QSI_l, QSW0_l
            1337                     
            1338                     !
            1339                     !
            1340                     !#######################################################################
            1341                     !########################## Begin Execution ############################
            1342                     !#######################################################################
            1343                     !
            1344                           DTPH = DTPG / mic_step
            1345                           ARAING=0.           ! Total Accumulated rainfall into grid box from above (kg/m**2)
            1346                           ASNOWG=0.           ! Total Accumulated snowfall into grid box from above (kg/m**2)
            1347                     !
            1348     1                     do ntimes =1,mic_step
            1349     1               !
            1350     1                       QI_min_0C=10.E3*MASSI(MDImin)   !- Ver5
            1351     1                     ARAIN=0.                ! Accumulated rainfall into grid box from above (kg/m**2)
            1352     1                     ASNOW=0.                ! Accumulated snowfall into grid box from above (kg/m**2)
            1353     1               !
            1354     1               !-----------------------------------------------------------------------
            1355     1               !------------ Loop from top (L=1) to surface (L=LSFC) ------------------
            1356     1               !-----------------------------------------------------------------------
            1357     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      QV_col
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 13  FILL 41
                                   <<<      SIMD&FP   : SPILL 208  FILL 457
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1358     2                     DO 10 L=1,LSFC
            1359     2               
            1360     2               !--- Skip this level and go to the next lower level if no condensate
            1361     2               !      and very low specific humidities
            1362     2               !
            1363     2                       IF (QV_col(L).LE.EPSQ .AND. WC_col(L).LE.EPSQ) GO TO 10
            1364     2               !
            1365     2               !-----------------------------------------------------------------------
            1366     2               !------------ Proceed with cloud microphysics calculations -------------
            1367     2               !-----------------------------------------------------------------------
            1368     2               !
            1369     2                         TK=T_col(L)         ! Temperature (deg K)
            1370     2                         TC=TK-T0C           ! Temperature (deg C)
            1371     2                         PP=P_col(L)         ! Pressure (Pa)
            1372     2                         QV=QV_col(L)        ! Specific humidity of water vapor (kg/kg)
            1373     2               !         WV=QV/(1.-QV)       ! Water vapor mixing ratio (kg/kg)
            1374     2                         WV=QV               ! Water vapor mixing ratio (kg/kg)
            1375     2                         WC=WC_col(L)        ! Grid-scale mixing ratio of total condensate (water or ice; kg/kg)
            1376     2               !         WC=WC/(1.-WC)
            1377     2                         RHgrd = RHC_col(L)
            1378     2               !go       pfac = max(0.5, (sqrt(min(1.0, pp*0.00004))))
            1379     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.00004))))
            1380     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.000025))))
            1381     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.000033))))
            1382     2               !         pfac = max(0.25, sqrt(sqrt(min(1.0, pp*0.00002))))
            1383     2               !         pfac = max(0.25, sqrt(sqrt(min(1.0, pp*0.00001))))
            1384     2               !         pfac = max(0.25, sqrt(sqrt(min(1.0, pp/psfc))))
            1385     2               !         pfac = max(0.1, sqrt(min(1.0, pp*0.00001)))
            1386     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.00002))))
            1387     2               !!        pfac = max(0.25, sqrt(sqrt(min(1.0, pp*0.000025))))
            1388     2                         pfac = 1.0
            1389     2               !
            1390     2               !-----------------------------------------------------------------------
            1391     2               !--- Moisture variables below are mixing ratios & not specifc humidities
            1392     2               !-----------------------------------------------------------------------
            1393     2               !
            1394     2                         CLEAR=.TRUE.
            1395     2               !
            1396     2               !--- This check is to determine grid-scale saturation when no condensate is present
            1397     2               !
            1398     2                         ESW=min(PP, FPVSL(TK))           ! Saturation vapor pressure w/r/t water
            1399     2               !         QSW=EPS*ESW/(PP-ESW)             ! Saturation mixing ratio w/r/t water
            1400     2                         QSW=EPS*ESW/(PP+epsm1*ESW)       ! Saturation specific humidity  w/r/t water
            1401     2                         WS=QSW                           ! General saturation mixing ratio (water/ice)
            1402     3                         IF (TC .LT. 0.) THEN
            1403     3                           ESI=min(PP,FPVSI(TK))          ! Saturation vapor pressure w/r/t ice
            1404     3               !           QSI=EPS*ESI/(PP-ESI)           ! Saturation mixing ratio w/r/t water
            1405     3                           QSI=EPS*ESI/(PP+epsm1*ESI)     ! Saturation specific humidity w/r/t water
            1406     3                           WS=QSI                         ! General saturation mixing ratio (water/ice)
            1407     3                           if (pp .le. esi) ws = wv /rhgrd
            1408     3                         ENDIF
            1409     2               !
            1410     2                         dum = min(PP, ESW0)
            1411     2                         QSW0=EPS*dum/(PP+epsm1*dum)
            1412     2               !
            1413     2               !--- Effective grid-scale Saturation mixing ratios
            1414     2               !
            1415     2                         QSWgrd=RHgrd*QSW
            1416     2                         QSIgrd=RHgrd*QSI
            1417     2                         WSgrd=RHgrd*WS
            1418     2                         QSW_l  = QSWgrd
            1419     2                         QSI_l  = QSIgrd
            1420     2                         QSW0_l = QSW0*RHgrd
            1421     2               !
            1422     2               !--- Check if air is subsaturated and w/o condensate
            1423     2               !
            1424     2                         IF (WV.GT.WSgrd .OR. WC.GT.EPSQ) CLEAR=.FALSE.
            1425     2               !
            1426     2               !--- Check if any rain is falling into layer from above
            1427     2               !
            1428     3                         IF (ARAIN .GT. CLIMIT) THEN
            1429     3                           CLEAR=.FALSE.
            1430     3                         ELSE
            1431     3                           ARAIN=0.
            1432     3                         ENDIF
            1433     2               !
            1434     2               !--- Check if any ice is falling into layer from above
            1435     2               !
            1436     2               !--- NOTE that "SNOW" in variable names is synonomous with
            1437     2               !    large, precipitation ice particles
            1438     2               !
            1439     3                         IF (ASNOW .GT. CLIMIT) THEN
            1440     3                           CLEAR=.FALSE.
            1441     3                         ELSE
            1442     3                           ASNOW=0.
            1443     3                         ENDIF
            1444     2               !
            1445     2               !-----------------------------------------------------------------------
            1446     2               !-- Loop to the end if in clear, subsaturated air free of condensate ---
            1447     2               !-----------------------------------------------------------------------
            1448     2               !
            1449     2                         IF (CLEAR) GO TO 10
            1450     2               !
            1451     2               !-----------------------------------------------------------------------
            1452     2               !--------- Initialize RHO, THICK & microphysical processes -------------
            1453     2               !-----------------------------------------------------------------------
            1454     2               !
            1455     2               !
            1456     2               !--- Virtual temperature, TV=T*(1./EPS-1)*Q, Q is specific humidity;
            1457     2               !    (see pp. 63-65 in Fleagle & Businger, 1963)
            1458     2               !
            1459     2                         RHO=PP/(RD*TK*(1.+EPS1*QV))   ! Air density (kg/m**3)
            1460     2                         RRHO=1./RHO                ! Reciprocal of air density
            1461     2                         DTRHO=DTPH*RHO             ! Time step * air density
            1462     2                         BLDTRH=BLEND*DTRHO         ! Blend parameter * time step * air density
            1463     2                         THICK=THICK_col(L)         ! Layer thickness = RHO*DZ = -DP/G = (Psfc-Ptop)*D_ETA/(G*ETA_sfc)
            1464     2               !
            1465     2                         ARAINnew=0.                ! Updated accumulated rainfall
            1466     2                         ASNOWnew=0.                ! Updated accumulated snowfall
            1467     2                         QI=QI_col(L)               ! Ice mixing ratio
            1468     2                         QInew=0.                   ! Updated ice mixing ratio
            1469     2                         QR=QR_col(L)               ! Rain mixing ratio
            1470     2                         QRnew=0.                   ! Updated rain ratio
            1471     2                         QW=QW_col(L)               ! Cloud water mixing ratio
            1472     2                         QWnew=0.                   ! Updated cloud water ratio
            1473     2               !
            1474     2                         PCOND=0.                   ! Condensation (>0) or evaporation (<0) of cloud water (kg/kg)
            1475     2                         PIDEP=0.                   ! Deposition (>0) or sublimation (<0) of ice crystals (kg/kg)
            1476     2                         PIACW=0.                   ! Cloud water collection (riming) by precipitation ice (kg/kg; >0)
            1477     2                         PIACWI=0.                  ! Growth of precip ice by riming (kg/kg; >0)
            1478     2                         PIACWR=0.                  ! Shedding of accreted cloud water to form rain (kg/kg; >0)
            1479     2                         PIACR=0.                   ! Freezing of rain onto large ice at supercooled temps (kg/kg; >0)
            1480     2                         PICND=0.                   ! Condensation (>0) onto wet, melting ice (kg/kg)
            1481     2                         PIEVP=0.                   ! Evaporation (<0) from wet, melting ice (kg/kg)
            1482     2                         PIMLT=0.                   ! Melting ice (kg/kg; >0)
            1483     2                         PRAUT=0.                   ! Cloud water autoconversion to rain (kg/kg; >0)
            1484     2                         PRACW=0.                   ! Cloud water collection (accretion) by rain (kg/kg; >0)
            1485     2                         PREVP=0.                   ! Rain evaporation (kg/kg; <0)
            1486     2               !
            1487     2               !--- Double check input hydrometeor mixing ratios
            1488     2               !
            1489     2               !          DUM=WC-(QI+QW+QR)
            1490     2               !          DUM1=ABS(DUM)
            1491     2               !          DUM2=TOLER*MIN(WC, QI+QW+QR)
            1492     2               !          IF (DUM1 .GT. DUM2) THEN
            1493     2               !            WRITE(6,"(/2(a,i4),a,i2)") '{@ i=',I_index,' j=',J_index,
            1494     2               !     &                                 ' L=',L
            1495     2               !            WRITE(6,"(4(a12,g11.4,1x))")
            1496     2               !     & '{@ TCold=',TC,'P=',.01*PP,'DIFF=',DUM,'WCold=',WC,
            1497     2               !     & '{@ QIold=',QI,'QWold=',QW,'QRold=',QR
            1498     2               !          ENDIF
            1499     2               !
            1500     2               !***********************************************************************
            1501     2               !*********** MAIN MICROPHYSICS CALCULATIONS NOW FOLLOW! ****************
            1502     2               !***********************************************************************
            1503     2               !
            1504     2               !--- Calculate a few variables, which are used more than once below
            1505     2               !
            1506     2               !--- Latent heat of vaporization as a function of temperature from
            1507     2               !      Bolton (1980, JAS)
            1508     2               !
            1509     2                         XLV=3.148E6-2370*TK        ! Latent heat of vaporization (Lv)
            1510     2                         XLF=XLS-XLV                ! Latent heat of fusion (Lf)
            1511     2                         XLV1=XLV*RCP               ! Lv/Cp
            1512     2                         XLF1=XLF*RCP               ! Lf/Cp
            1513     2                         TK2=1./(TK*TK)             ! 1./TK**2
            1514     2                         XLV2=XLV*XLV*QSW_l*TK2/RV  ! Lv**2*Qsw_l/(Rv*TK**2)
            1515     2                         DENOMW=1.+XLV2*RCP         ! Denominator term, Clausius-Clapeyron correction
            1516     2               !
            1517     2               !--- Basic thermodynamic quantities
            1518     2               !      * DYNVIS - dynamic viscosity  [ kg/(m*s) ]
            1519     2               !      * THERM_COND - thermal conductivity  [ J/(m*s*K) ]
            1520     2               !      * DIFFUS - diffusivity of water vapor  [ m**2/s ]
            1521     2               !
            1522     2                         TFACTOR=TK**1.5/(TK+120.)
            1523     2                         DYNVIS=1.496E-6*TFACTOR
            1524     2                         THERM_COND=2.116E-3*TFACTOR
            1525     2                         DIFFUS=8.794E-5*TK**1.81/PP
            1526     2               !
            1527     2               !--- Air resistance term for the fall speed of ice following the
            1528     2               !      basic research by Heymsfield, Kajikawa, others
            1529     2               !
            1530     2                         GAMMAS=(1.E5/PP)**C1
            1531     2               !
            1532     2               !--- Air resistance for rain fall speed (Beard, 1985, JAOT, p.470)
            1533     2               !
            1534     2               !Moorthi  GAMMAR=(RHO0/RHO)**.4
            1535     2                         GAMMAR=(RHO0/RHO)**0.4
            1536     2               !         GAMMAR=sqrt(RHO0/RHO)
            1537     2               !
            1538     2               !----------------------------------------------------------------------
            1539     2               !-------------  IMPORTANT MICROPHYSICS DECISION TREE  -----------------
            1540     2               !----------------------------------------------------------------------
            1541     2               !
            1542     2               !--- Determine if conditions supporting ice are present
            1543     2               !
            1544     3                         IF (TC.LT.0. .OR. QI.GT.EPSQ .OR. ASNOW.GT.CLIMIT) THEN
            1545     3                           ICE_logical=.TRUE.
            1546     3                         ELSE
            1547     3                           ICE_logical=.FALSE.
            1548     3                           QLICE=0.
            1549     3                           QTICE=0.
            1550     3                         ENDIF
            1551     2               !
            1552     2               !--- Determine if rain is present
            1553     2               !
            1554     2                         RAIN_logical=.FALSE.
            1555     2                         IF (ARAIN.GT.CLIMIT .OR. QR.GT.EPSQ) RAIN_logical=.TRUE.
            1556     2               !
            1557     3                         IF (ICE_logical) THEN
            1558     3               !
            1559     3               !--- IMPORTANT:  Estimate time-averaged properties.
            1560     3               !
            1561     3               !---
            1562     3               !  * FLARGE  - ratio of number of large ice to total (large & small) ice
            1563     3               !  * FSMALL  - ratio of number of small ice crystals to large ice particles
            1564     3               !  ->  Small ice particles are assumed to have a mean diameter of 50 microns.
            1565     3               !  * XSIMASS - used for calculating small ice mixing ratio
            1566     3               !---
            1567     3               !  * TOT_ICE - total mass (small & large) ice before microphysics,
            1568     3               !              which is the sum of the total mass of large ice in the
            1569     3               !              current layer and the input flux of ice from above
            1570     3               !  * PILOSS  - greatest loss (<0) of total (small & large) ice by
            1571     3               !              sublimation, removing all of the ice falling from above
            1572     3               !              and the ice within the layer
            1573     3               !  * RimeF1  - Rime Factor, which is the mass ratio of total (unrimed & rimed)
            1574     3               !              ice mass to the unrimed ice mass (>=1)
            1575     3               !  * VrimeF  - the velocity increase due to rime factor or melting (ratio, >=1)
            1576     3               !  * VSNOW   - Fall speed of rimed snow w/ air resistance correction
            1577     3               !  * EMAIRI  - equivalent mass of air associated layer and with fall of snow into layer
            1578     3               !  * XLIMASS - used for calculating large ice mixing ratio
            1579     3               !  * FLIMASS - mass fraction of large ice
            1580     3               !  * QTICE   - time-averaged mixing ratio of total ice
            1581     3               !  * QLICE   - time-averaged mixing ratio of large ice
            1582     3               !  * NLICE   - time-averaged number concentration of large ice
            1583     3               !  * NSmICE  - number concentration of small ice crystals at current level
            1584     3               !---
            1585     3               !--- Assumed number fraction of large ice particles to total (large & small)
            1586     3               !    ice particles, which is based on a general impression of the literature.
            1587     3               !
            1588     3                           WVQW=WV+QW                ! Water vapor & cloud water
            1589     3               !
            1590     3               !--- 6/19/03 - Deleted some code here ....
            1591     3               !
            1592     3               !  *********************************************************
            1593     3               
            1594     3               !           IF (TC.GE.0. .OR. WVQW.LT.QSIgrd) THEN
            1595     3               !  !
            1596     3               !  !--- Eliminate small ice particle contributions for melting & sublimation
            1597     3               !  !
            1598     3               !             FLARGE=FLARGE1
            1599     3               !           ELSE
            1600     3               !  !
            1601     3               !  !--- Enhanced number of small ice particles during depositional growth
            1602     3               !  !    (effective only when 0C > T >= T_ice [-10C] )
            1603     3               !  !
            1604     3               !             FLARGE=FLARGE2
            1605     3               !  !
            1606     3               !  !--- Larger number of small ice particles due to rime splintering
            1607     3               !  !
            1608     3               !             IF (TC.GE.-8. .AND. TC.LE.-3.) FLARGE=.5*FLARGE
            1609     3               !
            1610     3               !           ENDIF            ! End IF (TC.GE.0. .OR. WVQW.LT.QSIgrd)
            1611     3               !           FSMALL=(1.-FLARGE)/FLARGE
            1612     3               !           XSIMASS=RRHO*MASSI(MDImin)*FSMALL
            1613     3               !  *********************************************************
            1614     3               !
            1615     4                           IF (QI.LE.EPSQ .AND. ASNOW.LE.CLIMIT) THEN
            1616     4                             INDEXS=MDImin
            1617     4                             FLARGE=0.                    !--- Begin 6/19/03 changes
            1618     4                             FSMALL=1.
            1619     4                             XSIMASS=RRHO*MASSI(MDImin)   !--- End 6/19/03 changes
            1620     4                             TOT_ICE=0.
            1621     4                             PILOSS=0.
            1622     4                             RimeF1=1.
            1623     4                             VrimeF=1.
            1624     4                             VEL_INC=GAMMAS
            1625     4                             VSNOW=0.
            1626     4                             EMAIRI=THICK
            1627     4                             XLIMASS=RRHO*RimeF1*MASSI(INDEXS)
            1628     4                             FLIMASS=XLIMASS/(XLIMASS+XSIMASS)
            1629     4                             QLICE=0.
            1630     4                             QTICE=0.
            1631     4                             NLICE=0.
            1632     4                             NSmICE=0.
            1633     4                           ELSE
            1634     4                  !
            1635     4                  !--- For T<0C mean particle size follows Houze et al. (JAS, 1979, p. 160),
            1636     4                  !    converted from Fig. 5 plot of LAMDAs.  Similar set of relationships
            1637     4                  !    also shown in Fig. 8 of Ryan (BAMS, 1996, p. 66).
            1638     4                  !
            1639     4                  !--- Begin 6/19/03 changes => allow NLImax to increase & FLARGE to
            1640     4                  !    decrease at COLDER temperatures; set FLARGE to zero (i.e., only small
            1641     4                  !    ice) if the ice mixing ratio is below QI_min
            1642     4               !             DUM=MAX(0.05, MIN(1., EXP(.0536*TC)) )
            1643     4                             DUM=MAX(0.05, MIN(1., EXP(.0564*TC)) )
            1644     4                             INDEXS=MIN(MDImax, MAX(MDImin, INT(XMImax*DUM) ) )
            1645     4               !             NLImax=5.E3/sqrt(DUM)        !- Ver3
            1646     4               !
            1647     4                             DUM=MAX(FLGmin*pfac, DUM)
            1648     4               !             DUM=MAX(FLGmin, DUM)
            1649     4                             QI_min=QI_min_0C * dum  !- Ver5
            1650     4               !!            QI_min=QI_min_0C        !- Ver5
            1651     4               !!!           QI_min=QI_min_0C/DUM    !- Ver5
            1652     4               !             NLImax=20.E3            !- Ver3 => comment this line out
            1653     4               !             NLImax=50.E3            !- Ver3 => comment this line out
            1654     4                             NLImax=10.E3/sqrt(DUM)        !- Ver3
            1655     4               !             NLImax=5.E3/sqrt(DUM)        !- Ver3
            1656     4               !             NLImax=6.E3/sqrt(DUM)        !- Ver3
            1657     4               !             NLImax=7.5E3/sqrt(DUM)       !- Ver3
            1658     4               !             NLImax=20.E3/max(0.2,DUM)        !- Ver3
            1659     4               !             NLImax=2.0E3/max(0.1,DUM)        !- Ver3
            1660     4               !             NLImax=2.5E3/max(0.1,DUM)        !- Ver3
            1661     4               !             NLImax=10.E3/max(0.2,DUM)        !- Ver3
            1662     4               !             NLImax=4.E3/max(0.2,DUM)        !- Ver3
            1663     5                             IF (TC .LT. 0.) THEN
            1664     5               !               FLARGE=0.2       !- Ver4 => comment this line out
            1665     5                               FLARGE=DUM       !- Ver4
            1666     5                             ELSE
            1667     5                               FLARGE=1.
            1668     5                             ENDIF
            1669     4                             FSMALL=(1.-FLARGE)/FLARGE
            1670     4                             XSIMASS=RRHO*MASSI(MDImin)*FSMALL
            1671     4                             TOT_ICE=THICK*QI+BLEND*ASNOW
            1672     4                             PILOSS=-TOT_ICE/THICK
            1673     4                             LBEF=MAX(1,L-1)
            1674     4                             RimeF1=(RimeF_col(L)*THICK*QI                             &
            1675     4                    &                +RimeF_col(LBEF)*BLEND*ASNOW)/TOT_ICE
            1676     4                             RimeF1=MIN(RimeF1, RFmax)
            1677     4                             VSNOW=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1678     5       f                     DO IPASS=0,1
            1679     6       f                       IF (RimeF1 .LE. 1.) THEN
            1680     6       f                         RimeF1=1.
            1681     6       f                         VrimeF=1.
            1682     6       f                       ELSE
            1683     6       f                         IXS=MAX(2, MIN(INDEXS/100, 9))
            1684     6               !CWB2016          XRF=10.492*ALOG(RimeF1)
            1685     6       f                         XRF=10.492*DLOG(RimeF1)
            1686     6       f                         IXRF=MAX(0, MIN(INT(XRF), Nrime))
            1687     7       f                         IF (IXRF .GE. Nrime) THEN
            1688     7       f                           VrimeF=VEL_RF(IXS,Nrime)
            1689     7       f                         ELSE
            1690     7       f                           VrimeF=VEL_RF(IXS,IXRF)+(XRF-FLOAT(IXRF))*          &
            1691     7                    &                    (VEL_RF(IXS,IXRF+1)-VEL_RF(IXS,IXRF))
            1692     7       f                         ENDIF
            1693     6       f                       ENDIF            ! End IF (RimeF1 .LE. 1.)
            1694     5       f                       VEL_INC=GAMMAS*VrimeF
            1695     5       f                       VSNOW=VEL_INC*VSNOWI(INDEXS)
            1696     5               !               IF (QI.LT.QI_min .AND. TC.LE.T_ICE_init) then     !- Ver5
            1697     5               !                 dum = qi / max(qi_min, epsq)
            1698     5               !                 vsnow = vsnow * dum
            1699     5               !               endif
            1700     5               !!              IF (QI.LT.QI_min .AND. TC.LE.T_ICE_init)     !- Ver5
            1701     5               !!   &          VSNOW=VSNOW * 0.1
            1702     5               !!!  &          VSNOW=VEL_INC*VSNOWI(INDEXS)                 !- Ver5
            1703     5       f                       EMAIRI=THICK+BLDTRH*VSNOW
            1704     5       f                       XLIMASS=RRHO*RimeF1*MASSI(INDEXS)
            1705     5       f                       FLIMASS=XLIMASS/(XLIMASS+XSIMASS)
            1706     5       f                       QTICE=TOT_ICE/EMAIRI
            1707     5       f                       QLICE=FLIMASS*QTICE
            1708     5       f                       NLICE=QLICE/XLIMASS
            1709     5       f                       NSmICE=Fsmall*NLICE
            1710     5                  !
            1711     6       f                       IF ( (NLICE.GE.NLImin .AND. NLICE.LE.NLImax)            &
            1712     6                    &                .OR. IPASS.EQ.1) THEN
            1713     6       f                         EXIT
            1714     6       f                       ELSE
            1715     7       f                         IF(TC < 0) THEN
            1716     7       f                           XLI=RHO*(QTICE/DUM-XSIMASS)/RimeF1
            1717     8       f                           IF (XLI .LE. MASSI(MDImin) ) THEN
            1718     8       f                             INDEXS=MDImin
            1719     8       f                           ELSE IF (XLI .LE. MASSI(450) ) THEN
            1720     8       f                             DLI=9.5885E5*XLI**.42066         ! DLI in microns
            1721     8       f                             INDEXS=MIN(MDImax, MAX(MDImin, INT(DLI) ) )
            1722     8       f                           ELSE IF (XLI .LE. MASSI(MDImax) ) THEN
            1723     8       f                             DLI=3.9751E6*XLI**.49870         ! DLI in microns
            1724     8       f                             INDEXS=MIN(MDImax, MAX(MDImin, INT(DLI) ) )
            1725     8       f                           ELSE
            1726     8       f                             INDEXS=MDImax
            1727     8       f                           ENDIF             ! End IF (XLI .LE. MASSI(MDImin) )
            1728     7       f                         ENDIF               ! End IF (TC < 0)
            1729     6                          !
            1730     6                          !--- Reduce excessive accumulation of ice at upper levels
            1731     6                          !    associated with strong grid-resolved ascent
            1732     6                          !
            1733     6                          !--- Force NLICE to be between NLImin and NLImax
            1734     6                          !
            1735     6                          !--- 8/22/01: Increase density of large ice if maximum limits
            1736     6                          !    are reached for number concentration (NLImax) and mean size
            1737     6                          !    (MDImax).  Done to increase fall out of ice.
            1738     6                          !
            1739     6                          !
            1740     6               
            1741     6       f                         DUM=MAX(NLImin, MIN(NLImax, NLICE) )
            1742     6       f                           IF (DUM .GE. NLImax .AND. INDEXS .GE. MDImax)       &
            1743     6                    &                RimeF1=RHO*(QTICE/NLImax-XSIMASS)/MASSI(INDEXS)
            1744     6               !
            1745     6               !            WRITE(6,"(4(a12,g11.4,1x))")
            1746     6               !     & '{$ TC=',TC,'P=',.01*PP,'NLICE=',NLICE,'DUM=',DUM,
            1747     6               !     & '{$ XLI=',XLI,'INDEXS=',FLOAT(INDEXS),'RHO=',RHO,'QTICE=',QTICE,
            1748     6               !     & '{$ XSIMASS=',XSIMASS,'RimeF1=',RimeF1
            1749     6       f                       ENDIF                  ! End IF ( (NLICE.GE.NLImin .AND. NLICE.LE.NLImax) ...
            1750     5       f                     ENDDO                    ! End DO IPASS=0,1
            1751     4                           ENDIF                      ! End IF (QI.LE.EPSQ .AND. ASNOW.LE.CLIMIT)
            1752     3                         ENDIF                        ! End IF (ICE_logical)
            1753     2               !
            1754     2               !----------------------------------------------------------------------
            1755     2               !--------------- Calculate individual processes -----------------------
            1756     2               !----------------------------------------------------------------------
            1757     2               !
            1758     2               !--- Cloud water autoconversion to rain and collection by rain
            1759     2               !
            1760     3                         IF (QW.GT.EPSQ .AND. TC.GE.T_ICE) THEN
            1761     3                  !
            1762     3                  !--- QW0 could be modified based on land/sea properties,
            1763     3                  !      presence of convection, etc.  This is why QAUT0 and CRAUT
            1764     3                  !      are passed into the subroutine as externally determined
            1765     3                  !      parameters.  Can be changed in the future if desired.
            1766     3                  !
            1767     3               !           QW0=QAUT0*RRHO
            1768     3                           QW0=QAUTx*RRHO*XNCW(L)
            1769     3                           PRAUT=MAX(0., QW-QW0)*CRAUT
            1770     4                           IF (QLICE .GT. EPSQ) THEN
            1771     4                     !
            1772     4                     !--- Collection of cloud water by large ice particles ("snow")
            1773     4                     !    PIACWI=PIACW for riming, PIACWI=0 for shedding
            1774     4                     !
            1775     4               !Moor         FWS=MIN(1., CIACW*VEL_INC*NLICE*ACCRI(INDEXS)/PP**C1) ! 20050422
            1776     4                             FWS=MIN(0.1, CIACW*VEL_INC*NLICE*ACCRI(INDEXS)/PP**C1)
            1777     4                             PIACW=FWS*QW
            1778     4                             IF (TC .LT. 0.) PIACWI=PIACW    ! Large ice riming
            1779     4                           ENDIF           ! End IF (QLICE .GT. EPSQ)
            1780     3                         ENDIF             ! End IF (QW.GT.EPSQ .AND. TC.GE.T_ICE)
            1781     2               !
            1782     2               !----------------------------------------------------------------------
            1783     2               !--- Loop around some of the ice-phase processes if no ice should be present
            1784     2               !----------------------------------------------------------------------
            1785     2               !
            1786     2                         IF (ICE_logical .EQV. .FALSE.) GO TO 20
            1787     2               !
            1788     2               !--- Now the pretzel logic of calculating ice deposition
            1789     2               !
            1790     3                         IF (TC.LT.T_ICE .AND. (WV.GT.QSIgrd .OR. QW.GT.EPSQ)) THEN
            1791     3                  !
            1792     3                  !--- Adjust to ice saturation at T<T_ICE (-10C) if supersaturated.
            1793     3                  !    Sources of ice due to nucleation and convective detrainment are
            1794     3                  !    either poorly understood, poorly resolved at typical NWP
            1795     3                  !    resolutions, or are not represented (e.g., no detrained
            1796     3                  !    condensate in BMJ Cu scheme).
            1797     3                  !
            1798     3                           PCOND=-QW
            1799     3                           DUM1=TK+XLV1*PCOND                 ! Updated (dummy) temperature (deg K)
            1800     3                           DUM2=WV+QW                         ! Updated (dummy) water vapor mixing ratio
            1801     3                           DUM=min(pp,FPVSI(DUM1))            ! Updated (dummy) saturation vapor pressure w/r/t ice
            1802     3                           DUM=RHgrd*EPS*DUM/(pp+epsm1*dum)   ! Updated (dummy) saturation specific humidity w/r/t ice
            1803     3               !           DUM=RHgrd*EPS*DUM/(PP-DUM)         ! Updated (dummy) saturation mixing ratio w/r/t ice
            1804     3                           IF (DUM2 .GT. DUM) PIDEP=DEPOSIT (PP, RHgrd, DUM1, DUM2)
            1805     3                           DWVi=0.    ! Used only for debugging
            1806     3                  !
            1807     3                         ELSE IF (TC .LT. 0.) THEN
            1808     3                  !
            1809     3                  !--- These quantities are handy for ice deposition/sublimation
            1810     3                  !    PIDEP_max - max deposition or minimum sublimation to ice saturation
            1811     3                  !
            1812     3                           DENOMI=1.+XLS2*QSI_l*TK2
            1813     3                           DWVi=MIN(WVQW,QSW_l)-QSI_l
            1814     3                           PIDEP_max=MAX(PILOSS, DWVi/DENOMI)
            1815     4                           IF (QTICE .GT. 0.) THEN
            1816     4                     !
            1817     4                     !--- Calculate ice deposition/sublimation
            1818     4                     !      * SFACTOR - [VEL_INC**.5]*[Schmidt**(1./3.)]*[(RHO/DYNVIS)**.5],
            1819     4                     !        where Schmidt (Schmidt Number) =DYNVIS/(RHO*DIFFUS)
            1820     4                     !      * Units: SFACTOR - s**.5/m ;  ABI - m**2/s ;  NLICE - m**-3 ;
            1821     4                     !               VENTIL, VENTIS - m**-2 ;  VENTI1 - m ;
            1822     4                     !               VENTI2 - m**2/s**.5 ; DIDEP - unitless
            1823     4                     !
            1824     4                             SFACTOR=VEL_INC**.5*(RHO/(DIFFUS*DIFFUS*DYNVIS))**C2
            1825     4                             ABI=1./(RHO*XLS3*QSI*TK2/THERM_COND+1./DIFFUS)
            1826     4                     !
            1827     4                     !--- VENTIL - Number concentration * ventilation factors for large ice
            1828     4                     !--- VENTIS - Number concentration * ventilation factors for small ice
            1829     4                     !
            1830     4                     !--- Variation in the number concentration of ice with time is not
            1831     4                     !      accounted for in these calculations (could be in the future).
            1832     4                     !
            1833     4                             VENTIL=(VENTI1(INDEXS)+SFACTOR*VENTI2(INDEXS))*NLICE
            1834     4                             VENTIS=(VENTI1(MDImin)+SFACTOR*VENTI2(MDImin))*NSmICE
            1835     4                             DIDEP=ABI*(VENTIL+VENTIS)*DTPH
            1836     4                     !
            1837     4                     !--- Account for change in water vapor supply w/ time
            1838     4                     !
            1839     4                             IF (DIDEP .GE. Xratio)                                    &
            1840     4                    &          DIDEP=(1.-EXP(-DIDEP*DENOMI))/DENOMI
            1841     5                             IF (DWVi .GT. 0.) THEN
            1842     5                               PIDEP=MIN(DWVi*DIDEP, PIDEP_max)
            1843     5                             ELSE IF (DWVi .LT. 0.) THEN
            1844     5                               PIDEP=MAX(DWVi*DIDEP, PIDEP_max)
            1845     5                             ENDIF
            1846     4                     !
            1847     4                           ELSE IF (WVQW.GT.QSI_l .AND. TC.LE.T_ICE_init) THEN
            1848     4                     !
            1849     4                     !--- Ice nucleation in near water-saturated conditions.  Ice crystal
            1850     4                     !    growth during time step calculated using Miller & Young (1979, JAS).
            1851     4                     !--- These deposition rates could drive conditions below water saturation,
            1852     4                     !    which is the basis of these calculations.  Intended to approximate
            1853     4                     !    more complex & computationally intensive calculations.
            1854     4                     !
            1855     4                             INDEX_MY=MAX(MY_T1, MIN( INT(.5-TC), MY_T2 ) )
            1856     4                     !
            1857     4                     !--- DUM1 is the supersaturation w/r/t ice at water-saturated conditions
            1858     4                     !
            1859     4                     !--- DUM2 is the number of ice crystals nucleated at water-saturated
            1860     4                     !    conditions based on Meyers et al. (JAM, 1992).
            1861     4                     !
            1862     4                     !--- Prevent unrealistically large ice initiation (limited by PIDEP_max)
            1863     4                     !      if DUM2 values are increased in future experiments
            1864     4                     !
            1865     4                             DUM1=QSW/QSI-1.
            1866     4                             DUM2=1.E3*EXP(12.96*DUM1-0.639)
            1867     4                             PIDEP=MIN(PIDEP_max, DUM2*MY_GROWTH(INDEX_MY)*RRHO)
            1868     4                     !
            1869     4                           ENDIF       ! End IF (QTICE .GT. 0.)
            1870     3                  !
            1871     3                         ENDIF         ! End IF (TC.LT.T_ICE .AND. (WV.GT.QSIgrd .OR. QW.GT.EPSQ))
            1872     2               !
            1873     2               !------------------------------------------------------------------------
            1874     2               !
            1875     2               20      CONTINUE     ! Jump here if conditions for ice are not present
            1876     2               !
            1877     2               !------------------------------------------------------------------------
            1878     2               !
            1879     2               !--- Cloud water condensation
            1880     2               !
            1881     3                         IF (TC.GE.T_ICE .AND. (QW.GT.EPSQ .OR. WV.GT.QSWgrd)) THEN
            1882     4                           IF (PIACWI.EQ.0. .AND. PIDEP.EQ.0.) THEN
            1883     4                             PCOND=CONDENSE (PP, QW, RHgrd, TK, WV)
            1884     4                           ELSE
            1885     4                  !
            1886     4                  !--- Modify cloud condensation in response to ice processes
            1887     4                  !
            1888     4                             DUM=XLV*QSWgrd*RCPRV*TK2
            1889     4                             DENOMWI=1.+XLS*DUM
            1890     4                             DENOMF=XLF*DUM
            1891     4                             DUM=MAX(0., PIDEP)
            1892     4                             PCOND=(WV-QSWgrd-DENOMWI*DUM-DENOMF*PIACWI)/DENOMW
            1893     4                             DUM1=-QW
            1894     4                             DUM2=PCOND-PIACW
            1895     5                             IF (DUM2 .LT. DUM1) THEN
            1896     5                     !
            1897     5                     !--- Limit cloud water sinks
            1898     5                     !
            1899     5                               DUM=DUM1/DUM2
            1900     5                               PCOND=DUM*PCOND
            1901     5                               PIACW=DUM*PIACW
            1902     5                               PIACWI=DUM*PIACWI
            1903     5                             ENDIF        ! End IF (DUM2 .LT. DUM1)
            1904     4                           ENDIF          ! End IF (PIACWI.EQ.0. .AND. PIDEP.EQ.0.)
            1905     3                         ENDIF            ! End IF (TC.GE.T_ICE .AND. (QW.GT.EPSQ .OR. WV.GT.QSWgrd))
            1906     2               !
            1907     2               !--- Limit freezing of accreted rime to prevent temperature oscillations,
            1908     2               !    a crude Schumann-Ludlam limit (p. 209 of Young, 1993).
            1909     2               !
            1910     2                         TCC=TC+XLV1*PCOND+XLS1*PIDEP+XLF1*PIACWI
            1911     3                         IF (TCC .GT. 0.) THEN
            1912     3                           PIACWI=0.
            1913     3                           TCC=TC+XLV1*PCOND+XLS1*PIDEP
            1914     3                         ENDIF
            1915     2               !
            1916     3                         IF (TC.GT.0. .AND. TCC.GT.0. .AND. ICE_logical) THEN
            1917     3                  !
            1918     3                  !--- Calculate melting and evaporation/condensation
            1919     3                  !      * Units: SFACTOR - s**.5/m ;  ABI - m**2/s ;  NLICE - m**-3 ;
            1920     3                  !               VENTIL - m**-2 ;  VENTI1 - m ;
            1921     3                  !               VENTI2 - m**2/s**.5 ; CIEVP - /s
            1922     3                  !
            1923     3                           SFACTOR=VEL_INC**.5*(RHO/(DIFFUS*DIFFUS*DYNVIS))**C2
            1924     3                           VENTIL=NLICE*(VENTI1(INDEXS)+SFACTOR*VENTI2(INDEXS))
            1925     3                           AIEVP=VENTIL*DIFFUS*DTPH
            1926     4                           IF (AIEVP .LT. Xratio) THEN
            1927     4                             DIEVP=AIEVP
            1928     4                           ELSE
            1929     4                             DIEVP=1.-EXP(-AIEVP)
            1930     4                           ENDIF
            1931     3               !           QSW0=EPS*ESW0/(PP-ESW0)
            1932     3               !           QSW0=EPS*ESW0/(PP+epsm1*ESW0)
            1933     3               !!          dum = min(PP, ESW0)
            1934     3               !!          QSW0=EPS*dum/(PP+epsm1*dum)
            1935     3               !           DWV0=MIN(WV,QSW)-QSW0
            1936     3                           DWV0=MIN(WV,QSW_l)-QSW0_l
            1937     3                           DUM=QW+PCOND
            1938     4                           IF (WV.LT.QSW_l .AND. DUM.LE.EPSQ) THEN
            1939     4                  !
            1940     4                  !--- Evaporation from melting snow (sink of snow) or shedding
            1941     4                  !    of water condensed onto melting snow (source of rain)
            1942     4                  !
            1943     4                             DUM=DWV0*DIEVP
            1944     4                             PIEVP=MAX( MIN(0., DUM), PILOSS)
            1945     4                             PICND=MAX(0., DUM)
            1946     4                           ENDIF            ! End IF (WV.LT.QSW_l .AND. DUM.LE.EPSQ)
            1947     3                           PIMLT=THERM_COND*TCC*VENTIL*RRHO*DTPH/XLF
            1948     3                  !
            1949     3                  !--- Limit melting to prevent temperature oscillations across 0C
            1950     3                  !
            1951     3                           DUM1=MAX( 0., (TCC+XLV1*PIEVP)/XLF1 )
            1952     3                           PIMLT=MIN(PIMLT, DUM1)
            1953     3                  !
            1954     3                  !--- Limit loss of snow by melting (>0) and evaporation
            1955     3                  !
            1956     3                           DUM=PIEVP-PIMLT
            1957     4                           IF (DUM .LT. PILOSS) THEN
            1958     4                             DUM1=PILOSS/DUM
            1959     4                             PIMLT=PIMLT*DUM1
            1960     4                             PIEVP=PIEVP*DUM1
            1961     4                           ENDIF           ! End IF (DUM .GT. QTICE)
            1962     3                         ENDIF             ! End IF (TC.GT.0. .AND. TCC.GT.0. .AND. ICE_logical)
            1963     2               !
            1964     2               !--- IMPORTANT:  Estimate time-averaged properties.
            1965     2               !
            1966     2               !  * TOT_RAIN - total mass of rain before microphysics, which is the sum of
            1967     2               !               the total mass of rain in the current layer and the input
            1968     2               !               flux of rain from above
            1969     2               !  * VRAIN1   - fall speed of rain into grid from above (with air resistance correction)
            1970     2               !  * QTRAIN   - time-averaged mixing ratio of rain (kg/kg)
            1971     2               !  * PRLOSS   - greatest loss (<0) of rain, removing all rain falling from
            1972     2               !               above and the rain within the layer
            1973     2               !  * RQR      - rain content (kg/m**3)
            1974     2               !  * INDEXR   - mean size of rain drops to the nearest 1 micron in size
            1975     2               !  * N0r      - intercept of rain size distribution (typically 10**6 m**-4)
            1976     2               !
            1977     2                         TOT_RAIN=0.
            1978     2                         VRAIN1=0.
            1979     2                         QTRAIN=0.
            1980     2                         PRLOSS=0.
            1981     2                         RQR=0.
            1982     2                         N0r=0.
            1983     2                         INDEXR1=INDEXR    ! For debugging only
            1984     2                         INDEXR=MDRmin
            1985     3                         IF (RAIN_logical) THEN
            1986     4                           IF (ARAIN .LE. 0.) THEN
            1987     4                             INDEXR=MDRmin
            1988     4                             VRAIN1=0.
            1989     4                           ELSE
            1990     4                  !
            1991     4                  !--- INDEXR (related to mean diameter) & N0r could be modified
            1992     4                  !      by land/sea properties, presence of convection, etc.
            1993     4                  !
            1994     4                  !--- Rain rate normalized to a density of 1.194 kg/m**3
            1995     4                  !
            1996     4                             RR=ARAIN/(DTPH*GAMMAR)
            1997     4                  !
            1998     5                             IF (RR .LE. RR_DRmin) THEN
            1999     5                       !
            2000     5                       !--- Assume fixed mean diameter of rain (0.2 mm) for low rain rates,
            2001     5                       !      instead vary N0r with rain rate
            2002     5                       !
            2003     5                               INDEXR=MDRmin
            2004     5                             ELSE IF (RR .LE. RR_DR1) THEN
            2005     5                       !
            2006     5                       !--- Best fit to mass-weighted fall speeds (V) from rain lookup tables
            2007     5                       !      for mean diameters (Dr) between 0.05 and 0.10 mm:
            2008     5                       !      V(Dr)=5.6023e4*Dr**1.136, V in m/s and Dr in m
            2009     5                       !      RR = PI*1000.*N0r0*5.6023e4*Dr**(4+1.136) = 1.408e15*Dr**5.136,
            2010     5                       !        RR in kg/(m**2*s)
            2011     5                       !      Dr (m) = 1.123e-3*RR**.1947 -> Dr (microns) = 1.123e3*RR**.1947
            2012     5                       !
            2013     5                               INDEXR=INT( 1.123E3*RR**.1947 + .5 )
            2014     5                               INDEXR=MAX( MDRmin, MIN(INDEXR, MDR1) )
            2015     5                             ELSE IF (RR .LE. RR_DR2) THEN
            2016     5                       !
            2017     5                       !--- Best fit to mass-weighted fall speeds (V) from rain lookup tables
            2018     5                       !      for mean diameters (Dr) between 0.10 and 0.20 mm:
            2019     5                       !      V(Dr)=1.0867e4*Dr**.958, V in m/s and Dr in m
            2020     5                       !      RR = PI*1000.*N0r0*1.0867e4*Dr**(4+.958) = 2.731e14*Dr**4.958,
            2021     5                       !        RR in kg/(m**2*s)
            2022     5                       !      Dr (m) = 1.225e-3*RR**.2017 -> Dr (microns) = 1.225e3*RR**.2017
            2023     5                       !
            2024     5                               INDEXR=INT( 1.225E3*RR**.2017 + .5 )
            2025     5                               INDEXR=MAX( MDR1, MIN(INDEXR, MDR2) )
            2026     5                             ELSE IF (RR .LE. RR_DR3) THEN
            2027     5                       !
            2028     5                       !--- Best fit to mass-weighted fall speeds (V) from rain lookup tables
            2029     5                       !      for mean diameters (Dr) between 0.20 and 0.32 mm:
            2030     5                       !      V(Dr)=2831.*Dr**.80, V in m/s and Dr in m
            2031     5                       !      RR = PI*1000.*N0r0*2831.*Dr**(4+.80) = 7.115e13*Dr**4.80,
            2032     5                       !        RR in kg/(m**2*s)
            2033     5                       !      Dr (m) = 1.3006e-3*RR**.2083 -> Dr (microns) = 1.3006e3*RR**.2083
            2034     5                       !
            2035     5                               INDEXR=INT( 1.3006E3*RR**.2083 + .5 )
            2036     5                               INDEXR=MAX( MDR2, MIN(INDEXR, MDR3) )
            2037     5                             ELSE IF (RR .LE. RR_DRmax) THEN
            2038     5                       !
            2039     5                       !--- Best fit to mass-weighted fall speeds (V) from rain lookup tables
            2040     5                       !      for mean diameters (Dr) between 0.32 and 0.45 mm:
            2041     5                       !      V(Dr)=944.8*Dr**.6636, V in m/s and Dr in m
            2042     5                       !      RR = PI*1000.*N0r0*944.8*Dr**(4+.6636) = 2.3745e13*Dr**4.6636,
            2043     5                       !        RR in kg/(m**2*s)
            2044     5                       !      Dr (m) = 1.355e-3*RR**.2144 -> Dr (microns) = 1.355e3*RR**.2144
            2045     5                       !
            2046     5                               INDEXR=INT( 1.355E3*RR**.2144 + .5 )
            2047     5                               INDEXR=MAX( MDR3, MIN(INDEXR, MDRmax) )
            2048     5                             ELSE
            2049     5                       !
            2050     5                       !--- Assume fixed mean diameter of rain (0.45 mm) for high rain rates,
            2051     5                       !      instead vary N0r with rain rate
            2052     5                       !
            2053     5                               INDEXR=MDRmax
            2054     5                             ENDIF              ! End IF (RR .LE. RR_DRmin) etc.
            2055     4                             VRAIN1=GAMMAR*VRAIN(INDEXR)
            2056     4                           ENDIF              ! End IF (ARAIN .LE. 0.)
            2057     3                           INDEXR1=INDEXR     ! For debugging only
            2058     3                           TOT_RAIN=THICK*QR+BLEND*ARAIN
            2059     3                           QTRAIN=TOT_RAIN/(THICK+BLDTRH*VRAIN1)
            2060     3                           PRLOSS=-TOT_RAIN/THICK
            2061     3                           RQR=RHO*QTRAIN
            2062     3                  !
            2063     3                  !--- RQR - time-averaged rain content (kg/m**3)
            2064     3                  !
            2065     4                           IF (RQR .LE. RQR_DRmin) THEN
            2066     4                             N0r=MAX(N0rmin, CN0r_DMRmin*RQR)
            2067     4                             INDEXR=MDRmin
            2068     4                           ELSE IF (RQR .GE. RQR_DRmax) THEN
            2069     4                             N0r=CN0r_DMRmax*RQR
            2070     4                             INDEXR=MDRmax
            2071     4                           ELSE
            2072     4                             N0r=N0r0
            2073     4                             INDEXR=MAX( XMRmin, MIN(CN0r0*RQR**.25, XMRmax) )
            2074     4                           ENDIF
            2075     3                  !
            2076     4                           IF (TC .LT. T_ICE) THEN
            2077     4                             PIACR=-PRLOSS
            2078     4                           ELSE
            2079     4                             DWVr=WV-PCOND-QSW_l
            2080     4                             DUM=QW+PCOND
            2081     5                             IF (DWVr.LT.0. .AND. DUM.LE.EPSQ) THEN
            2082     5                     !
            2083     5                     !--- Rain evaporation
            2084     5                     !
            2085     5                     !    * RFACTOR - [GAMMAR**.5]*[Schmidt**(1./3.)]*[(RHO/DYNVIS)**.5],
            2086     5                     !        where Schmidt (Schmidt Number) =DYNVIS/(RHO*DIFFUS)
            2087     5                     !
            2088     5                     !    * Units: RFACTOR - s**.5/m ;  ABW - m**2/s ;  VENTR - m**-2 ;
            2089     5                     !             N0r - m**-4 ;  VENTR1 - m**2 ;  VENTR2 - m**3/s**.5 ;
            2090     5                     !             CREVP - unitless
            2091     5                     !
            2092     5               !               RFACTOR=GAMMAR**.5*(RHO/(DIFFUS*DIFFUS*DYNVIS))**C2
            2093     5                               RFACTOR=sqrt(GAMMAR)*(RHO/(DIFFUS*DIFFUS*DYNVIS))**C2
            2094     5                               ABW=1./(RHO*XLV2/THERM_COND+1./DIFFUS)
            2095     5                     !
            2096     5                     !--- Note that VENTR1, VENTR2 lookup tables do not include the
            2097     5                     !      1/Davg multiplier as in the ice tables
            2098     5                     !
            2099     5                               VENTR=N0r*(VENTR1(INDEXR)+RFACTOR*VENTR2(INDEXR))
            2100     5                               CREVP=ABW*VENTR*DTPH
            2101     6                               IF (CREVP .LT. Xratio) THEN
            2102     6                                 DUM=DWVr*CREVP
            2103     6                               ELSE
            2104     6                                 DUM=DWVr*(1.-EXP(-CREVP*DENOMW))/DENOMW
            2105     6                               ENDIF
            2106     5                               PREVP=MAX(DUM, PRLOSS)
            2107     5                             ELSE IF (QW .GT. EPSQ) THEN
            2108     5                               FWR=CRACW*GAMMAR*N0r*ACCRR(INDEXR)
            2109     5               !Moor           PRACW=MIN(1.,FWR)*QW               ! 20050422
            2110     5                               PRACW=MIN(0.1,FWR)*QW
            2111     5                             ENDIF           ! End IF (DWVr.LT.0. .AND. DUM.LE.EPSQ)
            2112     4                     !
            2113     5                             IF (TC.LT.0. .AND. TCC.LT.0.) THEN
            2114     5                        !
            2115     5                        !--- Biggs (1953) heteorogeneous freezing (e.g., Lin et al., 1983)
            2116     5                        !   - Rescaled mean drop diameter from microns (INDEXR) to mm (DUM) to prevent underflow
            2117     5                        !
            2118     5                               DUM=.001*FLOAT(INDEXR)
            2119     5                               dum1 = dum * dum
            2120     5                               DUM=(EXP(ABFR*TC)-1.)*DUM1*DUM1*DUM1*DUM
            2121     5                               PIACR=MIN(CBFR*N0r*RRHO*DUM, QTRAIN)
            2122     6                               IF (QLICE .GT. EPSQ) THEN
            2123     6                           !
            2124     6                           !--- Freezing of rain by collisions w/ large ice
            2125     6                           !
            2126     6                                 DUM=GAMMAR*VRAIN(INDEXR)
            2127     6                                 DUM1=DUM-VSNOW
            2128     6                           !
            2129     6                           !--- DUM2 - Difference in spectral fall speeds of rain and
            2130     6                           !      large ice, parameterized following eq. (48) on p. 112 of
            2131     6                           !      Murakami (J. Meteor. Soc. Japan, 1990)
            2132     6                           !
            2133     6                                 DUM2=(DUM1*DUM1+.04*DUM*VSNOW)**.5
            2134     6                                 DUM1=5.E-12*INDEXR*INDEXR+2.E-12*INDEXR*INDEXS        &
            2135     6                    &                 +.5E-12*INDEXS*INDEXS
            2136     6                                 FIR=MIN(1., CIACR*NLICE*DUM1*DUM2)
            2137     6                           !
            2138     6                           !--- Future?  Should COLLECTION BY SMALL ICE SHOULD BE INCLUDED???
            2139     6                           !
            2140     6                                 PIACR=MIN(PIACR+FIR*QTRAIN, QTRAIN)
            2141     6                               ENDIF        ! End IF (QLICE .GT. EPSQ)
            2142     5                               DUM=PREVP-PIACR
            2143     6                               If (DUM .LT. PRLOSS) THEN
            2144     6                                 DUM1=PRLOSS/DUM
            2145     6                                 PREVP=DUM1*PREVP
            2146     6                                 PIACR=DUM1*PIACR
            2147     6                               ENDIF        ! End If (DUM .LT. PRLOSS)
            2148     5                             ENDIF          ! End IF (TC.LT.0. .AND. TCC.LT.0.)
            2149     4                           ENDIF            ! End IF (TC .LT. T_ICE)
            2150     3                         ENDIF              ! End IF (RAIN_logical)
            2151     2               !
            2152     2               !----------------------------------------------------------------------
            2153     2               !---------------------- Main Budget Equations -------------------------
            2154     2               !----------------------------------------------------------------------
            2155     2               !
            2156     2               !
            2157     2               !-----------------------------------------------------------------------
            2158     2               !--- Update fields, determine characteristics for next lower layer ----
            2159     2               !-----------------------------------------------------------------------
            2160     2               !
            2161     2               !--- Carefully limit sinks of cloud water
            2162     2               !
            2163     2                         DUM1=PIACW+PRAUT+PRACW-MIN(0.,PCOND)
            2164     3                         IF (DUM1 .GT. QW) THEN
            2165     3                           DUM=QW/DUM1
            2166     3                           PIACW=DUM*PIACW
            2167     3                           PIACWI=DUM*PIACWI
            2168     3                           PRAUT=DUM*PRAUT
            2169     3                           PRACW=DUM*PRACW
            2170     3                           IF (PCOND .LT. 0.) PCOND=DUM*PCOND
            2171     3                         ENDIF
            2172     2                         PIACWR=PIACW-PIACWI          ! TC >= 0C
            2173     2               !
            2174     2               !--- QWnew - updated cloud water mixing ratio
            2175     2               !
            2176     2                         DELW=PCOND-PIACW-PRAUT-PRACW
            2177     2                         QWnew=QW+DELW
            2178     2                         IF (QWnew .LE. EPSQ) QWnew=0.
            2179     3                         IF (QW.GT.0. .AND. QWnew.NE.0.) THEN
            2180     3                           DUM=QWnew/QW
            2181     3                           IF (DUM .LT. TOLER) QWnew=0.
            2182     3                         ENDIF
            2183     2               !
            2184     2               !--- Update temperature and water vapor mixing ratios
            2185     2               !
            2186     2                         DELT= XLV1*(PCOND+PIEVP+PICND+PREVP)                          &
            2187     2                    &         +XLS1*PIDEP+XLF1*(PIACWI+PIACR-PIMLT)
            2188     2                         Tnew=TK+DELT
            2189     2               !
            2190     2                         DELV=-PCOND-PIDEP-PIEVP-PICND-PREVP
            2191     2                         WVnew=WV+DELV
            2192     2               !
            2193     2               !--- Update ice mixing ratios
            2194     2               !
            2195     2               !---
            2196     2               !  * TOT_ICEnew - total mass (small & large) ice after microphysics,
            2197     2               !                 which is the sum of the total mass of large ice in the
            2198     2               !                 current layer and the flux of ice out of the grid box below
            2199     2               !  * RimeF      - Rime Factor, which is the mass ratio of total (unrimed &
            2200     2               !                 rimed) ice mass to the unrimed ice mass (>=1)
            2201     2               !  * QInew      - updated mixing ratio of total (large & small) ice in layer
            2202     2               !      -> TOT_ICEnew=QInew*THICK+BLDTRH*QLICEnew*VSNOW
            2203     2               !        -> But QLICEnew=QInew*FLIMASS, so
            2204     2               !      -> TOT_ICEnew=QInew*(THICK+BLDTRH*FLIMASS*VSNOW)
            2205     2               !  * ASNOWnew   - updated accumulation of snow at bottom of grid cell
            2206     2               !---
            2207     2               !
            2208     2                         DELI=0.
            2209     2                         RimeF=1.
            2210     3                         IF (ICE_logical) THEN
            2211     3                           DELI=PIDEP+PIEVP+PIACWI+PIACR-PIMLT
            2212     3                           TOT_ICEnew=TOT_ICE+THICK*DELI
            2213     4                           IF (TOT_ICE.GT.0. .AND. TOT_ICEnew.NE.0.) THEN
            2214     4                             DUM=TOT_ICEnew/TOT_ICE
            2215     4                             IF (DUM .LT. TOLER) TOT_ICEnew=0.
            2216     4                           ENDIF
            2217     4                           IF (TOT_ICEnew .LE. CLIMIT) THEN
            2218     4                             TOT_ICEnew=0.
            2219     4                             RimeF=1.
            2220     4                             QInew=0.
            2221     4                             ASNOWnew=0.
            2222     4                           ELSE
            2223     4                     !
            2224     4                     !--- Update rime factor if appropriate
            2225     4                     !
            2226     4                             DUM=PIACWI+PIACR
            2227     5                             IF (DUM.LE.EPSQ .AND. PIDEP.LE.EPSQ) THEN
            2228     5                               RimeF=RimeF1
            2229     5                             ELSE
            2230     5                        !
            2231     5                        !--- Rime Factor, RimeF = (Total ice mass)/(Total unrimed ice mass)
            2232     5                        !      DUM1 - Total ice mass, rimed & unrimed
            2233     5                        !      DUM2 - Estimated mass of *unrimed* ice
            2234     5                        !
            2235     5                               DUM1=TOT_ICE+THICK*(PIDEP+DUM)
            2236     5                               DUM2=TOT_ICE/RimeF1+THICK*PIDEP
            2237     6                               IF (DUM2 .LE. 0.) THEN
            2238     6                                 RimeF=RFmax
            2239     6                               ELSE
            2240     6                                 RimeF=MIN(RFmax, MAX(1., DUM1/DUM2) )
            2241     6                               ENDIF
            2242     5                             ENDIF       ! End IF (DUM.LE.EPSQ .AND. PIDEP.LE.EPSQ)
            2243     4                             QInew=TOT_ICEnew/(THICK+BLDTRH*FLIMASS*VSNOW)
            2244     4                             IF (QInew .LE. EPSQ) QInew=0.
            2245     5                             IF (QI.GT.0. .AND. QInew.NE.0.) THEN
            2246     5                               DUM=QInew/QI
            2247     5                               IF (DUM .LT. TOLER) QInew=0.
            2248     5                             ENDIF
            2249     4                             ASNOWnew=BLDTRH*FLIMASS*VSNOW*QInew
            2250     5                             IF (ASNOW.GT.0. .AND. ASNOWnew.NE.0.) THEN
            2251     5                               DUM=ASNOWnew/ASNOW
            2252     5                               IF (DUM .LT. TOLER) ASNOWnew=0.
            2253     5                             ENDIF
            2254     4                           ENDIF         ! End IF (TOT_ICEnew .LE. CLIMIT)
            2255     3                         ENDIF           ! End IF (ICE_logical)
            2256     2               !
            2257     2               !--- Update rain mixing ratios
            2258     2               !
            2259     2               !---
            2260     2               ! * TOT_RAINnew - total mass of rain after microphysics
            2261     2               !                 current layer and the input flux of ice from above
            2262     2               ! * VRAIN2      - time-averaged fall speed of rain in grid and below
            2263     2               !                 (with air resistance correction)
            2264     2               ! * QRnew       - updated rain mixing ratio in layer
            2265     2               !      -> TOT_RAINnew=QRnew*(THICK+BLDTRH*VRAIN2)
            2266     2               !  * ARAINnew  - updated accumulation of rain at bottom of grid cell
            2267     2               !---
            2268     2               !
            2269     2                         DELR=PRAUT+PRACW+PIACWR-PIACR+PIMLT+PREVP+PICND
            2270     2                         TOT_RAINnew=TOT_RAIN+THICK*DELR
            2271     3                         IF (TOT_RAIN.GT.0. .AND. TOT_RAINnew.NE.0.) THEN
            2272     3                           DUM=TOT_RAINnew/TOT_RAIN
            2273     3                           IF (DUM .LT. TOLER) TOT_RAINnew=0.
            2274     3                         ENDIF
            2275     3                         IF (TOT_RAINnew .LE. CLIMIT) THEN
            2276     3                           TOT_RAINnew=0.
            2277     3                           VRAIN2=0.
            2278     3                           QRnew=0.
            2279     3                           ARAINnew=0.
            2280     3                         ELSE
            2281     3                  !
            2282     3                  !--- 1st guess time-averaged rain rate at bottom of grid box
            2283     3                  !
            2284     3                           RR=TOT_RAINnew/(DTPH*GAMMAR)
            2285     3                  !
            2286     3                  !--- Use same algorithm as above for calculating mean drop diameter
            2287     3                  !      (IDR, in microns), which is used to estimate the time-averaged
            2288     3                  !      fall speed of rain drops at the bottom of the grid layer.  This
            2289     3                  !      isn't perfect, but the alternative is solving a transcendental
            2290     3                  !      equation that is numerically inefficient and nasty to program
            2291     3                  !      (coded in earlier versions of GSMCOLUMN prior to 8-22-01).
            2292     3                  !
            2293     4                           IF (RR .LE. RR_DRmin) THEN
            2294     4                             IDR=MDRmin
            2295     4                           ELSE IF (RR .LE. RR_DR1) THEN
            2296     4                             IDR=INT( 1.123E3*RR**.1947 + .5 )
            2297     4                             IDR=MAX( MDRmin, MIN(IDR, MDR1) )
            2298     4                           ELSE IF (RR .LE. RR_DR2) THEN
            2299     4                             IDR=INT( 1.225E3*RR**.2017 + .5 )
            2300     4                             IDR=MAX( MDR1, MIN(IDR, MDR2) )
            2301     4                           ELSE IF (RR .LE. RR_DR3) THEN
            2302     4                             IDR=INT( 1.3006E3*RR**.2083 + .5 )
            2303     4                             IDR=MAX( MDR2, MIN(IDR, MDR3) )
            2304     4                           ELSE IF (RR .LE. RR_DRmax) THEN
            2305     4                             IDR=INT( 1.355E3*RR**.2144 + .5 )
            2306     4                             IDR=MAX( MDR3, MIN(IDR, MDRmax) )
            2307     4                           ELSE
            2308     4                             IDR=MDRmax
            2309     4                           ENDIF              ! End IF (RR .LE. RR_DRmin)
            2310     3                           VRAIN2=GAMMAR*VRAIN(IDR)
            2311     3                           QRnew=TOT_RAINnew/(THICK+BLDTRH*VRAIN2)
            2312     3                           IF (QRnew .LE. EPSQ) QRnew=0.
            2313     4                           IF (QR.GT.0. .AND. QRnew.NE.0.) THEN
            2314     4                             DUM=QRnew/QR
            2315     4                             IF (DUM .LT. TOLER) QRnew=0.
            2316     4                           ENDIF
            2317     3                           ARAINnew=BLDTRH*VRAIN2*QRnew
            2318     4                           IF (ARAIN.GT.0. .AND. ARAINnew.NE.0.) THEN
            2319     4                             DUM=ARAINnew/ARAIN
            2320     4                             IF (DUM .LT. TOLER) ARAINnew=0.
            2321     4                           ENDIF
            2322     3                         ENDIF                ! End IF (TOT_RAINnew .LE. CLIMIT)
            2323     2               !
            2324     2                         WCnew=QWnew+QRnew+QInew
            2325     2               !
            2326     2               !----------------------------------------------------------------------
            2327     2               !-------------- Begin debugging & verification ------------------------
            2328     2               !----------------------------------------------------------------------
            2329     2               !
            2330     2               !--- QT, QTnew - total water (vapor & condensate) before & after microphysics, resp.
            2331     2               !
            2332     2               !         QT=THICK*(QV+WC_col(l))+ARAIN+ASNOW
            2333     2               !         QTnew=THICK*(WVnew/(1.+WVnew)+WCnew/(1.+wcnew))
            2334     2               !    &         +ARAINnew+ASNOWnew
            2335     2                         QT=THICK*(WV+WC)+ARAIN+ASNOW
            2336     2                         QTnew=THICK*(WVnew+WCnew)+ARAINnew+ASNOWnew
            2337     2                         BUDGET=QT-QTnew
            2338     2               !
            2339     2               !--- Additional check on budget preservation, accounting for truncation effects
            2340     2               !
            2341     2                         DBG_logical=.FALSE.
            2342     2               !         DUM=ABS(BUDGET)
            2343     2               !         IF (DUM .GT. TOLER) THEN
            2344     2               !           DUM=DUM/MIN(QT, QTnew)
            2345     2               !           IF (DUM .GT. TOLER) DBG_logical=.TRUE.
            2346     2               !         ENDIF
            2347     2               !
            2348     2               !          DUM=(RHgrd+.001)*QSInew
            2349     2               !          IF ( (QWnew.GT.EPSQ .OR. QRnew.GT.EPSQ .OR. WVnew.GT.DUM)
            2350     2               !     &        .AND. TC.LT.T_ICE )  DBG_logical=.TRUE.
            2351     2               !
            2352     2               !          IF (TC.GT.5. .AND. QInew.GT.EPSQ) DBG_logical=.TRUE.
            2353     2               !
            2354     3                         IF ((WVnew.LT.EPSQ .OR. DBG_logical) .AND. PRINT_diag) THEN
            2355     3                  !
            2356     3                           WRITE(6,"(/2(a,i4),2(a,i2))") '{} i=',I_index,' j=',J_index,&
            2357     3                    &                                    ' L=',L,' LSFC=',LSFC
            2358     3                  !
            2359     3                           ESW=min(PP, FPVSL(Tnew))
            2360     3               !           QSWnew=EPS*ESW/(PP-ESW)
            2361     3                           QSWnew=EPS*ESW/(PP+epsm1*ESW)
            2362     4                           IF (TC.LT.0. .OR. Tnew .LT. 0.) THEN
            2363     4                             ESI=min(PP, FPVSI(Tnew))
            2364     4               !             QSInew=EPS*ESI/(PP-ESI)
            2365     4                             QSInew=EPS*ESI/(PP+epsm1*ESI)
            2366     4                           ELSE
            2367     4                             QSI=QSW
            2368     4                             QSInew=QSWnew
            2369     4                           ENDIF
            2370     3                           WSnew=QSInew
            2371     3                           WRITE(6,"(4(a12,g11.4,1x))")                                &
            2372     3                    & '{} TCold=',TC,'TCnew=',Tnew-T0C,'P=',.01*PP,'RHO=',RHO,         &
            2373     3                    & '{} THICK=',THICK,'RHold=',WV/WS,'RHnew=',WVnew/WSnew,           &
            2374     3                    &   'RHgrd=',RHgrd,                                                &
            2375     3                    & '{} RHWold=',WV/QSW,'RHWnew=',WVnew/QSWnew,'RHIold=',WV/QSI,     &
            2376     3                    &   'RHInew=',WVnew/QSInew,                                        &
            2377     3                    & '{} QSWold=',QSW,'QSWnew=',QSWnew,'QSIold=',QSI,'QSInew=',QSInew,&
            2378     3                    & '{} WSold=',WS,'WSnew=',WSnew,'WVold=',WV,'WVnew=',WVnew,        &
            2379     3                    & '{} WCold=',WC,'WCnew=',WCnew,'QWold=',QW,'QWnew=',QWnew,        &
            2380     3                    & '{} QIold=',QI,'QInew=',QInew,'QRold=',QR,'QRnew=',QRnew,        &
            2381     3                    & '{} ARAINold=',ARAIN,'ARAINnew=',ARAINnew,'ASNOWold=',ASNOW,     &
            2382     3                    &   'ASNOWnew=',ASNOWnew,                                          &
            2383     3                    & '{} TOT_RAIN=',TOT_RAIN,'TOT_RAINnew=',TOT_RAINnew,              &
            2384     3                    &   'TOT_ICE=',TOT_ICE,'TOT_ICEnew=',TOT_ICEnew,                   &
            2385     3                    & '{} BUDGET=',BUDGET,'QTold=',QT,'QTnew=',QTnew
            2386     3                  !
            2387     3                           WRITE(6,"(4(a12,g11.4,1x))")                                &
            2388     3                    & '{} DELT=',DELT,'DELV=',DELV,'DELW=',DELW,'DELI=',DELI,          &
            2389     3                    & '{} DELR=',DELR,'PCOND=',PCOND,'PIDEP=',PIDEP,'PIEVP=',PIEVP,    &
            2390     3                    & '{} PICND=',PICND,'PREVP=',PREVP,'PRAUT=',PRAUT,'PRACW=',PRACW,  &
            2391     3                    & '{} PIACW=',PIACW,'PIACWI=',PIACWI,'PIACWR=',PIACWR,'PIMLT=',    &
            2392     3                    &    PIMLT,                                                        &
            2393     3                    & '{} PIACR=',PIACR
            2394     3                  !
            2395     3                           IF (ICE_logical) WRITE(6,"(4(a12,g11.4,1x))")               &
            2396     3                    & '{} RimeF1=',RimeF1,'GAMMAS=',GAMMAS,'VrimeF=',VrimeF,           &
            2397     3                    &   'VSNOW=',VSNOW,                                                &
            2398     3                    & '{} INDEXS=',FLOAT(INDEXS),'FLARGE=',FLARGE,'FSMALL=',FSMALL,    &
            2399     3                    &   'FLIMASS=',FLIMASS,                                            &
            2400     3                    & '{} XSIMASS=',XSIMASS,'XLIMASS=',XLIMASS,'QLICE=',QLICE,         &
            2401     3                    &   'QTICE=',QTICE,                                                &
            2402     3                    & '{} NLICE=',NLICE,'NSmICE=',NSmICE,'PILOSS=',PILOSS,             &
            2403     3                    &   'EMAIRI=',EMAIRI,                                              &
            2404     3                    & '{} RimeF=',RimeF
            2405     3                  !
            2406     3                           IF (TOT_RAIN.GT.0. .OR. TOT_RAINnew.GT.0.)                  &
            2407     3                    &        WRITE(6,"(4(a12,g11.4,1x))")                              &
            2408     3                    & '{} INDEXR1=',FLOAT(INDEXR1),'INDEXR=',FLOAT(INDEXR),            &
            2409     3                    &   'GAMMAR=',GAMMAR,'N0r=',N0r,                                   &
            2410     3                    & '{} VRAIN1=',VRAIN1,'VRAIN2=',VRAIN2,'QTRAIN=',QTRAIN,'RQR=',RQR,&
            2411     3                    & '{} PRLOSS=',PRLOSS,'VOLR1=',THICK+BLDTRH*VRAIN1,                &
            2412     3                    &   'VOLR2=',THICK+BLDTRH*VRAIN2
            2413     3                  !
            2414     3                           IF (PRAUT .GT. 0.) WRITE(6,"(a12,g11.4,1x)") '{} QW0=',QW0
            2415     3                  !
            2416     3                           IF (PRACW .GT. 0.) WRITE(6,"(a12,g11.4,1x)") '{} FWR=',FWR
            2417     3                  !
            2418     3                           IF (PIACR .GT. 0.) WRITE(6,"(a12,g11.4,1x)") '{} FIR=',FIR
            2419     3                  !
            2420     3                           DUM=PIMLT+PICND-PREVP-PIEVP
            2421     3                           IF (DUM.GT.0. .or. DWVi.NE.0.)                              &
            2422     3                    &        WRITE(6,"(4(a12,g11.4,1x))")                              &
            2423     3                    & '{} TFACTOR=',TFACTOR,'DYNVIS=',DYNVIS,                          &
            2424     3                    &   'THERM_CON=',THERM_COND,'DIFFUS=',DIFFUS
            2425     3                  !
            2426     3                           IF (PREVP .LT. 0.) WRITE(6,"(4(a12,g11.4,1x))")             &
            2427     3                    & '{} RFACTOR=',RFACTOR,'ABW=',ABW,'VENTR=',VENTR,'CREVP=',CREVP,  &
            2428     3                    & '{} DWVr=',DWVr,'DENOMW=',DENOMW
            2429     3                  !
            2430     3                           IF (PIDEP.NE.0. .AND. DWVi.NE.0.)                           &
            2431     3                    &        WRITE(6,"(4(a12,g11.4,1x))")                              &
            2432     3                    & '{} DWVi=',DWVi,'DENOMI=',DENOMI,'PIDEP_max=',PIDEP_max,         &
            2433     3                    &   'SFACTOR=',SFACTOR,                                            &
            2434     3                    & '{} ABI=',ABI,'VENTIL=',VENTIL,'VENTIL1=',VENTI1(INDEXS),        &
            2435     3                    &   'VENTIL2=',SFACTOR*VENTI2(INDEXS),                             &
            2436     3                    & '{} VENTIS=',VENTIS,'DIDEP=',DIDEP
            2437     3                  !
            2438     3                           IF (PIDEP.GT.0. .AND. PCOND.NE.0.)                          &
            2439     3                    &        WRITE(6,"(4(a12,g11.4,1x))")                              &
            2440     3                    & '{} DENOMW=',DENOMW,'DENOMWI=',DENOMWI,'DENOMF=',DENOMF,         &
            2441     3                    &    'DUM2=',PCOND-PIACW
            2442     3                  !
            2443     3                           IF (FWS .GT. 0.) WRITE(6,"(4(a12,g11.4,1x))")               &
            2444     3                    & '{} FWS=',FWS
            2445     3                  !
            2446     3                           DUM=PIMLT+PICND-PIEVP
            2447     3                           IF (DUM.GT. 0.) WRITE(6,"(4(a12,g11.4,1x))")                &
            2448     3                    & '{} SFACTOR=',SFACTOR,'VENTIL=',VENTIL,'VENTIL1=',VENTI1(INDEXS),&
            2449     3                    &   'VENTIL2=',SFACTOR*VENTI2(INDEXS),                             &
            2450     3                    & '{} AIEVP=',AIEVP,'DIEVP=',DIEVP,'QSW0=',QSW0,'DWV0=',DWV0
            2451     3                  !
            2452     3               !         if(lsfc .gt. 0) stop
            2453     3                         ENDIF
            2454     2               !
            2455     2               !----------------------------------------------------------------------
            2456     2               !-------------- Water budget statistics & maximum values --------------
            2457     2               !----------------------------------------------------------------------
            2458     2               !
            2459     3                         IF (PRINT_diag) THEN
            2460     3                           ITdx=MAX( ITLO, MIN( INT(Tnew-T0C), ITHI ) )
            2461     3                           IF (QInew .GT. EPSQ) NSTATS(ITdx,1)=NSTATS(ITdx,1)+1
            2462     3                           IF (QInew.GT.EPSQ .AND.  QRnew+QWnew.GT.EPSQ)               &
            2463     3                    &        NSTATS(ITdx,2)=NSTATS(ITdx,2)+1
            2464     3                           IF (QWnew .GT. EPSQ) NSTATS(ITdx,3)=NSTATS(ITdx,3)+1
            2465     3                           IF (QRnew .GT. EPSQ) NSTATS(ITdx,4)=NSTATS(ITdx,4)+1
            2466     3                 !
            2467     3                           QMAX(ITdx,1)=MAX(QMAX(ITdx,1), QInew)
            2468     3                           QMAX(ITdx,2)=MAX(QMAX(ITdx,2), QWnew)
            2469     3                           QMAX(ITdx,3)=MAX(QMAX(ITdx,3), QRnew)
            2470     3                           QMAX(ITdx,4)=MAX(QMAX(ITdx,4), ASNOWnew)
            2471     3                           QMAX(ITdx,5)=MAX(QMAX(ITdx,5), ARAINnew)
            2472     3                           QTOT(ITdx,1)=QTOT(ITdx,1)+QInew*THICK
            2473     3                           QTOT(ITdx,2)=QTOT(ITdx,2)+QWnew*THICK
            2474     3                           QTOT(ITdx,3)=QTOT(ITdx,3)+QRnew*THICK
            2475     3                 !
            2476     3                           QTOT(ITdx,4)=QTOT(ITdx,4)+PCOND*THICK
            2477     3                           QTOT(ITdx,5)=QTOT(ITdx,5)+PICND*THICK
            2478     3                           QTOT(ITdx,6)=QTOT(ITdx,6)+PIEVP*THICK
            2479     3                           QTOT(ITdx,7)=QTOT(ITdx,7)+PIDEP*THICK
            2480     3                           QTOT(ITdx,8)=QTOT(ITdx,8)+PREVP*THICK
            2481     3                           QTOT(ITdx,9)=QTOT(ITdx,9)+PRAUT*THICK
            2482     3                           QTOT(ITdx,10)=QTOT(ITdx,10)+PRACW*THICK
            2483     3                           QTOT(ITdx,11)=QTOT(ITdx,11)+PIMLT*THICK
            2484     3                           QTOT(ITdx,12)=QTOT(ITdx,12)+PIACW*THICK
            2485     3                           QTOT(ITdx,13)=QTOT(ITdx,13)+PIACWI*THICK
            2486     3                           QTOT(ITdx,14)=QTOT(ITdx,14)+PIACWR*THICK
            2487     3                           QTOT(ITdx,15)=QTOT(ITdx,15)+PIACR*THICK
            2488     3                 !
            2489     3                           QTOT(ITdx,16)=QTOT(ITdx,16)+(WVnew-WV)*THICK
            2490     3                           QTOT(ITdx,17)=QTOT(ITdx,17)+(QWnew-QW)*THICK
            2491     3                           QTOT(ITdx,18)=QTOT(ITdx,18)+(QInew-QI)*THICK
            2492     3                           QTOT(ITdx,19)=QTOT(ITdx,19)+(QRnew-QR)*THICK
            2493     3                           QTOT(ITdx,20)=QTOT(ITdx,20)+(ARAINnew-ARAIN)
            2494     3                           QTOT(ITdx,21)=QTOT(ITdx,21)+(ASNOWnew-ASNOW)
            2495     3                           IF (QInew .GT. 0.)                                          &
            2496     3                    &        QTOT(ITdx,22)=QTOT(ITdx,22)+QInew*THICK/RimeF
            2497     3                 !
            2498     3                         ENDIF
            2499     2               !
            2500     2               !----------------------------------------------------------------------
            2501     2               !------------------------- Update arrays ------------------------------
            2502     2               !----------------------------------------------------------------------
            2503     2               !
            2504     2                         T_col(L)=Tnew                           ! Updated temperature
            2505     2               !
            2506     2               !         QV_col(L)=max(EPSQ, WVnew/(1.+WVnew))  ! Updated specific humidity
            2507     2                         QV_col(L)=max(0.0, WVnew           )   ! Updated specific humidity
            2508     2                         WC_col(L)=max(0.0, WCnew)              ! Updated total condensate mixing ratio
            2509     2                         QI_col(L)=max(0.0, QInew)              ! Updated ice mixing ratio
            2510     2                         QR_col(L)=max(0.0, QRnew)              ! Updated rain mixing ratio
            2511     2                         QW_col(L)=max(0.0, QWnew)              ! Updated cloud water mixing ratio
            2512     2                         RimeF_col(L)=RimeF                     ! Updated rime factor
            2513     2                         ASNOW=ASNOWnew                         ! Updated accumulated snow
            2514     2                         ARAIN=ARAINnew                         ! Updated accumulated rain
            2515     2               !
            2516     2               !#######################################################################
            2517     2               !
            2518     2               10      CONTINUE         ! ##### End "L" loop through model levels #####
            2519     1               !
            2520     1                       ARAING = ARAING + ARAIN
            2521     1                       ASNOWG = ASNOWG + ASNOW
            2522     1                     enddo              ! do for ntimes=1,mic_step
            2523                     !
            2524                     !#######################################################################
            2525                     !
            2526                     !-----------------------------------------------------------------------
            2527                     !--------------------------- Return to GSMDRIVE -----------------------
            2528                     !-----------------------------------------------------------------------
            2529                     !
            2530                           CONTAINS
            2531                     !     END  SUBROUTINE GSMCOLUMN
            2532                     !
            2533                     !#######################################################################
            2534                     !--------- Produces accurate calculation of cloud condensation ---------
            2535                     !#######################################################################
            2536                     !
            2537                           REAL FUNCTION CONDENSE (PP, QW, RHgrd, TK, WV)
            2538                     !
            2539                           implicit none
            2540                     !
            2541                     !---------------------------------------------------------------------------------
            2542                     !------   The Asai (1965) algorithm takes into consideration the release of ------
            2543                     !------   latent heat in increasing the temperature & in increasing the     ------
            2544                     !------   saturation mixing ratio (following the Clausius-Clapeyron eqn.).  ------
            2545                     !---------------------------------------------------------------------------------
            2546                     !
            2547                           real pp, qw, rhgrd, tk, wv
            2548                           INTEGER, PARAMETER :: HIGH_PRES=kind_phys
            2549                     !     INTEGER, PARAMETER :: HIGH_PRES=Selected_Real_Kind(15)
            2550                           REAL (KIND=HIGH_PRES), PARAMETER ::                               &
            2551                          & RHLIMIT=.001, RHLIMIT1=-RHLIMIT
            2552                           REAL, PARAMETER :: RCP=1./CP, RCPRV=RCP/RV
            2553                           REAL (KIND=HIGH_PRES) :: COND, SSAT, WCdum, tsq
            2554                           real wvdum, tdum, xlv, xlv1, xlv2, ws, dwv, esw
            2555                     !
            2556                     !-----------------------------------------------------------------------
            2557                     !
            2558                     !--- LV (T) is from Bolton (JAS, 1980)
            2559                     !
            2560                     !     XLV=3.148E6-2370.*TK
            2561                     !     XLV1=XLV*RCP
            2562                     !     XLV2=XLV*XLV*RCPRV
            2563                     !
            2564                           Tdum=TK
            2565                           WVdum=WV
            2566                           WCdum=QW
            2567                           ESW=min(PP, FPVSL(Tdum))                  ! Saturation vapor press w/r/t water
            2568                     !     WS=RHgrd*EPS*ESW/(PP-ESW)                 ! Saturation mixing ratio w/r/t water
            2569                           WS=RHgrd*EPS*ESW/(PP+epsm1*ESW)           ! Saturation mixing ratio w/r/t water
            2570                           DWV=WVdum-WS                              ! Deficit grid-scale water vapor mixing ratio
            2571                           SSAT=DWV/WS                               ! Supersaturation ratio
            2572                           CONDENSE=0.
            2573     1                     DO WHILE ((SSAT.LT.RHLIMIT1 .AND. WCdum.GT.EPSQ)                  &
            2574     1                    &           .OR. SSAT.GT.RHLIMIT)
            2575     1               !
            2576     1                       XLV=3.148E6-2370.*Tdum
            2577     1                       XLV1=XLV*RCP
            2578     1                       XLV2=XLV*XLV*RCPRV
            2579     1               !
            2580     1               !       COND=DWV/(1.+XLV2*WS/(Tdum*Tdum))       ! Asai (1965, J. Japan)
            2581     1                       tsq =Tdum*Tdum
            2582     1                       COND=DWV*tsq/(tsq+XLV2*WS)              ! Asai (1965, J. Japan)
            2583     1                       COND=MAX(COND, -WCdum)                  ! Limit cloud water evaporation
            2584     1                       Tdum=Tdum+XLV1*COND                     ! Updated temperature
            2585     1                       WVdum=WVdum-COND                        ! Updated water vapor mixing ratio
            2586     1                       WCdum=WCdum+COND                        ! Updated cloud water mixing ratio
            2587     1                       CONDENSE=CONDENSE+COND                  ! Total cloud water condensation
            2588     1                       ESW=min(PP, FPVSL(Tdum))                ! Updated saturation vapor press w/r/t water
            2589     1               !       WS=RHgrd*EPS*ESW/(PP-ESW)               ! Updated saturation mixing ratio w/r/t water
            2590     1                       WS=RHgrd*EPS*ESW/(PP+epsm1*ESW)         ! Updated saturation mixing ratio w/r/t water
            2591     1                       DWV=WVdum-WS                            ! Deficit grid-scale water vapor mixing ratio
            2592     1                       SSAT=DWV/WS                             ! Grid-scale supersaturation ratio
            2593     1                     ENDDO
            2594                     
            2595                           END FUNCTION CONDENSE
            2596                     !
            2597                     !#######################################################################
            2598                     !---------------- Calculate ice deposition at T<T_ICE ------------------
            2599                     !#######################################################################
            2600                     !
            2601                           REAL FUNCTION DEPOSIT (PP, RHgrd, Tdum, WVdum)
            2602                     !
            2603                           implicit none
            2604                     !
            2605                     !--- Also uses the Asai (1965) algorithm, but uses a different target
            2606                     !      vapor pressure for the adjustment
            2607                     !
            2608                           REAL PP, RHgrd, Tdum, WVdum
            2609                           INTEGER, PARAMETER :: HIGH_PRES=kind_phys
            2610                     !     INTEGER, PARAMETER :: HIGH_PRES=Selected_Real_Kind(15)
            2611                           REAL (KIND=HIGH_PRES), PARAMETER :: RHLIMIT=.001,                 &
            2612                          & RHLIMIT1=-RHLIMIT
            2613                           REAL, PARAMETER :: RCP=1./CP, RCPRV=RCP/RV, XLS=HVAP+HFUS         &
            2614                          &,                  XLS1=XLS*RCP, XLS2=XLS*XLS*RCPRV
            2615                           REAL (KIND=HIGH_PRES) :: DEP, SSAT
            2616                           real esi, ws, dwv
            2617                     !
            2618                     !-----------------------------------------------------------------------
            2619                     !
            2620                           ESI=min(PP, FPVSI(Tdum))                  ! Saturation vapor press w/r/t ice
            2621                     !     WS=RHgrd*EPS*ESI/(PP-ESI)                 ! Saturation mixing ratio
            2622                           WS=RHgrd*EPS*ESI/(PP+epsm1*ESI)           ! Saturation mixing ratio
            2623                           DWV=WVdum-WS                              ! Deficit grid-scale water vapor mixing ratio
            2624                           SSAT=DWV/WS                               ! Supersaturation ratio
            2625                           DEPOSIT=0.
            2626     1                     DO WHILE (SSAT.GT.RHLIMIT .OR. SSAT.LT.RHLIMIT1)
            2627     1                  !
            2628     1                  !--- Note that XLVS2=LS*LV/(CP*RV)=LV*WS/(RV*T*T)*(LS/CP*DEP1),
            2629     1                  !     where WS is the saturation mixing ratio following Clausius-
            2630     1                  !     Clapeyron (see Asai,1965; Young,1993,p.405)
            2631     1                  !
            2632     1                       DEP=DWV/(1.+XLS2*WS/(Tdum*Tdum))        ! Asai (1965, J. Japan)
            2633     1                       Tdum=Tdum+XLS1*DEP                      ! Updated temperature
            2634     1                       WVdum=WVdum-DEP                         ! Updated ice mixing ratio
            2635     1                       DEPOSIT=DEPOSIT+DEP                     ! Total ice deposition
            2636     1                       ESI=min(PP, FPVSI(Tdum))                ! Updated saturation vapor press w/r/t ice
            2637     1               !       WS=RHgrd*EPS*ESI/(PP-ESI)               ! Updated saturation mixing ratio w/r/t ice
            2638     1                       WS=RHgrd*EPS*ESI/(PP+epsm1*ESI)         ! Updated saturation mixing ratio w/r/t ice
            2639     1                       DWV=WVdum-WS                            ! Deficit grid-scale water vapor mixing ratio
            2640     1                       SSAT=DWV/WS                             ! Grid-scale supersaturation ratio
            2641     1                     ENDDO
            2642                           END FUNCTION DEPOSIT
            2643                     !
            2644                           END  SUBROUTINE GSMCOLUMN
            2645                     
            2646                     
            2647                           SUBROUTINE rsipath(im, ix, ix2, levs, prsl, prsi, t, q, clw       &
            2648                          &,                  f_ice, f_rain, f_rime, flgmin                  &
            2649                          &,                  cwatp, cicep, rainp, snowp                     &
            2650                          &,                  recwat, rerain, resnow, lprnt, ipr)
            2651                     !
            2652                           implicit none
            2653                     !
            2654                     !--------------------CLOUD----------------------------------------------
            2655                           integer im, ix, ix2, levs, ipr
            2656                           real    prsl(ix,levs), prsi(ix,levs+1), t(ix,levs), q(ix,levs)    &
            2657                          &,       clw(ix2,levs), f_ice(ix2,levs), f_rain(ix2,levs)          &
            2658                          &,       f_rime(ix2,levs)                                          &
            2659                          &,       cwatp(ix,levs), rainp(ix,levs),  cicep(ix,levs)           &
            2660                          &,       snowp(ix,levs), recwat(ix,levs), resnow(ix,levs)          &
            2661                          &,       rerain(ix,levs)
            2662                           real    flgmin
            2663                           real    frice, frrain, qcice, qcwat,  qrain, qsnow,   qtot, sden  &
            2664                          &,       cpath, rho,    dsnow, flarge, rimef, xsimass, nlice       &
            2665                          &,       tc,    recw1,  drain, xli,    dum,   NLImax, pfac, pp     &
            2666                          &,       snofac, tem
            2667                     !
            2668                           real, parameter :: cexp=1./3.
            2669                           integer i, l, indexs
            2670                           logical lprnt
            2671                     !
            2672                     
            2673                           RECW1 = 620.3505 / TNW**CEXP         ! cloud droplet effective radius
            2674                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2675,2689)
                                   <<< Loop-information  End >>>
            2675     1  pp                 do l=1,levs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2676,2690)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      recwat, t, rerain, resnow, clw, cwatp
                                   <<<      cicep, rainp, snowp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2676     2   p    s              do i=1,im
            2677     2                                                          !--- HYDROMETEOR'S OPTICAL PATH
            2678     2   p    v                 CWATP(I,L) = 0.
            2679     2   p    v                 CICEP(I,L) = 0.
            2680     2   p    v                 RAINP(I,L) = 0.
            2681     2   p    v                 SNOWP(I,L) = 0.
            2682     2                                                          !--- HYDROMETEOR'S EFFECTIVE RADIUS
            2683     2   p    v                 RECWAT(I,L) = RECWmin
            2684     2   p    v                 RERAIN(I,L) = RERAINmin
            2685     2   p    v                 RESNOW(I,L) = RESNOWmin
            2686     2   p    v              ENDDO
            2687     1   p                 ENDDO
            2688                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2689     1                     do l=1,levs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2690     2                       DO I=1,im
            2691     2               
            2692     2                  !        Assume parameterized condensate is
            2693     2                  !         all water for T>=-10C,
            2694     2                  !         all ice for T<=-30C,
            2695     2                  !         and a linear mixture at -10C > T > -30C
            2696     2                  !
            2697     2                  !    * Determine hydrometeor composition of total condensate (QTOT)
            2698     2                  !
            2699     2               !         pp   = prsl(i,l) * 1000.0
            2700     2   p                     pp   = prsl(i,l) / prsi(i,levs+1)
            2701     2               !         pfac = max(0.25, sqrt(sqrt(min(1.0, pp*0.000025))))
            2702     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.000025))))
            2703     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.00002))))
            2704     2               !         pfac = max(0.25, sqrt(sqrt(min(1.0, pp*0.00001))))
            2705     2               !         pfac = max(0.25, sqrt(sqrt(min(1.0, pp))))
            2706     2               !         pfac = max(0.1, sqrt(min(1.0, pp*0.00001)))
            2707     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.000033))))
            2708     2               !         pfac = max(0.5, sqrt(sqrt(min(1.0, pp*0.00004))))
            2709     2               !go       pfac = max(0.5, (sqrt(min(1.0, pp*0.000025))))
            2710     2   p                     pfac = 1.0
            2711     2   p                     TC   = T(I,L) - t0c
            2712     2   p                     QTOT = clw(I,L)
            2713     3   p                     IF (QTOT .GT. EPSQ) THEN
            2714     3   p                        QCWAT=0.
            2715     3   p                        QCICE=0.
            2716     3   p                        QRAIN=0.
            2717     3   p                        QSNOW=0.
            2718     3   p                        FRice  = max(0.0, min(1.0, F_ice(I,L)))
            2719     3   p                        FRrain = max(0.0, min(1.0, F_rain(I,L)))
            2720     4   p                        IF(TC.LE.Thom) then
            2721     4   p                           QCICE = QTOT
            2722     4   p                        ELSE
            2723     4   p                           QCICE = FRice  * QTOT
            2724     4   p                           QCWAT = QTOT   - QCICE
            2725     4   p                           QRAIN = FRrain * QCWAT
            2726     4   p                           QCWAT = QCWAT  - QRAIN
            2727     4   p                        ENDIF
            2728     3                   !
            2729     3                   !--- Air density (RHO), model mass thickness (CPATH)
            2730     3                   !
            2731     3   p                        RHO   = PRSL(I,L)/(RD*T(I,L)*(1.+EPS1*Q(I,L)))
            2732     3   p                        CPATH = (PRSI(I,L+1)-PRSI(I,L))*(1000000.0/grav)
            2733     3               
            2734     3                   !! CLOUD WATER
            2735     3                   !
            2736     3                   !--- Effective radius (RECWAT) & total water path (CWATP)
            2737     3                   !    Assume monodisperse distribution of droplets (no factor of 1.5)
            2738     3                   !
            2739     4   p                        IF(QCWAT .GT. 0.) THEN
            2740     4   p                           RECWAT(I,L) = MAX(RECWmin, RECW1*(RHO*QCWAT)**CEXP)
            2741     4   p                           CWATP(I,L)  = CPATH*QCWAT         ! cloud water path
            2742     4               !               tem         = 5.0*(1+max(0.0,min(1.0,-0.05*tc)))
            2743     4               !               RECWAT(I,L) = max(RECWAT(I,L), tem)
            2744     4   p                        ENDIF
            2745     3               
            2746     3                   !! RAIN
            2747     3                   !
            2748     3                   !--- Effective radius (RERAIN) & total water path (RAINP)
            2749     3                   !--- Factor of 1.5 accounts for r**3/r**2 moments for exponentially
            2750     3                   !    distributed drops in effective radius calculations
            2751     3                   !    (from M.D. Chou's code provided to Y.-T. Hou)
            2752     3                   !
            2753     4   p                        IF(QRAIN .GT. 0.) THEN
            2754     4   p                           DRAIN       = CN0r0*sqrt(sqrt((RHO*QRAIN)))
            2755     4   p                           RERAIN(I,L) = 1.5*MAX(XMRmin, MIN(DRAIN, XMRmax))
            2756     4   p                           RAINP(I,L)  = CPATH*QRAIN         ! rain water path
            2757     4   p                        ENDIF
            2758     3               
            2759     3                   !! SNOW (large ice) & CLOUD ICE
            2760     3                   !
            2761     3                   !--- Effective radius (RESNOW) & total ice path (SNOWP)
            2762     3                   !--- Total ice path (CICEP) for cloud ice
            2763     3                   !--- Factor of 1.5 accounts for r**3/r**2 moments for exponentially
            2764     3                   !    distributed ice particles in effective radius calculations
            2765     3                   !
            2766     3                   !--- Separation of cloud ice & "snow" uses algorithm from
            2767     3                   !    subroutine GSMCOLUMN
            2768     3                   !
            2769     4   p                        IF(QCICE .GT. 0.) THEN
            2770     4                   !
            2771     4                   !--- Mean particle size following Houze et al. (JAS, 1979, p. 160),
            2772     4                   !    converted from Fig. 5 plot of LAMDAs.  An analogous set of
            2773     4                   !    relationships also shown by Fig. 8 of Ryan (BAMS, 1996, p. 66),
            2774     4                   !    but with a variety of different relationships that parallel the
            2775     4                   !    Houze curves.
            2776     4                   !
            2777     4               !               DUM=MAX(0.05, MIN(1., EXP(.0536*TC)) )
            2778     4   p                           DUM=MAX(0.05, MIN(1., EXP(.0564*TC)) )
            2779     4   p                           INDEXS=MIN(MDImax, MAX(MDImin, INT(XMImax*DUM) ) )
            2780     4               !               indexs=max(INDEXSmin, indexs)
            2781     4               !               NLImax=5.E3/sqrt(DUM)        !- Ver3
            2782     4   p                           DUM=MAX(FLGmin*pfac, DUM)
            2783     4               !               DUM=MAX(FLGmin, DUM)
            2784     4               !               NLImax=20.E3            !- Ver3
            2785     4               !               NLImax=50.E3            !- Ver3 => comment this line out
            2786     4   p                           NLImax=10.E3/sqrt(DUM)        !- Ver3
            2787     4               !               NLImax=5.E3/sqrt(DUM)        !- Ver3
            2788     4               !               NLImax=6.E3/sqrt(DUM)        !- Ver3
            2789     4               !               NLImax=7.5E3/sqrt(DUM)       !- Ver3
            2790     4               !               NLImax=20.E3/DUM        !- Ver3
            2791     4               !               NLImax=20.E3/max(0.2,DUM)        !- Ver3
            2792     4               !               NLImax=2.0E3/max(0.1,DUM)        !- Ver3
            2793     4               !               NLImax=2.5E3/max(0.1,DUM)        !- Ver3
            2794     4               !               NLImax=10.E3/max(0.2,DUM)        !- Ver3
            2795     4               !               NLImax=4.E3/max(0.2,DUM)        !- Ver3
            2796     4               !Moorthi        DSNOW  = XMImax*EXP(.0536*TC)
            2797     4               !Moorthi        INDEXS = MAX(INDEXSmin, MIN(MDImax, INT(DSNOW)))
            2798     4                   !
            2799     4                   !--- Assumed number fraction of large ice to total (large & small)
            2800     4                   !    ice particles, which is based on a general impression of the
            2801     4                   !    literature.
            2802     4                   !
            2803     4                   !    Small ice are assumed to have a mean diameter of 50 microns.
            2804     4                   !
            2805     5   p                           IF(TC .GE. 0.) THEN
            2806     5   p                             FLARGE=FLG1P0
            2807     5   p                           ELSE
            2808     5   p                             FLARGE = dum
            2809     5   p                           ENDIF
            2810     4               !------------------------Commented by Moorthi -----------------------------
            2811     4               !               ELSEIF (TC .GE. -25.) THEN
            2812     4               !
            2813     4               !--- Note that absence of cloud water (QCWAT) is used as a quick
            2814     4               !    substitute for calculating water subsaturation as in GSMCOLUMN
            2815     4               !
            2816     4               !                  IF(QCWAT.LE.0. .OR. TC.LT.-8.
            2817     4               !    &                            .OR. TC.GT.-3.)THEN
            2818     4               !                     FLARGE=FLG0P2
            2819     4               !                  ELSE
            2820     4               
            2821     4               !--- Parameterize effects of rime splintering by increasing
            2822     4               !    number of small ice particles
            2823     4               !
            2824     4               !                     FLARGE=FLG0P1
            2825     4               !                  ENDIF
            2826     4               !               ELSEIF (TC .LE. -50.) THEN
            2827     4               !                  FLARGE=.01
            2828     4               !               ELSE
            2829     4               !                  FLARGE=.2*EXP(.1198*(TC+25))
            2830     4               !               ENDIF
            2831     4               !____________________________________________________________________________
            2832     4               
            2833     4   p                           RimeF=MAX(1., F_RIME(I,L))
            2834     4   p                           XSIMASS=MASSI(MDImin)*(1.-FLARGE)/FLARGE
            2835     4               !     if (lprnt) print *,' rimef=',rimef,' xsimass=',xsimass
            2836     4               !    &,' indexs=',indexs,' massi=',massi(indexs),' flarge=',flarge
            2837     4   p                           NLICE=RHO*QCICE/(XSIMASS+RimeF*MASSI(INDEXS))
            2838     4                   !
            2839     4                   !--- From subroutine GSMCOLUMN:
            2840     4                   !--- Minimum number concentration for large ice of NLImin=10/m**3
            2841     4                   !    at T>=0C.  Done in order to prevent unrealistically small
            2842     4                   !    melting rates and tiny amounts of snow from falling to
            2843     4                   !    unrealistically warm temperatures.
            2844     4                   !
            2845     5   p                           IF(TC .GE. 0.) THEN
            2846     5   p                              NLICE=MAX(NLImin, NLICE)
            2847     5   p                           ELSEIF (NLICE .GT. NLImax) THEN
            2848     5                     !
            2849     5                     !--- Ferrier 6/13/01:  Prevent excess accumulation of ice
            2850     5                     !
            2851     5   p                              XLI=(RHO*QCICE/NLImax-XSIMASS)/RimeF
            2852     5               
            2853     6   p                              IF(XLI .LE. MASSI(450) ) THEN
            2854     6   p                                 DSNOW=9.5885E5*XLI**.42066
            2855     6   p                              ELSE
            2856     6   p                                 DSNOW=3.9751E6*XLI**.49870
            2857     6   p                              ENDIF
            2858     5               
            2859     5   p                              INDEXS=MIN(MDImax, MAX(INDEXS, INT(DSNOW)))
            2860     5   p                              NLICE=RHO*QCICE/(XSIMASS+RimeF*MASSI(INDEXS))
            2861     5   p                           ENDIF
            2862     4               
            2863     4               !               if (tc .gt. -20.0 .and. indexs .ge. indexsmin) then
            2864     4               !                 snofac = max(0.0, min(1.0, exp(1.0*(tc+20.0))))
            2865     4               !               if (indexs .ge. indexsmin) then
            2866     4               !               if (tc .gt. -20.0 .or. indexs .ge. indexsmin) then
            2867     4               !               if (tc .gt. -40.0) then
            2868     4               !               if (tc .ge. -40.0 .or. prsl(i,l) .gt. 50.0) then
            2869     4               !!              if (tc .ge. -20.0) then
            2870     4               !               if (tc .ge. -20.0 .or. prsl(i,l) .gt. 50.0) then
            2871     4               !               if ((tc .ge. -20.0 .or.
            2872     4               !    &              prsi(i,levs+1)-prsi(i,l) .lt. 30.0)
            2873     5   p                           if (prsi(i,levs+1)-prsi(i,l) .lt. 40.0                  &
            2874     5               !               if (prsi(i,levs+1)-prsi(i,l) .lt. 70.0
            2875     5                    &              .and. indexs .ge. indexsmin) then
            2876     5               !    &              prsi(i,levs)-prsl(i,l) .lt. 20.0) then
            2877     5               !    &              prsi(i,levs)-prsl(i,l) .lt. 30.0) then
            2878     5               !    &              prsi(i,levs)-prsl(i,l) .lt. 40.0) then
            2879     5               !                 snofac = max(0.0, min(1.0, 0.05*(tc+40.0)))
            2880     5               !                 snofac = max(0.0, min(1.0, 0.1*(tc+25.0)))
            2881     5               !                 snofac = max(0.0, min(1.0, 0.0667*(tc+25.0)))
            2882     5               !               if (indexs .gt. indexsmin) then
            2883     5   p                             QSNOW     = MIN(QCICE, NLICE*RimeF*MASSI(INDEXS)/RHO)
            2884     5               !    &                      * snofac
            2885     5   p                           endif
            2886     4               !               qsnow       = qcice
            2887     4   p                           QCICE       = MAX(0., QCICE-QSNOW)
            2888     4               !               qsnow       = 0.0
            2889     4   p                           CICEP (I,L) = CPATH*QCICE          ! cloud ice path
            2890     4   p                           RESNOW(I,L) = 1.5*FLOAT(INDEXS)
            2891     4   p                           SDEN        = SDENS(INDEXS)/RimeF  ! 1/snow density
            2892     4   p                           SNOWP (I,L) = CPATH*QSNOW*SDEN     ! snow path / snow density
            2893     4               !               SNOWP (I,L) = CPATH*QSNOW          ! snow path / snow density
            2894     4               !               if (lprnt .and. i .eq. ipr) then
            2895     4               !                 print *,' L=',L,' snowp=',snowp(i,l),' cpath=',cpath
            2896     4               !    &,' qsnow=',qsnow,' sden=',sden,' rimef=',rimef,' indexs=',indexs
            2897     4               !    &,' sdens=',sdens(indexs),' resnow=',resnow(i,l)
            2898     4               !    &,' qcice=',qcice,' cicep=',cicep(i,l)
            2899     4               !               endif
            2900     4               
            2901     4               
            2902     4   p                        ENDIF                                 ! END QCICE BLOCK
            2903     3   p                      ENDIF                                   ! QTOT IF BLOCK
            2904     2               
            2905     2                       ENDDO
            2906     1                     ENDDO
            2907                     !
            2908                           END SUBROUTINE rsipath
            2909                     
            2910                     
            2911                     
            2912                     !-----------------------------------
            2913                           subroutine rsipath2                                               &
            2914                     !...................................
            2915                     
            2916                     !  ---  inputs:
            2917                          &     ( plyr, plvl, tlyr, qlyr, qcwat, qcice, qrain, rrime,        &
            2918                          &       IM, LEVS, iflip, flgmin,                                   &
            2919                     !  ---  outputs:
            2920                          &       cwatp, cicep, rainp, snowp, recwat, rerain, resnow, snden  &
            2921                          &     )
            2922                     
            2923                     ! =================   subprogram documentation block   ================ !
            2924                     !                                                                       !
            2925                     ! abstract:  this program is a modified version of ferrier's original   !
            2926                     !   "rsipath" subprogram.  it computes layer's cloud liquid, ice, rain, !
            2927                     !   and snow water condensate path and the partical effective radius    !
            2928                     !   for liquid droplet, rain drop, and snow flake.                      !
            2929                     !                                                                       !
            2930                     !  ====================  defination of variables  ====================  !
            2931                     !                                                                       !
            2932                     ! input variables:                                                      !
            2933                     !   plyr  (IM,LEVS) : model layer mean pressure in mb (100Pa)           !
            2934                     !   plvl  (IM,LEVS+1):model level pressure in mb (100Pa)                !
            2935                     !   tlyr  (IM,LEVS) : model layer mean temperature in k                 !
            2936                     !   qlyr  (IM,LEVS) : layer specific humidity in gm/gm                  !
            2937                     !   qcwat (IM,LEVS) : layer cloud liquid water condensate amount        !
            2938                     !   qcice (IM,LEVS) : layer cloud ice water condensate amount           !
            2939                     !   qrain (IM,LEVS) : layer rain drop water amount                      !
            2940                     !   rrime (IM,LEVS) : mass ratio of total to unrimed ice ( >= 1 )       !
            2941                     !   IM              : horizontal dimention                              !
            2942                     !   LEVS            : vertical layer dimensions                         !
            2943                     !   iflip           : control flag for in/out vertical indexing         !
            2944                     !                     =0: index from toa to surface                     !
            2945                     !                     =1: index from surface to toa                     !
            2946                     !   flgmin          : Minimum large ice fraction                        !
            2947                     !   lprnt           : logical check print control flag                  !
            2948                     !                                                                       !
            2949                     ! output variables:                                                     !
            2950                     !   cwatp (IM,LEVS) : layer cloud liquid water path                     !
            2951                     !   cicep (IM,LEVS) : layer cloud ice water path                        !
            2952                     !   rainp (IM,LEVS) : layer rain water path                             !
            2953                     !   snowp (IM,LEVS) : layer snow water path                             !
            2954                     !   recwat(IM,LEVS) : layer cloud eff radius for liqid water (micron)   !
            2955                     !   rerain(IM,LEVS) : layer rain water effective radius      (micron)   !
            2956                     !   resnow(IM,LEVS) : layer snow flake effective radius      (micron)   !
            2957                     !   snden (IM,LEVS) : 1/snow density                                    !
            2958                     !                                                                       !
            2959                     !                                                                       !
            2960                     ! usage:     call rsipath2                                              !
            2961                     !                                                                       !
            2962                     ! subroutines called:  none                                             !
            2963                     !                                                                       !
            2964                     ! program history log:                                                  !
            2965                     !      xx-xx-2001   b. ferrier     - original program                   !
            2966                     !      xx-xx-2004   s. moorthi     - modified for use in gfs model      !
            2967                     !      05-20-2004   y. hou         - modified, added vertical index flag!
            2968                     !                     to reduce data flipping, and rearrange code to    !
            2969                     !                     be comformable with radiation part programs.      !
            2970                     !                                                                       !
            2971                     !  ====================    end of description    =====================  !
            2972                     !
            2973                     
            2974                           implicit none
            2975                     
            2976                     !  ---  constant parameter:
            2977                           real, parameter :: CEXP= 1.0/3.0
            2978                     
            2979                     !  ---  inputs:
            2980                           real, dimension(:,:), intent(in) ::                               &
            2981                          &       plyr, plvl, tlyr, qlyr, qcwat, qcice, qrain, rrime
            2982                     
            2983                           integer, intent(in) :: IM, LEVS, iflip
            2984                           real, dimension(:),   intent(in) :: flgmin
            2985                     !     logical, intent(in) :: lprnt
            2986                     
            2987                     !  ---  output:
            2988                           real, dimension(:,:), intent(out) ::                              &
            2989                          &       cwatp, cicep, rainp, snowp, recwat, rerain, resnow, snden
            2990                     
            2991                     !  ---  locals:
            2992                     !     real,    dimension(IM,LEVS) :: delp, pp1, pp2
            2993                     
            2994                           real    :: recw1, dsnow, qsnow, qqcice, flarge, xsimass, pfac,    &
            2995                          &           nlice, xli, nlimax, dum, tem,                          &
            2996                          &           rho, cpath, rc, totcnd, tc
            2997                     
            2998                           integer :: i, k, indexs, ksfc, k1
            2999                     !
            3000                     !===>  ...  begin here
            3001                     !
            3002                           recw1 = 620.3505 / TNW**CEXP         ! cloud droplet effective radius
            3003                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3004     1  pp                 do k = 1, LEVS
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 8
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3005     2   p    v              do i = 1, IM
            3006     2                                                          !--- hydrometeor's optical path
            3007     2   p    v                 cwatp(i,k) = 0.0
            3008     2   p    v                 cicep(i,k) = 0.0
            3009     2   p    v                 rainp(i,k) = 0.0
            3010     2   p    v                 snowp(i,k) = 0.0
            3011     2   p    v                 snden(i,k) = 0.0
            3012     2                                                          !--- hydrometeor's effective radius
            3013     2   p    v                 recwat(i,k) = RECWmin
            3014     2   p    v                 rerain(i,k) = RERAINmin
            3015     2   p    v                 resnow(i,k) = RESNOWmin
            3016     2   p    v              enddo
            3017     1   p                 enddo
            3018                     
            3019                     !  ---  set up pressure related arrays, convert unit from mb to cb (10Pa)
            3020                     !       cause the rest part uses cb in computation
            3021                     
            3022     1                     if (iflip == 0) then        ! data from toa to sfc
            3023     1                       ksfc = levs + 1
            3024     1                       k1   = 0
            3025     1                     else                        ! data from sfc to top
            3026     1                       ksfc = 1
            3027     1                       k1   = 1
            3028     1                     endif                       ! end_if_iflip
            3029                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3030     1  pp                 do k = 1, LEVS
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 26
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3031     2   p    s              do i = 1, IM
            3032     2   p    v                totcnd = qcwat(i,k) + qcice(i,k) + qrain(i,k)
            3033     2   p    v                qsnow = 0.0
            3034     3   p    s                if(totcnd > EPSQ) then
            3035     3               
            3036     3               !  ---  air density (rho), model mass thickness (cpath), temperature in c (tc)
            3037     3               
            3038     3   p    s                  rho   = 0.1 * plyr(i,k)                                     &
            3039     3                    &            / (RD* tlyr(i,k) * (1.0 + EPS1*qlyr(i,k)))
            3040     3   p    s                  cpath = abs(plvl(i,k+1) - plvl(i,k)) * (100000.0 / GRAV)
            3041     3   p    s                  tc    = tlyr(i,k) - T0C
            3042     3               
            3043     3               !! cloud water
            3044     3               !
            3045     3               !  ---  effective radius (recwat) & total water path (cwatp):
            3046     3               !       assume monodisperse distribution of droplets (no factor of 1.5)
            3047     3               
            3048     4   p    s                  if (qcwat(i,k) > 0.0) then
            3049     4   p    s                    recwat(i,k) = max(RECWmin,recw1*(rho*qcwat(i,k))**CEXP)
            3050     4   p    s                    cwatp (i,k) = cpath * qcwat(i,k)           ! cloud water path
            3051     4               !             tem         = 5.0*(1.0 + max(0.0, min(1.0,-0.05*tc)))
            3052     4               !             recwat(i,k) = max(recwat(i,k), tem)
            3053     4   p    s                  endif
            3054     3               
            3055     3               !! rain
            3056     3               !
            3057     3               !  ---  effective radius (rerain) & total water path (rainp):
            3058     3               !       factor of 1.5 accounts for r**3/r**2 moments for exponentially
            3059     3               !       distributed drops in effective radius calculations
            3060     3               !       (from m.d. chou's code provided to y.-t. hou)
            3061     3               
            3062     4   p    s                  if (qrain(i,k) > 0.0) then
            3063     4   p    s                    tem         = CN0r0 * sqrt(sqrt(rho*qrain(i,k)))
            3064     4   p    s                    rerain(i,k) = 1.5 * max(XMRmin, min(XMRmax, tem))
            3065     4   p    s                    rainp (i,k) = cpath * qrain(i,k)           ! rain water path
            3066     4   p    s                  endif
            3067     3               
            3068     3               !! snow (large ice) & cloud ice
            3069     3               !
            3070     3               !  ---  effective radius (resnow) & total ice path (snowp) for snow, and
            3071     3               !       total ice path (cicep) for cloud ice:
            3072     3               !       factor of 1.5 accounts for r**3/r**2 moments for exponentially
            3073     3               !       distributed ice particles in effective radius calculations
            3074     3               !       separation of cloud ice & "snow" uses algorithm from subroutine gsmcolumn
            3075     3               
            3076     3               !           pfac = max(0.5, sqrt(sqrt(min(1.0, pp1(i,k)*0.00004))))
            3077     3               !go         pfac = max(0.5, (sqrt(min(1.0, pp1(i,k)*0.000025))))
            3078     3   p    s                  pfac = 1.0
            3079     3               
            3080     4   p    s                  if (qcice(i,k) > 0.0) then
            3081     4               
            3082     4               !  ---  mean particle size following houze et al. (jas, 1979, p. 160),
            3083     4               !       converted from fig. 5 plot of lamdas.  an analogous set of
            3084     4               !       relationships also shown by fig. 8 of ryan (bams, 1996, p. 66),
            3085     4               !       but with a variety of different relationships that parallel
            3086     4               !       the houze curves.
            3087     4               
            3088     4               !             dum = max(0.05, min(1.0, exp(0.0536*tc) ))
            3089     4   p    s                    dum = max(0.05, min(1.0, exp(0.0564*tc) ))
            3090     4   p    s                    indexs = min(MDImax, max(MDImin, int(XMImax*dum) ))
            3091     4   p    s                    DUM=MAX(FLGmin(i)*pfac, DUM)
            3092     4               
            3093     4               !  ---  assumed number fraction of large ice to total (large & small) ice
            3094     4               !       particles, which is based on a general impression of the literature.
            3095     4               !       small ice are assumed to have a mean diameter of 50 microns.
            3096     4               
            3097     5   p    s                    if (tc >= 0.0) then
            3098     5   p    s                      flarge = FLG1P0
            3099     5   p    s                    else
            3100     5   p    s                      flarge = dum
            3101     5               !               flarge = max(FLGmin*pfac, dum)
            3102     5   p    s                    endif
            3103     4               !------------------------commented by moorthi -----------------------------
            3104     4               !             elseif (tc >= -25.0) then
            3105     4               !
            3106     4               !  ---  note that absence of cloud water (qcwat) is used as a quick
            3107     4               !       substitute for calculating water subsaturation as in gsmcolumn
            3108     4               !
            3109     4               !               if (qcwat(i,k) <= 0.0 .or. tc < -8.0                 &
            3110     4               !    &                                .or. tc > -3.0) then
            3111     4               !                 flarge = FLG0P2
            3112     4               !               else
            3113     4               !
            3114     4               !  ---  parameterize effects of rime splintering by increasing
            3115     4               !       number of small ice particles
            3116     4               !
            3117     4               !                 flarge = FLG0P1
            3118     4               !               endif
            3119     4               !             elseif (tc <= -50.0) then
            3120     4               !               flarge = 0.01
            3121     4               !             else
            3122     4               !               flarge = 0.2 * exp(0.1198*(tc+25.0))
            3123     4               !             endif
            3124     4               !____________________________________________________________________________
            3125     4               
            3126     4   p    s                    xsimass = MASSI(MDImin) * (1.0 - flarge) / flarge
            3127     4               !             nlimax = 20.0e3                                      !- ver3
            3128     4               !             NLImax=50.E3                 !- Ver3 => comment this line out
            3129     4   p    s                    NLImax=10.E3/sqrt(DUM)       !- Ver3
            3130     4               !             NLImax=5.E3/sqrt(DUM)        !- Ver3
            3131     4               !             NLImax=6.E3/sqrt(DUM)        !- Ver3
            3132     4               !             NLImax=7.5E3/sqrt(DUM)       !- Ver3
            3133     4               
            3134     4               !             indexs = min(MDImax, max(MDImin, int(XMImax*dum) ))
            3135     4               !moorthi      dsnow  = XMImax * exp(0.0536*tc)
            3136     4               !moorthi      indexs = max(INDEXSmin, min(MDImax, int(dsnow)))
            3137     4               
            3138     4               !             if (lprnt) print *,' rrime=',rrime,' xsimass=',xsimass,   &
            3139     4               !    &       ' indexs=',indexs,' massi=',massi(indexs),' flarge=',flarge
            3140     4               
            3141     4   p    s                    tem = rho * qcice(i,k)
            3142     4   p    s                    nlice = tem / (xsimass +rrime(i,k)*MASSI(indexs))
            3143     4               
            3144     4               !  ---  from subroutine gsmcolumn:
            3145     4               !       minimum number concentration for large ice of NLImin=10/m**3
            3146     4               !       at t>=0c.  done in order to prevent unrealistically small
            3147     4               !       melting rates and tiny amounts of snow from falling to
            3148     4               !       unrealistically warm temperatures.
            3149     4               
            3150     5   p    s                    if (tc >= 0.0) then
            3151     5               
            3152     5   p    s                      nlice = max(NLImin, nlice)
            3153     5               
            3154     5   p    s                    elseif (nlice > nlimax) then
            3155     5               
            3156     5               !  ---  ferrier 6/13/01:  prevent excess accumulation of ice
            3157     5               
            3158     5   p    s                      xli = (tem/nlimax - xsimass) / rrime(i,k)
            3159     5               
            3160     6   p    s                      if (xli <= MASSI(450) ) then
            3161     6   p    s                        dsnow = 9.5885e5 * xli**0.42066
            3162     6   p    s                      else
            3163     6   p    s                        dsnow = 3.9751e6 * xli** 0.49870
            3164     6   p    s                      endif
            3165     5               
            3166     5   p    s                      indexs = min(MDImax, max(indexs, int(dsnow)))
            3167     5   p    s                      nlice = tem / (xsimass + rrime(i,k)*MASSI(indexs))
            3168     5               
            3169     5   p    s                    endif                               ! end if_tc block
            3170     4               
            3171     4               !             if (abs(plvl(i,ksfc)-plvl(i,k+k1)) < 300.0                &
            3172     4               !             if (abs(plvl(i,ksfc)-plvl(i,k+k1)) < 400.0                &
            3173     4               !             if (plvl(i,k+k1) > 600.0                                  &
            3174     4               !    &                            .and. indexs >= INDEXSmin) then
            3175     4               !             if (tc > -20.0 .and. indexs >= indexsmin) then
            3176     5   p    s                    if (plvl(i,ksfc) > 850.0 .and.                            &
            3177     5               !    &            plvl(i,k+k1) > 600.0 .and. indexs >= indexsmin) then
            3178     5                    &            plvl(i,k+k1) > 700.0 .and. indexs >= indexsmin) then ! 20060516
            3179     5               !!            if (plvl(i,ksfc) > 800.0 .and.                            &
            3180     5               !!   &            plvl(i,k+k1) > 700.0 .and. indexs >= indexsmin) then
            3181     5               !             if (plvl(i,ksfc) > 700.0 .and.                            &
            3182     5               !    &            plvl(i,k+k1) > 600.0 .and. indexs >= indexsmin) then
            3183     5   p    s                      qsnow = min( qcice(i,k),                                &
            3184     5                    &                       nlice*rrime(i,k)*MASSI(indexs)/rho )
            3185     5   p    s                    endif
            3186     4               
            3187     4   p    s                    qqcice      = max(0.0, qcice(i,k)-qsnow)
            3188     4   p    s                    cicep (i,k) = cpath * qqcice          ! cloud ice path
            3189     4   p    s                    resnow(i,k) = 1.5 * float(indexs)
            3190     4   p    s                    snden (i,k) = SDENS(indexs) / rrime(i,k)   ! 1/snow density
            3191     4   p    s                    snowp (i,k) = cpath*qsnow             ! snow path
            3192     4               !             snowp (i,k) = cpath*qsnow*snden(i,k)  ! snow path / snow density
            3193     4               
            3194     4               !             if (lprnt .and. i .eq. ipr) then
            3195     4               !             if (i .eq. 2) then
            3196     4               !               print *,' L=',k,' snowp=',snowp(i,k),' cpath=',cpath,   &
            3197     4               !    &         ' qsnow=',qsnow,' sden=',snden(i,k),' rrime=',rrime(i,k),&
            3198     4               !    &         ' indexs=',indexs,' sdens=',sdens(indexs),' resnow=',    &
            3199     4               !    &           resnow(i,k),' qcice=',qqcice,' cicep=',cicep(i,k)
            3200     4               !           endif
            3201     4               
            3202     4   p    s                  endif                                 ! end if_qcice block
            3203     3   p    v                endif                                   ! end if_totcnd block
            3204     2               
            3205     2   p    v              enddo
            3206     1   p                 enddo
            3207                     !
            3208                     !...................................
            3209                           end subroutine rsipath2

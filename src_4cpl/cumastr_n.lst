             203     1  pp    v            do jk = klev , 3 , -1
             204     1   p    v              if ( pmean(jk)/pmean(klev)*1.013250e5 >  950.e2 ) p950 = jk
             205     1   p                   if ( pmean(jk)/pmean(klev)*1.013250e5 >  650.e2 ) p650 = jk

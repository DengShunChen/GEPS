             152                          &         ktype(klon),            lndj(klon)
             153                           logical  ldcum(klon)
             154                           logical  loddraf(klon),          llo1,   llo2(klon)
             155                           integer  p950,p650
             156                     
             157                     
             158                     !  local varaiables
             159                           real     zcons,zcons2,zqumqe,zdqmin,zdh,zmfmax,xlat
             160                           real     zalfaw,zalv,zqalv,zc5ldcp,zc4les,zhsat,zgam,zzz,zhhat
             161                           real     zpbmpt,zro,zdz,zdp,zeps,zfac,wspeed
             162                           integer  jl,jk,ik
             163                           integer  ikb,ikt,icum,itopm2,jim
             164                           real     ztmst,ztau,zerate,zderate,zmfa
             165                           real     zmfs(klon),pmean(klev),zlon,pi,rad,torad,dlon,dlat
             166                           real     apha,capa,klvl
             167                           real     zduten,zdvten,ztdis,pgf_u,pgf_v
             168                           real     zoentr1(klon,klev),tmp2(klon,klev),tmp3(klon,klev) &
             169                          &        ,tmp4(klon,klev),tmp5(klon,klev)
             170                     !xb110>
             171                           real     mdlon,gdx,re,rr
             172                           integer  kcnv(klon)
             173                           real     sumpap(klon)
             174                           logical  adj
             175                     !for lightning parameterization
             176                           real     pluu(klon,klev),pf(klon,klev),rho(klon,klev),papn(klon,klev)
             177                           real     flash(klon),dx(klon)
             178                     !xb110<
             179                     !-------------------------------------------
             180                     !     1.    specify constants and parameters
             181                     !-------------------------------------------
             182                     !xb110>
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

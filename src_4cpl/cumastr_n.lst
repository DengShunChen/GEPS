             142                           real     upbl(klon)
             143                           real     xmin,xmax
             144                           real     pmfude_rate(klon,klev), pmfdde_rate(klon,klev)
             145                           real     zmfuus(klon,klev),      zmfdus(klon,klev)
             146                           real     zuv2(klon,klev),ztenu(klon,klev),ztenv(klon,klev)
             147                           real     zmfuvb(klon),zsum12(klon),zsum22(klon)
             148                           integer  ilab(klon,klev),        idtop(klon),&

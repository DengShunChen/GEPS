             128                          &         zud(klon,klev),         zvd(klon,klev),&
             129                          &         zlglac(klon,klev),                     &
             130                                    zxenh(klon,klev)
             131                           real     pmflxr(klon,klevp1),    pmflxs(klon,klevp1)
             132                           real     zhcbase(klon),&
             133                          &         zmfub(klon),            zmfub1(klon),&
             134                          &         zdhpbl(klon)
             135                           real     zsfl(klon),             zdpmel(klon,klev),&
             136                          &         pcte(klon,klev),        zcape(klon),&
             137                          &         zcape1(klon),           zcape2(klon),&
             138                          &         ztauc(klon),            ztaubl(klon),&
             139                          &         zheat(klon)
             140                           real     wup(klon),              zdqcv(klon)

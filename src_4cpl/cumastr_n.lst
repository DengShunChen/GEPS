               1                     !***********************************************************
               2                     !           subroutine cumastrn
               3                     !***********************************************************
               4                     SUBROUTINE cumastr_n  &
               5                          &      (nxj   ,klon ,klev ,klevp1,klevm1 ,&
               6                          &       pten  ,pqen ,pxen ,puen  ,pven   ,&
               7                          &       ldland,pverv,pqsen,pqhfl ,pap    ,&
               8                          &       paph  ,pgeo ,ptte ,pqte  ,pxtec  ,&
               9                          &       pvom  ,pvol ,prsfc,pssfc ,kcbot  ,&
              10                          &       kctop ,ztmst,jin  ,ptu   ,pqu    ,&
              11                          &       pmfu  ,pmfd ,prain,pcte  ,phhfl  ,&
              12                          &       lndj  ,ldcum,dx   ,kcnv   ,&
              13                          &       flash)
              14                     !
              15                     !***cumastrn*  master routine for cumulus massflux-scheme
              16                     !     m.tiedtke      e.c.m.w.f.      1986/1987/1989
              17                     !     modifications
              18                     !     y.wang         i.p.r.c         2001
              19                     !     c.zhang                        2012
              20                     !***purpose
              21                     !   -------
              22                     !          this routine computes the physical tendencies of the
              23                     !     prognostic variables t,q,u and v due to convective processes.
              24                     !     processes considered are: convective fluxes, formation of
              25                     !     precipitation, evaporation of falling rain below cloud base,
              26                     !     saturated cumulus downdrafts.
              27                     !***method
              28                     !   ------
              29                     !     parameterization is done using a massflux-scheme.
              30                     !        (1) define constants and parameters
              31                     !        (2) specify values (t,q,qs...) at half levels and
              32                     !            initialize updraft- and downdraft-values in 'cuinin'
              33                     !        (3) calculate cloud base in 'cutypen', calculate cloud types in cutypen,
              34                     !            and specify cloud base massflux
              35                     !        (4) do cloud ascent in 'cuascn' in absence of downdrafts
              36                     !        (5) do downdraft calculations:
              37                     !              (a) determine values at lfs in 'cudlfsn'
              38                     !              (b) determine moist descent in 'cuddrafn'
              39                     !              (c) recalculate cloud base massflux considering the
              40                     !                  effect of cu-downdrafts
              41                     !        (6) do final adjusments to convective fluxes in 'cuflxn',
              42                     !            do evaporation in subcloud layer
              43                     !        (7) calculate increments of t and q in 'cudtdqn'
              44                     !        (8) calculate increments of u and v in 'cududvn'
              45                     !***externals.
              46                     !   ----------
              47                     !       cuinin:  initializes values at vertical grid used in cu-parametr.
              48                     !       cutypen: cloud bypes, 1: deep cumulus 2: shallow cumulus
              49                     !       cuascn:  cloud ascent for entraining plume
              50                     !       cudlfsn: determines values at lfs for downdrafts
              51                     !       cuddrafn:does moist descent for cumulus downdrafts
              52                     !       cuflxn:  final adjustments to convective fluxes (also in pbl)
              53                     !       cudqdtn: updates tendencies for t and q
              54                     !       cududvn: updates tendencies for u and v
              55                     !***switches.
              56                     !   --------
              57                     !          lmfmid=.t.   midlevel convection is switched on
              58                     !          lmfdd=.t.    cumulus downdrafts switched on
              59                     !          lmfdudv=.t.  cumulus friction switched on
              60                     !***
              61                     !     model parameters (defined in subroutine cuparam)
              62                     !     ------------------------------------------------
              63                     !     entrdd     entrainment rate for cumulus downdrafts
              64                     !     cmfcmax    maximum massflux value allowed for
              65                     !     cmfcmin    minimum massflux value (for safety)
              66                     !     cmfdeps    fractional massflux for downdrafts at lfs
              67                     !     cprcon     coefficient for conversion from cloud water to rain
              68                     !***reference.
              69                     !   ----------
              70                     !         1. paper on massflux scheme (Tiedtke,1989)
              71                     !         2. Bechtold,P.et.al.(2014):Representing equilibrium and
              72                     !            nonequilibrium convection in large-scale models.
              73                     !         3. ECMWF,23-25 May 2016 NWP Training Course: Parametrization
              74                     !            of subgrid physical processes.
              75                     !            link:
              76                     !     https://software.ecmwf.int/wiki/display/OPTR/NWP+Training+Material+2016
              77                     !-----------------------------------------------------------------
              78                     USE mo_constants,     only: rd,      &! gas constant for dry air
              79                                                   c4les,   &!
              80                                                   c5les,   &!
              81                                                   cpd,     &! specific heat at constant pressure
              82                                                   g,       &! gravity acceleration
              83                                                   vtmpc1,  &! vtmpc1=rv/rd-1
              84                                                   alv,     &! latent heat for vaporisation
              85                                                   zrg,     &! 1.0/g
              86                                                   rcpd
              87                     USE mo_cumulus_flux,  only: lmfdudv, &! true if cum. friction is switched on
              88                                                   cmfdeps, &! fractional massflux for downdr. at lfs
              89                                                   lmfdd,   &! true if cum. downdraft is switched on
              90                                                   entrpen, &! entrainment rate for penetrative conv.
              91                                                   entrscv, &! entrainment rate for shallow conv.
              92                                                   zdnoprc, &
              93                                                   momtrans,&
              94                                                   lmfpen,  &
              95                                                   cmfcmin, &
              96                                                   lmfpen,  &

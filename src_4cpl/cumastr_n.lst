             214                                pverv,    pgeo,     paph,     zgeoh,    ztenh, &
             215                                zqenh,    zqsenh,   zxenh,    ilwmin,   ptu,      pqu,   &
             216                                ztd,      zqd,      zuu,      zvu,      zud,   &
             217                                zvd,      pmfu,     pmfd,     zmfus,    zmfds, &
             218                                zmfuq,    zmfdq,    zdmfup,   zdmfdp,   zdpmel,&
             219                                plu,      plude,    ilab,     jin)
             220                     !----------------------------------
             221                     !*    3.0   cloud base calculations
             222                     !----------------------------------
             223                     !*         (a) determine cloud base values in 'cutypen',
             224                     !              and the cumulus type 1 or 2
             225                     !          -------------------------------------------

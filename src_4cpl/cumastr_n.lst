             246     3   p    v                  zdhpbl(jl)=zdhpbl(jl)+(alv*pqte(jl,jk)+cpd*ptte(jl,jk))&
             247     3                    &                 *(paph(jl,jk+1)-paph(jl,jk))
             248     3   p    v                  wspeed = sqrt(puen(jl,jk)**2 + pven(jl,jk)**2)
             249     3   p    v                  upbl(jl) = upbl(jl) + wspeed*(paph(jl,jk+1)-paph(jl,jk))

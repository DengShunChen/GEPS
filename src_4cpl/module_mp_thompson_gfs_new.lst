            2779     2                        rvs = rho(k)*qvsi(k)
            2780     2                        rvs_p = rvs*otemp*(lsub*otemp*oRv - 1.)
            2781     2                        rvs_pp = rvs * ( otemp*(lsub*otemp*oRv - 1.) &
            2782     2                                        *otemp*(lsub*otemp*oRv - 1.) &
            2783     2                                        + (-2.*lsub*otemp*otemp*otemp*oRv) &
            2784     2                                        + otemp*otemp)
            2785     2                        gamsc = lsub*diffu(k)/tcond(k) * rvs_p
            2786     2                        alphsc = 0.5*(gamsc/(1.+gamsc))*(gamsc/(1.+gamsc)) &
            2787     2                                   * rvs_pp/rvs_p * rvs/rvs_p
            2788     2                        alphsc = MAX(1.E-9, alphsc)

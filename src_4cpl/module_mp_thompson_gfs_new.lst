            2264     1   p    v               nwfa(k) = MAX(11.1E6*rho(k), MIN(9999.E6*rho(k), nwfa1d(k)*rho(k)))
            2265     1   p    v               nifa(k) = MAX(naIN1*0.01*rho(k), MIN(9999.E6*rho(k), nifa1d(k)*rho(k)))
            2266     1   p    v               mvd_r(k) = D0r
            2267     1   p    v               mvd_c(k) = D0c
            2268     1               
            2269     2   p    v               if (qc1d(k) .gt. R1) then
            2270     2   p    s                  no_micro = .false.
            2271     2   p    s                  rc(k) = qc1d(k)*rho(k)
            2272     2   p    s                  nc(k) = MAX(2., MIN(nc1d(k)*rho(k), Nt_c_max))
            2273     2   p    s                  L_qc(k) = .true.
            2274     3   p    m                  if (nc(k).gt.10000.E6) then
            2275     3   p    m                   nu_c = 2
            2276     3   p    s                  elseif (nc(k).lt.100.) then
            2277     3   p    m                   nu_c = 15
            2278     3   p                       else
            2279     3   p    m                   nu_c = NINT(1000.E6/nc(k)) + 2
            2280     3   p    m                   nu_c = MAX(2, MIN(nu_c+NINT(rand2), 15))
            2281     3   p                       endif
            2282     2   p    s                  lamc = (nc(k)*am_r*ccg(2,nu_c)*ocg1(nu_c)/rc(k))**obmr
            2283     2   p    s                  xDc = (bm_r + nu_c + 1.) / lamc
            2284     3   p    m                  if (xDc.lt. D0c) then
            2285     3   p    m                   lamc = cce(2,nu_c)/D0c
            2286     3   p                       elseif (xDc.gt. D0r*2.) then
            2287     3   p    m                   lamc = cce(2,nu_c)/(D0r*2.)
            2288     3   p                       endif
            2289     2   p    s                  nc(k) = MIN( DBLE(Nt_c_max), ccg(1,nu_c)*ocg2(nu_c)*rc(k)   &
            2290     2                                 / am_r*lamc**bm_r)
            2291     3   p    s                  if (.NOT. (is_aerosol_aware .or. merra2_aerosol_aware)) then
            2292     4   p    m                     if (lsml == 1) then
            2293     4   p    m                       nc(k) = Nt_c_l
            2294     4   p                          else
            2295     4   p    m                       nc(k) = Nt_c_o
            2296     4   p                          endif
            2297     3   p                       endif
            2298     2   p                    else
            2299     2   p    s                  qc1d(k) = 0.0
            2300     2   p    v                  nc1d(k) = 0.0
            2301     2   p    v                  rc(k) = R1
            2302     2   p    v                  nc(k) = 2.
            2303     2   p    v                  L_qc(k) = .false.
            2304     2   p    m               endif
            2305     1               
            2306     2   p    v               if (qi1d(k) .gt. R1) then
            2307     2   p    s                  no_micro = .false.
            2308     2   p    s                  ri(k) = qi1d(k)*rho(k)
            2309     2   p    s                  ni(k) = MAX(R2, ni1d(k)*rho(k))
            2310     3   p    m                  if (ni(k).le. R2) then
            2311     3   p    s                     lami = cie(2)/5.E-6
            2312     3   p    m                     ni(k) = MIN(4999.D3, cig(1)*oig2*ri(k)/am_i*lami**bm_i)
            2313     3   p                       endif
            2314     2   p    s                  L_qi(k) = .true.
            2315     2   p    s                  lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            2316     2   p    s                  ilami = 1./lami
            2317     2   p    s                  xDi = (bm_i + mu_i + 1.) * ilami
            2318     3   p    m                  if (xDi.lt. 5.E-6) then
            2319     3   p    s                   lami = cie(2)/5.E-6
            2320     3   p    m                   ni(k) = MIN(4999.D3, cig(1)*oig2*ri(k)/am_i*lami**bm_i)
            2321     3   p                       elseif (xDi.gt. 300.E-6) then
            2322     3   p    m                   lami = cie(2)/300.E-6
            2323     3   p    m                   ni(k) = cig(1)*oig2*ri(k)/am_i*lami**bm_i
            2324     3   p                       endif
            2325     2   p                    else
            2326     2   p    s                  qi1d(k) = 0.0
            2327     2   p    v                  ni1d(k) = 0.0
            2328     2   p    v                  ri(k) = R1
            2329     2   p    v                  ni(k) = R2
            2330     2   p    v                  L_qi(k) = .false.
            2331     2   p    m               endif
            2332     1               

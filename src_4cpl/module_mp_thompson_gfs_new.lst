            3875     2   s    s            do k = kte, kts, -1
            3876     2   p    v               vtr = 0.
            3877     2   p    v               rhof(k) = SQRT(RHO_NOT/rho(k))
            3878     2               
            3879     3   p    v               if (rr(k).gt. R1) then
            3880     3   p    v                lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            3881     3   p    v                vtr = rhof(k)*av_r*crg(6)*org3 * lamr**cre(3)                 &

            2480     2                              + sa(8)*tc0 + sa(9)*tc0*tc0*tc0 &
            2481     2                              + sa(10)
            2482     2   p    v               a_ = 10.0**loga_
            2483     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3) + sb(4)*tc0 &
            2484     2                             + sb(5)*tc0*tc0 + sb(6) &

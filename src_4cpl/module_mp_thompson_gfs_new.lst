            3592     2   p    v               a_ = 10.0**loga_
            3593     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(14) + sb(4)*tc0*cse(14) &
            3594     2                             + sb(5)*tc0*tc0 + sb(6)*cse(14)*cse(14) &
            3595     2                             + sb(7)*tc0*tc0*cse(14) + sb(8)*tc0*cse(14)*cse(14) &
            3596     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(14)*cse(14)*cse(14)
            3597     2   p    v               smod(k) = a_ * smo2(k)**b_
            3598     2   p    v            enddo

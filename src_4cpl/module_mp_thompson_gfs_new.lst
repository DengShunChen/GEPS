            3080     5                           prs_iau(k) = MIN(DBLE(ri(k)*.99*odts), prs_iau(k))
            3081     5                           pni_iau(k) = tni_iaus(idx_i,idx_i1)*odts
            3082     5                           pni_iau(k) = MIN(DBLE(ni(k)*.95*odts), pni_iau(k))
            3083     5                          endif
            3084     4                         endif
            3085     3               
            3086     3               !>  - Snow collecting cloud ice.  In CE, assume Di<<Ds and vti=~0.
            3087     4                         if (L_qi(k)) then
            3088     4                          lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            3089     4                          ilami = 1./lami
            3090     4                          xDi = MAX(DBLE(D0i), (bm_i + mu_i + 1.) * ilami)
            3091     4                          xmi = am_i*xDi**bm_i
            3092     4                          oxmi = 1./xmi
            3093     5                          if (rs(k).ge. r_s(1)) then
            3094     5                           prs_sci(k) = t1_qs_qi*rhof(k)*Ef_si*ri(k)*smoe(k)
            3095     5                           pni_sci(k) = prs_sci(k) * oxmi
            3096     5                          endif
            3097     4               
            3098     4               !>  - Rain collecting cloud ice.  In CE, assume Di<<Dr and vti=~0.
            3099     5                          if (rr(k).ge. r_r(1) .and. mvd_r(k).gt. 4.*xDi) then
            3100     5                           lamr = 1./ilamr(k)
            3101     5                           pri_rci(k) = rhof(k)*t1_qr_qi*Ef_ri*ri(k)*N0_r(k) &
            3102     5                                          *((lamr+fv_r)**(-cre(9)))
            3103     5                           pnr_rci(k) = rhof(k)*t1_qr_qi*Ef_ri*ni(k)*N0_r(k)           &   ! RAIN2M
            3104     5                                          *((lamr+fv_r)**(-cre(9)))
            3105     5                           pni_rci(k) = pri_rci(k) * oxmi
            3106     5                           prr_rci(k) = rhof(k)*t2_qr_qi*Ef_ri*ni(k)*N0_r(k) &
            3107     5                                          *((lamr+fv_r)**(-cre(8)))
            3108     5                           prr_rci(k) = MIN(DBLE(rr(k)*odts), prr_rci(k))
            3109     5                           prg_rci(k) = pri_rci(k) + prr_rci(k)
            3110     5                          endif
            3111     4                         endif
            3112     3               
            3113     3               !>  - Ice multiplication from rime-splinters (Hallet & Mossop 1974).
            3114     4                         if (prg_gcw(k).gt. eps .and. tempc.gt.-8.0) then
            3115     4                          tf = 0.
            3116     5                          if (tempc.ge.-5.0 .and. tempc.lt.-3.0) then
            3117     5                           tf = 0.5*(-3.0 - tempc)
            3118     5                          elseif (tempc.gt.-8.0 .and. tempc.lt.-5.0) then
            3119     5                           tf = 0.33333333*(8.0 + tempc)
            3120     5                          endif
            3121     4                          pni_ihm(k) = 3.5E8*tf*prg_gcw(k)
            3122     4                          pri_ihm(k) = xm0i*pni_ihm(k)
            3123     4                          prs_ihm(k) = prs_scw(k)/(prs_scw(k)+prg_gcw(k)) &
            3124     4                                         * pri_ihm(k)
            3125     4                          prg_ihm(k) = prg_gcw(k)/(prs_scw(k)+prg_gcw(k)) &
            3126     4                                         * pri_ihm(k)
            3127     4                         endif
            3128     3               
            3129     3                        else
            3130     3               
            3131     3               !>  - Melt snow and graupel and enhance from collisions with liquid.
            3132     3               !! We also need to sublimate snow and graupel if subsaturated.
            3133     4                         if (L_qs(k)) then
            3134     4                          prr_sml(k) = (tempc*tcond(k)-lvap0*diffu(k)*delQvs(k))       &
            3135     4                                     * (t1_qs_me*smo1(k) + t2_qs_me*rhof2(k)*vsc2(k)*smof(k))
            3136     5                          if (prr_sml(k) .gt. 0.) then
            3137     5                             prr_sml(k) = prr_sml(k) + 4218.*olfus*tempc               &
            3138     5                                                     * (prr_rcs(k)+prs_scw(k))
            3139     5                          endif
            3140     4                          prr_sml(k) = MIN(DBLE(rs(k)*odts), MAX(0.D0, prr_sml(k)))
            3141     4                          pnr_sml(k) = smo0(k)/rs(k)*prr_sml(k) * 10.0**(-0.25*tempc)      ! RAIN2M
            3142     4                          pnr_sml(k) = MIN(DBLE(smo0(k)*odts), pnr_sml(k))
            3143     4               
            3144     5                          if (ssati(k).lt. 0.) then
            3145     5                           prs_sde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            3146     5                                        * (t1_qs_sd*smo1(k) &
            3147     5                                         + t2_qs_sd*rhof2(k)*vsc2(k)*smof(k))
            3148     5                           prs_sde(k) = MAX(DBLE(-rs(k)*odts), prs_sde(k))
            3149     5                          endif
            3150     4                         endif
            3151     3               
            3152     4                         if (L_qg(k)) then
            3153     4                          prr_gml(k) = (tempc*tcond(k)-lvap0*diffu(k)*delQvs(k))       &
            3154     4                                     * N0_g(k)*(t1_qg_me*ilamg(k)**cge(10)             &
            3155     4                                     + t2_qg_me*rhof2(k)*vsc2(k)*ilamg(k)**cge(11))
            3156     4               !-GT       prr_gml(k) = prr_gml(k) + 4218.*olfus*tempc &
            3157     4               !-GT                               * (prr_rcg(k)+prg_gcw(k))
            3158     4                          prr_gml(k) = MIN(DBLE(rg(k)*odts), MAX(0.D0, prr_gml(k)))
            3159     4                          pnr_gml(k) = N0_g(k)*cgg(2)*ilamg(k)**cge(2) / rg(k)         &   ! RAIN2M
            3160     4                                     * prr_gml(k) * 10.0**(-0.5*tempc)
            3161     4               
            3162     5                          if (ssati(k).lt. 0.) then
            3163     5                           prg_gde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            3164     5                               * N0_g(k) * (t1_qg_sd*ilamg(k)**cge(10) &
            3165     5                               + t2_qg_sd*vsc2(k)*rhof2(k)*ilamg(k)**cge(11))
            3166     5                           prg_gde(k) = MAX(DBLE(-rg(k)*odts), prg_gde(k))
            3167     5                          endif
            3168     4                         endif
            3169     3               
            3170     3               !> - This change will be required if users run adaptive time step that
            3171     3               !! results in delta-t that is generally too long to allow cloud water
            3172     3               !! collection by snow/graupel above melting temperature.
            3173     3               !! Credit to Bjorn-Egil Nygaard for discovering.
            3174     4                         if (dt .gt. 120.) then
            3175     4                            prr_rcw(k)=prr_rcw(k)+prs_scw(k)+prg_gcw(k)
            3176     4                            prs_scw(k)=0.
            3177     4                            prg_gcw(k)=0.
            3178     4                         endif
            3179     3               
            3180     3                        endif
            3181     2               
            3182     2                     enddo
            3183     1                     endif
            3184                     
            3185                     !+---+-----------------------------------------------------------------+
            3186                     !> - Ensure we do not deplete more hydrometeor species than exists.
            3187                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pri_ide, pri_inu, prs_sde, prg_gde
                                   <<<      prr_wau, prr_rcw, prs_scw, prs_ide
                                   <<<      prg_scw, qv, pri_iha, qvsi, rho, pri_wfz
                                   <<<      pni_ide, rc
                                   <<<    PREFETCH(SOFT) : 52
                                   <<<     SEQUENTIAL : 52
                                   <<<      rr: 2, L_qc: 2, prg_gcw: 2, ri: 2
                                   <<<      prs_iau: 2, prs_sci: 2, pri_rci: 2
                                   <<<      L_qi: 2, prr_rcg: 2, prg_rfz: 2
                                   <<<      pri_rfz: 2, prr_rci: 2, prr_rcs: 2
                                   <<<      L_qr: 2, prs_rcs: 2, rs: 2, prr_sml: 2
                                   <<<      prs_ihm: 2, L_qs: 2, temp: 2, prg_ihm: 2
                                   <<<      prg_rcg: 2, prr_gml: 2, rg: 2, L_qg: 2
                                   <<<      pri_ihm: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 21
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3188     1  pp    v            do k = kts, kte
            3189     1               
            3190     1               !>  - If ice supersaturated, ensure sum of depos growth terms does not
            3191     1               !! deplete more vapor than possibly exists.  If subsaturated, limit
            3192     1               !! sum of sublimation terms such that vapor does not reproduce ice
            3193     1               !! supersat again.
            3194     1   p    v               sump = pri_inu(k) + pri_ide(k) + prs_ide(k) &
            3195     1                             + prs_sde(k) + prg_gde(k) + pri_iha(k)
            3196     1   p    v               rate_max = (qv(k)-qvsi(k))*rho(k)*odts*0.999
            3197     2   p    v               if ( (sump.gt. eps .and. sump.gt. rate_max) .or. &
            3198     2                             (sump.lt. -eps .and. sump.lt. rate_max) ) then
            3199     2   p    v                ratio = rate_max/sump
            3200     2   p    v                pri_inu(k) = pri_inu(k) * ratio
            3201     2   p    v                pri_ide(k) = pri_ide(k) * ratio
            3202     2   p    v                pni_ide(k) = pni_ide(k) * ratio
            3203     2   p    v                prs_ide(k) = prs_ide(k) * ratio
            3204     2   p    v                prs_sde(k) = prs_sde(k) * ratio
            3205     2   p    v                prg_gde(k) = prg_gde(k) * ratio
            3206     2   p    v                pri_iha(k) = pri_iha(k) * ratio
            3207     2   p    v               endif
            3208     1               
            3209     1               !>  - Cloud water conservation.
            3210     1   p    v               sump = -prr_wau(k) - pri_wfz(k) - prr_rcw(k) &
            3211     1                               - prs_scw(k) - prg_scw(k) - prg_gcw(k)
            3212     1   p    v               rate_max = -rc(k)*odts
            3213     2   p    v               if (sump.lt. rate_max .and. L_qc(k)) then
            3214     2   p    v                ratio = rate_max/sump
            3215     2   p    v                prr_wau(k) = prr_wau(k) * ratio
            3216     2   p    v                pri_wfz(k) = pri_wfz(k) * ratio
            3217     2   p    v                prr_rcw(k) = prr_rcw(k) * ratio
            3218     2   p    v                prs_scw(k) = prs_scw(k) * ratio
            3219     2   p    v                prg_scw(k) = prg_scw(k) * ratio
            3220     2   p    v                prg_gcw(k) = prg_gcw(k) * ratio
            3221     2   p    v               endif
            3222     1               
            3223     1               !>  - Cloud ice conservation.
            3224     1   p    v               sump = pri_ide(k) - prs_iau(k) - prs_sci(k) &
            3225     1                               - pri_rci(k)
            3226     1   p    v               rate_max = -ri(k)*odts
            3227     2   p    v               if (sump.lt. rate_max .and. L_qi(k)) then
            3228     2   p    v                ratio = rate_max/sump
            3229     2   p    v                pri_ide(k) = pri_ide(k) * ratio
            3230     2   p    v                prs_iau(k) = prs_iau(k) * ratio
            3231     2   p    v                prs_sci(k) = prs_sci(k) * ratio
            3232     2   p    v                pri_rci(k) = pri_rci(k) * ratio
            3233     2   p    v               endif
            3234     1               
            3235     1               !>  - Rain conservation.
            3236     1   p    v               sump = -prg_rfz(k) - pri_rfz(k) - prr_rci(k) &
            3237     1                               + prr_rcs(k) + prr_rcg(k)
            3238     1   p    v               rate_max = -rr(k)*odts
            3239     2   p    v               if (sump.lt. rate_max .and. L_qr(k)) then
            3240     2   p    v                ratio = rate_max/sump
            3241     2   p    v                prg_rfz(k) = prg_rfz(k) * ratio
            3242     2   p    v                pri_rfz(k) = pri_rfz(k) * ratio
            3243     2   p    v                prr_rci(k) = prr_rci(k) * ratio
            3244     2   p    v                prr_rcs(k) = prr_rcs(k) * ratio
            3245     2   p    v                prr_rcg(k) = prr_rcg(k) * ratio
            3246     2   p    v               endif
            3247     1               
            3248     1               !>  - Snow conservation.
            3249     1   p    v               sump = prs_sde(k) - prs_ihm(k) - prr_sml(k) &
            3250     1                               + prs_rcs(k)
            3251     1   p    v               rate_max = -rs(k)*odts
            3252     2   p    v               if (sump.lt. rate_max .and. L_qs(k)) then
            3253     2   p    v                ratio = rate_max/sump
            3254     2   p    v                prs_sde(k) = prs_sde(k) * ratio
            3255     2   p    v                prs_ihm(k) = prs_ihm(k) * ratio
            3256     2   p    v                prr_sml(k) = prr_sml(k) * ratio
            3257     2   p    v                prs_rcs(k) = prs_rcs(k) * ratio
            3258     2   p    v               endif
            3259     1               
            3260     1               !>  - Graupel conservation.
            3261     1   p    v               sump = prg_gde(k) - prg_ihm(k) - prr_gml(k) &
            3262     1                             + prg_rcg(k)
            3263     1   p    v               rate_max = -rg(k)*odts
            3264     2   p    v               if (sump.lt. rate_max .and. L_qg(k)) then
            3265     2   p    v                ratio = rate_max/sump
            3266     2   p    v                prg_gde(k) = prg_gde(k) * ratio
            3267     2   p    v                prg_ihm(k) = prg_ihm(k) * ratio
            3268     2   p    v                prr_gml(k) = prr_gml(k) * ratio
            3269     2   p    v                prg_rcg(k) = prg_rcg(k) * ratio
            3270     2   p    v               endif
            3271     1               
            3272     1               !>  - Re-enforce proper mass conservation for subsequent elements in case
            3273     1               !! any of the above terms were altered.  Thanks P. Blossey. 2009Sep28
            3274     1   p    v               pri_ihm(k) = prs_ihm(k) + prg_ihm(k)
            3275     1   p    v               ratio = MIN( ABS(prr_rcg(k)), ABS(prg_rcg(k)) )
            3276     1   p    v               prr_rcg(k) = ratio * SIGN(1.0, SNGL(prr_rcg(k)))
            3277     1   p    v               prg_rcg(k) = -prr_rcg(k)
            3278     2   p    v               if (temp(k).gt.T_0) then
            3279     2   p    v                  ratio = MIN( ABS(prr_rcs(k)), ABS(prs_rcs(k)) )
            3280     2   p    v                  prr_rcs(k) = ratio * SIGN(1.0, SNGL(prr_rcs(k)))
            3281     2   p    v                  prs_rcs(k) = -prr_rcs(k)
            3282     2   p    v               endif
            3283     1               
            3284     1   p    v            enddo
            3285                     
            3286                     !+---+-----------------------------------------------------------------+
            3287                     !> - Calculate tendencies of all species but constrain the number of ice
            3288                     !! to reasonable values.
            3289                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp, rho, pna_sca, pna_rca, pni_iha
                                   <<<      pna_gca, nwfaten, pnd_gcd, pnd_scd
                                   <<<      pnd_rcd, nifaten, pni_inu, pri_inu
                                   <<<      pri_iha, pri_ide, prs_ide
                                   <<<    PREFETCH(SOFT) : 128
                                   <<<     SEQUENTIAL : 128
                                   <<<      prr_wau: 2, prr_rci: 2, qvten: 2
                                   <<<      prg_gde: 2, lvap: 2, prs_sde: 2
                                   <<<      pri_wfz: 2, prr_rcw: 2, prs_scw: 2
                                   <<<      prs_sci: 2, tten: 2, prg_scw: 2
                                   <<<      prg_gcw: 2, qcten: 2, prs_iau: 2
                                   <<<      pri_rfz: 2, pri_ihm: 2, pri_rci: 2
                                   <<<      qiten: 2, prs_rcs: 2, prr_sml: 2
                                   <<<      prs_ihm: 2, qsten: 2, prg_rci: 2
                                   <<<      prg_ihm: 2, prg_rcg: 2, prg_rfz: 2
                                   <<<      prr_gml: 2, prg_rcs: 2, qgten: 2, ocp: 2
                                   <<<      prr_rcs: 2, prr_rcg: 2, qc1d: 2
                                   <<<      pnc_wau: 2, pnc_rcw: 2, pnc_scw: 2
                                   <<<      pnc_gcw: 2, pni_wfz: 2, nc1d: 2
                                   <<<      ncten: 2, rc: 2, ni1d: 2, qi1d: 2
                                   <<<      pni_ihm: 2, pni_ide: 2, pni_iau: 2
                                   <<<      pni_sci: 2, pni_rci: 2, pni_rfz: 2
                                   <<<      niten: 2, qr1d: 2, qrten: 2, nr1d: 2
                                   <<<      pnr_wau: 2, pnr_sml: 2, pnr_gml: 2
                                   <<<      pnr_rcg: 2, pnr_rfz: 2, pnr_rcr: 2
                                   <<<      pnr_rcs: 2, pnr_rci: 2, nrten: 2
                                   <<<      mvd_r: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 61
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 78
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3290     1  pp    v            do k = kts, kte
            3291     1   p    v               orho = 1./rho(k)
            3292     1   p    v               lfus2 = lsub - lvap(k)
            3293     1               
            3294     1               !>  - Aerosol number tendency
            3295     2   p    v               if (is_aerosol_aware) then
            3296     2   p    v                  nwfaten(k) = nwfaten(k) - (pna_rca(k) + pna_sca(k)          &
            3297     2                                      + pna_gca(k) + pni_iha(k)) * orho
            3298     2   p    v                  nifaten(k) = nifaten(k) - (pnd_rcd(k) + pnd_scd(k)          &
            3299     2                                      + pnd_gcd(k)) * orho
            3300     3   p    v                  if (dustyIce) then
            3301     3   p    v                     nifaten(k) = nifaten(k) - pni_inu(k)*orho
            3302     3                           else
            3303     3                              nifaten(k) = 0.
            3304     3   p    v                  endif
            3305     2   p    v               endif
            3306     1               
            3307     1               !>  - Water vapor tendency
            3308     1   p    v               qvten(k) = qvten(k) + (-pri_inu(k) - pri_iha(k) - pri_ide(k)   &
            3309     1                                     - prs_ide(k) - prs_sde(k) - prg_gde(k)) &
            3310     1                                     * orho
            3311     1               
            3312     1               !>  - Cloud water tendency
            3313     1   p    v               qcten(k) = qcten(k) + (-prr_wau(k) - pri_wfz(k) &
            3314     1                                     - prr_rcw(k) - prs_scw(k) - prg_scw(k) &
            3315     1                                     - prg_gcw(k)) &
            3316     1                                     * orho
            3317     1               
            3318     1               !>  - Cloud water number tendency
            3319     1   p    v               ncten(k) = ncten(k) + (-pnc_wau(k) - pnc_rcw(k) &
            3320     1                                     - pni_wfz(k) - pnc_scw(k) - pnc_gcw(k)) &
            3321     1                                     * orho
            3322     1               
            3323     1               !>  - Cloud water mass/number balance; keep mass-wt mean size between
            3324     1               !! 1 and 50 microns.  Also no more than Nt_c_max drops total.
            3325     1   p    v               xrc=MAX(R1, (qc1d(k) + qcten(k)*dtsave)*rho(k))
            3326     1   p    v               xnc=MAX(2., (nc1d(k) + ncten(k)*dtsave)*rho(k))
            3327     2   p    v               if (xrc .gt. R1) then
            3328     3   p    v                if (xnc.gt.10000.E6) then
            3329     3   p    v                 nu_c = 2
            3330     3   p    v                elseif (xnc.lt.100.) then
            3331     3   p    v                 nu_c = 15
            3332     3   p    v                else
            3333     3   p    v                 nu_c = NINT(1000.E6/xnc) + 2
            3334     3   p    v                 nu_c = MAX(2, MIN(nu_c+NINT(rand2), 15))
            3335     3   p    v                endif
            3336     2   p    v                lamc = (xnc*am_r*ccg(2,nu_c)*ocg1(nu_c)/rc(k))**obmr
            3337     2   p    v                xDc = (bm_r + nu_c + 1.) / lamc
            3338     3   p    v                if (xDc.lt. D0c) then
            3339     3   p    v                 lamc = cce(2,nu_c)/D0c
            3340     3   p    v                 xnc = ccg(1,nu_c)*ocg2(nu_c)*xrc/am_r*lamc**bm_r
            3341     3   p    v                 ncten(k) = (xnc-nc1d(k)*rho(k))*odts*orho
            3342     3   p    v                elseif (xDc.gt. D0r*2.) then
            3343     3   p    v                 lamc = cce(2,nu_c)/(D0r*2.)
            3344     3   p    v                 xnc = ccg(1,nu_c)*ocg2(nu_c)*xrc/am_r*lamc**bm_r
            3345     3   p    v                 ncten(k) = (xnc-nc1d(k)*rho(k))*odts*orho
            3346     3   p    v                endif
            3347     2   p    v               else
            3348     2   p    v                ncten(k) = -nc1d(k)*odts
            3349     2   p    v               endif
            3350     1   p    v               xnc=MAX(0.,(nc1d(k) + ncten(k)*dtsave)*rho(k))
            3351     1   p    v               if (xnc.gt.Nt_c_max) &
            3352     1                               ncten(k) = (Nt_c_max-nc1d(k)*rho(k))*odts*orho
            3353     1               
            3354     1               !>  - Cloud ice mixing ratio tendency
            3355     1   p    v               qiten(k) = qiten(k) + (pri_inu(k) + pri_iha(k) + pri_ihm(k)    &
            3356     1                                     + pri_wfz(k) + pri_rfz(k) + pri_ide(k) &
            3357     1                                     - prs_iau(k) - prs_sci(k) - pri_rci(k)) &
            3358     1                                     * orho
            3359     1               
            3360     1               !>  - Cloud ice number tendency.
            3361     1   p    v               niten(k) = niten(k) + (pni_inu(k) + pni_iha(k) + pni_ihm(k)    &
            3362     1                                     + pni_wfz(k) + pni_rfz(k) + pni_ide(k) &
            3363     1                                     - pni_iau(k) - pni_sci(k) - pni_rci(k)) &
            3364     1                                     * orho
            3365     1               
            3366     1               !>  - Cloud ice mass/number balance; keep mass-wt mean size between
            3367     1               !! 5 and 300 microns.  Also no more than 500 xtals per liter.
            3368     1   p    v               xri=MAX(R1,(qi1d(k) + qiten(k)*dtsave)*rho(k))
            3369     1   p    v               xni=MAX(R2,(ni1d(k) + niten(k)*dtsave)*rho(k))
            3370     2   p    v               if (xri.gt. R1) then
            3371     2   p    v                 lami = (am_i*cig(2)*oig1*xni/xri)**obmi
            3372     2   p    v                 ilami = 1./lami
            3373     2   p    v                 xDi = (bm_i + mu_i + 1.) * ilami
            3374     3   p    v                 if (xDi.lt. 5.E-6) then
            3375     3   p    v                  lami = cie(2)/5.E-6
            3376     3   p    v                  xni = MIN(4999.D3, cig(1)*oig2*xri/am_i*lami**bm_i)
            3377     3   p    v                  niten(k) = (xni-ni1d(k)*rho(k))*odts*orho
            3378     3   p    v                 elseif (xDi.gt. 300.E-6) then
            3379     3   p    v                  lami = cie(2)/300.E-6
            3380     3   p    v                  xni = cig(1)*oig2*xri/am_i*lami**bm_i
            3381     3   p    v                  niten(k) = (xni-ni1d(k)*rho(k))*odts*orho
            3382     3   p    v                 endif
            3383     2   p    v               else
            3384     2   p    v                niten(k) = -ni1d(k)*odts
            3385     2   p    v               endif
            3386     1   p    v               xni=MAX(0.,(ni1d(k) + niten(k)*dtsave)*rho(k))
            3387     1   p    v               if (xni.gt.4999.E3) &
            3388     1                               niten(k) = (4999.E3-ni1d(k)*rho(k))*odts*orho
            3389     1               
            3390     1               !>  - Rain tendency
            3391     1   p    v               qrten(k) = qrten(k) + (prr_wau(k) + prr_rcw(k) &
            3392     1                                     + prr_sml(k) + prr_gml(k) + prr_rcs(k) &
            3393     1                                     + prr_rcg(k) - prg_rfz(k) &
            3394     1                                     - pri_rfz(k) - prr_rci(k)) &
            3395     1                                     * orho
            3396     1               
            3397     1               !>  - Rain number tendency
            3398     1   p    v               nrten(k) = nrten(k) + (pnr_wau(k) + pnr_sml(k) + pnr_gml(k)    &
            3399     1                                     - (pnr_rfz(k) + pnr_rcr(k) + pnr_rcg(k)           &
            3400     1                                     + pnr_rcs(k) + pnr_rci(k) + pni_rfz(k)) )         &
            3401     1                                     * orho
            3402     1               
            3403     1               !>  - Rain mass/number balance; keep median volume diameter between
            3404     1               !! 37 microns (D0r*0.75) and 2.5 mm.
            3405     1   p    v               xrr=MAX(R1,(qr1d(k) + qrten(k)*dtsave)*rho(k))
            3406     1   p    v               xnr=MAX(R2,(nr1d(k) + nrten(k)*dtsave)*rho(k))
            3407     2   p    v               if (xrr.gt. R1) then
            3408     2   p    v                 lamr = (am_r*crg(3)*org2*xnr/xrr)**obmr
            3409     2   p    v                 mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            3410     3   p    v                 if (mvd_r(k) .gt. 2.5E-3) then
            3411     3   p    v                    mvd_r(k) = 2.5E-3
            3412     3   p    v                    lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            3413     3   p    v                    xnr = crg(2)*org3*xrr*lamr**bm_r / am_r
            3414     3   p    v                    nrten(k) = (xnr-nr1d(k)*rho(k))*odts*orho
            3415     3   p    v                 elseif (mvd_r(k) .lt. D0r*0.75) then
            3416     3   p    v                    mvd_r(k) = D0r*0.75
            3417     3   p    v                    lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            3418     3   p    v                    xnr = crg(2)*org3*xrr*lamr**bm_r / am_r
            3419     3   p    v                    nrten(k) = (xnr-nr1d(k)*rho(k))*odts*orho
            3420     3   p    v                 endif
            3421     2   p    v               else
            3422     2   p    v                 qrten(k) = -qr1d(k)*odts
            3423     2   p    v                 nrten(k) = -nr1d(k)*odts
            3424     2   p    v               endif
            3425     1               
            3426     1               !>  - Snow tendency
            3427     1   p    v               qsten(k) = qsten(k) + (prs_iau(k) + prs_sde(k) &
            3428     1                                     + prs_sci(k) + prs_scw(k) + prs_rcs(k) &
            3429     1                                     + prs_ide(k) - prs_ihm(k) - prr_sml(k)) &
            3430     1                                     * orho
            3431     1               
            3432     1               !>  - Graupel tendency
            3433     1   p    v               qgten(k) = qgten(k) + (prg_scw(k) + prg_rfz(k) &
            3434     1                                     + prg_gde(k) + prg_rcg(k) + prg_gcw(k) &
            3435     1                                     + prg_rci(k) + prg_rcs(k) - prg_ihm(k) &
            3436     1                                     - prr_gml(k)) &
            3437     1                                     * orho
            3438     1               
            3439     1               !>  - Temperature tendency
            3440     2   p    v               if (temp(k).lt.T_0) then

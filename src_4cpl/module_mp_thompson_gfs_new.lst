            2989     5                             if ( (xni/10.**nn).ge.1.0 .and. &
            2990     5                                  (xni/10.**nn).lt.10.0) goto 149
            2991     5                          enddo
            2992     4                149       continue
            2993     4                          idx_IN = INT(xni/10.**n) + 10*(n-niin2) - (n-niin2)
            2994     4                          idx_IN = MAX(1, MIN(idx_IN, ntb_IN))
            2995     4                         else
            2996     4                          idx_IN = 1
            2997     4                         endif

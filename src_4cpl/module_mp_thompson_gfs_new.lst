            3563     3                              + sa(10)*bm_s*bm_s*bm_s
            3564     3                           a_ = 10.0**loga_
            3565     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            3566     3                              + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            3567     3                              + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            3568     3                              + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            3569     3                              + sb(10)*bm_s*bm_s*bm_s
            3570     3                           smo2(k) = (smob(k)/a_)**(1./b_)
            3571     3   p    v               endif
            3572     2               
            3573     2               !>  - Calculate bm_s+1 (th) moment.  Useful for diameter calcs.

            4379     2   p    v                 nr1d(k) = crg(2)*org3*qr1d(k)*lamr**bm_r / am_r
            4380     2   p    v               endif
            4381     1   p    v               qs1d(k) = qs1d(k) + qsten(k)*DT
            4382     1   p    v               if (qs1d(k) .le. R1) qs1d(k) = 0.0
            4383     1   p    v               qg1d(k) = qg1d(k) + qgten(k)*DT
            4384     1   p    v               if (qg1d(k) .le. R1) qg1d(k) = 0.0
            4385     1   p    v            enddo
            4386                     
            4387                     #ifdef EXT_DIAG
            4388                     ! Diagnostics
            4389                           calculate_extended_diagnostics: if (ext_diag) then
            4390                              do k = kts, kte
            4391                                 if(prw_vcd(k).gt.0)then
            4392                                    prw_vcdc1(k) = prw_vcd(k)*dt
            4393                                 elseif(prw_vcd(k).lt.0)then
            4394                                    prw_vcde1(k) = -1*prw_vcd(k)*dt
            4395                                 endif
            4396                     !heating/cooling diagnostics
            4397                                 tpri_inu1(k) = pri_inu(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4398                     
            4399                                 if(pri_ide(k).gt.0)then
            4400                                    tpri_ide1_d(k) = pri_ide(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4401                                 else
            4402                                    tpri_ide1_s(k) = -pri_ide(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4403                                 endif
            4404                     
            4405                                 if(temp(k).lt.T_0)then
            4406                                   tprs_ide1(k) = prs_ide(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4407                                 endif
            4408                     
            4409                                 if(prs_sde(k).gt.0)then
            4410                                    tprs_sde1_d(k) = prs_sde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4411                                 else
            4412                                    tprs_sde1_s(k) = -prs_sde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4413                                 endif
            4414                     
            4415                                 if(prg_gde(k).gt.0)then
            4416                                   tprg_gde1_d(k) = prg_gde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4417                                 else
            4418                                   tprg_gde1_s(k) = -prg_gde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4419                                 endif
            4420                     
            4421                                 tpri_iha1(k) = pri_iha(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4422                                 tpri_wfz1(k) = pri_wfz(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4423                                 tpri_rfz1(k) = pri_rfz(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4424                                 tprg_rfz1(k) = prg_rfz(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4425                                 tprs_scw1(k) = prs_scw(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4426                                 tprg_scw1(k) = prg_scw(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4427                                 tprg_rcs1(k) = prg_rcs(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4428                     
            4429                                 if(temp(k).lt.T_0)then
            4430                                   tprs_rcs1(k) = prs_rcs(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4431                                 endif
            4432                     
            4433                                 tprr_rci1(k) = prr_rci(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4434                     
            4435                                 if(temp(k).lt.T_0)then
            4436                                    tprg_rcg1(k) = prg_rcg(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4437                                 endif
            4438                     
            4439                                 if(prw_vcd(k).gt.0)then
            4440                                    tprw_vcd1_c(k) = lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)*DT
            4441                                 else
            4442                                    tprw_vcd1_e(k) = -lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)*DT
            4443                                 endif
            4444                     
            4445                     ! cooling terms
            4446                                 tprr_sml1(k) = prr_sml(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4447                                 tprr_gml1(k) = prr_gml(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4448                     
            4449                                 if(temp(k).ge.T_0)then
            4450                                    tprr_rcg1(k) = -prr_rcg(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4451                                 endif
            4452                     
            4453                                 if(temp(k).ge.T_0)then
            4454                                    tprr_rcs1(k) = -prr_rcs(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4455                                 endif
            4456                     
            4457                                 tprv_rev1(k) = lvap(k)*ocp(k)*prv_rev(k)*(1-IFDRY)*DT
            4458                                 tten1(k) = tten(k)*DT
            4459                                 qvten1(k) = qvten(k)*DT
            4460                                 qiten1(k) = qiten(k)*DT
            4461                                 qrten1(k) = qrten(k)*DT
            4462                                 qsten1(k) = qsten(k)*DT
            4463                                 qgten1(k) = qgten(k)*DT
            4464                                 niten1(k) = niten(k)*DT
            4465                                 nrten1(k) = nrten(k)*DT
            4466                                 ncten1(k) = ncten(k)*DT
            4467                                 qcten1(k) = qcten(k)*DT
            4468                              enddo
            4469                           endif calculate_extended_diagnostics
            4470                     #endif
            4471                     
            4472                           end subroutine mp_thompson
            4473                     !>@}
            4474                     
            4475                     !+---+-----------------------------------------------------------------+
            4476                     !ctrlL
            4477                     !+---+-----------------------------------------------------------------+
            4478                     !..Creation of the lookup tables and support functions found below here.
            4479                     !+---+-----------------------------------------------------------------+
            4480                     !>\ingroup aathompson
            4481                     !! Rain collecting graupel (and inverse).  Explicit CE integration.
            4482                           subroutine qr_acr_qg
            4483                     
            4484                           implicit none
            4485                     
            4486                     !..Local variables
            4487                           INTEGER:: i, j, k, m, n, n2
            4488                           INTEGER:: km, km_s, km_e
            4489                           DOUBLE PRECISION, DIMENSION(nbg):: vg, N_g
            4490                           DOUBLE PRECISION, DIMENSION(nbr):: vr, N_r
            4491                           DOUBLE PRECISION:: N0_r, N0_g, lam_exp, lamg, lamr
            4492                           DOUBLE PRECISION:: massg, massr, dvg, dvr, t1, t2, z1, z2, y1, y2
            4493                     !      LOGICAL force_read_thompson, write_thompson_tables
            4494                     !      LOGICAL lexist,lopen
            4495                     !      INTEGER good,ierr
            4496                     
            4497                     !      force_read_thompson = .false.
            4498                     !      write_thompson_tables = .false.
            4499                     !+---+
            4500                     
            4501                     
            4502                     !      good = 0
            4503                     !        INQUIRE(FILE=qr_acr_qg_file, EXIST=lexist)
            4504                     !#ifdef MPI
            4505                     !        call MPI_BARRIER(mpi_communicator,ierr)
            4506                     !#endif
            4507                     !        IF ( lexist ) THEN
            4508                     !          OPEN(63,file=qr_acr_qg_file,form="unformatted",err=1234)
            4509                     !!sms$serial begin
            4510                     !          READ(63,err=1234) tcg_racg
            4511                     !          READ(63,err=1234) tmr_racg
            4512                     !          READ(63,err=1234) tcr_gacr
            4513                     !          READ(63,err=1234) tmg_gacr
            4514                     !          READ(63,err=1234) tnr_racg
            4515                     !          READ(63,err=1234) tnr_gacr
            4516                     !!sms$serial end
            4517                     !          good = 1
            4518                     ! 1234     CONTINUE
            4519                     !          IF ( good .NE. 1 ) THEN
            4520                     !            INQUIRE(63,opened=lopen)
            4521                     !            IF (lopen) THEN
            4522                     !              IF( force_read_thompson ) THEN
            4523                     !                write(0,*) "Error reading "//qr_acr_qg_file//" Aborting because force_read_thompson is .true."
            4524                     !                return
            4525                     !              ENDIF
            4526                     !              CLOSE(63)
            4527                     !            ELSE
            4528                     !              IF( force_read_thompson ) THEN
            4529                     !                write(0,*) "Error opening "//qr_acr_qg_file//" Aborting because force_read_thompson is .true."
            4530                     !                return
            4531                     !              ENDIF
            4532                     !            ENDIF
            4533                     !         ELSE
            4534                     !            INQUIRE(63,opened=lopen)
            4535                     !            IF (lopen) THEN
            4536                     !              CLOSE(63)
            4537                     !            ENDIF
            4538                     !          ENDIF
            4539                     !        ELSE
            4540                     !          IF( force_read_thompson ) THEN
            4541                     !            write(0,*) "Non-existent "//qr_acr_qg_file//" Aborting because force_read_thompson is .true."
            4542                     !            return
            4543                     !          ENDIF
            4544                     !        ENDIF
            4545                     
            4546                     !      IF (.NOT. good .EQ. 1 ) THEN
            4547                     !        if (thompson_table_writer) then
            4548                     !          write_thompson_tables = .true.
            4549                     !          write(0,*) "ThompMP: computing qr_acr_qg"
            4550                     !        endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4551     1   s   fv              do n2 = 1, nbr
            4552     1               !        vr(n2) = av_r*Dr(n2)**bv_r * DEXP(-fv_r*Dr(n2))
            4553     1   p   fv               vr(n2) = -0.1021 + 4.932E3*Dr(n2) - 0.9551E6*Dr(n2)*Dr(n2)     &
            4554     1                             + 0.07934E9*Dr(n2)*Dr(n2)*Dr(n2)                          &
            4555     1                             - 0.002362E12*Dr(n2)*Dr(n2)*Dr(n2)*Dr(n2)
            4556     1   p   fv              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.10, ITR: 72, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vg, Dg
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 40
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4557     1  pp    v              do n = 1, nbg
            4558     1   p    v               vg(n) = av_g*Dg(n)**bv_g
            4559     1   p    v              enddo
            4560                     
            4561                     !..Note values returned from wrf_dm_decomp1d are zero-based, add 1 for
            4562                     !.. fortran indices.  J. Michalakes, 2009Oct30.
            4563                     
            4564                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            4565                             CALL wrf_dm_decomp1d ( ntb_r*ntb_r1, km_s, km_e )
            4566                     #else
            4567                             km_s = 0
            4568                             km_e = ntb_r*ntb_r1 - 1
            4569                     #endif
            4570                     
            4571     1                       do km = km_s, km_e
            4572     1                        m = km / ntb_r1 + 1
            4573     1                        k = mod( km , ntb_r1 ) + 1
            4574     1               
            4575     1                        lam_exp = (N0r_exp(k)*am_r*crg(1)/r_r(m))**ore1
            4576     1                        lamr = lam_exp * (crg(3)*org2*org1)**obmr
            4577     1                        N0_r = N0r_exp(k)/(crg(2)*lam_exp) * lamr**cre(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtr, Dr, N_r
                                   <<< Loop-information  End >>>
            4578     2  pp    v               do n2 = 1, nbr
            4579     2   p    v                  N_r(n2) = N0_r*Dr(n2)**mu_r *DEXP(-lamr*Dr(n2))*dtr(n2)
            4580     2   p    v               enddo
            4581     1               
            4582     2                        do j = 1, ntb_g
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4583     3                        do i = 1, ntb_g1
            4584     3                           lam_exp = (N0g_exp(i)*am_g*cgg(1)/r_g(j))**oge1
            4585     3                           lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg
            4586     3                           N0_g = N0g_exp(i)/(cgg(2)*lam_exp) * lamg**cge(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtg, Dg, N_g
                                   <<< Loop-information  End >>>
            4587     4  pp    v                  do n = 1, nbg
            4588     4   p    v                     N_g(n) = N0_g*Dg(n)**mu_g * DEXP(-lamg*Dg(n))*dtg(n)
            4589     4   p    v                  enddo
            4590     3               
            4591     3                           t1 = 0.0d0
            4592     3                           t2 = 0.0d0
            4593     3                           z1 = 0.0d0
            4594     3                           z2 = 0.0d0
            4595     3                           y1 = 0.0d0
            4596     3                           y2 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 6  FILL 6
                                   <<<      SCALABLE  : SPILL 0  FILL 17
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4597     4  pp                       do n2 = 1, nbr
            4598     4   p                          massr = am_r * Dr(n2)**bm_r
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4599     5   p   fv                     do n = 1, nbg
            4600     5   p   fv                        massg = am_g * Dg(n)**bm_g
            4601     5               
            4602     5   p   fv                        dvg = 0.5d0*((vr(n2) - vg(n)) + DABS(vr(n2)-vg(n)))
            4603     5   p   fv                        dvr = 0.5d0*((vg(n) - vr(n2)) + DABS(vg(n)-vr(n2)))
            4604     5               
            4605     5   p   fv                        t1 = t1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4606     5                                     *dvg*massg * N_g(n)* N_r(n2)
            4607     5   p   fv                        z1 = z1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4608     5                                     *dvg*massr * N_g(n)* N_r(n2)
            4609     5   p   fv                        y1 = y1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4610     5                                     *dvg       * N_g(n)* N_r(n2)
            4611     5               
            4612     5   p   fv                        t2 = t2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4613     5                                     *dvr*massr * N_g(n)* N_r(n2)
            4614     5   p   fv                        y2 = y2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4615     5                                     *dvr       * N_g(n)* N_r(n2)
            4616     5   p   fv                        z2 = z2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4617     5                                     *dvr*massg * N_g(n)* N_r(n2)
            4618     5   p   fv                     enddo
            4619     4   p            97            continue
            4620     4   p                       enddo
            4621     3                           tcg_racg(i,j,k,m) = t1
            4622     3                           tmr_racg(i,j,k,m) = DMIN1(z1, r_r(m)*1.0d0)
            4623     3                           tcr_gacr(i,j,k,m) = t2
            4624     3                           tmg_gacr(i,j,k,m) = DMIN1(z2, r_g(j)*1.0d0)
            4625     3                           tnr_racg(i,j,k,m) = y1
            4626     3                           tnr_gacr(i,j,k,m) = y2
            4627     3                        enddo
            4628     2                        enddo
            4629     1                       enddo
            4630                     
            4631                     !        IF ( write_thompson_tables ) THEN
            4632                     !          write(0,*) "Writing "//qr_acr_qg_file//" in Thompson MP init"
            4633                     !          OPEN(63,file=qr_acr_qg_file,form="unformatted",err=9234)
            4634                     !          WRITE(63,err=9234) tcg_racg
            4635                     !          WRITE(63,err=9234) tmr_racg
            4636                     !          WRITE(63,err=9234) tcr_gacr
            4637                     !          WRITE(63,err=9234) tmg_gacr
            4638                     !          WRITE(63,err=9234) tnr_racg
            4639                     !          WRITE(63,err=9234) tnr_gacr
            4640                     !          CLOSE(63)
            4641                     !          RETURN    ! ----- RETURN
            4642                     ! 9234     CONTINUE
            4643                     !          write(0,*) "Error writing "//qr_acr_qg_file
            4644                     !          return
            4645                     !        ENDIF
            4646                     !      ENDIF
            4647                     
            4648                           end subroutine qr_acr_qg
            4649                     !+---+-----------------------------------------------------------------+
            4650                     !ctrlL
            4651                     !+---+-----------------------------------------------------------------+
            4652                     !>\ingroup aathompson
            4653                     !!Rain collecting snow (and inverse).  Explicit CE integration.
            4654                           subroutine qr_acr_qs
            4655                     
            4656                           implicit none
            4657                     
            4658                     !..Local variables
            4659                           INTEGER:: i, j, k, m, n, n2
            4660                           INTEGER:: km, km_s, km_e
            4661                           DOUBLE PRECISION, DIMENSION(nbr):: vr, D1, N_r
            4662                           DOUBLE PRECISION, DIMENSION(nbs):: vs, N_s
            4663                           DOUBLE PRECISION:: loga_, a_, b_, second, M0, M2, M3, Mrat, oM3
            4664                           DOUBLE PRECISION:: N0_r, lam_exp, lamr, slam1, slam2
            4665                           DOUBLE PRECISION:: dvs, dvr, masss, massr
            4666                           DOUBLE PRECISION:: t1, t2, t3, t4, z1, z2, z3, z4
            4667                           DOUBLE PRECISION:: y1, y2, y3, y4
            4668                     !      LOGICAL force_read_thompson, write_thompson_tables
            4669                     !      LOGICAL lexist,lopen
            4670                     !      INTEGER good,ierr
            4671                     
            4672                     !+---+
            4673                     
            4674                     !      force_read_thompson = .false.
            4675                     !      write_thompson_tables = .false.
            4676                     
            4677                     !      good = 0
            4678                     !        INQUIRE(FILE=qr_acr_qs_file, EXIST=lexist)
            4679                     !#ifdef MPI
            4680                     !        call MPI_BARRIER(mpi_communicator,ierr)
            4681                     !#endif
            4682                     !        IF ( lexist ) THEN
            4683                     !          !write(0,*) "ThompMP: read "//qr_acr_qs_file//" instead of computing"
            4684                     !          OPEN(63,file=qr_acr_qs_file,form="unformatted",err=1234)
            4685                     !!sms$serial begin
            4686                     !          READ(63,err=1234)tcs_racs1
            4687                     !          READ(63,err=1234)tmr_racs1
            4688                     !          READ(63,err=1234)tcs_racs2
            4689                     !          READ(63,err=1234)tmr_racs2
            4690                     !          READ(63,err=1234)tcr_sacr1
            4691                     !          READ(63,err=1234)tms_sacr1
            4692                     !          READ(63,err=1234)tcr_sacr2
            4693                     !          READ(63,err=1234)tms_sacr2
            4694                     !          READ(63,err=1234)tnr_racs1
            4695                     !          READ(63,err=1234)tnr_racs2
            4696                     !          READ(63,err=1234)tnr_sacr1
            4697                     !          READ(63,err=1234)tnr_sacr2
            4698                     !!sms$serial end
            4699                     !          good = 1
            4700                     ! 1234     CONTINUE
            4701                     !          IF ( good .NE. 1 ) THEN
            4702                     !            INQUIRE(63,opened=lopen)
            4703                     !            IF (lopen) THEN
            4704                     !              IF( force_read_thompson ) THEN
            4705                     !                write(0,*) "Error reading "//qr_acr_qs_file//" Aborting because force_read_thompson is .true."
            4706                     !                return
            4707                     !              ENDIF
            4708                     !              CLOSE(63)
            4709                     !            ELSE
            4710                     !              IF( force_read_thompson ) THEN
            4711                     !                write(0,*) "Error opening "//qr_acr_qs_file//" Aborting because force_read_thompson is .true."
            4712                     !                return
            4713                     !              ENDIF
            4714                     !            ENDIF
            4715                     !          ELSE
            4716                     !            INQUIRE(63,opened=lopen)
            4717                     !            IF (lopen) THEN
            4718                     !              CLOSE(63)
            4719                     !            ENDIF
            4720                     !          ENDIF
            4721                     !        ELSE
            4722                     !          IF( force_read_thompson ) THEN
            4723                     !            write(0,*) "Non-existent "//qr_acr_qs_file//" Aborting because force_read_thompson is .true."
            4724                     !            return
            4725                     !          ENDIF
            4726                     !        ENDIF
            4727                     
            4728                     !      IF (.NOT. good .EQ. 1 ) THEN
            4729                     !        if (thompson_table_writer) then

            2589     2                         Dc_b = (xDc*xDc*xDc*Dc_g*Dc_g*Dc_g - xDc*xDc*xDc*xDc*xDc*xDc) &
            2590     2                                **(1./6.)
            2591     2                         zeta1 = 0.5*((6.25E-6*xDc*Dc_b*Dc_b*Dc_b - 0.4) &
            2592     2                                    + abs(6.25E-6*xDc*Dc_b*Dc_b*Dc_b - 0.4))

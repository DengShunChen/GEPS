                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4733     1   s   fv              do n2 = 1, nbr
            4734     1               !        vr(n2) = av_r*Dr(n2)**bv_r * DEXP(-fv_r*Dr(n2))
            4735     1   p   fv               vr(n2) = -0.1021 + 4.932E3*Dr(n2) - 0.9551E6*Dr(n2)*Dr(n2)     &
            4736     1                             + 0.07934E9*Dr(n2)*Dr(n2)*Dr(n2)                          &
            4737     1                             - 0.002362E12*Dr(n2)*Dr(n2)*Dr(n2)*Dr(n2)
            4738     1   p   fv               D1(n2) = (vr(n2)/av_s)**(1./bv_s)
            4739     1   p   fv              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 23
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.11, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vs, Ds
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 28
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4740     1  pp    v              do n = 1, nbs
            4741     1   p    v               vs(n) = 1.5*av_s*Ds(n)**bv_s * DEXP(-fv_s*Ds(n))
            4742     1   p    v              enddo
            4743                     
            4744                     !..Note values returned from wrf_dm_decomp1d are zero-based, add 1 for
            4745                     !.. fortran indices.  J. Michalakes, 2009Oct30.
            4746                     
            4747                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            4748                             CALL wrf_dm_decomp1d ( ntb_r*ntb_r1, km_s, km_e )
            4749                     #else
            4750                             km_s = 0
            4751                             km_e = ntb_r*ntb_r1 - 1
            4752                     #endif
            4753                     
            4754     1                       do km = km_s, km_e
            4755     1                        m = km / ntb_r1 + 1
            4756     1                        k = mod( km , ntb_r1 ) + 1
            4757     1               
            4758     1                        lam_exp = (N0r_exp(k)*am_r*crg(1)/r_r(m))**ore1
            4759     1                        lamr = lam_exp * (crg(3)*org2*org1)**obmr
            4760     1                        N0_r = N0r_exp(k)/(crg(2)*lam_exp) * lamr**cre(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

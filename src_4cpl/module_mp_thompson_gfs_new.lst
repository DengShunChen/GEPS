            2507     2                              + sa(10)*cse(13)*cse(13)*cse(13)
            2508     2   p    v               a_ = 10.0**loga_
            2509     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(13) + sb(4)*tc0*cse(13) &
            2510     2                             + sb(5)*tc0*tc0 + sb(6)*cse(13)*cse(13) &
            2511     2                             + sb(7)*tc0*tc0*cse(13) + sb(8)*tc0*cse(13)*cse(13) &
            2512     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(13)*cse(13)*cse(13)
            2513     2   p    v               smoe(k) = a_ * smo2(k)**b_

            2877     5                                        + tnr_sacr1(idx_s,idx_t,idx_r1,idx_r)          &
            2878     5                                        + tnr_sacr2(idx_s,idx_t,idx_r1,idx_r)
            2879     5                           pnr_rcs(k) = MIN(DBLE(nr(k)*odts), pnr_rcs(k))
            2880     5                          else
            2881     5                           prs_rcs(k) = -tcs_racs1(idx_s,idx_t,idx_r1,idx_r)           &
            2882     5                                        - tms_sacr1(idx_s,idx_t,idx_r1,idx_r)          &
            2883     5                                        + tmr_racs2(idx_s,idx_t,idx_r1,idx_r)          &
            2884     5                                        + tcr_sacr2(idx_s,idx_t,idx_r1,idx_r)
            2885     5                           prs_rcs(k) = MAX(DBLE(-rs(k)*odts), prs_rcs(k))

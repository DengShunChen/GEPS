            5845                     !ctrlL
            5846                     
            5847                     !+---+-----------------------------------------------------------------+
            5848                     !>\ingroup aathompson
            5849                     !! Compute _radiation_ effective radii of cloud water, ice, and snow.
            5850                     !! These are entirely consistent with microphysics assumptions, not
            5851                     !! constant or otherwise ad hoc as is internal to most radiation
            5852                     !! schemes.  Since only the smallest snowflakes should impact
            5853                     !! radiation, compute from first portion of complicated Field number
            5854                     !! distribution, not the second part, which is the larger sizes.
            5855                     
            5856                           subroutine calc_effectRad (t1d, p1d, qv1d, qc1d, nc1d, qi1d, ni1d, qs1d,   &
            5857                          &                re_qc1d, re_qi1d, re_qs1d, lsml, kts, kte)
            5858                     
            5859                           IMPLICIT NONE
            5860                     
            5861                     !..Sub arguments
            5862                           INTEGER, INTENT(IN):: kts, kte
            5863                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            5864                          &                    t1d, p1d, qv1d, qc1d, nc1d, qi1d, ni1d, qs1d
            5865                           REAL, DIMENSION(kts:kte), INTENT(OUT):: re_qc1d, re_qi1d, re_qs1d
            5866                     !..Local variables
            5867                           INTEGER:: k
            5868                           REAL, DIMENSION(kts:kte):: rho, rc, nc, ri, ni, rs
            5869                           REAL:: smo2, smob, smoc
            5870                           REAL:: tc0, loga_, a_, b_
            5871                           DOUBLE PRECISION:: lamc, lami
            5872                           LOGICAL:: has_qc, has_qi, has_qs
            5873                           INTEGER:: inu_c
            5874                           INTEGER:: lsml
            5875                           real, dimension(15), parameter:: g_ratio = (/24,60,120,210,336,   &
            5876                          &                504,720,990,1320,1716,2184,2730,3360,4080,4896/)
            5877                     
            5878                           has_qc = .false.
            5879                           has_qi = .false.
            5880                           has_qs = .false.
            5881                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      re_qs1d, re_qi1d, re_qc1d
                                   <<< Loop-information  End >>>
            5882        pp   2v            re_qc1d(:) = 0.0D0
            5883         p   2v            re_qi1d(:) = 0.0D0
            5884         p   2v            re_qs1d(:) = 0.0D0
            5885                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 114
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            5886     1  pp    v            do k = kts, kte
            5887     1   p    v               rho(k) = 0.622*p1d(k)/(R*t1d(k)*(qv1d(k)+0.622))
            5888     1   p    v               rc(k) = MAX(R1, qc1d(k)*rho(k))
            5889     1   p    v               nc(k) = MAX(2., MIN(nc1d(k)*rho(k), Nt_c_max))
            5890     2   p    v               if (.NOT. (is_aerosol_aware .or. merra2_aerosol_aware)) then
            5891     3   p    v                   if( lsml == 1) then
            5892     3   p    v                      nc(k) = Nt_c_l
            5893     3   p                        else
            5894     3   p    v                      nc(k) = Nt_c_o
            5895     3   p    v                   endif
            5896     2   p    v               endif
            5897     1   p    v               if (rc(k).gt.R1 .and. nc(k).gt.R2) has_qc = .true.
            5898     1   p    v               ri(k) = MAX(R1, qi1d(k)*rho(k))
            5899     1   p    v               ni(k) = MAX(R2, ni1d(k)*rho(k))
            5900     1   p                    if (ri(k).gt.R1 .and. ni(k).gt.R2) has_qi = .true.
            5901     1   p    v               rs(k) = MAX(R1, qs1d(k)*rho(k))
            5902     1   p                    if (rs(k).gt.R1) has_qs = .true.
            5903     1   p    v            enddo
            5904                     
            5905     1                     if (has_qc) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 37
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rc
                                   <<< Loop-information  End >>>
            5906     2  pp    s            do k = kts, kte
            5907     2   p    m               if (rc(k).le.R1 .or. nc(k).le.R2) CYCLE
            5908     3   p    s               if (nc(k).lt.100) then
            5909     3   p    s                  inu_c = 15
            5910     3   p    s               elseif (nc(k).gt.1.E10) then
            5911     3   p    s                  inu_c = 2
            5912     3   p    s               else
            5913     3   p    s                  inu_c = MIN(15, NINT(1000.E6/nc(k)) + 2)
            5914     3   p    s               endif
            5915     2   p    s               lamc = (nc(k)*am_r*g_ratio(inu_c)/rc(k))**obmr
            5916     2   p    s               re_qc1d(k) = SNGL(0.5D0 * DBLE(3.+inu_c)/lamc)
            5917     2   p    v            enddo
            5918     1                     endif
            5919                     
            5920     1                     if (has_qi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 43
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ri, ni, re_qi1d
                                   <<< Loop-information  End >>>
            5921     2  pp    v            do k = kts, kte
            5922     2   p    v               if (ri(k).le.R1 .or. ni(k).le.R2) CYCLE
            5923     2   p    v               lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            5924     2   p    v               re_qi1d(k) = SNGL(0.5D0 * DBLE(3.+mu_i)/lami)
            5925     2   p    v            enddo
            5926     1                     endif
            5927                     
            5928     1                     if (has_qs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 21
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rs, t1d, re_qs1d
                                   <<< Loop-information  End >>>
            5929     2  pp    v            do k = kts, kte
            5930     2   p    v               if (rs(k).le.R1) CYCLE
            5931     2   p    v               tc0 = MIN(-0.1, t1d(k)-273.15)
            5932     2   p    v               smob = rs(k)*oams
            5933     2               
            5934     2               !..All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            5935     2               !.. then we must compute actual 2nd moment and use as reference.
            5936     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            5937     3   p    v                  smo2 = smob
            5938     3                        else
            5939     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            5940     3                    &         + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            5941     3                    &         + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            5942     3                    &         + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            5943     3                    &         + sa(10)*bm_s*bm_s*bm_s
            5944     3                           a_ = 10.0**loga_
            5945     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            5946     3                    &         + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            5947     3                    &         + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            5948     3                    &         + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            5949     3                    &         + sb(10)*bm_s*bm_s*bm_s
            5950     3                           smo2 = (smob/a_)**(1./b_)
            5951     3   p    v               endif
            5952     2               !..Calculate bm_s+1 (th) moment.  Useful for diameter calcs.
            5953     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(1) &
            5954     2                    &         + sa(4)*tc0*cse(1) + sa(5)*tc0*tc0 &
            5955     2                    &         + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            5956     2                    &         + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            5957     2                    &         + sa(10)*cse(1)*cse(1)*cse(1)
            5958     2   p    v               a_ = 10.0**loga_
            5959     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(1) + sb(4)*tc0*cse(1) &
            5960     2                    &        + sb(5)*tc0*tc0 + sb(6)*cse(1)*cse(1) &
            5961     2                    &        + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            5962     2                    &        + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            5963     2   p    v               smoc = a_ * smo2**b_
            5964     2   p    v               re_qs1d(k) = 0.5*(smoc/smob)
            5965     2   p    v            enddo
            5966     1                     endif
            5967                     
            5968                           end subroutine calc_effectRad

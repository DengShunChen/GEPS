            3576     2                              + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            3577     2                              + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            3578     2                              + sa(10)*cse(1)*cse(1)*cse(1)
            3579     2   p    v               a_ = 10.0**loga_

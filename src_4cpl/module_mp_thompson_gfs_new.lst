            5970                     !+---+-----------------------------------------------------------------+
            5971                     !>\ingroup aathompson
            5972                     !! Compute radar reflectivity assuming 10 cm wavelength radar and using
            5973                     !! Rayleigh approximation.  Only complication is melted snow/graupel
            5974                     !! which we treat as water-coated ice spheres and use Uli Blahak's
            5975                     !! library of routines.  The meltwater fraction is simply the amount
            5976                     !! of frozen species remaining from what initially existed at the
            5977                     !! melting level interface.
            5978                     
            5979                           subroutine calc_refl10cm (qv1d, qc1d, qr1d, nr1d, qs1d, qg1d,     &
            5980                                    t1d, p1d, dBZ, rand1, kts, kte, ii, melti,               &
            5981                                    vt_dBZ, first_time_step)
            5982                     
            5983                           IMPLICIT NONE
            5984                     
            5985                     !..Sub arguments
            5986                           INTEGER, INTENT(IN):: kts, kte, ii!, jj
            5987                           REAL, INTENT(IN):: rand1
            5988                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            5989                                               qv1d, qc1d, qr1d, nr1d, qs1d, qg1d, t1d, p1d
            5990                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: dBZ
            5991                           REAL, DIMENSION(kts:kte), OPTIONAL, INTENT(INOUT):: vt_dBZ
            5992                           LOGICAL, OPTIONAL, INTENT(IN) :: first_time_step
            5993                     
            5994                     !..Local variables
            5995                           LOGICAL :: do_vt_dBZ
            5996                           LOGICAL :: allow_wet_graupel
            5997                           LOGICAL :: allow_wet_snow
            5998                           REAL, DIMENSION(kts:kte):: temp, pres, qv, rho, rhof
            5999                           REAL, DIMENSION(kts:kte):: rc, rr, nr, rs, rg
            6000                     
            6001                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilamg, N0_r, N0_g
            6002                           REAL, DIMENSION(kts:kte):: mvd_r
            6003                           REAL, DIMENSION(kts:kte):: smob, smo2, smoc, smoz
            6004                           REAL:: oM3, M0, Mrat, slam1, slam2, xDs
            6005                           REAL:: ils1, ils2, t1_vts, t2_vts, t3_vts, t4_vts
            6006                           REAL:: vtr_dbz_wt, vts_dbz_wt, vtg_dbz_wt
            6007                     
            6008                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            6009                     
            6010                           DOUBLE PRECISION:: N0_exp, N0_min, lam_exp, lamr, lamg
            6011                           REAL:: a_, b_, loga_, tc0, SR
            6012                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            6013                     
            6014                           INTEGER:: i, k, k_0, kbot, n
            6015                           LOGICAL, INTENT(IN):: melti
            6016                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            6017                     
            6018                           DOUBLE PRECISION:: cback, x, eta, f_d
            6019                           REAL:: xslw1, ygra1, zans1
            6020                     
            6021                     !+---+
            6022     1                     if (present(vt_dBZ) .and. present(first_time_step)) then
            6023     1                        do_vt_dBZ = .true.
            6024     2                        if (first_time_step) then
            6025     2               !           no bright banding, to be consistent with hydrometeor retrieval in GSI
            6026     2                           allow_wet_snow = .false.
            6027     2                        else
            6028     2                           allow_wet_snow = .true.
            6029     2                        endif
            6030     1                        allow_wet_graupel = .false.
            6031     1                     else
            6032     1                        do_vt_dBZ = .false.
            6033     1                        allow_wet_snow = .true.
            6034     1                        allow_wet_graupel = .false.
            6035     1                     endif
            6036                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            6037     1  pp   4v            do k = kts, kte
            6038     1   p   4v               dBZ(k) = -35.0
            6039     1   p   4v            enddo
            6040                     
            6041                     !+---+-----------------------------------------------------------------+
            6042                     !..Put column of data into local arrays.
            6043                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 19
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, p1d, pres, L_qg, L_qs
                                   <<<      L_qr, qv1d, t1d, qv, rho, rhof, qc1d, rr
                                   <<<      rc
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      nr1d: 2, N0_r: 2, mvd_r: 2, ilamr: 2
                                   <<<      nr: 2, rs: 2, rg: 2, temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 11
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6044     1  pp    v            do k = kts, kte
            6045     1   p    v               temp(k) = t1d(k)
            6046     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            6047     1   p    v               pres(k) = p1d(k)
            6048     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            6049     1   p    v               rhof(k) = SQRT(RHO_NOT/rho(k))
            6050     1   p    v               rc(k) = MAX(R1, qc1d(k)*rho(k))
            6051     2   p    v               if (qr1d(k) .gt. R1) then
            6052     2   p    v                  rr(k) = qr1d(k)*rho(k)
            6053     2   p    v                  nr(k) = MAX(R2, nr1d(k)*rho(k))
            6054     2   p    v                  lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            6055     2   p    v                  ilamr(k) = 1./lamr
            6056     2   p    v                  N0_r(k) = nr(k)*org2*lamr**cre(2)
            6057     2   p    v                  mvd_r(k) = (3.0 + mu_r + 0.672) * ilamr(k)
            6058     2   p    v                  L_qr(k) = .true.
            6059     2   p    v               else
            6060     2   p    v                  rr(k) = R1
            6061     2   p    v                  nr(k) = R1
            6062     2   p    v                  mvd_r(k) = 50.E-6
            6063     2   p    v                  L_qr(k) = .false.
            6064     2   p    v               endif
            6065     2   p    v               if (qs1d(k) .gt. R2) then
            6066     2   p    v                  rs(k) = qs1d(k)*rho(k)
            6067     2   p    v                  L_qs(k) = .true.
            6068     2   p    v               else
            6069     2   p    v                  rs(k) = R1
            6070     2   p    v                  L_qs(k) = .false.
            6071     2   p    v               endif
            6072     2   p    v               if (qg1d(k) .gt. R2) then
            6073     2   p    v                  rg(k) = qg1d(k)*rho(k)
            6074     2   p    v                  L_qg(k) = .true.
            6075     2   p    v               else
            6076     2   p    v                  rg(k) = R1
            6077     2   p    v                  L_qg(k) = .false.
            6078     2   p    v               endif
            6079     1   p    v            enddo
            6080                     
            6081                     !+---+-----------------------------------------------------------------+
            6082                     !..Calculate y-intercept, slope, and useful moments for snow.
            6083                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      smo2, smob, smoc, smoz
                                   <<< Loop-information  End >>>
            6084     1  pp   2v            do k = kts, kte
            6085     1   p   2v               smo2(k) = 0.
            6086     1   p   2v               smob(k) = 0.
            6087     1   p   2v               smoc(k) = 0.
            6088     1   p   2v               smoz(k) = 0.
            6089     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
            6090     1  pp    v            if (ANY(L_qs .eqv. .true.)) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qs, rs, temp, smob, smo2, smoc, smoz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 21  FILL 61
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6091     2  pp    v            do k = kts, kte
            6092     2   p    v               if (.not. L_qs(k)) CYCLE
            6093     2   p    v               tc0 = MIN(-0.1, temp(k)-273.15)
            6094     2   p    v               smob(k) = rs(k)*oams
            6095     2               
            6096     2               !..All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            6097     2               !.. then we must compute actual 2nd moment and use as reference.
            6098     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            6099     3   p    v                  smo2(k) = smob(k)
            6100     3                        else
            6101     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            6102     3                    &         + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            6103     3                    &         + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            6104     3                    &         + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            6105     3                    &         + sa(10)*bm_s*bm_s*bm_s
            6106     3                           a_ = 10.0**loga_
            6107     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            6108     3                    &         + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            6109     3                    &         + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            6110     3                    &         + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            6111     3                    &         + sb(10)*bm_s*bm_s*bm_s
            6112     3                           smo2(k) = (smob(k)/a_)**(1./b_)
            6113     3   p    v               endif
            6114     2               
            6115     2               !..Calculate bm_s+1 (th) moment.  Useful for diameter calcs.
            6116     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(1) &
            6117     2                    &         + sa(4)*tc0*cse(1) + sa(5)*tc0*tc0 &
            6118     2                    &         + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            6119     2                    &         + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            6120     2                    &         + sa(10)*cse(1)*cse(1)*cse(1)
            6121     2   p    v               a_ = 10.0**loga_
            6122     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(1) + sb(4)*tc0*cse(1) &
            6123     2                    &        + sb(5)*tc0*tc0 + sb(6)*cse(1)*cse(1) &
            6124     2                    &        + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            6125     2                    &        + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            6126     2   p    v               smoc(k) = a_ * smo2(k)**b_
            6127     2               
            6128     2               !..Calculate bm_s*2 (th) moment.  Useful for reflectivity.
            6129     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(3) &
            6130     2                    &         + sa(4)*tc0*cse(3) + sa(5)*tc0*tc0 &
            6131     2                    &         + sa(6)*cse(3)*cse(3) + sa(7)*tc0*tc0*cse(3) &
            6132     2                    &         + sa(8)*tc0*cse(3)*cse(3) + sa(9)*tc0*tc0*tc0 &
            6133     2                    &         + sa(10)*cse(3)*cse(3)*cse(3)
            6134     2   p    v               a_ = 10.0**loga_
            6135     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(3) + sb(4)*tc0*cse(3) &
            6136     2                    &        + sb(5)*tc0*tc0 + sb(6)*cse(3)*cse(3) &
            6137     2                    &        + sb(7)*tc0*tc0*cse(3) + sb(8)*tc0*cse(3)*cse(3) &
            6138     2                    &        + sb(9)*tc0*tc0*tc0 + sb(10)*cse(3)*cse(3)*cse(3)
            6139     2   p    v               smoz(k) = a_ * smo2(k)**b_
            6140     2   p    v            enddo
            6141     1                     endif
            6142                     
            6143                     !+---+-----------------------------------------------------------------+
            6144                     !..Calculate y-intercept, slope values for graupel.
            6145                     !+---+-----------------------------------------------------------------+
            6146                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
            6147     1  pp    v            if (ANY(L_qg .eqv. .true.)) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rg, ilamg, N0_g
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 2
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6148     2  pp    v            do k = kte, kts, -1
            6149     2   p    v               ygra1 = alog10(max(1.E-9, rg(k)))
            6150     2   p    v               zans1 = 3.4 + 2./7.*(ygra1+8.) + rand1
            6151     2   p    v               N0_exp = 10.**(zans1)
            6152     2   p    v               N0_exp = MAX(DBLE(gonv_min), MIN(N0_exp, DBLE(gonv_max)))
            6153     2   p    v               lam_exp = (N0_exp*am_g*cgg(1)/rg(k))**oge1
            6154     2   p    v               lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg
            6155     2   p    v               ilamg(k) = 1./lamg
            6156     2   p    v               N0_g(k) = N0_exp/(cgg(2)*lam_exp) * lamg**cge(2)
            6157     2   p    v            enddo
            6158     1                     endif
            6159                     
            6160                     !+---+-----------------------------------------------------------------+
            6161                     !..Locate K-level of start of melting (k_0 is level above).
            6162                     !+---+-----------------------------------------------------------------+
            6163                           k_0 = kts
            6164     1                     if ( melti ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6165     2                       K_LOOP:do k = kte-1, kts, -1
            6166     3                         if ((temp(k).gt.273.15) .and. L_qr(k)                         &
            6167     3                    &                            .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            6168     3                            k_0 = MAX(k+1, k_0)
            6169     3                            EXIT K_LOOP
            6170     3                         endif
            6171     2                       enddo K_LOOP
            6172     1                     endif
            6173                     !+---+-----------------------------------------------------------------+
            6174                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            6175                     !.. and non-water-coated snow and graupel when below freezing are
            6176                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            6177                     !+---+-----------------------------------------------------------------+
            6178                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qr, ze_rain, ze_snow, ze_graupel
                                   <<<      ilamr, N0_r, L_qs, smoz, L_qg, ilamg
                                   <<<      N0_g
                                   <<< Loop-information  End >>>
            6179     1  pp    v            do k = kts, kte
            6180     1   p    v               ze_rain(k) = 1.e-22
            6181     1   p    v               ze_snow(k) = 1.e-22
            6182     1   p    v               ze_graupel(k) = 1.e-22
            6183     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*crg(4)*ilamr(k)**cre(4)
            6184     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)     &
            6185     1                    &                           * (am_s/900.0)*(am_s/900.0)*smoz(k)
            6186     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)  &
            6187     1                    &                              * (am_g/900.0)*(am_g/900.0)         &
            6188     1                    &                              * N0_g(k)*cgg(4)*ilamg(k)**cge(4)
            6189     1   p    v            enddo
            6190                     
            6191                     !+---+-----------------------------------------------------------------+
            6192                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            6193                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            6194                     !.. extremely simple based on amount found above the melting level.
            6195                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            6196                     !.. routines).
            6197                     !+---+-----------------------------------------------------------------+
            6198                     
            6199     1                     if (.not. iiwarm .and. melti .and. k_0.ge.2) then
            6200     2                      do k = k_0-1, kts, -1
            6201     2               
            6202     2               !..Reflectivity contributed by melting snow
            6203     3                         if (allow_wet_snow .and. L_qs(k) .and. L_qs(k_0) ) then
            6204     3                          SR = MAX(0.01, MIN(1.0 - rs(k)/(rs(k) + rr(k)), 0.99))
            6205     3                          fmelt_s = DBLE(SR*SR)
            6206     3                          eta = 0.d0
            6207     3                          oM3 = 1./smoc(k)
            6208     3                          M0 = (smob(k)*oM3)
            6209     3                          Mrat = smob(k)*M0*M0*M0
            6210     3                          slam1 = M0 * Lam0
            6211     3                          slam2 = M0 * Lam1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6212     4                          do n = 1, nrbins
            6213     4                             x = am_s * xxDs(n)**bm_s
            6214     4                             call rayleigh_soak_wetgraupel (x, DBLE(ocms), DBLE(obms), &
            6215     4                    &              fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            6216     4                    &              CBACK, mixingrulestring_s, matrixstring_s,          &
            6217     4                    &              inclusionstring_s, hoststring_s,                    &
            6218     4                    &              hostmatrixstring_s, hostinclusionstring_s)
            6219     4                             f_d = Mrat*(Kap0*DEXP(-slam1*xxDs(n))                     &
            6220     4                    &              + Kap1*(M0*xxDs(n))**mu_s * DEXP(-slam2*xxDs(n)))
            6221     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            6222     4                          enddo
            6223     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            6224     3                         endif
            6225     2               
            6226     2               !..Reflectivity contributed by melting graupel
            6227     3                         if (allow_wet_graupel .and. L_qg(k) .and. L_qg(k_0) ) then
            6228     3                          SR = MAX(0.01, MIN(1.0 - rg(k)/(rg(k) + rr(k)), 0.99))
            6229     3                          fmelt_g = DBLE(SR*SR)
            6230     3                          eta = 0.d0
            6231     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, xdtg, simpson
                                   <<< Loop-information  End >>>
            6232     4                          do n = 1, nrbins
            6233     4                             x = am_g * xxDg(n)**bm_g
            6234     4                             call rayleigh_soak_wetgraupel (x, DBLE(ocmg), DBLE(obmg), &
            6235     4                    &              fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            6236     4                    &              CBACK, mixingrulestring_g, matrixstring_g,          &
            6237     4                    &              inclusionstring_g, hoststring_g,                    &
            6238     4                    &              hostmatrixstring_g, hostinclusionstring_g)
            6239     4                             f_d = N0_g(k)*xxDg(n)**mu_g * DEXP(-lamg*xxDg(n))
            6240     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            6241     4                          enddo
            6242     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            6243     3                         endif
            6244     2               
            6245     2                      enddo
            6246     1                     endif
            6247                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            6248     1  pp    v            do k = kte, kts, -1
            6249     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            6250     1   p    v            enddo
            6251                     
            6252                     !..Reflectivity-weighted terminal velocity (snow, rain, graupel, mix).
            6253     1                     if (do_vt_dBZ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rg, rr, rs, temp, smoc, smob, rhof
                                   <<<      ze_snow, ilamg, ze_graupel, ilamr
                                   <<<      ze_rain, vt_dBZ
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 5  FILL 57
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6254     2  pp    v               do k = kte, kts, -1
            6255     2   p    v                  vt_dBZ(k) = 1.E-3
            6256     3   p    v                  if (rs(k).gt.R2) then
            6257     3   p    v                   Mrat = smob(k) / smoc(k)
            6258     3   p    v                   ils1 = 1./(Mrat*Lam0 + fv_s)
            6259     3   p    v                   ils2 = 1./(Mrat*Lam1 + fv_s)
            6260     3   p    v                   t1_vts = Kap0*csg(5)*ils1**cse(5)
            6261     3   p    v                   t2_vts = Kap1*Mrat**mu_s*csg(11)*ils2**cse(11)
            6262     3   p    v                   ils1 = 1./(Mrat*Lam0)
            6263     3   p    v                   ils2 = 1./(Mrat*Lam1)
            6264     3   p    v                   t3_vts = Kap0*csg(6)*ils1**cse(6)
            6265     3   p    v                   t4_vts = Kap1*Mrat**mu_s*csg(12)*ils2**cse(12)
            6266     3   p    v                   vts_dbz_wt = rhof(k)*av_s * (t1_vts+t2_vts)/(t3_vts+t4_vts)
            6267     4   p    v                   if (temp(k).ge.273.15 .and. temp(k).lt.275.15) then
            6268     4   p    v                      vts_dbz_wt = vts_dbz_wt*1.5
            6269     4   p    v                   elseif (temp(k).ge.275.15) then
            6270     4   p    v                      vts_dbz_wt = vts_dbz_wt*2.0
            6271     4   p    v                   endif
            6272     3   p    v                  else
            6273     3   p    v                   vts_dbz_wt = 1.E-3
            6274     3   p    v                  endif
            6275     2               
            6276     3   p    v                  if (rr(k).gt.R1) then
            6277     3   p    v                   lamr = 1./ilamr(k)
            6278     3   p    v                   vtr_dbz_wt = rhof(k)*av_r*crg(13)*(lamr+fv_r)**(-cre(13))      &
            6279     3                                       / (crg(4)*lamr**(-cre(4)))
            6280     3   p    v                  else
            6281     3   p    v                   vtr_dbz_wt = 1.E-3
            6282     3   p    v                  endif
            6283     2               
            6284     3   p    v                  if (rg(k).gt.R2) then
            6285     3   p    v                   lamg = 1./ilamg(k)
            6286     3   p    v                   vtg_dbz_wt = rhof(k)*av_g*cgg(5)*lamg**(-cge(5))               &
            6287     3                                       / (cgg(4)*lamg**(-cge(4)))
            6288     3   p    v                  else
            6289     3   p    v                   vtg_dbz_wt = 1.E-3
            6290     3   p    v                  endif
            6291     2               
            6292     2   p    v                  vt_dBZ(k) = (vts_dbz_wt*ze_snow(k) + vtr_dbz_wt*ze_rain(k)      &
            6293     2                                        + vtg_dbz_wt*ze_graupel(k))                        &
            6294     2                                        / (ze_rain(k)+ze_snow(k)+ze_graupel(k))
            6295     2   p    v               enddo
            6296     1                     endif
            6297                     
            6298                           end subroutine calc_refl10cm
            6299                     !
            6300                     !-------------------------------------------------------------------
            6301                           SUBROUTINE semi_lagrange_sedim(km,dzl,wwl,rql,precip,pfsan,dt,R1)
            6302                     !-------------------------------------------------------------------
            6303                     !
            6304                     ! This routine is a semi-Lagrangain forward advection for hydrometeors
            6305                     ! with mass conservation and positive definite advection
            6306                     ! 2nd order interpolation with monotonic piecewise parabolic method is used.
            6307                     ! This routine is under assumption of decfl < 1 for semi_Lagrangian
            6308                     !
            6309                     ! dzl    depth of model layer in meter
            6310                     ! wwl    terminal velocity at model layer m/s
            6311                     ! rql    dry air density*mixing ratio
            6312                     ! precip precipitation at surface
            6313                     ! dt     time step
            6314                     !
            6315                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            6316                     !         implemented by song-you hong
            6317                     ! reference: Juang, H.-M., and S.-Y. Hong, 2010: Forward semi-Lagrangian advection
            6318                     !         with mass conservation and positive definiteness for falling
            6319                     !         hydrometeors. *Mon.  Wea. Rev.*, *138*, 1778-1791
            6320                     !
            6321                           implicit none
            6322                     
            6323                           integer, intent(in) :: km
            6324                           real, intent(in) ::  dt, R1
            6325                           real, intent(in) :: dzl(km),wwl(km)
            6326                           real, intent(out) :: precip
            6327                           real, intent(inout) :: rql(km)
            6328                           real, intent(out)  :: pfsan(km)
            6329                           integer  k,m,kk,kb,kt
            6330                           real  tl,tl2,qql,dql,qqd
            6331                           real  th,th2,qqh,dqh
            6332                           real  zsum,qsum,dim,dip,con1,fa1,fa2
            6333                           real  allold, decfl
            6334                           real  dz(km), ww(km), qq(km)
            6335                           real  wi(km+1), zi(km+1), za(km+2)
            6336                           real  qn(km)
            6337                           real  dza(km+1), qa(km+1), qmi(km+1), qpi(km+1)
            6338                           real  net_flx(km)
            6339                     !
            6340                           precip = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa
                                   <<< Loop-information  End >>>
            6341        pp   4v            qa(:) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, dz, wwl, dzl, qq
                                   <<< Loop-information  End >>>
            6342        pp   2v            qq(:) = 0.0
            6343         p   2v            dz(:) = dzl(:)
            6344         p   2v            ww(:) = wwl(:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rql, net_flx, ww, qq, pfsan
                                   <<< Loop-information  End >>>
            6345     1  pp   2v            do k = 1,km
            6346     2   p   2v              if(rql(k).gt.R1) then
            6347     2   p   2v                qq(k) = rql(k)
            6348     2   p   2v              else
            6349     2   p   2v                ww(k) = 0.0
            6350     2   p   2v              endif
            6351     1   p   2v              pfsan(k) = 0.0
            6352     1   p   2v              net_flx(k) = 0.0
            6353     1   p   2v            enddo
            6354                     ! skip for no precipitation for all layers
            6355                           allold = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6356     1  pp    v            do k=1,km
            6357     1   p    v              allold = allold + qq(k)
            6358     1   p    v            enddo
            6359     1                     if(allold.le.0.0) then
            6360     1                        return
            6361     1                     endif
            6362                     !
            6363                     ! compute interface values
            6364                           zi(1)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi
                                   <<< Loop-information  End >>>
            6365     1   s   2s            do k=1,km
            6366     1   s   2s              zi(k+1) = zi(k)+dz(k)
            6367     1   s   2s            enddo
            6368                     !     n=1
            6369                     ! plm is 2nd order, we can use 2nd order wi or 3rd order wi
            6370                     ! 2nd order interpolation to get wi
            6371                           wi(1) = ww(1)
            6372                           wi(km+1) = ww(km)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, ww, wi
                                   <<< Loop-information  End >>>
            6373     1  pp   2v            do k=2,km
            6374     1   p   2v              wi(k) = (ww(k)*dz(k-1)+ww(k-1)*dz(k))/(dz(k-1)+dz(k))
            6375     1   p   2v            enddo
            6376                     ! 3rd order interpolation to get wi
            6377                           fa1 = 9./16.
            6378                           fa2 = 1./16.
            6379                           wi(1) = ww(1)
            6380                           wi(2) = 0.5*(ww(2)+ww(1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            6381     1  pp   2v            do k=3,km-1
            6382     1   p   2v              wi(k) = fa1*(ww(k)+ww(k-1))-fa2*(ww(k+1)+ww(k-2))
            6383     1   p   2v            enddo
            6384                           wi(km) = 0.5*(ww(km)+ww(km-1))
            6385                           wi(km+1) = ww(km)
            6386                     
            6387                     ! terminate of top of raingroup
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            6388     1  pp   2v            do k=2,km
            6389     1   p   2v              if( ww(k).eq.0.0 ) wi(k)=ww(k-1)
            6390     1   p   2v            enddo
            6391                     
            6392                     ! diffusivity of wi
            6393                           con1 = 0.05
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, dz
                                   <<< Loop-information  End >>>
            6394     1   s   2s            do k=km,1,-1
            6395     1   m   2m              decfl = (wi(k+1)-wi(k))*dt/dz(k)
            6396     2   s   2s              if( decfl .gt. con1 ) then
            6397     2   s   2s                wi(k) = wi(k+1) - con1*dz(k)/dt
            6398     2   p   2v              endif
            6399     1   p   2v            enddo
            6400                     ! compute arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, zi, za
                                   <<< Loop-information  End >>>
            6401     1  pp   2v            do k=1,km+1
            6402     1   p   2v              za(k) = zi(k) - wi(k)*dt
            6403     1   p   2v            enddo
            6404                           za(km+2) = zi(km+1)
            6405                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za, dza
                                   <<< Loop-information  End >>>
            6406     1  pp   2v            do k=1,km+1
            6407     1   p   2v              dza(k) = za(k+1)-za(k)
            6408     1   p   2v            enddo
            6409                     
            6410                     ! computer deformation at arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qq, dza, qa
                                   <<< Loop-information  End >>>
            6411     1  pp   2v            do k=1,km
            6412     1   p   2v              qa(k) = qq(k)*dz(k)/dza(k)
            6413     1   p   2v            enddo
            6414                           qa(km+1) = 0.0
            6415                     
            6416                     ! estimate values at arrival cell interface with monotone
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qmi, qpi
                                   <<< Loop-information  End >>>
            6417     1  pp    v            do k=2,km
            6418     1   p    v              dip=(qa(k+1)-qa(k))/(dza(k+1)+dza(k))
            6419     1   p    v              dim=(qa(k)-qa(k-1))/(dza(k-1)+dza(k))
            6420     2   p    v              if( dip*dim.le.0.0 ) then
            6421     2   p    v                qmi(k)=qa(k)
            6422     2   p    v                qpi(k)=qa(k)
            6423     2   p    v              else
            6424     2   p    v                qpi(k)=qa(k)+0.5*(dip+dim)*dza(k)
            6425     2   p    v                qmi(k)=2.0*qa(k)-qpi(k)
            6426     3   p    v                if( qpi(k).lt.0.0 .or. qmi(k).lt.0.0 ) then
            6427     3   p    v                  qpi(k) = qa(k)
            6428     3   p    v                  qmi(k) = qa(k)
            6429     3   p    v                endif
            6430     2   p    v              endif
            6431     1   p    v            enddo
            6432                           qpi(1)=qa(1)
            6433                           qmi(1)=qa(1)
            6434                           qmi(km+1)=qa(km+1)
            6435                           qpi(km+1)=qa(km+1)
            6436                     
            6437                     ! interpolation to regular point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            6438        pp   4v            qn = 0.0
            6439                           kb=1
            6440                           kt=1
            6441     1                     intp : do k=1,km
            6442     1                            kb=max(kb-1,1)
            6443     1                            kt=max(kt-1,1)
            6444     1               ! find kb and kt
            6445     2                            if( zi(k).ge.za(km+1) ) then
            6446     2                              exit intp
            6447     2                            else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            6448     3                              find_kb : do kk=kb,km
            6449     4                                        if( zi(k).le.za(kk+1) ) then
            6450     4                                          kb = kk
            6451     4                                          exit find_kb
            6452     4                                        else
            6453     4                                          cycle find_kb
            6454     4                                        endif
            6455     3                              enddo find_kb
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            6456     3                              find_kt : do kk=kt,km+2
            6457     4                                        if( zi(k+1).le.za(kk) ) then
            6458     4                                          kt = kk
            6459     4                                          exit find_kt
            6460     4                                        else
            6461     4                                          cycle find_kt
            6462     4                                        endif
            6463     3                              enddo find_kt
            6464     2                              kt = kt - 1
            6465     2               ! compute q with piecewise constant method
            6466     3                              if( kt.eq.kb ) then
            6467     3                                tl=(zi(k)-za(kb))/dza(kb)
            6468     3                                th=(zi(k+1)-za(kb))/dza(kb)
            6469     3                                tl2=tl*tl
            6470     3                                th2=th*th
            6471     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            6472     3                                qqh=qqd*th2+qmi(kb)*th
            6473     3                                qql=qqd*tl2+qmi(kb)*tl
            6474     3                                qn(k) = (qqh-qql)/(th-tl)
            6475     3                              else if( kt.gt.kb ) then
            6476     3                                tl=(zi(k)-za(kb))/dza(kb)
            6477     3                                tl2=tl*tl
            6478     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            6479     3                                qql=qqd*tl2+qmi(kb)*tl
            6480     3                                dql = qa(kb)-qql
            6481     3                                zsum  = (1.-tl)*dza(kb)
            6482     3                                qsum  = dql*dza(kb)
            6483     4                                if( kt-kb.gt.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6484     5  pp    v                       do m=kb+1,kt-1
            6485     5   p    v                         zsum = zsum + dza(m)
            6486     5   p    v                         qsum = qsum + qa(m) * dza(m)
            6487     5   p    v                       enddo
            6488     4                                endif
            6489     3                                th=(zi(k+1)-za(kt))/dza(kt)
            6490     3                                th2=th*th
            6491     3                                qqd=0.5*(qpi(kt)-qmi(kt))
            6492     3                                dqh=qqd*th2+qmi(kt)*th
            6493     3                                zsum  = zsum + th*dza(kt)
            6494     3                                qsum  = qsum + dqh*dza(kt)
            6495     3                                qn(k) = qsum/zsum
            6496     3                              endif
            6497     2                              cycle intp
            6498     2                            endif
            6499     1               
            6500     1                      enddo intp
            6501                     
            6502                     ! rain out
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            6503     1                     sum_precip: do k=1,km
            6504     2                                   if( za(k).lt.0.0 .and. za(k+1).le.0.0 ) then
            6505     2                                     precip = precip + qa(k)*dza(k)
            6506     2                                     net_flx(k) =  qa(k)*dza(k)
            6507     2                                     cycle sum_precip
            6508     2                                   else if ( za(k).lt.0.0 .and. za(k+1).gt.0.0 ) then
            6509     2                                     th = (0.0-za(k))/dza(k)
            6510     2                                     th2 = th*th
            6511     2                                     qqd = 0.5*(qpi(k)-qmi(k))
            6512     2                                     qqh = qqd*th2+qmi(k)*th
            6513     2                                     precip = precip + qqh*dza(k)
            6514     2                                     net_flx(k) = qqh*dza(k)
            6515     2                                     exit sum_precip
            6516     2                                   endif
            6517     1                                   exit sum_precip
            6518     1                     enddo sum_precip
            6519                     
            6520                     ! calculating precipitation fluxes
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      net_flx, pfsan
                                   <<< Loop-information  End >>>
            6521     1   s   2s            do k=km,1,-1
            6522     2   p   2v               if(k == km) then
            6523     2   m   2v                 pfsan(k) = net_flx(k)
            6524     2   p   2v               else
            6525     2   m   2s                 pfsan(k) = pfsan(k+1) + net_flx(k)
            6526     2   p   2v               end if
            6527     1   p   2v            enddo
            6528                     !
            6529                     ! replace the new values
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 176, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn, rql
                                   <<< Loop-information  End >>>
            6530        pp   2v            rql(:) = max(qn(:),R1)
            6531                     
            6532                           END SUBROUTINE semi_lagrange_sedim
            6533                     
            6534                     !+---+-----------------------------------------------------------------+
            6535                     
            6536                     
            6537                     !+---+-----------------------------------------------------------------+
            6538                     !> Cloud fraction scheme by G. Thompson (NCAR-RAL), not intended for
            6539                     !! combining with any cumulus or shallow cumulus parameterization
            6540                     !! scheme cloud fractions.  This is intended as a stand-alone for
            6541                     !! cloud fraction and is relatively good at getting widespread stratus
            6542                     !! and stratoCu without caring whether any deep/shallow Cu param schemes
            6543                     !! is making sub-grid-spacing clouds/precip.  Under the hood, this
            6544                     !! scheme follows Mocko and Cotton (1995) in application of the
            6545                     !! Sundqvist et al (1989) scheme but using a grid-scale dependent
            6546                     !! RH threshold, one each for land v. ocean points based on
            6547                     !! experiences with HWRF testing.
            6548                           SUBROUTINE cal_cldfra3 ( ims, ime, its, ite, kms, kme, kts, kte,  &
            6549                          &                 cldfra, qv, qc, qi, qs, dz,                      &
            6550                          &                 p, t, XLAND, gridkm,                             &
            6551                          &                 modify_qvapor, max_relh, debug_flag )
            6552                     !
            6553                     !      USE module_mp_thompson_new   , ONLY : rsif, rslf
            6554                           IMPLICIT NONE
            6555                     !
            6556                           INTEGER, INTENT(IN):: ims, ime
            6557                           INTEGER, INTENT(IN):: its, ite
            6558                           INTEGER, INTENT(IN):: kms, kme
            6559                           INTEGER, INTENT(IN):: kts, kte
            6560                           LOGICAL, INTENT(IN):: modify_qvapor
            6561                           REAL, DIMENSION(ims:ime,kms:kme), INTENT(INOUT):: qv, qc, qi, cldfra
            6562                           REAL, DIMENSION(ims:ime,kms:kme), INTENT(IN):: p, t, dz, qs
            6563                           REAL, DIMENSION(ims:ime), INTENT(IN):: gridkm, XLAND!, max_relh
            6564                           REAL, INTENT(IN) :: max_relh
            6565                           LOGICAL, INTENT(IN):: debug_flag
            6566                     
            6567                     !..Local vars.
            6568                           REAL:: RH_00L, RH_00O, RH_00
            6569                           REAL:: entrmnt=0.5
            6570                           INTEGER:: i,k
            6571                           REAL:: TC, qvsi, qvsw, RHUM, delz, var_temp
            6572                           REAL, DIMENSION(kts:kte):: qvs, rh, rhoa
            6573                           REAL, DIMENSION(kts:kte):: cldfra1d, t1d, p1d, dz1d,              &
            6574                                                      qc1d, qi1d, qs1d
            6575                           integer:: ndebug = 0
            6576                     
            6577                           character*512 dbg_msg
            6578                     
            6579                     !+---+
            6580                     
            6581                     !..Initialize cloud fraction, compute RH, and rho-air.
            6582                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoa, cldfra1d, qvs, rh, qi1d, qc1d
                                   <<< Loop-information  End >>>
            6583     1                     DO i = its,ite
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 84
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoa, qvs, rh, cldfra1d
                                   <<< Loop-information  End >>>
            6584     2  pp    v               DO k = kts,kte
            6585     2   p    v                  cldfra1d(k) = 0.0
            6586     2               
            6587     2   pi   v                  qvsw = rslf(P(i,k), t(i,k))
            6588     2   pi   v                  qvsi = rsif(P(i,k), t(i,k))
            6589     2               
            6590     2   p    v                  tc = t(i,k) - 273.15
            6591     3   p    v                  if (tc .ge. -12.0) then
            6592     3   p    v                     qvs(k) = qvsw
            6593     3   p    v                  elseif (tc .lt. -35.0) then
            6594     3   p    v                     qvs(k) = qvsi
            6595     3   p    v                  else
            6596     3   p    v                     qvs(k) = qvsw - (qvsw-qvsi)*(-12.0-tc)/(-12.0+35.)
            6597     3   p    v                  endif
            6598     2               
            6599     3   p    v                  if (modify_qvapor) then
            6600     4   p    v                     if (qc(i,k).gt.1.E-8) then
            6601     4   p    v                        qv(i,k) = MAX(qv(i,k), qvsw)
            6602     4   p    v                        qvs(k) = qvsw
            6603     4   p    v                     endif
            6604     4   p    v                     if (qc(i,k).le.1.E-8 .and. qi(i,k).ge.1.E-9) then
            6605     4   p    v                        qv(i,k) = MAX(qv(i,k), qvsi*1.005)    !..To ensure a tiny bit ice supersaturated
            6606     4   p    v                        qvs(k) = qvsi
            6607     4   p    v                     endif
            6608     3   p    v                  endif
            6609     2               
            6610     2   p    v                  rh(k) = MAX(0.01, qv(i,k)/qvs(k))
            6611     2   p    v                  rhoa(k) = p(i,k)/(287.0*t(i,k))
            6612     2               
            6613     2   p    v               ENDDO
            6614     1               
            6615     1               
            6616     1               !..First cut scale-aware. Higher resolution should require closer to
            6617     1               !.. saturated grid box for higher cloud fraction.  Simple functions
            6618     1               !.. chosen based on Mocko and Cotton (1995) starting point and desire
            6619     1               !.. to get near 100% RH as grid spacing moves toward 1.0km, but higher
            6620     1               !.. RH over ocean required as compared to over land.
            6621     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 28
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfra1d, dz1d, qc1d, t1d, p1d, qi1d
                                   <<<      qs1d
                                   <<< Loop-information  End >>>
            6622     2  pp    s               DO k = kts,kte
            6623     2               
            6624     2   p    v                 delz = MAX(100., dz(i,k))
            6625     2   p    v                 RH_00L = 0.77 + MIN(0.22,&
            6626     2                                   SQRT(1./(50.0+gridkm(i)*gridkm(i)*delz*0.01)))
            6627     2   p    v                 RH_00O = 0.85 + MIN(0.14,&
            6628     2                                   SQRT(1./(50.0+gridkm(i)*gridkm(i)*delz*0.01)))
            6629     2   p    v                 RHUM = rh(k)
            6630     2               
            6631     3   p    m                 if (qc(i,k).ge.1.E-6 .or. qi(i,k).ge.1.E-7                     &
            6632     3                    &                .or. (qs(i,k).gt.1.E-6 .and. t(i,k).lt.273.)) then
            6633     3   p    s                   cldfra1d(K) = 1.0
            6634     3   p    s                 elseif (((qc(i,k)+qi(i,k)).gt.1.E-10) .and.                    &
            6635     3                    &             ((qc(i,k)+qi(i,k)).lt.1.E-6)) then
            6636     3   p    s                   var_temp = MIN(0.99, 0.1*(11.0 + log10(qc(i,k)+qi(i,k))))
            6637     3   p    s                   cldfra1d(K) = var_temp*var_temp
            6638     3   p    s                 else
            6639     3               
            6640     4   p    s                   IF ((XLAND(i)-1.5).GT.0.) THEN                                  !--- Ocean
            6641     4   p    s                     RH_00 = RH_00O
            6642     4   p    s                   ELSE                                                         !--- Land
            6643     4   p    s                     RH_00 = RH_00L
            6644     4   p    s                   ENDIF
            6645     3               
            6646     3   p    s                   tc = MAX(-80.0, t(i,k) - 273.15)
            6647     3   p    s                   if (tc .lt. -24.0) RH_00 = RH_00L
            6648     3               
            6649     4   p    s                   if (tc .gt. 20.0) then
            6650     4   p    s                     cldfra1d(K) = 0.0
            6651     4   p    s                   elseif (tc .ge. -24.0) then
            6652     4   p    s                     RHUM = MIN(rh(k), 1.0)
            6653     4   p    s                     var_temp = SQRT(SQRT((1.001-RHUM)/(1.001-RH_00)))
            6654     4   p    s                     cldfra1d(K) = MAX(0., 1.0-var_temp)
            6655     4   p    s                   else
            6656     5   p    s                     if (max_relh.gt.1.12 .or. (.NOT.(modify_qvapor)) ) then
            6657     5               !..For HRRR model, the following look OK.
            6658     5   p    s                        RHUM = MIN(rh(k), 1.45)
            6659     5   p    s                        RH_00 = RH_00 + (1.45-RH_00)*(-24.0-tc)/(-24.0+85.)
            6660     5   p    s                        var_temp = SQRT(SQRT((1.46-RHUM)/(1.46-RH_00)))
            6661     5   p    s                        cldfra1d(K) = MAX(0., 1.0-var_temp)
            6662     5                              else
            6663     5               !..but for the GFS model, RH is way lower.
            6664     5                                 RHUM = MIN(rh(k), 1.05)
            6665     5                                 RH_00 = RH_00 + (1.05-RH_00)*(-24.0-tc)/(-24.0+85.)
            6666     5                                 var_temp = SQRT(SQRT((1.06-RHUM)/(1.06-RH_00)))
            6667     5                                 cldfra1d(K) = MAX(0., 1.0-var_temp)
            6668     5   p    s                     endif
            6669     4   p    s                   endif
            6670     3   p    s                   if (cldfra1d(K).gt.0.) cldfra1d(K)=MAX(0.01,MIN(cldfra1d(K),0.99))
            6671     3               
            6672     3   p    v                 endif
            6673     2   p    m                 if (cldfra1d(k).gt.0.0 .and. p(i,k).lt.7000.0) cldfra1d(K) = 0.0
            6674     2   p    v                 t1d(k)  = t(i,k)
            6675     2   p    v                 p1d(k)  = p(i,k)
            6676     2   p    v                 dz1d(k) = dz(i,k)
            6677     2   p    v                 qc1d(k) = qc(i,k)
            6678     2   p    v                 qi1d(k) = qi(i,k)
            6679     2   p    v                 qs1d(k) = qs(i,k)
            6680     2               
            6681     2   p    v               ENDDO
            6682     1               
            6683     1                        call find_cloudLayers(qvs, cldfra1d, t1d, p1d, dz1d, entrmnt,  &
            6684     1                    &                      debug_flag, qc1d, qi1d, qs1d, kts,kte)
            6685     1               
            6686     1               !..Do a final total column adjustment since we may have added more than 1 mm
            6687     1               !.. LWP/IWP for multiple cloud decks.
            6688     1               
            6689     1                        call adjust_cloudFinal(cldfra1d, qc1d, qi1d, rhoa, dz1d,       &
            6690     1                                           kts,kte)
            6691     1               
            6692     1               !..Intended for cold start model runs, we use modify_qvapor to ensure that cloudy
            6693     1               !.. areas are actually saturated such that the inserted clouds do not evaporate a
            6694     1               !.. timestep later.
            6695     1               
            6696     2                        if (modify_qvapor) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.37, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvs, cldfra1d
                                   <<< Loop-information  End >>>
            6697     3  pp   2v                 DO k = kts,kte
            6698     4   p   2v                   if (cldfra1d(k).gt.0.2 .and. cldfra1d(k).lt.1.0) then
            6699     4   p   2v                     qv(i,k) = MAX(qv(i,k),qvs(k))
            6700     4   p   2v                   endif
            6701     3   p   2v                 ENDDO
            6702     2                        endif
            6703     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfra1d, qi1d, qc1d
                                   <<< Loop-information  End >>>
            6704     2  pp    v               DO k = kts,kte
            6705     2   p    v                 qc(i,k) = qc1d(k)
            6706     2   p    v                 qi(i,k) = qi1d(k)
            6707     3   p    v                 if ( cldfra1d(k) .lt. 0. ) then
            6708     3   p    v                   cldfra(i,k) = 0.
            6709     3   p    v                 elseif ( cldfra1d(k) .gt. 1. ) then
            6710     3   p    v                   cldfra(i,k) = 1.
            6711     3   p    v                 else
            6712     3   p    v                   cldfra(i,k) = cldfra1d(k)
            6713     3   p    v                 endif
            6714     2   p    v               ENDDO
            6715     1               
            6716     1                     ENDDO !end of do i=its,ite
            6717                     
            6718                     !...................................                                    !
            6719                           END SUBROUTINE cal_cldfra3
            6720                     !-----------------------------------                                    !
            6721                     
            6722                     
            6723                     !-----------------------------------                                    !
            6724                     !>From cloud fraction array, find clouds of multi-level depth and compute
            6725                     !! a reasonable value of LWP or IWP that might be contained in that depth,
            6726                     !! unless existing LWC/IWC is already there.
            6727                           SUBROUTINE find_cloudLayers(qvs1d, cfr1d, T1d, P1d, Dz1d, entrmnt,&
            6728                          &                            debugfl, qc1d, qi1d, qs1d, kts,kte)
            6729                     !
            6730                           IMPLICIT NONE
            6731                     !
            6732                           INTEGER, INTENT(IN):: kts, kte
            6733                           LOGICAL, INTENT(IN):: debugfl
            6734                           REAL, INTENT(IN):: entrmnt
            6735                           REAL, DIMENSION(kts:kte), INTENT(IN):: qs1d,qvs1d,T1d,P1d,Dz1d
            6736                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: cfr1d, qc1d, qi1d
            6737                     
            6738                     !..Local vars.
            6739                           REAL, DIMENSION(kts:kte):: theta
            6740                           REAL:: theta1, theta2, delz
            6741                           INTEGER:: k, k2, k_tropo, k_m12C, k_cldb, k_cldt, kbot, k_p200
            6742                           LOGICAL:: in_cloud
            6743                           character*512 dbg_msg
            6744                     
            6745                     !+---+
            6746                     
            6747                           k_m12C = 0
            6748                           k_p200 = 0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<< Loop-information  End >>>
            6749     1   m    s            DO k = kte, kts, -1
            6750     1   p    v               theta(k) = T1d(k)*((100000.0/P1d(k))**(287.05/1004.))
            6751     1   p                    if (T1d(k)-273.16 .gt. -12.0 .and. P1d(k).gt.10100.0)          &
            6752     1                    &                   k_m12C = MAX(k_m12C, k)
            6753     1   m    v               if (P1d(k).gt.19999.0 .and. k_p200.eq.0) k_p200 = k
            6754     1   p    v            ENDDO
            6755                           if (k_m12C .le. kts) k_m12C = kts
            6756                     
            6757                     !..Find tropopause height, best surrogate, because we would not really
            6758                     !.. wish to put fake clouds into the stratosphere.  The 10/1500 ratio
            6759                     !.. d(Theta)/d(Z) approximates a vertical line on typical SkewT chart
            6760                     !.. near typical (mid-latitude) tropopause height.  Since messy data
            6761                     !.. could give us a false signal of such a transition, do the check over
            6762                     !.. three K-level change, not just a level-to-level check.  This method
            6763                     !.. has potential failure in arctic-like conditions with extremely low
            6764                     !.. tropopause height, as would any other diagnostic, so ensure resulting
            6765                     !.. k_tropo level is above 700hPa.
            6766                     
            6767                           if ( (kte-k_p200) .lt. 3) k_p200 = kte-3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dz1d, theta
                                   <<< Loop-information  End >>>
            6768     1        s            DO k = k_p200-2, kts, -1
            6769     1        s               theta1 = theta(k)
            6770     1        s               theta2 = theta(k+2)
            6771     1        s               delz = 0.5*dz1d(k) + dz1d(k+1) + 0.5*dz1d(k+2)
            6772     1        s               if ( (((theta2-theta1)/delz).lt.10./1500.) .OR.                &
            6773     1                    &                       P1d(k).gt.70000.) EXIT
            6774     1        s            ENDDO
            6775                           k_tropo = MAX(kts+2, MIN(k+2, kte-1))
            6776                     
            6777     1                     if (k_tropo .gt. k_p200) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dz1d, theta
                                   <<< Loop-information  End >>>
            6778     2                        DO k = kte-3, k_p200-2, -1
            6779     2                           theta1 = theta(k)
            6780     2                           theta2 = theta(k+2)
            6781     2                           delz = 0.5*dz1d(k) + dz1d(k+1) + 0.5*dz1d(k+2)
            6782     2                           if ( (((theta2-theta1)/delz).lt.10./1500.) .AND.            &
            6783     2                    &                                    P1d(k).gt.9000.) EXIT
            6784     2                        ENDDO
            6785     1                        k_tropo = MAX(k_p200-1, MIN(k+2, kte-1))
            6786     1                     endif
            6787                     
            6788                     !..Eliminate possible fractional clouds above supposed tropopause.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.83, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            6789     1  pp   2v            DO k = k_tropo+1, kte
            6790     2   p   2v               if (cfr1d(k).gt.0.0 .and. cfr1d(k).lt.1.0) then
            6791     2   p   2v                  cfr1d(k) = 0.
            6792     2   p   2v               endif
            6793     1   p   2v            ENDDO
            6794                     
            6795                     !..Be a bit more conservative with lower cloud fraction in scenario with
            6796                     !.. well-mixed convective boundary layer below LCL.
            6797                     
            6798                           kbot = kts+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      theta, Dz1d
                                   <<< Loop-information  End >>>
            6799     1                     DO k = kbot, k_m12C
            6800     1                        if ( (theta(k)-theta(k-1)) .gt. 0.010E-3*Dz1d(k)) EXIT
            6801     1                     ENDDO
            6802                           kbot = MAX(kts+1, k-2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            6803     1  pp   2v            DO k = kts, kbot
            6804     1   p   2v               if (cfr1d(k).gt.0.0 .and. cfr1d(k).lt.1.0)                     &
            6805     1                    &              cfr1d(k) = MAX(0.01,0.33*cfr1d(k))
            6806     1   p   2v            ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<< Loop-information  End >>>
            6807     1  pp    s            DO k = kts,k_tropo
            6808     1   p                    if (cfr1d(k).gt.0.0) kbot = MIN(k,kbot)
            6809     1   p    v            ENDDO
            6810                     
            6811                     !..Starting below tropo height, if cloud fraction greater than 1 percent,
            6812                     !.. compute an approximate total layer depth of cloud, determine a total
            6813                     !.. liquid water/ice path (LWP/IWP), then reduce that amount with tuning
            6814                     !.. parameter to represent entrainment factor, then divide up LWP/IWP
            6815                     !.. into delta-Z weighted amounts for individual levels per cloud layer.
            6816                     
            6817                           k_cldb = k_tropo
            6818                           in_cloud = .false.
            6819                           k = k_tropo
            6820     1                     DO WHILE (.not. in_cloud .AND. k.gt.k_m12C+1)
            6821     1                        k_cldt = 0
            6822     2                        if (cfr1d(k).ge.0.01) then
            6823     2                           in_cloud = .true.
            6824     2                           k_cldt = MAX(k_cldt, k)
            6825     2                        endif
            6826     2                        if (in_cloud) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            6827     3                           DO k2 = k_cldt-1, k_m12C, -1
            6828     4                              if (cfr1d(k2).lt.0.01 .or. k2.eq.k_m12C) then
            6829     4                                 k_cldb = k2+1
            6830     4                                 goto 87
            6831     4                              endif
            6832     3                           ENDDO
            6833     2                87         continue
            6834     2                           in_cloud = .false.
            6835     2                        endif
            6836     2                        if ((k_cldt - k_cldb + 1) .ge. 2) then
            6837     2                           call adjust_cloudIce(cfr1d, qi1d, qs1d, qvs1d, T1d, Dz1d,   &
            6838     2                    &                           entrmnt, k_cldb,k_cldt,kts,kte)
            6839     2                           k = k_cldb
            6840     2                        elseif ((k_cldt - k_cldb + 1) .eq. 1) then
            6841     2                           if (cfr1d(k_cldb).gt.0.and.cfr1d(k_cldb).lt.1.)             &
            6842     2                    &        qi1d(k_cldb)=qi1d(k_cldb)+0.05*qvs1d(k_cldb)*cfr1d(k_cldb)
            6843     2                           k = k_cldb
            6844     2                        endif
            6845     1                        k = k - 1
            6846     1                     ENDDO
            6847                     
            6848                           k_cldb = k_m12C + 3
            6849                           in_cloud = .false.
            6850                           k = k_m12C + 2
            6851     1                     DO WHILE (.not. in_cloud .AND. k.gt.kbot)
            6852     1                        k_cldt = 0
            6853     2                        if (cfr1d(k).ge.0.01) then
            6854     2                           in_cloud = .true.
            6855     2                           k_cldt = MAX(k_cldt, k)
            6856     2                        endif
            6857     2                        if (in_cloud) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            6858     3                           DO k2 = k_cldt-1, kbot, -1
            6859     4                              if (cfr1d(k2).lt.0.01 .or. k2.eq.kbot) then
            6860     4                                 k_cldb = k2+1
            6861     4                                 goto 88
            6862     4                              endif
            6863     3                           ENDDO
            6864     2                88         continue
            6865     2                           in_cloud = .false.
            6866     2                        endif
            6867     2                        if ((k_cldt - k_cldb + 1) .ge. 2) then
            6868     2                           call adjust_cloudH2O(cfr1d, qc1d, qvs1d, T1d, Dz1d,         &
            6869     2                    &                           entrmnt, k_cldb,k_cldt,kts,kte)
            6870     2                           k = k_cldb
            6871     2                        elseif ((k_cldt - k_cldb + 1) .eq. 1) then
            6872     2                           if (cfr1d(k_cldb).gt.0.and.cfr1d(k_cldb).lt.1.)             &
            6873     2                    &        qc1d(k_cldb)=qc1d(k_cldb)+0.05*qvs1d(k_cldb)*cfr1d(k_cldb)
            6874     2                           k = k_cldb
            6875     2                        endif
            6876     1                        k = k - 1
            6877     1                     ENDDO
            6878                     
            6879                     
            6880                           END SUBROUTINE find_cloudLayers
            6881                     
            6882                     
            6883                     !+---+-----------------------------------------------------------------+
            6884                     
            6885                     !>
            6886                           SUBROUTINE adjust_cloudIce(cfr,qi,qs,qvs,T,dz,entr, k1,k2,kts,kte)
            6887                     !
            6888                           IMPLICIT NONE
            6889                     !
            6890                           INTEGER, INTENT(IN):: k1,k2, kts,kte
            6891                           REAL, INTENT(IN):: entr
            6892                           REAL, DIMENSION(kts:kte), INTENT(IN):: cfr, qs, qvs, T, dz
            6893                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qi
            6894                           REAL:: iwc, max_iwc, tdz, this_iwc, this_dz
            6895                           INTEGER:: k
            6896                     
            6897                           tdz = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6898     1  pp    v            do k = k1, k2
            6899     1   p    v               tdz = tdz + dz(k)
            6900     1   p    v            enddo
            6901                     !     max_iwc = ABS(qvs(k2)-qvs(k1))
            6902                           max_iwc = MAX(0.0, qvs(k1)-qvs(k2))
            6903                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, qs
                                   <<< Loop-information  End >>>
            6904     1   s   2s            do k = k1, k2
            6905     1   m   2m               max_iwc = MAX(1.E-6, max_iwc - (qi(k)+qs(k)))
            6906     1   p   2v            enddo
            6907                           max_iwc = MIN(1.E-4, max_iwc)
            6908                     
            6909                           this_dz = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, cfr
                                   <<< Loop-information  End >>>
            6910     1   s    s            do k = k1, k2
            6911     2   p    v               if (k.eq.k1) then
            6912     2   m    m                  this_dz = this_dz + 0.5*dz(k)
            6913     2   p    v               else
            6914     2   m    s                  this_dz = this_dz + dz(k)
            6915     2   p    v               endif
            6916     1   s    s               this_iwc = max_iwc*this_dz/tdz
            6917     1   p    v               iwc = MAX(1.E-6, this_iwc*(1.-entr))
            6918     2   p    v               if (cfr(k).gt.0.0.and.cfr(k).lt.1.0.and.T(k).ge.203.16) then
            6919     2   p    v                  qi(k) = qi(k) + cfr(k)*cfr(k)*iwc
            6920     2   p    v               endif
            6921     1   p    v            enddo
            6922                     
            6923                           END SUBROUTINE adjust_cloudIce
            6924                     
            6925                     !+---+-----------------------------------------------------------------+
            6926                     
            6927                     !>
            6928                           SUBROUTINE adjust_cloudH2O(cfr, qc, qvs,T,dz,entr, k1,k2,kts,kte)
            6929                     !
            6930                           IMPLICIT NONE
            6931                     !
            6932                           INTEGER, INTENT(IN):: k1,k2, kts,kte
            6933                           REAL, INTENT(IN):: entr
            6934                           REAL, DIMENSION(kts:kte), INTENT(IN):: cfr, qvs, T, dz
            6935                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qc
            6936                           REAL:: lwc, max_lwc, tdz, this_lwc, this_dz
            6937                           INTEGER:: k
            6938                     
            6939                           tdz = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6940     1  pp    v            do k = k1, k2
            6941     1   p    v               tdz = tdz + dz(k)
            6942     1   p    v            enddo
            6943                     !     max_lwc = ABS(qvs(k2)-qvs(k1))
            6944                           max_lwc = MAX(0.0, qvs(k1)-qvs(k2))
            6945                     !     print*, ' max_lwc = ', max_lwc, ' over DZ=',tdz
            6946                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qc
                                   <<< Loop-information  End >>>
            6947     1   s   2s            do k = k1, k2
            6948     1   s   2s               max_lwc = MAX(1.E-6, max_lwc - qc(k))
            6949     1   s   2s            enddo
            6950                           max_lwc = MIN(1.E-4, max_lwc)
            6951                     
            6952                           this_dz = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, cfr
                                   <<< Loop-information  End >>>
            6953     1   s    s            do k = k1, k2
            6954     2   p    v               if (k.eq.k1) then
            6955     2   m    m                  this_dz = this_dz + 0.5*dz(k)
            6956     2   p    v               else
            6957     2   m    s                  this_dz = this_dz + dz(k)
            6958     2   p    v               endif
            6959     1   s    s               this_lwc = max_lwc*this_dz/tdz
            6960     1   p    v               lwc = MAX(1.E-6, this_lwc*(1.-entr))
            6961     2   p    v               if (cfr(k).gt.0.0.and.cfr(k).lt.1.0.and.T(k).ge.258.16) then
            6962     2   p    v                  qc(k) = qc(k) + cfr(k)*cfr(k)*lwc
            6963     2   p    v               endif
            6964     1   p    v            enddo
            6965                     
            6966                           END SUBROUTINE adjust_cloudH2O
            6967                     
            6968                     !+---+-----------------------------------------------------------------+
            6969                     
            6970                     !> Do not alter any grid-explicitly resolved hydrometeors, rather only
            6971                     !! the supposed amounts due to the cloud fraction scheme.
            6972                           SUBROUTINE adjust_cloudFinal(cfr, qc, qi, Rho,dz, kts,kte)
            6973                     !
            6974                           IMPLICIT NONE
            6975                     !
            6976                           INTEGER, INTENT(IN):: kts,kte
            6977                           REAL, DIMENSION(kts:kte), INTENT(IN):: cfr, Rho, dz
            6978                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qc, qi
            6979                           REAL:: lwp, iwp, xfac
            6980                           INTEGER:: k
            6981                     
            6982                           lwp = 0.
            6983                           iwp = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6984     1  pp    v            do k = kts, kte
            6985     2   p    v               if (cfr(k).gt.0.0 .and. cfr(k).lt.1.0) then
            6986     2   p    v                  lwp = lwp + qc(k)*Rho(k)*dz(k)
            6987     2   p    v                  iwp = iwp + qi(k)*Rho(k)*dz(k)
            6988     2   p    v               endif
            6989     1   p    v            enddo
            6990                     
            6991     1                     if (lwp .gt. 1.0) then
            6992     1                        xfac = 1.0/lwp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.00, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr, qc
                                   <<< Loop-information  End >>>

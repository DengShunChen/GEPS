                                   <<<      SCALABLE  : SPILL 11  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4745     3                           do i = 1, ntb_s
            4746     3               
            4747     3               !..From the bm_s moment, compute plus one moment.  If we are not
            4748     3               !.. using bm_s=2, then we must transform to the pure 2nd moment
            4749     3               !.. (variable called "second") and then to the bm_s+1 moment.
            4750     3               
            4751     3                              M2 = r_s(i)*oams *1.0d0
            4752     4                              if (bm_s.gt.2.0-1.E-3 .and. bm_s.lt.2.0+1.E-3) then
            4753     4                                 loga_ = sa(1) + sa(2)*Tc(j) + sa(3)*bm_s &
            4754     4                                    + sa(4)*Tc(j)*bm_s + sa(5)*Tc(j)*Tc(j) &
            4755     4                                    + sa(6)*bm_s*bm_s + sa(7)*Tc(j)*Tc(j)*bm_s &
            4756     4                                    + sa(8)*Tc(j)*bm_s*bm_s + sa(9)*Tc(j)*Tc(j)*Tc(j) &
            4757     4                                    + sa(10)*bm_s*bm_s*bm_s
            4758     4                                 a_ = 10.0**loga_
            4759     4                                 b_ = sb(1) + sb(2)*Tc(j) + sb(3)*bm_s &
            4760     4                                    + sb(4)*Tc(j)*bm_s + sb(5)*Tc(j)*Tc(j) &
            4761     4                                    + sb(6)*bm_s*bm_s + sb(7)*Tc(j)*Tc(j)*bm_s &
            4762     4                                    + sb(8)*Tc(j)*bm_s*bm_s + sb(9)*Tc(j)*Tc(j)*Tc(j) &
            4763     4                                    + sb(10)*bm_s*bm_s*bm_s
            4764     4                                 second = (M2/a_)**(1./b_)
            4765     4                              else
            4766     4                                 second = M2
            4767     4                              endif
            4768     3               
            4769     3                              loga_ = sa(1) + sa(2)*Tc(j) + sa(3)*cse(1) &
            4770     3                                 + sa(4)*Tc(j)*cse(1) + sa(5)*Tc(j)*Tc(j) &
            4771     3                                 + sa(6)*cse(1)*cse(1) + sa(7)*Tc(j)*Tc(j)*cse(1) &
            4772     3                                 + sa(8)*Tc(j)*cse(1)*cse(1) + sa(9)*Tc(j)*Tc(j)*Tc(j) &
            4773     3                                 + sa(10)*cse(1)*cse(1)*cse(1)
            4774     3                              a_ = 10.0**loga_
            4775     3                              b_ = sb(1)+sb(2)*Tc(j)+sb(3)*cse(1) + sb(4)*Tc(j)*cse(1) &
            4776     3                                 + sb(5)*Tc(j)*Tc(j) + sb(6)*cse(1)*cse(1) &
            4777     3                                 + sb(7)*Tc(j)*Tc(j)*cse(1) + sb(8)*Tc(j)*cse(1)*cse(1) &
            4778     3                                 + sb(9)*Tc(j)*Tc(j)*Tc(j)+sb(10)*cse(1)*cse(1)*cse(1)
            4779     3                              M3 = a_ * second**b_
            4780     3               
            4781     3                              oM3 = 1./M3
            4782     3                              Mrat = M2*(M2*oM3)*(M2*oM3)*(M2*oM3)
            4783     3                              M0   = (M2*oM3)**mu_s
            4784     3                              slam1 = M2 * oM3 * Lam0
            4785     3                              slam2 = M2 * oM3 * Lam1
            4786     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Ds, dts, N_s
                                   <<< Loop-information  End >>>
            4787     4  pp    v                     do n = 1, nbs
            4788     4   p    v                        N_s(n) = Mrat*(Kap0*DEXP(-slam1*Ds(n)) &
            4789     4                                     + Kap1*M0*Ds(n)**mu_s * DEXP(-slam2*Ds(n)))*dts(n)
            4790     4   p    v                     enddo
            4791     3               
            4792     3                              t1 = 0.0d0
            4793     3                              t2 = 0.0d0
            4794     3                              t3 = 0.0d0
            4795     3                              t4 = 0.0d0
            4796     3                              z1 = 0.0d0
            4797     3                              z2 = 0.0d0
            4798     3                              z3 = 0.0d0
            4799     3                              z4 = 0.0d0
            4800     3                              y1 = 0.0d0
            4801     3                              y2 = 0.0d0
            4802     3                              y3 = 0.0d0
            4803     3                              y4 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            4804     4  pp                          do n2 = 1, nbr
            4805     4   p                             massr = am_r * Dr(n2)**bm_r
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 134
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Ds, vs
                                   <<< Loop-information  End >>>
            4806     5   p    s                        do n = 1, nbs
            4807     5   p    m                           masss = am_s * Ds(n)**bm_s
            4808     5               
            4809     5   p    v                           dvs = 0.5d0*((vr(n2) - vs(n)) + DABS(vr(n2)-vs(n)))
            4810     5   p    v                           dvr = 0.5d0*((vs(n) - vr(n2)) + DABS(vs(n)-vr(n2)))
            4811     5               
            4812     6   p    v                           if (massr .gt. 1.5*masss) then
            4813     6   p    m                           t1 = t1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4814     6                                        *dvs*masss * N_s(n)* N_r(n2)
            4815     6   p    s                           z1 = z1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4816     6                                        *dvs*massr * N_s(n)* N_r(n2)
            4817     6   p    s                           y1 = y1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4818     6                                        *dvs       * N_s(n)* N_r(n2)
            4819     6   p                                else
            4820     6   p    s                           t3 = t3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4821     6                                        *dvs*masss * N_s(n)* N_r(n2)
            4822     6   p    s                           z3 = z3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4823     6                                        *dvs*massr * N_s(n)* N_r(n2)
            4824     6   p    s                           y3 = y3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4825     6                                        *dvs       * N_s(n)* N_r(n2)
            4826     6   p    s                           endif
            4827     5               
            4828     6   p    m                           if (massr .gt. 1.5*masss) then
            4829     6   p    m                           t2 = t2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4830     6                                        *dvr*massr * N_s(n)* N_r(n2)
            4831     6   p    s                           y2 = y2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4832     6                                        *dvr       * N_s(n)* N_r(n2)
            4833     6   p    s                           z2 = z2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4834     6                                        *dvr*masss * N_s(n)* N_r(n2)
            4835     6   p                                else
            4836     6   p    s                           t4 = t4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4837     6                                        *dvr*massr * N_s(n)* N_r(n2)
            4838     6   p    s                           y4 = y4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4839     6                                        *dvr       * N_s(n)* N_r(n2)
            4840     6   p    s                           z4 = z4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4841     6                                        *dvr*masss * N_s(n)* N_r(n2)
            4842     6   p    v                           endif
            4843     5               
            4844     5   p    v                        enddo
            4845     4   p                          enddo
            4846     3                              tcs_racs1(i,j,k,m) = t1
            4847     3                              tmr_racs1(i,j,k,m) = DMIN1(z1, r_r(m)*1.0d0)
            4848     3                              tcs_racs2(i,j,k,m) = t3
            4849     3                              tmr_racs2(i,j,k,m) = z3
            4850     3                              tcr_sacr1(i,j,k,m) = t2
            4851     3                              tms_sacr1(i,j,k,m) = z2
            4852     3                              tcr_sacr2(i,j,k,m) = t4
            4853     3                              tms_sacr2(i,j,k,m) = z4
            4854     3                              tnr_racs1(i,j,k,m) = y1
            4855     3                              tnr_racs2(i,j,k,m) = y3
            4856     3                              tnr_sacr1(i,j,k,m) = y2
            4857     3                              tnr_sacr2(i,j,k,m) = y4
            4858     3                           enddo
            4859     2                        enddo
            4860     1                       enddo
            4861                     
            4862                     !        IF ( write_thompson_tables ) THEN
            4863                     !          write(0,*) "Writing "//qr_acr_qs_file//" in Thompson MP init"
            4864                     !          OPEN(63,file=qr_acr_qs_file,form="unformatted",err=9234)
            4865                     !          WRITE(63,err=9234)tcs_racs1
            4866                     !          WRITE(63,err=9234)tmr_racs1
            4867                     !          WRITE(63,err=9234)tcs_racs2
            4868                     !          WRITE(63,err=9234)tmr_racs2

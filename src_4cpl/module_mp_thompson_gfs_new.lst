            2577     3                          nu_c = MAX(2, MIN(nu_c+NINT(rand2), 15))
            2578     3                         endif
            2579     2                         xDc = MAX(D0c*1.E6, ((rc(k)/(am_r*nc(k)))**obmr) * 1.E6)
            2580     2                         lamc = (nc(k)*am_r* ccg(2,nu_c) * ocg1(nu_c) / rc(k))**obmr

            2334     2   p    s                  no_micro = .false.
            2335     2   p    s                  rr(k) = qr1d(k)*rho(k)
            2336     2   p    s                  nr(k) = MAX(R2, nr1d(k)*rho(k))
            2337     3   p    m                  if (nr(k).le. R2) then
            2338     3   p    m                     mvd_r(k) = 1.0E-3
            2339     3   p    s                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2340     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2341     3   p                       endif
            2342     2   p    s                  L_qr(k) = .true.
            2343     2   p    s                  lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            2344     2   p    s                  mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            2345     3   p    m                  if (mvd_r(k) .gt. 2.5E-3) then
            2346     3   p    m                     mvd_r(k) = 2.5E-3
            2347     3   p    s                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2348     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2349     3   p                       elseif (mvd_r(k) .lt. D0r*0.75) then
            2350     3   p    m                     mvd_r(k) = D0r*0.75
            2351     3   p    m                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2352     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2353     3   p                       endif
            2354     2   p                    else

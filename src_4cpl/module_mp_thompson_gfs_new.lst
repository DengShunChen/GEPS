                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtr, Dr, N_r
                                   <<< Loop-information  End >>>
            4761     2  pp    v               do n2 = 1, nbr
            4762     2   p    v                  N_r(n2) = N0_r*Dr(n2)**mu_r * DEXP(-lamr*Dr(n2))*dtr(n2)
            4763     2   p    v               enddo
            4764     1               
            4765     2                        do j = 1, ntb_t
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

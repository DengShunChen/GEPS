                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfils, pflls
                                   <<< Loop-information  End >>>
            1801     1  pp                   do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfils, pflls
                                   <<< Loop-information  End >>>
            1802     2   p   2v                do i = i_start, i_end
            1803     2   p   2v                  pfils(i,k) = pfils(i,k)/dt_in
            1804     2   p   2v                  pflls(i,k) = pflls(i,k)/dt_in
            1805     2   p   2v                enddo
            1806     1   p                   enddo
            1807                     !      enddo
            1808                     
            1809                           ! These are always allocated
            1810                           !deallocate (vtsk1)
            1811                           !deallocate (txri1)
            1812                           !deallocate (txrc1)
            1813                     #ifdef EXT_DIAG
            1814                           deallocate_extended_diagnostics: if (ext_diag) then
            1815                              deallocate (prw_vcdc1)
            1816                              deallocate (prw_vcde1)
            1817                              deallocate (tpri_inu1)
            1818                              deallocate (tpri_ide1_d)

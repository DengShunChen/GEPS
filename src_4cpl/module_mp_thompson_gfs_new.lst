            2268     1  pp    s            do k = kts, kte
            2269     1   p    m               temp(k) = t1d(k)
            2270     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            2271     1   p    v               pres(k) = p1d(k)
            2272     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            2273     1   p    v               nwfa(k) = MAX(11.1E6*rho(k), MIN(9999.E6*rho(k), nwfa1d(k)*rho(k)))
            2274     1   p    v               nifa(k) = MAX(naIN1*0.01*rho(k), MIN(9999.E6*rho(k), nifa1d(k)*rho(k)))
            2275     1   p    v               mvd_r(k) = D0r
            2276     1   p    v               mvd_c(k) = D0c
            2277     1               
            2278     2   p    v               if (qc1d(k) .gt. R1) then
            2279     2   p    s                  no_micro = .false.
            2280     2   p    s                  rc(k) = qc1d(k)*rho(k)
            2281     2   p    s                  nc(k) = MAX(2., MIN(nc1d(k)*rho(k), Nt_c_max))
            2282     2   p    s                  L_qc(k) = .true.
            2283     3   p    m                  if (nc(k).gt.10000.E6) then
            2284     3   p    m                   nu_c = 2
            2285     3   p    s                  elseif (nc(k).lt.100.) then
            2286     3   p    m                   nu_c = 15
            2287     3   p                       else
            2288     3   p    m                   nu_c = NINT(1000.E6/nc(k)) + 2
            2289     3   p    m                   nu_c = MAX(2, MIN(nu_c+NINT(rand2), 15))
            2290     3   p                       endif
            2291     2   p    s                  lamc = (nc(k)*am_r*ccg(2,nu_c)*ocg1(nu_c)/rc(k))**obmr
            2292     2   p    s                  xDc = (bm_r + nu_c + 1.) / lamc
            2293     3   p    m                  if (xDc.lt. D0c) then
            2294     3   p    m                   lamc = cce(2,nu_c)/D0c
            2295     3   p                       elseif (xDc.gt. D0r*2.) then
            2296     3   p    m                   lamc = cce(2,nu_c)/(D0r*2.)
            2297     3   p                       endif
            2298     2   p    s                  nc(k) = MIN( DBLE(Nt_c_max), ccg(1,nu_c)*ocg2(nu_c)*rc(k)   &
            2299     2                                 / am_r*lamc**bm_r)
            2300     3   p    s                  if (.NOT. (is_aerosol_aware .or. merra2_aerosol_aware)) then
            2301     4   p    m                     if (lsml == 1) then
            2302     4   p    m                       nc(k) = Nt_c_l
            2303     4   p                          else
            2304     4   p    m                       nc(k) = Nt_c_o
            2305     4   p                          endif
            2306     3   p                       endif
            2307     2   p                    else
            2308     2   p    s                  qc1d(k) = 0.0
            2309     2   p    v                  nc1d(k) = 0.0
            2310     2   p    v                  rc(k) = R1
            2311     2   p    v                  nc(k) = 2.
            2312     2   p    v                  L_qc(k) = .false.
            2313     2   p    m               endif
            2314     1               
            2315     2   p    v               if (qi1d(k) .gt. R1) then
            2316     2   p    s                  no_micro = .false.
            2317     2   p    s                  ri(k) = qi1d(k)*rho(k)
            2318     2   p    s                  ni(k) = MAX(R2, ni1d(k)*rho(k))
            2319     3   p    m                  if (ni(k).le. R2) then
            2320     3   p    s                     lami = cie(2)/5.E-6
            2321     3   p    m                     ni(k) = MIN(4999.D3, cig(1)*oig2*ri(k)/am_i*lami**bm_i)
            2322     3   p                       endif
            2323     2   p    s                  L_qi(k) = .true.
            2324     2   p    s                  lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            2325     2   p    s                  ilami = 1./lami
            2326     2   p    s                  xDi = (bm_i + mu_i + 1.) * ilami
            2327     3   p    m                  if (xDi.lt. 5.E-6) then
            2328     3   p    s                   lami = cie(2)/5.E-6
            2329     3   p    m                   ni(k) = MIN(4999.D3, cig(1)*oig2*ri(k)/am_i*lami**bm_i)
            2330     3   p                       elseif (xDi.gt. 300.E-6) then
            2331     3   p    m                   lami = cie(2)/300.E-6
            2332     3   p    m                   ni(k) = cig(1)*oig2*ri(k)/am_i*lami**bm_i
            2333     3   p                       endif
            2334     2   p                    else
            2335     2   p    s                  qi1d(k) = 0.0
            2336     2   p    v                  ni1d(k) = 0.0
            2337     2   p    v                  ri(k) = R1
            2338     2   p    v                  ni(k) = R2
            2339     2   p    v                  L_qi(k) = .false.
            2340     2   p    m               endif
            2341     1               
            2342     2   p    v               if (qr1d(k) .gt. R1) then
            2343     2   p    s                  no_micro = .false.
            2344     2   p    s                  rr(k) = qr1d(k)*rho(k)
            2345     2   p    s                  nr(k) = MAX(R2, nr1d(k)*rho(k))
            2346     3   p    m                  if (nr(k).le. R2) then
            2347     3   p    m                     mvd_r(k) = 1.0E-3
            2348     3   p    s                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2349     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2350     3   p                       endif
            2351     2   p    s                  L_qr(k) = .true.
            2352     2   p    s                  lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            2353     2   p    s                  mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            2354     3   p    m                  if (mvd_r(k) .gt. 2.5E-3) then
            2355     3   p    m                     mvd_r(k) = 2.5E-3
            2356     3   p    s                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2357     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2358     3   p                       elseif (mvd_r(k) .lt. D0r*0.75) then
            2359     3   p    m                     mvd_r(k) = D0r*0.75
            2360     3   p    m                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2361     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2362     3   p                       endif
            2363     2   p                    else
            2364     2   p    s                  qr1d(k) = 0.0
            2365     2   p    v                  nr1d(k) = 0.0
            2366     2   p    v                  rr(k) = R1
            2367     2   p    v                  nr(k) = R2
            2368     2   p    v                  L_qr(k) = .false.
            2369     2   p    s               endif
            2370     2   p    v               if (qs1d(k) .gt. R1) then
            2371     2   p    m                  no_micro = .false.
            2372     2   p    s                  rs(k) = qs1d(k)*rho(k)
            2373     2   p                       L_qs(k) = .true.
            2374     2   p                    else
            2375     2   p    s                  qs1d(k) = 0.0
            2376     2   p    v                  rs(k) = R1
            2377     2   p    v                  L_qs(k) = .false.
            2378     2   p    s               endif
            2379     2   p    v               if (qg1d(k) .gt. R1) then
            2380     2   p    m                  no_micro = .false.
            2381     2   p    s                  rg(k) = qg1d(k)*rho(k)
            2382     2   p                       L_qg(k) = .true.
            2383     2   p                    else
            2384     2   p    s                  qg1d(k) = 0.0
            2385     2   p    v                  rg(k) = R1
            2386     2   p    v                  L_qg(k) = .false.
            2387     2   p    v               endif
            2388     1   p    v            enddo
            2389                     

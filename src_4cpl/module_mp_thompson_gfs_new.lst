            3883     3   s    v                vtrk(k) = vtr
            3884     3               ! First below is technically correct:
            3885     3               !         vtr = rhof(k)*av_r*crg(5)*org2 * lamr**cre(2)                 &
            3886     3               !                     *((lamr+fv_r)**(-cre(5)))
            3887     3               ! Test: make number fall faster (but still slower than mass)
            3888     3               ! Goal: less prominent size sorting
            3889     3   p    v                vtr = rhof(k)*av_r*crg(7)/crg(12) * lamr**cre(12)             &

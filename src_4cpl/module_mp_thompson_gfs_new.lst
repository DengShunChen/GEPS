            3083     5                           pri_rci(k) = rhof(k)*t1_qr_qi*Ef_ri*ri(k)*N0_r(k) &
            3084     5                                          *((lamr+fv_r)**(-cre(9)))
            3085     5                           pnr_rci(k) = rhof(k)*t1_qr_qi*Ef_ri*ni(k)*N0_r(k)           &   ! RAIN2M
            3086     5                                          *((lamr+fv_r)**(-cre(9)))
            3087     5                           pni_rci(k) = pri_rci(k) * oxmi
            3088     5                           prr_rci(k) = rhof(k)*t2_qr_qi*Ef_ri*ni(k)*N0_r(k) &
            3089     5                                          *((lamr+fv_r)**(-cre(8)))
            3090     5                           prr_rci(k) = MIN(DBLE(rr(k)*odts), prr_rci(k))
            3091     5                           prg_rci(k) = pri_rci(k) + prr_rci(k)
            3092     5                          endif
            3093     4                         endif
            3094     3               
            3095     3               !>  - Ice multiplication from rime-splinters (Hallet & Mossop 1974).
            3096     4                         if (prg_gcw(k).gt. eps .and. tempc.gt.-8.0) then
            3097     4                          tf = 0.
            3098     5                          if (tempc.ge.-5.0 .and. tempc.lt.-3.0) then
            3099     5                           tf = 0.5*(-3.0 - tempc)
            3100     5                          elseif (tempc.gt.-8.0 .and. tempc.lt.-5.0) then
            3101     5                           tf = 0.33333333*(8.0 + tempc)
            3102     5                          endif
            3103     4                          pni_ihm(k) = 3.5E8*tf*prg_gcw(k)
            3104     4                          pri_ihm(k) = xm0i*pni_ihm(k)
            3105     4                          prs_ihm(k) = prs_scw(k)/(prs_scw(k)+prg_gcw(k)) &
            3106     4                                         * pri_ihm(k)
            3107     4                          prg_ihm(k) = prg_gcw(k)/(prs_scw(k)+prg_gcw(k)) &
            3108     4                                         * pri_ihm(k)
            3109     4                         endif
            3110     3               
            3111     3                        else
            3112     3               
            3113     3               !>  - Melt snow and graupel and enhance from collisions with liquid.
            3114     3               !! We also need to sublimate snow and graupel if subsaturated.
            3115     4                         if (L_qs(k)) then
            3116     4                          prr_sml(k) = (tempc*tcond(k)-lvap0*diffu(k)*delQvs(k))       &
            3117     4                                     * (t1_qs_me*smo1(k) + t2_qs_me*rhof2(k)*vsc2(k)*smof(k))
            3118     5                          if (prr_sml(k) .gt. 0.) then
            3119     5                             prr_sml(k) = prr_sml(k) + 4218.*olfus*tempc               &
            3120     5                                                     * (prr_rcs(k)+prs_scw(k))
            3121     5                          endif
            3122     4                          prr_sml(k) = MIN(DBLE(rs(k)*odts), MAX(0.D0, prr_sml(k)))
            3123     4                          pnr_sml(k) = smo0(k)/rs(k)*prr_sml(k) * 10.0**(-0.25*tempc)      ! RAIN2M
            3124     4                          pnr_sml(k) = MIN(DBLE(smo0(k)*odts), pnr_sml(k))
            3125     4               
            3126     5                          if (ssati(k).lt. 0.) then
            3127     5                           prs_sde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            3128     5                                        * (t1_qs_sd*smo1(k) &
            3129     5                                         + t2_qs_sd*rhof2(k)*vsc2(k)*smof(k))
            3130     5                           prs_sde(k) = MAX(DBLE(-rs(k)*odts), prs_sde(k))
            3131     5                          endif
            3132     4                         endif
            3133     3               
            3134     4                         if (L_qg(k)) then
            3135     4                          prr_gml(k) = (tempc*tcond(k)-lvap0*diffu(k)*delQvs(k))       &
            3136     4                                     * N0_g(k)*(t1_qg_me*ilamg(k)**cge(10)             &
            3137     4                                     + t2_qg_me*rhof2(k)*vsc2(k)*ilamg(k)**cge(11))
            3138     4               !-GT       prr_gml(k) = prr_gml(k) + 4218.*olfus*tempc &
            3139     4               !-GT                               * (prr_rcg(k)+prg_gcw(k))
            3140     4                          prr_gml(k) = MIN(DBLE(rg(k)*odts), MAX(0.D0, prr_gml(k)))
            3141     4                          pnr_gml(k) = N0_g(k)*cgg(2)*ilamg(k)**cge(2) / rg(k)         &   ! RAIN2M
            3142     4                                     * prr_gml(k) * 10.0**(-0.5*tempc)
            3143     4               
            3144     5                          if (ssati(k).lt. 0.) then
            3145     5                           prg_gde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            3146     5                               * N0_g(k) * (t1_qg_sd*ilamg(k)**cge(10) &
            3147     5                               + t2_qg_sd*vsc2(k)*rhof2(k)*ilamg(k)**cge(11))
            3148     5                           prg_gde(k) = MAX(DBLE(-rg(k)*odts), prg_gde(k))
            3149     5                          endif
            3150     4                         endif
            3151     3               
            3152     3               !> - This change will be required if users run adaptive time step that
            3153     3               !! results in delta-t that is generally too long to allow cloud water
            3154     3               !! collection by snow/graupel above melting temperature.
            3155     3               !! Credit to Bjorn-Egil Nygaard for discovering.
            3156     4                         if (dt .gt. 120.) then
            3157     4                            prr_rcw(k)=prr_rcw(k)+prs_scw(k)+prg_gcw(k)
            3158     4                            prs_scw(k)=0.
            3159     4                            prg_gcw(k)=0.
            3160     4                         endif
            3161     3               
            3162     3                        endif
            3163     2               
            3164     2                     enddo
            3165     1                     endif
            3166                     
            3167                     !+---+-----------------------------------------------------------------+
            3168                     !> - Ensure we do not deplete more hydrometeor species than exists.
            3169                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pri_ide, pri_inu, prs_sde, prg_gde
                                   <<<      prr_wau, prr_rcw, prs_scw, prs_ide
                                   <<<      prg_scw, qv, pri_iha, qvsi, rho, pri_wfz
                                   <<<      pni_ide, rc
                                   <<<    PREFETCH(SOFT) : 52
                                   <<<     SEQUENTIAL : 52
                                   <<<      rr: 2, L_qc: 2, prg_gcw: 2, ri: 2
                                   <<<      prs_iau: 2, prs_sci: 2, pri_rci: 2
                                   <<<      L_qi: 2, prr_rcg: 2, prg_rfz: 2
                                   <<<      pri_rfz: 2, prr_rci: 2, prr_rcs: 2
                                   <<<      L_qr: 2, prs_rcs: 2, rs: 2, prr_sml: 2
                                   <<<      prs_ihm: 2, L_qs: 2, temp: 2, prg_ihm: 2
                                   <<<      prg_rcg: 2, prr_gml: 2, rg: 2, L_qg: 2
                                   <<<      pri_ihm: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 21
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3170     1  pp    v            do k = kts, kte
            3171     1               
            3172     1               !>  - If ice supersaturated, ensure sum of depos growth terms does not
            3173     1               !! deplete more vapor than possibly exists.  If subsaturated, limit
            3174     1               !! sum of sublimation terms such that vapor does not reproduce ice
            3175     1               !! supersat again.
            3176     1   p    v               sump = pri_inu(k) + pri_ide(k) + prs_ide(k) &
            3177     1                             + prs_sde(k) + prg_gde(k) + pri_iha(k)
            3178     1   p    v               rate_max = (qv(k)-qvsi(k))*rho(k)*odts*0.999
            3179     2   p    v               if ( (sump.gt. eps .and. sump.gt. rate_max) .or. &
            3180     2                             (sump.lt. -eps .and. sump.lt. rate_max) ) then
            3181     2   p    v                ratio = rate_max/sump
            3182     2   p    v                pri_inu(k) = pri_inu(k) * ratio
            3183     2   p    v                pri_ide(k) = pri_ide(k) * ratio
            3184     2   p    v                pni_ide(k) = pni_ide(k) * ratio
            3185     2   p    v                prs_ide(k) = prs_ide(k) * ratio
            3186     2   p    v                prs_sde(k) = prs_sde(k) * ratio
            3187     2   p    v                prg_gde(k) = prg_gde(k) * ratio
            3188     2   p    v                pri_iha(k) = pri_iha(k) * ratio
            3189     2   p    v               endif
            3190     1               
            3191     1               !>  - Cloud water conservation.
            3192     1   p    v               sump = -prr_wau(k) - pri_wfz(k) - prr_rcw(k) &
            3193     1                               - prs_scw(k) - prg_scw(k) - prg_gcw(k)
            3194     1   p    v               rate_max = -rc(k)*odts
            3195     2   p    v               if (sump.lt. rate_max .and. L_qc(k)) then
            3196     2   p    v                ratio = rate_max/sump
            3197     2   p    v                prr_wau(k) = prr_wau(k) * ratio
            3198     2   p    v                pri_wfz(k) = pri_wfz(k) * ratio
            3199     2   p    v                prr_rcw(k) = prr_rcw(k) * ratio
            3200     2   p    v                prs_scw(k) = prs_scw(k) * ratio
            3201     2   p    v                prg_scw(k) = prg_scw(k) * ratio
            3202     2   p    v                prg_gcw(k) = prg_gcw(k) * ratio
            3203     2   p    v               endif
            3204     1               
            3205     1               !>  - Cloud ice conservation.
            3206     1   p    v               sump = pri_ide(k) - prs_iau(k) - prs_sci(k) &
            3207     1                               - pri_rci(k)
            3208     1   p    v               rate_max = -ri(k)*odts
            3209     2   p    v               if (sump.lt. rate_max .and. L_qi(k)) then
            3210     2   p    v                ratio = rate_max/sump
            3211     2   p    v                pri_ide(k) = pri_ide(k) * ratio
            3212     2   p    v                prs_iau(k) = prs_iau(k) * ratio
            3213     2   p    v                prs_sci(k) = prs_sci(k) * ratio
            3214     2   p    v                pri_rci(k) = pri_rci(k) * ratio
            3215     2   p    v               endif
            3216     1               
            3217     1               !>  - Rain conservation.
            3218     1   p    v               sump = -prg_rfz(k) - pri_rfz(k) - prr_rci(k) &
            3219     1                               + prr_rcs(k) + prr_rcg(k)
            3220     1   p    v               rate_max = -rr(k)*odts
            3221     2   p    v               if (sump.lt. rate_max .and. L_qr(k)) then
            3222     2   p    v                ratio = rate_max/sump
            3223     2   p    v                prg_rfz(k) = prg_rfz(k) * ratio
            3224     2   p    v                pri_rfz(k) = pri_rfz(k) * ratio
            3225     2   p    v                prr_rci(k) = prr_rci(k) * ratio
            3226     2   p    v                prr_rcs(k) = prr_rcs(k) * ratio
            3227     2   p    v                prr_rcg(k) = prr_rcg(k) * ratio
            3228     2   p    v               endif
            3229     1               
            3230     1               !>  - Snow conservation.
            3231     1   p    v               sump = prs_sde(k) - prs_ihm(k) - prr_sml(k) &
            3232     1                               + prs_rcs(k)
            3233     1   p    v               rate_max = -rs(k)*odts
            3234     2   p    v               if (sump.lt. rate_max .and. L_qs(k)) then
            3235     2   p    v                ratio = rate_max/sump
            3236     2   p    v                prs_sde(k) = prs_sde(k) * ratio
            3237     2   p    v                prs_ihm(k) = prs_ihm(k) * ratio
            3238     2   p    v                prr_sml(k) = prr_sml(k) * ratio
            3239     2   p    v                prs_rcs(k) = prs_rcs(k) * ratio
            3240     2   p    v               endif
            3241     1               
            3242     1               !>  - Graupel conservation.
            3243     1   p    v               sump = prg_gde(k) - prg_ihm(k) - prr_gml(k) &
            3244     1                             + prg_rcg(k)
            3245     1   p    v               rate_max = -rg(k)*odts
            3246     2   p    v               if (sump.lt. rate_max .and. L_qg(k)) then
            3247     2   p    v                ratio = rate_max/sump
            3248     2   p    v                prg_gde(k) = prg_gde(k) * ratio
            3249     2   p    v                prg_ihm(k) = prg_ihm(k) * ratio
            3250     2   p    v                prr_gml(k) = prr_gml(k) * ratio
            3251     2   p    v                prg_rcg(k) = prg_rcg(k) * ratio
            3252     2   p    v               endif
            3253     1               
            3254     1               !>  - Re-enforce proper mass conservation for subsequent elements in case
            3255     1               !! any of the above terms were altered.  Thanks P. Blossey. 2009Sep28
            3256     1   p    v               pri_ihm(k) = prs_ihm(k) + prg_ihm(k)
            3257     1   p    v               ratio = MIN( ABS(prr_rcg(k)), ABS(prg_rcg(k)) )
            3258     1   p    v               prr_rcg(k) = ratio * SIGN(1.0, SNGL(prr_rcg(k)))
            3259     1   p    v               prg_rcg(k) = -prr_rcg(k)
            3260     2   p    v               if (temp(k).gt.T_0) then
            3261     2   p    v                  ratio = MIN( ABS(prr_rcs(k)), ABS(prs_rcs(k)) )
            3262     2   p    v                  prr_rcs(k) = ratio * SIGN(1.0, SNGL(prr_rcs(k)))
            3263     2   p    v                  prs_rcs(k) = -prr_rcs(k)
            3264     2   p    v               endif
            3265     1               
            3266     1   p    v            enddo
            3267                     
            3268                     !+---+-----------------------------------------------------------------+
            3269                     !> - Calculate tendencies of all species but constrain the number of ice
            3270                     !! to reasonable values.
            3271                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp, rho, pna_sca, pna_rca, pni_iha
                                   <<<      pna_gca, nwfaten, pnd_gcd, pnd_scd
                                   <<<      pnd_rcd, nifaten, pni_inu, pri_inu
                                   <<<      pri_iha, pri_ide, prs_ide
                                   <<<    PREFETCH(SOFT) : 128
                                   <<<     SEQUENTIAL : 128
                                   <<<      prr_wau: 2, prr_rci: 2, qvten: 2
                                   <<<      prg_gde: 2, lvap: 2, prs_sde: 2
                                   <<<      pri_wfz: 2, prr_rcw: 2, prs_scw: 2
                                   <<<      prs_sci: 2, tten: 2, prg_scw: 2
                                   <<<      prg_gcw: 2, qcten: 2, prs_iau: 2
                                   <<<      pri_rfz: 2, pri_ihm: 2, pri_rci: 2
                                   <<<      qiten: 2, prs_rcs: 2, prr_sml: 2
                                   <<<      prs_ihm: 2, qsten: 2, prg_rci: 2
                                   <<<      prg_ihm: 2, prg_rcg: 2, prg_rfz: 2
                                   <<<      prr_gml: 2, prg_rcs: 2, qgten: 2, ocp: 2
                                   <<<      prr_rcs: 2, prr_rcg: 2, qc1d: 2
                                   <<<      pnc_wau: 2, pnc_rcw: 2, pnc_scw: 2
                                   <<<      pnc_gcw: 2, pni_wfz: 2, nc1d: 2
                                   <<<      ncten: 2, rc: 2, ni1d: 2, qi1d: 2
                                   <<<      pni_ihm: 2, pni_ide: 2, pni_iau: 2
                                   <<<      pni_sci: 2, pni_rci: 2, pni_rfz: 2
                                   <<<      niten: 2, qr1d: 2, qrten: 2, nr1d: 2
                                   <<<      pnr_wau: 2, pnr_sml: 2, pnr_gml: 2
                                   <<<      pnr_rcg: 2, pnr_rfz: 2, pnr_rcr: 2
                                   <<<      pnr_rcs: 2, pnr_rci: 2, nrten: 2
                                   <<<      mvd_r: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 61
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 78
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3272     1  pp    v            do k = kts, kte
            3273     1   p    v               orho = 1./rho(k)
            3274     1   p    v               lfus2 = lsub - lvap(k)
            3275     1               
            3276     1               !>  - Aerosol number tendency
            3277     2   p    v               if (is_aerosol_aware) then
            3278     2   p    v                  nwfaten(k) = nwfaten(k) - (pna_rca(k) + pna_sca(k)          &
            3279     2                                      + pna_gca(k) + pni_iha(k)) * orho
            3280     2   p    v                  nifaten(k) = nifaten(k) - (pnd_rcd(k) + pnd_scd(k)          &
            3281     2                                      + pnd_gcd(k)) * orho
            3282     3   p    v                  if (dustyIce) then
            3283     3   p    v                     nifaten(k) = nifaten(k) - pni_inu(k)*orho
            3284     3                           else
            3285     3                              nifaten(k) = 0.
            3286     3   p    v                  endif
            3287     2   p    v               endif
            3288     1               
            3289     1               !>  - Water vapor tendency
            3290     1   p    v               qvten(k) = qvten(k) + (-pri_inu(k) - pri_iha(k) - pri_ide(k)   &
            3291     1                                     - prs_ide(k) - prs_sde(k) - prg_gde(k)) &
            3292     1                                     * orho
            3293     1               
            3294     1               !>  - Cloud water tendency
            3295     1   p    v               qcten(k) = qcten(k) + (-prr_wau(k) - pri_wfz(k) &
            3296     1                                     - prr_rcw(k) - prs_scw(k) - prg_scw(k) &
            3297     1                                     - prg_gcw(k)) &
            3298     1                                     * orho
            3299     1               
            3300     1               !>  - Cloud water number tendency
            3301     1   p    v               ncten(k) = ncten(k) + (-pnc_wau(k) - pnc_rcw(k) &
            3302     1                                     - pni_wfz(k) - pnc_scw(k) - pnc_gcw(k)) &
            3303     1                                     * orho
            3304     1               
            3305     1               !>  - Cloud water mass/number balance; keep mass-wt mean size between
            3306     1               !! 1 and 50 microns.  Also no more than Nt_c_max drops total.
            3307     1   p    v               xrc=MAX(R1, (qc1d(k) + qcten(k)*dtsave)*rho(k))
            3308     1   p    v               xnc=MAX(2., (nc1d(k) + ncten(k)*dtsave)*rho(k))
            3309     2   p    v               if (xrc .gt. R1) then
            3310     3   p    v                if (xnc.gt.10000.E6) then
            3311     3   p    v                 nu_c = 2
            3312     3   p    v                elseif (xnc.lt.100.) then
            3313     3   p    v                 nu_c = 15
            3314     3   p    v                else
            3315     3   p    v                 nu_c = NINT(1000.E6/xnc) + 2
            3316     3   p    v                 nu_c = MAX(2, MIN(nu_c+NINT(rand2), 15))
            3317     3   p    v                endif
            3318     2   p    v                lamc = (xnc*am_r*ccg(2,nu_c)*ocg1(nu_c)/rc(k))**obmr
            3319     2   p    v                xDc = (bm_r + nu_c + 1.) / lamc
            3320     3   p    v                if (xDc.lt. D0c) then
            3321     3   p    v                 lamc = cce(2,nu_c)/D0c
            3322     3   p    v                 xnc = ccg(1,nu_c)*ocg2(nu_c)*xrc/am_r*lamc**bm_r
            3323     3   p    v                 ncten(k) = (xnc-nc1d(k)*rho(k))*odts*orho
            3324     3   p    v                elseif (xDc.gt. D0r*2.) then
            3325     3   p    v                 lamc = cce(2,nu_c)/(D0r*2.)
            3326     3   p    v                 xnc = ccg(1,nu_c)*ocg2(nu_c)*xrc/am_r*lamc**bm_r
            3327     3   p    v                 ncten(k) = (xnc-nc1d(k)*rho(k))*odts*orho
            3328     3   p    v                endif
            3329     2   p    v               else
            3330     2   p    v                ncten(k) = -nc1d(k)*odts
            3331     2   p    v               endif
            3332     1   p    v               xnc=MAX(0.,(nc1d(k) + ncten(k)*dtsave)*rho(k))
            3333     1   p    v               if (xnc.gt.Nt_c_max) &
            3334     1                               ncten(k) = (Nt_c_max-nc1d(k)*rho(k))*odts*orho
            3335     1               
            3336     1               !>  - Cloud ice mixing ratio tendency
            3337     1   p    v               qiten(k) = qiten(k) + (pri_inu(k) + pri_iha(k) + pri_ihm(k)    &
            3338     1                                     + pri_wfz(k) + pri_rfz(k) + pri_ide(k) &
            3339     1                                     - prs_iau(k) - prs_sci(k) - pri_rci(k)) &
            3340     1                                     * orho
            3341     1               
            3342     1               !>  - Cloud ice number tendency.
            3343     1   p    v               niten(k) = niten(k) + (pni_inu(k) + pni_iha(k) + pni_ihm(k)    &
            3344     1                                     + pni_wfz(k) + pni_rfz(k) + pni_ide(k) &
            3345     1                                     - pni_iau(k) - pni_sci(k) - pni_rci(k)) &
            3346     1                                     * orho
            3347     1               
            3348     1               !>  - Cloud ice mass/number balance; keep mass-wt mean size between
            3349     1               !! 5 and 300 microns.  Also no more than 500 xtals per liter.
            3350     1   p    v               xri=MAX(R1,(qi1d(k) + qiten(k)*dtsave)*rho(k))
            3351     1   p    v               xni=MAX(R2,(ni1d(k) + niten(k)*dtsave)*rho(k))
            3352     2   p    v               if (xri.gt. R1) then
            3353     2   p    v                 lami = (am_i*cig(2)*oig1*xni/xri)**obmi
            3354     2   p    v                 ilami = 1./lami
            3355     2   p    v                 xDi = (bm_i + mu_i + 1.) * ilami
            3356     3   p    v                 if (xDi.lt. 5.E-6) then
            3357     3   p    v                  lami = cie(2)/5.E-6
            3358     3   p    v                  xni = MIN(4999.D3, cig(1)*oig2*xri/am_i*lami**bm_i)
            3359     3   p    v                  niten(k) = (xni-ni1d(k)*rho(k))*odts*orho
            3360     3   p    v                 elseif (xDi.gt. 300.E-6) then
            3361     3   p    v                  lami = cie(2)/300.E-6
            3362     3   p    v                  xni = cig(1)*oig2*xri/am_i*lami**bm_i
            3363     3   p    v                  niten(k) = (xni-ni1d(k)*rho(k))*odts*orho
            3364     3   p    v                 endif
            3365     2   p    v               else
            3366     2   p    v                niten(k) = -ni1d(k)*odts
            3367     2   p    v               endif
            3368     1   p    v               xni=MAX(0.,(ni1d(k) + niten(k)*dtsave)*rho(k))
            3369     1   p    v               if (xni.gt.4999.E3) &
            3370     1                               niten(k) = (4999.E3-ni1d(k)*rho(k))*odts*orho
            3371     1               
            3372     1               !>  - Rain tendency
            3373     1   p    v               qrten(k) = qrten(k) + (prr_wau(k) + prr_rcw(k) &
            3374     1                                     + prr_sml(k) + prr_gml(k) + prr_rcs(k) &
            3375     1                                     + prr_rcg(k) - prg_rfz(k) &
            3376     1                                     - pri_rfz(k) - prr_rci(k)) &
            3377     1                                     * orho
            3378     1               
            3379     1               !>  - Rain number tendency
            3380     1   p    v               nrten(k) = nrten(k) + (pnr_wau(k) + pnr_sml(k) + pnr_gml(k)    &
            3381     1                                     - (pnr_rfz(k) + pnr_rcr(k) + pnr_rcg(k)           &
            3382     1                                     + pnr_rcs(k) + pnr_rci(k) + pni_rfz(k)) )         &
            3383     1                                     * orho
            3384     1               
            3385     1               !>  - Rain mass/number balance; keep median volume diameter between
            3386     1               !! 37 microns (D0r*0.75) and 2.5 mm.
            3387     1   p    v               xrr=MAX(R1,(qr1d(k) + qrten(k)*dtsave)*rho(k))
            3388     1   p    v               xnr=MAX(R2,(nr1d(k) + nrten(k)*dtsave)*rho(k))
            3389     2   p    v               if (xrr.gt. R1) then
            3390     2   p    v                 lamr = (am_r*crg(3)*org2*xnr/xrr)**obmr
            3391     2   p    v                 mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            3392     3   p    v                 if (mvd_r(k) .gt. 2.5E-3) then
            3393     3   p    v                    mvd_r(k) = 2.5E-3
            3394     3   p    v                    lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            3395     3   p    v                    xnr = crg(2)*org3*xrr*lamr**bm_r / am_r
            3396     3   p    v                    nrten(k) = (xnr-nr1d(k)*rho(k))*odts*orho
            3397     3   p    v                 elseif (mvd_r(k) .lt. D0r*0.75) then
            3398     3   p    v                    mvd_r(k) = D0r*0.75
            3399     3   p    v                    lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            3400     3   p    v                    xnr = crg(2)*org3*xrr*lamr**bm_r / am_r
            3401     3   p    v                    nrten(k) = (xnr-nr1d(k)*rho(k))*odts*orho
            3402     3   p    v                 endif
            3403     2   p    v               else
            3404     2   p    v                 qrten(k) = -qr1d(k)*odts
            3405     2   p    v                 nrten(k) = -nr1d(k)*odts
            3406     2   p    v               endif
            3407     1               
            3408     1               !>  - Snow tendency
            3409     1   p    v               qsten(k) = qsten(k) + (prs_iau(k) + prs_sde(k) &
            3410     1                                     + prs_sci(k) + prs_scw(k) + prs_rcs(k) &
            3411     1                                     + prs_ide(k) - prs_ihm(k) - prr_sml(k)) &
            3412     1                                     * orho
            3413     1               
            3414     1               !>  - Graupel tendency
            3415     1   p    v               qgten(k) = qgten(k) + (prg_scw(k) + prg_rfz(k) &
            3416     1                                     + prg_gde(k) + prg_rcg(k) + prg_gcw(k) &
            3417     1                                     + prg_rci(k) + prg_rcs(k) - prg_ihm(k) &
            3418     1                                     - prr_gml(k)) &
            3419     1                                     * orho
            3420     1               
            3421     1               !>  - Temperature tendency
            3422     2   p    v               if (temp(k).lt.T_0) then
            3423     2   p    v                tten(k) = tten(k) &
            3424     2                                   + ( lsub*ocp(k)*(pri_inu(k) + pri_ide(k) &
            3425     2                                                    + prs_ide(k) + prs_sde(k) &
            3426     2                                                    + prg_gde(k) + pri_iha(k)) &
            3427     2                                    + lfus2*ocp(k)*(pri_wfz(k) + pri_rfz(k) &
            3428     2                                                    + prg_rfz(k) + prs_scw(k) &
            3429     2                                                    + prg_scw(k) + prg_gcw(k) &
            3430     2                                                    + prg_rcs(k) + prs_rcs(k) &
            3431     2                                                    + prr_rci(k) + prg_rcg(k)) &
            3432     2                                      )*orho * (1-IFDRY)
            3433     2   p    v               else
            3434     2   p    v                tten(k) = tten(k) &
            3435     2                                   + ( lfus*ocp(k)*(-prr_sml(k) - prr_gml(k) &
            3436     2                                                    - prr_rcg(k) - prr_rcs(k)) &
            3437     2                                     + lsub*ocp(k)*(prs_sde(k) + prg_gde(k)) &
            3438     2                                      )*orho * (1-IFDRY)
            3439     2   p    v               endif
            3440     1               
            3441     1   p    v            enddo

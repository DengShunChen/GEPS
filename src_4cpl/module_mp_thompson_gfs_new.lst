            3625                     
            3626                     !+---+-----------------------------------------------------------------+
            3627                     !>  - Cloud water condensation and evaporation.  Nucleate cloud droplets
            3628                     !! using explicit CCN aerosols with hygroscopicity like sulfates using
            3629                     !! parcel model lookup table results provided by T. Eidhammer.  Evap
            3630                     !! drops using calculation of max drop size capable of evaporating in
            3631                     !! single timestep and explicit number of drops smaller than Dc_star
            3632                     !! from lookup table.
            3633                     !+---+-----------------------------------------------------------------+
            3634     1                     do k = kts, kte
            3635     1                        orho = 1./rho(k)
            3636     2                        if ( (ssatw(k).gt. eps) .or. (ssatw(k).lt. -eps .and. &
            3637     2                                  L_qc(k)) ) then
            3638     2                         clap = (qv(k)-qvs(k))/(1. + lvt2(k)*qvs(k))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3639     3   s   fs                do n = 1, 3
            3640     3   s   fs                   fcd = qvs(k)* EXP(lvt2(k)*clap) - qv(k) + clap
            3641     3   s   fs                   dfcd = qvs(k)*lvt2(k)* EXP(lvt2(k)*clap) + 1.
            3642     3   s   fs                   clap = clap - fcd/dfcd
            3643     3   p   fs                enddo
            3644     2                         xrc = rc(k) + clap*rho(k)
            3645     2                         xnc = 0.
            3646     3                         if (xrc.gt. R1) then
            3647     3                          prw_vcd(k) = clap*odt
            3648     3               !+---+-----------------------------------------------------------------+ !  DROPLET NUCLEATION
            3649     4                          if (clap .gt. eps) then
            3650     5                           if (is_aerosol_aware .or. merra2_aerosol_aware) then
            3651     5                              xnc = MAX(2., activ_ncloud(temp(k), w1d(k)+rand3, nwfa(k)))
            3652     5                           else
            3653     6                              if(lsml == 1) then
            3654     6                                xnc = Nt_c_l
            3655     6                              else
            3656     6                                xnc = Nt_c_o
            3657     6                              endif
            3658     5                           endif
            3659     4                           pnc_wcd(k) = 0.5*(xnc-nc(k) + abs(xnc-nc(k)))*odts*orho
            3660     4               
            3661     4               !+---+-----------------------------------------------------------------+ !  EVAPORATION
            3662     4                          elseif (clap .lt. -eps .AND. ssatw(k).lt.-1.E-6 .AND.     &
            3663     4                                 (is_aerosol_aware .or. merra2_aerosol_aware)) then
            3664     4                           tempc = temp(k) - 273.15
            3665     4                           otemp = 1./temp(k)
            3666     4                           rvs = rho(k)*qvs(k)
            3667     4                           rvs_p = rvs*otemp*(lvap(k)*otemp*oRv - 1.)
            3668     4                           rvs_pp = rvs * ( otemp*(lvap(k)*otemp*oRv - 1.) &
            3669     4                                           *otemp*(lvap(k)*otemp*oRv - 1.) &
            3670     4                                           + (-2.*lvap(k)*otemp*otemp*otemp*oRv) &
            3671     4                                           + otemp*otemp)
            3672     4                           gamsc = lvap(k)*diffu(k)/tcond(k) * rvs_p
            3673     4                           alphsc = 0.5*(gamsc/(1.+gamsc))*(gamsc/(1.+gamsc)) &
            3674     4                                      * rvs_pp/rvs_p * rvs/rvs_p
            3675     4                           alphsc = MAX(1.E-9, alphsc)
            3676     4                           xsat = ssatw(k)
            3677     4                           if (abs(xsat).lt. 1.E-9) xsat=0.
            3678     4                           t1_evap = 2.*PI*( 1.0 - alphsc*xsat  &
            3679     4                                  + 2.*alphsc*alphsc*xsat*xsat  &
            3680     4                                  - 5.*alphsc*alphsc*alphsc*xsat*xsat*xsat ) &
            3681     4                                  / (1.+gamsc)
            3682     4               
            3683     4                           Dc_star = DSQRT(-2.D0*DT * t1_evap/(2.*PI) &
            3684     4                                   * 4.*diffu(k)*ssatw(k)*rvs/rho_w)
            3685     4                           idx_d = MAX(1, MIN(INT(1.E6*Dc_star), nbc))
            3686     4               
            3687     4                           idx_n = NINT(1.0 + FLOAT(nbc) * DLOG(nc(k)/t_Nc(1)) / nic1)
            3688     4                           idx_n = MAX(1, MIN(idx_n, nbc))
            3689     4               
            3690     4               !>  - Cloud water lookup table index.
            3691     5                           if (rc(k).gt. r_c(1)) then
            3692     5                            nic = NINT(ALOG10(rc(k)))
            3693     6                            do nn = nic-1, nic+1
            3694     6                               n = nn
            3695     6                               if ( (rc(k)/10.**nn).ge.1.0 .and. &
            3696     6                                    (rc(k)/10.**nn).lt.10.0) goto 159
            3697     6                            enddo
            3698     5                159         continue
            3699     5                            idx_c = INT(rc(k)/10.**n) + 10*(n-nic2) - (n-nic2)
            3700     5                            idx_c = MAX(1, MIN(idx_c, ntb_c))
            3701     5                           else
            3702     5                            idx_c = 1
            3703     5                           endif
            3704     4               
            3705     4                          !prw_vcd(k) = MAX(DBLE(-rc(k)*orho*odt),                     &
            3706     4                          !           -tpc_wev(idx_d, idx_c, idx_n)*orho*odt)
            3707     4                           prw_vcd(k) = MAX(DBLE(-rc(k)*0.99*orho*odt), prw_vcd(k))
            3708     4                           pnc_wcd(k) = MAX(DBLE(-nc(k)*0.99*orho*odt),                &
            3709     4                                      -tnc_wev(idx_d, idx_c, idx_n)*orho*odt)
            3710     4               
            3711     4                          endif
            3712     3                         else
            3713     3                          prw_vcd(k) = -rc(k)*orho*odt
            3714     3                          pnc_wcd(k) = -nc(k)*orho*odt
            3715     3                         endif
            3716     2               
            3717     2               !+---+-----------------------------------------------------------------+
            3718     2               
            3719     2                         qvten(k) = qvten(k) - prw_vcd(k)
            3720     2                         qcten(k) = qcten(k) + prw_vcd(k)
            3721     2                         ncten(k) = ncten(k) + pnc_wcd(k)
            3722     2                         nwfaten(k) = nwfaten(k) - pnc_wcd(k)
            3723     2                         tten(k) = tten(k) + lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)
            3724     2                         rc(k) = MAX(R1, (qc1d(k) + DT*qcten(k))*rho(k))
            3725     2                         if (rc(k).eq.R1) L_qc(k) = .false.
            3726     2                         nc(k) = MAX(2., MIN((nc1d(k)+ncten(k)*DT)*rho(k), Nt_c_max))
            3727     3                         if (.NOT. (is_aerosol_aware .or. merra2_aerosol_aware)) then
            3728     4                           if(lsml == 1) then
            3729     4                             nc(k) = Nt_c_l
            3730     4                           else
            3731     4                             nc(k) = Nt_c_o
            3732     4                           endif
            3733     3                         endif
            3734     2                         qv(k) = MAX(1.E-10, qv1d(k) + DT*qvten(k))
            3735     2                         temp(k) = t1d(k) + DT*tten(k)
            3736     2                         rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            3737     2    i                    qvs(k) = rslf(pres(k), temp(k))
            3738     2                         ssatw(k) = qv(k)/qvs(k) - 1.
            3739     2                        endif
            3740     1                     enddo
            3741                     
            3742                     !+---+-----------------------------------------------------------------+
            3743                     !> - If still subsaturated, allow rain to evaporate, following
            3744                     !! Srivastava & Coen (1992).
            3745                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 12
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssatw, L_qr, prw_vcd, qv, qvs, rho, ocp
                                   <<<      temp, lvap, tcond, rr, prr_gml, pres
                                   <<<      rhof, rhof2, diffu
                                   <<<    PREFETCH(SOFT) : 32
                                   <<<     SEQUENTIAL : 32
                                   <<<      vsc2: 2, N0_r: 2, visco: 2, nrten: 2
                                   <<<      ilamr: 2, prv_rev: 2, qvten: 2, tten: 2
                                   <<<      t1d: 2, nwfaten: 2, qv1d: 2, qr1d: 2
                                   <<<      qrten: 2, nr1d: 2, nr: 2, pnr_rev: 2
                                   <<<    SPILLS :

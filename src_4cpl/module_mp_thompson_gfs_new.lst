            3572     2               !>  - All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            3573     2               !! then we must compute actual 2nd moment and use as reference.
            3574     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            3575     3   p    v                  smo2(k) = smob(k)
            3576     3                        else
            3577     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            3578     3                              + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            3579     3                              + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &

            3582     2                             + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            3583     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            3584     2   p    v               smoc(k) = a_ * smo2(k)**b_
            3585     2               
            3586     2               !>  - Calculate bm_s+bv_s (th) moment.  Useful for sedimentation.
            3587     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(14) &

                                   <<< Loop-information  End >>>
            3746     1  pp    v            do k = kts, kte
            3747     2   p    v               if ( (ssatw(k).lt. -eps) .and. L_qr(k) &
            3748     2                                    .and. (.not.(prw_vcd(k).gt. 0.)) ) then
            3749     2   p    v                tempc = temp(k) - 273.15
            3750     2   p    v                otemp = 1./temp(k)
            3751     2   p    v                orho = 1./rho(k)
            3752     2   p    v                rhof(k) = SQRT(RHO_NOT*orho)
            3753     2   p    v                rhof2(k) = SQRT(rhof(k))
            3754     2   p    v                diffu(k) = 2.11E-5*(temp(k)/273.15)**1.94 * (101325./pres(k))
            3755     3   p    v                if (tempc .ge. 0.0) then
            3756     3   p    v                   visco(k) = (1.718+0.0049*tempc)*1.0E-5
            3757     3   p    v                else
            3758     3   p    v                   visco(k) = (1.718+0.0049*tempc-1.2E-5*tempc*tempc)*1.0E-5
            3759     3   p    v                endif
            3760     2   p    v                vsc2(k) = SQRT(rho(k)/visco(k))
            3761     2   p    v                lvap(k) = lvap0 + (2106.0 - 4218.0)*tempc
            3762     2   p    v                tcond(k) = (5.69 + 0.0168*tempc)*1.0E-5 * 418.936
            3763     2   p    v                ocp(k) = 1./(Cp*(1.+0.887*qv(k)))
            3764     2               
            3765     2   p    v                rvs = rho(k)*qvs(k)
            3766     2   p    v                rvs_p = rvs*otemp*(lvap(k)*otemp*oRv - 1.)
            3767     2   p    v                rvs_pp = rvs * ( otemp*(lvap(k)*otemp*oRv - 1.) &
            3768     2                                         *otemp*(lvap(k)*otemp*oRv - 1.) &
            3769     2                                         + (-2.*lvap(k)*otemp*otemp*otemp*oRv) &
            3770     2                                         + otemp*otemp)
            3771     2   p    v                gamsc = lvap(k)*diffu(k)/tcond(k) * rvs_p
            3772     2   p    v                alphsc = 0.5*(gamsc/(1.+gamsc))*(gamsc/(1.+gamsc)) &
            3773     2                                    * rvs_pp/rvs_p * rvs/rvs_p
            3774     2   p    v                alphsc = MAX(1.E-9, alphsc)
            3775     2   p    v                xsat   = MIN(-1.E-9, ssatw(k))
            3776     2   p    v                t1_evap = 2.*PI*( 1.0 - alphsc*xsat  &
            3777     2                                + 2.*alphsc*alphsc*xsat*xsat  &
            3778     2                                - 5.*alphsc*alphsc*alphsc*xsat*xsat*xsat ) &
            3779     2                                / (1.+gamsc)
            3780     2               
            3781     2   p    v                lamr = 1./ilamr(k)
            3782     2               !>  - Rapidly eliminate near zero values when low humidity (<95%)
            3783     3   p    v                if (qv(k)/qvs(k) .lt. 0.95 .AND. rr(k)*orho.le.1.E-8) then
            3784     3   p    v                prv_rev(k) = rr(k)*orho*odts
            3785     3   p    v                else
            3786     3   p    v                prv_rev(k) = t1_evap*diffu(k)*(-ssatw(k))*N0_r(k)*rvs &
            3787     3                             * (t1_qr_ev*ilamr(k)**cre(10) &
            3788     3                             + t2_qr_ev*vsc2(k)*rhof2(k)*((lamr+0.5*fv_r)**(-cre(11))))
            3789     3   p    v                rate_max = MIN((rr(k)*orho*odts), (qvs(k)-qv(k))*odts)
            3790     3   p    v                prv_rev(k) = MIN(DBLE(rate_max), prv_rev(k)*orho)
            3791     3               
            3792     3               !..TEST: G. Thompson  10 May 2013
            3793     3               !>  - Reduce the rain evaporation in same places as melting graupel occurs.
            3794     3               !! Rationale: falling and simultaneous melting graupel in subsaturated
            3795     3               !! regions will not melt as fast because particle temperature stays
            3796     3               !! at 0C.  Also not much shedding of the water from the graupel so
            3797     3               !! likely that the water-coated graupel evaporating much slower than
            3798     3               !! if the water was immediately shed off.
            3799     4   p    v                IF (prr_gml(k).gt.0.0) THEN
            3800     4   p    v                   eva_factor = MIN(1.0, 0.01+(0.99-0.01)*(tempc/20.0))
            3801     4   p    v                   prv_rev(k) = prv_rev(k)*eva_factor
            3802     4   p    v                ENDIF
            3803     3   p    v                endif
            3804     2               
            3805     2   p    v                pnr_rev(k) = MIN(DBLE(nr(k)*0.99*orho*odts),                  &   ! RAIN2M
            3806     2                                      prv_rev(k) * nr(k)/rr(k))
            3807     2               
            3808     2   p    v                qrten(k) = qrten(k) - prv_rev(k)
            3809     2   p    v                qvten(k) = qvten(k) + prv_rev(k)
            3810     2   p    v                nrten(k) = nrten(k) - pnr_rev(k)
            3811     2   p    v                nwfaten(k) = nwfaten(k) + pnr_rev(k)
            3812     2   p    v                tten(k) = tten(k) - lvap(k)*ocp(k)*prv_rev(k)*(1-IFDRY)
            3813     2               

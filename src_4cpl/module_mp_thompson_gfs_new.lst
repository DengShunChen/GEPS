            3610     2   p    v               a_ = 10.0**loga_
            3611     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(14) + sb(4)*tc0*cse(14) &
            3612     2                             + sb(5)*tc0*tc0 + sb(6)*cse(14)*cse(14) &
            3613     2                             + sb(7)*tc0*tc0*cse(14) + sb(8)*tc0*cse(14)*cse(14) &
            3614     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(14)*cse(14)*cse(14)
            3615     2   p    v               smod(k) = a_ * smo2(k)**b_
            3616     2   p    v            enddo
            3617     1               
            3618     1               !+---+-----------------------------------------------------------------+
            3619     1               !> - Calculate y-intercept, slope values for graupel.
            3620     1               !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rg, ilamg, N0_g

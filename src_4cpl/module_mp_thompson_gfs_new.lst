            1883                           if (ALLOCATED(tni_iaus)) DEALLOCATE(tni_iaus)
            1884                           if (ALLOCATED(tpi_ide))  DEALLOCATE(tpi_ide)
            1885                     
            1886                           if (ALLOCATED(t_Efrw)) DEALLOCATE(t_Efrw)
            1887                           if (ALLOCATED(t_Efsw)) DEALLOCATE(t_Efsw)
            1888                     
            1889                           if (ALLOCATED(tnr_rev)) DEALLOCATE(tnr_rev)
            1890                           if (ALLOCATED(tpc_wev)) DEALLOCATE(tpc_wev)
            1891                           if (ALLOCATED(tnc_wev)) DEALLOCATE(tnc_wev)
            1892                     
            1893                           if (ALLOCATED(tnccn_act)) DEALLOCATE(tnccn_act)
            1894                     
            1895                           END SUBROUTINE thompson_finalize
            1896                     
            1897                     !+---+-----------------------------------------------------------------+
            1898                     !ctrlL
            1899                     !+---+-----------------------------------------------------------------+
            1900                     !+---+-----------------------------------------------------------------+
            1901                     
            1902                     !>\ingroup aathompson
            1903                     !! This subroutine computes the moisture tendencies of water vapor,
            1904                     !! cloud droplets, rain, cloud ice (pristine), snow, and graupel.
            1905                     !! Previously this code was based on Reisner et al (1998), but few of
            1906                     !! those pieces remain.  A complete description is now found in
            1907                     !! Thompson et al. (2004, 2008)\cite Thompson_2004 \cite Thompson_2008.
            1908                     !>\section gen_mp_thompson  mp_thompson General Algorithm
            1909                     !> @{
            1910                           subroutine mp_thompson (qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
            1911                                            nr1d, nc1d, nwfa1d, nifa1d, t1d, p1d, w1d, dzq,  &
            1912                                            lsml, pptrain, pptsnow, pptgraul, pptice,        &
            1913                     #if ( WRF_CHEM == 1 )
            1914                                            rainprod, evapprod,                              &
            1915                     #endif
            1916                                            rand1, rand2, rand3,                             &
            1917                                            kts, kte, dt, ii,                                &
            1918                                               ! Extended diagnostics, most arrays only
            1919                                               ! allocated if ext_diag flag is .true.
            1920                                            ext_diag,                                        &
            1921                                            sedi_semi, decfl,                                &
            1922                     #ifdef EXT_DIAG
            1923                                             !vtsk1, txri1, txrc1,                            &
            1924                                            prw_vcdc1, prw_vcde1,                            &
            1925                                            tpri_inu1, tpri_ide1_d, tpri_ide1_s, tprs_ide1,  &
            1926                                            tprs_sde1_d, tprs_sde1_s,                        &
            1927                                            tprg_gde1_d, tprg_gde1_s, tpri_iha1, tpri_wfz1,  &
            1928                                            tpri_rfz1, tprg_rfz1, tprs_scw1, tprg_scw1,      &
            1929                                            tprg_rcs1, tprs_rcs1, tprr_rci1,                 &
            1930                                            tprg_rcg1, tprw_vcd1_c,                          &
            1931                                            tprw_vcd1_e, tprr_sml1, tprr_gml1, tprr_rcg1,    &
            1932                                            tprr_rcs1, tprv_rev1,                            &
            1933                                            tten1, qvten1, qrten1, qsten1,                   &
            1934                                            qgten1, qiten1, niten1, nrten1, ncten1, qcten1,  &
            1935                     #endif
            1936                                            pfil1, pfll1)
            1937                     
            1938                     #ifdef MPI
            1939                           use mpi
            1940                     #endif
            1941                           implicit none
            1942                     
            1943                     !..Sub arguments
            1944                           INTEGER, INTENT(IN):: kts, kte, ii!, jj
            1945                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: &
            1946                                               qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
            1947                                               nr1d, nc1d, nwfa1d, nifa1d, t1d
            1948                           REAL, DIMENSION(kts:kte), INTENT(OUT):: pfil1, pfll1
            1949                           REAL, DIMENSION(kts:kte), INTENT(IN):: p1d, w1d, dzq
            1950                           REAL, INTENT(INOUT):: pptrain, pptsnow, pptgraul, pptice
            1951                           REAL, INTENT(IN):: dt
            1952                           INTEGER, INTENT(IN):: lsml
            1953                           REAL, INTENT(IN):: rand1, rand2, rand3
            1954                           ! Extended diagnostics, most arrays only allocated if ext_diag is true
            1955                           LOGICAL, INTENT(IN) :: ext_diag
            1956                           LOGICAL, INTENT(IN) :: sedi_semi
            1957                           INTEGER, INTENT(IN) :: decfl
            1958                     #ifdef EXT_DIAG
            1959                           REAL, DIMENSION(:), INTENT(OUT):: &
            1960                                               !vtsk1, txri1, txrc1,                       &
            1961                                               prw_vcdc1,                                 &
            1962                                               prw_vcde1, tpri_inu1, tpri_ide1_d,         &
            1963                                               tpri_ide1_s, tprs_ide1,                    &
            1964                                               tprs_sde1_d, tprs_sde1_s, tprg_gde1_d,     &
            1965                                               tprg_gde1_s, tpri_iha1, tpri_wfz1,         &
            1966                                               tpri_rfz1, tprg_rfz1, tprs_scw1, tprg_scw1,&
            1967                                               tprg_rcs1, tprs_rcs1,                      &
            1968                                               tprr_rci1, tprg_rcg1,                      &
            1969                                               tprw_vcd1_c, tprw_vcd1_e, tprr_sml1,       &
            1970                                               tprr_gml1, tprr_rcg1,                      &
            1971                                               tprr_rcs1, tprv_rev1, tten1, qvten1,       &
            1972                                               qrten1, qsten1, qgten1, qiten1, niten1,    &
            1973                                               nrten1, ncten1, qcten1
            1974                     #endif
            1975                     
            1976                     #if ( WRF_CHEM == 1 )
            1977                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: &
            1978                                               rainprod, evapprod
            1979                     #endif
            1980                     
            1981                     !..Local variables
            1982                           REAL, DIMENSION(kts:kte):: tten, qvten, qcten, qiten, &
            1983                                qrten, qsten, qgten, niten, nrten, ncten, nwfaten, nifaten
            1984                     
            1985                           DOUBLE PRECISION, DIMENSION(kts:kte):: prw_vcd
            1986                     
            1987                           DOUBLE PRECISION, DIMENSION(kts:kte):: pnc_wcd, pnc_wau, pnc_rcw, &
            1988                                pnc_scw, pnc_gcw
            1989                     
            1990                           DOUBLE PRECISION, DIMENSION(kts:kte):: pna_rca, pna_sca, pna_gca, &
            1991                                pnd_rcd, pnd_scd, pnd_gcd
            1992                     
            1993                           DOUBLE PRECISION, DIMENSION(kts:kte):: prr_wau, prr_rcw, prr_rcs, &
            1994                                prr_rcg, prr_sml, prr_gml, &
            1995                                prr_rci, prv_rev,          &
            1996                                pnr_wau, pnr_rcs, pnr_rcg, &
            1997                                pnr_rci, pnr_sml, pnr_gml, &
            1998                                pnr_rev, pnr_rcr, pnr_rfz
            1999                     
            2000                           DOUBLE PRECISION, DIMENSION(kts:kte):: pri_inu, pni_inu, pri_ihm, &
            2001                                pni_ihm, pri_wfz, pni_wfz, &
            2002                                pri_rfz, pni_rfz, pri_ide, &
            2003                                pni_ide, pri_rci, pni_rci, &
            2004                                pni_sci, pni_iau, pri_iha, pni_iha
            2005                     
            2006                           DOUBLE PRECISION, DIMENSION(kts:kte):: prs_iau, prs_sci, prs_rcs, &
            2007                                prs_scw, prs_sde, prs_ihm, &
            2008                                prs_ide
            2009                     
            2010                           DOUBLE PRECISION, DIMENSION(kts:kte):: prg_scw, prg_rfz, prg_gde, &
            2011                                prg_gcw, prg_rci, prg_rcs, &
            2012                                prg_rcg, prg_ihm
            2013                     
            2014                           DOUBLE PRECISION, PARAMETER:: zeroD0 = 0.0d0
            2015                           REAL :: dtcfl,rainsfc,graulsfc
            2016                           INTEGER :: niter
            2017                     
            2018                           REAL, DIMENSION(kts:kte):: temp, pres, qv, pfll, pfil, pdummy
            2019                           REAL, DIMENSION(kts:kte):: rc, ri, rr, rs, rg, ni, nr, nc, nwfa, nifa
            2020                           REAL, DIMENSION(kts:kte):: rr_tmp, nr_tmp, rg_tmp
            2021                           REAL, DIMENSION(kts:kte):: rho, rhof, rhof2
            2022                           REAL, DIMENSION(kts:kte):: qvs, qvsi, delQvs
            2023                           REAL, DIMENSION(kts:kte):: satw, sati, ssatw, ssati
            2024                           REAL, DIMENSION(kts:kte):: diffu, visco, vsc2, &
            2025                                tcond, lvap, ocp, lvt2
            2026                     
            2027                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilamg, N0_r, N0_g
            2028                           REAL, DIMENSION(kts:kte):: mvd_r, mvd_c
            2029                           REAL, DIMENSION(kts:kte):: smob, smo2, smo1, smo0, &
            2030                                smoc, smod, smoe, smof
            2031                     
            2032                           REAL, DIMENSION(kts:kte):: sed_r, sed_s, sed_g, sed_i, sed_n,sed_c
            2033                     
            2034                           REAL:: rgvm, delta_tp, orho, lfus2, orhodt
            2035                           REAL, DIMENSION(5):: onstep
            2036                           DOUBLE PRECISION:: N0_exp, N0_min, lam_exp, lamc, lamr, lamg
            2037                           DOUBLE PRECISION:: lami, ilami, ilamc
            2038                           REAL:: xDc, Dc_b, Dc_g, xDi, xDr, xDs, xDg, Ds_m, Dg_m
            2039                           DOUBLE PRECISION:: Dr_star, Dc_star
            2040                           REAL:: zeta1, zeta, taud, tau
            2041                           REAL:: stoke_r, stoke_s, stoke_g, stoke_i
            2042                           REAL:: vti, vtr, vts, vtg, vtc
            2043                           REAL, DIMENSION(kts:kte+1):: vtik, vtnik, vtrk, vtnrk, vtsk, vtgk,  &
            2044                                vtck, vtnck
            2045                           REAL, DIMENSION(kts:kte):: vts_boost
            2046                           REAL:: Mrat, ils1, ils2, t1_vts, t2_vts, t3_vts, t4_vts, C_snow
            2047                           REAL:: a_, b_, loga_, A1, A2, tf
            2048                           REAL:: tempc, tc0, r_mvd1, r_mvd2, xkrat
            2049                           REAL:: xnc, xri, xni, xmi, oxmi, xrc, xrr, xnr
            2050                           REAL:: xsat, rate_max, sump, ratio
            2051                           REAL:: clap, fcd, dfcd
            2052                           REAL:: otemp, rvs, rvs_p, rvs_pp, gamsc, alphsc, t1_evap, t1_subl
            2053                           REAL:: r_frac, g_frac
            2054                           REAL:: Ef_rw, Ef_sw, Ef_gw, Ef_rr
            2055                           REAL:: Ef_ra, Ef_sa, Ef_ga
            2056                           REAL:: dtsave, odts, odt, odzq, hgt_agl, SR
            2057                           REAL:: xslw1, ygra1, zans1, eva_factor
            2058                           REAL:: av_i
            2059                           INTEGER:: i, k, k2, n, nn, nstep, k_0, kbot, IT, iexfrq
            2060                           INTEGER, DIMENSION(5):: ksed1
            2061                           INTEGER:: nir, nis, nig, nii, nic, niin
            2062                           INTEGER:: idx_tc, idx_t, idx_s, idx_g1, idx_g, idx_r1, idx_r,     &
            2063                                     idx_i1, idx_i, idx_c, idx, idx_d, idx_n, idx_in
            2064                     
            2065                           LOGICAL:: no_micro
            2066                           LOGICAL, DIMENSION(kts:kte):: L_qc, L_qi, L_qr, L_qs, L_qg
            2067                           LOGICAL:: debug_flag
            2068                           INTEGER:: nu_c
            2069                     
            2070                     !+---+
            2071                     
            2072                           debug_flag = .false.
            2073                     !     if (ii.eq.901 .and. jj.eq.379) debug_flag = .true.
            2074     1                     if(debug_flag) then
            2075     1                       write(*, *) 'DEBUG INFO, mp_thompson at i ', ii
            2076     1                     endif
            2077                     
            2078                           no_micro = .true.
            2079                           dtsave = dt
            2080                           odt = 1./dt
            2081                           odts = 1./dtsave
            2082                           iexfrq = 1
            2083                     ! Transition value of coefficient matching at crossover from cloud ice to snow
            2084                           av_i = av_s * D0s ** (bv_s - bv_i)
            2085                     
            2086                     !+---+-----------------------------------------------------------------+
            2087                     !> - Initialize Source/sink terms.  First 2 chars: "pr" represents source/sink of
            2088                     !! mass while "pn" represents source/sink of number.  Next char is one
            2089                     !! of "v" for water vapor, "r" for rain, "i" for cloud ice, "w" for
            2090                     !! cloud water, "s" for snow, and "g" for graupel.  Next chars
            2091                     !! represent processes: "de" for sublimation/deposition, "ev" for
            2092                     !! evaporation, "fz" for freezing, "ml" for melting, "au" for
            2093                     !! autoconversion, "nu" for ice nucleation, "hm" for Hallet/Mossop
            2094                     !! secondary ice production, and "c" for collection followed by the
            2095                     !! character for the species being collected.  ALL of these terms are
            2096                     !! positive (except for deposition/sublimation terms which can switch
            2097                     !! signs based on super/subsaturation) and are treated as negatives
            2098                     !! where necessary in the tendency equations.
            2099                     !+---+-----------------------------------------------------------------+
            2100                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 68
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prs_scw, prs_sde, prs_ihm, prg_rcg
                                   <<<      prs_sci, prg_ihm, pna_rca, pna_sca
                                   <<<      prs_rcs, prs_ide, prg_scw, prg_rfz
                                   <<<      prg_gde, prg_gcw, prg_rci, prg_rcs
                                   <<<    PREFETCH(SOFT) : 122
                                   <<<     SEQUENTIAL : 122
                                   <<<      pna_gca: 2, pnd_rcd: 2, pnd_scd: 2
                                   <<<      pnd_gcd: 2, pfil1: 2, pfll1: 2, pfil: 2
                                   <<<      pfll: 2, pdummy: 2, tten: 2, qvten: 2
                                   <<<      qcten: 2, qiten: 2, qrten: 2, qsten: 2
                                   <<<      qgten: 2, niten: 2, nrten: 2, ncten: 2
                                   <<<      nwfaten: 2, nifaten: 2, prw_vcd: 2
                                   <<<      pnc_wcd: 2, pnc_wau: 2, pnc_rcw: 2
                                   <<<      pnc_scw: 2, pnc_gcw: 2, prv_rev: 2
                                   <<<      prr_wau: 2, prr_rcw: 2, prr_rcs: 2
                                   <<<      prr_rcg: 2, prr_sml: 2, prr_gml: 2
                                   <<<      prr_rci: 2, pnr_wau: 2, pnr_rcs: 2
                                   <<<      pnr_rcg: 2, pnr_rci: 2, pnr_sml: 2
                                   <<<      pnr_gml: 2, pnr_rev: 2, pnr_rcr: 2
                                   <<<      pnr_rfz: 2, pri_inu: 2, pni_inu: 2
                                   <<<      pri_ihm: 2, pni_ihm: 2, pri_wfz: 2
                                   <<<      pni_wfz: 2, pri_rfz: 2, pni_rfz: 2
                                   <<<      pri_ide: 2, pni_ide: 2, pri_rci: 2
                                   <<<      pni_rci: 2, pni_sci: 2, pni_iau: 2
                                   <<<      pri_iha: 2, pni_iha: 2, prs_iau: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 50
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2101     1  pp    v            do k = kts, kte
            2102     1   p    v               tten(k) = 0.
            2103     1   p    v               qvten(k) = 0.
            2104     1   p    v               qcten(k) = 0.
            2105     1   p    v               qiten(k) = 0.
            2106     1   p    v               qrten(k) = 0.
            2107     1   p    v               qsten(k) = 0.
            2108     1   p    v               qgten(k) = 0.
            2109     1   p    v               niten(k) = 0.
            2110     1   p    v               nrten(k) = 0.
            2111     1   p    v               ncten(k) = 0.
            2112     1   p    v               nwfaten(k) = 0.
            2113     1   p    v               nifaten(k) = 0.
            2114     1               
            2115     1   p    v               prw_vcd(k) = 0.
            2116     1               
            2117     1   p    v               pnc_wcd(k) = 0.
            2118     1   p    v               pnc_wau(k) = 0.
            2119     1   p    v               pnc_rcw(k) = 0.
            2120     1   p    v               pnc_scw(k) = 0.
            2121     1   p    v               pnc_gcw(k) = 0.
            2122     1               
            2123     1   p    v               prv_rev(k) = 0.
            2124     1   p    v               prr_wau(k) = 0.
            2125     1   p    v               prr_rcw(k) = 0.
            2126     1   p    v               prr_rcs(k) = 0.
            2127     1   p    v               prr_rcg(k) = 0.
            2128     1   p    v               prr_sml(k) = 0.
            2129     1   p    v               prr_gml(k) = 0.
            2130     1   p    v               prr_rci(k) = 0.
            2131     1   p    v               pnr_wau(k) = 0.
            2132     1   p    v               pnr_rcs(k) = 0.
            2133     1   p    v               pnr_rcg(k) = 0.
            2134     1   p    v               pnr_rci(k) = 0.

                                   <<< Loop-information  End >>>
            3638     1  pp    v            do k = kte, kts, -1
            3639     1   p    v               lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            3640     1   p    v               ilamr(k) = 1./lamr
            3641     1   p    v               mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            3642     1   p    v               N0_r(k) = nr(k)*org2*lamr**cre(2)
            3643     1   p    v            enddo
            3644                     
            3645                     !+---+-----------------------------------------------------------------+
            3646                     !>  - Cloud water condensation and evaporation.  Nucleate cloud droplets
            3647                     !! using explicit CCN aerosols with hygroscopicity like sulfates using
            3648                     !! parcel model lookup table results provided by T. Eidhammer.  Evap
            3649                     !! drops using calculation of max drop size capable of evaporating in
            3650                     !! single timestep and explicit number of drops smaller than Dc_star
            3651                     !! from lookup table.
            3652                     !+---+-----------------------------------------------------------------+
            3653     1                     do k = kts, kte
            3654     1                        orho = 1./rho(k)
            3655     2                        if ( (ssatw(k).gt. eps) .or. (ssatw(k).lt. -eps .and. &
            3656     2                                  L_qc(k)) ) then
            3657     2                         clap = (qv(k)-qvs(k))/(1. + lvt2(k)*qvs(k))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3658     3   s   fs                do n = 1, 3
            3659     3   s   fs                   fcd = qvs(k)* EXP(lvt2(k)*clap) - qv(k) + clap
            3660     3   s   fs                   dfcd = qvs(k)*lvt2(k)* EXP(lvt2(k)*clap) + 1.
            3661     3   s   fs                   clap = clap - fcd/dfcd
            3662     3   p   fs                enddo
            3663     2                         xrc = rc(k) + clap*rho(k)
            3664     2                         xnc = 0.
            3665     3                         if (xrc.gt. R1) then
            3666     3                          prw_vcd(k) = clap*odt
            3667     3               !+---+-----------------------------------------------------------------+ !  DROPLET NUCLEATION
            3668     4                          if (clap .gt. eps) then
            3669     5                           if (is_aerosol_aware .or. merra2_aerosol_aware) then
            3670     5                              xnc = MAX(2., activ_ncloud(temp(k), w1d(k)+rand3, nwfa(k)))
            3671     5                           else
            3672     6                              if(lsml == 1) then
            3673     6                                xnc = Nt_c_l
            3674     6                              else
            3675     6                                xnc = Nt_c_o
            3676     6                              endif
            3677     5                           endif
            3678     4                           pnc_wcd(k) = 0.5*(xnc-nc(k) + abs(xnc-nc(k)))*odts*orho
            3679     4               
            3680     4               !+---+-----------------------------------------------------------------+ !  EVAPORATION
            3681     4                          elseif (clap .lt. -eps .AND. ssatw(k).lt.-1.E-6 .AND.     &
            3682     4                                 (is_aerosol_aware .or. merra2_aerosol_aware)) then
            3683     4                           tempc = temp(k) - 273.15
            3684     4                           otemp = 1./temp(k)
            3685     4                           rvs = rho(k)*qvs(k)
            3686     4                           rvs_p = rvs*otemp*(lvap(k)*otemp*oRv - 1.)
            3687     4                           rvs_pp = rvs * ( otemp*(lvap(k)*otemp*oRv - 1.) &
            3688     4                                           *otemp*(lvap(k)*otemp*oRv - 1.) &
            3689     4                                           + (-2.*lvap(k)*otemp*otemp*otemp*oRv) &
            3690     4                                           + otemp*otemp)
            3691     4                           gamsc = lvap(k)*diffu(k)/tcond(k) * rvs_p
            3692     4                           alphsc = 0.5*(gamsc/(1.+gamsc))*(gamsc/(1.+gamsc)) &
            3693     4                                      * rvs_pp/rvs_p * rvs/rvs_p
            3694     4                           alphsc = MAX(1.E-9, alphsc)
            3695     4                           xsat = ssatw(k)
            3696     4                           if (abs(xsat).lt. 1.E-9) xsat=0.
            3697     4                           t1_evap = 2.*PI*( 1.0 - alphsc*xsat  &
            3698     4                                  + 2.*alphsc*alphsc*xsat*xsat  &
            3699     4                                  - 5.*alphsc*alphsc*alphsc*xsat*xsat*xsat ) &
            3700     4                                  / (1.+gamsc)
            3701     4               
            3702     4                           Dc_star = DSQRT(-2.D0*DT * t1_evap/(2.*PI) &
            3703     4                                   * 4.*diffu(k)*ssatw(k)*rvs/rho_w)
            3704     4                           idx_d = MAX(1, MIN(INT(1.E6*Dc_star), nbc))
            3705     4               
            3706     4                           idx_n = NINT(1.0 + FLOAT(nbc) * DLOG(nc(k)/t_Nc(1)) / nic1)
            3707     4                           idx_n = MAX(1, MIN(idx_n, nbc))
            3708     4               
            3709     4               !>  - Cloud water lookup table index.
            3710     5                           if (rc(k).gt. r_c(1)) then
            3711     5               !             nic = NINT(ALOG10(rc(k)))
            3712     5                            nic = NINT(DLOG10(rc(k)))
            3713     6                            do nn = nic-1, nic+1
            3714     6                               n = nn
            3715     6                               if ( (rc(k)/10.**nn).ge.1.0 .and. &
            3716     6                                    (rc(k)/10.**nn).lt.10.0) goto 159
            3717     6                            enddo
            3718     5                159         continue
            3719     5                            idx_c = INT(rc(k)/10.**n) + 10*(n-nic2) - (n-nic2)
            3720     5                            idx_c = MAX(1, MIN(idx_c, ntb_c))
            3721     5                           else
            3722     5                            idx_c = 1
            3723     5                           endif
            3724     4               
            3725     4                          !prw_vcd(k) = MAX(DBLE(-rc(k)*orho*odt),                     &
            3726     4                          !           -tpc_wev(idx_d, idx_c, idx_n)*orho*odt)
            3727     4                           prw_vcd(k) = MAX(DBLE(-rc(k)*0.99*orho*odt), prw_vcd(k))
            3728     4                           pnc_wcd(k) = MAX(DBLE(-nc(k)*0.99*orho*odt),                &
            3729     4                                      -tnc_wev(idx_d, idx_c, idx_n)*orho*odt)
            3730     4               
            3731     4                          endif
            3732     3                         else
            3733     3                          prw_vcd(k) = -rc(k)*orho*odt
            3734     3                          pnc_wcd(k) = -nc(k)*orho*odt
            3735     3                         endif
            3736     2               
            3737     2               !+---+-----------------------------------------------------------------+
            3738     2               
            3739     2                         qvten(k) = qvten(k) - prw_vcd(k)
            3740     2                         qcten(k) = qcten(k) + prw_vcd(k)
            3741     2                         ncten(k) = ncten(k) + pnc_wcd(k)
            3742     2                         nwfaten(k) = nwfaten(k) - pnc_wcd(k)
            3743     2                         tten(k) = tten(k) + lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)
            3744     2                         rc(k) = MAX(R1, (qc1d(k) + DT*qcten(k))*rho(k))
            3745     2                         if (rc(k).eq.R1) L_qc(k) = .false.
            3746     2                         nc(k) = MAX(2., MIN((nc1d(k)+ncten(k)*DT)*rho(k), Nt_c_max))
            3747     3                         if (.NOT. (is_aerosol_aware .or. merra2_aerosol_aware)) then
            3748     4                           if(lsml == 1) then
            3749     4                             nc(k) = Nt_c_l
            3750     4                           else
            3751     4                             nc(k) = Nt_c_o
            3752     4                           endif
            3753     3                         endif
            3754     2                         qv(k) = MAX(1.E-10, qv1d(k) + DT*qvten(k))
            3755     2                         temp(k) = t1d(k) + DT*tten(k)
            3756     2                         rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            3757     2    i                    qvs(k) = rslf(pres(k), temp(k))
            3758     2                         ssatw(k) = qv(k)/qvs(k) - 1.
            3759     2                        endif
            3760     1                     enddo
            3761                     
            3762                     !+---+-----------------------------------------------------------------+
            3763                     !> - If still subsaturated, allow rain to evaporate, following
            3764                     !! Srivastava & Coen (1992).
            3765                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 12
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssatw, L_qr, prw_vcd, qv, qvs, rho, ocp
                                   <<<      temp, lvap, tcond, rr, prr_gml, pres
                                   <<<      rhof, rhof2, diffu
                                   <<<    PREFETCH(SOFT) : 32
                                   <<<     SEQUENTIAL : 32
                                   <<<      vsc2: 2, N0_r: 2, visco: 2, nrten: 2
                                   <<<      ilamr: 2, prv_rev: 2, qvten: 2, tten: 2
                                   <<<      t1d: 2, nwfaten: 2, qv1d: 2, qr1d: 2
                                   <<<      qrten: 2, nr1d: 2, nr: 2, pnr_rev: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 12
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 26  FILL 60
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
            3766     1  pp    v            do k = kts, kte
            3767     2   p    v               if ( (ssatw(k).lt. -eps) .and. L_qr(k) &
            3768     2                                    .and. (.not.(prw_vcd(k).gt. 0.)) ) then
            3769     2   p    v                tempc = temp(k) - 273.15
            3770     2   p    v                otemp = 1./temp(k)
            3771     2   p    v                orho = 1./rho(k)
            3772     2   p    v                rhof(k) = SQRT(RHO_NOT*orho)
            3773     2   p    v                rhof2(k) = SQRT(rhof(k))
            3774     2   p    v                diffu(k) = 2.11E-5*(temp(k)/273.15)**1.94 * (101325./pres(k))
            3775     3   p    v                if (tempc .ge. 0.0) then
            3776     3   p    v                   visco(k) = (1.718+0.0049*tempc)*1.0E-5
            3777     3   p    v                else
            3778     3   p    v                   visco(k) = (1.718+0.0049*tempc-1.2E-5*tempc*tempc)*1.0E-5
            3779     3   p    v                endif
            3780     2   p    v                vsc2(k) = SQRT(rho(k)/visco(k))
            3781     2   p    v                lvap(k) = lvap0 + (2106.0 - 4218.0)*tempc
            3782     2   p    v                tcond(k) = (5.69 + 0.0168*tempc)*1.0E-5 * 418.936
            3783     2   p    v                ocp(k) = 1./(Cp*(1.+0.887*qv(k)))
            3784     2               
            3785     2   p    v                rvs = rho(k)*qvs(k)
            3786     2   p    v                rvs_p = rvs*otemp*(lvap(k)*otemp*oRv - 1.)
            3787     2   p    v                rvs_pp = rvs * ( otemp*(lvap(k)*otemp*oRv - 1.) &
            3788     2                                         *otemp*(lvap(k)*otemp*oRv - 1.) &
            3789     2                                         + (-2.*lvap(k)*otemp*otemp*otemp*oRv) &
            3790     2                                         + otemp*otemp)
            3791     2   p    v                gamsc = lvap(k)*diffu(k)/tcond(k) * rvs_p
            3792     2   p    v                alphsc = 0.5*(gamsc/(1.+gamsc))*(gamsc/(1.+gamsc)) &
            3793     2                                    * rvs_pp/rvs_p * rvs/rvs_p
            3794     2   p    v                alphsc = MAX(1.E-9, alphsc)
            3795     2   p    v                xsat   = MIN(-1.E-9, ssatw(k))
            3796     2   p    v                t1_evap = 2.*PI*( 1.0 - alphsc*xsat  &
            3797     2                                + 2.*alphsc*alphsc*xsat*xsat  &
            3798     2                                - 5.*alphsc*alphsc*alphsc*xsat*xsat*xsat ) &
            3799     2                                / (1.+gamsc)
            3800     2               
            3801     2   p    v                lamr = 1./ilamr(k)
            3802     2               !>  - Rapidly eliminate near zero values when low humidity (<95%)
            3803     3   p    v                if (qv(k)/qvs(k) .lt. 0.95 .AND. rr(k)*orho.le.1.E-8) then
            3804     3   p    v                prv_rev(k) = rr(k)*orho*odts
            3805     3   p    v                else
            3806     3   p    v                prv_rev(k) = t1_evap*diffu(k)*(-ssatw(k))*N0_r(k)*rvs &
            3807     3                             * (t1_qr_ev*ilamr(k)**cre(10) &
            3808     3                             + t2_qr_ev*vsc2(k)*rhof2(k)*((lamr+0.5*fv_r)**(-cre(11))))
            3809     3   p    v                rate_max = MIN((rr(k)*orho*odts), (qvs(k)-qv(k))*odts)
            3810     3   p    v                prv_rev(k) = MIN(DBLE(rate_max), prv_rev(k)*orho)
            3811     3               
            3812     3               !..TEST: G. Thompson  10 May 2013
            3813     3               !>  - Reduce the rain evaporation in same places as melting graupel occurs.
            3814     3               !! Rationale: falling and simultaneous melting graupel in subsaturated
            3815     3               !! regions will not melt as fast because particle temperature stays
            3816     3               !! at 0C.  Also not much shedding of the water from the graupel so
            3817     3               !! likely that the water-coated graupel evaporating much slower than
            3818     3               !! if the water was immediately shed off.
            3819     4   p    v                IF (prr_gml(k).gt.0.0) THEN
            3820     4   p    v                   eva_factor = MIN(1.0, 0.01+(0.99-0.01)*(tempc/20.0))
            3821     4   p    v                   prv_rev(k) = prv_rev(k)*eva_factor
            3822     4   p    v                ENDIF
            3823     3   p    v                endif
            3824     2               
            3825     2   p    v                pnr_rev(k) = MIN(DBLE(nr(k)*0.99*orho*odts),                  &   ! RAIN2M
            3826     2                                      prv_rev(k) * nr(k)/rr(k))
            3827     2               
            3828     2   p    v                qrten(k) = qrten(k) - prv_rev(k)
            3829     2   p    v                qvten(k) = qvten(k) + prv_rev(k)
            3830     2   p    v                nrten(k) = nrten(k) - pnr_rev(k)
            3831     2   p    v                nwfaten(k) = nwfaten(k) + pnr_rev(k)
            3832     2   p    v                tten(k) = tten(k) - lvap(k)*ocp(k)*prv_rev(k)*(1-IFDRY)
            3833     2               
            3834     2   p    v                rr(k) = MAX(R1, (qr1d(k) + DT*qrten(k))*rho(k))
            3835     2   p    v                qv(k) = MAX(1.E-10, qv1d(k) + DT*qvten(k))
            3836     2   p    v                nr(k) = MAX(R2, (nr1d(k) + DT*nrten(k))*rho(k))
            3837     2   p    v                temp(k) = t1d(k) + DT*tten(k)
            3838     2   p    v                rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            3839     2   p    v               endif
            3840     1   p    v            enddo

            1820                              deallocate (tprs_ide1)
            1821                              deallocate (tprs_sde1_d)
            1822                              deallocate (tprs_sde1_s)
            1823                              deallocate (tprg_gde1_d)
            1824                              deallocate (tprg_gde1_s)
            1825                              deallocate (tpri_iha1)
            1826                              deallocate (tpri_wfz1)
            1827                              deallocate (tpri_rfz1)
            1828                              deallocate (tprg_rfz1)
            1829                              deallocate (tprs_scw1)

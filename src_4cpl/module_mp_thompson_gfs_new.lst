            1358     2               !..Introduce stochastic parameter perturbations by creating as many scalar rand1, rand2, ...
            1359     2               !.. variables as needed to perturb different pieces of microphysics. gthompsn  21Mar2018
            1360     2               ! Setting spp_mp_opt to 1 gives graupel Y-intercept pertubations (2^0)
            1361     2               !                   2 gives cloud water distribution gamma shape parameter perturbations (2^1)
            1362     2               !                   4 gives CCN & IN activation perturbations (2^2)
            1363     2               !                   3 gives both 1+2
            1364     2               !                   5 gives both 1+4
            1365     2               !                   6 gives both 2+4
            1366     2               !                   7 gives all 1+2+4
            1367     2               ! For now (22Mar2018), standard deviation should be up to 0.75 and cut-off at 3.0
            1368     2               ! stddev in order to constrain the various perturbations from being too extreme.
            1369     2               !+---+-----------------------------------------------------------------+
            1370     2                        rand1 = 0.0
            1371     2                        rand2 = 0.0
            1372     2                        rand3 = 0.0
            1373     3                        if (rand_perturb_on .ne. 0) then
            1374     3                           if (MOD(rand_perturb_on,2) .ne. 0) rand1 = rand_pert(i,1)
            1375     3                           m = RSHIFT(ABS(rand_perturb_on),1)

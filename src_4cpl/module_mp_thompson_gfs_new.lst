                                   <<< Loop-information  End >>>
            3621     2  pp    v            do k = kte, kts, -1
            3622     2               !         ygra1 = alog10(max(1.E-9, rg(k)))
            3623     2   p    v               ygra1 = dlog10(max(1.E-9, rg(k)))
            3624     2   p    v               zans1 = 3.4 + 2./7.*(ygra1+8.) + rand1
            3625     2   p    v               N0_exp = 10.**(zans1)
            3626     2   p    v               N0_exp = MAX(DBLE(gonv_min), MIN(N0_exp, DBLE(gonv_max)))
            3627     2   p    v               lam_exp = (N0_exp*am_g*cgg(1)/rg(k))**oge1
            3628     2   p    v               lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg

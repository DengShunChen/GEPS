            3443     2                                                    + prs_ide(k) + prs_sde(k) &
            3444     2                                                    + prg_gde(k) + pri_iha(k)) &
            3445     2                                    + lfus2*ocp(k)*(pri_wfz(k) + pri_rfz(k) &
            3446     2                                                    + prg_rfz(k) + prs_scw(k) &
            3447     2                                                    + prg_scw(k) + prg_gcw(k) &
            3448     2                                                    + prg_rcs(k) + prs_rcs(k) &
            3449     2                                                    + prr_rci(k) + prg_rcg(k)) &
            3450     2                                      )*orho * (1-IFDRY)
            3451     2   p    v               else
            3452     2   p    v                tten(k) = tten(k) &
            3453     2                                   + ( lfus*ocp(k)*(-prr_sml(k) - prr_gml(k) &
            3454     2                                                    - prr_rcg(k) - prr_rcs(k)) &
            3455     2                                     + lsub*ocp(k)*(prs_sde(k) + prg_gde(k)) &
            3456     2                                      )*orho * (1-IFDRY)
            3457     2   p    v               endif
            3458     1               
            3459     1   p    v            enddo

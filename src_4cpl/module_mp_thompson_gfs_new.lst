             438                     !+---+-----------------------------------------------------------------+
             439                     !+---+
             440                     !ctrlL
             441                     
             442                           CONTAINS
             443                     !>\ingroup aathompson
             444                     !! This subroutine calculates simplified cloud species equations and create
             445                     !! lookup tables in Thomspson scheme.
             446                     !>\section gen_thompson_init thompson_init General Algorithm
             447                     !> @{
             448                           SUBROUTINE thompson_init(is_aerosol_aware_in,                     &
             449                                                    merra2_aerosol_aware_in,                 &
             450                                                    mpirank, mpiroot, errmsg, errflg)
             451                     !                               mpicomm, mpirank, mpiroot)
             452                     !                               mpicomm, mpirank, mpiroot, &
             453                     !                               threads, errmsg, errflg)
             454                     
             455                           IMPLICIT NONE
             456                     
             457                           LOGICAL, INTENT(IN) :: is_aerosol_aware_in
             458                           LOGICAL, INTENT(IN) :: merra2_aerosol_aware_in
             459                     !      INTEGER, INTENT(IN) :: mpicomm
             460                           INTEGER, INTENT(IN) ::mpirank, mpiroot
             461                     !      INTEGER, INTENT(IN) :: threads
             462                           CHARACTER(len=*), INTENT(INOUT) :: errmsg
             463                           INTEGER,          INTENT(INOUT) :: errflg
             464                     
             465                           INTEGER:: i, j, k, l, m, n
             466                           LOGICAL:: micro_init
             467                           real :: stime, etime
             468                           LOGICAL, PARAMETER :: precomputed_tables = .FALSE.
             469                     
             470                     ! Set module variable is_aerosol_aware/merra2_aerosol_aware
             471                           is_aerosol_aware = is_aerosol_aware_in
             472                           merra2_aerosol_aware = merra2_aerosol_aware_in
             473     1                     if (is_aerosol_aware .and. merra2_aerosol_aware) then
             474     1                         errmsg = 'Logic error in thompson_init: ' //                  &
             475     1                                  'only one of the two options can be true, ' //       &
             476     1                                  'not both: is_aerosol_aware or merra2_aerosol_aware'
             477     1                         errflg = 1
             478     1                         return
             479     1                     end if
             480     1                     if (mpirank==mpiroot) then
             481     2                         if (is_aerosol_aware) then
             482     2                             write (0,'(a)') &
             483     2                             'Using aerosol-aware version of Thompson MP'
             484     2                         else if(merra2_aerosol_aware) then
             485     2                             write (0,'(a)') &
             486     2                             'Using merra2 aerosol-aware version of Thompson MP'
             487     2                         else
             488     2                             write (0,'(a)') &
             489     2                             'Using non-aerosol-aware version of Thompson MP'
             490     2                         end if
             491     1                     end if
             492                     
             493                           micro_init = .FALSE.
             494                     
             495                     !> - Allocate space for lookup tables (J. Michalakes 2009Jun08).
             496                     
             497     1                     if (.NOT. ALLOCATED(tcg_racg) ) then
             498     1                        ALLOCATE(tcg_racg(ntb_g1,ntb_g,ntb_r1,ntb_r))
             499     1                        micro_init = .TRUE.
             500     1                     endif
             501                     
             502                           if (.NOT. ALLOCATED(tmr_racg)) ALLOCATE(tmr_racg(ntb_g1,ntb_g,ntb_r1,ntb_r))
             503                           if (.NOT. ALLOCATED(tcr_gacr)) ALLOCATE(tcr_gacr(ntb_g1,ntb_g,ntb_r1,ntb_r))
             504                           if (.NOT. ALLOCATED(tmg_gacr)) ALLOCATE(tmg_gacr(ntb_g1,ntb_g,ntb_r1,ntb_r))
             505                           if (.NOT. ALLOCATED(tnr_racg)) ALLOCATE(tnr_racg(ntb_g1,ntb_g,ntb_r1,ntb_r))
             506                           if (.NOT. ALLOCATED(tnr_gacr)) ALLOCATE(tnr_gacr(ntb_g1,ntb_g,ntb_r1,ntb_r))
             507                     
             508                           if (.NOT. ALLOCATED(tcs_racs1)) ALLOCATE(tcs_racs1(ntb_s,ntb_t,ntb_r1,ntb_r))
             509                           if (.NOT. ALLOCATED(tmr_racs1)) ALLOCATE(tmr_racs1(ntb_s,ntb_t,ntb_r1,ntb_r))
             510                           if (.NOT. ALLOCATED(tcs_racs2)) ALLOCATE(tcs_racs2(ntb_s,ntb_t,ntb_r1,ntb_r))
             511                           if (.NOT. ALLOCATED(tmr_racs2)) ALLOCATE(tmr_racs2(ntb_s,ntb_t,ntb_r1,ntb_r))
             512                           if (.NOT. ALLOCATED(tcr_sacr1)) ALLOCATE(tcr_sacr1(ntb_s,ntb_t,ntb_r1,ntb_r))
             513                           if (.NOT. ALLOCATED(tms_sacr1)) ALLOCATE(tms_sacr1(ntb_s,ntb_t,ntb_r1,ntb_r))
             514                           if (.NOT. ALLOCATED(tcr_sacr2)) ALLOCATE(tcr_sacr2(ntb_s,ntb_t,ntb_r1,ntb_r))
             515                           if (.NOT. ALLOCATED(tms_sacr2)) ALLOCATE(tms_sacr2(ntb_s,ntb_t,ntb_r1,ntb_r))
             516                           if (.NOT. ALLOCATED(tnr_racs1)) ALLOCATE(tnr_racs1(ntb_s,ntb_t,ntb_r1,ntb_r))
             517                           if (.NOT. ALLOCATED(tnr_racs2)) ALLOCATE(tnr_racs2(ntb_s,ntb_t,ntb_r1,ntb_r))
             518                           if (.NOT. ALLOCATED(tnr_sacr1)) ALLOCATE(tnr_sacr1(ntb_s,ntb_t,ntb_r1,ntb_r))
             519                           if (.NOT. ALLOCATED(tnr_sacr2)) ALLOCATE(tnr_sacr2(ntb_s,ntb_t,ntb_r1,ntb_r))
             520                     
             521                           if (.NOT. ALLOCATED(tpi_qcfz)) ALLOCATE(tpi_qcfz(ntb_c,nbc,45,ntb_IN))
             522                           if (.NOT. ALLOCATED(tni_qcfz)) ALLOCATE(tni_qcfz(ntb_c,nbc,45,ntb_IN))
             523                     
             524                           if (.NOT. ALLOCATED(tpi_qrfz)) ALLOCATE(tpi_qrfz(ntb_r,ntb_r1,45,ntb_IN))
             525                           if (.NOT. ALLOCATED(tpg_qrfz)) ALLOCATE(tpg_qrfz(ntb_r,ntb_r1,45,ntb_IN))
             526                           if (.NOT. ALLOCATED(tni_qrfz)) ALLOCATE(tni_qrfz(ntb_r,ntb_r1,45,ntb_IN))
             527                           if (.NOT. ALLOCATED(tnr_qrfz)) ALLOCATE(tnr_qrfz(ntb_r,ntb_r1,45,ntb_IN))
             528                     
             529                           if (.NOT. ALLOCATED(tps_iaus)) ALLOCATE(tps_iaus(ntb_i,ntb_i1))
             530                           if (.NOT. ALLOCATED(tni_iaus)) ALLOCATE(tni_iaus(ntb_i,ntb_i1))
             531                           if (.NOT. ALLOCATED(tpi_ide)) ALLOCATE(tpi_ide(ntb_i,ntb_i1))
             532                     
             533                           if (.NOT. ALLOCATED(t_Efrw)) ALLOCATE(t_Efrw(nbr,nbc))
             534                           if (.NOT. ALLOCATED(t_Efsw)) ALLOCATE(t_Efsw(nbs,nbc))
             535                     
             536                           if (.NOT. ALLOCATED(tnr_rev)) ALLOCATE(tnr_rev(nbr, ntb_r1, ntb_r))
             537                           if (.NOT. ALLOCATED(tpc_wev)) ALLOCATE(tpc_wev(nbc,ntb_c,nbc))
             538                           if (.NOT. ALLOCATED(tnc_wev)) ALLOCATE(tnc_wev(nbc,ntb_c,nbc))
             539                     
             540                           if (.NOT. ALLOCATED(tnccn_act))                                   &
             541                                 ALLOCATE(tnccn_act(ntb_arc,ntb_arw,ntb_art,ntb_arr,ntb_ark))
             542                     
             543     1                     if_micro_init: if (micro_init) then
             544     1               
             545     1               !> - From Martin et al. (1994), assign gamma shape parameter mu for cloud
             546     1               !! drops according to general dispersion characteristics (disp=~0.25
             547     1               !! for maritime and 0.45 for continental)
             548     1               !.. disp=SQRT((mu+2)/(mu+1) - 1) so mu varies from 15 for Maritime
             549     1               !.. to 2 for really dirty air.  This not used in 2-moment cloud water
             550     1               !.. scheme and nu_c used instead and varies from 2 to 15 (integer-only).
             551     1                     mu_c_l = MIN(15., (1000.E6/Nt_c_l + 2.))
             552     1                     mu_c_o = MIN(15., (1000.E6/Nt_c_o + 2.))
             553     1               
             554     1               !> - Compute Schmidt number to one-third used numerous times
             555     1                     Sc3 = Sc**(1./3.)
             556     1               
             557     1               !> - Compute minimum ice diam from mass, min snow/graupel mass from diam
             558     1                     D0i = (xm0i/am_i)**(1./bm_i)
             559     1                     xm0s = am_s * D0s**bm_s
             560     1                     xm0g = am_g * D0g**bm_g
             561     1               
             562     1               !> - Compute constants various exponents and gamma() associated with cloud,
             563     1               !! rain, snow, and graupel
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cce, ccg, ocg2, ocg1
                                   <<< Loop-information  End >>>
             564     2                     do n = 1, 15
             565     2                        cce(1,n) = n + 1.
             566     2                        cce(2,n) = bm_r + n + 1.
             567     2                        cce(3,n) = bm_r + n + 4.
             568     2                        cce(4,n) = n + bv_c + 1.
             569     2                        cce(5,n) = bm_r + n + bv_c + 1.
             570     2    i                   ccg(1,n) = WGAMMA(cce(1,n))

            1906                     !+---+-----------------------------------------------------------------+
            1907                     !ctrlL
            1908                     !+---+-----------------------------------------------------------------+
            1909                     !+---+-----------------------------------------------------------------+
            1910                     
            1911                     !>\ingroup aathompson
            1912                     !! This subroutine computes the moisture tendencies of water vapor,
            1913                     !! cloud droplets, rain, cloud ice (pristine), snow, and graupel.
            1914                     !! Previously this code was based on Reisner et al (1998), but few of
            1915                     !! those pieces remain.  A complete description is now found in
            1916                     !! Thompson et al. (2004, 2008)\cite Thompson_2004 \cite Thompson_2008.
            1917                     !>\section gen_mp_thompson  mp_thompson General Algorithm
            1918                     !> @{
            1919                           subroutine mp_thompson (qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
            1920                                            nr1d, nc1d, nwfa1d, nifa1d, t1d, p1d, w1d, dzq,  &
            1921                                            lsml, pptrain, pptsnow, pptgraul, pptice,        &
            1922                     #if ( WRF_CHEM == 1 )
            1923                                            rainprod, evapprod,                              &
            1924                     #endif
            1925                                            rand1, rand2, rand3,                             &
            1926                                            kts, kte, dt, ii,                                &
            1927                                               ! Extended diagnostics, most arrays only
            1928                                               ! allocated if ext_diag flag is .true.
            1929                                            ext_diag,                                        &
            1930                                            sedi_semi, decfl,                                &
            1931                     #ifdef EXT_DIAG
            1932                                             !vtsk1, txri1, txrc1,                            &
            1933                                            prw_vcdc1, prw_vcde1,                            &
            1934                                            tpri_inu1, tpri_ide1_d, tpri_ide1_s, tprs_ide1,  &
            1935                                            tprs_sde1_d, tprs_sde1_s,                        &
            1936                                            tprg_gde1_d, tprg_gde1_s, tpri_iha1, tpri_wfz1,  &
            1937                                            tpri_rfz1, tprg_rfz1, tprs_scw1, tprg_scw1,      &
            1938                                            tprg_rcs1, tprs_rcs1, tprr_rci1,                 &
            1939                                            tprg_rcg1, tprw_vcd1_c,                          &
            1940                                            tprw_vcd1_e, tprr_sml1, tprr_gml1, tprr_rcg1,    &
            1941                                            tprr_rcs1, tprv_rev1,                            &
            1942                                            tten1, qvten1, qrten1, qsten1,                   &
            1943                                            qgten1, qiten1, niten1, nrten1, ncten1, qcten1,  &
            1944                     #endif
            1945                                            pfil1, pfll1)
            1946                     
            1947                     #ifdef MPI
            1948                           use mpi
            1949                     #endif
            1950                           implicit none
            1951                     
            1952                     !..Sub arguments
            1953                           INTEGER, INTENT(IN):: kts, kte, ii!, jj
            1954                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: &
            1955                                               qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
            1956                                               nr1d, nc1d, nwfa1d, nifa1d, t1d
            1957                           REAL, DIMENSION(kts:kte), INTENT(OUT):: pfil1, pfll1
            1958                           REAL, DIMENSION(kts:kte), INTENT(IN):: p1d, w1d, dzq
            1959                           REAL, INTENT(INOUT):: pptrain, pptsnow, pptgraul, pptice
            1960                           REAL, INTENT(IN):: dt
            1961                           INTEGER, INTENT(IN):: lsml
            1962                           REAL, INTENT(IN):: rand1, rand2, rand3
            1963                           ! Extended diagnostics, most arrays only allocated if ext_diag is true
            1964                           LOGICAL, INTENT(IN) :: ext_diag
            1965                           LOGICAL, INTENT(IN) :: sedi_semi
            1966                           INTEGER, INTENT(IN) :: decfl
            1967                     #ifdef EXT_DIAG
            1968                           REAL, DIMENSION(:), INTENT(OUT):: &
            1969                                               !vtsk1, txri1, txrc1,                       &
            1970                                               prw_vcdc1,                                 &
            1971                                               prw_vcde1, tpri_inu1, tpri_ide1_d,         &
            1972                                               tpri_ide1_s, tprs_ide1,                    &
            1973                                               tprs_sde1_d, tprs_sde1_s, tprg_gde1_d,     &
            1974                                               tprg_gde1_s, tpri_iha1, tpri_wfz1,         &
            1975                                               tpri_rfz1, tprg_rfz1, tprs_scw1, tprg_scw1,&
            1976                                               tprg_rcs1, tprs_rcs1,                      &
            1977                                               tprr_rci1, tprg_rcg1,                      &
            1978                                               tprw_vcd1_c, tprw_vcd1_e, tprr_sml1,       &
            1979                                               tprr_gml1, tprr_rcg1,                      &
            1980                                               tprr_rcs1, tprv_rev1, tten1, qvten1,       &
            1981                                               qrten1, qsten1, qgten1, qiten1, niten1,    &
            1982                                               nrten1, ncten1, qcten1
            1983                     #endif
            1984                     
            1985                     #if ( WRF_CHEM == 1 )
            1986                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: &
            1987                                               rainprod, evapprod
            1988                     #endif
            1989                     
            1990                     !..Local variables
            1991                           REAL, DIMENSION(kts:kte):: tten, qvten, qcten, qiten, &
            1992                                qrten, qsten, qgten, niten, nrten, ncten, nwfaten, nifaten
            1993                     
            1994                           DOUBLE PRECISION, DIMENSION(kts:kte):: prw_vcd
            1995                     
            1996                           DOUBLE PRECISION, DIMENSION(kts:kte):: pnc_wcd, pnc_wau, pnc_rcw, &
            1997                                pnc_scw, pnc_gcw
            1998                     
            1999                           DOUBLE PRECISION, DIMENSION(kts:kte):: pna_rca, pna_sca, pna_gca, &
            2000                                pnd_rcd, pnd_scd, pnd_gcd
            2001                     
            2002                           DOUBLE PRECISION, DIMENSION(kts:kte):: prr_wau, prr_rcw, prr_rcs, &
            2003                                prr_rcg, prr_sml, prr_gml, &
            2004                                prr_rci, prv_rev,          &
            2005                                pnr_wau, pnr_rcs, pnr_rcg, &
            2006                                pnr_rci, pnr_sml, pnr_gml, &
            2007                                pnr_rev, pnr_rcr, pnr_rfz
            2008                     
            2009                           DOUBLE PRECISION, DIMENSION(kts:kte):: pri_inu, pni_inu, pri_ihm, &
            2010                                pni_ihm, pri_wfz, pni_wfz, &
            2011                                pri_rfz, pni_rfz, pri_ide, &
            2012                                pni_ide, pri_rci, pni_rci, &
            2013                                pni_sci, pni_iau, pri_iha, pni_iha
            2014                     
            2015                           DOUBLE PRECISION, DIMENSION(kts:kte):: prs_iau, prs_sci, prs_rcs, &
            2016                                prs_scw, prs_sde, prs_ihm, &
            2017                                prs_ide
            2018                     
            2019                           DOUBLE PRECISION, DIMENSION(kts:kte):: prg_scw, prg_rfz, prg_gde, &
            2020                                prg_gcw, prg_rci, prg_rcs, &
            2021                                prg_rcg, prg_ihm
            2022                     
            2023                           DOUBLE PRECISION, PARAMETER:: zeroD0 = 0.0d0
            2024                           REAL :: dtcfl,rainsfc,graulsfc
            2025                           INTEGER :: niter
            2026                     
            2027                           REAL, DIMENSION(kts:kte):: temp, pres, qv, pfll, pfil, pdummy
            2028                           REAL, DIMENSION(kts:kte):: rc, ri, rr, rs, rg, ni, nr, nc, nwfa, nifa
            2029                           REAL, DIMENSION(kts:kte):: rr_tmp, nr_tmp, rg_tmp
            2030                           REAL, DIMENSION(kts:kte):: rho, rhof, rhof2
            2031                           REAL, DIMENSION(kts:kte):: qvs, qvsi, delQvs
            2032                           REAL, DIMENSION(kts:kte):: satw, sati, ssatw, ssati
            2033                           REAL, DIMENSION(kts:kte):: diffu, visco, vsc2, &
            2034                                tcond, lvap, ocp, lvt2
            2035                     
            2036                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilamg, N0_r, N0_g
            2037                           REAL, DIMENSION(kts:kte):: mvd_r, mvd_c
            2038                           REAL, DIMENSION(kts:kte):: smob, smo2, smo1, smo0, &
            2039                                smoc, smod, smoe, smof
            2040                     
            2041                           REAL, DIMENSION(kts:kte):: sed_r, sed_s, sed_g, sed_i, sed_n,sed_c
            2042                     
            2043                           REAL:: rgvm, delta_tp, orho, lfus2, orhodt
            2044                           REAL, DIMENSION(5):: onstep
            2045                           DOUBLE PRECISION:: N0_exp, N0_min, lam_exp, lamc, lamr, lamg
            2046                           DOUBLE PRECISION:: lami, ilami, ilamc
            2047                           REAL:: xDc, Dc_b, Dc_g, xDi, xDr, xDs, xDg, Ds_m, Dg_m
            2048                           DOUBLE PRECISION:: Dr_star, Dc_star
            2049                           REAL:: zeta1, zeta, taud, tau
            2050                           REAL:: stoke_r, stoke_s, stoke_g, stoke_i
            2051                           REAL:: vti, vtr, vts, vtg, vtc
            2052                           REAL, DIMENSION(kts:kte+1):: vtik, vtnik, vtrk, vtnrk, vtsk, vtgk,  &
            2053                                vtck, vtnck
            2054                           REAL, DIMENSION(kts:kte):: vts_boost
            2055                           REAL:: Mrat, ils1, ils2, t1_vts, t2_vts, t3_vts, t4_vts, C_snow
            2056                           REAL:: a_, b_, loga_, A1, A2, tf
            2057                           REAL:: tempc, tc0, r_mvd1, r_mvd2, xkrat
            2058                           REAL:: xnc, xri, xni, xmi, oxmi, xrc, xrr, xnr
            2059                           REAL:: xsat, rate_max, sump, ratio
            2060                           REAL:: clap, fcd, dfcd
            2061                           REAL:: otemp, rvs, rvs_p, rvs_pp, gamsc, alphsc, t1_evap, t1_subl
            2062                           REAL:: r_frac, g_frac
            2063                           REAL:: Ef_rw, Ef_sw, Ef_gw, Ef_rr
            2064                           REAL:: Ef_ra, Ef_sa, Ef_ga
            2065                           REAL:: dtsave, odts, odt, odzq, hgt_agl, SR
            2066                           REAL:: xslw1, ygra1, zans1, eva_factor
            2067                           REAL:: av_i
            2068                           INTEGER:: i, k, k2, n, nn, nstep, k_0, kbot, IT, iexfrq
            2069                           INTEGER, DIMENSION(5):: ksed1
            2070                           INTEGER:: nir, nis, nig, nii, nic, niin
            2071                           INTEGER:: idx_tc, idx_t, idx_s, idx_g1, idx_g, idx_r1, idx_r,     &
            2072                                     idx_i1, idx_i, idx_c, idx, idx_d, idx_n, idx_in
            2073                     
            2074                           LOGICAL:: no_micro
            2075                           LOGICAL, DIMENSION(kts:kte):: L_qc, L_qi, L_qr, L_qs, L_qg
            2076                           LOGICAL:: debug_flag
            2077                           INTEGER:: nu_c
            2078                     
            2079                     !+---+
            2080                     
            2081                           debug_flag = .false.
            2082                     !     if (ii.eq.901 .and. jj.eq.379) debug_flag = .true.
            2083     1                     if(debug_flag) then
            2084     1                       write(*, *) 'DEBUG INFO, mp_thompson at i ', ii
            2085     1                     endif
            2086                     
            2087                           no_micro = .true.
            2088                           dtsave = dt
            2089                           odt = 1./dt
            2090                           odts = 1./dtsave
            2091                           iexfrq = 1
            2092                     ! Transition value of coefficient matching at crossover from cloud ice to snow
            2093                           av_i = av_s * D0s ** (bv_s - bv_i)
            2094                     
            2095                     !+---+-----------------------------------------------------------------+
            2096                     !> - Initialize Source/sink terms.  First 2 chars: "pr" represents source/sink of
            2097                     !! mass while "pn" represents source/sink of number.  Next char is one
            2098                     !! of "v" for water vapor, "r" for rain, "i" for cloud ice, "w" for
            2099                     !! cloud water, "s" for snow, and "g" for graupel.  Next chars
            2100                     !! represent processes: "de" for sublimation/deposition, "ev" for
            2101                     !! evaporation, "fz" for freezing, "ml" for melting, "au" for
            2102                     !! autoconversion, "nu" for ice nucleation, "hm" for Hallet/Mossop
            2103                     !! secondary ice production, and "c" for collection followed by the
            2104                     !! character for the species being collected.  ALL of these terms are
            2105                     !! positive (except for deposition/sublimation terms which can switch
            2106                     !! signs based on super/subsaturation) and are treated as negatives
            2107                     !! where necessary in the tendency equations.
            2108                     !+---+-----------------------------------------------------------------+
            2109                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 68
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prs_scw, prs_sde, prs_ihm, prg_rcg
                                   <<<      prs_sci, prg_ihm, pna_rca, pna_sca
                                   <<<      prs_rcs, prs_ide, prg_scw, prg_rfz
                                   <<<      prg_gde, prg_gcw, prg_rci, prg_rcs
                                   <<<    PREFETCH(SOFT) : 122
                                   <<<     SEQUENTIAL : 122
                                   <<<      pna_gca: 2, pnd_rcd: 2, pnd_scd: 2
                                   <<<      pnd_gcd: 2, pfil1: 2, pfll1: 2, pfil: 2
                                   <<<      pfll: 2, pdummy: 2, tten: 2, qvten: 2
                                   <<<      qcten: 2, qiten: 2, qrten: 2, qsten: 2
                                   <<<      qgten: 2, niten: 2, nrten: 2, ncten: 2
                                   <<<      nwfaten: 2, nifaten: 2, prw_vcd: 2
                                   <<<      pnc_wcd: 2, pnc_wau: 2, pnc_rcw: 2
                                   <<<      pnc_scw: 2, pnc_gcw: 2, prv_rev: 2
                                   <<<      prr_wau: 2, prr_rcw: 2, prr_rcs: 2
                                   <<<      prr_rcg: 2, prr_sml: 2, prr_gml: 2
                                   <<<      prr_rci: 2, pnr_wau: 2, pnr_rcs: 2
                                   <<<      pnr_rcg: 2, pnr_rci: 2, pnr_sml: 2
                                   <<<      pnr_gml: 2, pnr_rev: 2, pnr_rcr: 2
                                   <<<      pnr_rfz: 2, pri_inu: 2, pni_inu: 2
                                   <<<      pri_ihm: 2, pni_ihm: 2, pri_wfz: 2
                                   <<<      pni_wfz: 2, pri_rfz: 2, pni_rfz: 2
                                   <<<      pri_ide: 2, pni_ide: 2, pri_rci: 2
                                   <<<      pni_rci: 2, pni_sci: 2, pni_iau: 2
                                   <<<      pri_iha: 2, pni_iha: 2, prs_iau: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 50
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2110     1  pp    v            do k = kts, kte
            2111     1   p    v               tten(k) = 0.
            2112     1   p    v               qvten(k) = 0.
            2113     1   p    v               qcten(k) = 0.
            2114     1   p    v               qiten(k) = 0.
            2115     1   p    v               qrten(k) = 0.
            2116     1   p    v               qsten(k) = 0.
            2117     1   p    v               qgten(k) = 0.
            2118     1   p    v               niten(k) = 0.
            2119     1   p    v               nrten(k) = 0.
            2120     1   p    v               ncten(k) = 0.
            2121     1   p    v               nwfaten(k) = 0.
            2122     1   p    v               nifaten(k) = 0.
            2123     1               
            2124     1   p    v               prw_vcd(k) = 0.
            2125     1               
            2126     1   p    v               pnc_wcd(k) = 0.
            2127     1   p    v               pnc_wau(k) = 0.
            2128     1   p    v               pnc_rcw(k) = 0.
            2129     1   p    v               pnc_scw(k) = 0.
            2130     1   p    v               pnc_gcw(k) = 0.
            2131     1               
            2132     1   p    v               prv_rev(k) = 0.
            2133     1   p    v               prr_wau(k) = 0.

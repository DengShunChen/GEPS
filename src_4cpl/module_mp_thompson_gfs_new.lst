            3603     2  pp    v            do k = kte, kts, -1
            3604     2   p    v               ygra1 = alog10(max(1.E-9, rg(k)))
            3605     2   p    v               zans1 = 3.4 + 2./7.*(ygra1+8.) + rand1
            3606     2   p    v               N0_exp = 10.**(zans1)
            3607     2   p    v               N0_exp = MAX(DBLE(gonv_min), MIN(N0_exp, DBLE(gonv_max)))
            3608     2   p    v               lam_exp = (N0_exp*am_g*cgg(1)/rg(k))**oge1

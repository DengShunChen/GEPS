            2382                     !     if (debug_flag) then
            2383                     !      do k = kts, kte
            2384                     !        write(*, '(a,i3,f8.2,1x,f7.2,1x, 11(1x,e13.6))')        &
            2385                     !    &              'VERBOSE: ', k, pres(k)*0.01, temp(k)-273.15, qv(k), rc(k), rr(k), ri(k), rs(k), rg(k), nc(k), nr(k), ni(k), nwfa(k), nifa(k)
            2386                     !      enddo
            2387                     !     endif
            2388                     !+---+-----------------------------------------------------------------+
            2389                     
            2390                     !+---+-----------------------------------------------------------------+
            2391                     !> - Derive various thermodynamic variables frequently used.
            2392                     !! Saturation vapor pressure (mixing ratio) over liquid/ice comes from
            2393                     !! Flatau et al. 1992; enthalpy (latent heat) of vaporization from
            2394                     !! Bohren & Albrecht 1998; others from Pruppacher & Klett 1978.
            2395                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rho, pres, temp, rhof, rhof2, qv, qvs
                                   <<<      delQvs, qvsi, satw, sati, ssatw, ssati
                                   <<<      diffu
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      visco: 2, ocp: 2, vsc2: 2, lvap: 2
                                   <<<      tcond: 2
                                   <<< Loop-information  End >>>
            2396     1   s    s            do k = kts, kte
            2397     1   p    v               tempc = temp(k) - 273.15
            2398     1   p    v               rhof(k) = SQRT(RHO_NOT/rho(k))
            2399     1   p    v               rhof2(k) = SQRT(rhof(k))
            2400     1   pi   v               qvs(k) = rslf(pres(k), temp(k))
            2401     1   pi   v               delQvs(k) = MAX(0.0, rslf(pres(k), 273.15)-qv(k))
            2402     2   p    v               if (tempc .le. 0.0) then
            2403     2   pi   v                qvsi(k) = rsif(pres(k), temp(k))
            2404     2   p    v               else
            2405     2   p    v                qvsi(k) = qvs(k)
            2406     2   p    v               endif
            2407     1   p    v               satw(k) = qv(k)/qvs(k)
            2408     1   p    v               sati(k) = qv(k)/qvsi(k)
            2409     1   p    v               ssatw(k) = satw(k) - 1.
            2410     1   p    v               ssati(k) = sati(k) - 1.
            2411     1   p    v               if (abs(ssatw(k)).lt. eps) ssatw(k) = 0.0
            2412     1   p    v               if (abs(ssati(k)).lt. eps) ssati(k) = 0.0
            2413     1   m    m               if (no_micro .and. ssati(k).gt. 0.0) no_micro = .false.
            2414     1   p    v               diffu(k) = 2.11E-5*(temp(k)/273.15)**1.94 * (101325./pres(k))
            2415     2   p    v               if (tempc .ge. 0.0) then
            2416     2   p    v                  visco(k) = (1.718+0.0049*tempc)*1.0E-5
            2417     2   p    v               else
            2418     2   p    v                  visco(k) = (1.718+0.0049*tempc-1.2E-5*tempc*tempc)*1.0E-5
            2419     2   p    v               endif
            2420     1   p    v               ocp(k) = 1./(Cp*(1.+0.887*qv(k)))
            2421     1   p    v               vsc2(k) = SQRT(rho(k)/visco(k))
            2422     1   p    v               lvap(k) = lvap0 + (2106.0 - 4218.0)*tempc
            2423     1   p    v               tcond(k) = (5.69 + 0.0168*tempc)*1.0E-5 * 418.936
            2424     1   p    v            enddo
            2425                     
            2426                     !+---+-----------------------------------------------------------------+
            2427                     !> - If no existing hydrometeor species and no chance to initiate ice or
            2428                     !! condense cloud water, just exit quickly!
            2429                     !+---+-----------------------------------------------------------------+
            2430                     
            2431                           if (no_micro) return
            2432                     
            2433                     !+---+-----------------------------------------------------------------+
            2434                     !> - Calculate y-intercept, slope, and useful moments for snow.
            2435                     !+---+-----------------------------------------------------------------+
            2436     1                     if (.not. iiwarm) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qs, rs, temp, smob, smo2, smo0, smo1
                                   <<<      smoc, smoe, smof
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 64  FILL 169
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2437     2  pp    v            do k = kts, kte
            2438     2   p    v               if (.not. L_qs(k)) CYCLE
            2439     2   p    v               tc0 = MIN(-0.1, temp(k)-273.15)
            2440     2   p    v               smob(k) = rs(k)*oams
            2441     2               
            2442     2               !>  - All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            2443     2               !! then we must compute actual 2nd moment and use as reference.
            2444     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            2445     3   p    v                  smo2(k) = smob(k)
            2446     3                        else
            2447     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            2448     3                              + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            2449     3                              + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            2450     3                              + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            2451     3                              + sa(10)*bm_s*bm_s*bm_s
            2452     3                           a_ = 10.0**loga_
            2453     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            2454     3                              + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            2455     3                              + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            2456     3                              + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            2457     3                              + sb(10)*bm_s*bm_s*bm_s
            2458     3                           smo2(k) = (smob(k)/a_)**(1./b_)
            2459     3   p    v               endif
            2460     2               
            2461     2               !>  - Calculate 0th moment.  Represents snow number concentration.
            2462     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(5)*tc0*tc0 + sa(9)*tc0*tc0*tc0
            2463     2   p    v               a_ = 10.0**loga_
            2464     2   p    v               b_ = sb(1) + sb(2)*tc0 + sb(5)*tc0*tc0 + sb(9)*tc0*tc0*tc0
            2465     2   p    v               smo0(k) = a_ * smo2(k)**b_
            2466     2               
            2467     2               !>  - Calculate 1st moment.  Useful for depositional growth and melting.
            2468     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3) &
            2469     2                              + sa(4)*tc0 + sa(5)*tc0*tc0 &
            2470     2                              + sa(6) + sa(7)*tc0*tc0 &
            2471     2                              + sa(8)*tc0 + sa(9)*tc0*tc0*tc0 &
            2472     2                              + sa(10)

            1849                     !>\ingroup aathompson
            1850                           SUBROUTINE thompson_finalize()
            1851                     
            1852                           IMPLICIT NONE
            1853                     
            1854                           if (ALLOCATED(tcg_racg)) DEALLOCATE(tcg_racg)
            1855                           if (ALLOCATED(tmr_racg)) DEALLOCATE(tmr_racg)
            1856                           if (ALLOCATED(tcr_gacr)) DEALLOCATE(tcr_gacr)
            1857                           if (ALLOCATED(tmg_gacr)) DEALLOCATE(tmg_gacr)
            1858                           if (ALLOCATED(tnr_racg)) DEALLOCATE(tnr_racg)
            1859                           if (ALLOCATED(tnr_gacr)) DEALLOCATE(tnr_gacr)
            1860                     
            1861                           if (ALLOCATED(tcs_racs1)) DEALLOCATE(tcs_racs1)
            1862                           if (ALLOCATED(tmr_racs1)) DEALLOCATE(tmr_racs1)
            1863                           if (ALLOCATED(tcs_racs2)) DEALLOCATE(tcs_racs2)
            1864                           if (ALLOCATED(tmr_racs2)) DEALLOCATE(tmr_racs2)
            1865                           if (ALLOCATED(tcr_sacr1)) DEALLOCATE(tcr_sacr1)
            1866                           if (ALLOCATED(tms_sacr1)) DEALLOCATE(tms_sacr1)
            1867                           if (ALLOCATED(tcr_sacr2)) DEALLOCATE(tcr_sacr2)
            1868                           if (ALLOCATED(tms_sacr2)) DEALLOCATE(tms_sacr2)
            1869                           if (ALLOCATED(tnr_racs1)) DEALLOCATE(tnr_racs1)
            1870                           if (ALLOCATED(tnr_racs2)) DEALLOCATE(tnr_racs2)
            1871                           if (ALLOCATED(tnr_sacr1)) DEALLOCATE(tnr_sacr1)
            1872                           if (ALLOCATED(tnr_sacr2)) DEALLOCATE(tnr_sacr2)
            1873                     
            1874                           if (ALLOCATED(tpi_qcfz)) DEALLOCATE(tpi_qcfz)
            1875                           if (ALLOCATED(tni_qcfz)) DEALLOCATE(tni_qcfz)
            1876                     
            1877                           if (ALLOCATED(tpi_qrfz)) DEALLOCATE(tpi_qrfz)
            1878                           if (ALLOCATED(tpg_qrfz)) DEALLOCATE(tpg_qrfz)
            1879                           if (ALLOCATED(tni_qrfz)) DEALLOCATE(tni_qrfz)

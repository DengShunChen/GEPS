            4382                                 endif
            4383                     
            4384                                 if(temp(k).lt.T_0)then
            4385                                   tprs_ide1(k) = prs_ide(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4386                                 endif
            4387                     
            4388                                 if(prs_sde(k).gt.0)then
            4389                                    tprs_sde1_d(k) = prs_sde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4390                                 else
            4391                                    tprs_sde1_s(k) = -prs_sde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4392                                 endif
            4393                     
            4394                                 if(prg_gde(k).gt.0)then
            4395                                   tprg_gde1_d(k) = prg_gde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4396                                 else
            4397                                   tprg_gde1_s(k) = -prg_gde(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4398                                 endif
            4399                     
            4400                                 tpri_iha1(k) = pri_iha(k)*lsub*ocp(k)*orho * (1-IFDRY)*DT
            4401                                 tpri_wfz1(k) = pri_wfz(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4402                                 tpri_rfz1(k) = pri_rfz(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4403                                 tprg_rfz1(k) = prg_rfz(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4404                                 tprs_scw1(k) = prs_scw(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4405                                 tprg_scw1(k) = prg_scw(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4406                                 tprg_rcs1(k) = prg_rcs(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4407                     
            4408                                 if(temp(k).lt.T_0)then
            4409                                   tprs_rcs1(k) = prs_rcs(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4410                                 endif
            4411                     
            4412                                 tprr_rci1(k) = prr_rci(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4413                     
            4414                                 if(temp(k).lt.T_0)then
            4415                                    tprg_rcg1(k) = prg_rcg(k)*lfus2*ocp(k)*orho * (1-IFDRY)*DT
            4416                                 endif
            4417                     
            4418                                 if(prw_vcd(k).gt.0)then
            4419                                    tprw_vcd1_c(k) = lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)*DT
            4420                                 else
            4421                                    tprw_vcd1_e(k) = -lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)*DT
            4422                                 endif
            4423                     
            4424                     ! cooling terms
            4425                                 tprr_sml1(k) = prr_sml(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4426                                 tprr_gml1(k) = prr_gml(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4427                     
            4428                                 if(temp(k).ge.T_0)then
            4429                                    tprr_rcg1(k) = -prr_rcg(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4430                                 endif
            4431                     
            4432                                 if(temp(k).ge.T_0)then
            4433                                    tprr_rcs1(k) = -prr_rcs(k)*lfus*ocp(k)*orho * (1-IFDRY)*DT
            4434                                 endif
            4435                     
            4436                                 tprv_rev1(k) = lvap(k)*ocp(k)*prv_rev(k)*(1-IFDRY)*DT
            4437                                 tten1(k) = tten(k)*DT
            4438                                 qvten1(k) = qvten(k)*DT
            4439                                 qiten1(k) = qiten(k)*DT
            4440                                 qrten1(k) = qrten(k)*DT
            4441                                 qsten1(k) = qsten(k)*DT
            4442                                 qgten1(k) = qgten(k)*DT
            4443                                 niten1(k) = niten(k)*DT
            4444                                 nrten1(k) = nrten(k)*DT
            4445                                 ncten1(k) = ncten(k)*DT
            4446                                 qcten1(k) = qcten(k)*DT
            4447                              enddo
            4448                           endif calculate_extended_diagnostics
            4449                     #endif
            4450                     
            4451                           end subroutine mp_thompson
            4452                     !>@}
            4453                     
            4454                     !+---+-----------------------------------------------------------------+
            4455                     !ctrlL
            4456                     !+---+-----------------------------------------------------------------+
            4457                     !..Creation of the lookup tables and support functions found below here.
            4458                     !+---+-----------------------------------------------------------------+
            4459                     !>\ingroup aathompson
            4460                     !! Rain collecting graupel (and inverse).  Explicit CE integration.
            4461                           subroutine qr_acr_qg
            4462                     
            4463                           implicit none
            4464                     
            4465                     !..Local variables
            4466                           INTEGER:: i, j, k, m, n, n2
            4467                           INTEGER:: km, km_s, km_e
            4468                           DOUBLE PRECISION, DIMENSION(nbg):: vg, N_g
            4469                           DOUBLE PRECISION, DIMENSION(nbr):: vr, N_r
            4470                           DOUBLE PRECISION:: N0_r, N0_g, lam_exp, lamg, lamr
            4471                           DOUBLE PRECISION:: massg, massr, dvg, dvr, t1, t2, z1, z2, y1, y2
            4472                     !      LOGICAL force_read_thompson, write_thompson_tables
            4473                     !      LOGICAL lexist,lopen
            4474                     !      INTEGER good,ierr
            4475                     
            4476                     !      force_read_thompson = .false.
            4477                     !      write_thompson_tables = .false.
            4478                     !+---+
            4479                     
            4480                     
            4481                     !      good = 0
            4482                     !        INQUIRE(FILE=qr_acr_qg_file, EXIST=lexist)
            4483                     !#ifdef MPI
            4484                     !        call MPI_BARRIER(mpi_communicator,ierr)
            4485                     !#endif
            4486                     !        IF ( lexist ) THEN
            4487                     !          OPEN(63,file=qr_acr_qg_file,form="unformatted",err=1234)
            4488                     !!sms$serial begin
            4489                     !          READ(63,err=1234) tcg_racg
            4490                     !          READ(63,err=1234) tmr_racg
            4491                     !          READ(63,err=1234) tcr_gacr
            4492                     !          READ(63,err=1234) tmg_gacr
            4493                     !          READ(63,err=1234) tnr_racg
            4494                     !          READ(63,err=1234) tnr_gacr
            4495                     !!sms$serial end
            4496                     !          good = 1
            4497                     ! 1234     CONTINUE
            4498                     !          IF ( good .NE. 1 ) THEN
            4499                     !            INQUIRE(63,opened=lopen)
            4500                     !            IF (lopen) THEN
            4501                     !              IF( force_read_thompson ) THEN
            4502                     !                write(0,*) "Error reading "//qr_acr_qg_file//" Aborting because force_read_thompson is .true."
            4503                     !                return
            4504                     !              ENDIF
            4505                     !              CLOSE(63)
            4506                     !            ELSE
            4507                     !              IF( force_read_thompson ) THEN
            4508                     !                write(0,*) "Error opening "//qr_acr_qg_file//" Aborting because force_read_thompson is .true."
            4509                     !                return
            4510                     !              ENDIF
            4511                     !            ENDIF
            4512                     !         ELSE
            4513                     !            INQUIRE(63,opened=lopen)
            4514                     !            IF (lopen) THEN
            4515                     !              CLOSE(63)
            4516                     !            ENDIF
            4517                     !          ENDIF
            4518                     !        ELSE
            4519                     !          IF( force_read_thompson ) THEN
            4520                     !            write(0,*) "Non-existent "//qr_acr_qg_file//" Aborting because force_read_thompson is .true."
            4521                     !            return
            4522                     !          ENDIF
            4523                     !        ENDIF
            4524                     
            4525                     !      IF (.NOT. good .EQ. 1 ) THEN
            4526                     !        if (thompson_table_writer) then
            4527                     !          write_thompson_tables = .true.
            4528                     !          write(0,*) "ThompMP: computing qr_acr_qg"
            4529                     !        endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4530     1   s   fv              do n2 = 1, nbr
            4531     1               !        vr(n2) = av_r*Dr(n2)**bv_r * DEXP(-fv_r*Dr(n2))
            4532     1   p   fv               vr(n2) = -0.1021 + 4.932E3*Dr(n2) - 0.9551E6*Dr(n2)*Dr(n2)     &
            4533     1                             + 0.07934E9*Dr(n2)*Dr(n2)*Dr(n2)                          &
            4534     1                             - 0.002362E12*Dr(n2)*Dr(n2)*Dr(n2)*Dr(n2)
            4535     1   p   fv              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.10, ITR: 72, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vg, Dg
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 40
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4536     1  pp    v              do n = 1, nbg
            4537     1   p    v               vg(n) = av_g*Dg(n)**bv_g
            4538     1   p    v              enddo
            4539                     
            4540                     !..Note values returned from wrf_dm_decomp1d are zero-based, add 1 for
            4541                     !.. fortran indices.  J. Michalakes, 2009Oct30.
            4542                     
            4543                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            4544                             CALL wrf_dm_decomp1d ( ntb_r*ntb_r1, km_s, km_e )
            4545                     #else
            4546                             km_s = 0
            4547                             km_e = ntb_r*ntb_r1 - 1
            4548                     #endif
            4549                     
            4550     1                       do km = km_s, km_e
            4551     1                        m = km / ntb_r1 + 1
            4552     1                        k = mod( km , ntb_r1 ) + 1
            4553     1               
            4554     1                        lam_exp = (N0r_exp(k)*am_r*crg(1)/r_r(m))**ore1
            4555     1                        lamr = lam_exp * (crg(3)*org2*org1)**obmr
            4556     1                        N0_r = N0r_exp(k)/(crg(2)*lam_exp) * lamr**cre(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtr, Dr, N_r
                                   <<< Loop-information  End >>>
            4557     2  pp    v               do n2 = 1, nbr
            4558     2   p    v                  N_r(n2) = N0_r*Dr(n2)**mu_r *DEXP(-lamr*Dr(n2))*dtr(n2)
            4559     2   p    v               enddo
            4560     1               
            4561     2                        do j = 1, ntb_g
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4562     3                        do i = 1, ntb_g1
            4563     3                           lam_exp = (N0g_exp(i)*am_g*cgg(1)/r_g(j))**oge1
            4564     3                           lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg
            4565     3                           N0_g = N0g_exp(i)/(cgg(2)*lam_exp) * lamg**cge(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtg, Dg, N_g
                                   <<< Loop-information  End >>>
            4566     4  pp    v                  do n = 1, nbg
            4567     4   p    v                     N_g(n) = N0_g*Dg(n)**mu_g * DEXP(-lamg*Dg(n))*dtg(n)
            4568     4   p    v                  enddo
            4569     3               
            4570     3                           t1 = 0.0d0
            4571     3                           t2 = 0.0d0
            4572     3                           z1 = 0.0d0
            4573     3                           z2 = 0.0d0
            4574     3                           y1 = 0.0d0
            4575     3                           y2 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 6  FILL 6
                                   <<<      SCALABLE  : SPILL 0  FILL 17
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4576     4  pp                       do n2 = 1, nbr
            4577     4   p                          massr = am_r * Dr(n2)**bm_r
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4578     5   p   fv                     do n = 1, nbg
            4579     5   p   fv                        massg = am_g * Dg(n)**bm_g
            4580     5               
            4581     5   p   fv                        dvg = 0.5d0*((vr(n2) - vg(n)) + DABS(vr(n2)-vg(n)))
            4582     5   p   fv                        dvr = 0.5d0*((vg(n) - vr(n2)) + DABS(vg(n)-vr(n2)))
            4583     5               
            4584     5   p   fv                        t1 = t1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4585     5                                     *dvg*massg * N_g(n)* N_r(n2)
            4586     5   p   fv                        z1 = z1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4587     5                                     *dvg*massr * N_g(n)* N_r(n2)
            4588     5   p   fv                        y1 = y1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4589     5                                     *dvg       * N_g(n)* N_r(n2)
            4590     5               
            4591     5   p   fv                        t2 = t2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4592     5                                     *dvr*massr * N_g(n)* N_r(n2)
            4593     5   p   fv                        y2 = y2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4594     5                                     *dvr       * N_g(n)* N_r(n2)
            4595     5   p   fv                        z2 = z2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            4596     5                                     *dvr*massg * N_g(n)* N_r(n2)
            4597     5   p   fv                     enddo
            4598     4   p            97            continue
            4599     4   p                       enddo
            4600     3                           tcg_racg(i,j,k,m) = t1
            4601     3                           tmr_racg(i,j,k,m) = DMIN1(z1, r_r(m)*1.0d0)
            4602     3                           tcr_gacr(i,j,k,m) = t2
            4603     3                           tmg_gacr(i,j,k,m) = DMIN1(z2, r_g(j)*1.0d0)
            4604     3                           tnr_racg(i,j,k,m) = y1
            4605     3                           tnr_gacr(i,j,k,m) = y2
            4606     3                        enddo
            4607     2                        enddo
            4608     1                       enddo
            4609                     
            4610                     !        IF ( write_thompson_tables ) THEN
            4611                     !          write(0,*) "Writing "//qr_acr_qg_file//" in Thompson MP init"
            4612                     !          OPEN(63,file=qr_acr_qg_file,form="unformatted",err=9234)
            4613                     !          WRITE(63,err=9234) tcg_racg
            4614                     !          WRITE(63,err=9234) tmr_racg
            4615                     !          WRITE(63,err=9234) tcr_gacr
            4616                     !          WRITE(63,err=9234) tmg_gacr
            4617                     !          WRITE(63,err=9234) tnr_racg
            4618                     !          WRITE(63,err=9234) tnr_gacr
            4619                     !          CLOSE(63)
            4620                     !          RETURN    ! ----- RETURN
            4621                     ! 9234     CONTINUE
            4622                     !          write(0,*) "Error writing "//qr_acr_qg_file
            4623                     !          return
            4624                     !        ENDIF
            4625                     !      ENDIF
            4626                     
            4627                           end subroutine qr_acr_qg
            4628                     !+---+-----------------------------------------------------------------+
            4629                     !ctrlL
            4630                     !+---+-----------------------------------------------------------------+
            4631                     !>\ingroup aathompson
            4632                     !!Rain collecting snow (and inverse).  Explicit CE integration.
            4633                           subroutine qr_acr_qs
            4634                     
            4635                           implicit none
            4636                     
            4637                     !..Local variables
            4638                           INTEGER:: i, j, k, m, n, n2
            4639                           INTEGER:: km, km_s, km_e
            4640                           DOUBLE PRECISION, DIMENSION(nbr):: vr, D1, N_r
            4641                           DOUBLE PRECISION, DIMENSION(nbs):: vs, N_s
            4642                           DOUBLE PRECISION:: loga_, a_, b_, second, M0, M2, M3, Mrat, oM3
            4643                           DOUBLE PRECISION:: N0_r, lam_exp, lamr, slam1, slam2
            4644                           DOUBLE PRECISION:: dvs, dvr, masss, massr
            4645                           DOUBLE PRECISION:: t1, t2, t3, t4, z1, z2, z3, z4
            4646                           DOUBLE PRECISION:: y1, y2, y3, y4
            4647                     !      LOGICAL force_read_thompson, write_thompson_tables
            4648                     !      LOGICAL lexist,lopen
            4649                     !      INTEGER good,ierr
            4650                     
            4651                     !+---+
            4652                     
            4653                     !      force_read_thompson = .false.
            4654                     !      write_thompson_tables = .false.
            4655                     
            4656                     !      good = 0
            4657                     !        INQUIRE(FILE=qr_acr_qs_file, EXIST=lexist)
            4658                     !#ifdef MPI
            4659                     !        call MPI_BARRIER(mpi_communicator,ierr)
            4660                     !#endif
            4661                     !        IF ( lexist ) THEN
            4662                     !          !write(0,*) "ThompMP: read "//qr_acr_qs_file//" instead of computing"
            4663                     !          OPEN(63,file=qr_acr_qs_file,form="unformatted",err=1234)
            4664                     !!sms$serial begin
            4665                     !          READ(63,err=1234)tcs_racs1
            4666                     !          READ(63,err=1234)tmr_racs1
            4667                     !          READ(63,err=1234)tcs_racs2
            4668                     !          READ(63,err=1234)tmr_racs2
            4669                     !          READ(63,err=1234)tcr_sacr1
            4670                     !          READ(63,err=1234)tms_sacr1
            4671                     !          READ(63,err=1234)tcr_sacr2
            4672                     !          READ(63,err=1234)tms_sacr2
            4673                     !          READ(63,err=1234)tnr_racs1
            4674                     !          READ(63,err=1234)tnr_racs2
            4675                     !          READ(63,err=1234)tnr_sacr1
            4676                     !          READ(63,err=1234)tnr_sacr2
            4677                     !!sms$serial end
            4678                     !          good = 1
            4679                     ! 1234     CONTINUE
            4680                     !          IF ( good .NE. 1 ) THEN
            4681                     !            INQUIRE(63,opened=lopen)
            4682                     !            IF (lopen) THEN
            4683                     !              IF( force_read_thompson ) THEN
            4684                     !                write(0,*) "Error reading "//qr_acr_qs_file//" Aborting because force_read_thompson is .true."
            4685                     !                return
            4686                     !              ENDIF
            4687                     !              CLOSE(63)
            4688                     !            ELSE
            4689                     !              IF( force_read_thompson ) THEN
            4690                     !                write(0,*) "Error opening "//qr_acr_qs_file//" Aborting because force_read_thompson is .true."
            4691                     !                return
            4692                     !              ENDIF
            4693                     !            ENDIF
            4694                     !          ELSE
            4695                     !            INQUIRE(63,opened=lopen)
            4696                     !            IF (lopen) THEN
            4697                     !              CLOSE(63)
            4698                     !            ENDIF
            4699                     !          ENDIF
            4700                     !        ELSE
            4701                     !          IF( force_read_thompson ) THEN
            4702                     !            write(0,*) "Non-existent "//qr_acr_qs_file//" Aborting because force_read_thompson is .true."
            4703                     !            return
            4704                     !          ENDIF
            4705                     !        ENDIF
            4706                     
            4707                     !      IF (.NOT. good .EQ. 1 ) THEN
            4708                     !        if (thompson_table_writer) then
            4709                     !          write_thompson_tables = .true.
            4710                     !          write(0,*) "ThompMP: computing qr_acr_qs"
            4711                     !        endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4712     1   s   fv              do n2 = 1, nbr
            4713     1               !        vr(n2) = av_r*Dr(n2)**bv_r * DEXP(-fv_r*Dr(n2))
            4714     1   p   fv               vr(n2) = -0.1021 + 4.932E3*Dr(n2) - 0.9551E6*Dr(n2)*Dr(n2)     &
            4715     1                             + 0.07934E9*Dr(n2)*Dr(n2)*Dr(n2)                          &
            4716     1                             - 0.002362E12*Dr(n2)*Dr(n2)*Dr(n2)*Dr(n2)
            4717     1   p   fv               D1(n2) = (vr(n2)/av_s)**(1./bv_s)
            4718     1   p   fv              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 23
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.11, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vs, Ds
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 28
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4719     1  pp    v              do n = 1, nbs
            4720     1   p    v               vs(n) = 1.5*av_s*Ds(n)**bv_s * DEXP(-fv_s*Ds(n))
            4721     1   p    v              enddo
            4722                     
            4723                     !..Note values returned from wrf_dm_decomp1d are zero-based, add 1 for
            4724                     !.. fortran indices.  J. Michalakes, 2009Oct30.
            4725                     
            4726                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            4727                             CALL wrf_dm_decomp1d ( ntb_r*ntb_r1, km_s, km_e )
            4728                     #else
            4729                             km_s = 0
            4730                             km_e = ntb_r*ntb_r1 - 1
            4731                     #endif
            4732                     
            4733     1                       do km = km_s, km_e
            4734     1                        m = km / ntb_r1 + 1
            4735     1                        k = mod( km , ntb_r1 ) + 1
            4736     1               
            4737     1                        lam_exp = (N0r_exp(k)*am_r*crg(1)/r_r(m))**ore1
            4738     1                        lamr = lam_exp * (crg(3)*org2*org1)**obmr
            4739     1                        N0_r = N0r_exp(k)/(crg(2)*lam_exp) * lamr**cre(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtr, Dr, N_r
                                   <<< Loop-information  End >>>
            4740     2  pp    v               do n2 = 1, nbr
            4741     2   p    v                  N_r(n2) = N0_r*Dr(n2)**mu_r * DEXP(-lamr*Dr(n2))*dtr(n2)
            4742     2   p    v               enddo
            4743     1               
            4744     2                        do j = 1, ntb_t
                                   <<< Loop-information Start >>>

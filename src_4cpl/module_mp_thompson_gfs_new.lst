                                   <<<      SCALABLE  : SPILL 11  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4766     3                           do i = 1, ntb_s
            4767     3               
            4768     3               !..From the bm_s moment, compute plus one moment.  If we are not
            4769     3               !.. using bm_s=2, then we must transform to the pure 2nd moment
            4770     3               !.. (variable called "second") and then to the bm_s+1 moment.
            4771     3               
            4772     3                              M2 = r_s(i)*oams *1.0d0
            4773     4                              if (bm_s.gt.2.0-1.E-3 .and. bm_s.lt.2.0+1.E-3) then
            4774     4                                 loga_ = sa(1) + sa(2)*Tc(j) + sa(3)*bm_s &
            4775     4                                    + sa(4)*Tc(j)*bm_s + sa(5)*Tc(j)*Tc(j) &
            4776     4                                    + sa(6)*bm_s*bm_s + sa(7)*Tc(j)*Tc(j)*bm_s &
            4777     4                                    + sa(8)*Tc(j)*bm_s*bm_s + sa(9)*Tc(j)*Tc(j)*Tc(j) &
            4778     4                                    + sa(10)*bm_s*bm_s*bm_s
            4779     4                                 a_ = 10.0**loga_
            4780     4                                 b_ = sb(1) + sb(2)*Tc(j) + sb(3)*bm_s &
            4781     4                                    + sb(4)*Tc(j)*bm_s + sb(5)*Tc(j)*Tc(j) &
            4782     4                                    + sb(6)*bm_s*bm_s + sb(7)*Tc(j)*Tc(j)*bm_s &
            4783     4                                    + sb(8)*Tc(j)*bm_s*bm_s + sb(9)*Tc(j)*Tc(j)*Tc(j) &
            4784     4                                    + sb(10)*bm_s*bm_s*bm_s
            4785     4                                 second = (M2/a_)**(1./b_)
            4786     4                              else
            4787     4                                 second = M2
            4788     4                              endif
            4789     3               
            4790     3                              loga_ = sa(1) + sa(2)*Tc(j) + sa(3)*cse(1) &
            4791     3                                 + sa(4)*Tc(j)*cse(1) + sa(5)*Tc(j)*Tc(j) &
            4792     3                                 + sa(6)*cse(1)*cse(1) + sa(7)*Tc(j)*Tc(j)*cse(1) &
            4793     3                                 + sa(8)*Tc(j)*cse(1)*cse(1) + sa(9)*Tc(j)*Tc(j)*Tc(j) &
            4794     3                                 + sa(10)*cse(1)*cse(1)*cse(1)
            4795     3                              a_ = 10.0**loga_
            4796     3                              b_ = sb(1)+sb(2)*Tc(j)+sb(3)*cse(1) + sb(4)*Tc(j)*cse(1) &
            4797     3                                 + sb(5)*Tc(j)*Tc(j) + sb(6)*cse(1)*cse(1) &
            4798     3                                 + sb(7)*Tc(j)*Tc(j)*cse(1) + sb(8)*Tc(j)*cse(1)*cse(1) &
            4799     3                                 + sb(9)*Tc(j)*Tc(j)*Tc(j)+sb(10)*cse(1)*cse(1)*cse(1)
            4800     3                              M3 = a_ * second**b_
            4801     3               
            4802     3                              oM3 = 1./M3
            4803     3                              Mrat = M2*(M2*oM3)*(M2*oM3)*(M2*oM3)
            4804     3                              M0   = (M2*oM3)**mu_s
            4805     3                              slam1 = M2 * oM3 * Lam0
            4806     3                              slam2 = M2 * oM3 * Lam1
            4807     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Ds, dts, N_s
                                   <<< Loop-information  End >>>
            4808     4  pp    v                     do n = 1, nbs
            4809     4   p    v                        N_s(n) = Mrat*(Kap0*DEXP(-slam1*Ds(n)) &
            4810     4                                     + Kap1*M0*Ds(n)**mu_s * DEXP(-slam2*Ds(n)))*dts(n)
            4811     4   p    v                     enddo
            4812     3               
            4813     3                              t1 = 0.0d0
            4814     3                              t2 = 0.0d0
            4815     3                              t3 = 0.0d0
            4816     3                              t4 = 0.0d0
            4817     3                              z1 = 0.0d0
            4818     3                              z2 = 0.0d0
            4819     3                              z3 = 0.0d0
            4820     3                              z4 = 0.0d0
            4821     3                              y1 = 0.0d0
            4822     3                              y2 = 0.0d0
            4823     3                              y3 = 0.0d0
            4824     3                              y4 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            4825     4  pp                          do n2 = 1, nbr
            4826     4   p                             massr = am_r * Dr(n2)**bm_r
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 134
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Ds, vs
                                   <<< Loop-information  End >>>
            4827     5   p    s                        do n = 1, nbs
            4828     5   p    m                           masss = am_s * Ds(n)**bm_s
            4829     5               
            4830     5   p    v                           dvs = 0.5d0*((vr(n2) - vs(n)) + DABS(vr(n2)-vs(n)))
            4831     5   p    v                           dvr = 0.5d0*((vs(n) - vr(n2)) + DABS(vs(n)-vr(n2)))
            4832     5               
            4833     6   p    v                           if (massr .gt. 1.5*masss) then
            4834     6   p    m                           t1 = t1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4835     6                                        *dvs*masss * N_s(n)* N_r(n2)
            4836     6   p    s                           z1 = z1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4837     6                                        *dvs*massr * N_s(n)* N_r(n2)
            4838     6   p    s                           y1 = y1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4839     6                                        *dvs       * N_s(n)* N_r(n2)
            4840     6   p                                else
            4841     6   p    s                           t3 = t3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4842     6                                        *dvs*masss * N_s(n)* N_r(n2)
            4843     6   p    s                           z3 = z3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4844     6                                        *dvs*massr * N_s(n)* N_r(n2)
            4845     6   p    s                           y3 = y3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4846     6                                        *dvs       * N_s(n)* N_r(n2)
            4847     6   p    s                           endif
            4848     5               
            4849     6   p    m                           if (massr .gt. 1.5*masss) then
            4850     6   p    m                           t2 = t2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4851     6                                        *dvr*massr * N_s(n)* N_r(n2)
            4852     6   p    s                           y2 = y2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4853     6                                        *dvr       * N_s(n)* N_r(n2)
            4854     6   p    s                           z2 = z2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4855     6                                        *dvr*masss * N_s(n)* N_r(n2)
            4856     6   p                                else
            4857     6   p    s                           t4 = t4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4858     6                                        *dvr*massr * N_s(n)* N_r(n2)
            4859     6   p    s                           y4 = y4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4860     6                                        *dvr       * N_s(n)* N_r(n2)
            4861     6   p    s                           z4 = z4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            4862     6                                        *dvr*masss * N_s(n)* N_r(n2)
            4863     6   p    v                           endif
            4864     5               
            4865     5   p    v                        enddo
            4866     4   p                          enddo
            4867     3                              tcs_racs1(i,j,k,m) = t1
            4868     3                              tmr_racs1(i,j,k,m) = DMIN1(z1, r_r(m)*1.0d0)
            4869     3                              tcs_racs2(i,j,k,m) = t3
            4870     3                              tmr_racs2(i,j,k,m) = z3
            4871     3                              tcr_sacr1(i,j,k,m) = t2
            4872     3                              tms_sacr1(i,j,k,m) = z2
            4873     3                              tcr_sacr2(i,j,k,m) = t4
            4874     3                              tms_sacr2(i,j,k,m) = z4
            4875     3                              tnr_racs1(i,j,k,m) = y1
            4876     3                              tnr_racs2(i,j,k,m) = y3
            4877     3                              tnr_sacr1(i,j,k,m) = y2
            4878     3                              tnr_sacr2(i,j,k,m) = y4
            4879     3                           enddo
            4880     2                        enddo
            4881     1                       enddo
            4882                     
            4883                     !        IF ( write_thompson_tables ) THEN
            4884                     !          write(0,*) "Writing "//qr_acr_qs_file//" in Thompson MP init"
            4885                     !          OPEN(63,file=qr_acr_qs_file,form="unformatted",err=9234)
            4886                     !          WRITE(63,err=9234)tcs_racs1
            4887                     !          WRITE(63,err=9234)tmr_racs1
            4888                     !          WRITE(63,err=9234)tcs_racs2
            4889                     !          WRITE(63,err=9234)tmr_racs2
            4890                     !          WRITE(63,err=9234)tcr_sacr1
            4891                     !          WRITE(63,err=9234)tms_sacr1
            4892                     !          WRITE(63,err=9234)tcr_sacr2
            4893                     !          WRITE(63,err=9234)tms_sacr2
            4894                     !          WRITE(63,err=9234)tnr_racs1
            4895                     !          WRITE(63,err=9234)tnr_racs2
            4896                     !          WRITE(63,err=9234)tnr_sacr1
            4897                     !          WRITE(63,err=9234)tnr_sacr2
            4898                     !          CLOSE(63)

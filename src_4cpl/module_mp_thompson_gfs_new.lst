            2364     2   p                       L_qs(k) = .true.
            2365     2   p                    else
            2366     2   p    s                  qs1d(k) = 0.0
            2367     2   p    v                  rs(k) = R1
            2368     2   p    v                  L_qs(k) = .false.
            2369     2   p    s               endif
            2370     2   p    v               if (qg1d(k) .gt. R1) then
            2371     2   p    m                  no_micro = .false.
            2372     2   p    s                  rg(k) = qg1d(k)*rho(k)
            2373     2   p                       L_qg(k) = .true.
            2374     2   p                    else
            2375     2   p    s                  qg1d(k) = 0.0
            2376     2   p    v                  rg(k) = R1
            2377     2   p    v                  L_qg(k) = .false.
            2378     2   p    v               endif

 External subroutine subprogram "roptir"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine roptir( nr,nx,lev,ib,dz,cld,clwc,ciwc,cre,cde,tauwc  &
               2                                            , tauic,wwc,wic,wwc1,wwc2,wic1,wic2 )
               3                     !
               4                     !#####################################################################
               5                     !
               6                     !  (1)compute the optical properties of clouds for a given ir band.
               7                     !
               8                     !  (2)the optical properties for water clouds use
               9                     !  the mean single scattering properties of the eight drop
              10                     !  size distributions in each spectral band, the single scattering
              11                     !  properties of a water cloud with the given liquid water content
              12                     !  and effective radius are obtained by interpolating (Eqs. 4.25 -
              13                     !  4.27 of Fu, 1991).
              14                     !
              15                     !  (3)the optical properties for ice clouds follow the parameterization
              16                     !  of Fu et al. (1998).
              17                     !
              18                     !  ++ input variables :
              19                     !   ib  : ir band number ( 1 - 12 )
              20                     !   dz(nx*lev) : layer thickness in unit of km
              21                     !   clwc(nx*lev) : cloud liquid water content (g/m3)
              22                     !   cre(nx*lev)  : effective size of water cloud (um)
              23                     !   ciwc(nx*lev) : cloud ice water content (g/m3)
              24                     !   cde(nx*lev)  : effective size of ice cloud (um)
              25                     !
              26                     !  ++ output variables :
              27                     !   tauwc, tauic : optical depth for water and ice clouds
              28                     !   wwc, wic : single scattering albedo
              29                     !   wwc1~2, wic1~2 : first two expansion coeffs. of the phase function
              30                     !
              31                     !#####################################################################
              32                     !
              33                           implicit  none
              34                     
              35                           integer   nr,nx,lev,ib
              36                     
              37                           real      dz(nx*lev),clwc(nx*lev),ciwc(nx*lev),cre(nx*lev)    &
              38                                    ,cde(nx*lev),tauwc(nx*lev),tauic(nx*lev),wwc(nx*lev) &
              39                                    ,wic(nx*lev),wwc1(nx*lev),wwc2(nx*lev),wic1(nx*lev)  &
              40                                    ,wic2(nx*lev),cld(nx*lev)
              41                     !
              42                     !  local arrays
              43                     !
              44                           real      re(8),fl(8),bz(8,12),wz(8,12),gz(8,12)              &
              45                                    ,ap(3,12),bp(4,12),cp(4,12)
              46                     
              47                           integer   ibs(nx*lev),jre(nx*lev)
              48                     !
              49                     ! bz, wz and gz are the extinction coefficient(1/km), single scattering
              50                     ! albedo and asymmetry factor for the water clouds (St II, Sc I, St I,
              51                     ! As, Ns, Sc II, Cu, and Cb) in different bands.   re is the effective
              52                     ! radius and fl is the liquid water content (LWC).  See Tables 4.2-4.4
              53                     ! of Fu (1991).
              54                     !
              55                           data re / 4.18, 5.36, 5.89, 6.16, 9.27, 9.84, 12.10, 31.23 /
              56                           data fl / 0.05, 0.14, 0.22, 0.28, 0.50, 0.47, 1.00, 2.50 /
              57                           data bz /                                                         &
              58                               22.44, 57.35, 84.41,103.50,103.49, 84.17,152.77,132.07        &
              59                           ,   18.32, 52.69, 76.67,100.31,105.46, 92.86,157.82,133.03        &
              60                           ,   17.27, 50.44, 74.18, 96.76,105.32, 95.25,158.07,134.48        &
              61                           ,   13.73, 44.90, 67.70, 90.85,109.16,105.48,163.11,136.21        &
              62                           ,   10.30, 36.28, 57.23, 76.43,106.45,104.90,161.73,136.62        &
              63                           ,    7.16, 26.40, 43.51, 57.24, 92.55, 90.55,149.10,135.13        &
              64                           ,    6.39, 21.00, 33.81, 43.36, 66.90, 63.58,113.83,125.65        &
              65                           ,   10.33, 30.87, 47.63, 60.33, 79.54, 73.92,127.46,128.21        &
              66                           ,   11.86, 35.64, 54.81, 69.85, 90.39, 84.16,142.49,135.25        &
              67                           ,   10.27, 33.08, 51.81, 67.26, 93.24, 88.60,148.71,140.42        &
              68                           ,    6.72, 24.09, 39.42, 51.68, 83.34, 80.72,140.14,143.57        &
              69                           ,    3.92, 14.76, 25.32, 32.63, 60.85, 58.81,112.30,145.62 /
              70                           data wz /                                                         &
              71                               .9193, .8962, .8859, .8810, .8127, .7816, .7754, .6373        &
              72                           ,   .8747, .8611, .8478, .8516, .7871, .7729, .7531, .6186        &
              73                           ,   .7647, .7524, .7365, .7434, .6712, .6593, .6394, .5499        &
              74                           ,   .8075, .8087, .7959, .8054, .7505, .7555, .7094, .5719        &
              75                           ,   .7533, .7720, .7672, .7770, .7512, .7609, .7125, .5682        &
              76                           ,   .6327, .6763, .6846, .6935, .7079, .7177, .6824, .5528        &
              77                           ,   .2888, .3484, .3716, .3803, .4545, .4657, .4754, .4938        &
              78                           ,   .2618, .3062, .3213, .3330, .3929, .4068, .4174, .4845        &
              79                           ,   .2958, .3399, .3524, .3655, .4162, .4303, .4352, .4913        &
              80                           ,   .3012, .3547, .3693, .3819, .4336, .4473, .4474, .4869        &
              81                           ,   .2437, .3187, .3446, .3527, .4279, .4389, .4459, .4772        &
              82                           ,   .1090, .1872, .2268, .2249, .3313, .3359, .3748, .4570 /
              83                           data gz /                                                         &
              84                               .818, .805, .824, .830, .815, .801, .820, .845                &
              85                           ,   .810, .802, .826, .840, .829, .853, .840, .868                &
              86                           ,   .774, .766, .799, .818, .815, .869, .834, .869                &
              87                           ,   .734, .728, .767, .797, .796, .871, .818, .854                &
              88                           ,   .693, .688, .736, .772, .780, .880, .808, .846                &
              89                           ,   .643, .646, .698, .741, .759, .882, .793, .839                &
              90                           ,   .564, .582, .637, .690, .719, .871, .764, .819                &
              91                           ,   .466, .494, .546, .609, .651, .823, .701, .766                &
              92                           ,   .375, .410, .455, .525, .583, .773, .637, .710                &
              93                           ,   .262, .301, .334, .406, .485, .695, .545, .631                &
              94                           ,   .144, .181, .200, .256, .352, .562, .413, .517                &
              95                           ,   .060, .077, .088, .112, .181, .310, .222, .327 /
              96                     !
              97                     !  ap and bp are coefficients to calculate the extiction and
              98                     !  absorption coefficients (1/m) respectively for a randomly
              99                     !  oriented hexagonal ice crystal in the ir band.
             100                     !  cp is the coefficients to calculate the asymmetry factor.
             101                     !  They are based on the table 1 of Fu et al. (1998).
             102                     !  The units of mean effective size and ice water content
             103                     !  in these calculation are um and g/m3 respectively.
             104                     !
             105                           data ap /                                                         &
             106                            -2.3088e-03, 2.8140, 1.0722e+00,-2.4652e-03, 2.8331,-4.2275e-01  &
             107                           ,-3.0345e-03, 2.9000,-1.8499e+00,-4.9366e-03, 3.0877,-3.8842e+00  &
             108                           ,-8.1786e-03, 3.4012,-8.8128e+00,-8.3726e-03, 3.4550,-1.5166e+01  &
             109                           ,-1.6916e-03, 2.7657,-8.3310e+00,-4.1594e-03, 3.0473,-5.0615e+00  &
             110                           ,-9.5241e-03, 3.5877,-1.0688e+01,-1.3348e-02, 4.0438,-2.1710e+01  &
             111                           , 3.3257e-03, 2.6013,-1.9096e+01, 4.9196e-03, 2.3277,-1.3908e+01 /
             112                           data bp/                                                          &
             113                               4.3464e-01,  1.7214e-02, -1.6232e-04,  5.5615e-07             &
             114                           ,   7.4289e-01,  1.2796e-02, -1.3918e-04,  5.1801e-07             &
             115                           ,   8.8624e-01,  1.2265e-02, -1.5230e-04,  6.0008e-07             &
             116                           ,   7.1522e-01,  1.6217e-02, -1.8685e-04,  7.0787e-07             &
             117                           ,   5.8743e-01,  1.8766e-02, -2.0458e-04,  7.5100e-07             &
             118                           ,   5.4095e-01,  1.9496e-02, -2.0509e-04,  7.3646e-07             &
             119                           ,   1.1955e+00,  3.3506e-03, -5.2669e-05,  2.2333e-07             &
             120                           ,   1.4664e+00, -2.1292e-03, -1.3616e-05,  1.1936e-07             &
             121                           ,   9.5514e-01,  1.3097e-02, -1.7936e-04,  7.3133e-07             &
             122                           ,   3.0037e-01,  2.0515e-02, -1.9316e-04,  6.5830e-07             &
             123                           ,   2.0055e-01,  2.1326e-02, -1.7510e-04,  5.3558e-07             &
             124                           ,   8.8697e-01,  2.1184e-02, -2.7814e-04,  1.0945e-06 /
             125                           data cp/                                                          &
             126                               7.9627e-01,  3.0034e-03, -2.0823e-05,  5.3665e-08             &
             127                           ,   8.4729e-01,  2.5599e-03, -2.1826e-05,  6.8799e-08             &
             128                           ,   8.7416e-01,  2.4554e-03, -2.4569e-05,  8.6412e-08             &
             129                           ,   8.5228e-01,  2.5236e-03, -2.1491e-05,  6.6850e-08             &
             130                           ,   8.6096e-01,  2.2004e-03, -1.7481e-05,  5.1766e-08             &
             131                           ,   8.9062e-01,  1.9032e-03, -1.7335e-05,  5.8550e-08             &
             132                           ,   8.6633e-01,  2.7979e-03, -3.1870e-05,  1.2172e-07             &
             133                           ,   7.9840e-01,  3.9771e-03, -4.4719e-05,  1.6949e-07             &
             134                           ,   7.3634e-01,  4.7982e-03, -4.5132e-05,  1.5257e-07             &
             135                           ,   7.2604e-01,  2.6643e-03, -1.2511e-05,  2.2433e-08             &
             136                           ,   6.8914e-01,  6.1922e-03, -6.4595e-05,  2.4369e-07             &
             137                           ,   4.9492e-01,  1.1861e-02, -1.2676e-04,  4.6035e-07 /
             138                     !
             139                     
             140                           integer i,j,ii,nt
             141                           real    gg,x1,x2,fw1,fw2,fw3,bext,babs
             142                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wic2, wic1, wwc2, wwc1, wic, wwc, tauic
                                   <<<      tauwc
                                   <<< Loop-information  End >>>
             143     1  pp    v            do 20 i = 1, nr*lev
             144     1   p    v            tauwc(i) = 0.0
             145     1   p    v            tauic(i) = 0.0
             146     1   p    v            wwc(i)   = 0.0
             147     1   p    v            wic(i)   = 0.0
             148     1   p    v            wwc1(i)  = 0.0
             149     1   p    v            wwc2(i)  = 0.0
             150     1   p    v            wic1(i)  = 0.0
             151     1   p    v            wic2(i)  = 0.0
             152     1   p    v         20 continue
             153                     !
             154                           nt = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cld
                                   <<< Loop-information  End >>>
             155     1        s            do 50 i = 1, nr*lev
             156     2        v             if( cld(i) .gt. 0.01 .and. clwc(i) .gt. 1.0e-5 ) then
             157     2        v               cre(i) = max( re(1)+0.0001, min( re(8)-0.0001, cre(i) ) )
             158     2        m               nt = nt + 1
             159     2        s               ibs(nt) = i
             160     2        v             end if
             161     1        v         50 continue
             162                     !
             163                           if( nt .eq. 0 ) go to 190
             164                     !
             165     1                     do 60 j  = 1, 7
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ibs
                                   <<< Loop-information  End >>>
             166     2  pp   2s            do 60 ii = 1, nt
             167     2   p   2v             i = ibs(ii)
             168     3   p   2m             if(cre(i) .ge. re(j) .and. cre(i) .le. re(j+1)) then
             169     3   p   2s               jre(ii) = j
             170     3   p   2v             end if
             171     1   p   2v         60 continue
             172                     !
             173                     !-----------------------------------
             174                     !  water cloud optical properties
             175                     !-----------------------------------
             176                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ibs, jre
                                   <<< Loop-information  End >>>
             177     1   s    v            do 100 ii = 1, nt
             178     1   p    v              i = ibs(ii)
             179     1   p    v              j = jre(ii)
             180     1               !
             181     1               ! A cloud with the effective radius smaller than 4.18 um is assumed
             182     1               ! to have an effective radius of 4.18 um with respect to the single
             183     1               ! scattering properties.
             184     1               !
             185     1               ! A cloud with the effective radius larger than 31.23 um is assumed
             186     1               ! to have an effective radius of 31.18 um with respect to the single
             187     1               ! scattering properties.
             188     1               !
             189     1   m    v             tauwc(i) = dz(i) * clwc(i) * ( bz(j,ib) / fl(j) +                &
             190     1                               ( bz(j+1,ib) / fl(j+1) - bz(j,ib) / fl(j) ) /           &
             191     1                               ( 1.0 / re(j+1) - 1.0 / re(j) ) * ( 1.0 / cre(i)        &
             192     1                               - 1.0 / re(j) ) )
             193     1   m    v               wwc(i) = wz(j,ib) + ( wz(j+1,ib) - wz(j,ib) ) /                &
             194     1                               ( re(j+1) - re(j) ) * ( cre(i) - re(j) )
             195     1   p    v                   gg = gz(j,ib) + ( gz(j+1,ib) - gz(j,ib) ) /                &
             196     1                               ( re(j+1) - re(j) ) * ( cre(i) - re(j) )
             197     1   p    v                   x1 = gg
             198     1   p    v                   x2 = x1 * gg
             199     1   m    v              wwc1(i) = 3.0 * x1
             200     1   m    v              wwc2(i) = 5.0 * x2
             201     1   p    v        100 continue
             202                     
             203                       190 continue
             204                     
             205                     !---------------------------------
             206                     !  ice cloud optical properties
             207                     !---------------------------------
             208                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 145
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cld
                                   <<< Loop-information  End >>>
             209     1  pp    s            do 200  i = 1, nr*lev
             210     2   p    m              if ( cld(i) .gt. 0.01 .and. ciwc(i) .gt. 1.0e-5 ) then
             211     2   p    s                cde(i)= max( 10., cde(i) )
             212     2   p    s                fw1 = cde(i)
             213     2   p    s                fw2 = fw1 * cde(i)
             214     2   p    s                fw3 = fw2 * cde(i)
             215     2   p    s                    bext = ap(1,ib) + ap(2,ib)/fw1 + ap(3,ib)/fw2
             216     2   p    s                tauic(i) = dz(i) * 1000.0 * ciwc(i) * bext
             217     2   p    s                    babs = bp(1,ib)/fw1+bp(2,ib)+bp(3,ib)*fw1+bp(4,ib)*fw2
             218     2   p    s                  wic(i) = 1.0 - babs/bext
             219     2   p    s                      gg = cp(1,ib)+cp(2,ib)*fw1+cp(3,ib)*fw2+cp(4,ib)*fw3

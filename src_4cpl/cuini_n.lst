              54                     !  local variables
              55                           integer  jl,jk,jin
              56                           integer  icall,ik
              57                           real zzs, zdp
              58                     !------------------------------------------------------------
              59                     !*    1.       specify large scale parameters at half levels
              60                     !*             adjust temperature fields if staticly unstable
              61                     !*             find level of maximum vertical velocity

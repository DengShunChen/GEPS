                                   <<< Loop-information  End >>>
              74     2  pp    v             do jl = 1, nxj
              75     2   p    v              pgeoh(jl,jk) = pgeo(jl,jk) + (pgeo(jl,jk-1)-pgeo(jl,jk))*zdp
              76     2   p    v              ptenh(jl,jk)=(max(cpd*pten(jl,jk-1)+pgeo(jl,jk-1), &
              77     2                    &             cpd*pten(jl,jk)+pgeo(jl,jk))-pgeoh(jl,jk))*rcpd
              78     2   p    v              pqenh(jl,jk) = pqen(jl,jk-1)
              79     2   p    v              pqsenh(jl,jk)= pqsen(jl,jk-1)
              80     2   p    v              zph(jl)=paph(jl,jk)
              81     2   p    v              loflag(jl)=.true.
              82     2   p    v            end do

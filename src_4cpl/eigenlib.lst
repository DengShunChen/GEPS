 External subroutine subprogram "RSB"
  (inc)(line-no.)(nest)(optimize)
               1                           SUBROUTINE RSB(NM,N,MB,A,W,MATZ,Z,FV1,FV2,IERR)
               2                     !
               3                           INTEGER N,MB,NM,IERR,MATZ
               4                           REAL A(NM,MB),W(N),Z(NM,N),FV1(N),FV2(N)
               5                           LOGICAL TF
               6                     !
               7                     !     THIS SUBROUTINE CALLS THE RECOMMENDED SEQUENCE OF
               8                     !     SUBROUTINES FROM THE EIGENSYSTEM SUBROUTINE PACKAGE (EISPACK)
               9                     !     TO FIND THE EIGENVALUES AND EIGENVECTORS (IF DESIRED)
              10                     !     OF A REAL SYMMETRIC BAND MATRIX.
              11                     !
              12                     !     ON INPUT
              13                     !
              14                     !        NM  MUST BE SET TO THE ROW DIMENSION OF THE TWO-DIMENSIONAL
              15                     !        ARRAY PARAMETERS AS DECLARED IN THE CALLING PROGRAM
              16                     !        DIMENSION STATEMENT.
              17                     !
              18                     !        N  IS THE ORDER OF THE MATRIX  A.
              19                     !
              20                     !        MB  IS THE HALF BAND WIDTH OF THE MATRIX, DEFINED AS THE
              21                     !        NUMBER OF ADJACENT DIAGONALS, INCLUDING THE PRINCIPAL
              22                     !        DIAGONAL, REQUIRED TO SPECIFY THE NON-ZERO PORTION OF THE
              23                     !        LOWER TRIANGLE OF THE MATRIX.
              24                     !
              25                     !        A  CONTAINS THE LOWER TRIANGLE OF THE REAL SYMMETRIC
              26                     !        BAND MATRIX.  ITS LOWEST SUBDIAGONAL IS STORED IN THE
              27                     !        LAST  N+1-MB  POSITIONS OF THE FIRST COLUMN, ITS NEXT
              28                     !        SUBDIAGONAL IN THE LAST  N+2-MB  POSITIONS OF THE
              29                     !        SECOND COLUMN, FURTHER SUBDIAGONALS SIMILARLY, AND
              30                     !        FINALLY ITS PRINCIPAL DIAGONAL IN THE  N  POSITIONS
              31                     !        OF THE LAST COLUMN.  CONTENTS OF STORAGES NOT PART
              32                     !        OF THE MATRIX ARE ARBITRARY.
              33                     !
              34                     !        MATZ  IS AN INTEGER VARIABLE SET EQUAL TO ZERO IF
              35                     !        ONLY EIGENVALUES ARE DESIRED.  OTHERWISE IT IS SET TO
              36                     !        ANY NON-ZERO INTEGER FOR BOTH EIGENVALUES AND EIGENVECTORS.
              37                     !
              38                     !     ON OUTPUT
              39                     !
              40                     !        W  CONTAINS THE EIGENVALUES IN ASCENDING ORDER.
              41                     !
              42                     !        Z  CONTAINS THE EIGENVECTORS IF MATZ IS NOT ZERO.
              43                     !
              44                     !        IERR  IS AN INTEGER OUTPUT VARIABLE SET EQUAL TO AN ERROR
              45                     !           COMPLETION CODE DESCRIBED IN THE DOCUMENTATION FOR TQLRAT
              46                     !           AND TQL2.  THE NORMAL COMPLETION CODE IS ZERO.
              47                     !
              48                     !        FV1  AND  FV2  ARE TEMPORARY STORAGE ARRAYS.
              49                     !
              50                     !     QUESTIONS AND COMMENTS SHOULD BE DIRECTED TO BURTON S. GARBOW,
              51                     !     MATHEMATICS AND COMPUTER SCIENCE DIV, ARGONNE NATIONAL LABORATORY
              52                     !
              53                     !     THIS VERSION DATED AUGUST 1983.
              54                     !
              55                     !     ------------------------------------------------------------------
              56                     !
              57                           IF (N .LE. NM) GO TO 5
              58                           IERR = 10 * N
              59                           GO TO 50
              60                         5 IF (MB .GT. 0) GO TO 10
              61                           IERR = 12 * N
              62                           GO TO 50
              63                        10 IF (MB .LE. N) GO TO 15
              64                           IERR = 12 * N
              65                           GO TO 50
              66                     !
              67                        15 IF (MATZ .NE. 0) GO TO 20
              68                     !     .......... FIND EIGENVALUES ONLY ..........
              69                           TF = .FALSE.
              70                           CALL  BANDR(NM,N,MB,A,W,FV1,FV2,TF,Z)
              71                           CALL  TQLRAT(N,W,FV2,IERR)
              72                           GO TO 50
              73                     !     .......... FIND BOTH EIGENVALUES AND EIGENVECTORS ..........
              74                        20 TF = .TRUE.
              75                           CALL  BANDR(NM,N,MB,A,W,FV1,FV1,TF,Z)
              76                           CALL  TQL2(NM,N,W,FV1,Z,IERR)
              77                        50 RETURN
              78                           END


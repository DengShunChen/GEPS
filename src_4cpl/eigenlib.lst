 External subroutine subprogram "TQLRAT"
  (inc)(line-no.)(nest)(optimize)
             255                     
             256                           SUBROUTINE TQLRAT(N,D,E2,IERR)
             257                     !
             258                           INTEGER I,J,L,M,N,II,L1,MML,IERR
             259                           REAL D(N),E2(N)
             260                           REAL B,C,F,G,H,P,R,S,T,EPSLON,PYTHAG
             261                     !
             262                     !     THIS SUBROUTINE IS A TRANSLATION OF THE ALGOL PROCEDURE TQLRAT,
             263                     !     ALGORITHM 464, COMM. ACM 16, 689(1973) BY REINSCH.
             264                     !
             265                     !     THIS SUBROUTINE FINDS THE EIGENVALUES OF A SYMMETRIC
             266                     !     TRIDIAGONAL MATRIX BY THE RATIONAL QL METHOD.
             267                     !
             268                     !     ON INPUT
             269                     !
             270                     !        N IS THE ORDER OF THE MATRIX.
             271                     !
             272                     !        D CONTAINS THE DIAGONAL ELEMENTS OF THE INPUT MATRIX.
             273                     !
             274                     !        E2 CONTAINS THE SQUARES OF THE SUBDIAGONAL ELEMENTS OF THE
             275                     !          INPUT MATRIX IN ITS LAST N-1 POSITIONS.  E2(1) IS ARBITRARY.
             276                     !
             277                     !      ON OUTPUT
             278                     !
             279                     !        D CONTAINS THE EIGENVALUES IN ASCENDING ORDER.  IF AN
             280                     !          ERROR EXIT IS MADE, THE EIGENVALUES ARE CORRECT AND
             281                     !          ORDERED FOR INDICES 1,2,...IERR-1, BUT MAY NOT BE
             282                     !          THE SMALLEST EIGENVALUES.
             283                     !
             284                     !        E2 HAS BEEN DESTROYED.
             285                     !
             286                     !        IERR IS SET TO
             287                     !          ZERO       FOR NORMAL RETURN,
             288                     !          J          IF THE J-TH EIGENVALUE HAS NOT BEEN
             289                     !                     DETERMINED AFTER 30 ITERATIONS.
             290                     !
             291                     !     CALLS PYTHAG FOR  SQRT(A*A + B*B) .
             292                     !
             293                     !     QUESTIONS AND COMMENTS SHOULD BE DIRECTED TO BURTON S. GARBOW,
             294                     !     MATHEMATICS AND COMPUTER SCIENCE DIV, ARGONNE NATIONAL LABORATORY
             295                     !
             296                     !     THIS VERSION DATED AUGUST 1983.
             297                     !
             298                     !     ------------------------------------------------------------------
             299                     !
             300                           IERR = 0
             301                           IF (N .EQ. 1) GO TO 1001
             302                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      E2
                                   <<< Loop-information  End >>>
             303     1  pp   4v            DO 100 I = 2, N
             304     1   p   4v        100 E2(I-1) = E2(I)
             305                     !
             306                           F = 0.0E0
             307                           T = 0.0E0
             308                           E2(N) = 0.0E0
             309                     !
             310     1                     DO 290 L = 1, N
             311     1                        J = 0
             312     1                        H = ABS(D(L)) + SQRT(E2(L))
             313     1                        IF (T .GT. H) GO TO 105
             314     1                        T = H
             315     1    i                   B = EPSLON(T)
             316     1                        C = B * B
             317     1               !     .......... LOOK FOR SMALL SQUARED SUB-DIAGONAL ELEMENT ..........
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      E2
                                   <<< Loop-information  End >>>
             318     2                 105    DO 110 M = L, N
             319     2                           IF (E2(M) .LE. C) GO TO 120
             320     2               !     .......... E2(N) IS ALWAYS ZERO, SO THERE IS NO EXIT
             321     2               !                THROUGH THE BOTTOM OF THE LOOP ..........
             322     2                 110    CONTINUE
             323     1               !
             324     1                 120    IF (M .EQ. L) GO TO 210
             325     1                 130    IF (J .EQ. 30) GO TO 1000
             326     1                        J = J + 1
             327     1               !     .......... FORM SHIFT ..........
             328     1                        L1 = L + 1
             329     1                        S = SQRT(E2(L))
             330     1                        G = D(L)
             331     1                        P = (D(L1) - G) / (2.0E0 * S)
             332     1                        R = PYTHAG(P,1.0E0)
             333     1                        D(L) = S / (P + SIGN(R,P))
             334     1                        H = G - D(L)
             335     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      D
                                   <<< Loop-information  End >>>
             336     2  pp   2v               DO 140 I = L1, N
             337     2   p   2v        140    D(I) = D(I) - H
             338     1               !
             339     1                        F = F + H
             340     1               !     .......... RATIONAL QL TRANSFORMATION ..........
             341     1                        G = D(M)
             342     1                        IF (G .EQ. 0.0E0) G = B
             343     1                        H = G
             344     1                        S = 0.0E0
             345     1                        MML = M - L
             346     1               !     .......... FOR I=M-1 STEP -1 UNTIL L DO -- ..........
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      E2, D
                                   <<< Loop-information  End >>>
             347     2   s   2s               DO 200 II = 1, MML
             348     2   s   2s                  I = M - II
             349     2   s   2s                  P = G * H
             350     2   s   2s                  R = P + E2(I)
             351     2   s   2s                  E2(I+1) = S * R
             352     2   s   2s                  S = E2(I) / R
             353     2   s   2s                  D(I+1) = H + S * (H + D(I))
             354     2   s   2s                  G = D(I) - E2(I) / G
             355     2   s   2s                  IF (G .EQ. 0.0E0) G = B
             356     2   s   2s                  H = G * P / R
             357     2   s   2s        200    CONTINUE
             358     1               !
             359     1                        E2(L) = S * G
             360     1                        D(L) = H
             361     1               !     .......... GUARD AGAINST UNDERFLOW IN CONVERGENCE TEST ..........
             362     1                        IF (H .EQ. 0.0E0) GO TO 210
             363     1                        IF (ABS(E2(L)) .LE. ABS(C/H)) GO TO 210
             364     1                        E2(L) = H * E2(L)
             365     1                        IF (E2(L) .NE. 0.0E0) GO TO 130
             366     1                 210    P = D(L) + F
             367     1               !     .......... ORDER EIGENVALUES ..........
             368     1                        IF (L .EQ. 1) GO TO 250
             369     1               !     .......... FOR I=L STEP -1 UNTIL 2 DO -- ..........
             370     2                        DO 230 II = 2, L
             371     2                           I = L + 2 - II
             372     2                           IF (P .GE. D(I-1)) GO TO 270
             373     2                           D(I) = D(I-1)
             374     2                 230    CONTINUE
             375     1               !
             376     1                 250    I = 1
             377     1                 270    D(I) = P
             378     1                 290 CONTINUE
             379                     !
             380                           GO TO 1001
             381                     !     .......... SET ERROR -- NO CONVERGENCE TO AN
             382                     !                EIGENVALUE AFTER 30 ITERATIONS ..........
             383                      1000 IERR = L
             384                      1001 RETURN
             385                           END


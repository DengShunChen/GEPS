 External function subprogram "EPSLON"
  (inc)(line-no.)(nest)(optimize)
             557                     
             558                           REAL FUNCTION EPSLON (X)
             559                           REAL X
             560                     !
             561                     !     ESTIMATE UNIT ROUNDOFF IN QUANTITIES OF SIZE X.
             562                     !
             563                           REAL A,B,C,EPS
             564                     !
             565                     !     THIS PROGRAM SHOULD FUNCTION PROPERLY ON ALL SYSTEMS
             566                     !     SATISFYING THE FOLLOWING TWO ASSUMPTIONS,
             567                     !        1.  THE BASE USED IN REPRESENTING FLOATING POINT
             568                     !            NUMBERS IS NOT A POWER OF THREE.
             569                     !        2.  THE QUANTITY  A  IN STATEMENT 10 IS REPRESENTED TO
             570                     !            THE ACCURACY USED IN FLOATING POINT VARIABLES
             571                     !            THAT ARE STORED IN MEMORY.
             572                     !     THE STATEMENT NUMBER 10 AND THE GO TO 10 ARE INTENDED TO
             573                     !     FORCE OPTIMIZING COMPILERS TO GENERATE CODE SATISFYING
             574                     !     ASSUMPTION 2.
             575                     !     UNDER THESE ASSUMPTIONS, IT SHOULD BE TRUE THAT,
             576                     !            A  IS NOT EXACTLY EQUAL TO FOUR-THIRDS,
             577                     !            B  HAS A ZERO FOR ITS LAST BIT OR DIGIT,
             578                     !            C  IS NOT EXACTLY EQUAL TO ONE,
             579                     !            EPS  MEASURES THE SEPARATION OF 1.0 FROM
             580                     !                 THE NEXT LARGER FLOATING POINT NUMBER.
             581                     !     THE DEVELOPERS OF EISPACK WOULD APPRECIATE BEING INFORMED
             582                     !     ABOUT ANY SYSTEMS WHERE THESE ASSUMPTIONS DO NOT HOLD.
             583                     !
             584                     !     THIS VERSION DATED 4/6/83.
             585                     !
             586                           A = 4.0E0/3.0E0
             587                        10 B = A - 1.0E0
             588                           C = B + B + B
             589                           EPS = ABS(C-1.0E0)
             590                           IF (EPS .EQ. 0.0E0) GO TO 10
             591                           EPSLON = EPS*ABS(X)
             592                           RETURN
             593                           END


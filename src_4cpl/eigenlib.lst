 External subroutine subprogram "TQL2"
  (inc)(line-no.)(nest)(optimize)
             386                     
             387                           SUBROUTINE TQL2(NM,N,D,E,Z,IERR)
             388                     !
             389                           INTEGER I,J,K,L,M,N,II,L1,L2,NM,MML,IERR
             390                           REAL D(N),E(N),Z(NM,N)
             391                           REAL C,C2,C3,DL1,EL1,F,G,H,P,R,S,S2,TST1,TST2,PYTHAG
             392                     !
             393                     !     THIS SUBROUTINE IS A TRANSLATION OF THE ALGOL PROCEDURE TQL2,
             394                     !     NUM. MATH. 11, 293-306(1968) BY BOWDLER, MARTIN, REINSCH, AND
             395                     !     WILKINSON.
             396                     !     HANDBOOK FOR AUTO. COMP., VOL.II-LINEAR ALGEBRA, 227-240(1971).
             397                     !
             398                     !     THIS SUBROUTINE FINDS THE EIGENVALUES AND EIGENVECTORS
             399                     !     OF A SYMMETRIC TRIDIAGONAL MATRIX BY THE QL METHOD.
             400                     !     THE EIGENVECTORS OF A FULL SYMMETRIC MATRIX CAN ALSO
             401                     !     BE FOUND IF  TRED2  HAS BEEN USED TO REDUCE THIS
             402                     !     FULL MATRIX TO TRIDIAGONAL FORM.
             403                     !
             404                     !     ON INPUT
             405                     !
             406                     !        NM MUST BE SET TO THE ROW DIMENSION OF TWO-DIMENSIONAL
             407                     !          ARRAY PARAMETERS AS DECLARED IN THE CALLING PROGRAM
             408                     !          DIMENSION STATEMENT.
             409                     !
             410                     !        N IS THE ORDER OF THE MATRIX.
             411                     !
             412                     !        D CONTAINS THE DIAGONAL ELEMENTS OF THE INPUT MATRIX.
             413                     !
             414                     !        E CONTAINS THE SUBDIAGONAL ELEMENTS OF THE INPUT MATRIX
             415                     !          IN ITS LAST N-1 POSITIONS.  E(1) IS ARBITRARY.
             416                     !
             417                     !        Z CONTAINS THE TRANSFORMATION MATRIX PRODUCED IN THE
             418                     !          REDUCTION BY  TRED2, IF PERFORMED.  IF THE EIGENVECTORS
             419                     !          OF THE TRIDIAGONAL MATRIX ARE DESIRED, Z MUST CONTAIN
             420                     !          THE IDENTITY MATRIX.
             421                     !
             422                     !      ON OUTPUT
             423                     !
             424                     !        D CONTAINS THE EIGENVALUES IN ASCENDING ORDER.  IF AN
             425                     !          ERROR EXIT IS MADE, THE EIGENVALUES ARE CORRECT BUT
             426                     !          UNORDERED FOR INDICES 1,2,...,IERR-1.
             427                     !
             428                     !        E HAS BEEN DESTROYED.
             429                     !
             430                     !        Z CONTAINS ORTHONORMAL EIGENVECTORS OF THE SYMMETRIC
             431                     !          TRIDIAGONAL (OR FULL) MATRIX.  IF AN ERROR EXIT IS MADE,
             432                     !          Z CONTAINS THE EIGENVECTORS ASSOCIATED WITH THE STORED
             433                     !          EIGENVALUES.
             434                     !
             435                     !        IERR IS SET TO
             436                     !          ZERO       FOR NORMAL RETURN,
             437                     !          J          IF THE J-TH EIGENVALUE HAS NOT BEEN
             438                     !                     DETERMINED AFTER 30 ITERATIONS.
             439                     !
             440                     !     CALLS PYTHAG FOR  SQRT(A*A + B*B) .
             441                     !
             442                     !     QUESTIONS AND COMMENTS SHOULD BE DIRECTED TO BURTON S. GARBOW,
             443                     !     MATHEMATICS AND COMPUTER SCIENCE DIV, ARGONNE NATIONAL LABORATORY
             444                     !
             445                     !     THIS VERSION DATED AUGUST 1983.
             446                     !
             447                     !     ------------------------------------------------------------------
             448                     !
             449                           IERR = 0
             450                           IF (N .EQ. 1) GO TO 1001
             451                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      E
                                   <<< Loop-information  End >>>
             452     1  pp   4v            DO 100 I = 2, N
             453     1   p   4v        100 E(I-1) = E(I)
             454                     !
             455                           F = 0.0E0
             456                           TST1 = 0.0E0
             457                           E(N) = 0.0E0
             458                     !
             459     1                     DO 240 L = 1, N
             460     1                        J = 0
             461     1                        H = ABS(D(L)) + ABS(E(L))
             462     1                        IF (TST1 .LT. H) TST1 = H
             463     1               !     .......... LOOK FOR SMALL SUB-DIAGONAL ELEMENT ..........
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      E
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             464     2                        DO 110 M = L, N
             465     2                           TST2 = TST1 + ABS(E(M))
             466     2                           IF (TST2 .EQ. TST1) GO TO 120
             467     2               !     .......... E(N) IS ALWAYS ZERO, SO THERE IS NO EXIT
             468     2               !                THROUGH THE BOTTOM OF THE LOOP ..........
             469     2                 110    CONTINUE
             470     1               !
             471     1                 120    IF (M .EQ. L) GO TO 220
             472     1                 130    IF (J .EQ. 30) GO TO 1000
             473     1                        J = J + 1
             474     1               !     .......... FORM SHIFT ..........
             475     1                        L1 = L + 1
             476     1                        L2 = L1 + 1
             477     1                        G = D(L)
             478     1                        P = (D(L1) - G) / (2.0E0 * E(L))
             479     1                        R = PYTHAG(P,1.0E0)
             480     1                        D(L) = E(L) / (P + SIGN(R,P))
             481     1                        D(L1) = E(L) * (P + SIGN(R,P))
             482     1                        DL1 = D(L1)
             483     1                        H = G - D(L)
             484     1                        IF (L2 .GT. N) GO TO 145
             485     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      D
                                   <<< Loop-information  End >>>
             486     2  pp   2v               DO 140 I = L2, N
             487     2   p   2v        140    D(I) = D(I) - H
             488     1               !
             489     1                 145    F = F + H
             490     1               !     .......... QL TRANSFORMATION ..........
             491     1                        P = D(M)
             492     1                        C = 1.0E0
             493     1                        C2 = C
             494     1                        EL1 = E(L1)
             495     1                        S = 0.0E0
             496     1                        MML = M - L
             497     1               !     .......... FOR I=M-1 STEP -1 UNTIL L DO -- ..........
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Z
                                   <<< Loop-information  End >>>
             498     2                        DO 200 II = 1, MML
             499     2                           C3 = C2
             500     2                           C2 = C
             501     2                           S2 = S
             502     2                           I = M - II
             503     2                           G = C * E(I)
             504     2                           H = C * P
             505     2                           R = PYTHAG(P,E(I))
             506     2                           E(I+1) = S * R
             507     2                           S = E(I) / R
             508     2                           C = P / R
             509     2                           P = C * D(I) - S * G
             510     2                           D(I+1) = H + S * (C * G + S * D(I))
             511     2               !     .......... FORM VECTOR ..........
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Z
                                   <<< Loop-information  End >>>
             512     3  pp   2v                  DO 180 K = 1, N
             513     3   p   2v                     H = Z(K,I+1)
             514     3   p   2v                     Z(K,I+1) = S * Z(K,I) + C * H
             515     3   p   2v                     Z(K,I) = C * Z(K,I) - S * H
             516     3   p   2v        180       CONTINUE
             517     2               !
             518     2                 200    CONTINUE
             519     1               !
             520     1                        P = -S * S2 * C3 * EL1 * E(L) / DL1
             521     1                        E(L) = S * P
             522     1                        D(L) = C * P
             523     1                        TST2 = TST1 + ABS(E(L))
             524     1                        IF (TST2 .GT. TST1) GO TO 130
             525     1                 220    D(L) = D(L) + F
             526     1                 240 CONTINUE
             527                     !     .......... ORDER EIGENVALUES AND EIGENVECTORS ..........
             528     1                     DO 300 II = 2, N
             529     1                        I = II - 1
             530     1                        K = I
             531     1                        P = D(I)
             532     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<< Loop-information  End >>>
             533     2  pp    s               DO 260 J = II, N
             534     2   p    v                  IF (D(J) .GE. P) GO TO 260
             535     2   p    m                  K = J
             536     2   p    s                  P = D(J)
             537     2   p    m        260    CONTINUE
             538     1               !
             539     1                        IF (K .EQ. I) GO TO 300
             540     1                        D(K) = D(I)
             541     1                        D(I) = P
             542     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Z
                                   <<< Loop-information  End >>>
             543     2  pp   2v               DO 280 J = 1, N
             544     2   p   2v                  P = Z(J,I)
             545     2   p   2v                  Z(J,I) = Z(J,K)
             546     2   p   2v                  Z(J,K) = P
             547     2   p   2v        280    CONTINUE
             548     1               !
             549     1                 300 CONTINUE
             550                     !
             551                           GO TO 1001
             552                     !     .......... SET ERROR -- NO CONVERGENCE TO AN
             553                     !                EIGENVALUE AFTER 30 ITERATIONS ..........
             554                      1000 IERR = L
             555                      1001 RETURN
             556                           END


 External function subprogram "PYTHAG"
  (inc)(line-no.)(nest)(optimize)
             594                     
             595                           REAL FUNCTION PYTHAG(A,B)
             596                           REAL A,B
             597                     !
             598                     !     FINDS SQRT(A**2+B**2) WITHOUT OVERFLOW OR DESTRUCTIVE UNDERFLOW
             599                     !
             600                           REAL P,R,S,T,U
             601                     !     P = AMAX1(ABS(A),ABS(B))
             602                           P = DMAX1(ABS(A),ABS(B))        ! CWB2015
             603                           IF (P .EQ. 0.0E0) GO TO 20
             604                     !     R = (AMIN1(ABS(A),ABS(B))/P)**2
             605                           R = (DMIN1(ABS(A),ABS(B))/P)**2 ! CWB2015
             606                        10 CONTINUE
             607                              T = 4.0E0 + R
             608                              IF (T .EQ. 4.0E0) GO TO 20
             609                              S = R/T
             610                              U = 1.0E0 + 2.0E0*S
             611                              P = U*P
             612                              R = (S/U)**2 * R
             613                           GO TO 10
             614                        20 PYTHAG = P
             615                           RETURN
             616                           END


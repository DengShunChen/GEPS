             247                     !orig logical   flag_guess(nx),flag_iter(nx),mom4ice(nx)
             248                           logical   flag_guess(nx),flag_iter(nx),mom4ice
             249                     !
             250                     !2018 new
             251                           logical   redrag
             252                           integer   ivegsrc,isot
             253                     !----------------------------------------------------
             254                     ! for new pbl: asl,atl,xmu
             255                           real      asl(nx,lev),atl(nx,lev),swh(nx,lev),hlw(nx,lev),xmu(nx)
             256                     
             257                     !----------------------------------------------------
             258                     ! for fractional step:
             259                           real      dudt(nx,lev),dvdt(nx,lev),dtdt(nx,lev),dqdt(nx,lev)
             260                     
             261                           integer  lsm,i,k,iter,kc,ntrac
             262                           real     ppd,ppp,ttt,ppu,dth,p850,ddd,cc,qqq
             263                     !
             264                     ! noah mode
             265                           lsm   =  1
             266                           mom4ice =.false.
             267                           redrag =.false.
             268                     !------------------------------------------------------------
             269                     !     io=67
             270                     !     jo=251
             271                     !     io=589
             272                     !     jo=148
             273                     !     io=705
             274                     !     jo=236
             275                           io=480
             276                           jo=240
             277                     !
             278                           ntrac=ncld
             279                           if ( nmmiph .eq. 6 ) ntrac=ncld-3
             280                           if ( nmmiph .eq. 8 ) ntrac=ncld-4
             281                           if ( nmmiph .eq.18 ) ntrac=5
             282                           if ( nmmiph .eq.11 .or. nmmiph.eq.12 .or. nmmiph.eq.13 ) ntrac=7
             283                           if ( nmmiph .eq.15 ) ntrac=5
             284                           if ( nmmiph .eq.16 ) ntrac=5
             285                     !      if ( nmmiph .eq.16 ) ntrac=8
             286                     
             287                           allocate(q1(nx,lev,ntrac))
             288                     !
             289                     ! --- ensure ktpbl selection is greater than 2
             290                     !
             291                           if ( ktpbl .lt. 2 )  ktpbl = 2
             292                     !
             293                     ! --- compute surface pres and surface air temp at current time level
             294                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, pkd, pk2d, pk2x, pkx
                                   <<< Loop-information  End >>>
             295     1                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkd, pk2, pk, pk2d
                                   <<< Loop-information  End >>>
             296     1  pp   2             pkd(:) =pk(:,k)
             297     1   p   2             pk2d(:)=pk2(:,k)
             298     1                     call vlog(pk2x(1,k),pk2d,nxj)
             299     1                     call vlog(pkx(1,k), pkd, nxj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 14, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2x, pkx
                                   <<< Loop-information  End >>>
             300     2  pp   2             do i=1,nxj
             301     2   p   2               pk2x(i,k)=pk2x(i,k)*(cp/r)

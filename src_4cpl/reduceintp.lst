              18                     !
              19                     
              20                     ! ..................................
              21                     ! ..................................
              22                            pi  = 4.0 * atan(1.0)
              23                            two_pi = 2.0 * pi
              24                            dxf = two_pi / lonf
              25                            hfdxf = 0.5 * dxf

             557                     
             558                     !-----
             559                     !  following subroutine added for new soil model
             560                     !-----
             561                           subroutine rdsoil(nx,my,my_max,km,smc,stc,slc,canopy,ifilout &
             562                                            ,idtg,itau,ggdef,gmdef)
             563                     !
             564                           use index
             565                           use mpe
             566                     
             567                           implicit  none
             568                     
             569                           integer   nx,my,my_max,km,itau
             570                     
             571                           real        smc(nxp,km,my_max),stc(nxp,km,my_max),canopy(nxp,my_max), &
             572                                       slc(nxp,km,my_max)
             573                     
             574                           character*4 ggdef,gmdef
             575                     
             576                           character ifilout*80
             577                           real      work(nx,my),tmp(nxp,my_max)
             578                           integer*8 idtg
             579                           character typ*6,ihdg*26
             580                     !
             581                           integer   lenc,i,j,k,ii,jj,nxj,istat
             582                     
             583                           lenc=nx*my
             584                     !
             585                           call syslbl ('s005c0',idtg,itau,ggdef,ihdg)
             586                           call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             587                           call unify_reducepick(nx,my,my_max,work,canopy)
             588                     
             589                     !
             590                     ! for Noah 4-layer land model
             591                     ! dmskey(1:3) 1st layer :l01
             592                     ! dmskey(1:3) 2nd layer :l02
             593                     ! dmskey(1:3) 3rd layer :l03
             594                     ! dmskey(1:3) 4th layer :l04
             595                     
             596     1                     do k = 1,km
             597     1               !
             598     1               ! read smc  l015b0
             599     1               !
             600     1                     write(typ,'("l0",i1.1,"5b0")')k
             601     1                     call syslbl (typ,idtg,itau,gmdef,ihdg)
             602     1                     call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             603     1                     call unify_reducepick(nx,my,my_max,work,tmp)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, smc
                                   <<< Loop-information  End >>>
             604     1  pp   2v            smc(:,k,:) = tmp(:,:)
             605     1               !
             606     1               ! read slc  l015b1
             607     1               !
             608     1                     write(typ,'("l0",i1.1,"5b1")')k
             609     1                     call syslbl (typ,idtg,itau,gmdef,ihdg)
             610     1                     call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             611     1                     call unify_reducepick(nx,my,my_max,work,tmp)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, slc
                                   <<< Loop-information  End >>>
             612     1  pp   2v            slc(:,k,:) = tmp(:,:)
             613     1               !
             614     1               ! read stc  l01100
             615     1               !
             616     1                     write(typ,'("l0",i1.1,"100")')k
             617     1                     call syslbl (typ,idtg,itau,gmdef,ihdg)
             618     1                     call dmsread(nx,my,ihdg,lenc,'H',ifilout,work,istat)
             619     1                     call unify_reducepick(nx,my,my_max,work,tmp)
                                   <<< Loop-information Start >>>

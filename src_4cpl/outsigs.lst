             266                     !
             267                     ! compute geopotential by hydrstatic
             268                     !
             269                           capa=1.0/3.5
             270                           pk2top=(ptop/1000.)**capa
             271                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :

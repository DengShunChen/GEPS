                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, phi, pk2
                                   <<< Loop-information  End >>>
             283     3   p    v            do i=1,nxj
             284     3   p    v            phi(i,k,jj)= phi(i,k+1,jj)+cp*(tt(i,k,jj)*(pk2(i,k,jj)-pk(i,k,jj)) &
             285     3                                  + tt(i,k+1,jj)*(pk(i,k+1,jj)-pk2(i,k,jj)))
             286     3   p    v            enddo

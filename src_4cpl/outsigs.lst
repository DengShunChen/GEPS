                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, stc
                                   <<< Loop-information  End >>>
             620     1  pp   2v            stc(:,k,:) = tmp(:,:)
             621     1               !
             622     1               !
             623     1                     enddo
             624                     !
             625                           return
             626                           end


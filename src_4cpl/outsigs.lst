                                   <<< Loop-information  End >>>
             272     1  pp                 do jj =1,jlistnum
             273     1   p                 j=jlist1(jj)
             274     1   p                 nxj=nxdef_2d(j)
             275     1               !
             276     1               !  hydrostatic equation
             277     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, sgeo, tt, phi
                                   <<< Loop-information  End >>>
             278     2   p   2v            do i=1,nxj
             279     2   p   2v            phi(i,lev,jj)= cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj)) &
             280     2                                    + sgeo(i,jj)
             281     2   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, tt, phi

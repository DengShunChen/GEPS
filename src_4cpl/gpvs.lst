 External subroutine subprogram "gpvs"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gpvs
               2                     !
               3                     ! Abstract: Computes saturation vapor pressure table as a function of
               4                     !   temperature for the table lookup function fpvs.
               5                     !   Exact saturation vapor pressures are calculated in subprogram fpvsx.
               6                     !   The current implementation computes a table with a length
               7                     !   of 7501 for temperatures ranging from 180. to 330. Kelvin.
               8                     !
               9                           implicit none
              10                           integer jx
              11                           real xmin,xmax,xinc,x,t
              12                           integer nxpvs
              13                           real c1xpvs,c2xpvs,tbpvs,fpvsx
              14                           parameter(nxpvs=7501)
              15                           common/fpvscom/ c1xpvs,c2xpvs,tbpvs(nxpvs)
              16                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
              17                           xmin=180.0
              18                           xmax=330.0
              19                           xinc=(xmax-xmin)/(nxpvs-1)
              20                     !   c1xpvs=1.-xmin/xinc
              21                           c2xpvs=1./xinc
              22                           c1xpvs=1.-xmin*c2xpvs
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tbpvs, (unknown)
                                   <<< Loop-information  End >>>
              23     1   m   2v            do jx=1,nxpvs
              24     1   m   2s              x=xmin+(jx-1)*xinc
              25     1   s   2s              t=x
              26     1   s   2s              tbpvs(jx)=fpvsx(t)
              27     1   p   2v            enddo
              28                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
              29                           end subroutine


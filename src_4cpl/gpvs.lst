 External function subprogram "fpvsx"
  (inc)(line-no.)(nest)(optimize)
              30                     
              31                           function fpvsx(t)
              32                     !
              33                     ! Abstract: Exactly compute saturation vapor pressure from temperature.
              34                     !   The saturation vapor pressure over either liquid and ice is computed
              35                     !   over liquid for temperatures above the triple point,
              36                     !   over ice for temperatures 20 degress below the triple point,
              37                     !   and a linear combination of the two for temperatures in between.
              38                     !   The water model assumes a perfect gas, constant specific heats
              39                     !   for gas, liquid and ice, and neglects the volume of the condensate.
              40                     !   The model does account for the variation of the latent heat
              41                     !   of condensation and sublimation with temperature.
              42                     !   The Clausius-Clapeyron equation is integrated from the triple point
              43                     !   to get the formula
              44                     !         pvsl=psat*(tr**xa)*exp(xb*(1.-tr))
              45                     !   where tr is ttp/t and other values are physical constants.
              46                     !   The reference for this computation is Emanuel(1994), pages 116-117.
              47                     !   This function should be expanded inline in the calling routine.
              48                     !
              49                     !   Input argument list:
              50                     !       t              Real temperature in Kelvin
              51                     !
              52                     !   Output argument list:
              53                     !       fpvsx        Real saturation vapor pressure in Pascals
              54                     !
              55                           implicit none
              56                           real fpvsx
              57                           real t
              58                           real psat,hvap,cvap,cliq,csol,grav,hfus,ttp,rd,rv,cp
              59                           parameter(  psat = 6.1078e+2 )
              60                           parameter(  hvap = 2.5000e+6 )
              61                           parameter(  cvap = 1.8460e+3 )
              62                           parameter(  cliq = 4.1855e+3 )
              63                           parameter(  csol = 2.1060e+3 )
              64                           parameter(  grav = 9.80665e+0 )
              65                           parameter(  hfus = 3.3358e+5 )
              66                           parameter(   ttp = 2.7316e+2 )
              67                           parameter(    rd = 2.8705e+2 )
              68                           parameter(    rv = 4.6150e+2 )
              69                           parameter(    cp = 1.0046e+3 )
              70                           real tliq,tice,dldtl,heatl,xponal,xponbl,dldti,heati,xponai,xponbi
              71                           parameter( tliq=ttp )
              72                           parameter( tice=ttp-20.0 )
              73                           parameter( dldtl=cvap-cliq )
              74                           parameter( heatl=hvap )
              75                           parameter( xponal=-dldtl/rv )
              76                           parameter( xponbl=xponal+heatl/(rv*ttp) )
              77                           parameter( dldti=cvap-csol )
              78                           parameter( heati=hvap+hfus )
              79                           parameter( xponai=-dldti/rv )
              80                           parameter( xponbi=xponai+heati/(rv*ttp) )
              81                           real tr,w,pvl,pvi
              82                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
              83                           tr=ttp/t
              84     1                     if(t.ge.tliq) then
              85     1                       fpvsx=psat*(tr**xponal)*exp(xponbl*(1.-tr))
              86     1                     elseif(t.lt.tice) then
              87     1                       fpvsx=psat*(tr**xponai)*exp(xponbi*(1.-tr))
              88     1                     else
              89     1                       w=(t-tice)/(tliq-tice)
              90     1                       pvl=psat*(tr**xponal)*exp(xponbl*(1.-tr))
              91     1                       pvi=psat*(tr**xponai)*exp(xponbi*(1.-tr))
              92     1                       fpvsx=w*pvl+(1.-w)*pvi
              93     1                     endif
              94                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
              95                           end function
              96                     


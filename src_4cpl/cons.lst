             119                           namelist /grb_conf/ grbmem,grbnumm
             120                     
             121                     ! for ECHAM4 Tiedtke cumulus scheme
             122                           call cuparam
             123                           call inicon
             124                           call set_lookup_tables
             125                     
             126                           capa= 1.0/3.5
             127                           rgas= capa*cp
             128                           pi  = 4.0*atan(1.0)
             129                           radsq= rad*rad
             130                     !
             131                           call gpvs
             132                     !----------------------------------------------------------------!
             133                     !
             134                     !  read namlist of path/file name(operation)
             135                     !
             136                           call getfname(pathname,logicname,truefile,istat)
             137     1                     if(istat.ne.0)then
             138     1                       print *,'getfname : error','RANK=',myrank
             139     1                       call mpe_finalize
             140     1                       call dmsexit(-1)
             141     1                     else
             142     1                       if(myrank .eq. 0) print *,truefile
             143     1                     endif
             144                     !
             145                           open (unit=12,file=trim(truefile),form='formatted')
             146                     !!      open (unit=77,file='output.dat',form='formatted')
             147                     !
             148                           read (12,filst,end=110)
             149                     !
             150                       110 continue
             151                           close(12)
             152                     !
             153                           if(myrank .eq. 0) print filst
             154                     !
             155                     !  read namelist for model parameters
             156                     !
             157                           open (unit=1,file=trim(namlsts),form='formatted')
             158                     !
             159                           read (1,modlst,end=120)
             160                       120 continue
             161                           read (1,typ,end=121)
             162                       121 continue
             163                           ! read stochastic_physics
             164                           read (1,stochy_physics,end=122)
             165                       122 continue
             166                           read (1,grb_conf,end=123)
             167                       123 continue
             168                           close(1)
             169                     !
             170                           open (unit=1,file=trim(namlsts),form='formatted')
             171                     
             172     1                     if(do_sit) then
             173     1                       read (1,sit_nml,end=130)
             174     2                       if(myrank .eq. 0) then
             175     2                         print *, 'chlee debug...'
             176     2                         print sit_nml
             177     2                       endif
             178     2                       if(.NOT. ldailyFCTsst)then
             179     2                         print *,'do_sit=.true., auto set: ldailyFCTsst=.true.' &
             180     2                             ,',dailyClm_option=1, check ifilin_sst & ifilin_ClmANA'&
             181     2                             ,'is in filelist.'
             182     2                         ldailyFCTsst=.true.
             183     2                         dailyClm_option=1
             184     2                       endif
             185     1                 130 continue
             186     1                     endif
             187                           close(1)
             188                     
             189                     !
             190                           open (unit=2,file=trim(crdate),form='formatted')
             191                     !
             192                     ! read in idtg*12
             193                           read(2,'(i8.8)')idtg8
             194                           close(2)
             195                     ! transfer idtg8 to idtg*12
             196     1                     if(idtg8.gt.60000000)then
             197     1                       idtg = 190000000000 + idtg8*100
             198     1                     else
             199     1                       idtg = 200000000000 + idtg8*100
             200     1                     endif
             201                     !
             202                           write(cdtg,900)idtg
             203                      900  format(i12.12)
             204                     !
             205                           if(myrank .eq. 0) print*,' dtg=',cdtg
             206                     !-----------------------------------------------------------------------
             207                           read(cdtg,'(i4,i2,i2,i2,i2)') idate(1),idate(2),idate(3),idate(5)&
             208                                                        ,ii
             209                     !-----------------------------------------------------------------------
             210                     !
             211                           call days (cdtg,julian,hours)
             212                     !
             213                           flag =.false.
             214     1                     if(myrank .eq. 0)then
             215     1                       call recmsg('gfs',ifromtau,itotau,istat)
             216     1                       flag =.true.
             217     1                     endif
             218                     !ch   call mpe_broadcast(istat,1,flag,mpe_integer)
             219                           call mpe_bcast(istat,1,0,mpe_integer)
             220                     
             221     1                     if(istat.eq.-1)then
             222     1                       if(myrank.eq.0) print *,'RECMSG ERROR','RANK=',myrank
             223     1                       call mpe_finalize
             224     1                       call dmsexit(-1)
             225     1                     else if(istat.eq.1)then
             226     1                       call mpe_finalize
             227     1                       call dmsexit(0)
             228     1                     endif
             229                     !
             230                     !ch   call mpe_broadcast(ifromtau,1,flag,mpe_integer)
             231                     !ch   call mpe_broadcast(itotau,1,flag,mpe_integer)
             232                           call mpe_bcast(ifromtau,1,0,mpe_integer)
             233                           call mpe_bcast(itotau,1,0,mpe_integer)
             234                     !
             235                           taui=float(ifromtau)
             236                           taue=float(itotau)
             237                           tauo=float(itotau)+0.000001
             238                     !
             239                           tau   = 0.0
             240                           restrt=.false.
             241     1                     if (taui.gt.0.0)  then
             242     1                       itaui=ifromtau
             243     1                       itau= int(taui) + 0.001
             244     1                       itau= min(itau,itaui)
             245     1                       taui= float(itau)
             246     1                       restrt=.true.
             247     1                       if(myrank .eq. 0) print*,' restarting at tau=',itau
             248     1                       hours = hours+taui
             249     1                       julian= julian+hours/24.0+0.001
             250     1                       hours = mod(hours,24.)
             251     1                     endif
             252                     !
             253                           if(myrank .eq. 0) print modlst
             254                           if(myrank .eq. 0) print typ
             255                           if(myrank .eq. 0) print stochy_physics
             256                     !
             257     1                     if (taui .ge. taue)  then
             258     1                       if(myrank .eq. 0)  &
             259     1                        print *,'******** aborting run, taui.ge.taue ******* '
             260     1                       stop
             261     1                     endif
             262                     
             263                     !
             264                     !  build pointer arrays for locating zonal and total wavenumber
             265                     !  values in the one-dimensional spherical harmonic arrays.
             266                     !
             267                     !  original allocation system only for spectral space
             268                     !
             269                           call sortml (jtrun,mlmax,msort,lsort,mlsort)
             270                     !
             271                     !  new allocation system in parallization for both spectral
             272                     !  and grid spaces
             273                     !
             274                     
             275                           call make_list
             276                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             277     1  pp                 do 150 m =1,mlistnum
             278     1   p                  mf=mlist(m)
             279     1               !
             280     1   p                  rm=mf-1
             281     1   p                  if (mf.eq.1)  rm= 0.0
             282     1   p                  cim(m) = rm
             283     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             284     2   p    s            do 150 l=mf,jtrun
             285     2   p    v             rl = l
             286     2   p    v             rlm= rl-1.0
             287     2   p    v             if (mf.eq.1)  rm= 0.0
             288     2   p    v             eps4(l,m)= rl*rlm/radsq
             289     3   p    s             if ( l.eq.1 ) then
             290     3   p    m              wdfac(1,m) = 0. ; wcfac(1,m) = 0.
             291     3   p    s             else
             292     3   p    s              wdfac(l,m) = 1.0/(radsq*eps4(l,m))
             293     3   p    s              wcfac(l,m) = cim(m)*wdfac(l,m)
             294     3   p    v             endif
             295     1   p    v        150 continue
             296                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aki, bki, sigma
                                   <<< Loop-information  End >>>
             297     1  pp   2v            do k=1,lev+1
             298     1   p   2v              sigma(k,1) = bki(k)
             299     1   p   2v              sigma(k,2) = aki(k)
             300     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, dsigma
                                   <<< Loop-information  End >>>
             301     1  pp    v            do k=1,lev
             302     1   p    v              dsigma(k,1) = sigma(k+1,1) - sigma(k,1)
             303     1   p    v              dsigma(k,2) = sigma(k+1,2) - sigma(k,2)
             304     1   p    v            enddo
             305                     !--------------------------------------------------------------------------
             306                     !   for rrtmg
             307                     !--------------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, si
                                   <<< Loop-information  End >>>
             308     1  pp   2v            do k=1,lev+1
             309     1   p   2v               si(lev+2-k)=sigma(k,1)+sigma(k,2)/1000.
             310     1   p   2v            enddo
             311                     !--------------------------------------------------------------------------
             312                     !     build matrices for semi-implicit and normal mode initialization
             313                     !
             314                            call matrix_hybrid_cwb ( cp,sigma,dsigma,ptop,ptmean,tmean,spalm &
             315                                       , eigval,evecin,evectr,arrhyd,arsddt,pmcor,tmcor )
             316                     !
             317                     !  gaussian quadrature weights and latitudes
             318                     !
             319                           one = 1.0
             320                           onem= -one
             321                           call gausl3 (my,onem,one,weight,sinl)
             322                     !
             323                           my2= my/2
             324                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.33, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, onocos, weight, cosl
                                   <<< Loop-information  End >>>
             325     1   s    s            do 180 j = 1, my2
             326     1   s    s            sinl(my+1-j)  = -sinl(j)
             327     1   s    s            weight(my+1-j)= weight(j)
             328     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             329     1   s    s            onocos(my+1-j)= onocos(j)

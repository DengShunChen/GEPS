 External subroutine subprogram "days"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine days (cdtg,julian,hours)
               2                     
               3                           implicit  none
               4                           integer   iy,im,id,ih,imin,julian,i
               5                           integer   mon(12)
               6                           real      hours
               7                           character cdtg*12
               8                           data mon /0,31,28,31,30,31,30,31,31,30,31,30/
               9                     !
              10                           read(cdtg,'(i4,4i2)') iy,im,id,ih,imin
              11                     !cc   iy = 1900 + iy
              12                           if (mod(iy,4).eq.0)  mon(3) = 29
              13                           julian = 0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
              14     1  pp    v            do 100 i=1,im
              15     1   p    v            julian = julian + mon(i)
              16     1   p    v       100  continue
              17                           julian = julian + id
              18                           hours = float(ih)
              19                     !xx   hours = float(ih) + 8.0
              20                           return
              21                           end


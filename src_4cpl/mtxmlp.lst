 External subroutine subprogram "mtxmlp"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine mtxmlp (a,b,c,lm)
               2                     !
               3                     !  matrix multiply routine
               4                     !
               5                     !  ***input***
               6                     !
               7                     !  a:  first array in matrix product
               8                     !  b:  second array in matrix product
               9                     !  lm: order of matrices
              10                     !
              11                     ! ***output***
              12                     !
              13                     !  c: matrix product
              14                     !
              15                     ! **************************************************************
              16                     !
              17                           use const, only : RTYPE
              18                     !
              19                           implicit  none
              20                           integer   lm,j,k,i
              21                           real(kind=RTYPE) a(lm,lm),b(lm,lm),c(lm,lm)
              22                     !
              23                           call zilch(c,lm*lm)
              24                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PATTERN MATCHING(matmul)
                                   <<< Loop-information  End >>>
              25     1                     do 1 j=1,lm
              26     2                     do 1 k=1,lm
              27     3                     do 1 i=1,lm
              28     1                   1 c(i,j)= c(i,j)+a(i,k)*b(k,j)
              29                     !
              30                           return
              31                           end


 External subroutine subprogram "mtxprt"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine mtxprt (a,m,n,lab,fmt)
               2                     !
               3                     !  matrix print routine
               4                     !
               5                     !  ***input***
               6                     !
               7                     !  a: matrix to be printed
               8                     !  m: first dimension
               9                     !  n: second dimension
              10                     !  lab: caption to be printed (8 character)
              11                     !  fmt: format used for printing
              12                     !
              13                     ! *************************************************************
              14                     !
              15                     
              16                           use rank
              17                           use const, only : RTYPE
              18                     
              19                           implicit  none
              20                     
              21                           integer   m,n,nx,kk,is,ie,i,j
              22                           real(kind=RTYPE) a(m,n)
              23                           character*8 lab,fmt
              24                           character*16 cfmt
              25                     
              26                           nx= (n-1)/15+1
              27     1                     do 5 kk=1,nx
              28     1                     is= 1+(kk-1)*15
              29     1                     ie= min(is+14,n)
              30     1               !
              31     1                     if(myrank .eq. 0) print 100, lab
              32     1               !
              33     1                 100 format(/'0matrix ',a8)
              34     1                     write(cfmt,200) fmt
              35     1                 200 format('(1x,',a8,')')
              36     1               !
              37     2                     if(myrank .eq. 0) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              38     3   s    s            do 1 i=1,m
              39     3   m    m            print cfmt,(a(i,j),j=is,ie)
              40     3   p    v          1 continue
              41     2                     endif
              42     1               !
              43     1                   5 continue
              44                           return
              45                           end


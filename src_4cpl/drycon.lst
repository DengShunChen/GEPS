 External subroutine subprogram "drycon"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine drycon (j,indx,th,dp,nx,lev )
               2                     !
               3                     !     perform dry convective adjustment on a number of potential
               4                     !     temperature soundings using a variational method.
               5                     !
               6                     !   parameters:
               7                     !     th(nx,lev)    : potential temp (k),
               8                     !     dp(lev)       : sigma thickness of layers,
               9                     !     nx          : horizontal dimension
              10                     !     lev           : vertical dimension
              11                     !
              12                     !     by c.s. liou  6/92
              13                     !     modify to f90 by C-H Lee and sort by River Chen in 2015
              14                     !
              15                           implicit  none
              16                           integer   j,nx,lev
              17                           integer   indx(nx)
              18                           real      th(nx,lev),dp(lev)
              19                     !
              20                     !     local work arrays
              21                     !
              22                           real      work(nx*lev*2)
              23                           real      dth(nx*(lev-1)),b(lev-1),c(lev-1)
              24                     !
              25                           logical   stable(nx*(lev-1))
              26                     
              27                           integer   lm1,lmd,nlv,nlv1,l,i,il,k,ilmax,ismax
              28                           real      wmax
              29                     
              30                           lm1 = lev - 1
              31                           lmd = lev * 2
              32                           nlv = nx*lev
              33                           nlv1= nx*lm1
              34                     !
              35                     !   check for stability of each layer
              36                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 37,46)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      th, dth, stable
                                   <<< Loop-information  End >>>
              37     1                     do 100 l = 1, lm1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      th, stable, dth
                                   <<< Loop-information  End >>>
              38     2  pp   2v            do 100 i = 1, nx
              39     2   p   2v            il=i+nx*(l-1)
              40     2   p   2v            dth(il) = (th(i,l+1) - th(i,l))*dp(l)
              41     2   p   2v            stable(il) = dth(il) .le. 0.0
              42     1   p   2v       100  continue
              43                     !
              44                     !   compute off diagonal coeff
              45                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
              46     1                     do 200 l = 1, lm1
              47     1                     c(l)= dp(l)/dp(l+1)
              48     1                     b(l)= - c(l) - 1.0
              49     1                 200 continue
              50                     !
              51                     !   iterate (20 times max.) to adjust potential temp
              52                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stable, dth, work
                                   <<< Loop-information  End >>>
              53     1                     do 800 k = 1, 20
              54     1               !
              55     1               !   force no adjustment for stable layers with zero forcing
              56     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dth, stable
                                   <<< Loop-information  End >>>
              57     2  pp   2v            do 300 i = 1, nlv1
              58     2   p   2v            if ( stable(i) )  dth(i) = 0.0
              59     2   p   2v        300 continue
              60     1               !
              61     1               !   solve a tri-diagonal system for temperature adjustment
              62     1               !
              63     1                     call triadj( dth,b,c,nx,lm1,lmd,work,stable )
              64     1               !
              65     1               !   adjust potential temperature
              66     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dth, work
                                   <<< Loop-information  End >>>
              67     2                     do 400 l = 2, lm1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dth, work
                                   <<< Loop-information  End >>>
              68     3  pp   2v            do 400 i = 1, nx
              69     3   p   2v            il=i+nx*(l-1)
              70     3   p   2v            work(il) = (dth(il) - dth(il-nx))/dp(l)
              71     2   p   2v        400 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 14, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      work, dth
                                   <<< Loop-information  End >>>
              72     2   s   2s            do 410 i = 1, nx
              73     2   m   2m            work(i) = dth(i) / dp(1)
              74     2   m   2m            work(i+nlv1) = - dth(i+nlv1-nx) / dp(lev)
              75     2   p   2v        410 continue
              76     1                     wmax = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              77     2  pp    v            do 420 i = 1, nlv
              78     2   p    v            th(i,1) = th(i,1) - work(i)
              79     2   p    v            wmax = max ( wmax, abs(work(i)) )
              80     2   p    v        420 continue
              81     1               !
              82     1               !     assume convergence if max correction is less than .05 degrees
              83     1               !
              84     1                     if( wmax .lt. 0.05 ) go to 900
              85     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      th, stable, dth
                                   <<< Loop-information  End >>>
              86     2                     do 500 l = 1, lm1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      th, stable, dth
                                   <<< Loop-information  End >>>
              87     3  pp   2v            do 500 i = 1, nx
              88     3   p   2v            il= i+nx*(l-1)
              89     3   p   2v            dth(il) = ( th(i,l+1) - th(i,l) )*dp(l)
              90     3   p   2v            stable(il) = dth(il) .le. 0.0
              91     2   p   2v        500 continue
              92     1                     ilmax= ismax(nx*lm1,dth,1)
              93     1                     ilmax= ilmax-nx*((ilmax-1)/nx)
              94     1                     ilmax= indx(ilmax)
              95     1               !
              96     1                 800 continue
              97                           print 910, wmax,ilmax,j
              98                       910 format(1x,'*** warning: no drycon converge , wmax = ', &
              99                                     e13.6 ,',at i,j=',2i4)
             100                     !
             101                       900 continue
             102                     !
             103                           return
             104                           end


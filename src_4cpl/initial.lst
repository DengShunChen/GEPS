 External subroutine subprogram "initial"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine initial(no,jtrun,jtmax,lev,nx,my,my_max,mlmax)
               2                     
               3                     !
               4                     !  purpose : do nonlinear normal mode initialization
               5                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
               6                     !-----------------------------------------------------------
               7                           use param, only : ncld
               8                           use mpe
               9                           use rank
              10                           use index
              11                           use const, only : eigval,omega,rad,nnmiit,doincr,evecin,nnmivm,   &
              12                                             cutfreq,evectr,pmcor,tmcor,poly,dpoly,cim,      &
              13                                             wdfac,wcfac,onocos,RTYPE
              14                           use spec,  only : temold,vorten,vorold,divten,divold,plnow,temnow,&
              15                                             divnow,vornow,plold
              16                     !byl                        divnow,vornow,qold,qnow,plold
              17                           use grid,  only : pt,tt,rdiv,rvor,dtpl,dlpl,ut,vt
              18                           use fftcom
              19                     
              20                           implicit none
              21                           integer  no,jtrun,jtmax,lev,nx,my,my_max,mlmax
              22                     !
              23                     !  working array
              24                     !
              25                     !     integer, parameter ::  no=2*((jtrun+1)/2)+(jtrun/2)+10
              26                           real      eval(no),evec(no*no),epos(no*no),x(no*2)
              27                     !byl      real      a(jtrun,jtrun,lev),b(jtrun,jtrun,lev)
              28                           real      a(jtrun,jtrun,nnmivm),b(jtrun,jtrun,nnmivm)
              29                           real      mx(no*no),h(jtrun,jtmax,nnmivm),c(jtrun,jtrun,nnmivm)
              30                           integer   nw(jtrun,jtmax)
              31                           real(kind=RTYPE) phiten(levp,2,jtrun,jtmax),dummy
              32                           real      wk(no*no),wc(no*2),wd(no*2),ew(no*no)
              33                           real(kind=RTYPE) cc(nx+2,levp,1,my_max)
              34                     !byl      real      cc(nx+2,levp,3,my_max),wss(levp,2,3,jtrun,jtmax)
              35                           real      bal_tmp(jtrun)
              36                           character lab*10,lrec*16
              37                     
              38                           integer   mlmax2,j,k,l,ic,m,mf,n,ns,na,nbig,kk,kL
              39                           real      bal
              40                           logical   nnmical
              41                           integer   brank   !root rank of row_broadcast
              42                     !
              43                           mlmax2 = mlmax*2
              44                           if(myrank .eq. 0) print *,'jrtun=',jtrun,' mlmax=',mlmax
              45                           lab='pt'
              46                           call  check(pt,nx,my,my_max,lab)
              47                     !
              48                     !  define constants and comput coefficients for initializatin
              49                     !
              50                           call  inicons (rad,omega,eigval,lev,jtrun,jtmax, &
              51                                          nw,a,b,c,h,nnmivm)
              52                     !
              53                     !  begin to iterration, now doing 3 iterrations
              54                     !
              55     1                     do 120 ic=1,nnmiit
              56     1               !
              57     1                       if(myrank .eq. 0) print *,'iteration=',ic
              58     1               !
              59     1               !  get tendency of vorticity,divergence,geopotential
              60     1               !
              61     1                       call tendget (phiten)
              62     1               !
              63     1               !--------------------------------------------------------
              64     1               !  incremental initialization
              65     1               !
              66     2                       if(doincr)then
              67     3                         do m=1,mlistnum
              68     3                           mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              69     4  pp                       do n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phiten, divold, divten, vorold, vorten
                                   <<<      temold
                                   <<< Loop-information  End >>>
              70     5   p                         do j =1,2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.42, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temold, phiten, divold, divten, vorold
                                   <<<      vorten
                                   <<< Loop-information  End >>>
              71     6   p    v                      do k =1,levp
              72     6   p    v                        phiten(k,j,n,m)=phiten(k,j,n,m)-temold(k,j,n,m)
              73     6   p    v                        vorten(k,j,n,m)=vorten(k,j,n,m)-vorold(k,j,n,m)
              74     6   p    v                        divten(k,j,n,m)=divten(k,j,n,m)-divold(k,j,n,m)
              75     6   p    v                      enddo
              76     5   p                         enddo
              77     4   p                       enddo
              78     3                         enddo
              79     2                       endif
              80     1               !
              81     1               !--------------------------------------------------------
              82     1               !
              83     1               !  do vertical transform
              84     1               !
              85     1                       call zx (evecin,vorten,divten,phiten,jtrun,jtmax,lev)
              86     1               !
              87     1               !     conversion  structure of variables from forecast model to
              88     1               !     initialization
              89     1               !     model
              90     1               !
              91     1               !   begin initialize the first liz (now,liz=3) modes.
              92     1               !
              93     1               
              94     2                       do 110 L=1,nnmivm
              95     2                         nnmical=.false.
              96     2                         brank=0
              97     3                         if( (L .ge. Lstart) .and. (L .le. Lend)) then
              98     3                           k=L-Lstart+1
              99     3                           nnmical=.true.
             100     3                           brank=row_rank
             101     3                         endif
             102     2               !
             103     2                         if(myrank .eq. 0) print *,'vertical mode l=',L
             104     2               !
             105     2               ! set convergence variable
             106     2               !
             107     2                         bal=0.
             108     2               !
             109     2               !   do nondimensionalize of the variables
             110     2               !         +2:nondimensionalize
             111     2               !
             112     2               !      if(L.eq.Llist(L)) &
             113     2                     if(nnmical) &
             114     2                         call vartran (vorten,divten,phiten,nw,jtrun,jtmax,levp,k, &
             115     2                                      rad,omega,h(1,1,L),+2)
             116     2               !
             117     2               !   begin to initialize horizontal modes
             118     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 29
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             119     3                         do 100 m=1,mlistnum
             120     3                           mf=mlist(m)
             121     3               !
             122     3               !  calculate the size of symmetric and antisymmetric matrix which
             123     3               !  include the gravity and rossby wave
             124     3               !
             125     3                           nbig = jtrun-mf+1
             126     3                           ns   = 2*int((nbig+1)/2)+int(nbig/2)
             127     3                           na   = 2*int(nbig/2)+int((nbig+1)/2)
             128     3               !
             129     3               !  do symmetric case
             130     3               !
             131     3               !  create variable vector
             132     3               !       +1:symmetric, +2:creation
             133     3               !
             134     3               !      if(L.eq.Llist(L)) &
             135     3                     if(nnmical) &
             136     3                           call vartrix (vorten,divten,phiten,levp, &
             137     3                                        k,x,ns,m,nbig,jtrun,jtmax,+1,+2)
             138     3               
             139     3                     call mpe2d_row_broadcast(x,no*2,brank)
             140     3               
             141     3               !
             142     3               !  construct coefficient matrix
             143     3               !       +1:symmetric
             144     3               !
             145     3               !      if(L.eq.Llist(L)) &
             146     3                     if(nnmical) &
             147     3                           call coftrix (mf,L,mx,ns,a(1,1,L),b(1,1,L),c(1,1,L),jtrun,lev,+1)
             148     3               
             149     3                     call mpe2d_row_broadcast(mx,no*no,brank)
             150     3               !
             151     3               !   fine the eigenvector and eigenvalues of the symmetric matrix
             152     3               !
             153     3                           call eigen (mx,ns,eval,evec,epos,wk)
             154     3               !
             155     3               !   perform nonlinear normal mode initialization
             156     3               !
             157     3                           call nnmi (no,x,epos,eval,evec,ns,wc,wd,bal,cutfreq)
             158     3               !
             159     3               !   decompose the variable vector back to 3 individual variable
             160     3               !       +1:symmetric , -2:decompose
             161     3               !
             162     3               !      if(L.eq.Llist(L)) &
             163     3                     if(nnmical) &
             164     3                           call vartrix (vorten,divten,phiten,levp, &
             165     3                                         k,x,ns,m,nbig,jtrun,jtmax,+1,-2)
             166     3               !
             167     3               !   do antisymmtric case
             168     3               !
             169     3               !   construct variable vector from 3 individual variable
             170     3               !       -1:antisymmetric , +2 : creation
             171     3               !
             172     3               !      if(L.eq.Llist(L)) &
             173     3                     if(nnmical) &
             174     3                           call vartrix (vorten,divten,phiten,levp, &
             175     3                                         k,x,na,m,nbig,jtrun,jtmax,-1,+2)
             176     3               
             177     3                     call mpe2d_row_broadcast(x,no*2,brank)
             178     3               !
             179     3               !  construct coefficient matrix
             180     3               !       -1:antisymmetric
             181     3               !
             182     3               !      if(L.eq.Llist(L)) &
             183     3                     if(nnmical) &
             184     3                           call coftrix (mf,L,mx,na,a(1,1,L),b(1,1,L),c(1,1,L),jtrun,lev,-1)
             185     3               
             186     3                     call mpe2d_row_broadcast(mx,no*no,brank)
             187     3               !
             188     3               !   fine the eigenvector and eigenvalues of the antisymmetric matrix
             189     3               !
             190     3                           call eigen (mx,na,eval,evec,epos,wk)
             191     3               !
             192     3               !   perform nonlinear normal mode initialization
             193     3               !
             194     3                           call nnmi (no,x,epos,eval,evec,na,wc,wd,bal,cutfreq)
             195     3               !
             196     3               !   decompose the variable vector back to 3 individual variable
             197     3               !       +1:symmetric , -2:decompose
             198     3               !
             199     3               !      if(L.eq.Llist(L)) &
             200     3                     if(nnmical) &
             201     3                           call vartrix (vorten,divten,phiten,levp, &
             202     3                                         k,x,na,m,nbig,jtrun,jtmax,-1,-2)
             203     3                           bal_tmp(mf) = bal
             204     3                           bal = 0.
             205     3               !
             206     3                100      continue
             207     2               !
             208     2                         call mpe_unify(bal_tmp,1,jtrun,3,mpe_double)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             209     3  pp    v                do mf = 1, jtrun
             210     3   p    v                  bal = bal + bal_tmp(mf)
             211     3   p    v                enddo
             212     2               !
             213     2                         if(myrank .eq. 0) print *,'bal=',bal
             214     2               !
             215     2               !   dimensionlize the variables
             216     2               !     -2:dimensionalize
             217     2               !
             218     2               !      if(L.eq.Llist(L)) &
             219     2                     if(nnmical) &
             220     2                         call vartran (vorten,divten,phiten,nw,jtrun,jtmax,levp,k, &
             221     2                                       rad,omega,h(1,1,L),-2)
             222     2               !
             223     2                110    continue
             224     1               !
             225     1               !   initial none initialized mode
             226     1               !
             227     1               
             228     1               !2dMPI>
             229     1               !!         kL=1
             230     1               !!         kk=Llist(nnmivm+1)
             231     1               !!         if(kk .le.levp)then
             232     1               !!            kL=nnmivm+1
             233     1               !!         endif
             234     1               !2dMPI<
             235     1               
             236     2                        do m=1,mlistnum
             237     2                          mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             238     3  pp                      do n=mf,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Llist, vorten, divten, phiten
                                   <<< Loop-information  End >>>
             239     4   p                        do j = 1, 2
             240     4               !              do k = nnmivm+1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vorten, Llist, divten, phiten
                                   <<< Loop-information  End >>>
             241     5   p   2v                     do k = 1,levp
             242     5   p   2v                       kk=Llist(k)
             243     6   p   2v                       if ( kk .gt. nnmivm ) then
             244     6   p   2v                         vorten(k,j,n,m)= 0.
             245     6   p   2v                         divten(k,j,n,m)= 0.
             246     6   p   2v                         phiten(k,j,n,m)= 0.
             247     6   p   2v                       endif
             248     5   p   2v                     enddo
             249     4   p                        enddo
             250     3   p                      enddo
             251     2                        enddo
             252     1               !
             253     1               !  conversion  structure of variables ( phiten,vorten,divten)
             254     1               !
             255     1               !   vertical transform back
             256     1               !
             257     1                       call zx (evectr,vorten,divten,phiten,jtrun,jtmax,lev)
             258     1               !
             259     1               !   add the correction to variables
             260     1               !
             261     1                       call correct (vorten,divten,phiten,tmcor,pmcor,vornow, &
             262     1                                    divnow,temnow,plnow,jtrun,jtmax,lev)
             263     1               !
             264     2                       do m=1,mlistnum
             265     2                         mf=mlist(m)
             266     3                         if (mf.eq.1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vornow, divnow
                                   <<< Loop-information  End >>>
             267     4  pp   2v                  do k = 1, levp
             268     4   p   2v                    vornow(k,1,1,m)= 0.
             269     4   p   2v                    vornow(k,2,1,m)= 0.
             270     4   p   2v                    divnow(k,1,1,m)= 0.
             271     4   p   2v                    divnow(k,2,1,m)= 0.
             272     4   p   2v                  enddo
             273     3                         endif
             274     2                       enddo
             275     1               !
             276     1               !   transform back to phyical space
             277     1               !
             278     1               !!        call joinsr(wss,vornow,divnow,temnow,dummy,jtrun,jtmax,levp &
             279     1               !!                   ,mlistnum,3,1)
             280     1               !!        call transr(jtrun,jtmax,nx,my,my_max,levp,poly,wss,cc,3,nsizey)
             281     1               !!        call ujoinsr(cc,rvor,rdiv,tt,dummy,nx,my_max,lev,jlistnum,3,1)
             282     1                       call transr(jtrun,jtmax,nx,my,my_max,levp,poly,vornow,cc,1,nsizey)
             283     1                       call ujoinsr(cc,rvor,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             284     1                       call transr(jtrun,jtmax,nx,my,my_max,levp,poly,divnow,cc,1,nsizey)
             285     1                       call ujoinsr(cc,rdiv,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             286     1                       call transr(jtrun,jtmax,nx,my,my_max,levp,poly,temnow,cc,1,nsizey)
             287     1                       call ujoinsr(cc,tt,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             288     1                       call transr1(jtrun,jtmax,nx,my,my_max,poly,plnow,pt,nsizey)
             289     1               !
             290     1               !  compute zonal and meridional gradients of terrain pressure
             291     1               !
             292     1                       call trngra (jtrun,jtmax,nx,my,my_max,cim,poly,dpoly,plnow, &
             293     1                                   dlpl,dtpl,nsizey)
             294     1               !
             295     1               !   transform spectrum vorticity , divergence to physical u , v
             296     1               !
             297     1                       call tranuv (jtrun,jtmax,nx,my,my_max,levp,onocos,wcfac,wdfac &
             298     1                                  ,poly,dpoly,vornow,divnow,ut,vt,nsizey)

               1                           subroutine minp ( mn,aa,amn,imn )
               2                     !
               3                     !     find out the min value and location of the array aa
               4                     !
               5                           implicit  none
               6                           integer   mn,imn,i
               7                           real      aa(mn),amn
               8                     !

              11     1  pp    s            do 100 i = 2, mn
              12     2   p    v            if ( aa(i) .lt. amn )  then
              13     2   p    m               imn = i
              14     2   p    s               amn = aa(i)
              15     2   p    m            endif
              16     1   p    s        100 continue
              17                     !
              18                     !ccc  imn = ismin ( mn,aa,1 )

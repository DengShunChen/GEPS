             219                     !------------------------------------------------------------------------------
             220                       SUBROUTINE add_dim (name, len, longname, units, levtyp, single, value, indx)
             221                       !--------------------------------------------------
             222                       ! define a new dimension for Netcdf and GRIB output
             223                       !--------------------------------------------------
             224                       CHARACTER (len=*) ,INTENT(in)            :: name      ! mnemonic
             225                       INTEGER           ,INTENT(in)            :: len       ! size of dimension
             226                       CHARACTER (len=*) ,INTENT(in)  ,OPTIONAL :: longname  ! long name
             227                       CHARACTER (len=*) ,INTENT(in)  ,OPTIONAL :: units     ! units
             228                       INTEGER           ,INTENT(in)  ,OPTIONAL :: levtyp    ! GRIB level type
             229                       LOGICAL           ,INTENT(in)  ,OPTIONAL :: single    ! single layer flag
             230                       REAL          ,INTENT(in)  ,OPTIONAL :: value (:) ! coordinates
             231                       INTEGER           ,INTENT(out) ,OPTIONAL :: indx      ! index in IO_dim_ids
             232                     
             233                         INTEGER                :: idx, i
             234                         TYPE (IO_dim) ,POINTER :: dim
             235                         !--------------------
             236                         ! check for zero size
             237                         !--------------------
             238     1                   if (len == 0) then
             239     1                     WRITE(nerr,*) 'add_dim',TRIM(name)//' len = 0'
             240     1                     stop
             241     1                   endif
             242                         !-----------------------------------------------------------
             243                         ! if dimension is already defined it must have the same size
             244                         !-----------------------------------------------------------
             245                         idx = 0
             246     1                   do i=1, IO_ndim_ids
             247     2                     if (IO_dim_ids(i)% dim_name == name) then
             248     2                       idx = i
             249     2                       if (IO_dim_ids(i)% dim_len /= len) &
             250     2                         WRITE(nerr,*) 'add_dim',TRIM(name)//' redifined with different len'
             251     2                         stop
             252     2                       exit
             253     2                     endif
             254     1                   end do
             255                         !--------------------------------------
             256                         ! increase number of dimensions defined
             257                         !--------------------------------------
             258     1                   if (idx == 0) then
             259     1                     IO_ndim_ids = IO_ndim_ids + 1
             260     1                     IF (IO_ndim_ids > SIZE(IO_dim_ids)) &
             261     1                       WRITE(nerr,*) 'add_dim','increase size of IO_dim_ids'
             262     1                       stop
             263     1                     idx = IO_ndim_ids
             264     1                     dim => IO_dim_ids(idx)
             265     1                   endif
             266                         !---------------------------------------------------------
             267                         ! define attributes, chose defaults or optional parameters
             268                         !---------------------------------------------------------
             269                         dim% dim_id   =   0
             270                         dim% var_id   =   0
             271                         dim% dim_len  =  len
             272                         dim% dim_name =  name
             273                         dim% longname =  ''     ; IF (PRESENT (longname)) dim% longname = longname
             274                         dim% units    =  ''     ; IF (PRESENT (units   )) dim% units    = units
             275                         dim% levtyp   =   0     ; IF (PRESENT (levtyp  )) dim% levtyp   = levtyp
             276                         dim% single   =  .FALSE.; IF (PRESENT (single  )) dim% single   = single
             277                         IF (ASSOCIATED (dim% value)) DEALLOCATE (dim% value)
             278     1                   IF (PRESENT (value)) THEN
             279     1                     IF (SIZE (value) /= dim% dim_len) &
             280     1                       WRITE(nerr,*) 'add_dim',TRIM(name)//' len /= size (value)'
             281     1                       stop
             282     1                     ALLOCATE (dim% value (SIZE (value)))
             283     1                     dim% value = value
             284     1                   ENDIF
             285                         IF (PRESENT(indx)) indx = idx
             286                       END SUBROUTINE add_dim
             287                     !------------------------------------------------------------------------------
             288                       SUBROUTINE add_unknown_dim (len, indx)
             289                       !-----------------------------------------
             290                       ! add a dummy entry in the dimension table
             291                       !-----------------------------------------
             292                     
             293                       INTEGER   ,INTENT(in)  :: len  ! size of dimension
             294                       INTEGER   ,INTENT(out) :: indx ! index of entry in table
             295                     
             296                         CHARACTER(len=4) :: nam
             297                         CHARACTER(len=4) :: form
             298                         INTEGER          :: i
             299     1                   SELECT CASE (len)
             300     1                   CASE (1:9)
             301     1                     form ='(i1)'
             302     1                   CASE (10:99)
             303     1                     form ='(i2)'
             304     1                   CASE (100:999)
             305     1                     form ='(i3)'
             306     1                   CASE default
             307     1                     WRITE(nerr,*) 'add_unknown_dim','len < 1 or len > 999'
             308     1                     stop
             309     1               
             310     1                   END SELECT
             311                         nam = 'n'
             312                         WRITE (nam(2:4),form) len
             313     1                   DO i=1, IO_ndim_ids
             314     2                     IF (IO_dim_ids(i)% dim_name == nam) THEN
             315     2                       indx = i
             316     2                       RETURN
             317     2                     ENDIF
             318     1                   END DO
             319                         CALL add_dim (nam, len, levtyp=109, indx=indx)
             320                       END SUBROUTINE add_unknown_dim
             321                     !------------------------------------------------------------------------------
             322                       SUBROUTINE IO_DEF_DIM (ncid, name, len, dimid)
             323                     
             324                         INTEGER :: ncid, len, dimid, status, indx
             325                         CHARACTER*(*) name
             326                     
             327                     
             328                         status = NF_DEF_DIM (ncid, name, len, dimid)
             329     1                   IF (status /= NF_NOERR) THEN
             330     1                     WRITE(nerr,*) 'IO_DEF_DIM :', ncid, name, len
             331     1                     WRITE(nerr,*) 'IO_DEF_DIM', NF_STRERROR(status)
             332     1                     WRITE(nerr,*) 'IO_DEF_DIM', 'Run terminated.'
             333     1                     stop
             334     1                   END IF
             335                     
             336     1                   DO indx = 1, IO_ndim_ids
             337     2                     IF (name == IO_dim_ids(indx)%dim_name) THEN
             338     2                       IO_dim_ids(indx)%dim_id = dimid
             339     2                       RETURN
             340     2                     END IF
             341     1                   END DO
             342                     
             343                         WRITE (nerr,*) 'element ',name,' not available ...'
             344                         WRITE (nerr,*) 'IO_DEF_DIM','IO_dim_ids error'
             345                         stop
             346                     
             347                     
             348                       END SUBROUTINE IO_DEF_DIM

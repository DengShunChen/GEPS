              71        pp   4v            deldm=0.
              72                     !
              73                     !  surface pressure tendency
              74                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dlpl, ut, dtpl, vt, pt, deldm, rdiv, cg
                                   <<<      sd
                                   <<< Loop-information  End >>>
              75     1                     do 2 k=1,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.37, ITR: 104, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rdiv, dlpl, deldm, ut, dtpl, pt, vt, sd
                                   <<<      cg
                                   <<< Loop-information  End >>>
              76     2  pp    v            do 2 i=1,nxj
              77     2   p    v              cg(i,k) = ut(i,k)*dlpl(i)*onocos+vt(i,k)*dtpl(i)
              78     2   p    v              deldm(i)= deldm(i)-dsigma(k,1)*cg(i,k)                        &
              79     2                                -rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
              80     2               !!        deldm(i)= deldm(i)+pten(i,k)-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
              81     2               !        deldm(i)= deldm(i)-dsig(k)*(ut(i,k)*dlpl(i)*onocos
              82     2               !     *           +vt(i,k)*dtpl(i)+rdiv(i,k)*pt(i))
              83     2   p    v              sd(i,k+1)= deldm(i)
              84     1   p    v          2 continue
              85                     !
              86                           k= lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 104, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, rdiv, dlpl, deldm, ut, vt, dtpl, cg

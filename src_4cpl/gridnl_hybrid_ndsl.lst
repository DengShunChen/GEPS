 External subroutine subprogram "gridnl_hybrid_ndsl_2tl"
  (inc)(line-no.)(nest)(optimize)
             150                     !
             151                     !----------------------------------------------------------------------
             152                           subroutine gridnl_hybrid_ndsl_2tl ( nxj,nx,lev,ncld            &
             153                                             , cp,radsq,ut,vt,rdiv,tt,qt,phi,pt           &
             154                                             , dtpl,dlpl,sinl,pk,pk2,dsigma,sigma,onocos  &
             155                                             , cor,diveng,vdmerd,vdzonl,pten,deldm,sdpbl  &
             156                                             , sd,pdot,sgeo,step)
             157                     !
             158                     !  real to spectral transformation, compute non-linear contributions
             159                     !  to spectral tendencies
             160                     !
             161                     !  **** input variables ****
             162                     !
             163                     !  nx:  e-w dimension
             164                     !  lev: no. of vertical levels
             165                     !  cp: specific heat of air
             166                     !  radsq: radius of earth squared
             167                     !  ut: gridpt e-w velocity (scaled)
             168                     !  vt: gridpt n-s velocity (scaled)
             169                     !  tt: gridpt virtual potential temp
             170                     !  qt: gridpt specific humidity
             171                     !  rdiv: gridpt divergence
             172                     !  pt: gridpt terrain pressure
             173                     !  dtpl: d(pt)/dy
             174                     !  dlpl: d(pt)/dx
             175                     !  pk: exner function on full(odd) levels
             176                     !  pk2: exner function on half(even) levels
             177                     !  dsigma: thickness of sigma layers
             178                     !  sigma: sigma level values
             179                     !  onocos: 1.0/(cos(lat)**2)
             180                     !  cor: coriolis on each gaussian latitude
             181                     !  pten: horizontal adv of terrain pressure
             182                     !
             183                     ! *** output variables ***
             184                     !
             185                     !  deldm: terrain pressure tendency
             186                     !  sd: vertical velocity
             187                     !  pdot: vertical velocity
             188                     !  diveng: energy term of divergence equation
             189                     !  vdmerd: meridional advection term of divergence/vorticity tends
             190                     !  vdzonl: zonal advection term of divergence/vorticity tends
             191                     !
             192                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
             193                     !
             194                     ! ******************************************************************
             195                     !
             196                           use const, only : RTYPE
             197                           implicit  none
             198                     
             199                           integer   nxj,nx,lev,ncld
             200                           real      cp,radsq
             201                           real(kind=RTYPE) onocos,cor,sinl
             202                     
             203                     !
             204                           real(kind=RTYPE) diveng(nx,lev),vdmerd(nx,lev),vdzonl(nx,lev),   &
             205                                            pdot(nx,lev+1),pten(nx,lev),dlpl(nx),dtpl(nx),  &
             206                                            rdiv(nx,lev),ut(nx,lev),vt(nx,lev),tt(nx,lev),  &
             207                                            qt(nx,lev*ncld),phi(nx,lev),pt(nx),sgeo(nx),    &
             208                                            deldm(nx),spal(nx,lev),sd(nx,lev),sdpbl(nx),    &
             209                                            dsigma(lev,2),sigma(lev+1,2),pk(nx,lev),        &
             210                                            pk2(nx,lev)
             211                     !
             212                           logical   flag(nx)
             213                     !
             214                           integer   k,i,kbgn,kk,step
             215                           real      px,px_pbl
             216                     
             217     1                     if ( step .eq. 2 ) then
             218     1               !CWB2014 fixed undefined value problem in diabat line 665
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd
                                   <<< Loop-information  End >>>
             219     1  pp   4v            sd=0.
             220     1               !
             221     1               !  surface pressure tendency
             222     1               !
             223     1                     k= 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 72, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, dtpl, pt, rdiv, dlpl, ut, deldm, sd
                                   <<< Loop-information  End >>>
             224     2  pp    v            do 22 i=1,nxj
             225     2   p    v              deldm(i)= -dsigma(k,1)*(ut(i,k)*dlpl(i)*onocos+vt(i,k)*dtpl(i))   &
             226     2                                 -rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             227     2               !        deldm(i)= pten(i,k)-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             228     2               !        deldm(i)= -dsig(k)*(ut(i,k)*dlpl(i)*onocos+vt(i,k)*dtpl(i)
             229     2               !     *            +rdiv(i,k)*pt(i))
             230     2   p    v              sd(i,k+1)= deldm(i)
             231     2   p    v         22 continue
             232     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dlpl, ut, rdiv, pt, vt, dtpl, deldm, sd
                                   <<< Loop-information  End >>>
             233     2                     do 2 k=2,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.57, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, vt, dtpl, rdiv, dlpl, ut, deldm, sd
                                   <<< Loop-information  End >>>
             234     3  pp    v            do 2 i=1,nxj
             235     3   p    v              deldm(i)= deldm(i)-dsigma(k,1)*(ut(i,k)*dlpl(i)*onocos            &
             236     3                                +vt(i,k)*dtpl(i))-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             237     3               !        deldm(i)= deldm(i)+pten(i,k)-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             238     3               !        deldm(i)= deldm(i)-dsig(k)*(ut(i,k)*dlpl(i)*onocos
             239     3               !     *           +vt(i,k)*dtpl(i)+rdiv(i,k)*pt(i))
             240     3   p    v              sd(i,k+1)= deldm(i)
             241     2   p    v          2 continue
             242     1               !
             243     1                     k= lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      deldm, pt, vt, dtpl, rdiv, dlpl, ut
                                   <<< Loop-information  End >>>
             244     2  pp    v            do 24 i=1,nxj
             245     2   p    v              deldm(i)= deldm(i)-dsigma(k,1)*(ut(i,k)*dlpl(i)*onocos            &
             246     2                                +vt(i,k)*dtpl(i))-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             247     2               !        deldm(i)= deldm(i)+pten(i,k)-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             248     2               !        deldm(i)= deldm(i)-dsig(k)*(ut(i,k)*dlpl(i)*onocos
             249     2               !     *           +vt(i,k)*dtpl(i)+rdiv(i,k)*pt(i))
             250     2   p    v         24 continue
             251     1               !
             252     1               !  vertical velocity
             253     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdot, sd
                                   <<< Loop-information  End >>>
             254     1  pp   2v            sd(:,    1) = 0.0
             255     1   p   2v            pdot(:,lev+1) = 0.0
             256     1   p   2v            pdot(:,    1) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd, deldm, pdot
                                   <<< Loop-information  End >>>
             257     2  pp                 do 3 k=2,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdot, sd, deldm
                                   <<< Loop-information  End >>>
             258     3   p   2v            do 3 i=1,nxj
             259     3   p   2v              kk=lev-k+2
             260     3   p   2v              sd(i,k)= sd(i,k)-sigma(k,1)*deldm(i)
             261     3               !        sd(i,k)= sd(i,k)-sig(k)*deldm(i)
             262     3   p   2v              pdot(i,kk)=sd(i,k)
             263     2   p   2v          3 continue
             264     1               !
             265     1               !  obtain vertical velocity within low layers
             266     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.40, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sdpbl, flag, sd
                                   <<< Loop-information  End >>>
             267     2  pp   2v            do i = 1, nxj
             268     2   p   2v              flag(i) = .true.
             269     2   p   2v              sdpbl(i) = sd(i,lev-1)
             270     2   p   2v            enddo
             271     1               !
             272     1                     px_pbl = 850.
             273     1                     kbgn = (lev*2)/3 - 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma
                                   <<< Loop-information  End >>>
             274     2   p    s            do 4 k = kbgn, lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             275     3  pp   2             do 4 i = 1, nxj
             276     3   p   2v              px = sigma(k,1) * pt(i) + sigma(k,2)
             277     3               !        px = sig(k) * pt(i)
             278     4   p   2s              if( px .ge. px_pbl .and. flag(i) ) then
             279     4   p   2s                sdpbl(i) = sd(i,k)
             280     4   p   2v                flag(i) = .false.
             281     4   p   2v              endif
             282     2   p   2v          4 continue
             283     1               !
             284     1                     else
             285     1               !
             286     1                     call vstruc_hybrid_cwb(nxj,nx,lev,cp,radsq,sigma,dsigma,pt,tt,qt &
             287     1                                  ,pk,pk2,spal,phi,ncld)
             288     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt, spal, dtpl, phi, sgeo, dlpl
                                   <<<      vdzonl, diveng, vdmerd
                                   <<< Loop-information  End >>>
             289     2  pp                 do 13 k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.10, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtpl, vt, ut, phi, sgeo, diveng, spal
                                   <<<      dlpl, vdzonl, vdmerd
                                   <<< Loop-information  End >>>
             290     3   p    v            do 13 i=1,nxj
             291     3   p    v              vdmerd(i,k)= -spal(i,k)*dtpl(i)/onocos-ut(i,k)*cor             &
             292     3                                    -(ut(i,k)*ut(i,k)+vt(i,k)*vt(i,k))*onocos*sinl
             293     3   p    v              vdzonl(i,k)= -spal(i,k)*dlpl(i)+vt(i,k)*cor
             294     3               
             295     3   p    v              diveng(i,k)= sgeo(i)+phi(i,k)
             296     2   p    v        13  continue
             297     1                     endif
             298                           return
             299                           end


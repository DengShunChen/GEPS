             127     2  pp   2             do 4 i = 1, nxj
             128     2   p   2v              px = sigma(k,1) * pt(i) + sigma(k,2)
             129     2               !        px = sig(k) * pt(i)
             130     3   p   2s              if( px .ge. px_pbl .and. flag(i) ) then
             131     3   p   2s                sdpbl(i) = sd(i,k)
             132     3   p   2v                flag(i) = .false.
             133     3   p   2v              endif
             134     1   p   2v          4 continue
             135                     !
             136                     !
             137                           call vstruc_hybrid_cwb(nxj,nx,lev,cp,radsq,sigma,dsigma,pt,tt,qt &
             138                                        ,pk,pk2,spal,phi,ncld)

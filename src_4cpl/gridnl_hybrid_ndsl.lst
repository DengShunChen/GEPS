               1                           subroutine gridnl_hybrid_ndsl ( nxj,nx,lev,ncld                &
               2                                             , cp,radsq,ut,vt,rdiv,tt,qt,phi,pt           &
               3                                             , dtpl,dlpl,sinl,pk,pk2,dsigma,sigma,onocos  &
               4                                             , cor,diveng,vdmerd,vdzonl,pten,deldm,sdpbl  &
               5                                             , sd,pdot,vvel,sgeo)
               6                     !
               7                     !  real to spectral transformation, compute non-linear contributions
               8                     !  to spectral tendencies
               9                     !
              10                     !  **** input variables ****
              11                     !
              12                     !  nx:  e-w dimension
              13                     !  lev: no. of vertical levels
              14                     !  cp: specific heat of air
              15                     !  radsq: radius of earth squared
              16                     !  ut: gridpt e-w velocity (scaled)
              17                     !  vt: gridpt n-s velocity (scaled)
              18                     !  tt: gridpt virtual potential temp
              19                     !  qt: gridpt specific humidity
              20                     !  rdiv: gridpt divergence
              21                     !  pt: gridpt terrain pressure
              22                     !  dtpl: d(pt)/dy
              23                     !  dlpl: d(pt)/dx
              24                     !  pk: exner function on full(odd) levels
              25                     !  pk2: exner function on half(even) levels
              26                     !  dsigma: thickness of sigma layers
              27                     !  sigma: sigma level values
              28                     !  onocos: 1.0/(cos(lat)**2)
              29                     !  cor: coriolis on each gaussian latitude
              30                     !  pten: horizontal adv of terrain pressure
              31                     !
              32                     ! *** output variables ***
              33                     !
              34                     !  deldm: terrain pressure tendency
              35                     !  sd: vertical velocity
              36                     !  pdot: vertical velocity
              37                     !  vvel: vertical velocity at mean layer(Pa/s)
              38                     !  diveng: energy term of divergence equation
              39                     !  vdmerd: meridional advection term of divergence/vorticity tends
              40                     !  vdzonl: zonal advection term of divergence/vorticity tends
              41                     !
              42                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              43                     !
              44                     ! ******************************************************************
              45                     !
              46                           use const, only : RTYPE
              47                     !
              48                           implicit  none
              49                     
              50                           integer   nxj,nx,lev,ncld
              51                           real      cp,radsq
              52                           real(kind=RTYPE) onocos,cor,sinl
              53                     
              54                     !
              55                           real(kind=RTYPE) diveng(nx,lev),vdmerd(nx,lev),vdzonl(nx,lev), &
              56                                     pdot(nx,lev+1),pten(nx,lev),dlpl(nx),dtpl(nx),       &
              57                                     rdiv(nx,lev),ut(nx,lev),vt(nx,lev),tt(nx,lev),       &
              58                                     qt(nx,lev*ncld),phi(nx,lev),pt(nx),sgeo(nx),         &
              59                                     deldm(nx),spal(nx,lev),sd(nx,lev),sdpbl(nx),         &
              60                                     dsigma(lev,2),sigma(lev+1,2),pk(nx,lev),pk2(nx,lev), &
              61                                     cg(nx,lev),vvel(nx,lev)
              62                     !
              63                           logical   flag(nx)
              64                     !
              65                           integer   k,i,kbgn,kk,kkp1
              66                           real      px,px_pbl
              67                     
              68                     
              69                     !CWB2014 fixed undefined value problem in diabat line 665

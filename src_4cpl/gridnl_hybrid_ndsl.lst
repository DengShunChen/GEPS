             100         p   2v            pdot(:,    1) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd, deldm, pdot
                                   <<< Loop-information  End >>>
             101     1  pp                 do 3 k=2,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdot, sd, deldm
                                   <<< Loop-information  End >>>
             102     2   p   2v            do 3 i=1,nxj
             103     2   p   2v              kk=lev-k+2
             104     2   p   2v              sd(i,k)= sd(i,k)-sigma(k,1)*deldm(i)
             105     2               !        sd(i,k)= sd(i,k)-sig(k)*deldm(i)
             106     2   p   2v              pdot(i,kk)=sd(i,k)
             107     1   p   2v          3 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      deldm, cg, pdot, vvel
                                   <<< Loop-information  End >>>
             108     1  pp                 do k=1,lev
             109     1   p                   kk  =lev-k+1
             110     1   p                   kkp1=lev-k+2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdot, deldm, cg, vvel
                                   <<< Loop-information  End >>>
             111     2   p    v              do i=1,nxj
             112     2   p    v                vvel(i,k)=0.5*((sigma(k,1)+sigma(k+1,1))*(cg(i,k)+deldm(i))  &
             113     2                                 + (pdot(i,kk)+pdot(i,kkp1)))
             114     2   p    v              enddo
             115     1   p                 enddo
             116                     !
             117                     !  obtain vertical velocity within low layers
             118                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.40, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sdpbl, flag, sd
                                   <<< Loop-information  End >>>
             119     1  pp   2v            do i = 1, nxj
             120     1   p   2v              flag(i) = .true.
             121     1   p   2v              sdpbl(i) = sd(i,lev-1)
             122     1   p   2v            enddo
             123                     !
             124                           px_pbl = 850.
             125                           kbgn = (lev*2)/3 - 1
                                   <<< Loop-information Start >>>

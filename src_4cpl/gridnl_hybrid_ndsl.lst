                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.10, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtpl, vt, ut, phi, sgeo, diveng, spal
                                   <<<      dlpl, vdzonl, vdmerd
                                   <<< Loop-information  End >>>
             141     2   p    v            do 13 i=1,nxj
             142     2   p    v              vdmerd(i,k)= -spal(i,k)*dtpl(i)/onocos-ut(i,k)*cor             &
             143     2                                    -(ut(i,k)*ut(i,k)+vt(i,k)*vt(i,k))*onocos*sinl
             144     2   p    v              vdzonl(i,k)= -spal(i,k)*dlpl(i)+vt(i,k)*cor
             145     2               
             146     2   p    v              diveng(i,k)= sgeo(i)+phi(i,k)
             147     1   p    v        13  continue
             148                           return
             149                           end


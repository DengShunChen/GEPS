                                   <<<      SCALABLE  : SPILL 0  FILL 5
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              87     1  pp    v            do 24 i=1,nxj
              88     1   p    v              cg(i,k) = ut(i,k)*dlpl(i)*onocos+vt(i,k)*dtpl(i)
              89     1   p    v              deldm(i)= deldm(i)-dsigma(k,1)*cg(i,k)                        &
              90     1                                -rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
              91     1               !!        deldm(i)= deldm(i)+pten(i,k)-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
              92     1               !        deldm(i)= deldm(i)-dsig(k)*(ut(i,k)*dlpl(i)*onocos
              93     1               !     *           +vt(i,k)*dtpl(i)+rdiv(i,k)*pt(i))
              94     1   p    v         24 continue
              95                     !
              96                     !  vertical velocity
              97                     !
                                   <<< Loop-information Start >>>

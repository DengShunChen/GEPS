             446     3  pp    v              do 410  i = 1, nrn
             447     3   p    v              pe = pa(i) * wa(i) / ( 0.622 + 0.378 * wa(i) )
             448     3   p    v              w = exp ( 1800.0 / ta(i) - 6.08108 )
             449     3   p    v              fk = s * ( pe + r * pa(i) ) * w
             450     3   p    v              taucon(i) = ( fk * wa(i) )* dp(i) * trg
             451     3   p    v        410   continue
             452     2                     else

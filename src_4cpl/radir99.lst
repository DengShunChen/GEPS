             473     4   p   4v            do 415 i = 1, nr
             474     4   p   4v            zttau(i,m) = 0.
             475     3   p   4v        415 continue
             476     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

             485     4   p    v            do 430 i = 1, nrn
             486     5   p    v            if ( zw(i,m) .lt. 1.0e-10 ) then
             487     5   p    v      	zw1(i,m) = 0.
             488     5   p    v      	zw2(i,m) = 0.
             489     5   p    v            else

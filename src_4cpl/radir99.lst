             477     3  pp    v            do 420 i = 1, nrn
             478     3   p    v      	ztau(i,1) = taugas(i,igt) + taucon(i)
             479     3   p    v      	ztau(i,2) = taugas(i,igt) + taucon(i) + tauwc(i) + tauic(i)
             480     3   p    v      	zw(i,1) = 0.
             481     3   p    v      	zw(i,2) = ( tauic(i)*wic(i) + tauwc(i)*wwc(i) ) / ztau(i,2)
             482     3   p    v        420 continue
             483     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2

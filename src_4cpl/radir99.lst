 External subroutine subprogram "radir99"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine radir99( nr,nx,lev,fluxcl,ee,pu                      &
               2                                            ,pa,ta,tg,wa,oa,umco2,umch4,umn2o,cld,clwc     &
               3                                            ,cre,ciwc,cde,cufrac,fuir,fdir,fuirr,fdirr )
               4                     !
               5                     !#####################################################################
               6                     !
               7                     !  (1)compute infrared radiation fluxes at each model level using
               8                     !  correlated k-distribution method to resolve gas absorption
               9                     !  coefficients (Fu and Liou, 1992) and delta two and four-stream
              10                     !  approximation to compute fluxes (Fu et al., 1998; Fong, 1998).
              11                     !
              12                     !  (2)the delta two and four-stream approximation includes the
              13                     !  partial cloud treatment consistent with that used in the solar
              14                     !  radiation model.
              15                     !
              16                     !  ++ input/output variables :
              17                     !     (1) input :
              18                     !      nr    : number of grid points to calculate ir flux ( <= nx )
              19                     !      nx    : horizontal dimension of input array
              20                     !      lev   : number of vertical layers
              21                     !      fluxcl : logical const. to perform cloud forcing calculation
              22                     !      ee(nx,ibir) : ir surface emissivity at each band
              23                     !      pu(nx*(lev+1)) : presure at level levels
              24                     !      pa(nx*lev)     : presure at odd levels ( prediction levels )
              25                     !      ta(nx*lev)     : temperature at odd levels
              26                     !      tg(nx)         : surface ground temperature ( k )
              27                     !      wa(nx*lev)     : moisture (mixing ratio) specific humility ( kg/kg )
              28                     !      oa(nx*lev)     : ozone mixing ratio from climatology ( kg/kg )
              29                     !      umco2 : constant concentration of co2 ( ppmv )
              30                     !      umch4 : constant concentration of ch4 ( ppmv )
              31                     !      umn2o : constant concentration of n2o ( ppmv )
              32                     !      cld(nx*lev)    : cloud fraction at each layer
              33                     !      clwc(nx*lev)   : liquid water content at each layer ( g/m3 )
              34                     !      cre(nx*lev)    : effective size of water clouds ( um )
              35                     !      ciwc(nx*lev)   : ice water content at each layer ( g/m3 )
              36                     !      cde(nx*lev)    : effective size of ice clouds ( um )
              37                     !      cufrac(nx) : cumulus-related cloud fraction for chooseing
              38                     !                    cloud overlapping approximation
              39                     !
              40                     !     (2) output : (nx*(lev+1))
              41                     !      fuir   : all-sky ir upward flux at each level ( w/m2 )
              42                     !      fdir   : all-sky ir downward flux at each level ( w/m2 )
              43                     !      fuirr  : clear-sky ir upward flux at each level ( w/m2 )
              44                     !      fdirr  : clear-sky ir downward flux at each level ( w/m2 )
              45                     !
              46                     !#########################################################################
              47                     !
              48                     !  ibir : total band number in ir region
              49                     !  igir : total k-interval (g-value) number in ir region
              50                     !
              51                           implicit none
              52                           integer, parameter :: ibir = 12, igir = 67
              53                     
              54                           integer  nr,nx,lev
              55                           logical  fluxcl
              56                           real     ee(nx,ibir),pu(nx*(lev+1)),pa(nx*lev),ta(nx*lev),     &
              57                                    tg(nx),wa(nx*lev),oa(nx*lev),cld(nx*lev),clwc(nx*lev),&
              58                                    cre(nx*lev),ciwc(nx*lev),cde(nx*lev),                 &
              59                                    cufrac(nx),fuir(nx*(lev+1)),fdir(nx*(lev+1)),         &
              60                                    fuirr(nx*(lev+1)),fdirr(nx*(lev+1))
              61                     !
              62                     !  common block, data comes from "rkdisir.f"
              63                     !
              64                           real     hk1(2), c1h2o(3,19,2)
              65                           real     hk2(3), c2h2o(3,19,3)
              66                           real     hk3(4), c3h2o(3,19,4)
              67                           real     hk4(4),c4h2o(3,19,4),c4ch4(3,19),c4n2o(3,19)
              68                           real     hk5(3),c5h2o(3,19,3),c5ch4(3,19),c5n2o(3,19)
              69                           real     hk6(5),c6o3(3,19,5),c6h2o(3,19)
              70                           real     hk7(2), c7h2o(3,19,2)
              71                           real     hk8(10), c8hca(3,19,10), c8hcb(3,19,10)
              72                           real     hk9(12), c9hca(3,19,12), c9hcb(3,19,12)
              73                           real     hk10(7), c10h2o(3,19,7)
              74                           real     hk11(7), c11h2o(3,19,7)
              75                           real     hk12(8), c12h2o(3,19,8)
              76                     
              77                           common /ir1/ hk1, c1h2o
              78                           common /ir2/ hk2, c2h2o
              79                           common /ir3/ hk3, c3h2o
              80                           common /ir4/ hk4,c4h2o,c4ch4,c4n2o
              81                           common /ir5/ hk5,c5h2o,c5ch4,c5n2o
              82                           common /ir6/ hk6,c6o3,c6h2o
              83                           common /ir7/ hk7, c7h2o
              84                           common /ir8/ hk8, c8hca, c8hcb
              85                           common /ir9/ hk9, c9hca, c9hcb
              86                           common /ir10/ hk10, c10h2o
              87                           common /ir11/ hk11, c11h2o
              88                           common /ir12/ hk12, c12h2o
              89                     !
              90                     !  local working arrays
              91                     !
              92                           logical ozon
              93                           real    hk(igir),vv(12),pc(5,12)
              94                           integer igb(12)
              95                           real    dp(nx*lev),tu(nx*(lev+2))
              96                           real    zw1(nx*lev,2),zw2(nx*lev,2),                      &
              97                                   zw(nx*lev,2),ztau(nx*lev,2),zttau(nx*(lev+1),2),  &
              98                                   zbf(nx*(lev+2)),zffu(nx*(lev+1)),zffd(nx*(lev+1))
              99                           real    taugas(nx*lev,igir),tauic(nx*lev),tauwc(nx*lev),  &
             100                                   taucon(nx*lev)
             101                           real    wic1(nx*lev),wic2(nx*lev),wwc1(nx*lev),wwc2(nx*lev),&
             102                                   wic(nx*lev),wwc(nx*lev)
             103                           real    fkg(nx*lev,igir),fuq(nx),wk1(nx*lev),wk2(nx*(lev+2),3),&
             104                                   dz(nx*lev)
             105                           real    cldb(nx*lev,4)
             106                     
             107                           integer nrn,nrn1,i,j,jk,jj,jje,m,igt,ig,ib
             108                           real    pi,vmin,umn2o,umch4,umco2,h1269,h476,cld_maxran,dzmax_km,dlogpa
             109                           real    dlogp,x1,x2,rch4,rn2o,rco2,x,y,z,r,trg,s,pe,w,fk,tics,twcs,ttts
             110                     
             111                     !
             112                     !  igb : the max. number of g-values contained in the band 1-12
             113                     !
             114                           data igb /2,3,4,4,3,5,2,10,12,7,7,8/
             115                     !
             116                     ! "taucon" are the optical depthes due to water vapor continuum absorp-
             117                     ! tion in lev layers for a given band ib. We include continuum absorp-
             118                     ! tion in the 280 to 1250 cm**-1 region. vv(11)-vv(17) are the central
             119                     ! wavenumbers of each band in this region.
             120                     !
             121                           data vv / 4*0.0,1175.0,1040.0,890.0,735.0,605.0,470.0,340.0,0.0 /
             122                     !
             123                     !  coefficients for computing the blackbody intensity function
             124                     !
             125                            data pc /                                                        &
             126                            9.598466e-9, -7.287285e-6, 2.090916e-3,-2.677473e-1, 1.286976e+1,&
             127                            7.211260e-9, -4.792760e-6, 1.202248e-3,-1.344489e-1, 5.639765e+0,&
             128                            7.572943e-9, -2.626821e-6, 2.216726e-5, 7.445105e-2,-6.670347e+0,&
             129                            4.730481e-11, 2.706418e-6,-1.351777e-3, 2.282604e-1,-1.300338e+1,&
             130                           -3.297827e-9,  5.815023e-6,-2.261827e-3, 3.382716e-1,-1.779915e+1,&
             131                           -4.643682e-9,  6.200410e-6,-2.132982e-3, 2.915934e-1,-1.426057e+1,&
             132                           -7.868328e-9,  9.028216e-6,-2.644667e-3, 3.072150e-1,-1.274817e+1,&
             133                           -4.047419e-9,  3.969190e-6,-7.282698e-4, 2.771434e-2, 1.444413e+0,&
             134                           -1.476049e-9,  9.066730e-7, 4.060300e-4,-1.256673e-1, 8.467850e+0,&
             135                            5.730060e-10,-1.242197e-6, 1.034899e-3,-1.776529e-1, 9.197895e+0,&
             136                            8.067974e-10,-1.134579e-6, 6.529138e-4,-8.009666e-2, 2.954545e+0,&
             137                            3.569705e-10,-4.619423e-7, 2.387227e-4,-1.647910e-3,-7.843924e-1/
             138                     !
             139                     !  476.16 = 2.24e4 / M * 10.0 / 9.8, where M = 48 for o3
             140                     !  1269.841 = 2.24e4 / M * 10.0 / 9.8, where M = 18 for h2o
             141                     !
             142                           data h476/476.16/, h1269/1269.841/
             143                     !
             144                     !  if "cufrac(i)" .gt. "cld_maxran", assume maximum-random cloud overlapping
             145                     !  if "cufrac(i)" .le. "cld_maxran", assume random cloud overlapping
             146                     !  so, set cld_maxran equal to less than 0. if assume the maximum-random cloud
             147                     !  overlapping approximation always
             148                     !
             149                           data cld_maxran / 0. /
             150                     !
             151                           nrn  = nr*lev
             152                           nrn1 = nr*(lev+1)
             153                           pi = 4.*atan(1.)
             154                           vmin = 1.0e-8
             155                     !
             156                     !
             157                     !  obtain the temperature (tu) at even levels
             158                     !
             159                     !  lev+1 : the surface skin temperature
             160                     !  lev+2 : the ground temperature
             161                     !  dp : layer thickness in pressure (hPa)
             162                     !  dz : layer thickness (km)
             163                     !
             164                     !  assume the temperature at the top even level equal to that at
             165                     !  the top odd level
             166                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, tu
                                   <<< Loop-information  End >>>
             167     1  pp   4v            do 20 i = 1, nr
             168     1   p   4v            tu(i) = ta(i)
             169     1   p   4v         20 continue
             170                     !
             171                     ! note : dz in ir radiation uses unit of km instead of m in solar
             172                     !
             173                           dzmax_km = 1.   ! avoid too thick cloud depth
             174                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pu, ta, dp, dz
                                   <<< Loop-information  End >>>
             175     1                     do 25 j = 1, lev
             176     1                     jk = j*nr
             177     1                     jj = jk-nr
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.17, ITR: 72, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, ta, dz, pu
                                   <<< Loop-information  End >>>
             178     2  pp    v            do 25 i = 1, nr
             179     2   p    v            dp(i+jj) = pu(i+jk) - pu(i+jj)
             180     2   p    v            dz(i+jj) = 0.0292674 * ta(i+jj) * log( pu(i+jk) / pu(i+jj) )
             181     2               !
             182     2   p    v            dz(i+jj) = min( dzmax_km, dz(i+jj) )
             183     2               !
             184     1   p    v         25 continue
             185                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, pa, pu, tu
                                   <<< Loop-information  End >>>
             186     1  pp    v            do 30 i = 1, nr*(lev-1)
             187     1   p    v            dlogpa = log ( pa(i+nr) ) - log ( pa(i) )
             188     1   p    v            dlogp  = log ( pu(i+nr) ) - log ( pa(i) )
             189     1   p    v            tu(i+nr) = ta(i) + ( ta(i+nr) - ta(i) ) * dlogp / dlogpa
             190     1   p    v         30 continue
             191                     !
             192                     !  assume the lowest model layer is well mixed (i.e. theta = const. )
             193                     !
             194                           jje = (lev-1)*nr
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.77, ITR: 40, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, tg, tu, pu, pa
                                   <<< Loop-information  End >>>
             195     1  pp    v            do 35 i = 1, nr
             196     1   p    v            x1 = log ( pa(i+jje) )
             197     1   p    v            x2 = log ( pu(i+nrn) )
             198     1   p    v            tu(i+nrn)  = ta(i+jje) * exp ( 0.286*(x2-x1) )
             199     1   p    v            tu(i+nrn) = (2.0*tg(i)+tu(i+nrn))/3.0
             200     1   p    v            tu(i+nrn1) = tg(i)
             201     1   p    v         35 continue
             202                     !
             203                     !  compute cloud optical properties
             204                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<< Loop-information  End >>>
             205     1  pp                 do 60 m = 1, 4
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldb
                                   <<< Loop-information  End >>>
             206     2   p   4v            do 60 i = 1, nrn
             207     2   p   4v            cldb(i,m) = 1.0
             208     1   p   4v         60 continue
             209                     !
             210                     !  compute cloud overlapping variables assuming mixed maximum
             211                     !  and random overlap based on the method proposed by Geleyn and
             212                     !  Hollingsworth (1979, contrib. atmos. phys.)
             213                     !
             214                           jj = nrn - nr
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldb, cld
                                   <<< Loop-information  End >>>
             215     1  pp    v            do 68 i = 1, nr
             216     1   p    v            cldb(i,1) = 1.0 - cld(i)
             217     1   p    v            cldb(i,3) = cld(i)
             218     1   p    v            cldb(i+jj,2) = 1.0 - cld(i+jj)
             219     1   p    v            cldb(i+jj,4) = cld(i+jj)
             220     1   p    v         68 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cufrac, cld, cldb
                                   <<< Loop-information  End >>>
             221     1                     do 69 j = 1, lev-1
             222     1                     jk = j*nr
             223     1                     jj = jk-nr
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 118
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cufrac, cld, cldb
                                   <<< Loop-information  End >>>
             224     2  pp    v            do 69 i = 1, nr
             225     3   p    v            if ( cufrac(i) .ge. cld_maxran ) then
             226     3   p    v            cldb(i+jk,1) = max( vmin, 1.0-max( cld(i+jk),cld(i+jj) ) ) /  &
             227     3                                    max( vmin, 1.0-cld(i+jj) )
             228     3   p    v            cldb(i+jk,3) = max( vmin, min( cld(i+jk),cld(i+jj) ) ) /      &
             229     3                                    max( vmin, cld(i+jj) )
             230     3   p    v            cldb(i+jj,2) = max( vmin, 1.0-max( cld(i+jj),cld(i+jk) ) ) /  &

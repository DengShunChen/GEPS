 External subroutine subprogram "hdiffu"
  (inc)(line-no.)(nest)(optimize)
             157                     !
             158                           subroutine hdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             159                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
             160                                             , trefs)
             161                           use index
             162                           use mpe
             163                           use rank
             164                           use const, only : hdk1,hdk2,radsq,doskeb,onocos,wcfac,wdfac      &
             165                                           , poly,dpoly,hord,vd,RTYPE
             166                           use param, only : octahedral
             167                     
             168                           implicit  none
             169                     
             170                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             171                           real      rad
             172                     
             173                           real(kind=RTYPE) dta
             174                           real(kind=RTYPE) vordiss(levp,2,jtrun,jtmax),divdiss(levp,2,jtrun,jtmax)
             175                     
             176                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             177                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             178                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),eps4(jtrun,jtmax),&
             179                                            cosl(my)
             180                     !
             181                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             182                     !
             183                           real      wmax(lev)
             184                           real      windmax1,windmax2,windmax3
             185                     
             186                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             187                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             188                           real      hfilt,hfilt2,nf,dec,coefu,factop,powd,kfac
             189                           real      c1,c2,c3
             190                           logical   windchk
             191                     
             192                           data      windmax1/80./, windmax2/100./, windmax3/130./
             193                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             194                     !
             195                     
             196                     !
             197                           nf=jtrun-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             198        pp   4v            wmax(1:lev)= 0.0
             199                     !
             200     1                     do jj =1,jlistnum
             201     1                       j=jlist1(jj)
             202     1                       nxj=nxdef_2d(j)
             203     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             204     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             205     3   p   2v                do i=1,nxj
             206     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             207     3   p   2v                enddo
             208     2   p                   enddo
             209     1                     enddo
             210                     !
             211                           call mpe_global_max(wmax,lev,mpe_double)
             212                     !
             213                     !!      do k=1,lev
             214                     !!        if( wmax(k) .gt. windmax3 ) then
             215                     !!          if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
             216                     !!                                 ' windmax=',wmax(k)
             217                     !!        endif
             218                     !!      enddo
             219                     !
             220                     !
             221                           powd = float(hord) / 2.
             222                           hfilt  = (radsq/(nf*(nf+1)))**powd
             223                           hfilt2 = radsq/(nf*(nf+1))
             224                           factop = 60.
             225                           coefu = factop/float(hdk2(1)-hdk1)
             226     1                     if ( octahedral ) then
             227     1                       hfilt  = hfilt/(6.*dta)
             228     1                       hfilt2 = hfilt2/(6.*dta)
             229     1                     else
             230     1                       hfilt  = hfilt/dta
             231     1                       hfilt2 = hfilt2/dta
             232     1                     endif
             233                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             234     1  pp                 do 100 k=1,levp  ! levp -> lev
             235     1               !
             236     1               !  compute diffusion coefficients
             237     1               !
             238     1   p                   KL=Llist(k)
             239     1               !
             240     1   p                   kfac = min(coefu*max(float(hdk2(1)-KL),0.),factop)!  &
             241     1               !             + min(1.*max(float(hdk2(3)-KL),0.),4.)
             242     1               !        if ( KL .le. hdk1 ) kfac = kfac*(1.+vd*exp(-0.5*KL))
             243     1   p                   kfac = kfac*(1.+vd*exp(-0.5*max(float(KL-hdk1),0.)))
             244     1   p                   facd = max(1.,kfac)*amp
             245     1   p                   facv = max(1.,kfac)*amp
             246     1   p                   fact = max(1.,kfac)*amp
             247     1               !!        facd = 1. * amp * (kfac + 2.*max(float(hdk1-KL),0.))
             248     1               !!        facv = 1. * (kfac + 1.*max(float(hdk1-KL),0.))
             249     1               !!        fact = 1. * (kfac + 1.*max(float(hdk1-KL),0.))
             250     1               !
             251     1               
             252     1               
             253     1               !
             254     1               !  difuse vorticity, divergence and temperature fields
             255     1               !
             256     2   p                   do m=1,mlistnum
             257     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             258     3   p    v                do n=mf,jtrun
             259     3               
             260     3               !            if ( KL .le. hdk1 ) then
             261     3               !              c1=1.+dta*facv*hfilt*eps4(n,m)**powd+vd*exp(-0.7*k)
             262     3               !              c2=1.+dta*facd*hfilt*eps4(n,m)**powd+vd*exp(-0.7*k)
             263     3               !              c3=1.+dta*fact*hfilt*eps4(n,m)**powd+vd*exp(-0.7*k)
             264     3               !            else
             265     3   p    v                    c1=1.+dta*facv*hfilt*eps4(n,m)**powd
             266     3   p    v                    c2=1.+dta*facd*hfilt*eps4(n,m)**powd
             267     3   p    v                    c3=1.+dta*fact*hfilt*eps4(n,m)**powd
             268     3               !            endif
             269     3               
             270     3               !  if doskeb = .true. estimate the dissipation of kinectic energy for SKEB
             271     3   p    v                  vordiss(k,1,n,m)=(1.-1./c1)*vornow(k,1,n,m)
             272     3   p    v                  vordiss(k,2,n,m)=(1.-1./c1)*vornow(k,2,n,m)
             273     3   p    v                  divdiss(k,1,n,m)=(1.-1./c2)*divnow(k,1,n,m)
             274     3   p    v                  divdiss(k,2,n,m)=(1.-1./c2)*divnow(k,2,n,m)
             275     3               !
             276     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             277     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             278     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             279     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             280     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             281     3   p    v                  temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             282     3               !            temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             283     3               !            temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             284     3   p    v                enddo
             285     2   p                   enddo
             286     1   p            100  continue
             287                     !
             288                     !       estimate the dissipation of kinetic energy
             289     1                     if ( doskeb ) then
             290     1                        ! transfer the dissipation to grid point from spectrum
             291     1                        call tranuv (jtrun,jtmax,nx,my,my_max,levp,onocos,wcfac,wdfac &
             292     1                                   , poly,dpoly,vordiss,divdiss,ut,vt,nsizey)
             293     1                     endif
             294                     
             295                     !
             296                     !-------------------------------------------------------------------
             297                     !
             298                     !  filter layers near the upper bound if too strong wind speed
             299                     !  happens at the top layer
             300                     !
             301                     !  2003/10/7 :
             302                     !  sometimes wind speed greater than 100m/s happens at k=2
             303                     !
             304                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             305     1  pp    v            do k=1,hdk1
             306     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             307     1   p    v            enddo
             308     1                     if ( windchk ) then
             309     1                      call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             310     1                     end if
             311                     !--------------------------------------------------------------------
             312                           return
             313                           end


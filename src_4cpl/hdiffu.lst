 External subroutine subprogram "filter_top"
  (inc)(line-no.)(nest)(optimize)
             599                     !
             600                     !--------------------------------------------------------------------
             601                           subroutine filter_top(jtrun,jtmax,lev,ktop,ncld,temnow     &
             602                                            ,vornow,divnow)
             603                     !
             604                     !  apply Lanczos filter to top "ktop" layers
             605                     !
             606                           use index
             607                           use mpe
             608                           use const, only: RTYPE
             609                     !
             610                           implicit  none
             611                     
             612                           integer   ktop,ktopm1
             613                     !      parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             614                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             615                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             616                     !
             617                           integer   jtrun,jtmax,lev,ncld
             618                     
             619                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax),  &
             620                                            vornow(lev,2,jtrun,jtmax),  &
             621                                            divnow(lev,2,jtrun,jtmax)
             622                     !
             623                           real      wvn_top(ktop+1),djt
             624                     
             625                           integer   k,mode,m,mf,n,nflt,IERR,KL
             626                           real      pi,flt,fac
             627                     !
             628                     
             629                     !2dMPI >
             630                     !     if(ktop.gt.levp)then
             631                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             632                     !        call MPI_FINALIZE(IERR)
             633                     !        stop
             634                     !     endif
             635                     !2dMPI <
             636                     
             637                     !      wvn_top(1) = jtrun*2./3.
             638                           wvn_top(1) = max(min(jtrun/3.,155.),55.)
             639                           wvn_top(ktop+1) = jtrun
             640                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             641                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.78, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wvn_top
                                   <<< Loop-information  End >>>
             642     1  pp    v            do k = 2, ktop
             643     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.5*(k-1))
             644     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             645     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             646     1   p    v            enddo
             647                     !
             648                           pi = 3.141596
             649                     !
             650                     !  mode = 0 : just truncate into assigned wavenumbers without
             651                     !             extra filtering
             652                     !  mode = 1 or other : add fitering along with truncating
             653                     !
             654                           mode = 1
             655                     !
             656     1                     if( mode .eq. 0 ) then
             657     2                       do k = 1, lev
             658     2               !2dMPI >
             659     2                       KL=Llist(k)
             660     3                       if( KL .le. ktop ) then
             661     3               !2dMPI <
             662     4                         do m = 1, mlistnum
             663     4                           mf=max(2,mlist(m))
             664     5                           do n = mf, jtrun
             665     5                             nflt = int ( wvn_top(k) / float(n) )
             666     5                             flt = min( 1.0, float(nflt) )
             667     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             668     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             669     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             670     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             671     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             672     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             673     5                           enddo
             674     4                         enddo
             675     3               !          do m = 1, mlistnum
             676     3               !            mf=max(2,mlist(m))
             677     3               !            do n = mf, jtrun
             678     3               !              nflt = int ( wvn_top(k) / float(n) )
             679     3               !              flt = min( 1.0, float(nflt) )
             680     3               !              do nc=1,ncld
             681     3               !                kk=(nc-1)*lev+k
             682     3               !                qnow(kk,1,n,m)  = qnow(kk,1,n,m)*flt
             683     3               !                qnow(kk,2,n,m)  = qnow(kk,2,n,m)*flt
             684     3               !              enddo
             685     3               !            enddo
             686     3               !          enddo
             687     3               !2dMPI >
             688     3                       endif
             689     2               !2dMPI <
             690     2                       enddo
             691     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             692     2  pp                   do k = 1, lev
             693     2               !2dMPI >
             694     2   p                   KL=Llist(k)
             695     3   p                   if( KL .le. ktop ) then
             696     3               !2dMPI <
             697     4   p                     do m = 1, mlistnum
             698     4   p                       mf=max(2,mlist(m))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 48, MVE: 3, POL: S)
                                   <<< Loop-information  End >>>
             699     5   p    v                  do n = mf, jtrun
             700     5   p    v                    fac = min(wvn_top(k),float(n-1)) * pi / wvn_top(k)
             701     5   p    v                    flt = sin(fac)/fac

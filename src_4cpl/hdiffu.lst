 External subroutine subprogram "ohdiffu"
  (inc)(line-no.)(nest)(optimize)
             314                     !
             315                     !--------------------------------------------------------------------
             316                           subroutine ohdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             317                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
             318                                             , trefs)
             319                     !     horizontal diffusion for Cubic Truncation Octahedral Reduced
             320                     !     Gaussain grid (under testing for now) -- 03/03/2020 Pang-Yang Liu
             321                           use index
             322                           use mpe
             323                           use rank
             324                           use const, only : hdk1,hdk2,radsq,RTYPE
             325                           use param, only : octahedral
             326                     
             327                           implicit  none
             328                     
             329                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             330                           real      rad
             331                     
             332                           real(kind=RTYPE) dta
             333                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             334                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             335                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             336                                            eps4(jtrun,jtmax),cosl(my)
             337                     !
             338                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             339                     !
             340                           real      wmax(lev)
             341                           real      windmax1,windmax2,windmax3
             342                     
             343                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             344                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             345                           real      hfilt,hfilt2,nf,ncut,ncor,kfac
             346                           real      c1,c2,c3
             347                           logical   windchk
             348                     
             349                           data      windmax1/80./, windmax2/100./, windmax3/130./
             350                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             351                     !
             352                     
             353                     !
             354                           nf=jtrun-1
             355                           ncut=0.5*jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             356        pp   4v            wmax(1:lev)= 0.0
             357                     !
             358     1                     do jj =1,jlistnum
             359     1                       j=jlist1(jj)
             360     1                       nxj=nxdef_2d(j)
             361     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             362     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             363     3   p   2v                do i=1,nxj
             364     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             365     3   p   2v                enddo
             366     2   p                   enddo
             367     1                     enddo
             368                     !
             369                           call mpe_global_max(wmax,lev,mpe_double)
             370                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3200
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             371     1  pp    s            do k=1,lev
             372     2   p    s              if( wmax(k) .gt. windmax3 ) then
             373     2   p    v                if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
             374     2                                                ' windmax=',wmax(k)
             375     2   p    s              endif
             376     1   p    s            enddo
             377                     !
             378                     !
             379                           hfilt = (radsq/(nf*(nf+1)))**2.
             380                           hfilt = hfilt/(6.*dta)
             381                           hfilt2 = radsq/(nf*(nf+1))
             382                           hfilt2 = hfilt2/(6.*dta)
             383                     
             384                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             385     1  pp                 do 100 k=1,levp  ! levp -> lev
             386     1               !
             387     1               !  compute diffusion coefficients
             388     1               !
             389     1               
             390     1   p                    KL=Llist(k)
             391     1               !
             392     1   p                    kfac  = min(5.*max(float(hdk2(1)-KL),0.),60.)
             393     1   p                    facd = amp + kfac
             394     1   p                    facv = amp + kfac
             395     1   p                    fact = amp + kfac
             396     1               !         facd= 1.0 + max(float(hdk2(1)-KL),0.)
             397     1               !         facv= 1.0 + max(float(hdk2(1)-KL),0.)
             398     1               !         fact= 1.0 + max(float(hdk2(1)-KL),0.)
             399     1               
             400     1               !         if ( KL .le. hdk1 ) facd=facd*(1.+float(hdk1-KL))
             401     1               !
             402     1               !          facd = amp * facd
             403     1               !          facv = amp * facv
             404     1               !          fact = amp * fact
             405     1               !
             406     1               
             407     1               !
             408     1               !  difuse vorticity and divergence fields
             409     1               !  diffuse moisture and temperature fields
             410     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             411     2   p                   do m=1,mlistnum
             412     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 9
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             413     3   p    v                do n=mf,jtrun
             414     3   p    v                  ncor=1.
             415     4   p    v                  if ( n .gt. ncut ) then
             416     4   p    v                    ncor=exp(-0.5*( (n-jtrun)**2. / (n-ncut)**2. ))
             417     4   p    v                  else
             418     4   p    v                    ncor=0.
             419     4   p    v                  endif
             420     3   p    v                  c3=1.+dta*fact*hfilt*ncor*eps4(n,m)**2
             421     3               
             422     3   p    v                  ncor=min(ncor+0.2*max(float(hdk2(1)-KL),0.),1.)
             423     3   p    v                  c1=1.+dta*facv*hfilt*ncor*eps4(n,m)**2
             424     4   p    v                  if ( KL .le. hdk1 ) then
             425     4               !              c2=1.+dta*facd*hfilt2*ncor*eps4(n,m)
             426     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)
             427     4   p    v                  else
             428     4   p    v                    c2=1.+dta*facd*hfilt*ncor*eps4(n,m)**2
             429     4   p    v                  endif
             430     3               
             431     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             432     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             433     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             434     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             435     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             436     3   p    v                  temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             437     3               !            temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             438     3               !            temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             439     3   p    v                enddo
             440     2   p                   enddo
             441     1   p            100  continue
             442                     !
             443                     !-------------------------------------------------------------------
             444                     !
             445                     !  filter layers near the upper bound if too strong wind speed
             446                     !  happens at the top layer
             447                     !
             448                     !  2003/10/7 :
             449                     !  sometimes wind speed greater than 100m/s happens at k=2
             450                     !
             451                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             452     1  pp    v            do k=1,hdk1
             453     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             454     1   p    v            enddo
             455                     !
             456     1                     if ( windchk ) then
             457     1                      call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             458     1                     end if
             459                     !--------------------------------------------------------------------
             460                           return
             461                           end


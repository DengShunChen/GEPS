              58     1   p    v            enddo
              59                     !
              60                     !
              61                             hfilt = (radsq/(nf*(nf+1)))**2.
              62                             hfilt2 = radsq/(nf*(nf+1))
              63     1                     if ( octahedral ) then
              64     1                       hfilt = hfilt/(6.*dta)
              65     1                       hfilt2 = hfilt2/(6.*dta)
              66     1                     else
              67     1                       hfilt = 16.*hfilt/dta
              68     1                       hfilt2 =16.*hfilt2/dta

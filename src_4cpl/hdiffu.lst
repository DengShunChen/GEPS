             805                     !
             806                     !--------------------------------------------------------------------
             807                           subroutine filter_top_3tl(jtrun,jtmax,lev,ncld,temnow     &
             808                                            ,vornow,divnow)
             809                     !
             810                     !  apply Lanczos filter to top "ktop" layers
             811                     !
             812                           use index
             813                           use mpe
             814                           use const, only : RTYPE
             815                     !
             816                           implicit  none
             817                     
             818                           integer   ktop,ktopm1
             819                           parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             820                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             821                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             822                     !
             823                           integer   jtrun,jtmax,lev,ncld
             824                     
             825                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax), &
             826                                            vornow(lev,2,jtrun,jtmax), &
             827                                            divnow(lev,2,jtrun,jtmax)
             828                     !
             829                           real      wvn_top(ktop+1),djt
             830                     
             831                           integer   k,mode,m,mf,n,nflt,IERR,KL
             832                           real      pi,flt,fac
             833                     !
             834                     
             835                     !2dMPI >
             836                     !     if(ktop.gt.levp)then
             837                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             838                     !        call MPI_FINALIZE(IERR)
             839                     !        stop
             840                     !     endif
             841                     !2dMPI <
             842                     
             843                     !      wvn_top(1) = jtrun*1./3.
             844                           wvn_top(1) = 155
             845                           wvn_top(ktop+1) = jtrun
             846                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             847                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             848     1   s    v            do k = 2, ktop
             849     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.7*(k-1))
             850     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             851     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             852     1   p    v            enddo
             853                     !
             854                           pi = 3.141596
             855                     !
             856                     !  mode = 0 : just truncate into assigned wavenumbers without
             857                     !             extra filtering
             858                     !  mode = 1 or other : add fitering along with truncating
             859                     !
             860                           mode = 1
             861                     !
             862     1                     if( mode .eq. 0 ) then
             863     2                       do k = 1, lev
             864     2               !2dMPI >
             865     2                       KL=Llist(k)
             866     3                       if( KL .le. ktop ) then
             867     3               !2dMPI <
             868     4                         do m = 1, mlistnum
             869     4                           mf=max(2,mlist(m))
             870     5                           do n = mf, jtrun
             871     5                             nflt = int ( wvn_top(k) / float(n) )
             872     5                             flt = min( 1.0, float(nflt) )
             873     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             874     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             875     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             876     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             877     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             878     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             879     5                           enddo
             880     4                         enddo
             881     3               !          do m = 1, mlistnum
             882     3               !            mf=max(2,mlist(m))
             883     3               !            do n = mf, jtrun
             884     3               !              nflt = int ( wvn_top(k) / float(n) )
             885     3               !              flt = min( 1.0, float(nflt) )
             886     3               !              do nc=1,ncld

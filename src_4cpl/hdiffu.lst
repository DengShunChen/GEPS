             730                     
             731                     !
             732                     !--------------------------------------------------------------------
             733                           subroutine filter_skeb(jtrun,jtmax,lev,dissest,wvn_top)
             734                     !
             735                     !  apply Lanczos filter to estimation of kinetic energy dissipation.
             736                     !
             737                           use index
             738                           use mpe
             739                           use const, only : RTYPE
             740                     !
             741                           implicit  none
             742                     
             743                     !
             744                           integer   jtrun,jtmax,lev,ncld
             745                     
             746                           real(kind=RTYPE) dissest(lev,2,jtrun,jtmax)
             747                     !
             748                           real      wvn_top
             749                     
             750                           integer   k,mode,m,mf,n,nflt,IERR,KL
             751                           real      pi,flt,fac
             752                     !
             753                     
             754                     !2dMPI >
             755                     !     if(ktop.gt.levp)then
             756                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             757                     !        call MPI_FINALIZE(IERR)
             758                     !        stop
             759                     !     endif
             760                     !2dMPI <
             761                     
             762                     !
             763                           pi = 3.141596
             764                     !
             765                     !  mode = 0 : just truncate into assigned wavenumbers without
             766                     !             extra filtering
             767                     !  mode = 1 or other : add fitering along with truncating
             768                     !
             769                           mode = 1
             770                     !
             771     1                     if( mode .eq. 0 ) then
             772     2                       do k = 1, lev
             773     2               !2dMPI >
             774     2                       KL=Llist(k)
             775     3                         do m = 1, mlistnum
             776     3                           mf=max(2,mlist(m))
             777     4                           do n = mf, jtrun
             778     4                             nflt = int ( wvn_top / float(n) )
             779     4                             flt = min( 1.0, float(nflt) )
             780     4                             dissest(k,1,n,m)= dissest(k,1,n,m)*flt
             781     4                             dissest(k,2,n,m)= dissest(k,2,n,m)*flt
             782     4                           enddo
             783     3                         enddo
             784     2               !2dMPI <
             785     2                       enddo
             786     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             787     2  pp                   do k = 1, lev
             788     2               !2dMPI >
             789     2   p                   KL=Llist(k)
             790     3   p                     do m = 1, mlistnum
             791     3   p                       mf=max(2,mlist(m))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 48, MVE: 3, POL: S)
                                   <<< Loop-information  End >>>
             792     4   p    v                  do n = mf, jtrun
             793     4   p    v                    fac = min(wvn_top,float(n-1)) * pi / wvn_top
             794     4   p    v                    flt = sin(fac)/fac
             795     4   p    v                    dissest(k,1,n,m)= dissest(k,1,n,m)*flt
             796     4   p    v                    dissest(k,2,n,m)= dissest(k,2,n,m)*flt
             797     4   p    v                  enddo
             798     3   p                     enddo
             799     2               !2dMPI <
             800     2   p                   enddo
             801     1                     endif
             802                     !
             803                           return
             804                           end


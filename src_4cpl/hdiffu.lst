 External subroutine subprogram "filter_top"
  (inc)(line-no.)(nest)(optimize)
             585                     !
             586                     !--------------------------------------------------------------------
             587                           subroutine filter_top(jtrun,jtmax,lev,ktop,ncld,temnow     &
             588                                            ,vornow,divnow)
             589                     !
             590                     !  apply Lanczos filter to top "ktop" layers
             591                     !
             592                           use index
             593                           use mpe
             594                           use const, only: RTYPE
             595                     !
             596                           implicit  none
             597                     
             598                           integer   ktop,ktopm1
             599                     !      parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             600                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             601                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             602                     !
             603                           integer   jtrun,jtmax,lev,ncld
             604                     
             605                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax),  &
             606                                            vornow(lev,2,jtrun,jtmax),  &
             607                                            divnow(lev,2,jtrun,jtmax)
             608                     !
             609                           real      wvn_top(ktop+1),djt
             610                     
             611                           integer   k,mode,m,mf,n,nflt,IERR,KL
             612                           real      pi,flt,fac
             613                     !
             614                     
             615                     !2dMPI >
             616                     !     if(ktop.gt.levp)then
             617                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             618                     !        call MPI_FINALIZE(IERR)
             619                     !        stop
             620                     !     endif
             621                     !2dMPI <
             622                     
             623                     !      wvn_top(1) = jtrun*2./3.
             624                           wvn_top(1) = max(min(jtrun/3.,155.),55.)
             625                           wvn_top(ktop+1) = jtrun
             626                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             627                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.78, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wvn_top
                                   <<< Loop-information  End >>>
             628     1  pp    v            do k = 2, ktop
             629     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.5*(k-1))
             630     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             631     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             632     1   p    v            enddo
             633                     !
             634                           pi = 3.141596
             635                     !
             636                     !  mode = 0 : just truncate into assigned wavenumbers without
             637                     !             extra filtering
             638                     !  mode = 1 or other : add fitering along with truncating
             639                     !
             640                           mode = 1
             641                     !
             642     1                     if( mode .eq. 0 ) then
             643     2                       do k = 1, lev
             644     2               !2dMPI >
             645     2                       KL=Llist(k)
             646     3                       if( KL .le. ktop ) then
             647     3               !2dMPI <
             648     4                         do m = 1, mlistnum
             649     4                           mf=max(2,mlist(m))
             650     5                           do n = mf, jtrun
             651     5                             nflt = int ( wvn_top(k) / float(n) )
             652     5                             flt = min( 1.0, float(nflt) )
             653     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             654     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             655     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             656     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             657     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             658     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             659     5                           enddo
             660     4                         enddo
             661     3               !          do m = 1, mlistnum
             662     3               !            mf=max(2,mlist(m))
             663     3               !            do n = mf, jtrun
             664     3               !              nflt = int ( wvn_top(k) / float(n) )
             665     3               !              flt = min( 1.0, float(nflt) )
             666     3               !              do nc=1,ncld
             667     3               !                kk=(nc-1)*lev+k
             668     3               !                qnow(kk,1,n,m)  = qnow(kk,1,n,m)*flt
             669     3               !                qnow(kk,2,n,m)  = qnow(kk,2,n,m)*flt
             670     3               !              enddo
             671     3               !            enddo
             672     3               !          enddo
             673     3               !2dMPI >
             674     3                       endif
             675     2               !2dMPI <
             676     2                       enddo
             677     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             678     2  pp                   do k = 1, lev
             679     2               !2dMPI >
             680     2   p                   KL=Llist(k)
             681     3   p                   if( KL .le. ktop ) then
             682     3               !2dMPI <
             683     4   p                     do m = 1, mlistnum
             684     4   p                       mf=max(2,mlist(m))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             685     5   p    v                  do n = mf, jtrun
             686     5   p    v                    fac = min(wvn_top(k),float(n-1)) * pi / wvn_top(k)
             687     5   p    v                    flt = sin(fac)/fac
             688     5   p    v                    vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             689     5   p    v                    divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             690     5   p    v                    temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             691     5   p    v                    vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             692     5   p    v                    divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             693     5   p    v                    temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             694     5   p    v                  enddo
             695     4   p                     enddo
             696     3               !          do m = 1, mlistnum
             697     3               !            mf=max(2,mlist(m))
             698     3               !            do n = mf, jtrun
             699     3               !              fac = min(wvn_top(k),float(n-1)) * pi / wvn_top(k)
             700     3               !              flt = sin(fac)/fac
             701     3               !              do nc=1,ncld

             125     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             126     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             127     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             128     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             129     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3

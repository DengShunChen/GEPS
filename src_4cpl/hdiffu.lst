             791                     !
             792                     !--------------------------------------------------------------------
             793                           subroutine filter_top_3tl(jtrun,jtmax,lev,ncld,temnow     &
             794                                            ,vornow,divnow)
             795                     !
             796                     !  apply Lanczos filter to top "ktop" layers
             797                     !
             798                           use index
             799                           use mpe
             800                           use const, only : RTYPE
             801                     !
             802                           implicit  none
             803                     
             804                           integer   ktop,ktopm1
             805                           parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             806                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             807                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             808                     !
             809                           integer   jtrun,jtmax,lev,ncld
             810                     
             811                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax), &
             812                                            vornow(lev,2,jtrun,jtmax), &
             813                                            divnow(lev,2,jtrun,jtmax)
             814                     !
             815                           real      wvn_top(ktop+1),djt
             816                     
             817                           integer   k,mode,m,mf,n,nflt,IERR,KL
             818                           real      pi,flt,fac
             819                     !
             820                     
             821                     !2dMPI >
             822                     !     if(ktop.gt.levp)then
             823                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             824                     !        call MPI_FINALIZE(IERR)
             825                     !        stop
             826                     !     endif
             827                     !2dMPI <
             828                     
             829                     !      wvn_top(1) = jtrun*1./3.
             830                           wvn_top(1) = 155
             831                           wvn_top(ktop+1) = jtrun
             832                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             833                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             834     1   s    v            do k = 2, ktop
             835     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.7*(k-1))
             836     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             837     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             838     1   p    v            enddo
             839                     !
             840                           pi = 3.141596
             841                     !
             842                     !  mode = 0 : just truncate into assigned wavenumbers without
             843                     !             extra filtering
             844                     !  mode = 1 or other : add fitering along with truncating
             845                     !
             846                           mode = 1
             847                     !
             848     1                     if( mode .eq. 0 ) then
             849     2                       do k = 1, lev
             850     2               !2dMPI >
             851     2                       KL=Llist(k)
             852     3                       if( KL .le. ktop ) then
             853     3               !2dMPI <
             854     4                         do m = 1, mlistnum
             855     4                           mf=max(2,mlist(m))
             856     5                           do n = mf, jtrun
             857     5                             nflt = int ( wvn_top(k) / float(n) )
             858     5                             flt = min( 1.0, float(nflt) )
             859     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             860     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             861     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             862     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             863     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             864     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             865     5                           enddo
             866     4                         enddo
             867     3               !          do m = 1, mlistnum
             868     3               !            mf=max(2,mlist(m))
             869     3               !            do n = mf, jtrun
             870     3               !              nflt = int ( wvn_top(k) / float(n) )
             871     3               !              flt = min( 1.0, float(nflt) )
             872     3               !              do nc=1,ncld
             873     3               !                kk=(nc-1)*lev+k
             874     3               !                qnow(kk,1,n,m)  = qnow(kk,1,n,m)*flt
             875     3               !                qnow(kk,2,n,m)  = qnow(kk,2,n,m)*flt
             876     3               !              enddo
             877     3               !            enddo
             878     3               !          enddo
             879     3               !2dMPI >
             880     3                       endif
             881     2               !2dMPI <
             882     2                       enddo
             883     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             884     2  pp                   do k = 1, lev
             885     2               !2dMPI >
             886     2   p                   KL=Llist(k)
             887     3   p                   if( KL .le. ktop ) then
             888     3               !2dMPI <
             889     4   p                     do m = 1, mlistnum
             890     4   p                       mf=max(2,mlist(m))

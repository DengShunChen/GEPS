                                   <<<      eps4
                                   <<< Loop-information  End >>>
             114     3   p    v                do n=mf,jtrun
             115     3               
             116     3   p    v                  c1=1.+dta*facv*hfilt*eps4(n,m)**2
             117     3   p    v                  c3=1.+dta*fact*hfilt*eps4(n,m)**2
             118     3               
             119     4   p    v                  if ( KL .le. hdk1 ) then
             120     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)
             121     4   p    v                  else
             122     4   p    v                    c2=1.+dta*facd*hfilt*eps4(n,m)**2
             123     4   p    v                  endif
             124     3               
             125     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             126     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             127     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             128     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             129     3               !            temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             130     3               !            temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             131     3   p    v                  temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             132     3   p    v                  temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             133     3   p    v                enddo
             134     2   p                   enddo
             135     1   p            100  continue
             136                     !

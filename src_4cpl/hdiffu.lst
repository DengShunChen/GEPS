              27                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
              28                           real      hfilt,hfilt2,nf,kfac
              29                           real      c1,c2,c3
              30                           logical   windchk
              31                     
              32                           data      windmax1/80./, windmax2/100./, windmax3/130./
              33                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
              34                     !
              35                     
              36                     !
              37                           nf=jtrun-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286

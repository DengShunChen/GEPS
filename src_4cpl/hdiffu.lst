 External subroutine subprogram "whdiffu"
  (inc)(line-no.)(nest)(optimize)
             462                     !
             463                     !--------------------------------------------------------------------
             464                           subroutine whdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             465                                             , rad,cosl,ut,vt,vornow,divnow,temnow          &
             466                                             , eps4,trefs)
             467                           use index
             468                           use mpe
             469                           use rank
             470                           use const, only : hdk1,hdk2,radsq,vd,RTYPE
             471                           use param, only : octahedral
             472                     
             473                           implicit  none
             474                     
             475                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             476                           real      rad
             477                     
             478                           real(kind=RTYPE) dta
             479                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             480                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             481                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             482                                            eps4(jtrun,jtmax),cosl(my)
             483                     !
             484                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             485                     !
             486                           real      wmax(lev)
             487                           real      windmax1,windmax2,windmax3
             488                     
             489                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             490                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             491                           real      hfilt2,hfilt4,hfilt6,nf,kfac,fl,factop
             492                           real      c1,c2,c3,c4
             493                           logical   windchk
             494                     
             495                           data      windmax1/80./, windmax2/100./, windmax3/130./
             496                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             497                     !
             498                     !      temnow = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             499        pp   4v            wmax(1:lev)= 0.0
             500                     !
             501     1                     do jj =1,jlistnum
             502     1                       j=jlist1(jj)
             503     1                       nxj=nxdef_2d(j)
             504     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             505     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             506     3   p   2v                do i=1,nxj
             507     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             508     3   p   2v                enddo
             509     2   p                   enddo
             510     1                     enddo
             511                     !
             512                           call mpe_global_max(wmax,lev,mpe_double)
             513                     !
             514                           nf=jtrun-1
             515                     !
             516                           factop = 60.
             517                           fl   = factop/float(hdk2(1)-hdk1)
             518                           hfilt6 = (radsq/(nf*(nf+1)))**3.
             519                           hfilt4 = (radsq/(nf*(nf+1)))**2.
             520                           hfilt2 = radsq/(nf*(nf+1))
             521     1                     if ( octahedral ) then
             522     1                       hfilt6 = hfilt6/(6.*dta)
             523     1                       hfilt4 = hfilt4/(6.*dta)
             524     1                       hfilt2 = hfilt2/(6.*dta)
             525     1                     else
             526     1                       hfilt6 = hfilt6/dta
             527     1                       hfilt4 = hfilt4/dta
             528     1                       hfilt2 = hfilt2/dta
             529     1                     endif
             530                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             531     1  pp                 do 100 k=1,levp  ! levp -> lev
             532     1               !
             533     1               !  compute diffusion coefficients
             534     1               !
             535     1               
             536     1   p                   KL=Llist(k)
             537     1               !
             538     1   p                   kfac = min(fl*max(float(hdk2(1)-KL),0.),factop)!    &
             539     1               !              + min(1.*max(float(hdk2(3)-KL),0.),4.)
             540     1               !        if ( KL .le. hdk1 ) kfac = kfac*(1.+vd*exp(-0.5*KL))
             541     1   p                   kfac = kfac*(1.+vd*exp(-0.5*max(float(KL-hdk1),0.)))
             542     1               !        facd = mwhd * max(amp,kfac)
             543     1               !        facv = max(min(amp,1.),kfac)
             544     1   p                   facd = max(1.,kfac)*amp
             545     1   p                   facv = max(1.,kfac)*amp
             546     1   p                   fact = max(1.,kfac)*amp
             547     1               !!        fact = amp * kfacv
             548     1               !          endif
             549     1               
             550     1               !
             551     1               !  difuse vorticity and divergence fields
             552     1               !  diffuse moisture and temperature fields
             553     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             554     2   p                   do m=1,mlistnum
             555     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.47, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             556     3   p    v                do n=mf,jtrun
             557     3               
             558     3               !!            c1=1.+dta*facv*hfilt6*eps4(n,m)**3.
             559     3               !!            c2=1.+dta*facd*hfilt2*eps4(n,m)
             560     3               !            if ( KL .le. hdk1 ) then
             561     3               !              c1=1.+dta*facv*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             562     3               !              c2=1.+dta*facd*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             563     3               !              c3=1.+dta*fact*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             564     3               !            else
             565     3   p    v                    c1=1.+dta*facv*hfilt4*eps4(n,m)**2.
             566     3   p    v                    c2=1.+dta*facd*hfilt4*eps4(n,m)**2.
             567     3   p    v                    c3=1.+dta*fact*hfilt4*eps4(n,m)**2.
             568     3               !!              c2=1.+dta*facd*hfilt6*eps4(n,m)**3.
             569     3               !            endif
             570     3               
             571     3               
             572     3               !!            c3=1.+dta*fact*hfilt6*eps4(n,m)**3.
             573     3               
             574     3               
             575     3               
             576     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             577     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             578     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             579     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             580     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             581     3   p    v                  temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3

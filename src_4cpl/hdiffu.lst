             716                     
             717                     !
             718                     !--------------------------------------------------------------------
             719                           subroutine filter_skeb(jtrun,jtmax,lev,dissest,wvn_top)
             720                     !
             721                     !  apply Lanczos filter to estimation of kinetic energy dissipation.
             722                     !
             723                           use index
             724                           use mpe
             725                           use const, only : RTYPE
             726                     !
             727                           implicit  none
             728                     
             729                     !
             730                           integer   jtrun,jtmax,lev,ncld
             731                     
             732                           real(kind=RTYPE) dissest(lev,2,jtrun,jtmax)
             733                     !
             734                           real      wvn_top
             735                     
             736                           integer   k,mode,m,mf,n,nflt,IERR,KL
             737                           real      pi,flt,fac
             738                     !
             739                     
             740                     !2dMPI >
             741                     !     if(ktop.gt.levp)then
             742                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             743                     !        call MPI_FINALIZE(IERR)
             744                     !        stop
             745                     !     endif
             746                     !2dMPI <
             747                     
             748                     !
             749                           pi = 3.141596
             750                     !
             751                     !  mode = 0 : just truncate into assigned wavenumbers without
             752                     !             extra filtering
             753                     !  mode = 1 or other : add fitering along with truncating
             754                     !
             755                           mode = 1
             756                     !
             757     1                     if( mode .eq. 0 ) then
             758     2                       do k = 1, lev
             759     2               !2dMPI >
             760     2                       KL=Llist(k)
             761     3                         do m = 1, mlistnum
             762     3                           mf=max(2,mlist(m))
             763     4                           do n = mf, jtrun
             764     4                             nflt = int ( wvn_top / float(n) )
             765     4                             flt = min( 1.0, float(nflt) )
             766     4                             dissest(k,1,n,m)= dissest(k,1,n,m)*flt
             767     4                             dissest(k,2,n,m)= dissest(k,2,n,m)*flt
             768     4                           enddo
             769     3                         enddo
             770     2               !2dMPI <
             771     2                       enddo
             772     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             773     2  pp                   do k = 1, lev
             774     2               !2dMPI >
             775     2   p                   KL=Llist(k)
             776     3   p                     do m = 1, mlistnum
             777     3   p                       mf=max(2,mlist(m))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.37, ITR: 48, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             778     4   p    v                  do n = mf, jtrun
             779     4   p    v                    fac = min(wvn_top,float(n-1)) * pi / wvn_top
             780     4   p    v                    flt = sin(fac)/fac
             781     4   p    v                    dissest(k,1,n,m)= dissest(k,1,n,m)*flt
             782     4   p    v                    dissest(k,2,n,m)= dissest(k,2,n,m)*flt
             783     4   p    v                  enddo
             784     3   p                     enddo
             785     2               !2dMPI <
             786     2   p                   enddo
             787     1                     endif
             788                     !
             789                           return
             790                           end


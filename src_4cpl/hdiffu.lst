              76     1               !
              77     1               !  compute diffusion coefficients
              78     1               !
              79     1               
              80     1   p                   KL=Llist(k)
              81     1               !
              82     1               !            facd= 1.
              83     1               !            facv= 1.
              84     1               !            fact= 1.
              85     1               
              86     1               !          if ( KL .le. hdk2 ) then
              87     1   p                   kfac = 1.0 + 1. * min(max(float(hdk2(1)-KL),0.),60.)
              88     1   p                   kfac = kfac*(1.+vd*exp(-0.5*max(float(KL-hdk1),0.)))
              89     1               !!        facd = 2.* amp * (kfac + 1.*max(float(hdk1-KL),0.))
              90     1               !!        facv = amp * (kfac + 0.5*max(float(hdk1-KL),0.))
              91     1               !!        fact = amp * (kfac + 0.5*max(float(hdk1-KL),0.))
              92     1   p                   facd = 2.* amp * kfac
              93     1   p                   facv = amp * kfac
              94     1   p                   fact = amp * kfac
              95     1               !          endif
              96     1               
              97     1               
              98     1               !        if ( KL .le. hdk1 ) then
              99     1               !          ddiffu =facd*hfilt2
             100     1               !        else
             101     1               !          ddiffu =facd*hfilt
             102     1               !        endif
             103     1               
             104     1               !        tdiffu =fact*hfilt
             105     1               !        vdiffu =facv*hfilt
             106     1               
             107     1               
             108     1               !
             109     1               !  difuse vorticity and divergence fields
             110     1               !  diffuse moisture and temperature fields
             111     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             112     2   p                   do m=1,mlistnum
             113     2   p                     mf=mlist(m)

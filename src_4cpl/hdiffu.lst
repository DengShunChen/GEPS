                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, ut
                                   <<< Loop-information  End >>>
              45     3   p   2v                do i=1,nxj
              46     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
              47     3   p   2v                enddo
              48     2   p                   enddo
              49     1                     enddo
              50                     !
              51                           call mpe_global_max(wmax,lev,mpe_double)
              52                     !

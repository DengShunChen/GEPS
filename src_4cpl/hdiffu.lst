 External subroutine subprogram "whdiffu"
  (inc)(line-no.)(nest)(optimize)
             458                     !
             459                     !--------------------------------------------------------------------
             460                           subroutine whdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             461                                             , rad,cosl,ut,vt,vornow,divnow,temnow          &
             462                                             , eps4,trefs)
             463                           use index
             464                           use mpe
             465                           use rank
             466                           use const, only : hdk1,hdk2,radsq,vd,factop,RTYPE,hord
             467                           use param, only : octahedral
             468                     
             469                           implicit  none
             470                     
             471                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             472                           real      rad
             473                     
             474                           real(kind=RTYPE) dta
             475                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             476                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             477                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             478                                            eps4(jtrun,jtmax),cosl(my)
             479                     !
             480                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             481                     !
             482                           real      wmax(lev)
             483                           real      windmax1,windmax2,windmax3
             484                     
             485                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             486                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             487                           real      hfilt,nf,kfac,fl,powd
             488                           real      c1,c2,c3,c4
             489                           logical   windchk
             490                     
             491                           data      windmax1/80./, windmax2/100./, windmax3/130./
             492                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             493                     !
             494                     !      temnow = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             495        pp   4v            wmax(1:lev)= 0.0
             496                     !
             497     1                     do jj =1,jlistnum
             498     1                       j=jlist1(jj)
             499     1                       nxj=nxdef_2d(j)
             500     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             501     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, ut
                                   <<< Loop-information  End >>>
             502     3   p   2v                do i=1,nxj
             503     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             504     3   p   2v                enddo
             505     2   p                   enddo
             506     1                     enddo
             507                     !
             508                           call mpe_global_max(wmax,lev,mpe_double)
             509                     !
             510                           nf=jtrun-1
             511                     !
             512                           powd = float(hord) / 2.
             513                           fl   = factop/float(hdk2(1)-hdk1)
             514                           hfilt = (radsq/(nf*(nf+1)))**powd
             515     1                     if ( octahedral ) then
             516     1                       hfilt = hfilt/(6.*dta)
             517     1                     else
             518     1                       hfilt = hfilt/dta
             519     1                     endif
             520                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             521     1  pp                 do 100 k=1,levp  ! levp -> lev
             522     1               !
             523     1               !  compute diffusion coefficients
             524     1               !
             525     1               
             526     1   p                   KL=Llist(k)
             527     1               !
             528     1   p                   kfac = min(fl*max(float(hdk2(1)-KL),0.),factop)!    &
             529     1               !              + min(1.*max(float(hdk2(3)-KL),0.),4.)
             530     1               !        if ( KL .le. hdk1 ) kfac = kfac*(1.+vd*exp(-0.5*KL))
             531     1   p                   kfac = kfac*(1.+vd*exp(-0.5*max(float(KL-hdk1),0.)))
             532     1               !        facd = mwhd * max(amp,kfac)
             533     1               !        facv = max(min(amp,1.),kfac)
             534     1   p                   facd = max(1.,kfac)*amp
             535     1   p                   facv = max(1.,kfac)*amp
             536     1   p                   fact = max(1.,kfac)*amp
             537     1               !!        fact = amp * kfacv
             538     1               !          endif
             539     1               
             540     1               !
             541     1               !  difuse vorticity and divergence fields
             542     1               !  diffuse moisture and temperature fields
             543     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             544     2   p                   do m=1,mlistnum
             545     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.18, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 22
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             546     3   p    v                do n=mf,jtrun
             547     3               
             548     3               !            if ( KL .le. hdk1 ) then
             549     3               !              c1=1.+dta*facv*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             550     3               !              c2=1.+dta*facd*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             551     3               !              c3=1.+dta*fact*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             552     3               !            else
             553     3   p    v                    c1=1.+dta*facv*hfilt*eps4(n,m)**powd
             554     3   p    v                    c2=1.+dta*facd*hfilt*eps4(n,m)**powd
             555     3   p    v                    c3=1.+dta*fact*hfilt*eps4(n,m)**powd
             556     3               !            endif
             557     3               
             558     3               
             559     3               
             560     3               
             561     3               
             562     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             563     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             564     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             565     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             566     3               !            temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             567     3               !            temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             568     3   p    v                  temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             569     3   p    v                  temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             570     3   p    v                enddo
             571     2   p                   enddo
             572     1   p            100  continue
             573                     !!
             574                     !
             575                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

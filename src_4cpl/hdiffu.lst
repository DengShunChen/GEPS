 External subroutine subprogram "ohdiffu"
  (inc)(line-no.)(nest)(optimize)
             310                     !
             311                     !--------------------------------------------------------------------
             312                           subroutine ohdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             313                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
             314                                             , trefs)
             315                     !     horizontal diffusion for Cubic Truncation Octahedral Reduced
             316                     !     Gaussain grid (under testing for now) -- 03/03/2020 Pang-Yang Liu
             317                           use index
             318                           use mpe
             319                           use rank
             320                           use const, only : hdk1,hdk2,radsq,RTYPE
             321                           use param, only : octahedral
             322                     
             323                           implicit  none
             324                     
             325                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             326                           real      rad
             327                     
             328                           real(kind=RTYPE) dta
             329                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             330                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             331                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             332                                            eps4(jtrun,jtmax),cosl(my)
             333                     !
             334                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             335                     !
             336                           real      wmax(lev)
             337                           real      windmax1,windmax2,windmax3
             338                     
             339                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             340                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             341                           real      hfilt,hfilt2,nf,ncut,ncor,kfac
             342                           real      c1,c2,c3
             343                           logical   windchk
             344                     
             345                           data      windmax1/80./, windmax2/100./, windmax3/130./
             346                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             347                     !
             348                     
             349                     !
             350                           nf=jtrun-1
             351                           ncut=0.5*jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             352        pp   4v            wmax(1:lev)= 0.0
             353                     !
             354     1                     do jj =1,jlistnum
             355     1                       j=jlist1(jj)
             356     1                       nxj=nxdef_2d(j)
             357     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             358     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, ut
                                   <<< Loop-information  End >>>
             359     3   p   2v                do i=1,nxj
             360     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             361     3   p   2v                enddo
             362     2   p                   enddo
             363     1                     enddo
             364                     !
             365                           call mpe_global_max(wmax,lev,mpe_double)
             366                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3200
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             367     1  pp    s            do k=1,lev
             368     2   p    s              if( wmax(k) .gt. windmax3 ) then
             369     2   p    v                if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
             370     2                                                ' windmax=',wmax(k)
             371     2   p    s              endif
             372     1   p    s            enddo
             373                     !
             374                     !
             375                           hfilt = (radsq/(nf*(nf+1)))**2.
             376                           hfilt = hfilt/(6.*dta)
             377                           hfilt2 = radsq/(nf*(nf+1))
             378                           hfilt2 = hfilt2/(6.*dta)
             379                     
             380                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             381     1  pp                 do 100 k=1,levp  ! levp -> lev
             382     1               !
             383     1               !  compute diffusion coefficients
             384     1               !
             385     1               
             386     1   p                    KL=Llist(k)
             387     1               !
             388     1   p                    kfac  = min(5.*max(float(hdk2(1)-KL),0.),60.)
             389     1   p                    facd = amp + kfac
             390     1   p                    facv = amp + kfac
             391     1   p                    fact = amp + kfac
             392     1               !         facd= 1.0 + max(float(hdk2(1)-KL),0.)
             393     1               !         facv= 1.0 + max(float(hdk2(1)-KL),0.)
             394     1               !         fact= 1.0 + max(float(hdk2(1)-KL),0.)
             395     1               
             396     1               !         if ( KL .le. hdk1 ) facd=facd*(1.+float(hdk1-KL))
             397     1               !
             398     1               !          facd = amp * facd
             399     1               !          facv = amp * facv
             400     1               !          fact = amp * fact
             401     1               !
             402     1               
             403     1               !
             404     1               !  difuse vorticity and divergence fields
             405     1               !  diffuse moisture and temperature fields
             406     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             407     2   p                   do m=1,mlistnum
             408     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             409     3   p    v                do n=mf,jtrun
             410     3   p    v                  ncor=1.
             411     4   p    v                  if ( n .gt. ncut ) then
             412     4   p    v                    ncor=exp(-0.5*( (n-jtrun)**2. / (n-ncut)**2. ))
             413     4   p    v                  else
             414     4   p    v                    ncor=0.
             415     4   p    v                  endif
             416     3   p    v                  c3=1.+dta*fact*hfilt*ncor*eps4(n,m)**2
             417     3               
             418     3   p    v                  ncor=min(ncor+0.2*max(float(hdk2(1)-KL),0.),1.)
             419     3   p    v                  c1=1.+dta*facv*hfilt*ncor*eps4(n,m)**2
             420     4   p    v                  if ( KL .le. hdk1 ) then
             421     4               !              c2=1.+dta*facd*hfilt2*ncor*eps4(n,m)
             422     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)
             423     4   p    v                  else
             424     4   p    v                    c2=1.+dta*facd*hfilt*ncor*eps4(n,m)**2
             425     4   p    v                  endif
             426     3               
             427     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             428     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             429     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             430     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             431     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             432     3   p    v                  temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             433     3               !            temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             434     3               !            temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             435     3   p    v                enddo
             436     2   p                   enddo
             437     1   p            100  continue
             438                     !
             439                     !-------------------------------------------------------------------
             440                     !
             441                     !  filter layers near the upper bound if too strong wind speed
             442                     !  happens at the top layer
             443                     !
             444                     !  2003/10/7 :
             445                     !  sometimes wind speed greater than 100m/s happens at k=2
             446                     !
             447                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             448     1  pp    v            do k=1,hdk1
             449     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             450     1   p    v            enddo
             451                     !
             452     1                     if ( windchk ) then
             453     1                      call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             454     1                     end if
             455                     !--------------------------------------------------------------------
             456                           return
             457                           end


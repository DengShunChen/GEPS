             172                           subroutine allocate_const_array
             173                             implicit none
             174                             integer  ierr
             175                     
             176                             allocate (poly(jtrun,my/2,jtmax),dpoly(jtrun,my/2,jtmax),          &
             177                                       eps4(jtrun,jtmax),wdfac(jtrun,jtmax),wcfac(jtrun,jtmax), &
             178                                       cim(jtmax), stat=ierr)
             179     1                       if (ierr/= 0) then
             180     1                           write(6,*) 'mod_const : allocate fail 1 '
             181     1                           stop
             182     1                       end if
             183                     
             184                             allocate (aki(lev+1),bki(lev+1),                         &
             185                                       sigma(lev+1,2),dsigma(lev,2), stat= ierr)
             186     1                       if (ierr/= 0) then
             187     1                           write(6,*) 'mod_const : allocate fail 2 '
             188     1                           stop
             189     1                       end if
             190                     

             192                                       stat= ierr)
             193     1                       if (ierr/= 0) then
             194     1                           write(6,*) 'mod_const : allocate fail 3 '
             195     1                           stop
             196     1                       end if
             197                     
             198                             allocate (weight(my),sinl(my),cosl(my),           &
             199                             cor(my),onocos(my),                               &
             200                             tmean(lev),spalm(lev),eigval(lev),evecin(lev,lev),&
             201                             evectr(lev,lev),arrhyd(lev,lev),arsddt(lev,lev),  &
             202                             pmcor(lev),tmcor(lev,lev),tmeans(lev),            &
             203                                       stat= ierr)
             204     1                       if (ierr/= 0) then
             205     1                           write(6,*) 'mod_const : allocate fail 4 '
             206     1                           stop
             207     1                       end if
             208                     
             209                     
             210                             allocate (outdir(nout),stat= ierr)
             211     1                       if (ierr/= 0) then
             212     1                           write(6,*) 'mod_const : allocate fail 5 '
             213     1                           stop
             214     1                       end if
             215                           end subroutine

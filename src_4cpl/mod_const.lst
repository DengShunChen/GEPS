             164                           subroutine allocate_const_array
             165                             implicit none
             166                             integer  ierr
             167                     
             168                             allocate (poly(jtrun,my/2,jtmax),dpoly(jtrun,my/2,jtmax),          &
             169                                       eps4(jtrun,jtmax),wdfac(jtrun,jtmax),wcfac(jtrun,jtmax), &
             170                                       cim(jtmax), stat=ierr)
             171     1                       if (ierr/= 0) then
             172     1                           write(6,*) 'mod_const : allocate fail 1 '
             173     1                           stop
             174     1                       end if
             175                     
             176                             allocate (aki(lev+1),bki(lev+1),                         &
             177                                       sigma(lev+1,2),dsigma(lev,2), stat= ierr)
             178     1                       if (ierr/= 0) then

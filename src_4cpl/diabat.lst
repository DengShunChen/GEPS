            2318     3  pp                   do k=1,lev
            2319     3   p                     kc=lev-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtradc, tt, sppt3d, tt_save_sppt, qt
                                   <<<      qt_save_sppt, ut, ut_save_sppt, vt
                                   <<<      vt_save_sppt, zmtnblck
                                   <<< Loop-information  End >>>
            2320     4   p    v                do i=1,nxj
            2321     4   p    v                  vru=1.
            2322     5   p    v                  if (kc.gt.zmtnblck(i)+2) then
            2323     5   p    v                     vru=1.0
            2324     5   p    v                  endif
            2325     5   p    v                  if (kc.le.zmtnblck(i)) then
            2326     5   p    v                     vru=0.0
            2327     5   p    v                  endif
            2328     5   p    v                  if (kc.eq.zmtnblck(i)+1) then
            2329     5   p    v                     vru=0.333333
            2330     5   p    v                  endif
            2331     5   p    v                  if (kc.eq.zmtnblck(i)+2) then
            2332     5   p    v                     vru=0.666667
            2333     5   p    v                  endif
            2334     4               
            2335     4   p    v                  ru = sppt3d(i,k,jj) + 1.
            2336     4   p    v                  if (use_zmtnblck) ru = (ru - 1.) * vru + 1.
            2337     4               
            2338     4   p    v                  dtdtr = dtradc(i,k,jj) * dta / 86400.
            2339     4   p    v                  upert = ( ut(i,k,jj) - ut_save_sppt(i,k,jj) ) * ru
            2340     4   p    v                  vpert = ( vt(i,k,jj) - vt_save_sppt(i,k,jj) ) * ru
            2341     4   p    v                  tpert = ( tt(i,k,jj) - tt_save_sppt(i,k,jj) - dtdtr ) * ru
            2342     4   p    v                  qpert = ( qt(i,k,jj) - qt_save_sppt(i,k,jj) ) * ru
            2343     4               
            2344     4   p    v                  ut(i,k,jj) = ut_save_sppt(i,k,jj) + upert
            2345     4   p    v                  vt(i,k,jj) = vt_save_sppt(i,k,jj) + vpert
            2346     4               
            2347     4                           !negative humidity check

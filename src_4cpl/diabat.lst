            2122     4                           obsseaice(ii,jj)=cicetm(ii)
            2123     4                           evapw(ii,jj)=-qfluxtm(ii)/hltm
            2124     4                           rsf(ii,jj)=(rlsptm(ii)+rcuptm(ii))/dta
            2125     4               
            2126     4                           !ustrw, vstrw
            2127     4                           rnuw = 1.14E-6
            2128     4                           z0w = 0.11*rnuw/ustartm(ii)+0.1*SQRT(rnuw*ustartm(ii)/grav) &
            2129     4                                  +0.015*ustartm(ii)**2/grav  ! Kraus & Businger(1994, page 146)
            2130     4                           d0w = 0.
            2131     4               
            2132     4                           Pairvapor= AirVaporPressure(t2tm(ii),rh2tm(ii))
            2133     4                           rhoa = 100.*psttm(ii)/(287.04*t2tm(ii))*(1.0-0.378*Pairvapor/psttm(ii))
            2134     4                                ! 287.04 [k.g-1.K-1]  Gas constant of dry air
            2135     4                           liw = -(0.4*grav*((hfluxtm(ii)/(t2tm(ii)*cp)+0.61*(qfluxtm(ii)/hltm)))/(ustartm(ii)**3.)*rhoa)
            2136     4                           ps1w = log((10.0-d0w)/z0w)-CalcSm((10.0-d0w)*liw,z0w,liw)+CalcSm(z0w*liw,z0w,liw)
            2137     4                           ustra = u10tm(ii)*0.4/ps1w
            2138     4                           vstra = v10tm(ii)*0.4/ps1w
            2139     4                           ustrw(ii,jj) = rhoa*ustra**2
            2140     4                           vstrw(ii,jj) = rhoa*vstra**2
            2141     4               
            2142     4                           !in&out
            2143     4                           seaice(ii,jj)=cicetm(ii)
            2144     4                           thickness(ii,jj)=zicetm(ii)
            2145     4                           sni(ii,jj)=snrtm(ii)/1000.   !mm->m
            2146     4                           t_surf   =obswtbtm(ii)
            2147     4                           t_surf = MAX( t_surf, ctfreez )
            2148     4                           tsi(ii,jj)= MIN( t_surf, ctfreez )
            2149     4                           obswtb(ii,jj)=obswtbtm(ii)
            2150     4                           tsw(ii,jj)=tg(ii,jj)
            2151     4                           dtswdt(ii,jj)=0.
            2152     4               
            2153     4                         endif    !end (lrun_sitvdiff)

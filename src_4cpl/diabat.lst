             543                     !     define local constants
             544                     ! for vertical rhc
             545                     !      ct=0.7
             546                     !      cs=0.9
             547                     !      px=4.
             548                     !
             549                     !-------------------------------
             550                     ! pbl package > tke-e  ; npbl=1
             551                     ! pbl package > ncep   ; npbl=2
             552                     !     npbl = 2
             553                     !
             554                     ! shlcon use Frank version , nmshl=1
             555                     ! shlcon use ncep new version(2010) companion with new_sas, nmshl=2
             556                     !     nmshl = 2

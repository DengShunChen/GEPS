             591     1                     else
             592     1                       dta    = 2.0*dt
             593     1                       rainfc = 0.5
             594     1                     endif
             595                     !
             596     1                     if (itimestep .le. 1) then
             597     1                        doozon = .true.
             598     1                        kdt    = 1
             599     1                     else
             600     1                        doozon = .false.
             601     1                        kdt    = 0
             602     1                     endif
             603                     
             604                     !------------------------------------------------------------------------------
             605                     !     set hours, iter, icrad, julian, uprad, doozon
             606                     !------------------------------------------------------------------------------
             607                     
             608                     
             609                           rsolhr = hours
             610                           hours = hours + dt/3600.
             611     1                     if ( abs(24.-hours) .lt. 1.e-6 )  then
             612     1                        hours = 0.
             613     1                        julian= julian + 1
             614     1                        if ( julian .gt. yrd ) julian = julian - yrd
             615     1                        doozon = .true.
             616     1                        doclxu = .true.
             617     1                     endif
             618                           leap = mod ( year , 4 )
             619                           yrd = 365
             620                           if ( leap .eq. 0 ) yrd = 366
             621                     !
             622                           icrad = frad*3600.0/dt + 0.0001 ! frad =1.0 set in block.f
             623                           iter  = tau*3600.0/dt  + 0.0001
             624                           uprad = .false.
             625                           if ( (mod(iter,icrad).eq.0) .or. (iter.eq.1) )  uprad = .true.
             626                           doozon = doozon .and. dorad
             627                           uprad  = uprad  .and. dorad

             609     1                     if ( abs(24.-hours) .lt. 1.e-6 )  then
             610     1                        hours = 0.
             611     1                        julian= julian + 1
             612     1                        if ( julian .gt. yrd ) julian = julian - yrd
             613     1                        doozon = .true.
             614     1                        doclxu = .true.
             615     1                     endif
             616                           leap = mod ( year , 4 )
             617                           yrd = 365
             618                           if ( leap .eq. 0 ) yrd = 366
             619                     !
             620                           icrad = frad*3600.0/dt + 0.0001 ! frad =1.0 set in block.f

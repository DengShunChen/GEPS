             560                           sup=  1.0
             561                           nxmy = nx * my
             562                           nxlev= nx * lev
             563                           levmy= lev* my
             564                           radus = 6371000.
             565                           radsq = radus**2
             566                           tpi   = 4.0*atan(1.0)
             567                           d2r   = tpi / 180.0
             568                           tpr   = 2.*tpi*radus
             569                           ptrad = max(0.01,ptop)
             570                           xkapa = rgas/cp
             571                           xkapa1= 1.0 + xkapa
             572                           okapa = 1.0/xkapa
             573                           p0k   = 1000.0**xkapa
             574                           op0k  = 1.0/p0k
             575                           ptopk = ptop**xkapa
             576                     !

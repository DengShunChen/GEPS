              26                     
              27                       USE shr_kind_mod, only: r8 => shr_kind_r8
              28                       USE mo_constants, ONLY: rhoh2o, &! density of liquid water
              29                                               tmelt,  &! temperature of fusion of ice
              30                                               alv,    &! latent heat for vaporisation
              31                                               g,      &! gravity acceleration
              32                                               alf,    &! latent heat for fusion
              33                                               als,    &! latent heat for sublimation
              34                                               rcpd     ! rcpd=1./cpd
              35                     
              36                       IMPLICIT NONE
              37                     
              38                       !  Scalar arguments with intent(In):
              39                     !  INTEGER, INTENT (IN) :: klev, klevp1, klon, ktopm2

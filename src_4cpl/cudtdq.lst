              41                     
              42                       !  Array arguments with intent(In):
              43                       REAL(r8), INTENT (IN) :: paphp1(klon,klevp1), pdmfdp(klon,klev), &
              44                     &      pdmfup(klon,klev), pdpmel(klon,klev), plude(klon,klev), &
              45                     &      pmfdq(klon,klev), pmfds(klon,klev), &
              46                     &      pmful(klon,klev), pmfuq(klon,klev), pmfus(klon,klev), &
              47                     &       prain(klon), prfl(klon), &
              48                     &      psfl(klon), pten(klon,klev),ztodt
              49                       LOGICAL, INTENT (IN) :: ldcum(klon)
              50                     
              51                       !  Scalar arguments with intent(InOut):
              52                     
              53                       !  Array arguments with intent(InOut):
              54                       REAL(r8), INTENT (INOUT) :: paprc(klon), paprs(klon), pqte(klon,klev), &
              55                     &                         prsfc(klon), pssfc(klon), ptte(klon,klev), &
              56                     &                         pxtec(klon,klev)
              57                     
              58                       !  Local scalars:
              59                       REAL(r8) :: zalv, zdiagt, zdiagw, zdqdt, zdtdt, zdxtdt
              60                       INTEGER :: jk, jl, jt
              61                       LOGICAL :: llo1
              62                     
              63                       !  Intrinsic functions
              64                       INTRINSIC MERGE
              65                     
              66                     
              67                       !  Executable statements
              68                     
              69                     !-- 1. Specify parameters
              70                     
              71                     ! zdiagt = 0.5*ztodt
              72                       zdiagt = ztodt
              73                       zdiagw = zdiagt/rhoh2o
              74                     
              75                     !-- 2. Incrementation of t and q tendencies
              76                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

               5                     SUBROUTINE cudtdq(nxj,klon,klev,klevp1,ktopm2,paphp1,ldcum,pten,ptte,pqte, &
               6                     &      pxtec,pmfus,pmfds,pmfuq,pmfdq,pmful,pdmfup, &

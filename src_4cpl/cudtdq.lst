                                   <<<     SEQUENTIAL : 20
                                   <<<      pmfuq: 8, pmfdq: 4, pqte: 4, pxtec: 4
                                   <<< Loop-information  End >>>
              81     1  pp             DO jk = ktopm2, klev
              82     1               
              83     2   p               IF (jk<klev) THEN
              84     2               !      DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmfdq, ldcum, pmful, plude, pten, pmfds
                                   <<<      pmfus, pdmfdp, pdmfup, pdpmel, paphp1
                                   <<<      ptte
                                   <<<    PREFETCH(SOFT) : 30
                                   <<<     SEQUENTIAL : 30
                                   <<<      pmfuq: 12, pmfdq: 6, pqte: 6, pxtec: 6
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              85     3   p    v            DO jl = 1, nxj
              86     4   p    v              IF (ldcum(jl)) THEN
              87     4   p    v                llo1 = (pten(jl,jk)-tmelt) > 0.
              88     4   p    v                zalv = MERGE(alv,als,llo1)
              89     4   p    v                zdtdt = (g/(paphp1(jl,jk+1)-paphp1(jl,jk)))*rcpd*(pmfus(jl,jk+1)- &
              90     4               &              pmfus(jl,jk)+pmfds(jl,jk+1)-pmfds(jl,jk)-alf*pdpmel(jl,jk)- &
              91     4               &              zalv*(pmful(jl,jk+1)-pmful(jl,jk)-plude(jl, &
              92     4               &              jk)-(pdmfup(jl,jk)+pdmfdp(jl,jk))))
              93     4               ! jwhwu 201209 for CWB, output tendency is for cumulus only
              94     4               !         ptte(jl,jk) = ptte(jl,jk) + zdtdt
              95     4   p    v                ptte(jl,jk) = zdtdt
              96     4   p    v                zdqdt = (g/(paphp1(jl,jk+1)-paphp1(jl,jk)))*(pmfuq(jl,jk+1)-pmfuq( &
              97     4               &              jl,jk)+pmfdq(jl,jk+1)-pmfdq(jl,jk)+pmful(jl,jk+1)-pmful(jl,jk)- &
              98     4               &              plude(jl,jk)-(pdmfup(jl,jk)+pdmfdp(jl,jk)))
              99     4               ! jwhwu 201209 for CWB, output tendency is for cumulus only
             100     4               !         pqte(jl,jk) = pqte(jl,jk) + zdqdt
             101     4   p    v                pqte(jl,jk) = zdqdt
             102     4   p    v                pxtec(jl,jk) = (g/(paphp1(jl,jk+1)-paphp1(jl,jk)))*plude(jl,jk)
             103     4   p    v              END IF
             104     3   p    v            END DO
             105     2               
             106     2   p               ELSE
             107     2               !      DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.39, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plude, ldcum, pdmfup, pmful, pten
                                   <<<      pdpmel, pmfds, pdmfdp, pmfuq, pmfdq
                                   <<<      paphp1, pmfus, ptte, pqte, pxtec
                                   <<< Loop-information  End >>>
             108     3   p    v            DO jl = 1, nxj
             109     4   p    v              IF (ldcum(jl)) THEN
             110     4   p    v                llo1 = (pten(jl,jk)-tmelt) > 0.
             111     4   p    v                zalv = MERGE(alv,als,llo1)
             112     4   p    v                zdtdt = -(g/(paphp1(jl,jk+1)-paphp1(jl,jk)))*rcpd*(pmfus(jl,jk)+ &
             113     4               &              pmfds(jl,jk)+alf*pdpmel(jl,jk)-zalv*(pmful(jl,jk)+pdmfup(jl, &
             114     4               &              jk)+pdmfdp(jl,jk)+plude(jl,jk)))
             115     4               ! jwhwu 201209 for CWB, output tendency is for cumulus only
             116     4               !         ptte(jl,jk) = ptte(jl,jk) + zdtdt
             117     4   p    v                ptte(jl,jk) = zdtdt
             118     4   p    v                zdqdt = -(g/(paphp1(jl,jk+1)-paphp1(jl,jk)))*(pmfuq(jl,jk)+pmfdq(jl &
             119     4               &              ,jk)+plude(jl,jk)+(pmful(jl,jk)+pdmfup(jl,jk)+pdmfdp(jl,jk)))
             120     4               ! jwhwu 201209 for CWB, output tendency is for cumulus only
             121     4               !         pqte(jl,jk) = pqte(jl,jk) + zdqdt
             122     4   p    v                pqte(jl,jk) = zdqdt
             123     4   p    v                pxtec(jl,jk) = (g/(paphp1(jl,jk+1)-paphp1(jl,jk)))*plude(jl,jk)
             124     4   p    v              END IF
             125     3   p    v            END DO
             126     2               
             127     2   p               END IF
             128     1   p             END DO
             129                     !-- 3. Update surface fields and do global budgets
             130                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 88, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pssfc, psfl, prfl, paprc, prsfc, paprs
                                   <<< Loop-information  End >>>
             131     1  pp    v        DO jl = 1, nxj
             132     1   p    v          prsfc(jl) = prfl(jl)
             133     1   p    v          pssfc(jl) = psfl(jl)
             134     1   p    v          paprc(jl) = paprc(jl) + zdiagw*(prfl(jl)+psfl(jl))
             135     1   p    v          paprs(jl) = paprs(jl) + zdiagw*psfl(jl)
             136     1   p    v        END DO
             137                     
             138                       RETURN
             139                     END SUBROUTINE cudtdq


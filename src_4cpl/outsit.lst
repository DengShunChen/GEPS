                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sitwttau, glob2d
                                   <<< Loop-information  End >>>
             199     2  pp   2v                glob2d(:,:)= sitwttau(:,:,k)/dtsittau
             200     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob2d
                                   <<< Loop-information  End >>>
             201     2  pp   4v                glob2d=xmissing
             202     2                       endif
             203     1                       call unify_reduceintp(nx,my,my_max,glob2d,wk1)
             204     1                       call split(nx,my,lenc,ifilout,ncnt,wk1,pout,ihdg,ihdg2)
             205     1                  10 continue
             206                     
             207     1                     if(outdms.gt.0)then
             208     1                     if(myrank .lt. ncnt) call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             209     1                     endif
             210                     

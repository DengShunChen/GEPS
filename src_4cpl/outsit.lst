             167                           SUBROUTINE writesitmean(nx,my,my_max,lkvl,ifilout,itau,idtg,ggdef)
             168                     
             169                           use rank
             170                           use mpe
             171                           use index
             172                           use const,           only:RTYPE,kflag,outdms
             173                           use mod_sitgrid,     only:sitwttau,sitwstau,sitwutau,sitwvtau &
             174                                                    ,dtsittau
             175                           use mod_sit_control, only: xmissing,outsitlev
             176                     
             177                           implicit none
             178                     
             179                           integer nx,my,my_max,lkvl,itau
             180                     
             181                     
             182                           character*60 ifilout
             183                           integer*8 idtg
             184                           character*4 ggdef
             185                           integer lenc,k,jj,j,nxj,ii,istat
             186                           character*26 ihdg,ihdg2
             187                           character*6 lrec
             188                           real(kind=RTYPE) wk1(nx,my),pout(nx,my),glob2d(nxp,my_max)
             189                           integer ncnt
             190                     
             191                           lenc= nx*my
             192                     
             193                     
             194                           ncnt=0
             195     1                     do 10 k = 0, outsitlev+1
             196     1                       write( lrec, '(i3.3,a3)' ) k,'WTT'
             197     1                       call syslbl (lrec,idtg,itau,ggdef,ihdg)
             198     2                       if(dtsittau .ne. 0.) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]

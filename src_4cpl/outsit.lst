                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sitwttau
                                   <<< Loop-information  End >>>
             211        pp   4v            sitwttau=0.
             212                           dtsittau=0.
             213                     
             214                           END SUBROUTINE writesitmean


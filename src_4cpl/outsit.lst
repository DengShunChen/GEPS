             862                           subroutine readpre6hr_sit(nx,my,itaup,ifilin,idtg,ggdef)
             863                     
             864                           use index
             865                           use mpe
             866                           use rank
             867                           use mod_sitgrid
             868                     
             869                           implicit none
             870                           integer nx,my
             871                           integer itaup,nxmy,i,j,k,ii,jj,istat,nxj
             872                           character*60 ifilin
             873                           character*4 ggdef

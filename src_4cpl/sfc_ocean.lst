               1                     !-----------------------------------
               2                           subroutine sfc_ocean                                              &
               3                     !...................................
               4                     !  ---  inputs: &
               5                                ( imj,im, ps, u1, v1, t1, q1, tskin, cm, ch,                 &
               6                                  prsl1, prslki, islimsk, ddvel, flag_iter,                  &
               7                     !  ---  outputs:
               8                     !    &       qsurf, cmm, chh, gflux, evap, hflx, ep                     &
               9                                  qsurf, gflux, evap, hflx, ep, ssu, ssv                     &
              10                                )
              11                     
              12                     ! ===================================================================== !
              13                     !  description:                                                         !
              14                     !                                                                       !
              15                     !  usage:                                                               !
              16                     !                                                                       !
              17                     !    call sfc_ocean                                                     !
              18                     !       inputs:                                                         !
              19                     !          ( im, ps, u1, v1, t1, q1, tskin, cm, ch,                     !
              20                     !            prsl1, prslki, islimsk, ddvel, flag_iter,                  !
              21                     !       outputs:                                                        !
              22                     !            qsurf, cmm, chh, gflux, evap, hflx, ep )                   !
              23                     !                                                                       !
              24                     !                                                                       !
              25                     !  subprograms/functions called: fpvs                                   !
              26                     !                                                                       !
              27                     !                                                                       !
              28                     !  program history log:                                                 !
              29                     !         2005  -- created from the original progtm to account for      !
              30                     !                  ocean only                                           !
              31                     !    oct  2006  -- h. wei      added cmm and chh to the output          !
              32                     !    apr  2009  -- y.-t. hou   modified to match the modified gbphys.f  !
              33                     !                  reformatted the code and added program documentation !
              34                     !    sep  2009  -- s. moorthi removed rcl and made pa as pressure unit  !
              35                     !                  and furthur reformatted the code                     !
              36                     !                                                                       !
              37                     !                                                                       !
              38                     !  ====================  defination of variables  ====================  !
              39                     !                                                                       !
              40                     !  inputs:                                                       size   !
              41                     !     im       - integer, horizontal dimension                     1    !
              42                     !     ps       - real, surface pressure                            im   !
              43                     !     u1, v1   - real, u/v component of surface layer wind         im   !
              44                     !     t1       - real, surface layer mean temperature ( k )        im   !
              45                     !     q1       - real, surface layer mean specific humidity        im   !
              46                     !     tskin    - real, ground surface skin temperature ( k )       im   !
              47                     !     cm       - real, surface exchange coeff for momentum (m/s)   im   !
              48                     !     ch       - real, surface exchange coeff heat & moisture(m/s) im   !
              49                     !     prsl1    - real, surface layer mean pressure                 im   !
              50                     !     prslki   - real,                                             im   !
              51                     !     islimsk  - integer, sea/land/ice mask (=0/1/2)               im   !
              52                     !     ddvel    - real, wind enhancement due to convection (m/s)    im   !
              53                     !     flag_iter- logical,                                          im   !
              54                     !                                                                       !
              55                     !  outputs:                                                             !
              56                     !     qsurf    - real, specific humidity at sfc                    im   !
              57                     !     cmm      - real,                                             im   !
              58                     !     chh      - real,                                             im   !
              59                     !     gflux    - real, ground heat flux (zero for ocean)           im   !
              60                     !     evap     - real, evaporation from latent heat flux           im   !
              61                     !     hflx     - real, sensible heat flux                          im   !
              62                     !     ep       - real, potential evaporation                       im   !
              63                     !                                                                       !
              64                     ! ===================================================================== !
              65                     !
              66                           use machine , only : kind_phys
              67                     !     use funcphys, only : fpvs
              68                           use physcons, only : cp => con_cp, rd => con_rd, eps => con_eps,    &
              69                                                epsm1 => con_epsm1, hvap => con_hvap,          &
              70                                                rvrdm1 => con_fvirt
              71                           use const,    only : RTYPE
              72                     !
              73                           implicit none
              74                     !
              75                     !  ---  constant parameters:
              76                           real (kind=kind_phys), parameter :: cpinv  = 1.0/cp                 &
              77                           ,                                   hvapi  = 1.0/hvap               &
              78                           ,                                   elocp  = hvap/cp
              79                     
              80                     !  ---  inputs:
              81                           integer, intent(in) :: im, imj
              82                     
              83                           real (kind=RTYPE), dimension(im), intent(in) :: u1, v1, t1, q1
              84                           real (kind=kind_phys), dimension(im), intent(in) :: ps,             &
              85                                 tskin, cm, ch, prsl1, prslki, ddvel, ssu, ssv
              86                           integer, dimension(im), intent(in):: islimsk
              87                     
              88                           logical, intent(in) :: flag_iter(im)
              89                     
              90                     !  ---  outputs:
              91                     !     real (kind=kind_phys), dimension(im), intent(out) :: qsurf,         &
              92                           real (kind=kind_phys), dimension(im) :: qsurf,         &
              93                                  cmm, chh, gflux, evap, hflx, ep
              94                     
              95                     !  ---  locals:
              96                     
              97                           real (kind=kind_phys) :: q0, qss, rch, rho, wind, tem, fpvs
              98                     
              99                           integer :: i
             100                     
             101                           logical :: flag(im)
             102                     !
             103                     !===> ...  begin here
             104                     !
             105                     !  --- ...  flag for open water
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      islimsk, flag_iter, flag
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 18
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             106     1   s    s            do i = 1, imj
             107     1   m    m              flag(i) = ( islimsk(i) == 0 .and. flag_iter(i) )
             108     1               
             109     1               !  --- ...  initialize variables. all units are supposedly m.k.s. unless specified
             110     1               !           ps is in pascals, wind is wind speed,
             111     1               !           rho is density, qss is sat. hum. at surface
             112     1               
             113     2   s    s              if ( flag(i) ) then
             114     2               
             115     2   m    m                wind     = max(sqrt((u1(i)-ssu(i))**2 + (v1(i)-ssv(i))**2)          &
             116     2                                      + max( 0.0, min( ddvel(i), 30.0 ) ), 1.0)
             117     2               
             118     2   p    v                q0       = max( q1(i), 1.0e-8 )
             119     2   p    v                rho      = prsl1(i) / (rd*t1(i)*(1.0 + rvrdm1*q0))
             120     2               
             121     2   s    s                qss      = fpvs( tskin(i) )
             122     2   p    v                qss      = eps*qss / (ps(i) + epsm1*qss)
             123     2               
             124     2   p    v                evap(i)  = 0.0
             125     2   p    v                hflx(i)  = 0.0
             126     2   p    v                ep(i)    = 0.0
             127     2   p    v                gflux(i) = 0.0
             128     2               
             129     2               !  --- ...    rcp  = rho cp ch v
             130     2               
             131     2   p    v                rch      = rho * cp * ch(i) * wind
             132     2   p    v                cmm(i)   = cm(i) * wind
             133     2   p    v                chh(i)   = rho * ch(i) * wind
             134     2               
             135     2               !  --- ...  sensible and latent heat flux over open water
             136     2               
             137     2   m    m                hflx(i)  = rch * (tskin(i) - t1(i) * prslki(i))
             138     2               
             139     2   p    v                evap(i)  = elocp*rch * (qss - q0)
             140     2   p    v                qsurf(i) = qss
             141     2               
             142     2   p    v                tem      = 1.0 / rho
             143     2   p    v                hflx(i)  = hflx(i) * tem * cpinv
             144     2   p    v                evap(i)  = evap(i) * tem * hvapi
             145     2   p    v              endif
             146     1   p    v            enddo
             147                     !
             148                           return
             149                     !...................................
             150                           end subroutine sfc_ocean
             151                     !-----------------------------------


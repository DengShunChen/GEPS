             431                     !
             432                     !
             433                     !-------------------------------------------------------------------
             434                           subroutine cyclic_cell_massadvy(jm,lev,nvars,delt,vc,qq,mass)
             435                     !
             436                     ! compute local positive advection with mass conserving
             437                     ! qq will be advect by vc from past to next location with 2*delt
             438                     !
             439                     ! author: hann-ming henry juang 2007
             440                     !
             441                     !
             442                           use grid     , only : gglati,fa1,fa2,fa3,fa4
             443                     !
             444                           use const, only : RTYPE
             445                     
             446                           implicit none
             447                     !
             448                           integer   jm,lev,nvars,mass
             449                           real(kind=RTYPE)      delt
             450                           real(kind=RTYPE)      vc(jm,lev)
             451                           real(kind=RTYPE)      qq(jm,lev,nvars)
             452                     !
             453                           real(kind=RTYPE)      var(jm)
             454                           real(kind=RTYPE)      past(jm,nvars),da(jm,nvars),next(jm,nvars)
             455                           real(kind=RTYPE)      dyfact(jm)
             456                           real(kind=RTYPE)      ypast(jm+1),ynext(jm+1)
             457                           real(kind=RTYPE)      dist (jm+1), ds(jm), step(10), dist_step
             458                           real(kind=RTYPE)      sc
             459                     
             460                           integer   n,k,j,jmh,nv,nst,nstep
             461                     !
             462                     ! preparations ---------------------------
             463                     !
             464                           jmh  = jm / 2
             465                           sc = gglati(jm+1)-gglati(1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 288, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gglati, ds
                                   <<< Loop-information  End >>>
             466     1       2v            do j=1,jm
             467     1       2v              ds(j) = gglati(j+1) - gglati(j)
             468     1       2v            enddo
             469                           nv   = nvars
             470                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var, fa1, fa3, fa2, fa4, dist
                                   <<< Loop-information  End >>>
             471     1                     do k=1,lev
             472     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.83, ITR: 224, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var
                                   <<< Loop-information  End >>>
             473     2       2v              do j=1,jmh
             474     2       2v                var(j)     =  vc(j    ,k) * delt
             475     2       2v                var(j+jmh) = -vc(j+jmh,k) * delt
             476     2       2v              enddo
             477     1               ! for Gaussian latitude
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 224, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fa2, var, fa3, fa4, fa1, dist
                                   <<< Loop-information  End >>>
             478     2        v              do j=3,jm-1
             479     2        v                dist(j)=fa1(j)*var(j-2)+fa2(j)*var(j-1)+fa3(j)*var(j)+fa4(j)*var(j+1)
             480     2        v              enddo
             481     1                       ! over pole
             482     1                       dist(2)=fa1(2)*var(jm)+fa2(2)*var(1)+fa3(2)*var(2)+fa4(2)*var(3)
             483     1                       dist(jm)=fa1(jm)*var(jm-2)+fa2(jm)*var(jm-1)+fa3(jm)*var(jm)+fa4(jm)*var(1)
             484     1               
             485     1                       dist(1)=fa1(1)*var(jm-1)+fa2(1)*var(jm)+fa3(1)*var(1)+fa4(1)*var(2)
             486     1                       dist(jm+1)=dist(1)
             487     1               ! for reguler grid
             488     1               !        do j=3,jm-1
             489     1               !          dist(j)=fa1*(var(j)+var(j-1))-fa2*(var(j+1)+var(j-2))
             490     1               !        enddo
             491     1               !        ! over pole
             492     1               !        dist(2)=fa1*(var(2)+var(1 ))-fa2*(var(3)+var(jm  ))
             493     1               !        dist(1)=fa1*(var(1)+var(jm))-fa2*(var(2)+var(jm-1))
             494     1               !        dist(jm+1)=dist(1)
             495     1               !        dist(jm  )=fa1*(var(jm)+var(jm-1))-fa2*(var(1)+var(jm-2))
             496     1               !cflx   call def_cfl_max (jm+1,dist,ds,nstep)
             497     1                       call def_cfl_step(jm+1,dist,ds,step,nstep,lev+1-k,'advy')
             498     1               
             499     1               !
             500     1               ! advection all in y
             501     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, gglati, ypast, ynext, dyfact
                                   <<< Loop-information  End >>>
             502     2                      do nst = 1, nstep
             503     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, gglati, ypast, ynext
                                   <<< Loop-information  End >>>
             504     3       2v              do j=1,jm+1
             505     3       2v                dist_step = dist(j)*step(nst)
             506     3       2v                ypast(j) = gglati(j) - dist_step
             507     3       2v                ynext(j) = gglati(j) + dist_step
             508     3       2v              enddo
             509     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ypast, ynext, dyfact
                                   <<< Loop-information  End >>>
             510     4       2v               do j=1,jm
             511     4       2v                dyfact(j) = (ypast(j+1)-ypast(j)) / (ynext(j+1)-ynext(j))
             512     4       2v               enddo
             513     3                       endif
             514     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             515     3                       do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, past
                                   <<< Loop-information  End >>>
             516     3       2v                past(1:jm,n) = qq(1:jm,k,n)
             517     3                       enddo
             518     2                       call cyclic_cell_ppm_intp(gglati,past,ypast,da,jm,nv,jm,jm,sc)
             519     2               !        call cyclic_cell_plm_intp(gglati,past,ypast,da,jm,nv,jm,jm,sc)
             520     2               
             521     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dyfact, da
                                   <<< Loop-information  End >>>
             522     4                         do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 384, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dyfact, da
                                   <<< Loop-information  End >>>
             523     4       2v                  da(1:jm,n) = da(1:jm,n) * dyfact(1:jm)
             524     4                         enddo
             525     3                       endif
             526     2                       call cyclic_cell_ppm_intp(ynext,da,gglati,next,jm,nv,jm,jm,sc)
             527     2               !        call cyclic_cell_plm_intp(ynext,da,gglati,next,jm,nv,jm,jm,sc)
             528     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             529     3                       do n=1,nv
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      next, qq
                                   <<< Loop-information  End >>>
             530     3       2v                qq(1:jm,k,n) = next(1:jm,n)
             531     3                       enddo
             532     2               !
             533     2                      enddo
             534     1               !
             535     1                     enddo
             536                     
             537                           return
             538                           end subroutine cyclic_cell_massadvy


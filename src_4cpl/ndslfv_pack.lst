              68     1       2s              gslati(jm -j+1) = gslati(jm -j+2) - wgt(j)
              69     1       2s              gslati(jm +j+1) = gslati(jm +j  ) + wgt(j)
              70     1       2s              gslati(jm2-j+1) = gslati(jm2-j+2) - wgt(j)
              71     1       2s            enddo

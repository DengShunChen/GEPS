                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssid, ssia, dsfact
                                   <<< Loop-information  End >>>
            1291     4       2v                do k=1,levs
            1292     4       2v                  dsfact(k)=(ssid(k)-ssid(k+1))/(ssia(k)-ssia(k+1))
            1293     4       2v                enddo
            1294     3                       endif
            1295     2               !
            1296     3                       if ( forward ) then

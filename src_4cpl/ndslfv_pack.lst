 External subroutine subprogram "cyclic_cell_ppm_intp"
  (inc)(line-no.)(nest)(optimize)
            1332                     !
            1333                     !
            1334                     ! -------------------------------------------------------------------------
            1335                           subroutine cyclic_cell_ppm_intp(pp,qq,pn,qn,lons,nv,lonp,lonn,sc)
            1336                     !
            1337                     ! mass conservation in cyclic bc interpolation: interpolate a group
            1338                     ! of grid point  coordiante call pp at interface with quantity qq at
            1339                     ! cell averaged to a group of new grid point coordinate call pn at
            1340                     ! interface with quantity qn at cell average with ppm spline.
            1341                     ! in horizontal with mass conservation is under the condition that
            1342                     ! variable value at pp(1)= pp(lons+1)=pn(lons+1)
            1343                     !
            1344                     ! pp    location at interfac point as input
            1345                     ! qq    quantity at averaged-cell as input
            1346                     ! pn    location at interface of new grid structure as input
            1347                     ! qn    quantity at averaged-cell as output
            1348                     ! lons  numer of cells for dimension
            1349                     ! lonp  numer of cells for input
            1350                     ! lonn  numer of cells for output
            1351                     ! levs  number of vertical layers
            1352                     ! mono  monotonicity o:no, 1:yes
            1353                     !
            1354                     ! author : henry.juang@noaa.gov
            1355                     !
            1356                     !
            1357                           use const, only : RTYPE
            1358                           implicit none
            1359                     !
            1360                           real(kind=RTYPE)      pp(lons+1)
            1361                           real(kind=RTYPE)      qq(lons  ,nv)

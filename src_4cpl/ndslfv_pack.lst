                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mass, qpi, qmi
                                   <<< Loop-information  End >>>
            2189     3        v              do i=kstr-1,kend+1
            2190     3        v                c1=qpi(i,n)-mass(i,n)
            2191     3        v                c2=mass(i,n)-qmi(i,n)
            2192     4        v                if( c1*c2.le.0.0 ) then
            2193     4        v                  qmi(i,n)=mass(i,n)
            2194     4        v                  qpi(i,n)=mass(i,n)
            2195     4        v                else
            2196     4        v                  cc=qpi(i,n)-qmi(i,n)
            2197     4        v                  c1=cc*(mass(i,n)-0.5*(qpi(i,n)+qmi(i,n)))
            2198     4        v                  c2=cc*cc*r6
            2199     5        v                  if( c1.gt.c2 ) then
            2200     5        v                    qmi(i,n)=3.*mass(i,n)-2.*qpi(i,n)
            2201     5        v                  else if( c1.lt.-c2 ) then
            2202     5        v                    qpi(i,n)=3.*mass(i,n)-2.*qmi(i,n)
            2203     5        v                  endif
            2204     4        v                endif
            2205     3        v              enddo
            2206     2                       enddo
            2207     1                     endif
            2208                     !
            2209                     ! start interpolation by integral of ppm
            2210                     !
            2211                           kkl = kstr
            2212                           tl=(pn(1)-locs(kkl))/hh(kkl)
            2213                           tl2=tl*tl
            2214                           tl3=tl2*tl
            2215                           tlp = tl3-tl2
            2216                           tlm = tl3-2.*tl2+tl
            2217                           tlc = -2.*tl3+3.*tl2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 176, MVE: 4, POL: S)

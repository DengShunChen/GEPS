             663                           subroutine fixend_cell_massadvy(jm,jmh,levs,nvars,delt,vc,qq,mass)
             664                     !
             665                     ! compute local positive advection with mass conserving
             666                     ! qq will be advect by vc from past to next location with 2*delt
             667                     !
             668                     ! author: hann-ming henry juang 2007
             669                     !
             670                           use grid     , only : gslati
             671                     !      use gfs_dyn_layout1
             672                     !
             673                           use const, only : RTYPE
             674                     
             675                           implicit none
             676                     !
             677                           integer   jm,jmh,levs,nvars,mass
             678                           real(kind=RTYPE)	delt
             679                           real(kind=RTYPE)	vc(jm,levs)
             680                           real(kind=RTYPE)	qq(jm,levs,nvars)
             681                     !
             682                           real(kind=RTYPE)	var(jmh)
             683                           real(kind=RTYPE)	past(jmh,nvars),da(jmh,nvars),next(jmh,nvars)
             684                           real(kind=RTYPE)	dyfact(jmh)
             685                           real(kind=RTYPE)	ypast(jmh+1),ynext(jmh+1)
             686                           real(kind=RTYPE)	dist (jmh+1), ds(jmh)
             687                           real(kind=RTYPE)	step(10), dist_step
             688                           real(kind=RTYPE) 	hfpi,pi
             689                           real(kind=RTYPE), parameter :: fa1 = 9./16.
             690                           real(kind=RTYPE), parameter :: fa2 = 1./16.
             691                     
             692                           integer  	n,k,j,nv,nst,nstep
             693                     !
             694                     ! preparations ---------------------------
             695                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 288, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gslati, ds
                                   <<< Loop-information  End >>>
             696     1       2v            do j=1,jmh
             697     1       2v              ds(j) = gslati(j+1) - gslati(j)
             698     1       2v            enddo
             699                           pi = 4.0 * atan(1.0)
             700                           hfpi = pi * 0.5
             701                           nv   = nvars
             702                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, ds, var, dist
                                   <<< Loop-information  End >>>
             703     1                     do k=1,levs
             704     1               !
             705     1               ! first hemisphere
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 384, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var
                                   <<< Loop-information  End >>>
             706     2       2v              do j=1,jmh
             707     2       2v                var(j)     = vc(j    ,k) * delt
             708     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ds, var, dist
                                   <<< Loop-information  End >>>
             709     2       2v              do j=2,jmh
             710     2       2v                dist(j)=(var(j)*ds(j-1)+var(j-1)*ds(j)) / (ds(j-1)+ds(j))
             711     2       2v              enddo
             712     1                       dist(1)=0.0
             713     1                       dist(jmh+1)=0.0
             714     1               !cflx   call def_cfl_max (jmh+1,dist,ds,nstep)
             715     1                       call def_cfl_step(jmh+1,dist,ds,step,nstep,levs+1-k,'advy')
             716     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, gslati, ypast, ynext, dyfact
                                   <<< Loop-information  End >>>
             717     2                       do nst = 1, nstep
             718     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, gslati, ypast, ynext
                                   <<< Loop-information  End >>>
             719     3       2v              do j=1,jmh+1

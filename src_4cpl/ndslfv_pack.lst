                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pn
                                   <<< Loop-information  End >>>
            2083     2       2v              do i=1,lonn+1
            2084     2       2v                pn(i)=pn(i)+(int((locbndmax-pnmin)/sc)-1)*sc
            2085     2       2v              enddo
            2086     1                     endif
            2087                     
            2088                           pnmin = pn(1)
            2089                           pnmax = pn(lonn+1)
            2090                     !!    do i=2,lonn
            2091                     !!      pnmin = min( pnmin, pn(i) )
            2092                     !!      pnmax = max( pnmax, pn(i) )
            2093                     !!    enddo
            2094                     

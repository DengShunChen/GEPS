            1904                     !
            1905                           subroutine ndslfv_update (lonsperlat,vdzonl,vdmerd,vdzonlr,vdmerdr,deltim,forward)
            1906                     
            1907                     !  update all horizontal components into momentum eqs
            1908                     !  for Semi-Lagrangian vertical advection
            1909                     
            1910                           use index
            1911                           use param, only : nx,my,lev,my_max
            1912                           use const, only : onocos,radsq,RTYPE
            1913                           use grid , only : dlphi,dtphi
            1914                     
            1915                           integer,intent(in):: lonsperlat(my)
            1916                           real(kind=RTYPE),   intent(in):: deltim
            1917                     
            1918                           real(kind=RTYPE)    vdmerd(nxp,lev,my_max),vdzonl(nxp,lev,my_max)
            1919                           real(kind=RTYPE)    vdmerdr(nxp,lev,my_max),vdzonlr(nxp,lev,my_max)
            1920                           integer i,ii,k,lan,lat,lons_lat
            1921                           integer dt2
            1922                           logical forward
            1923                     
            1924     1                     if ( forward ) then
            1925     1                       dt2 = deltim
            1926     1                     else
            1927     1                       dt2 = 2. * deltim
            1928     1                     endif
            1929                     !
            1930                     !$omp parallel do                                                   &
            1931                     !$omp private(lan,lat,lons_lat,i,k)                                 &
            1932                     !$omp schedule(dynamic)
            1933     1   p                 do lan=1,jlistnum
            1934     1               !
            1935     1   p                   lat = jlist1(lan)
            1936     1   p                   lons_lat = lonsperlat(lat)
            1937     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerdr, vdmerd, vdzonlr, vdzonl
                                   <<< Loop-information  End >>>
            1938     2   p                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerd, vdmerdr, vdzonlr, vdzonl
                                   <<< Loop-information  End >>>
            1939     3   p    v               do i=1,lons_lat
            1940     3               !ttl           vdzonl(i,k,lan) = (vdzonlr(i,k,lan)-dlphi(i,k,lan)/radsq) &
            1941     3               !ttl                             * dt2 + vdzonl(i,k,lan)
            1942     3               !ttl           vdmerd(i,k,lan) = (vdmerdr(i,k,lan)-dtphi(i,k,lan)/radsq  &
            1943     3               !ttl                             / onocos(lat))*dt2 + vdmerd(i,k,lan)
            1944     3   p    v                 vdzonl(i,k,lan) = vdzonlr(i,k,lan) * dt2 + vdzonl(i,k,lan)
            1945     3   p    v                 vdmerd(i,k,lan) = vdmerdr(i,k,lan) * dt2 + vdmerd(i,k,lan)
            1946     3   p    v               enddo
            1947     2   p                   enddo
            1948     1   p                 enddo
            1949                     !$omp end parallel do
            1950                     !
            1951                     ! ===============================
            1952                     !
            1953                           return
            1954                           end subroutine ndslfv_update


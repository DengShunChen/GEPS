  (inc)(line-no.)(nest)(optimize)
            1816                     !!
            1817                     !!
            1818                           subroutine def_cfl_step (im,dist,del,step,nstep,k,job)
            1819                     !
            1820                     ! compute the deformation cfl condition
            1821                     ! select the maxima value of the deformation CFL and provide step to
            1822                     ! avoid it.
            1823                     !
            1824                     !
            1825                           use const, only : RTYPE
            1826                     
            1827                           implicit none
            1828                     !
            1829                           integer im,nstep
            1830                           real(kind=RTYPE) dist(im),del(im-1),step(10)
            1831                     ! local
            1832                           integer   n,k,nchk
            1833                           real(kind=RTYPE)      rstep,check,check_max,check_point
            1834                           real(kind=RTYPE)      safe_step,last_step
            1835                           character*4 job
            1836                     !
            1837                           check_point=1.00
            1838                           safe_step=0.99
            1839                           nstep = 1
            1840                           step(1) = 1.0
            1841                     
            1842                           check_max = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, del
                                   <<< Loop-information  End >>>
            1843     1       2s            check_loop: do n=1,im-1
            1844     1       2v              check = abs ( (dist(n+1)-dist(n))/del(n) )
            1845     2       2v              if( check.lt.check_point ) then
            1846     2       2v                cycle check_loop
            1847     2       2v              else
            1848     3       2s                if ( check .gt. check_max ) then
            1849     3       2v                   nchk=n
            1850     3       2s                   check_max=check
            1851     3       2v                endif
            1852     2               !!          check_max = max( check_max, check )
            1853     2       2v              endif
            1854     1       2v            enddo check_loop
            1855     1                     if(check_max.ge.check_point) then
            1856     1                       nstep = int(check_max/safe_step) + 1
            1857     2                       if ( job .eq. 'advv' ) then
            1858     2                         print *,' max def_cfl ',check_max,' needs ',nstep,    &
            1859     2                         'steps at level',im+1-nchk,'of',im,'in ',job,' processing'
            1860     2                       else if ( job .eq. 'advx' .and. im .gt. 25 ) then
            1861     2                         print *,' max def_cfl ',check_max,' needs ',nstep,    &
            1862     2                         'steps in',nchk,'of',im,'at level',k,'in ',job,' processing'
            1863     2                       else if ( job .eq. 'advy' ) then
            1864     2                         print *,' max def_cfl ',check_max,' needs ',nstep,    &
            1865     2                         'steps in',nchk,'of',im,'at level',k,'in ',job,' processing'
            1866     2                       endif
            1867     1                       rstep =  safe_step / check_max
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      step
                                   <<< Loop-information  End >>>
            1868     2        v              do n=1,nstep-1
            1869     2        v                step(n) = rstep
            1870     2        v              enddo
            1871     1                       last_step = 1. - ( nstep - 1 ) * rstep
            1872     1                       step(nstep) = last_step
            1873     1                     endif
            1874                     !
            1875                           return
            1876                           end subroutine def_cfl_step


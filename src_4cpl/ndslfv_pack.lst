                                   <<< Loop-information  End >>>
            1304     5       4v                  do k=1,levs
            1305     5       4v                    rqmm(k,n) = qql(i,k,n)
            1306     5       4v                  enddo
            1307     4                         enddo
            1308     3                         call vertical_cell_ppm_intp(ssii,rqmm,ssid,rqda,levs,nvars,i)
            1309     3               !          call fixend_cell_plm_intp(ssii,rqmm,ssid,rqda,levs,nvars)
            1310     3                       endif
            1311     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :

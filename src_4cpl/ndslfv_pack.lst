 External subroutine subprogram "fixend_cell_plm_intp"
  (inc)(line-no.)(nest)(optimize)
            1098                     !
            1099                     ! -------------------------------------------------------------------------
            1100                           subroutine fixend_cell_plm_intp(pp,qq,pn,qn,lons,nv)
            1101                     !
            1102                     ! linear quick version of the same two end points cell interpolation
            1103                     ! so pp(1) = pn(1) and pp(lonp+1) = pn(lonn+1)
            1104                     !
            1105                     ! pp    location at interfac point as input
            1106                     ! qq    quantity at averaged-cell as input
            1107                     ! pn    location at interface of new grid structure as input
            1108                     ! qn    quantity at averaged-cell as output
            1109                     ! lons  numer of cells for dimension
            1110                     !
            1111                     ! author : henry.juang@noaa.gov
            1112                     !
            1113                     !      use gfs_dyn_layout1
            1114                     !
            1115                           use index, only : col_rank
            1116                           use const, only : RTYPE
            1117                     
            1118                           implicit none
            1119                     !
            1120                           real(kind=RTYPE)      pp(lons+1)
            1121                           real(kind=RTYPE)      qq(lons  ,nv)
            1122                           real(kind=RTYPE)      pn(lons+1)
            1123                           real(kind=RTYPE)      qn(lons  ,nv)
            1124                           integer   lons,nv
            1125                     !
            1126                           real(kind=RTYPE)      hfdp(lons),rdsi(lons)
            1127                           real(kind=RTYPE)      locf(lons+lons),df(lons+lons-1),dt(lons+lons-1)
            1128                           real(kind=RTYPE)      qc(lons),dq(lons),qmi(lons),qpi(lons)
            1129                           real(kind=RTYPE)      valf(lons+lons-1)
            1130                           real(kind=RTYPE)      rdd(lons)
            1131                           real(kind=RTYPE)      dd,check,ss
            1132                           integer   js(lons+1),i4j(lons+lons)
            1133                           integer   i,j,n,ip,in
            1134                     !
            1135                     ! arrange input array cover output location with cyclic boundary
            1136                     ! condition
            1137                     !
            1138                           locf(1) = pp(1)
            1139                           i4j(1)=1
            1140                           js(1)=1
            1141                           ip=2
            1142                           in=2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, pn, i4j
                                   <<< Loop-information  End >>>
            1143     1       2s            do j=2,lons+lons-1
            1144     2       2m              if( pp(ip).le.pn(in) ) then
            1145     2       2s                locf(j) = pp(ip)
            1146     2       2m                ip = ip + 1
            1147     2       2s              else
            1148     2       2s                locf(j) = pn(in)
            1149     2       2s                js(in) = j
            1150     2       2m                in = in + 1
            1151     2       2v              endif
            1152     1       2s              i4j(j) = ip - 1
            1153     1       2v            enddo
            1154                           locf(lons+lons) = pp(lons+1)
            1155                           js(lons+1) = lons+lons
            1156                     !
            1157                     ! interpolation coefficient
            1158                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, hfdp
                                   <<< Loop-information  End >>>
            1159     1       2v            do i=1,lons
            1160     1       2v              hfdp(i) = 0.5*(pp(i+1)-pp(i))
            1161     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hfdp, rdsi
                                   <<< Loop-information  End >>>
            1162     1       2v            do i=2,lons
            1163     1       2v              rdsi(i) = 1.0 / (hfdp(i)+hfdp(i-1))
            1164     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locf, df
                                   <<< Loop-information  End >>>
            1165     1                     do i=1,lons
            1166     1                       dd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.04, ITR: 384, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locf, df
                                   <<< Loop-information  End >>>
            1167     2       8v              do j=js(i),js(i+1)-1
            1168     2       8v                df(j) = locf(j+1) - locf(j)
            1169     2       8v                dd    = dd    + df(j)
            1170     2       8v              enddo
            1171     1                       rdd(i) = 1.0 / dd
            1172     1                     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      df, locf, i4j, dt
                                   <<< Loop-information  End >>>
            1173     1        v            do j=1,lons+lons-1
            1174     1        v              i = i4j(j)
            1175     1        v              dt(j) = (locf(j) + 0.5*df(j)) - (pp(i) + hfdp(i))
            1176     1        v            enddo
            1177                     !
            1178                     ! start interpolation by integral of ppm
            1179                     !
            1180                           dq(1) = 0.0
            1181                           dq(lons) = 0.0
            1182                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, qc, rdsi, qmi, i4j, dt, dq, qpi
                                   <<<      valf
                                   <<< Loop-information  End >>>
            1183     1                     do n=1,nv
            1184     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, qc
                                   <<< Loop-information  End >>>
            1185     2       2v              do i=1,lons
            1186     2       2v                qc(i) = qq(i,n)
            1187     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 192, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rdsi, qc, qmi
                                   <<< Loop-information  End >>>
            1188     2       2v              do i=2,lons
            1189     2       2v                qmi(i) = (qc(i)-qc(i-1))*rdsi(i)
            1190     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1191,1194)
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 320, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmi, dq, qpi
                                   <<< Loop-information  End >>>
            1191     2       2v              do i=2,lons-1
            1192     2       2v                qpi(i) = qmi(i+1)
            1193     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1194     2                       do i=2,lons-1
            1195     2                         check = qmi(i)*qpi(i)
            1196     3                         if( check.lt.0.0 ) then
            1197     3                           dq(i) = 0.0
            1198     3                         else
            1199     3                           dq(i)  = 0.5*(qmi(i)+qpi(i))
            1200     3                         endif
            1201     2                       enddo
            1202     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.42, ITR: 352, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      i4j, dt, valf
                                   <<< Loop-information  End >>>
            1203     2       2v              do j=1,lons+lons-1
            1204     2       2v                i = i4j(j)
            1205     2       2v                valf(j) = qc(i) + dq(i)*dt(j)
            1206     2       2v              enddo
            1207     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      df, valf
                                   <<< Loop-information  End >>>
            1208     2                       do i=1,lons
            1209     2                         ss = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.75, ITR: 384, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      df, valf
                                   <<< Loop-information  End >>>
            1210     3       8v                do j=js(i),js(i+1)-1
            1211     3       8v                  ss = ss + valf(j)*df(j)
            1212     3       8v                enddo
            1213     2                         qn(i,n) = ss * rdd(i)
            1214     2                       enddo
            1215     1               
            1216     1                     enddo
            1217                     !
            1218                           return
            1219                           end subroutine fixend_cell_plm_intp


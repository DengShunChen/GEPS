              44                     ! ------------------- gaussian latitude
              45                     ! cosglat   cos(lat)
              46                     ! gglat     gaussian latitude count from 0 to 2 pi
              47                     !           from north pole to south pole back to north pole
              48                     ! gglati    gaussian latitude at edges for gglat
              49                     ! gslati    cos(lat) at gglati
              50                     ! ggfact    interpolation factor from gglat to gglati for wind
              51                     !
              52                     ! --------------------- for parallel --------------------
              53                     !      allocate ( gslati(jm2+1) )

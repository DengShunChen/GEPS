            2073                     !!      pnmax = max( pnmax, pn(i) )
            2074                     !!    enddo
            2075                     
            2076                           locbndmin=locs(  lonp+4)
            2077                           locbndmax=locs(2*lonp-4)
            2078     1                     if( pnmin.lt.locbndmin-sc ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pn
                                   <<< Loop-information  End >>>
            2079     2       2v              do i=1,lonn+1
            2080     2       2v                pn(i)=pn(i)+int((locbndmin-pnmin)/sc)*sc
            2081     2       2v              enddo
            2082     1                     else if( pnmin.gt.locbndmax ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

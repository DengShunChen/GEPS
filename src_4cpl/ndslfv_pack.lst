            2227     2                       do kk=kkl+1,kend+2
            2228     3                         if( pn(kh).lt.locs(kk) ) then
            2229     3                           kkh = kk-1
            2230     3                           go to 100
            2231     3                         endif
            2232     2                       enddo
            2233     1               

              96     1                             *(gglati(j)-gglat(j+1)))/((gglat(j-2)-gglat(j-1))   &
              97     1                             *(gglat(j-2)-gglat(j))*(gglat(j-2)-gglat(j+1)))
              98     1        v              fa2(j)=((gglati(j)-gglat(j-2))*(gglati(j)-gglat(j))       &
              99     1                             *(gglati(j)-gglat(j+1)))/((gglat(j-1)-gglat(j-2))   &
             100     1                             *(gglat(j-1)-gglat(j))*(gglat(j-1)-gglat(j+1)))
             101     1        v              fa3(j)=((gglati(j)-gglat(j-2))*(gglati(j)-gglat(j-1))     &

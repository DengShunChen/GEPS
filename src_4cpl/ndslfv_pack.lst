 External subroutine subprogram "vertical_cell_ppm_intp"
  (inc)(line-no.)(nest)(optimize)
            1624                     !
            1625                     ! ------------------------------------------------------------------------
            1626                           subroutine vertical_cell_ppm_intp(pp,qq,pn,qn,levs,nvars,i)
            1627                     !
            1628                     ! mass conservation in vertical interpolation: interpolate a group
            1629                     ! of grid point  coordiante call pp at interface with quantity qq at
            1630                     ! cell averaged to a group of new grid point coordinate call pn at
            1631                     ! interface with quantity qn at cell average with ppm spline.
            1632                     ! in vertical with mass conservation is under the condition that
            1633                     ! pp(1)=pn(1), pp(levs+1)=pn(levs+1)
            1634                     !
            1635                     ! pp    pressure at interfac level as input
            1636                     ! qq    quantity at layer as input
            1637                     ! pn    pressure at interface of new grid structure as input
            1638                     ! qn    quantity at layer as output
            1639                     ! levs  numer of verical layers
            1640                     !
            1641                     ! author : henry.juang@noaa.gov
            1642                     !
            1643                           use const, only : RTYPE
            1644                     
            1645                           implicit none
            1646                     !
            1647                           real(kind=RTYPE)      pp(levs+1)
            1648                           real(kind=RTYPE)      qq(levs,nvars)
            1649                           real(kind=RTYPE)      pn(levs+1)
            1650                           real(kind=RTYPE)      qn(levs,nvars)
            1651                           integer   levs,nvars
            1652                     !
            1653                           real(kind=RTYPE)      massm,massc,massp,massbot,masstop
            1654                           real(kind=RTYPE)      qmi(levs,nvars),qpi(levs,nvars)
            1655                           real(kind=RTYPE)      dql(nvars),dqh(nvars)
            1656                           real(kind=RTYPE)      hh(levs)
            1657                           real(kind=RTYPE)      dqi,dqimax,dqimin,dqmono(levs,nvars)
            1658                           real(kind=RTYPE)      tl,tl2,tl3,tlp,tlm,tlc
            1659                           real(kind=RTYPE)      th,th2,th3,thp,thm,thc
            1660                           real(kind=RTYPE)      dpp,dqq,c1,c2
            1661                           integer   i,k, kl, kh, kk, kkl, kkh,n
            1662                           integer, parameter :: mono=1
            1663                     !
            1664     1                     if( pp(1).ne.pn(1) .or. pp(levs+1).ne.pn(levs+1) ) then
            1665     1                       print *,' Error in vertical_cell_ppm_intp for domain values '
            1666     1                       print *,' i pp1 pn1 ppt pnt ',i,                            &
            1667     1                               pp(1),pn(1),pp(levs+1),pn(levs+1)
            1668     1                       call abort
            1669     1                     endif
            1670                     !
            1671                     ! prepare thickness for grid
            1672                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 288, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, hh
                                   <<< Loop-information  End >>>
            1673     1       2v            do k=1,levs
            1674     1       2v              hh(k) = pp(k+1)-pp(k)
            1675     1       2v            enddo
            1676                     !
            1677                     ! prepare location with monotonic concerns
            1678                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, hh, dqmono, qmi, qpi
                                   <<< Loop-information  End >>>
            1679     1                     do n=1,nvars
            1680     1                       massbot=(3.*hh(1)+hh(2))*qq(1,n)-2.*hh(1)*qq(2,n)
            1681     1                       massm = massbot/(hh(1)+hh(2))
            1682     1                       massc = qq(1  ,n)
            1683     1                       massp = qq(1+1,n)
            1684     1                       dqi = 0.25*(massp-massm)
            1685     1                       dqimax = max(massm,massc,massp) - massc
            1686     1                       dqimin = massc - min(massm,massc,massp)
            1687     1                       dqmono(1,n) = sign( min( abs(dqi), dqimin, dqimax ), dqi)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.88, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, dqmono
                                   <<< Loop-information  End >>>
            1688     2        v              do k=2,levs-1
            1689     2        v                massp = qq(k+1,n)
            1690     2        v                massc = qq(k  ,n)
            1691     2        v                massm = qq(k-1,n)
            1692     2        v                dqi = 0.25*(massp-massm)
            1693     2        v                dqimax = max(massm,massc,massp) - massc
            1694     2        v                dqimin = massc - min(massm,massc,massp)
            1695     2        v                dqmono(k,n) = sign( min( abs(dqi), dqimin, dqimax ), dqi)
            1696     2        v              enddo
            1697     1                       masstop=(3.*hh(levs)+hh(levs-1))*qq(levs,n)                  &
            1698     1                                  -2.*hh(levs)*qq(levs-1,n)
            1699     1                       massp = masstop/(hh(levs)+hh(levs-1))
            1700     1                       massc = qq(levs  ,n)
            1701     1                       massm = qq(levs-1,n)
            1702     1                       dqi = 0.25*(massp-massm)
            1703     1                       dqimax = max(massm,massc,massp) - massc
            1704     1                       dqimin = massc - min(massm,massc,massp)
            1705     1                       dqmono(levs,n) = sign( min( abs(dqi), dqimin, dqimax ), dqi)
            1706     1               !
            1707     1               ! compute value at interface with momotone
            1708     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hh, qq, dqmono, qmi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0

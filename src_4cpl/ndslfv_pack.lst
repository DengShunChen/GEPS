                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gglati, dist, ypast, ynext, dyfact
                                   <<< Loop-information  End >>>
             610     2                      do nst = 1, nstep
             611     2               !
             612     3                       if ( forward ) then

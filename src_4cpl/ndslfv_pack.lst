              56     1       2s            do j=1,jmh
              57     1       2m              gglat(      j) = 0.5*pi - acos(coslat(j))
              58     1       2m              gglat(jm +1-j) = 0.5*pi + acos(coslat(j))
              59     1       2m              gglat(jm +  j) = 1.5*pi - acos(coslat(j))
              60     1       2m              gglat(jm2+1-j) = 1.5*pi + acos(coslat(j))
              61     1       2v            enddo
              62                     !
              63                           gslati(    1)=0.0
              64                           gslati(jm +1)=2.0
              65                           gslati(jm2+1)=4.0

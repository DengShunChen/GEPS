                                   <<<      ds, var, dist
                                   <<< Loop-information  End >>>
             749     2       2v              do j=2,jmh
             750     2       2v                dist(j)=(var(j)*ds(j-1)+var(j-1)*ds(j)) / (ds(j-1)+ds(j))
             751     2       2v              enddo
             752     1                       dist(1)=0.0
             753     1                       dist(jmh+1)=0.0
             754     1               !cflx   call def_cfl_max (jmh+1,dist,ds,nstep)
             755     1                       call def_cfl_step(jmh+1,dist,ds,step,nstep,levs+1-k,'advy')
             756     1               !

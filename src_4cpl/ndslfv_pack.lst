            1286     4               !            ssid(k)=-ssi(i,k)+dd_step
            1287     4               !            ssia(k)=-ssi(i,k)-dd_step
            1288     4       2v                enddo
            1289     3                       endif
            1290     3                       if( mass.eq.1 ) then
                                   <<< Loop-information Start >>>

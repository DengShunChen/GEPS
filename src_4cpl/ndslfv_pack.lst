             541                           subroutine cyclic_cell_massadvyl(jm,lev,nvars,delt,vc,qq,mass,forward)
             542                     !
             543                     ! compute local positive advection with mass conserving
             544                     ! qq will be advect by vc from past to next location with 2*delt
             545                     !
             546                     ! author: hann-ming henry juang 2007
             547                     !
             548                     !
             549                           use grid     , only : gglati,fa1,fa2,fa3,fa4
             550                     !
             551                           use const, only : RTYPE
             552                     
             553                           implicit none
             554                     !
             555                           integer   jm,lev,nvars,mass
             556                           real(kind=RTYPE)      delt
             557                           real(kind=RTYPE)      vc(jm,lev)
             558                           real(kind=RTYPE)      qq(jm,lev,nvars)
             559                     !
             560                           real(kind=RTYPE)      var(jm)
             561                           real(kind=RTYPE)      past(jm,nvars),da(jm,nvars),next(jm,nvars)
             562                           real(kind=RTYPE)      dyfact(jm)
             563                           real(kind=RTYPE)      ypast(jm+1),ynext(jm+1)
             564                           real(kind=RTYPE)      dist (jm+1), ds(jm), step(10), dist_step
             565                           real(kind=RTYPE)      sc
             566                     
             567                           integer   n,k,j,jmh,nv,nst,nstep
             568                           logical   forward
             569                     !
             570                     ! preparations ---------------------------
             571                     !
             572                           jmh  = jm / 2
             573                           sc = gglati(jm+1)-gglati(1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 288, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gglati, ds
                                   <<< Loop-information  End >>>
             574     1       2v            do j=1,jm
             575     1       2v              ds(j) = gglati(j+1) - gglati(j)
             576     1       2v            enddo
             577                           nv   = nvars
             578                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var, fa1, fa3, fa2, fa4, dist
                                   <<< Loop-information  End >>>
             579     1                     do k=1,lev
             580     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.83, ITR: 224, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var
                                   <<< Loop-information  End >>>
             581     2       2v              do j=1,jmh
             582     2       2v                var(j)     =  vc(j    ,k) * delt
             583     2       2v                var(j+jmh) = -vc(j+jmh,k) * delt
             584     2       2v              enddo
             585     1               ! for Gaussian latitude
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 224, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :

            2242     1                       call abort
            2243     1               
            2244     1                100    continue
            2245     1               ! mass interpolate
            2246     1                       th=(pn(kh)-locs(kkh))/hh(kkh)
            2247     1                       th2=th*th
            2248     1                       th3=th2*th
            2249     1                       thp = th3-th2
            2250     1                       thm = th3-2.*th2+th
            2251     1                       thc = -2.*th3+3.*th2
                                   <<< Loop-information Start >>>

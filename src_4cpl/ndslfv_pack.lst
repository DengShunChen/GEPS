            2029                           real      qq(lons  ,nv)
            2030                           real      pn(lons+1)
            2031                           real      qn(lons  ,nv)
            2032                           integer   lons,lonp,lonn,nv
            2033                           real      sc
            2034                     !
            2035                           real      locs  (3*lonp)
            2036                           real      mass  (3*lonp,nv)
            2037                           real      hh    (3*lonp)
            2038                           real      fm    (3*lonp)
            2039                           real      fn    (3*lonp)
            2040                           real      dqmono(3*lonp,nv)
            2041                           real      qmi   (3*lonp,nv)
            2042                           real      qpi   (3*lonp,nv)
            2043                           real      cyclic_length
            2044                           integer   ik,le,kstr,kend
            2045                           real      pnmin,pnmax,locbndmin,locbndmax
            2046                           real      dqi,dqimax,dqimin
            2047                           real      tl,tl2,tl3,qql,tlp,tlm,tlc
            2048                           real      th,th2,th3,qqh,thp,thm,thc
            2049                           real      dql(nv),dqh(nv)
            2050                           real      dpp,dqq,c1,c2,cc,r3,r6
            2051                           integer   i,k, kl, kh, kk, kkl, kkh, n
            2052                           integer, parameter :: mono=1
            2053                     !
            2054                     !     cyclic_length = pp(lonp+1) - pp(1)
            2055                           cyclic_length = sc
            2056                     !
            2057                     ! arrange input array cover output location with cyclic boundary
            2058                     ! condition
            2059                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

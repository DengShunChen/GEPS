             790                     !
             791                     !-------------------------------------------------------------------------------
             792                           subroutine cyclic_cell_intpx(levs,imp,imf,qq)
             793                     !
             794                     ! do  mass conserving interpolation from different grid at given latitude
             795                     !
             796                     ! author: hann-ming henry juang 2008
             797                     !
             798                           use grid      , only : lonfull
             799                     !     use gfs_dyn_layout1
             800                           use const, only : RTYPE
             801                     
             802                           implicit none
             803                     !
             804                           integer	 levs, imp, imf
             805                           real(kind=RTYPE)	 qq(lonfull,levs)
             806                     !
             807                           real(kind=RTYPE)	old(lonfull,levs),new(lonfull,levs)
             808                           real(kind=RTYPE)	xpast(lonfull+1),xnext(lonfull+1)
             809                           real(kind=RTYPE)	two_pi,dxp,dxf,hfdxp,hfdxf,sc,pi
             810                     !
             811                           integer  	i,k,im
             812                     !
             813                           im = lonfull
             814                     
             815                     ! ..................................
             816     1                     if( imp.ne.imf ) then
             817     1               ! ..................................
             818     1                       pi  = 4.0 * atan(1.0)
             819     1                       two_pi = 2.0 * pi
             820     1                       dxp = two_pi / imp
             821     1                       dxf = two_pi / imf
             822     1                       hfdxp = 0.5 * dxp
             823     1                       hfdxf = 0.5 * dxf
             824     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xpast
                                   <<< Loop-information  End >>>
             825     2       2v              do i=1,imp+1
             826     2       2v                xpast(i) = (i-1) * dxp - hfdxp
             827     2       2v              enddo
             828     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xnext
                                   <<< Loop-information  End >>>
             829     2       2v              do i=1,imf+1

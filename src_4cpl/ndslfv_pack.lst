                                   <<<      SCALABLE  : SPILL 1  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             586     2        v              do j=3,jm-1
             587     2        v                dist(j)=fa1(j)*var(j-2)+fa2(j)*var(j-1)+fa3(j)*var(j)+fa4(j)*var(j+1)
             588     2        v              enddo
             589     1                       ! over pole
             590     1                       dist(2)=fa1(2)*var(jm)+fa2(2)*var(1)+fa3(2)*var(2)+fa4(2)*var(3)
             591     1                       dist(jm)=fa1(jm)*var(jm-2)+fa2(jm)*var(jm-1)+fa3(jm)*var(jm)+fa4(jm)*var(1)
             592     1               
             593     1                       dist(1)=fa1(1)*var(jm-1)+fa2(1)*var(jm)+fa3(1)*var(1)+fa4(1)*var(2)
             594     1                       dist(jm+1)=dist(1)
             595     1               ! for equal latitude

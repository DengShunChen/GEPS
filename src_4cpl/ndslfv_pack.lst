                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2096     2                       do i=lonp,1,-1
            2097     3                         if( pnmin.ge.locs(i) .and. pnmin.lt.locs(i+1) ) then
            2098     3                           kstr = i
            2099     3                           go to 10
            2100     3                         endif
            2101     2                       enddo
            2102     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2103     2                       do i=lonp+1,2*lonp
            2104     3                         if( pnmin.ge.locs(i) .and. pnmin.lt.locs(i+1) ) then
            2105     3                           kstr = i
            2106     3                           go to 10
            2107     3                         endif
            2108     2                       enddo
            2109     1                     endif
            2110                           print *,' Error: can not find kstr: pnmin locs(1) locs(2*lonp) ',&
            2111                                                               pnmin,locs(1),locs(2*lonp)
            2112                           print *,' Error: pn(1) pn(2) pn(3) ',pn(1),pn(2),pn(3)
            2113                     
            2114                      10   kstr=max(3,kstr)
            2115                     
            2116     1                     if( pnmax.lt.locs(2*lonp+1) ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2117     2                       do i=2*lonp,lonp,-1
            2118     3                         if( pnmax.ge.locs(i) .and. pnmax.lt.locs(i+1) ) then
            2119     3                           kend = i+1
            2120     3                           go to 20
            2121     3                         endif
            2122     2                       enddo
            2123     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2124     2                       do i=2*lonp+1,3*lonp-1
            2125     3                         if( pnmax.ge.locs(i) .and. pnmax.lt.locs(i+1) ) then
            2126     3                           kend = i+1
            2127     3                           go to 20
            2128     3                         endif
            2129     2                       enddo
            2130     1                     endif
            2131                           print *,' Error: cannot get kend: pnmax locs(lonp) locs(3*lonp)',&
            2132                                                       kend, pnmax,locs(lonp),locs(3*lonp)
            2133                           print *,' Error: pn(lonn-1) pn(lonn) pn(lonn+1) ',               &
            2134                                            pn(lonn-1),pn(lonn),pn(lonn+1)
            2135                     
            2136                      20   kend=min(3*lonp-2,kend)
            2137                     !
            2138                     ! prepare grid spacing
            2139                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs, hh
                                   <<< Loop-information  End >>>
            2140     1       2v            do i=kstr-2,kend+2
            2141     1       2v              hh(i) = locs(i+1)-locs(i)
            2142     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hh, fn, fm
                                   <<< Loop-information  End >>>
            2143     1       2v            do i=kstr-1,kend+2
            2144     1       2v             cc = 1./(hh(i)+hh(i-1))
            2145     1       2v             fm(i) = hh(i  ) * cc
            2146     1       2v             fn(i) = hh(i-1) * cc
            2147     1       2v            enddo
            2148                     !
            2149                     ! prepare location with monotonic concerns
            2150                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2151,2163)
                                   <<<    PREFETCH(HARD) Expected by compiler :

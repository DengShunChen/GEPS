             906                           subroutine cyclic_cell_plm_intp(pp,qq,pn,qn,lons,nv,lonp,lonn,sc)
             907                     !
             908                     ! linear quick version of cyclic cell interpolation
             909                     !
             910                     ! pp    location at interfac point as input
             911                     ! qq    quantity at averaged-cell as input
             912                     ! pn    location at interface of new grid structure as input

            1955                     !
            1956                           subroutine ndslfv_update_3tl (lonsperlat,vdzonl,vdmerd,vdzonlr,vdmerdr,deltim)
            1957                     
            1958                     !  update all horizontal components into momentum eqs
            1959                     !  for Semi-Lagrangian vertical advection for 3tl
            1960                     
            1961                           use index
            1962                           use param, only : nx,my,lev,my_max
            1963                           use const, only : onocos,radsq,RTYPE
            1964                           use grid , only : dlphi,dtphi
            1965                     
            1966                           integer,intent(in):: lonsperlat(my)
            1967                           real(kind=RTYPE),   intent(in):: deltim
            1968                     
            1969                     !ch   real    vdmerd(nx+3,lev,my_max),vdzonl(nx+3,lev,my_max)
            1970                           real(kind=RTYPE) vdmerd(nxp,lev,my_max),vdzonl(nxp,lev,my_max)
            1971                           real(kind=RTYPE) vdmerdr(nxp,lev,my_max),vdzonlr(nxp,lev,my_max)
            1972                           integer i,ii,k,lan,lat,lons_lat
            1973                           integer dt2
            1974                     
            1975                           dt2 = 2. * deltim
            1976                     !
            1977                     !$omp parallel do                                                   &
            1978                     !$omp private(lan,lat,lons_lat,i,k)                                 &
            1979                     !$omp schedule(dynamic)
            1980     1   p                 do lan=1,jlistnum
            1981     1               !
            1982     1   p                   lat = jlist1(lan)
            1983     1   p                   lons_lat = lonsperlat(lat)
            1984     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerdr, vdzonlr, dtphi, dlphi, vdzonl
                                   <<<      vdmerd
                                   <<< Loop-information  End >>>
            1985     2   p                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.22, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerd, dtphi, dlphi, vdzonlr, vdzonl
                                   <<<      vdmerdr
                                   <<< Loop-information  End >>>
            1986     3   p    v               do i=1,lons_lat
            1987     3   p    v                 vdzonl(i,k,lan) = (vdzonlr(i,k,lan)-dlphi(i,k,lan)/radsq) &
            1988     3                                            * dt2 + vdzonl(i,k,lan)
            1989     3   p    v                 vdmerd(i,k,lan) = (vdmerdr(i,k,lan)-dtphi(i,k,lan)/radsq  &
            1990     3                                            / onocos(lat))*dt2 + vdmerd(i,k,lan)
            1991     3   p    v               enddo
            1992     2   p                   enddo
            1993     1   p                 enddo

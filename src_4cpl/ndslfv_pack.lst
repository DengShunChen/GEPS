                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mass, dqmono
                                   <<< Loop-information  End >>>
            2152     2        v            do i=kstr-2,kend+2
            2153     2        v              dqi = 0.25*(mass(i+1,n)-mass(i-1,n))
            2154     2        v              dqimax = max(mass(i-1,n),mass(i,n),mass(i+1,n)) - mass(i,n)
            2155     2        v              dqimin = mass(i,n) - min(mass(i-1,n),mass(i,n),mass(i+1,n))

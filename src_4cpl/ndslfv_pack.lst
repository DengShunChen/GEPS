             598     1               !        enddo
             599     1               ! over pole
             600     1               !        dist(2)=fa1*(var(2)+var(1 ))-fa2*(var(3)+var(jm  ))
             601     1               !        dist(1)=fa1*(var(1)+var(jm))-fa2*(var(2)+var(jm-1))
             602     1               !        dist(jm+1)=dist(1)
             603     1               !        dist(jm  )=fa1*(var(jm)+var(jm-1))-fa2*(var(1)+var(jm-2))
             604     1               !cflx   call def_cfl_max (jm+1,dist,ds,nstep)
             605     1                       call def_cfl_step(jm+1,dist,ds,step,nstep,lev+1-k,'advy')
             606     1               
             607     1               !
             608     1               ! advection all in y
             609     1               !
                                   <<< Loop-information Start >>>

                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ypast, ynext, dyfact
                                   <<< Loop-information  End >>>
             725     4       2v               do j=1,jmh
             726     4       2v                dyfact(j) = (ypast(j+1)-ypast(j)) / (ynext(j+1)-ynext(j))
             727     4       2v               enddo

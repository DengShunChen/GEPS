             941                           integer   js(lonn+1),ix4i(lonp+2),i4j(lonp+lonn+3)
             942                           integer   i,j,n,ip,ix,is,in
             943                     !
             944                           hfsc = 0.5 * sc
             945                     !
             946                     ! arrange input array cover output location with cyclic boundary
             947                     ! condition
             948                     !
             949                     ! bring input location close to output location
             950                     ! and cover output starting point.
             951     1                     if( pp(1).ne.pn(1) ) then
             952     2                       if( pp(1).gt.pn(1) ) then
             953     2                         shift = (int((pn(1)-pp(1))/sc)-1) * sc
             954     2                       else
             955     2                         shift =  int((pn(1)-pp(1))/sc) * sc
             956     2                       endif

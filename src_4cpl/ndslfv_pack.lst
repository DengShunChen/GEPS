            2183                     !
            2184                     ! do monotonicity within cell
            2185                     !
            2186                           r6 = 1./6.
            2187     1                     if( mono.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mass, qpi, qmi

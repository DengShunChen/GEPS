 External subroutine subprogram "prexp"
  (inc)(line-no.)(nest)(optimize)
             521                     
             522                     
             523                           subroutine prexp ( nx,lev,ptop,sig,pt,pk,pk2,plt )
             524                     !c
             525                     !c  subroutine to compute p to the kapa on odd and even levels
             526                     !c
             527                     !c *** input ****
             528                     !c
             529                     !c  nx: e-w dimension no.
             530                     !c  lev: number of vertical levels
             531                     !c  sig: sigma levels
             532                     !c  pt: terrain pressure
             533                     !c
             534                     !c *** output ***
             535                     !c
             536                     !c  pk: odd (full) level p**capa
             537                     !c  pk2: even( half) level p**capa
             538                     !c
             539                     !c **************************************************
             540                     !c
             541                     !c
             542                           dimension pt(nx),pk2(nx,lev),pk(nx,lev),sig(lev+1) &
             543                           ,         plt(nx,lev)
             544                     !c
             545                     !csun  include '../include/paramt.h'  .. change im to nx
             546                           dimension pl2(nx,2)
             547                     !c
             548                     !c  compute  pressure variables
             549                     !c
             550                           capa  = 1.0/3.5
             551                           capap1= 1.0+capa
             552                           opok  = 1.0/1000.0**capa
             553                     !c
             554                           kbot= 1
             555                           k= 1
             556                           ptopk= ptop*opok*ptop**capa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.12, ITR: 80, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pl2, pk2, plt, pt
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 52
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             557     1  pp    v            do 80 i=1, nx
             558     1   p    v            pl2(i,kbot)= sig(2)*pt(i)+ptop
             559     1   p    v            pk2(i,1)   = opok*pl2(i,kbot)**capa
             560     1   p    v            pk(i,k)    = (pl2(i,kbot)*pk2(i,k)-ptopk)  &
             561     1                               / (capap1*(pl2(i,kbot)-ptop))
             562     1   p    v            plt(i,k)   = 1000.0*pk(i,k)*pk(i,k)*pk(i,k)*sqrt(pk(i,k))
             563     1   p    v         80 continue
             564                     !c
             565     1                     do 90 k = 2, lev
             566     1                     ktop= kbot
             567     1                     kbot= 3 - ktop
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pl2, pk2, pk, plt
                                   <<< Loop-information  End >>>
             568     2  pp    v            do 90 i = 1, nx
             569     2   p    v            pl2(i,kbot)= sig(k+1)*pt(i)+ptop
             570     2   p    v            pk2(i,k)   = opok*pl2(i,kbot)**capa
             571     2   p    v            pk(i,k)    = (pl2(i,kbot)*pk2(i,k)-pl2(i,ktop)*pk2(i,k-1))  &
             572     2                               / (capap1*(pl2(i,kbot)-pl2(i,ktop)))
             573     2   p    v            plt(i,k)   = 1000.0*pk(i,k)*pk(i,k)*pk(i,k)*sqrt(pk(i,k))
             574     1   p    v         90 continue
             575                     !c
             576                           return
             577                           end


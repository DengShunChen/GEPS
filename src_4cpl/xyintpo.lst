  (inc)(line-no.)(nest)(optimize)
             230                     
             231                           subroutine bcubij(f,ix,jy,dout,mn,xin,yin)
             232                     !c
             233                     !c  parameter list
             234                     !c
             235                     !c  f,ix,jy,dout,mn,xin,yin - see below
             236                     !c
             237                           dimension f(ix,jy),dout(mn),xin(mn),yin(mn)
             238                     !c
             239                     !c
             240                     !c  working array
             241                           dimension fxx(ix,jy),fyy(ix,jy),pix(mn,4),pjy(mn,4)  &
             242                          , tp1(mn,4),tp2(mn,4),tp3(ix,jy)
             243                           dimension ipt(mn)
             244                     !c
             245                     !c          a bicubic spline interpolator to interpolate from a grid
             246                     !c          with constant grid spacing to a grid with constant or
             247                     !c          variable grid spacing. all grids are assumed to have point
             248                     !c          (1,1) in the lower left corner with i increasing to the right
             249                     !c          and j increasing upward.
             250                     !c
             251                     !c          arguments:
             252                     !c
             253                     !c          f(ix,jy): fwa of data array to be interpolated from (given
             254                     !c                    by user)
             255                     !c
             256                     !c          ix: first (i) dimension of f (given by user)
             257                     !c
             258                     !c          jy: second (j) dimension of f (given by user)
             259                     !c
             260                     !c          dout(mn): fwa of array of interpolated values (given on
             261                     !c                     output)
             262                     !c
             263                     !c
             264                     !c         mn: number of points (dimension) of output grid
             265                     !c
             266                     !c          xin(mn): x-coordinates of points in dout relative to the
             267                     !c                   x-coordinates of f. a "1" refers to the leftmost
             268                     !c                   boundary of f (given by user)
             269                     !c
             270                     !c          yin(mn): y-coordinates of points in dout relative to the
             271                     !c                   y-corrdinates of f. a "1" refers to the bottom
             272                     !c                   row of f (given by user)
             273                     !c
             274                     !c   scratch work arrays
             275                     !c
             276                     !c          pix(mn,4): array to hold coefficients for interpolation in
             277                     !c                     x-direction
             278                     !c
             279                     !c          pjy(mn,4): array to hold coefficients for interpolation in
             280                     !c                     y-direction
             281                     !c
             282                     !c          tp1(mn,4): work space
             283                     !c
             284                     !c          tp2(mn,4): work space
             285                     !c
             286                     !c          tp3(ix,jy): work space
             287                     !c
             288                     !c          fxx(ix,jy): array to hold cubic spline values (computed
             289                     !c                      internally)
             290                     !c
             291                     !c          fyy(ix,jy): array to hold cubic spline values (computed
             292                     !c                      internally)
             293                     !c
             294                     !c          ipt(mn): array that holds 2-d coordinate, relative to f grid,
             295                     !c                   of each point in dout
             296                     !c
             297                     !c          compute ipt,jpt,pix and pjy
             298                     !c
             299                           call stupij(xin,yin,mn,ix,pix,pjy,ipt)
             300                     !c
             301                           ijm2=ix*jy-2
             302                           ixjym2=ix*(jy-2)
             303                     !c
             304                     !c          interpolate in x-direction
             305                     !c
             306                     !c          compute fyy
             307                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, fyy
                                   <<< Loop-information  End >>>
             308     1  pp   2v            do 100 i=1,ixjym2
             309     1   p   2v            fyy(i,2)=(f(i,1)-2.0*f(i,2)+f(i,3))
             310     1   p   2v        100 continue
             311                           call trdih(ix,jy-2,fyy(1,2))
             312                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
             313     1  pp   2v            do 105 i=1,ix
             314     1   p   2v            fyy(i,1)= 0.0
             315     1   p   2v            fyy(i,jy)= 0.0
             316     1   p   2v        105 continue
             317                     !c
             318                     !c          compute fxxyy
             319                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy, fxx
                                   <<< Loop-information  End >>>
             320     1  pp   2v            do 130 i=1,ijm2
             321     1   p   2v            fxx(i+1,1)= fyy(i,1)+(fyy(i+2,1)-2.0*fyy(i+1,1))
             322     1   p   2v        130 continue
             323                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.30, ITR: 128, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             324     1  pp   2v            do 205 j=1,jy
             325     1   p   2v            fxx(1,j)= fyy(ix,j)-2.0*fyy(1,j)+fyy(2,j)
             326     1   p   2v            fxx(ix,j)= fyy(ix-1,j)-2.0*fyy(ix,j)+fyy(1,j)
             327     1   p   2v        205 continue
             328                     !c
             329          i                call tpose(fxx,ix,jy,tp3)
             330                           call trdiph(jy,ix,tp3)
             331          i                call tpose(tp3,jy,ix,fxx)
             332                     !c
             333                     !c          fxx holds fxxyy and fyy holds fyy
             334                     !c
             335                           call gathij(1,mn,ix,jy,ipt,fxx,fyy,tp2)
             336                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.72, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pix, tp2, tp1
                                   <<< Loop-information  End >>>
             337     1  pp    v            do 550 i=1,mn
             338     1   p    v            tp2(i,1)= pix(i,1)*tp2(i,1)
             339     1   p    v            tp2(i,2)= pix(i,2)*tp2(i,2)
             340     1   p    v            tp2(i,3)= pix(i,3)*tp2(i,3)
             341     1   p    v            tp2(i,4)= pix(i,4)*tp2(i,4)
             342     1   p    v            tp1(i,1)=tp2(i,1)+tp2(i,2)+tp2(i,3)+tp2(i,4)
             343     1   p    v        550 continue
             344                     !c
             345                           call gathij(0,mn,ix,jy,ipt,fxx,fyy,tp2)
             346                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.72, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pix, tp2, tp1
                                   <<< Loop-information  End >>>
             347     1  pp    v            do 555 i=1,mn
             348     1   p    v            tp2(i,1)= pix(i,1)*tp2(i,1)
             349     1   p    v            tp2(i,2)= pix(i,2)*tp2(i,2)
             350     1   p    v            tp2(i,3)= pix(i,3)*tp2(i,3)
             351     1   p    v            tp2(i,4)= pix(i,4)*tp2(i,4)
             352     1   p    v            tp1(i,2)=tp2(i,1)+tp2(i,2)+tp2(i,3)+tp2(i,4)
             353     1   p    v        555 continue
             354                     !c
             355                     !c          compute fxx
             356                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, fxx
                                   <<< Loop-information  End >>>
             357     1  pp   2v            do 170 i=1,ijm2
             358     1   p   2v            fxx(i+1,1)= f(i,1)+f(i+2,1)-2.0*f(i+1,1)
             359     1   p   2v        170 continue
             360                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.30, ITR: 128, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             361     1  pp   2v            do 155 j=1,jy
             362     1   p   2v            fxx(1,j)= f(ix,j)-2.0*f(1,j)+f(2,j)
             363     1   p   2v            fxx(ix,j)= f(ix-1,j)-2.0*f(ix,j)+f(1,j)
             364     1   p   2v        155 continue
             365                     !c
             366          i                call tpose(fxx,ix,jy,tp3)
             367                           call trdiph(jy,ix,tp3)
             368          i                call tpose(tp3,jy,ix,fxx)
             369                     !c
             370                           call gathij(1,mn,ix,jy,ipt,fxx,f,tp2)
             371                     !c
                                   <<< Loop-information Start >>>

 External subroutine subprogram "phi2pt"
  (inc)(line-no.)(nest)(optimize)
             578                     
             579                           subroutine phi2pt(nx,my,lmax,zz,anlslp,t1000,puvphi,sgeo,pt)
             580                     !c
             581                           use const, only: RTYPE
             582                     !c
             583                           dimension sgeo(nx,my),pt(nx,my),zz(nx,my,lmax)
             584                           dimension fld1(nx,lmax+2,my),fld2(nx,lmax+2,my),t1000(nx,my) &
             585                                  , anlslp(nx,my)                                       &
             586                                  , hld1(nx,my),hld2(nx,my)                             &
             587                                  , tens(lmax+2)
             588                           dimension phistd(lmax),puvphi(lmax),pdiff(nx,my)
             589                           real(kind=RTYPE) presp(nx,lmax+2,my)
             590                     !c
             591                           data cp/1004.24/, grav/9.80616/
             592                     !c
             593                           capa= 1.0/3.5
             594                           rgas= capa*cp
             595                     !c
             596                           lmaxp1= lmax + 1
             597                           lmaxp2= lmax + 2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             598     1  pp   4v            do 20 k = 1, lmaxp2
             599     1   p   4v            tens(k) = 1.0
             600     1   p   4v        20  continue
             601                           tens(lmaxp2) = 0.0
             602                           tens(1) = 0.0
             603                     !c
             604                           call geostd ( lmax,puvphi,phistd )
             605                     !c
             606                     !c  read geopotential height
             607                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.02, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      puvphi, zz, fld1, presp, fld2, (unknown)
                                   <<< Loop-information  End >>>
             608     1  pp    v            do 60 k=1,lmax
             609     1   p    v            pstdt= log(puvphi(k))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             610     2  pp                 do 50 j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fld1, presp, zz, fld2
                                   <<< Loop-information  End >>>
             611     3   p   2v            do 50 i=1,nx
             612     3   p   2v            presp(i,k+1,j)= pstdt
             613     3   p   2v            fld2(i,k+1,j)= -grav*zz(i,j,k)
             614     3   p   2v            fld1(i,k+1,j)= -grav*phistd(k)-fld2(i,k+1,j)
             615     2   p   2v        50  continue
             616     1   p             60  continue
             617                     !c
             618                     !c  initialization of terrain pressure
             619                     !c
             620                     !c  define bottom & top boundary condition for pt interpolation
             621                     !c
             622                           l1= 1
             623                           alaps= 6.5e-4
             624                           eps = 0.001
             625                           call ttstd ( 1, 1.0, tp00 )
             626                           call ttstd ( 1, puvphi(1), tp01 )
             627                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fld2, anlslp, hld1, sgeo, pt, presp
                                   <<<      t1000
                                   <<< Loop-information  End >>>
             628     1                     do 130 j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 39
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.58, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, t1000, fld2, anlslp, presp, hld1
                                   <<<      pt
                                   <<< Loop-information  End >>>
             629     2  pp    v            do 132 i=1,nx
             630     2   p    v            hld1(i,j)= anlslp(i,j)
             631     2   p    v            pt(i,j)  = 0.1
             632     2               !c
             633     2               !c dealing with inconsistency between anlslp and 1000hPa height
             634     2               !c 2009/12/10
             635     3   p    v            if( fld2(i,lmaxp1,j).gt.0 .and. anlslp(i,j).ge.1000.)then
             636     3   p    v              pxx = log(hld1(i,j))
             637     3   p    v              pt(i,j) = fld2(i,lmaxp1,j)  &
             638     3                              +rgas*t1000(i,j)*(pxx-presp(i,lmaxp1,j))
             639     3   p    v            endif
             640     2               !c
             641     3   p    v            if(sgeo(i,j).le.-1.0) then
             642     3   p    v              px= sgeo(i,j)/(rgas*(t1000(i,j)-alaps*0.5*sgeo(i,j)))
             643     3   p    v              hld1(i,j)= hld1(i,j)*(1.0-px)
             644     3   p    v              pt(i,j)  =-sgeo(i,j) + 0.1
             645     3   p    v            endif
             646     2   p    v        132 continue
             647     1                     call geostd (nx,hld1(1,j),hld2(1,j))
             648     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 35
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, pdiff, hld1, presp, fld1, hld2, pt
                                   <<<      fld2
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      fld2: 6
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             649     2  pp    v            do 133 i=1,nx
             650     2   p    v            hld1(i,j) = log(hld1(i,j))
             651     2               !ccc   if ( hld1(i,j) .le. (presp(i,lmaxp1,j)+eps) )  then
             652     3   p    v            if ( hld1(i,j) .le. presp(i,lmaxp1,j) )  then
             653     3   p    v              presp(i,lmaxp2,j)= 2.0*presp(i,lmaxp1,j) - presp(i,lmax,j)
             654     3   p    v              fld2(i,lmaxp2,j) = 2.0*fld2(i,lmaxp1,j) - fld2(i,lmax,j)
             655     3   p    v              fld1(i,lmaxp2,j) = fld1(i,lmaxp1,j)
             656     3   p    v            else
             657     3   p    v              presp(i,lmaxp2,j)= hld1(i,j)
             658     3   p    v              fld2(i,lmaxp2,j) = pt(i,j)
             659     3   p    v              fld1(i,lmaxp2,j) =-fld2(i,lmaxp2,j)-grav*hld2(i,j)
             660     3   p    v            endif
             661     2   p    v            presp(i,1,j)= log(1.0)
             662     2   p    v            fld2(i,1,j) = fld2(i,2,j) - rgas*tp00*(presp(i,2,j)-presp(i,1,j))
             663     2   p    v            fld1(i,1,j) = fld1(i,2,j)
             664     2               !c
             665     2   p    v            pdiff(i,j)  = -sgeo(i,j)
             666     2   p    v            if ((sgeo(i,j).le.0.0).and.(sgeo(i,j).ge.(-1.0+eps)))  &
             667     2                      pdiff(i,j)= 0.0
             668     2               !c
             669     2   p    v        133 continue
             670     1               !c
             671     1               !c  interpolate to get terrain pressure
             672     1               !c  interpolation is of log p - cubic as function of geopotential
             673     1               !c  output is log p in array pt
             674     1               !c
             675     1                     call vterpj( nx,lmaxp2,l1,fld2(1,1,j),presp(1,1,j),pdiff(1,j) &
             676     1                               , pt(1,j),tens)
             677     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt
                                   <<< Loop-information  End >>>
             678     2  pp    v            do 135 i=1,nx
             679     2   p    v            pt(i,j)= exp(pt(i,j))
             680     2   p    v        135 continue
             681     1                 130 continue
             682                     !c
             683                           return
             684                           end


             432                           ne = nt2
             433                           work(ne-1) = 1.0/(4.0-work(n-2))
             434                           nu = nt2+n
             435                           work(n-1) = (1.0-work(nu-2))*work(ne-1)
             436                           work(ne) = 1.0/(bn-v*work(n-1))
             437                     !c
             438                           v= 1.0
             439                     !DIR$ IVDEP
             440                     !ocl  novrec

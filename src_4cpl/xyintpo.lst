             479                           subroutine gathij(kp,mn,ix,jy,ijpt,fxx,f,tp2)
             480                     !c
             481                           dimension fxx(ix*jy),f(ix*jy),tp2(mn,4)
             482                           dimension ijpt(mn)
             483                     !c
             484     1                     if(kp.eq.0) then
             485     1               !c
             486     1               !c  lower left corner of interpolation square
             487     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp2, ijpt
                                   <<< Loop-information  End >>>
             488     2  pp   2v            do 10 i=1,mn
             489     2   p   2v            inx= ijpt(i)-ix
             490     2   p   2v            tp2(i,2)= fxx(inx)
             491     2   p   2v            tp2(i,4)= f  (inx)
             492     2   p   2v         10 continue
             493     1               !c
             494     1                     else
             495     1               !c
             496     1               !c  upper left corner of interpolation square
             497     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

             406                           subroutine trdiph (m,n,y)
             407                     !c
             408                     !c  vectorized periodic gaussian elimination solver
             409                     !c
             410                     !      dimension y(m,n),work(10000)
             411                           dimension y(m,n),work(m+3*n)  ! wei 20231019
             412                     !c
             413                     !c gaussian elimination
             414                     !c
             415                           nt2= 2*n
             416                           work(n+1)= 0.25
             417                           v = 1.0
             418                           work(1) = work(n+1)
             419                           work(nt2+1) = work(n+1)
             420                           bn = -v*work(nt2+1)+4.0
                                   <<< Loop-information Start >>>

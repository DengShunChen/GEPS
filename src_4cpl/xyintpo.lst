                                   <<< Loop-information  End >>>
             421     1   s   8s            do 101 j=2,n-2
             422     1   p   8v              ne = j+n
             423     1   s   8s              work(ne) = 1.0/(4.0-work(j-1))
             424     1   s   8s              work(j) = work(ne)
             425     1   s   8s              nu = j+nt2
             426     1   s   8s              work(nu) = -work(nu-1)*work(ne)
             427     1   s   8s              v = -v*work(j-1)
             428     1   m   8m              bn = bn-v*work(nu)
             429     1   p   8v        101 continue
             430                     !c

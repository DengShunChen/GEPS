                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ijpt, tp2
                                   <<< Loop-information  End >>>
             498     2  pp   2v            do 20 i=1,mn
             499     2   p   2v            tp2(i,2)= fxx(ijpt(i))
             500     2   p   2v            tp2(i,4)= f  (ijpt(i))
             501     2   p   2v         20 continue
             502     1                     endif
             503                     !c
             504     1                     if(kp.eq.0) then
             505     1               !c  lower right corner of interpolation square
             506     1                     i1= 1-ix
             507     1                     else
             508     1               !c  upper right corner of interpolation square
             509     1                     i1= 1
             510     1                     endif
             511                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.40, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ijpt, tp2
                                   <<< Loop-information  End >>>
             512     1  pp    v            do 30 i=1,mn
             513     1   p    v            inx= ijpt(i)+i1
             514     1   p    v            if(mod(inx,ix).eq.1) inx= inx-ix
             515     1   p    v            tp2(i,1)= fxx(inx)
             516     1   p    v            tp2(i,3)= f  (inx)
             517     1   p    v         30 continue
             518                     !c
             519                           return
             520                           end


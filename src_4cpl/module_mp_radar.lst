             167                           xcge(2) = 1. + xmu_g
             168                           xcge(3) = 1. + xbm_g + xmu_g
             169                           xcge(4) = 1. + 2.*xbm_g + xmu_g
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             170     1       f             do n = 1, 4
             171     1    i  f                xcgg(n) = WGAMMA(xcge(n))
             172     1       f             enddo
             173                           xogg2 = 1./xcgg(2)
             174                     
             175                           xobmr = 1./xbm_r
             176                           xoams = 1./xam_s

             101     1       2                hostinclusionstring_g(n:n) = char(0)
             102     1       2             enddo
             103                     
             104                           mixingrulestring_s = 'maxwellgarnett'
             105                           hoststring_s = 'air'
             106                           matrixstring_s = 'water'
             107                           inclusionstring_s = 'spheroidal'
             108                           hostmatrixstring_s = 'icewater'
             109                           hostinclusionstring_s = 'spheroidal'
             110                     

             112                           hoststring_g = 'air'
             113                           matrixstring_g = 'water'
             114                           inclusionstring_g = 'spheroidal'
             115                           hostmatrixstring_g = 'icewater'
             116                           hostinclusionstring_g = 'spheroidal'
             117                     
             118                     !..Create bins of snow (from 100 microns up to 2 cm).
             119                           xxDx(1) = 100.D-6
             120                           xxDx(nrbins+1) = 0.02d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

              37                           DOUBLE PRECISION, DIMENSION(nrbins+1), PUBLIC:: xxDx
              38                           DOUBLE PRECISION, DIMENSION(nrbins), PUBLIC:: xxDs,xdts,xxDg,xdtg
              39                           DOUBLE PRECISION, PARAMETER, PUBLIC:: lamda_radar = 0.10           ! in meters
              40                           DOUBLE PRECISION, PUBLIC:: K_w, PI5, lamda4
              41                           COMPLEX*16, PUBLIC:: m_w_0, m_i_0
              42                           DOUBLE PRECISION, DIMENSION(nrbins+1), PUBLIC:: simpson
              43                           DOUBLE PRECISION, DIMENSION(3), PARAMETER, PUBLIC:: basis =       &
              44                                                (/1.d0/3.d0, 4.d0/3.d0, 1.d0/3.d0/)
              45                           REAL, DIMENSION(4), PUBLIC:: xcre, xcse, xcge, xcrg, xcsg, xcgg
              46                           REAL, PUBLIC:: xam_r, xbm_r, xmu_r, xobmr
              47                           REAL, PUBLIC:: xam_s, xbm_s, xmu_s, xoams, xobms, xocms
              48                           REAL, PUBLIC:: xam_g, xbm_g, xmu_g, xoamg, xobmg, xocmg
              49                           REAL, PUBLIC:: xorg2, xosg2, xogg2
              50                     
              51                           INTEGER, PARAMETER, PUBLIC:: slen = 20
              52                           CHARACTER(len=slen), PUBLIC::                                     &
              53                                   mixingrulestring_s, matrixstring_s, inclusionstring_s,    &
              54                                   hoststring_s, hostmatrixstring_s, hostinclusionstring_s,  &
              55                                   mixingrulestring_g, matrixstring_g, inclusionstring_g,    &
              56                                   hoststring_g, hostmatrixstring_g, hostinclusionstring_g
              57                     

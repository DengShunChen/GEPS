              89     1       2             do n = 1, slen
              90     1       2                mixingrulestring_s(n:n) = char(0)
              91     1       2                matrixstring_s(n:n) = char(0)
              92     1       2                inclusionstring_s(n:n) = char(0)
              93     1       2                hoststring_s(n:n) = char(0)

             188                     
             189                           COMPLEX*16 FUNCTION m_complex_water_ray(lambda,T)
             190                     
             191                     !      Complex refractive Index of Water as function of Temperature T
             192                     !      [deg C] and radar wavelength lambda [m]; valid for
             193                     !      lambda in [0.001,1.0] m; T in [-10.0,30.0] deg C
             194                     !      after Ray (1972)
             195                     
             196                           IMPLICIT NONE
             197                           DOUBLE PRECISION, INTENT(IN):: T,lambda
             198                           DOUBLE PRECISION:: epsinf,epss,epsr,epsi
             199                           DOUBLE PRECISION:: alpha,lambdas,sigma,nenner
             200                           COMPLEX*16, PARAMETER:: i = (0d0,1d0)
             201                           DOUBLE PRECISION, PARAMETER:: PIx=3.1415926535897932384626434d0
             202                     
             203                           epsinf  = 5.27137d0 + 0.02164740d0 * T - 0.00131198d0 * T*T
             204                           epss    = 78.54d+0 * (1.0 - 4.579d-3 * (T - 25.0)                 &
             205                                   + 1.190d-5 * (T - 25.0)*(T - 25.0)                        &
             206                                   - 2.800d-8 * (T - 25.0)*(T - 25.0)*(T - 25.0))
             207                           alpha   = -16.8129d0/(T+273.16) + 0.0609265d0
             208                           lambdas = 0.00033836d0 * exp(2513.98d0/(T+273.16)) * 1e-2
             209                     
             210                           nenner = 1.d0+2.d0*(lambdas/lambda)**(1d0-alpha)*sin(alpha*PIx*0.5) &
             211                                  + (lambdas/lambda)**(2d0-2d0*alpha)
             212                           epsr = epsinf + ((epss-epsinf) * ((lambdas/lambda)**(1d0-alpha)   &
             213                                * sin(alpha*PIx*0.5)+1d0)) / nenner
             214                           epsi = ((epss-epsinf) * ((lambdas/lambda)**(1d0-alpha)            &
             215                                * cos(alpha*PIx*0.5)+0d0)) / nenner                           &
             216                                + lambda*1.25664/1.88496
             217                     
             218                           m_complex_water_ray = SQRT(CMPLX(epsr,-epsi))
             219                     
             220                           END FUNCTION m_complex_water_ray
             221                     
             222                     !+---+-----------------------------------------------------------------+
             223                     
             224                           COMPLEX*16 FUNCTION m_complex_ice_maetzler(lambda,T)
             225                     
             226                     !      complex refractive index of ice as function of Temperature T
             227                     !      [deg C] and radar wavelength lambda [m]; valid for
             228                     !      lambda in [0.0001,30] m; T in [-250.0,0.0] C
             229                     !      Original comment from the Matlab-routine of Prof. Maetzler:
             230                     !      Function for calculating the relative permittivity of pure ice in
             231                     !      the microwave region, according to C. Maetzler, "Microwave
             232                     !      properties of ice and snow", in B. Schmitt et al. (eds.) Solar
             233                     !      System Ices, Astrophys. and Space Sci. Library, Vol. 227, Kluwer
             234                     !      Academic Publishers, Dordrecht, pp. 241-257 (1998). Input:
             235                     !      TK = temperature (K), range 20 to 273.15
             236                     !      f = frequency in GHz, range 0.01 to 3000
             237                     
             238                           IMPLICIT NONE
             239                           DOUBLE PRECISION, INTENT(IN):: T,lambda
             240                           DOUBLE PRECISION:: f,c,TK,B1,B2,b,deltabeta,betam,beta,theta,alfa
             241                     
             242                           c = 2.99d8
             243                           TK = T + 273.16
             244                           f = c / lambda * 1d-9
             245                     
             246                           B1 = 0.0207
             247                           B2 = 1.16d-11
             248                           b = 335.0d0
             249                           deltabeta = EXP(-10.02 + 0.0364*(TK-273.16))
             250                           betam = (B1/TK) * ( EXP(b/TK) / ((EXP(b/TK)-1)**2) ) + B2*f*f
             251                           beta = betam + deltabeta
             252                           theta = 300. / TK - 1.
             253                           alfa = (0.00504d0 + 0.0062d0*theta) * EXP(-22.1d0*theta)
             254                           m_complex_ice_maetzler = 3.1884 + 9.1e-4*(TK-273.16)
             255                           m_complex_ice_maetzler = m_complex_ice_maetzler                   &
             256                                                  + CMPLX(0.0d0, (alfa/f + beta*f))
             257                           m_complex_ice_maetzler = SQRT(CONJG(m_complex_ice_maetzler))
             258                     
             259                           END FUNCTION m_complex_ice_maetzler
             260                     
             261                     !+---+-----------------------------------------------------------------+
             262                     
             263                           subroutine rayleigh_soak_wetgraupel (x_g, a_geo, b_geo, fmelt,    &
             264                                          meltratio_outside, m_w, m_i, lambda, C_back,       &
             265                                          mixingrule,matrix,inclusion,                       &
             266                                          host,hostmatrix,hostinclusion)
             267                     
             268                           IMPLICIT NONE
             269                     
             270                           DOUBLE PRECISION, INTENT(in):: x_g, a_geo, b_geo, fmelt, lambda,  &
             271                                                          meltratio_outside
             272                           DOUBLE PRECISION, INTENT(out):: C_back
             273                           COMPLEX*16, INTENT(in):: m_w, m_i
             274                           CHARACTER(len=*), INTENT(in):: mixingrule, matrix, inclusion,     &
             275                                                          host, hostmatrix, hostinclusion
             276                     
             277                           COMPLEX*16:: m_core, m_air
             278                           DOUBLE PRECISION:: D_large, D_g, rhog, x_w, xw_a, fm, fmgrenz,    &
             279                                              volg, vg, volair, volice, volwater,            &
             280                                              meltratio_outside_grenz, mra
             281                           INTEGER:: error
             282                           DOUBLE PRECISION, PARAMETER:: PIx=3.1415926535897932384626434d0
             283                     
             284                     !     refractive index of air:
             285                           m_air = (1.0d0,0.0d0)
             286                     
             287                     !     Limiting the degree of melting --- for safety:
             288                           fm = DMAX1(DMIN1(fmelt, 1.0d0), 0.0d0)
             289                     !     Limiting the ratio of (melting on outside)/(melting on inside):
             290                           mra = DMAX1(DMIN1(meltratio_outside, 1.0d0), 0.0d0)
             291                     
             292                     !    ! The relative portion of meltwater melting at outside should increase
             293                     !    ! from the given input value (between 0 and 1)
             294                     !    ! to 1 as the degree of melting approaches 1,
             295                     !    ! so that the melting particle "converges" to a water drop.
             296                     !    ! Simplest assumption is linear:
             297                           mra = mra + (1.0d0-mra)*fm
             298                     
             299                           x_w = x_g * fm
             300                     
             301                           D_g = a_geo * x_g**b_geo
             302                     
             303     1                     if (D_g .ge. 1d-12) then
             304     1               
             305     1                      vg = PIx/6. * D_g**3
             306     1                      rhog = DMAX1(DMIN1(x_g / vg, 900.0d0), 10.0d0)
             307     1                      vg = x_g / rhog
             308     1               
             309     1                      meltratio_outside_grenz = 1.0d0 - rhog / 1000.
             310     1               
             311     2                      if (mra .le. meltratio_outside_grenz) then
             312     2                       !..In this case, it cannot happen that, during melting, all the
             313     2                       !.. air inclusions within the ice particle get filled with
             314     2                       !.. meltwater. This only happens at the end of all melting.
             315     2                       volg = vg * (1.0d0 - mra * fm)
             316     2               
             317     2                      else
             318     2                       !..In this case, at some melting degree fm, all the air
             319     2                       !.. inclusions get filled with meltwater.
             320     2                       fmgrenz=(900.0-rhog)/(mra*900.0-rhog+900.0*rhog/1000.)
             321     2               
             322     3                       if (fm .le. fmgrenz) then
             323     3                        !.. not all air pockets are filled:
             324     3                        volg = (1.0 - mra * fm) * vg
             325     3                       else
             326     3                        !..all air pockets are filled with meltwater, now the
             327     3                        !.. entire ice sceleton melts homogeneously:
             328     3                        volg = (x_g - x_w) / 900.0 + x_w / 1000.
             329     3                       endif
             330     2               
             331     2                      endif
             332     1               
             333     1                      D_large  = (6.0 / PIx * volg) ** (1./3.)
             334     1                      volice = (x_g - x_w) / (volg * 900.0)
             335     1                      volwater = x_w / (1000. * volg)
             336     1                      volair = 1.0 - volice - volwater
             337     1               
             338     1                      !..complex index of refraction for the ice-air-water mixture
             339     1                      !.. of the particle:
             340     1                      m_core = get_m_mix_nested (m_air, m_i, m_w, volair, volice,      &
             341     1                                        volwater, mixingrule, host, matrix, inclusion, &
             342     1                                        hostmatrix, hostinclusion, error)
             343     2                      if (error .ne. 0) then
             344     2                       C_back = 0.0d0
             345     2                       return
             346     2                      endif
             347     1               
             348     1                      !..Rayleigh-backscattering coefficient of melting particle:
             349     1                      C_back = (ABS((m_core**2-1.0d0)/(m_core**2+2.0d0)))**2           &
             350     1                               * PI5 * D_large**6 / lamda4
             351     1               
             352     1                     else
             353     1                      C_back = 0.0d0
             354     1                     endif
             355                     
             356                           end subroutine rayleigh_soak_wetgraupel
             357                     
             358                     !+---+-----------------------------------------------------------------+
             359                     
             360                           complex*16 function get_m_mix_nested (m_a, m_i, m_w, volair,      &
             361                                          volice, volwater, mixingrule, host, matrix,        &
             362                                          inclusion, hostmatrix, hostinclusion, cumulerror)
             363                     
             364                           IMPLICIT NONE
             365                     
             366                           DOUBLE PRECISION, INTENT(in):: volice, volair, volwater
             367                           COMPLEX*16, INTENT(in):: m_a, m_i, m_w
             368                           CHARACTER(len=*), INTENT(in):: mixingrule, host, matrix,          &
             369                                          inclusion, hostmatrix, hostinclusion
             370                           INTEGER, INTENT(out):: cumulerror
             371                     
             372                           DOUBLE PRECISION:: vol1, vol2
             373                           COMPLEX*16:: mtmp
             374                           INTEGER:: error
             375                     
             376                           !..Folded: ( (m1 + m2) + m3), where m1,m2,m3 could each be
             377                           !.. air, ice, or water
             378                     
             379                           cumulerror = 0
             380                           get_m_mix_nested = CMPLX(1.0d0,0.0d0)
             381                     
             382     1                     if (host .eq. 'air') then
             383     1               
             384     2                      if (matrix .eq. 'air') then
             385     2                       write(*,*) 'GET_M_MIX_NESTED: bad matrix: ', matrix
             386     2                       cumulerror = cumulerror + 1
             387     2                      else
             388     2                       vol1 = volice / MAX(volice+volwater,1d-10)
             389     2                       vol2 = 1.0d0 - vol1
             390     2                       mtmp = get_m_mix (m_a, m_i, m_w, 0.0d0, vol1, vol2,             &
             391     2                                        mixingrule, matrix, inclusion, error)
             392     2                       cumulerror = cumulerror + error
             393     2               
             394     3                       if (hostmatrix .eq. 'air') then
             395     3                        get_m_mix_nested = get_m_mix (m_a, mtmp, 2.0*m_a,              &
             396     3                                        volair, (1.0d0-volair), 0.0d0, mixingrule,     &
             397     3                                        hostmatrix, hostinclusion, error)
             398     3                        cumulerror = cumulerror + error
             399     3                       elseif (hostmatrix .eq. 'icewater') then
             400     3                        get_m_mix_nested = get_m_mix (m_a, mtmp, 2.0*m_a,              &
             401     3                                        volair, (1.0d0-volair), 0.0d0, mixingrule,     &
             402     3                                        'ice', hostinclusion, error)
             403     3                        cumulerror = cumulerror + error
             404     3                       else
             405     3                        write(*,*) 'GET_M_MIX_NESTED: bad hostmatrix: ',        &
             406     3                                          hostmatrix
             407     3                        cumulerror = cumulerror + 1
             408     3                       endif
             409     2                      endif
             410     1               
             411     1                     elseif (host .eq. 'ice') then
             412     1               
             413     2                      if (matrix .eq. 'ice') then
             414     2                       write(radar_debug,*) 'GET_M_MIX_NESTED: bad matrix: ', matrix
             415     2                       cumulerror = cumulerror + 1
             416     2                      else
             417     2                       vol1 = volair / MAX(volair+volwater,1d-10)
             418     2                       vol2 = 1.0d0 - vol1
             419     2                       mtmp = get_m_mix (m_a, m_i, m_w, vol1, 0.0d0, vol2,             &
             420     2                                        mixingrule, matrix, inclusion, error)
             421     2                       cumulerror = cumulerror + error
             422     2               
             423     3                       if (hostmatrix .eq. 'ice') then
             424     3                        get_m_mix_nested = get_m_mix (mtmp, m_i, 2.0*m_a,              &
             425     3                                        (1.0d0-volice), volice, 0.0d0, mixingrule,     &
             426     3                                        hostmatrix, hostinclusion, error)
             427     3                        cumulerror = cumulerror + error
             428     3                       elseif (hostmatrix .eq. 'airwater') then
             429     3                        get_m_mix_nested = get_m_mix (mtmp, m_i, 2.0*m_a,              &
             430     3                                        (1.0d0-volice), volice, 0.0d0, mixingrule,     &
             431     3                                        'air', hostinclusion, error)
             432     3                        cumulerror = cumulerror + error
             433     3                       else
             434     3                        write(*,*) 'GET_M_MIX_NESTED: bad hostmatrix: ',        &
             435     3                                          hostmatrix
             436     3                        cumulerror = cumulerror + 1
             437     3                       endif
             438     2                      endif
             439     1               
             440     1                     elseif (host .eq. 'water') then
             441     1               
             442     2                      if (matrix .eq. 'water') then
             443     2                       write(*,*) 'GET_M_MIX_NESTED: bad matrix: ', matrix
             444     2                       cumulerror = cumulerror + 1
             445     2                      else
             446     2                       vol1 = volair / MAX(volice+volair,1d-10)
             447     2                       vol2 = 1.0d0 - vol1
             448     2                       mtmp = get_m_mix (m_a, m_i, m_w, vol1, vol2, 0.0d0,             &
             449     2                                        mixingrule, matrix, inclusion, error)
             450     2                       cumulerror = cumulerror + error
             451     2               
             452     3                       if (hostmatrix .eq. 'water') then
             453     3                        get_m_mix_nested = get_m_mix (2*m_a, mtmp, m_w,                &
             454     3                                        0.0d0, (1.0d0-volwater), volwater, mixingrule, &
             455     3                                        hostmatrix, hostinclusion, error)
             456     3                        cumulerror = cumulerror + error
             457     3                       elseif (hostmatrix .eq. 'airice') then
             458     3                        get_m_mix_nested = get_m_mix (2*m_a, mtmp, m_w,                &
             459     3                                        0.0d0, (1.0d0-volwater), volwater, mixingrule, &
             460     3                                        'ice', hostinclusion, error)
             461     3                        cumulerror = cumulerror + error
             462     3                       else
             463     3                        write(*,*) 'GET_M_MIX_NESTED: bad hostmatrix: ',         &
             464     3                                          hostmatrix
             465     3                        cumulerror = cumulerror + 1
             466     3                       endif
             467     2                      endif
             468     1               
             469     1                     elseif (host .eq. 'none') then
             470     1               
             471     1                      get_m_mix_nested = get_m_mix (m_a, m_i, m_w,                     &
             472     1                                      volair, volice, volwater, mixingrule,            &
             473     1                                      matrix, inclusion, error)
             474     1                      cumulerror = cumulerror + error
             475     1               
             476     1                     else
             477     1                      write(*,*) 'GET_M_MIX_NESTED: unknown matrix: ', host
             478     1                      cumulerror = cumulerror + 1
             479     1                     endif
             480                     
             481     1                     IF (cumulerror .ne. 0) THEN
             482     1                      write(*,*) 'GET_M_MIX_NESTED: error encountered'
             483     1                      get_m_mix_nested = CMPLX(1.0d0,0.0d0)
             484     1                     endif
             485                     
             486                           end function get_m_mix_nested
             487                     
             488                     !+---+-----------------------------------------------------------------+
             489                     
             490                           COMPLEX*16 FUNCTION get_m_mix (m_a, m_i, m_w, volair, volice,     &
             491                                          volwater, mixingrule, matrix, inclusion, error)
             492                     
             493                           IMPLICIT NONE
             494                     
             495                           DOUBLE PRECISION, INTENT(in):: volice, volair, volwater
             496                           COMPLEX*16, INTENT(in):: m_a, m_i, m_w
             497                           CHARACTER(len=*), INTENT(in):: mixingrule, matrix, inclusion
             498                           INTEGER, INTENT(out):: error
             499                     
             500                           error = 0
             501                           get_m_mix = CMPLX(1.0d0,0.0d0)
             502                     
             503     1                     if (mixingrule .eq. 'maxwellgarnett') then
             504     2                      if (matrix .eq. 'ice') then
             505     2                       get_m_mix = m_complex_maxwellgarnett(volice, volair, volwater,  &
             506     2                                          m_i, m_a, m_w, inclusion, error)
             507     2                      elseif (matrix .eq. 'water') then
             508     2                       get_m_mix = m_complex_maxwellgarnett(volwater, volair, volice,  &
             509     2                                          m_w, m_a, m_i, inclusion, error)
             510     2                      elseif (matrix .eq. 'air') then
             511     2                       get_m_mix = m_complex_maxwellgarnett(volair, volwater, volice,  &
             512     2                                          m_a, m_w, m_i, inclusion, error)
             513     2                      else
             514     2                       write(*,*) 'GET_M_MIX: unknown matrix: ', matrix
             515     2                       error = 1
             516     2                      endif
             517     1               
             518     1                     else
             519     1                      write(*,*) 'GET_M_MIX: unknown mixingrule: ', mixingrule
             520     1                      error = 2
             521     1                     endif
             522                     
             523     1                     if (error .ne. 0) then
             524     1                      write(*,*) 'GET_M_MIX: error encountered'
             525     1                     endif
             526                     
             527                           END FUNCTION get_m_mix
             528                     
             529                     !+---+-----------------------------------------------------------------+
             530                     
             531                           COMPLEX*16 FUNCTION m_complex_maxwellgarnett(vol1, vol2, vol3,    &
             532                                          m1, m2, m3, inclusion, error)
             533                     
             534                           IMPLICIT NONE
             535                     
             536                           COMPLEX*16 :: m1, m2, m3
             537                           DOUBLE PRECISION :: vol1, vol2, vol3
             538                           CHARACTER(len=*) :: inclusion
             539                     
             540                           COMPLEX*16 :: beta2, beta3, m1t, m2t, m3t
             541                           INTEGER, INTENT(out) :: error
             542                     
             543                           error = 0
             544                     
             545     1                     if (DABS(vol1+vol2+vol3-1.0d0) .gt. 1d-6) then
             546     1                      write(*,*) 'M_COMPLEX_MAXWELLGARNETT: sum of the ',       &
             547     1                             'partial volume fractions is not 1...ERROR'
             548     1                      m_complex_maxwellgarnett=CMPLX(-999.99d0,-999.99d0)
             549     1                      error = 1
             550     1                      return
             551     1                     endif
             552                     
             553                           m1t = m1**2
             554                           m2t = m2**2
             555                           m3t = m3**2
             556                     
             557     1                     if (inclusion .eq. 'spherical') then
             558     1                      beta2 = 3.0d0*m1t/(m2t+2.0d0*m1t)
             559     1                      beta3 = 3.0d0*m1t/(m3t+2.0d0*m1t)
             560     1                     elseif (inclusion .eq. 'spheroidal') then
             561     1                      beta2 = 2.0d0*m1t/(m2t-m1t) * (m2t/(m2t-m1t)*LOG(m2t/m1t)-1.0d0)
             562     1                      beta3 = 2.0d0*m1t/(m3t-m1t) * (m3t/(m3t-m1t)*LOG(m3t/m1t)-1.0d0)
             563     1                     else
             564     1                      write(*,*) 'M_COMPLEX_MAXWELLGARNETT: ',                  &
             565     1                                        'unknown inclusion: ', inclusion
             566     1                      m_complex_maxwellgarnett=DCMPLX(-999.99d0,-999.99d0)
             567     1                      error = 1
             568     1                      return
             569     1                     endif
             570                     
             571                           m_complex_maxwellgarnett = &
             572                            SQRT(((1.0d0-vol2-vol3)*m1t + vol2*beta2*m2t + vol3*beta3*m3t) / &
             573                            (1.0d0-vol2-vol3+vol2*beta2+vol3*beta3))
             574                     
             575                           END FUNCTION m_complex_maxwellgarnett
             576                     
             577                     !+---+-----------------------------------------------------------------+
             578                           REAL FUNCTION GAMMLN(XX)
             579                     !     --- RETURNS THE VALUE LN(GAMMA(XX)) FOR XX > 0.
             580                           IMPLICIT NONE
             581                           REAL, INTENT(IN):: XX
             582                           DOUBLE PRECISION, PARAMETER:: STP = 2.5066282746310005D0
             583                           DOUBLE PRECISION, DIMENSION(6), PARAMETER:: &
             584                                    COF = (/76.18009172947146D0, -86.50532032941677D0, &
             585                                            24.01409824083091D0, -1.231739572450155D0, &
             586                                           .1208650973866179D-2, -.5395239384953D-5/)
             587                           DOUBLE PRECISION:: SER,TMP,X,Y
             588                           INTEGER:: J
             589                     
             590                           X=XX
             591                           Y=X
             592                           TMP=X+5.5D0
             593                           TMP=(X+0.5D0)*LOG(TMP)-TMP
             594                           SER=1.000000000190015D0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             595     1   s   fs            DO 11 J=1,6
             596     1   s   fs              Y=Y+1.D0
             597     1   m   fm              SER=SER+COF(J)/Y
             598     1   p   fv      11    CONTINUE
             599                           GAMMLN=TMP+LOG(STP*SER/X)
             600                           END FUNCTION GAMMLN
             601                     !  (C) Copr. 1986-92 Numerical Recipes Software 2.02
             602                     !+---+-----------------------------------------------------------------+
             603                           REAL FUNCTION WGAMMA(y)
             604                     
             605                           IMPLICIT NONE
             606                           REAL, INTENT(IN):: y
             607                     
             608                           WGAMMA = EXP(GAMMLN(y))
             609                     
             610                           END FUNCTION WGAMMA

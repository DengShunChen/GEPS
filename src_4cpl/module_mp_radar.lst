              70                           subroutine radar_init
              71                     
              72                           IMPLICIT NONE
              73                           INTEGER:: n
              74                           PI5 = 3.14159*3.14159*3.14159*3.14159*3.14159
              75                           lamda4 = lamda_radar*lamda_radar*lamda_radar*lamda_radar
              76          i                m_w_0 = m_complex_water_ray (lamda_radar, 0.0d0)
              77                           m_i_0 = m_complex_ice_maetzler (lamda_radar, 0.0d0)
              78                           K_w = (ABS( (m_w_0*m_w_0 - 1.0) /(m_w_0*m_w_0 + 2.0) ))**2
              79                     

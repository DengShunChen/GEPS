             160                           xcse(4) = 1. + 2.*xbm_s + xmu_s
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             161     1       f             do n = 1, 4
             162     1    i  f                xcsg(n) = WGAMMA(xcse(n))
             163     1       f             enddo

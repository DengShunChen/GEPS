             849                     !-----------------------------------
             850                           subroutine prtime                                                 &
             851                     !...................................
             852                     !  ---  inputs:
             853                          &     ( jd, fjd, dlt, alp, r1, solc                                &
             854                     !  ---  outputs: ( none )
             855                          &     )
             856                     
             857                     !  ===================================================================  !
             858                     !                                                                       !
             859                     !  prtime prints out forecast date, time, and astronomy quantities.     !
             860                     !                                                                       !
             861                     !  inputs:                                                              !
             862                     !    jd       - forecast julian day                                     !
             863                     !    fjd      - forecast fraction of julian day                         !
             864                     !    dlt      - declination angle of sun in radians                     !
             865                     !    alp      - right ascension of sun in radians                       !
             866                     !    r1       - earth-sun radius vector in meter                        !
             867                     !    solc     - solar constant in w/m^2                                 !
             868                     !                                                                       !
             869                     !  outputs:   ( none )                                                  !
             870                     !                                                                       !
             871                     !  module variables:                                                    !
             872                     !    sollag   - equation of time in radians                             !
             873                     !                                                                       !
             874                     !  usage:    call prtime                                                !
             875                     !                                                                       !
             876                     !  external subroutines called: w3fs26                                  !
             877                     !                                                                       !
             878                     !  ===================================================================  !
             879                     !
             880                           implicit none
             881                     
             882                     !  ---  inputs:
             883                           integer, intent(in) :: jd
             884                     
             885                           real (kind=kind_phys), intent(in) :: fjd, dlt, alp, r1, solc
             886                     
             887                     !  ---  outputs: ( none )
             888                     
             889                     !  ---  locals:
             890                           real (kind=kind_phys), parameter :: sixty  = 60.0
             891                     
             892                           character(len=1),     parameter :: sign   = '-'
             893                           character(len=1),     parameter :: sigb   = ' '
             894                     
             895                           character(len=1)     :: dsig
             896                           character(len=4)     :: month(12)
             897                     
             898                           data month / 'jan.','feb.','mar.','apr.','may ','june',           &
             899                          &             'july','aug.','sep.','oct.','nov ','dec.' /
             900                     
             901                           integer               :: iday, imon, iyear, ihr, ltd, ltm,        &
             902                          &                         ihalp, iyy, jda, mfjd, idaywk, idayyr
             903                           real (kind=kind_phys) :: xmin, dltd, dltm, dlts, halp, ymin,      &
             904                          &                         asec, eqt, eqsec
             905                     
             906                     !===>  ...  begin here
             907                     
             908                     !  --- ...  get forecast hour and minute from fraction of julian day
             909                     
             910     1                     if (fjd >= 0.5) then
             911     1                       jda = jd + 1
             912     1                       mfjd= nint( fjd*1440.0 )
             913     1                       ihr = mfjd / 60 - 12
             914     1                       xmin= float(mfjd) - (ihr + 12)*sixty
             915     1                     else
             916     1                       jda = jd
             917     1                       mfjd= nint( fjd*1440.0 )
             918     1                       ihr = mfjd / 60 + 12
             919     1                       xmin= float(mfjd) - (ihr - 12)*sixty
             920     1                     endif
             921                     
             922                     !  --- ...  get forecast year, month, and day from julian day
             923                     
             924                           call w3fs26(jda, iyear,imon,iday, idaywk,idayyr)
             925                     
             926                     !  -- ...  compute solar parameters
             927                     
             928                           dltd = degrad * dlt
             929                           ltd  = dltd
             930                           dltm = sixty * (abs(dltd) - abs(float(ltd)))
             931                           ltm  = dltm
             932                           dlts = sixty * (dltm - float(ltm))
             933                     
             934     1                     if ((dltd < 0.0) .and. (ltd == 0.0)) then
             935     1                       dsig = sign
             936     1                     else
             937     1                       dsig = sigb
             938     1                     endif
             939                     
             940                           halp = 6.0 * alp / hpi
             941                           ihalp= halp
             942                           ymin = abs(halp - float(ihalp)) * sixty
             943                           iyy  = ymin
             944                           asec = (ymin - float(iyy)) * sixty
             945                     
             946                           eqt  = 228.55735 * sollag
             947                           eqsec= sixty * eqt
             948                     
             949                           print 101, iday, month(imon), iyear, ihr, xmin, jd, fjd
             950                      101  format('0 forecast date',9x,i3,a5,i6,' at',i3,' hrs',f6.2,' mins'/&
             951                          &       '  julian day',12x,i8,2x,'plus',f11.6)
             952                     
             953                           print 102, r1, halp, ihalp, iyy, asec
             954                      102  format('  radius vector',9x,f10.7/'  right ascension of sun',     &
             955                          &       f12.7,' hrs, or',i4,' hrs',i4,' mins',f6.1,' secs')
             956                     
             957                           print 103, dltd, dsig, ltd, ltm, dlts, eqt, eqsec, sollag, solc
             958                      103  format('  declination of the sun',f12.7,' degs, or ',a1,i3,       &
             959                          &       ' degs',i4,' mins',f6.1,' secs'/'  equation of time',6x,   &
             960                          &       f12.7,' mins, or',f10.2,' secs, or',f9.6,' radians'/       &
             961                          &       '  solar constant',8x,f12.7,' (distance ajusted)'//)
             962                     
             963                     !
             964                           return
             965                     !...................................
             966                           end subroutine prtime
             967                     !-----------------------------------
             968                     
             969                     !
             970                     !...........................................!
             971                           end module module_radiation_astronomy !
             972                     !===========================================!


             126                     !-----------------------------------
             127                           subroutine sol_init                                               &
             128                     !...................................
             129                     !  ---  inputs:
             130                          &     ( me , myrank )
             131                     !  ---  outputs: ( none )
             132                     
             133                     !  ===================================================================  !
             134                     !                                                                       !
             135                     !  initialize astronomy process, set up module constants.               !
             136                     !                                                                       !
             137                     !  inputs:                                                              !
             138                     !     me      - print message control flag                              !
             139                     !                                                                       !
             140                     !  outputs:  (to module variable)                                       !
             141                     !     ( none )                                                          !
             142                     !                                                                       !
             143                     !  external module variable: (in physpara)                              !
             144                     !   isolar    - = 0: use the old fixed solar constant in "physcon"      !
             145                     !               =10: use the new fixed solar constant in "physcon"      !
             146                     !               = 1: use noaa ann-mean tsi tbl abs-scale with cyc apprx !
             147                     !               = 2: use noaa ann-mean tsi tbl tim-scale with cyc apprx !
             148                     !               = 3: use cmip5 ann-mean tsi tbl tim-scale with cyc apprx!
             149                     !               = 4: use cmip5 mon-mean tsi tbl tim-scale with cyc apprx!
             150                     !   solar_file- external solar constant data table                      !
             151                     !                                                                       !
             152                     !  internal module variable:                                            !
             153                     !   isolflg   - internal solar constant scheme control flag             !
             154                     !   solc0     - solar constant  (w/m**2)                                !
             155                     !   solar_fname-file name for solar constant table assigned based on    !
             156                     !               the scheme control flag, isolflg.                       !
             157                     !                                                                       !
             158                     !  usage:    call sol_init                                              !
             159                     !                                                                       !
             160                     !  subprograms called:  none                                            !
             161                     !                                                                       !
             162                     !  ===================================================================  !
             163                     !
             164                           implicit none
             165                     
             166                     !  ---  input:
             167                           integer,  intent(in) :: me, myrank
             168                     
             169                     !  ---  output: ( none )
             170                     
             171                     !  ---  local:
             172                           logical :: file_exist
             173                     !
             174                     !===>  ...  begin here
             175                     !
             176                           if ( me == 0 .and. myrank == 0) print *, vtagast    !print out version tag
             177                     
             178                     !  ---  initialization
             179                           isolflg = isolar
             180                           solc0   = con_solr
             181                           solar_fname = solar_file
             182                           iyr_sav = 0
             183                           nstp    = 6
             184                     
             185     1                     if ( isolar == 0 ) then
             186     1                       solc0   = con_solr_old
             187     2                       if ( me == 0 .and. myrank == 0 ) then
             188     2                         print *,' - using old fixed solar constant =', solc0
             189     2                       endif
             190     1                     elseif ( isolar == 10 ) then
             191     2                       if ( me == 0 .and. myrank == 0 ) then
             192     2                         print *,' - using new fixed solar constant =', solc0
             193     2                       endif
             194     1                     elseif ( isolar == 1 ) then        ! noaa ann-mean tsi in absolute scale
             195     1                       solar_fname(15:26) = 'noaa_a0.txt'
             196     1               
             197     2                       if ( me == 0 .and. myrank == 0 ) then
             198     2                         print *,' - using noaa annual mean tsi table in abs scale',   &
             199     2                    &            ' with cycle approximation (old values)!'
             200     2                       endif
             201     1               
             202     1                       inquire (file=solar_fname, exist=file_exist)
             203     2                       if ( .not. file_exist ) then
             204     2                         isolflg = 10
             205     2               
             206     3                         if ( me == 0 .and. myrank == 0 ) then
             207     3                           print *,'   requested solar data file "',solar_fname,       &
             208     3                    &              '" not found!'
             209     3                           print *,'   using the default solar constant value =',solc0,&
             210     3                    &              ' reset control flag isolflg=',isolflg
             211     3                         endif
             212     2                       endif
             213     1                     elseif ( isolar == 2 ) then        ! noaa ann-mean tsi in tim scale
             214     1                       solar_fname(15:26) = 'noaa_an.txt'
             215     1               
             216     2                       if ( me == 0 .and. myrank == 0 ) then
             217     2                         print *,' - using noaa annual mean tsi table in tim scale',   &
             218     2                    &            ' with cycle approximation (new values)!'
             219     2                       endif
             220     1               
             221     1                       inquire (file=solar_fname, exist=file_exist)
             222     2                       if ( .not. file_exist ) then
             223     2                         isolflg = 10
             224     2               
             225     3                         if ( me == 0 .and. myrank == 0 ) then
             226     3                           print *,'   requested solar data file "',solar_fname,       &
             227     3                    &              '" not found!'
             228     3                           print *,'   using the default solar constant value =',solc0,&
             229     3                    &              ' reset control flag isolflg=',isolflg
             230     3                         endif
             231     2                       endif
             232     1                     elseif ( isolar == 3 ) then        ! cmip5 ann-mean tsi in tim scale
             233     1                       solar_fname(15:26) = 'cmip_an.txt'
             234     1               
             235     2                       if ( me == 0 .and. myrank == 0 ) then
             236     2                         print *,' - using cmip5 annual mean tsi table in tim scale',  &
             237     2                    &            ' with cycle approximation'
             238     2                       endif
             239     1               
             240     1                       inquire (file=solar_fname, exist=file_exist)
             241     2                       if ( .not. file_exist ) then
             242     2                         isolflg = 10
             243     2               
             244     3                         if ( me == 0 .and. myrank == 0 ) then
             245     3                           print *,'   requested solar data file "',solar_fname,       &
             246     3                    &              '" not found!'
             247     3                           print *,'   using the default solar constant value =',solc0,&
             248     3                    &              ' reset control flag isolflg=',isolflg
             249     3                         endif
             250     2                       endif
             251     1                     elseif ( isolar == 4 ) then        ! cmip5 mon-mean tsi in tim scale
             252     1                       solar_fname(15:26) = 'cmip_mn.txt'
             253     1               
             254     2                       if ( me == 0 .and. myrank == 0 ) then
             255     2                         print *,' - using cmip5 monthly mean tsi table in tim scale', &
             256     2                    &            ' with cycle approximation'
             257     2                       endif
             258     1               
             259     1                       inquire (file=solar_fname, exist=file_exist)
             260     2                       if ( .not. file_exist ) then
             261     2                         isolflg = 10
             262     2               
             263     3                         if ( me == 0 .and. myrank == 0 ) then
             264     3                           print *,'   requested solar data file "',solar_fname,       &
             265     3                    &              '" not found!'
             266     3                           print *,'   using the default solar constant value =',solc0,&
             267     3                    &              ' reset control flag isolflg=',isolflg
             268     3                         endif
             269     2                       endif
             270     1                     else                               ! selection error
             271     1                       isolflg = 10
             272     1               
             273     2                       if ( me == 0 .and. myrank == 0) then
             274     2                         print *,' - !!! error in selection of solar constant data',   &
             275     2                    &            ' source, isol =',isolar
             276     2                         print *,'   using the default solar constant value =',solc0,  &
             277     2                    &              ' reset control flag isolflg=',isolflg
             278     2                       endif
             279     1                     endif       ! end if_isolar_block
             280                     !
             281                           return
             282                     !...................................
             283                           end subroutine sol_init
             284                     !-----------------------------------
             285                     
             286                     
             287                     !-----------------------------------
             288                           subroutine sol_update                                             &
             289                     !...................................
             290                     !  ---  inputs:
             291                          &     ( myrank,jdate,kyear,deltsw,deltim,lsol_chg, me,             &
             292                     !  ---  outputs:
             293                          &       slag, sdec, cdec, solcon                                   &
             294                          &      )
             295                     
             296                     !  ===================================================================  !
             297                     !                                                                       !
             298                     !  sol_update computes solar parameters at forecast time                !
             299                     !                                                                       !
             300                     !  inputs:                                                              !
             301                     !     jdate(8)- ncep absolute date and time at fcst time                !
             302                     !                (yr, mon, day, t-zone, hr, min, sec, mil-sec)          !
             303                     !     kyear   - usually kyear=jdate(1). if not, it is for hindcast mode,!
             304                     !               and it is usually the init cond time and serves as the  !
             305                     !               upper limit of data can be used.                        !
             306                     !     deltsw  - time duration in seconds per sw calculation             !
             307                     !     deltim  - timestep in seconds                                     !
             308                     !     lsol_chg- logical flags for change solar constant                 !
             309                     !     me      - print message control flag                              !
             310                     !                                                                       !
             311                     !  outputs:                                                             !
             312                     !    slag          - equation of time in radians                        !
             313                     !    sdec, cdec    - sin and cos of the solar declination angle         !
             314                     !    solcon        - sun-earth distance adjusted solar constant (w/m2)  !
             315                     !                                                                       !
             316                     !                                                                       !
             317                     !  module variable:                                                     !
             318                     !   solc0   - solar constant  (w/m**2) not adjusted by earth-sun dist   !
             319                     !   isolflg - solar constant control flag                               !
             320                     !             = 0: use the old fixed solar constant                     !
             321                     !             =10: use the new fixed solar constant                     !
             322                     !             = 1: use noaa ann-mean tsi tbl abs-scale with cycle apprx !
             323                     !             = 2: use noaa ann-mean tsi tbl tim-scale with cycle apprx !
             324                     !             = 3: use cmip5 ann-mean tsi tbl tim-scale with cycle apprx!
             325                     !             = 4: use cmip5 mon-mean tsi tbl tim-scale with cycle apprx!
             326                     !   solar_fname-external solar constant data table                      !
             327                     !   sindec  - sine of the solar declination angle                       !
             328                     !   cosdec  - cosine of the solar declination angle                     !
             329                     !   anginc  - solar angle increment per iteration for cosz calc         !
             330                     !   nstp    - total number of zenith angle iterations                   !
             331                     !   smon_sav- saved monthly solar constants (isolflg=4 only)            !
             332                     !   iyr_sav - saved year  of data previously used                       !
             333                     !                                                                       !
             334                     !  usage:    call sol_update                                            !
             335                     !                                                                       !
             336                     !  subprograms called:  solar, prtime                                   !
             337                     !                                                                       !
             338                     !  external functions called: iw3jdn                                    !
             339                     !                                                                       !
             340                     !  ===================================================================  !
             341                     !
             342                           implicit none
             343                     
             344                     !  ---  input:
             345                           integer, intent(in) :: jdate(:), kyear, me, myrank
             346                           logical, intent(in) :: lsol_chg
             347                     
             348                           real (kind=kind_phys), intent(in) :: deltsw, deltim
             349                     
             350                     !  ---  output:
             351                           real (kind=kind_phys), intent(out) :: slag, sdec, cdec, solcon
             352                     
             353                     !  ---  locals:
             354                           real (kind=kind_phys), parameter :: hrday = 1.0/24.0    ! frc day/hour
             355                           real (kind=kind_phys), parameter :: minday= 1.0/1440.0  ! frc day/minute
             356                           real (kind=kind_phys), parameter :: secday= 1.0/86400.0 ! frc day/second
             357                     
             358                           real (kind=kind_phys) :: smean, solc1, dtswh, smon(12)
             359                           real (kind=kind_phys) :: fjd, fjd1, dlt, r1, alp
             360                     
             361                           integer :: jd, jd1, iyear, imon, iday, ihr, imin, isec
             362                           integer :: iw3jdn
             363                           integer :: i, iyr, iyr1, iyr2, jyr, nn, nswr, icy1, icy2, icy
             364                     
             365                           logical :: file_exist
             366                           character :: cline*60
             367                     !
             368                     !===>  ...  begin here
             369                     !
             370                     !  --- ...  forecast time
             371                           iyear = jdate(1)
             372                           imon  = jdate(2)
             373                           iday  = jdate(3)
             374                           ihr   = jdate(5)
             375                           imin  = jdate(6)
             376                           isec  = jdate(7)
             377                     
             378     1                     if ( lsol_chg ) then   ! get solar constant from data table
             379     1               
             380     2                       if ( iyr_sav == iyear ) then   ! same year, no new reading necessary
             381     3                         if ( isolflg==4 ) then
             382     3                           solc0 = smon_sav(imon)
             383     3                         endif
             384     2                       else                           ! need to read in new data
             385     2                         iyr_sav = iyear
             386     2               
             387     2               !  --- ...  check to see if the solar constant data file existed
             388     2               
             389     2                         inquire (file=solar_fname, exist=file_exist)
             390     3                         if ( .not. file_exist ) then
             391     3                           print *,' !!! error! can not find solar constant file!!!'
             392     3                           stop
             393     3                         else
             394     3                           iyr = iyear
             395     3               
             396     3                           close(niradsf)
             397     3                           open (niradsf,file=solar_fname,form='formatted',            &
             398     3                    &                    status='old')
             399     3                           rewind niradsf
             400     3               
             401     3                           read (niradsf, * ) iyr1,iyr2,icy1,icy2,smean,cline(1:60)
             402     3               !           read (niradsf, 24) iyr1,iyr2,icy1,icy2,smean,cline
             403     3               ! 24        format(4i5,f8.2,a60)
             404     3               
             405     4                           if ( me == 0 .and. myrank == 0 ) then
             406     4                             print *,'  updating solar constant with cycle approx'
             407     4                             print *,'   opened solar constant data file: ',solar_fname
             408     4               !check        print *, iyr1, iyr2, icy1, icy2, smean, cline
             409     4                           endif
             410     3               
             411     3               !  --- ...  check if there is a upper year limit put on the data table
             412     3               
             413     3               !           if ( iyear /= kyear ) then
             414     3               !             icy = icy1 - iyr1 + 1    ! range of the earlest cycle in data table
             415     3               !             if ( kyear-iyr1 < icy ) then ! need data range at least icy years
             416     3                                                          ! to perform cycle approximation
             417     3               !               if ( me == 0 .and. myrank == 0 ) then
             418     3               !                 print *,'  *** the requested year',iyear,' and upper',&
             419     3               !    &                  'limit',kyear,' do not fit the range of data ', &
             420     3               !    &                  'table of iyr1, iyr2 =',iyr1,iyr2
             421     3               !                 print *,'      use fixed solar constant=',con_solr
             422     3               !               endif
             423     3               !               solc0 = con_solr
             424     3               !               isolflg = 10
             425     3               
             426     3               !             elseif ( kyear < iyr2 ) then
             427     3               
             428     3               !  --- ...  because the usage limit put on the historical data table,
             429     3               !           skip those unused data records at first
             430     3               
             431     3               !               i = iyr2
             432     3               !               lab_dowhile0 : do while ( i > kyear )
             433     3               !                 read (niradsf,26) jyr, solc1
             434     3               ! 26              format(i4,f10.4)
             435     3               !                 read (niradsf,*) jyr, solc1
             436     3               !                 i = i - 1
             437     3               !               enddo lab_dowhile0
             438     3               
             439     3               !               iyr2 = kyear   ! next record will serve the upper limit
             440     3               
             441     3               !             endif   ! end if_kyear_block
             442     3               !           endif   ! end if_iyear_block
             443     3               
             444     3               !  --- ...  checking the cycle range
             445     3               
             446     4                           if ( iyr < iyr1 ) then
             447     4                             icy = icy1 - iyr1 + 1    ! range of the earlest cycle in data table
             448     5                             lab_dowhile1 : do while ( iyr < iyr1 )
             449     5                               iyr = iyr + icy
             450     5                             enddo lab_dowhile1
             451     4               
             452     5                             if ( me == 0 .and. myrank == 0) then
             453     5                               print *,'   *** year',iyear,' out of table range!',     &
             454     5                    &                  iyr1, iyr2
             455     5                               print *,'       using the closest-cycle year (',iyr,')'
             456     5                             endif
             457     4                           elseif ( iyr > iyr2 ) then
             458     4                             icy = iyr2 - icy2 + 1    ! range of the latest cycle in data table
             459     5                             lab_dowhile2 : do while ( iyr > iyr2 )
             460     5                               iyr = iyr - icy
             461     5                             enddo lab_dowhile2
             462     4               
             463     5                             if ( me == 0 .and. myrank == 0 ) then
             464     5                               print *,'   *** year',iyear,' out of table range!',     &
             465     5                    &                  iyr1, iyr2
             466     5                               print *,'       using the closest-cycle year (',iyr,')'
             467     5                             endif
             468     4                           endif
             469     3               
             470     3               !  --- ...  locate the right record for the year of data
             471     3               
             472     4                           if ( isolflg < 4 ) then        ! use annual mean data tables
             473     4                             i = iyr2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             474     5                             lab_dowhile3 : do while ( i >= iyr1 )
             475     5               !               read (niradsf,26) jyr, solc1
             476     5               ! 26            format(i4,f10.4)
             477     5                               read (niradsf,*) jyr, solc1
             478     5               
             479     6                               if ( i == iyr .and. iyr == jyr ) then
             480     6                                 solc0  = smean + solc1
             481     6               
             482     7                                 if (me == 0 .and. myrank == 0) then
             483     7                                   print *,' check: solar constant data used for year',&
             484     7                    &                       iyr, solc1, solc0
             485     7                                 endif
             486     6                                 exit lab_dowhile3
             487     6                               else
             488     6                                 if(me == 0 .and. myrank == 0)print *,'  skip solar const data for yr',i
             489     6                                 i = i - 1
             490     6                               endif
             491     5                             enddo   lab_dowhile3
             492     4                           elseif ( isolflg == 4 ) then   ! use monthly mean data tables
             493     4                             i = iyr2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             494     5                             lab_dowhile4 : do while ( i >= iyr1 )
             495     5               !               read (niradsf,26) jyr, smon(:)
             496     5               ! 26            format(i4,12f10.4)
             497     5                               read (niradsf,*) jyr, smon(1:12)
             498     5               
             499     6                               if ( i == iyr .and. iyr == jyr ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             500     7   s    v                        do nn = 1, 12
             501     7   p    v                          smon_sav(nn) = smean + smon(nn)
             502     7   p    v                        enddo
             503     6                                 solc0  = smean + smon(imon)
             504     6               
             505     7                                 if (me == 0 .and. myrank == 0) then
             506     7                                     print *,' check: solar constant data used for year',&
             507     7                    &                iyr,' and month',imon
             508     7                                 endif
             509     6                                 exit lab_dowhile4
             510     6                               else
             511     6                                 if(me == 0 .and. myrank == 0) print *,'  skip solar const data for yr',i
             512     6                                 i = i - 1
             513     6                               endif
             514     5                             enddo   lab_dowhile4
             515     4                           endif    ! end if_isolflg_block
             516     3               
             517     3                           close ( niradsf )
             518     3                         endif      ! end if_file_exist_block
             519     2               
             520     2                       endif    ! end if_iyr_sav_block
             521     1                     endif   ! end if_lsol_chg_block
             522                     
             523                     !  --- ...  calculate forecast julian day and fraction of julian day
             524                     
             525                           jd1 = iw3jdn(iyear,imon,iday)
             526                     
             527                     !  --- ...  unlike in normal applications, where day starts from 0 hr,
             528                     !           in astronomy applications, day stats from noon.
             529                     
             530     1                     if (ihr < 12) then
             531     1                       jd1 = jd1 - 1
             532     1                       fjd1= 0.5 + float(ihr)*hrday + float(imin)*minday               &
             533     1                    &            + float(isec)*secday
             534     1                     else
             535     1                       fjd1= float(ihr - 12)*hrday + float(imin)*minday                &
             536     1                    &            + float(isec)*secday
             537     1                     endif
             538                     
             539                           fjd1  = fjd1 + jd1
             540                     
             541                           jd  = int(fjd1)
             542                           fjd = fjd1 - jd
             543                     
             544                           call solar                                                        &
             545                     !  ---  inputs:
             546                          &     ( jd, fjd,                                                   &
             547                     !  ---  outputs:
             548                          &       r1, dlt, alp                                               &
             549                          &     )
             550                     
             551                     !  --- ...  calculate sun-earth distance adjustment factor appropriate to date
             552                           solcon = solc0 / (r1*r1)
             553                     
             554                           slag   = sollag
             555                           sdec   = sindec
             556                           cdec   = cosdec
             557                     
             558                     !  --- ...  diagnostic print out
             559                     
             560     1                     if (me == 0 .and. myrank == 0) then
             561     1               
             562     1                       call prtime                                                     &
             563     1               !  ---  inputs:
             564     1                    &     ( jd, fjd, dlt, alp, r1, solcon )
             565     1               !  ---  outputs: ( none )
             566     1               
             567     1                     endif
             568                     
             569                     !  --- ...  setting up calculation parameters used by subr coszmn
             570                     
             571                           nswr  = nint(deltsw / deltim)         ! number of mdl t-step per sw call
             572                           dtswh = deltsw / f3600                ! time length in hours
             573                     
             574     1                     if ( deltsw >= f3600 ) then           ! for longer sw call interval
             575     1                       nn   = max(6, min(12, nint(f3600/deltim) ))   ! num of calc per hour
             576     1                       nstp = nint(dtswh) * nn + 1                   ! num of calc per sw call
             577     1                     else                                  ! for shorter sw sw call interval
             578     1                       nstp = max(2, min(20, nswr)) + 1
             579     1               !       nn   = nint( float(nstp-1)/dtswh )
             580     1                     endif
             581                     
             582                           anginc = pid12 * dtswh / float(nstp-1)          ! solar angle inc during each calc step
             583                     
             584     1                     if ( me == 0 .and. myrank == 0) then
             585     1                       print *,'   for cosz calculations: nswr,deltim,deltsw,dtswh =', &
             586     1                    &          nswr,deltim,deltsw,dtswh,'  anginc,nstp =',anginc,nstp
             587     1                     endif
             588                     
             589                           if (me == 0 .and. myrank == 0) print*,'in sol_update completed sr solar'
             590                     !
             591                     
             592                           return
             593                     !...................................
             594                           end subroutine sol_update
             595                     !-----------------------------------
             596                     
             597                     
             598                     !-----------------------------------
             599                           subroutine solar                                                  &
             600                     !...................................
             601                     !  ---  inputs:
             602                          &     ( jd, fjd,                                                   &
             603                     !  ---  outputs:
             604                          &       r1, dlt, alp                                               &
             605                          &     )
             606                     
             607                     !  ===================================================================  !
             608                     !                                                                       !
             609                     !  solar computes radius vector, declination and right ascension of     !
             610                     !  sun, and equation of time.                                           !
             611                     !                                                                       !
             612                     !  inputs:                                                              !
             613                     !    jd       - julian day                                              !
             614                     !    fjd      - fraction of the julian day                              !
             615                     !                                                                       !
             616                     !  outputs:                                                             !
             617                     !    r1       - earth-sun radius vector                                 !
             618                     !    dlt      - declination of sun in radians                           !
             619                     !    alp      - right ascension of sun in radians                       !
             620                     !                                                                       !
             621                     !  module variables:                                                    !
             622                     !    sollag   - equation of time in radians                             !
             623                     !    sindec   - sine of declination angle                               !
             624                     !    cosdec   - cosine of declination angle                             !
             625                     !                                                                       !
             626                     !  usage:    call solar                                                 !
             627                     !                                                                       !
             628                     !  external subroutines called: none                                    !
             629                     !                                                                       !
             630                     !  ===================================================================  !
             631                     !
             632                           implicit none
             633                     
             634                     !  ---  inputs:
             635                           real (kind=kind_phys), intent(in) :: fjd
             636                           integer,               intent(in) :: jd
             637                     
             638                     !  ---  outputs:
             639                           real (kind=kind_phys), intent(out) :: r1, dlt, alp
             640                     
             641                     !  ---  locals:
             642                           real (kind=kind_phys), parameter :: cyear = 365.25   ! days of year
             643                           real (kind=kind_phys), parameter :: ccr   = 1.3e-6   ! iteration limit
             644                           real (kind=kind_phys), parameter :: tpp   = 1.55     ! days between epoch and
             645                                                                                ! perihelion passage of 1900
             646                           real (kind=kind_phys), parameter :: svt6  = 78.035   ! days between perihelion passage
             647                                                                                ! and march equinox of 1900
             648                           integer,               parameter :: jdor  = 2415020  ! jd of epoch which is january
             649                                                                                ! 0, 1900 at 12 hours ut
             650                     
             651                           real (kind=kind_phys) :: dat, t1, year, tyear, ec, angin, ador,   &
             652                          &       deleqn, sni, tini, er, qq, e1, ep, cd, eq, date, em,       &
             653                          &       cr, w1, tst, sun
             654                     
             655                           integer               :: jdoe, iter
             656                     
             657                     !===>  ...  begin here
             658                     
             659                     ! --- ...  computes time in julian centuries after epoch
             660                     
             661                           t1 = float(jd - jdor) / 36525.0
             662                     
             663                     ! --- ...  computes length of anomalistic and tropical years (minus 365 days)
             664                     
             665                           year = 0.25964134e0 + 0.304e-5 * t1
             666                           tyear= 0.24219879e0 - 0.614e-5 * t1
             667                     
             668                     ! --- ...  computes orbit eccentricity and angle of earth's inclination from t
             669                     
             670                           ec   = 0.01675104e0 - (0.418e-4 + 0.126e-6 * t1) * t1
             671                           angin= 23.452294e0 - (0.0130125e0 + 0.164e-5 * t1) * t1
             672                     
             673                           ador = jdor
             674                           jdoe = ador + (svt6 * cyear) / (year - tyear)
             675                     
             676                     ! --- ...  deleqn is updated svt6 for current date
             677                     
             678                           deleqn= float(jdoe - jd) * (year - tyear) / cyear
             679                           year  = year + 365.0
             680                           sni   = sin( angin / degrad )
             681                           tini  = 1.0 / tan( angin / degrad )
             682                           er    = sqrt( (1.0 + ec) / (1.0 - ec) )
             683                           qq    = deleqn * tpi / year
             684                     
             685                     ! --- ...  determine true anomaly at equinox
             686                     
             687                           e1    = 1.0
             688                           cd    = 1.0
             689                           iter  = 0
             690                     
             691     1                     lab_do_1 : do while ( cd > ccr )
             692     1               
             693     1                       ep    = e1 - (e1 - ec*sin(e1) - qq) / (1.0 - ec*cos(e1))
             694     1                       cd    = abs(e1 - ep)
             695     1                       e1    = ep
             696     1                       iter  = iter + 1
             697     1               
             698     2                       if (iter > 10) then
             699     2                         write(6,*) ' iteration count for loop 32 =', iter
             700     2                         write(6,*) ' e, ep, cd =', e1, ep, cd
             701     2                         exit lab_do_1
             702     2                       endif
             703     1               
             704     1                     enddo  lab_do_1
             705                     
             706                           eq   = 2.0 * atan( er * tan( 0.5*e1 ) )
             707                     
             708                     ! --- ...  date is days since last perihelion passage
             709                     
             710                           dat  = float(jd - jdor) - tpp + fjd
             711                           date = mod(dat, year)
             712                     
             713                     ! --- ...  solve orbit equations by newton's method
             714                     
             715                           em   = tpi * date / year
             716                           e1   = 1.0
             717                           cr   = 1.0
             718                           iter = 0
             719                     
             720     1                     lab_do_2 : do while ( cr > ccr )
             721     1               
             722     1                       ep   = e1 - (e1 - ec*sin(e1) - em) / (1.0 - ec*cos(e1))
             723     1                       cr   = abs(e1 - ep)
             724     1                       e1   = ep
             725     1                       iter = iter + 1
             726     1               
             727     2                       if (iter > 10) then
             728     2                         write(6,*) ' iteration count for loop 31 =', iter
             729     2                         exit lab_do_2
             730     2                       endif
             731     1               
             732     1                     enddo  lab_do_2
             733                     
             734                           w1   = 2.0 * atan( er * tan( 0.5*e1 ) )
             735                     
             736                           r1   = 1.0 - ec*cos(e1)
             737                     
             738                           sindec = sni * sin(w1 - eq)
             739                           cosdec = sqrt( 1.0 - sindec*sindec )
             740                     
             741                           dlt  = asin( sindec )
             742                           alp  = asin( tan(dlt)*tini )
             743                     
             744                           tst  = cos( w1 - eq )
             745                           if (tst < 0.0) alp = con_pi - alp
             746                           if (alp < 0.0) alp = alp + tpi
             747                     
             748                           sun  = tpi * (date - deleqn) / year
             749                           if (sun < 0.0) sun = sun + tpi
             750                           sollag = sun - alp - 0.03255e0
             751                     !
             752                           return
             753                     !...................................
             754                           end subroutine solar
             755                     !-----------------------------------
             756                     
             757                     
             758                     !-----------------------------------
             759                           subroutine coszmn                                                 &
             760                     !...................................
             761                     !  ---  inputs:
             762                          &     ( xlon,sinlat,coslat,solhr, im, me,                          &
             763                     !  ---  outputs:
             764                          &       coszen, coszdg                                             &
             765                          &     )
             766                     
             767                     !  ===================================================================  !
             768                     !                                                                       !
             769                     !  coszmn computes mean cos solar zenith angle over sw calling interval !
             770                     !                                                                       !
             771                     !  inputs:                                                              !
             772                     !    xlon  (im)    - grids' longitudes in radians, work both on zonal   !
             773                     !                    0->2pi and -pi->+pi arrangements                   !
             774                     !    sinlat(im)    - sine of the corresponding latitudes                !
             775                     !    coslat(im)    - cosine of the corresponding latitudes              !
             776                     !    solhr         - time after 00z in hours                            !
             777                     !    im            - num of grids in horizontal dimension               !
             778                     !    me            - print message control flag                         !
             779                     !                                                                       !
             780                     !  outputs:                                                             !
             781                     !    coszen(im)    - average of cosz for daytime only in sw call interval
             782                     !    coszdg(im)    - average of cosz over entire sw call interval       !
             783                     !                                                                       !
             784                     !  module variables:                                                    !
             785                     !    sollag        - equation of time                                   !
             786                     !    sindec        - sine of the solar declination angle                !
             787                     !    cosdec        - cosine of the solar declination angle              !
             788                     !    anginc        - solar angle increment per iteration for cosz calc  !
             789                     !    nstp          - total number of zenith angle iterations            !
             790                     !                                                                       !
             791                     !  usage:    call comzmn                                                !
             792                     !                                                                       !
             793                     !  external subroutines called: none                                    !
             794                     !                                                                       !
             795                     !  ===================================================================  !
             796                     !
             797                           implicit none
             798                     
             799                     !  ---  inputs:
             800                           integer, intent(in) :: im, me
             801                     
             802                           real (kind=kind_phys), intent(in) :: sinlat(:), coslat(:),        &
             803                          &       xlon(:), solhr
             804                     
             805                     !  ---  outputs:
             806                           real (kind=kind_phys), intent(out) :: coszen(:), coszdg(:)
             807                     
             808                     !  ---  locals:
             809                           real (kind=kind_phys) :: coszn, cns, ss, cc, solang, rstp
             810                     
             811                           integer :: istsun(im), i, it, j, lat
             812                     
             813                     !===>  ...  begin here
             814                     
             815                           solang = pid12 * (solhr - f12)         ! solar angle at present time
             816                           rstp = 1.0 / float(nstp)
             817                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      istsun
                                   <<< Loop-information  End >>>
             818     1  pp   2v            do i = 1, im
             819     1   p   2v              coszen(i) = 0.0
             820     1   p   2v              istsun(i) = 0
             821     1   p   2v            enddo
             822                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      istsun
                                   <<< Loop-information  End >>>
             823     1                     do it = 1, nstp
             824     1                       cns = solang + float(it-1)*anginc + sollag
             825     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.50, ITR: 96, MVE: 5, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      istsun
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 20
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             826     2  pp    v              do i = 1, im
             827     2   p    v                ss  = sinlat(i) * sindec
             828     2   p    v                cc  = coslat(i) * cosdec
             829     2               
             830     2   p    v                coszn = ss + cc * cos(cns + xlon(i))
             831     2   p    v                coszen(i) = coszen(i) + max(0.0, coszn)
             832     2   p    v                if (coszn > czlimt) istsun(i) = istsun(i) + 1
             833     2   p    v              enddo
             834     1                     enddo
             835                     
             836                     !  --- ...  compute time averages
             837                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.20, ITR: 48, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      istsun
                                   <<< Loop-information  End >>>
             838     1  pp   2v            do i = 1, im
             839     1   p   2v              coszdg(i) = coszen(i) * rstp
             840     1   p   2v              if (istsun(i) > 0) coszen(i) = coszen(i) / istsun(i)
             841     1   p   2v            enddo
             842                     !
             843                           return
             844                     !...................................
             845                           end subroutine coszmn

 External subroutine subprogram "landpack"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine landpack(tsat,dfkt,xktk,dfk)
               2                     !
               3                     !*****************************************
               4                     ! 1. purpose:
               5                     !
               6                     !  set up parameters table for 9 soil types
               7                     !                            ,depend on 22 levels of soil moisture
               8                     !     moisture diffusivity : dfk(22,9)
               9                     !     hydrolic conductivity : xktk(22,9)
              10                     !     thermal diffusivity for all soil types: dfkt(22,9)
              11                     ! 2. parameter specification
              12                     !
              13                     ! tsat   : satuation point  (9)
              14                     ! dfkt   : soil thermal diffusivity     (22,9)    m2/s
              15                     ! xktk   : soil hydraulic conductivity  (22,9)    m/s
              16                     !  dfk   : soil hydraulic diffusivity   (22,9)    m2/s
              17                     !
              18                     !***************************
              19                     !  the 9 soil types are:
              20                     !    1  ... loamy sand (coarse)
              21                     !    2  ... silty clay loam (medium)
              22                     !    3  ... light clay (fine)
              23                     !    4  ... sandy loam (coarse-medium)
              24                     !    5  ... sandy clay (coarse-fine)
              25                     !    6  ... clay loam  (medium-fine)
              26                     !    7  ... sandy clay loam (coarse-med-fine)
              27                     !    8  ... loam  (organic)
              28                     !    9  ... ice (use loamy sand property)
              29                     !****************************************
              30                     !
              31                           implicit  none
              32                           integer,  parameter :: ntype=9, ngrid=22
              33                           real      b(ntype),satpsi(ntype),satkt(ntype)
              34                           real      tsat(ntype)
              35                           real      dfkt(ngrid,ntype)
              36                           real      dfk(ngrid,ntype)
              37                           real      xktk(ngrid,ntype)
              38                     
              39                           integer   k,i
              40                           real      dynw,f1,f2,theta,pf
              41                     
              42                     !
              43                           data b/4.26,8.72,11.55,4.74,10.73,8.17,6.77,5.25,4.26/
              44                           data satpsi/.04,.62,.47,.14,.10,.26,.14,.36,.04/
              45                           data satkt/1.41e-5,.20e-5,.10e-5,.52e-5,.72e-5,  &
              46                                      .25e-5,.45e-5,.34e-5,1.41e-5/
              47                     
              48                     ! get dfkt
              49                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              50     1  pp                 do k = 1, ntype
              51     1   p                   dynw = tsat(k) * .05
              52     1   p                   f1 = log10(satpsi(k)) + b(k) * log10(tsat(k)) + 2.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dfkt
                                   <<< Loop-information  End >>>
              53     2   p    s              do i = 1, ngrid
              54     2   p    v                theta = float(i-1) * dynw
              55     2   p    v                theta = min(tsat(k),theta)
              56     3   p    s                if(theta.gt.0.) then
              57     3   p    s                  pf = f1 - b(k) * log10(theta)
              58     3   p    s                else
              59     3   p    s                  pf = 5.2
              60     3   p    v                endif
              61     3   p    s                if(pf.le.5.1) then
              62     3   p    s                  dfkt(i,k) = exp(-(2.7+pf)) * 420.
              63     3   p    s                else
              64     3   p    s                  dfkt(i,k) = .1744
              65     3   p    v                endif
              66     2   p    v              enddo
              67     1   p                 enddo
              68                     !
              69                     ! get dfk,ktk
              70                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tsat, b, satkt, satpsi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 3  FILL 3
                                   <<<      SCALABLE  : SPILL 20  FILL 26
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              71     1  pp                 do k = 1, ntype
              72     1   p                   dynw = tsat(k) * .05
              73     1   p                   f1 = b(k) * satkt(k) * satpsi(k) / tsat(k) ** (b(k) + 3.)
              74     1   p                   f2 = satkt(k) / tsat(k) ** (b(k) * 2. + 3.)
              75     1               !
              76     1               !  convert from m/s to kg m-2 s-1 unit
              77     1               !
              78     1   p                   f1 = f1 * 1000.
              79     1   p                   f2 = f2 * 1000.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
              80     2   p   fv              do i = 1, ngrid
              81     2   p   fv                theta = float(i-1) * dynw
              82     2   p   fv                theta = min(tsat(k),theta)
              83     2   p   fv                dfk(i,k) = f1 * theta ** (b(k) + 2.)
              84     2   p   fv                xktk(i,k) = f2 * theta ** (b(k) * 2. + 3.)
              85     2   p   fv              enddo
              86     1   p                 enddo
              87                           return
              88                           end


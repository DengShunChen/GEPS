 External subroutine subprogram "wrte_idate"
  (inc)(line-no.)(nest)(optimize)
               1                     #ifdef RSM
               2                           subroutine wrte_idate(idate)
               3                     !
               4                           use rank, only : myrank
               5                     !
               6                           integer idate,nsig
               7                           character cidtg*10
               8                     !
               9     1                     if (myrank.eq.0) then
              10     1                       nsig=51
              11     1                       write(cidtg,'(I10.10)') idate
              12     1                     open(nsig,file='rsm_idate_'//cidtg,status='unknown', &
              13     1                         form='unformatted',iostat=ios)
              14     1                     write(nsig) idate
              15     1                       print*,'idate in wrte_idate =',idate
              16     1                     close(nsig)
              17     1                     endif
              18                     !
              19                           return
              20                           end
              21                     #endif


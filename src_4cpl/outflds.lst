                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             224     3   p    v                do i=1,nxj
             225     3   p    v                  plog(i,k,jj)= log(plt(i,k,jj))
             226     3   p    v                enddo
             227     2   p                   enddo
             228     1   p                 enddo
             229                     !
             230                     !  compute sea level pressure and update pdiff
             231                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             232                     !
             233                     !  llts layer's temperature is used to derive an alternative
             234                     !  surface skin temperature
             235                     !
             236                     !      if( itau .gt. 0 )then
             237                     !
             238                           llts = lev-5
             239                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             240     1  pp                 do jj = 1, jlistnum
             241     1   p                   j=jlist1(jj)
             242     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, pt, plt, sgeo, phi, hld1
                                   <<<      hld2, pdiff, pllp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
             243     2   p    v              do i=1,nxj
             244     2   p    v                ttb  = tt(i,lev,jj)*pk(i,lev,jj)/(1.0+0.608*qt(i,lev,jj))
             245     2   p    v                ttp  = tt(i,llts,jj)*pk(i,llts,jj)/(1.0+0.608*qt(i,llts,jj))
             246     2   p    v                ttt1 = ttb + alaps*rdg*ttb*   &
             247     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             248     2   p    v                ttt2 = ttp + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             249     2   p    v                hld1(i,jj) = 0.25*ttt1 + 0.75*ttt2
             250     2   p    v                hld2(i,jj) = hld1(i,jj) + alaps*sgeo(i,jj)/grav
             251     3   p    v                if( sgeo(i,jj) .lt. 0.1 ) then
             252     3   p    v                  anlslp = pt(i,jj) + ptop
             253     3   p    v                else if( hld1(i,jj) .le. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             254     3   p    v                  apha = rgas*(290.5-hld1(i,jj))/sgeo(i,jj)
             255     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             256     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             257     3                                    apha*ttt*apha*ttt) )
             258     3   p    v                else if( hld1(i,jj) .gt. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             259     3   p    v                  hld1(i,jj) = (hld1(i,jj)+290.5)*0.5
             260     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             261     3   p    v                else if( hld1(i,jj) .lt. 255.0 .and. hld2(i,jj) .lt. 255.0 ) then
             262     3   p    v                  hld1(i,jj) = (hld1(i,jj)+255.0)*0.5
             263     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             264     3   p    v                else
             265     3   p    v                  apha = alaps * rdg
             266     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             267     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             268     3                                    apha*ttt*apha*ttt) )
             269     3   p    v                endif
             270     2   p    v                pllp(i,jj) = anlslp - pt(i,jj)
             271     2   p    v                pdiff(i,jj)=pllp(i,jj)
             272     2   p    v              enddo
             273     1   p                 enddo
             274                     !
             275                     !      else
             276                     !
             277                     !  pllp equal to pdiff at the initial time, tau=0
             278                     !
             279                     !      do jj = 1, jlistnum
             280                     !        j=jlist1(jj)
             281                     !        nxj=nxdef(j)
             282                     !        do i = 1, nxj
             283                     !          pllp(i,j) = pdiff(i,jj)
             284                     !        enddo
             285                     !      enddo
             286                     !
             287                     !      endif     ! end of ( itau .gt. 0 )
             288                     !
             289                     !      call mpe_unify(pllp,nx,my,2,mpe_double)
             290                     !      call mpe_unify(pt,nx,my,2,mpe_double)
             291                     !      call mpe_unify(ptend,nx,my,2,mpe_double)
             292                     !
             293                     !
             294                     ! output surface fields
             295                     !
             296                     !  add terrain pressure output in surfout ( add "ptop" )
             297                     !
             298                           if(myrank.eq.0)print*,' outfld : start surfout, lwrite = ',lwrite
             299                           call surfout (nx,my,my_max,ifilout,itau,idtg,taudir,ntau,pdiff,pt  &
             300                                        ,ptop,typtrk(1,1,1),ptend,glob,ggdef,lwrite)
             301                     !
             302                     !  obtain the the bottom pressure for the following interpolations
             303                     !  bt2 will be used in geoptential interpolations
             304                     !
             305                           pl1000= log(1000.1)
             306                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdiff, pt, pllp, slp
                                   <<< Loop-information  End >>>
             307     1                     do jj = 1, jlistnum
             308     1                       j=jlist1(jj)
             309     1                       nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 176, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdiff, slp, pt, pllp
                                   <<< Loop-information  End >>>
             310     2  pp   2v              do i = 1, nxj
             311     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             312     3   p   2v                if( slp(i,jj) .le. 1000.1) then
             313     3   p   2v                  pllp(i,jj) = 1000.1
             314     3   p   2v                else
             315     3   p   2v                  pllp(i,jj) = slp(i,jj)
             316     3   p   2v                endif
             317     2   p   2v              enddo
             318     1               !

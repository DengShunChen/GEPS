             337                     !
             338     1                     if(numz.gt.0.or.numt.gt.0.or.numq.gt.0) then
             339     1               !
             340     1               !  temperature output
             341     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             342     2  pp                 do jj =1,jlistnum
             343     2   p                   j=jlist1(jj)
             344     2   p                   nxj=nxdef_2d(j)
             345     2               !
             346     2               !  bottom boundary condition for temperature:
             347     2               !  limits for 1000 mb boundary condition are (1) standard lapse rate
             348     2               !  from bottom model level for terrain height and (2) layer mean temp
             349     2               !  of slp and 1000 mb.  Boundary condition is linear combination
             350     2               !  of these two cases weighted with subterrainean thickness.
             351     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, tmp
                                   <<< Loop-information  End >>>
             352     3   p                   do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, tmp
                                   <<< Loop-information  End >>>
             353     4   p   2v                do i = 1,nxj
             354     4   p   2v                  tmp(i,k,jj) = tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             355     4   p   2v                enddo
             356     3   p                   enddo
             357     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, slp, sgeo, plog, tmp, plt, bt1
                                   <<<      t1000
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             358     3   p    v              do i=1,nxj
             359     3   p    v                slp(i,jj) = max( slp(i,jj), pt(i,jj) )
             360     3   p    v                splog= log(slp(i,jj))
             361     3   p    v                dx= log(slp(i,jj)/(pt(i,jj)+ptop))
             362     3               !          bx= tmp(i,lev,jj)*(1.0/sig(lev+1))**0.19023 + sgeo(i,jj)*0.00065
             363     3   p    v                bx= tmp(i,lev,jj) + sgeo(i,jj)*0.00065
             364     4   p    v                if ( sgeo(i,jj) .ge. 1000.0 )  then
             365     4   p    v                  tmid = sgeo(i,jj)/(dx*rgas)
             366     4   p    v                  ax = tmp(i,lev,jj)+ (tmid-tmp(i,lev,jj))*(splog-plog(i,lev,jj)) &
             367     4                               / (log((slp(i,jj)+pt(i,jj)+ptop)*0.5)-plog(i,lev,jj))
             368     4   p    v                else
             369     4   p    v                  ax = bx
             370     4   p    v                endif
             371     3   p    v                cx = (sgeo(i,jj)-1000.0)/(10000.0-1000.0)
             372     3   p    v                cx = max (0.0, min (1.0, cx))
             373     3   p    v                dx = cx*cx
             374     3   p    v                tsf = dx*ax + (1.0-dx)*bx
             375     3   p    v                tadia= tmp(i,lev,jj)*(slp(i,jj)/plt(i,lev,jj))**0.25
             376     3   p    v                tsf  = max( tmp(i,lev,jj), min( tsf,tadia ) )
             377     4   p    v                if ( slp(i,jj) .gt. 1000.1 )  then
             378     4   p    v                  bt1(i,jj)= tsf
             379     4   p    v                  t1000(i,jj) = tsf
             380     4   p    v                else
             381     4   p    v                  bt1(i,jj)= tsf + (tsf-tmp(i,lev,jj))*(pl1000-splog)  &
             382     4                                    / (splog - plog(i,lev,jj))
             383     4   p    v                  t1000(i,jj) = bt1(i,jj)
             384     4   p    v                endif
             385     3   p    v              enddo
             386     2   p                 enddo

               1                           subroutine matrix_hybrid_cwb(cp,sigma,dsigma,ptop,ptmean,tmean,spalm &
               2                                             ,eigval,evecin,evectr,arrhyd,arsddt                &
               3                                             ,pmcor,tmcor )
               4                     !
               5                     !  ***input***
               6                     !
               7                     !  cp: specific heat of air
               8                     !  sig: sigma coordinate array
               9                     !  dsig: sigma coordinate layer thickness array
              10                     !  ptop: pressure at model top
              11                     !  ptmean: reference terrain pressure for linearization
              12                     !  tmean: reference temperature profile for linearization
              13                     !  spalm: linearized energy conversion term
              14                     !
              15                     !  ***output***
              16                     !
              17                     !  eigval: eigenvalues of gravity wave matrix
              18                     !  evectr: eigenvectors of gravity wave matrix
              19                     !  evecin: inverse of evectr
              20                     !  arrhyd: hydrostatic matrix for reference atmosphere
              21                     !  arsddt: matrix operator for mean vertical temperature advection
              22                     !  pmcor: vector used in future normal mode initialization
              23                     !  tmcor: matrix used in future normal mode initialization
              24                     !
              25                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              26                     !
              27                     ! *******************************************************************
              28                     !
              29                     !  matrix computes the matrix operators used in the semi-implicit
              30                     !  time differencing scheme of the model.
              31                     !
              32                           use param
              33                           use const, only : RTYPE
              34                     
              35                           implicit  none
              36                           real      cp,ptop
              37                     !
              38                           real(kind=RTYPE) eigval(lev),evecin(lev,lev),evectr(lev,lev),    &
              39                                     pmcor(lev),tmcor(lev,lev),arrhyd(lev,lev),             &
              40                                     arsddt(lev,lev),sigma(lev+1,2),dsigma(lev,2),          &
              41                                     tmean(lev),spalm(lev),ptmean
              42                     !
              43                           integer   ipp(lev*2),iwk(lev)
              44                     !  in order to keep the stability. two variables below can not be single precision.
              45                           real      dp(lev),dcdp(lev)
              46                     !
              47                           real(kind=RTYPE) a(lev,lev),b(lev,lev),asd(lev,lev),ai(lev,lev), &
              48                                     csrtn(lev,lev),enorm(lev),tmp(lev),                    &
              49                                     phatk(lev+1),pko(lev),thatm(lev),p2(lev+1)
              50                     !
              51                     !  compute some pressure related variables from reference atmosphere
              52                     !
              53                           integer   k,j,ier,jj,i,l
              54                           real      capa,capap1,at,det
              55                     !
              56                           capa= 1.0/3.5
              57                           capap1= 1.0+capa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.28, ITR: 80, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phatk, p2, sigma
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 40
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              58     1  pp    v            do 135 k=1,lev+1
              59     1   p    v            p2(k)= ptop+sigma(k,1)*ptmean+sigma(k,2)
              60     1               !      p2(k)= ptop+sig(k)*ptmean
              61     1   p    v            phatk(k)= (p2(k)/1000.0)**capa
              62     1               !jh      sig(k) = (p2(k)-ptop) / ptmean
              63     1   p    v        135 continue
              64                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 211
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 65,71)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p2, phatk, tmean, sigma, spalm, pko, dp
                                   <<< Loop-information  End >>>
              65     1  pp    v            do 145 k=1,lev
              66     1   p    v            dp(k)= p2(k+1)-p2(k)
              67     1               !jh      dsig(k) = sig(k+1) - sig(k)
              68     1   p    v            pko(k)= (p2(k+1)*phatk(k+1)-p2(k)*phatk(k))/(capap1*dp(k))
              69     1   p    v        145 continue
              70                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
              71     1                     do 120 k=1,lev
              72     1                     tmean(k)= tmean(k)/pko(k)
              73     1                     spalm(k)= tmean(k)*(sigma(k,1)*(pko(k)-phatk(k))+sigma(k+1,1)     &
              74     1                      *(phatk(k+1)-pko(k)))/dp(k)
              75     1               !jh      spalm(k)= tmean(k)*(sig(k)*(pko(k)-phatk(k))+sig(k+1)
              76     1               !jh     * *(phatk(k+1)-pko(k)))/dp(k)
              77     1                 120 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.46, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmean, pko, phatk, thatm
                                   <<< Loop-information  End >>>
              78     1  pp    v            do 140 k=1,lev-1
              79     1   p    v            at= (phatk(k+1)-pko(k))/(pko(k+1)-pko(k))
              80     1   p    v            thatm(k)= tmean(k)*at+tmean(k+1)*(1.0-at)
              81     1   p    v        140 continue
              82                     !
              83                     ! computation of hydrostatic matrix operators
              84                     !
              85                           call zilch (a,lev*lev)
              86                           call zilch (b,lev*lev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 373
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pko, phatk
                                   <<< Loop-information  End >>>
              87     1  pp    v            do 2 j=1,lev-1
              88     1   p    v            a(j,j)= -1.0
              89     1   p    v            a(j,j+1)= 1.0
              90     1   p    v            b(j,j)= cp*(pko(j)-phatk(j+1))
              91     1   p    v            b(j,j+1)= cp*(phatk(j+1)-pko(j+1))
              92     1   p    v          2 continue
              93                           a(lev,lev)= 1.0
              94                           b(lev,lev)= cp*(phatk(lev+1)-pko(lev))
              95                     !
              96                           call invmtx (a,lev,ai,lev,lev,det,ipp,ier)
              97                           call mtxmlp (ai,b,arrhyd,lev)
              98                     !
              99                           call pmatrx_hybrid_cwb(cp,tmean,ptop,ptmean,spalm,phatk(2),sigma  &
             100                                                 ,ai,dcdp)
             101                     !
             102                           call zilch (a,lev*lev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmean, thatm, dp
                                   <<< Loop-information  End >>>
             103     1  pp    v            do 7 k=1,lev-1
             104     1   p    v            if(k.gt.1) a(k,k)= (tmean(k)-thatm(k-1))/dp(k)
             105     1   p    v          7 a(k,k+1)= (thatm(k)-tmean(k))/dp(k)
             106                           a(lev,lev)= (tmean(lev)-thatm(lev-1))/dp(lev)
             107                           call zilch (asd,lev*lev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp
                                   <<< Loop-information  End >>>
             108     1  pp                 do 20 j=2,lev
             109     1   p                 jj= j-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp
                                   <<< Loop-information  End >>>
             110     2   p   2v            do 30 i=1,lev
             111     2   p   2v         30   asd(j,i)=  sigma(j,1) *dp(i)
             112     1               !   30 asd(j,i)= sig(j)*dp(i)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp
                                   <<< Loop-information  End >>>
             113     2   p   2v            do 20 i=1,jj
             114     1   p   2v         20   asd(j,i)= (sigma(j,1)-1.0)*dp(i)
             115                     !   20 asd(j,i)= (sig(j)-1.0)*dp(i)
             116                           call mtxmlp (a,asd,arsddt,lev)
             117                     #ifdef VERBOSE
             118                           tmp=dcdp
             119                           call mtxprt (tmp,lev,1,'dcdp    ','f10.4   ')
             120                           tmp=dp
             121                           call mtxprt (tmp,lev,1,'dp      ','f10.4   ')
             122                     #endif
             123                     !
             124                           call mtxmlp (arrhyd,arsddt,a,lev)
             125                           call zilch (csrtn,lev*lev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.20, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dcdp, spalm
                                   <<< Loop-information  End >>>
             126     1  pp   2v            do 10 j=1,lev
             127     1   p   2v            spalm(j)= dcdp(j)+cp*spalm(j)
             128     1   p   2v         10 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      spalm, a, csrtn
                                   <<< Loop-information  End >>>
             129     1  pp                 do 11 i=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 112, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      spalm, a, csrtn
                                   <<< Loop-information  End >>>
             130     2   p   2v            do 11 j=1,lev
             131     1   p   2v         11 csrtn(j,i)= a(j,i)+spalm(j)*dp(i)
             132                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      csrtn, evecin
                                   <<< Loop-information  End >>>
             133     1  pp   4v            do 15 i=1,lev*lev
             134     1   p   4v            evecin(i,1)= csrtn(i,1)
             135     1   p   4v         15 continue
             136                     !
             137                     !  find eigenvalues and eigenvectors of gravity wave modes
             138                     !
             139                     !  evectr in "rg" should be a integer array
             140                     !  1/9/2004
             141                     !err  call rg (lev,lev,evecin,a,eigval,1,b,evectr,enorm,ier)
             142                     #ifdef SP
             143                     !sigle precision version in fujitsu
             144                           call eig1(evecin,lev,lev,0,a,eigval,b,enorm,ier)
             145                     #else
             146                           call rg (lev,lev,evecin,a,eigval,1,b,iwk,enorm,ier)
             147                     #endif
             148                     !sun  call rg (lev,lev,evecin,eigval,a,1,evectr,b,enorm,ier)
             149                     !fuji      call deig1(evecin,lev,lev,0,a,eigval,b,enorm,ier)
             150                     
             151                     !
             152                     !  normalize vertical eigenvector matrix
             153                     !
             154                     !      call orders (2,wrk,a,ipp,lev,1,8,1)
             155                           call indexx (lev,a,ipp)
             156                     !
             157                     !  normalize vertical eigenvector matrix
             158                     !
             159                     !sun-no: i.e. cray only  ( make eigval be decending order)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b, evectr
                                   <<< Loop-information  End >>>
             160     1  pp                 do 40 j = 1, lev
             161     1   p                 jj = lev -j + 1
             162     1   p                 eigval(jj)   = a(ipp(j),1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      b, evectr
                                   <<< Loop-information  End >>>
             163     2   p   2v            do 40 i = 1, lev
             164     2   p   2v            evectr(i,jj) = b(i,ipp(j))
             165     1   p   2v         40 continue
             166                     !sun-no: i.e. cray only
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dsigma, evectr
                                   <<< Loop-information  End >>>
             167     1  pp                 do 45 i=1,lev
             168     1   p                 enorm(i)= 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.34, ITR: 384, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      evectr, dsigma
                                   <<< Loop-information  End >>>
             169     2   p   8v            do 50 j=1,lev
             170     2   p   8v         50 enorm(i)= enorm(i)+(dsigma(j,1)+dsigma(j,2)/ptmean)               &
             171     1                                        *evectr(j,i)*evectr(j,i)
             172     1               !jh1   50 enorm(i)= enorm(i)+dsigma(j,1)*evectr(j,i)*evectr(j,i)
             173     1               !jh   50 enorm(i)= enorm(i)+dsig(j)*evectr(j,i)*evectr(j,i)
             174     1   p                 enorm(i)= 1.0/sqrt(enorm(i))
             175     1   p              45 continue
             176                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      evectr
                                   <<< Loop-information  End >>>
             177     1  pp                 do 55 i=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 512, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      evectr
                                   <<< Loop-information  End >>>
             178     2   p   2v            do 55 j=1,lev
             179     1   p   2v         55 evectr(j,i)= evectr(j,i)*enorm(i)
             180                     !
             181                           call invmtx (evectr,lev,evecin,lev,lev,det,ipp,ier)
             182                     #ifdef VERBOSE
             183                           call mtxprt (arrhyd,lev,lev,'arrhyd  ','20f6.2  ')
             184                           call mtxprt (eigval,lev,1,'eigval  ','f12.4   ')
             185                           call mtxprt (evectr,lev,lev,'evectr  ','20f7.3  ')
             186                           call mtxprt (evecin,lev,lev,'evecin  ','20f7.3  ')
             187                     #endif
             188                           call invmtx (csrtn,lev,b,lev,lev,det,ipp,ier)
             189                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :

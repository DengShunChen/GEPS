             185                     !-----------------------------------
             186                           subroutine gas_init                                               &
             187                     !...................................
             188                     
             189                     !  ---  inputs:
             190                          &     ( me,myrank )
             191                     !  ---  outputs: ( none )
             192                     
             193                     !  ===================================================================  !
             194                     !                                                                       !
             195                     !  gas_init sets up ozone, co2, etc. parameters.  if climatology ozone  !
             196                     !  then read in monthly ozone data.                                     !
             197                     !                                                                       !
             198                     !  inputs:                                               dimemsion      !
             199                     !     me      - print message control flag                  1           !
             200                     !                                                                       !
             201                     !  outputs: (to the module variables)                                   !
             202                     !    ( none )                                                           !
             203                     !                                                                       !
             204                     !  external module variables:  (in physpara)                            !
             205                     !     ico2flg    - co2 data source control flag                         !
             206                     !                   =0: use prescribed co2 global mean value            !
             207                     !                   =1: use input global mean co2 value (co2_glb)       !
             208                     !                   =2: use input 2-d monthly co2 value (co2vmr_sav)    !
             209                     !     ictmflg    - =yyyy#, data ic time/date control flag               !
             210                     !                  =   -2: same as 0, but superimpose seasonal cycle    !
             211                     !                          from climatology data set.                   !
             212                     !                  =   -1: use user provided external data for the fcst !
             213                     !                          time, no extrapolation.                      !
             214                     !                  =    0: use data at initial cond time, if not existed!
             215                     !                          then use latest, without extrapolation.      !
             216                     !                  =    1: use data at the forecast time, if not existed!
             217                     !                          then use latest and extrapolate to fcst time.!
             218                     !                  =yyyy0: use yyyy data for the forecast time, no      !
             219                     !                          further data extrapolation.                  !
             220                     !                  =yyyy1: use yyyy data for the fcst. if needed, do    !
             221                     !                          extrapolation to match the fcst time.        !
             222                     !     ioznflg    - ozone data control flag                              !
             223                     !                   =0: use climatological ozone profile                !
             224                     !                   >0: use interactive ozone profile                   !
             225                     !     ivflip     - vertical profile indexing flag                       !
             226                     !     co2usr_file- external co2 user defined data table                 !
             227                     !     co2cyc_file- external co2 climotology monthly cycle data table    !
             228                     !                                                                       !
             229                     !  internal module variables:                                           !
             230                     !     pkstr, o3r - arrays for climatology ozone data                    !
             231                     !                                                                       !
             232                     !  usage:    call gas_init                                              !
             233                     !                                                                       !
             234                     !  subprograms called:  none                                            !
             235                     !                                                                       !
             236                     !  ===================================================================  !
             237                     !
             238                           implicit none
             239                     
             240                     !  ---  inputs:
             241                           integer, intent(in) :: me, myrank
             242                     
             243                     !  ---  output: ( none )
             244                     
             245                     !  ---  locals:
             246                           real (kind=kind_phys), dimension(imxco2,jmxco2) :: co2dat
             247                           real (kind=kind_phys), dimension(imxco2,jmxco2,12) :: co2dat3
             248                           real (kind=kind_phys) :: co2g1, co2g2
             249                           real (kind=kind_phys) :: pstr(loz)
             250                           real (kind=kind_io4)  :: o3clim4(jmr,loz,12), pstr4(loz)
             251                     
             252                           integer    :: imond(12), ilat(jmr,12)
             253                           integer    :: i, j, k, iyr, imo, jn
             254                           logical    :: file_exist, lextpl
             255                           character  :: cline*100, cform*8
             256                           data  cform  / '(24f7.2)' /       !! data format in imxco2*f7.2
             257                     !
             258                     !===>  ...  begin here
             259                     !
             260                           if ( me == 0 .and. myrank == 0) print *, vtaggas    ! print out version tag
             261                     
             262                           kyrsav  = 0
             263                           kmonsav = 1
             264                     
             265                     !  --- ...  climatology ozone data section
             266                     
             267     1                     if ( ioznflg > 0 ) then
             268     2                       if ( me == 0 .and. myrank == 0 ) then
             269     2                         print *,' - using interactive ozone distribution'
             270     2                       endif
             271     1                     else
             272     2                       if ( timeozc /= 12 ) then
             273     2                         print *,' - using climatology ozone distribution'
             274     2                         print *,' timeozc=',timeozc, ' is not monthly mean',          &
             275     2                    &            ' - job aborting in subroutin gas_init!!!'
             276     2                         stop
             277     2                       endif
             278     1               
             279     1                       allocate (pkstr(loz), o3r(jmr,loz,12))
             280     1                       rewind nio3clm
             281     1               
             282     2                       if ( loz == 17 ) then       ! for the operational ozone climatology
             283     3   s    s                do k = 1, loz
             284     3   s    s                  read (nio3clm,15) pstr4(k)
             285     3                  15       format(f10.3)
             286     3   s    s                enddo
             287     2               
             288     3                         do imo = 1, 12
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             289     4   s    s                  do j = 1, jmr
             290     4   m    m                    read (nio3clm,16) imond(imo), ilat(j,imo),                &
             291     4                    &                          (o3clim4(j,k,imo),k=1,10)
             292     4                  16         format(i2,i4,10f6.2)
             293     4   m    m                    read (nio3clm,20) (o3clim4(j,k,imo),k=11,loz)
             294     4                  20         format(6x,10f6.2)
             295     4   p    v                  enddo
             296     3                         enddo
             297     2                       else                      ! for newer ozone climatology
             298     2                         read (nio3clm)
             299     3   s    s                do k = 1, loz
             300     3   s    s                  read (nio3clm) pstr4(k)
             301     3   s    s                enddo
             302     2               
             303     3                         do imo = 1, 12
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             304     4   s    s                  do k = 1, loz
             305     4   m    s                    read (nio3clm) (o3clim4(j,k,imo),j=1,jmr)
             306     4   p    s                  enddo
             307     3                         enddo
             308     2                       endif   ! end if_loz_block
             309     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             310     2  pp                   do imo = 1, 12
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      o3clim4, o3r
                                   <<< Loop-information  End >>>
             311     3   p                     do k = 1, loz
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      o3clim4, o3r
                                   <<< Loop-information  End >>>
             312     4   p   2v                  do j = 1, jmr
             313     4   p   2v                    o3r(j,k,imo) = o3clim4(j,k,imo) * 1.655e-6
             314     4   p   2v                  enddo

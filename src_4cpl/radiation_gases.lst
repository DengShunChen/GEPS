            1055                           subroutine getozn                                                 &
            1056                     !...................................
            1057                     
            1058                     !  ---  inputs:
            1059                          &     ( prslk,xlat,                                                &
            1060                          &       imax, lm,                                                  &
            1061                     !  ---  outputs:
            1062                          &       o3mmr                                                      &
            1063                          &     )
            1064                     
            1065                     !  ===================================================================  !
            1066                     !                                                                       !
            1067                     !  getozn sets up climatological ozone profile for radiation calculation!
            1068                     !                                                                       !
            1069                     !  this code is originally written by shrinivas moorthi                 !
            1070                     !                                                                       !
            1071                     !  inputs:                                                              !
            1072                     !     prslk (imax,lm)  - exner function = (p/p0)**rocp                  !
            1073                     !     xlat  (imax)     - latitude in radians, default to pi/2 -> -pi/2  !
            1074                     !                        range, otherwise see in-line comment           !
            1075                     !     imax, lm         - horizontal and vertical dimensions             !
            1076                     !                                                                       !
            1077                     !  outputs:                                                             !
            1078                     !     o3mmr (imax,lm)  - output ozone profile in mass mixing ratio (g/g)!
            1079                     !                                                                       !
            1080                     !  module variables:                                                    !
            1081                     !     k1oz, k2oz       - ozone data interpolation indices               !
            1082                     !     facoz            - ozone data interpolation factor                !
            1083                     !     ivflip           - control flag for direction of vertical index   !
            1084                     !                                                                       !
            1085                     !  usage:    call getozn                                                !
            1086                     !                                                                       !
            1087                     !  ===================================================================  !
            1088                     !
            1089                           implicit none
            1090                     
            1091                     !  ---  inputs:
            1092                           integer,  intent(in) :: imax, lm
            1093                     
            1094                           real (kind=kind_phys), intent(in) :: prslk(:,:), xlat(:)
            1095                     
            1096                     !  ---  outputs:
            1097                           real (kind=kind_phys), intent(out) :: o3mmr(:,:)
            1098                     
            1099                     !  ---  locals:
            1100                           real (kind=kind_phys) :: o3i(imax,loz), wk1(imax), deglat, elte,  &
            1101                          &                         tem, tem1, tem2, tem3, tem4, temp
            1102                     
            1103                           integer :: i, j, k, l, j1, j2, ll
            1104                     !
            1105                     !===> ...  begin here
            1106                     !
            1107                           elte = blte + (jmr-1)*dlte
            1108                     
            1109     1                     do i = 1, imax
            1110     1                       deglat = xlat(i) * raddeg        ! if xlat in pi/2 -> -pi/2 range
            1111     1               !       deglat = 90.0 - xlat(i)*raddeg   ! if xlat in 0 -> pi range
            1112     1               
            1113     2                       if (deglat > blte .and. deglat < elte) then
            1114     2                         tem1 = (deglat - blte) / dlte + 1
            1115     2                         j1   = tem1
            1116     2                         j2   = j1 + 1
            1117     2                         tem1 = tem1 - j1
            1118     2                       elseif (deglat <= blte) then
            1119     2                         j1   = 1
            1120     2                         j2   = 1
            1121     2                         tem1 = 1.0
            1122     2                       elseif (deglat >= elte) then
            1123     2                         j1   = jmr
            1124     2                         j2   = jmr
            1125     2                         tem1 = 1.0
            1126     2                       endif
            1127     1               
            1128     1                       tem2 = 1.0 - tem1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.81, ITR: 80, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            1129     2  pp   2v              do j = 1, loz
            1130     2   p   2v                tem3     = tem2*o3r(j1,j,k1oz) + tem1*o3r(j2,j,k1oz)
            1131     2   p   2v                tem4     = tem2*o3r(j1,j,k2oz) + tem1*o3r(j2,j,k2oz)
            1132     2   p   2v                o3i(i,j) = tem4*facoz          + tem3*(1.0 - facoz)
            1133     2   p   2v              enddo
            1134     1                     enddo
            1135                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wk1, o3i
                                   <<< Loop-information  End >>>
            1136     1                     do l = 1, lm
            1137     1                       ll = l
            1138     1                       if (ivflip == 1) ll = lm -l + 1
            1139     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wk1
                                   <<< Loop-information  End >>>
            1140     2  pp   4v              do i = 1, imax
            1141     2   p   4v                wk1(i) = prslk(i,ll)
            1142     2   p   4v              enddo
            1143     1               
            1144     2                       do k = 1, loz-1
            1145     2                         temp = 1.0 / (pkstr(k+1) - pkstr(k))
            1146     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wk1
                                   <<< Loop-information  End >>>
            1147     3  pp   2s                do i = 1, imax
            1148     4   p   2m                  if (wk1(i) > pkstr(k) .and. wk1(i) <= pkstr(k+1)) then
            1149     4   p   2s                    tem       = (pkstr(k+1) - wk1(i)) * temp
            1150     4   p   2s                    o3mmr(i,ll) = tem * o3i(i,k) + (1.0 - tem) * o3i(i,k+1)
            1151     4   p   2v                  endif
            1152     3   p   2v                enddo
            1153     2                       enddo
            1154     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.33, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wk1, o3i
                                   <<< Loop-information  End >>>
            1155     2  pp   2v              do i = 1, imax
            1156     2   p   2v                if (wk1(i) > pkstr(loz)) o3mmr(i,ll) = o3i(i,loz)
            1157     2   p   2v                if (wk1(i) < pkstr(1))   o3mmr(i,ll) = o3i(i,1)
            1158     2   p   2v              enddo
            1159     1                     enddo
            1160                     !
            1161                           return
            1162                     !...................................
            1163                           end subroutine getozn
            1164                     !-----------------------------------
            1165                     
            1166                     !
            1167                     !........................................!
            1168                           end module module_radiation_gases  !

             137                     
             138                     !  ---  parameter constants for gas volume mixing ratioes
             139                           real (kind=kind_phys), parameter :: co2vmr_def = 350.0e-6
             140                           real (kind=kind_phys), parameter :: n2ovmr_def = 0.31e-6
             141                           real (kind=kind_phys), parameter :: ch4vmr_def = 1.50e-6
             142                           real (kind=kind_phys), parameter :: o2vmr_def  = 0.209
             143                           real (kind=kind_phys), parameter :: covmr_def  = 1.50e-8
             144                           real (kind=kind_phys), parameter :: f11vmr_def = 3.520e-10   ! aer 2003 value
             145                           real (kind=kind_phys), parameter :: f12vmr_def = 6.358e-10   ! aer 2003 value
             146                           real (kind=kind_phys), parameter :: f22vmr_def = 1.500e-10   ! aer 2003 value
             147                           real (kind=kind_phys), parameter :: cl4vmr_def = 1.397e-10   ! aer 2003 value
             148                           real (kind=kind_phys), parameter :: f113vmr_def= 8.2000e-11  ! gfdl 1999 value
             149                     
             150                     !  ---  ozone seasonal climatology parameters defined in module ozne_def
             151                     !   - 4x5 ozone data parameter
             152                     !     integer, parameter :: jmr=45, loz=17
             153                     !     real (kind=kind_phys), parameter :: blte=-86.0, dlte=4.0
             154                     !   - geos ozone data
             155                     !     integer, parameter :: jmr=18, loz=17
             156                     !     real (kind=kind_phys), parameter :: blte=-85.0, dlte=10.0
             157                     

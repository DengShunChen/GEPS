             502                     !-----------------------------------
             503                           subroutine gas_update                                             &
             504                     !...................................
             505                     
             506                     !  ---  inputs:
             507                          &     ( myrank, iyear, imon, iday, ihour, loz1st, ldoco2, me )
             508                     !  ---  outputs: ( none )
             509                     
             510                     !  ===================================================================  !
             511                     !                                                                       !
             512                     !  gas_update reads in 2-d monthly co2 data set for a specified year.   !
             513                     !  data are in a 15 degree lat/lon horizontal resolution.               !
             514                     !                                                                       !
             515                     !  inputs:                                               dimemsion      !
             516                     !     iyear   - year of the requested data for fcst         1           !
             517                     !     imon    - month of the year                           1           !
             518                     !     iday    - day of the month                            1           !
             519                     !     ihour   - hour of the day                             1           !
             520                     !     loz1st  - clim ozone 1st time update control flag     1           !
             521                     !     ldoco2  - co2 update control flag                     1           !
             522                     !     me      - print message control flag                  1           !
             523                     !                                                                       !
             524                     !  outputs: (to the module variables)                                   !
             525                     !    ( none )                                                           !
             526                     !                                                                       !
             527                     !  external module variables:  (in physpara)                            !
             528                     !     ico2flg    - co2 data source control flag                         !
             529                     !                   =0: use prescribed co2 global mean value            !
             530                     !                   =1: use input global mean co2 value (co2_glb)       !
             531                     !                   =2: use input 2-d monthly co2 value (co2vmr_sav)    !
             532                     !     ictmflg    - =yyyy#, data ic time/date control flag               !
             533                     !                  =   -2: same as 0, but superimpose seasonal cycle    !
             534                     !                          from climatology data set.                   !
             535                     !                  =   -1: use user provided external data for the fcst !
             536                     !                          time, no extrapolation.                      !
             537                     !                  =    0: use data at initial cond time, if not existed!
             538                     !                          then use latest, without extrapolation.      !
             539                     !                  =    1: use data at the forecast time, if not existed!
             540                     !                          then use latest and extrapolate to fcst time.!
             541                     !                  =yyyy0: use yyyy data for the forecast time, no      !
             542                     !                          further data extrapolation.                  !
             543                     !                  =yyyy1: use yyyy data for the fcst. if needed, do    !
             544                     !                          extrapolation to match the fcst time.        !
             545                     !     ioznflg    - ozone data control flag                              !
             546                     !                   =0: use climatological ozone profile                !
             547                     !                   >0: use interactive ozone profile                   !
             548                     !     ivflip     - vertical profile indexing flag                       !
             549                     !     co2dat_file- external co2 2d monthly obsv data table              !
             550                     !     co2gbl_file- external co2 global annual mean data table           !
             551                     !                                                                       !
             552                     !  internal module variables:                                           !
             553                     !     co2vmr_sav - monthly co2 volume mixing ratio     imxco2*jmxco2*12 !
             554                     !     co2cyc_sav - monthly cycle co2 vol mixing ratio  imxco2*jmxco2*12 !
             555                     !     co2_glb    - global annual mean co2 mixing ratio                  !
             556                     !     gco2cyc    - global monthly mean co2 variation       12           !
             557                     !     k1oz,k2oz,facoz                                                   !
             558                     !                - climatology ozone parameters             1           !
             559                     !                                                                       !
             560                     !  usage:    call gas_update                                            !
             561                     !                                                                       !
             562                     !  subprograms called:  none                                            !
             563                     !                                                                       !
             564                     !  ===================================================================  !
             565                     !
             566                           implicit none
             567                     
             568                     !  ---  inputs:
             569                           integer, intent(in) :: iyear, imon, iday, ihour, me, myrank
             570                     
             571                           logical, intent(in) :: loz1st, ldoco2
             572                     
             573                     !  ---  output: ( none )
             574                     
             575                     !  ---  locals:
             576                           real (kind=kind_phys), dimension(imxco2,jmxco2) :: co2dat, co2ann
             577                           real (kind=kind_phys), dimension(imxco2,jmxco2,12) :: co2dat3
             578                           real (kind=kind_phys) :: co2g1, co2g2, rate
             579                     
             580                           integer    :: i, id, j, l, iyr, imo, iyr1, iyr2, jyr, idyr, jn
             581                           integer, save :: mdays(13), midmon=15, midm=15, midp=45
             582                     !  ---  number of days in a month
             583                           data mdays / 31,28,31,30,31,30,31,31,30,31,30,31,30 /
             584                     
             585                           logical    :: file_exist, lextpl, change
             586                           character  :: cline*100, cform*8, cfile1*26
             587                           data  cform  / '(24f7.2)' /       !! data format in imxco2*f7.2
             588                     !
             589                     !===>  ...  begin here
             590                     !
             591                     !  --- ...  ozone data section
             592                     
             593     1                     if ( ioznflg == 0 ) then
             594     1                       midmon = mdays(imon)/2 + 1
             595     1                       change = loz1st .or. ( (iday==midmon) .and. (ihour==0) )
             596     1               !
             597     2                       if ( change ) then
             598     3                         if ( iday < midmon ) then
             599     3                           k1oz = mod(imon+10, 12) + 1
             600     3                           midm = mdays(k1oz)/2 + 1
             601     3                           k2oz = imon
             602     3                           midp = mdays(k1oz) + midmon
             603     3                         else
             604     3                           k1oz = imon
             605     3                           midm = midmon
             606     3                           k2oz = mod(imon, 12) + 1
             607     3                           midp = mdays(k2oz)/2 + 1 + mdays(k1oz)
             608     3                         endif
             609     2                       endif
             610     1               !
             611     2                       if (iday < midmon) then
             612     2                        id = iday + mdays(k1oz)
             613     2                       else
             614     2                        id = iday
             615     2                       endif
             616     1               
             617     1                       facoz = float(id - midm) / float(midp - midm)
             618     1                     endif
             619                     
             620                     !  --- ...  co2 data section
             621                     
             622                           if ( ico2flg == 0 ) return    ! use prescribed global mean co2 data
             623                           if ( ictmflg ==-1 ) return    ! use user provided co2 data
             624                           if ( .not. ldoco2 ) return    ! no need to update co2 data
             625                     
             626     1                     if ( ictmflg < 0 ) then        ! use user provided external data
             627     1                       lextpl = .false.                   ! no time extrapolation
             628     1                       idyr   = iyear                     ! use the model year
             629     1                     else                           ! use historically observed data
             630     1                       lextpl = ( mod(ictmflg,10) == 1 )  ! flag for data extrapolation
             631     1                       idyr   = ictmflg / 10              ! year of data source used
             632     1                       if ( idyr == 0 ) idyr = iyear      ! not specified, use model year
             633     1                     endif
             634                     
             635                     !  --- ...  auto select co2 2-d data table for required year
             636                     
             637                           kmonsav = imon
             638                           if ( kyrsav == iyear ) return
             639                           kyrsav = iyear
             640                           iyr    = iyear
             641                     
             642                     !  --- ...  for data earlier than minyear (1957), the data are in
             643                     !           the form of semi-yearly global mean values.  otherwise,
             644                     !           data are monthly mean in horizontal 2-d map.
             645                     
             646     1                     lab_if_idyr : if ( idyr < minyear .and. ictmflg > 0 ) then
             647     1               
             648     2                       if ( me == 0 .and. myrank == 0) then
             649     2                         print *,'   requested co2 data year',iyear,' earlier than',   &
             650     2                    &            minyear
             651     2                         print *,'   which is the earliest monthly observation',       &
             652     2                    &            ' data available.'
             653     2                         print *,'   thus, historical global mean data is used'
             654     2                       endif
             655     1               
             656     1               !  --- ... check to see if requested co2 data file existed
             657     1               
             658     1                       inquire (file=co2gbl_file, exist=file_exist)
             659     2                       if ( .not. file_exist ) then
             660     2                         print *,'   requested co2 data file "',co2gbl_file,           &
             661     2                    &            '" not found - stopped in subroutine gas_update!!'
             662     2                         stop
             663     2                       else
             664     2                         close(nico2cn)
             665     2                         open (nico2cn,file=co2gbl_file,form='formatted',status='old')
             666     2                         rewind nico2cn
             667     2               
             668     2                         read (nico2cn, 24) iyr1, iyr2, cline
             669     2                 24      format(i4,4x,i4,a48)
             670     2               
             671     3                         if ( me == 0 .and. myrank == 0) then
             672     3                           print *,'   opened co2 data file: ',co2gbl_file
             673     3               !check      print *, iyr1, iyr2, cline(1:48)
             674     3                         endif
             675     2               
             676     3                         if ( idyr < iyr1 ) then
             677     3                           iyr = iyr1
             678     3               !check      if ( me == 0 ) then
             679     3               !             print *,'   using earlist available co2 data, year=',iyr1
             680     3               !check      endif
             681     3                         endif
             682     2               
             683     2                         i = iyr2
             684     3                         lab_dowhile1 : do while ( i >= iyr1 )
             685     3               !           read (nico2cn,26) jyr, co2g1, co2g2
             686     3               ! 26        format(i4,4x,2f7.2)
             687     3                           read (nico2cn, *) jyr, co2g1, co2g2
             688     3               
             689     4                           if ( i == iyr .and. iyr == jyr ) then
             690     4                             co2_glb = (co2g1+co2g2) * 0.5e-6
             691     5                             if ( ico2flg == 2 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<< Loop-information  End >>>
             692     6  pp                           do j = 1, jmxco2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.25, ITR: 36, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             693     7   p   2                         do i = 1, imxco2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             694     7   p   2v                          co2vmr_sav(i,j,1:6)  = co2g1 * 1.0e-6
             695     7   p   2v                          co2vmr_sav(i,j,7:12) = co2g2 * 1.0e-6
             696     7   p   2                         enddo
             697     6   p                           enddo
             698     5                             endif
             699     4               
             700     5                             if ( me == 0 .and. myrank == 0 ) then
             701     5                                  print *,'  co2 data for year',iyear,co2_glb
             702     5                             endif
             703     4                             exit lab_dowhile1
             704     4                           else
             705     4               !check        if ( me == 0 ) print *,'   skip co2 data for year',i
             706     4                             i = i - 1
             707     4                           endif
             708     3                         enddo  lab_dowhile1
             709     2               
             710     2                         close ( nico2cn )
             711     2                       endif   ! end if_file_exist_block
             712     1               
             713     1                     else  lab_if_idyr
             714     1               
             715     1               !  --- ...  set up input data file name
             716     1               
             717     1                       cfile1 = co2dat_file
             718     1                       write(cfile1(19:22),34) idyr
             719     1                 34    format(i4.4)
             720     1               
             721     1               !  --- ... check to see if requested co2 data file existed
             722     1               
             723     1                       inquire (file=cfile1, exist=file_exist)
             724     2                       if ( .not. file_exist ) then
             725     2               
             726     3                         lab_if_ictm : if ( ictmflg  > 10 ) then    ! specified year of data not found
             727     4                           if ( me == 0 .and. myrank == 0  ) then
             728     4                             print *,'   specified co2 data for year',idyr,            &
             729     4                    &               ' not found !!  need to change namelist ictm !!'
             730     4                             print *,'   *** stopped in subroutine gas_update !!'
             731     4                           endif
             732     3                           stop
             733     3                         else lab_if_ictm                        ! looking for latest available data
             734     4                           if ( me == 0 .and. myrank == 0) then
             735     4                             print *,'   requested co2 data for year',idyr,            &
             736     4                    &              ' not found, check for other available data set'
             737     4                           endif
             738     3               
             739     4                           lab_dowhile2 : do while ( iyr >= minyear )
             740     4                             iyr = iyr - 1
             741     4                             write(cfile1(19:22),34) iyr
             742     4               
             743     4                             inquire (file=cfile1, exist=file_exist)
             744     5                             if ( me == 0 .and. myrank == 0 ) then
             745     5                               print *,' looking for co2 file ',cfile1
             746     5                             endif
             747     4               
             748     5                             if ( file_exist ) then
             749     5                               exit lab_dowhile2
             750     5                             endif
             751     4                           enddo   lab_dowhile2
             752     3               
             753     4                           if ( .not. file_exist ) then
             754     5                             if ( me == 0 .and. myrank == 0 ) then
             755     5                               print *,'   can not find co2 data source file'
             756     5                               print *,'   *** stopped in subroutine gas_update !!'
             757     5                             endif
             758     4                             stop
             759     4                           endif
             760     3                         endif  lab_if_ictm
             761     2                       endif   ! end if_file_exist_block
             762     1               
             763     1               !  --- ...  read in co2 2-d data for the requested month
             764     1               
             765     1                       close(nico2cn)
             766     1                       open (nico2cn,file=cfile1,form='formatted',status='old')
             767     1                       rewind nico2cn
             768     1                       read (nico2cn, 36) iyr, cline, co2g1, co2g2
             769     1                 36    format(i4,a94,f7.2,16x,f5.2)
             770     1               
             771     2                       if ( me == 0 .and. myrank == 0 ) then
             772     2                         print *,'   opened co2 data file: ',cfile1
             773     2                         print *, iyr, cline(1:94), co2g1,'  growth rate =', co2g2
             774     2                       endif
             775     1               
             776     1               !  --- ...  add growth rate if needed
             777     2                       if ( lextpl ) then
             778     2               !         rate = co2g2 * (iyear - iyr)   ! rate from early year
             779     2               !         rate = 1.60  * (iyear - iyr)   ! avg rate over long period
             780     2                         rate = 2.00  * (iyear - iyr)   ! avg rate for recent period
             781     2                       else
             782     2                         rate = 0.0
             783     2                       endif
             784     1               
             785     1                       co2_glb = (co2g1 + rate) * 1.0e-6
             786     2                       if ( me == 0 .and. myrank == 0 ) then
             787     2                         print *,'   global annual mean co2 data for year',            &
             788     2                    &              iyear, co2_glb
             789     2                       endif
             790     1               
             791     2                       if ( ictmflg == -2 ) then     ! need to calc ic time annual mean first
             792     2               
             793     3                         if ( ico2flg == 1 ) then
             794     4                           if ( me==0 .and. myrank == 0 ) then
             795     4                             print *,' check: monthly deviations of climatology ',     &
             796     4                    &                'to be superimposed on global annual mean'
             797     4                             print *, gco2cyc
             798     4                           endif
             799     3                         elseif ( ico2flg == 2 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             800     3   s   4v                  co2ann(:,:) = 0.0
             801     3               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             802     4                           do imo = 1, 12
             803     4                             read (nico2cn,cform) co2dat
             804     4               !check        print cform, co2dat
             805     4               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 192, MVE: 13, POL: S)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             806     5   s   2v                    do j = 1, jmxco2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             807     6   s   2v                      do i = 1, imxco2
             808     6   p   2v                        co2ann(i,j) = co2ann(i,j) + co2dat(i,j)
             809     6   p   2v                      enddo
             810     5   p                         enddo
             811     4                           enddo
             812     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 256, MVE: 11, POL: S)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             813     4   s   2v                  do j = 1, jmxco2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             814     5   s   2v                    do i = 1, imxco2
             815     5   p   2v                      co2ann(i,j) = co2ann(i,j) * 1.0e-6 / float(12)
             816     5   p   2v                    enddo
             817     4   p                       enddo
             818     3               !cmy--------------------------------------------------------------------
             819     3               !cmy --- transfer j-index from N->S : 1-jmxco2 to S->N : 1-jmxco2
             820     3               !cmy--------------------------------------------------------------------
             821     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2cyc_sav, co2ann, co2dat3
                                   <<< Loop-information  End >>>
             822     4  pp                       do imo = 1, 12
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat3, co2cyc_sav, co2ann
                                   <<< Loop-information  End >>>
             823     5   p                         do j = 1, jmxco2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             824     6   p   fv                      do i = 1, imxco2
             825     6   p   fv                        co2dat3(i,j,imo) = co2ann(i,j)+co2cyc_sav(i,j,imo)
             826     6   p   fv                      enddo
             827     5   p                         enddo
             828     4   p                       enddo
             829     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat3
                                   <<< Loop-information  End >>>
             830     4  pp                       do imo = 1, 12
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat3
                                   <<< Loop-information  End >>>
             831     5   p                         do j = 1, jmxco2
             832     5   p                            jn= jmxco2-j+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             833     6   p   fv                      do i = 1, imxco2
             834     6   p   fv                        co2vmr_sav(i,jn,imo) = co2dat3(i,j,imo)
             835     6   p   fv                      enddo
             836     5   p                         enddo
             837     4   p                       enddo
             838     3               
             839     3               !cmy--------------------------------------------------------------------
             840     4                           if ( me==0 .and. myrank == 0 ) then
             841     4                             print *,' check: sample of 2-d annual mean of co2 ',      &
             842     4                    &                'data used for year:',iyear
             843     4                             print *, co2ann(1,:)
             844     4                             print *,' check: after adding seasonal cycle, sample ',   &
             845     4                    &                'of selected months of co2 data for year:',iyear
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             846     5   s    s                    do imo = 1, 12, 3
             847     5   m    m                      print *,'        month =',imo
             848     5   m    s                      print *, co2vmr_sav(1,:,imo)
             849     5   p    v                    enddo
             850     4                           endif
             851     3                         endif   ! endif_icl2flg_block
             852     2               
             853     2                       else                  ! no need to calc ic time annual mean first
             854     2               
             855     3                         if ( ico2flg == 2 ) then      ! directly save monthly data
             856     3               !cmy--------------------------------------------------------------------
             857     3               !cmy --- transfer j-index from N->S : 1-jmxco2 to S->N : 1-jmxco2
             858     3               !cmy--------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat, (unknown)
                                   <<< Loop-information  End >>>
             859     4                           do imo = 1, 12
             860     4                             read (nico2cn,cform) co2dat
             861     4               !check        print cform, co2dat
             862     4               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat, (unknown)
                                   <<< Loop-information  End >>>
             863     5   s   2v                    do j = 1, jmxco2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             864     6   s   2v                      do i = 1, imxco2
             865     6   p   2v                        co2dat3(i,j,imo) = (co2dat(i,j) + rate) * 1.0e-6
             866     6   p   2v                      enddo
             867     5   p                         enddo
             868     4                           enddo
             869     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat3
                                   <<< Loop-information  End >>>
             870     4  pp                       do imo = 1, 12
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      co2dat3
                                   <<< Loop-information  End >>>
             871     5   p                         do j = 1, jmxco2
             872     5   p                            jn = jmxco2-j+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             873     6   p   fv                      do i = 1, imxco2
             874     6   p   fv                        co2vmr_sav(i,jn,imo) = co2dat3(i,j,imo)
             875     6   p   fv                      enddo
             876     5   p                         enddo
             877     4   p                       enddo
             878     3               !cmy--------------------------------------------------------------------
             879     3               
             880     4                           if ( me == 0 .and. myrank == 0 ) then
             881     4                             print *,' check: sample of selected months of co2 ',      &
             882     4                    &                'data used for year:',iyear
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             883     5   s    s                    do imo = 1, 12, 3
             884     5   m    m                      print *,'        month =',imo
             885     5   m    s                      print *, co2vmr_sav(1,:,imo)
             886     5   p    v                    enddo
             887     4                           endif
             888     3                         endif   ! endif_ico2flg_block
             889     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             890     3   s    v                do imo = 1, 12
             891     3   p    v                  gco2cyc(imo) = 0.0
             892     3   p    v                enddo
             893     2                       endif   ! endif_ictmflg_block
             894     1                       close ( nico2cn )
             895     1               
             896     1                     endif  lab_if_idyr
             897                     
             898                           return
             899                     !
             900                     !...................................
             901                           end subroutine gas_update
             902                     !-----------------------------------
             903                     
             904                     
             905                     !-----------------------------------
             906                           subroutine getgases                                               &
             907                     !...................................
             908                     
             909                     !  ---  inputs:
             910                          &     ( plvl, xlon, xlat,                                          &
             911                          &       imax, lmax,                                                &
             912                     !  ---  outputs:
             913                          &       gasdat                                                     &
             914                          &      )
             915                     
             916                     !  ===================================================================  !
             917                     !                                                                       !
             918                     !  getgases set up global distribution of radiation absorbing  gases    !
             919                     !  in volume mixing ratio.  currently only co2 has the options from     !
             920                     !  observed values, all other gases are asigned to the climatological   !
             921                     !  values.                                                              !
             922                     !                                                                       !
             923                     !  inputs:                                                              !
             924                     !     plvl(imax,lmax+1)- pressure at model layer interfaces (mb)        !
             925                     !     xlon(imax)       - grid longitude in radians, ok both 0->2pi or   !
             926                     !                        -pi -> +pi arrangements                        !
             927                     !     xlat(imax)       - grid latitude in radians, default range to     !
             928                     !                        pi/2 -> -pi/2, otherwise see in-line comment   !
             929                     !     imax, lmax       - horiz, vert dimensions for output data         !
             930                     !                                                                       !
             931                     !  outputs:                                                             !
             932                     !     gasdat(imax,lmax,nf_vgas) - gases volume mixing ratioes           !
             933                     !               (:,:,1)           - co2                                 !
             934                     !               (:,:,2)           - n2o                                 !
             935                     !               (:,:,3)           - ch4                                 !
             936                     !               (:,:,4)           - o2                                  !
             937                     !               (:,:,5)           - co                                  !
             938                     !               (:,:,6)           - cfc11                               !
             939                     !               (:,:,7)           - cfc12                               !
             940                     !               (:,:,8)           - cfc22                               !
             941                     !               (:,:,9)           - ccl4                                !
             942                     !               (:,:,10)          - cfc113                              !
             943                     !                                                                       !
             944                     !  external module variables:  (in physpara)                            !
             945                     !     ico2flg    - co2 data source control flag                         !
             946                     !                   =0: use prescribed co2 global mean value            !
             947                     !                   =1: use input global mean co2 value (co2_glb)       !
             948                     !                   =2: use input 2-d monthly co2 value (co2vmr_sav)    !
             949                     !     ivflip     - vertical profile indexing flag                       !
             950                     !                                                                       !
             951                     !  internal module variables used:                                      !
             952                     !     co2vmr_sav - saved monthly co2 concentration from sub gas_update  !
             953                     !     co2_glb    - saved global annual mean co2 value from  gas_update  !
             954                     !     gco2cyc    - saved global seasonal variation of co2 climatology   !
             955                     !                  in 12-month form                                     !
             956                     !  ** note: for lower atmos co2vmr_sav may have clim monthly deviations !
             957                     !           superimposed on init-cond co2 value, while co2_glb only     !
             958                     !           contains the global mean value, thus needs to add the       !
             959                     !           monthly dglobal mean deviation gco2cyc at upper atmos. for  !
             960                     !           ictmflg/=-2, this value will be zero.                       !
             961                     !                                                                       !
             962                     !  usage:    call getgases                                              !
             963                     !                                                                       !
             964                     !  subprograms called:  none                                            !
             965                     !                                                                       !
             966                     !  ===================================================================  !
             967                     !
             968                           implicit none
             969                     
             970                     !  ---  input:
             971                           integer,  intent(in)  :: imax, lmax
             972                           real (kind=kind_phys), intent(in) :: plvl(:,:), xlon(:), xlat(:)
             973                     
             974                     !  ---  output:
             975                           real (kind=kind_phys), intent(out) :: gasdat(:,:,:)
             976                     
             977                     !  ---  local:
             978                           integer :: i, k, ilat, ilon
             979                     
             980                           real (kind=kind_phys) :: xlon1, xlat1, tmp
             981                     
             982                     !===>  ...  begin here
             983                     
             984                     !  --- ...  assign default values
             985                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             986     1  pp                 do k = 1, lmax
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 24, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             987     2   p    v            do i = 1, imax
             988     2   p    v              gasdat(i,k,1) = co2vmr_def
             989     2   p    v              gasdat(i,k,2) = n2ovmr_def
             990     2   p    v              gasdat(i,k,3) = ch4vmr_def
             991     2   p    v              gasdat(i,k,4) = o2vmr_def
             992     2   p    v              gasdat(i,k,5) = covmr_def
             993     2   p    v              gasdat(i,k,6) = f11vmr_def
             994     2   p    v              gasdat(i,k,7) = f12vmr_def
             995     2   p    v              gasdat(i,k,8) = f22vmr_def
             996     2   p    v              gasdat(i,k,9) = cl4vmr_def
             997     2   p    v              gasdat(i,k,10)= f113vmr_def
             998     2   p    v            enddo
             999     1   p                 enddo
            1000                     
            1001                     !  --- ...  co2 section
            1002                     
            1003     1                     if ( ico2flg == 1 ) then
            1004     1               !  ---  use obs co2 global annual mean value only
            1005     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            1006     2  pp                   do k = 1, lmax
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1007     3   p   4v                do i = 1, imax
            1008     3   p   4v                  gasdat(i,k,1) = co2_glb + gco2cyc(kmonsav)
            1009     3   p   4v                enddo
            1010     2   p                   enddo
            1011     1               
            1012     1                     elseif ( ico2flg == 2 ) then
            1013     1               !  ---  use obs co2 monthly data with 2-d variation at lower atmos
            1014     1               !       otherwise use global mean value
            1015     1               
            1016     1                       tmp = raddeg / resco2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1017     2  pp                   do i = 1, imax
            1018     2   p                     xlon1 = xlon(i)
            1019     2   p                     if ( xlon1 < 0.0 ) xlon1 = xlon1 + con_pi  ! if xlon in -pi->pi, convert to 0->2pi
            1020     2               !         xlat1 = hfpi - xlat(i)                     ! if xlat in pi/2 -> -pi/2 range
            1021     2   p                     xlat1 = hfpi + xlat(i)                     ! if xlat in -pi/2 -> pi/2 range
            1022     2               !note     xlat1 = xlat(i)                            ! if xlat in 0 -> pi range
            1023     2               
            1024     2   p                     ilon = min( imxco2, int( xlon1*tmp + 1 ))
            1025     2   p                     ilat = min( jmxco2, int( xlat1*tmp + 1 ))
            1026     2               
            1027     3   p                     if ( ivflip == 0 ) then         ! index from toa to sfc
            1028     4   p   2s                  do k = 1, lmax
            1029     5   p   2m                    if ( plvl(i,k) >= prsco2 ) then
            1030     5   p   2s                      gasdat(i,k,1) = co2vmr_sav(ilon,ilat,kmonsav)
            1031     5   p   2s                    else
            1032     5   p   2s                      gasdat(i,k,1) = co2_glb + gco2cyc(kmonsav)
            1033     5   p   2v                    endif
            1034     4   p   2v                  enddo
            1035     3   p                     else                            ! index from sfc to toa
            1036     4   p   2s                  do k = 1, lmax
            1037     5   p   2m                    if ( plvl(i,k+1) >= prsco2 ) then
            1038     5   p   2s                      gasdat(i,k,1) = co2vmr_sav(ilon,ilat,kmonsav)
            1039     5   p   2s                    else
            1040     5   p   2s                      gasdat(i,k,1) = co2_glb + gco2cyc(kmonsav)
            1041     5   p   2v                    endif
            1042     4   p   2v                  enddo
            1043     3   p                     endif
            1044     2   p                   enddo
            1045     1                     endif
            1046                     
            1047                     !
            1048                           return
            1049                     !...................................
            1050                           end subroutine getgases

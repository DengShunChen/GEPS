               1                           subroutine diagrd (ozon,nx,lev,my,my_max,njump,julian,stbo,s0,cosl &
               2                                   ,tt,qt,plcl,cumtop,ss,rs,asr,alr,xsr,xlr,acld,aflxd,aflxu  &
               3                                   ,ncld)
               4                           use mpe
               5                           use rank
               6                           use index
               7                     !######################################################################c
               8                     !                                                                      c
               9                     ! a. function:                                                         c
              10                     !  print radiation diagnoses when raddia=.true.                        c
              11                     !                                                                      c
              12                     ! b. common block specification:                                       c
              13                     !  none                                                                c
              14                     !                                                                      c
              15                     ! c. parameter specification:                                          c
              16                     !  none                                                                c
              17                     !                                                                      c
              18                     ! d. input/output variables                                            c
              19                     !  (1) input variables:                                                c
              20                     !  ozon  : logical constant to include ozon in sw/lw rad calculation   c
              21                     !  nx    : i-direction horizontal dimension of the model               c
              22                     !  lev    : vertical layers of the model                               c
              23                     !  my    : j-direction horizontal dimension of the model               c
              24                     !  njump : grid interval for long wave radiative calculation           c
              25                     !  julian: julian day ( julian = 1 for january 1 )                     c
              26                     !  stbo  : stefan-boltzman constant (5.669e-8)                         c
              27                     !  s0    : solar constant (1368.3)                                     c
              28                     !  cosl  : cos(lat)                                                    c
              29                     !  tt(nx,lev,my) : real temperature at prediction levels (k)           c
              30                     !  qt(nx,lev,my) : specific humidity at prediction levels (kg/kg)      c
              31                     !  plcl(nx,my)  : total column solar radiation absorption              c
              32                     !  cumtop(nx,my): outgoing long wave radiation at model top            c
              33                     !  ss(nx,my): net short wave flux down to ground surface (wat/m**2)    c
              34                     !  rs(nx,my): net long  wave flux up from ground surface (wat/m**2)    c
              35                     !  asr(lev,my): lat-mean temp change due to short wave radtn (k/day)   c
              36                     !  alr(lev,my): lat-maen temp change due to long  wave radtn (k/day)   c
              37                     !  xsr(lev,my): maxnxum short wave heating for each lat. ring (k/day)  c
              38                     !  xlr(lev,my): maxnxum long  wave colling for each lat. ring (k/day)  c
              39                     !  acld(lev,my): lat-mean total cloud fraction assuming random overlap c
              40                     !  aflxd(lev+2,my): lat-mean downward long wave flux (wat/m**2)        c
              41                     !  aflxu(lev+2,my): lat-mean upward   long wave flux (wat/m**2)        c
              42                     !                                                                      c
              43                     ! e. calling modules:                                                  c
              44                     !    diabat                                                            c
              45                     !                                                                      c
              46                     ! f. usage:                                                            c
              47                     !     call diagrd ( ozon,nx,lev,my,njump,julian,stbo,s0,cosl,tt,qt     c
              48                     !    1       , plcl,cumtop,ss,rs,asr,alr,xsr,xlr,acld,aflxd,aflxu )    c
              49                     !                                                                      c
              50                     ! g. modules called:                                                   c
              51                     !  none                                                                c
              52                     !                                                                      c
              53                     ! h. lnxitation:                                                       c
              54                     !  no                                                                  c
              55                     !                                                                      c
              56                     ! i. date:                                                             c
              57                     !  created: oct 5 , 1992                                               c
              58                     !                                                                      c
              59                     ! j. author:                                                           c
              60                     !  c.-s. liou, c. fong                                                 c
              61                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              62                     !                                                                      c
              63                     !######################################################################c
              64                     !
              65                     !      use index, only : nxp
              66                     
              67                           implicit  none
              68                     
              69                           integer   nx,lev,my,my_max,njump,julian,ncld
              70                     
              71                           real      stbo,s0
              72                     
              73                           logical ozon
              74                     !
              75                           real      cosl(my),tt(nxp,lev,my_max),qt(nxp,lev*ncld,my_max),&
              76                                     plcl(nxp,my_max),cumtop(nxp,my_max),ss(nxp,my_max),rs(nxp,my_max),    &
              77                                     asr(lev,my),alr(lev,my),xsr(lev,my),xlr(lev,my),  &
              78                                     acld(lev,my),aflxd(lev+2,my),aflxu(lev+2,my)
              79                     
              80                           logical flag
              81                     !
              82                     
              83                           integer   i,j,k,jj,nxj,levp1
              84                           real      xmy,xstop,xltop,xssfc,xlsfc,zfluxu,zfluxd,zasr,zalr, &
              85                                     zclds,ztt,zqt,xmsr,xnlr,zttj,zqtj,ztadd
              86                     !
              87                           if(myrank .eq. 0) print 900, ozon,nx,lev,my,njump,julian,stbo,s0
              88                       900 format (1h0,15x,'-------layer-mean radtn diagnosis : ---------'  &
              89                                  , //,2x, 'ozon =',l2,';  nx,lev,my =',3i4                 &
              90                                  , '; njump =', i3,';  julian =', i3                       &
              91                                  , ';  stbo,s0 =', 2e14.6 )
              92                     !
              93                           levp1 = lev + 1
              94                           xmy = 1./float(my)
              95                     !
              96                           call glbmean_2d ( cosl,plcl,  xstop )
              97                           call glbmean_2d ( cosl,cumtop,xltop )
              98                           call glbmean_2d ( cosl,ss, xssfc )
              99                           call glbmean_2d ( cosl,rs, xlsfc )
             100                     !
             101                           if(myrank .eq. 0) print 910, xstop, xltop, xssfc, xlsfc
             102                       910 format( 2x, 'top:  down-sw, upward-lw flux =', 2f7.2            &
             103                                 , ';   sfc:  down-sw, upward-lw flux =', 2f7.2, //        &
             104                                 , 4x, '   asl     atl     tadd    clds     tt      qt  '  &
             105                                 ,     '  mxasl   mnatl   fluxu   fluxd ')
             106                     !
             107                           xmy = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             108     1  pp    v            do 100 j = 1, my
             109     1   p    v            xmy = xmy + cosl(j)
             110     1   p    v        100 continue
             111                           xmy = 1.0/xmy
             112                     !     ximy= xmy/float(nx)
             113                     !
             114                           zfluxu = 0.0
             115                           zfluxd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             116     1  pp    v            do 810 jj  = 1, jlistnum
             117     1   p    v            j=jlist1(jj)
             118     1   p    v            zfluxu = zfluxu + aflxu(1,j)*cosl(j)
             119     1   p    v            zfluxd = zfluxd + aflxd(1,j)*cosl(j)
             120     1   p    v        810 continue
             121                     !
             122                           call mpe_global_sum(zfluxu,1,mpe_double)
             123                           call mpe_global_sum(zfluxd,1,mpe_double)
             124                     !
             125                           zfluxu = zfluxu * xmy
             126                           zfluxd = zfluxd * xmy
             127                           if(myrank .eq. 0) print 915, zfluxu,zfluxd
             128                       915 format( 67x, 2f8.2 )
             129     1                     do 890 k = 1, lev
             130     1                     zasr = 0.0
             131     1                     zalr = 0.0
             132     1                     zclds = 0.0
             133     1                     ztt = 0.0
             134     1                     zqt = 0.0
             135     1                     zfluxu = 0.0
             136     1                     zfluxd = 0.0
             137     1               !
             138     1               !     xmsr = xsr(k,1)
             139     1               !     xnlr = xlr(k,1)
             140     1                     xmsr =-1.797693134862316d+308
             141     1                     xnlr = 1.797693134862316d+308
             142     1               !
             143     2                     do 840 jj  = 1, jlistnum
             144     2                     j=jlist1(jj)
             145     2                     zasr  = zasr  + asr(k,j)*cosl(j)
             146     2                     zalr  = zalr  + alr(k,j)*cosl(j)
             147     2                     zclds = zclds + acld(k,j)*cosl(j)
             148     2                     zfluxu = zfluxu + aflxu(k+1,j)*cosl(j)
             149     2                     zfluxd = zfluxd + aflxd(k+1,j)*cosl(j)
             150     2                     xmsr = max( xmsr, xsr(k,j) )
             151     2                     xnlr = min( xnlr, xlr(k,j) )
             152     2                     zttj = 0.0
             153     2                     zqtj = 0.0
             154     2                     nxj=nxdef(j)
             155     2               !     do 845 i = 1,   nxj
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             156     3  pp    v            do 845 i = 1, nxdef_2d(j)
             157     3   p    v            zttj  = zttj  + tt(i,k,jj)*cosl(j)
             158     3   p    v            zqtj  = zqtj  + qt(i,k,jj)*cosl(j)
             159     3   p    v        845 continue
             160     2                     ztt = ztt + zttj/float(nxj)
             161     2                     zqt = zqt + zqtj/float(nxj)
             162     2                 840 continue
             163     1               !
             164     1                     call mpe_global_sum(zasr,1,mpe_double)
             165     1                     call mpe_global_sum(zalr,1,mpe_double)
             166     1                     call mpe_global_sum(zclds,1,mpe_double)
             167     1                     call mpe_global_sum(zfluxu,1,mpe_double)
             168     1                     call mpe_global_sum(zfluxd,1,mpe_double)
             169     1                     call mpe_global_sum(ztt,1,mpe_double)
             170     1                     call mpe_global_sum(zqt,1,mpe_double)
             171     1                     call mpe_global_max(xmsr,1,mpe_double)
             172     1                     call mpe_global_min(xnlr,1,mpe_double)
             173     1               !
             174     1                     zasr = zasr * xmy
             175     1                     zalr = zalr * xmy
             176     1                     ztadd = zasr + zalr
             177     1                     zclds = zclds * 100.0 * xmy
             178     1               !x    ztt = ztt * ximy
             179     1               !x    zqt = zqt * ximy * 1000.0
             180     1                     ztt = ztt * xmy
             181     1                     zqt = zqt * xmy * 1000.0
             182     1                     zfluxu = zfluxu * xmy
             183     1                     zfluxd = zfluxd * xmy
             184     1                     if(myrank .eq. 0) print 920,k,zasr,zalr,ztadd,zclds,ztt,zqt,xmsr, &
             185     1                                       xnlr,zfluxu,zfluxd
             186     1                 920 format ( 1x, i2, 10f8.2 )
             187     1                 890 continue
             188                     !
             189                           zfluxu = 0.0
             190                           zfluxd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             191     1  pp    v            do 895 jj  = 1, jlistnum
             192     1   p    v            j=jlist1(jj)
             193     1   p    v            zfluxu = zfluxu + aflxu(lev+2,j)*cosl(j)
             194     1   p    v            zfluxd = zfluxd + aflxd(lev+2,j)*cosl(j)
             195     1   p    v        895 continue
             196                     !
             197                           call mpe_global_sum(zfluxu,1,mpe_double)
             198                           call mpe_global_sum(zfluxd,1,mpe_double)
             199                     !
             200                           zfluxu = zfluxu * xmy
             201                           zfluxd = zfluxd * xmy
             202                           if(myrank .eq. 0) print 915, zfluxu,zfluxd
             203                     !
             204                           return
             205                           end


 External subroutine subprogram "stemp"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine stemp(incrup,nx,lev,cp,grav,sgeo,pk,pk2,phi,tt)
               2                     !
               3                     !  stemp computes approximatly hydrostatically consistent thickness
               4                     !  tempratures from analysis heights.  algorithm prevents buckling
               5                     !  of the temperature soundings
               6                     !
               7                     
               8                           implicit  none
               9                     
              10                           integer   nx,lev,lm2,l,l1,l2,i,ll,l3,jj,jim
              11                     
              12                           real      phi(nx,lev),tt(nx,lev),pk(nx,lev),pk2(nx,lev)  &
              13                           , sgeo(nx)
              14                     !
              15                           logical incrup
              16                     !
              17                           real      phidif(nx),that(nx,lev)
              18                           real      pexp(nx),xlaps(14),tempps(nx,2*lev-1)
              19                     !
              20                           data xlaps/.002,.002,.00175,.0015,.001625,.00175,.0018   &
              21                           ,   .0019,.002,.0021,.0022,.0023,.0024,.0025/
              22                     
              23                           real      dkapa,capa,pratio,rgas,ocp,grav,cp,wrk,pp,xl1,xl2,phimax
              24                     !
              25                     !  thickness temps on half levels
              26                     !
              27                     !
              28                     !  pressure at full and half levels
              29                     !
              30                           lm2= 2*lev-1
              31                           dkapa= 3.5
              32                           capa= 1.0/dkapa
              33                           pratio=1.4142
              34                           rgas=287.04
              35                           ocp= 1.0/cp
              36                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phi, pk, that
                                   <<< Loop-information  End >>>
              37     1  pp   2v            do 5 l=1,lev-1
              38     1       2             l1=2*l-1
              39     1       2             l2=l1+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
              40     2   p   2             do 55 i=1,nx
              41     2   p   2v            that(i,l)= ocp*(phi(i,l)-phi(i,l+1))/    &
              42     2                      (pk(i,l+1)-pk(i,l))
              43     2   p   2v         55 continue
              44     1   p               5 continue
              45                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, that, pexp
                                   <<< Loop-information  End >>>
              46     1  pp    v            do 201 i=1,nx
              47     1   p    v            wrk=that(i,1)*pk2(i,1)-that(i,2)*pk2(i,2)+0.5
              48     1   p    v            jj=int(wrk)+1
              49     1   p    v            jj= max(1,jj)
              50     1   p    v            jj= min(14,jj)
              51     1   p    v            pp= xlaps(jj)
              52     1   p    v            pexp(i)=rgas*pp/grav
              53     1   p    v        201 continue
              54                     !
              55                     !  begin interation
              56                     !
              57     1                     do 100 jim=1,10
              58     1               !
              59     1               !  analysis temps match co-located thickness temps at half levels
              60     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      that, tempps
                                   <<< Loop-information  End >>>
              61     2  pp                 do 6 l=1,lev-1
              62     2   p                 l1= 2*l
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      that, tempps
                                   <<< Loop-information  End >>>
              63     3   p   2v            do 66 i=1,nx
              64     3   p   2v            tempps(i,l1)=that(i,l)
              65     3   p   2v         66 continue
              66     2   p               6 continue
              67     1               !
              68     1               !  interpolate to full levels for analysis temps
              69     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, that, tempps
                                   <<< Loop-information  End >>>
              70     2  pp                 do 7 l=1,lev-2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, that, tempps
                                   <<< Loop-information  End >>>
              71     3   p    v            do 7 i=1,nx
              72     3   p    v            xl1=(pk(i,l+1)-pk2(i,l))/(pk2(i,l+1)-pk2(i,l))
              73     3   p    v            tempps(i,2*l+1)=that(i,l)+(that(i,l+1)-that(i,l))*xl1
              74     2   p    v          7 continue
              75     1               !
              76     1               !
              77     1               !  temperature boundary conditions at top and bottom
              78     1               !
              79     1               !      if(incrup) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.54, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tempps, pk, pk2
                                   <<< Loop-information  End >>>
              80     2  pp    v            do 56 i=1,nx
              81     2   p    v            xl1=(pk(i,lev)-pk(i,lev-1))/(pk2(i,lev-1)-pk(i,lev-1))
              82     2   p    v            xl2=(pk(i,2)-pk(i,1))/(pk(i,2)-pk2(i,1))
              83     2   p    v            tempps(i,lm2)= tempps(i,lm2-2)+xl1*(tempps(i,lm2-1) &
              84     2                      -tempps(i,lm2-2))
              85     2   p    v            tempps(i,1)= tempps(i,3)+xl2*(tempps(i,2)-tempps(i,3))
              86     2   p    v         56 continue
              87     1               !
              88     1               !      else
              89     1               !
              90     1               !      do 78 i=1,nx
              91     1               !      tempps(i,1)=that(i,1)*(pk2(i,2)/pk(i,1))*pratio**pexp(i)
              92     1               !      tempps(i,lm2)= ocp*(phi(i,lev)-sgeo(i))/(pk2(i,lev)-pk(i,lev))
              93     1               !   78 continue
              94     1               !      endif
              95     1               !
              96     1               !  adjust thickness temperatures to be consistent with both analysis
              97     1               !  temperatures and geopotentials
              98     1               !
              99     1                     phimax= 0.0
             100     2                     do 8 l=lev-1,1,-1
             101     2                     l1=2*l-1
             102     2                     l2=l1+1
             103     2                     l3=l2+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 243
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             104     3  pp    v            do 88 i=1,nx
             105     3   p    v            xl1=cp*(pk2(i,l)-pk(i,l))
             106     3   p    v            xl2=cp*(pk(i,l+1)-pk2(i,l))
             107     3   p    v            phidif(i)= (tempps(i,l1)+tempps(i,l2))*xl1     &
             108     3                       +(tempps(i,l2)+tempps(i,l3))*xl2
             109     3   p    v            phidif(i)= 0.5*phidif(i)-phi(i,l)+phi(i,l+1)
             110     3   p    v            that(i,l)= that(i,l)-phidif(i)/(xl1+xl2)
             111     3   p    v            phimax= max(phimax,abs(phidif(i)))
             112     3   p    v         88 continue
             113     2                   8 continue
             114     1                     if(phimax.lt.1.0) go to 110
             115     1                 100 continue
             116                       110 continue
             117                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tempps, tt
                                   <<< Loop-information  End >>>
             118     1  pp                 do 13 l=1,lev
             119     1   p                 ll= 2*l-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tempps, pk, tt
                                   <<< Loop-information  End >>>
             120     2   p   2v            do 13 i=1,nx
             121     2   p   2v            tt(i,l)= tempps(i,ll)*pk(i,l)
             122     1   p   2v         13 continue
             123                     !
             124                           return
             125                           end


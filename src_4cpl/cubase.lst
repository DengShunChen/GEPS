 External subroutine subprogram "cubase"
  (inc)(line-no.)(nest)(optimize)
               1                     !+ calculates cloud base values (t and q) for cumulus parameterization
               2                     !+ $Id: cubase.f90,v 1.9 1999/07/19 19:07:06 m214030 Exp $
               3                     
               4                     !SUBROUTINE cubase(klon,klev,klevp1,klevm1,ptenh,pqenh,pgeoh,paph, &
               5                     SUBROUTINE cubase(nxj,klon,klev,klevp1,klevm1,ptenh,pqenh,pgeoh,paph, &
               6                     &      ptu,pqu,plu,puen,pven,puu,pvu,ldcum,kcbot,klab,jin)
               7                     
               8                       ! Description:
               9                       !
              10                       ! Calculates cloud base values (t and q) for cumulus parameterization
              11                       !
              12                       ! Method:
              13                       !
              14                       ! Produce cloud base values for cu-parametrization
              15                       !
              16                       ! This routine is called from *cumastr*.
              17                       ! Input are environm. values of t,q,p,phi at half levels.
              18                       ! It returns cloud base values and flags as follows;
              19                       !    klab=1 for subcloud levels
              20                       !    klab=2 for condensation level
              21                       !
              22                       ! Lift surface air dry-adiabatically to cloud base
              23                       ! (non entraining plume,i.e.constant massflux)
              24                       !
              25                       ! *cuadjtq* for adjusting t and q due to condensation in ascent
              26                       !
              27                       ! Authors:
              28                       !
              29                       ! M. Tiedtke, ECMWF, in July 1986 and December 1989, original source
              30                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              31                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              32                       !
              33                       ! for more details see file AUTHORS
              34                       !
              35                       USE shr_kind_mod, only: r8 => shr_kind_r8
              36                       USE mo_constants,    ONLY: cpd,   &! specific heat at constant pressure
              37                                                  rcpd,  &! rcpd=1./cpd
              38                                                  vtmpc1  ! vtmpc1=rv/rd-1
              39                       USE mo_cumulus_flux, ONLY: lmfdudv ! true if cumulus friction is switched on
              40                     
              41                       IMPLICIT NONE
              42                     
              43                       !  Scalar arguments with intent(In):
              44                     !  INTEGER, INTENT (IN) :: klon, klev, klevm1, klevp1
              45                       INTEGER, INTENT (IN) :: klon, nxj, klev, klevm1, klevp1
              46                     
              47                       !  Array arguments with intent(In):
              48                       REAL(r8), INTENT (IN) :: paph(klon,klevp1), pgeoh(klon,klev), pqenh(klon,klev),  &
              49                     &                      ptenh(klon,klev), puen(klon,klev), pven(klon,klev)
              50                     
              51                       !  Array arguments with intent(InOut):
              52                       REAL(r8), INTENT (INOUT) :: plu(klon,klev), pqu(klon,klev), ptu(klon,klev), &
              53                     &                         puu(klon,klev), pvu(klon,klev)
              54                       INTEGER, INTENT (INOUT) :: kcbot(klon), klab(klon,klev)
              55                       LOGICAL, INTENT (INOUT) :: ldcum(klon)
              56                     
              57                       !  Local scalars:
              58                       REAL(r8) :: zbuo, zz
              59                       INTEGER :: icall, ik, ikb, is, jk, jl, jin
              60                     
              61                       !  Local arrays:
              62                       REAL(r8) :: zph(klon), zqold(klon)
              63                       LOGICAL :: loflag(klon)
              64                     
              65                       !  External subroutines
              66                       EXTERNAL cuadjtq
              67                     
              68                       !  Executable statements
              69                     
              70                     !-- 1. Initialize values at lifting level
              71                     
              72                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.14, ITR: 64, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      puu, ldcum, paph, pven, kcbot, puen
                                   <<<      klab, pvu
                                   <<< Loop-information  End >>>
              73     1  pp    v        DO jl = 1, nxj
              74     1   p    v          klab(jl,klev) = 1
              75     1   p    v          kcbot(jl) = klevm1
              76     1   p    v          ldcum(jl) = .FALSE.
              77     1   p    v          puu(jl,klev) = puen(jl,klev)*(paph(jl,klevp1)-paph(jl,klev))
              78     1   p    v          pvu(jl,klev) = pven(jl,klev)*(paph(jl,klevp1)-paph(jl,klev))
              79     1               
              80     1               !-- 2. Do ascent in subcloud layer,
              81     1               !      check for existence of condensation level,
              82     1               !      adjust t,q and l accordingly in *cuadjtq*,
              83     1               !      check for buoyancy and set flags
              84     1               
              85     1   p    v        END DO
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      loflag, pgeoh, ptu, pqenh, pqu, ptenh
                                   <<<      zqold, plu, klab, kcbot, ldcum, paph
                                   <<<      puen, puu, pven, pvu
                                   <<< Loop-information  End >>>
              86     1                 DO jk = klevm1, 2, -1
              87     1                   is = 0
              88     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              89     2  pp    v          DO jl = 1, nxj
              90     2   p    v            IF (klab(jl,jk+1)==1) is = is +1
              91     2   p    v            loflag(jl) = klab(jl,jk+1) == 1
              92     2   p    v            zph(jl) = paph(jl,jk)
              93     2   p    v          END DO
              94     1                   IF (is==0) CYCLE
              95     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.53, ITR: 80, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pqenh, pqu, zqold, loflag, ptu, ptenh
                                   <<<      pgeoh, klab
                                   <<< Loop-information  End >>>
              96     2  pp    v          DO jl = 1, nxj
              97     3   p    v            IF (loflag(jl)) THEN
              98     3   p    v              pqu(jl,jk) = pqu(jl,jk+1)
              99     3   p    v              ptu(jl,jk) = (cpd*ptu(jl,jk+1)+pgeoh(jl,jk+1)-pgeoh(jl,jk))*rcpd
             100     3   p    v              zbuo = ptu(jl,jk)*(1.+vtmpc1*pqu(jl,jk)) - ptenh(jl,jk)*(1.+vtmpc1* &
             101     3               &            pqenh(jl,jk)) + 0.5
             102     3   p    v              IF (zbuo>0.) klab(jl,jk) = 1
             103     3   p    v              zqold(jl) = pqu(jl,jk)
             104     3   p    v            END IF
             105     2   p    v          END DO
             106     1               
             107     1                   ik = jk
             108     1                   icall = 1
             109     1               !    CALL cuadjtq(klon,klev,ik,zph,ptu,pqu,loflag,icall)
             110     1                   CALL cuadjtq(nxj,klon,klev,ik,zph,ptu,pqu,loflag,icall)
             111     1               
             112     1               !DIR$ IVDEP
             113     1               !OCL NOVREC
             114     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.13, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptu, plu, pqenh, pqu, zqold, ptenh
                                   <<<      loflag, klab, kcbot, ldcum
                                   <<< Loop-information  End >>>
             115     2  pp    v          DO jl = 1, nxj
             116     3   p    v            IF (loflag(jl) .AND. ABS(pqu(jl,jk)-zqold(jl))>0.) THEN
             117     3   p    v              klab(jl,jk) = 2
             118     3   p    v              plu(jl,jk) = plu(jl,jk) + zqold(jl) - pqu(jl,jk)
             119     3   p    v              zbuo = ptu(jl,jk)*(1.+vtmpc1*pqu(jl,jk)) - ptenh(jl,jk)*(1.+vtmpc1* &
             120     3               &            pqenh(jl,jk)) + 0.5
             121     4   p    v              IF (zbuo>0.) THEN
             122     4   p    v                kcbot(jl) = jk
             123     4   p    v                ldcum(jl) = .TRUE.
             124     4   p    v              END IF
             125     3   p    v            END IF
             126     2   p    v          END DO
             127     1               
             128     1                   ! Calculate averages of u and v for subcloud ara,.
             129     1                   ! The values will be used to define cloud base values.
             130     1               
             131     2                   IF (lmfdudv) THEN
             132     2               !      DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 381
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 104, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pven, pvu, kcbot, paph, puen, puu
                                   <<< Loop-information  End >>>
             133     3  pp    v            DO jl = 1, nxj
             134     4   p    v              IF (jk>=kcbot(jl)) THEN
             135     4   p    v                puu(jl,klev) = puu(jl,klev) + puen(jl,jk)*(paph(jl,jk+1)-paph(jl,jk &
             136     4               &              ))
             137     4   p    v                pvu(jl,klev) = pvu(jl,klev) + pven(jl,jk)*(paph(jl,jk+1)-paph(jl,jk &
             138     4               &              ))
             139     4   p    v              END IF
             140     3   p    v            END DO
             141     2               
             142     2                   END IF
             143     1                 END DO
             144                     
             145     1                 IF (lmfdudv) THEN
             146     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 267
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, pvu
                                   <<< Loop-information  End >>>
             147     2  pp    s          DO jl = 1, nxj
             148     3   p    m            IF (ldcum(jl)) THEN
             149     3   p    s              ikb = kcbot(jl)
             150     3   p    s              zz = 1./(paph(jl,klevp1)-paph(jl,ikb))
             151     3   p    s              puu(jl,klev) = puu(jl,klev)*zz
             152     3   p    s              pvu(jl,klev) = pvu(jl,klev)*zz
             153     3   p    s            ELSE
             154     3   p    s              puu(jl,klev) = puen(jl,klevm1)
             155     3   p    s              pvu(jl,klev) = pven(jl,klevm1)
             156     3   p    v            END IF
             157     2   p    v          END DO
             158     1                 END IF
             159                     
             160                       RETURN
             161                     END SUBROUTINE cubase


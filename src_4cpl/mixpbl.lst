 External subroutine subprogram "mixpbl"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine mixpbl( nxj,mn,kk,ktpbl                               &
               2                                            , dt,g,hgt,u,v,t,q,ut,vt,tt,qt,e,eps            &
               3                                            , xkm,xkh,zl,sfcw,ustar,tstar,qstar,itypbl      &
               4                                            ,dhgt,ro2,dhgtz)
               5                     !
               6                     !##################################################################
               7                     !                     subroutine description
               8                     !
               9                     ! 1. function description
              10                     !
              11                     !       this subroutine calculates eddy transport coefficient by
              12                     !       computing e and eps, and update ut, vt, tt, qt due to
              13                     !       turbulence mixing effects using backward time scheme.
              14                     !
              15                     ! 2. common block specification
              16                     !
              17                     ! 3. parameter specification
              18                     !
              19                     !     mn : dimension of horizontal-direction
              20                     !     kk : dimension of z-direction
              21                     !  ktpbl : starting level to onsider vertical mixing effects
              22                     !     dt : time step for ut, vt, tt, qt updates                (s)
              23                     !      g : gravity                                              (m/s2)
              24                     !    hgt : height above ground    (mn,kk)  at  current time lvl (m)
              25                     !      u : x-direction velocity   (mn,kk)  at  current time lvl (m/s)
              26                     !      v : y-direction velocity   (mn,kk)  at  current time lvl (m/s)
              27                     !      t : potent temp on odd lvl  (mn,kk) at  current time lvl (k)
              28                     !      q : moisture    on odd lvl  (mn,kk) at  current time lvl (kg/kg)
              29                     !     ut : x-direction velocity   (mn,kk)  at past/future t lvl (m/s)
              30                     !     vt : y-direction velocity   (mn,kk)  at past/future t lvl (m/s)
              31                     !     tt : potent temp on odd lvl  (mn,kk) at past/future t lvl (k)
              32                     !     qt : moisture    on odd lvl  (mn,kk) at past/future t lvl (kg/kg)
              33                     !     e  : turbulence kinetic energy (mn,kk) at current/future  (m2/s2)
              34                     !    eps : tke dissipation           (mn,kk) at current/future  (m2/s2)
              35                     !    xkm : eddy mixing coef for u, v (mn,kk) at current t lvl   (m2/s2)
              36                     !    xkh : eddy mixing coef for t, q (mn,kk) at current t lvl   (m2/s2)
              37                     !     zl : height(kk) over monin-obukhov scale height.
              38                     !          a stability indicator.                   (mn)
              39                     !   sfcw : surface wind speed        (mn)                      (m/s)
              40                     !   ustar: friction velocity         (mn)                      (m/s)
              41                     !   tstar: potential temp scale      (mn)                      (k)
              42                     !   qstar: moisture scale            (mn)                      (kg/kg)
              43                     ! itypbl : index for surface layer update, =0 stress b,c., =1 direct
              44                     !
              45                     !
              46                     ! 4. local work arrays
              47                     !
              48                     !   wkk1 : working array               (mn,kk)
              49                     !   wkk2 : working array               (mn,kk)
              50                     !   wktri: tri-diagonal matrix solver working array   (mn,kk,4)
              51                     !
              52                     ! 5. calling modules
              53                     !
              54                     !     pbltke
              55                     !
              56                     ! 6. usage
              57                     !
              58                     !     call mixpbl( mn,kk,ktpbl,dt,g,hgt,u,v,t,q,ut,vt,tt,qt,e,eps
              59                     !    1           , xkm,xkh,zl,sfcw,ustar,tstar,qstar,itypbl )
              60                     !
              61                     ! 7. modules called
              62                     !
              63                     !     couvtq
              64                     !     trigau
              65                     !     eeps
              66                     !
              67                     ! 8. limitation
              68                     !
              69                     !   ** ktpbl  >= 2
              70                     !   **     e  >= 1.0e-4,    <= 250.0
              71                     !   **    eps >= 1.0e-7,    <= 1.0
              72                     !   **    xkm >=0.01 (stable) or 1.0 (unstable);  <= 1200.0
              73                     !   **    xkh = xhk*phih/phit
              74                     !
              75                     ! 9. date
              76                     !
              77                     !     rewritten          november 1991
              78                     !
              79                     ! 10. author
              80                     !
              81                     !      c. liou / f. wang / s. chang
              82                     !      modify to f90 by C-H Lee abd sort by River Chen in 2015
              83                     !
              84                     ! 11. reference
              85                     !       detering, h. w., and d. etling, 1984: application of the
              86                     !            e-eps turbulence model to the atmospheric boundary
              87                     !            layer. boundary-layer meteorol., 33, 113-133.
              88                     !
              89                     !#####################################################################
              90                           use paramt
              91                           use const, only : RTYPE
              92                     
              93                           implicit  none
              94                           integer   nxj,mn,kk,ktpbl,itypbl
              95                           real      dt,g
              96                     !
              97                     ! input & output variables
              98                     !
              99                           real      hgt(mn,kk),u(mn,kk),v(mn,kk),t(mn,kk),           &
             100                                     e(mn,kk),                                        &
             101                                     eps(mn,kk),xkm(mn,kk),xkh(mn,kk),zl(mn),         &
             102                                     sfcw(mn),ustar(mn),tstar(mn),qstar(mn),          &
             103                                     dhgt(mn,kk),ro2(mn,kk),dhgtz(mn,kk)
             104                           real(kind=RTYPE) q(mn,kk),qt(mn,kk),tt(mn,kk),             &
             105                                            ut(mn,kk),vt(mn,kk)
             106                     !
             107                     !  local work arrays
             108                     !
             109                           real      wkk1(im,lm),wkk2(im,lm)
             110                           real      wktri(mn,kk,4)
             111                     !
             112                           integer  k,i,kk1,kt,ktpbl1,nlimt,nlimq,nee,nc
             113                           real     ec1,ec2,ec3,ec4,ec5,wgtx,wgt,umin,smin
             114                           real     duu,dvv,beta,tmin,qmin,dth,dtee
             115                     
             116                           data ec1,ec2,ec3,ec4,ec5 / 2.0, 0.026, 1.38, 1.9, 0.77 /
             117                     !
             118                     !     compute eddy mixing coef xkm, xkh using current time lvl e, eps.
             119                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             120     1  pp                 do 100 k = 1, kk
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xkh, xkm
                                   <<< Loop-information  End >>>
             121     2   p   2v            do 100 i = 1, nxj
             122     2   p   2v            xkm(i,k) = 0.0
             123     2   p   2v            xkh(i,k) = 0.0
             124     1   p   2v        100 continue
             125                     !
             126                           kk1 = kk - 1
             127                           ktpbl1 = ktpbl - 1
             128                           wgtx = 1.0/((kk-ktpbl1)*(kk-ktpbl1))
             129                     !
             130                     !     put upper and lower limits on xkm (depneding on lvls, stability)
             131                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e, eps, t, xkm
                                   <<< Loop-information  End >>>
             132     1                     do 120 k = ktpbl, kk
             133     1                     wgt = (k-ktpbl1)*(k-ktpbl1)*wgtx
             134     1                     umin = 1.00 * wgt
             135     1                     smin = 0.01 * wgt
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 373
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xkm, e, eps, t
                                   <<< Loop-information  End >>>
             136     2  pp    v            do 120 i = 1, nxj
             137     2   p    v            xkm(i,k) = ec2*e(i,k)*e(i,k)/eps(i,k)
             138     2               !zzzz if (xkm(i,k) .gt. 1000.0)  xkm(i,k) = 1000.0
             139     2   p    v            if (xkm(i,k) .gt. 1200.0)  xkm(i,k) = 1200.0
             140     2   p    v            if ((t(i,k-1).le.t(i,k)).and.(xkm(i,k-1).lt.umin)) &
             141     2                                                   xkm(i,k-1) =  umin
             142     2   p    v            if ((t(i,k-1).gt.t(i,k)).and.(xkm(i,k-1).lt.smin)) &
             143     2                                                   xkm(i,k-1) =  smin
             144     1   p    v        120 continue
             145                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zl, u, v, t, hgt, wktri, wkk1, xkm, wkk2
                                   <<<      xkh
                                   <<< Loop-information  End >>>
             146     1                     do 200 k = ktpbl1, kk1
             147     1               !
             148     1               !     (1) compute richardson number : wkk1(,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 145
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.79, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, hgt, wktri, xkm, u, zl, wkk1, v, wkk2
                                   <<<      xkh
                                   <<< Loop-information  End >>>
             149     2  pp    v                do 220 i = 1, nxj
             150     2   p    v                duu = u(i,k) - u(i,k+1)
             151     2   p    v                dvv = v(i,k) - v(i,k+1)
             152     2   p    v                wktri(i,1,1) = duu*duu + dvv*dvv
             153     2   p    v                if ( wktri(i,1,1) .lt. 1.0e-6 )  wktri(i,1,1) = 1.0e-6
             154     2               ! 220     continue
             155     2               !         do 240 i = 1, nxj
             156     2   p    v                wkk1(i,1) = g*(t(i,k)-t(i,k+1))*(hgt(i,k)-hgt(i,k+1)) / &
             157     2                                 ( 0.5*(t(i,k)+t(i,k+1))*wktri(i,1,1) )
             158     2               ! 240     continue
             159     2               !
             160     2               !     (2) compute phim/phih : wkk2(,1)
             161     2               !         do 260 i = 1, nxj
             162     2   p    v                wktri(i,1,1) = zl(i)*0.5*(hgt(i,k)+hgt(i,k+1)) / hgt(i,kk)
             163     2   p    v                if( wktri(i,1,1) .gt. 10.0 )  wktri(i,1,1) = 10.0
             164     2   p    v                if( wktri(i,1,1) .lt. -10.0 ) wktri(i,1,1) = -10.0
             165     2               ! 260     continue
             166     2               !         do 280 i = 1, nxj
             167     2               !         if ( zl(i) .gt. 0.0 )  then
             168     2               !            wkk2(i,1) =(1.0+4.7*wktri(i,1,1))/(0.74+4.7*wktri(i,1,1))
             169     2               !         else
             170     2               !            wkk2(i,1) =1.35*sqrt( (1.0-9.0*wktri(i,1,1))/
             171     2               !    1                         sqrt(1.0-15.0*wktri(i,1,1)) )
             172     2               !         endif
             173     2               ! ---     limit phim/phih = 1.35, if ri > 0.25
             174     2               !         if ( wkk1(i,1) .gt. 0.25 ) wkk2(i,1) = 1.35
             175     2               ! 280     continue
             176     2               !
             177     2               ! yamada(1983) formula of xkh/xkm
             178     2               !       do 280 i=1,nxj
             179     3   p    v               if(wkk1(i,1) .lt. 0.16)then
             180     3   p    v                 wkk2(i,1)=1.318*(0.2231-wkk1(i,1))/(0.2341-wkk1(i,1))
             181     3   p    v               else
             182     3   p    v                 wkk2(i,1)=1.12
             183     3   p    v               endif
             184     2               !280    continue
             185     2               !       do 290 i = 1, nxj
             186     2   p    v              xkh(i,k) = xkm(i,k)*wkk2(i,1)
             187     2               ! 290   continue
             188     2               !
             189     2   p    v        220   continue
             190     1                 200 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xkm, xkh
                                   <<< Loop-information  End >>>
             191     1  pp   2v            do 295 i = 1, nxj
             192     1   p   2v            xkh(i,kk) = 1.35*xkm(i,kk)
             193     1   p   2v        295 continue
             194                     !
             195                     !     update ut, vt, t, qt due to vertical mixing using backward
             196                     !     time scheme by solving a tri-diagonal matrix:
             197                     !     if itypbl= 0 (.ne. 1) use surface stress as lower b.c. in forcing
             198                     !
             199                     ! (a) for ut  (assume boussineq approximation)
             200                     !     a*u(k+1,t+1) + b*u(k,t+1) + c*u(k-1,t+1) = u(k,t-1)
             201                     !     a= -dt*xkm(k+1/2) / (dz(k+1/2)*dz(k)),
             202                     !     b= 1 + dt*(xkm(k+1/2)/dz(k+1/2) + xkm(k-1/2)/dz(k-1/2)) / (dz(k)
             203                     !     c= -dt*xkm(k-1)/(dz(k-1/2)*dz(k)),    dt = (t+1) - (t-1),
             204                     !     dz(k) = 1/2*(dz(k+1/2)+dz(k-1/2)) = 1/2(z(k-1)-z(k+1))
             205                     !     k: odd level index (u lvl, k+1/2 --> k for xkm)
             206                     !
             207                           kt = kk - ktpbl + 1
             208                           beta = 1.0
             209                     !
             210                           call couvtq ( nxj,mn,kk,ktpbl,dt,wktri,xkm,hgt,ut,beta,dhgt,ro2 )
             211     1                     if ( itypbl .ne. 1 )  then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dhgt, ustar, sfcw, ro2, wktri, wkk1
                                   <<< Loop-information  End >>>
             212     2  pp    v               do 300 i = 1, nxj
             213     2               !        sfcwx = max( 1.0e-4, sqrt(ut(i,kk)**2 + vt(i,kk)**2) )
             214     2   p    v               wkk1(i,1) = ustar(i)/sfcw(i)
             215     2               !org     wkk1(i,2) = dt*ustar(i)/( 0.5*(hgt(i,kk-1)+hgt(i,kk)) )
             216     2   p    v               wkk1(i,2) = dt*ustar(i)/( dhgt(i,kk) )
             217     2   p    v               wktri(i,kt,2) = wktri(i,kt,2) + wkk1(i,1)*wkk1(i,2)*ro2(i,kk)
             218     2   p    v        300    continue
             219     1                     endif
             220                           call trigau ( wktri, mn, nxj, kk, kt, 0 )
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, ut
                                   <<< Loop-information  End >>>
             221     1  pp                 do 320 k = ktpbl, kk
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, ut
                                   <<< Loop-information  End >>>
             222     2   p   2v            do 320 i = 1, nxj
             223     2   p   2v            ut(i,k) = wktri(i,k-ktpbl+1,4)
             224     2               !cc   do 320 ik = (ktpbl-1)*mn+1, kk*mn
             225     2               !cc   ut(ik,1) = wktri(ik-(ktpbl-1)*mn,1,4)
             226     1   p   2v        320 continue
             227                     !
             228                     ! (b) for vt
             229                     !
             230                           call couvtq ( nxj,mn,kk,ktpbl,dt,wktri,xkm,hgt,vt,beta,dhgt,ro2 )
             231     1                     if ( itypbl .ne. 1 )  then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.14, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ro2, wktri, wkk1

             313                     !-----------------------------------------------------------------------
             314                     
             315                     !c  set up constants used internally in GCE
             316                     
             317                        call consat_s (ihail, itaobraun)
             318                     
             319                     
             320                     !c Negative values correction
             321                     
             322                        iskip = 1
             323                     
             324     1                  if (iskip.eq.0) then
             325     1                     call negcor(qv,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             326     1                                          itimestep,1,             &
             327     1                                          its,ite,jts,jte,kts,kte)
             328     1                     call negcor(ql,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             329     1                                          itimestep,2,             &
             330     1                                          its,ite,jts,jte,kts,kte)
             331     1                     call negcor(qr,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             332     1                                          itimestep,3,             &
             333     1                                          its,ite,jts,jte,kts,kte)
             334     1                     call negcor(qi,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             335     1                                          itimestep,4,             &
             336     1                                          its,ite,jts,jte,kts,kte)
             337     1                     call negcor(qs,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             338     1                                          itimestep,5,             &
             339     1                                          its,ite,jts,jte,kts,kte)
             340     1                     call negcor(qg,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             341     1                                          itimestep,6,             &
             342     1                                          its,ite,jts,jte,kts,kte)
             343     1               !   else if (mod(itimestep,i24h).eq.1) then
             344     1               !      print *,'no neg correction in mp at timestep=',itimestep
             345     1                  endif ! iskip
             346                     
             347                     !c microphysics in GCE
             348                     
             349                        call SATICEL_S( dt_in, IHAIL, itaobraun, ICE2, istatmin,     &
             350                                        new_ice_sat, id,                             &
             351                     !                   th, th_old, qv, ql, qr,                      &
             352                                        th, qv, ql, qr,                      &
             353                                        qi, qs, qg,                                  &
             354                     !                   qvold, qlold, qrold,                         &
             355                     !                   qiold, qsold, qgold,                         &
             356                                        rho, pii, p, itimestep,                      &
             357                                        refl_10cm, diagflag, do_radar_ref,           & ! GT added for reflectivity calcs
             358                     !                   ids,ide, jds,jde, kds,kde,                   & ! domain dims
             359                                        ims,ime, jms,jme, kms,kme,                   & ! memory dims
             360                                        its,ite, jts,jte, kts,kte                    & ! tile   dims
             361                     #ifdef EffectRad_GCE3
             362                                       ,xland,                                       &
             363                                        re_cloud_gsfc, re_rain_gsfc, re_ice_gsfc,    & ! cloud effective radius
             364                                        re_snow_gsfc, re_graupel_gsfc                & ! cloud effective radius
             365                     #endif
             366                                                                                     )
             367                     
             368                     
             369                        END SUBROUTINE gsfcgce
             370                     
             371                     !-----------------------------------------------------------------------
             372                        SUBROUTINE fall_flux ( dt, qr, qi, qs, qg, p,              &
             373                                           rho, z, dz8w, topo, rainnc,             &
             374                                           rainncv, grav, itimestep,               &
             375                                           rhowater, rhosnow,                      &
             376                                           snownc, snowncv, sr,                    &
             377                                           graupelnc, graupelncv,                  &
             378                                           ihail, ice2,                            &
             379                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             380                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             381                     !-----------------------------------------------------------------------
             382                     ! adopted from Jiun-Dar Chern's codes for Purdue Regional Model
             383                     ! adopted by Jainn J. Shi, 6/10/2005
             384                     !-----------------------------------------------------------------------
             385                     
             386                       IMPLICIT NONE
             387                       INTEGER, INTENT(IN   )               :: ihail, ice2,                &
             388                                                               ims,ime, jms,jme, kms,kme,  &
             389                                                               its,ite, jts,jte, kts,kte
             390                       INTEGER, INTENT(IN   )               :: itimestep
             391                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             392                                INTENT(INOUT)               :: qr, qi, qs, qg
             393                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             394                                INTENT(INOUT)               :: rainnc, rainncv,            &
             395                                                               snownc, snowncv, sr,        &
             396                                                               graupelnc, graupelncv
             397                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             398                                INTENT(IN   )               :: rho, z, dz8w, p
             399                     
             400                       REAL,    INTENT(IN   )               :: dt, grav, rhowater, rhosnow
             401                     
             402                     
             403                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             404                                INTENT(IN   )               :: topo
             405                     
             406                     ! temperary vars
             407                     
             408                       REAL,    DIMENSION( kts:kte )           :: sqrhoz
             409                       REAL                                    :: tmp1, term0
             410                       REAL                                :: pptrain, pptsnow,        &
             411                                                              pptgraul, pptice
             412                       REAL,    DIMENSION( kts:kte )       :: qrz, qiz, qsz, qgz,      &
             413                                                              zz, dzw, prez, rhoz,     &
             414                                                              orhoz
             415                     
             416                     
             417                        INTEGER                    :: k, i, j
             418                     !
             419                     
             420                       REAL, DIMENSION( kts:kte )    :: vtr, vts, vtg, vti
             421                     
             422                       REAL                          :: dtb, pi, consta, constc, gambp4,    &
             423                                                        gamdp4, gam4pt5, gam4bbar
             424                     
             425                     !  Lin
             426                     !-GT  REAL    , PARAMETER ::     xnor = 8.0e6
             427                     !   REAL    , PARAMETER ::     xnos = 3.0e6
             428                     !-GT   REAL    , PARAMETER ::     xnos = 1.6e7   ! Tao's value
             429                        REAL    , PARAMETER ::                              &
             430                     !             constb = 0.8, constd = 0.25, o6 = 1./6.,           &
             431                                  constb = 0.8, constd = 0.11, o6 = 1./6.,           &
             432                                  cdrag = 0.6
             433                     !  Lin
             434                     !  REAL    , PARAMETER ::     xnoh = 4.0e4
             435                     !-GT  REAL    , PARAMETER ::     xnoh = 2.0e5    ! Tao's value
             436                     !-GT  REAL    , PARAMETER ::     rhohail = 917.
             437                     
             438                     ! Hobbs
             439                     !-GT  REAL    , PARAMETER ::     xnog = 4.0e6
             440                     !-GT  REAL    , PARAMETER ::     rhograul = 400.
             441                       REAL    , PARAMETER ::     abar = 19.3, bbar = 0.37,      &
             442                                                           p0 = 1.0e5
             443                     
             444                       REAL    , PARAMETER ::     rhoe_s = 1.29
             445                     
             446                     ! for terminal velocity flux
             447                       INTEGER                       :: min_q, max_q
             448                       REAL                          :: t_del_tv, del_tv, flux, fluxin, fluxout ,tmpqrz
             449                       LOGICAL                       :: notlast
             450                     
             451                     !  if (itimestep.eq.1) then
             452                     !     write(6, *) 'in fall_flux'
             453                     !     write(6, *) 'ims=', ims, '  ime=', ime
             454                     !     write(6, *) 'jms=', jms, '  jme=', jme
             455                     !     write(6, *) 'kms=', kms, '  kme=', kme
             456                     !     write(6, *) 'its=', its, '  ite=', ite
             457                     !     write(6, *) 'jts=', jts, '  jte=', jte
             458                     !     write(6, *) 'kts=', kts, '  kte=', kte
             459                     !     write(6, *) 'dt=', dt
             460                     !     write(6, *) 'ihail=', ihail
             461                     !     write(6, *) 'ICE2=', ICE2
             462                     !     write(6, *) 'dt=', dt
             463                     !   endif
             464                     
             465                     !-----------------------------------------------------------------------
             466                     !  This program calculates precipitation fluxes due to terminal velocities.
             467                     !-----------------------------------------------------------------------
             468                     
             469                        dtb=dt
             470                        pi=acos(-1.)
             471                        consta=2115.0*0.01**(1-constb)
             472                     !   constc=152.93*0.01**(1-constd)
             473                        constc=78.63*0.01**(1-constd)
             474                     
             475                     !  Gamma function
             476                        gambp4=ggamma(constb+4.)
             477                        gamdp4=ggamma(constd+4.)
             478                        gam4pt5=ggamma(4.5)
             479                        gam4bbar=ggamma(4.+bbar)
             480                     
             481                     !***********************************************************************
             482                     ! Calculate precipitation fluxes due to terminal velocities.
             483                     !***********************************************************************
             484                     !
             485                     !- Calculate termianl velocity (vt?)  of precipitation q?z
             486                     !- Find maximum vt? to determine the small delta t
             487                     
             488     1                j_loop:  do j = jts, jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, sqrhoz, orhoz, qsz, qiz, dzw, zz
                                   <<<      prez, qrz, qgz
                                   <<< Loop-information  End >>>
             489     2                i_loop:  do i = its, ite
             490     2               
             491     2                  pptrain = 0.
             492     2                  pptsnow = 0.
             493     2                  pptgraul = 0.
             494     2                  pptice  = 0.
             495     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 254
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 496,506,510)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsz, qiz, dzw, zz, prez, sqrhoz, orhoz
                                   <<<      rhoz, qrz
                                   <<< Loop-information  End >>>
             496     3  pp    v         do k = kts, kte
             497     3   p    v            qrz(k)=qr(i,k,j)
             498     3   p    v            rhoz(k)=rho(i,k,j)
             499     3   p    v            orhoz(k)=1./rhoz(k)
             500     3   p    v            prez(k)=p(i,k,j)
             501     3   p    v            sqrhoz(k)=sqrt(rhoe_s/rhoz(k))
             502     3   p    v            zz(k)=z(i,k,j)
             503     3   p    v            dzw(k)=dz8w(i,k,j)
             504     3   p    v         enddo !k
             505     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             506     3                     DO k = kts, kte
             507     3                        qiz(k)=qi(i,k,j)
             508     3                     ENDDO
             509     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             510     3                     DO k = kts, kte
             511     3                        qsz(k)=qs(i,k,j)
             512     3                     ENDDO
             513     2               
             514     3                  IF (ice2 .eq. 0) THEN
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<< Loop-information  End >>>
             515     4  pp   4v            DO k = kts, kte
             516     4   p   4v               qgz(k)=qg(i,k,j)
             517     4   p   4v            ENDDO
             518     3                  ELSE
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<< Loop-information  End >>>
             519     4  pp   4v            DO k = kts, kte
             520     4   p   4v               qgz(k)=0.
             521     4   p   4v            ENDDO
             522     3                  ENDIF
             523     2               
             524     2               
             525     2               !
             526     2               !-- rain
             527     2               !
             528     2                   t_del_tv=0.
             529     2                   del_tv=dtb
             530     2                   notlast=.true.
             531     3                   DO while (notlast)
             532     3               !
             533     3                     min_q=kte
             534     3                     max_q=kts-1
             535     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrz
                                   <<< Loop-information  End >>>
             536     4   s   2s            do k=kts,kte-1
             537     5   p   2v               if (qrz(k) .gt. 1.0e-8) then
             538     5   p   2v                  min_q=min0(min_q,k)
             539     5   p   2v                  max_q=max0(max_q,k)
             540     5   p   2v                  tmp1=sqrt(pi*rhowater*xnor/rhoz(k)/qrz(k))
             541     5   p   2v                  tmp1=sqrt(tmp1)
             542     5   p   2v                  vtr(k)=consta*gambp4*sqrhoz(k)/tmp1**constb
             543     5   m   2m                  vtr(k)=vtr(k)/6.
             544     6   p   2v                  if (k .eq. 1) then
             545     6   m   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtr(k))
             546     6   p   2v                  else
             547     6   m   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtr(k))
             548     6   p   2v                  endif
             549     5   p   2v               else
             550     5   s   2m                  vtr(k)=0.
             551     5   p   2v               endif
             552     4   p   2v            enddo
             553     3               
             554     4                     if (max_q .ge. min_q) then
             555     4               !
             556     4               !- Check if the summation of the small delta t >=  big delta t
             557     4               !             (t_del_tv)          (del_tv)             (dtb)
             558     4               
             559     4                        t_del_tv=t_del_tv+del_tv
             560     4               !
             561     5                        if ( t_del_tv .ge. dtb ) then
             562     5                             notlast=.false.
             563     5                             del_tv=dtb+del_tv-t_del_tv
             564     5                        endif
             565     4               
             566     4               ! use small delta t to calculate the qrz flux
             567     4               ! termi is the qrz flux pass in the grid box through the upper boundary
             568     4               ! termo is the qrz flux pass out the grid box through the lower boundary
             569     4               !
             570     4                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qrz, vtr, dzw
                                   <<< Loop-information  End >>>
             571     5   s    s               do k=max_q,min_q,-1
             572     5   p    v                  fluxout=rhoz(k)*vtr(k)*qrz(k)
             573     5   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             574     5               !            tmpqrz=qrz(k)
             575     5   p    v                  qrz(k)=qrz(k)+del_tv*flux
             576     5   p    v                  qrz(k)=amax1(0.,qrz(k))
             577     5   p    v                  qr(i,k,j)=qrz(k)
             578     5   s    s                  fluxin=fluxout
             579     5   p    v               enddo
             580     5                        if (min_q .eq. 1) then
             581     5                           pptrain=pptrain+fluxin*del_tv
             582     5                        else
             583     5                           qrz(min_q-1)=qrz(min_q-1)+del_tv*  &
             584     5                                         fluxin/rhoz(min_q-1)/dzw(min_q-1)
             585     5                           qr(i,min_q-1,j)=qrz(min_q-1)
             586     5                        endif
             587     4               !
             588     4                     else
             589     4                        notlast=.false.
             590     4                     endif
             591     3                   ENDDO
             592     2               
             593     2               !
             594     2               !-- snow
             595     2               !
             596     2                   t_del_tv=0.
             597     2                   del_tv=dtb
             598     2                   notlast=.true.
             599     2               
             600     3                   DO while (notlast)
             601     3               !
             602     3                     min_q=kte
             603     3                     max_q=kts-1
             604     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsz
                                   <<< Loop-information  End >>>
             605     4   s   2s            do k=kts,kte-1
             606     5   p   2v               if (qsz(k) .gt. 1.0e-8) then
             607     5   p   2v                  min_q=min0(min_q,k)
             608     5   p   2v                  max_q=max0(max_q,k)
             609     5   p   2v                  tmp1=sqrt(pi*rhosnow*xnos/rhoz(k)/qsz(k))
             610     5   p   2v                  tmp1=sqrt(tmp1)
             611     5   p   2v                  vts(k)=constc*gamdp4*sqrhoz(k)/tmp1**constd
             612     5   m   2m                  vts(k)=vts(k)/6.
             613     6   p   2v                  if (k .eq. 1) then
             614     6   m   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vts(k))
             615     6   p   2v                  else
             616     6   m   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vts(k))
             617     6   p   2v                  endif
             618     5   p   2v               else
             619     5   s   2m                  vts(k)=0.
             620     5   p   2v               endif
             621     4   p   2v            enddo
             622     3               
             623     4                     if (max_q .ge. min_q) then
             624     4               !
             625     4               !
             626     4               !- Check if the summation of the small delta t >=  big delta t
             627     4               !             (t_del_tv)          (del_tv)             (dtb)
             628     4               
             629     4                        t_del_tv=t_del_tv+del_tv
             630     4               
             631     5                        if ( t_del_tv .ge. dtb ) then
             632     5                             notlast=.false.
             633     5                             del_tv=dtb+del_tv-t_del_tv
             634     5                        endif
             635     4               
             636     4               ! use small delta t to calculate the qsz flux
             637     4               ! termi is the qsz flux pass in the grid box through the upper boundary
             638     4               ! termo is the qsz flux pass out the grid box through the lower boundary
             639     4               !
             640     4                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qsz, vts, dzw
                                   <<< Loop-information  End >>>
             641     5   s    s               do k=max_q,min_q,-1
             642     5   p    v                  fluxout=rhoz(k)*vts(k)*qsz(k)
             643     5   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             644     5   p    v                  qsz(k)=qsz(k)+del_tv*flux
             645     5   p    v                  qsz(k)=amax1(0.,qsz(k))
             646     5   p    v                  qs(i,k,j)=qsz(k)
             647     5   s    s                  fluxin=fluxout
             648     5   p    v               enddo
             649     5                        if (min_q .eq. 1) then
             650     5                           pptsnow=pptsnow+fluxin*del_tv
             651     5                        else
             652     5                           qsz(min_q-1)=qsz(min_q-1)+del_tv*  &
             653     5                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
             654     5                           qs(i,min_q-1,j)=qsz(min_q-1)
             655     5                        endif
             656     4               !
             657     4                     else
             658     4                        notlast=.false.
             659     4                     endif
             660     3               
             661     3                   ENDDO
             662     2               
             663     2               !
             664     2               !   ice2=0 --- with hail/graupel
             665     2               !   ice2=1 --- without hail/graupel
             666     2               !
             667     3                 if (ice2.eq.0) then
             668     3               !
             669     3               !-- If IHAIL=1, use hail.
             670     3               !-- If IHAIL=0, use graupel.
             671     3               !
             672     3               !    if (ihail .eq. 1) then
             673     3               !       xnog = xnoh
             674     3               !       rhograul = rhohail
             675     3               !    endif
             676     3               
             677     3                   t_del_tv=0.
             678     3                   del_tv=dtb
             679     3                   notlast=.true.
             680     3               !
             681     4                   DO while (notlast)
             682     4               !
             683     4                     min_q=kte
             684     4                     max_q=kts-1
             685     4               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             686     5   s   2s            do k=kts,kte-1
             687     6   p   2v               if (qgz(k) .gt. 1.0e-8) then
             688     7   p   2v                  if (ihail .eq. 1) then
             689     7               !  for hail, based on Lin et al (1983)
             690     7       2                     min_q=min0(min_q,k)
             691     7       2                     max_q=max0(max_q,k)
             692     7       2                     tmp1=sqrt(pi*rhohail*xnoh/rhoz(k)/qgz(k))
             693     7       2                     tmp1=sqrt(tmp1)
             694     7       2                     term0=sqrt(4.*grav*rhohail/3./rhoz(k)/cdrag)
             695     7       2                     vtg(k)=gam4pt5*term0*sqrt(1./tmp1)
             696     7       2                     vtg(k)=vtg(k)/6.
             697     8       2                     if (k .eq. 1) then
             698     8       2                        del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtg(k))
             699     8       2                     else
             700     8       2                        del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtg(k))
             701     8       2                     endif !k
             702     7   p   2v                  else
             703     7               ! added by JJS
             704     7               ! for graupel, based on RH (1984)
             705     7   p   2v                    min_q=min0(min_q,k)
             706     7   p   2v                    max_q=max0(max_q,k)
             707     7   p   2v                    tmp1=sqrt(pi*rhograul*xnog/rhoz(k)/qgz(k))
             708     7   p   2v                    tmp1=sqrt(tmp1)
             709     7   p   2v                    tmp1=tmp1**bbar
             710     7   p   2v                    tmp1=1./tmp1
             711     7   p   2v                    term0=abar*gam4bbar/6.
             712     7   m   2m                    vtg(k)=term0*tmp1*(p0/prez(k))**0.4
             713     8   p   2v                    if (k .eq. 1) then
             714     8   m   2m                       del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtg(k))
             715     8   p   2v                    else
             716     8   m   2m                       del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtg(k))
             717     8   p   2v                    endif !k
             718     7   p   2v                  endif !ihail
             719     6   p   2v               else
             720     6   s   2m                  vtg(k)=0.
             721     6   p   2v               endif !qgz
             722     5   p   2v            enddo !k
             723     4               
             724     5                     if (max_q .ge. min_q) then
             725     5               !
             726     5               !
             727     5               !- Check if the summation of the small delta t >=  big delta t
             728     5               !             (t_del_tv)          (del_tv)             (dtb)
             729     5               
             730     5                        t_del_tv=t_del_tv+del_tv
             731     5               
             732     6                        if ( t_del_tv .ge. dtb ) then
             733     6                             notlast=.false.
             734     6                             del_tv=dtb+del_tv-t_del_tv
             735     6                        endif
             736     5               
             737     5               ! use small delta t to calculate the qgz flux
             738     5               ! termi is the qgz flux pass in the grid box through the upper boundary
             739     5               ! termo is the qgz flux pass out the grid box through the lower boundary
             740     5               !
             741     5                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qgz, vtg, dzw
                                   <<< Loop-information  End >>>
             742     6   s    s               do k=max_q,min_q,-1
             743     6   p    v                  fluxout=rhoz(k)*vtg(k)*qgz(k)
             744     6   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             745     6   p    v                  qgz(k)=qgz(k)+del_tv*flux
             746     6   p    v                  qgz(k)=amax1(0.,qgz(k))
             747     6   p    v                  qg(i,k,j)=qgz(k)
             748     6   s    s                  fluxin=fluxout
             749     6   p    v               enddo
             750     6                        if (min_q .eq. 1) then
             751     6                           pptgraul=pptgraul+fluxin*del_tv
             752     6                        else
             753     6                           qgz(min_q-1)=qgz(min_q-1)+del_tv*  &
             754     6                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
             755     6                           qg(i,min_q-1,j)=qgz(min_q-1)
             756     6                        endif
             757     5               !
             758     5                     else
             759     5                        notlast=.false.
             760     5                     endif
             761     4               !
             762     4                   ENDDO
             763     3                ENDIF !ice2
             764     2               !
             765     2               !-- cloud ice  (03/21/02) follow Vaughan T.J. Phillips at GFDL
             766     2               !
             767     2               
             768     2                   t_del_tv=0.
             769     2                   del_tv=dtb
             770     2                   notlast=.true.
             771     2               !
             772     3                   DO while (notlast)
             773     3               !
             774     3                     min_q=kte
             775     3                     max_q=kts-1
             776     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qiz
                                   <<< Loop-information  End >>>
             777     4   s   2s            do k=kts,kte-1
             778     5   p   2v               if (qiz(k) .gt. 1.0e-8) then
             779     5   p   2v                  min_q=min0(min_q,k)
             780     5   p   2v                  max_q=max0(max_q,k)
             781     5   m   2m                  vti(k)= 3.29 * (rhoz(k)* qiz(k))** 0.16  ! Heymsfield and Donner
             782     6   p   2v                  if (k .eq. 1) then
             783     6   m   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vti(k))
             784     6   p   2v                  else
             785     6   m   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vti(k))
             786     6   p   2v                  endif
             787     5   p   2v               else
             788     5   s   2m                  vti(k)=0.
             789     5   p   2v               endif
             790     4   p   2v            enddo
             791     3               
             792     4                     if (max_q .ge. min_q) then
             793     4               !
             794     4               !
             795     4               !- Check if the summation of the small delta t >=  big delta t
             796     4               !             (t_del_tv)          (del_tv)             (dtb)
             797     4               
             798     4                        t_del_tv=t_del_tv+del_tv
             799     4               
             800     5                        if ( t_del_tv .ge. dtb ) then
             801     5                             notlast=.false.
             802     5                             del_tv=dtb+del_tv-t_del_tv
             803     5                        endif
             804     4               
             805     4               ! use small delta t to calculate the qiz flux
             806     4               ! termi is the qiz flux pass in the grid box through the upper boundary
             807     4               ! termo is the qiz flux pass out the grid box through the lower boundary
             808     4               !
             809     4               
             810     4                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qiz, vti, dzw
                                   <<< Loop-information  End >>>
             811     5   s    s               do k=max_q,min_q,-1
             812     5   p    v                  fluxout=rhoz(k)*vti(k)*qiz(k)
             813     5   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             814     5   p    v                  qiz(k)=qiz(k)+del_tv*flux
             815     5   p    v                  qiz(k)=amax1(0.,qiz(k))
             816     5   p    v                  qi(i,k,j)=qiz(k)
             817     5   s    s                  fluxin=fluxout
             818     5   p    v               enddo
             819     5                        if (min_q .eq. 1) then
             820     5                           pptice=pptice+fluxin*del_tv
             821     5                        else
             822     5                           qiz(min_q-1)=qiz(min_q-1)+del_tv*  &
             823     5                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
             824     5                           qi(i,min_q-1,j)=qiz(min_q-1)
             825     5                        endif
             826     4               !
             827     4                     else
             828     4                        notlast=.false.
             829     4                     endif
             830     3               !
             831     3                  ENDDO !notlast
             832     2               
             833     2               !   prnc(i,j)=prnc(i,j)+pptrain
             834     2               !   psnowc(i,j)=psnowc(i,j)+pptsnow
             835     2               !   pgrauc(i,j)=pgrauc(i,j)+pptgraul
             836     2               !   picec(i,j)=picec(i,j)+pptice
             837     2               !
             838     2               
             839     2               !   write(6,*) 'i=',i,' j=',j,'   ', pptrain, pptsnow, pptgraul, pptice
             840     2               !   flush(6)
             841     2               
             842     2                  snowncv(i,j) = pptsnow
             843     2                  snownc(i,j) = snownc(i,j) + pptsnow
             844     2                  graupelncv(i,j) = pptgraul
             845     2                  graupelnc(i,j) = graupelnc(i,j) + pptgraul
             846     2                  RAINNCV(i,j) = pptrain + pptsnow + pptgraul + pptice
             847     2                  RAINNC(i,j)  = RAINNC(i,j) + pptrain + pptsnow + pptgraul + pptice
             848     2                  sr(i,j) = 0.
             849     2                  if (RAINNCV(i,j) .gt. 0.) sr(i,j) = (pptsnow + pptgraul + pptice) / RAINNCV(i,j)
             850     2               
             851     2                 ENDDO i_loop
             852     1                 ENDDO j_loop
             853                     
             854                     !  if (itimestep.eq.6480) then
             855                     !     write(51,*) 'in the end of fallflux, itimestep=',itimestep
             856                     !     do j=jts,jte
             857                     !        do i=its,ite
             858                     !           if (rainnc(i,j).gt.400.) then
             859                     !              write(50,*) 'i=',i,' j=',j,' rainnc=',rainnc
             860                     !           endif
             861                     !        enddo
             862                     !     enddo
             863                     !  endif
             864                     
             865                       END SUBROUTINE fall_flux
             866                     
             867                     !----------------------------------------------------------------
             868                        REAL FUNCTION ggamma(X)
             869                     !----------------------------------------------------------------
             870                        IMPLICIT NONE
             871                     !----------------------------------------------------------------
             872                           REAL, INTENT(IN   ) :: x
             873                           REAL, DIMENSION(8)  :: B
             874                           INTEGER             ::j, K1
             875                           REAL                ::PF, G1TO2 ,TEMP
             876                     
             877                           DATA B/-.577191652,.988205891,-.897056937,.918206857,  &
             878                                  -.756704078,.482199394,-.193527818,.035868343/
             879                     
             880                           PF=1.
             881                           TEMP=X
             882     1                     DO 10 J=1,200
             883     1                     IF (TEMP .LE. 2) GO TO 20
             884     1                     TEMP=TEMP-1.
             885     1                  10 PF=PF*TEMP
             886                       100 FORMAT(//,5X,'module_gsfcgce: INPUT TO GAMMA FUNCTION TOO LARGE, X=',E12.5)
             887                     !      WRITE(wrf_err_message,100)X
             888                     !      CALL wrf_error_fatal(wrf_err_message)
             889                        20 G1TO2=1.
             890                           TEMP=TEMP - 1.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             891     1   s    v            DO 30 K1=1,8
             892     1   p    v         30 G1TO2=G1TO2 + B(K1)*TEMP**K1
             893                           ggamma=PF*G1TO2
             894                     
             895                           END FUNCTION ggamma
             896                     
             897                     !-----------------------------------------------------------------------
             898                     !c Correction of negative values
             899                        SUBROUTINE negcor ( X, rho, dz8w,                         &
             900                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             901                                           itimestep, ics,                         &
             902                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             903                     !-----------------------------------------------------------------------
             904                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
             905                             INTENT(INOUT) ::                                     X
             906                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
             907                             INTENT(IN   ) ::                              rho, dz8w
             908                       integer, INTENT(IN   ) ::                           itimestep, ics
             909                     
             910                     !c Local variables
             911                     !  REAL, DIMENSION( kts:kte ) ::  Y1, Y2
             912                       REAL   ::   A0, A1, A2
             913                     
             914                       A1=0.
             915                       A2=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<< Loop-information  End >>>
             916     1                 do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             917     2                    do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             918     3  pp    v              do i=its,ite
             919     3   p    v              A1=A1+max(X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
             920     3   p    v              A2=A2+max(-X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
             921     3   p    v              enddo
             922     2                    enddo
             923     1                 enddo
             924                     
             925                     !  A1=0.0
             926                     !  A2=0.0
             927                     !  do k=kts,kte
             928                     !     A1=A1+Y1(k)
             929                     !     A2=A2+Y2(k)
             930                     !  enddo
             931                     
             932                       A0=0.0
             933                     
             934     1                 if (A1.NE.0.0.and.A1.GT.A2) then
             935     1                    A0=(A1-A2)/A1
             936     1               
             937     2                 if (mod(itimestep,540).eq.0) then
             938     3                    if (ics.eq.1) then
             939     3                       write(61,*) 'kms=',kms,'  kme=',kme,'  kts=',kts,'  kte=',kte
             940     3                       write(61,*) 'jms=',jms,'  jme=',jme,'  jts=',jts,'  jte=',jte
             941     3                       write(61,*) 'ims=',ims,'  ime=',ime,'  its=',its,'  ite=',ite
             942     3                    endif
             943     3                    if (ics.eq.1) then
             944     3                        write(61,*) 'qv timestep=',itimestep
             945     3                        write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
             946     3                    else if (ics.eq.2) then
             947     3                            write(61,*) 'ql timestep=',itimestep
             948     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
             949     3                    else if (ics.eq.3) then
             950     3                            write(61,*) 'qr timestep=',itimestep
             951     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
             952     3                    else if (ics.eq.4) then
             953     3                            write(61,*) 'qi timestep=',itimestep
             954     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
             955     3                    else if (ics.eq.5) then
             956     3                            write(61,*) 'qs timestep=',itimestep
             957     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
             958     3                    else if (ics.eq.6) then
             959     3                            write(61,*) 'qg timestep=',itimestep
             960     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
             961     3                    else
             962     3                            write(61,*) 'wrong cloud specieis number'
             963     3                    endif
             964     2                 endif
             965     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
             966     2   p                do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             967     3  pp                   do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 224, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
             968     4   p   2v                 do i=its,ite
             969     4   p   2v                 X(i,k,j)=A0*AMAX1(X(i,k,j), 0.0)
             970     4   p   2v                 enddo
             971     3   p                   enddo
             972     2   p                enddo
             973     1                 endif
             974                     
             975                       END SUBROUTINE negcor
             976                     
             977                      SUBROUTINE consat_s (ihail,itaobraun)
             978                     
             979                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             980                     !                                                                      c
             981                     !   Tao, W.-K., and J. Simpson, 1989: Modeling study of a tropical     c
             982                     !   squall-type convective line. J. Atmos. Sci., 46, 177-202.          c
             983                     !                                                                      c
             984                     !   Tao, W.-K., J. Simpson and M. McCumber, 1989: An ice-water         c
             985                     !   saturation adjustment. Mon. Wea. Rev., 117, 231-235.               c
             986                     !                                                                      c
             987                     !   Tao, W.-K., and J. Simpson, 1993: The Goddard Cumulus Ensemble     c
             988                     !   Model. Part I: Model description. Terrestrial, Atmospheric and     c
             989                     !   Oceanic Sciences, 4, 35-72.                                        c
             990                     !                                                                      c
             991                     !   Tao, W.-K., J. Simpson, D. Baker, S. Braun, M.-D. Chou, B.         c
             992                     !   Ferrier,D. Johnson, A. Khain, S. Lang,  B. Lynn, C.-L. Shie,       c
             993                     !   D. Starr, C.-H. Sui, Y. Wang and P. Wetzel, 2003: Microphysics,    c
             994                     !   radiation and surface processes in the Goddard Cumulus Ensemble    c
             995                     !   (GCE) model, A Special Issue on Non-hydrostatic Mesoscale          c
             996                     !   Modeling, Meteorology and Atmospheric Physics, 82, 97-137.         c
             997                     !                                                                      c
             998                     !   Lang, S., W.-K. Tao, R. Cifelli, W. Olson, J. Halverson, S.        c
             999                     !   Rutledge, and J. Simpson, 2007: Improving simulations of           c
            1000                     !   convective system from TRMM LBA: Easterly and Westerly regimes.    c
            1001                     !   J. Atmos. Sci., 64, 1141-1164.                                     c
            1002                     !                                                                      c
            1003                     !   Coded by Tao (1989-2003), modified by S. Lang (2006/07)            c
            1004                     !                                                                      c
            1005                     !   Implemented into WRF  by Roger Shi 2006/2007                       c
            1006                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1007                     
            1008                     !        itaobraun=0   ! see Tao and Simpson (1993)
            1009                     !        itaobraun=1   ! see Tao et al. (2003)
            1010                     
            1011                      integer :: itaobraun
            1012                      real    :: cn0
            1013                     
            1014                     !JJS 1/3/2008  vvvvv
            1015                     !JJS   the following common blocks have been moved to the top of
            1016                     !JJS   module_mp_gsfcgce_driver_instat.F
            1017                     !
            1018                     ! real,   dimension (1:31) ::  a1, a2
            1019                     ! data a1/.7939e-7,.7841e-6,.3369e-5,.4336e-5,.5285e-5,.3728e-5, &
            1020                     !         .1852e-5,.2991e-6,.4248e-6,.7434e-6,.1812e-5,.4394e-5,.9145e-5, &
            1021                     !         .1725e-4,.3348e-4,.1725e-4,.9175e-5,.4412e-5,.2252e-5,.9115e-6, &
            1022                     !         .4876e-6,.3473e-6,.4758e-6,.6306e-6,.8573e-6,.7868e-6,.7192e-6, &
            1023                     !         .6513e-6,.5956e-6,.5333e-6,.4834e-6/
            1024                     ! data a2/.4006,.4831,.5320,.5307,.5319,.5249,.4888,.3894,.4047, &
            1025                     !         .4318,.4771,.5183,.5463,.5651,.5813,.5655,.5478,.5203,.4906, &
            1026                     !         .4447,.4126,.3960,.4149,.4320,.4506,.4483,.4460,.4433,.4413, &
            1027                     !         .4382,.4361/
            1028                     !JJS 1/3/2008  ^^^^^
            1029                     
            1030                     
            1031                     !     ******************************************************************
            1032                     !JJS
            1033                           al = 2.5e10
            1034                           cp = 1.004e7
            1035                           rd1 = 1.e-3
            1036                           rd2 = 2.2
            1037                     !JJS
            1038                           cpi=4.*atan(1.)
            1039                           cpi2=cpi*cpi
            1040                           grvt=980.
            1041                           cd1=6.e-1
            1042                           cd2=4.*grvt/(3.*cd1)
            1043                           tca=2.43e3
            1044                           dwv=.226
            1045                           dva=1.718e-4
            1046                           amw=18.016
            1047                           ars=8.314e7
            1048                           scv=2.2904487
            1049                           t0=273.16
            1050                           t00=238.16
            1051                           alv=2.5e10
            1052                           alf=3.336e9
            1053                           als=2.8336e10
            1054                           avc=alv/cp
            1055                           afc=alf/cp
            1056                           asc=als/cp
            1057                           rw=4.615e6
            1058                           cw=4.187e7
            1059                           ci=2.093e7
            1060                           c76=7.66
            1061                           c358=35.86
            1062                           c172=17.26939
            1063                           c409=4098.026
            1064                           c218=21.87456
            1065                           c580=5807.695
            1066                           c610=6.1078e3
            1067                           c149=1.496286e-5
            1068                           c879=8.794142
            1069                           c141=1.4144354e7
            1070                     !***   DEFINE THE COEFFICIENTS USED IN TERMINAL VELOCITY
            1071                     !***   DEFINE THE DENSITY AND SIZE DISTRIBUTION OF PRECIPITATION
            1072                     !**********   HAIL OR GRAUPEL PARAMETERS   **********
            1073     1                     if(ihail .eq. 1) then
            1074     1                        roqg=.9
            1075     1                        ag=sqrt(cd2*roqg)
            1076     1                        bg=.5
            1077     1                        tng=.002
            1078     1                     else
            1079     1                        roqg=.4
            1080     1                        ag=351.2
            1081     1               !        AG=372.3 ! if ice913=1 6/15/02 tao's
            1082     1                        bg=.37
            1083     1                        tng=.04
            1084     1                     endif
            1085                     !**********         SNOW PARAMETERS        **********
            1086                     !ccshie 6/15/02 tao's
            1087                     !      TNS=1.
            1088                     !      TNS=.08 ! if ice913=1, tao's
            1089                           tns=.16 ! if ice913=0, tao's
            1090                           roqs=.1
            1091                     !      AS=152.93
            1092                           as=78.63
            1093                     !      BS=.25
            1094                           bs=.11
            1095                     !**********         RAIN PARAMETERS        **********
            1096                           aw=2115.
            1097                           bw=.8
            1098                           roqr=1.
            1099                           tnw=.08
            1100                     !*****************************************************************
            1101                           bgh=.5*bg
            1102                           bsh=.5*bs
            1103                           bwh=.5*bw
            1104                           bgq=.25*bg
            1105                           bsq=.25*bs
            1106                           bwq=.25*bw
            1107                     !**********GAMMA FUNCTION CALCULATIONS*************
            1108                           ga3b  = gammagce(3.+bw)
            1109                           ga4b  = gammagce(4.+bw)
            1110                           ga6b  = gammagce(6.+bw)
            1111                           ga5bh = gammagce((5.+bw)/2.)
            1112                           ga3g  = gammagce(3.+bg)
            1113                           ga4g  = gammagce(4.+bg)
            1114                           ga5gh = gammagce((5.+bg)/2.)
            1115                           ga3d  = gammagce(3.+bs)
            1116                           ga4d  = gammagce(4.+bs)
            1117                           ga5dh = gammagce((5.+bs)/2.)
            1118                     !CCCCC        LIN ET AL., 1983 OR LORD ET AL., 1984   CCCCCCCCCCCCCCCCC
            1119                           ac1=aw
            1120                     !JJS
            1121                           ac2=ag
            1122                           ac3=as
            1123                     !JJS
            1124                           bc1=bw
            1125                           cc1=as
            1126                           dc1=bs
            1127                           zrc=(cpi*roqr*tnw)**0.25
            1128                           zsc=(cpi*roqs*tns)**0.25
            1129                           zgc=(cpi*roqg*tng)**0.25
            1130                           vrc=aw*ga4b/(6.*zrc**bw)
            1131                           vsc=as*ga4d/(6.*zsc**bs)
            1132                           vgc=ag*ga4g/(6.*zgc**bg)
            1133                     !     ****************************
            1134                     !     RN1=1.E-3
            1135                           rn1=9.4e-15 ! 6/15/02 tao's
            1136                           bnd1=6.e-4
            1137                           rn2=1.e-3
            1138                     !     BND2=1.25E-3
            1139                     !     BND2=1.5E-3 ! if ice913=1 6/15/02 tao's
            1140                           bnd2=2.0e-3 ! if ice913=0 6/15/02 tao's
            1141                           rn3=.25*cpi*tns*cc1*ga3d
            1142                           esw=1.
            1143                           rn4=.25*cpi*esw*tns*cc1*ga3d
            1144                     !     ERI=1.
            1145                           eri=.1  ! 6/17/02 tao's ice913=0 (not 1)
            1146                           rn5=.25*cpi*eri*tnw*ac1*ga3b
            1147                     !     AMI=1./(24.*4.19E-10)
            1148                           ami=1./(24.*6.e-9) ! 6/15/02 tao's
            1149                           rn6=cpi2*eri*tnw*ac1*roqr*ga6b*ami
            1150                     !     ESR=1. ! also if ice913=1 for tao's
            1151                           esr=.5 ! 6/15/02 for ice913=0 tao's
            1152                           rn7=cpi2*esr*tnw*tns*roqs
            1153                           esr=1.
            1154                           rn8=cpi2*esr*tnw*tns*roqr
            1155                           rn9=cpi2*tns*tng*roqs
            1156                           rn10=2.*cpi*tns
            1157                           rn101=.31*ga5dh*sqrt(cc1)
            1158                           rn10a=als*als/rw
            1159                     !JJS
            1160                            rn10b=alv/tca
            1161                            rn10c=ars/(dwv*amw)
            1162                     !JJS
            1163                           rn11=2.*cpi*tns/alf
            1164                           rn11a=cw/alf
            1165                     !     AMI50=1.51e-7
            1166                           ami50=3.84e-6 ! 6/15/02 tao's
            1167                     !     AMI40=2.41e-8
            1168                           ami40=3.08e-8 ! 6/15/02 tao's
            1169                           eiw=1.
            1170                     !     UI50=20.
            1171                           ui50=100. ! 6/15/02 tao's
            1172                           ri50=2.*5.e-3
            1173                           cmn=1.05e-15
            1174                           rn12=cpi*eiw*ui50*ri50**2
            1175                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 12
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aa2, aa1, rn25a, rn12b, rn13, rn12a
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 4  FILL 12
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1176     1  pp    v            do 10 k=1,31
            1177     1   p    v               y1=1.-aa2(k)
            1178     1   p    v               rn13(k)=aa1(k)*y1/(ami50**y1-ami40**y1)
            1179     1   p    v               rn12a(k)=rn13(k)/ami50
            1180     1   p    v               rn12b(k)=aa1(k)*ami50**aa2(k)
            1181     1   p    v               rn25a(k)=aa1(k)*cmn**aa2(k)
            1182     1   p    v         10 continue
            1183                     
            1184                           egw=1.
            1185                           rn14=.25*cpi*egw*tng*ga3g*ag
            1186                           egi=.1
            1187                           rn15=.25*cpi*egi*tng*ga3g*ag
            1188                           egi=1.
            1189                           rn15a=.25*cpi*egi*tng*ga3g*ag
            1190                           egr=1.
            1191                           rn16=cpi2*egr*tng*tnw*roqr
            1192                           rn17=2.*cpi*tng
            1193                           rn17a=.31*ga5gh*sqrt(ag)
            1194                           rn17b=cw-ci
            1195                           rn17c=cw
            1196                           apri=.66
            1197                           bpri=1.e-4
            1198                           bpri=0.5*bpri ! 6/17/02 tao's
            1199                           rn18=20.*cpi2*bpri*tnw*roqr
            1200                           rn18a=apri
            1201                           rn19=2.*cpi*tng/alf
            1202                           rn19a=.31*ga5gh*sqrt(ag)
            1203                           rn19b=cw/alf
            1204                     !
            1205                            rnn191=.78
            1206                            rnn192=.31*ga5gh*sqrt(ac2/dva)
            1207                     !
            1208                           rn20=2.*cpi*tng
            1209                           rn20a=als*als/rw
            1210                           rn20b=.31*ga5gh*sqrt(ag)
            1211                           bnd3=2.e-3
            1212                           rn21=1.e3*1.569e-12/0.15
            1213                           erw=1.
            1214                           rn22=.25*cpi*erw*ac1*tnw*ga3b
            1215                           rn23=2.*cpi*tnw
            1216                           rn23a=.31*ga5bh*sqrt(ac1)
            1217                           rn23b=alv*alv/rw
            1218                     
            1219                     
            1220                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1221                     !cc
            1222                     !cc        "c0" in routine      "consat" (2d), "consatrh" (3d)
            1223                     !cc        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
            1224                     !cc        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
            1225                     
            1226     1                      if (itaobraun .eq. 0) then
            1227     1                        cn0=1.e-8
            1228     1                        beta=-.6
            1229     1                      elseif (itaobraun .eq. 1) then
            1230     1                        cn0=1.e-6
            1231     1                        beta=-.46
            1232     1                      endif
            1233                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1234                     !      CN0=1.E-6
            1235                     !      CN0=1.E-8 ! 6/15/02 tao's
            1236                     !      BETA=-.46
            1237                     !      BETA=-.6  ! 6/15/02 tao's
            1238                     
            1239                           rn25=cn0
            1240                           rn30a=alv*als*amw/(tca*ars)
            1241                           rn30b=alv/tca
            1242                           rn30c=ars/(dwv*amw)
            1243                           rn31=1.e-17
            1244                     
            1245                           rn32=4.*51.545e-4
            1246                     !
            1247                           rn30=2.*cpi*tng
            1248                           rnn30a=alv*alv*amw/(tca*ars)
            1249                     !
            1250                           rn33=4.*tns
            1251                            rn331=.65
            1252                            rn332=.44*sqrt(ac3/dva)*ga5dh
            1253                     !
            1254                     
            1255                         return
            1256                      END SUBROUTINE consat_s

            3231                     real function gamma_toshi(x)
            3232                     !---------------------------------------------------------------------------------------------------
            3233                     ! Comments:
            3234                     !   compute the gamma function T(x) for single precision floating point.
            3235                     !       input :  x  --- argument of a(x)
            3236                     !                       ( x is not equal to 0,-1,-2,... )
            3237                     !
            3238                     ! History:
            3239                     ! 09/2009  Toshi Matsui@NASA GSFC ; Adapted to SDSU
            3240                     !
            3241                     ! References:
            3242                     !----------------------------------------------------------------------------------------------------
            3243                      implicit double precision (a-h,o-z)
            3244                      dimension g(26)
            3245                      data g/1.0d0,0.5772156649015329d0, &
            3246                            -0.6558780715202538d0, -0.420026350340952d-1, &
            3247                             0.1665386113822915d0,-.421977345555443d-1, &
            3248                             -.96219715278770d-2, .72189432466630d-2, &
            3249                             -.11651675918591d-2, -.2152416741149d-3, &
            3250                             .1280502823882d-3, -.201348547807d-4, &
            3251                             -.12504934821d-5, .11330272320d-5, &
            3252                             -.2056338417d-6, .61160950d-8, &
            3253                              .50020075d-8, -.11812746d-8, &
            3254                             .1043427d-9, .77823d-11, &
            3255                             -.36968d-11, .51d-12, &
            3256                             -.206d-13, -.54d-14, .14d-14, .1d-15/
            3257                      real :: x
            3258                     
            3259                      pi=3.141592653589793d0
            3260     1                if (x.eq.int(x)) then
            3261     2                    if (x.gt.0.0d0) then
            3262     2                        ga=1.0d0
            3263     2                        m1=int(x)-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3264     3  pp    v              do k=2,m1
            3265     3   p    v                 ga=ga*k
            3266     3   p    v              enddo
            3267     2                    else
            3268     2                       ga=1.0d+300
            3269     2                    endif
            3270     1                 else
            3271     2                    if (dabs(dble(x)).gt.1.0d0) then
            3272     2                        z=dabs(dble(x))
            3273     2                        m=int(z)
            3274     2                        r=1.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3275     3  pp    v              do k=1,m
            3276     3   p    v                 r=r*(z-k)
            3277     3   p    v              enddo
            3278     2                       z=z-m
            3279     2                    else
            3280     2                       z=dble(x)
            3281     2                    endif
            3282     1                    gr=g(26)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      g
                                   <<< Loop-information  End >>>
            3283     2   s   4s           do k=25,1,-1
            3284     2   s   4s              gr=gr*z+g(k)
            3285     2   s   4s           enddo
            3286     1                    ga=1.0d0/(gr*z)
            3287     2                    if (dabs(dble(x)).gt.1.0d0) then
            3288     2                        ga=ga*r
            3289     2                        if (x.lt.0.0d0) ga=-pi/(x*ga*dsin(pi*x))
            3290     2                    endif
            3291     1                 endif
            3292                     
            3293                       gamma_toshi = real(ga)
            3294                     
            3295                       end function gamma_toshi

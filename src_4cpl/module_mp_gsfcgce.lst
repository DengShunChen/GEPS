             265                     !             stop
             266                     !        endif !ihail
             267                     !     else if (ice2.eq.1) then
             268                     !             write(6,*) 'Running 2-ice scheme in GSFCGCE with'
             269                     !             write(6,*) '     ice and snow'
             270                     !     else if (ice2.eq.2) then
             271                     !             write(6,*) 'Running 2-ice scheme in GSFCGCE with'
             272                     !             write(6,*) '     ice and graupel'
             273                     !     else if (ice2.eq.3) then
             274                     !             write(6,*) 'Running warm rain only scheme in GSFCGCE without any ice'
             275                     !     else

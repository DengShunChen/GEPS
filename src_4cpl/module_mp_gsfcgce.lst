             212                     
             213                           INTEGER:: NCALL=0
             214                     
             215     1                     IF (NCALL .EQ. 0) THEN
             216     1               !..Set these variables needed for computing radar reflectivity.  These
             217     1               !.. get used within radar_init to create other variables used in the
             218     1               !.. radar module.
             219     1                        xam_r = 3.14159*rhowater/6.
             220     1                        xbm_r = 3.
             221     1                        xmu_r = 0.
             222     1                        xam_s = 3.14159*rhosnow/6.
             223     1                        xbm_s = 3.
             224     1                        xmu_s = 0.
             225     2                        if (ihail .eq. 1) then
             226     2                           xam_g = 3.14159*rhohail/6.
             227     2                        else
             228     2                           xam_g = 3.14159*rhograul/6.
             229     2                        endif
             230     1                        xbm_g = 3.
             231     1                        xmu_g = 0.
             232     1               
             233     1                        call radar_init
             234     1                        NCALL = 1
             235     1                     ENDIF
             236                     !+---+-----------------------------------------------------------------+
             237                     
             238                     !
             239                     !c  ihail = 0    for graupel, for tropical region
             240                     !c  ihail = 1    for hail, for mid-lat region
             241                     
             242                     ! itaobraun: 0 for Tao's constantis, 1 for Braun's constants
             243                     !c        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
             244                     !c        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
             245                        itaobraun = 1
             246                     
             247                     !c  ice2 = 0    for 3 ice --- ice, snow and graupel/hail
             248                     !c  ice2 = 1    for 2 ice --- ice and snow only
             249                     !c  ice2 = 2    for 2 ice --- ice and graupel only, use ihail = 0 only
             250                     !c  ice2 = 3    for 0 ice --- no ice, warm only
             251                     
             252                     !  if (ice2 .eq. 2) ihail = 0
             253                     
             254                     !  i24h=nint(86400./dt_in)
             255                     !  if (mod(itimestep,i24h).eq.1) then
             256                     !     write(6,*) 'ihail=',ihail,'  ice2=',ice2
             257                     !     if (ice2.eq.0) then
             258                     !        write(6,*) 'Running 3-ice scheme in GSFCGCE with'
             259                     !        if (ihail.eq.0) then

            3298                     ! Calculate cloud droplet effective radius
            3299                        real function eff_rad(lambda)
            3300                     
            3301                     !#ifndef NO_IEEE_MODULE
            3302                     !      use, intrinsic :: ieee_arithmetic
            3303                     !#endif
            3304                           implicit none
            3305                     
            3306                     !---------------------------------------------------------------------------------------------------
            3307                     ! Comments:
            3308                     ! Compute drop effective radius from slope parameters (lambda) of expoential size distribution.
            3309                     !
            3310                     ! History:
            3311                     ! 02/2014  Toshi Matsui@NASA GSFC ; Initial
            3312                     !
            3313                     ! References:
            3314                     !----------------------------------------------------------------------------------------------------
            3315                           real,intent(in)  :: lambda   ! intercept parameter [1/cm]
            3316                     
            3317                     !
            3318                     ! for no particles.
            3319                     !
            3320                     !#ifndef NO_IEEE_MODULE
            3321                     !       if ( lambda <= 0.e0  .or. ieee_is_nan(lambda) ) then
            3322                     !#else
            3323     1                      if ( lambda <= 0.e0                           ) then
            3324     1               !#endif
            3325     1                         eff_rad = 0.e0
            3326     1                         return
            3327     1                      endif
            3328                     
            3329                     !
            3330                     ! compute drop effective radius for exponential distribution N(D) = N0*exp(-lam*D)
            3331                     !
            3332                            eff_rad = 1.5e0 / (lambda*100.) * 1.0e+6  ! [micron]
            3333                     
            3334                        end function eff_rad
            3335                     !+---+-----------------------------------------------------------------+
            3336                     #endif

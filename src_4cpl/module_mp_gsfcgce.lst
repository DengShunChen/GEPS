            1862     4   s    s                       PRAUT(I,J)=MIN(Y1(I,J), PRAUT(I,J))
            1863     4   s    s                       PRACW(I,J)=MIN(Y1(I,J), PRACW(I,J))
            1864     4   s    s                       Y1(I,J)=(PRAUT(I,J)+PRACW(I,J))*D2T
            1865     4               
            1866     5   s    s                     if (qc(i,j) .lt. y1(i,j) .and. y1(i,j) .ge. cmin2) then
            1867     5   s    s                         y2(i,j)=qc(i,j)/(y1(i,j)+cmin2)
            1868     5   s    s                         praut(i,j)=praut(i,j)*y2(i,j)
            1869     5   s    s                         pracw(i,j)=pracw(i,j)*y2(i,j)
            1870     5   m    s                         qc(i,j)=0.0
            1871     5   s    s                     else
            1872     5   m    s                        qc(i,j)=qc(i,j)-y1(i,j)
            1873     5   p    s                     endif
            1874     4               
            1875     4   s    s                     PR(I,J)=(PRAUT(I,J)+PRACW(I,J))*D2T
            1876     4   s    s                     QR(I,J)=QR(I,J)+PR(I,J)
            1877     4               
            1878     4               !*****   TAO ET AL (1989) SATURATION TECHNIQUE  ***********************
            1879     4               
            1880     4   p    s                 cnd(i,j)=0.0
            1881     4   p    s                 tair(i,j)=(pt(i,j)+tb0)*pi0
            1882     4   s    s                    y1(i,j)=1./(tair(i,j)-c358)
            1883     4   s    s                    qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            1884     4   s    s                    dd(i,j)=cp409*y1(i,j)*y1(i,j)
            1885     4   s    s                    dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            1886     4   s    s                    cnd(i,j)=dm(i,j)/(1.+avcp*dd(i,j)*qsw(i,j))
            1887     4               !c    ******   condensation or evaporation of qc  ******
            1888     4   s    s                    cnd(i,j)=max(-qc(i,j), cnd(i,j))
            1889     4   s    s                               pt(i,j)=pt(i,j)+avcp*cnd(i,j)
            1890     4   s    s                   qv(i,j)=qv(i,j)-cnd(i,j)
            1891     4   s    s                               qc(i,j)=qc(i,j)+cnd(i,j)
            1892     4               
            1893     4               !C     ******   EVAPORATION   ******
            1894     4               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            1895     4   p    s                  ern(i,j)=0.0
            1896     4               
            1897     5   s    s                  if(qr(i,j).gt.0.0) then
            1898     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            1899     5   s    s                     rtair(i,j)=1./(tair(i,j)-c358)
            1900     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*rtair(i,j))
            1901     5   s    s                     ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.0
            1902     5   s    s                     dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            1903     5   s    s                     rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            1904     5   s    s                     dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)), 0.0)
            1905     5   s    s                     y1(i,j)=.78/zr(i,j)**2+r23af*scv(i,j)/zr(i,j)**bwh5
            1906     5   s    s                     y2(i,j)=r23br/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            1907     5                                      *qsw(i,j))
            1908     5               !cccc
            1909     5   s    s                     ern(i,j)=r23t*ssw(i,j)*y1(i,j)/y2(i,j)
            1910     5   s    s                     ern(i,j)=min(dd1(i,j),qr(i,j),max(ern(i,j),0.))
            1911     5   p    s                     pt(i,j)=pt(i,j)-avcp*ern(i,j)
            1912     5   p    s                     qv(i,j)=qv(i,j)+ern(i,j)
            1913     5   s    s                     qr(i,j)=qr(i,j)-ern(i,j)
            1914     5   p    s                  endif
            1915     4               
            1916     4   p    s             ELSE       ! part of if (iwarm.eq.1) then
            1917     4               !JJS 10/7/2008     ^^^^^
            1918     4               
            1919     4               !JJS   for calculating processes related to both ice and warm rain
            1920     4               
            1921     4               !     ***   COMPUTE ZR,ZS,ZG,VR,VS,VG      *****************************
            1922     4               
            1923     5   p    s                  if (qr(i,j) .gt. cmin1) then
            1924     5   p    s                     dd(i,j)=r00*qr(i,j)
            1925     5   p    s                     y1(i,j)=dd(i,j)**.25
            1926     5   s    s                     zr(i,j)=zrc/y1(i,j)
            1927     5   s    s                     vr(i,j)=max(vrcf*dd(i,j)**bwq, 0.)
            1928     5   p    s                  endif
            1929     4               
            1930     5   p    s                  if (qs(i,j) .gt. cmin1) then
            1931     5   p    s                     dd(i,j)=r00*qs(i,j)
            1932     5   p    s                     y1(i,j)=dd(i,j)**.25
            1933     5   s    s                     zs(i,j)=zsc/y1(i,j)
            1934     5   s    s                     vs(i,j)=max(vscf*dd(i,j)**bsq, 0.)
            1935     5   p    s                  endif
            1936     4               
            1937     5   p    s                  if (qg(i,j) .gt. cmin1) then
            1938     5   p    s                     dd(i,j)=r00*qg(i,j)
            1939     5   p    s                     y1(i,j)=dd(i,j)**.25
            1940     5   s    s                     zg(i,j)=zgc/y1(i,j)
            1941     6   p    s                     if(ihail .eq. 1) then
            1942     6   m    m                        vg(i,j)=max(vgcr*dd(i,j)**bgq, 0.)
            1943     6   p    s                     else
            1944     6   m    s                        vg(i,j)=max(vgcf*dd(i,j)**bgq, 0.)
            1945     6   p    s                     endif
            1946     5   p    s                  endif
            1947     4               
            1948     4   p    s                  if (qr(i,j) .le. cmin2) vr(i,j)=0.0
            1949     4   p    s                  if (qs(i,j) .le. cmin2) vs(i,j)=0.0
            1950     4   p    s                  if (qg(i,j) .le. cmin2) vg(i,j)=0.0
            1951     4               
            1952     4               !     ******************************************************************
            1953     4               !     ***   Y1 : DYNAMIC VISCOSITY OF AIR (U)
            1954     4               !     ***   DWV : DIFFUSIVITY OF WATER VAPOR IN AIR (PI)
            1955     4               !     ***   TCA : THERMAL CONDUCTIVITY OF AIR (KA)
            1956     4               !     ***   Y2 : KINETIC VISCOSITY (V)
            1957     4               
            1958     4   m    s                  y1(i,j)=c149*tair(i,j)**1.5/(tair(i,j)+120.)
            1959     4   m    s                  dwv(i,j)=dwvp*tair(i,j)**1.81
            1960     4   s    s                  tca(i,j)=c141*y1(i,j)
            1961     4   s    s                  scv(i,j)=1./((rr0*y1(i,j))**.1666667*dwv(i,j)**.3333333)
            1962     4               !JJS  100    CONTINUE
            1963     4               
            1964     4               !*  1 * PSAUT : AUTOCONVERSION OF QI TO QS                        ***1**
            1965     4               !*  3 * PSACI : ACCRETION OF QI TO QS                             ***3**
            1966     4               !*  4 * PSACW : ACCRETION OF QC BY QS (RIMING) (QSACW FOR PSMLT)  ***4**
            1967     4               !*  5 * PRACI : ACCRETION OF QI BY QR                             ***5**
            1968     4               !*  6 * PIACR : ACCRETION OF QR OR QG BY QI                       ***6**
            1969     4               
            1970     4               !JJS         DO 125 J=3,JLES
            1971     4               !JJS         DO 125 I=3,ILES
            1972     4   p    s                  psaut(i,j)=0.0
            1973     4   p    s                  psaci(i,j)=0.0
            1974     4   p    s                  praci(i,j)=0.0
            1975     4   p    s                  piacr(i,j)=0.0
            1976     4   p    s                  psacw(i,j)=0.0
            1977     4   p    s                  qsacw(i,j)=0.0
            1978     4   s    s                  dd(i,j)=1./zs(i,j)**bs3
            1979     4               
            1980     5   m    s                  if (tair(i,j).lt.t0) then
            1981     5   s    s                     esi(i,j)=exp(.025*tairc(i,j))
            1982     5   s    s                     psaut(i,j)=r2is*max(rn1*esi(i,j)*(qi(i,j)-bnd1) ,0.0)
            1983     5   s    s                     psaci(i,j)=r2is*r3f*esi(i,j)*qi(i,j)*dd(i,j)
            1984     5               !JJS 3/30/06
            1985     5               !    to cut water to snow accretion by half
            1986     5               !               PSACW(I,J)=R4F*QC(I,J)*DD(I,J)
            1987     5   s    s                     psacw(i,j)=r2is*0.5*r4f*qc(i,j)*dd(i,j)
            1988     5               !JJS 3/30/06
            1989     5   s    s                     praci(i,j)=r2is*r5f*qi(i,j)/zr(i,j)**bw3
            1990     5   m    m                     piacr(i,j)=r2is*r6f*qi(i,j)*(zr(i,j)**(-bw6))
            1991     5               !JJS               PIACR(I,J)=R6F*QI(I,J)/ZR(I,J)**BW6
            1992     5   s    s                  else
            1993     5   m    s                     qsacw(i,j)=r2is*r4f*qc(i,j)*dd(i,j)
            1994     5   p    s                  endif
            1995     4               
            1996     4               !* 21 * PRAUT   AUTOCONVERSION OF QC TO QR                        **21**
            1997     4               !* 22 * PRACW : ACCRETION OF QC BY QR                             **22**
            1998     4               
            1999     4   m    s                  pracw(i,j)=r22f*qc(i,j)/zr(i,j)**bw3
            2000     4   p    s                  praut(i,j)=0.0
            2001     4   s    s                  y1(i,j)=qc(i,j)-bnd3
            2002     5   s    s                  if (y1(i,j).gt.0.0) then
            2003     5   s    s                     praut(i,j)=r00*y1(i,j)*y1(i,j)/(1.2e-4+rn21/y1(i,j))
            2004     5   p    s                  endif
            2005     4               
            2006     4               !* 12 * PSFW : BERGERON PROCESSES FOR QS (KOENING, 1971)          **12**
            2007     4               !* 13 * PSFI : BERGERON PROCESSES FOR QS                          **13**
            2008     4               
            2009     4   p    s                  psfw(i,j)=0.0
            2010     4   p    s                  psfi(i,j)=0.0
            2011     4   p    s                  pidep(i,j)=0.0
            2012     4               
            2013     5   s    s                  if(tair(i,j).lt.t0.and.qi(i,j).gt.cmin) then
            2014     5   s    s                     y1(i,j)=max( min(tairc(i,j), -1.), -31.)
            2015     5   s    s                     it(i,j)=int(abs(y1(i,j)))
            2016     5   s    s                     y1(i,j)=rn12a(it(i,j))
            2017     5   s    s                     y2(i,j)=rn12b(it(i,j))
            2018     5               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2019     5   s    s                psfw(i,j)=r2is* &
            2020     5                                   max(d2t*y1(i,j)*(y2(i,j)+r12r*qc(i,j))*qi(i,j),0.0)
            2021     5   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2022     5   s    s                     y2(i,j)=exp(c218-c580*rtair(i,j))
            2023     5   s    s                     qsi(i,j)=rp0*y2(i,j)
            2024     5   s    s                     esi(i,j)=c610*y2(i,j)
            2025     5   s    s                     ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2026     5   s    s                     r_nci=min(1.e-6*exp(-.46*tairc(i,j)),1.)
            2027     5               !              R_NCI=min(1.e-8*EXP(-.6*TAIRC(I,J)),1.) ! use Tao's
            2028     5   s    s                     dm(i,j)=max( (qv(i,j)+qb0-qsi(i,j)), 0.)
            2029     5   s    s                     rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2030     5   s    s                     y3(i,j)=1./tair(i,j)
            2031     5   s    s                dd(i,j)=y3(i,j)*(rn30a*y3(i,j)-rn30b)+rn30c*tair(i,j)/esi(i,j)
            2032     5   s    s                     y1(i,j)=206.18*ssi(i,j)/dd(i,j)
            2033     5   s    s                     pidep(i,j)=y1(i,j)*sqrt(r_nci*qi(i,j)/r00)
            2034     5   s    s                     dep(i,j)=dm(i,j)/(1.+rsub1(i,j))/d2t
            2035     6   m    s                     if(dm(i,j).gt.cmin2) then
            2036     6   s    s                        a2=1.
            2037     7   s    s                      if(pidep(i,j).gt.dep(i,j).and.pidep(i,j).gt.cmin2) then
            2038     7   s    s                           a2=dep(i,j)/pidep(i,j)
            2039     7   s    s                           pidep(i,j)=dep(i,j)
            2040     7   s    s                      endif
            2041     6   m    m                        psfi(i,j)=r2is*a2*.5*qi(i,j)*y1(i,j)/(sqrt(ami100) &
            2042     6                                         -sqrt(ami40))
            2043     6   m    s                        elseif(dm(i,j).lt.-cmin2) then
            2044     6               !
            2045     6               !        SUBLIMATION TERMS USED ONLY WHEN SATURATION ADJUSTMENT FOR ICE
            2046     6               !        IS TURNED OFF
            2047     6               !
            2048     6   s    s                        pidep(i,j)=0.
            2049     6   m    s                        psfi(i,j)=0.
            2050     6   s    s                     else
            2051     6   s    s                        pidep(i,j)=0.
            2052     6   m    s                        psfi(i,j)=0.
            2053     6   p    s                     endif
            2054     5   p    s                  endif
            2055     4               
            2056     4               !TTT***** QG=QG+MIN(PGDRY,PGWET)
            2057     4               !*  9 * PGACS : ACCRETION OF QS BY QG (DGACS,WGACS: DRY AND WET)  ***9**
            2058     4               !* 14 * DGACW : ACCRETION OF QC BY QG (QGACW FOR PGMLT)           **14**
            2059     4               !* 16 * DGACR : ACCRETION OF QR TO QG (QGACR FOR PGMLT)           **16**
            2060     4               
            2061     5   p    s                  if(qc(i,j)+qr(i,j).lt.1.e-4) then
            2062     5   p    m                     ee1=.01
            2063     5   p    s                    else
            2064     5   p    s                       ee1=1.
            2065     5   p    s                    endif
            2066     4   s    s                  ee2=0.09
            2067     4   s    s                  egs(i,j)=ee1*exp(ee2*tairc(i,j))
            2068     4               !            EGS(I,J)=0.1 ! 6/15/02 tao's
            2069     4   s    s                  if (tair(i,j).ge.t0) egs(i,j)=1.0
            2070     4   m    s                  y1(i,j)=abs(vg(i,j)-vs(i,j))
            2071     4   s    s                  y2(i,j)=zs(i,j)*zg(i,j)
            2072     4   s    s                  y3(i,j)=5./y2(i,j)
            2073     4   s    s                  y4(i,j)=.08*y3(i,j)*y3(i,j)
            2074     4   s    s                  y5(i,j)=.05*y3(i,j)*y4(i,j)
            2075     4   s    s                  dd(i,j)=y1(i,j)*(y3(i,j)/zs(i,j)**5+y4(i,j)/zs(i,j)**3 &
            2076     4                                   +y5(i,j)/zs(i,j))
            2077     4   s    s                  pgacs(i,j)=r2ig*r2is*r9r*egs(i,j)*dd(i,j)
            2078     4               !JJS 1/3/06 from Steve and Chunglin
            2079     5   p    s                  if (ihail.eq.1) then
            2080     5   m    m                     dgacs(i,j)=pgacs(i,j)
            2081     5   p    s                  else
            2082     5   p    s                     dgacs(i,j)=0.
            2083     5   p    s                  endif
            2084     4               !JJS 1/3/06 from Steve and Chunglin
            2085     4   s    s                  wgacs(i,j)=r2ig*r2is*r9r*dd(i,j)
            2086     4               !            WGACS(I,J)=0.  ! 6/15/02 tao's
            2087     4   s    s                  y1(i,j)=1./zg(i,j)**bg3
            2088     4               
            2089     5   p    s                  if(ihail .eq. 1) then
            2090     5   m    m                     dgacw(i,j)=r2ig*max(r14r*qc(i,j)*y1(i,j), 0.0)
            2091     5   p    s                  else
            2092     5   m    s                     dgacw(i,j)=r2ig*max(r14f*qc(i,j)*y1(i,j), 0.0)
            2093     5   p    s                  endif
            2094     4               
            2095     4   s    s                  qgacw(i,j)=dgacw(i,j)
            2096     4   s    s                  y1(i,j)=abs(vg(i,j)-vr(i,j))
            2097     4   s    s                  y2(i,j)=zr(i,j)*zg(i,j)
            2098     4   s    s                  y3(i,j)=5./y2(i,j)
            2099     4   s    s                  y4(i,j)=.08*y3(i,j)*y3(i,j)
            2100     4   s    s                  y5(i,j)=.05*y3(i,j)*y4(i,j)
            2101     4   s    s                  dd(i,j)=r16r*y1(i,j)*(y3(i,j)/zr(i,j)**5+y4(i,j)/zr(i,j)**3 &
            2102     4                                   +y5(i,j)/zr(i,j))
            2103     4   s    s                  dgacr(i,j)=r2ig*max(dd(i,j), 0.0)
            2104     4   s    s                  qgacr(i,j)=dgacr(i,j)
            2105     4               
            2106     5   m    s                  if (tair(i,j).ge.t0) then
            2107     5   s    s                     dgacs(i,j)=0.0
            2108     5   s    s                     wgacs(i,j)=0.0
            2109     5   s    s                     dgacw(i,j)=0.0
            2110     5   m    m                     dgacr(i,j)=0.0
            2111     5   s    s                  else
            2112     5   s    s                     pgacs(i,j)=0.0
            2113     5   s    s                     qgacw(i,j)=0.0
            2114     5   m    s                     qgacr(i,j)=0.0
            2115     5   p    s                  endif
            2116     4               
            2117     4               !*******PGDRY : DGACW+DGACI+DGACR+DGACS                           ******
            2118     4               !* 15 * DGACI : ACCRETION OF QI BY QG (WGACI FOR WET GROWTH)      **15**
            2119     4               !* 17 * PGWET : WET GROWTH OF QG                                  **17**
            2120     4               
            2121     4   p    s                  dgaci(i,j)=0.0
            2122     4   p    s                  wgaci(i,j)=0.0
            2123     4   p    s                  pgwet(i,j)=0.0
            2124     4               
            2125     5   s    s                  if (tair(i,j).lt.t0) then
            2126     5   s    s                     y1(i,j)=qi(i,j)/zg(i,j)**bg3
            2127     6   m    s                     if (ihail.eq.1) then
            2128     6   s    s                        dgaci(i,j)=r2ig*r15r*y1(i,j)
            2129     6   m    m                        wgaci(i,j)=r2ig*r15ar*y1(i,j)
            2130     6               !                  WGACI(I,J)=0.  ! 6/15/02 tao's
            2131     6   s    s                     else
            2132     6               
            2133     6               !JJS                  DGACI(I,J)=r2ig*R15F*Y1(I,J)
            2134     6   s    s                         dgaci(i,j)=0.
            2135     6   m    s                        wgaci(i,j)=r2ig*r15af*y1(i,j)
            2136     6               !                  WGACI(I,J)=0.  ! 6/15/02 tao's
            2137     6   s    s                     endif
            2138     5               !
            2139     6   s    s                     if (tairc(i,j).ge.-50.) then
            2140     7   s    s                      if (alf+rn17c*tairc(i,j) .eq. 0.) then
            2141     7   s    s                         write(91,*) itimestep, i,j,k, alf, rn17c, tairc(i,j)
            2142     7   s    s                      endif
            2143     6   s    s                      y1(i,j)=1./(alf+rn17c*tairc(i,j))
            2144     7   m    s                      if (ihail.eq.1) then
            2145     7   m    m                         y3(i,j)=.78/zg(i,j)**2+r17aq*scv(i,j)/zg(i,j)**bgh5
            2146     7   s    s                      else
            2147     7   m    s                         y3(i,j)=.78/zg(i,j)**2+r17as*scv(i,j)/zg(i,j)**bgh5
            2148     7   s    s                      endif
            2149     6   s    s                      y4(i,j)=alvr*dwv(i,j)*(rp0-(qv(i,j)+qb0)) &
            2150     6                                       -tca(i,j)*tairc(i,j)
            2151     6   s    s                      dd(i,j)=y1(i,j)*(r17r*y4(i,j)*y3(i,j) &
            2152     6                                      +(wgaci(i,j)+wgacs(i,j))*(alf+rn17b*tairc(i,j)))
            2153     6   s    s                      pgwet(i,j)=r2ig*max(dd(i,j), 0.0)
            2154     6   p    s                     endif
            2155     5   p    s                  endif
            2156     4               !JJS  125    CONTINUE
            2157     4               
            2158     4               !********   HANDLING THE NEGATIVE CLOUD WATER (QC)    ******************
            2159     4               !********   HANDLING THE NEGATIVE CLOUD ICE (QI)      ******************
            2160     4               
            2161     4               !JJS         DO 150 J=3,JLES
            2162     4               !JJS         DO 150 I=3,ILES
            2163     4               
            2164     4   p    s                  y1(i,j)=qc(i,j)/d2t
            2165     4   s    s                  psacw(i,j)=min(y1(i,j), psacw(i,j))
            2166     4   s    s                  praut(i,j)=min(y1(i,j), praut(i,j))
            2167     4   s    s                  pracw(i,j)=min(y1(i,j), pracw(i,j))
            2168     4   s    s                  psfw(i,j)= min(y1(i,j), psfw(i,j))
            2169     4   s    s                  dgacw(i,j)=min(y1(i,j), dgacw(i,j))
            2170     4   s    s                  qsacw(i,j)=min(y1(i,j), qsacw(i,j))
            2171     4   s    s                  qgacw(i,j)=min(y1(i,j), qgacw(i,j))
            2172     4               
            2173     4   s    s                  y1(i,j)=(psacw(i,j)+praut(i,j)+pracw(i,j)+psfw(i,j) &
            2174     4                                   +dgacw(i,j)+qsacw(i,j)+qgacw(i,j))*d2t
            2175     4   s    s                  qc(i,j)=qc(i,j)-y1(i,j)
            2176     4               
            2177     5   s    s                  if (qc(i,j) .lt. 0.0) then
            2178     5   s    s                     a1=1.
            2179     5   s    s                     if (y1(i,j) .ne. 0.0) a1=qc(i,j)/y1(i,j)+1.
            2180     5   s    s                     psacw(i,j)=psacw(i,j)*a1
            2181     5   s    s                     praut(i,j)=praut(i,j)*a1
            2182     5   s    s                     pracw(i,j)=pracw(i,j)*a1
            2183     5   s    s                     psfw(i,j)=psfw(i,j)*a1
            2184     5   s    s                     dgacw(i,j)=dgacw(i,j)*a1
            2185     5   s    s                     qsacw(i,j)=qsacw(i,j)*a1
            2186     5   s    s                     qgacw(i,j)=qgacw(i,j)*a1
            2187     5   s    s                     qc(i,j)=0.0
            2188     5   p    s                  endif
            2189     4               !c
            2190     4               !
            2191     4               !******** SHED PROCESS (WGACR=PGWET-DGACW-WGACI-WGACS)
            2192     4               !c
            2193     4   s    s                  wgacr(i,j)=pgwet(i,j)-dgacw(i,j)-wgaci(i,j)-wgacs(i,j)
            2194     4   s    s                  y2(i,j)=dgacw(i,j)+dgaci(i,j)+dgacr(i,j)+dgacs(i,j)
            2195     5   m    s                  if (pgwet(i,j).ge.y2(i,j)) then
            2196     5   s    s                     wgacr(i,j)=0.0
            2197     5   s    s                     wgaci(i,j)=0.0
            2198     5   m    m                     wgacs(i,j)=0.0
            2199     5   s    s                  else
            2200     5   s    s                     dgacr(i,j)=0.0
            2201     5   s    s                     dgaci(i,j)=0.0
            2202     5   m    s                     dgacs(i,j)=0.0
            2203     5   p    s                  endif
            2204     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2205     4               !c
            2206     4   m    s                  y1(i,j)=qi(i,j)/d2t
            2207     4   s    s                  psaut(i,j)=min(y1(i,j), psaut(i,j))
            2208     4   s    s                  psaci(i,j)=min(y1(i,j), psaci(i,j))
            2209     4   s    s                  praci(i,j)=min(y1(i,j), praci(i,j))
            2210     4   s    s                  psfi(i,j)= min(y1(i,j), psfi(i,j))
            2211     4   s    s                  dgaci(i,j)=min(y1(i,j), dgaci(i,j))
            2212     4   s    s                  wgaci(i,j)=min(y1(i,j), wgaci(i,j))
            2213     4               !
            2214     4   s    s                  y2(i,j)=(psaut(i,j)+psaci(i,j)+praci(i,j)+psfi(i,j) &
            2215     4                                  +dgaci(i,j)+wgaci(i,j))*d2t
            2216     4   s    s                  qi(i,j)=qi(i,j)-y2(i,j)+pidep(i,j)*d2t
            2217     4               
            2218     5   s    s                  if (qi(i,j).lt.0.0) then
            2219     5   s    s                     a2=1.
            2220     5   s    s                     if (y2(i,j) .ne. 0.0) a2=qi(i,j)/y2(i,j)+1.
            2221     5   s    s                     psaut(i,j)=psaut(i,j)*a2
            2222     5   s    s                     psaci(i,j)=psaci(i,j)*a2
            2223     5   s    s                     praci(i,j)=praci(i,j)*a2
            2224     5   s    s                     psfi(i,j)=psfi(i,j)*a2
            2225     5   s    s                     dgaci(i,j)=dgaci(i,j)*a2
            2226     5   s    s                     wgaci(i,j)=wgaci(i,j)*a2
            2227     5   s    s                     qi(i,j)=0.0
            2228     5   p    s                  endif
            2229     4               !
            2230     4   p    s                  dlt3(i,j)=0.0
            2231     4   p    s                  dlt2(i,j)=0.0
            2232     4               !
            2233     4               
            2234     4               !            DLT4(I,J)=1.0
            2235     4               !            if(qc(i,j) .gt. 5.e-4) dlt4(i,j)=0.0
            2236     4               !            if(qs(i,j) .le. 1.e-4) dlt4(i,j)=1.0
            2237     4               !
            2238     4               !            IF (TAIR(I,J).ge.T0) THEN
            2239     4               !               DLT4(I,J)=0.0
            2240     4               !            ENDIF
            2241     4               
            2242     5   s    s                  if (tair(i,j).lt.t0) then
            2243     6   s    s                     if (qr(i,j).lt.1.e-4) then
            2244     6   s    s                        dlt3(i,j)=1.0
            2245     6   s    s                        dlt2(i,j)=1.0
            2246     6   s    s                     endif
            2247     6   s    s                     if (qs(i,j).ge.1.e-4) then
            2248     6   s    s                        dlt2(i,j)=0.0
            2249     6   p    s                     endif
            2250     5   p    s                  endif
            2251     4               
            2252     5   p    s                  if (ice2 .eq. 1) then
            2253     5   s    s                        dlt3(i,j)=1.0
            2254     5   s    s                        dlt2(i,j)=1.0
            2255     5   p    s                  endif
            2256     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2257     4   m    s                  pr(i,j)=(qsacw(i,j)+praut(i,j)+pracw(i,j)+qgacw(i,j))*d2t
            2258     4   s    s                  ps(i,j)=(psaut(i,j)+psaci(i,j)+psacw(i,j)+psfw(i,j) &
            2259     4                                   +psfi(i,j)+dlt3(i,j)*praci(i,j))*d2t
            2260     4               !           PS(I,J)=(PSAUT(I,J)+PSACI(I,J)+dlt4(i,j)*PSACW(I,J)
            2261     4               !    1              +PSFW(I,J)+PSFI(I,J)+DLT3(I,J)*PRACI(I,J))*D2T
            2262     4   s    s                  pg(i,j)=((1.-dlt3(i,j))*praci(i,j)+dgaci(i,j)+wgaci(i,j) &
            2263     4                                   +dgacw(i,j))*d2t
            2264     4               !           PG(I,J)=((1.-DLT3(I,J))*PRACI(I,J)+DGACI(I,J)+WGACI(I,J)
            2265     4               !    1              +DGACW(I,J)+(1.-dlt4(i,j))*PSACW(I,J))*D2T
            2266     4               
            2267     4               !JJS  150    CONTINUE
            2268     4               
            2269     4               !*  7 * PRACS : ACCRETION OF QS BY QR                             ***7**
            2270     4               !*  8 * PSACR : ACCRETION OF QR BY QS (QSACR FOR PSMLT)           ***8**
            2271     4               
            2272     4               !JJS         DO 175 J=3,JLES
            2273     4               !JJS         DO 175 I=3,ILES
            2274     4               
            2275     4   s    s                  y1(i,j)=abs(vr(i,j)-vs(i,j))
            2276     4   s    s                  y2(i,j)=zr(i,j)*zs(i,j)
            2277     4   s    s                  y3(i,j)=5./y2(i,j)
            2278     4   s    s                  y4(i,j)=.08*y3(i,j)*y3(i,j)
            2279     4   s    s                  y5(i,j)=.05*y3(i,j)*y4(i,j)
            2280     4   s    s                  pracs(i,j)=r2ig*r2is*r7r*y1(i,j)*(y3(i,j)/zs(i,j)**5 &
            2281     4                                     +y4(i,j)/zs(i,j)**3+y5(i,j)/zs(i,j))
            2282     4   s    s                  psacr(i,j)=r2is*r8r*y1(i,j)*(y3(i,j)/zr(i,j)**5 &
            2283     4                                     +y4(i,j)/zr(i,j)**3+y5(i,j)/zr(i,j))
            2284     4   s    s                  qsacr(i,j)=psacr(i,j)
            2285     4               
            2286     5   m    s                  if (tair(i,j).ge.t0) then
            2287     5   s    s                     pracs(i,j)=0.0
            2288     5   m    m                     psacr(i,j)=0.0
            2289     5   s    s                  else
            2290     5   m    s                     qsacr(i,j)=0.0
            2291     5   p    s                  endif
            2292     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2293     4               !*  2 * PGAUT : AUTOCONVERSION OF QS TO QG                        ***2**
            2294     4               !* 18 * PGFR : FREEZING OF QR TO QG                               **18**
            2295     4               
            2296     4   p    s                  pgaut(i,j)=0.0
            2297     4   p    s                  pgfr(i,j)=0.0
            2298     4               
            2299     5   s    s                  if (tair(i,j) .lt. t0) then
            2300     5               !               Y1(I,J)=EXP(.09*TAIRC(I,J))
            2301     5               !               PGAUT(I,J)=r2is*max(RN2*Y1(I,J)*(QS(I,J)-BND2), 0.0)
            2302     5               !         IF(IHAIL.EQ.1) PGAUT(I,J)=max(RN2*Y1(I,J)*(QS(I,J)-BND2),0.0)
            2303     5   s    s                     y2(i,j)=exp(rn18a*(t0-tair(i,j)))
            2304     5               !JJS              PGFR(I,J)=r2ig*max(R18R*(Y2(I,J)-1.)/ZR(I,J)**7., 0.0)
            2305     5               !              pgfr(i,j)=r2ice*max(r18r*(y2(i,j)-1.)* &
            2306     5               !                                    (zr(i,j)**(-7.)), 0.0)
            2307     5               !        modify to prevent underflow on some computers (JD)
            2308     5   s    s                     temp = 1./zr(i,j)
            2309     5   s    s                     temp = temp*temp*temp*temp*temp*temp*temp
            2310     5   s    s                     pgfr(i,j)=r2ig*max(r18r*(y2(i,j)-1.)* &
            2311     5                                                   temp, 0.0)
            2312     5   p    s                  endif
            2313     4               
            2314     4               !JJS  175    CONTINUE
            2315     4               
            2316     4               !********   HANDLING THE NEGATIVE RAIN WATER (QR)    *******************
            2317     4               !********   HANDLING THE NEGATIVE SNOW (QS)          *******************
            2318     4               
            2319     4               !JJS         DO 200 J=3,JLES
            2320     4               !JJS         DO 200 I=3,ILES
            2321     4               
            2322     4   m    s                  y1(i,j)=qr(i,j)/d2t
            2323     4   m    s                  y2(i,j)=-qg(i,j)/d2t
            2324     4   s    s                  piacr(i,j)=min(y1(i,j), piacr(i,j))
            2325     4   s    s                  dgacr(i,j)=min(y1(i,j), dgacr(i,j))
            2326     4   s    s                  wgacr(i,j)=min(y1(i,j), wgacr(i,j))
            2327     4   s    s                  wgacr(i,j)=max(y2(i,j), wgacr(i,j))
            2328     4   s    s                  psacr(i,j)=min(y1(i,j), psacr(i,j))
            2329     4   s    s                  pgfr(i,j)= min(y1(i,j), pgfr(i,j))
            2330     4   p    s                  del=0.
            2331     4   s    s                  if(wgacr(i,j) .lt. 0.) del=1.
            2332     4   m    s                  y1(i,j)=(piacr(i,j)+dgacr(i,j)+(1.-del)*wgacr(i,j) &
            2333     4                                   +psacr(i,j)+pgfr(i,j))*d2t
            2334     4   s    s                  qr(i,j)=qr(i,j)+pr(i,j)-y1(i,j)-del*wgacr(i,j)*d2t
            2335     5   s    s                  if (qr(i,j) .lt. 0.0) then
            2336     5   s    s                     a1=1.
            2337     5   s    s                     if(y1(i,j) .ne. 0.) a1=qr(i,j)/y1(i,j)+1.
            2338     5   s    s                     piacr(i,j)=piacr(i,j)*a1
            2339     5   s    s                     dgacr(i,j)=dgacr(i,j)*a1
            2340     5   s    s                     if (wgacr(i,j).gt.0.) wgacr(i,j)=wgacr(i,j)*a1
            2341     5   s    s                     pgfr(i,j)=pgfr(i,j)*a1
            2342     5   s    s                     psacr(i,j)=psacr(i,j)*a1
            2343     5   s    s                     qr(i,j)=0.0
            2344     5   p    s                  endif
            2345     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2346     4   s    s                  prn(i,j)=d2t*((1.-dlt3(i,j))*piacr(i,j)+dgacr(i,j) &
            2347     4                                    +wgacr(i,j)+(1.-dlt2(i,j))*psacr(i,j)+pgfr(i,j))
            2348     4   s    s                  ps(i,j)=ps(i,j)+d2t*(dlt3(i,j)*piacr(i,j) &
            2349     4                                   +dlt2(i,j)*psacr(i,j))
            2350     4   s    s                  pracs(i,j)=(1.-dlt2(i,j))*pracs(i,j)
            2351     4   m    s                  y1(i,j)=qs(i,j)/d2t
            2352     4   s    s                  pgacs(i,j)=min(y1(i,j), pgacs(i,j))
            2353     4   s    s                  dgacs(i,j)=min(y1(i,j), dgacs(i,j))
            2354     4   s    s                  wgacs(i,j)=min(y1(i,j), wgacs(i,j))
            2355     4   p    s                  pgaut(i,j)=min(y1(i,j), pgaut(i,j))
            2356     4   s    s                  pracs(i,j)=min(y1(i,j), pracs(i,j))
            2357     4   s    s                  psn(i,j)=d2t*(pgacs(i,j)+dgacs(i,j)+wgacs(i,j) &
            2358     4                                    +pgaut(i,j)+pracs(i,j))
            2359     4   s    s                  qs(i,j)=qs(i,j)+ps(i,j)-psn(i,j)
            2360     4               
            2361     5   s    s                  if (qs(i,j).lt.0.0) then
            2362     5   s    s                     a2=1.
            2363     5   s    s                     if (psn(i,j) .ne. 0.0) a2=qs(i,j)/psn(i,j)+1.
            2364     5   m    s                     pgacs(i,j)=pgacs(i,j)*a2
            2365     5   p    s                     dgacs(i,j)=dgacs(i,j)*a2
            2366     5   p    s                     wgacs(i,j)=wgacs(i,j)*a2
            2367     5   p    s                     pgaut(i,j)=pgaut(i,j)*a2
            2368     5   p    s                     pracs(i,j)=pracs(i,j)*a2
            2369     5   s    s                     psn(i,j)=psn(i,j)*a2
            2370     5   s    s                     qs(i,j)=0.0
            2371     5   p    s                  endif
            2372     4               !
            2373     4               !C           PSN(I,J)=D2T*(PGACS(I,J)+DGACS(I,J)+WGACS(I,J)
            2374     4               !c                    +PGAUT(I,J)+PRACS(I,J))
            2375     4   s    s                  y2(i,j)=d2t*(psacw(i,j)+psfw(i,j)+dgacw(i,j)+piacr(i,j) &
            2376     4                                   +dgacr(i,j)+wgacr(i,j)+psacr(i,j)+pgfr(i,j))
            2377     4   s    s                  pt(i,j)=pt(i,j)+afcp*y2(i,j)
            2378     4   s    s                  qg(i,j)=qg(i,j)+pg(i,j)+prn(i,j)+psn(i,j)
            2379     4               
            2380     4               !JJS  200    CONTINUE
            2381     4               
            2382     4               !* 11 * PSMLT : MELTING OF QS                                     **11**
            2383     4               !* 19 * PGMLT : MELTING OF QG TO QR                               **19**
            2384     4               
            2385     4               !JJS         DO 225 J=3,JLES
            2386     4               !JJS         DO 225 I=3,ILES
            2387     4               
            2388     4   p    s                  psmlt(i,j)=0.0
            2389     4   p    s                  pgmlt(i,j)=0.0
            2390     4   s    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2391     4               
            2392     5   s    s                  if (tair(i,j).ge.t0) then
            2393     5   s    s                     tairc(i,j)=tair(i,j)-t0
            2394     5   s    s                     y1(i,j)=tca(i,j)*tairc(i,j)-alvr*dwv(i,j) &
            2395     5                                              *(rp0-(qv(i,j)+qb0))
            2396     5   s    s                     y2(i,j)=.78/zs(i,j)**2+r101f*scv(i,j)/zs(i,j)**bsh5
            2397     5   s    s                     dd(i,j)=r11rt*y1(i,j)*y2(i,j)+r11at*tairc(i,j) &
            2398     5                                      *(qsacw(i,j)+qsacr(i,j))
            2399     5   s    s                     psmlt(i,j)=r2is*max(0.0, min(dd(i,j), qs(i,j)))
            2400     5               
            2401     6   m    s                     if(ihail.eq.1) then
            2402     6   m    m                        y3(i,j)=.78/zg(i,j)**2+r19aq*scv(i,j)/zg(i,j)**bgh5
            2403     6   s    s                     else
            2404     6   m    s                        y3(i,j)=.78/zg(i,j)**2+r19as*scv(i,j)/zg(i,j)**bgh5
            2405     6   s    s                     endif
            2406     5               
            2407     5   s    s                     dd1(i,j)=r19rt*y1(i,j)*y3(i,j)+r19bt*tairc(i,j) &
            2408     5                                       *(qgacw(i,j)+qgacr(i,j))
            2409     5   s    s                     pgmlt(i,j)=r2ig*max(0.0, min(dd1(i,j), qg(i,j)))
            2410     5   s    s                     pt(i,j)=pt(i,j)-afcp*(psmlt(i,j)+pgmlt(i,j))
            2411     5   s    s                     qr(i,j)=qr(i,j)+psmlt(i,j)+pgmlt(i,j)
            2412     5   s    s                     qs(i,j)=qs(i,j)-psmlt(i,j)
            2413     5   s    s                     qg(i,j)=qg(i,j)-pgmlt(i,j)
            2414     5   p    s                  endif
            2415     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2416     4               !* 24 * PIHOM : HOMOGENEOUS FREEZING OF QC TO QI (T < T00)        **24**
            2417     4               !* 25 * PIDW : DEPOSITION GROWTH OF QC TO QI ( T0 < T <= T00)     **25**
            2418     4               !* 26 * PIMLT : MELTING OF QI TO QC (T >= T0)                     **26**
            2419     4               
            2420     4   s    s                  if (qc(i,j).le.cmin1) qc(i,j)=0.0
            2421     4   m    s                  if (qi(i,j).le.cmin1) qi(i,j)=0.0
            2422     4   m    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2423     4               
            2424     5   m    s                  if(tair(i,j).le.t00) then
            2425     5   m    m                     pihom(i,j)=qc(i,j)
            2426     5   s    s                  else
            2427     5   m    s                     pihom(i,j)=0.0
            2428     5   p    s                  endif
            2429     5   m    s                  if(tair(i,j).ge.t0) then
            2430     5   m    m                     pimlt(i,j)=qi(i,j)
            2431     5   s    s                  else
            2432     5   m    s                     pimlt(i,j)=0.0
            2433     5   p    s                  endif
            2434     4   p    s                  pidw(i,j)=0.0
            2435     4               
            2436     5   s    s                  if (tair(i,j).lt.t0 .and. tair(i,j).gt.t00) then
            2437     5   s    s                     tairc(i,j)=tair(i,j)-t0
            2438     5   s    s                     y1(i,j)=max( min(tairc(i,j), -1.), -31.)
            2439     5   m    s                     it(i,j)=int(abs(y1(i,j)))
            2440     5   s    s                     y2(i,j)=aa1(it(i,j))
            2441     5   s    s                     y3(i,j)=aa2(it(i,j))
            2442     5   s    s                     y4(i,j)=exp(abs(beta*tairc(i,j)))
            2443     5   s    s                     y5(i,j)=(r00*qi(i,j)/(r25a*y4(i,j)))**y3(i,j)
            2444     5   s    s                     pidw(i,j)=min(r25rt*y2(i,j)*y4(i,j)*y5(i,j), qc(i,j))
            2445     5   p    s                  endif
            2446     4               
            2447     4   s    s                  y1(i,j)=pihom(i,j)-pimlt(i,j)+pidw(i,j)
            2448     4   s    s                  pt(i,j)=pt(i,j)+afcp*y1(i,j)+ascp*(pidep(i,j))*d2t
            2449     4   s    s                  qv(i,j)=qv(i,j)-(pidep(i,j))*d2t
            2450     4   s    s                  qc(i,j)=qc(i,j)-y1(i,j)
            2451     4   s    s                  qi(i,j)=qi(i,j)+y1(i,j)
            2452     4               
            2453     4               !* 31 * PINT  : INITIATION OF QI                                  **31**
            2454     4               !* 32 * PIDEP : DEPOSITION OF QI                                  **32**
            2455     4               !
            2456     4               !     CALCULATION OF PINT USES DIFFERENT VALUES OF THE INTERCEPT AND SLOPE FOR
            2457     4               !     THE FLETCHER EQUATION. ALSO, ONLY INITIATE MORE ICE IF THE NEW NUMBER
            2458     4               !     CONCENTRATION EXCEEDS THAT ALREADY PRESENT.
            2459     4               !* 31 * pint  : initiation of qi                                  **31**
            2460     4               !* 32 * pidep : deposition of qi                                  **32**
            2461     4   p    s                 pint(i,j)=0.0
            2462     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2463     5   p    s              if ( itaobraun.eq.1 ) then
            2464     5   s    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2465     6   s    s                  if (tair(i,j) .lt. t0) then
            2466     6               !             if (qi(i,j) .le. cmin) qi(i,j)=0.
            2467     6   s    s                    if (qi(i,j) .le. cmin2) qi(i,j)=0.
            2468     6   s    s                     tairc(i,j)=tair(i,j)-t0
            2469     6   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2470     6   s    s                     y2(i,j)=exp(c218-c580*rtair(i,j))
            2471     6   s    s                    qsi(i,j)=rp0*y2(i,j)
            2472     6   s    s                     esi(i,j)=c610*y2(i,j)
            2473     6   s    s                    ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2474     6   s    s                              ami50=3.76e-8
            2475     6               
            2476     6               !ccif ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
            2477     6               !ccif ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
            2478     6               
            2479     6   s    s                   y1(i,j)=1./tair(i,j)
            2480     6               
            2481     6               !cc insert a restriction on ice collection that ice collection
            2482     6               !cc should be stopped at -30 c (with cn0=1.e-6, beta=-.46)
            2483     6               
            2484     6   s    s                   tairccri=tairc(i,j)          ! in degree c
            2485     6   s    s                   if(tairccri.le.-30.) tairccri=-30.
            2486     6               
            2487     6               !            y2(i,j)=exp(betah*tairc(i,j))
            2488     6   s    s                   y2(i,j)=exp(betah*tairccri)
            2489     6   s    s                   y3(i,j)=sqrt(qi(i,j))
            2490     6   s    s                   dd(i,j)=y1(i,j)*(rn10a*y1(i,j)-rn10b)+rn10c*tair(i,j) &
            2491     6                                                               /esi(i,j)
            2492     6   s    s                pidep(i,j)=max(r32rt*ssi(i,j)*y2(i,j)*y3(i,j)/dd(i,j), 0.e0)
            2493     6               
            2494     6   s    s                 r_nci=min(cn0*exp(beta*tairc(i,j)),1.)
            2495     6               !          r_nci=min(1.e-6*exp(-.46*tairc(i,j)),1.)
            2496     6               
            2497     6   s    s                 dd(i,j)=max(1.e-9*r_nci/r00-qi(i,j)*1.e-9/ami50, 0.)
            2498     6   s    s                      dm(i,j)=max( (qv(i,j)+qb0-qsi(i,j)), 0.0)
            2499     6   s    s                      rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2500     6   s    s                    dep(i,j)=dm(i,j)/(1.+rsub1(i,j))
            2501     6   s    s                    pint(i,j)=max(min(dd(i,j), dm(i,j)), 0.)
            2502     6               
            2503     6               !             pint(i,j)=min(pint(i,j), dep(i,j))
            2504     6   s    s                    pint(i,j)=min(pint(i,j)+pidep(i,j), dep(i,j))
            2505     6               
            2506     6               !              if (pint(i,j) .le. cmin) pint(i,j)=0.
            2507     6   s    s                     if (pint(i,j) .le. cmin2) pint(i,j)=0.
            2508     6   s    s                    pt(i,j)=pt(i,j)+ascp*pint(i,j)
            2509     6   s    s                    qv(i,j)=qv(i,j)-pint(i,j)
            2510     6   s    s                    qi(i,j)=qi(i,j)+pint(i,j)
            2511     6   p    s                 endif
            2512     5   p    s              endif  ! if ( itaobraun.eq.1 )
            2513     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2514     4               !
            2515     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2516     5   p    s              if ( itaobraun.eq.0 ) then
            2517     5   s    s                   tair(i,j)=(pt(i,j)+tb0)*pi0
            2518     6   s    s                   if (tair(i,j) .lt. t0) then
            2519     6   s    s                     if (qi(i,j) .le. cmin1) qi(i,j)=0.
            2520     6   s    s                     tairc(i,j)=tair(i,j)-t0
            2521     6   s    s                     dd(i,j)=r31r*exp(beta*tairc(i,j))
            2522     6   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2523     6   s    s                     y2(i,j)=exp(c218-c580*rtair(i,j))
            2524     6   s    s                     qsi(i,j)=rp0*y2(i,j)
            2525     6   s    s                     esi(i,j)=c610*y2(i,j)
            2526     6   s    s                     ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2527     6   s    s                     dm(i,j)=max( (qv(i,j)+qb0-qsi(i,j)), 0.)
            2528     6   s    s                     rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2529     6   s    s                     dep(i,j)=dm(i,j)/(1.+rsub1(i,j))
            2530     6   s    s                    pint(i,j)=max(min(dd(i,j), dm(i,j)), 0.)
            2531     6   s    s                     y1(i,j)=1./tair(i,j)
            2532     6   s    s                     y2(i,j)=exp(betah*tairc(i,j))
            2533     6   s    s                     y3(i,j)=sqrt(qi(i,j))
            2534     6   s    s                     dd(i,j)=y1(i,j)*(rn10a*y1(i,j)-rn10b) &
            2535     6                                    +rn10c*tair(i,j)/esi(i,j)
            2536     6   s    s                   pidep(i,j)=max(r32rt*ssi(i,j)*y2(i,j)*y3(i,j)/dd(i,j), 0.)
            2537     6   s    s                    pint(i,j)=pint(i,j)+pidep(i,j)
            2538     6   s    s                    pint(i,j)=min(pint(i,j),dep(i,j))
            2539     6               !c          if (pint(i,j) .le. cmin2) pint(i,j)=0.
            2540     6   s    s                   pt(i,j)=pt(i,j)+ascp*pint(i,j)
            2541     6   s    s                   qv(i,j)=qv(i,j)-pint(i,j)
            2542     6   s    s                   qi(i,j)=qi(i,j)+pint(i,j)
            2543     6   p    s                  endif
            2544     5   p    s              endif  ! if ( itaobraun.eq.0 )
            2545     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2546     4               
            2547     4               !JJS  225    CONTINUE
            2548     4               
            2549     4               !*****   TAO ET AL (1989) SATURATION TECHNIQUE  ***********************
            2550     4               
            2551     5   p    s               if (new_ice_sat .eq. 0) then
            2552     5               
            2553     5               !JJS            DO 250 J=3,JLES
            2554     5               !JJS            DO 250 I=3,ILES
            2555     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            2556     5   s    s                     cnd(i,j)=rt0*(tair(i,j)-t00)
            2557     5   s    s                     dep(i,j)=rt0*(t0-tair(i,j))
            2558     5   s    s                     y1(i,j)=1./(tair(i,j)-c358)
            2559     5   s    s                     y2(i,j)=1./(tair(i,j)-c76)
            2560     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2561     5   s    s                     qsi(i,j)=rp0*exp(c218-c580*y2(i,j))
            2562     5   s    s                     dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2563     5   s    s                     dd1(i,j)=cp580*y2(i,j)*y2(i,j)
            2564     5   s    s                     if (qc(i,j).le.cmin) qc(i,j)=cmin
            2565     5   m    s                     if (qi(i,j).le.cmin) qi(i,j)=cmin
            2566     6   m    s                     if (tair(i,j).ge.t0) then
            2567     6   s    s                        dep(i,j)=0.0
            2568     6   s    s                        cnd(i,j)=1.
            2569     6   s    s                        qi(i,j)=0.0
            2570     6   p    s                     endif
            2571     5               
            2572     6   s    s                     if (tair(i,j).lt.t00) then
            2573     6   s    s                        cnd(i,j)=0.0
            2574     6   s    s                        dep(i,j)=1.
            2575     6   s    s                        qc(i,j)=0.0
            2576     6   p    s                     endif
            2577     5               
            2578     5   s    s                     y5(i,j)=avcp*cnd(i,j)+ascp*dep(i,j)
            2579     5               !               if (qc(i,j) .ge. cmin .or. qi(i,j) .ge. cmin) then
            2580     5   s    s                     y1(i,j)=qc(i,j)*qsw(i,j)/(qc(i,j)+qi(i,j))
            2581     5   s    s                     y2(i,j)=qi(i,j)*qsi(i,j)/(qc(i,j)+qi(i,j))
            2582     5   s    s                     y4(i,j)=dd(i,j)*y1(i,j)+dd1(i,j)*y2(i,j)
            2583     5   s    s                     qvs(i,j)=y1(i,j)+y2(i,j)
            2584     5   s    s                     rsub1(i,j)=(qv(i,j)+qb0-qvs(i,j))/(1.+y4(i,j)*y5(i,j))
            2585     5   s    s                     cnd(i,j)=cnd(i,j)*rsub1(i,j)
            2586     5   s    s                     dep(i,j)=dep(i,j)*rsub1(i,j)
            2587     5   s    s                     if (qc(i,j).le.cmin) qc(i,j)=0.
            2588     5   m    s                     if (qi(i,j).le.cmin) qi(i,j)=0.
            2589     5               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2590     5               !c    ******   condensation or evaporation of qc  ******
            2591     5               
            2592     5   m    s                     cnd(i,j)=max(-qc(i,j),cnd(i,j))
            2593     5               
            2594     5               !c    ******   deposition or sublimation of qi    ******
            2595     5               
            2596     5   s    s                     dep(i,j)=max(-qi(i,j),dep(i,j))
            2597     5               
            2598     5   s    s                     pt(i,j)=pt(i,j)+avcp*cnd(i,j)+ascp*dep(i,j)
            2599     5   s    s                     qv(i,j)=qv(i,j)-cnd(i,j)-dep(i,j)
            2600     5   s    s                     qc(i,j)=qc(i,j)+cnd(i,j)
            2601     5   s    s                     qi(i,j)=qi(i,j)+dep(i,j)
            2602     5               !JJS  250       continue
            2603     5   p    s               endif
            2604     4               
            2605     5   p    s               if (new_ice_sat .eq. 1) then
            2606     5               
            2607     5               !JJS            DO J=3,JLES
            2608     5               !JJS            DO I=3,ILES
            2609     5               
            2610     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            2611     5   s    s                     cnd(i,j)=rt0*(tair(i,j)-t00)
            2612     5   s    s                     dep(i,j)=rt0*(t0-tair(i,j))
            2613     5   s    s                     y1(i,j)=1./(tair(i,j)-c358)
            2614     5   s    s                     y2(i,j)=1./(tair(i,j)-c76)
            2615     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2616     5   s    s                     qsi(i,j)=rp0*exp(c218-c580*y2(i,j))
            2617     5   s    s                     dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2618     5   s    s                     dd1(i,j)=cp580*y2(i,j)*y2(i,j)
            2619     5   s    s                     y5(i,j)=avcp*cnd(i,j)+ascp*dep(i,j)
            2620     5   s    s                     y1(i,j)=rt0*(tair(i,j)-t00)*qsw(i,j)
            2621     5   s    s                     y2(i,j)=rt0*(t0-tair(i,j))*qsi(i,j)
            2622     5               !               IF (QC(I,J).LE.CMIN) QC(I,J)=CMIN
            2623     5               !               IF (QI(I,J).LE.CMIN) QI(I,J)=CMIN
            2624     5               
            2625     6   s    s                     if (tair(i,j).ge.t0) then
            2626     6               !                 QI(I,J)=0.0
            2627     6   s    s                        dep(i,j)=0.0
            2628     6   s    s                        cnd(i,j)=1.
            2629     6   s    s                        y2(i,j)=0.
            2630     6   s    s                        y1(i,j)=qsw(i,j)
            2631     6   p    s                     endif
            2632     6   s    s                     if (tair(i,j).lt.t00) then
            2633     6   s    s                        cnd(i,j)=0.0
            2634     6   s    s                        dep(i,j)=1.
            2635     6   s    s                        y2(i,j)=qsi(i,j)
            2636     6   s    s                        y1(i,j)=0.
            2637     6               !                 QC(I,J)=0.0
            2638     6   p    s                     endif
            2639     5               
            2640     5               !            Y1(I,J)=QC(I,J)*QSW(I,J)/(QC(I,J)+QI(I,J))
            2641     5               !            Y2(I,J)=QI(I,J)*QSI(I,J)/(QC(I,J)+QI(I,J))
            2642     5               
            2643     5   s    s                     y4(i,j)=dd(i,j)*y1(i,j)+dd1(i,j)*y2(i,j)
            2644     5   s    s                     qvs(i,j)=y1(i,j)+y2(i,j)
            2645     5   s    s                     rsub1(i,j)=(qv(i,j)+qb0-qvs(i,j))/(1.+y4(i,j)*y5(i,j))
            2646     5   s    s                     cnd(i,j)=cnd(i,j)*rsub1(i,j)
            2647     5   s    s                     dep(i,j)=dep(i,j)*rsub1(i,j)
            2648     5               !               IF (QC(I,J).LE.CMIN) QC(I,J)=0.
            2649     5               !               IF (QI(I,J).LE.CMIN) QI(I,J)=0.
            2650     5               
            2651     5               !C    ******   CONDENSATION OR EVAPORATION OF QC  ******
            2652     5               
            2653     5   s    s                     cnd(i,j)=max(-qc(i,j),cnd(i,j))
            2654     5               
            2655     5               !C    ******   DEPOSITION OR SUBLIMATION OF QI    ******
            2656     5               
            2657     5   s    s                     dep(i,j)=max(-qi(i,j),dep(i,j))
            2658     5               
            2659     5   s    s                     pt(i,j)=pt(i,j)+avcp*cnd(i,j)+ascp*dep(i,j)
            2660     5   s    s                     qv(i,j)=qv(i,j)-cnd(i,j)-dep(i,j)
            2661     5   s    s                     qc(i,j)=qc(i,j)+cnd(i,j)
            2662     5   s    s                     qi(i,j)=qi(i,j)+dep(i,j)
            2663     5               !JJS            ENDDO
            2664     5               !JJS            ENDDO
            2665     5   p    s               endif
            2666     4               
            2667     4               !c
            2668     4               !
            2669     5   p    s                if (new_ice_sat .eq. 2) then
            2670     5               !JJS          do j=3,jles
            2671     5               !JJS             do i=3,iles
            2672     5   p    s                dep(i,j)=0.0
            2673     5   p    s                cnd(i,j)=0.0
            2674     5   s    s                tair(i,j)=(pt(i,j)+tb0)*pi0
            2675     6   s    s                if (tair(i,j) .ge. 253.16) then
            2676     6   s    s                    y1(i,j)=1./(tair(i,j)-c358)
            2677     6   s    s                    qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2678     6   s    s                    dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2679     6   s    s                    dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            2680     6   s    s                    cnd(i,j)=dm(i,j)/(1.+avcp*dd(i,j)*qsw(i,j))
            2681     6               !c    ******   condensation or evaporation of qc  ******
            2682     6   m    s                    cnd(i,j)=max(-qc(i,j), cnd(i,j))
            2683     6   s    s                   pt(i,j)=pt(i,j)+avcp*cnd(i,j)
            2684     6   s    s                   qv(i,j)=qv(i,j)-cnd(i,j)
            2685     6   s    s                   qc(i,j)=qc(i,j)+cnd(i,j)
            2686     6   p    s               endif
            2687     6   s    s                if (tair(i,j) .le. 258.16) then
            2688     6               !c             cnd(i,j)=0.0
            2689     6   s    s                 y2(i,j)=1./(tair(i,j)-c76)
            2690     6   s    s                 qsi(i,j)=rp0*exp(c218-c580*y2(i,j))
            2691     6   s    s                dd1(i,j)=cp580*y2(i,j)*y2(i,j)
            2692     6   s    s               dep(i,j)=(qv(i,j)+qb0-qsi(i,j))/(1.+ascp*dd1(i,j)*qsi(i,j))
            2693     6               !c    ******   deposition or sublimation of qi    ******
            2694     6   m    s                   dep(i,j)=max(-qi(i,j),dep(i,j))
            2695     6   s    s                   pt(i,j)=pt(i,j)+ascp*dep(i,j)
            2696     6   s    s                   qv(i,j)=qv(i,j)-dep(i,j)
            2697     6   s    s                   qi(i,j)=qi(i,j)+dep(i,j)
            2698     6   p    s               endif
            2699     5               !JJS       enddo
            2700     5               !JJS       enddo
            2701     5   p    s            endif
            2702     4               
            2703     4               !c
            2704     4               !
            2705     4               !* 10 * PSDEP : DEPOSITION OR SUBLIMATION OF QS                   **10**
            2706     4               !* 20 * PGSUB : SUBLIMATION OF QG                                 **20**
            2707     4               
            2708     4               !JJS         DO 275 J=3,JLES
            2709     4               !JJS         DO 275 I=3,ILES
            2710     4               
            2711     4   p    s                  psdep(i,j)=0.0
            2712     4   p    s                  pgdep(i,j)=0.0
            2713     4   p    s                  pssub(i,j)=0.0
            2714     4   p    s                  pgsub(i,j)=0.0
            2715     4   s    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2716     4               
            2717     5   s    s                  if(tair(i,j).lt.t0) then
            2718     5   s    s                     if(qs(i,j).lt.cmin1) qs(i,j)=0.0
            2719     5   s    s                     if(qg(i,j).lt.cmin1) qg(i,j)=0.0
            2720     5   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2721     5   s    s                     qsi(i,j)=rp0*exp(c218-c580*rtair(i,j))
            2722     5   s    s                     ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2723     5               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2724     5   s    s                     y1(i,j)=r10ar/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            2725     5                                     *qsi(i,j))
            2726     5   s    s                     y2(i,j)=.78/zs(i,j)**2+r101f*scv(i,j)/zs(i,j)**bsh5
            2727     5   s    s                     psdep(i,j)=r10t*ssi(i,j)*y2(i,j)/y1(i,j)
            2728     5   s    s                     pssub(i,j)=psdep(i,j)
            2729     5   s    s                     psdep(i,j)=r2is*max(psdep(i,j), 0.)
            2730     5   s    s                     pssub(i,j)=r2is*max(-qs(i,j), min(pssub(i,j), 0.))
            2731     5               
            2732     6   m    s                     if(ihail.eq.1) then
            2733     6   m    m                        y2(i,j)=.78/zg(i,j)**2+r20bq*scv(i,j)/zg(i,j)**bgh5
            2734     6   s    s                     else
            2735     6   m    s                        y2(i,j)=.78/zg(i,j)**2+r20bs*scv(i,j)/zg(i,j)**bgh5
            2736     6   s    s                     endif
            2737     5               
            2738     5   s    s                     pgsub(i,j)=r2ig*r20t*ssi(i,j)*y2(i,j)/y1(i,j)
            2739     5   s    s                     dm(i,j)=qv(i,j)+qb0-qsi(i,j)
            2740     5   s    s                     rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2741     5               
            2742     5               !     ********   DEPOSITION OR SUBLIMATION OF QS  **********************
            2743     5               
            2744     5   s    s                     y1(i,j)=dm(i,j)/(1.+rsub1(i,j))
            2745     5   s    s                     psdep(i,j)=r2is*min(psdep(i,j),max(y1(i,j),0.))
            2746     5   s    s                     y2(i,j)=min(y1(i,j),0.)
            2747     5   s    s                     pssub(i,j)=r2is*max(pssub(i,j),y2(i,j))
            2748     5               
            2749     5               !     ********   SUBLIMATION OF QG   ***********************************
            2750     5               
            2751     5   s    s                     dd(i,j)=max((-y2(i,j)-qs(i,j)), 0.)
            2752     5   s    s                    pgsub(i,j)=r2ig*min(dd(i,j), qg(i,j), max(pgsub(i,j),0.))
            2753     5               
            2754     6   m    s                     if(qc(i,j)+qi(i,j).gt.1.e-5) then
            2755     6   m    m                        dlt1(i,j)=1.
            2756     6   s    s                     else
            2757     6   m    s                        dlt1(i,j)=0.
            2758     6   s    s                     endif
            2759     5               
            2760     5   s    s                     psdep(i,j)=dlt1(i,j)*psdep(i,j)
            2761     5   s    s                     pssub(i,j)=(1.-dlt1(i,j))*pssub(i,j)
            2762     5   s    s                     pgsub(i,j)=(1.-dlt1(i,j))*pgsub(i,j)
            2763     5               
            2764     5   s    s                     pt(i,j)=pt(i,j)+ascp*(psdep(i,j)+pssub(i,j)-pgsub(i,j))
            2765     5   s    s                     qv(i,j)=qv(i,j)+pgsub(i,j)-pssub(i,j)-psdep(i,j)
            2766     5   s    s                     qs(i,j)=qs(i,j)+psdep(i,j)+pssub(i,j)
            2767     5   s    s                     qg(i,j)=qg(i,j)-pgsub(i,j)
            2768     5   p    s                  endif
            2769     4               
            2770     4               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            2771     4               
            2772     4   p    s                  ern(i,j)=0.0
            2773     4               
            2774     5   s    s                  if(qr(i,j).gt.0.0) then
            2775     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            2776     5   s    s                     rtair(i,j)=1./(tair(i,j)-c358)
            2777     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*rtair(i,j))
            2778     5   s    s                     ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.0
            2779     5   s    s                     dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            2780     5   s    s                     rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            2781     5   s    s                     dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)), 0.0)
            2782     5   s    s                     y1(i,j)=.78/zr(i,j)**2+r23af*scv(i,j)/zr(i,j)**bwh5
            2783     5   s    s                     y2(i,j)=r23br/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            2784     5                                      *qsw(i,j))
            2785     5               !cccc
            2786     5   s    s                     ern(i,j)=r23t*ssw(i,j)*y1(i,j)/y2(i,j)
            2787     5   s    s                     ern(i,j)=min(dd1(i,j),qr(i,j),max(ern(i,j),0.))
            2788     5   p    s                     pt(i,j)=pt(i,j)-avcp*ern(i,j)
            2789     5   p    s                     qv(i,j)=qv(i,j)+ern(i,j)
            2790     5   s    s                     qr(i,j)=qr(i,j)-ern(i,j)
            2791     5   p    s                  endif
            2792     4               
            2793     4               !JJS 10/7/2008     vvvvv
            2794     4   p    v          ENDIF    ! part of if (iwarm.eq.1) then
            2795     3               !JJS 10/7/2008     ^^^^^
            2796     3               
            2797     3               !            IF (QV(I,J)+QB0 .LE. 0.) QV(I,J)=-QB0
            2798     3   s    s                  if (qc(i,j) .le. cmin1) qc(i,j)=0.
            2799     3   m    m                  if (qr(i,j) .le. cmin1) qr(i,j)=0.
            2800     3   p    m                  if (qi(i,j) .le. cmin1) qi(i,j)=0.
            2801     3   m    m                  if (qs(i,j) .le. cmin1) qs(i,j)=0.
            2802     3   m    m                  if (qg(i,j) .le. cmin1) qg(i,j)=0.
            2803     3   p    v                  dpt(i,j,k)=pt(i,j)
            2804     3   p    v                  dqv(i,j,k)=qv(i,j)
            2805     3   s    s                  qcl(i,j,k)=qc(i,j)
            2806     3   s    s                  qrn(i,j,k)=qr(i,j)
            2807     3   p    v                  qci(i,j,k)=qi(i,j)
            2808     3   s    s                  qcs(i,j,k)=qs(i,j)
            2809     3   s    s                  qcg(i,j,k)=qg(i,j)
            2810     3               
            2811     3               !JJS  275    CONTINUE
            2812     3               
            2813     3   p    v               scc=0.
            2814     3   p    v               see=0.
            2815     3               
            2816     3               !         DO 110 J=3,JLES
            2817     3               !         DO 110 I=3,ILES
            2818     3               !            DD(I,J)=MAX(-CND(I,J), 0.)
            2819     3               !            CND(I,J)=MAX(CND(I,J), 0.)
            2820     3               !            DD1(I,J)=MAX(-DEP(I,J), 0.)
            2821     3               
            2822     3               !ccshie 2/21/02 shie follow tao
            2823     3               !CC for reference    QI(I,J)=QI(I,J)-Y2(I,J)+PIDEP(I,J)*D2T
            2824     3               !CC for reference    QV(I,J)=QV(I,J)-(PIDEP(I,J))*D2T
            2825     3               
            2826     3               !c            DEP(I,J)=MAX(DEP(I,J), 0.)
            2827     3               !            DEP(I,J)=MAX(DEP(I,J), 0.)+PIDEP(I,J)*D2T
            2828     3               !            SCC=SCC+CND(I,J)
            2829     3               !            SEE=SEE+DD(I,J)+ERN(I,J)
            2830     3               
            2831     3               !  110    CONTINUE
            2832     3               
            2833     3               !         SC(K)=SCC+SC(K)
            2834     3               !         SE(K)=SEE+SE(K)
            2835     3               
            2836     3               !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2837     3               !c     henry:  please take a look  (start)
            2838     3               !JJS modified by JJS on 5/1/2007  vvvvv
            2839     3               
            2840     3               !JJS       do 305 j=3,jles
            2841     3               !JJS       do 305 i=3,iles
            2842     3   p    v                  dd(i,j)=max(-cnd(i,j), 0.)
            2843     3   p    v                  cnd(i,j)=max(cnd(i,j), 0.)
            2844     3   p    v                  dd1(i,j)=max(-dep(i,j), 0.)+pidep(i,j)*d2t
            2845     3   p    v                  dep(i,j)=max(dep(i,j), 0.)
            2846     3               !JJS  305  continue
            2847     3               
            2848     3               !JJS       do 306 j=3,jles
            2849     3               !JJS       do 306 i=3,iles
            2850     3               !JJS              scc=scc+cnd(i,j)
            2851     3               !JJS              see=see+(dd(i,j)+ern(i,j))
            2852     3               !
            2853     3               !JJS            sddd=sddd+(dep(i,j)+pint(i,j)+psdep(i,j)+pgdep(i,j))
            2854     3               !JJS          ssss=ssss+dd1(i,j)
            2855     3               !JJS
            2856     3               !            shhh=shhh+rsw(i,j,k)*d2t
            2857     3               !            sccc=sccc+rlw(i,j,k)*d2t
            2858     3               !jjs
            2859     3               !JJS              smmm=smmm+(psmlt(i,j)+pgmlt(i,j)+pimlt(i,j))
            2860     3               !JJS              sfff=sfff+d2t*(psacw(i,j)+piacr(i,j)+psfw(i,j)
            2861     3               !JJS     1         +pgfr(i,j)+dgacw(i,j)+dgacr(i,j)+psacr(i,j))
            2862     3               !JJS     2        -qracs(i,j)+pihom(i,j)+pidw(i,j)
            2863     3               
            2864     3               
            2865     3   s    s                    sccc=cnd(i,j)
            2866     3   s    s                    seee=dd(i,j)+ern(i,j)
            2867     3   s    s                    sddd=dep(i,j)+pint(i,j)+psdep(i,j)+pgdep(i,j)
            2868     3   s    s                    ssss=dd1(i,j) + pgsub(i,j)
            2869     3   s    s                    smmm=psmlt(i,j)+pgmlt(i,j)+pimlt(i,j)
            2870     3   s    s                    sfff=d2t*(psacw(i,j)+piacr(i,j)+psfw(i,j) &
            2871     3                              +pgfr(i,j)+dgacw(i,j)+dgacr(i,j)+psacr(i,j) &
            2872     3                              +wgacr(i,j))+pihom(i,j)+pidw(i,j)
            2873     3               
            2874     3               !           physc(i,k,j) = avcp * sccc / d2t
            2875     3               !           physe(i,k,j) = avcp * seee / d2t
            2876     3               !           physd(i,k,j) = ascp * sddd / d2t
            2877     3               !           physs(i,k,j) = ascp * ssss / d2t
            2878     3               !           physf(i,k,j) = afcp * sfff / d2t
            2879     3               !           physm(i,k,j) = afcp * smmm / d2t
            2880     3               !           physc(i,k,j) = physc(i,k,j) + avcp * sccc
            2881     3               !           physe(i,k,j) = physc(i,k,j) + avcp * seee
            2882     3               !           physd(i,k,j) = physd(i,k,j) + ascp * sddd
            2883     3               !           physs(i,k,j) = physs(i,k,j) + ascp * ssss
            2884     3               !           physf(i,k,j) = physf(i,k,j) + afcp * sfff
            2885     3               !           physm(i,k,j) = physm(i,k,j) + afcp * smmm
            2886     3               
            2887     3               !JJS modified by JJS on 5/1/2007  ^^^^^
            2888     3               
            2889     3               #ifdef EffectRad_GCE3
            2890     3               !xb141 20230525 : code from GCE 4ICE
            2891     3               !JJS 20140305 vvvvv  Calculate effective radius for all cloud species
            2892     3               !   eff_rad is a function of the slope parameter (Lambda)
            2893     3               
            2894     3                     ! rain
            2895     4   m    s            if (qrn(i,j,k) .lt. cmin) then
            2896     4   p    s               re_rain_gsfc(i,k,j) = 0.
            2897     4   s    s            else
            2898     4   mi   s               re_rain_gsfc(i,k,j) = eff_rad(zr(i,j))
            2899     4   p    v            endif
            2900     3               
            2901     3                     ! snow
            2902     4   m    s            if (qcs(i,j,k) .lt. cmin) then
            2903     4   p    s               re_snow_gsfc(i,k,j) = 0.e0
            2904     4   s    s            else
            2905     4   mi   s               re_snow_gsfc(i,k,j) = eff_rad(zs(i,j))
            2906     4   p    v            endif
            2907     3               
            2908     3                     ! graupel
            2909     4   m    s            if (qcg(i,j,k) .lt. cmin) then
            2910     4   p    s               re_graupel_gsfc(i,k,j) = 0.e0
            2911     4   s    s            else
            2912     4   mi   s               re_graupel_gsfc(i,k,j) = eff_rad(zg(i,j))
            2913     4   p    v            endif
            2914     3               
            2915     3                     ! cloud water
            2916     4   m    s            if (qcl(i,j,k) .lt. cmin) then
            2917     4   p    s               re_cloud_gsfc(i,k,j) = 0.e0
            2918     4   s    s            else
            2919     4   p    s               L_cloud = qcl(i,j,k) * rho(i,j,k)             ! cloud water [g/cm3]
            2920     4                        ! Not running with WRF_Chem
            2921     4                           ! ccn_over_land = 1500  ! [#/cm3] climatological value
            2922     4                           ! ccn_over_water = 150  ! [#/cm3] climatological value
            2923     5   m    s                  if (xland(i,j) .eq. 1.0) then
            2924     5   s    s                     ccn_ref = ccn_over_land
            2925     5   m    s                  else if (xland(i,j) .eq. 2.0) then
            2926     5   m    s                     ccn_ref = ccn_over_water
            2927     5   s    s                  else
            2928     5   m    s                     print *,' xland is not 1. or 2., run stopped'
            2929     5                              ! EMK NUWRF
            2930     5               !               call wrf_error_fatal(' xland is not 1. or 2., run stopped')
            2931     5               !               stop
            2932     5   s    s                  endif
            2933     4                          ! for cloud water, estimate lambda (slope of gamma distribution)
            2934     4   s    s                         mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            2935     4   m    s                         gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            2936     4   m    s                         gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            2937     4   m    s                         lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            2938     4                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            2939     4   p    s                         re_cloud_gsfc(i,k,j) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            2940     4   p    v            endif ! qcl(i,k) < cmin test
            2941     3               
            2942     3                     ! cloud ice
            2943     4   p    s            if (qci(i,j,k) .lt. cmin) then
            2944     4   p    s               re_ice_gsfc(i,k,j) = 0.e0
            2945     4   p    s            else
            2946     4                       ! Not running with WRF_Chem
            2947     4                       ! for cloud ice effective radius depends on temperature profile, formula from GCE
            2948     4   p    s               re_ice_gsfc(i,k,j) = 125.e0 +(tair(i,j)-243.16)*5.e0     ! [micron]
            2949     4   p    s               if (tair(i,j) .gt. 243.16) re_ice_gsfc(i,k,j) = 125.e0
            2950     4   p    s               if (tair(i,j) .lt. 223.16) re_ice_gsfc(i,k,j) = 25.e0
            2951     4   p    v            endif ! qci(i,k) < cmin test
            2952     3               #endif
            2953     3               
            2954     2   p    v       2000 continue
            2955     1               
            2956     1                1000 continue
            2957                     
            2958                     !JJS  ****************************************************************
            2959                     !JJS  convert from GCE grid back to WRF grid
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2960     1  pp                 do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qcs, qci, qrn, qcg, qcl, dpt, dqv, qrwrf
                                   <<<      qswrf, qlwrf, ptwrf, qiwrf, qvwrf, qgwrf
                                   <<< Loop-information  End >>>
            2961     2   p                    do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.72, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qswrf, qci, qiwrf, qcg, qrn, qrwrf, qcs
                                   <<<      qcl, qlwrf, dpt, dqv, qvwrf, ptwrf
                                   <<<      qgwrf
                                   <<< Loop-information  End >>>
            2962     3   p    v               do i=its,ite
            2963     3   p    v               ptwrf(i,k,j) = dpt(i,j,k)
            2964     3   p    v               qvwrf(i,k,j) = dqv(i,j,k)
            2965     3   p    v               qlwrf(i,k,j) = qcl(i,j,k)
            2966     3   p    v               qrwrf(i,k,j) = qrn(i,j,k)
            2967     3   p    v               qiwrf(i,k,j) = qci(i,j,k)
            2968     3   p    v               qswrf(i,k,j) = qcs(i,j,k)
            2969     3   p    v               qgwrf(i,k,j) = qcg(i,j,k)
            2970     3   p    v               enddo !i
            2971     2   p                    enddo !j
            2972     1   p                 enddo !k
            2973                     
            2974                     !     ****************************************************************
            2975                     
            2976                     !+---+-----------------------------------------------------------------+
            2977     1                        IF ( PRESENT (diagflag) ) THEN
            2978     2                        if (diagflag .and. do_radar_ref == 1) then
            2979     3                           do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv1d, qr1d, t1d, p1d, dBZ, qg1d, qs1d
                                   <<< Loop-information  End >>>
            2980     4                           do i=its,ite
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.11, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv1d, p1d, t1d, qr1d
                                   <<< Loop-information  End >>>
            2981     5  pp   2v                     DO K=kts,kte
            2982     5   p   2v                        t1d(k)=ptwrf(i,k,j)*pi_mks(i,k,j)
            2983     5   p   2v                        p1d(k)=p0_mks(i,k,j)
            2984     5   p   2v                        qv1d(k)=qvwrf(i,k,j)
            2985     5   p   2v                        qr1d(k)=qrwrf(i,k,j)
            2986     5   p   2v                     ENDDO
            2987     5                              if (ice2.eq.0) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.25, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d
                                   <<< Loop-information  End >>>
            2988     6  pp   2v                        DO K=kts,kte
            2989     6   p   2v                           qs1d(k)=qswrf(i,k,j)
            2990     6   p   2v                           qg1d(k)=qgwrf(i,k,j)
            2991     6   p   2v                        ENDDO
            2992     5                              elseif (ice2.eq.1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs1d
                                   <<< Loop-information  End >>>
            2993     6  pp   4v                        DO K=kts,kte
            2994     6   p   4v                           qs1d(k)=qswrf(i,k,j)
            2995     6   p   4v                        ENDDO
            2996     5                              elseif (ice2.eq.2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d
                                   <<< Loop-information  End >>>
            2997     6  pp   2v                        DO K=kts,kte
            2998     6   p   2v                           qs1d(k)=0.
            2999     6   p   2v                           qg1d(k)=qgwrf(i,k,j)
            3000     6   p   2v                        ENDDO
            3001     5                              elseif (ice2.eq.3) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d
                                   <<< Loop-information  End >>>
            3002     6  pp   2v                        DO K=kts,kte
            3003     6   p   2v                           qs1d(k)=0.
            3004     6   p   2v                           qg1d(k)=0.
            3005     6   p   2v                        ENDDO
            3006     5                              endif
            3007     4                              call refl10cm_gsfc (qv1d, qr1d, qs1d, qg1d,             &
            3008     4                                      t1d, p1d, dBZ, kts, kte, i, j, ihail)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            3009     5  pp   2v                     do k = kts, kte
            3010     5   p   2v                        refl_10cm(i,k,j) = MAX(-35., dBZ(k))
            3011     5   p   2v                     enddo
            3012     4                           enddo
            3013     3                           enddo
            3014     2                        endif
            3015     1                        ENDIF
            3016                     !+---+-----------------------------------------------------------------+
            3017                     
            3018                           return
            3019                      END SUBROUTINE saticel_s
            3020                     
            3021                     !JJS
            3022                     !JJS      REAL FUNCTION GAMMA(X)
            3023                     !JJS        Y=GAMMLN(X)
            3024                     !JJS        GAMMA=EXP(Y)
            3025                     !JJS      RETURN
            3026                     !JJS      END
            3027                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            3028                     !JJS      real function GAMMLN (xx)
            3029                       real function gammagce (xx)
            3030                     !**********************************************************************
            3031                       real*8 cof(6),stp,half,one,fpf,x,tmp,ser
            3032                       data cof,stp /  76.18009173,-86.50532033,24.01409822, &
            3033                          -1.231739516,.120858003e-2,-.536382e-5, 2.50662827465 /
            3034                       data half,one,fpf / .5, 1., 5.5 /
            3035                     !
            3036                           x=xx-one
            3037                           tmp=x+fpf
            3038                           tmp=(x+half)*log(tmp)-tmp
            3039                           ser=one
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3040     1   s   fs            do  j=1,6
            3041     1   s   fs               x=x+one
            3042     1   m   fm              ser=ser+cof(j)/x
            3043     1   p   fv            enddo !j
            3044                           gammln=tmp+log(stp*ser)
            3045                     !JJS
            3046                           gammagce=exp(gammln)
            3047                     !JJS
            3048                           return
            3049                      END FUNCTION gammagce
            3050                     
            3051                     !+---+-----------------------------------------------------------------+
            3052                     
            3053                           subroutine refl10cm_gsfc (qv1d, qr1d, qs1d, qg1d,                 &
            3054                                            t1d, p1d, dBZ, kts, kte, ii, jj, ihail)
            3055                     
            3056                           IMPLICIT NONE
            3057                     
            3058                     !..Sub arguments

             299                     !      CALL wrf_error_fatal3 ( "module_mp_lin.b" , 130 ,  'module_mp_lin: Improper use of Lin et al scheme; no ice phase. Please chose another one.')
             300                     !   ENDIF
             301                     
             302                     ! calculte fallflux and precipiation in MKS system
             303                     
             304                        call fall_flux(dt_in, qr, qi, qs, qg, p,                   &
             305                                           rho, z, dz8w, ht, rainnc,               &
             306                                           rainncv, grav,itimestep,                &

 External subroutine subprogram "get_model_param"
  (inc)(line-no.)(nest)(optimize)
               1                     
               2                           subroutine get_model_param
               3                     !
               4                           use param
               5                     
               6                           use const, only : ifilin,cwbout,bckfile,namlsts,   &
               7                                             ifilout,crdate,ocards,phyout,cntrl, &
               8                                             ifilin_ncep,ifilin_sst,ifilin_nc,&
               9                                             ifilin_ClmANA,ifilin_ClmFCT,ifilout_grb
              10                     
              11                           use paramt
              12                     
              13                           use rank
              14                           use mod_grb2_param, only:grbmem,grbnumm
              15                     !
              16                           implicit  none
              17                     
              18                     !
              19                           namelist /model_param/nco,lev,ncld,octahedral,nout &
              20                                                ,io_quilting,npex,npey !2dMPI
              21                     !
              22                           integer istat
              23                           character*80 filist
              24                           character*80 pathname,logicname,truefile
              25                           namelist /filst/ ifilin,cwbout,bckfile,namlsts &
              26                                          , ifilout,crdate,ocards,phyout,cntrl &
              27                                          , ifilin_ncep,ifilin_sst,ifilin_nc &
              28                                          , ifilin_ClmANA,ifilin_ClmFCT,ifilout_grb
              29                     
              30                           namelist /grb_conf/ grbmem,grbnumm
              31                     
              32                           data pathname/'NWPETCGLB'/
              33                           data logicname/'filist'/
              34                     !
              35                     !  read namlist of path/file name(operation)
              36                     !
              37                           call getfname(pathname,logicname,truefile,istat)
              38     1                     if(istat.ne.0)then
              39     1                       print *,'getfname : error','RANK=',myrank
              40     1                       call mpe_finalize
              41     1                       call dmsexit(-1)
              42     1               !     else
              43     1               !       if(myrank .eq. 0) print *,truefile
              44     1                     endif
              45                     !
              46                           open (unit=12,file=trim(truefile),form='formatted')
              47                     !
              48                           read (12,filst,end=110)
              49                     !
              50                       110 continue
              51                           close(12)
              52                     !
              53                     !  read namelist for model parameters
              54                     !
              55                           open (unit=1,file=trim(namlsts),form='formatted')
              56                     !
              57                           read (1,model_param,end=120)
              58                     !
              59                       120 continue
              60                           read (1,grb_conf,end=121)
              61                       121 continue
              62                           close(1)
              63                     
              64                     
              65                     !     if(myrank .eq. 0) print model_param
              66                           if(myrank_all .eq. 0) print model_param
              67                     
              68     1                     if ( octahedral ) then
              69     1                       my=2*nco
              70     1                       nx=16+4*nco
              71     1                       jtrun= 2*((1+(4*nco-1)/4)/2)
              72     1               
              73     1                       im=16+4*nco
              74     1                       jm=2*nco
              75     1                       jtr= 2*((1+(4*nco-1)/4)/2)
              76     1                     else
              77     1                       nx=4*nco
              78     1                       my=nx/2
              79     1                       jtrun= 2*((1+(nx-1)/2)/2)
              80     1               
              81     1                       im=nx
              82     1                       jm=im/2
              83     1                       jtr= 2*((1+(im-1)/2)/2)
              84     1                     endif
              85                           mlmax= jtrun*(jtrun+1)/2
              86                     
              87                           lm=lev
              88                           mlm=jtr*(jtr+1)/2
              89                     
              90                           imax=nx
              91                           jmax=imax/2
              92                           lpx=26
              93                           kvkw=im/2
              94                     
              95                           ilm=im*lm
              96                           im2=kvkw*(lm+1)
              97                     
              98                           jmhalf=jm/2
              99                           lmX2=lm*2
             100                           lmX4=lm*4
             101                           lmX10=lm*10
             102                     
             103                           return
             104                           end


                                   <<<      kcbot, kctop, kdpl, ktype, wbase, ldcum
                                   <<< Loop-information  End >>>
             124     1  pp   2v            do jl = 1, nxj
             125     1   p   2v              kcbot(jl)=klev
             126     1   p   2v              kctop(jl)=klev
             127     1   p   2v              kdpl(jl) =klev
             128     1   p   2v              ktype(jl)=0
             129     1   p   2v              wbase(jl)=0.
             130     1   p   2v              ldcum(jl)=.false.
             131     1   p   2v            end do
             132                     
             133                     !-----------------------------------------------------------
             134                     ! let's do test,and check the shallow convection first
             135                     ! the first level is klev
             136                     ! define deltat and deltaq
             137                     !-----------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      culab, cutu, cuqu, culu, ptu, zbuo, vten
                                   <<<      vptu, kup, dhen, dh, pqu, klab, plu
                                   <<<      abuoy
                                   <<< Loop-information  End >>>
             138     1  pp                 do jk=1,klev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      culu, cutu, ptu, zbuo, vten, vptu, kup
                                   <<<      dhen, dh, klab, culab, cuqu, pqu, plu
                                   <<<      abuoy
                                   <<< Loop-information  End >>>
             139     2   p    v             do jl = 1, nxj
             140     2   p    v                plu(jl,jk)=culu(jl,jk)  ! parcel liquid water
             141     2   p    v                ptu(jl,jk)=cutu(jl,jk)  ! parcel temperature
             142     2   p    v                pqu(jl,jk)=cuqu(jl,jk)  ! parcel specific humidity
             143     2   p    v                klab(jl,jk)=culab(jl,jk)
             144     2   p    v                 dh(jl,jk)=0.0  ! parcel dry static energy
             145     2   p    v               dhen(jl,jk)=0.0  ! environment dry static energy
             146     2   p    v                kup(jl,jk)=0.0  ! updraught kinetic energy for parcel
             147     2   p    v               vptu(jl,jk)=0.0  ! parcel virtual temperature considering water-loading
             148     2   p    v               vten(jl,jk)=0.0  ! environment virtual temperature
             149     2   p    v               zbuo(jl,jk)=0.0  ! parcel buoyancy
             150     2   p    v               abuoy(jl,jk)=0.0
             151     2   p    v            end do
             152     1   p                 end do
             153                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zqold, lldcum, loflag
                                   <<< Loop-information  End >>>
             154     1  pp   2v             do jl = 1, nxj
             155     1   p   2v               zqold(jl) = 0.
             156     1   p   2v               lldcum(jl) = .false.
             157     1   p   2v               loflag(jl) = .true.
             158     1   p   2v            end do
             159                     
             160                     ! check the levels from lowest level to second top level
             161     1                     do jk=klevm1,2,-1
             162     1               
             163     1               ! define the variables at the first level
             164     2                     if(jk .eq. klevm1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 33
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qfx, hfx, pten, ptenh, pgeoh, klab
                                   <<<      loflag, dhen, pqenh, pqen, paph, vten
                                   <<<      kup, ptu, dh
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      zbuo: 2, vptu: 2, pqu: 2
                                   <<< Loop-information  End >>>
             165     3  pp    v             do jl = 1, nxj
             166     3   p    v              rho=paph(jl,klev+1)/ &
             167     3                    &         (rd*(pten(jl,klev)*(1.+vtmpc1*pqen(jl,klev))))
             168     3   p    v              part1 = 1.5*0.4*(pgeoh(jl,klev)-pgeoh(jl,klev+1))/ &
             169     3                    &              (rho*pten(jl,klev))
             170     3   p    v              part2 = -hfx(jl)*rcpd-vtmpc1*pten(jl,klev)*qfx(jl)
             171     3   p    v              root  = 0.001-part1*part2
             172     4   p    v              if(part2 .lt. 0.) then
             173     4   p    v                 conw  = 1.2*(root)**t13
             174     4   p    v                 deltt = max(1.5*hfx(jl)/(rho*cpd*conw),0.)
             175     4   p    v                 deltq = max(1.5*qfx(jl)/(rho*conw),0.)
             176     4   p    v                 kup(jl,klev) = 0.5*(conw**2)
             177     4   p    v                 pqu(jl,klev)= pqenh(jl,klev) + deltq
             178     4   p    v                dhen(jl,klev)= pgeoh(jl,klev) + ptenh(jl,klev)*cpd
             179     4   p    v                 dh(jl,klev) = dhen(jl,klev)  + deltt*cpd
             180     4   p    v                ptu(jl,klev) = (dh(jl,klev)-pgeoh(jl,klev))*rcpd
             181     4   p    v                vptu(jl,klev)=ptu(jl,klev)*(1.+vtmpc1*pqu(jl,klev))
             182     4   p    v                vten(jl,klev)=ptenh(jl,klev)*(1.+vtmpc1*pqenh(jl,klev))
             183     4   p    v                zbuo(jl,klev)=(vptu(jl,klev)-vten(jl,klev))/vten(jl,klev)
             184     4   p    v                klab(jl,klev) = 1
             185     4   p    v              else
             186     4   p    v                loflag(jl) = .false.
             187     4   p    v              end if
             188     3   p    v            end do
             189     2                     end if
             190     1               
             191     1                     is=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
             192     2  pp    v             do jl = 1, nxj

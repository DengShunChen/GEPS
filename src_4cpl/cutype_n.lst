             105                     
             106                           real     zqsu,zcor,zdp,zesdp,zalfaw,zfacw,zfaci,zfac,zdsdp,zdqsdt,zdtdp
             107                           real     zpdifftop, zpdiffbot
             108                           integer  zcbase(klon)
             109                           integer  jl,jk,ik,icall,levels
             110                           logical  needreset, lldcum(klon)
             111                     !--------------------------------------------------------------
             112                           t13 = 1.0/3.0
             113                     !xb110>
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cutop, cubot, zcbase, zph, coef, dz, eta
                                   <<< Loop-information  End >>>
             114        pp    v            eta = 0.
             115         p    v            dz  = 0.
             116         p    v            coef = 0.
             117         p    v            zph  = 0.
             118         p    v            zcbase = 0.
             119                     
             120         p    v            cubot = -1
             121         p    v            cutop = -1
             122                     !xb110<
             123                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]

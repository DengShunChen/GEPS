              93                           real     dhen(klon,klev), dh(klon,klev)
              94                           real     plude(klon,klev)
              95                           real     kup(klon,klev)
              96                           real     vptu(klon,klev),vten(klon,klev)
              97                           real     zbuo(klon,klev),abuoy(klon,klev)
              98                     
              99                           real     zz,zdken,zdq
             100                           real     fscale,crirh1,pp
             101                           real     atop1,atop2,abot
             102                           real     tmix,zmix,qmix,pmix

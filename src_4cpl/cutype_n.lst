               1                           subroutine cutype_n &
               2                          &   ( nxj,     klon,    klev,     klevp1,   klevm1,     pqen,&
               3                          &     ptenh,   pqenh,     pqsenh,    pgeoh,     paph,&
               4                          &       hfx,     qfx,       pgeo,    pqsen,      pap,&
               5                          &      pten,    lndj,       cutu,     cuqu,    culab,&
               6                          &     ldcum,   cubot,      cutop,    ktype,    wbase,    culu,   kdpl,&
               7                          &     p650,     jin    )
               8                     !      zhang & wang      iprc           2011-2013
               9                     !***purpose.
              10                     !   --------
              11                     !          to produce first guess updraught for cu-parameterizations
              12                     !          calculates condensation level, and sets updraught base variables and
              13                     !          first guess cloud type
              14                     !***interface
              15                     !   ---------
              16                     !          this routine is called from *cumastr*.
              17                     !          input are environm. values of t,q,p,phi at half levels.
              18                     !          it returns cloud types as follows;
              19                     !                 ktype=1 for deep cumulus
              20                     !                 ktype=2 for shallow cumulus
              21                     !***method.
              22                     !  --------
              23                     !          based on a simplified updraught equation
              24                     !            partial(hup)/partial(z)=eta(h - hup)
              25                     !            eta is the entrainment rate for test parcel
              26                     !            h stands for dry static energy or the total water specific humidity
              27                     !            references: christian jakob, 2003: a new subcloud model for
              28                     !            mass-flux convection schemes
              29                     !                        influence on triggering, updraft properties, and model
              30                     !                        climate, mon.wea.rev.
              31                     !                        131, 2765-2778
              32                     !            and
              33                     !                        ifs documentation - cy36r1,cy38r1
              34                     !***input variables:
              35                     !       ptenh [ztenh] - environment temperature on half levels. (cuini)
              36                     !       pqenh [zqenh] - env. specific humidity on half levels. (cuini)
              37                     !       pgeoh [zgeoh] - geopotential on half levels, (mssflx)
              38                     !       paph - pressure of half levels. (mssflx)
              39                     !       rho  - density of the lowest model level
              40                     !       qfx  - net upward moisture flux at the surface (kg/m^2/s)
              41                     !       hfx  - net upward heat flux at the surface (w/m^2)
              42                     !***variables output by cutype:
              43                     !       ktype - convection type - 1: penetrative  (cumastr)
              44                     !                                 2: stratocumulus (cumastr)
              45                     !                                 3: mid-level  (cuasc)
              46                     !       information for updraft parcel (ptu,pqu,plu,kcbot,klab,kdpl...)
              47                     ! ----------------------------------------------------------------
              48                       USE mo_constants,    ONLY: cpd,    &! specific heat at constant pressure
              49                                                  rcpd,   &! rcpd=1./cpd
              50                                                  vtmpc1, &! vtmpc1=rv/rd-1
              51                                                  zrg,    &! 1.0/g
              52                                                  ralfdcp,&
              53                                                  rd,     &
              54                                                  g,      &
              55                                                  c4les,  &
              56                                                  c5les,  &
              57                                                  c4ies,  &
              58                                                  c5ies
              59                       USE mo_cumulus_flux, ONLY: lmfdudv, & ! true if cumulus friction is switched on
              60                                                  zdnoprc
              61                     
              62                     !-------------------------------------------------------------------
              63                           implicit none
              64                     !-------------------------------------------------------------------
              65                           integer  klon, klev, klevp1, klevm1,nxj,p650,jin
              66                           real     foeewm,foealfa
              67                           real     ptenh(klon,klev),       pqenh(klon,klev),&
              68                          &         pqsen(klon,klev),       pqsenh(klon,klev),&
              69                          &         pgeoh(klon,klevp1),     paph(klon,klevp1),&
              70                          &         pap(klon,klev),         pqen(klon,klev)
              71                           real     pten(klon,klev)

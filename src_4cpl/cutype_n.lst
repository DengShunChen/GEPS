             194     3   p                       is=is+1
             195     3   p    v               endif
             196     2   p    v            enddo
             197     1                     if(is.eq.0) exit
             198     1               
             199     1               ! the next levels, we use the variables at the first level as initial values
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 159
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      loflag, pgeo, eta, pgeoh, dz, coef
                                   <<<      ptenh, dhen, dh, pqu, pqenh, zqold
                                   <<<    PREFETCH(SOFT) : 8
                                   <<<     SEQUENTIAL : 8
                                   <<<      pqu: 2, paph: 2, ptu: 2, zph: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             200     2  pp    v             do jl = 1, nxj
             201     3   p    v            if(loflag(jl)) then
             202     3               !         eta(jl) = 0.55/((pgeoh(jl,jk)-pgeoh(jl,klev+1))*zrg)+1.0e-4
             203     3   p    v              eta(jl) = 0.8/(pgeo(jl,jk)*zrg)+2.e-4             !xb110, for more stable
             204     3   p    v              dz(jl)  = (pgeoh(jl,jk)-pgeoh(jl,jk+1))*zrg
             205     3   p    v              coef(jl)= 0.5*eta(jl)*dz(jl)
             206     3   p    v              dhen(jl,jk) = pgeoh(jl,jk) + cpd*ptenh(jl,jk)
             207     3   p    v              dh(jl,jk) = (coef(jl)*(dhen(jl,jk+1)+dhen(jl,jk))&
             208     3                    &              +(1.-coef(jl))*dh(jl,jk+1))/(1.+coef(jl))
             209     3   p    v              pqu(jl,jk) =(coef(jl)*(pqenh(jl,jk+1)+pqenh(jl,jk))&
             210     3                    &              +(1.-coef(jl))*pqu(jl,jk+1))/(1.+coef(jl))
             211     3   p    v              ptu(jl,jk) = (dh(jl,jk)-pgeoh(jl,jk))*rcpd
             212     3   p    v              zqold(jl) = pqu(jl,jk)
             213     3   p    v              zph(jl)=paph(jl,jk)
             214     3   p    v            end if
             215     2   p    v            end do
             216     1               ! check if the parcel is saturated
             217     1                     ik=jk
             218     1                     icall=1
             219     1                     call cuadjtq_n(nxj,klon,klev,ik,zph,ptu,pqu,loflag,icall)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      loflag
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 5  FILL 26
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             220     2   s    s              do jl = 1, nxj
             221     3   p    v              if( loflag(jl) ) then
             222     3   p    v                pqu(jl,jk) =max(pqu(jl,jk),0.) !xb110, to make sure that pqu is positive
             223     3   p    v                zdq = max((zqold(jl) - pqu(jl,jk)),0.)
             224     3   p    v                plu(jl,jk) = plu(jl,jk+1) + zdq
             225     3   s    s                zlglac=zdq*((1.-foealfa(ptu(jl,jk))) - &
             226     3                                     (1.-foealfa(ptu(jl,jk+1))))
             227     3   p    v                plu(jl,jk) = min(plu(jl,jk),5.e-3)

 External subroutine subprogram "rad_initialize"
  (inc)(line-no.)(nest)(optimize)
               1                     !-----------------------------------
               2                           subroutine rad_initialize                                         &
               3                     !...................................
               4                     !  ---  inputs:
               5                          &     ( si,levr,ictm,isol,ico2,iaer,ialb,iems,ntcw,                &
               6                          &       nmmiph,ntoz,iovr_sw,iovr_lw,isubc_sw,isubc_lw,             &
               7                          &       icliq_sw,icice_sw,icliq_lw,icice_lw,                       &
               8                          &       sashal,crick_proof,ccnorm,norad_precip,idate,iflip,me,myrank)
               9                     !  ---  outputs: ( none )
              10                     
              11                     ! =================   subprogram documentation block   ================ !
              12                     !                                                                       !
              13                     ! subprogram:   rad_initialize - a subprogram to initialize radiation   !
              14                     !                                                                       !
              15                     ! usage:        call rad_initialize                                     !
              16                     !                                                                       !
              17                     ! attributes:                                                           !
              18                     !   language:  fortran 90                                               !
              19                     !                                                                       !
              20                     ! program history:                                                      !
              21                     !   mar 2012  - yu-tai hou   create the program to initialize fixed     !
              22                     !                 control variables for radiaion processes.  this       !
              23                     !                 subroutine is called at the start of model run.       !
              24                     !   nov 2012  - yu-tai hou   modified control parameter through         !
              25                     !                 module 'physparam'.                                   !
              26                     !   mar 2014  - sarah lu  iaermdl is determined from iaer               !
              27                     !   jun 2014  - h-m lin/y-t hou   added run-time adjustable cloud       !
              28                     !                 optical property control parameters.                  !
              29                     !                                                                       !
              30                     !  ====================  defination of variables  ====================  !
              31                     !                                                                       !
              32                     ! input parameters:                                                     !
              33                     !   si               : model vertical sigma interface or equivalence    !
              34                     !   levr             : number of model vertical layers                  !
              35                     !   ictm             :=yyyy#, external data time/date control flag      !
              36                     !                     =   -2: same as 0, but superimpose seasonal cycle !
              37                     !                             from climatology data set.                !
              38                     !                     =   -1: use user provided external data for the   !
              39                     !                             forecast time, no extrapolation.          !
              40                     !                     =    0: use data at initial cond time, if not     !
              41                     !                             available, use latest, no extrapolation.  !
              42                     !                     =    1: use data at the forecast time, if not     !
              43                     !                             available, use latest and extrapolation.  !
              44                     !                     =yyyy0: use yyyy data for the forecast time,      !
              45                     !                             no further data extrapolation.            !
              46                     !                     =yyyy1: use yyyy data for the fcst. if needed, do !
              47                     !                             extrapolation to match the fcst time.     !
              48                     !   isol             := 0: use the old fixed solar constant in "physcon"!
              49                     !                     =10: use the new fixed solar constant in "physcon"!
              50                     !                     = 1: use noaa ann-mean tsi tbl abs-scale data tabl!
              51                     !                     = 2: use noaa ann-mean tsi tbl tim-scale data tabl!
              52                     !                     = 3: use cmip5 ann-mean tsi tbl tim-scale data tbl!
              53                     !                     = 4: use cmip5 mon-mean tsi tbl tim-scale data tbl!
              54                     !   ico2             :=0: use prescribed global mean co2 (old  oper)    !
              55                     !                     =1: use observed co2 annual mean value only       !
              56                     !                     =2: use obs co2 monthly data with 2-d variation   !
              57                     !   iaer             : 4-digit aerosol flag (dabc for aermdl,volc,lw,sw)!
              58                     !                     d: =0 or none, opac-climatology aerosol scheme    !
              59                     !                        =1 use gocart climatology aerosol scheme       !
              60                     !                        =2 use gocart progostic aerosol scheme         !
              61                     !                     a: =0 use background stratospheric aerosol        !
              62                     !                        =1 incl stratospheric vocanic aeros            !
              63                     !                     b: =0 no topospheric aerosol in lw radiation      !
              64                     !                        =1 include tropspheric aerosols for lw         !
              65                     !                     c: =0 no topospheric aerosol in sw radiation      !
              66                     !                        =1 include tropspheric aerosols for sw         !
              67                     !   ialb             : control flag for surface albedo schemes          !
              68                     !                     =0: climatology, based on surface veg types       !
              69                     !                     =1: modis retrieval based surface albedo scheme   !
              70                     !   iems             : ab 2-digit control flag                          !
              71                     !                     a: =0 set sfc air/ground t same for lw radiation  !
              72                     !                        =1 set sfc air/ground t diff for lw radiation  !
              73                     !                     b: =0 use fixed sfc emissivity=1.0 (black-body)   !
              74                     !                        =1 use varying climtology sfc emiss (veg based)!
              75                     !                        =2 future development (not yet)                !
              76                     !   ntcw             :=0 no cloud condensate calculated                 !
              77                     !                     >0 array index location for cloud condensate      !
              78                     !   nmmiph          :=3: ferrier's microphysics cloud scheme           !
              79                     !                     =4: zhao/carr/sundqvist microphysics cloud        !
              80                     !                     =5: WSM6 & Thompson microphysics cloud            !
              81                     !   ntoz             : ozone data control flag                          !
              82                     !                     =0: use climatological ozone profile              !
              83                     !                     >0: use interactive ozone profile                 !
              84                     !   iovr_sw/iovr_lw  : control flag for cloud overlap (sw/lw rad)       !
              85                     !                     =0: random overlapping clouds                     !
              86                     !                     =1: max/ran overlapping clouds                    !
              87                     !   isubc_sw/isubc_lw: sub-column cloud approx control flag (sw/lw rad) !
              88                     !                     =0: with out sub-column cloud approximation       !
              89                     !                     =1: mcica sub-col approx. prescribed random seed  !
              90                     !                     =2: mcica sub-col approx. provided random seed    !
              91                     !   icliq_sw         : sw liq-cloud opt prop contol flag (sw rad)       !
              92                     !                     =0: diag cld opt depth input, ignore icice_sw.    !
              93                     !                     =1: hu & stamnes method for sw liq-cld opt prop.  !
              94                     !   icice_sw         : sw ice-cloud opt prop contol flag (sw rad)       !
              95                     !                     =1: ebert & curry method for sw ice-cld opt prop. !
              96                     !                     =2: streamer v3.0 method for sw ice-cld opt prop. !
              97                     !                     =3: fu method for sw ice-cld opt prop.            !
              98                     !   icliq_lw         : lw liq-cloud opt prop contol flag (lw rad)       !
              99                     !                     =0: diag cld opt depth input, ignore icice_lw.    !
             100                     !                     =1: hu & stamnes method for lw liq-cld opt prop.  !
             101                     !   icice_lw         : lw ice-cloud opt prop contol flag (lw rad)       !
             102                     !                     =1: ebert & curry method for lw ice-cld opt prop. !
             103                     !                     =2: streamer method for lw ice-cld opt prop.      !
             104                     !                     =3: fu method for lw ice-cld opt prop.            !
             105                     !   sashal           : shallow convection scheme flag                   !
             106                     !   crick_proof      : control flag for eliminating CRICK               !
             107                     !   ccnorm           : control flag for in-cloud condensate mixing ratio!
             108                     !   norad_precip     : control flag for not using precip in radiation   !
             109                     !   idate(8)         : ncep absolute date and time of initial condition !
             110                     !                      (hour, month, day, year)                         !
             111                     !   iflip            : control flag for direction of vertical index     !
             112                     !                     =0: index from toa to surface                     !
             113                     !                     =1: index from surface to toa                     !
             114                     !   me               : print control flag                               !
             115                     !                                                                       !
             116                     !  subroutines called: radinit                                          !
             117                     !                                                                       !
             118                     !  ===================================================================  !
             119                     !
             120                           use physpara , only : isolar , ictmflg, ico2flg, ioznflg, iaerflg,&
             121                          &             iaermdl, laswflg, lalwflg, lavoflg, icldflg, icmphys,&
             122                          &             iovrsw , iovrlw , lsashal, lcrick , lcnorm , lnoprec,&
             123                          &             ialbflg, iemsflg, isubcsw, isubclw, ivflip , ipsd0,  &
             124                          &             kind_phys, iswcliq, iswcice, ilwcliq, ilwcice
             125                           use const,     only : pdfcloud
             126                     
             127                           use module_radiation_driver, only : radinit
             128                     !
             129                     
             130                           implicit   none
             131                     
             132                     
             133                     !  ---  input:
             134                           integer,  intent(in) :: levr, ictm, isol, ico2, iaer,             &
             135                          &       ntcw, ialb, iems, nmmiph, ntoz, iovr_sw, iovr_lw,          &
             136                          &       icliq_sw,icice_sw,icliq_lw,icice_lw,                       &
             137                          &       isubc_sw, isubc_lw, iflip, me, idate(8),myrank
             138                     
             139                           real (kind=kind_phys), intent(in) :: si(levr+1)
             140                     
             141                           logical, intent(in) :: sashal, crick_proof, ccnorm, norad_precip
             142                     
             143                     !  ---  output: ( none )
             144                     
             145                     !  ---  local:
             146                           integer :: icld
             147                     !
             148                     !===> ...  start here
             149                     !
             150                     !  ---  set up parameters for radiation initialization
             151                     
             152                           isolar = isol                     ! solar constant control flag
             153                     
             154                           ictmflg= ictm                     ! data ic time/date control flag
             155                           ico2flg= ico2                     ! co2 data source control flag
             156                           ioznflg= ntoz                     ! ozone data source control flag
             157                     
             158     1                     if ( ictm==0 .or. ictm==-2 ) then
             159     1                       iaerflg = mod(iaer, 100)        ! no volcanic aerosols for clim hindcast
             160     1                     else
             161     1                       iaerflg = mod(iaer, 1000)
             162     1                     endif
             163                           laswflg= (mod(iaerflg,10) > 0)    ! control flag for sw tropospheric aerosol
             164                           lalwflg= (mod(iaerflg/10,10) > 0) ! control flag for lw tropospheric aerosol
             165                           lavoflg= (iaerflg >= 100)         ! control flag for stratospheric volcanic aeros
             166                           iaermdl = iaer/1000               ! control flag for aerosol scheme selection
             167     1                     if ( iaermdl < 0 .or.  iaermdl > 2) then
             168     1                     if (myrank.eq.0) print *, ' Error -- IAER flag is incorrect, Abort'
             169     1                        stop 7777
             170     1                     endif
             171                     
             172     1                     if ( ntcw > 0 ) then
             173     1                       icldflg = 1                     ! prognostic cloud optical prop scheme
             174     1               
             175     2                       if ( nmmiph == 2 ) then
             176     3                         if ( pdfcloud ) then
             177     3                           icmphys = 3                 ! zhao/moorthi's prognostic with PDF cloud scheme
             178     3                         else
             179     3                           icmphys = 1                 ! zhao/moorthi's prognostic cloud scheme
             180     3                         endif
             181     2                       elseif ( nmmiph == 3 ) then
             182     2                         icmphys = 2                   ! ferrier's microphysics
             183     2                       elseif ( nmmiph == 6 ) then
             184     2                         icmphys = 6                   ! WSM6 microphysics
             185     2                       elseif ( nmmiph == 8 ) then
             186     2                         icmphys = 8                   ! Thompson microphysics
             187     2                       elseif ( nmmiph == 18 ) then
             188     2                         icmphys = 18                  ! 2M Thompson microphysics
             189     2                       elseif ( nmmiph == 11 ) then
             190     2                         icmphys = 11                  ! GFDL microphysics version 1
             191     2                       elseif ( nmmiph == 12 ) then
             192     2                         icmphys = 12                  ! GFDL microphysics version 2
             193     2                       elseif ( nmmiph == 13 ) then
             194     2                         icmphys = 13                  ! GFDL microphysics version 3
             195     2                       elseif ( nmmiph == 15 ) then
             196     2                         icmphys = 15                  ! Goddard (GCE) 3ICE microphysics
             197     2                       elseif ( nmmiph == 16 ) then
             198     2                         icmphys = 16                  ! Goddard (GCE) 4ICE microphysics
             199     2                       endif
             200     1                     else
             201     1                       icldflg = 0                     ! diagnostic cloud optical prop scheme
             202     1                     endif
             203                           iovrsw = iovr_sw                  ! cloud overlapping control flag for sw
             204                           iovrlw = iovr_lw                  ! cloud overlapping control flag for lw
             205                     
             206                           lsashal = sashal                  ! shallow convection scheme flag
             207                           lcrick  = crick_proof             ! control flag for eliminating CRICK
             208                           lcnorm  = ccnorm                  ! control flag for in-cld condensate
             209                           lnoprec = norad_precip            ! precip effect on radiation flag (ferrier microphysics)
             210                           isubcsw = isubc_sw                ! sub-column cloud approx flag in sw radiation
             211                           isubclw = isubc_lw                ! sub-column cloud approx flag in lw radiation
             212                           iswcliq = icliq_sw                ! sw liq-cld opt prop scheme flag in sw radiation
             213                           iswcice = icice_sw                ! sw ice-cld opt prop scheme flag in sw radiation
             214                           ilwcliq = icliq_lw                ! lw liq-cld opt prop scheme flag in lw radiation
             215                           ilwcice = icice_lw                ! lw ice-cld opt prop scheme flag in lw radiation
             216                     
             217                           ialbflg= ialb                     ! surface albedo control flag
             218                           iemsflg= iems                     ! surface emissivity control flag
             219                     
             220                           ivflip = iflip                    ! vertical index direction control flag
             221                     
             222                     !  ---  assign initial permutation seed for mcica cloud-radiation
             223     1                     if ( isubc_sw>0 .or. isubc_lw>0 ) then
             224     1               !       ipsd0 = 17*idate(1)+43*idate(2)+37*idate(3)+23*idate(4) + ipsd0
             225     1                       ipsd0 = 17*idate(5)+43*idate(2)+37*idate(3)+23*idate(1)
             226     1                     endif
             227                     
             228     1                     if ( me == 0 .and. myrank == 0 ) then
             229     1                       print *,'  In rad_initialize, before calling radinit'
             230     1                       print *,' si =',si
             231     1                       print *,' levr=',levr,' ictm=',ictm,' isol=',isol,' ico2=',ico2,&
             232     1                               ' iaer=',iaer,' ialb=',ialb,' iems=',iems,' ntcw=',ntcw
             233     1                       print *,' nmmiph=',nmmiph,' ntoz=',ntoz,' iovr_sw=',iovr_sw,    &
             234     1                               ' iovr_lw=',iovr_lw,' isubc_sw=',isubc_sw,              &
             235     1                               ' isubc_lw=',isubc_lw,' iflip=',iflip,'  me=',me
             236     1                       print *,' sashal=',sashal,' crick_proof=',crick_proof,          &
             237     1                               ' ccnorm=',ccnorm,' norad_precip=',norad_precip
             238     1                     endif
             239                     
             240                           call radinit                                                      &
             241                     !  ---  inputs:
             242                          &     (  si, levr, me, myrank )
             243                     !  ---  outputs:
             244                     !          ( none )
             245                     
             246     1                     if ( me == 0  .and. myrank  == 0 ) then
             247     1                       print *,'  Radiation sub-cloud initial seed =',ipsd0,           &
             248     1                    &          ' IC-idate =',idate
             249     1                       print *,' return from rad_initialize - after calling radinit'
             250     1                     endif
             251                     !
             252                           return
             253                     !...................................
             254                           end subroutine rad_initialize
             255                     !-----------------------------------


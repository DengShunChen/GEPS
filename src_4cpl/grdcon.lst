 External subroutine subprogram "grdcon"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine grdcon ( mn,tg,gwet,czh,land,ocean,snow,ice,tice &
               2                                             , as,snr )
               3                     !
               4                     !***********************************************************************
               5                     !            subroutine description
               6                     !
               7                     ! 1. function description
               8                     !
               9                     !    this subroutine deterime ground condition, then depending on
              10                     !    the condition to calculate thermal capacity (czh) and diffusion
              11                     !    albedo (as).
              12                     !
              13                     ! 2. parameter specification
              14                     !
              15                     !    mn : dimension of horizontal-direction                          i
              16                     !    tg : ground temperature                            (mn)   (k)   i/o
              17                     !  gwet : ground wetness(water volume/soil space volume (mn)         i/o
              18                     !   czh : soil thermal capacity                         (mn)  (j/m2k)o
              19                     !  land : logic for bare soil land                      (mn)         i
              20                     !  ocean: logic for open water   (=true for open water) (mn)         i
              21                     !  snow : logic for snow covered area                   (mn)         o
              22                     !   ice : logic for ice covered area                    (mn)         i
              23                     !  tice : temperature of melting point                  (mn)   (k)   i
              24                     !    as : diffusion albedo                              (mn)         o
              25                     !   snr : snow depth in water state                     (mn)   (mm)  i/o
              26                     !
              27                     ! 3. local variable
              28                     !
              29                     ! 4. calling modules
              30                     !
              31                     !    pbltke
              32                     !
              33                     ! 5. usage
              34                     !
              35                     !    call grdcon ( mn,tg,gwet,czh,land,ocean,snow,ice,tice,as,snr )
              36                     !
              37                     ! 6. modules called
              38                     !
              39                     ! 7. limitation
              40                     !
              41                     ! 8. date
              42                     !
              43                     !    created    feb. 1992
              44                     !    modified   may  1993
              45                     !
              46                     ! 9. author
              47                     !
              48                     !    f. wang,  c.s. liou
              49                     !    modify to f90 by C-H Lee and sort by River Chen in 2015
              50                     !
              51                     !10. reference
              52                     !#######################################################################
              53                           implicit  none
              54                     !
              55                     !  input & ouput variable
              56                           integer   mn
              57                           real      tice
              58                           real      tg(mn),gwet(mn),czh(mn),as(mn),snr(mn)
              59                           logical   land(mn),ocean(mn),snow(mn),ice(mn)
              60                     !
              61                     !----------------------------------------------------------------------
              62                           integer   i
              63                           real      pi,frday,wet
              64                     !
              65                           pi    = 3.141592654
              66                           frday = 2.0*pi/86400.0
              67                     !
              68                     !----------------------------------------------------------------------
              69                     ! determine ground condition by
              70                     !  from data base:
              71                     !    ocean            for open water
              72                     !    land             for bare land
              73                     !    ice              for ice (seaice & land ice)
              74                     ! from snow depth:
              75                     !    snow             check if (snr .gt. 0.) on land and ice
              76                     !                     when snr >0.   land(or ice) become snow
              77                     !
              78                     !----------------------------------------------------------------------
              79                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 291
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 80,96)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      snr, land, snow, as, ice, gwet, czh
                                   <<< Loop-information  End >>>
              80     1  pp    v            do 400 i = 1, mn
              81     1   p    v              snow(i) = land(i) .and. (snr(i).gt.0.0)
              82     1               !xx     snow(i) = (land(i).or.ice(i)).and.(snr(i).gt.0.)
              83     1   p    v       400  continue
              84                     !
              85                     ! ---------------------------------------------------------------------
              86                     !   determine czh and as ,depending on ground condiction.
              87                     !        czh is soil thermal capacity (j/m2/k)
              88                     !        as is albedo
              89                     !
              90                     !              czh : rho(kg/m3) *cp(j/kgk) *h(m)]
              91                     !              h   : effective thickness (=sqrt(2ks/w))
              92                     !              ks  : thermal diffusivity of soil
              93                     !              w   : frequency (=2pi/86400)
              94                     !----------------------------------------------------------------------
              95                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
              96     1                     do 500 i = 1, mn
              97     2                       if (snow(i)) then
              98     2                         as(i)  = 0.7
              99     2                         czh(i) = 4.2e4*2.3
             100     2                       else if (ice(i)) then
             101     2                         czh(i) = 4.2e4*5.1
             102     2                       else if (land(i)) then
             103     2                         wet = gwet(i)
             104     2                         if (wet.le.1.e-10)  wet = 0.0
             105     2               !xxx      if (tg(i).le.tice)  wet = min( wet,0.01 )
             106     2                         czh(i)= 4.2e4*sqrt( (0.387+0.15*wet)*(1.+wet)*2.e-3/frday )
             107     2                       endif
             108     1                500  continue
             109                     !
             110                           return
             111                           end


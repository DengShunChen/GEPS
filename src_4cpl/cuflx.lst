              99     1  pp   2v        DO jl = 1, nxj
             100     1               !    itop = MIN(itop,kctop(jl))
             101     1   p   2v          IF ( .NOT. ldcum(jl) .OR. kdtop(jl)<kctop(jl)) lddraf(jl) = .FALSE.
             102     1   p   2v          IF ( .NOT. ldcum(jl)) ktype(jl) = 0
             103     1   p   2v        END DO
             104                     !  ktopm2 = itop - 2
             105                       ktopm2 = 2
                                   <<< Loop-information Start >>>

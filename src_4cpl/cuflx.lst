                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      pdmfdp: 4
                                   <<< Loop-information  End >>>
             106     1  pp             DO jk = ktopm2, klev
             107     1               !DIR$ IVDEP
             108     1               !OCL NOVREC
             109     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.10, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmfus, pmfdq, pmfds, pmfd, kctop, pgeoh
                                   <<<      lddraf, ptenh, pqenh, pmfu, pmfuq, plude

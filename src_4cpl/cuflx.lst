                                   <<< Loop-information  End >>>
             166     1                 DO jk = ktopm2, klev
             167     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 196
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.47, ITR: 40, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdmfdp, prfl, prain, pten, psfl, pdpmel
                                   <<<      pdmfup, paphp1, ldcum
                                   <<< Loop-information  End >>>
             168     2  pp    v          DO jl = 1, nxj
             169     3   p    v            IF (ldcum(jl)) THEN
             170     3   p    v              prain(jl) = prain(jl) + pdmfup(jl,jk)
             171     4   p    v              IF (pten(jl,jk)>tmelt) THEN
             172     4   p    v                prfl(jl) = prfl(jl) + pdmfup(jl,jk) + pdmfdp(jl,jk)
             173     5   p    v                IF (psfl(jl)>0. .AND. pten(jl,jk)>ztmelp2) THEN
             174     5   p    v                  zfac = zcons1*(paphp1(jl,jk+1)-paphp1(jl,jk))
             175     5   p    v                  zsnmlt = MIN(psfl(jl),zfac*(pten(jl,jk)-ztmelp2))
             176     5   p    v                  pdpmel(jl,jk) = zsnmlt
             177     5   p    v                  psfl(jl) = psfl(jl) - zsnmlt
             178     5   p    v                  prfl(jl) = prfl(jl) + zsnmlt
             179     5   p    v                END IF
             180     4   p    v              ELSE
             181     4   p    v                psfl(jl) = psfl(jl) + pdmfup(jl,jk) + pdmfdp(jl,jk)
             182     4   p    v              END IF
             183     3   p    v            END IF
             184     2   p    v          END DO
             185     1                 END DO
             186                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      psfl, prfl, zpsubcl
                                   <<< Loop-information  End >>>
             187     1  pp   2v        DO jl = 1, nxj
             188     1   p   2v          prfl(jl) = MAX(prfl(jl),0.)
             189     1   p   2v          psfl(jl) = MAX(psfl(jl),0.)
             190     1   p   2v          zpsubcl(jl) = prfl(jl) + psfl(jl)
             191     1   p   2v        END DO
             192     1                 DO jk = ktopm2, klev
             193     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 147
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum
                                   <<< Loop-information  End >>>
             194     2  pp    s          DO jl = 1, nxj
             195     3   p    m            IF (ldcum(jl) .AND. jk>=kcbot(jl) .AND. zpsubcl(jl)>1.E-20) THEN
             196     3   p    s              zrfl = zpsubcl(jl)
             197     3   p    s              zrnew = (MAX(0.,SQRT(zrfl/zcucov)-cevapcu(jk)*(paphp1(jl,jk+1)- &
             198     3                               paphp1(jl,jk))*MAX(0.,pqsen(jl,jk)-pqen(jl,jk))))**2*zcucov
             199     3   p    s              zrmin = zrfl - zcucov*MAX(0.,0.8*pqsen(jl,jk)-pqen(jl,jk))*zcons2* &
             200     3                               (paphp1(jl,jk+1)-paphp1(jl,jk))
             201     3   p    s              zrnew = MAX(zrnew,zrmin)
             202     3   p    s              zrfln = MAX(zrnew,0.)
             203     3   p    s              zdrfl = MIN(0.,zrfln-zrfl)
             204     3   p    s              pdmfup(jl,jk) = pdmfup(jl,jk) + zdrfl
             205     3   p    s              zpsubcl(jl) = zrfln
             206     3   p    v            END IF
             207     2   p    v          END DO
             208     1                 END DO
             209                     
             210                         ! ------ CORRECTION OF PRECIPITATION EVAPORATION ERROR (AMIP2) --------
             211                         !                (Found by M. Werner)
             212                     !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zpsubcl, psfl, prfl
                                   <<< Loop-information  End >>>
             213     1  pp    v          DO jl = 1, nxj
             214     1   p    v            zrsum    = prfl(jl)+psfl(jl)
             215     1   p    v            zdpevap  = zpsubcl(jl) - zrsum
             216     1   p    v            prfl(jl) = prfl(jl) + zdpevap*prfl(jl)*(1./MAX(1.d-20,zrsum))
             217     1   p    v            psfl(jl) = psfl(jl) + zdpevap*psfl(jl)*(1./MAX(1.d-20,zrsum))
             218     1   p    v          END DO
             219                     
             220                       RETURN
             221                     END SUBROUTINE cuflx


              82                       !  Executable statements
              83                     
              84                       !  eta level for CAM
              85                     ! cevapcu(:)=1.93E-6*261.*SQRT(1.E3/(38.3*0.293)*SQRT(hyam(:)+hybm(:)))*0.5/g
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cevapcu
                                   <<< Loop-information  End >>>
              86        pp   4v         cevapcu(:)= 0.
              87                       !  Specify constants
              88                       ztmst = ztodt*0.5
              89                     ! IF (is_first_step()) ztmst = 0.5*ztodt
              90                       zcons1 = cpd/(alf*g*ztmst)
              91                       zcons2 = 1./(g*ztmst)
              92                       zcucov = 0.05
              93                       ztmelp2 = tmelt + 2.
              94                     
              95                     !-- 1. Determine final convective fluxes
              96                     
              97                     !  itop = klev
              98                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)

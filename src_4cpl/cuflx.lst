                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      pdmfdp: 4
                                   <<< Loop-information  End >>>
             110     2   p    v          DO jl = 1, nxj
             111     3   p    v            IF (ldcum(jl) .AND. jk>=kctop(jl)-1) THEN
             112     3   p    v              pmfus(jl,jk) = pmfus(jl,jk) - pmfu(jl,jk)*(cpd*ptenh(jl,jk)+pgeoh(jl,jk))
             113     3   p    v              pmfuq(jl,jk) = pmfuq(jl,jk) - pmfu(jl,jk)*pqenh(jl,jk)
             114     4   p    v              IF (lddraf(jl) .AND. jk>=kdtop(jl)) THEN
             115     4   p    v                pmfds(jl,jk) = pmfds(jl,jk) - pmfd(jl,jk)*(cpd*ptenh(jl,jk)+pgeoh(jl,jk))
             116     4   p    v                pmfdq(jl,jk) = pmfdq(jl,jk) - pmfd(jl,jk)*pqenh(jl,jk)
             117     4   p    v              ELSE
             118     4   p    v                pmfd(jl,jk) = 0.
             119     4   p    v                pmfds(jl,jk) = 0.
             120     4   p    v                pmfdq(jl,jk) = 0.
             121     4   p    v                pdmfdp(jl,jk-1) = 0.
             122     4   p    v              END IF
             123     3   p    v            ELSE
             124     3   p    v              pmfu(jl,jk) = 0.
             125     3   p    v              pmfd(jl,jk) = 0.
             126     3   p    v              pmfus(jl,jk) = 0.
             127     3   p    v              pmfds(jl,jk) = 0.
             128     3   p    v              pmfuq(jl,jk) = 0.
             129     3   p    v              pmfdq(jl,jk) = 0.
             130     3   p    v              pmful(jl,jk) = 0.
             131     3   p    v              pdmfup(jl,jk-1) = 0.
             132     3   p    v              pdmfdp(jl,jk-1) = 0.
             133     3   p    v              plude(jl,jk-1) = 0.
             134     3   p    v            END IF
             135     2   p    v          END DO
             136     1               
             137     1   p             END DO
             138     1                 DO jk = ktopm2, klev
             139     1               !DIR$ IVDEP
             140     1               !OCL NOVREC
             141     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 206
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum
                                   <<< Loop-information  End >>>
             142     2  pp    s          DO jl = 1, nxj
             143     3   p    m            IF (ldcum(jl) .AND. jk>kcbot(jl)) THEN
             144     3   p    s              ikb = kcbot(jl)
             145     3   p    s              zzp = ((paphp1(jl,klevp1)-paphp1(jl,jk))/(paphp1(jl,klevp1)-paphp1(jl,ikb)))
             146     3   p    s              zzp = MERGE(zzp**2,zzp,ktype(jl)==3)
             147     3   p    s              pmfu(jl,jk) = pmfu(jl,ikb)*zzp
             148     3   p    s              pmfus(jl,jk) = pmfus(jl,ikb)*zzp
             149     3   p    s              pmfuq(jl,jk) = pmfuq(jl,ikb)*zzp
             150     3   p    s              pmful(jl,jk) = pmful(jl,ikb)*zzp
             151     3   p    v            END IF
             152     2   p    v          END DO
             153     1               
             154     1                 END DO
             155                     
             156                     !-- 2. Calculate rain/snow fall rates
             157                     !      Calculate melting of snow
             158                     !      Calculate evaporation of precip
             159                     
             160                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prfl, psfl, prain
                                   <<< Loop-information  End >>>

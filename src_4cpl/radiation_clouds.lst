            1534                     !-----------------------------------
            1535                           subroutine progcld4                                               &
            1536                          &     ( plyr,plvl,tlyr,qlyr,qstl,rhly,clw,                         &    !  ---  inputs:
            1537                          &       xlat,xlon,slmsk,                                           &
            1538                          &       ntrac,ntcw,ntiw,ntrw,ntsw,ntgl,                            &
            1539                          &       ix, nlay, nlp1,                                            &
            1540                          &       uni_cld, lmfshal, lmfdeep2, cldcov,                        &
            1541                          &       re_cloud,re_ice,re_snow,                                   &
            1542                          &       clouds,clds,mtop,mbot                                      &    !  ---  outputs:
            1543                          &      )
            1544                     
            1545                     ! =================   subprogram documentation block   ================ !
            1546                     !                                                                       !
            1547                     ! subprogram:    progcld4    computes cloud related quantities using    !
            1548                     !   Thompson/WSM6 cloud microphysics scheme.                !
            1549                     !                                                                       !
            1550                     ! abstract:  this program computes cloud fractions from cloud           !
            1551                     !   condensates,                                                        !
            1552                     !   and computes the low, mid, high, total and boundary layer cloud     !
            1553                     !   fractions and the vertical indices of low, mid, and high cloud      !
            1554                     !   top and base.  the three vertical cloud domains are set up in the   !
            1555                     !   initial subroutine "cld_init".                                      !
            1556                     !                                                                       !
            1557                     ! usage:         call progcld4                                          !
            1558                     !                                                                       !
            1559                     ! subprograms called:   gethml                                          !
            1560                     !                                                                       !
            1561                     ! attributes:                                                           !
            1562                     !   language:   fortran 90                                              !
            1563                     !   machine:    ibm-sp, sgi                                             !
            1564                     !                                                                       !
            1565                     !                                                                       !
            1566                     !  ====================  definition of variables  ====================  !
            1567                     !                                                                       !
            1568                     ! input variables:                                                      !
            1569                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            1570                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            1571                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            1572                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            1573                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            1574                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            1575                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            1576                     !   clw   (IX,NLAY,ntrac) : layer cloud condensate amount               !
            1577                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            1578                     !                     range, otherwise see in-line comment              !
            1579                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            1580                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            1581                     !   IX              : horizontal dimention                              !
            1582                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            1583                     !   uni_cld         : logical - true for cloud fraction from shoc       !
            1584                     !   lmfshal         : logical - true for mass flux shallow convection   !
            1585                     !   lmfdeep2        : logical - true for mass flux deep convection      !
            1586                     !   cldcov          : layer cloud fraction (used when uni_cld=.true.    !
            1587                     !                                                                       !
            1588                     ! output variables:                                                     !
            1589                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            1590                     !      clouds(:,:,1) - layer total cloud fraction                       !
            1591                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            1592                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            1593                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            1594                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            1595                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            1596                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            1597                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            1598                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !

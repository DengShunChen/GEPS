            3943                     
            3944                           integer :: i, j, k, klowt
            3945                     !     integer :: klowb
            3946                     
            3947                           logical :: notstop
            3948                     
            3949                     !
            3950                     !===> ... begin here
            3951                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            3952        pp   4             clouds(:,:,:) = 0.0
            3953                     
            3954                           tem1 = 180.0 / con_pi
            3955                     
            3956     1                     lab_do_i_ix : do i = 1, ix
            3957     1               
            3958     1                       xlatdg = xlat(i) * tem1                    ! if xlat in pi/2 -> -pi/2 range
            3959     1               !       xlatdg = 90.0 - xlat(i)*tem1               ! if xlat in 0 -> pi range
            3960     1               
            3961     1                       xlondg = xlon(i) * tem1
            3962     1                       if (xlondg < 0.0) xlondg = xlondg + 360.0  ! if in -180->180, chg to 0->360 range
            3963     1               
            3964     1                       ireg = 4
            3965     1               
            3966     1               !  ---  get rh-cld relation for this lat
            3967     1               
                                   <<< Loop-information Start >>>

            3841                           subroutine diagcld1                                               &
            3842                     !...................................
            3843                     
            3844                     !  ---  inputs:
            3845                          &     ( plyr,plvl,tlyr,rhly,vvel,cv,cvt,cvb,                       &
            3846                          &       xlat,xlon,slmsk,                                           &
            3847                          &       ix, nlay, nlp1,                                            &
            3848                     !  ---  outputs:
            3849                          &       clouds,clds,mtop,mbot                                      &
            3850                          &      )
            3851                     
            3852                     ! =================   subprogram documentation block   ================ !
            3853                     !                                                                       !
            3854                     ! subprogram:    diagcld1    computes cloud fractions for radiation     !
            3855                     !   calculations.                                                       !
            3856                     !                                                                       !
            3857                     ! abstract:  clouds are diagnosed from layer relative humidity, and     !
            3858                     !   estimate cloud optical depth from temperature and layer thickness.  !
            3859                     !   then computes the low, mid, high, total and boundary layer cloud    !
            3860                     !   fractions and the vertical indices of low, mid, and high cloud top  !
            3861                     !   and base.  the three vertical cloud domains are set up in the       !
            3862                     !   initial subroutine "cld_init".                                      !
            3863                     !                                                                       !
            3864                     ! usage:         call diagcld1                                          !
            3865                     !                                                                       !
            3866                     ! subprograms called:   gethml                                          !
            3867                     !                                                                       !
            3868                     ! attributes:                                                           !
            3869                     !   language:   fortran 90                                              !
            3870                     !   machine:    ibm-sp, sgi                                             !
            3871                     !                                                                       !
            3872                     !                                                                       !
            3873                     !  ====================  defination of variables  ====================  !
            3874                     !                                                                       !
            3875                     ! input variables:                                                      !
            3876                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
            3877                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
            3878                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
            3879                     !   rhly  (ix,nlay) : layer relative humidity                           !
            3880                     !   vvel  (ix,nlay) : layer mean vertical velocity in mb/sec            !
            3881                     !   clw   (ix,nlay) : layer cloud condensate amount         (not used)  !
            3882                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
            3883                     !                     range, otherwise see in-line comment              !
            3884                     !   xlon  (ix)      : grid longitude in radians, ok for both 0->2pi or  !
            3885                     !                     -pi -> +pi ranges                                 !
            3886                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            3887                     !   cv    (ix)      : fraction of convective cloud                      !
            3888                     !   cvt, cvb (ix)   : conv cloud top/bottom pressure in mb              !
            3889                     !   ix              : horizontal dimention                              !
            3890                     !   nlay,nlp1       : vertical layer/level dimensions                   !
            3891                     !                                                                       !
            3892                     ! output variables:                                                     !
            3893                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
            3894                     !      clouds(:,:,1) - layer total cloud fraction                       !
            3895                     !      clouds(:,:,2) - layer cloud optical depth                        !
            3896                     !      clouds(:,:,3) - layer cloud single scattering albedo             !
            3897                     !      clouds(:,:,4) - layer cloud asymmetry factor                     !
            3898                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            3899                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
            3900                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
            3901                     !                                                                       !
            3902                     ! external module variables:                                            !
            3903                     !   ivflip          : control flag of vertical index direction          !
            3904                     !                     =0: index from toa to surface                     !
            3905                     !                     =1: index from surface to toa                     !
            3906                     !                                                                       !
            3907                     !  ====================    end of description    =====================  !
            3908                     !
            3909                           implicit none
            3910                     
            3911                     !  ---  inputs
            3912                           integer,  intent(in) :: ix, nlay, nlp1
            3913                     
            3914                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            3915                          &       tlyr, rhly, vvel
            3916                     
            3917                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            3918                          &       slmsk, cv, cvt, cvb
            3919                     
            3920                     !  ---  outputs
            3921                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            3922                     
            3923                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            3924                     
            3925                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            3926                     
            3927                     !  ---  local variables:
            3928                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
            3929                          &       cldtau, taufac, dthdp, tem2d
            3930                     
            3931                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
            3932                     
            3933                           real (kind=kind_phys) :: cr1, cr2, crk, pval, cval, omeg, value,  &
            3934                          &       tem1, tem2
            3935                     
            3936                           integer, dimension(ix):: idom, kcut
            3937                     
            3938                     !  ---  for rh-cl calculation

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            4057     2   p   2               do i = 1, ix
            4058     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            4059     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            4060     2               
            4061     2   p   2                 ptop1(i,j) = ptopc(j,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            4062     2   p   2               enddo
            4063     1   p                 enddo
            4064                     
            4065                     !  ---  stratiform cloud optical depth
            4066                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 4067,4080)
                                   <<< Loop-information  End >>>
            4067     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 4068,4081)

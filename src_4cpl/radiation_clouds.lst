            3815                     !> -# Call gethml() to compute low,mid,high,total, and boundary layer
            3816                     !!    cloud fractions and clouds top/bottom layer indices for low, mid,
            3817                     !!    and high clouds.
            3818                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            3819                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            3820                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            3821                     !       overlapping method is defined by control flag 'iovr', which may
            3822                     !       be different for lw and sw radiation programs.
            3823                     
            3824                           call gethml                                                       &
            3825                     !  ---  inputs:
            3826                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            3827                          &       IX,NLAY,                                                   &
            3828                     !  ---  outputs:
            3829                          &       clds, mtop, mbot                                           &
            3830                          &     )
            3831                     
            3832                     
            3833                     !
            3834                           return
            3835                     !...................................
            3836                           end subroutine progclduni

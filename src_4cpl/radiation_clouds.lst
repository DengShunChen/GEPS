                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhcl, rhcla
                                   <<< Loop-information  End >>>
            3976     3   p                     do ic = 1, mcld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SOFTWARE PIPELINING(IPC: 1.83, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhcla, rhcl
                                   <<< Loop-information  End >>>
            3977     4   p   4                   do il = 1, nlon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            3978     5   p   4                     do ib = 1, nbin
            3979     5   p   4                       rhcla(ib,il,ic,is) = rhcl(ib,il,ireg,ic,is)
            3980     5   p   4                     enddo
            3981     4   p   4                   enddo
            3982     3   p                     enddo
            3983     2   p                   enddo
            3984     1               
            3985     1               !  ---  linear transition between latitudinal regions...
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3986     2       f               do j = 1, 3
            3987     2       f                 xlnn = xlabdy(j) + xlim
            3988     2       f                 xlss = xlabdy(j) - xlim
            3989     2               
            3990     3       f                 if (xlatdg < xlnn .and. xlatdg > xlss) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3991     4  pp   f                   do is = 1, nseal
                                   <<< Loop-information Start >>>

            3775     3   p                     do i = 1, IX
            3776     3   p                       tem2 = tlyr(i,k) - con_ttp
            3777     3               
            3778     4   p                       if (cip(i,k) > 0.0) then
            3779     4   p                         tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            3780     4               
            3781     5   p                         if (tem2 < -50.0) then
            3782     5   p                           rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            3783     5   p                         elseif (tem2 < -40.0) then
            3784     5   p                           rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            3785     5   p                         elseif (tem2 < -30.0) then
            3786     5   p                           rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            3787     5   p                         else
            3788     5   p                           rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            3789     5   p                         endif
            3790     4               !             rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            3791     4               !             rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            3792     4   p                         rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            3793     4               !             rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            3794     4   p                       endif
            3795     3   p                     enddo
            3796     2   p                   enddo
            3797     1                     endif

            3760     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            3761     4   p                         cwp(i,k) = cwp(i,k) * tem1
            3762     4   p                         cip(i,k) = cip(i,k) * tem1
            3763     4   p                         crp(i,k) = crp(i,k) * tem1
            3764     4   p                         csp(i,k) = csp(i,k) * tem1
            3765     4   p                       endif
            3766     3   p                     enddo
            3767     2   p                   enddo
            3768     1                     endif
            3769                     
            3770                     !> -# Compute effective ice cloud droplet radius following Heymsfield
            3771                     !!    and McFarquhar (1996) \cite heymsfield_and_mcfarquhar_1996.
            3772                     
            3773     1                     if(.not. effr_in) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3774     2  pp                   do k = 1, NLAY

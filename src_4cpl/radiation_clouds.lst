                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            4406                           where (cldtot < climit .and. cldcnv < climit)
            4407                             cldtau = 0.0
            4408                           endwhere
            4409                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtau, taufac, cldtot, cldcnv
                                   <<< Loop-information  End >>>
            4410     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 4, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtau, taufac, cldtot, cldcnv
                                   <<< Loop-information  End >>>
            4411     2   p                   do i = 1, ix
            4412     2   p                     clouds(i,k,1) = max(cldtot(i,k), cldcnv(i,k))
            4413     2   p                     clouds(i,k,2) = cldtau(i,k) * taufac(i,k)
            4414     2   p                     clouds(i,k,3) = cldssa_def
            4415     2   p                     clouds(i,k,4) = cldasy_def
            4416     2   p                   enddo
            4417     1   p                 enddo
            4418                     
            4419                     !
            4420                     !===> ... compute low, mid, high, total, and boundary layer cloud fractions
            4421                     !         and clouds top/bottom layer indices for low, mid, and high clouds.
            4422                     !         the three cloud domain boundaries are defined by ptopc.  the cloud
            4423                     !         overlapping method is defined by control flag 'iovr', which may
            4424                     !         be different for lw and sw radiation programs.
            4425                     
            4426                           call gethml                                                       &
            4427                     !  ---  inputs:
            4428                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            4429                          &       ix, nlay,                                                  &
            4430                     !  ---  outputs:
            4431                          &       clds, mtop, mbot                                           &
            4432                          &     )
            4433                     
            4434                     !
            4435                           return
            4436                     !...................................
            4437                           end subroutine diagcld1
            4438                     !-----------------------------------
            4439                     
            4440                     
            4441                     !-----------------------------------                                    !
            4442                           subroutine gethml                                                 &
            4443                     !...................................                                    !
            4444                     
            4445                     !  ---  inputs:
            4446                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            4447                          &       ix, nlay,                                                  &
            4448                     !  ---  outputs:
            4449                          &       clds, mtop, mbot                                           &
            4450                          &     )
            4451                     
            4452                     !  ===================================================================  !
            4453                     !                                                                       !
            4454                     ! abstract: compute high, mid, low, total, and boundary cloud fractions !
            4455                     !   and cloud top/bottom layer indices for model diagnostic output.     !
            4456                     !   the three cloud domain boundaries are defined by ptopc.  the cloud  !
            4457                     !   overlapping method is defined by control flag 'iovr', which is also !
            4458                     !   used by lw and sw radiation programs.                               !
            4459                     !                                                                       !
            4460                     ! usage:         call gethml                                            !
            4461                     !                                                                       !
            4462                     ! subprograms called:  none                                             !
            4463                     !                                                                       !
            4464                     ! attributes:                                                           !
            4465                     !   language:   fortran 90                                              !
            4466                     !   machine:    ibm-sp, sgi                                             !
            4467                     !                                                                       !
            4468                     !                                                                       !
            4469                     !  ====================  defination of variables  ====================  !
            4470                     !                                                                       !
            4471                     ! input variables:                                                      !
            4472                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
            4473                     !   ptop1 (ix,4)    : pressure limits of cloud domain interfaces        !
            4474                     !                     (sfc,low,mid,high) in mb (100pa)                  !
            4475                     !   cldtot(ix,nlay) : total or straiform cloud profile in fraction      !
            4476                     !   cldcnv(ix,nlay) : convective cloud (for diagnostic scheme only)     !
            4477                     !   ix              : horizontal dimention                              !
            4478                     !   nlay            : vertical layer dimensions                         !
            4479                     !                                                                       !
            4480                     ! output variables:                                                     !
            4481                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            4482                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
            4483                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
            4484                     !                                                                       !
            4485                     ! external module variables:  (in physpara)                             !
            4486                     !   ivflip          : control flag of vertical index direction          !
            4487                     !                     =0: index from toa to surface                     !
            4488                     !                     =1: index from surface to toa                     !
            4489                     !                                                                       !
            4490                     ! internal module variables:                                            !
            4491                     !   iovr            : control flag for cloud overlap                    !
            4492                     !                     =0 random overlapping clouds                      !
            4493                     !                     =1 max/ran overlapping clouds                     !
            4494                     !                                                                       !
            4495                     !                                                                       !
            4496                     !  ====================    end of description    =====================  !
            4497                     !
            4498                           implicit none!
            4499                     
            4500                     !  ---  inputs:
            4501                           integer, intent(in) :: ix, nlay
            4502                     
            4503                           real (kind=kind_phys), dimension(:,:), intent(in) :: plyr, ptop1, &
            4504                          &       cldtot, cldcnv
            4505                     
            4506                     !  ---  outputs
            4507                           real (kind=kind_phys), dimension(:,:), intent(out) :: clds
            4508                     
            4509                           integer,               dimension(:,:), intent(out) :: mtop, mbot
            4510                     
            4511                     !  ---  local variables:
            4512                           real (kind=kind_phys) :: cl1(ix), cl2(ix)
            4513                           real (kind=kind_phys) :: pcur, pnxt, ccur, cnxt
            4514                     
            4515                           integer, dimension(ix):: idom, kbt1, kth1, kbt2, kth2
            4516                           integer :: i, k, id, id1, kstr, kend, kinc
            4517                     
            4518                     !
            4519                     !===> ... begin here
            4520                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            4521        pp   4             clds(:,:) = 0.0
            4522                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            4523     1  pp   4             do i = 1, ix
            4524     1   p   4               cl1(i) = 1.0
            4525     1   p   4               cl2(i) = 1.0
            4526     1   p   4             enddo
            4527                     
            4528                     !  ---  total and bl clouds, where cl1, cl2 are fractions of clear-sky view
            4529                     !       layer processed from surface and up
            4530                     
            4531     1                     if ( ivflip == 0 ) then                   ! input data from toa to sfc
            4532     1                       kstr = nlay
            4533     1                       kend = 1
            4534     1                       kinc = -1
            4535     1                     else                                      ! input data from sfc to toa
            4536     1                       kstr = 1
            4537     1                       kend = nlay
            4538     1                       kinc = 1
            4539     1                     endif                                     ! end_if_ivflip
            4540                     
            4541     1                     if ( iovr == 0 ) then                     ! random overlap
            4542     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl1
                                   <<< Loop-information  End >>>
            4543     2                       do k = kstr, kend, kinc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<< Loop-information  End >>>
            4544     3  pp   2                 do i = 1, ix
            4545     3   p   2                   ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            4546     3   p   2                   if (ccur >= climit) cl1(i) = cl1(i) * (1.0 - ccur)
            4547     3   p   2                 enddo
            4548     2               
            4549     3                         if (k == llyr) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl1
                                   <<< Loop-information  End >>>
            4550     4  pp   4                   do i = 1, ix
            4551     4   p   4                     clds(i,5) = 1.0 - cl1(i)          ! save bl cloud
            4552     4   p   4                   enddo
            4553     3                         endif
            4554     2                       enddo
            4555     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl1
                                   <<< Loop-information  End >>>
            4556     2  pp   4               do i = 1, ix
            4557     2   p   4                 clds(i,4) = 1.0 - cl1(i)              ! save total cloud
            4558     2   p   4               enddo
            4559     1               
            4560     1                     else                                      ! max/ran overlap
            4561     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            4562     2                       do k = kstr, kend, kinc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 267
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2
                                   <<< Loop-information  End >>>
            4563     3  pp                     do i = 1, ix
            4564     3   p                       ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            4565     4   p                       if (ccur >= climit) then             ! cloudy layer
            4566     4   p                         cl2(i) = min( cl2(i), (1.0 - ccur) )
            4567     4   p                       else                                ! clear layer
            4568     4   p                         cl1(i) = cl1(i) * cl2(i)
            4569     4   p                         cl2(i) = 1.0
            4570     4   p                       endif
            4571     3   p                     enddo
            4572     2               
            4573     3                         if (k == llyr) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 14, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            4574     4  pp   2                   do i = 1, ix
            4575     4   p   2                     clds(i,5) = 1.0 - cl1(i) * cl2(i) ! save bl cloud
            4576     4   p   2                   enddo
            4577     3                         endif
            4578     2                       enddo
            4579     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 14, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            4580     2  pp   2               do i = 1, ix
            4581     2   p   2                 clds(i,4) = 1.0 - cl1(i) * cl2(i)     ! save total cloud
            4582     2   p   2               enddo
            4583     1               
            4584     1                     endif                                     ! end_if_iovr
            4585                     
            4586                     !  ---  high, mid, low clouds, where cl1, cl2 are cloud fractions
            4587                     !       layer processed from one layer below llyr and up
            4588                     !  ---  change! layer processed from surface to top, so low clouds will
            4589                     !       contains both bl and low clouds.
            4590                     
            4591     1                     if ( ivflip == 0 ) then                   ! input data from toa to sfc
            4592     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom, kth2, kth1, cl1, kbt2, cl2, kbt1
                                   <<< Loop-information  End >>>
            4593     2  pp                   do i = 1, ix
            4594     2   p                     cl1 (i) = 0.0
            4595     2   p                     cl2 (i) = 0.0
            4596     2   p                     kbt1(i) = nlay
            4597     2   p                     kbt2(i) = nlay
            4598     2   p                     kth1(i) = 0
            4599     2   p                     kth2(i) = 0
            4600     2   p                     idom(i) = 1
            4601     2   p                     mbot(i,1) = nlay
            4602     2   p                     mtop(i,1) = nlay
            4603     2   p                     mbot(i,2) = nlay - 1
            4604     2   p                     mtop(i,2) = nlay - 1
            4605     2   p                     mbot(i,3) = nlay - 1
            4606     2   p                     mtop(i,3) = nlay - 1
            4607     2   p                   enddo
            4608     1               
            4609     1               !org    do k = llyr-1, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            4610     2                       do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 50
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 26
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4611     3  pp                     do i = 1, ix
            4612     3   p                       id = idom(i)
            4613     3   p                       id1= id + 1
            4614     3               
            4615     3   p                       pcur = plyr(i,k)
            4616     3   p                       ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            4617     3               
            4618     4   p                       if (k > 1) then
            4619     4   p                         pnxt = plyr(i,k-1)
            4620     4   p                         cnxt = min( ovcst, max( cldtot(i,k-1), cldcnv(i,k-1) ))
            4621     4   p                       else
            4622     4   p                         pnxt = -1.0
            4623     4   p                         cnxt = 0.0
            4624     4   p                       endif
            4625     3               
            4626     4   p                       if (pcur < ptop1(i,id1)) then
            4627     4   p                         id = id + 1
            4628     4   p                         id1= id1 + 1
            4629     4   p                         idom(i) = id
            4630     4   p                       endif
            4631     3               
            4632     4   p                       if (ccur >= climit) then
            4633     4   p                         if (kth2(i) == 0) kbt2(i) = k
            4634     4   p                         kth2(i) = kth2(i) + 1
            4635     4               
            4636     5   p                         if ( iovr == 0 ) then
            4637     5   p                           cl2(i) = cl2(i) + ccur - cl2(i)*ccur
            4638     5   p                         else
            4639     5   p                           cl2(i) = max( cl2(i), ccur )
            4640     5   p                         endif
            4641     4               
            4642     5   p                         if (cnxt < climit .or. pnxt < ptop1(i,id1)) then
            4643     5   p                           kbt1(i) = nint( (cl1(i)*kbt1(i) + cl2(i)*kbt2(i) )      &
            4644     5                    &                  / (cl1(i) + cl2(i)) )
            4645     5   p                           kth1(i) = nint( (cl1(i)*kth1(i) + cl2(i)*kth2(i) )      &
            4646     5                    &                  / (cl1(i) + cl2(i)) )
            4647     5   p                           cl1 (i) = cl1(i) + cl2(i) - cl1(i)*cl2(i)
            4648     5               
            4649     5   p                           kbt2(i) = k - 1
            4650     5   p                           kth2(i) = 0
            4651     5   p                           cl2 (i) = 0.0
            4652     5   p                         endif   ! end_if_cnxt_or_pnxt
            4653     4   p                       endif     ! end_if_ccur
            4654     3               
            4655     4   p                       if (pnxt < ptop1(i,id1)) then
            4656     4   p                         clds(i,id) = cl1(i)
            4657     4   p                         mtop(i,id) = min( kbt1(i), kbt1(i)-kth1(i)+1 )
            4658     4   p                         mbot(i,id) = kbt1(i)
            4659     4               
            4660     4   p                         cl1 (i) = 0.0
            4661     4   p                         kbt1(i) = k - 1
            4662     4   p                         kth1(i) = 0
            4663     4               
            4664     5   p                         if (id1 <= nk_clds) then
            4665     5   p                           mbot(i,id1) = kbt1(i)
            4666     5   p                           mtop(i,id1) = kbt1(i)
            4667     5   p                         endif
            4668     4   p                       endif     ! end_if_pnxt
            4669     3               
            4670     3   p                     enddo       ! end_do_i_loop
            4671     2                       enddo         ! end_do_k_loop
            4672     1               
            4673     1                     else                                      ! input data from sfc to toa
            4674     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom, kth2, kth1, kbt2, kbt1, cl2, cl1
                                   <<< Loop-information  End >>>
            4675     2  pp                   do i = 1, ix
            4676     2   p                     cl1 (i) = 0.0
            4677     2   p                     cl2 (i) = 0.0
            4678     2   p                     kbt1(i) = 1
            4679     2   p                     kbt2(i) = 1
            4680     2   p                     kth1(i) = 0
            4681     2   p                     kth2(i) = 0
            4682     2   p                     idom(i) = 1
            4683     2   p                     mbot(i,1) = 1
            4684     2   p                     mtop(i,1) = 1
            4685     2   p                     mbot(i,2) = 2
            4686     2   p                     mtop(i,2) = 2
            4687     2   p                     mbot(i,3) = 2
            4688     2   p                     mtop(i,3) = 2
            4689     2   p                   enddo
            4690     1               
            4691     1               !org    do k = llyr+1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            4692     2                       do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 50
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 26
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4693     3  pp                     do i = 1, ix
            4694     3   p                       id = idom(i)
            4695     3   p                       id1= id + 1
            4696     3               
            4697     3   p                       pcur = plyr(i,k)
            4698     3   p                       ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            4699     3               
            4700     4   p                       if (k < nlay) then
            4701     4   p                         pnxt = plyr(i,k+1)
            4702     4   p                         cnxt = min( ovcst, max( cldtot(i,k+1), cldcnv(i,k+1) ))
            4703     4   p                       else
            4704     4   p                         pnxt = -1.0
            4705     4   p                         cnxt = 0.0
            4706     4   p                       endif
            4707     3               
            4708     4   p                       if (pcur < ptop1(i,id1)) then
            4709     4   p                         id = id + 1
            4710     4   p                         id1= id1 + 1
            4711     4   p                         idom(i) = id
            4712     4   p                       endif
            4713     3               
            4714     4   p                       if (ccur >= climit) then
            4715     4   p                         if (kth2(i) == 0) kbt2(i) = k
            4716     4   p                         kth2(i) = kth2(i) + 1
            4717     4               
            4718     5   p                         if ( iovr == 0 ) then
            4719     5   p                           cl2(i) = cl2(i) + ccur - cl2(i)*ccur
            4720     5   p                         else
            4721     5   p                           cl2(i) = max( cl2(i), ccur )
            4722     5   p                         endif
            4723     4               
            4724     5   p                         if (cnxt < climit .or. pnxt < ptop1(i,id1)) then
            4725     5   p                           kbt1(i) = nint( (cl1(i)*kbt1(i) + cl2(i)*kbt2(i))       &
            4726     5                    &                  / (cl1(i) + cl2(i)) )
            4727     5   p                           kth1(i) = nint( (cl1(i)*kth1(i) + cl2(i)*kth2(i))       &
            4728     5                    &                  / (cl1(i) + cl2(i)) )
            4729     5   p                           cl1 (i) = cl1(i) + cl2(i) - cl1(i)*cl2(i)
            4730     5               
            4731     5   p                           kbt2(i) = k + 1
            4732     5   p                           kth2(i) = 0
            4733     5   p                           cl2 (i) = 0.0
            4734     5   p                         endif     ! end_if_cnxt_or_pnxt
            4735     4   p                       endif       ! end_if_ccur
            4736     3               
            4737     4   p                       if (pnxt < ptop1(i,id1)) then
            4738     4   p                         clds(i,id) = cl1(i)
            4739     4   p                         mtop(i,id) = max( kbt1(i), kbt1(i)+kth1(i)-1 )
            4740     4   p                         mbot(i,id) = kbt1(i)
            4741     4               
            4742     4   p                         cl1 (i) = 0.0
            4743     4   p                         kbt1(i) = k + 1
            4744     4   p                         kth1(i) = 0
            4745     4               
            4746     5   p                         if (id1 <= nk_clds) then
            4747     5   p                           mbot(i,id1) = kbt1(i)
            4748     5   p                           mtop(i,id1) = kbt1(i)
            4749     5   p                         endif
            4750     4   p                       endif     ! end_if_pnxt
            4751     3               
            4752     3   p                     enddo       ! end_do_i_loop
            4753     2                       enddo         ! end_do_k_loop
            4754     1               
            4755     1                     endif                                     ! end_if_ivflip
            4756                     
            4757                     !
            4758                           return
            4759                     !...................................
            4760                           end subroutine gethml
            4761                     !-----------------------------------
            4762                     
            4763                     
            4764                     !-----------------------------------
            4765                     !> Cloud fraction scheme by G. Thompson (NCAR-RAL), not intended for
            4766                     !! combining with any cumulus or shallow cumulus parameterization
            4767                     !! scheme cloud fractions.  This is intended as a stand-alone for
            4768                     !! cloud fraction and is relatively good at getting widespread stratus
            4769                     !! and stratoCu without caring whether any deep/shallow Cu param schemes
            4770                     !! is making sub-grid-spacing clouds/precip.  Under the hood, this
            4771                     !! scheme follows Mocko and Cotton (1995) in application of the
            4772                     !! Sundqvist et al (1989) scheme but using a grid-scale dependent
            4773                     !! RH threshold, one each for land v. ocean points based on
            4774                     !! experiences with HWRF testing.
            4775                           SUBROUTINE cal_cldfra3(CLDFRA, qv, qc, qi, qs, dz,                &
            4776                          &                 p, t, XLAND, gridkm,                             &
            4777                          &                 modify_qvapor, max_relh,                         &
            4778                          &                 kts,kte, debug_flag)
            4779                     !
            4780                           USE module_mp_thompson_new   , ONLY : rsif, rslf
            4781                           IMPLICIT NONE
            4782                     !
            4783                           INTEGER, INTENT(IN):: kts, kte
            4784                           LOGICAL, INTENT(IN):: modify_qvapor
            4785                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qv, qc, qi, cldfra
            4786                           REAL, DIMENSION(kts:kte), INTENT(IN):: p, t, dz, qs
            4787                           REAL, INTENT(IN):: gridkm, XLAND, max_relh
            4788                           LOGICAL, INTENT(IN):: debug_flag
            4789                     
            4790                     !..Local vars.
            4791                           REAL:: RH_00L, RH_00O, RH_00
            4792                           REAL:: entrmnt=0.5
            4793                           INTEGER:: k
            4794                           REAL:: TC, qvsi, qvsw, RHUM, delz, var_temp
            4795                           REAL, DIMENSION(kts:kte):: qvs, rh, rhoa
            4796                           integer:: ndebug = 0
            4797                     
            4798                           character*512 dbg_msg
            4799                     
            4800                     !+---+
            4801                     
            4802                     !..Initialize cloud fraction, compute RH, and rho-air.
            4803                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      CLDFRA, t, qvs, qv, p, rhoa, rh
                                   <<< Loop-information  End >>>
            4804     1   s                    DO k = kts,kte
            4805     1   p                       CLDFRA(K) = 0.0
            4806     1               
            4807     1   s                       qvsw = rslf(P(k), t(k))
            4808     1   s                       qvsi = rsif(P(k), t(k))
            4809     1               
            4810     1   s                       tc = t(k) - 273.15
            4811     2   s                       if (tc .ge. -12.0) then
            4812     2   m                          qvs(k) = qvsw
            4813     2   m                       elseif (tc .lt. -35.0) then
            4814     2   m                          qvs(k) = qvsi
            4815     2   s                       else
            4816     2   m                          qvs(k) = qvsw - (qvsw-qvsi)*(-12.0-tc)/(-12.0+35.)
            4817     2   p                       endif
            4818     1               
            4819     2   p                       if (modify_qvapor) then
            4820     3   p                          if (qc(k).gt.1.E-8) then
            4821     3   s                             qv(k) = MAX(qv(k), qvsw)
            4822     3   s                             qvs(k) = qvsw
            4823     3   p                          endif
            4824     3   p                          if (qc(k).le.1.E-8 .and. qi(k).ge.1.E-9) then
            4825     3   m                             qv(k) = MAX(qv(k), qvsi*1.005)    !..To ensure a tiny bit ice supersaturated
            4826     3   s                             qvs(k) = qvsi
            4827     3   p                          endif
            4828     2   p                       endif
            4829     1               
            4830     1   p                       rh(k) = MAX(0.01, qv(k)/qvs(k))
            4831     1   m                       rhoa(k) = p(k)/(287.0*t(k))
            4832     1               
            4833     1   p                    ENDDO
            4834                     
            4835                     
            4836                     !..First cut scale-aware. Higher resolution should require closer to
            4837                     !.. saturated grid box for higher cloud fraction.  Simple functions
            4838                     !.. chosen based on Mocko and Cotton (1995) starting point and desire
            4839                     !.. to get near 100% RH as grid spacing moves toward 1.0km, but higher
            4840                     !.. RH over ocean required as compared to over land.
            4841                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 30
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qc, CLDFRA
                                   <<< Loop-information  End >>>
            4842     1  pp                 DO k = kts,kte
            4843     1               
            4844     1   p                    delz = MAX(100., dz(k))
            4845     1   p                    RH_00L = 0.77+MIN(0.22,SQRT(1./(50.0+gridkm*gridkm*delz*0.01)))
            4846     1   p                    RH_00O = 0.85+MIN(0.14,SQRT(1./(50.0+gridkm*gridkm*delz*0.01)))
            4847     1   p                    RHUM = rh(k)
            4848     1               
            4849     2   p                    if (qc(k).ge.1.E-6 .or. qi(k).ge.1.E-7                         &
            4850     2                    &                    .or. (qs(k).gt.1.E-6 .and. t(k).lt.273.)) then
            4851     2   p                       CLDFRA(K) = 1.0
            4852     2   p                    elseif (((qc(k)+qi(k)).gt.1.E-10) .and.                        &
            4853     2                    &                                    ((qc(k)+qi(k)).lt.1.E-6)) then
            4854     2   p                       var_temp = MIN(0.99, 0.1*(11.0 + log10(qc(k)+qi(k))))
            4855     2   p                       CLDFRA(K) = var_temp*var_temp
            4856     2                        else
            4857     2               
            4858     3   p                       IF ((XLAND-1.5).GT.0.) THEN                                  !--- Ocean
            4859     3   p                          RH_00 = RH_00O
            4860     3                           ELSE                                                         !--- Land
            4861     3                              RH_00 = RH_00L
            4862     3   p                       ENDIF
            4863     2               
            4864     2   p                       tc = MAX(-80.0, t(k) - 273.15)
            4865     2   p                       if (tc .lt. -24.0) RH_00 = RH_00L
            4866     2               
            4867     3   p                       if (tc .gt. 20.0) then
            4868     3   p                          CLDFRA(K) = 0.0
            4869     3   p                       elseif (tc .ge. -24.0) then
            4870     3   p                          RHUM = MIN(rh(k), 1.0)
            4871     3   p                          var_temp = SQRT(SQRT((1.001-RHUM)/(1.001-RH_00)))
            4872     3   p                          CLDFRA(K) = MAX(0., 1.0-var_temp)
            4873     3   p                       else
            4874     4   p                          if (max_relh.gt.1.12 .or. (.NOT.(modify_qvapor)) ) then
            4875     4               !..For HRRR model, the following look OK.
            4876     4   p                             RHUM = MIN(rh(k), 1.45)
            4877     4   p                             RH_00 = RH_00 + (1.45-RH_00)*(-24.0-tc)/(-24.0+85.)
            4878     4   p                             var_temp = SQRT(SQRT((1.46-RHUM)/(1.46-RH_00)))
            4879     4   p                             CLDFRA(K) = MAX(0., 1.0-var_temp)
            4880     4   p                          else
            4881     4               !..but for the GFS model, RH is way lower.
            4882     4   p                             RHUM = MIN(rh(k), 1.05)
            4883     4   p                             RH_00 = RH_00 + (1.05-RH_00)*(-24.0-tc)/(-24.0+85.)
            4884     4   p                             var_temp = SQRT(SQRT((1.06-RHUM)/(1.06-RH_00)))
            4885     4   p                             CLDFRA(K) = MAX(0., 1.0-var_temp)
            4886     4   p                          endif
            4887     3   p                       endif
            4888     2   p                       if (CLDFRA(K).gt.0.) CLDFRA(K)=MAX(0.01,MIN(CLDFRA(K),0.99))
            4889     2               
            4890     2   p                    endif
            4891     1   p                    if (cldfra(k).gt.0.0 .and. p(k).lt.7000.0) CLDFRA(K) = 0.0
            4892     1   p                 ENDDO
            4893                     
            4894                           call find_cloudLayers(qvs, cldfra, T, P, Dz, entrmnt,             &
            4895                          &                      debug_flag, qc, qi, qs, kts,kte)
            4896                     
            4897                     !..Do a final total column adjustment since we may have added more than 1 mm
            4898                     !.. LWP/IWP for multiple cloud decks.
            4899                     
            4900                           call adjust_cloudFinal(cldfra, qc, qi, rhoa, dz, kts,kte)
            4901                     
            4902                     !..Intended for cold start model runs, we use modify_qvapor to ensure that cloudy
            4903                     !.. areas are actually saturated such that the inserted clouds do not evaporate a
            4904                     !.. timestep later.
            4905                     
            4906     1                     if (modify_qvapor) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      CLDFRA
                                   <<< Loop-information  End >>>
            4907     2  pp   2                DO k = kts,kte
            4908     3   p   2                   if (cldfra(k).gt.0.2 .and. cldfra(k).lt.1.0) then
            4909     3   p   2                      qv(k) = MAX(qv(k),qvs(k))
            4910     3   p   2                   endif
            4911     2   p   2                ENDDO
            4912     1                     endif
            4913                     
            4914                     !...................................                                    !
            4915                           END SUBROUTINE cal_cldfra3
            4916                     !-----------------------------------                                    !
            4917                     
            4918                     
            4919                     !-----------------------------------                                    !
            4920                     !>From cloud fraction array, find clouds of multi-level depth and compute
            4921                     !! a reasonable value of LWP or IWP that might be contained in that depth,
            4922                     !! unless existing LWC/IWC is already there.
            4923                           SUBROUTINE find_cloudLayers(qvs1d, cfr1d, T1d, P1d, Dz1d, entrmnt,&
            4924                          &                            debugfl, qc1d, qi1d, qs1d, kts,kte)
            4925                     !
            4926                           IMPLICIT NONE
            4927                     !
            4928                           INTEGER, INTENT(IN):: kts, kte
            4929                           LOGICAL, INTENT(IN):: debugfl
            4930                           REAL, INTENT(IN):: entrmnt
            4931                           REAL, DIMENSION(kts:kte), INTENT(IN):: qs1d,qvs1d,T1d,P1d,Dz1d
            4932                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: cfr1d, qc1d, qi1d
            4933                     
            4934                     !..Local vars.
            4935                           REAL, DIMENSION(kts:kte):: theta
            4936                           REAL:: theta1, theta2, delz
            4937                           INTEGER:: k, k2, k_tropo, k_m12C, k_cldb, k_cldt, kbot, k_p200
            4938                           LOGICAL:: in_cloud
            4939                           character*512 dbg_msg
            4940                     
            4941                     !+---+
            4942                     
            4943                           k_m12C = 0
            4944                           k_p200 = 0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<< Loop-information  End >>>
            4945     1   m                 DO k = kte, kts, -1
            4946     1   p                    theta(k) = T1d(k)*((100000.0/P1d(k))**(287.05/1004.))
            4947     1   p                    if (T1d(k)-273.16 .gt. -12.0 .and. P1d(k).gt.10100.0)          &
            4948     1                    &                   k_m12C = MAX(k_m12C, k)
            4949     1   m                    if (P1d(k).gt.19999.0 .and. k_p200.eq.0) k_p200 = k
            4950     1   p                 ENDDO
            4951                           if (k_m12C .le. kts) k_m12C = kts
            4952                     
            4953                     !..Find tropopause height, best surrogate, because we would not really
            4954                     !.. wish to put fake clouds into the stratosphere.  The 10/1500 ratio
            4955                     !.. d(Theta)/d(Z) approximates a vertical line on typical SkewT chart
            4956                     !.. near typical (mid-latitude) tropopause height.  Since messy data
            4957                     !.. could give us a false signal of such a transition, do the check over
            4958                     !.. three K-level change, not just a level-to-level check.  This method
            4959                     !.. has potential failure in arctic-like conditions with extremely low
            4960                     !.. tropopause height, as would any other diagnostic, so ensure resulting
            4961                     !.. k_tropo level is above 700hPa.
            4962                     
            4963                           if ( (kte-k_p200) .lt. 3) k_p200 = kte-3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dz1d, theta
                                   <<< Loop-information  End >>>
            4964     1                     DO k = k_p200-2, kts, -1
            4965     1                        theta1 = theta(k)
            4966     1                        theta2 = theta(k+2)
            4967     1                        delz = 0.5*dz1d(k) + dz1d(k+1) + 0.5*dz1d(k+2)
            4968     1                        if ( (((theta2-theta1)/delz).lt.10./1500.) .OR.                &
            4969     1                    &                       P1d(k).gt.70000.) EXIT
            4970     1                     ENDDO
            4971                           k_tropo = MAX(kts+2, MIN(k+2, kte-1))
            4972                     
            4973     1                     if (k_tropo .gt. k_p200) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dz1d, theta
                                   <<< Loop-information  End >>>
            4974     2                        DO k = kte-3, k_p200-2, -1
            4975     2                           theta1 = theta(k)
            4976     2                           theta2 = theta(k+2)
            4977     2                           delz = 0.5*dz1d(k) + dz1d(k+1) + 0.5*dz1d(k+2)
            4978     2                           if ( (((theta2-theta1)/delz).lt.10./1500.) .AND.            &
            4979     2                    &                                    P1d(k).gt.9000.) EXIT
            4980     2                        ENDDO
            4981     1                        k_tropo = MAX(k_p200-1, MIN(k+2, kte-1))
            4982     1                     endif
            4983                     
            4984                     !..Eliminate possible fractional clouds above supposed tropopause.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            4985     1  pp   4             DO k = k_tropo+1, kte
            4986     2   p   4                if (cfr1d(k).gt.0.0 .and. cfr1d(k).lt.1.0) then
            4987     2   p   4                   cfr1d(k) = 0.
            4988     2   p   4                endif
            4989     1   p   4             ENDDO
            4990                     
            4991                     !..Be a bit more conservative with lower cloud fraction in scenario with
            4992                     !.. well-mixed convective boundary layer below LCL.
            4993                     
            4994                           kbot = kts+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      theta, Dz1d
                                   <<< Loop-information  End >>>
            4995     1                     DO k = kbot, k_m12C
            4996     1                        if ( (theta(k)-theta(k-1)) .gt. 0.010E-3*Dz1d(k)) EXIT
            4997     1                     ENDDO
            4998                           kbot = MAX(kts+1, k-2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            4999     1  pp   2             DO k = kts, kbot
            5000     1   p   2                if (cfr1d(k).gt.0.0 .and. cfr1d(k).lt.1.0)                     &
            5001     1                    &              cfr1d(k) = MAX(0.01,0.33*cfr1d(k))
            5002     1   p   2             ENDDO
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<< Loop-information  End >>>
            5003     1  pp                 DO k = kts,k_tropo
            5004     1   p                    if (cfr1d(k).gt.0.0) kbot = MIN(k,kbot)
            5005     1   p                 ENDDO
            5006                     
            5007                     !..Starting below tropo height, if cloud fraction greater than 1 percent,
            5008                     !.. compute an approximate total layer depth of cloud, determine a total
            5009                     !.. liquid water/ice path (LWP/IWP), then reduce that amount with tuning
            5010                     !.. parameter to represent entrainment factor, then divide up LWP/IWP
            5011                     !.. into delta-Z weighted amounts for individual levels per cloud layer.
            5012                     
            5013                           k_cldb = k_tropo
            5014                           in_cloud = .false.
            5015                           k = k_tropo
            5016     1                     DO WHILE (.not. in_cloud .AND. k.gt.k_m12C+1)
            5017     1                        k_cldt = 0
            5018     2                        if (cfr1d(k).ge.0.01) then
            5019     2                           in_cloud = .true.
            5020     2                           k_cldt = MAX(k_cldt, k)
            5021     2                        endif
            5022     2                        if (in_cloud) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            5023     3                           DO k2 = k_cldt-1, k_m12C, -1
            5024     4                              if (cfr1d(k2).lt.0.01 .or. k2.eq.k_m12C) then
            5025     4                                 k_cldb = k2+1
            5026     4                                 goto 87
            5027     4                              endif
            5028     3                           ENDDO
            5029     2                87         continue
            5030     2                           in_cloud = .false.
            5031     2                        endif
            5032     2                        if ((k_cldt - k_cldb + 1) .ge. 2) then
            5033     2                           call adjust_cloudIce(cfr1d, qi1d, qs1d, qvs1d, T1d, Dz1d,   &
            5034     2                    &                           entrmnt, k_cldb,k_cldt,kts,kte)
            5035     2                           k = k_cldb
            5036     2                        elseif ((k_cldt - k_cldb + 1) .eq. 1) then
            5037     2                           if (cfr1d(k_cldb).gt.0.and.cfr1d(k_cldb).lt.1.)             &
            5038     2                    &        qi1d(k_cldb)=qi1d(k_cldb)+0.05*qvs1d(k_cldb)*cfr1d(k_cldb)
            5039     2                           k = k_cldb
            5040     2                        endif
            5041     1                        k = k - 1
            5042     1                     ENDDO
            5043                     
            5044                           k_cldb = k_m12C + 3
            5045                           in_cloud = .false.
            5046                           k = k_m12C + 2
            5047     1                     DO WHILE (.not. in_cloud .AND. k.gt.kbot)
            5048     1                        k_cldt = 0
            5049     2                        if (cfr1d(k).ge.0.01) then
            5050     2                           in_cloud = .true.
            5051     2                           k_cldt = MAX(k_cldt, k)
            5052     2                        endif
            5053     2                        if (in_cloud) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr1d
                                   <<< Loop-information  End >>>
            5054     3                           DO k2 = k_cldt-1, kbot, -1
            5055     4                              if (cfr1d(k2).lt.0.01 .or. k2.eq.kbot) then
            5056     4                                 k_cldb = k2+1
            5057     4                                 goto 88
            5058     4                              endif
            5059     3                           ENDDO
            5060     2                88         continue
            5061     2                           in_cloud = .false.
            5062     2                        endif
            5063     2                        if ((k_cldt - k_cldb + 1) .ge. 2) then
            5064     2                           call adjust_cloudH2O(cfr1d, qc1d, qvs1d, T1d, Dz1d,         &
            5065     2                    &                           entrmnt, k_cldb,k_cldt,kts,kte)
            5066     2                           k = k_cldb
            5067     2                        elseif ((k_cldt - k_cldb + 1) .eq. 1) then
            5068     2                           if (cfr1d(k_cldb).gt.0.and.cfr1d(k_cldb).lt.1.)             &
            5069     2                    &        qc1d(k_cldb)=qc1d(k_cldb)+0.05*qvs1d(k_cldb)*cfr1d(k_cldb)
            5070     2                           k = k_cldb
            5071     2                        endif
            5072     1                        k = k - 1
            5073     1                     ENDDO
            5074                     
            5075                     
            5076                           END SUBROUTINE find_cloudLayers
            5077                     
            5078                     
            5079                     !+---+-----------------------------------------------------------------+
            5080                     
            5081                     !>
            5082                           SUBROUTINE adjust_cloudIce(cfr,qi,qs,qvs,T,dz,entr, k1,k2,kts,kte)
            5083                     !
            5084                           IMPLICIT NONE
            5085                     !
            5086                           INTEGER, INTENT(IN):: k1,k2, kts,kte
            5087                           REAL, INTENT(IN):: entr
            5088                           REAL, DIMENSION(kts:kte), INTENT(IN):: cfr, qs, qvs, T, dz
            5089                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qi
            5090                           REAL:: iwc, max_iwc, tdz, this_iwc, this_dz
            5091                           INTEGER:: k
            5092                     
            5093                           tdz = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<< Loop-information  End >>>
            5094     1  pp                 do k = k1, k2
            5095     1   p                    tdz = tdz + dz(k)
            5096     1   p                 enddo
            5097                     !     max_iwc = ABS(qvs(k2)-qvs(k1))
            5098                           max_iwc = MAX(0.0, qvs(k1)-qvs(k2))
            5099                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, qs
                                   <<< Loop-information  End >>>
            5100     1   s   2             do k = k1, k2
            5101     1   m   2                max_iwc = MAX(1.E-6, max_iwc - (qi(k)+qs(k)))
            5102     1   p   2             enddo
            5103                           max_iwc = MIN(1.E-4, max_iwc)
            5104                     
            5105                           this_dz = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, cfr
                                   <<< Loop-information  End >>>
            5106     1   s                 do k = k1, k2
            5107     2   p                    if (k.eq.k1) then
            5108     2   m                       this_dz = this_dz + 0.5*dz(k)
            5109     2   p                    else
            5110     2   m                       this_dz = this_dz + dz(k)
            5111     2   p                    endif
            5112     1   s                    this_iwc = max_iwc*this_dz/tdz
            5113     1   p                    iwc = MAX(1.E-6, this_iwc*(1.-entr))
            5114     2   p                    if (cfr(k).gt.0.0.and.cfr(k).lt.1.0.and.T(k).ge.203.16) then
            5115     2   p                       qi(k) = qi(k) + cfr(k)*cfr(k)*iwc
            5116     2   p                    endif
            5117     1   p                 enddo
            5118                     
            5119                           END SUBROUTINE adjust_cloudIce
            5120                     
            5121                     !+---+-----------------------------------------------------------------+
            5122                     
            5123                     !>
            5124                           SUBROUTINE adjust_cloudH2O(cfr, qc, qvs,T,dz,entr, k1,k2,kts,kte)
            5125                     !
            5126                           IMPLICIT NONE
            5127                     !
            5128                           INTEGER, INTENT(IN):: k1,k2, kts,kte
            5129                           REAL, INTENT(IN):: entr
            5130                           REAL, DIMENSION(kts:kte), INTENT(IN):: cfr, qvs, T, dz
            5131                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qc
            5132                           REAL:: lwc, max_lwc, tdz, this_lwc, this_dz
            5133                           INTEGER:: k
            5134                     
            5135                           tdz = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<< Loop-information  End >>>
            5136     1  pp                 do k = k1, k2
            5137     1   p                    tdz = tdz + dz(k)
            5138     1   p                 enddo
            5139                     !     max_lwc = ABS(qvs(k2)-qvs(k1))
            5140                           max_lwc = MAX(0.0, qvs(k1)-qvs(k2))
            5141                     !     print*, ' max_lwc = ', max_lwc, ' over DZ=',tdz
            5142                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qc
                                   <<< Loop-information  End >>>
            5143     1   s   2             do k = k1, k2
            5144     1   s   2                max_lwc = MAX(1.E-6, max_lwc - qc(k))
            5145     1   s   2             enddo
            5146                           max_lwc = MIN(1.E-4, max_lwc)
            5147                     
            5148                           this_dz = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, cfr
                                   <<< Loop-information  End >>>
            5149     1   s                 do k = k1, k2
            5150     2   p                    if (k.eq.k1) then
            5151     2   m                       this_dz = this_dz + 0.5*dz(k)
            5152     2   p                    else
            5153     2   m                       this_dz = this_dz + dz(k)
            5154     2   p                    endif
            5155     1   s                    this_lwc = max_lwc*this_dz/tdz
            5156     1   p                    lwc = MAX(1.E-6, this_lwc*(1.-entr))
            5157     2   p                    if (cfr(k).gt.0.0.and.cfr(k).lt.1.0.and.T(k).ge.258.16) then
            5158     2   p                       qc(k) = qc(k) + cfr(k)*cfr(k)*lwc
            5159     2   p                    endif
            5160     1   p                 enddo
            5161                     
            5162                           END SUBROUTINE adjust_cloudH2O
            5163                     
            5164                     !+---+-----------------------------------------------------------------+
            5165                     
            5166                     !> Do not alter any grid-explicitly resolved hydrometeors, rather only
            5167                     !! the supposed amounts due to the cloud fraction scheme.
            5168                           SUBROUTINE adjust_cloudFinal(cfr, qc, qi, Rho,dz, kts,kte)
            5169                     !
            5170                           IMPLICIT NONE
            5171                     !
            5172                           INTEGER, INTENT(IN):: kts,kte
            5173                           REAL, DIMENSION(kts:kte), INTENT(IN):: cfr, Rho, dz
            5174                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: qc, qi
            5175                           REAL:: lwp, iwp, xfac
            5176                           INTEGER:: k
            5177                     
            5178                           lwp = 0.
            5179                           iwp = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<< Loop-information  End >>>
            5180     1  pp                 do k = kts, kte
            5181     2   p                    if (cfr(k).gt.0.0 .and. cfr(k).lt.1.0) then
            5182     2   p                       lwp = lwp + qc(k)*Rho(k)*dz(k)
            5183     2   p                       iwp = iwp + qi(k)*Rho(k)*dz(k)
            5184     2   p                    endif
            5185     1   p                 enddo
            5186                     
            5187     1                     if (lwp .gt. 1.0) then
            5188     1                        xfac = 1.0/lwp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr
                                   <<< Loop-information  End >>>
            5189     2  pp   2                do k = kts, kte
            5190     3   p   2                   if (cfr(k).gt.0.0 .and. cfr(k).lt.1.0) then
            5191     3   p   2                      qc(k) = qc(k)*xfac
            5192     3   p   2                   endif
            5193     2   p   2                enddo
            5194     1                     endif
            5195                     
            5196     1                     if (iwp .gt. 1.0) then
            5197     1                        xfac = 1.0/iwp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfr
                                   <<< Loop-information  End >>>
            5198     2  pp   2                do k = kts, kte
            5199     3   p   2                   if (cfr(k).gt.0.0 .and. cfr(k).lt.1.0) then
            5200     3   p   2                      qi(k) = qi(k)*xfac
            5201     3   p   2                   endif
            5202     2   p   2                enddo
            5203     1                     endif
            5204                     
            5205                           END SUBROUTINE adjust_cloudFinal
            5206                     
            5207                     !+---+-----------------------------------------------------------------+
            5208                     
            5209                     !> This subroutine computes the Xu-Randall cloud fraction scheme.
            5210                           subroutine cloud_fraction_XuRandall                               &
            5211                     !  ---  inputs:
            5212                          &     ( IX, NLAY, plyr, clwf, rhly, qstl, lmfshal, lmfdeep2,       &
            5213                     !  ---  outputs:
            5214                          &       cldtot )
            5215                     
            5216                     !  ---  inputs:
            5217                           integer, intent(in) :: IX, NLAY
            5218                           real (kind=kind_phys), dimension(:,:), intent(in) :: plyr, clwf,  &
            5219                          &                                                     rhly, qstl
            5220                           logical, intent(in) :: lmfshal, lmfdeep2
            5221                     
            5222                     !  ---  outputs
            5223                           real (kind=kind_phys), dimension(:,:), intent(inout) :: cldtot
            5224                     
            5225                     !  ---  local variables:
            5226                     
            5227                            real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,      &
            5228                          &       tem1, tem2
            5229                            real (kind=kind_phys), parameter :: xrc3 = 100.
            5230                            integer :: i, k
            5231                     
            5232                     !> - Compute layer cloud fraction.
            5233                     
            5234     1                      if ( ivflip == 0 ) then              ! input data from toa to sfc
            5235     1               
            5236     1                        clwmin = 0.0
            5237     2                        if (.not. lmfshal) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            5238     3  pp                      do k = NLAY, 1, -1
            5239     4   p                      do i = 1, IX
            5240     4   p                        clwt = 1.0e-6 * (plyr(i,k)*0.001)
            5241     4               
            5242     5   p                        if (clwf(i,k) > clwt) then
            5243     5               
            5244     5   p                          onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            5245     5   p                          clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            5246     5               
            5247     5   p                          tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            5248     5   p                          tem1  = 2000.0 / tem1
            5249     5               
            5250     5   p                          value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
            5251     5   p                          tem2  = sqrt( sqrt(rhly(i,k)) )
            5252     5               
            5253     5   p                          cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            5254     5   p                        endif
            5255     4   p                     enddo
            5256     3   p                     enddo
            5257     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            5258     3  pp                     do k = NLAY, 1, -1
            5259     4   p                     do i = 1, IX
            5260     4   p                       clwt = 1.0e-6 * (plyr(i,k)*0.001)
            5261     4               
            5262     5   p                       if (clwf(i,k) > clwt) then
            5263     5   p                         onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            5264     5   p                         clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            5265     5               
            5266     5   p                         tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)  !jhan
            5267     6   p                         if (lmfdeep2) then
            5268     6   p                           tem1  = xrc3 / tem1
            5269     6   p                         else
            5270     6   p                           tem1  = 100.0 / tem1
            5271     6   p                         endif
            5272     5               
            5273     5   p                         value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
            5274     5   p                         tem2  = sqrt( sqrt(rhly(i,k)) )
            5275     5   p                         cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            5276     5   p                       endif
            5277     4   p                     enddo
            5278     3   p                     enddo
            5279     2                       endif
            5280     1               
            5281     1                     else                                 ! input data from sfc to toa
            5282     1               
            5283     1                       clwmin = 0.0
            5284     2                       if (.not. lmfshal) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            5285     3  pp                     do k = 1, NLAY
            5286     4   p                     do i = 1, IX
            5287     4   p                       clwt = 1.0e-6 * (plyr(i,k)*0.001)
            5288     4               
            5289     5   p                       if (clwf(i,k) > clwt) then
            5290     5               
            5291     5   p                         onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            5292     5   p                         clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            5293     5               
            5294     5   p                         tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            5295     5   p                         tem1  = 2000.0 / tem1
            5296     5               
            5297     5   p                         value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
            5298     5   p                         tem2  = sqrt( sqrt(rhly(i,k)) )
            5299     5               
            5300     5   p                         cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            5301     5   p                       endif
            5302     4   p                     enddo
            5303     3   p                     enddo
            5304     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            5305     3  pp                     do k = 1, NLAY
            5306     4   p                     do i = 1, IX
            5307     4   p                       clwt = 1.0e-6 * (plyr(i,k)*0.001)
            5308     4               
            5309     5   p                       if (clwf(i,k) > clwt) then
            5310     5   p                         onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            5311     5   p                         clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            5312     5               !
            5313     5   p                         tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)  !jhan
            5314     6   p                         if (lmfdeep2) then
            5315     6   p                           tem1  = xrc3 / tem1
            5316     6   p                         else
            5317     6   p                           tem1  = 100.0 / tem1
            5318     6   p                         endif
            5319     5               
            5320     5   p                         value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
            5321     5   p                         tem2  = sqrt( sqrt(rhly(i,k)) )
            5322     5               
            5323     5   p                         cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            5324     5   p                       endif
            5325     4   p                     enddo
            5326     3   p                     enddo
            5327     2                       endif
            5328     1                     endif
            5329                     
            5330                           end subroutine cloud_fraction_XuRandall
            5331                     
            5332                           subroutine cloud_fraction1d_XuRandall                             &
            5333                     !  ---  inputs:
            5334                          &     ( NLAY, plyr, clwf, rhly, qstl, lmfshal, lmfdeep2,           &
            5335                     !  ---  outputs:
            5336                          &       cldtot )
            5337                     
            5338                     !  ---  inputs:
            5339                           integer, intent(in) :: NLAY
            5340                           real (kind=kind_phys), dimension(:), intent(in)   :: plyr, clwf,  &
            5341                          &                                                     rhly, qstl
            5342                           logical, intent(in) :: lmfshal, lmfdeep2
            5343                     
            5344                     !  ---  outputs
            5345                           real (kind=kind_phys), dimension(:), intent(inout) :: cldtot
            5346                     
            5347                     !  ---  local variables:
            5348                     
            5349                            real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,      &
            5350                          &       tem1, tem2
            5351                            real (kind=kind_phys), parameter :: xrc3 = 100.
            5352                            integer :: k
            5353                     
            5354                     !> - Compute layer cloud fraction.
            5355                     
            5356                           clwmin = 0.0
            5357     1                     if (.not. lmfshal) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 37
                                   <<< Loop-information  End >>>
            5358     2  pp                   do k = 1, NLAY
            5359     2   p                     clwt = 1.0e-6 * (plyr(k)*0.001)
            5360     2               
            5361     3   p                     if (clwf(k) > clwt) then
            5362     3               
            5363     3   p                       onemrh= max( 1.e-10, 1.0-rhly(k) )
            5364     3   p                       clwm  = clwmin / max( 0.01, plyr(k)*0.001 )
            5365     3               
            5366     3   p                       tem1  = min(max(sqrt(sqrt(onemrh*qstl(k))),0.0001),1.0)
            5367     3   p                       tem1  = 2000.0 / tem1
            5368     3               
            5369     3   p                       value = max( min( tem1*(clwf(k)-clwm), 50.0 ), 0.0 )
            5370     3   p                       tem2  = sqrt( sqrt(rhly(k)) )
            5371     3               
            5372     3   p                       cldtot(k) = max( tem2*(1.0-exp(-value)), 0.0 )
            5373     3   p                     endif
            5374     2   p                   enddo
            5375     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 21
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            5376     2  pp                   do k = 1, NLAY
            5377     2   p                     clwt = 1.0e-6 * (plyr(k)*0.001)
            5378     2               
            5379     3   p                     if (clwf(k) > clwt) then
            5380     3   p                       onemrh= max( 1.e-10, 1.0-rhly(k) )
            5381     3   p                       clwm  = clwmin / max( 0.01, plyr(k)*0.001 )
            5382     3               
            5383     3   p                       tem1  = min(max((onemrh*qstl(k))**0.49,0.0001),1.0)  !jhan
            5384     4   p                       if (lmfdeep2) then
            5385     4                             tem1  = xrc3 / tem1
            5386     4   p                       else
            5387     4   p                         tem1  = 100.0 / tem1
            5388     4   p                       endif
            5389     3               
            5390     3   p                       value = max( min( tem1*(clwf(k)-clwm), 50.0 ), 0.0 )
            5391     3   p                       tem2  = sqrt( sqrt(rhly(k)) )
            5392     3               
            5393     3   p                       cldtot(k) = max( tem2*(1.0-exp(-value)), 0.0 )
            5394     3   p                     endif
            5395     2   p                   enddo
            5396     1                     endif
            5397                     
            5398                           end subroutine cloud_fraction1d_XuRandall
            5399                     !+---+-----------------------------------------------------------------+
            5400                     
            5401                     
            5402                     !-----------------------------------                                    !
            5403                           subroutine rhtable                                                &
            5404                     !...................................                                    !
            5405                     
            5406                     !  ---  inputs:
            5407                          &     ( me                                                         &
            5408                     !  ---  outputs:
            5409                          &,      ier )
            5410                     
            5411                     !  ===================================================================  !
            5412                     !                                                                       !
            5413                     ! abstract: cld-rh relations obtained from mitchell-hahn procedure,     !
            5414                     !   here read cld/rh tuning tables for day 0,1,...,5 and merge into 1   !
            5415                     !   file.                                                               !
            5416                     !                                                                       !
            5417                     ! inputs:                                                               !
            5418                     !   me              : check print control flag                          !
            5419                     !                                                                       !
            5420                     ! outputs:                                                              !
            5421                     !   ier             : error flag                                        !
            5422                     !                                                                       !
            5423                     !  ===================================================================  !
            5424                     !
            5425                           implicit none!
            5426                     
            5427                     !  ---  inputs:
            5428                           integer, intent(in) :: me
            5429                     
            5430                     !  ---  output:
            5431                           integer, intent(out) :: ier
            5432                     
            5433                     !  ---  locals:
            5434                           real (kind=kind_phys), dimension(nbin,nlon,nlat,mcld,nseal) ::    &
            5435                          &      rhfd, rtnfd, rhcf, rtncf, rhcla
            5436                     
            5437                           real (kind=kind_io4), dimension(nbin,nlon,nlat,mcld,nseal) ::     &
            5438                          &      rhfd4, rtnfd4
            5439                     
            5440                           real(kind=kind_io4)  :: fhour
            5441                     
            5442                           real(kind=kind_phys) :: binscl, cfrac, clsat, rhsat, cstem
            5443                     
            5444                           integer, dimension(nlon,nlat,mcld,nseal) :: kpts, kkpts
            5445                     
            5446                           integer :: icdays(15), idate(4), nbdayi, isat
            5447                     
            5448                           integer :: i, i1, j, k, l, m, id, im, iy
            5449                     
            5450                     !
            5451                     !===> ...  begin here
            5452                     !
            5453                     
            5454                           ier = 1
            5455                     
            5456                           rewind nicltun
            5457                     
            5458                           binscl = 1.0 / nbin
            5459                     
            5460                     !  ---  array initializations
            5461                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhcla, rtncf, rhcf
                                   <<< Loop-information  End >>>
            5462     1  pp   2             do m=1,nseal
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            5463     2   p   2              do l=1,mcld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            5464     3   p   2               do k=1,nlat
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            5465     4   p   2                do j=1,nlon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            5466     5   p   2                 do i=1,nbin
            5467     5   p   2                   rhcf (i,j,k,l,m) = 0.0
            5468     5   p   2                   rtncf(i,j,k,l,m) = 0.0
            5469     5   p   2                   rhcla(i,j,k,l,m) = -0.1
            5470     5   p   2                 enddo
            5471     4   p   2                enddo
            5472     3   p   2               enddo
            5473     2   p   2              enddo
            5474     1   p   2             enddo
            5475                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 116
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5476         s   f             kkpts = 0
            5477                     
            5478                     !  ---  read the data off the rotating file
            5479                     
            5480                           read (nicltun,err=998,end=999) nbdayi, icdays
            5481                     
            5482                           if (me == 0) print 11, nbdayi
            5483                       11  format('   from rhtable days on file =',i5)
            5484                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      icdays
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5485     1   s                 do i = 1, nbdayi
            5486     1   p                  id = icdays(i) / 10000
            5487     1   p                  im = (icdays(i)-id*10000) / 100
            5488     1   p                  iy = icdays(i)-id*10000-im*100

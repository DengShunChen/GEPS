            1894     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.76, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp
                                   <<<      cldtot, res
                                   <<< Loop-information  End >>>
            1895     2   p                   do i = 1, IX
            1896     2   p                     clouds(i,k,1) = cldtot(i,k)
            1897     2   p                     clouds(i,k,2) = cwp(i,k)
            1898     2   p                     clouds(i,k,3) = rew(i,k)
            1899     2   p                     clouds(i,k,4) = cip(i,k)
            1900     2   p                     clouds(i,k,5) = rei(i,k)
            1901     2   p                     clouds(i,k,6) = crp(i,k)  ! added for Thompson
            1902     2   p                     clouds(i,k,7) = rer(i,k)
            1903     2   p                     clouds(i,k,8) = csp(i,k)  ! added for Thompson
            1904     2   p                     clouds(i,k,9) = res(i,k)
            1905     2   p                   enddo
            1906     1   p                 enddo
            1907                     
            1908                     
            1909                     !> -# Call gethml() to compute low,mid,high,total, and boundary layer
            1910                     !!    cloud fractions and clouds top/bottom layer indices for low, mid,
            1911                     !!    and high clouds.
            1912                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            1913                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            1914                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            1915                     !       overlapping method is defined by control flag 'iovr', which may
            1916                     !       be different for lw and sw radiation programs.
            1917                     
            1918                           call gethml                                                       &
            1919                     !  ---  inputs:
            1920                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            1921                          &       ix,nlay,                                                   &
            1922                     !  ---  outputs:
            1923                          &       clds, mtop, mbot                                           &
            1924                          &     )
            1925                     
            1926                     
            1927                     !
            1928                           return
            1929                     !...................................
            1930                           end subroutine progcld4
            1931                     !-----------------------------------
            1932                     
            1933                     
            1934                     !-----------------------------------
            1935                           subroutine progcld5                                               &
            1936                     !...................................
            1937                     !
            1938                     !  ---  inputs:
            1939                                ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,cnvw,cnvc,          &
            1940                                  xlat,xlon,slmsk,IX, NLAY, NLP1,                            &
            1941                                  cldcov,                                                    &
            1942                     !  ---  outputs:
            1943                          &       clouds,clds,mtop,mbot                                      &
            1944                          &      )
            1945                     
            1946                     ! =================   subprogram documentation block   ================ !
            1947                     !                                                                       !
            1948                     ! subprogram:    progcld5    computes cloud related quantities using    !
            1949                     !   GFDL Lin MP prognostic cloud microphysics scheme.                   !
            1950                     !                                                                       !
            1951                     ! abstract:  this program computes cloud fractions from cloud           !
            1952                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            1953                     !   and computes the low, mid, high, total and boundary layer cloud     !
            1954                     !   fractions and the vertical indices of low, mid, and high cloud      !
            1955                     !   top and base.  the three vertical cloud domains are set up in the   !
            1956                     !   initial subroutine "cld_init".                                      !
            1957                     !                                                                       !
            1958                     ! usage:         call progcld5                                          !
            1959                     !                                                                       !
            1960                     ! subprograms called:   gethml                                          !
            1961                     !                                                                       !
            1962                     ! attributes:                                                           !
            1963                     !   language:   fortran 90                                              !
            1964                     !   machine:    ibm-sp, sgi                                             !
            1965                     !                                                                       !
            1966                     !                                                                       !
            1967                     !  ====================  definition of variables  ====================  !
            1968                     !                                                                       !
            1969                     ! input variables:                                                      !
            1970                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            1971                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            1972                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            1973                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            1974                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            1975                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            1976                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            1977                     !   clw   (IX,NLAY) : layer cloud condensate amount                     !
            1978                     !   cnvw  (IX,NLAY) : layer convective cloud condensate                 !
            1979                     !   cnvc  (IX,NLAY) : layer convective cloud cover                      !
            1980                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            1981                     !                     range, otherwise see in-line comment              !
            1982                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            1983                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            1984                     !   IX              : horizontal dimention                              !
            1985                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            1986                     !   cldcov(IX,NLAY) : total cloud fraction                              !
            1987                     !                                                                       !
            1988                     ! output variables:                                                     !
            1989                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            1990                     !      clouds(:,:,1) - layer total cloud fraction, =cldcov(IX,NLAY)     !
            1991                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            1992                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            1993                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            1994                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            1995                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            1996                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            1997                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            1998                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            1999                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            2000                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            2001                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            2002                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            2003                     !                                                                       !
            2004                     ! module variables:                                                     !
            2005                     !   ivflip          : control flag of vertical index direction          !
            2006                     !                     =0: index from toa to surface                     !
            2007                     !                     =1: index from surface to toa                     !
            2008                     !   lsashal         : control flag for shallow convection               !
            2009                     !   lcrick          : control flag for eliminating CRICK                !
            2010                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2011                     !                     =f: do not apply layer smoothing                  !
            2012                     !   lcnorm          : control flag for in-cld condensate                !
            2013                     !                     =t: normalize cloud condensate                    !
            2014                     !                     =f: not normalize cloud condensate                !
            2015                     !                                                                       !
            2016                     !  ====================    end of description    =====================  !
            2017                     !
            2018                           implicit none
            2019                     
            2020                     !  ---  inputs
            2021                           integer,  intent(in) :: IX, NLAY, NLP1
            2022                     
            2023                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            2024                          &       tlyr, tvly, qlyr, qstl, rhly, clw, cnvw, cnvc, cldcov!,     &
            2025                     !             re_cloud, re_ice, re_snow
            2026                     
            2027                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2028                          &       slmsk
            2029                     
            2030                     !  ---  outputs
            2031                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2032                     
            2033                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2034                     
            2035                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2036                     
            2037                     !  ---  local variables:
            2038                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv,              &
            2039                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf, &
            2040                          &       cldtot
            2041                     
            2042                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2043                     
            2044                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            2045                          &       tem1, tem2, tem3
            2046                     
            2047                           integer :: i, k, id, nf
            2048                     
            2049                     !
            2050                     !===> ... begin here
            2051                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2052        pp   4             cldtot = cldcov
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2053     1  pp                 do nf=1,nf_clds
            2054     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2055     3   p   4                 do i=1,ix
            2056     3   p   4                   clouds(i,k,nf) = 0.0
            2057     3   p   4                 enddo
            2058     2   p                   enddo
            2059     1   p                 enddo
            2060                     !     clouds(:,:,:) = 0.0
            2061                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      res, cwp, cip, crp, csp, tem2d, rew, rei
                                   <<<      cldcnv, rer, clwf
                                   <<< Loop-information  End >>>
            2062     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.41, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      res, cwp, cip, crp, csp, rew, rei, rer
                                   <<<      tem2d, clwf, cldcnv
                                   <<< Loop-information  End >>>
            2063     2   p                   do i = 1, IX
            2064     2   p                     cldcnv(i,k) = 0.0
            2065     2   p                     cwp   (i,k) = 0.0
            2066     2   p                     cip   (i,k) = 0.0
            2067     2   p                     crp   (i,k) = 0.0
            2068     2   p                     csp   (i,k) = 0.0
            2069     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
            2070     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
            2071     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            2072     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
            2073     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
            2074     2   p                     clwf(i,k)   = 0.0
            2075     2   p                   enddo
            2076     1   p                 enddo
            2077                     !
            2078     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2079     2  pp   2               do i = 1, IX
            2080     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
            2081     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
            2082     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2083     2  pp                   do k = 2, NLAY-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2084     3   p   2                 do i = 1, IX
            2085     3   p   2                   clwf(i,K) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
            2086     3   p   2                 enddo
            2087     2   p                   enddo
            2088     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2089     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2090     3   p   4                 do i = 1, IX
            2091     3   p   4                   clwf(i,k) = clw(i,k)
            2092     3   p   4                 enddo
            2093     2   p                   enddo
            2094     1                     endif
            2095                     
            2096                     !  ---  find top pressure for each cloud domain for given latitude
            2097                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2098                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2099                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2100     1  pp                 do id = 1, 4
            2101     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2102     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2103     2   p   2               do i =1, IX
            2104     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2105     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2106     2               
            2107     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2108     2   p   2               enddo
            2109     1   p                 enddo
            2110                     
            2111                     !  ---  compute liquid/ice condensate path in g/m**2
            2112                     
            2113     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
            2114     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
            2115     3   p                     do i = 1, IX
            2116     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2117     3   p                       clwt     = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
            2118     3   p                       cip(i,k) = clwt * tem2d(i,k)
            2119     3   p                       cwp(i,k) = clwt - cip(i,k)
            2120     3   p                     enddo
            2121     2   p                   enddo
            2122     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
            2123     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
            2124     3   p                     do i = 1, IX
            2125     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2126     3   p                       clwt     = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
            2127     3   p                       cip(i,k) = clwt * tem2d(i,k)
            2128     3   p                       cwp(i,k) = clwt - cip(i,k)
            2129     3   p                     enddo
            2130     2   p                   enddo
            2131     1                     endif                            ! end_if_ivflip
            2132                     
            2133                     !  ---  effective liquid cloud droplet radius over land
            2134                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            2135     1  pp                 do i = 1, IX
            2136     2   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            2137     3   p   4                 do k = 1, NLAY
            2138     3   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            2139     3   p   4                 enddo
            2140     2   p                   endif
            2141     1   p                 enddo
            2142                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2143     1  pp   2             do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2144     2   p   2               do i = 1, IX
            2145     3   p   2                 if (cldtot(i,k) < climit) then
            2146     3   p   2                   cwp(i,k)    = 0.0
            2147     3   p   2                   cip(i,k)    = 0.0
            2148     3   p   2                   crp(i,k)    = 0.0
            2149     3   p   2                   csp(i,k)    = 0.0
            2150     3   p   2                 endif
            2151     2   p   2               enddo
            2152     1   p   2             enddo
            2153                     
            2154     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2155     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2156     3   p                     do i = 1, IX
            2157     4   p                       if (cldtot(i,k) >= climit) then
            2158     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            2159     4   p                         cwp(i,k) = cwp(i,k) * tem1
            2160     4   p                         cip(i,k) = cip(i,k) * tem1
            2161     4   p                         crp(i,k) = crp(i,k) * tem1
            2162     4   p                         csp(i,k) = csp(i,k) * tem1
            2163     4   p                       endif
            2164     3   p                     enddo
            2165     2   p                   enddo
            2166     1                     endif
            2167                     
            2168                     !  ---  effective ice cloud droplet radius
            2169                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2170,2195)
                                   <<< Loop-information  End >>>
            2170     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2171,2196)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, cwp, rew, rei, rer, res
                                   <<< Loop-information  End >>>
            2171     2   p                   do i = 1, IX
            2172     2   p                     tem2 = tlyr(i,k) - con_ttp
            2173     2               
            2174     3   p                     if (cip(i,k) > 0.0) then
            2175     3   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            2176     3               
            2177     4   p                       if (tem2 < -50.0) then
            2178     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            2179     4   p                       elseif (tem2 < -40.0) then
            2180     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            2181     4   p                       elseif (tem2 < -30.0) then
            2182     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            2183     4   p                       else
            2184     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            2185     4   p                       endif
            2186     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            2187     3               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            2188     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            2189     3               !           rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            2190     3   p                     endif
            2191     2   p                   enddo
            2192     1   p                 enddo
            2193                     
            2194                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2195     1                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2196     2                       do i = 1, IX
            2197     2   p                     clouds(i,k,1) = cldtot(i,k)
            2198     2   p                     clouds(i,k,2) = cwp(i,k)
            2199     2   p                     clouds(i,k,3) = rew(i,k)
            2200     2   p                     clouds(i,k,4) = cip(i,k)
            2201     2   p                     clouds(i,k,5) = rei(i,k)
            2202     2               !         clouds(i,k,6) = 0.0
            2203     2   p                     clouds(i,k,7) = rer(i,k)
            2204     2               !         clouds(i,k,8) = 0.0
            2205     2   p                     clouds(i,k,9) = res(i,k)
            2206     2                       enddo
            2207     1                     enddo
            2208                     
            2209                     
            2210                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            2211                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            2212                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            2213                     !       overlapping method is defined by control flag 'iovr', which may
            2214                     !       be different for lw and sw radiation programs.
            2215                     
            2216                           call gethml                                                       &
            2217                     !  ---  inputs:
            2218                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            2219                          &       IX,NLAY,                                                   &
            2220                     !  ---  outputs:
            2221                          &       clds, mtop, mbot                                           &
            2222                          &     )
            2223                     
            2224                     
            2225                     !
            2226                           return
            2227                     !...................................
            2228                           end subroutine progcld5
            2229                     !-----------------------------------
            2230                     
            2231                     
            2232                     
            2233                     !-----------------------------------
            2234                           subroutine progcld5o                                              &
            2235                     !...................................
            2236                     !
            2237                     !  ---  inputs:
            2238                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
            2239                          &       xlat,xlon,slmsk,                                           &
            2240                          &       ntrac,ntcw,ntiw,ntrw,ntsw,ntgl,cldcov,                     &
            2241                          &       effr_cw,effr_iw,effr_sw,effr_rw,effr_in,                   &
            2242                          &       IX, NLAY, NLP1,                                            &
            2243                     !  ---  outputs:
            2244                          &       clouds,clds,mtop,mbot                                      &
            2245                          &      )
            2246                     
            2247                     ! =================   subprogram documentation block   ================ !
            2248                     !                                                                       !
            2249                     ! subprogram:    progcld5o   computes cloud related quantities using    !
            2250                     !   GFDL Lin MP prognostic cloud microphysics scheme. Moist species     !
            2251                     !   from MP are fed into the corresponding arrays for calcuation of     !
            2252                     !                                                                       !
            2253                     ! abstract:  this program computes cloud fractions from cloud           !
            2254                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            2255                     !   and computes the low, mid, high, total and boundary layer cloud     !
            2256                     !   fractions and the vertical indices of low, mid, and high cloud      !
            2257                     !   top and base.  the three vertical cloud domains are set up in the   !
            2258                     !   initial subroutine "cld_init".                                      !
            2259                     !                                                                       !
            2260                     ! usage:         call progcld5o                                         !
            2261                     !                                                                       !
            2262                     ! subprograms called:   gethml                                          !
            2263                     !                                                                       !
            2264                     ! attributes:                                                           !
            2265                     !   language:   fortran 90                                              !
            2266                     !   machine:    ibm-sp, sgi                                             !
            2267                     !                                                                       !
            2268                     !                                                                       !
            2269                     !  ====================  definition of variables  ====================  !
            2270                     !                                                                       !
            2271                     ! input variables:                                                      !
            2272                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            2273                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            2274                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            2275                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            2276                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            2277                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            2278                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            2279                     !   clw   (IX,NLAY,NTRAC) : layer cloud condensate amount               !
            2280                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            2281                     !                     range, otherwise see in-line comment              !
            2282                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            2283                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            2284                     !   ntrac           : number of tracers
            2285                     !   ntcw            : index for liquid water
            2286                     !   ntiw            : index for ice water
            2287                     !   ntrw            : index for rain water
            2288                     !   ntsw            : index for snow water
            2289                     !   ntgl            : index for graupel
            2290                     !   cldcov(IX,NLAY) : total cloud fraction
            2291                     !   effr_cw(IX,NLAY): effective radius of liquid water (mm)             !
            2292                     !   effr_iw(IX,NLAY): effective radius of ice water (mm)                !
            2293                     !   effr_rw(IX,NLAY): effective radius of rain water (mm)               !
            2294                     !   effr_sw(IX,NLAY): effective radius of snow water (mm)               !
            2295                     !   IX              : horizontal dimention                              !
            2296                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            2297                     !                                                                       !
            2298                     ! output variables:                                                     !
            2299                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            2300                     !      clouds(:,:,1) - layer total cloud fraction                       !
            2301                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            2302                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            2303                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            2304                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            2305                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            2306                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            2307                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            2308                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            2309                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            2310                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            2311                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            2312                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            2313                     !                                                                       !
            2314                     ! module variables:                                                     !
            2315                     !   ivflip          : control flag of vertical index direction          !
            2316                     !                     =0: index from toa to surface                     !
            2317                     !                     =1: index from surface to toa                     !
            2318                     !   lsashal         : control flag for shallow convection               !
            2319                     !   lcrick          : control flag for eliminating CRICK                !
            2320                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2321                     !                     =f: do not apply layer smoothing                  !
            2322                     !   lcnorm          : control flag for in-cld condensate                !
            2323                     !                     =t: normalize cloud condensate                    !
            2324                     !                     =f: not normalize cloud condensate                !
            2325                     !                                                                       !
            2326                     !  ====================    end of description    =====================  !
            2327                     !
            2328                           implicit none
            2329                     
            2330                     !  ---  inputs
            2331                           integer,  intent(in) :: IX, NLAY, NLP1
            2332                           integer,  intent(in) :: ntrac, ntcw, ntiw, ntrw, ntsw, ntgl
            2333                     
            2334                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            2335                          &       tlyr, tvly, qlyr, qstl, rhly, cldcov
            2336                     
            2337                     
            2338                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: clw
            2339                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2340                          &       slmsk
            2341                     
            2342                           real (kind=kind_phys), dimension(:,:), intent(in) :: effr_cw,     &
            2343                          &       effr_iw, effr_rw, effr_sw
            2344                     
            2345                           logical, intent(in) :: effr_in
            2346                     
            2347                     !  ---  outputs
            2348                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2349                     
            2350                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2351                     
            2352                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2353                     
            2354                     !  ---  local variables:
            2355                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv,              &
            2356                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d
            2357                     
            2358                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2359                     
            2360                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            2361                          &       tem1, tem2, tem3
            2362                           real (kind=kind_phys), dimension(IX,NLAY) :: cldtot
            2363                     
            2364                           integer :: i, k, id, nf
            2365                     
            2366                     !
            2367                     !===> ... begin here
            2368                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2369     1  pp                 do nf=1,nf_clds
            2370     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2371     3   p   4                 do i=1,ix
            2372     3   p   4                   clouds(i,k,nf) = 0.0
            2373     3   p   4                 enddo
            2374     2   p                   enddo
            2375     1   p                 enddo
            2376                     !     clouds(:,:,:) = 0.0
            2377                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp, rew, tem2d, cldcnv, rei, cwp
                                   <<<      rer, res, cldtot, cip
                                   <<< Loop-information  End >>>
            2378     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.28, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, crp, csp, rew, rei
                                   <<<      rer, res, tem2d, cldtot
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2379     2   p                   do i = 1, IX
            2380     2   p                     cldcnv(i,k) = 0.0
            2381     2   p                     cwp   (i,k) = 0.0
            2382     2   p                     cip   (i,k) = 0.0
            2383     2   p                     crp   (i,k) = 0.0
            2384     2   p                     csp   (i,k) = 0.0
            2385     3   p                     if ( effr_in ) then
            2386     3   p                       rew (i,k) = effr_cw (i,k)
            2387     3   p                       rei (i,k) = effr_iw (i,k)
            2388     3   p                       rer (i,k) = effr_rw (i,k)
            2389     3   p                       res (i,k) = effr_sw (i,k)
            2390     3   p                     else
            2391     3   p                       rew (i,k) = reliq_def            ! default liq radius to 10 micron
            2392     3   p                       rei (i,k) = reice_def            ! default ice radius to 50 micron
            2393     3   p                       rer (i,k) = rrain_def            ! default rain radius to 1000 micron
            2394     3   p                       res (i,k) = rsnow_def            ! default snow radius to 250 micron
            2395     3   p                     endif
            2396     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
            2397     2   p                     cldtot(i,k) = cldcov(i,k)
            2398     2   p                   enddo
            2399     1   p                 enddo
            2400                     
            2401                     !  ---  find top pressure for each cloud domain for given latitude
            2402                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2403                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2404                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2405     1  pp                 do id = 1, 4
            2406     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2407     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2408     2   p   2               do i =1, IX
            2409     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2410     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2411     2               
            2412     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2413     2   p   2               enddo
            2414     1   p                 enddo
            2415                     
            2416                     !  ---  compute liquid/ice condensate path in g/m**2
            2417                     
            2418     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2419     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.10, ITR: 11, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2420     3   p                     do i = 1, IX
            2421     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2422     3   p                       cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            2423     3   p                       cip(i,k) = max(0.0, clw(i,k,ntiw) * gfac * delp(i,k))
            2424     3   p                       crp(i,k) = max(0.0, clw(i,k,ntrw) * gfac * delp(i,k))
            2425     3   p                       csp(i,k) = max(0.0, (clw(i,k,ntsw)+clw(i,k,ntgl)) *         &
            2426     3                    &                  gfac * delp(i,k))
            2427     3   p                     enddo
            2428     2   p                   enddo
            2429     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, crp, cip, csp
                                   <<< Loop-information  End >>>
            2430     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.10, ITR: 11, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2431     3   p                     do i = 1, IX
            2432     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2433     3   p                       cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            2434     3   p                       cip(i,k) = max(0.0, clw(i,k,ntiw) * gfac * delp(i,k))
            2435     3   p                       crp(i,k) = max(0.0, clw(i,k,ntrw) * gfac * delp(i,k))
            2436     3   p                       csp(i,k) = max(0.0, (clw(i,k,ntsw)+clw(i,k,ntgl)) *         &
            2437     3                    &                  gfac * delp(i,k))
            2438     3   p                     enddo
            2439     2   p                   enddo
            2440     1                     endif                            ! end_if_ivflip
            2441                     
            2442                     !  ---  effective liquid cloud droplet radius over land
            2443                     
            2444     1                     if ( .not. effr_in ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            2445     2  pp                 do i = 1, IX
            2446     3   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            2447     4   p   4                 do k = 1, NLAY
            2448     4   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            2449     4   p   4                 enddo
            2450     3   p                   endif
            2451     2   p                 enddo
            2452     1                     endif
            2453                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2454     1  pp   2             do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2455     2   p   2               do i = 1, IX
            2456     3   p   2                 if (cldtot(i,k) < climit) then
            2457     3   p   2                   cldtot(i,k) = 0.0
            2458     3   p   2                   cwp(i,k)    = 0.0
            2459     3   p   2                   cip(i,k)    = 0.0
            2460     3   p   2                   crp(i,k)    = 0.0
            2461     3   p   2                   csp(i,k)    = 0.0
            2462     3   p   2                 endif
            2463     2   p   2               enddo
            2464     1   p   2             enddo
            2465                     
            2466     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2467     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2468     3   p                     do i = 1, IX
            2469     4   p                       if (cldtot(i,k) >= climit) then
            2470     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            2471     4   p                         cwp(i,k) = cwp(i,k) * tem1
            2472     4   p                         cip(i,k) = cip(i,k) * tem1
            2473     4   p                         crp(i,k) = crp(i,k) * tem1
            2474     4   p                         csp(i,k) = csp(i,k) * tem1
            2475     4   p                       endif
            2476     3   p                     enddo
            2477     2   p                   enddo
            2478     1                     endif
            2479                     
            2480                     !  ---  effective ice cloud droplet radius
            2481                     
            2482     1                     if ( .not. effr_in ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2483     2  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip
                                   <<< Loop-information  End >>>
            2484     3   p                   do i = 1, IX
            2485     3   p                     tem2 = tlyr(i,k) - con_ttp
            2486     3               
            2487     4   p                     if (cip(i,k) > 0.0) then
            2488     4   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            2489     4               
            2490     5   p                       if (tem2 < -50.0) then
            2491     5   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            2492     5   p                       elseif (tem2 < -40.0) then
            2493     5   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            2494     5   p                       elseif (tem2 < -30.0) then
            2495     5   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            2496     5   p                       else
            2497     5   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            2498     5   p                       endif
            2499     4               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            2500     4               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            2501     4   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            2502     4               !           rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            2503     4   p                     endif
            2504     3   p                   enddo
            2505     2   p                 enddo
            2506     1                     endif
            2507                     
            2508                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cwp, rew, cip, rei, crp, rer
                                   <<<      csp, res
                                   <<< Loop-information  End >>>
            2509     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.76, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp
                                   <<<      cldtot, res
                                   <<< Loop-information  End >>>
            2510     2   p                   do i = 1, IX
            2511     2   p                     clouds(i,k,1) = cldtot(i,k)
            2512     2   p                     clouds(i,k,2) = cwp(i,k)
            2513     2   p                     clouds(i,k,3) = rew(i,k)
            2514     2   p                     clouds(i,k,4) = cip(i,k)
            2515     2   p                     clouds(i,k,5) = rei(i,k)
            2516     2   p                     clouds(i,k,6) = crp(i,k)
            2517     2   p                     clouds(i,k,7) = rer(i,k)
            2518     2   p                     clouds(i,k,8) = csp(i,k)
            2519     2   p                     clouds(i,k,9) = res(i,k)
            2520     2   p                   enddo
            2521     1   p                 enddo
            2522                     
            2523                     
            2524                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            2525                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            2526                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            2527                     !       overlapping method is defined by control flag 'iovr', which may
            2528                     !       be different for lw and sw radiation programs.
            2529                     
            2530                           call gethml                                                       &
            2531                     !  ---  inputs:
            2532                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            2533                          &       IX,NLAY,                                                   &
            2534                     !  ---  outputs:
            2535                          &       clds, mtop, mbot                                           &
            2536                          &     )
            2537                     
            2538                     
            2539                     !
            2540                           return
            2541                     !...................................
            2542                           end subroutine progcld5o
            2543                     !-----------------------------------
            2544                     
            2545                     !-----------------------------------
            2546                           subroutine progcld6                                               &
            2547                     !...................................
            2548                     
            2549                     !  ---  inputs:
            2550                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,cnvw,cnvc,              &
            2551                          &       qw,qr,qi,qs,qg,                                            &
            2552                          &       cldcov,slmsk,                                              &
            2553                          &       effr_cw,effr_iw,effr_sw,effr_rw,effr_in,                   &
            2554                          &       xlat,xlon,IX,NLAY,NLP1,                                    &
            2555                     !  ---  outputs:
            2556                          &       clouds,clds,mtop,mbot                                      &
            2557                          &      )
            2558                     
            2559                     ! =================   subprogram documentation block   ================ !
            2560                     !                                                                       !
            2561                     ! subprogram:    progcld1    computes cloud related quantities using    !
            2562                     !   zhao/moorthi's prognostic cloud microphysics scheme.                !
            2563                     !                                                                       !
            2564                     ! abstract:  this program computes cloud fractions from cloud           !
            2565                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            2566                     !   and computes the low, mid, high, total and boundary layer cloud     !
            2567                     !   fractions and the vertical indices of low, mid, and high cloud      !
            2568                     !   top and base.  the three vertical cloud domains are set up in the   !
            2569                     !   initial subroutine "cld_init".                                      !
            2570                     !                                                                       !
            2571                     ! usage:         call progcld1                                          !
            2572                     !                                                                       !
            2573                     ! subprograms called:   gethml                                          !
            2574                     !                                                                       !
            2575                     ! attributes:                                                           !
            2576                     !   language:   fortran 90                                              !
            2577                     !   machine:    ibm-sp, sgi                                             !
            2578                     !                                                                       !
            2579                     !                                                                       !
            2580                     !  ====================  definition of variables  ====================  !
            2581                     !                                                                       !
            2582                     ! input variables:                                                      !
            2583                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            2584                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            2585                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            2586                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            2587                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            2588                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            2589                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            2590                     !   cnvw  (ix,nlay) : layer convective cloud condensate                 !
            2591                     !   cnvc  (ix,nlay) : layer convective cloud cover                      !
            2592                     !   qw    (ix,nlay) : cloud water mixing ratio (kg/kg)                  !
            2593                     !   qr    (ix,nlay) : rain water mixing ratio (kg/kg)                   !
            2594                     !   qi    (ix,nlay) : cloud ice mixing ratio (kg/kg)                    !
            2595                     !   qs    (ix,nlay) : snow water mixing ratio (kg/kg)                   !
            2596                     !   qg    (ix,nlay) : graupel mixing ratio (kg/kg)                      !
            2597                     !   qa    (ix,nlay) : aerosol mixing ratio (kg/kg)                      !
            2598                     !   cldtot(ix,nlay) : layer cloud fraction                              !
            2599                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            2600                     !   snowd (ix)      : snow depth                                        !
            2601                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            2602                     !                     range, otherwise see in-line comment              !
            2603                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            2604                     !   IX              : horizontal dimention                              !
            2605                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            2606                     !                                                                       !
            2607                     ! output variables:                                                     !
            2608                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            2609                     !      clouds(:,:,1) - layer total cloud fraction                       !
            2610                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            2611                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            2612                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            2613                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            2614                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            2615                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            2616                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            2617                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            2618                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            2619                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            2620                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            2621                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            2622                     !                                                                       !
            2623                     ! module variables:                                                     !
            2624                     !   ivflip          : control flag of vertical index direction          !
            2625                     !                     =0: index from toa to surface                     !
            2626                     !                     =1: index from surface to toa                     !
            2627                     !   lsashal         : control flag for shallow convection               !
            2628                     !   lcrick          : control flag for eliminating CRICK                !
            2629                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2630                     !                     =f: do not apply layer smoothing                  !
            2631                     !   lcnorm          : control flag for in-cld condensate                !
            2632                     !                     =t: normalize cloud condensate                    !
            2633                     !                     =f: not normalize cloud condensate                !
            2634                     !                                                                       !
            2635                     !  ====================    end of description    =====================  !
            2636                     
            2637                           use physpara,           only : icmphys
            2638                     !      use cld_eff_rad_v2,     only : cld_eff_rad
            2639                     !      use module_mp_gfdl_v3,  only : cld_eff_rad_v3
            2640                     !
            2641                           implicit none
            2642                     
            2643                     !  ---  inputs
            2644                           integer,  intent(in) :: IX, NLAY, NLP1
            2645                     
            2646                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            2647                          &       tlyr, tvly, qlyr, qstl, rhly,  cnvw, cnvc
            2648                     
            2649                           real (kind=kind_phys), dimension(:,:), intent(inout) ::           &
            2650                          &       qw, qr, qi, qs, qg
            2651                           real (kind=kind_phys), dimension(:,:), intent(inout) :: cldcov
            2652                     
            2653                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2654                          &       slmsk
            2655                     
            2656                           real (kind=kind_phys), dimension(:,:), intent(in) :: effr_cw,     &
            2657                          &       effr_iw, effr_rw, effr_sw
            2658                     
            2659                           logical, intent(in) :: effr_in
            2660                     
            2661                     !  ---  outputs
            2662                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2663                     
            2664                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2665                     
            2666                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2667                     
            2668                     !  ---  local variables:
            2669                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv, cldtot,      &
            2670                          &       cwp, cip, crp, csp, cgp, rew, rei, res, rer, reg, delp,    &
            2671                          &       tem2d, clwf
            2672                     
            2673                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2674                     
            2675                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            2676                          &       tem1, tem2, tem3
            2677                     
            2678                           real, parameter :: qmin = 1.0e-12  !minimum mass mixing ratio (kg / kg)
            2679                     
            2680                           integer :: i, k, id, nf
            2681                     
            2682                     !
            2683                     !===> ... begin here
            2684                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2685     1  pp                 do nf=1,nf_clds
            2686     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2687     3   p   4                 do i=1,ix
            2688     3   p   4                   clouds(i,k,nf) = 0.0
            2689     3   p   4                 enddo
            2690     2   p                   enddo
            2691     1   p                 enddo
            2692                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2693,2718)
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            2693     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2694,2719)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      csp, cldcnv, rew, rei, rer, res, cldtot
                                   <<<      tem2d, delp, cwp, cip, crp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 68
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2694     2   p                   do i = 1, IX
            2695     2   p                     cldcnv(i,k) = 0.0
            2696     2   p                     cwp   (i,k) = 0.0
            2697     2   p                     cip   (i,k) = 0.0
            2698     2   p                     crp   (i,k) = 0.0
            2699     2   p                     csp   (i,k) = 0.0
            2700     3   p                     if ( effr_in ) then
            2701     3   p                       rew (i,k) = effr_cw (i,k)
            2702     3   p                       rei (i,k) = effr_iw (i,k)
            2703     3   p                       rer (i,k) = effr_rw (i,k)
            2704     3   p                       res (i,k) = effr_sw (i,k)
            2705     3   p                     else
            2706     3   p                       rew (i,k) = reliq_def            ! default liq radius to 10 micron
            2707     3   p                       rei (i,k) = reice_def            ! default ice radius to 50 micron
            2708     3   p                       rer (i,k) = rrain_def            ! default rain radius to 1000 micron
            2709     3   p                       res (i,k) = rsnow_def            ! default snow radius to 250 micron
            2710     3   p                     endif
            2711     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
            2712     2   p                     cldtot(i,k) = cldcov(i,k)
            2713     2   p                   enddo
            2714     1   p                 enddo
            2715                     
            2716                     !  ---  compute liquid/ice condensate path in g/m**2
            2717                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2718     1                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2719     2                       do i = 1, IX
            2720     3   p                     if ( ivflip == 0 ) then          ! input data from toa to sfc
            2721     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2722     3   p                     else                             ! input data from sfc to toa
            2723     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2724     3   p                     endif
            2725     2               
            2726     2   p                     if ( qw(i,k) .gt. qmin ) cwp(i,k) = qw(i,k) * gfac * delp(i,k)
            2727     2   p                     if ( qi(i,k) .gt. qmin ) cip(i,k) = qi(i,k) * gfac * delp(i,k)
            2728     2   p                     if ( qr(i,k) .gt. qmin ) crp(i,k) = qr(i,k) * gfac * delp(i,k)
            2729     2   p                     if ( qs(i,k)+qg(i,k) .gt. qmin ) &
            2730     2                                        csp(i,k) = (qs(i,k)+qg(i,k)) * gfac * delp(i,k)
            2731     2                       enddo
            2732     1                     enddo
            2733                     
            2734                     !      if ( icmphys .eq. 12 ) then
            2735                     !      call cld_eff_rad (1, IX, 1, NLAY, slmsk, plyr*100,                &
            2736                     !     &                  abs(plvl(:,1:NLAY)-plvl(:,2:NLAY+1))*100,       &
            2737                     !     &                  tlyr, qw, qi, qr, qs, qg, qa, cwp, cip, crp,    &
            2738                     !     &                  csp, cgp, rew, rei, rer, res, reg, cldtot,      &
            2739                     !     &                  snowd, cnvw=cnvw, cnvc=cnvc)
            2740                     !      cldcnv = 0.0
            2741                     !      elseif ( icmphys .eq. 13 ) then
            2742                     !      call cld_eff_rad_v3 (1, IX, 1, NLAY, slmsk, plyr*100,             &
            2743                     !     &                  abs(plvl(:,1:NLAY)-plvl(:,2:NLAY+1))*100,       &
            2744                     !     &                  tlyr, qw, qi, qr, qs, qg, qa, cwp, cip, crp,    &
            2745                     !     &                  csp, cgp, rew, rei, rer, res, reg, cldtot,      &
            2746                     !     &                  snowd, cnvw=cnvw, cnvc=cnvc)
            2747                     !      cldcnv = 0.0
            2748                     !      endif
            2749                     
            2750                     
            2751                     !  ---  find top pressure for each cloud domain for given latitude
            2752                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2753                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2754                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2755     1  pp                 do id = 1, 4
            2756     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2757     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2758     2   p   2               do i =1, IX
            2759     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2760     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2761     2               
            2762     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2763     2   p   2               enddo
            2764     1   p                 enddo
            2765                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cwp, rew, cip, rei, crp, rer
                                   <<<      csp, res
                                   <<< Loop-information  End >>>
            2766     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.76, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp
                                   <<<      cldtot, res
                                   <<< Loop-information  End >>>
            2767     2   p                   do i = 1, IX
            2768     2   p                     clouds(i,k,1) = cldtot(i,k)
            2769     2   p                     clouds(i,k,2) = cwp(i,k)
            2770     2   p                     clouds(i,k,3) = rew(i,k)
            2771     2   p                     clouds(i,k,4) = cip(i,k)
            2772     2   p                     clouds(i,k,5) = rei(i,k)
            2773     2   p                     clouds(i,k,6) = crp(i,k)
            2774     2   p                     clouds(i,k,7) = rer(i,k)
            2775     2   p                     clouds(i,k,8) = csp(i,k)
            2776     2   p                     clouds(i,k,9) = res(i,k)
            2777     2               !          clouds(i,k,10) = cgp(i,k)
            2778     2               !          clouds(i,k,11) = reg(i,k)
            2779     2   p                   enddo
            2780     1   p                 enddo
            2781                     
            2782                     
            2783                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            2784                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            2785                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            2786                     !       overlapping method is defined by control flag 'iovr', which may
            2787                     !       be different for lw and sw radiation programs.
            2788                     
            2789                           call gethml                                                       &
            2790                     !  ---  inputs:
            2791                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            2792                          &       IX,NLAY,                                                   &
            2793                     !  ---  outputs:
            2794                          &       clds, mtop, mbot                                           &
            2795                          &     )
            2796                     
            2797                     
            2798                     !
            2799                           return
            2800                     !...................................
            2801                           end subroutine progcld6
            2802                     !-----------------------------------
            2803                     
            2804                     !............................................
            2805                     !> This subroutine added by G. Thompson specifically to account for
            2806                     !! explicit (microphysics-produced) cloud liquid water, cloud ice, and
            2807                     !! snow with 100% cloud fraction.  Also, a parameterization for cloud
            2808                     !! fraction less than 1.0 but greater than 0.0 follows Mocko and Cotton
            2809                     !! (1996) from Sundqvist et al. (1989) with cloud fraction increasing
            2810                     !! as RH increases above a critical value.  In locations with non-zero
            2811                     !! (but less than 1.0) cloud fraction, there MUST be a value assigned
            2812                     !! to cloud liquid water and ice or else there is zero impact in the
            2813                     !! RRTMG radiation scheme.
            2814                           subroutine progcld_thompson                                       &
            2815                     !  --- inputs
            2816                                ( plyr,plvl,tlyr,qlyr,qstl,rhly,clw,                         &
            2817                                  xlat,xlon,slmsk,                                           &
            2818                                  ntrac,ntcw,ntiw,ntrw,ntsw,ntgl,                            &
            2819                                  IX, NLAY, NLP1,                                            &
            2820                                  uni_cld, lmfshal, lmfdeep2, cldcov,                        &
            2821                                  re_cloud,re_ice,re_snow,                                   &
            2822                     !             lwp_ex, iwp_ex, lwp_fc, iwp_fc, dzlay,                    &
            2823                     !             gridkm,                                                    &
            2824                     !             cldtot, cldcnv,                                            &
            2825                     !   --- outputs:
            2826                     !            cld_frac, cld_lwp, cld_reliq, cld_iwp,                     &
            2827                     !            cld_reice,cld_rwp, cld_rerain,cld_swp, cld_resnow          &
            2828                                  clouds,clds,mtop,mbot                                      &
            2829                                )
            2830                     ! =================   subprogram documentation block   ================ !
            2831                     !                                                                       !
            2832                     ! subprogram:    progcld_thompson    computes cloud related quantities  !
            2833                     !   using Thompson cloud microphysics scheme.                           !
            2834                     !                                                                       !
            2835                     ! abstract:  this program computes cloud fractions from cloud           !
            2836                     !   condensates,                                                        !
            2837                     !   and computes the low, mid, high, total and boundary layer cloud     !
            2838                     !   fractions and the vertical indices of low, mid, and high cloud      !
            2839                     !   top and base.  the three vertical cloud domains are set up in the   !
            2840                     !   initial subroutine "cld_init".                                      !
            2841                     !                                                                       !
            2842                     ! usage:         call progcld_thompson                                  !
            2843                     !                                                                       !
            2844                     ! subprograms called:   gethml                                          !
            2845                     !                                                                       !
            2846                     ! attributes:                                                           !
            2847                     !   language:   fortran 90                                              !
            2848                     !   machine:    ibm-sp, sgi                                             !
            2849                     !                                                                       !
            2850                     !                                                                       !
            2851                     !  ====================  definition of variables  ====================  !
            2852                     !                                                                       !
            2853                     !                                                                       !
            2854                     ! input variables:                                                      !
            2855                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            2856                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            2857                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            2858                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            2859                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            2860                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            2861                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            2862                     !   clw   (IX,NLAY,ntrac) : layer cloud condensate amount               !
            2863                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            2864                     !                     range, otherwise see in-line comment              !
            2865                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            2866                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            2867                     !   dz    (ix,nlay) : layer thickness (km)                              !
            2868                     !   delp  (ix,nlay) : model layer pressure thickness in mb (100Pa)      !
            2869                     !   gridkm (IX)     : grid length in km                                 !
            2870                     !   IX              : horizontal dimention                              !
            2871                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            2872                     !   uni_cld         : logical - true for cloud fraction from shoc       !
            2873                     !   lmfshal         : logical - true for mass flux shallow convection   !
            2874                     !   lmfdeep2        : logical - true for mass flux deep convection      !
            2875                     !   cldcov          : layer cloud fraction (used when uni_cld=.true.    !
            2876                     !                                                                       !
            2877                     ! output variables:                                                     !
            2878                     !   cloud profiles:                                                     !
            2879                     !      cld_frac  (:,:) - layer total cloud fraction                     !
            2880                     !      cld_lwp   (:,:) - layer cloud liq water path       (g/m**2)      !
            2881                     !      cld_reliq (:,:) - mean eff radius for liq cloud    (micron)      !
            2882                     !      cld_iwp   (:,:) - layer cloud ice water path       (g/m**2)      !
            2883                     !      cld_reice (:,:) - mean eff radius for ice cloud    (micron)      !
            2884                     !      cld_rwp   (:,:) - layer rain drop water path       not assigned  !
            2885                     !      cld_rerain(:,:) - mean eff radius for rain drop    (micron)      !
            2886                     !  *** cld_swp   (:,:) - layer snow flake water path      not assigned  !
            2887                     !      cld_resnow(:,:) - mean eff radius for snow flake   (micron)      !
            2888                     !                                                                       !
            2889                     ! module variables:                                                     !
            2890                     !   ivflip          : control flag of vertical index direction          !
            2891                     !                     =0: index from toa to surface                     !
            2892                     !                     =1: index from surface to toa                     !
            2893                     !   lmfshal         : mass-flux shallow conv scheme flag                !
            2894                     !   lmfdeep2        : scale-aware mass-flux deep conv scheme flag       !
            2895                     !   lcrick          : control flag for eliminating CRICK                !
            2896                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2897                     !                     =f: do not apply layer smoothing                  !
            2898                     !   lcnorm          : control flag for in-cld condensate                !
            2899                     !                     =t: normalize cloud condensate                    !
            2900                     !                     =f: not normalize cloud condensate                !
            2901                     !                                                                       !
            2902                     !  ====================    end of description    =====================  !
            2903                     !
            2904                           use module_mp_thompson_new, only : cfflag_thom
            2905                     
            2906                           implicit none
            2907                     !  ---  inputs
            2908                           integer,  intent(in) :: IX, NLAY, NLP1
            2909                           integer,  intent(in) :: ntrac, ntcw, ntiw, ntrw, ntsw, ntgl
            2910                           logical, intent(in)  :: uni_cld, lmfshal, lmfdeep2
            2911                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            2912                          &       tlyr, qlyr, qstl, rhly, cldcov, re_cloud, re_ice, re_snow
            2913                     !      real (kind=kind_phys), dimension(:,:), intent(in) :: delp, dz
            2914                     !      real (kind=kind_phys), dimension(:,:), intent(in) :: dzlay
            2915                     !      real (kind=kind_phys), dimension(:), intent(inout) ::             &
            2916                     !     &       lwp_ex, iwp_ex, lwp_fc, iwp_fc
            2917                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: clw
            2918                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2919                          &       slmsk
            2920                     !      real(kind=kind_phys), dimension(:), intent(in) :: gridkm
            2921                     !  --- inputs/outputs
            2922                     !      real (kind=kind_phys), dimension(:,:), intent(inout) ::            &
            2923                     !     &   cld_frac, cld_lwp, cld_reliq, cld_iwp, cld_reice,               &
            2924                     !     &   cld_rwp, cld_rerain, cld_swp, cld_resnow
            2925                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2926                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2927                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2928                     !  ---  local variables:
            2929                           real (kind=kind_phys), dimension(IX,NLAY) :: cldtot, cldcnv,      &
            2930                          &       cwp, cip, crp, csp, rew, rei, res, rer, qsum
            2931                           real (kind=kind_phys), dimension(IX,NLAY) :: dz, delp
            2932                           real (kind=kind_phys), dimension(NLAY) :: cldfra1d, qv1d,         &
            2933                          &                                 qc1d, qi1d, qs1d, dz1d, p1d, t1d,&
            2934                          &                                 rh1d, qst1d
            2935                           real(kind=kind_phys) :: gridkm
            2936                           real (kind=kind_phys), dimension(IX,NK_CLDS+1) :: ptop1
            2937                           real (kind=kind_phys) :: clwmin, tem1, tem2
            2938                           real (kind=kind_phys) :: corr, xland, snow_mass_factor
            2939                           real (kind=kind_phys), parameter :: max_relh = 1.5
            2940                           real (kind=kind_phys), parameter :: snow_max_radius = 130.0
            2941                           integer :: i, k, k2, id, nf, idx_rei
            2942                     !
            2943                     !===> ... begin here
            2944                     !
            2945                           clwmin = 1.0E-9
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2946     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cldcnv, cwp, cip, crp, csp, rew
                                   <<<      rei, rer, res, qsum
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2947     2   p                   do i = 1, IX
            2948     2   p                     cldtot(i,k) = 0.0
            2949     2   p                     cldcnv(i,k) = 0.0
            2950     2   p                     cwp   (i,k) = 0.0
            2951     2   p                     cip   (i,k) = 0.0
            2952     2   p                     crp   (i,k) = 0.0
            2953     2   p                     csp   (i,k) = 0.0
            2954     2   p                     rew   (i,k) = re_cloud(i,k)
            2955     2   p                     rei   (i,k) = re_ice(i,k)
            2956     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            2957     2   p                     res   (i,k) = re_snow(i,K)
            2958     2   p                     qsum  (i,k) = clw(i,k,ntcw) + clw(i,k,ntiw) + clw(i,k,ntsw)
            2959     2   p                   enddo
            2960     1   p                 enddo
            2961                     !> - Compute cloud liquid/ice condensate path in \f$ g/m^2 \f$ .
            2962                     !> - Since using Thompson MP, assume 1 percent of snow is actually in
            2963                     !!   ice sizes.
            2964     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp
                                   <<< Loop-information  End >>>
            2965     2  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 16, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp
                                   <<< Loop-information  End >>>
            2966     3   p   2                   do i = 1, IX
            2967     3   p   2                     delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2968     3   p   2                   enddo
            2969     2   p                     enddo
            2970     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp
                                   <<< Loop-information  End >>>
            2971     2  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 16, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp
                                   <<< Loop-information  End >>>
            2972     3   p   2                   do i = 1, IX
            2973     3   p   2                     delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2974     3   p   2                   enddo
            2975     2   p                     enddo
            2976     1                     endif
            2977                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2978     1  pp                 do k = 1, NLAY-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, crp, cwp, cip, csp
                                   <<< Loop-information  End >>>
            2979     2   p                   do i = 1, IX
            2980     2   p                     cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            2981     2   p                     crp(i,k) = 0.0
            2982     2   p                     snow_mass_factor = 0.90
            2983     2   p                     cip(i,k) = max(0.0, (clw(i,k,ntiw)                            &
            2984     2                    &            +(1.0-snow_mass_factor)*clw(i,k,ntsw))*gfac*delp(i,k))
            2985     3   p                     if (re_snow(i,k) .gt. snow_max_radius)then
            2986     3   p                        snow_mass_factor = min(snow_mass_factor,                   &
            2987     3                    &                              (snow_max_radius/re_snow(i,k))      &
            2988     3                    &                             *(snow_max_radius/re_snow(i,k)))
            2989     3   p                        res(i,k) = snow_max_radius
            2990     3   p                     endif
            2991     2   p                     csp(i,k) = max(0.,snow_mass_factor*clw(i,k,ntsw)*gfac*delp(i,k))
            2992     2   p                   enddo
            2993     1   p                 enddo
            2994                     
            2995                     !> - Sum the liquid water and ice paths that come from explicit micro
            2996                     !      do i = 1, IX
            2997                     !         lwp_ex(i) = 0.0
            2998                     !         iwp_ex(i) = 0.0
            2999                     !         do k = 1, NLAY-1
            3000                     !            lwp_ex(i) = lwp_ex(i) + cwp(i,k)
            3001                     !            iwp_ex(i) = iwp_ex(i) + cip(i,k) + csp(i,k)
            3002                     !         enddo
            3003                     !      enddo
            3004                     
            3005                     !> - Now determine the cloud fraction.  Here, we will use the scheme of
            3006                     !!   G. Thompson that implements a variannt of Mocko and Cotton (1995)
            3007                     !!   based on work within HWRF and WRF.  Where the bulk microphysics
            3008                     !!   scheme already has explicit clouds, assume cloud fraction of one,
            3009                     !!   but, otherwise, use a Sundqvist et al (1989) scheme and RH-critical
            3010                     !!   to account for sub-grid-scale clouds, include those in the water
            3011                     !!   and ice paths _seen_ by the radiation scheme, but do not actually
            3012                     !!   include these fake clouds into anything other than radiation.
            3013     1                     if ( cfflag_thom .eq. 1 ) then
            3014     1                       call cloud_fraction_XuRandall                                   &
            3015     1                              ( IX, NLAY, plyr, qsum, rhly, qstl,                      &
            3016     1                                lmfshal, lmfdeep2, cldtot )
            3017     1                     elseif ( cfflag_thom .eq. 2 ) then
            3018     1               !        do i = 1, IX
            3019     1               !          if (slmsk(i)-0.5 .gt. 0.5 .and. slmsk(i)+0.5 .lt. 1.5) then
            3020     1               !             xland = 1.0
            3021     1               !          else
            3022     1               !             xland = 2.0
            3023     1               !          endif
            3024     1               !          if (ivflip .eq. 1) then
            3025     1               !            do k = 1, NLAY
            3026     1               !               qv1d(k) = qlyr(i,k)
            3027     1               !               qc1d(k) = max(0.0, clw(i,k,ntcw))
            3028     1               !               qi1d(k) = max(0.0, clw(i,k,ntiw))
            3029     1               !               qs1d(k) = max(0.0, clw(i,k,ntsw))
            3030     1               !               rh1d(k) = rhly(i,k)
            3031     1               !               qst1d(k)= qstl(i,k)
            3032     1               !               p1d(k) = plyr(i,k)*100.0
            3033     1               !               t1d(k) = tlyr(i,k)
            3034     1               !            enddo
            3035     1               !          else
            3036     1               !            do k = NLAY, 1, -1
            3037     1               !               k2 = NLAY - k + 1
            3038     1               !               qv1d(k2) = qlyr(i,k)
            3039     1               !               qc1d(k2) = max(0.0, clw(i,k,ntcw))
            3040     1               !               qi1d(k2) = max(0.0, clw(i,k,ntiw))
            3041     1               !               qs1d(k2) = max(0.0, clw(i,k,ntsw))
            3042     1               !               rh1d(k2) = rhly(i,k)
            3043     1               !               qst1d(k2)= qstl(i,k)
            3044     1               !               p1d(k2) = plyr(i,k)*100.0
            3045     1               !               t1d(k2) = tlyr(i,k)
            3046     1               !            enddo
            3047     1               !          endif
            3048     1               !          call cal_cldfra3(cldfra1d, qv1d, qc1d, qi1d, qs1d, dz1d,      &
            3049     1               !     &                     p1d, t1d, xland, gridkm(i),                  &
            3050     1               !     &                     .false., max_relh, 1, nlay, .false.)
            3051     1               !          do k = 1, NLAY
            3052     1               !            cldtot(i,k) = cldfra1d(k)
            3053     1               !            if (qc1d(k).gt.clwmin .and. cldfra1d(k).lt.ovcst) then
            3054     1               !               cwp(i,k) = qc1d(k) * gfac * delp(i,k)
            3055     1               !               if ((xland-1.5).GT.0.) then
            3056     1               !                  rew(i,k) = 9.5   ! over ocean
            3057     1               !               else
            3058     1               !                  rew(i,k) = 5.5   ! over land
            3059     1               !               endif
            3060     1               !            endif
            3061     1               !            if (qi1d(k).gt.clwmin .and. cldfra1d(k).lt.ovcst) then
            3062     1               !               cip(i,k) = qi1d(k) * gfac * delp(i,k)
            3063     1               !               idx_rei = int(t1d(k)-179.)
            3064     1               !               idx_rei = min(max(idx_rei,1),75)
            3065     1               !               corr = t1d(k) - int(t1d(k))
            3066     1               !               rei(i,K) = max(5.0, retab(idx_rei)*(1.-corr) +           &
            3067     1               !     &                                 retab(idx_rei+1)*corr)
            3068     1               !            endif
            3069     1               !          enddo
            3070     1               !        enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            3071     2   p   4               do i = 1, IX
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            3072     3  pp   4                 do k = 1, NLAY
            3073     3   p   4                   cldtot(i,k) = cldcov(i,k)
            3074     3   p   4                 enddo
            3075     2   p   4               enddo
            3076     1                     endif
            3077                     
            3078                     !  ---  find top pressure for each cloud domain for given latitude
            3079                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            3080                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            3081                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3082     1  pp                 do id = 1, 4
            3083     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            3084     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3085     2   p   2               do i =1, IX
            3086     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            3087     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            3088     2               
            3089     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            3090     2   p   2               enddo
            3091     1   p                 enddo
            3092                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cwp, rew, cip, rei, crp, rer
                                   <<<      csp, res
                                   <<< Loop-information  End >>>
            3093     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.76, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp
                                   <<<      cldtot, res
                                   <<< Loop-information  End >>>
            3094     2   p                   do i = 1, IX
            3095     2               !          cld_frac(i,k)   = cldtot(i,k)
            3096     2               !          cld_lwp(i,k)    = cwp(i,k)
            3097     2               !          cld_reliq(i,k)  = rew(i,k)
            3098     2               !          cld_iwp(i,k)    = cip(i,k)
            3099     2               !          cld_reice(i,k)  = rei(i,k)
            3100     2               !          cld_rwp(i,k)    = crp(i,k)  ! added for Thompson
            3101     2               !          cld_rerain(i,k) = rer(i,k)
            3102     2               !          cld_swp(i,k)    = csp(i,k)  ! added for Thompson
            3103     2               !          cld_resnow(i,k) = res(i,k)
            3104     2   p                     clouds(i,k,1) = cldtot(i,k)
            3105     2   p                     clouds(i,k,2) = cwp(i,k)
            3106     2   p                     clouds(i,k,3) = rew(i,k)
            3107     2   p                     clouds(i,k,4) = cip(i,k)
            3108     2   p                     clouds(i,k,5) = rei(i,k)
            3109     2   p                     clouds(i,k,6) = crp(i,k)
            3110     2   p                     clouds(i,k,7) = rer(i,k)
            3111     2   p                     clouds(i,k,8) = csp(i,k)
            3112     2   p                     clouds(i,k,9) = res(i,k)
            3113     2   p                   enddo
            3114     1   p                 enddo
            3115                     
            3116                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            3117                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            3118                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            3119                     !       overlapping method is defined by control flag 'iovr', which may
            3120                     !       be different for lw and sw radiation programs.
            3121                     
            3122                           call gethml                                                       &
            3123                     !  ---  inputs:
            3124                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            3125                          &       IX,NLAY,                                                   &
            3126                     !  ---  outputs:
            3127                          &       clds, mtop, mbot                                           &
            3128                          &     )
            3129                     
            3130                     !> - Sum the liquid water and ice paths that come from fractional clouds
            3131                     !      do i = 1, IX
            3132                     !         lwp_fc(i) = 0.0
            3133                     !         iwp_fc(i) = 0.0
            3134                     !         do k = 1, NLAY
            3135                     !            lwp_fc(i) = lwp_fc(i) + cwp(i,k)
            3136                     !            iwp_fc(i) = iwp_fc(i) + cip(i,k) + csp(i,k)
            3137                     !         enddo
            3138                     !         lwp_fc(i) = MAX(0.0, lwp_fc(i) - lwp_ex(i))
            3139                     !         iwp_fc(i) = MAX(0.0, iwp_fc(i) - iwp_ex(i))
            3140                     !         lwp_fc(i) = lwp_fc(i)*1.E-3
            3141                     !         iwp_fc(i) = iwp_fc(i)*1.E-3
            3142                     !         lwp_ex(i) = lwp_ex(i)*1.E-3
            3143                     !         iwp_ex(i) = iwp_ex(i)*1.E-3
            3144                     !      enddo
            3145                     !
            3146                           return
            3147                     !............................................
            3148                           end subroutine progcld_thompson
            3149                     !............................................
            3150                     
            3151                     !-----------------------------------
            3152                           subroutine progcld_gce                                            &
            3153                     !...................................
            3154                     !
            3155                     !  ---  inputs:
            3156                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
            3157                          &       xlat,xlon,slmsk,ntrac,                                     &
            3158                          &       effr_cw,effr_iw,effr_sw,effr_rw,effr_in,                   &
            3159                          &       IX, NLAY, NLP1, lmfshal, lmfdeep2,                         &
            3160                     !  ---  outputs:
            3161                          &       clouds,clds,mtop,mbot,cldcov                               &
            3162                          &      )
            3163                     
            3164                     ! =================   subprogram documentation block   ================ !
            3165                     !                                                                       !
            3166                     ! subprogram:    progcld_gce   computes cloud related quantities using  !
            3167                     !   Goddard (GCE) 4ICE MP prognostic cloud microphysics scheme. Moist   !
            3168                     !   species from MP are fed into the corresponding arrays for           !
            3169                     !   calcuation of     !
            3170                     !                                                                       !
            3171                     ! abstract:  this program computes cloud fractions from cloud           !
            3172                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            3173                     !   and computes the low, mid, high, total and boundary layer cloud     !
            3174                     !   fractions and the vertical indices of low, mid, and high cloud      !
            3175                     !   top and base.  the three vertical cloud domains are set up in the   !
            3176                     !   initial subroutine "cld_init".                                      !
            3177                     !                                                                       !
            3178                     ! usage:         call progcld_gce                                       !
            3179                     !                                                                       !
            3180                     ! subprograms called:   gethml                                          !
            3181                     !                                                                       !
            3182                     ! attributes:                                                           !
            3183                     !   language:   fortran 90                                              !
            3184                     !   machine:    ibm-sp, sgi                                             !
            3185                     !                                                                       !
            3186                     !                                                                       !
            3187                     !  ====================  definition of variables  ====================  !
            3188                     !                                                                       !
            3189                     ! input variables:                                                      !
            3190                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            3191                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            3192                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            3193                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            3194                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            3195                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            3196                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            3197                     !   clw   (IX,NLAY,NTRAC) : layer cloud condensate amount               !
            3198                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            3199                     !                     range, otherwise see in-line comment              !
            3200                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            3201                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            3202                     !   ntrac           : number of tracers
            3203                     !   ntcw            : index for liquid water
            3204                     !   ntiw            : index for ice water
            3205                     !   ntrw            : index for rain water
            3206                     !   ntsw            : index for snow water
            3207                     !   ntgl            : index for graupel
            3208                     !   nthl            : index for hail
            3209                     !   cldcov(IX,NLAY) : total cloud fraction
            3210                     !   effr_cw(IX,NLAY): effective radius of liquid water (mm)             !
            3211                     !   effr_iw(IX,NLAY): effective radius of ice water (mm)                !
            3212                     !   effr_rw(IX,NLAY): effective radius of rain water (mm)               !
            3213                     !   effr_sw(IX,NLAY): effective radius of snow water (mm)               !
            3214                     !   IX              : horizontal dimention                              !
            3215                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            3216                     !                                                                       !
            3217                     ! output variables:                                                     !
            3218                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            3219                     !      clouds(:,:,1) - layer total cloud fraction                       !
            3220                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            3221                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            3222                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            3223                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            3224                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            3225                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            3226                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            3227                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            3228                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            3229                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            3230                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            3231                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            3232                     !                                                                       !
            3233                     ! module variables:                                                     !
            3234                     !   ivflip          : control flag of vertical index direction          !
            3235                     !                     =0: index from toa to surface                     !
            3236                     !                     =1: index from surface to toa                     !
            3237                     !   lsashal         : control flag for shallow convection               !
            3238                     !   lcrick          : control flag for eliminating CRICK                !
            3239                     !                     =t: apply layer smoothing to eliminate CRICK      !
            3240                     !                     =f: do not apply layer smoothing                  !
            3241                     !   lcnorm          : control flag for in-cld condensate                !
            3242                     !                     =t: normalize cloud condensate                    !
            3243                     !                     =f: not normalize cloud condensate                !
            3244                     !                                                                       !
            3245                     !  ====================    end of description    =====================  !
            3246                     !
            3247                           use radn, only : ntcw, ntiw, ntrw, ntsw, ntgl, nthl
            3248                           implicit none
            3249                     
            3250                     !  ---  inputs
            3251                           integer,  intent(in) :: IX, NLAY, NLP1
            3252                           integer,  intent(in) :: ntrac
            3253                     
            3254                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            3255                          &       tlyr, tvly, qlyr, qstl, rhly
            3256                     
            3257                     
            3258                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: clw
            3259                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            3260                          &       slmsk
            3261                     
            3262                           real (kind=kind_phys), dimension(:,:), intent(in) :: effr_cw,     &
            3263                          &       effr_iw, effr_rw, effr_sw
            3264                     
            3265                           logical, intent(in) :: effr_in, lmfshal, lmfdeep2
            3266                     
            3267                     !  ---  outputs
            3268                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            3269                     
            3270                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            3271                           real (kind=kind_phys), dimension(:,:),   intent(out) :: cldcov
            3272                     
            3273                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            3274                     
            3275                     !  ---  local variables:
            3276                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv,              &
            3277                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, qsum
            3278                     
            3279                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            3280                     
            3281                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            3282                          &       tem1, tem2, tem3
            3283                     
            3284                           integer :: i, k, id, nf
            3285                     
            3286                     !
            3287                     !===> ... begin here
            3288                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3289     1  pp                 do nf=1,nf_clds
            3290     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            3291     3   p   4                 do i=1,ix
            3292     3   p   4                   clouds(i,k,nf) = 0.0
            3293     3   p   4                 enddo
            3294     2   p                   enddo
            3295     1   p                 enddo
            3296                     !     clouds(:,:,:) = 0.0
            3297                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            3298     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, crp, csp, rew, rei
                                   <<<      rer, res, tem2d, qsum
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 13
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3299     2   p                   do i = 1, IX
            3300     2   p                     cldcnv(i,k) = 0.0
            3301     2   p                     cwp   (i,k) = 0.0
            3302     2   p                     cip   (i,k) = 0.0
            3303     2   p                     crp   (i,k) = 0.0
            3304     2   p                     csp   (i,k) = 0.0
            3305     3   p                     if ( effr_in ) then
            3306     3   p                       rew (i,k) = effr_cw (i,k)
            3307     3   p                       rei (i,k) = effr_iw (i,k)
            3308     3   p                       rer (i,k) = effr_rw (i,k)
            3309     3   p                       res (i,k) = effr_sw (i,k)
            3310     3   p                     else
            3311     3   p                       rew (i,k) = reliq_def            ! default liq radius to 10 micron
            3312     3   p                       rei (i,k) = reice_def            ! default ice radius to 50 micron
            3313     3   p                       rer (i,k) = rrain_def            ! default rain radius to 1000 micron
            3314     3   p                       res (i,k) = rsnow_def            ! default snow radius to 250 micron
            3315     3   p                     endif
            3316     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
            3317     2   p                     cldcov(i,k) = 0.0
            3318     2   p                     qsum  (i,k) = clw(i,k,ntcw)+clw(i,k,ntiw)+clw(i,k,ntrw)+      &
            3319     2                                       clw(i,k,ntsw)+clw(i,k,ntgl)+clw(i,k,nthl)
            3320     2   p                   enddo
            3321     1   p                 enddo
            3322                     
            3323                     !  ---  find top pressure for each cloud domain for given latitude
            3324                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            3325                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            3326                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3327     1  pp                 do id = 1, 4
            3328     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            3329     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3330     2   p   2               do i =1, IX
            3331     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            3332     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            3333     2               
            3334     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            3335     2   p   2               enddo
            3336     1   p                 enddo
            3337                     
            3338                     !  ---  compute liquid/ice condensate path in g/m**2
            3339                     
            3340     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, crp, csp, cip
                                   <<< Loop-information  End >>>
            3341     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 7, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            3342     3   p                     do i = 1, IX
            3343     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
            3344     3   p                       cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            3345     3   p                       cip(i,k) = max(0.0, clw(i,k,ntiw) * gfac * delp(i,k))
            3346     3   p                       crp(i,k) = max(0.0, clw(i,k,ntrw) * gfac * delp(i,k))
            3347     3   p                       csp(i,k) = max(0.0, ( clw(i,k,ntsw)+clw(i,k,ntgl)+          &
            3348     3                    &                 clw(i,k,nthl) ) * gfac * delp(i,k))
            3349     3   p                     enddo
            3350     2   p                   enddo
            3351     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, crp, csp, cip
                                   <<< Loop-information  End >>>
            3352     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 7, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            3353     3   p                     do i = 1, IX
            3354     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
            3355     3   p                       cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            3356     3   p                       cip(i,k) = max(0.0, clw(i,k,ntiw) * gfac * delp(i,k))
            3357     3   p                       crp(i,k) = max(0.0, clw(i,k,ntrw) * gfac * delp(i,k))
            3358     3   p                       csp(i,k) = max(0.0, ( clw(i,k,ntsw)+clw(i,k,ntgl)+          &
            3359     3                    &                 clw(i,k,nthl) ) * gfac * delp(i,k))
            3360     3   p                     enddo
            3361     2   p                   enddo
            3362     1                     endif                            ! end_if_ivflip
            3363                     
            3364                     !  --- calculate cloud fraction :
            3365                           call cloud_fraction_XuRandall                                     &
            3366                                    ( IX, NLAY, plyr, qsum, rhly, qstl,                      &
            3367                                      lmfshal, lmfdeep2, cldcov )
            3368                     
            3369                     !  ---  find top pressure for each cloud domain for given latitude
            3370                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            3371                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            3372                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3373     1  pp                 do id = 1, 4
            3374     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            3375     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3376     2   p   2               do i =1, IX
            3377     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            3378     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            3379     2               
            3380     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            3381     2   p   2               enddo
            3382     1   p                 enddo
            3383                     
            3384                     !  ---  effective liquid cloud droplet radius over land
            3385                     
            3386     1                     if ( .not. effr_in ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            3387     2  pp                 do i = 1, IX
            3388     3   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            3389     4   p   4                 do k = 1, NLAY
            3390     4   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            3391     4   p   4                 enddo
            3392     3   p                   endif
            3393     2   p                 enddo
            3394     1                     endif
            3395                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3396     1  pp                 do k = 1, NLAY
            3397     2   p   2               do i = 1, IX
            3398     3   p   2                 if (cldcov(i,k) < climit) then
            3399     3   p   2                   cldcov(i,k) = 0.0
            3400     3   p   2                   cwp(i,k)    = 0.0
            3401     3   p   2                   cip(i,k)    = 0.0
            3402     3   p   2                   crp(i,k)    = 0.0
            3403     3   p   2                   csp(i,k)    = 0.0
            3404     3   p   2                 endif
            3405     2   p   2               enddo
            3406     1   p                 enddo
            3407                     
            3408     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3409     2  pp                   do k = 1, NLAY
            3410     3   p                     do i = 1, IX
            3411     4   p                       if (cldcov(i,k) >= climit) then
            3412     4   p                         tem1 = 1.0 / max(climit2, cldcov(i,k))
            3413     4   p                         cwp(i,k) = cwp(i,k) * tem1
            3414     4   p                         cip(i,k) = cip(i,k) * tem1
            3415     4   p                         crp(i,k) = crp(i,k) * tem1
            3416     4   p                         csp(i,k) = csp(i,k) * tem1
            3417     4   p                       endif
            3418     3   p                     enddo
            3419     2   p                   enddo
            3420     1                     endif
            3421                     
            3422                     !  ---  effective ice cloud droplet radius
            3423                     
            3424     1                     if ( .not. effr_in ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3425     2  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip
                                   <<< Loop-information  End >>>
            3426     3   p                   do i = 1, IX
            3427     3   p                     tem2 = tlyr(i,k) - con_ttp
            3428     3               
            3429     4   p                     if (cip(i,k) > 0.0) then
            3430     4   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            3431     4               
            3432     5   p                       if (tem2 < -50.0) then
            3433     5   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            3434     5   p                       elseif (tem2 < -40.0) then
            3435     5   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            3436     5   p                       elseif (tem2 < -30.0) then
            3437     5   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            3438     5   p                       else
            3439     5   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            3440     5   p                       endif
            3441     4               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            3442     4               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            3443     4   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            3444     4               !           rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            3445     4   p                     endif
            3446     3   p                   enddo
            3447     2   p                 enddo
            3448     1                     endif
            3449                     
            3450                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp, res
                                   <<< Loop-information  End >>>
            3451     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, rei, crp, rer, csp, cwp, res, rew
                                   <<< Loop-information  End >>>
            3452     2   p                   do i = 1, IX
            3453     2   p                     clouds(i,k,1) = cldcov(i,k)
            3454     2   p                     clouds(i,k,2) = cwp(i,k)
            3455     2   p                     clouds(i,k,3) = rew(i,k)
            3456     2   p                     clouds(i,k,4) = cip(i,k)
            3457     2   p                     clouds(i,k,5) = rei(i,k)
            3458     2   p                     clouds(i,k,6) = crp(i,k)
            3459     2   p                     clouds(i,k,7) = rer(i,k)
            3460     2   p                     clouds(i,k,8) = csp(i,k)
            3461     2   p                     clouds(i,k,9) = res(i,k)
            3462     2   p                   enddo
            3463     1   p                 enddo
            3464                     
            3465                     
            3466                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            3467                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            3468                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            3469                     !       overlapping method is defined by control flag 'iovr', which may
            3470                     !       be different for lw and sw radiation programs.
            3471                     
            3472                           call gethml                                                       &
            3473                     !  ---  inputs:
            3474                          &     ( plyr, ptop1, cldcov, cldcnv,                               &
            3475                          &       IX,NLAY,                                                   &
            3476                     !  ---  outputs:
            3477                          &       clds, mtop, mbot                                           &
            3478                          &     )
            3479                     
            3480                     
            3481                     !
            3482                           return
            3483                     !...................................
            3484                           end subroutine progcld_gce
            3485                     !-----------------------------------
            3486                     
            3487                     !-----------------------------------
            3488                           subroutine progclduni                                             &
            3489                     !  ---  inputs:
            3490                          &     ( plyr,plvl,tlyr,tvly,ccnd,ncnd,                             &
            3491                          &       xlat,xlon,slmsk, IX, NLAY, NLP1, cldcov,                   &
            3492                          &       effrl,effri,effrs,effrr,effr_in,                           &
            3493                     !  ---  outputs:
            3494                          &       clouds,clds,mtop,mbot                                      &
            3495                          &      )
            3496                     
            3497                     ! =================   subprogram documentation block   ================ !
            3498                     !                                                                       !
            3499                     ! subprogram:    progclduni    computes cloud related quantities using    !
            3500                     !   for unified cloud microphysics scheme.                !
            3501                     !                                                                       !
            3502                     ! abstract:  this program computes cloud fractions from cloud           !
            3503                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            3504                     !   and computes the low, mid, high, total and boundary layer cloud     !
            3505                     !   fractions and the vertical indices of low, mid, and high cloud      !
            3506                     !   top and base.  the three vertical cloud domains are set up in the   !
            3507                     !   initial subroutine "cld_init".                                      !
            3508                     !                                                                       !
            3509                     ! usage:         call progclduni                                          !
            3510                     !                                                                       !
            3511                     ! subprograms called:   gethml                                          !
            3512                     !                                                                       !
            3513                     ! attributes:                                                           !
            3514                     !   language:   fortran 90                                              !
            3515                     !   machine:    ibm-sp, sgi                                             !
            3516                     !                                                                       !
            3517                     !                                                                       !
            3518                     !  ====================  definition of variables  ====================  !
            3519                     !                                                                       !
            3520                     ! input variables:                                                      !
            3521                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            3522                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            3523                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            3524                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            3525                     !   ccnd  (IX,NLAY,ncnd) : layer cloud condensate amount                     !
            3526                     !   ncnd            : number of layer cloud condensate types            !
            3527                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            3528                     !                     range, otherwise see in-line comment              !
            3529                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            3530                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            3531                     !   IX              : horizontal dimention                              !
            3532                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            3533                     !   cldcov          : unified cloud fracrion from moist physics         !
            3534                     !   effrl (ix,nlay) : effective radius for liquid water                 !
            3535                     !   effri (ix,nlay) : effective radius for ice water                    !
            3536                     !   effrr (ix,nlay) : effective radius for rain water                   !
            3537                     !   effrs (ix,nlay) : effective radius for snow water                   !
            3538                     !   effr_in         : logical - if .true. use input effective radii     !
            3539                     !                                                                       !
            3540                     ! output variables:                                                     !
            3541                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            3542                     !      clouds(:,:,1) - layer total cloud fraction                       !
            3543                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            3544                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            3545                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            3546                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            3547                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            3548                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            3549                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            3550                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            3551                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            3552                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            3553                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            3554                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            3555                     !                                                                       !
            3556                     ! module variables:                                                     !
            3557                     !   ivflip          : control flag of vertical index direction          !
            3558                     !                     =0: index from toa to surface                     !
            3559                     !                     =1: index from surface to toa                     !
            3560                     !   lmfshal         : mass-flux shallow conv scheme flag                !
            3561                     !   lmfdeep2        : scale-aware mass-flux deep conv scheme flag       !
            3562                     !   lcrick          : control flag for eliminating CRICK                !
            3563                     !                     =t: apply layer smoothing to eliminate CRICK      !
            3564                     !                     =f: do not apply layer smoothing                  !
            3565                     !   lcnorm          : control flag for in-cld condensate                !
            3566                     !                     =t: normalize cloud condensate                    !
            3567                     !                     =f: not normalize cloud condensate                !
            3568                     !                                                                       !
            3569                     !  ====================    end of description    =====================  !
            3570                     !
            3571                           implicit none
            3572                     
            3573                     !  ---  inputs
            3574                           integer,  intent(in) :: IX, NLAY, NLP1, ncnd
            3575                           logical,  intent(in) :: effr_in
            3576                     
            3577                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: ccnd
            3578                           real (kind=kind_phys), dimension(:,:),   intent(in) :: plvl, plyr,&
            3579                          &       tlyr, tvly, cldcov, effrl, effri, effrr, effrs
            3580                     
            3581                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            3582                          &       slmsk
            3583                     
            3584                     !  ---  outputs
            3585                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            3586                     
            3587                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            3588                     
            3589                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            3590                     
            3591                     !  ---  local variables:
            3592                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv, cwp, cip,    &
            3593                          &       crp, csp, rew, rei, res, rer, delp, tem2d, cldtot
            3594                           real (kind=kind_phys), dimension(IX,NLAY,ncnd) :: cndf
            3595                     
            3596                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            3597                     
            3598                           real (kind=kind_phys) :: tem1, tem2, tem3
            3599                     
            3600                           integer :: i, k, id, nf, n
            3601                     
            3602                     !
            3603                     !===> ... begin here
            3604                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3605     1  pp                 do nf=1,nf_clds
            3606     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            3607     3   p   4                 do i=1,ix
            3608     3   p   4                   clouds(i,k,nf) = 0.0
            3609     3   p   4                 enddo
            3610     2   p                   enddo
            3611     1   p                 enddo
            3612                     !     clouds(:,:,:) = 0.0
            3613                     
            3614     1                     if (effr_in) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3615     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cldcnv, cwp, cip, crp, csp, rew
                                   <<<      rei, rer, res, tem2d
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3616     3   p                     do i = 1, IX
            3617     3   p                       cldtot(i,k) = cldcov(i,k)
            3618     3   p                       cldcnv(i,k) = 0.0
            3619     3   p                       cwp   (i,k) = 0.0
            3620     3   p                       cip   (i,k) = 0.0
            3621     3   p                       crp   (i,k) = 0.0
            3622     3   p                       csp   (i,k) = 0.0
            3623     3   p                       rew   (i,k) = effrl (i,k)
            3624     3   p                       rei   (i,k) = effri (i,k)
            3625     3   p                       rer   (i,k) = effrr (i,k)
            3626     3   p                       res   (i,k) = effrs (i,k)
            3627     3   p                       tem2d (i,k) = min( 1.0, max( 0.0,(con_ttp-tlyr(i,k))*0.05))
            3628     3   p                     enddo
            3629     2   p                   enddo
            3630     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp, cwp, rew, rei, tem2d, rer, cip
                                   <<<      cldcnv, res
                                   <<< Loop-information  End >>>
            3631     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.45, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp, cwp, rew, rei, rer, res, tem2d
                                   <<<      cip, cldcnv
                                   <<< Loop-information  End >>>
            3632     3   p                     do i = 1, IX
            3633     3   p                       cldcnv(i,k) = 0.0
            3634     3   p                       cwp   (i,k) = 0.0
            3635     3   p                       cip   (i,k) = 0.0
            3636     3   p                       crp   (i,k) = 0.0
            3637     3   p                       csp   (i,k) = 0.0
            3638     3   p                       rew   (i,k) = reliq_def            ! default liq radius to 10 micron
            3639     3   p                       rei   (i,k) = reice_def            ! default ice radius to 50 micron
            3640     3   p                       rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            3641     3   p                       res   (i,k) = rsnow_def            ! default snow radius to 250 micron
            3642     3   p                       tem2d (i,k) = min(1.0, max(0.0, (con_ttp-tlyr(i,k))*0.05))
            3643     3   p                     enddo
            3644     2   p                   enddo
            3645     1                     endif
            3646                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3647     1  pp                 do n=1,ncnd
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            3648     2   p                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            3649     3   p   4                 do i = 1, IX
            3650     3   p   4                   cndf(i,k,n) = ccnd(i,k,n)
            3651     3   p   4                 enddo
            3652     2   p                   enddo
            3653     1   p                 enddo
            3654     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            3655     2  pp                   do n=1,ncnd
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            3656     3   p   2                 do i = 1, IX
            3657     3   p   2                   cndf(i,1,n)    = 0.75*ccnd(i,1,n)    + 0.25*ccnd(i,2,n)
            3658     3   p   2                   cndf(i,nlay,n) = 0.75*ccnd(i,nlay,n) + 0.25*ccnd(i,nlay-1,n)
            3659     3   p   2                 enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            3660     3   p                     do k = 2, NLAY-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            3661     4   p   2                   do i = 1, IX
            3662     4   p   2                     cndf(i,K,n) = 0.25 * (ccnd(i,k-1,n) + ccnd(i,k+1,n))      &
            3663     4                    &                    + 0.5  *  ccnd(i,k,n)
            3664     4   p   2                   enddo
            3665     3   p                     enddo
            3666     2   p                   enddo
            3667     1                     endif
            3668                     
            3669                     !> -# Find top pressure for each cloud domain for given latitude.
            3670                     !     ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            3671                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            3672                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3673     1  pp                 do id = 1, 4
            3674     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            3675     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            3676     2   p   2               do i =1, IX
            3677     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            3678     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            3679     2               
            3680     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            3681     2   p   2               enddo
            3682     1   p                 enddo
            3683                     
            3684                     !> -# Compute cloud liquid/ice condensate path in \f$ g/m^2 \f$ .
            3685                     
            3686     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
            3687     2                       if (ncnd == 2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            3688     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.81, ITR: 12, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            3689     4   p   2                   do i = 1, IX
            3690     4   p   2                     delp(i,k) = plvl(i,k+1) - plvl(i,k)
            3691     4   p   2                     tem1      = gfac * delp(i,k)
            3692     4   p   2                     cwp(i,k)  = cndf(i,k,1) * tem1
            3693     4   p   2                     cip(i,k)  = cndf(i,k,2) * tem1
            3694     4   p   2                   enddo
            3695     3   p                     enddo
            3696     2                       elseif (ncnd == 4 .or. ncnd == 5) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            3697     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.11, ITR: 8, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            3698     4   p                       do i = 1, IX
            3699     4   p                         delp(i,k) = plvl(i,k+1) - plvl(i,k)
            3700     4   p                         tem1      = gfac * delp(i,k)
            3701     4   p                         cwp(i,k)  = cndf(i,k,1) * tem1
            3702     4   p                         cip(i,k)  = cndf(i,k,2) * tem1
            3703     4   p                         crp(i,k)  = cndf(i,k,3) * tem1
            3704     4   p                         csp(i,k)  = cndf(i,k,4) * tem1
            3705     4   p                       enddo
            3706     3   p                     enddo
            3707     2                       endif
            3708     1                     else                             ! input data from sfc to toa
            3709     2                       if (ncnd == 2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            3710     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.81, ITR: 12, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            3711     4   p   2                   do i = 1, IX
            3712     4   p   2                     delp(i,k) = plvl(i,k) - plvl(i,k+1)
            3713     4   p   2                     tem1      = gfac * delp(i,k)
            3714     4   p   2                     cwp(i,k)  = cndf(i,k,1) * tem1
            3715     4   p   2                     cip(i,k)  = cndf(i,k,2) * tem1
            3716     4   p   2                   enddo
            3717     3   p                     enddo
            3718     2                       elseif (ncnd == 4 .or. ncnd == 5) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cip, cwp, crp, csp
                                   <<< Loop-information  End >>>
            3719     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.11, ITR: 8, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            3720     4   p                       do i = 1, IX
            3721     4   p                         delp(i,k) = plvl(i,k) - plvl(i,k+1)
            3722     4   p                         tem1      = gfac * delp(i,k)
            3723     4   p                         cwp(i,k)  = cndf(i,k,1) * tem1
            3724     4   p                         cip(i,k)  = cndf(i,k,2) * tem1
            3725     4   p                         crp(i,k)  = cndf(i,k,3) * tem1
            3726     4   p                         csp(i,k)  = cndf(i,k,4) * tem1
            3727     4   p                       enddo
            3728     3   p                     enddo
            3729     2                       endif
            3730     1               
            3731     1                     endif                            ! end_if_ivflip
            3732                     
            3733                     !> -# Compute effective liquid cloud droplet radius over land.
            3734                     
            3735     1                     if(.not. effr_in) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            3736     2  pp                   do i = 1, IX
            3737     3   p                     if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            3738     4   p   4                   do k = 1, NLAY
            3739     4   p   4                     rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            3740     4   p   4                   enddo
            3741     3   p                     endif
            3742     2   p                   enddo
            3743     1                     endif
            3744                     
                                   <<< Loop-information Start >>>

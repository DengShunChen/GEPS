            3746     2   p   2               do i = 1, IX
            3747     3   p   2                 if (cldtot(i,k) < climit) then
            3748     3   p   2                   cwp(i,k)    = 0.0
            3749     3   p   2                   cip(i,k)    = 0.0
            3750     3   p   2                   crp(i,k)    = 0.0

             241                     
             242                     !-----------------------------------
             243                           subroutine cld_init                                               &
             244                     !...................................
             245                     
             246                     !  ---  inputs:
             247                          &     ( si, nlay, me, myrank )
             248                     !  ---  outputs:
             249                     !          ( none )
             250                     
             251                     !  ===================================================================  !
             252                     !                                                                       !
             253                     ! abstract: cld_init is an initialization program for cloud-radiation   !
             254                     !   calculations. it sets up boundary layer cloud top.                  !
             255                     !                                                                       !
             256                     !                                                                       !
             257                     ! inputs:                                                               !
             258                     !   si (l+1)        : model vertical sigma layer interface              !
             259                     !   nlay            : vertical layer number                             !
             260                     !   me              : print control flag                                !
             261                     !                                                                       !
             262                     !  outputs: (none)                                                      !
             263                     !           to module variables                                         !
             264                     !                                                                       !
             265                     !  external module variables: (in physpara)                             !
             266                     !   icldflg         : cloud optical property scheme control flag        !
             267                     !                     =0: model use diagnostic cloud method             !
             268                     !                     =1: model use prognostic cloud method             !
             269                     !   icmphys         : cloud microphysics scheme control flag            !
             270                     !                     =1: zhao/carr/sundqvist microphysics cloud        !
             271                     !                     =2: ferrier microphysics cloud scheme             !
             272                     !		      =3: zhao/carr/sundqvist microphysics cloud +pdfcld!
             273                     !   iovrsw/iovrlw   : sw/lw control flag for cloud overlapping scheme   !
             274                     !                     =0: random overlapping clouds                     !
             275                     !                     =1: max/ran overlapping clouds                    !
             276                     !   ivflip          : control flag for direction of vertical index      !
             277                     !                     =0: index from toa to surface                     !
             278                     !                     =1: index from surface to toa                     !
             279                     !  usage:       call cld_init                                           !
             280                     !                                                                       !
             281                     !  subroutines called:    rhtable                                       !
             282                     !                                                                       !
             283                     !  ===================================================================  !
             284                     !
             285                           implicit none
             286                     
             287                     !  ---  inputs:
             288                           integer, intent(in) :: nlay, me, myrank
             289                     
             290                           real (kind=kind_phys), intent(in) :: si(:)
             291                     
             292                     !  ---  outputs: (none)
             293                     
             294                     !  ---  locals:
             295                           integer :: k, kl, ier
             296                     
             297                     !
             298                     !===> ...  begin here
             299                     !
             300                     !  ---  set up module variables
             301                     
             302                           iovr    = max( iovrsw, iovrlw )    !cld ovlp used for diag hml cld output
             303                     
             304                           if (me == 0 .and. myrank ==0) print *, vtagcld      !print out version tag
             305                     
             306     1                     if ( icldflg == 0 ) then
             307     1                       if (me == 0 .and. myrank ==0) print *,' - using diagnostic cloud method'
             308     1               
             309     1               !  ---  set up tuned rh table
             310     1               
             311     1                       call rhtable( me, ier )
             312     1               
             313     2                       if (ier < 0) then
             314     2                         write(6,99) ier
             315     2                 99      format(3x,' *** error in finding tuned rh table ***'          &
             316     2                    &,         /3x,'     stop at calling subroutine rhtable !!'/)
             317     2                         stop 99
             318     2                       endif
             319     1                     else
             320     2                       if (myrank ==0) then
             321     2                         print *,' - using prognostic cloud method'
             322     3                         if (icmphys == 1) then
             323     3                           print *,'   --- zhao/carr/sundqvist microphysics'
             324     3                         elseif (icmphys == 2) then
             325     3                           print *,'   --- ferrier cloud microphysics'
             326     3                         elseif (icmphys == 3) then
             327     3                           print *,'   --- zhao/carr/sundqvist + pdf cloud'
             328     3                         elseif (icmphys == 6) then
             329     3                           print *,'   --- WSM6 microphysics'
             330     3                         elseif (icmphys == 8) then
             331     3                           print *,'   --- Thompson microphysics'
             332     3                         elseif (icmphys == 18) then
             333     3                           print *,'   --- 2M Thompson microphysics'
             334     3                         elseif (icmphys == 11) then
             335     3                           print *,'   --- GFDL microphysics version 1'
             336     3                         elseif (icmphys == 12) then
             337     3                           print *,'   --- GFDL microphysics version 2'
             338     3                         elseif (icmphys == 13) then
             339     3                           print *,'   --- GFDL microphysics version 3'
             340     3                         elseif (icmphys == 15) then
             341     3                           print *,'   --- Goddard (GCE) 3ICE microphysics'
             342     3                         elseif (icmphys == 16) then
             343     3                           print *,'   --- Goddard (GCE) 4ICE microphysics'
             344     3                         else
             345     3                           print *,'  !!! error in cloud microphysc specification!!!', &
             346     3                    &              '  icmphys (np3d) =',icmphys
             347     3                           stop
             348     3                         endif
             349     2                       endif
             350     1                     endif
             351                     
             352                     !  ---  compute llyr - the top of bl cld and is topmost non cld(low) layer
             353                     !       for stratiform (at or above lowest 0.1 of the atmosphere)
             354                     
             355     1                     if ( ivflip == 0 ) then    ! data from toa to sfc
             356     2                       lab_do_k0 : do k = nlay, 2, -1
             357     2                         kl = k
             358     2                         if (si(k) < 0.9e0) exit lab_do_k0
             359     2                       enddo  lab_do_k0
             360     1               
             361     1                       llyr = kl
             362     1                     else                      ! data from sfc to top
             363     2                       lab_do_k1 : do k = 2, nlay
             364     2                         kl = k
             365     2                         if (si(k) < 0.9e0) exit lab_do_k1
             366     2                       enddo  lab_do_k1
             367     1               
             368     1                       llyr = kl - 1
             369     1                     endif                     ! end_if_ivflip
             370                     
             371                     !
             372                           return
             373                     !...................................
             374                           end subroutine cld_init
             375                     !-----------------------------------
             376                     
             377                     
             378                     !-----------------------------------
             379                           subroutine progcld1                                               &
             380                     !...................................
             381                     
             382                     !  ---  inputs:
             383                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
             384                          &       xlat,xlon,slmsk,                                           &
             385                          &       ix, nlay, nlp1, myrank,                                    &
             386                     !  ---  outputs:
             387                          &       clouds,clds,mtop,mbot                                      &
             388                          &      )
             389                     
             390                     ! =================   subprogram documentation block   ================ !
             391                     !                                                                       !
             392                     ! subprogram:    progcld1    computes cloud related quantities using    !
             393                     !   zhao/moorthi's prognostic cloud microphysics scheme.                !
             394                     !                                                                       !
             395                     ! abstract:  this program computes cloud fractions from cloud           !
             396                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
             397                     !   and computes the low, mid, high, total and boundary layer cloud     !
             398                     !   fractions and the vertical indices of low, mid, and high cloud      !
             399                     !   top and base.  the three vertical cloud domains are set up in the   !
             400                     !   initial subroutine "cld_init".                                      !
             401                     !                                                                       !
             402                     ! usage:         call progcld1                                          !
             403                     !                                                                       !
             404                     ! subprograms called:   gethml                                          !
             405                     !                                                                       !
             406                     ! attributes:                                                           !
             407                     !   language:   fortran 90                                              !
             408                     !   machine:    ibm-sp, sgi                                             !
             409                     !                                                                       !
             410                     !                                                                       !
             411                     !  ====================  defination of variables  ====================  !
             412                     !                                                                       !
             413                     ! input variables:                                                      !
             414                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
             415                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
             416                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
             417                     !   tvly  (ix,nlay) : model layer virtual temperature in k              !
             418                     !   qlyr  (ix,nlay) : layer specific humidity in gm/gm                  !
             419                     !   qstl  (ix,nlay) : layer saturate humidity in gm/gm                  !
             420                     !   rhly  (ix,nlay) : layer relative humidity (=qlyr/qstl)              !
             421                     !   clw   (ix,nlay) : layer cloud condensate amount                     !
             422                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
             423                     !                     range, otherwise see in-line comment              !
             424                     !   xlon  (ix)      : grid longitude in radians  (not used)             !
             425                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
             426                     !   ix              : horizontal dimention                              !
             427                     !   nlay,nlp1       : vertical layer/level dimensions                   !
             428                     !                                                                       !
             429                     ! output variables:                                                     !
             430                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
             431                     !      clouds(:,:,1) - layer total cloud fraction                       !
             432                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
             433                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
             434                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
             435                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
             436                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
             437                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
             438                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
             439                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
             440                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
             441                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
             442                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
             443                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
             444                     !                                                                       !
             445                     ! module variables:                                                     !
             446                     !   ivflip          : control flag of vertical index direction          !
             447                     !                     =0: index from toa to surface                     !
             448                     !                     =1: index from surface to toa                     !
             449                     !   lcrick          : control flag for eliminating crick                !
             450                     !                     =t: apply layer smoothing to eliminate crick      !
             451                     !                     =f: do not apply layer smoothing                  !
             452                     !   lcnorm          : control flag for in-cld condensate                !
             453                     !                     =t: normalize cloud condensate                    !
             454                     !                     =f: not normalize cloud condensate                !
             455                     !                                                                       !
             456                     !  ====================    end of description    =====================  !
             457                     !
             458                           implicit none
             459                     
             460                     !  ---  inputs
             461                           integer,  intent(in) :: ix, nlay, nlp1, myrank
             462                     
             463                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
             464                          &       tlyr, tvly, qlyr, qstl, rhly, clw
             465                     
             466                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
             467                          &       slmsk
             468                     
             469                     !  ---  outputs
             470                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
             471                     
             472                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
             473                     
             474                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
             475                     
             476                     !  ---  local variables:
             477                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
             478                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf
             479                     
             480                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
             481                     
             482                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
             483                          &       tem1, tem2, tem3
             484                     
             485                           integer :: i, k, id, nf
             486                     !
             487                     !===> ... begin here
             488                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             489     1  pp                 do nf=1,nf_clds
             490     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             491     3   p   4                 do i=1,ix
             492     3   p   4                   clouds(i,k,nf) = 0.0
             493     3   p   4                 enddo
             494     2   p                   enddo
             495     1   p                 enddo
             496                     !     clouds(:,:,:) = 0.0
             497                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, cip, res, crp, csp, rew, cldcnv
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             498     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.46, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, res, crp, csp, rew
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             499     2   p                   do i = 1, ix
             500     2   p                     cldtot(i,k) = 0.0
             501     2   p                     cldcnv(i,k) = 0.0
             502     2   p                     cwp   (i,k) = 0.0
             503     2   p                     cip   (i,k) = 0.0
             504     2   p                     crp   (i,k) = 0.0
             505     2   p                     csp   (i,k) = 0.0
             506     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
             507     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
             508     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
             509     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
             510     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
             511     2   p                     clwf(i,k)   = 0.0
             512     2   p                   enddo
             513     1   p                 enddo
             514                     !
             515     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             516     2  pp   2               do i = 1, ix
             517     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
             518     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
             519     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             520     2  pp                   do k = 2, nlay-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             521     3   p   2                 do i = 1, ix
             522     3   p   2                   clwf(i,k) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
             523     3   p   2                 enddo
             524     2   p                   enddo
             525     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             526     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             527     3   p   4                 do i = 1, ix
             528     3   p   4                   clwf(i,k) = clw(i,k)
             529     3   p   4                 enddo
             530     2   p                   enddo
             531     1                     endif
             532                     
             533                     !  ---  find top pressure for each cloud domain for given latitude
             534                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,l,m,h;
             535                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
             536                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             537     1  pp                 do id = 1, 4
             538     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
             539     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             540     2   p   2               do i =1, ix
             541     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
             542     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
             543     2               
             544     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
             545     2   p   2               enddo
             546     1   p                 enddo
             547                     
             548                     !  ---  compute liquid/ice condensate path in g/m**2
             549                     
             550     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cwp, cip
                                   <<< Loop-information  End >>>
             551     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 17, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, clwf, tem2d, cip, cwp
                                   <<< Loop-information  End >>>
             552     3   p                     do i = 1, ix
             553     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
             554     3   p                       clwt     = max(0.0, clwf(i,k)) * gfac * delp(i,k)
             555     3   p                       cip(i,k) = clwt * tem2d(i,k)
             556     3   p                       cwp(i,k) = clwt - cip(i,k)
             557     3   p                     enddo
             558     2   p                   enddo
             559     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cwp, cip
                                   <<< Loop-information  End >>>
             560     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 17, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, clwf, tem2d, cip, cwp
                                   <<< Loop-information  End >>>
             561     3   p                     do i = 1, ix
             562     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
             563     3   p                       clwt     = max(0.0, clwf(i,k)) * gfac * delp(i,k)
             564     3   p                       cip(i,k) = clwt * tem2d(i,k)
             565     3   p                       cwp(i,k) = clwt - cip(i,k)
             566     3   p                     enddo
             567     2   p                   enddo
             568     1                     endif                            ! end_if_ivflip
             569                     
             570                     !  ---  effective liquid cloud droplet radius over land
             571                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             572     1  pp                 do i = 1, ix
             573     2   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             574     3   p   4                 do k = 1, nlay
             575     3   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
             576     3   p   4                 enddo
             577     2   p                   endif
             578     1   p                 enddo
             579                     
             580                     !  ---  layer cloud fraction
             581                     
             582     1                     if ( ivflip == 0 ) then              ! input data from toa to sfc
             583     1               
             584     1                       clwmin = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             585     2  pp                   do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             586     3   p                   do i = 1, ix
             587     3   p                     clwt = 1.0e-6 * (plyr(i,k)*0.001)
             588     3               !         clwt = 2.0e-6 * (plyr(i,k)*0.001)
             589     3               
             590     4   p                     if (clwf(i,k) > clwt) then
             591     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
             592     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
             593     4               
             594     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
             595     4               !           tem1  = 2000.0 / tem1
             596     4               
             597     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)  !jhan
             598     4   p                       tem1  = 100.0 / tem1
             599     4               !
             600     4               !           tem1  = 2000.0 / tem1
             601     4               !           tem1  = 1000.0 / tem1
             602     4               !
             603     4               
             604     4   p                       value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
             605     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
             606     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
             607     4   p                     endif
             608     3   p                    enddo
             609     2   p                    enddo
             610     1               
             611     1                     else                                 ! input data from sfc to toa
             612     1               
             613     1                       clwmin = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             614     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             615     3   p                   do i = 1, ix
             616     3   p                     clwt = 1.0e-6 * (plyr(i,k)*0.001)
             617     3               !         clwt = 2.0e-6 * (plyr(i,k)*0.001)
             618     3               
             619     4   p                     if (clwf(i,k) > clwt) then
             620     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
             621     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
             622     4               
             623     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
             624     4               !           tem1  = 2000.0 / tem1
             625     4               
             626     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)  !jhan
             627     4   p                       tem1  = 100.0 / tem1
             628     4               !
             629     4               !           tem1  = 2000.0 / tem1
             630     4               !           tem1  = 1000.0 / tem1
             631     4               !
             632     4               
             633     4   p                       value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
             634     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
             635     4               
             636     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
             637     4   p                     endif
             638     3   p                   enddo
             639     2   p                   enddo
             640     1               
             641     1                     endif                                ! end_if_flip
             642                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             643     1  pp   2             do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             644     2   p   2               do i = 1, ix
             645     3   p   2                 if (cldtot(i,k) < climit) then
             646     3   p   2                   cldtot(i,k) = 0.0
             647     3   p   2                   cwp(i,k)    = 0.0
             648     3   p   2                   cip(i,k)    = 0.0
             649     3   p   2                   crp(i,k)    = 0.0
             650     3   p   2                   csp(i,k)    = 0.0
             651     3   p   2                 endif
             652     2   p   2               enddo
             653     1   p   2             enddo
             654                     
             655     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             656     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             657     3   p                     do i = 1, ix
             658     4   p                       if (cldtot(i,k) >= climit) then
             659     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
             660     4   p                         cwp(i,k) = cwp(i,k) * tem1
             661     4   p                         cip(i,k) = cip(i,k) * tem1
             662     4   p                         crp(i,k) = crp(i,k) * tem1
             663     4   p                         csp(i,k) = csp(i,k) * tem1
             664     4   p                       endif
             665     3   p                     enddo
             666     2   p                   enddo
             667     1                     endif
             668                     
             669                     !  ---  effective ice cloud droplet radius
             670                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 671,697)
                                   <<< Loop-information  End >>>
             671     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 672,698)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, cwp, rew, rei, rer, res
                                   <<< Loop-information  End >>>
             672     2   p                   do i = 1, ix
             673     2   p                     tem2 = tlyr(i,k) - con_ttp
             674     2               
             675     3   p                     if (cip(i,k) > 0.0) then
             676     3               !           tem3 = gord * cip(i,k) * (plyr(i,k)/delp(i,k)) / tvly(i,k)
             677     3   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
             678     3               
             679     4   p                       if (tem2 < -50.0) then
             680     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
             681     4   p                       elseif (tem2 < -40.0) then
             682     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
             683     4   p                       elseif (tem2 < -30.0) then
             684     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
             685     4   p                       else
             686     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
             687     4   p                       endif
             688     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
             689     3               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
             690     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
             691     3               !           rei(i,k)   = max(5.0, min(rei(i,k), 130.0))
             692     3   p                     endif
             693     2   p                   enddo
             694     1   p                 enddo
             695                     
             696                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             697     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             698     2                       do i = 1, ix
             699     2   p                     clouds(i,k,1) = cldtot(i,k)
             700     2   p                     clouds(i,k,2) = cwp(i,k)
             701     2   p                     clouds(i,k,3) = rew(i,k)
             702     2   p                     clouds(i,k,4) = cip(i,k)
             703     2   p                     clouds(i,k,5) = rei(i,k)
             704     2               !         clouds(i,k,6) = 0.0
             705     2   p                     clouds(i,k,7) = rer(i,k)
             706     2               !         clouds(i,k,8) = 0.0
             707     2               !          clouds(i,k,9) = rei(i,k)
             708     2   p                     clouds(i,k,9) = res(i,k)
             709     2                       enddo
             710     1                     enddo
             711                     
             712                     
             713                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
             714                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
             715                     !       the three cloud domain boundaries are defined by ptopc.  the cloud
             716                     !       overlapping method is defined by control flag 'iovr', which may
             717                     !       be different for lw and sw radiation programs.
             718                     
             719                           call gethml                                                       &
             720                     !  ---  inputs:
             721                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
             722                          &       ix,nlay,                                                   &
             723                     !  ---  outputs:
             724                          &       clds, mtop, mbot                                           &
             725                          &     )
             726                     
             727                     
             728                     !
             729                           return
             730                     !...................................
             731                           end subroutine progcld1
             732                     !-----------------------------------
             733                     
             734                     !-----------------------------------
             735                           subroutine progcld3                                               &
             736                     !...................................
             737                     
             738                     !  ---  inputs:
             739                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,cnvw,cnvc,          &
             740                          &       xlat,xlon,slmsk,                                           &
             741                          &       ix, nlay, nlp1,                                            &
             742                          &       deltaq,sup,kdt,me,                                         &
             743                     !  ---  outputs:
             744                          &       clouds,clds,mtop,mbot                                      &
             745                          &      )
             746                     
             747                     ! =================   subprogram documentation block   ================ !
             748                     !                                                                       !
             749                     ! subprogram:    progcld3    computes cloud related quantities using    !
             750                     !   zhao/moorthi's prognostic cloud microphysics scheme.                !
             751                     !                                                                       !
             752                     ! abstract:  this program computes cloud fractions from cloud           !
             753                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
             754                     !   and computes the low, mid, high, total and boundary layer cloud     !
             755                     !   fractions and the vertical indices of low, mid, and high cloud      !
             756                     !   top and base.  the three vertical cloud domains are set up in the   !
             757                     !   initial subroutine "cld_init".                                      !
             758                     !                                                                       !
             759                     ! usage:         call progcld3                                          !
             760                     !                                                                       !
             761                     ! subprograms called:   gethml                                          !
             762                     !                                                                       !
             763                     ! attributes:                                                           !
             764                     !   language:   fortran 90                                              !
             765                     !   machine:    ibm-sp, sgi                                             !
             766                     !                                                                       !
             767                     !                                                                       !
             768                     !  ====================  defination of variables  ====================  !
             769                     !                                                                       !
             770                     ! input variables:                                                      !
             771                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
             772                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
             773                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
             774                     !   tvly  (ix,nlay) : model layer virtual temperature in k              !
             775                     !   qlyr  (ix,nlay) : layer specific humidity in gm/gm                  !
             776                     !   qstl  (ix,nlay) : layer saturate humidity in gm/gm                  !
             777                     !   rhly  (ix,nlay) : layer relative humidity (=qlyr/qstl)              !
             778                     !   clw   (ix,nlay) : layer cloud condensate amount                     !
             779                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
             780                     !                     range, otherwise see in-line comment              !
             781                     !   xlon  (ix)      : grid longitude in radians  (not used)             !
             782                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
             783                     !   ix              : horizontal dimention                              !
             784                     !   nlay,nlp1       : vertical layer/level dimensions                   !
             785                     !   cnvw  (ix,nlay) : layer convective cloud condensate                 !
             786                     !   cnvc  (ix,nlay) : layer convective cloud cover                      !
             787                     !   deltaq(ix,nlay) : half total water distribution width               !
             788                     !   sup             : supersaturation                                   !
             789                     
             790                     !                                                                       !
             791                     ! output variables:                                                     !
             792                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
             793                     !      clouds(:,:,1) - layer total cloud fraction                       !
             794                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
             795                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
             796                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
             797                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
             798                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
             799                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
             800                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
             801                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
             802                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
             803                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
             804                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
             805                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
             806                     !                                                                       !
             807                     ! module variables:                                                     !
             808                     !   ivflip          : control flag of vertical index direction          !
             809                     !                     =0: index from toa to surface                     !
             810                     !                     =1: index from surface to toa                     !
             811                     !   lcrick          : control flag for eliminating crick                !
             812                     !                     =t: apply layer smoothing to eliminate crick      !
             813                     !                     =f: do not apply layer smoothing                  !
             814                     !   lcnorm          : control flag for in-cld condensate                !
             815                     !                     =t: normalize cloud condensate                    !
             816                     !                     =f: not normalize cloud condensate                !
             817                     !                                                                       !
             818                     !  ====================    end of description    =====================  !
             819                     !
             820                           implicit none
             821                     
             822                     !  ---  inputs
             823                           integer,  intent(in) :: ix, nlay, nlp1,kdt
             824                     
             825                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
             826                          &       tlyr, tvly, qlyr, qstl, rhly, clw
             827                     !     &       tlyr, tvly, qlyr, qstl, rhly, clw, cnvw, cnvc
             828                     !      real (kind=kind_phys), dimension(:,:), intent(in) :: deltaq
             829                           real (kind=kind_phys), dimension(:,:) :: deltaq, cnvw, cnvc
             830                           real (kind=kind_phys) qtmp,qsc,rhs
             831                           real (kind=kind_phys), intent(in) :: sup
             832                           real (kind=kind_phys), parameter :: epsq = 1.0e-12
             833                     
             834                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
             835                          &       slmsk
             836                           integer :: me
             837                     
             838                     !  ---  outputs
             839                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
             840                     
             841                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
             842                     
             843                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
             844                     
             845                     !  ---  local variables:
             846                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
             847                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf
             848                     
             849                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
             850                     
             851                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
             852                          &       tem1, tem2, tem3
             853                     
             854                           integer :: i, k, id, nf
             855                     
             856                     !
             857                     !===> ... begin here
             858                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             859     1  pp                 do nf=1,nf_clds
             860     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             861     3   p   4                 do i=1,ix
             862     3   p   4                   clouds(i,k,nf) = 0.0
             863     3   p   4                 enddo
             864     2   p                   enddo
             865     1   p                 enddo
             866                     !     clouds(:,:,:) = 0.0
             867                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, cip, res, crp, csp, rew, cldcnv
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             868     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.46, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, res, crp, csp, rew
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             869     2   p                   do i = 1, ix
             870     2   p                     cldtot(i,k) = 0.0
             871     2   p                     cldcnv(i,k) = 0.0
             872     2   p                     cwp   (i,k) = 0.0
             873     2   p                     cip   (i,k) = 0.0
             874     2   p                     crp   (i,k) = 0.0
             875     2   p                     csp   (i,k) = 0.0
             876     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
             877     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
             878     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
             879     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
             880     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
             881     2   p                     clwf(i,k)   = 0.0
             882     2   p                   enddo
             883     1   p                 enddo
             884                     !
             885     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             886     2  pp   2               do i = 1, ix
             887     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
             888     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
             889     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             890     2  pp                   do k = 2, nlay-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             891     3   p   2                 do i = 1, ix
             892     3   p   2                   clwf(i,k) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
             893     3   p   2                 enddo
             894     2   p                   enddo
             895     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             896     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             897     3   p   4                 do i = 1, ix
             898     3   p   4                   clwf(i,k) = clw(i,k)
             899     3   p   4                 enddo
             900     2   p                   enddo
             901     1                     endif
             902                     
             903     1                     if(kdt==1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
             904     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 32, MVE: 3, POL: S)
                                   <<< Loop-information  End >>>
             905     3   p   4                 do i = 1, ix
             906     3   p   4                   deltaq(i,k) = (1.-0.95)*qstl(i,k)
             907     3   p   4                 enddo
             908     2   p                   enddo
             909     1                     endif
             910                     
             911                     !  ---  find top pressure for each cloud domain for given latitude
             912                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,l,m,h;
             913                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
             914                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             915     1  pp                 do id = 1, 4
             916     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
             917     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             918     2   p   2               do i =1, ix
             919     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
             920     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
             921     2               
             922     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
             923     2   p   2               enddo
             924     1   p                 enddo
             925                     
             926                     !  ---  compute liquid/ice condensate path in g/m**2
             927                     
             928     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
             929     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
             930     3   p                     do i = 1, ix
             931     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
             932     3   p                       clwt  = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
             933     3   p                       cip(i,k) = clwt * tem2d(i,k)
             934     3   p                       cwp(i,k) = clwt - cip(i,k)
             935     3   p                     enddo
             936     2   p                   enddo
             937     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
             938     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
             939     3   p                     do i = 1, ix
             940     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
             941     3   p                       clwt = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
             942     3   p                       cip(i,k) = clwt * tem2d(i,k)
             943     3   p                       cwp(i,k) = clwt - cip(i,k)
             944     3   p                     enddo
             945     2   p                   enddo
             946     1                     endif                            ! end_if_ivflip
             947                     
             948                     !  ---  effective liquid cloud droplet radius over land
             949                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             950     1  pp                 do i = 1, ix
             951     2   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             952     3   p   4                 do k = 1, nlay
             953     3   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
             954     3   p   4                 enddo
             955     2   p                   endif
             956     1   p                 enddo
             957                     
             958                     !  ---  layer cloud fraction
             959                     
             960     1                     if ( ivflip == 0 ) then              ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             961     2  pp                     do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             962     3   p                     do i = 1, ix
             963     3   p                       tem1 = tlyr(i,k) - 273.16
             964     4   p                       if(tem1 < con_thgni) then  ! for pure ice, has to be consistent with gscond
             965     4   p                         qsc = sup * qstl(i,k)
             966     4   p                         rhs = sup
             967     4   p                       else
             968     4   p                         qsc = qstl(i,k)
             969     4   p                         rhs = 1.0
             970     4   p                       endif
             971     4   p                      if(rhly(i,k) >= rhs) then
             972     4   p                        cldtot(i,k) = 1.0
             973     4   p                      else
             974     4   p                        qtmp = qlyr(i,k) + clwf(i,k) - qsc
             975     5   p                        if(deltaq(i,k) > epsq) then
             976     6   p                          if(qtmp < -deltaq(i,k) .or. clwf(i,k) < epsq) then
             977     6               !               if(qtmp < -deltaq(i,k)) then
             978     6   p                            cldtot(i,k) = 0.0
             979     6   p                          elseif(qtmp >= deltaq(i,k)) then
             980     6   p                            cldtot(i,k) = 1.0
             981     6   p                          else
             982     6   p                            cldtot(i,k) = 0.5*qtmp/deltaq(i,k) + 0.5
             983     6   p                            cldtot(i,k) = max(cldtot(i,k),0.0)
             984     6   p                            cldtot(i,k) = min(cldtot(i,k),1.0)
             985     6   p                          endif
             986     5   p                        else
             987     6   p                          if(qtmp.gt.0) then
             988     6   p                            cldtot(i,k) = 1.0
             989     6   p                          else
             990     6   p                            cldtot(i,k) = 0.0
             991     6   p                          endif
             992     5   p                        endif
             993     4   p                      endif
             994     3   p                      cldtot(i,k) = cnvc(i,k)+(1-cnvc(i,k))*cldtot(i,k)
             995     3   p                      cldtot(i,k) = max(cldtot(i,k),0.)
             996     3   p                      cldtot(i,k) = min(cldtot(i,k),1.)
             997     3   p                     enddo
             998     2   p                     enddo
             999     1                     else                                 ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1000     2  pp                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1001     3   p                     do i = 1, ix
            1002     3   p                       tem1 = tlyr(i,k) - 273.16
            1003     4   p                       if(tem1 < con_thgni) then  ! for pure ice, has to be consistent with gscond
            1004     4   p                         qsc = sup * qstl(i,k)
            1005     4   p                         rhs = sup
            1006     4   p                       else
            1007     4   p                         qsc = qstl(i,k)
            1008     4   p                         rhs = 1.0
            1009     4   p                       endif
            1010     4   p                      if(rhly(i,k) >= rhs) then
            1011     4   p                        cldtot(i,k) = 1.0
            1012     4   p                      else
            1013     4   p                        qtmp = qlyr(i,k) + clwf(i,k) - qsc
            1014     5   p                        if(deltaq(i,k) > epsq) then
            1015     5               !              if(qtmp <= -deltaq(i,k) .or. cwmik < epsq) then
            1016     6   p                          if(qtmp <= -deltaq(i,k)) then
            1017     6   p                            cldtot(i,k) = 0.0
            1018     6   p                          elseif(qtmp >= deltaq(i,k)) then
            1019     6   p                            cldtot(i,k) = 1.0
            1020     6   p                          else
            1021     6   p                            cldtot(i,k) = 0.5*qtmp/deltaq(i,k) + 0.5
            1022     6   p                            cldtot(i,k) = max(cldtot(i,k),0.0)
            1023     6   p                            cldtot(i,k) = min(cldtot(i,k),1.0)
            1024     6   p                          endif
            1025     5   p                        else
            1026     6   p                          if(qtmp > 0.) then
            1027     6   p                            cldtot(i,k) = 1.0
            1028     6   p                          else
            1029     6   p                            cldtot(i,k) = 0.0
            1030     6   p                          endif
            1031     5   p                        endif
            1032     4   p                      endif
            1033     3   p                      cldtot(i,k) = cnvc(i,k) + (1-cnvc(i,k))*cldtot(i,k)
            1034     3   p                      cldtot(i,k) = max(cldtot(i,k),0.)
            1035     3   p                      cldtot(i,k) = min(cldtot(i,k),1.)
            1036     3               
            1037     3   p                     enddo
            1038     2   p                     enddo
            1039     1                     endif                                ! end_if_flip
            1040                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1041     1  pp   2             do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1042     2   p   2               do i = 1, ix
            1043     3   p   2                 if (cldtot(i,k) < climit) then
            1044     3   p   2                   cldtot(i,k) = 0.0
            1045     3   p   2                   cwp(i,k)    = 0.0
            1046     3   p   2                   cip(i,k)    = 0.0
            1047     3   p   2                   crp(i,k)    = 0.0
            1048     3   p   2                   csp(i,k)    = 0.0
            1049     3   p   2                 endif
            1050     2   p   2               enddo
            1051     1   p   2             enddo
            1052                     
            1053     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1054     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1055     3   p                     do i = 1, ix
            1056     4   p                       if (cldtot(i,k) >= climit) then
            1057     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            1058     4   p                         cwp(i,k) = cwp(i,k) * tem1
            1059     4   p                         cip(i,k) = cip(i,k) * tem1
            1060     4   p                         crp(i,k) = crp(i,k) * tem1
            1061     4   p                         csp(i,k) = csp(i,k) * tem1
            1062     4   p                       endif
            1063     3   p                     enddo
            1064     2   p                   enddo
            1065     1                     endif
            1066                     
            1067                     !  ---  effective ice cloud droplet radius
            1068                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1069,1095)
                                   <<< Loop-information  End >>>
            1069     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1070,1096)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, cwp, rew, rei, rer
                                   <<< Loop-information  End >>>
            1070     2   p                   do i = 1, ix
            1071     2   p                     tem2 = tlyr(i,k) - con_ttp
            1072     2               
            1073     3   p                     if (cip(i,k) > 0.0) then
            1074     3               !           tem3 = gord * cip(i,k) * (plyr(i,k)/delp(i,k)) / tvly(i,k)
            1075     3   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            1076     3               
            1077     4   p                       if (tem2 < -50.0) then
            1078     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            1079     4   p                       elseif (tem2 < -40.0) then
            1080     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            1081     4   p                       elseif (tem2 < -30.0) then
            1082     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            1083     4   p                       else
            1084     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            1085     4   p                       endif
            1086     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            1087     3               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            1088     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            1089     3               !           rei(i,k)   = max(5.0, min(rei(i,k), 130.0))
            1090     3   p                     endif
            1091     2   p                   enddo
            1092     1   p                 enddo
            1093                     
            1094                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1095     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1096     2                       do i = 1, ix
            1097     2   p                     clouds(i,k,1) = cldtot(i,k)
            1098     2   p                     clouds(i,k,2) = cwp(i,k)
            1099     2   p                     clouds(i,k,3) = rew(i,k)
            1100     2   p                     clouds(i,k,4) = cip(i,k)
            1101     2   p                     clouds(i,k,5) = rei(i,k)
            1102     2               !         clouds(i,k,6) = 0.0
            1103     2   p                     clouds(i,k,7) = rer(i,k)
            1104     2               !         clouds(i,k,8) = 0.0
            1105     2   p                     clouds(i,k,9) = rei(i,k)
            1106     2                       enddo
            1107     1                     enddo
            1108                     
            1109                     
            1110                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            1111                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            1112                     !       the three cloud domain boundaries are defined by ptopc.  the cloud
            1113                     !       overlapping method is defined by control flag 'iovr', which may
            1114                     !       be different for lw and sw radiation programs.
            1115                     
            1116                           call gethml                                                       &
            1117                     !  ---  inputs:
            1118                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            1119                          &       ix,nlay,                                                   &
            1120                     !  ---  outputs:
            1121                          &       clds, mtop, mbot                                           &
            1122                          &     )
            1123                     
            1124                     
            1125                     !
            1126                           return
            1127                     !...................................
            1128                           end subroutine progcld3
            1129                     !-----------------------------------
            1130                     
            1131                     !-----------------------------------
            1132                           subroutine progcld2                                               &
            1133                     !...................................
            1134                     
            1135                     !  ---  inputs:
            1136                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
            1137                          &       xlat,xlon,slmsk, f_ice,f_rain,r_rime,flgmin,               &
            1138                          &       ix, nlay, nlp1,                                            &
            1139                     !  ---  outputs:
            1140                          &       clouds,clds,mtop,mbot                                      &
            1141                          &      )
            1142                     
            1143                     ! =================   subprogram documentation block   ================ !
            1144                     !                                                                       !
            1145                     ! subprogram:    progcld2    computes cloud related quantities using    !
            1146                     !   ferrier's prognostic cloud microphysics scheme.                     !
            1147                     !                                                                       !
            1148                     ! abstract:  this program computes cloud fractions from cloud           !
            1149                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            1150                     !   and computes the low, mid, high, total and boundary layer cloud     !
            1151                     !   fractions and the vertical indices of low, mid, and high cloud      !
            1152                     !   top and base.  the three vertical cloud domains are set up in the   !
            1153                     !   initial subroutine "cld_init".                                      !
            1154                     !                                                                       !
            1155                     ! usage:         call progcld2                                          !
            1156                     !                                                                       !
            1157                     ! subprograms called:   gethml                                          !
            1158                     !                                                                       !
            1159                     ! attributes:                                                           !
            1160                     !   language:   fortran 90                                              !
            1161                     !   machine:    ibm-sp, sgi                                             !
            1162                     !                                                                       !
            1163                     !                                                                       !
            1164                     !  ====================  defination of variables  ====================  !
            1165                     !                                                                       !
            1166                     ! input variables:                                                      !
            1167                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
            1168                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
            1169                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
            1170                     !   tvly  (ix,nlay) : model layer virtual temperature in k              !
            1171                     !   qlyr  (ix,nlay) : layer specific humidity in gm/gm                  !
            1172                     !   qstl  (ix,nlay) : layer saturate humidity in gm/gm                  !
            1173                     !   rhly  (ix,nlay) : layer relative humidity (=qlyr/qstl)              !
            1174                     !   clw   (ix,nlay) : layer cloud condensate amount                     !
            1175                     !   f_ice (ix,nlay) : fraction of layer cloud ice  (ferrier micro-phys) !
            1176                     !   f_rain(ix,nlay) : fraction of layer rain water (ferrier micro-phys) !
            1177                     !   r_rime(ix,nlay) : mass ratio of total ice to unrimed ice (>=1)      !
            1178                     !   flgmin(ix)      : minimim large ice fraction                        !
            1179                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
            1180                     !                     range, otherwise see in-line comment              !
            1181                     !   xlon  (ix)      : grid longitude in radians  (not used)             !
            1182                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            1183                     !   ix              : horizontal dimention                              !
            1184                     !   nlay,nlp1       : vertical layer/level dimensions                   !
            1185                     !                                                                       !
            1186                     ! output variables:                                                     !
            1187                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
            1188                     !      clouds(:,:,1) - layer total cloud fraction                       !
            1189                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            1190                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            1191                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            1192                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            1193                     !      clouds(:,:,6) - layer rain drop water path         (g/m**2)      !
            1194                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            1195                     !  *** clouds(:,:,8) - layer snow flake water path        (g/m**2)      !
            1196                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            1197                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            1198                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            1199                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
            1200                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
            1201                     !                                                                       !
            1202                     ! external module variables:                                            !
            1203                     !   ivflip          : control flag of vertical index direction          !
            1204                     !                     =0: index from toa to surface                     !
            1205                     !                     =1: index from surface to toa                     !
            1206                     !   lcrick          : control flag for eliminating crick                !
            1207                     !                     =t: apply layer smoothing to eliminate crick      !
            1208                     !                     =f: do not apply layer smoothing                  !
            1209                     !   lcnorm          : control flag for in-cld condensate                !
            1210                     !                     =t: normalize cloud condensate                    !
            1211                     !                     =f: not normalize cloud condensate                !
            1212                     !   lnoprec         : precip effect in radiation flag (ferrier scheme)  !
            1213                     !                     =t: snow/rain has no impact on radiation          !
            1214                     !                     =f: snow/rain has impact on radiation             !
            1215                     !                                                                       !
            1216                     !  ====================    end of description    =====================  !
            1217                     !
            1218                           implicit none
            1219                     
            1220                     !  ---  constants
            1221                     
            1222                     !  ---  inputs
            1223                           integer,  intent(in) :: ix, nlay, nlp1
            1224                     
            1225                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            1226                          &       tlyr, tvly, qlyr, qstl, rhly, clw, f_ice, f_rain, r_rime
            1227                     
            1228                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            1229                          &       slmsk
            1230                           real (kind=kind_phys), dimension(:), intent(in) :: flgmin
            1231                     
            1232                     !  ---  outputs
            1233                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            1234                     
            1235                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            1236                     
            1237                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            1238                     
            1239                     !  ---  local variables:
            1240                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
            1241                          &       cwp, cip, crp, csp, rew, rei, res, rer, tem2d, clw2,       &
            1242                          &       qcwat, qcice, qrain, fcice, frain, rrime, rsden, clwf
            1243                     
            1244                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
            1245                     
            1246                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            1247                          &       tem1, tem2, tem3
            1248                     
            1249                           integer :: i, k, id
            1250                     
            1251                     !
            1252                     !===> ... begin here
            1253                     !
            1254                     !     clouds(:,:,:) = 0.0
            1255                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1256     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cldcnv, cwp, cip, crp, csp, rew
                                   <<<      rei, rer, res, fcice, frain, rrime
                                   <<<      tem2d
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1257     2   p                   do i = 1, ix
            1258     2   p                     cldtot(i,k) = 0.0
            1259     2   p                     cldcnv(i,k) = 0.0
            1260     2   p                     cwp   (i,k) = 0.0
            1261     2   p                     cip   (i,k) = 0.0
            1262     2   p                     crp   (i,k) = 0.0
            1263     2   p                     csp   (i,k) = 0.0
            1264     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
            1265     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
            1266     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            1267     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
            1268     2   p                     fcice (i,k) = max(0.0, min(1.0, f_ice(i,k)))
            1269     2   p                     frain (i,k) = max(0.0, min(1.0, f_rain(i,k)))
            1270     2   p                     rrime (i,k) = max(1.0, r_rime(i,k))
            1271     2   p                     tem2d (i,k) = tlyr(i,k) - con_t0c
            1272     2   p                   enddo
            1273     1   p                 enddo
            1274                     !
            1275     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1276     2  pp   2               do i = 1, ix
            1277     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
            1278     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
            1279     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1280     2  pp                   do k = 2, nlay-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1281     3   p   2                 do i = 1, ix
            1282     3   p   2                   clwf(i,k) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
            1283     3   p   2                 enddo
            1284     2   p                   enddo
            1285     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1286     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1287     3   p   4                 do i = 1, ix
            1288     3   p   4                   clwf(i,k) = clw(i,k)
            1289     3   p   4                 enddo
            1290     2   p                   enddo
            1291     1                     endif
            1292                     
            1293                     !  ---  find top pressure for each cloud domain for given latitude
            1294                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,l,m,h;
            1295                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            1296                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            1297     1  pp                 do id = 1, 4
            1298     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            1299     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            1300     2   p   2               do i =1, ix
            1301     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            1302     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            1303     2               
            1304     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            1305     2   p   2               enddo
            1306     1   p                 enddo
            1307                     
            1308                     !  ---  separate cloud condensate into liquid, ice, and rain types, and
            1309                     !       save the liquid+ice condensate in array clw2 for later
            1310                     !       calculation of cloud fraction
            1311                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 291
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d, clwf, qcwat, clw2
                                   <<< Loop-information  End >>>
            1312     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1313     2   p                   do i = 1, ix
            1314     3   p                     if (tem2d(i,k) > -40.0) then
            1315     3   p                       qcice(i,k) = clwf(i,k) * fcice(i,k)
            1316     3   p                       tem1       = clwf(i,k) - qcice(i,k)
            1317     3   p                       qrain(i,k) = tem1 * frain(i,k)
            1318     3   p                       qcwat(i,k) = tem1 - qrain(i,k)
            1319     3   p                       clw2 (i,k) = qcwat(i,k) + qcice(i,k)
            1320     3   p                     else
            1321     3   p                       qcice(i,k) = clwf(i,k)
            1322     3   p                       qrain(i,k) = 0.0
            1323     3   p                       qcwat(i,k) = 0.0
            1324     3   p                       clw2 (i,k) = clwf(i,k)
            1325     3   p                     endif
            1326     2   p                   enddo
            1327     1   p                 enddo
            1328                     
            1329                           call  rsipath2                                                    &
            1330                     !  ---  inputs:
            1331                          &     ( plyr, plvl, tlyr, qlyr, qcwat, qcice, qrain, rrime,        &
            1332                          &       ix, nlay, ivflip, flgmin,                                  &
            1333                     !  ---  outputs:
            1334                          &       cwp, cip, crp, csp, rew, rer, res, rsden                   &
            1335                          &     )
            1336                     
            1337                     
            1338     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1339     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1340     3   p   2                 do i = 1, ix
            1341     3   p   2                   tem2d(i,k) = (con_g * plyr(i,k))                            &
            1342     3                    &                 / (con_rd* (plvl(i,k+1) - plvl(i,k)))
            1343     3   p   2                 enddo
            1344     2   p                   enddo
            1345     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1346     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1347     3   p   2                 do i = 1, ix
            1348     3   p   2                   tem2d(i,k) = (con_g * plyr(i,k))                            &
            1349     3                    &                 / (con_rd* (plvl(i,k) - plvl(i,k+1)))
            1350     3   p   2                 enddo
            1351     2   p                   enddo
            1352     1                     endif                            ! end_if_ivflip
            1353                     
            1354                     !  ---  layer cloud fraction
            1355                     
            1356     1                     if ( ivflip == 0 ) then              ! input data from toa to sfc
            1357     1               
            1358     1                       clwmin = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1359     2  pp                   do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clw2
                                   <<< Loop-information  End >>>
            1360     3   p                   do i = 1, ix
            1361     3               !         clwt = 1.0e-6 * (plyr(i,k)*0.001)
            1362     3   p                     clwt = 2.0e-6 * (plyr(i,k)*0.001)
            1363     3               
            1364     4   p                     if (clw2(i,k) > clwt) then
            1365     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            1366     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            1367     4               
            1368     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)    !jhan
            1369     4   p                       tem1  = 100.0 / tem1
            1370     4               
            1371     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1372     4               !           tem1  = 2000.0 / tem1
            1373     4               !
            1374     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1375     4               !           tem1  = 2200.0 / tem1
            1376     4               !           tem1  = 2400.0 / tem1
            1377     4               !           tem1  = 2500.0 / tem1
            1378     4               !           tem1  = min(max(sqrt(onemrh*qstl(i,k)),0.0001),1.0)
            1379     4               !           tem1  = 2000.0 / tem1
            1380     4               !           tem1  = 1000.0 / tem1
            1381     4               !           tem1  = 100.0 / tem1
            1382     4               
            1383     4   p                       value = max( min( tem1*(clw2(i,k)-clwm), 50.0 ), 0.0 )
            1384     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
            1385     4               
            1386     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            1387     4   p                     endif
            1388     3   p                   enddo
            1389     2   p                   enddo
            1390     1               
            1391     1                     else                                 ! input data from sfc to toa
            1392     1               
            1393     1                       clwmin = 0.0e-6
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1394     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clw2
                                   <<< Loop-information  End >>>
            1395     3   p                   do i = 1, ix
            1396     3               !         clwt = 1.0e-6 * (plyr(i,k)*0.001)
            1397     3   p                     clwt = 2.0e-6 * (plyr(i,k)*0.001)
            1398     3               
            1399     4   p                     if (clw2(i,k) > clwt) then
            1400     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            1401     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            1402     4               
            1403     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)   !jhan
            1404     4   p                       tem1  = 100.0 / tem1
            1405     4               
            1406     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1407     4               !           tem1  = 2000.0 / tem1
            1408     4               !
            1409     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1410     4               !           tem1  = 2200.0 / tem1
            1411     4               !           tem1  = 2400.0 / tem1
            1412     4               !           tem1  = 2500.0 / tem1
            1413     4               !           tem1  = min(max(sqrt(onemrh*qstl(i,k)),0.0001),1.0)
            1414     4               !           tem1  = 2000.0 / tem1
            1415     4               !           tem1  = 1000.0 / tem1
            1416     4               !           tem1  = 100.0 / tem1
            1417     4               
            1418     4   p                       value = max( min( tem1*(clw2(i,k)-clwm), 50.0 ), 0.0 )
            1419     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
            1420     4               
            1421     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            1422     4   p                     endif
            1423     3   p                   enddo
            1424     2   p                   enddo
            1425     1               
            1426     1                     endif                                ! end_if_flip
            1427                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
            1428     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1429     2   p   2               do i = 1, ix
            1430     3   p   2                 if (cldtot(i,k) < climit) then
            1431     3   p   2                   cldtot(i,k) = 0.0
            1432     3   p   2                   cwp(i,k)    = 0.0
            1433     3   p   2                   cip(i,k)    = 0.0
            1434     3   p   2                   crp(i,k)    = 0.0
            1435     3   p   2                   csp(i,k)    = 0.0
            1436     3   p   2                 endif
            1437     2   p   2               enddo
            1438     1   p                 enddo
            1439                     
            1440                     !     when lnoprec = .true. snow/rain has no impact on radiation
            1441     1                     if ( lnoprec ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            1442     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp
                                   <<< Loop-information  End >>>
            1443     3   p   4                 do i = 1, ix
            1444     3   p   4                   crp(i,k) = 0.0
            1445     3   p   4                   csp(i,k) = 0.0
            1446     3   p   4                 enddo
            1447     2   p                   enddo
            1448     1                     endif
            1449                     !
            1450     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1451     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1452     3   p                     do i = 1, ix
            1453     4   p                       if (cldtot(i,k) >= climit) then
            1454     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            1455     4   p                         cwp(i,k) = cwp(i,k) * tem1
            1456     4   p                         cip(i,k) = cip(i,k) * tem1
            1457     4   p                         crp(i,k) = crp(i,k) * tem1
            1458     4   p                         csp(i,k) = csp(i,k) * tem1
            1459     4   p                       endif
            1460     3   p                     enddo
            1461     2   p                   enddo
            1462     1                     endif
            1463                     
            1464                     !  ---  effective ice cloud droplet radius
            1465                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1466,1496)
                                   <<< Loop-information  End >>>
            1466     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1467,1497)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, crp, rer, cwp, rew, rei
                                   <<<      csp, rsden
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1467     2   p                   do i = 1, ix
            1468     2   p                     tem1 = tlyr(i,k) - con_ttp
            1469     2   p                     tem2 = cip(i,k)
            1470     2               
            1471     3   p                     if (tem2 > 0.0) then
            1472     3   p                       tem3 = tem2d(i,k) * tem2 / tvly(i,k)
            1473     3               
            1474     4   p                       if (tem1 < -50.0) then
            1475     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            1476     4   p                       elseif (tem1 < -40.0) then
            1477     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            1478     4   p                       elseif (tem1 < -30.0) then
            1479     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            1480     4   p                       else
            1481     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            1482     4   p                       endif
            1483     3               
            1484     3               !           if (lprnt .and. k == l) print *,' reil=',rei(i,k),' icec=', &
            1485     3               !    &        icec,' cip=',cip(i,k),' tem=',tem,' delt=',delt
            1486     3               
            1487     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 300.0))
            1488     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            1489     3               !!!!        rei(i,k)   = max(30.0, min(rei(i,k), 300.0))
            1490     3               !           rei(i,k)   = max(50.0, min(rei(i,k), 300.0))
            1491     3               !           rei(i,k)   = max(100.0, min(rei(i,k), 300.0))
            1492     3   p                     endif
            1493     2   p                   enddo
            1494     1   p                 enddo
            1495                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1496     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1497     2                       do i = 1, ix
            1498     2   p                     clouds(i,k,1) = cldtot(i,k)
            1499     2   p                     clouds(i,k,2) = cwp(i,k)
            1500     2   p                     clouds(i,k,3) = rew(i,k)
            1501     2   p                     clouds(i,k,4) = cip(i,k)
            1502     2   p                     clouds(i,k,5) = rei(i,k)
            1503     2   p                     clouds(i,k,6) = crp(i,k)
            1504     2   p                     clouds(i,k,7) = rer(i,k)
            1505     2               !         clouds(i,k,8) = csp(i,k)               !ncar scheme
            1506     2   p                     clouds(i,k,8) = csp(i,k) * rsden(i,k)  !fu's scheme
            1507     2   p                     clouds(i,k,9) = rei(i,k)
            1508     2                       enddo
            1509     1                     enddo
            1510                     
            1511                     
            1512                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            1513                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            1514                     !       the three cloud domain boundaries are defined by ptopc.  the cloud
            1515                     !       overlapping method is defined by control flag 'iovr', which may
            1516                     !       be different for lw and sw radiation programs.
            1517                     
            1518                           call gethml                                                       &
            1519                     !  ---  inputs:
            1520                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            1521                          &       ix,nlay,                                                   &
            1522                     !  ---  outputs:
            1523                          &       clds, mtop, mbot                                           &
            1524                          &     )
            1525                     
            1526                     
            1527                     !
            1528                           return
            1529                     !...................................
            1530                           end subroutine progcld2
            1531                     !-----------------------------------
            1532                     

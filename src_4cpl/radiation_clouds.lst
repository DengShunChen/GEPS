                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            3994     7   p   2                         do ib = 1, nbin
            3995     7   p   2                           rhcla(ib,il,ic,is) = rhcl(ib,il,j+1,ic,is)          &
            3996     7                    &                + (rhcl(ib,il,j,ic,is)-rhcl(ib,il,j+1,ic,is))     &
            3997     7                    &                * (xlatdg-xlss) / (xlnn-xlss)
            3998     7   p   2                         enddo
            3999     6   p   2                       enddo
            4000     5   p   f                     enddo
            4001     4   p   f                   enddo
            4002     3       f                 endif
            4003     2               
            4004     2       f               enddo        ! end_j_loop
            4005     1               
            4006     1               !  ---  get rh-cld relationship for each grid point, interpolating
            4007     1               !       longitudinally between regions if necessary..
            4008     1               
            4009     2                       if (slmsk(i) < 1.0) then
            4010     2                         is = 2
            4011     2                       else
            4012     2                         is = 1
            4013     2                       endif
            4014     1               
            4015     1               !  ---  which hemisphere (e,w)
            4016     1               
            4017     2                       if (xlondg > 180.e0) then
            4018     2                         il = 2
            4019     2                       else
            4020     2                         il = 1
            4021     2                       endif
            4022     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4023     2   s                   do ic = 1, mcld
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4024     3   s   4                 do ib = 1, nbin
            4025     3   p   4                   rhcld(i,ib,ic) = rhcla(ib,il,ic,is)
            4026     3   p   4                 enddo
            4027     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4028     3   s   f                 lab_do_k : do k = 1, 3
            4029     3   p   f                   tem2 = abs(xlondg - xlobdy(k))
            4030     3               
            4031     4   p   f                   if (tem2 < xlim) then
            4032     4   p   f                     id = il
            4033     4   p   f                     id1= id + 1
            4034     4   p   f                     if (id1 > nlon) id1 = 1
            4035     4               
            4036     4   p   f                     xlft = xlobdy(k) - xlim
            4037     4   p   f                     xrgt = xlobdy(k) + xlim
            4038     4               

               1                           subroutine cuentr_n(nxj,klon,klev,kk,kcbot,ldcum,ldwork, &
               2                                         pgeoh,pmfu,pdmfen,pdmfde)
               3                     !--------------------------------------------------------------------
               4                       USE mo_constants, ONLY : g,  & ! gravity acceleration
               5                                                rd, & ! gas constant for dry air
               6                                                zrg        ! 1.0/g
               7                     !--------------------------------------------------------------------
               8                            implicit none
               9                            integer  klon,klev,kk,nxj
              10                            integer  kcbot(klon)
              11                            logical  ldcum(klon)
              12                            logical  ldwork
              13                            real  pgeoh(klon,klev+1)
              14                            real  pmfu(klon,klev)
              15                            real  pdmfen(klon)
              16                            real  pdmfde(klon)
              17                            logical  llo1
              18                            integer  jl
              19                            real  zdz , zmf
              20                            real  zentr(klon)
              21                         !
              22                         !* 1. CALCULATE ENTRAINMENT AND DETRAINMENT RATES
              23                         ! -------------------------------------------
              24     1                   if ( ldwork ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 25,33)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.38, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kcbot, ldcum, zentr, pdmfde, pmfu, pgeoh
                                   <<<      pdmfen
                                   <<< Loop-information  End >>>
              25     2  pp    v             do jl = 1, nxj
              26     2   p    v              pdmfen(jl) = 0.
              27     2   p    v              pdmfde(jl) = 0.
              28     2   p    v              zentr(jl) = 0.
              29     2   p    v            end do
              30     1                     !
              31     1                     !*  1.1 SPECIFY ENTRAINMENT RATES
              32     1                     !   -------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
              33     2                      do jl = 1, nxj
              34     3                       if ( ldcum(jl) ) then
              35     3                         zdz = (pgeoh(jl,kk)-pgeoh(jl,kk+1))*zrg
              36     3                         zmf = pmfu(jl,kk+1)*zdz
              37     3                         llo1 = kk < kcbot(jl)
              38     4                         if ( llo1 ) then
              39     4                           pdmfen(jl) = zentr(jl)*zmf
              40     4                           pdmfde(jl) = 0.75e-4*zmf
              41     4                         end if
              42     3                       end if
              43     2                     end do
              44     1                   end if
              45                         end subroutine cuentr_n


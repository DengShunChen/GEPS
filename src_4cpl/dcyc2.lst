 External subroutine subprogram "dcyc2t3"
  (inc)(line-no.)(nest)(optimize)
               1                     ! ===================================================================== !
               2                     !  description:                                                         !
               3                     !                                                                       !
               4                     !    dcyc2t3 fits radiative fluxes and heating rates from a coarse      !
               5                     !    radiation calc time interval into model's more frequent time steps.!
               6                     !    solar heating rates and fluxes are scaled by the ratio of cosine   !
               7                     !    of zenith angle at the current time to the mean value used in      !
               8                     !    radiation calc.  surface downward lw flux is scaled by the ratio   !
               9                     !    of current surface air temperature (temp**4) to the corresponding  !
              10                     !    temperature saved during lw radiation calculation. upward lw flux  !
              11                     !    at the surface is computed by current ground surface temperature.  !
              12                     !    surface emissivity effect will be taken in other part of the model.!
              13                     !                                                                       !
              14                     !  usage:                                                               !
              15                     !                                                                       !
              16                     !    call dcyc2t3                                                       !
              17                     !      inputs:                                                          !
              18                     !          ( solhr,slag,sdec,cdec,sinlat,coslat,                        !
              19                     !            xlon,coszen,tsea,tf,tsflw,                                 !
              20                     !            sfcdsw,sfcnsw,sfcdlw,swh,hlw,swhc,hlwc,                    !
              21                     !            ix, im, levs,                                              !
              22                     !      input/output:                                                    !
              23                     !            dtrad,dtradc,                                              !
              24                     !      outputs:                                                         !
              25                     !            adjsfcdsw,adjsfcnsw,adjsfcdlw,adjsfculw,xmu,xcosz)         !
              26                     !                                                                       !
              27                     !                                                                       !
              28                     !  program history:                                                     !
              29                     !          198?  nmc mrf    - created, similar as treatment in gfdl     !
              30                     !                             radiation treatment                       !
              31                     !          1994  y. hou     - modified solar zenith angle calculation   !
              32                     !     nov  2004  x. wu      - add sfc sw downward flux to the variable  !
              33                     !                             list for sea-ice model                    !
              34                     !     mar  2008  y. hou     - add cosine of zenith angle as output for  !
              35                     !                             sunshine duration time calc.              !
              36                     !     sep  2008  y. hou     - separate net sw and downward lw in slrad, !
              37                     !                 changed the sign of sfc net sw to consistent with     !
              38                     !                 other parts of the mdl (positive value defines from   !
              39                     !                 atmos to the ground). rename output fluxes as adjusted!
              40                     !                 fluxes. other minor changes such as renaming some of  !
              41                     !                 passing argument names to be consistent with calling  !
              42                     !                 program.                                              !
              43                     !     apr  2009  y. hou     - integrated with the new parallel model    !
              44                     !                 along with other modifications                        !
              45                     !                                                                       !
              46                     !  subprograms called:  none                                            !
              47                     !                                                                       !
              48                     !                                                                       !
              49                     !  ====================  defination of variables  ====================  !
              50                     !                                                                       !
              51                     !  inputs:                                                              !
              52                     !     solhr        - real, forecast time in 24-hour form (hr)           !
              53                     !     slag         - real, equation of time in radians                  !
              54                     !     sdec, cdec   - real, sin and cos of the solar declination angle   !
              55                     !     sinlat(im), coslat(im):                                           !
              56                     !                  - real, sin and cos of latitude                      !
              57                     !     xlon   (im)  - real, longitude in radians                         !
              58                     !     coszen (im)  - real, avg of cosz over daytime sw call interval    !
              59                     !     tsea   (im)  - real, ground surface temperature (k)               !
              60                     !     tf     (im)  - real, surface air (layer 1) temperature (k)        !
              61                     !     tsflw  (im)  - real, sfc air (layer 1) temp in k saved in lw call !
              62                     !     sfcdsw (im)  - real, total sky sfc downward sw flux ( w/m**2 )    !
              63                     !     sfcnsw (im)  - real, total sky sfc net sw into ground (w/m**2)    !
              64                     !     sfcdlw (im)  - real, total sky sfc downward lw flux ( w/m**2 )    !
              65                     !     swh(ix,levs) - real, total sky sw heating rates ( k/s )           !
              66                     !     hlw(ix,levs) - real, total sky lw heating rates ( k/s )           !
              67                     !     swhc(ix,levs)- real, clear sky sw heating rates ( k/s )           !
              68                     !     hlwc(ix,levs)- real, clear sky lw heating rates ( k/s )           !
              69                     !     ix, im       - integer, horiz. dimention and num of used points   !
              70                     !     levs         - integer, vertical layer dimension                  !
              71                     !                                                                       !
              72                     !  input/output:                                                        !
              73                     !     dtrad(im,levs)- real, model time step adjusted total radiation    !
              74                     !                          heating rates ( k/s )                        !
              75                     !     dtradc(im,levs)-real, model time step adjusted clear sky radiation!
              76                     !                          heating rates ( k/s )                        !
              77                     !                                                                       !
              78                     !  outputs:                                                             !
              79                     !     adjsfcdsw(im)- real, time step adjusted sfc dn sw flux (w/m**2)   !
              80                     !     adjsfcnsw(im)- real, time step adj sfc net sw into ground (w/m**2)!
              81                     !     adjsfcdlw(im)- real, time step adjusted sfc dn lw flux (w/m**2)   !
              82                     !     adjsfcnlw(im)- real, time step adj sfc net lw into atmospher (w/m**2)!
              83                     !     xmu   (im)   - real, time step zenith angle adjust factor for sw  !
              84                     !     xcosz (im)   - real, cosine of zenith angle at current time step  !
              85                     !                                                                       !
              86                     !  ====================    end of description    =====================  !
              87                     
              88                     !-----------------------------------
              89                           subroutine dcyc2t3                                               &
              90                     !...................................
              91                     !  ---  inputs:
              92                               ( solhr,slag,sdec,cdec,sinlat,coslat,                        &
              93                                 xlon,coszen,tsea,tf,tsflw,                                 &
              94                                 sfcdsw,sfcnsw,sfcdlw,swh,hlw,                              &
              95                                 swhc,hlwc,ix, im, levs,                                    &
              96                     !  ---  output:
              97                                 dtrad,dtradc,                                              &
              98                     !  ---  outputs:
              99                                 adjsfcdsw,adjsfcnsw,adjsfcdlw,adjsfcnlw,xmu                &
             100                               )
             101                     !
             102                           use machine,         only : kind_phys
             103                           use physcons,        only : con_pi, con_sbc
             104                           use const,           only : RTYPE
             105                     
             106                           implicit none
             107                     !
             108                     !  ---  constant parameters:
             109                           real(kind=kind_phys), parameter :: f_eps  = 0.0001
             110                           real(kind=kind_phys), parameter :: hour12 = 12.0
             111                     
             112                     !  ---  inputs:
             113                           integer, intent(in) :: ix, im, levs
             114                     
             115                           real(kind=kind_phys), intent(in) :: solhr, slag, cdec, sdec,     &
             116                                sinlat, coslat
             117                     
             118                     
             119                           real(kind=kind_phys), dimension(ix), intent(in) ::               &
             120                                xlon, coszen, tsea, tsflw, sfcdlw,                          &
             121                                sfcdsw, sfcnsw
             122                           real(kind=RTYPE), dimension(ix), intent(in) ::                   &
             123                                tf
             124                     
             125                           real(kind=kind_phys), dimension(ix,levs), intent(in) :: swh, hlw
             126                           real(kind=kind_phys), dimension(ix,levs), intent(in) :: swhc, hlwc
             127                     
             128                     !  ---  input/output:
             129                           real(kind=kind_phys), dimension(ix,levs), intent(inout) :: dtrad &
             130                                                                                     ,dtradc
             131                     
             132                     !  ---  outputs:
             133                           real(kind=kind_phys), dimension(ix), intent(out) ::              &
             134                                adjsfcdsw, adjsfcnsw, adjsfcdlw, adjsfcnlw, xmu
             135                     
             136                     !  ---  locals:
             137                           integer :: i, k
             138                           real(kind=kind_phys) :: cns, ss, cc, ch, tem1, tem2, xlw(im)
             139                     !
             140                     !     adjsfculw(im)- real, sfc upward lw flux at current time (w/m**2)  !
             141                           real(kind=kind_phys), dimension(ix) :: adjsfculw
             142                     !===> ...  begin here
             143                     !
             144                     !  --- ...  compute cosine of solar zenith angle for both hemispheres.
             145                     
             146                           cns = con_pi * (solhr - hour12) / hour12 + slag
             147                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.81, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xlon, tf, tsflw, xlw, xmu
                                   <<< Loop-information  End >>>
             148     1  pp    v            do i = 1, im
             149     1   p    v              ss     = sinlat * sdec
             150     1   p    v              cc     = coslat * cdec
             151     1   p    v              ch     = cc * cos( xlon(i)+cns )
             152     1   p    v              xmu(i) = ch + ss
             153     1               
             154     1               !  --- ...  for lw time-step adjustment: compute 4th power of the ratio of
             155     1               !           layer 1 temperature over the value during radiation calculation
             156     1               
             157     1   p    v              tem1   = tf(i) / tsflw(i)
             158     1   p    v              xlw(i) = tem1 * tem1
             159     1   p    v            enddo
             160                     
             161                     !  --- ...  normalize by average value over radiation period for daytime.
             162                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 163,172)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.04, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      coszen, xmu, sfcdsw, sfcnsw, tsea
                                   <<<      adjsfculw, adjsfcnlw, xlw, sfcdlw
                                   <<<      adjsfcdlw, adjsfcdsw, adjsfcnsw
                                   <<< Loop-information  End >>>
             163     1  pp    v            do i = 1, im
             164     1               !        xcosz(i) = xmu(i)
             165     2   p    v              if ( xmu(i) > f_eps .and. coszen(i) > f_eps ) then
             166     2   p    v                xmu(i) = xmu(i) / coszen(i)
             167     2   p    v              else
             168     2   p    v                xmu(i) = 0.0
             169     2   p    v              endif
             170     1   p    v            enddo
             171                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             172     1                     do i = 1, im
             173     1               !  --- ...  adjust sfc downward lw flux to account for t changes in layer 1.
             174     1               !           1st line is for original version, 2nd one is for updated version
             175     1                       adjsfcdlw(i) = sfcdlw(i) * xlw(i) * xlw(i)
             176     1               
             177     1               !  --- ...  compute sfc upward lw flux from current temp,
             178     1               !      note: sfc emiss effect is not appied at this time
             179     1                       tem1         = tsea(i) * tsea(i)
             180     1                       adjsfculw(i) =  con_sbc * tem1 * tem1
             181     1               
             182     1                       adjsfcnlw(i) = adjsfculw(i)-adjsfcdlw(i)
             183     1               
             184     1               !  --- ...  adjust sfc net and downward sw fluxes for zenith angle changes
             185     1                       adjsfcnsw(i) = sfcnsw(i) * xmu(i)
             186     1                       adjsfcdsw(i) = sfcdsw(i) * xmu(i)
             187     1                     enddo
             188                     
             189                     !  --- ...  adjust sw heating rates with zenith angle change and
             190                     !           add with lw heating to temperature tendency
             191                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      swhc, swh, xmu, hlwc, hlw, dtradc, dtrad
                                   <<< Loop-information  End >>>
             192     1  pp                 do k = 1, levs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      swhc, xmu, hlwc, dtradc, swh, hlw, dtrad
                                   <<< Loop-information  End >>>
             193     2   p    v              do i = 1, im
             194     2   p    v                dtrad(i,k) = swh(i,k)*xmu(i) + hlw(i,k)
             195     2   p    v                dtradc(i,k) = swhc(i,k)*xmu(i) + hlwc(i,k)
             196     2   p    v              enddo
             197     1   p                 enddo
             198                     !
             199                           return
             200                     !...................................
             201                           end subroutine dcyc2t3
             202                     !-----------------------------------
             203                     


                                   <<< Loop-information  End >>>
            1931     1  pp    s            do i= 1, im
            1932     2   p    m              if(cnvflg(i)) then
            1933     2   p    s                tem = zi(i,ktcon1(i)) - zi(i,kbcon1(i))
            1934     2   p    s                dtconv(i) = tem / wc(i)
            1935     2   p    s                tfac = 1. + gdx(i) / 75000.
            1936     2   p    s                dtconv(i) = tfac * dtconv(i)
            1937     2   p    s                dtconv(i) = max(dtconv(i),dtmin)
            1938     2   p    s                dtconv(i) = min(dtconv(i),dtmax)
            1939     2   p    v              endif

            1841     2  pp    v              do i = 1, im
            1842     3   p    v                if (asqecflg(i) .and. k.lt.jmin(i)) then
            1843     3   p    v                    gamma = el2orc * qeso(i,k) / to(i,k)**2
            1844     3   p    v                    dhh=hcdo(i,k)

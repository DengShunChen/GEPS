                                   <<<      cnvflg, xaa0, mbdt, xmb
                                   <<< Loop-information  End >>>
            1997     1  pp    v            do i= 1, im
            1998     2   p    v              if(asqecflg(i)) then
            1999     2               !         fld(i)=(aa1(i)-acrt(i)*acrtfct(i))/dtconv(i)
            2000     2   p    v                fld(i)=aa1(i)/dtconv(i)
            2001     3   p    v                if(fld(i) <= 0.) then
            2002     3   p    v                  asqecflg(i) = .false.
            2003     3   p    v                  cnvflg(i) = .false.
            2004     3   p    v                endif
            2005     2   p    v              endif
            2006     1               !> - Calculate the stabilization effect of the convection (per unit
            2007     1               !cloud base mass flux) as in equation 6 of Pan and Wu (1995) \cite
            2008     1               !pan_and_wu_1995 :
            2009     1               !! \f[
            2010     1               !! \frac{\partial A}{\partial t}_{cu}=\frac{A^*-A^+}{\Delta t_{cu}}
            2011     1               !! \f]
            2012     1               !! \f$\Delta t_{cu}\f$ is the short timescale of the convection.
            2013     2   p    v              if(asqecflg(i)) then
            2014     2               !         xaa0(i) = max(xaa0(i),0.)
            2015     2   p    v                xk(i) = (xaa0(i) - aa1(i)) / mbdt(i)
            2016     3   p    v                if(xk(i) >= 0.) then
            2017     3   p    v                  asqecflg(i) = .false.
            2018     3   p    v                  cnvflg(i) = .false.
            2019     3   p    v                endif
            2020     2   p    v              endif
            2021     1               !
            2022     1               !--- kernel, cloud base mass flux
            2023     1               !
            2024     1               !> - The cloud base mass flux (xmb) is then calculated from equation 7
            2025     1               !of Pan and Wu (1995) \cite pan_and_wu_1995
            2026     1               !! \f[
            2027     1               !! M_c=\frac{-\frac{\partial A}{\partial t}_{LS}}{\frac{\partial
            2028     1               !A}{\partial t}_{cu}}
            2029     1               !! \f]
            2030     1               !!
            2031     1               !!  Again when dtconv is larger than tauadv, the cloud base mass flux is
            2032     1               !further reduced in proportion to the ratio of tauadv to dtconv.
            2033     2   p    v              if(asqecflg(i)) then
            2034     2   p    v                tfac = tauadv(i) / dtconv(i)
            2035     2   p    v                tfac = min(tfac, 1.)
            2036     2   p    v                xmb(i) = -tfac * fld(i) / xk(i)
            2037     2               !         xmb(i) = min(xmb(i),xmbmax(i))
            2038     2   p    v              endif
            2039     1   p    v            enddo
            2040                     !!
            2041                           totflg = .true.

                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, umean, sumx, gdx, tauadv
                                   <<< Loop-information  End >>>
            1962     1  pp    v            do i= 1, im
            1963     2   p    v              if(cnvflg(i)) then
            1964     2   p    v                 umean(i) = umean(i) / sumx(i)
            1965     2   p    v                 umean(i) = max(umean(i), 1.)
            1966     2   p    v                 tauadv(i) = gdx(i) / umean(i)
            1967     2   p    v              endif
            1968     1   p    v            enddo
            1969                     !> - From Han et al.'s (2017) \cite han_et_al_2017 equation 6, calculate
            1970                     !cloud base mass flux as a function of the mean updraft velcoity for the
            1971                     !grid sizes where the quasi-equilibrium assumption of Arakawa-Schubert
            1972                     !is not valid any longer.
            1973                     !!  As discussed in Han et al. (2017) \cite han_et_al_2017 , when dtconv
            1974                     !is larger than tauadv, the convective mixing is not fully conducted
            1975                     !before the cumulus cloud is advected out of the grid cell. In this
            1976                     !case, therefore, the cloud base mass flux is further reduced in
            1977                     !proportion to the ratio of tauadv to dtconv.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            1978     1  pp    s            do i= 1, im
            1979     2   p    m              if(cnvflg(i) .and. .not.asqecflg(i)) then
            1980     2   p    s                k = kbcon(i)
            1981     2   p    s                rho = po(i,k)*100. / (rd*to(i,k))
            1982     2   p    s                tfac = tauadv(i) / dtconv(i)
            1983     2   p    s                tfac = min(tfac, 1.)
            1984     2   p    s                xmb(i) = tfac*betaw*rho*wc(i)
            1985     2   p    v              endif
            1986     1   p    v            enddo
            1987                     !> - For the cases where the quasi-equilibrium assumption of
            1988                     !Arakawa-Schubert is valid, first calculate the large scale
            1989                     !destabilization as in equation 5 of Pan and Wu (1995) \cite
            1990                     !pan_and_wu_1995 :
            1991                     !! \f[
            1992                     !!  \frac{\partial A}{\partial t}_{LS}=\frac{A^+-cA^0}{\Delta t_{LS}}
            1993                     !! \f]
            1994                     !! Here \f$A^0\f$ is set to zero following  Han et al.'s (2017) \cite
            1995                     !han_et_al_2017 , implying that the instability is completely eliminated
            1996                     !after the convective adjustment time, \f$\Delta t_{LS}\f$.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 169
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

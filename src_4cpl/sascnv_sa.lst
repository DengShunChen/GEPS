            2042     1  pp    v            do i=1,im
            2043     1   p    v              totflg = totflg .and. (.not. cnvflg(i))
            2044     1   p    v            enddo
            2045                           if(totflg) return
            2046                     !!
            2047                     !
            2048                     !> - For scale-aware parameterization, the updraft fraction (sigmagfm)
            2049                     !is first computed as a function of the lateral entrainment rate at
            2050                     !cloud base (see Han et al.'s (2017) \cite han_et_al_2017 equation 4 and
            2051                     !5), following the study by Grell and Freitas (2014) \cite
            2052                     !grell_and_freitus_2014.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 276
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.35, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, xlamx, sigmagfm
                                   <<< Loop-information  End >>>
            2053     1  pp   2v            do i = 1, im
            2054     2   p   2v              if(cnvflg(i)) then
            2055     2   p   2v                tem = min(max(xlamx(i), 7.e-5), 3.e-4)
            2056     2   p   2v                tem = 0.2 / tem
            2057     2   p   2v                tem1 = 3.14 * tem * tem
            2058     2   p   2v                sigmagfm(i) = tem1 / garea
            2059     2   p   2v                sigmagfm(i) = max(sigmagfm(i), 0.001)
            2060     2   p   2v                sigmagfm(i) = min(sigmagfm(i), 0.999)
            2061     2   p   2v              endif
            2062     1   p   2v            enddo
            2063                     !
            2064                     !> - Then, calculate the reduction factor (scaldfunc) of the vertical
            2065                     !convective eddy transport of mass flux as a function of updraft
            2066                     !fraction from the studies by Arakawa and Wu (2013) \cite
            2067                     !arakawa_and_wu_2013 (also see Han et al.'s (2017) \cite han_et_al_2017
            2068                     !equation 1 and 2). The final cloud base mass flux with scale-aware
            2069                     !parameterization is obtained from the mass flux when sigmagfm << 1,
            2070                     !multiplied by the reduction factor (Han et al.'s (2017) \cite
            2071                     !han_et_al_2017 equation 2).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gdx, scaldfunc, xmb, sigmagfm, xmbmax
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            2072     1  pp    v            do i = 1, im
            2073     2   p    v              if(cnvflg(i)) then
            2074     3   p    v                if (gdx(i) .lt. dxcrtuf) then
            2075     3   p    v                  scaldfunc(i) = (1.-sigmagfm(i)) * (1.-sigmagfm(i))
            2076     3   p    v                  scaldfunc(i) = max(min(scaldfunc(i), 1.0), 0.)
            2077     3   p    v                else
            2078     3   p    v                  scaldfunc(i) = 1.0
            2079     3   p    v                endif
            2080     2   p    v                xmb(i) = xmb(i) * scaldfunc(i)
            2081     2   p    v                xmb(i) = min(xmb(i),xmbmax(i))
            2082     2   p    v              endif
            2083     1   p    v            enddo
            2084                     !!
            2085                     !
            2086                     !  restore to,qo,uo,vo to t1,q1,u1,v1 in case convection stops
            2087                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

            1795     3   p    v                    dh       = hcdo(i,k) - heso(i,k)
            1796     3   p    v                    qrcd(i,k)=dq+(1./hvap)*(gamma/(1.+gamma))*dh
            1797     3               !             detad    = etad(i,k+1) - etad(i,k)
            1798     3               !
            1799     3   p    v                    dz = zi(i,k+1) - zi(i,k)
            1800     4   p    v                    if(k.ge.kbcon(i)) then
            1801     4   p    v                       tem  = xlamde * dz
            1802     4   p    v                       tem1 = 0.5 * xlamdd * dz
            1803     4   p    v                    else
            1804     4   p    v                       tem  = xlamde * dz
            1805     4   p    v                       tem1 = 0.5 * (xlamd(i)+xlamdd) * dz
            1806     4   p    v                    endif
            1807     3   p    v                    factor = 1. + tem - tem1
            1808     3   p    v                    qcdo(i,k) = ((1.-tem1)*qcdo(i,k+1)+tem*0.5*  &
            1809     3                                          (qo(i,k)+qo(i,k+1)))/factor
            1810     3               !
            1811     3               !             xpwd     = etad(i,k+1) * qcdo(i,k+1) -
            1812     3               !                        etad(i,k) * qrcd(i,k)
            1813     3               !             xpwd     = xpwd - detad *
            1814     3               !                      .5 * (qrcd(i,k) + qrcd(i,k+1))
            1815     3               !
            1816     3   p    v                    xpwd     = etad(i,k) * (qcdo(i,k) - qrcd(i,k))
            1817     3               !              qcdo(i,k)= qrcd(i,k)
            1818     3   p    v                    xpwev(i) = xpwev(i) + xpwd
            1819     3   p    v                endif
            1820     2   p    v              enddo
            1821     1                     enddo

            2089     2   p    s              do i = 1, im
            2090     3   p    m                if (cnvflg(i) .and. k .le. kmax(i)) then
            2091     3   p    s                  to(i,k) = t1(i,k)
            2092     3   p    s                  qo(i,k) = q1(i,k)
            2093     3   p    s                  uo(i,k) = u1(i,k)

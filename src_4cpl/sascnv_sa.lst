                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u1, kbcon1, v1, zi, umean, sumx, ktcon1
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
            1951     2  pp    v              do i = 1, im
            1952     3   p    v                if(cnvflg(i)) then
            1953     4   p    v                  if(k .ge. kbcon1(i) .and. k .lt. ktcon1(i)) then
            1954     4   p    v                    dz = zi(i,k) - zi(i,k-1)
            1955     4   p    v                    tem = sqrt(u1(i,k)*u1(i,k)+v1(i,k)*v1(i,k))
            1956     4   p    v                    umean(i) = umean(i) + tem * dz
            1957     4   p    v                    sumx(i) = sumx(i) + dz
            1958     4   p    v                  endif
            1959     3   p    v                endif
            1960     2   p    v              enddo
            1961     1                     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391

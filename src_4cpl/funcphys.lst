             552                         real(krealfp) xj
             553                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
             554                         xj=min(max(c1xpvsi+c2xpvsi*t,1._krealfp),real(nxpvsi,krealfp))
             555                         jx=min(xj,nxpvsi-1._krealfp)
             556                         fpvsi=tbpvsi(jx)+(xj-jx)*(tbpvsi(jx+1)-tbpvsi(jx))

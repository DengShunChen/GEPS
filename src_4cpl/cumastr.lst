              10                     !SUBROUTINE cumastr(klon,klev,klevp1,klevm1,pten,pqen,pxen, puen,pven,   &
              11                     SUBROUTINE cumastr(nxj,klon,klev,klevp1,klevm1,pten,pqen,pxen, puen,pven,   &
              12                                        ldland,pverv,pqsen,pqhfl,papp1,paphp1,pgeo,   &
              13                     !                   ptte,pqte,pxtec,pvom,pvol,prsfc,pssfc,ktype,kcbot,kctop, &
              14                                        ptte,pqte,pxtec,pvom,pvol,prsfc,pssfc,kcbot,kctop, &
              15                                        ztodt,jin                                         ,&

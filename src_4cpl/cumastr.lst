             154                                   ed(klon,klev), ptu(klon,klev),pqu(klon,klev),        &
             155                                   plude(klon,klev), pmfd(klon,klev), pmfu(klon,klev), prain(klon)
             156                       REAL(r8) :: zcape(klon), zdmfdp(klon,klev), zdmfup(klon,klev),  &
             157                               zdpmel(klon,klev), zdqcv(klon), zdqpbl(klon), zentr(klon), &
             158                               zgeoh(klon,klev), zhcbase(klon), zheat(klon), zhhatt(klon,klev), &
             159                               zhmin(klon), zmfdq(klon,klev), zmfds(klon,klev), &
             160                     zmfub(klon), zmfub1(klon), zmful(klon,klev), &
             161                               zmfuq(klon,klev), zmfus(klon,klev), &
             162                               zqd(klon,klev), zqenh(klon,klev), zqsenh(klon,klev), zrfl(klon), &
             163                               zsfl(klon), ztd(klon,klev), ztenh(klon,klev), zud(klon,klev), &
             164                               zuu(klon,klev), zvd(klon,klev), zvu(klon,klev), zxenh(klon,klev), &
             165                               ztmp
             166                       INTEGER :: ictop0(klon), idtop(klon), ihmin(klon), ilwmin(klon)
             167                       LOGICAL :: loddraf(klon)
             168                     
             169                     
             170                       !  External subroutines
             171                       EXTERNAL cuasc, cubase, cuddraf, cudlfs, cudtdq, cududv, cuflx, cuini
             172                     
             173                       !  Intrinsic functions
             174                       INTRINSIC ABS, MAX, MERGE, MIN, SQRT
             175                     
             176                     
             177                       !  Executable statements
             178                     !xb110>
             179                       integer kcnv(klon)
             180                     !xb110<
             181                     
             182                     !CWB2016 debug
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paprs, paprc
                                   <<< Loop-information  End >>>
             183        pp   2v           paprc=0.
             184         p   2v           paprs=0.
             185                     
             186                     !-- 1. Specify constants and parameters
             187                     
             188                       ztmst = ztodt
             189                     !  ztmst = 0.5*ztodt
             190                     ! IF (nstep==nstart) ztmst = 0.5*ztodt
             191                     ! IF (is_first_step()) ztmst = 0.5*ztodt
             192                       zcons2 = 1./(g*ztmst)
             193                     
             194                     !-- 2. Initialize values at vertical grid points in 'cuini'
             195                     
             196                     !  CALL cuini(klon,klev,klevp1,klevm1,pten,pqen,pqsen,pxen,puen,          &
             197                       CALL cuini(nxj,klon,klev,klevp1,klevm1,pten,pqen,pqsen,pxen,puen,          &
             198                                  pven, &
             199                          pverv,pgeo,paphp1,     &
             200                                  zgeoh,ztenh,zqenh,zqsenh,zxenh,ilwmin,ptu,pqu,ztd,zqd,zuu,zvu,zud,zvd, &
             201                                  pmfu,pmfd,zmfus,zmfds,zmfuq,zmfdq,zdmfup,zdmfdp,zdpmel,plu,plude,ilab,jin)
             202                     !-- 3. Cloud base calculations
             203                     
             204                       ! (A) Determine cloud base values in 'cubase'
             205                     
             206                     !  CALL cubase(klon,klev,klevp1,klevm1,ztenh,zqenh,zgeoh,paphp1, &
             207                       CALL cubase(nxj,klon,klev,klevp1,klevm1,ztenh,zqenh,zgeoh,paphp1, &
             208                                   ptu,pqu,plu,puen,pven,zuu,zvu,ldcum,kcbot,ilab,jin)
             209                     
             210                       ! (B) Determine total moisture convergence and
             211                       !     then decide on type of cumulus convection
             212                     
             213                       jk = 1
             214                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 72, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paphp1, pqte, zdqcv, zdqpbl, idtop
                                   <<< Loop-information  End >>>
             215     1  pp    v        DO jl = 1, nxj
             216     1   p    v          zdqcv(jl) = pqte(jl,jk)*(paphp1(jl,jk+1)-paphp1(jl,jk))
             217     1   p    v          zdqpbl(jl) = 0.0
             218     1   p    v          idtop(jl) = 0
             219     1   p    v        END DO
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paphp1, kcbot, pqte, zdqcv, zdqpbl
                                   <<< Loop-information  End >>>
             220     1                 DO jk = 2, klev
             221     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 128, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zdqcv, kcbot, zdqpbl, paphp1, pqte
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 2  FILL 7
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             222     2  pp    v          DO jl = 1, nxj
             223     2   p    v            zdqcv(jl) = zdqcv(jl) + pqte(jl,jk)*(paphp1(jl,jk+1)-paphp1(jl,jk))
             224     2   p    v            IF (jk>=kcbot(jl)) zdqpbl(jl) = zdqpbl(jl) + pqte(jl,jk)*(paphp1(jl,jk+1) &
             225     2                            -paphp1(jl,jk))
             226     2   p    v          END DO
             227     1                 END DO
             228                     
             229                     !  DO JL = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.45, ITR: 128, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zdqcv, ktype, pqhfl
                                   <<< Loop-information  End >>>
             230     1  pp   2v        DO JL = 1, nxj
             231     1   p   2v          ktype(jl) = MERGE(1,2,zdqcv(jl)>MAX(0.d0,-1.1d0*pqhfl(jl)*g))
             232     1   p   2v        END DO
             233                     
             234                       ! (C) Determine moisture supply for boundary layer
             235                       !     and determine cloud base massflux ignoring
             236                       !     the effects of downdrafts at this stage
             237                     
             238                     !DIR$ IVDEP
             239                     !OCL NOVREC
             240                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 145
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.21, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kcbot, ktype, ldcum, zdqpbl, zentr
                                   <<<      zcape, zheat, zmfub
                                   <<< Loop-information  End >>>
             241     1  pp    v        DO jl = 1, nxj
             242     1   p    v          ikb = kcbot(jl)
             243     1   p    v          zqumqe = pqu(jl,ikb) + plu(jl,ikb) - zqenh(jl,ikb)
             244     1   p    v          zdqmin = MAX(0.01*zqenh(jl,ikb),1.d-10)
             245     1   p    v          llo1 = zdqpbl(jl) > 0. .AND. zqumqe > zdqmin .AND. ldcum(jl)
             246     1   p    v          zmfub(jl) = MERGE(zdqpbl(jl)/(g*MAX(zqumqe,zdqmin)),0.01d0,llo1)
             247     1   p    v          zmfmax = (paphp1(jl,ikb)-paphp1(jl,ikb-1))*zcons2
             248     1   p    v          zmfub(jl) = MIN(zmfub(jl),zmfmax)
             249     1   p    v          IF ( .NOT. llo1) ldcum(jl) = .FALSE.
             250     1   p    v          zcape(jl) = 0.
             251     1   p    v          zheat(jl) = 0.
             252     1   p    v          zentr(jl) = MERGE(entrpen,entrscv,ktype(jl)==1)
             253     1   p    v        END DO
             254                     
             255                     !-- 4. Determine cloud ascent for entraining plume
             256                     
             257                       ! (a) Estimate cloud height for entrainment/detrainment
             258                       !     calculations in cuasc (max.possible cloud height
             259                       !     for non-entraining plume, following a.-s.,1974)
             260                     
             261                     !DIR$ IVDEP
             262                     !OCL NOVREC
             263                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>

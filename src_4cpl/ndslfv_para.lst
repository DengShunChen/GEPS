 External subroutine subprogram "para_ns2we"
  (inc)(line-no.)(nest)(optimize)
              96                     
              97                     ! ======================================================================
              98                           subroutine para_ns2we(a,b,levs,latg)
              99                     !
             100                     ! mpi transport from full dimension of west-east to full dimension of
             101                     ! north-south with latitude shuffl.
             102                     !
             103                           use const   , only : RTYPE  ,MPI_RTYPE
             104                           use grid    , only : lonfull,lonhalf,lonpart,lonlenmax,mylonlen, &
             105                                                latfull,lathalf,latpart,latlenmax,mylatlen, &
             106                                                latstr ,latlen ,lonstr ,lonlen
             107                           use rank
             108                           use index
             109                           use mpi
             110                     !      use gfs_dyn_mpi_def
             111                     !      use gfs_dyn_layout1
             112                           implicit none
             113                     !
             114                           integer levs,latg
             115                           real(kind=RTYPE) a(latfull,levs,lonpart)
             116                           real(kind=RTYPE) b(lonfull,levs,latpart)
             117                     !      integer global_lats_a(latg)
             118                     !
             119                     !     real(kind=RTYPE) (kind=kind_mpi_r) works(2*levs*mylonlen*lathalf)
             120                     !     real(kind=RTYPE) (kind=kind_mpi_r) workr(2*levs*mylatlen*lonhalf)
             121                           real(kind=RTYPE) works(2,levs,lonlenmax*latlenmax,nsizey)
             122                           real(kind=RTYPE) workr(2,levs,lonlenmax*latlenmax,nsizey)
             123                           integer lensend(nsizey),lenrecv(nsizey)
             124                           integer locsend(nsizey),locrecv(nsizey)
             125                     !      integer i,j,k,n,mn,jj,lat1,lat2,ierr
             126                           integer i,j,k,n,mn,lat1,lat2,ierr
             127                     !
             128                     !     print *,' enter ndslfv_ns2we '
             129                     
             130                     !$omp parallel do private(n,mn,i,j,lat1,lat2,k) &
             131                     !$omp schedule(dynamic)
             132     1   p                 do n=1,nsizey
             133     1   p                   mn=0
             134     2   p                   do j=1,latlen(n)
             135     2               !          jj=latstr(n) + j -1
             136     2               !          lat1=global_lats_a(jj)
             137     2               !          lat1=latg-jlist1_sl(j,n)+1
             138     2   p                     lat1=jlist1_sl(j,n)
             139     2   p                     lat2=latfull+1-lat1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      works
                                   <<< Loop-information  End >>>
             140     3   p                     do i=1,mylonlen

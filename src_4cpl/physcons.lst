               1                     !!!!!  ==========================================================  !!!!!
               2                     !!!!!                 module  'physcons' description               !!!!!
               3                     !!!!!  ==========================================================  !!!!!
               4                     !                                                                      !
               5                     !   this module contains some the most frequently used math and        !
               6                     !   physics constatns for gcm models.                                  !
               7                     !                                                                      !
               8                     !   references:                                                        !
               9                     !     as set in NMC handbook from Smithsonian tables.                  !
              10                     !                                                                      !
              11                     !   modification history:                                              !
              12                     !                                                                      !
              13                     !     1990-04-30  g and rd are made consistent with NWS usage          !
              14                     !     2001-10-22  g made consistent with SI usage                      !
              15                     !     2005-04-13  added molicular weights for gases          - y-t hou !
              16                     !                                                                      !
              17                     !   external modules referenced:                                       !
              18                     !                                                                      !
              19                     !       'module machine'                    in 'machine.f'             !
              20                     !                                                                      !
              21                     !                                                                      !
              22                     !!!!!  ==========================================================  !!!!!
              23                     !!!!!                       end descriptions                       !!!!!
              24                     !!!!!  ==========================================================  !!!!!
              25                     
              26                     !========================================!
              27                               module physcons                !
              28                     !........................................!
              29                     !
              30                       use machine,      only : kind_phys
              31                     !
              32                       implicit none
              33                     !
              34                       public
              35                     
              36                     !  --- ...  Math constants
              37                     
              38                       real(kind=kind_phys),parameter:: con_pi     =3.1415926535897931 ! pi
              39                       real(kind=kind_phys),parameter:: con_sqrt2  =1.414214e+0        ! square root of 2
              40                       real(kind=kind_phys),parameter:: con_sqrt3  =1.732051e+0        ! square root of 3
              41                     
              42                     !  --- ...  Geophysics/Astronomy constants
              43                     
              44                       real(kind=kind_phys),parameter:: con_rerth  =6.3712e+6      ! radius of earth   (m)
              45                       real(kind=kind_phys),parameter:: con_g      =9.80665e+0     ! gravity           (m/s2)
              46                       real(kind=kind_phys),parameter:: con_omega  =7.2921e-5      ! ang vel of earth  (1/s)
              47                       real(kind=kind_phys),parameter:: con_p0     =1.01325e5      ! std atms pressure (pa)
              48                     ! real(kind=kind_phys),parameter:: con_solr   =1.36822e+3     ! solar constant    (W/m2)-aer(2001)
              49                       real(kind=kind_phys),parameter:: con_solr_old =1.3660e+3    ! solar constant    (W/m2)-liu(2002)
              50                       real(kind=kind_phys),parameter:: con_solr   =1.3608e+3      ! solar constant    (W/m2)-nasa-sorce tim (2008)
              51                     ! real(kind=kind_phys),parameter:: con_solr   =1.36742732e+3  ! solar constant    (W/m2)-gfdl(1989) - OPR as of Jan 2006
              52                     
              53                     !  --- ...  Thermodynamics constants
              54                     
              55                       real(kind=kind_phys),parameter:: con_rgas   =8.314472       ! molar gas constant  (J/mol/K)
              56                       real(kind=kind_phys),parameter:: con_rd     =2.8705e+2      ! gas constant air    (J/kg/K)
              57                       real(kind=kind_phys),parameter:: con_rv     =4.6150e+2      ! gas constant H2O    (J/kg/K)
              58                       real(kind=kind_phys),parameter:: con_cp     =1.0046e+3      ! spec heat air @p    (J/kg/K)
              59                       real(kind=kind_phys),parameter:: con_cv     =7.1760e+2      ! spec heat air @v    (J/kg/K)
              60                       real(kind=kind_phys),parameter:: con_cvap   =1.8460e+3      ! spec heat H2O gas   (J/kg/K)
              61                       real(kind=kind_phys),parameter:: con_cliq   =4.1855e+3      ! spec heat H2O liq   (J/kg/K)
              62                       real(kind=kind_phys),parameter:: con_csol   =2.1060e+3      ! spec heat H2O ice   (J/kg/K)
              63                       real(kind=kind_phys),parameter:: con_hvap   =2.5000e+6      ! lat heat H2O cond   (J/kg)
              64                       real(kind=kind_phys),parameter:: con_hfus   =3.3358e+5      ! lat heat H2O fusion (J/kg)
              65                       real(kind=kind_phys),parameter:: con_psat   =6.1078e+2      ! pres at H2O 3pt     (Pa)
              66                       real(kind=kind_phys),parameter:: con_t0c    =2.7315e+2      ! temp at 0C          (K)
              67                       real(kind=kind_phys),parameter:: con_ttp    =2.7316e+2      ! temp at H2O 3pt     (K)
              68                       real(kind=kind_phys),parameter:: con_tice   =2.7120e+2      ! temp freezing sea     (K)
              69                       real(kind=kind_phys),parameter:: con_jcal   =4.1855E+0      ! joules per calorie  ()
              70                       real(kind=kind_phys),parameter:: con_rhw0   =1022.0         ! sea water reference density (kg/m^3)
              71                       real(kind=kind_phys),parameter:: con_epsq   =1.0E-12        ! min q for computing precip type
              72                       real(kind=kind_phys),parameter:: con_thgni  =-38.15
              73                     
              74                     !  Secondary constants
              75                     
              76                       real(kind=kind_phys),parameter:: con_rocp   =con_rd/con_cp
              77                       real(kind=kind_phys),parameter:: con_cpor   =con_cp/con_rd
              78                       real(kind=kind_phys),parameter:: con_rog    =con_rd/con_g
              79                       real(kind=kind_phys),parameter:: con_fvirt  =con_rv/con_rd-1.
              80                       real(kind=kind_phys),parameter:: con_eps    =con_rd/con_rv
              81                       real(kind=kind_phys),parameter:: con_epsm1  =con_rd/con_rv-1.
              82                       real(kind=kind_phys),parameter:: con_dldt   =con_cvap-con_cliq
              83                       real(kind=kind_phys),parameter:: con_xpona  =-con_dldt/con_rv
              84                       real(kind=kind_phys),parameter:: con_xponb  =-con_dldt/con_rv+con_hvap/(con_rv*con_ttp)
              85                     
              86                     !  --- ...  Other Physics/Chemistry constants (source: 2002 CODATA)
              87                     
              88                       real(kind=kind_phys),parameter:: con_c      =2.99792458e+8  ! speed of light      (m/s)
              89                       real(kind=kind_phys),parameter:: con_plnk   =6.6260693e-34  ! planck constatn     (J/s)
              90                       real(kind=kind_phys),parameter:: con_boltz  =1.3806505e-23  ! boltzmann constant  (J/K)
              91                       real(kind=kind_phys),parameter:: con_sbc    =5.670400e-8    ! stefan-boltzmann    (W/m2/K4)
              92                       real(kind=kind_phys),parameter:: con_avgd   =6.0221415e23   ! avogadro constant   (1/mol)
              93                       real(kind=kind_phys),parameter:: con_gasv   =22413.996e-6   ! vol of ideal gas at 273.15k, 101.325kpa (m3/mol)
              94                     ! real(kind=kind_phys),parameter:: con_amd    =28.970         ! molecular wght of dry air (g/mol)
              95                       real(kind=kind_phys),parameter:: con_amd    =28.9644        ! molecular wght of dry air (g/mol)
              96                       real(kind=kind_phys),parameter:: con_amw    =18.0154        ! molecular wght of water vapor (g/mol)
              97                       real(kind=kind_phys),parameter:: con_amo3   =47.9982        ! molecular wght of o3  (g/mol)
              98                     ! real(kind=kind_phys),parameter:: con_amo3   =48.0           ! molecular wght of o3  (g/mol)
              99                       real(kind=kind_phys),parameter:: con_amco2  =44.011         ! molecular wght of co2 (g/mol)
             100                       real(kind=kind_phys),parameter:: con_amo2   =31.9999        ! molecular wght of o2  (g/mol)
             101                       real(kind=kind_phys),parameter:: con_amch4  =16.043         ! molecular wght of ch4 (g/mol)
             102                       real(kind=kind_phys),parameter:: con_amn2o  =44.013         ! molecular wght of n2o (g/mol)
             103                     ! for wsm6
             104                       real(kind=kind_phys),parameter:: rhowater   = 1000.         ! density of water (kg/m^3)
             105                       real(kind=kind_phys),parameter:: rhosnow    = 100.          ! density of snow (kg/m^3)
             106                       real(kind=kind_phys),parameter:: rhoair     = 1.28          ! density of air near surface (kg/m^3)
             107                     
             108                     
             109                     !........................................!
             110                           end module physcons                !

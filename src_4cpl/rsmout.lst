             321     1                     enddo
             322                     !
             323                     !      call mpe_unify(pllp,nx,my,2,mpe_double)
             324                     !      call mpe_unify(bt2,nx,my,2,mpe_double)
             325                     !
             326                     !  temperature output
             327                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             328     1  pp                 do jj =1,jlistnum
             329     1   p                   j=jlist1(jj)
             330     1   p                   nxj=nxdef_2d(j)
             331     1               !
             332     1               !  bottom boundary condition for temperature:
             333     1               !  limits for 1000 mb boundary condition are (1) standard lapse rate
             334     1               !  from bottom model level for terrain height and (2) layer mean temp
             335     1               !  of slp and 1000 mb.  Boundary condition is linear combination
             336     1               !  of these two cases weighted with subterrainean thickness.
             337     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, tmp
                                   <<< Loop-information  End >>>
             338     2   p                   do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, tmp
                                   <<< Loop-information  End >>>
             339     3   p   2v                do i = 1,nxj
             340     3   p   2v                  tmp(i,k,jj) = tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             341     3   p   2v                enddo
             342     2   p                   enddo
             343     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, pt, slp, plog, plt, tmp, bt1
                                   <<<      t1000
                                   <<< Loop-information  End >>>
             344     2   p    v              do i=1,nxj
             345     2   p    v                slp(i,jj) = max( slp(i,jj), pt(i,jj) )
             346     2   p    v                splog= log(slp(i,jj))
             347     2   p    v                dx= log(slp(i,jj)/(pt(i,jj)+ptop))
             348     2               !          bx= tmp(i,lev,jj)*(1.0/sig(lev+1))**0.19023 + sgeo(i,jj)*0.00065
             349     2   p    v                bx= tmp(i,lev,jj) + sgeo(i,jj)*0.00065
             350     3   p    v                if ( sgeo(i,jj) .ge. 1000.0 )  then
             351     3   p    v                  tmid = sgeo(i,jj)/(dx*rgas)
             352     3   p    v                  ax = tmp(i,lev,jj)+ (tmid-tmp(i,lev,jj))*(splog-plog(i,lev,jj)) &
             353     3                               / (log((slp(i,jj)+pt(i,jj)+ptop)*0.5)-plog(i,lev,jj))
             354     3   p    v                else
             355     3   p    v                  ax = bx
             356     3   p    v                endif
             357     2   p    v                cx = (sgeo(i,jj)-1000.0)/(10000.0-1000.0)
             358     2   p    v                cx = max (0.0, min (1.0, cx))
             359     2   p    v                dx = cx*cx
             360     2   p    v                tsf = dx*ax + (1.0-dx)*bx
             361     2   p    v                tadia= tmp(i,lev,jj)*(slp(i,jj)/plt(i,lev,jj))**0.25
             362     2   p    v                tsf  = max( tmp(i,lev,jj), min( tsf,tadia ) )
             363     3   p    v                if ( slp(i,jj) .gt. 1000.1 )  then
             364     3   p    v                  bt1(i,jj)= tsf
             365     3   p    v                  t1000(i,jj) = tsf
             366     3   p    v                else
             367     3   p    v                  bt1(i,jj)= tsf + (tsf-tmp(i,lev,jj))*(pl1000-splog)  &
             368     3                                    / (splog - plog(i,lev,jj))
             369     3   p    v                  t1000(i,jj) = bt1(i,jj)
             370     3   p    v                endif
             371     2   p    v              enddo
             372     1   p                 enddo

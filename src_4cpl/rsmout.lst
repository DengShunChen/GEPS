             184     1                       call mpe_global_sum(ngq,1,mpe_integer)
             185     1                       call mpe_global_sum(ntt,1,mpe_integer)
             186     1                       if( n.eq.1 .and. myrank.eq.0 .and. ngq.ne.0 )  print 901, ngq
             187     1                       if( n.eq.2 .and. myrank.eq.0 .and. ngq.ne.0 )  print 902, ntt-ngq
             188     1                     enddo

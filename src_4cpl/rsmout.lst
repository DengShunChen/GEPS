             193                                  , " with qc > 0. , total number = ",i8,// )
             194                     !
             195                     !                 compute interpolation coeffs
             196                     !
             197                           ograv= 1.0/grav
             198                     !
             199                     !  generate structure variables
             200                     !
             201                     !  first, the log(p) quantities
             202                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.89, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pout, pkout
                                   <<< Loop-information  End >>>
             203     1  pp    v            do k=1,lpout
             204     1   p    v              pkout(k)= log(pout(k))
             205     1   p    v            enddo
             206                     !
             207                     !  generate std height at p levels
             208                     !
             209                           call geostd(lpout,pout,phistd)
             210                     !
             211                           alaps = 0.0065
             212                           rdg = rgas/grav
             213                     !
             214                     !  hydrostatic equation
             215                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, tt, sgeo, phi
                                   <<< Loop-information  End >>>
             216     1  pp                 do jj =1,jlistnum
             217     1   p                   j=jlist1(jj)
             218     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 72, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, sgeo, tt, phi
                                   <<< Loop-information  End >>>
             219     2   p    v              do i=1,nxj
             220     2   p    v                phi(i,lev,jj)= cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj)) &
             221     2                                      + sgeo(i,jj)
             222     2   p    v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, tt, phi
                                   <<< Loop-information  End >>>
             223     2   p                   do k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 104, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, pk2, phi
                                   <<< Loop-information  End >>>
             224     3   p    v                do i=1,nxj
             225     3   p    v                  phi(i,k,jj)= phi(i,k+1,jj)+cp*(tt(i,k,jj)*(pk2(i,k,jj)-pk(i,k,jj)) &
             226     3                                      + tt(i,k+1,jj)*(pk(i,k+1,jj)-pk2(i,k,jj)))
             227     3   p    v                enddo
             228     2   p                   enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             229     2   p                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.89, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             230     3   p    v                do i=1,nxj
             231     3   p    v                  plog(i,k,jj)= log(plt(i,k,jj))
             232     3   p    v                enddo
             233     2   p                   enddo
             234     1   p                 enddo
             235                     !
             236                     !  compute sea level pressure and update pdiff
             237                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             238                     !
             239                     !  llts layer's temperature is used to derive an alternative
             240                     !  surface skin temperature
             241                     !
             242                     !      if( itau .gt. 0 )then
             243                     !
             244                           llts = lev-5
             245                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             246     1  pp                 do jj = 1, jlistnum
             247     1   p                   j=jlist1(jj)
             248     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, pk, plt, tt, qt, pt, phi, hld1
                                   <<<      hld2, pdiff, pllp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 2
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
             249     2   p    v              do i=1,nxj
             250     2   p    v                ttb  = tt(i,lev,jj)*pk(i,lev,jj)/(1.0+0.608*qt(i,lev,jj))
             251     2   p    v                ttp  = tt(i,llts,jj)*pk(i,llts,jj)/(1.0+0.608*qt(i,llts,jj))
             252     2   p    v                ttt1 = ttb + alaps*rdg*ttb*   &
             253     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             254     2   p    v                ttt2 = ttp + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             255     2   p    v                hld1(i,jj) = 0.25*ttt1 + 0.75*ttt2
             256     2   p    v                hld2(i,jj) = hld1(i,jj) + alaps*sgeo(i,jj)/grav
             257     3   p    v                if( sgeo(i,jj) .lt. 0.1 ) then
             258     3   p    v                  anlslp = pt(i,jj) + ptop
             259     3   p    v                else if( hld1(i,jj) .le. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             260     3   p    v                  apha = rgas*(290.5-hld1(i,jj))/sgeo(i,jj)
             261     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             262     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             263     3                                    apha*ttt*apha*ttt) )
             264     3   p    v                else if( hld1(i,jj) .gt. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             265     3   p    v                  hld1(i,jj) = (hld1(i,jj)+290.5)*0.5
             266     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             267     3   p    v                else if( hld1(i,jj) .lt. 255.0 .and. hld2(i,jj) .lt. 255.0 ) then
             268     3   p    v                  hld1(i,jj) = (hld1(i,jj)+255.0)*0.5
             269     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             270     3   p    v                else
             271     3   p    v                  apha = alaps * rdg
             272     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             273     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             274     3                                    apha*ttt*apha*ttt) )
             275     3   p    v                endif
             276     2   p    v                pllp(i,jj) = anlslp - pt(i,jj)
             277     2   p    v                pdiff(i,jj)=pllp(i,jj)
             278     2   p    v              enddo
             279     1   p                 enddo
             280                     !
             281                     !      else
             282                     !
             283                     !  pllp equal to pdiff at the initial time, tau=0
             284                     !
             285                     !      do jj = 1, jlistnum
             286                     !        j=jlist1(jj)
             287                     !        nxj=nxdef(j)
             288                     !        do i = 1, nxj
             289                     !          pllp(i,j) = pdiff(i,jj)
             290                     !        enddo
             291                     !      enddo
             292                     !
             293                     !      endif     ! end of ( itau .gt. 0 )
             294                     !

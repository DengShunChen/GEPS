             415     3   p    v                  dp      = .5 * (pfld(i,k+1) - pfld(i,k))
             416     3   s    s                  es      = 0.01 * fpvs(to(i,k+1))      ! fpvs is in pa
             417     3               !cwb qsat
             418     3               !         t11 = max(1.00001, min(190.999, to(i,k+1)-182.16))

             423     3               !cwb
             424     3   s    s                  pprime  = pfld(i,k+1) + epsm1 * es
             425     3   s    s                  qs      = eps * es / pprime
             426     3   s    s                  dqsdp   = - qs / pprime
             427     3   s    s                  desdt   = es * (fact1 / to(i,k+1) + fact2 / (to(i,k+1)**2))
             428     3   p    v                  dqsdt   = qs * pfld(i,k+1) * desdt / (es * pprime)
             429     3   m    m                  gamma   = el2orc * qeso(i,k+1) / (to(i,k+1)**2)

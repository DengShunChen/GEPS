             505     1  pp    s            do i=1,im
             506     2   p    m              if(cnvflg(i)) then
             507     3   p    s                if(slimsk(i).eq.1.) then
             508     3   p    s                  w1 = w1l
             509     3   p    s                  w2 = w2l
             510     3   p    s                  w3 = w3l
             511     3   p    s                  w4 = w4l
             512     3   p    s                else

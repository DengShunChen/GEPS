             478                     !
             479                     !  compute sea level pressure and write out pdiff
             480                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             481                     !
             482                           alaps = 0.0065
             483                           rdg = rgas/grav
             484                     !
             485                     !  llts layer's temperature is used to derive an alternative
             486                     !  surface skin temperature
             487                     !
             488                           llts = lev-5
             489                     !
             490     1                     do 190 jj = 1, jlistnum
             491     1                      j=jlist1(jj)
             492     1                      nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 214
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.82, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, plt, phi, sgeo, pt, hld2, hld1
                                   <<< Loop-information  End >>>
             493     2  pp    v            do 180 i = 1, nxj
             494     2   p    v             ttt1 = tt(i,lev,jj) + alaps*rdg*tt(i,lev,jj)*       &
             495     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             496     2   p    v             ttt2 = tt(i,llts,jj) + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             497     2   p    v             hld1(i,j) = 0.25*ttt1 + 0.75*ttt2
             498     2   p    v             hld2(i,j) = hld1(i,j) + alaps*sgeo(i,jj)/grav
             499     2   p    v        180 continue
             500     1                     ii=nxjstart(j)
             501     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, hld1, pt, anlslp, hld2
                                   <<< Loop-information  End >>>
             502     2  pp    v            do 185 i = 1, nxj
             503     3   p    v            if( sgeo(i,jj) .lt. 0.1 ) then
             504     3   p    v             anlslp(i,jj) = pt(i,jj) + ptop
             505     3               
             506     3   p    v            elseif( hld1(i,j) .le. 290.5 .and. hld2(i,j) .gt. 290.5 ) then
             507     3   p    v             apha = rgas*(290.5-hld1(i,j))/sgeo(i,jj)
             508     3   p    v             ttt = sgeo(i,jj)/(rgas*hld1(i,j))
             509     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333* &
             510     3                                    apha*ttt*apha*ttt) )
             511     3               
             512     3   p    v            elseif( hld1(i,j) .gt. 290.5 .and. hld2(i,j) .gt. 290.5 ) then
             513     3   p    v             hld1(i,j) = (hld1(i,j)+290.5)*0.5
             514     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,j)) )
             515     3               
             516     3   p    v            elseif( hld1(i,j) .lt. 255.0 .and. hld2(i,j) .lt. 255.0 ) then
             517     3   p    v             hld1(i,j) = (hld1(i,j)+255.0)*0.5
             518     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,j)) )
             519     3               

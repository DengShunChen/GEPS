 External subroutine subprogram "cubasmc"
  (inc)(line-no.)(nest)(optimize)
               1                     !+  Calculates cloud base values for midlevel convection
               2                     !+ $Id: cubasmc.f90,v 1.5 1999/09/17 11:18:36 m214089 Exp $
               3                     
               4                     !SUBROUTINE cubasmc(klon,klev,kk,pten,pqen,pqsen,puen,pven,&
               5                     SUBROUTINE cubasmc(nxj,klon,klev,kk,pten,pqen,pqsen,puen,pven,&
               6                     !ktrac, &
               7                     !&      pxten,pxtu,pmfuxt,
               8                        pverv,pgeo,pgeoh,ldcum,ktype,klab,pmfu,pmfub,pentr, &
               9                     &      kcbot,ptu,pqu,plu,puu,pvu,pmfus,pmfuq,pmful,pdmfup,pmfuu,pmfuv)
              10                     
              11                       ! Description:
              12                       !
              13                       ! This routine calculates cloud base values for midlevel convection
              14                       !
              15                       ! Method:
              16                       !
              17                       ! This routine is called from *cuasc*.
              18                       ! Input are environmental values t,q etc.
              19                       ! It returns cloudbase values for midlevel convection
              20                       !
              21                       ! Authors:
              22                       !
              23                       ! S. Tiedtke, ECMWF, in 1989, original source
              24                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              25                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              26                       !
              27                       ! for more details see file AUTHORS
              28                       !
              29                       USE shr_kind_mod, only: r8 => shr_kind_r8
              30                       USE mo_constants,    ONLY: cpd,     &! specific heat at constant pressure
              31                                                  rcpd,    &! rcpd=1./cpd
              32                                                  g         ! gravity acceleration
              33                       USE mo_cumulus_flux, ONLY: cmfcmin, &! minimum massflux value (for safety)
              34                                                  cmfcmax, &! maximum massflux value allowed for
              35                                                  entrmid, &! entrainment rate for midlevel convect.
              36                                                  lmfdudv   ! true if cumulus friction is switched on
              37                     
              38                       IMPLICIT NONE
              39                     
              40                       !  Scalar arguments with intent(In):
              41                     !  INTEGER, INTENT (IN) :: klon, kk, klev
              42                       INTEGER, INTENT (IN) :: klon, nxj, kk, klev
              43                     !, ktrac
              44                     
              45                       !  Array arguments with intent(In):
              46                       REAL(r8), INTENT (IN) :: pgeo(klon,klev), pgeoh(klon,klev), pqen(klon,klev),  &
              47                     &                      pqsen(klon,klev), pten(klon,klev), puen(klon,klev), &
              48                     &                      pven(klon,klev), pverv(klon,klev)
              49                     !, pxten(klon,klev,ktrac)
              50                       LOGICAL, INTENT (IN) :: ldcum(klon)
              51                     
              52                       !  Array arguments with intent(InOut):
              53                       REAL(r8), INTENT (INOUT) :: pdmfup(klon,klev), pentr(klon), plu(klon,klev), &
              54                     &                         pmfu(klon,klev), pmfub(klon), pmful(klon,klev), &
              55                     &                         pmfuq(klon,klev), pmfus(klon,klev), pmfuu(klon), &
              56                     &                         pmfuv(klon), &
              57                     !pmfuxt(klon,klev,ktrac),  &
              58                     &                         pqu(klon,klev), ptu(klon,klev), puu(klon,klev), &
              59                     &                         pvu(klon,klev)
              60                     !, pxtu(klon,klev,ktrac)
              61                       INTEGER, INTENT (INOUT) :: kcbot(klon), klab(klon,klev), ktype(klon)
              62                     
              63                       !  Local scalars:
              64                       REAL(r8) :: zzzmb
              65                       INTEGER :: jl, jt
              66                     
              67                       !  Local arrays:
              68                       LOGICAL :: llo3(klon)
              69                     
              70                       !  Intrinsic functions
              71                       INTRINSIC MAX, MIN
              72                     
              73                     
              74                       !  Executable statements
              75                     
              76                     !-- 1. CALCULATE ENTRAINMENT AND DETRAINMENT RATES
              77                     
              78                     !DIR$ IVDEP
              79                     !OCL NOVREC
              80                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 122
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ldcum, klab, pqsen, pqen, pten, pgeo
                                   <<<      pgeoh, ptu, pqu, plu, pverv, pmfub, pmfu
                                   <<<      pmfus, pmfuq, pmful
                                   <<<    PREFETCH(SOFT) : 22
                                   <<<     SEQUENTIAL : 22
                                   <<<      ktype: 2, pentr: 2, puen: 2, puu: 2
                                   <<<      pven: 2, pvu: 2, pdmfup: 2, kcbot: 2
                                   <<<      pmfuv: 2, pmfuu: 2, llo3: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              81     1  pp    v        DO jl = 1, nxj
              82     1   p    v          llo3(jl) = .FALSE.
              83     2   p    v           IF( .NOT. ldcum(jl) .AND. klab(jl,kk+1).EQ.0                  &
              84     2                             .AND. pqen(jl,kk) .GT. 0.90*pqsen(jl,kk) ) THEN
              85     2   p    v            llo3(jl) = .TRUE.
              86     2   p    v            ptu(jl,kk+1) = (cpd*pten(jl,kk)+pgeo(jl,kk)-pgeoh(jl,kk+1))*rcpd
              87     2   p    v            pqu(jl,kk+1) = pqen(jl,kk)
              88     2   p    v            plu(jl,kk+1) = 0.
              89     2   p    v            zzzmb = MAX(cmfcmin,-pverv(jl,kk)/g)
              90     2   p    v            zzzmb = MIN(zzzmb,cmfcmax)
              91     2   p    v            pmfub(jl) = zzzmb
              92     2   p    v            pmfu(jl,kk+1) = pmfub(jl)
              93     2   p    v            pmfus(jl,kk+1) = pmfub(jl)*(cpd*ptu(jl,kk+1)+pgeoh(jl,kk+1))
              94     2   p    v            pmfuq(jl,kk+1) = pmfub(jl)*pqu(jl,kk+1)
              95     2   p    v            pmful(jl,kk+1) = 0.
              96     2   p    v            pdmfup(jl,kk+1) = 0.
              97     2   p    v            kcbot(jl) = kk
              98     2   p    v            klab(jl,kk+1) = 1
              99     2   p    v            ktype(jl) = 3
             100     2   p    v            pentr(jl) = entrmid
             101     3   p    v            IF (lmfdudv) THEN
             102     3   p    v              puu(jl,kk+1) = puen(jl,kk)
             103     3   p    v              pvu(jl,kk+1) = pven(jl,kk)
             104     3   p    v              pmfuu(jl) = pmfub(jl)*puu(jl,kk+1)
             105     3   p    v              pmfuv(jl) = pmfub(jl)*pvu(jl,kk+1)
             106     3   p    v            END IF
             107     2   p    v          END IF
             108     1   p    v        END DO
             109                     
             110                     !DIR$ IVDEP
             111                     !OCL NOVREC
             112                     ! DO jt = 1, ktrac
             113                     !   DO jl = 1, klon
             114                     !   DO jl = 1, nxj
             115                     !     IF (llo3(jl)) THEN
             116                     !       pxtu(jl,kk+1,jt) = pxten(jl,kk,jt)
             117                     !       pmfuxt(jl,kk+1,jt) = pmfub(jl)*pxtu(jl,kk+1,jt)
             118                     !     END IF
             119                     !   END DO
             120                     ! END DO
             121                     
             122                       RETURN
             123                     END SUBROUTINE cubasmc


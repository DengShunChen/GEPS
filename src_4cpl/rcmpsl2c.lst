              66                     
              67                           edding = .true.
              68                           quadra = .false.
              69                     !
              70                           nsn  = ns*lev
              71                           nsn1 = ns*(lev+1)
              72                           lev4 = lev*4
              73                           sqrt3= sqrt(3.)
              74                           rsqrt3= 1./sqrt3
              75                           pi   = 4.*atan(1.)

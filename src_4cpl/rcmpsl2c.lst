                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 263
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 113,122)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.73, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tau, ttau, ww1, ww2, ww, tmp1, w, w1
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             113     2   m    v            do i = 1, nsn
             114     2   p    v             fxx = ww2(i,m) / 5.0
             115     2   p    v             fw = 1.0 - fxx * ww(i,m)
             116     2   p    v             w1(i,m) = ( ww1(i,m) - 3.0 * fxx ) / ( 1.0 - fxx )
             117     2   p    v             w(i,m)  = ( 1.0 - fxx ) * ww(i,m) / fw
             118     2   p    v             w(i,m) = min ( w(i,m), 0.999999 )
             119     2   p    v             tmp1(i) = (ttau(i+ns,m) - ttau(i,m)) * fw
             120     2   p    v            enddo
             121     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             122     2                     do i = 1, nsn
             123     2        s             tau(i+ns,m) = tau(i,m) + tmp1(i)
             124     2                     enddo
             125     1               !ibm
             126     1               !fj      call vrec(tmp2(1),u0t(1),nsn)
             127     1               !fj      call vexp(expdt(1,m),tmp2(1),nsn)
             128     1               !ocl norecurrence,simd
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 20
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tau, w1, w, tmp1, u0t, expdt, tl, rl, rb
                                   <<<      tb
                                   <<< Loop-information  End >>>
             129     2  pp    v            do 40 i = 1, nsn
             130     2   p    v               tmp2 = 1.d0/u0t(i)
             131     2   p    v               tmp2 = -tmp1(i)*tmp2
             132     2   p    v               expdt(i,m) = exp(tmp2)
             133     2               !ibm
             134     2               !fj      do 40 i = 1, nsn
             135     2               !
             136     2               !fong02_1
             137     2               !cc   if ( edding ) then
             138     2   p    v      	   x = 0.25 * w1(i,m)     ! w1 = 3g
             139     2   p    v                 y = w(i,m) * x
             140     2   p    v                 gamma1 = 1.75 - w(i,m) - y
             141     2   p    v                 gamma2 = - 0.25 + w(i,m) - y
             142     2   p    v                 gamma3 = 0.5 - x * u0t(i)
             143     2   p    v                 gamma4 = 1.0 - gamma3
             144     2   p    v                 ugts1 = 0.5
             145     2               !
             146     2               !cc   elseif ( quadra ) then
             147     2               !          x = 0.5*sqrt3 * w(i,m)
             148     2               !          y = 0.5*rsqrt3 * w1(i,m)  ! rsqrt3 = 1/sqrt3
             149     2               !          z = y * w(i,m)
             150     2               !          gamma1 = sqrt3 - x - z
             151     2               !          gamma2 = x - z
             152     2               !          gamma3 = 0.5 - y * u0t(i)
             153     2               !          gamma4 = 1.0 - gamma3
             154     2               !          ugts1 = rsqrt3
             155     2               !cc   endif
             156     2               !fong02_1
             157     2               !ibm  lamdan = exp( 0.5*log((gamma1 + gamma2)*(gamma1 - gamma2)) )
             158     2   p    v            lamdan = sqrt((gamma1 + gamma2)*(gamma1 - gamma2))
             159     2   p    v            gamman = gamma2 / ( gamma1 + lamdan )
             160     2   p    v            z = lamdan * lamdan * u0t(i) * u0t(i) - 1.0
             161     3   p    v            if(abs(z) .lt. 0.000001)then
             162     3   p    v             u0_mod=u0t(i)+0.01*u0t(i)
             163     3   p    v             z = lamdan * lamdan * u0_mod * u0_mod - 1.0
             164     3   p    v            end if
             165     2   p    v            vh = ( -gamma3 + u0t(i)*(gamma1*gamma3+gamma2*gamma4) ) / z
             166     2   p    v            vk = (  gamma4 + u0t(i)*(gamma1*gamma4+gamma2*gamma3) ) / z
             167     2   p    v            enn = exp ( - lamdan * ( tau(i+ns,m)-tau(i,m) ) )
             168     2   p    v            axx = gamman * gamman
             169     2   p    v            bxx = enn * enn
             170     2   p    v            cxx = axx*bxx - 1.0
             171     2   p    v            rl(i,m) = gamman * ( bxx - 1.0 ) / cxx
             172     2   p    v            tl(i,m) = enn * ( axx - 1.0 ) / cxx
             173     2   p    v            rb(i,m) = w(i,m) * ( -vk*rl(i,m) - vh*expdt(i,m)* tl(i,m) + vh )
             174     2   p    v            tb(i,m) = w(i,m) * ( -vk*tl(i,m) - vh*expdt(i,m)* rl(i,m) + expdt(i,m)*vk )

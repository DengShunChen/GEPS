              93     2   p   2v            enddo
              94     1                     enddo
              95                     !
              96                     ! The following is used to calculate the Coefficients For Generalized
              97                     ! Two-Stream scheme.  We can make choices between Eddington, quadrature
              98                     ! and  hemispheric  mean  schemes  through  logical variables 'edding',
              99                     ! 'quadra', and 'hemisp'.  The  Eddington  and  quadrature  schemes are
             100                     ! discussed in detail by Liou (1992).  The  hemispheric  mean scheme is
             101                     ! derived by assuming that the phase function is equal to 1 + g in  the
             102                     ! forward scattering hemisphere and 1 - g  in  the  backward scattering
             103                     ! hemisphere where g is the asymmetry factor.   The hemispheric mean is
             104                     ! only used for infrared wavelengths (Toon et al. 1989).
             105                     !
             106                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww2, ww, ww1, ttau, w1, w, tmp1
                                   <<<      (unknown)

               1                           subroutine rcmpsl2c ( ns,nx,lev,u0,as,ww1,ww2,ww,ttau,cld,cldb    &
               2                                                ,ffu,ffd )
               3                     !
               4                     ! **********************************************************************
               5                     ! (1)
               6                     ! The generalized two stream approximation for nonhomgeneous atmospheres
               7                     ! in  the  solar  wavelengths.
               8                     !
               9                     ! (2)
              10                     ! The treatment of cloud overlapping for partial cloudinesses is included
              11                     ! by Fong(1996), which is based on the method proposed by Geleyn and
              12                     ! Hollingsworth (1979, contrib. atmos. phys. )
              13                     !
              14                     ! ++ input/output variables:
              15                     !    (1) input variables :
              16                     !        ns    : number of grid points to calculate sw flux
              17                     !        nx    : horizontal dimension of input array
              18                     !        lev   : number of vertical layers
              19                     !        u0    : cos(zenith angle)
              20                     !        as    : ground surface albedo
              21                     !        ww1~2 : first two coeff. of legendre polynomials for
              22                     !                the scattering phase function
              23                     !        ww    : single scattering albedo
              24                     !        ttau(lev+1) : total optical depth from top to reference level
              25                     !
              26                     !    (2) output variables :
              27                     !        ffu
              28                     !        ffd
              29                     !
              30                     ! ++ auther :
              31                     !    c. t. fong and fu (1996, summer)
              32                     !    modify to f90 by C-H Lee in 2015
              33                     !
              34                     ! **********************************************************************
              35                     !
              36                           use fj_pad
              37                     
              38                           implicit  none
              39                           integer   ns,nx,lev
              40                     
              41                           real      u0(nx),as(nx),ww1(nx*lev,2),ww2(nx*lev,2),ww(nx*lev,2), &
              42                                     ttau(nx*(lev+1),2),cld(nx*lev),cldb(nx*lev,4)

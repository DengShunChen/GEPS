                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      h
                                   <<< Loop-information  End >>>
              70     3   p    v               do 130 l = mf, jtrun
              71     4   p    v      	  if (l.ne.1) then
              72     4               !byl            vorten(k,1,l,m)=-vorten(k,1,l,m)*omega/h(l,m,k)
              73     4               !byl            vorten(k,2,l,m)=-vorten(k,2,l,m)*omega/h(l,m,k)
              74     4               !byl            temp1= divten(k,2,l,m)*omega/h(l,m,k)
              75     4               !byl            temp2=-divten(k,1,l,m)*omega/h(l,m,k)
              76     4   p    v                  vorten(k,1,l,m)=-vorten(k,1,l,m)*omega/h(l,m)
              77     4   p    v                  vorten(k,2,l,m)=-vorten(k,2,l,m)*omega/h(l,m)
              78     4   p    v                  temp1= divten(k,2,l,m)*omega/h(l,m)
              79     4   p    v                  temp2=-divten(k,1,l,m)*omega/h(l,m)
              80     4   p    v                  divten(k,1,l,m)= temp1
              81     4   p    v                  divten(k,2,l,m)= temp2
              82     4   p    v      	  endif
              83     2   p    v       130     continue
              84     1               !
                                   <<< Loop-information Start >>>

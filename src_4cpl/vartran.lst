                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.15, ITR: 48, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
              87     3   p   2v               do 135 l = mf, jtrun
              88     3   p   2v                phiten(k,1,l,m)= phiten(k,1,l,m)*omga2r2
              89     3   p   2v                phiten(k,2,l,m)= phiten(k,2,l,m)*omga2r2
              90     2   p   2v       135     continue
              91     1                     endif
              92                     !
              93                           return
              94                           end


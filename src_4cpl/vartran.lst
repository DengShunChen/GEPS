               1                           subroutine vartran(vorten,divten,phiten,nw,jtrun,jtmax,lev,k, &
               2                                              rad,omega,h,iflag)
               3                     !
               4                     !    purpose : conversion between dimension and dimensionless forms
               5                     !--------------------------------------------------------------------
               6                     ! *** input ****
               7                     !  vorten  :  vorticity tendency(correction) array in spectrum domaon
               8                     !  divten  :  divergence tendency(correction) array in spectrum domain
               9                     !  phiten  :  geopotantial tendency(correction) array in spectrum domain
              10                     !  nw      :  total wavenumber index array
              11                     !  lev     :  total vertical levels
              12                     !  k       :  vetical level of (non)dimensionlize
              13                     !  rad     :  radius of earth
              14                     !  omega   :  angular velocity of earth
              15                     !  h       :  coefficient array of (non)dimensionlize
              16                     !  iflag   : +2 = to nondimension form
              17                     !          : -2 = to dimensional form
              18                     ! **** output ****
              19                     !  vorten  :  vorticity tendency(correction) array in spectrum domaon
              20                     !  divten  :  divergence tendency(correction) array in spectrum domain
              21                     !  phiten  :  geopotantial tendency(correction) array in spectrum domain
              22                     !************************************
              23                           use index
              24                           use const, only: RTYPE
              25                     
              26                           implicit none
              27                     
              28                           integer  jtrun,jtmax,lev,k,iflag,m,l,mf
              29                     
              30                           real(kind=RTYPE) vorten(lev,2,jtrun,jtmax),   &
              31                                            divten(lev,2,jtrun,jtmax),   &
              32                                            phiten(lev,2,jtrun,jtmax)
              33                     !     real h(jtrun,jtmax,lev)
              34                     !byl      real h(jtrun,jtmax,levF) ! 2dMPI
              35                           real h(jtrun,jtmax) ! 2dMPI
              36                           integer nw(jtrun,jtmax)
              37                     
              38                           real omega2,omega,omga2r2,rad,temp1,temp2
              39                     
              40                           omega2=omega*omega
              41                           omga2r2=omega2*rad*rad
              42                     !
              43                     !  do nondimensionlize which are tendency
              44                     !
              45     1                     if(iflag.eq.2)then
              46     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              47     2  pp                    do 110 m = 1, mlistnum
              48     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      h
                                   <<< Loop-information  End >>>
              49     3   p    v               do 110 l = mf, jtrun
              50     3               !byl          vorten(k,1,l,m)=-h(l,m,k)*vorten(k,1,l,m)/omega2
              51     3               !byl          vorten(k,2,l,m)=-h(l,m,k)*vorten(k,2,l,m)/omega2
              52     3   p    v                vorten(k,1,l,m)=-h(l,m)*vorten(k,1,l,m)/omega2
              53     3   p    v                vorten(k,2,l,m)=-h(l,m)*vorten(k,2,l,m)/omega2
              54     3   p    v                temp1=divten(k,2,l,m)/omega2
              55     3   p    v                temp2=divten(k,1,l,m)/omega2
              56     3               !byl          divten(k,1,l,m)=-h(l,m,k)*temp1
              57     3               !byl          divten(k,2,l,m)= h(l,m,k)*temp2
              58     3   p    v                divten(k,1,l,m)=-h(l,m)*temp1
              59     3   p    v                divten(k,2,l,m)= h(l,m)*temp2
              60     3   p    v                phiten(k,1,l,m)=phiten(k,1,l,m)/omga2r2/omega
              61     3   p    v                phiten(k,2,l,m)=phiten(k,2,l,m)/omga2r2/omega
              62     2   p    v       110    continue
              63     1               !
              64     1               !  do dimensionlize which are correct term now
              65     1               !
              66     1                     else if(iflag.eq.-2)then
              67     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      h
                                   <<< Loop-information  End >>>
              68     2  pp                    do 130 m = 1, mlistnum
              69     2   p                     mf=mlist(m)

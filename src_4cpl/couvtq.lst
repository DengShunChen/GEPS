 External subroutine subprogram "couvtq"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine couvtq ( nxj,mn,kk,ktpbl,dt,wktri,xkm,hgt,uu,beta &
               2                                              ,dhgt,ro2)
               3                     !
               4                     !####################################################################
               5                     !
               6                     ! 1. function description
               7                     !
               8                     !     prepare tri-diagonal matrix for backward time scheme of
               9                     !     the diffusion equation: du/dt = d(xkm*(du/dz))/dz
              10                     !
              11                     ! 2. common block specification
              12                     !
              13                     ! 3. parameter specification
              14                     !
              15                     !     mn   : number of tri-diagonal matrix (horizontal dimension)      i
              16                     !     kk   : vertical dimension                                        i
              17                     !     ktpbl: starting lveles to consider vertical mixing effects       i
              18                     !     dt   : time step                                                 i
              19                     !     wktri: output tri-diagonal matrix coef. + forcing      (mn,kk,4) o
              20                     !     xkm  : input eddy mixing coefficient at even levels    (mn,kk)   i
              21                     !     hgt  : input height at odd levels                      (mn,kk)   i
              22                     !     uu   : variable to be updated by backward time scheme  (mn,kk)   i
              23                     !     beta : parameter to control time scheme ;                        i
              24                     !            1.0 -> backward, 1/2. -> crank-nicholson, 0. -> forward.
              25                     !
              26                     ! 4. local variable
              27                     !
              28                     ! 5. calling modules
              29                     !
              30                     !    mixpbl
              31                     !
              32                     ! 6. usage
              33                     !
              34                     !    call couvtq (mn,kk,ktpbl,dt,wktri,xkm,hgt,uu,beta)
              35                     !
              36                     ! 7. modules called
              37                     !
              38                     ! 8. limitation
              39                     !
              40                     ! 9. date
              41                     !
              42                     !    created    nov. 1991
              43                     !    modified   nov. 1991
              44                     !    remodified mar. 1992
              45                     !
              46                     ! 10. author
              47                     !       c.-s. liou/ f.-j. wang,
              48                     !       modify to f90 by C-H Lee and sort by River Chen in 2015
              49                     !
              50                     !#####################################################################
              51                     !
              52                           use const, only: RTYPE
              53                     !
              54                           implicit  none
              55                     
              56                           integer   nxj,mn,kk,ktpbl,kt,kt1,k,i,ik,iksm,iks,iksp
              57                           real      alpha,beta,dt,xx,yy,zz
              58                     
              59                           real      wktri(mn,kk,4),xkm(mn,kk),hgt(mn,kk)
              60                           real      dhgt(mn,kk),ro2(mn,kk)
              61                           real(kind=RTYPE) uu(mn,kk)
              62                     !
              63                           alpha = 1.0 - beta
              64                           kt = kk - ktpbl + 1
              65                           kt1 = kt - 1
              66                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hgt, dhgt, xkm, uu, ro2, wktri
                                   <<< Loop-information  End >>>
              67     1                     do 120 k = 1, kt1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 164
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.51, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uu, xkm, ro2, hgt, dhgt, wktri
                                   <<< Loop-information  End >>>
              68     2  pp    v            do 120 i = 1, nxj
              69     2   p    v            ik = (k-1)*mn + i
              70     2   p    v            iksm =(ktpbl-2)*mn + ik
              71     2   p    v            iks  =(ktpbl-1)*mn + ik
              72     2   p    v            iksp = ktpbl   *mn + ik
              73     2   p    v            xx = -dt*xkm(iksm,1)*ro2(iksm,1)/( dhgt(iks,1) *      &
              74     2                                                (hgt(iksm,1)-hgt(iks,1)) )
              75     2   p    v            yy = -dt*xkm(iks,1)*ro2(iks,1)/( dhgt(iks,1)*         &
              76     2                                              (hgt(iks,1)-hgt(iksp,1)) )
              77     2   p    v            wktri(ik,1,1) = beta * xx
              78     2   p    v            wktri(ik,1,3) = beta * yy
              79     2   p    v            wktri(ik,1,2) = 1.0 - wktri(ik,1,1) - wktri(ik,1,3)
              80     2   p    v            wktri(ik,1,4) = uu(iks,1)   * ( 1.0 + alpha*(xx+yy) ) &
              81     2                                  - uu(iksm,1) * alpha * xx                &
              82     2                                  - uu(iksp,1) * alpha * yy
              83     1   p    v        120 continue
              84                     !
              85                     !     fix upper b.c. (move -uu(ktpbl-1)*wktri(1,1) to forcing term)
              86                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 191
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 87,93)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.21, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uu, wktri, hgt, dhgt, ro2, xkm
                                   <<< Loop-information  End >>>
              87     1  pp    v            do 200 i = 1, nxj
              88     1   p    v            wktri(i,1,4) = wktri(i,1,4) - uu(i,ktpbl-1)*wktri(i,1,1)
              89     1   p    v        200 continue
              90                     !
              91                     !     fix lower b.c.
              92                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
              93     1                     do 220 i = 1, nxj
              94     1                     zz = - dt*xkm(i,kk-1)*ro2(i,kk-1)/( dhgt(i,kk) *       &
              95     1                                                 (hgt(i,kk-1)-hgt(i,kk)) )
              96     1                     wktri(i,kt,1) = beta * zz
              97     1                     wktri(i,kt,3) = 0.0
              98     1                     wktri(i,kt,2) = 1.0 - wktri(i,kt,1) - wktri(i,kt,3)
              99     1                     wktri(i,kt,4) = uu(i,kk)   * ( 1.0 + alpha*zz )        &
             100     1                                   - uu(i,kk-1) * alpha * zz
             101     1                 220 continue
             102                     !
             103                           return
             104                           end


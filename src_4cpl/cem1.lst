 External subroutine subprogram "cem1"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine cem1 ( nn,nx,lev,lt,cp,r,g,pcon,ccritl,etop,kcbase   &
               2                                           , cadj,htop,hbase, hswo,ho,qo,qswo,hswe,qswe    &
               3                                           , gamqo,gamqe,dzlc,dzl2c,e,exist,hc,qc,cu,rain  &
               4                                           , zl,zl2 )
               5                     !
               6                     !***********************************************************************
               7                     !
               8                     !    1.   function description
               9                     !           cloud ensemble model for a-s scheme
              10                     !           normalized cloud mass flux is linear function of height
              11                     !
              12                     !    2.   common block specification
              13                     !            none
              14                     !
              15                     !    3.   parameter specification
              16                     !     input :
              17                     !       nn        :   no. of potential convective points in x-direction
              18                     !       nx        :   dimension of horizontal direction
              19                     !       lev       :   position index in the latitudinal direction
              20                     !       cp        :   heat specific constant of the air (=1004.)
              21                     !       r         :   gas constant (287.0)
              22                     !       g         :   gravity (9.806)
              23                     !       cadj      :   logical flag for water budget calculations
              24                     !       kcbase(nx):   cloud base index
              25                     !       htop(nx)  :   moist static energy on cloud top
              26                     !       hbase(nx) :   moist static energy on cloud base
              27                     !       ho (nx,lev):   moist static energy on model level
              28                     !       hswo(nx,lev):  saturation moist static energy on model level
              29                     !       hswe(nx,lev):  saturation moist static energy on even level
              30                     !       qo (nx,lev):   temperature on model level
              31                     !       qswo(nx,lev):  saturation mixing ratio on model level
              32                     !       qswe(nx,lev):  saturation mixing ratio on even level
              33                     !       gamqo(nx,lev)
              34                     !       gamqe(nx,lev)
              35                     !       dzlc(nx,lev))
              36                     !       dzl2c(nx,lev)
              37                     !     output:
              38                     !       e(nx,lev) : mass flux normalized with cloud base mass flux
              39                     !       hc(nx,lev): moist static energy for cloud
              40                     !       qc(nx,lev): mixing ratio for cloud
              41                     !       cu(nx,lev): cloud liquid water
              42                     !       rain(nx,lev): rain water
              43                     !     working array
              44                     !
              45                     !    4.  calling modules
              46                     !            cup92
              47                     !
              48                     !    5.  usage
              49                     !         call cem1 (nn,nx,lev,lt,cp,r,g,pcon,ccritl,etop,kcbase,cadj
              50                     !         1         ,htop,hbase,hswo,ho,qo,qswo,hswe,qswe,gamqo,gamqe
              51                     !         2         , dzlc,dzl2c,e,exist,hc,qc,cu,rain )
              52                     !
              53                     !    6.  modules called
              54                     !            none
              55                     !
              56                     !    7.  date
              57                     !          created    1992           by      c-s chen  ( cwb  )
              58                     !          modify to f90 by C-H Lee and sort by River Chen in 2015
              59                     !
              60                     !***********************************************************************
              61                     !
              62                           use paramt
              63                     
              64                           implicit  none
              65                     
              66                           integer   nn,nx,lev,lt,i,l,lk,kklb
              67                     
              68                     !     input array
              69                           integer   kcbase(nx)
              70                           real      hbase(nx),htop(nx,lev),ho(nx,lev),                  &
              71                                     dzlc(nx,lev),dzl2c(nx,lev),qo(nx,lev),qswo(nx,lev), &
              72                                     qswe(nx,lev),hswe(nx,lev),hswo(nx,lev),             &
              73                                     gamqo(nx,lev),gamqe(nx,lev)
              74                           logical   exist(nx),cadj
              75                     
              76                     !     output array
              77                           real      e(nx,lev),hc(nx,lev),qc(nx,lev),cu(nx,lev),rain(nx,lev)
              78                     !
              79                     !  local work arrays
              80                     !
              81                           real      alamda(im),addtop(im)
              82                           real      alammax(im,lm),zl(im,lm),zl2(im,lm)
              83                           real      etop,ccritl,pcon,g,r,cp,qctem,totliq
              84                     !
              85                     ! subroutine cem1  calculates the thermaodynamic profile of
              86                     !  an updraft sub-ensemble according to a given lamda
              87                     !
              88                     ! all the properties of updrafts are definded at even levels except
              89                     !   at the cloud tops where they are defined at odd levels
              90                     ! mixing and its related processes take place at odd levels
              91                     ! level indices for all properties of cumulus clouds are added by 1
              92                     !   the cloud base level is identified with level index (lb+1)
              93                     !   the cloud top levels are identified with level indices lt's
              94                     ! ice phase is not considered in this version
              95                     !
              96                     !
              97                     !     constant
              98                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 99,104)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      exist, dzlc, zl, htop, ho, kcbase
                                   <<<      addtop, alamda, alammax
                                   <<< Loop-information  End >>>
              99     1  pp    v            do i=1,nn
             100     1   p    v              kklb=kcbase(i)
             101     1   p    v              alammax(i,lt) = 5.0/(zl(i,lt) - zl2(i,kklb))
             102     1   p    v            enddo
             103                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             104     1                     do 50 i = 1,nn
             105     2                     if (exist(i)) then
             106     2                     addtop(i)= etop*(htop(i,lt)-ho(i,lt))
             107     2                     alamda(i)= dzlc(i,lt)*(htop(i,lt)-ho(i,lt)+addtop(i))
             108     2                     endif
             109     1                  50 continue
             110                     !
             111     1                     if(lt.lt.lev-1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      exist, kcbase, htop, ho, addtop, dzl2c
                                   <<<      alamda
                                   <<< Loop-information  End >>>
             112     2                     do 60 l=lt+1,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.00, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dzl2c, alamda, htop, ho, kcbase, exist
                                   <<<      addtop
                                   <<< Loop-information  End >>>
             113     3  pp    v            do 60 i=1,nn
             114     4   p    v            if (exist(i).and.l.le.kcbase(i)) then
             115     4   p    v            alamda(i) = alamda(i) + dzl2c(i,l)*(htop(i,lt)-ho(i,l) &
             116     4                                                       +addtop(i))
             117     4   p    v            endif
             118     2   p    v        60  continue
             119     1                     endif
             120                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 308
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.65, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      alamda, alammax, exist, dzlc, hbase
                                   <<<      htop, addtop
                                   <<< Loop-information  End >>>
             121     1  pp    v            do 70 i=1,nn
             122     2   p    v            if (exist(i)) then
             123     2   p    v            alamda(i) = (hbase(i) - htop(i,lt))/alamda(i)
             124     2   p    v            exist(i)= exist(i).and.alamda(i).ge.0.0
             125     2   p    v            exist(i)= exist(i).and.alamda(i).lt.alammax(i,lt)
             126     2   p    v            addtop(i)= dzlc(i,lt)
             127     2   p    v            endif
             128     1   p    v        70  continue
             129                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      exist, kcbase, dzl2c, e, ho, hc, alamda
                                   <<<      addtop
                                   <<< Loop-information  End >>>
             130     1                     do 110 lk= lev,lt+1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 239
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.86, ITR: 40, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      addtop, e, kcbase, hc, dzl2c, ho, alamda
                                   <<<      exist
                                   <<< Loop-information  End >>>
             131     2  pp    v            do 110 i = 1,nn
             132     3   p    v            if (exist(i).and.lk.le.kcbase(i))  then
             133     3   p    v            e(i,lk-1) = e(i,lk)+alamda(i)*dzl2c(i,lk)
             134     3   p    v            hc(i,lk-1)=(e(i,lk)*hc(i,lk)+alamda(i)*ho(i,lk)*dzl2c(i,lk)) &
             135     3                               / e(i,lk-1)
             136     3   p    v            addtop(i)= addtop(i)+dzl2c(i,lk)
             137     3   p    v            else if (lk.le.kcbase(i)) then
             138     3   p    v            e(i,lk-1) = 0.0
             139     3   p    v            hc(i,lk-1)= 0.0
             140     3   p    v            endif
             141     1   p    v       110  continue
             142                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 291
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hc, exist, ho, addtop, dzlc, alamda, e
                                   <<< Loop-information  End >>>
             143     1  pp    v            do 120 i=1,nn
             144     2   p    v            if (exist(i))  then
             145     2   p    v            e(i,lt-1) = e(i,lt) +alamda(i)*(dzlc(i,lt)+etop*addtop(i))
             146     2   p    v            hc(i,lt-1)=(e(i,lt)*hc(i,lt)+(e(i,lt-1)-e(i,lt))*ho(i,lt)) &
             147     2                               / e(i,lt-1)
             148     2   p    v            else
             149     2   p    v            e(i,lt-1) = 0.0
             150     2   p    v            hc(i,lt-1)= 0.0
             151     2   p    v            endif
             152     1   p    v        120 continue
             153                     !
             154                     !  return if water budgets not need (cem1 calls with adjusted soundings)
             155                     !
             156                           if (cadj)  return
             157                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      exist, kcbase, qo, e, qc, dzl2c, hc
                                   <<<      hswe, qswe, alamda, gamqe, cu, rain
                                   <<< Loop-information  End >>>
             158     1                     do 100 lk= lev,lt+1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 178
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.94, ITR: 48, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cu, qc, rain, kcbase, qo, alamda, e
                                   <<<      dzl2c, hswe, hc, qswe, gamqe, exist
                                   <<< Loop-information  End >>>
             159     2  pp    v            do 100 i=1,nn
             160     3   p    v            if (exist(i).and.lk.le.kcbase(i))  then
             161     3   p    v            qctem= qswe(i,lk-1)+(hc(i,lk-1)-hswe(i,lk-1))*gamqe(i,lk-1)
             162     3               !
             163     3   p    v            qc(i,lk-1)=(e(i,lk)*qc(i,lk)+alamda(i)*qo(i,lk) &
             164     3                              *dzl2c(i,lk))/e(i,lk-1)
             165     3   p    v            totliq= qc(i,lk-1)-qctem
             166     3               !
             167     4   p    v            if (totliq .ge. ccritl)  then
             168     4               !
             169     4   p    v            cu(i,lk-1) = (totliq+ccritl*dzl2c(i,lk)) &
             170     4                                 /(1.+pcon*dzl2c(i,lk))
             171     4   p    v            rain(i,lk)=totliq-cu(i,lk-1)
             172     4   p    v            qc(i,lk-1)= qctem+cu(i,lk-1)
             173     4               !
             174     4   p    v            else
             175     4               !
             176     4   p    v              rain(i,lk) = 0.0
             177     4   p    v              cu(i,lk-1)= 0.0
             178     4   p    v            endif
             179     3               !
             180     3   p    v            endif
             181     1   p    v       100  continue
             182                     !
             183                     !-----cloud top
             184                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e, qc, dzlc, dzl2c, qo, hswo, hc, qswo
                                   <<<      gamqo, exist, rain, cu
                                   <<< Loop-information  End >>>
             185     1  pp    v            do 500 i=1,nn
             186     2   p    v            if (exist(i))  then
             187     2   p    v            qctem= qswo(i,lt)+(hc(i,lt-1)-hswo(i,lt))*gamqo(i,lt)
             188     2               !
             189     2   p    v            qc(i,lt-1) =(e(i,lt)*qc(i,lt)+(e(i,lt-1)-e(i,lt))*qo(i,lt)) &
             190     2                               /e(i,lt-1)
             191     2   p    v            totliq= qc(i,lt-1)-qctem
             192     2               !
             193     3   p    v            if (totliq .ge. ccritl)  then
             194     3               !
             195     3   p    v            cu(i,lt-1) = (totliq+ccritl*dzl2c(i,lt)) &
             196     3                                 /(1.+pcon*dzlc(i,lt))
             197     3   p    v            rain(i,lt)=totliq-cu(i,lt-1)
             198     3   p    v            qc(i,lt-1)= qctem+cu(i,lt-1)
             199     3               !
             200     3   p    v            else
             201     3               !
             202     3   p    v              rain(i,lt) = 0.0
             203     3   p    v              cu(i,lt-1)= 0.0
             204     3   p    v            endif
             205     2               !
             206     2   p    v            endif
             207     1   p    v       500  continue
             208                           return
             209                           end


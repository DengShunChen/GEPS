               1                           subroutine pmatrx_hybrid_cwb ( cp,tmean,ptop,ptmean,spalm,phatk  &
               2                                             , sigma,ai,dcdp )
               3                     !
               4                     !  pmatrx computes the contributions to the semi-implicit operators
               5                     !  that are a result of the differences of the actual terrain pressure
               6                     !  and pbl depth from the reference values of these parameters
               7                     !
               8                     !  ***input***
               9                     !
              10                     !  cp: specific heat of air
              11                     !  tmean: reference temperature profile for linearized atmosphere
              12                     !  ptop: pressure at model top
              13                     !  ptmean:  reference terrain pressure for linearized atmosphere
              14                     !  spalm:  linearized energy conversion term for reference atmosphere
              15                     !  phatk: even level exner function
              16                     !  sig: sigma coordinates
              17                     !  ai: inverse of bi-linear vertical differencing operator array
              18                     !
              19                     !  ***output***
              20                     !
              21                     !  dcdp: matrix operator for vertical differencing of energy term
              22                     !
              23                     ! *********************************************************************
              24                     !
              25                           use param
              26                           use const, only : RTYPE
              27                     !
              28                           implicit  none
              29                     
              30                     !      real      sigma(lev+1,2),tmean(lev),a(lev,lev),b(lev,lev),ai(lev,lev),&
              31                           real      dcdp(lev)
              32                           real(kind=RTYPE) sigma(lev+1,2),tmean(lev),a(lev,lev),b(lev,lev),&
              33                                            ai(lev,lev),spalm(lev),phatk(lev)
              34                     !
              35                           integer   i,j,k
              36                           real      ptop,cp
              37                           real(kind=RTYPE) ptmean,capa,ps,spamin,tem,tem1,tem2,tem3,phat
              38                     
              39                           capa= 2.0/7.0
              40                           ps= ptmean+ptop
              41                           call zilch(b,lev*lev)
              42                           spamin= 0.000001
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 217
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.40, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      spalm, tmean, sigma, phatk
                                   <<< Loop-information  End >>>
              43     1  pp    v            do 3 k=1,lev-1
              44     1   p    v            tem2= max(spalm(k+1),spamin)
              45     1   p    v            tem3= max(spalm(k),spamin)
              46     1   p    v            phat= sigma(k+1,1)*ptmean+sigma(k+1,2)+ptop
              47     1   p    v            tem= capa*sigma(k+1,1)/phat
              48     1               !      phat= sig(k+1)*ptmean+ptop
              49     1               !      tem= capa*sig(k+1)/phat
              50     1   p    v            tem= tem*phatk(k)
              51     1   p    v            tem1= tem*tmean(k+1)/tem2
              52     1   p    v            tem= tem*tmean(k)/tem3
              53     1   p    v            b(k,k)= cp*spalm(k)*(1.0-tem)
              54     1   p    v            b(k,k+1)= cp*spalm(k+1)*(tem1-1.0)
              55     1   p    v          3 continue
              56                           tem= capa*tmean(lev)/(ps*spalm(lev))
              57                           tem= tem*phatk(lev)
              58                           b(lev,lev)= cp*spalm(lev)*(tem-1.0)
              59                           call mtxmlp(ai,b,a,lev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dcdp
                                   <<< Loop-information  End >>>
              60     1  pp   4v            do 5 i=1,lev
              61     1   p   4v            dcdp(i)= 0.0
              62     1   p   4v          5 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, dcdp
                                   <<< Loop-information  End >>>
              63     1                     do 6 j=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, dcdp
                                   <<< Loop-information  End >>>
              64     2  pp   2v            do 6 i=1,lev
              65     1   p   2v          6 dcdp(i)= dcdp(i)+a(i,j)
              66                           return
              67                           end


                                   <<< Loop-information  End >>>
             331     1  pp   2v            do i=1,im
             332     1   p   2v              kbm(i)   = km
             333     1   p   2v              kmax(i)  = km
             334     1   p   2v              tx1(i)   = 1.0 / ps(i)

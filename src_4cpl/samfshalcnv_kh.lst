                                   <<< Loop-information  End >>>
             391     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kmax, prsl, pfld, eta, frh, hcko
                                   <<<      qcko, qrcko, ucko, vcko, dbyo, pwo
                                   <<<      dellal, t1, to
                                   <<<    PREFETCH(SOFT) : 20
                                   <<<     SEQUENTIAL : 20
                                   <<<      q1: 2, qo: 2, u1: 2, v1: 2, uo: 2, vo: 2
                                   <<<      wu2: 2, buo: 2, drag: 2, cnvwt: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             392     2   p    v              do i = 1, im
             393     3   p    v                if (cnvflg(i) .and. k <= kmax(i)) then
             394     3   p    v                  pfld(i,k) = prsl(i,k) * 10.0
             395     3   p    v                  eta(i,k)  = 1.
             396     3   p    v                  frh(i,k)  = 0.
             397     3   p    v                  hcko(i,k) = 0.
             398     3   p    v                  qcko(i,k) = 0.
             399     3   p    v                  qrcko(i,k)= 0.
             400     3   p    v                  ucko(i,k) = 0.
             401     3   p    v                  vcko(i,k) = 0.
             402     3   p    v                  dbyo(i,k) = 0.
             403     3   p    v                  pwo(i,k)  = 0.
             404     3   p    v                  dellal(i,k) = 0.
             405     3   p    v                  to(i,k)   = t1(i,k)
             406     3   p    v                  qo(i,k)   = q1(i,k)
             407     3   p    v                  uo(i,k)   = u1(i,k)
             408     3   p    v                  vo(i,k)   = v1(i,k)
             409     3               !           uo(i,k)   = u1(i,k) * rcs(i)
             410     3               !           vo(i,k)   = v1(i,k) * rcs(i)
             411     3   p    v                  wu2(i,k)  = 0.
             412     3   p    v                  buo(i,k)  = 0.

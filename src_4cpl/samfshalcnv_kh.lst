             265     1   p    v            enddo
             266                           if(totflg) return
             267                     !!
             268                     !>  - determine aerosol-aware rain conversion parameter over land
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

             418                     !>  - Calculate saturation specific humidity and enforce minimum moisture values.
             419     1                     do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             420     2   s    s              do i=1,im
             421     3   p    v                if (cnvflg(i) .and. k <= kmax(i)) then
             422     3   m    m                  qeso(i,k) = 0.01 * fpvs(to(i,k))      ! fpvs is in pa
             423     3               !byl            call qsatq_cwb(1,to(i,k),pfld(i,k),qeso(i,k))
             424     3   p    v                  qeso(i,k) = eps * qeso(i,k) / (pfld(i,k) + epsm1*qeso(i,k))
             425     3   p    v                  val1      =             1.e-8
             426     3   p    v                  qeso(i,k) = max(qeso(i,k), val1)
             427     3   p    v                  val2      =           1.e-10
             428     3   p    v                  qo(i,k)   = max(qo(i,k), val2 )
             429     3               !           qo(i,k)   = min(qo(i,k),qeso(i,k))
             430     3               !           tvo(i,k)  = to(i,k) + delta * to(i,k) * qo(i,k)
             431     3   p    v                endif
             432     2   p    m              enddo
             433     1                     enddo
             434                     !
             435                     !  compute moist static energy
             436                     !
             437                     !>  - Calculate moist static energy (heo) and saturation moist static energy (heso).
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kmax, phil, to, qo, qeso, heo

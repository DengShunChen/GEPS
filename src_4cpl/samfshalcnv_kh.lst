             279     2  pp    v              do i = 1, im
             280     3   p    v                if(t1(i,k) > 273.16) then
             281     3   p    v                  c0t(i,k) = c0(i)
             282     3   p                     else
             283     3   p    v                  tem = d0 * (t1(i,k) - 273.16)
             284     3   p    v                  tem1 = exp(tem)
             285     3   p    v                  c0t(i,k) = c0(i) * tem1
             286     3   p    v                endif
             287     2   p    v              enddo
             288     1                     enddo

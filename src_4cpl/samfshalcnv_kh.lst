             438     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.15, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phil, to, kmax, cnvflg, qo, heo, qeso
                                   <<<      heso
                                   <<< Loop-information  End >>>
             439     2   p    v              do i=1,im
             440     3   p    v                if (cnvflg(i) .and. k <= kmax(i)) then
             441     3               !           tem       = g * zo(i,k) + cp * to(i,k)
             442     3   p    v                  tem       = phil(i,k) + cp * to(i,k)
             443     3   p    v                  heo(i,k)  = tem  + hvap * qo(i,k)
             444     3   p    v                  heso(i,k) = tem  + hvap * qeso(i,k)
             445     3               !           heo(i,k)  = min(heo(i,k),heso(i,k))
             446     3   p    v                endif
             447     2   p    v              enddo
             448     1   p                 enddo
             449                     !
             450                     !  determine level with largest moist static energy within pbl
             451                     !  this is the level where updraft starts
             452                     !
             453                     !> ## Perform calculations related to the updraft of the entraining/detraining cloud model ("static control").
             454                     !> - Search in the PBL for the level of maximum moist static energy to start the ascending parcel.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.77, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      heo, hmax, kb, cnvflg
                                   <<< Loop-information  End >>>
             455     1  pp   2v            do i=1,im
             456     2   p   2v               if (cnvflg(i)) then
             457     2   p   2v                  hmax(i) = heo(i,1)
             458     2   p   2v                  kb(i) = 1
             459     2   p   2v               endif
             460     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kpbl, heo, hmax, kb
                                   <<< Loop-information  End >>>
             461     1                     do k = 2, km
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      heo, hmax, kpbl, cnvflg, kb
                                   <<< Loop-information  End >>>
             462     2  pp    v              do i=1,im
             463     3   p    v                if (cnvflg(i) .and. k <= kpbl(i)) then
             464     4   p    v                  if(heo(i,k) > hmax(i)) then
             465     4   p    v                    kb(i)   = k
             466     4   p    v                    hmax(i) = heo(i,k)
             467     4   p    v                  endif
             468     3   p    v                endif
             469     2   p    v              enddo
             470     1                     enddo
             471                     !
             472                     !> - Calculate the temperature, water vapor mixing ratio, and pressure at interface levels.
             473     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             474     2   s    s              do i=1,im
             475     3   p    v                if (cnvflg(i) .and. k <= kmax(i)-1) then
             476     3   p    v                  dz      = .5 * (zo(i,k+1) - zo(i,k))
             477     3   p    v                  dp      = .5 * (pfld(i,k+1) - pfld(i,k))
             478     3   s    s                  es      = 0.01 * fpvs(to(i,k+1))      ! fpvs is in pa
             479     3               !byl            call qsatq_cwb(1,to(i,k+1),pfld(i,k+1),es)
             480     3   s    s                  pprime  = pfld(i,k+1) + epsm1 * es
             481     3   s    s                  qs      = eps * es / pprime
             482     3   s    s                  dqsdp   = - qs / pprime
             483     3   s    s                  desdt   = es * (fact1 / to(i,k+1) + fact2 / (to(i,k+1)**2))
             484     3   p    v                  dqsdt   = qs * pfld(i,k+1) * desdt / (es * pprime)
             485     3   m    m                  gamma   = el2orc * qeso(i,k+1) / (to(i,k+1)**2)
             486     3   m    m                  dt      = (g * dz + hvap * dqsdp * dp) / (cp * (1. + gamma))
             487     3   p    v                  dq      = dqsdt * dt + dqsdp * dp
             488     3   s    s                  to(i,k) = to(i,k+1) + dt
             489     3   p    v                  qo(i,k) = qo(i,k+1) + dq
             490     3   p    v                  po(i,k) = .5 * (pfld(i,k) + pfld(i,k+1))
             491     3   p    v                endif
             492     2   p    m              enddo

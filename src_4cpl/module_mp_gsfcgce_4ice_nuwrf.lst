            3998     2               
            3999     3   s    s                 if (tair(i) .lt. t0) then
            4000     3   m    m                    rtair(i)=1./(tair(i)-c76)
            4001     3   s    s                    y2(i)=exp(c218-c580*rtair(i))
            4002     3   s    s                    qsi(i)=rp0(i)*y2(i)
            4003     3   s    s                    esi(i)=c610*y2(i)
            4004     3   s    s                    ftns(i)=1.
            4005     3   s    s                    ftng(i)=1.
            4006     3   s    s                    ftnh(i)=1.
            4007     3               
            4008     3   s    s                    SSI(i)=(QV(i)+QB0)/QSI(i)-1.
            4009     3   s    s                      IF(SSI(i).GT.0.) DLT1(i)=1.
            4010     3   s    s                      IF(SSI(i).LE.0.) DLT1(i)=0.
            4011     3   m    m                    DM(i)=QV(i)+QB0-QSI(i)
            4012     3   s    s                    RSUB1(i)=cs580(i)*QSI(i)*RTAIR(i)*RTAIR(i)
            4013     3   s    s                    DD1(i)=DM(i)/(1.+RSUB1(i))
            4014     3   s    s                    Y3(i)=1./TAIR(i)
            4015     3               ! JDC water vapor diffusivity correction
            4016     3   s    s                   term1   = y3(i)*(rn20a*y3(i)-rn20b)
            4017     3   s    s                   term2   = rn10c*tair(i)/esi(i)
            4018     3   s    s                   dd(i) = term1+term2
            4019     3   s    s                   fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            4020     3   s    s                    TAIRC(i)=TAIR(i)-T0
            4021     3               !
            4022     3   s    s                  ftns(i)=1.
            4023     3   s    s                  ftng(i)=1.
            4024     3   s    s                  ftnh(i)=1.
            4025     3   s    s                  ftns0(i)=1.
            4026     3   s    s                  ftng0(i)=1.

            3534     2   p    v               dhacr(i)=min((1.-del)*whacr(i),dhacr(i))
            3535     2   p    s               if(del.eq.1) dhacw(i)=dhacw(i)+del*whacr(i)      !fix from JDC
            3536     2   m    m                y1(i)=(piacr(i)+dgacr(i)+dhacr(i)+psacr(i)+pgfr(i) &
            3537     2                                +phfr(i))*d2t
            3538     2   s    s                qr(i)=qr(i)+pr(i)+qracs(i)-del*whacr(i)*d2t+qracg(i) !fix SEL
            3539     2   m    m                qr(i)=qr(i)-y1(i)                                          !fix SEL
            3540     3   s    s                if (qr(i) .lt. 0.0) then
            3541     3   s    s                   y2(i)=1.

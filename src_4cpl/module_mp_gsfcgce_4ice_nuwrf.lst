                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             469     4   p    v                DO ic=1,min(CHUNK,ite-ii+1)
             470     4   p    v                  i = ii+ic -1
             471     4   p    v                  th2d(ic,k) = th(i,k,j)

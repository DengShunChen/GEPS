            2793     2   p    v               y1(i)=c149*tair(i)**1.5/(tair(i)+120.)
            2794     2   p    v               dwv(i)=dwvp(i)*tair(i)**1.81
            2795     2   p    v               tca(i)=c141*y1(i)

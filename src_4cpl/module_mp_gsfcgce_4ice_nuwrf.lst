            1218     5   p    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
            1219     5   p    v                  qiz=qiz+del_tv*flux
            1220     5   p    v                  qiz=amax1(0.,qiz)
            1221     5   p    v                  qi(i,k,j)=qiz
            1222     5   p    s                  fluxin=fluxout
            1223     5   p    v                  ised(k)=ised(k)+fluxin
            1224     5   p    v               enddo
            1225     5   p                    if (min_q .eq. 1) then
            1226     5   p                       pptice=pptice+fluxin*del_tv
            1227     5   p                    else
            1228     5   p                       qiz=qi(i,min_q-1,j)
            1229     5   p                       qiz=qiz+del_tv*  &
            1230     5                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
            1231     5   p                       qiz=amax1(0.,qiz)         !Di 10/23/2012
            1232     5   p                       qi(i,min_q-1,j)=qiz
            1233     5   p                    endif
            1234     4               !
            1235     4   p                 else
            1236     4   p                    notlast=.false.
            1237     4   p                 endif
            1238     3               !

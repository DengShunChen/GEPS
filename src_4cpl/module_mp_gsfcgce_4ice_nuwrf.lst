             337                       REAL, DIMENSION(CHUNK) :: xland1d
             338                       REAL, DIMENSION(CHUNK, kms:kme):: refl_10cm2d
             339                     #if ( WRF_CHEM == 1)
             340                       REAL, DIMENSION(CHUNK, kms:kme, num_go):: aero3d
             341                       REAL, DIMENSION(CHUNK, kms:kme):: icn_diag2d, nc_diag2d
             342                     #endif
             343                     
             344                     !-----------------------------------------------------------------------
             345                     !WRF radar reflectivity initialization only need to run once
             346                     
             347                           INTEGER:: NCALL=0
             348                     
             349                     !-----------------------------------------------------------------------
             350                     
             351                     
             352                     ! itaobraun: 0 for Tao's constantis, 1 for Braun's constants
             353                     !c        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
             354                     !c        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
             355                        itaobraun = 0
             356                     
             357                     ! Use Steve's new improvement   9/18/2009
             358                     
             359                         improve = 8
             360                     
             361                     !c  new_ice_sat = 0, 1, 2, or 3
             362                         new_ice_sat = 9
             363                     
             364                     !c istatmin
             365                         istatmin = 180
             366                     
             367                     !c id = 0  without in-line staticstics
             368                     !c id = 1  with in-line staticstics
             369                         id = 0
             370                     
             371                     !c ibud = 0 no calculation of dth, dqv, dqrest and dqall
             372                     !c ibud = 1 yes
             373                         ibud = 0
             374                     
             375                     !c  set up constants used internally in GCE
             376                     
             377                        call consat_s ( itaobraun)
             378                     
             379                     ! calculte fallflux and precipiation in MKS system
             380                     
             381                        call fall_flux(    dt_in,ql, qr, qi, qs, qg, qh, p,        &
             382                                           rho, th, pii, z, dz8w, ht, rainnc,      &
             383                                           rainncv, grav,itimestep,                &
             384                                           preci3d, precs3d, precg3d, prech3d, precr3d,     &
             385                                           snownc, snowncv, sr,                    &
             386                                           graupelnc, graupelncv,                  &
             387                                           hailnc, hailncv,                        &
             388                                           vgc, vgc2,vhc,bhq,                      &
             389                                           improve,                                &
             390                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             391                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             392                     !-----------------------------------------------------------------------
             393                           ! EMK NUWRF...Moved this WRF radar reflectivity initialization to after
             394                           ! fall_flux, as the rhohail and rhograul variables are set in that
             395                           ! subroutine.
             396                     
             397     1                     IF (NCALL .EQ. 0) THEN
             398     1               !..Set these variables needed for computing radar reflectivity.  These
             399     1               !.. get used within radar_init to create other variables used in the
             400     1               !.. radar module.
             401     1                        xam_r = 3.14159*rhowater/6.
             402     1                        xbm_r = 3.
             403     1                        xmu_r = 0.
             404     1                        xam_s = 3.14159*rhosnow/6.
             405     1                        xbm_s = 3.
             406     1                        xmu_s = 0.
             407     1                        xam_g = 3.14159*rhograul/6.
             408     1                        xbm_g = 3.
             409     1                        xmu_g = 0.
             410     1               
             411     1                        call radar_init
             412     1                        NCALL = 1
             413     1                     ENDIF
             414                     !+---+-----------------------------------------------------------------+
             415                     
             416                     !c Negative values correction
             417                     
             418                     !   iskip = 1
             419                     !
             420                     !   if (iskip.eq.0) then
             421                     !      call negcor(qv,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             422                     !                           itimestep,1,             &
             423                     !                           its,ite,jts,jte,kts,kte)
             424                     !      call negcor(ql,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             425                     !                           itimestep,2,             &
             426                     !                           its,ite,jts,jte,kts,kte)
             427                     !      call negcor(qr,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             428                     !                           itimestep,3,             &
             429                     !                           its,ite,jts,jte,kts,kte)
             430                     !      call negcor(qi,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             431                     !                           itimestep,4,             &
             432                     !                           its,ite,jts,jte,kts,kte)
             433                     !      call negcor(qs,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             434                     !                           itimestep,5,             &
             435                     !                           its,ite,jts,jte,kts,kte)
             436                     !      call negcor(qg,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             437                     !                           itimestep,6,             &
             438                     !                           its,ite,jts,jte,kts,kte)
             439                     !!   else if (mod(itimestep,i24h).eq.1) then
             440                     !!      print *,'no neg correction in mp at timestep=',itimestep
             441                     !   endif ! iskip
             442                     
             443                     !c microphysics in GCE
             444                     
             445                     !$OMP PARALLEL DO &
             446                     !$OMP PRIVATE ( ic, j, ii, i, k ) &
             447                     !$OMP PRIVATE ( th2d, qv2d, ql2d, qr2d ) &
             448                     !$OMP PRIVATE ( qi2d, qs2d, qg2d, qh2d ) &
             449                     !$OMP PRIVATE ( rho2d, pii2d, p2d, w2d ) &
             450                     !$OMP PRIVATE ( refc2d, refr2d, refi2d, refs2d, refg2d, refh2d ) &
             451                     !$OMP PRIVATE ( physc2d, physe2d, physd2d, physs2d, physm2d, physf2d ) &
             452                     !$OMP PRIVATE ( acphysc2d, acphyse2d, acphysd2d, acphyss2d, acphysm2d, acphysf2d ) &
             453                     !$OMP PRIVATE ( xland1d, refl_10cm2d ) &
             454                     #if ( WRF_CHEM == 1)
             455                     !$OMP PRIVATE ( aero3d, icn_diag2d, nc_diag2d) &
             456                     #endif
             457                     !$OMP SCHEDULE(dynamic,1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xland, (unknown)
                                   <<< Loop-information  End >>>
             458     1   p                 DO ip = 1,((1+(ite-its+1)/CHUNK)*CHUNK)*(jte-jts+1),CHUNK ! i-dim contains '(1+(ite-its+1)/CHUNK)' blocks of size 'CHUNK'
             459     1   p                  j  = jts+(ip-1)/((1+(ite-its+1)/CHUNK)*CHUNK)
             460     2   p                  IF ( j .ge. jts .and. j .le. jte ) THEN ! j: [jts, jte]
             461     2   p                   ii = its+mod((ip-1),((1+(ite-its+1)/CHUNK)*CHUNK)) ! ii: [its, ((1+(ite-its+1)/CHUNK)*CHUNK)]
             462     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

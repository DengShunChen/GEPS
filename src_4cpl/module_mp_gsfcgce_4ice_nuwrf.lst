            1044     5   p                    endif
            1045     4               
            1046     4               ! use small delta t to calculate the qgz flux
            1047     4               ! termi is the qgz flux pass in the grid box through the upper boundary
            1048     4               ! termo is the qgz flux pass out the grid box through the lower boundary
            1049     4               !
            1050     4   p                    fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            1051     5   p    s               do k=max_q,min_q,-1
            1052     5   p    v                  fluxout=rhoz(k)*vtg(k)*qgz(k)
            1053     5   p    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
            1054     5   p    v                  qgz(k)=qgz(k)+del_tv*flux

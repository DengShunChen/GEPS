            3477     2                                 +y4(i)/zs(i)**3+y5(i)/zs(i))*ftns(i)*fros(i))       !improve4
            3478     2   s    s              if(qs(i).le.cmin) pracs(i)=0.
            3479     2   p    m              if(qr(i).le.cmin) pracs(i)=0.
            3480     2   m    m             qracs(i)=r2ig*r2is*min(d2t*pracs(i), qs(i))
            3481     2   m    v             psacr(i)=r2is*(r8rf(i)*y1(i)*(y3(i)/zr(i)**5 &
            3482     2                                 +y4(i)/zr(i)**3+y5(i)/zr(i))*ftns(i))
            3483     2   s    s              if(qs(i).le.cmin) psacr(i)=0.
            3484     2   p    m              if(qr(i).le.cmin) psacr(i)=0.
            3485     2   p    v             qsacr(i)=psacr(i)
            3486     2               
            3487     3   s    s               if (tair(i) .ge. t0) then
            3488     3   s    s                pracs(i)=0.0
            3489     3   p    s                psacr(i)=0.0
            3490     3   s    s               else
            3491     3   s    s                qsacr(i)=0.0
            3492     3   p    v                qracs(i)=0.0
            3493     3   p    v               endif
            3494     2               
            3495     2               !* 18 * pgfr : freezing of qr to qg                               **18**
            3496     2   p    v                pgaut(i)=0.0
            3497     2   s    s                pgfr(i)=0.0
            3498     2   s    s                phfr(i)=0.0
            3499     3   s    s             if (tair(i) .lt. t0) then
            3500     3   s    s                  y1(i)=exp(rn18a*(t0-tair(i)))
            3501     4   s    s                if( qr(i).ge.0.)then
            3502     4   s    s                 temp = 1./zr(i)
            3503     4   s    s                 temp = temp*temp*temp*temp*temp*temp*temp
            3504     4   m    s                 phfr(i)=r2ih*max(r18r(i)*(y1(i)-1.)*temp, 0.0)
            3505     4               !           phfr(i)=r2ih*max(r18r(i)*(y1(i)-1.)/zr(i)**7., 0.0)
            3506     4   s    s                else
            3507     4   s    s                 temp = 1./zr(i)
            3508     4   s    s                 temp = temp*temp*temp*temp*temp*temp*temp
            3509     4   s    s                 pgfr(i)=r2ig*max(r18r(i)*(y1(i)-1.)*temp, 0.0)
            3510     4               !           pgfr(i)=r2ig*max(r18r(i)*(y1(i)-1.)/zr(i)**7., 0.0)
            3511     4   s    s                 if(qr(i).le.cmin) pgfr(i)=0.
            3512     4   p    s                endif
            3513     3   p    v             endif

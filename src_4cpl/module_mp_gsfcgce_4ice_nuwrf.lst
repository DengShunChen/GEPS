            2178                     !
            2179                     !      COMPUTE ICE PHASE MICROPHYSICS AND SATURATION PROCESSES
            2180                     !
            2181                     
            2182                     !cc   using scott braun's way for pint, pidep computations
            2183                       INTEGER, INTENT(IN   ) :: itaobraun, improve, new_ice_sat
            2184                       integer, intent(in)  ::   id
            2185                       integer, intent(in)  ::   itimestep,istatmin

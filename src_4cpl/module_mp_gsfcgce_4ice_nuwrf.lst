                                   <<<     SEQUENTIAL : 140
                                   <<<      dlt1: 2, qhwrf: 2, qgwrf: 2, dpt: 2
                                   <<<      dqv: 2, qcl: 2, qrn: 2, qci: 2, qcs: 2
                                   <<<      qcg: 2, qch: 2, physe: 2, physc: 2
                                   <<<      physd: 2, physs: 2, physf: 2, physm: 2
                                   <<<      acphysc: 2, acphyse: 2, acphysd: 2
                                   <<<      acphyss: 2, acphysf: 2, acphysm: 2

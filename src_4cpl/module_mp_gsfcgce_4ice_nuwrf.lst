            4802                           REAL, DIMENSION(kts:kte):: rr, rs, rg
            4803                     
            4804                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilams, ilamg
            4805                           DOUBLE PRECISION, DIMENSION(kts:kte):: N0_r, N0_s, N0_g
            4806                           DOUBLE PRECISION:: lamr, lams, lamg
            4807                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            4808                     
            4809                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            4810                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            4811                     
            4812                           INTEGER:: i, k, k_0, kbot, n
            4813                           LOGICAL:: melti
            4814                     
            4815                           DOUBLE PRECISION:: cback, x, eta, f_d
            4816                           REAL, PARAMETER:: R=287.
            4817                           REAL, PARAMETER:: PIx=3.1415926536
            4818                     
            4819                     !+---+
            4820                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            4821     1  pp   4v            do k = kts, kte
            4822     1   p   4v               dBZ(k) = -35.0
            4823     1   p   4v            enddo
            4824                     
            4825                     !+---+-----------------------------------------------------------------+
            4826                     !..Put column of data into local arrays.
            4827                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 14
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, p1d, t1d, pres, N0_g
                                   <<<      L_qg, N0_s, L_qs, N0_r, L_qr, qv1d, qv
                                   <<<      rho, ilamr
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      rr: 2, ilams: 2, rs: 2, rg: 2, ilamg: 2
                                   <<<      temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 1  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4828     1  pp    v            do k = kts, kte
            4829     1   p    v               temp(k) = t1d(k)
            4830     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            4831     1   p    v               pres(k) = p1d(k)
            4832     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            4833     1               
            4834     2   p    v               if (qr1d(k) .gt. 1.E-9) then
            4835     2   p    v                  rr(k) = qr1d(k)*rho(k)
            4836     2   p    v                  N0_r(k) = xnor
            4837     2   p    v                  lamr = (xam_r*xcrg(3)*N0_r(k)/rr(k))**(1./xcre(1))
            4838     2   p    v                  ilamr(k) = 1./lamr
            4839     2   p    v                  L_qr(k) = .true.
            4840     2   p    v               else
            4841     2   p    v                  rr(k) = 1.E-12
            4842     2   p    v                  L_qr(k) = .false.
            4843     2   p    v               endif
            4844     1               
            4845     2   p    v               if (qs1d(k) .gt. 1.E-9) then
            4846     2   p    v                  rs(k) = qs1d(k)*rho(k)
            4847     2   p    v                  N0_s(k) = xnos
            4848     2   p    v                  lams = (xam_s*xcsg(3)*N0_s(k)/rs(k))**(1./xcse(1))
            4849     2   p    v                  ilams(k) = 1./lams
            4850     2   p    v                  L_qs(k) = .true.
            4851     2   p    v               else
            4852     2   p    v                  rs(k) = 1.E-12
            4853     2   p    v                  L_qs(k) = .false.
            4854     2   p    v               endif
            4855     1               
            4856     2   p    v               if (qg1d(k) .gt. 1.E-9) then
            4857     2   p    v                  rg(k) = qg1d(k)*rho(k)
            4858     2   p    v                     N0_g(k) = xnog
            4859     2   p    v                  lamg = (xam_g*xcgg(3)*N0_g(k)/rg(k))**(1./xcge(1))
            4860     2   p    v                  ilamg(k) = 1./lamg
            4861     2   p    v                  L_qg(k) = .true.
            4862     2   p    v               else
            4863     2   p    v                  rg(k) = 1.E-12
            4864     2   p    v                  L_qg(k) = .false.
            4865     2   p    v               endif
            4866     1   p    v            enddo
            4867                     
            4868                     !+---+-----------------------------------------------------------------+
            4869                     !..Locate K-level of start of melting (k_0 is level above).
            4870                     !+---+-----------------------------------------------------------------+
            4871                           melti = .false.
            4872                           k_0 = kts
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp
                                   <<< Loop-information  End >>>
            4873     1                     do k = kte-1, kts, -1
            4874     2                        if ( (temp(k).gt.273.15) .and. L_qr(k)                         &
            4875     2                                                 .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            4876     2                           k_0 = MAX(k+1, k_0)
            4877     2                           melti=.true.
            4878     2                           goto 195
            4879     2                        endif
            4880     1                     enddo
            4881                      195  continue
            4882                     
            4883                     !+---+-----------------------------------------------------------------+
            4884                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            4885                     !.. and non-water-coated snow and graupel when below freezing are
            4886                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            4887                     !+---+-----------------------------------------------------------------+
            4888                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, ilams, L_qr, N0_s
                                   <<<      ilamr, N0_r
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 4
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4889     1  pp    v            do k = kts, kte
            4890     1   p    v               ze_rain(k) = 1.e-22
            4891     1   p    v               ze_snow(k) = 1.e-22
            4892     1   p    v               ze_graupel(k) = 1.e-22
            4893     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*xcrg(4)*ilamr(k)**xcre(4)
            4894     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PIx)*(6.0/PIx)     &
            4895     1                                                * (xam_s/900.0)*(xam_s/900.0)          &
            4896     1                                                * N0_s(k)*xcsg(4)*ilams(k)**xcse(4)
            4897     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PIx)*(6.0/PIx)  &
            4898     1                                                   * (xam_g/900.0)*(xam_g/900.0)       &
            4899     1                                                   * N0_g(k)*xcgg(4)*ilamg(k)**xcge(4)
            4900     1   p    v            enddo
            4901                     
            4902                     
            4903                     !+---+-----------------------------------------------------------------+
            4904                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            4905                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            4906                     !.. extremely simple based on amount found above the melting level.
            4907                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            4908                     !.. routines).
            4909                     !+---+-----------------------------------------------------------------+
            4910                     
            4911     1                     if (melti .and. k_0.ge.kts+1) then
            4912     2                      do k = k_0-1, kts, -1
            4913     2               
            4914     2               !..Reflectivity contributed by melting snow
            4915     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            4916     3                          fmelt_s = MAX(0.005d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            4917     3                          eta = 0.d0
            4918     3                          lams = 1./ilams(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<< Loop-information  End >>>
            4919     4                          do n = 1, nrbins
            4920     4                             x = xam_s * xxDs(n)**xbm_s
            4921     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocms),DBLE(xobms), &
            4922     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            4923     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            4924     4                                   inclusionstring_s, hoststring_s,                    &
            4925     4                                   hostmatrixstring_s, hostinclusionstring_s)
            4926     4                             f_d = N0_s(k)*xxDs(n)**xmu_s * DEXP(-lams*xxDs(n))
            4927     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            4928     4                          enddo
            4929     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4930     3                         endif
            4931     2               
            4932     2               !..Reflectivity contributed by melting graupel
            4933     2               
            4934     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            4935     3                          fmelt_g = MAX(0.005d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            4936     3                          eta = 0.d0
            4937     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, simpson, xdtg
                                   <<< Loop-information  End >>>
            4938     4                          do n = 1, nrbins
            4939     4                             x = xam_g * xxDg(n)**xbm_g
            4940     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocmg),DBLE(xobmg), &
            4941     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            4942     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            4943     4                                   inclusionstring_g, hoststring_g,                    &
            4944     4                                   hostmatrixstring_g, hostinclusionstring_g)
            4945     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            4946     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            4947     4                          enddo
            4948     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4949     3                         endif
            4950     2               
            4951     2                      enddo
            4952     1                     endif
            4953                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            4954     1  pp    v            do k = kte, kts, -1
            4955     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            4956     1   p    v            enddo
            4957                     
            4958                           end subroutine refl10cm_gsfc

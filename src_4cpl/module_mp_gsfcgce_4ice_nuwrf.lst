            1138     5   p                    else
            1139     5   p                       qhz(min_q-1)=qhz(min_q-1)+del_tv*  &
            1140     5                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
            1141     5   p                       qhz(min_q-1)=amax1(0.,qhz(min_q-1))         !Di 10/23/2012
            1142     5   p                       qh(i,min_q-1,j)=qhz(min_q-1)
            1143     5   p                    endif
            1144     4               !
            1145     4   p                 else
            1146     4   p                    notlast=.false.
            1147     4   p                 endif
            1148     3               !
            1149     3   p               ENDDO
            1150     2               
            1151     2               !
            1152     2               !-- cloud ice  (03/21/02) follow Vaughan T.J. Phillips at GFDL
            1153     2               !
            1154     2               
            1155     2   p               t_del_tv=0.
            1156     2   p               del_tv=dtb
            1157     2   p               notlast=.true.
            1158     2               !
            1159     3   p               DO while (notlast)
            1160     3               !
            1161     3   p                 min_q=kte
            1162     3   p                 max_q=kts-1
            1163     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)

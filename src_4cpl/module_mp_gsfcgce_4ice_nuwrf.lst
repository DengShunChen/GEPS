            3812     2   s    s              DO i=1,irestrict
            3813     2               
            3814     2               !      STEVE: PLEASE CHECK
            3815     2   p    v             y1(i)=pihom(i)+pidw(i)+pimm(i)+pcfr(i)-pimlt(i)
            3816     2               
            3817     3   p    v               if (y1(i).gt.qc(i)) then
            3818     3   p    v                  y1(i)=qc(i)
            3819     3   p    v                  y2(i)=1.
            3820     3   p    v                  y3(i)=pihom(i)+pidw(i)+pimm(i)+pcfr(i)
            3821     3   p    v                  if(y3(i).ne.0.) y2(i)=(qc(i)+pimlt(i))/y3(i)
            3822     3   p    v                  pihom(i)=pihom(i)*y2(i)
            3823     3   p    v                  pidw(i)=pidw(i)*y2(i)
            3824     3   p    v                  pimm(i)=pimm(i)*y2(i)
            3825     3   p    v                  pcfr(i)=pcfr(i)*y2(i)
            3826     3   p    v               endif  !y1
            3827     2               
            3828     2   p    v               pt(i)=pt(i)+afcp(i)*y1(i)
            3829     2   p    v               tair(i)=(pt(i)+tb0)*pi0(i)
            3830     2   p    v               qc(i)=qc(i)-y1(i)
            3831     2   p    v               qi(i)=qi(i)+y1(i)
            3832     2               
            3833     2               !* 31 * pint  : initiation of qi                                  **31**
            3834     2               !* 32 * pidep : deposition of qi                                  **32**
            3835     2               !
            3836     2               !     CALCULATION OF PINT USES DIFFERENT VALUES OF THE INTERCEPT AND SLOPE FOR
            3837     2               !     THE FLETCHER EQUATION. ALSO, ONLY INITIATE MORE ICE IF THE NEW NUMBER
            3838     2               !     CONCENTRATION EXCEEDS THAT ALREADY PRESENT.
            3839     2               
            3840     2   s    s               tair(i)=(pt(i)+tb0)*pi0(i)
            3841     3   s    s               if (tair(i) .lt. t0) then
            3842     3   s    s                  if (qi(i) .le. cmin) qi(i)=0.
            3843     3   s    s                  tairc(i)=tair(i)-t0
            3844     3   s    s                  rtair(i)=1./(tair(i)-c76)
            3845     3   s    s                  y2(i)=exp(c218-c580*rtair(i))
            3846     3   s    s                  qsi(i)=rp0(i)*y2(i)
            3847     3   s    s                  esi(i)=c610*y2(i)
            3848     3   s    s                  ssi(i)=(qv(i)+qb0)/qsi(i)-1.
            3849     3   s    s                  y1(i)=1./tair(i)
            3850     3   s    s                  y3(i)=SQRT(qi(i))
            3851     3               ! JDC water vapor diffusivity correction term
            3852     3   s    s                  term1   = y1(i)*(rn20a*y1(i)-rn20b)
            3853     3   s    s                  term2   = rn10c*tair(i)/esi(i)
            3854     3   s    s                  dd(i) = term1+term2
            3855     3   s    s                  fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            3856     3               
            3857     3   s    s                  dm(i)=max(qv(i)+qb0-qsi(i),0.0)
            3858     3   s    s                  rsub1(i)=cs580(i)*qsi(i)*rtair(i)*rtair(i)
            3859     3   s    s                  dep(i)=dm(i)/(1.+rsub1(i))
            3860     4   s    s                  if (tairc(i).le.-5.) then
            3861     4   s    s                      y4(i)=1./(tair(i)-c358)
            3862     4   s    s                      qsw(i)=rp0(i)*exp(c172-c409*y4(i))
            3863     4   s    s                      fssi=min(xssi,max(rssi,xssi*(tairc(i)+44.)/(44.-38.)))
            3864     4   s    s                      fssi=rssi
            3865     4   s    s                      wssi=ww1(i,k)/100.-2.0
            3866     4   s    s                      if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3867     4   s    s                      fssi=min(ssi(i),fssi)
            3868     4               !               r_nci=min(1.e-3*exp(-.639+12.96*fssi),1.)
            3869     4   s    s                      r_nci=max(1.e-3*exp(-.639+12.96*fssi),0.528e-3)
            3870     4   m    m             	        if (r_nci.gt.15.) r_nci=15.
            3871     4               
            3872     4               ! Cooper curve
            3873     5   s    s                      if( tairc(i) .lt. -40.0 ) then
            3874     5   m    m                        c_nci = 5.0e-6*exp(0.304*40.0)
            3875     5   s    s                      else
            3876     5   m    s                        c_nci = 5.0e-6*exp(0.304*abs(tairc(i)))
            3877     5   s    s                      end if
            3878     4   s    s                      r_nci = c_nci
            3879     4               ! JDC cap r_nci to the amount corresponding to crystal size of ami50
            3880     4   s    s                      r_nci = max(r_nci,r00(i)*qi(i)/ami50)
            3881     4               
            3882     4               #if (WRF_CHEM == 1)
            3883     4                               ! EMK...Only execute if GOCART and coupling is on
            3884     4                               if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            3885     4                                     chem_opt == 302 .or. chem_opt == 303) .and. &
            3886     4                                     (gsfcgce_gocart_coupling == 1) ) then
            3887     4                                  !JJS 20110602 vvvvv
            3888     4                                  ! Conversion rate of cloud water to ice in the Bergeron porcess based on Meyer + DeMott formulae
            3889     4                                  !
            3890     4                                  ! convert gocart aerosol mass conc to IN
            3891     4                                  !      p0 need to be converted from g*cm/s2/cm2 to mb (hPa)
            3892     4                                  !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out)
            3893     4                                  !                icn_cgs(i,k) = max(min_icn, icn_out) * 1.e-3   !IN conc [#/cm3] <-- [#/Litter]
            3894     4                                  !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out,i,k)
            3895     4                                  !                icn_out = min(1.e3, max(0.01e0 ,  icn_out) )
            3896     4                                  !                icn_cgs(i,k) = icn_out * 1.e-3 !IN conc [#/cm3]
            3897     4                                  !                r_nci = icn_cgs(i,k)  !DeMotto's formuale
            3898     4                                  r_nci = icn_out(i) * 1.e-3  !DeMotto's formuale
            3899     4                                  !JJS 20110602 ^^^^^
            3900     4                               end if
            3901     4               #endif
            3902     4               
            3903     4   s    s                      pidep(i)=max(R32RT(i)*1.e4*fssi*sqrt(r_nci)*y3(i)/     & !meyers
            3904     4                               dd(i)*fdwv, -qi(i))                    !fix SEL
            3905     4   s    s                      if(qi(i).le.cmin) pidep(i)=0.
            3906     4   s    s                      dd(i)=max(1.e-9*r_nci/r00(i)-qci(i,k)*1.e-9/ami50, 0.)
            3907     4   s    s                      pint(i)=max(min(dd(i),dm(i)),0.)
            3908     4   s    s                      pint(i)=min(pint(i)+pidep(i), dep(i))
            3909     4   s    s                      pt(i)=pt(i)+ascp(i)*pint(i)
            3910     4   s    s                      tair(i)=(pt(i)+tb0)*pi0(i)
            3911     4   s    s                      qv(i)=qv(i)-pint(i)
            3912     4   s    s                      qi(i)=qi(i)+pint(i)
            3913     4   p    v                  endif  !taric
            3914     3   p    v                endif  !tair
            3915     2               
            3916     2               ! End of Process 31 & 32
            3917     2               
            3918     2               ! WRF satice has new_ice_sat option 0, 1 and 2
            3919     2               ! Steve's satice has new_ice_sat option 0, 1, 2, 3 and 9
            3920     2               ! option 0, 1 and 2 are identical in both satice
            3921     2               ! I added option 3 below and wrapped them with "if (improve.eq.3)"
            3922     2               
            3923     2               !*****   TAO ET AL (1989) SATURATION TECHNIQUE  ***********************
            3924     2               
            3925     2               !!!!
            3926     2               !!!   new_ice_sat option 9 from  Steve's satice
            3927     2               !!!   sequential, non-iterative, ssi
            3928     2               !!!!
            3929     2               
            3930     2   m    m               dep(i)=0.0
            3931     2   s    s               cnd(i)=0.0
            3932     2   s    s               tair(i)=(pt(i)+tb0)*pi0(i)
            3933     3   s    s               if (tair(i).ge.t00) THEN
            3934     3   s    s                  y1(i)=1./(tair(i)-c358)
            3935     3   s    s                  qsw(i)=rp0(i)*exp(c172-c409*y1(i))
            3936     3   s    s                  dd(i)=cp409(i)*y1(i)*y1(i)
            3937     3   s    s                  dm(i)=qv(i)+qb0-qsw(i)
            3938     3   s    s                  cnd(i)=dm(i)/(1.+avcp(i)*dd(i)*qsw(i))
            3939     3               !c    ******   condensation or evaporation of qc  ******
            3940     3   s    s                  cnd(i)=max(-qc(i),cnd(i))
            3941     3               
            3942     3               ! JJS 20150831
            3943     3               !            if(ww1(i,k).ge.-10.)  &     ! for 1-km grid
            3944     3               ! thresh_evap is a function of dx and defined in the beginning of the subroutine
            3945     3               
            3946     3   s    s                  if(ww1(i,k) .ge. thresh_evap)  cnd(i)=max(0.,cnd(i)) !reduce spurious evap
            3947     3               
            3948     3   s    s                  pt(i)=pt(i)+avcp(i)*cnd(i)
            3949     3   s    s                  tair(i)=(pt(i)+tb0)*pi0(i)
            3950     3   s    s                  qv(i)=qv(i)-cnd(i)
            3951     3   s    s                  qc(i)=qc(i)+cnd(i)
            3952     3   p    v               endif
            3953     3   s    s               if (tair(i).le.273.16) THEN
            3954     3               !c    ******   deposition or sublimation of qi    ******
            3955     3   s    s                  y1(i)=1./(tair(i)-c358)
            3956     3   s    s                  qsw(i)=rp0(i)*exp(c172-c409*y1(i))
            3957     3   s    s                  y2(i)=1./(tair(i)-c76)
            3958     3   s    s                  qsi(i)=rp0(i)*exp(c218-c580*y2(i))
            3959     3   s    s                  fssi=min(xssi,max(rssi,xssi*(tair(i)-t0+44.0)/(44.0-38.0)))
            3960     3   s    s                  fssi=rssi
            3961     3   s    s                  wssi=ww1(i,k)/100.-2.0
            3962     3   s    s                  if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3963     3   s    s                  y3(i)=1.+min((qsw(i)-qsi(i))/qsi(i), fssi)
            3964     3   s    s                  y4(i)=qsi(i)*y3(i)
            3965     4   s    m                  if (tair(i).le.268.16.and.(qv(i)+qb0.gt.y4(i))) then
            3966     4   s    s                     dd1(i)=cp580(i)*y2(i)*y2(i)
            3967     4   m    m                     dep(i)=(qv(i)+qb0-y4(i))/(1.+ascp(i)*dd1(i)*y4(i))
            3968     4   s    s                  else if (qv(i)+qb0.lt.xsubi*qsi(i).and.qi(i).gt.cmin) then
            3969     4   s    s                     dd1(i)=cp580(i)*y2(i)*y2(i)
            3970     4   s    s                     dep(i)=(qv(i)+qb0-xsubi*qsi(i))/(1.+ascp(i)*dd1(i)*xsubi*qsi(i))
            3971     4   m    s                     dep(i)=max(-qi(i),dep(i))
            3972     4   s    s                  endif
            3973     3   s    s                  if(ww1(i,k).ge.0.)  &
            3974     3                             dep(i)=max(0.,dep(i))                                !reduce spurious sublimation
            3975     3   s    s                  pt(i)=pt(i)+ascp(i)*dep(i)
            3976     3   s    s                  tair(i)=(pt(i)+tb0)*pi0(i)
            3977     3   s    s                  qv(i)=qv(i)-dep(i)
            3978     3   s    s                  qi(i)=qi(i)+dep(i)
            3979     3   p    v               endif
            3980     2               
            3981     2               !* 10 * PSDEP : DEPOSITION OR SUBLIMATION OF QS                   **10**

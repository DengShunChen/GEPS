            3554     2   m    m                if (tair(i) .ge. t0) dlt2(i)=0.
            3555     2   m    m                y1(i)=qs(i)/d2t
            3556     2   s    s                pgacs(i)=min(y1(i), pgacs(i))
            3557     2   s    s                dgacs(i)=min(y1(i), dgacs(i))
            3558     2   s    s                wgacs(i)=min(y1(i), wgacs(i))
            3559     2   s    s                whacs(i)=min(y1(i), whacs(i))
            3560     2   s    s                pracs(i)=min(y1(i), pracs(i))
            3561     2   s    s                pwacs(i)=min(y1(i), pwacs(i))
            3562     2               

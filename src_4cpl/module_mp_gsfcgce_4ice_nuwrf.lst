                                   <<< Loop-information  End >>>
            1164     4   p    s            do k=kts,kte-1
            1165     4   p    s               qiz=qi(i,k,j)
            1166     4   p    s               vti(k)=0.
            1167     5   p    s               if (qiz .gt. cmin) then
            1168     5   p    v                  min_q=min0(min_q,k)
            1169     5   p    v                  max_q=max0(max_q,k)
            1170     5               
            1171     5               ! new codes from Steve's in cgs.
            1172     5   p    s               vti(k)=0.
            1173     5   p    s               y1=rhoz(k) * 1000. * qiz    ! y1 in g/m**3
            1174     6   p    s               if (y1 .ge. 1.e-6) then
            1175     6   p    s                  y1=qiz
            1176     6   p    s                  y2=qcz(k)
            1177     6   p    s                   tair=thz(k)*piz(k)
            1178     6   p    s                   tairc=tair-t0
            1179     6   p    s                   call vqrqi(2,r00(k),fv(k),y1,y2,tair,vti(k))      ! Di
            1180     6   p    s                endif  !y1
            1181     5   p    s                   vti(k)=vti(k) * 0.01                       ! convert back to MKS
            1182     5               
            1183     5               ! EMK: prevent divsion by zero and underflow value
            1184     6   p    s                if (vti(k) .gt. 1.e-20) then
            1185     7   p    s                  if (k .eq. 1) then
            1186     7   p    m                     del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vti(k))
            1187     7   p    v                  else
            1188     7   p    m                     del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vti(k))
            1189     7   p    v                  endif
            1190     6   p    v                endif
            1191     5               !         else
            1192     5               !            vti(k)=0.
            1193     5   p    v               endif
            1194     4   p    v            enddo
            1195     3               
            1196     4   p                 if (max_q .ge. min_q) then
            1197     4               !
            1198     4               !
            1199     4               !- Check if the summation of the small delta t >=  big delta t

            3145     2   p    v               wgacs(i)=0.0
            3146     2   p    v               wgacs(i)=10.*r9rf(i)*y2(i)*ftns(i)*ftng(i)*fros(i)         !4ice revised
            3147     2               !        if(r00(i)*qg(i).gt.qrog2)then                                      !4ice revised
            3148     2               !         wgacs(i)=10.*r9rf(i)*y2(i)*ftns(i)*ftng(i)*fros(i)        !4ice revised
            3149     2               !        endif                                                             !4ice revised
            3150     2   p    v               if(qg(i).le.cmin) wgacs(i)=0.                !4ice revised2
            3151     2   p    v               if(qs(i).le.cmin) wgacs(i)=0.                !4ice revised2
            3152     2               
            3153     2   p    v              dhacs(i)=0.0
            3154     2   p    v              whacs(i)=0.0
            3155     2   p    v              y1(i)=abs( vh(i)-vs(i) )
            3156     2   p    v              y2(i)=zs(i)*zh(i)

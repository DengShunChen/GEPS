            1066     5   p                       qg(i,min_q-1,j)=qgz(min_q-1)
            1067     5   p                    endif
            1068     4               !
            1069     4   p                 else
            1070     4   p                    notlast=.false.
            1071     4   p                 endif
            1072     3               !
            1073     3   p               ENDDO
            1074     2               !
            1075     2               !--- hail
            1076     2               !
            1077     2               
            1078     2   p               t_del_tv=0.
            1079     2   p               del_tv=dtb
            1080     2   p               notlast=.true.
            1081     2               !
            1082     3   p               DO while (notlast)
            1083     3               !
            1084     3   p                 min_q=kte
            1085     3   p                 max_q=kts-1
            1086     3               
                                   <<< Loop-information Start >>>

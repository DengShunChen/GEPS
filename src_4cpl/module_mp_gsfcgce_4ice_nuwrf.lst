            4033     3   s    s                  call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            4034     3   s    s                  call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            4035     3   s    s                  call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            4036     3   s    s                  call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))
            4037     3               
            4038     3   m    m                  ftns(i)=ftns0(i)
            4039     3   m    m                  ftng(i)=ftng0(i)
            4040     3   m    m                  ftnh(i)=ftnh0(i)
            4041     3               
            4042     3   s    s                  Y4(i)=r10t*SSI(i)*(r101r(i)/ZS(i)**2+r102rf(i)/ZS(i)**BSH5)   &
            4043     3                                               /DD(i)*ftns(i)*fdwv
            4044     3   s    s                  PSDEP(i)=r2is*max(-QS(i), Y4(i))
            4045     3   s    s                  if(qs(i).le.cmin) psdep(i)=0.
            4046     3   s    s                  DD(i)=Y3(i)*(RN20A*Y3(i)-RN20B)+RN10C*TAIR(i)/ESI(i)
            4047     3   s    s                  Y2(i)=r191r(i)/ZG(i)**2+r192rf(i)/ZG(i)**BGH5
            4048     3   s    s                  if(r00(i)*qg(i).gt.qrog2) &
            4049     3                             y2(i)=(r191r(i)/zg(i)**2+r192rf2(i)/zg(i)**bgh5_2)
            4050     3   s    s                    PGDEP(i)=r2ig*MAX(-qg(i), R20T*SSI(i)*Y2(i)/DD(i)          &
            4051     3                                                    *ftng(i)*fdwv)
            4052     3   s    s                  if(qg(i).le.cmin) pgdep(i)=0.
            4053     3   s    s                 Y1(i)=h10ar(i)/(TCA(i)*TAIR(i)**2)+1./(DWV(i)*QSI(i))
            4054     3   s    s                 Y2(i)=.78/ZH(i)**2+h20bq(i)*SCV(i)/ZH(i)**BHH5
            4055     3   s    s                 PHDEP(i)=r2ih*MAX(-qh(i), h20t(i)*ftnh(i)*SSI(i)*Y2(i)/Y1(i))
            4056     3   s    s                      if(qh(i).le.cmin) phdep(i)=0.
            4057     3   s    s                PSSUB(i)=min(PSDEP(i), 0.)
            4058     3   s    s                PSDEP(i)=max(PSDEP(i), 0.)
            4059     3   s    s                PGSUB(i)=min(PGDEP(i), 0.)
            4060     3   s    s                PGDEP(i)=max(PGDEP(i), 0.)
            4061     3   s    s                PHSUB(i)=min(PHDEP(i), 0.)
            4062     3   s    s                PHDEP(i)=max(PHDEP(i), 0.)
            4063     3               
            4064     3               !      ******************************************************************
            4065     3   s    s                    Y5(i)=min(0.,DD1(i))
            4066     3   s    s                    DD1(i)=max(0.,DD1(i))
            4067     3               
            4068     4   s    s               IF(DLT1(i).EQ.1.)THEN                              !Di
            4069     4   s    s                 Y1(i)=PSDEP(i)+PGDEP(i)+PHDEP(i)
            4070     5   s    s                 IF(Y1(i).ge.DD1(i))THEN
            4071     5   s    s                  PSDEP(i)=PSDEP(i)/Y1(i)*DD1(i)            !...
            4072     5   s    s                  PGDEP(i)=PGDEP(i)/Y1(i)*DD1(i)
            4073     5   s    s                  PHDEP(i)=PHDEP(i)/Y1(i)*DD1(i)
            4074     5   p    v                 ENDIF
            4075     4   s    s               ENDIF                                                !Di
            4076     3               
            4077     4   s    s               if(qc(i).le.1.e-5) then
            4078     4   s    s                vap_frac=2.0*min((tairc(i)/(t00-t0))**2,1.0)
            4079     4   s    s                pvapg(i)=vap_frac*pgdep(i)
            4080     4   s    s                pvaph(i)=vap_frac*phdep(i)
            4081     4   s    s               endif
            4082     3   s    s               if(pgdep(i).gt.0.)          &
            4083     3                          pvapg(i)=min(pvapg(i),qg(i)+pgdep(i))
            4084     3   s    s               if(phdep(i).gt.0.)          &
            4085     3                          pvaph(i)=min(pvaph(i),qh(i)+phdep(i))
            4086     3               
            4087     3               
            4088     4   s    s               IF(DLT1(i).EQ.0.)THEN
            4089     4   s    s                 Y1(i)=MAX(PSsub(i)+PGsub(i)+phsub(i), Y5(i))
            4090     5   s    s                 IF(Y5(i).gt.(PSsub(i)+PGsub(i)+phsub(i)))THEN
            4091     5   s    s                  Y3(i)=(PSsub(i)+PGsub(i)+phsub(i))
            4092     6   s    s                  IF(Y3(i).ne.0.0)THEN
            4093     6   s    s                   PSsub(i)=PSsub(i)/Y3(i)*Y5(i)
            4094     6   s    s                   PGsub(i)=PGsub(i)/Y3(i)*Y5(i)
            4095     6   s    s                   Phsub(i)=Phsub(i)/Y3(i)*Y5(i)
            4096     6   p    v                  ENDIF
            4097     5   p    v                 ENDIF
            4098     4   s    s               ENDIF
            4099     3   s    s                PSSUB(i)=-PSSUB(i)
            4100     3   s    s                PGSUB(i)=-PGSUB(i)
            4101     3   s    s                PHSUB(i)=-PHSUB(i)
            4102     3   s    s                Y1(i)=PSDEP(i)+PGDEP(i)+PHDEP(i)  &
            4103     3                                -PSsub(i)-PGsub(i)-PHsub(i)
            4104     3               
            4105     3   s    s                 pt(i)=pt(i)+ascp(i)*y1(i)
            4106     3   p    v                 tair(i)=(pt(i)+tb0)*pi0(i)
            4107     3   s    s                 qv(i)=qv(i)-y1(i)
            4108     3   s    s                 qs(i)=qs(i)+psdep(i)-pssub(i)+pvapg(i)+pvaph(i)
            4109     3   s    s                 qg(i)=qg(i)+pgdep(i)-pgsub(i)-pvapg(i)
            4110     3   s    s                 qh(i)=qh(i)+phdep(i)-phsub(i)-pvaph(i)
            4111     3   p    v                 endif   ! if (tair(i) .lt. t0)
            4112     2               
            4113     2               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            4114     2               ! Steve did not make any improvement on this process
            4115     2   p    v                 ern(i)=0.0
            4116     3   p    v                 if (qr(i) .gt. 0.0) then
            4117     3   m    m                   tair(i)=(pt(i)+tb0)*pi0(i)
            4118     3   s    s                   rtair(i)=1./(tair(i)-c358)
            4119     3   s    s      	     y2(i)=exp( c172-c409*rtair(i) )
            4120     3   s    s      	     esw(i)=c610*y2(i)
            4121     3   s    s                   qsw(i)=rp0(i)*y2(i)
            4122     3   s    s                   ssw(i)=(qv(i)+qb0)/qsw(i)-1.
            4123     3   s    s                   dm(i)=qv(i)+qb0-qsw(i)
            4124     3   s    s                   rsub1(i)=cv409(i)*qsw(i)*rtair(i)*rtair(i)
            4125     3   s    s                   dd1(i)=max(-dm(i)/(1.+rsub1(i)),0.0)
            4126     3   s    s                   y3(i)=1./tair(i)
            4127     3               ! JDC water vapor diffusivity correction term
            4128     3   s    s                   term1   = y3(i)*(rn30a*y3(i)-rn10b)
            4129     3   s    s                   term2   = rn10c*tair(i)/esw(i)
            4130     3   s    s                   dd(i) = term1+term2
            4131     3   m    m                   fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            4132     3   p    v                   ftnw=1.
            4133     4   m    m                   if (qr(i) .gt. cmin.and.tair(i).gt.t0) then   !no need to check qc, no qc if ssw < 0
            4134     4   s    s                       bin_factor(i)=0.11*(1000.*qr(i))**(-1.27) + 0.98
            4135     4   s    s                       bin_factor(i)=min(bin_factor(i),1.30)
            4136     4   s    s                       ftnw=1./bin_factor(i)**3.35
            4137     4   s    s                       ftnwmin=r00(i)*qr(i)/draimax
            4138     4   s    s                       if(qr(i).le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            4139     4               
            4140     4   s    s                       y4(i)=r00(i)*qr(i)
            4141     4   s    s                       y1(i)=sqrt(y4(i))
            4142     4   s    s                       y2(i)=sqrt(y1(i))
            4143     4   s    s                       zr(i)=zrc/y2(i)*ftnw**0.25
            4144     4   p    v                   endif !qr
            4145     3   s    s                   y1(i)=-r23t*ssw(i)*(r231r(i)/zr(i)**2+r232rf(i)/       &
            4146     3                                                     zr(i)**3)/dd(i)*ftnw*fdwv
            4147     3   s    s                   ern(i)=min(dd1(i),qr(i),max(y1(i),0.0))
            4148     3   s    s                   pt(i)=pt(i)-avcp(i)*ern(i)
            4149     3   m    m                   tair(i)=(pt(i)+tb0)*pi0(i)
            4150     3   s    s                   tairc(i)=tair(i)-t0
            4151     3   s    s                   qv(i)=qv(i)+ern(i)
            4152     3   s    s                   qr(i)=qr(i)-ern(i)
            4153     3   p    v                endif !qr
            4154     2               
            4155     2               !!!!
            4156     2               !!  add processes 30 & 33 fpr pmltg and pmlts
            4157     2               !!
            4158     2               !!!!
            4159     2               
            4160     2               !* 30 * pmltg : evaporation of melting qg                         **30**
            4161     2               !* 33 * pmlts : evaporation of melting qs                         **33**
            4162     2               
            4163     2   m    m                pmlts(i)=0.0
            4164     2   s    s                pmltg(i)=0.0
            4165     2               
            4166     2   m    m                tair(i)=(pt(i)+tb0)*pi0(i)
            4167     2   s    s                tairc(i)=tair(i)-t0
            4168     2               
            4169     2   p    v                ftns0(i)=1.
            4170     2   p    v                ftng0(i)=1.
            4171     2               
            4172     2   m    m                qhz2=qhwrf(i,k)
            4173     2   s    s                qgz2=qgwrf(i,k)
            4174     3   m    m                if (k .lt. kte-2 .and. tairc(i) .ge. -5) then
            4175     3   s    s                  qhz2=qhwrf(i,k+1)
            4176     3   s    s                  qgz2=qgwrf(i,k+1)
            4177     3   p    v                endif
            4178     2   s    s                call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            4179     2   s    s                call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            4180     2   s    s                call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            4181     2               
            4182     3   s    s                if (tair(i) .ge. t0) then
            4183     3   s    s                   ftns(i)=1.
            4184     3   s    s                   ftng(i)=1.
            4185     3   m    m                      ftns(i)=ftns0(i)
            4186     3   m    m                      ftng(i)=ftng0(i)
            4187     3   s    s                   rtair(i)=1./(t0-c358)
            4188     3   s    s                   y2(i)=exp( c172-c409*rtair(i) )
            4189     3   s    s                   esw(i)=c610*y2(i)
            4190     3   s    s                   qsw(i)=rp0(i)*y2(i)
            4191     3   s    s                   ssw(i)=1.-(qv(i)+qb0)/qsw(i)
            4192     3   s    s                   dm(i)=qsw(i)-qv(i)-qb0
            4193     3   s    s                   rsub1(i)=cv409(i)*qsw(i)*rtair(i)*rtair(i)
            4194     3   s    s                   dd1(i)=max(dm(i)/(1.+rsub1(i)),0.0)
            4195     3   s    s                   y3(i)=1./tair(i)
            4196     3               ! JDC water vapor diffusivity correction term
            4197     3   s    s                  term1   = y3(i)*(rn30a*y3(i)-rn10b)
            4198     3   s    s                  term2   = rn10c*tair(i)/esw(i)
            4199     3   s    s                  dd(i) = term1+term2
            4200     3   s    s                  fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            4201     3   s    s                   y1(i)=ftng(i)*r30t*ssw(i)*(r191r(i)/zg(i)**2+r192rf(i)    &
            4202     3                                  /zg(i)**bgh5)/dd(i)*fdwv
            4203     3   s    s                   if(r00(i)*qg(i).gt.qrog2)                   &
            4204     3                              y1(i)=ftng(i)*r30t*ssw(i)*(r191r(i)/zg(i)**2+r192rf2(i) &
            4205     3                                     /zg(i)**bgh5_2)/dd(i)*fdwv
            4206     3   s    s                   pmltg(i)=r2ig*min(qg(i),max(y1(i),0.0))
            4207     3   s    s                   y1(i)=ftns(i)*r33t*ssw(i)*(r331r(i)/zs(i)**2+r332rf(i)    &
            4208     3                                                          /zs(i)**bsh5)/dd(i)*fdwv
            4209     3   s    s                   pmlts(i)=r2is*min(qs(i),max(y1(i),0.0))
            4210     3   s    s                   y1(i)=min(pmltg(i)+pmlts(i),dd1(i))
            4211     3   s    s                   pmltg(i)=y1(i)-pmlts(i)
            4212     3   p    v                   pt(i)=pt(i)-ascp(i)*y1(i)
            4213     3   p    v                   tair(i)=(pt(i)+tb0)*pi0(i)
            4214     3   p    v                   qv(i)=qv(i)+y1(i)
            4215     3   s    s                   qs(i)=qs(i)-pmlts(i)
            4216     3   s    s                   qg(i)=qg(i)-pmltg(i)
            4217     3   p    v                endif  !tair t0
            4218     2               ! end   Processes 30 and 33
            4219     2               
            4220     2   s    s                  if (qc(i) .le. cmin) qc(i)=0.
            4221     2   m    m                  if (qr(i) .le. cmin) qr(i)=0.
            4222     2   p    v                  if (qi(i) .le. cmin) qi(i)=0.
            4223     2   m    m                  if (qs(i) .le. cmin) qs(i)=0.
            4224     2   m    m                  if (qg(i) .le. cmin) qg(i)=0.
            4225     2   m    m                  if (qh(i) .le. cmin) qh(i)=0.
            4226     2   p    v                  dpt(i,k)=pt(i)
            4227     2   p    v                  dqv(i,k)=qv(i)
            4228     2   s    s                  qcl(i,k)=qc(i)
            4229     2   s    s                  qrn(i,k)=qr(i)
            4230     2   p    v                  qci(i,k)=qi(i)
            4231     2   s    s                  qcs(i,k)=qs(i)
            4232     2   s    s                  qcg(i,k)=qg(i)
            4233     2   s    s                  qch(i,k)=qh(i)
            4234     2               
            4235     2               !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            4236     2               !c     henry:  please take a look  (start)
            4237     2               !JJS modified by JJS on 5/1/2007  vvvvv
            4238     2               
            4239     2   s    s                  dd(i)=max(-cnd(i), 0.)
            4240     2   s    s                  cnd(i)=max(cnd(i), 0.)
            4241     2   s    s                  dd1(i)=max(-dep(i), 0.)  !bug fix by Di
            4242     2   s    s                  dep(i)=max(dep(i), 0.)
            4243     2   p    v                  del=0.
            4244     2   p    v                  IF(whacr(i) .LT. 0.) DEL=1.
            4245     2               
            4246     2               
            4247     2               !!!!!!!!!!!DDDDDDDDDDDDDD double check
            4248     2   p    v                  sccc=cnd(i)
            4249     2   s    s                  seee=dd(i)+ern(i)
            4250     2   s    s                  sddd=dep(i)+amax1(pint(i),0.0)+psdep(i)+pgdep(i)+phdep(i)
            4251     2   s    s                  ssss=dd1(i)-amin1(pint(i),0.0)+pssub(i)+pgsub(i)+phsub(i)+pmlts(i)+pmltg(i)
            4252     2   p    v                  smmm=psmlt(i)+pgmlt(i)+pimlt(i)+qracs(i)+phmlt(i)+qracg(i) &
            4253     2                                -del*whacr(i)
            4254     2   p    v                  sfff=psacw(i)*d2t+piacr(i)*d2t+psfw(i)*d2t+pgfr(i)*d2t   &
            4255     2                               +dgacw(i)*d2t+dgacr(i)*d2t+psacr(i)*d2t+pihom(i) &
            4256     2                               +pidw(i)+pimm(i)+pcfr(i)+pihms(i)*d2t    &
            4257     2                               +pihmg(i)*d2t+phfr(i)*d2t+dhacw(i)*d2t+dhacr(i)*d2t+pihmh(i)*d2t
            4258     2               
            4259     2               ! for snapsot diabatic heating rate (deg K / s)
            4260     2   m    m                  physc(i,k) = avc * sccc / d2t       !K/s
            4261     2   m    m                  physe(i,k) = avc * seee / d2t       !K/s
            4262     2   m    m                  physd(i,k) = asc * sddd / d2t       !K/s
            4263     2   m    m                  physs(i,k) = asc * ssss / d2t       !K/s
            4264     2   m    m                  physf(i,k) = afc * sfff / d2t       !K/s
            4265     2   m    m                  physm(i,k) = afc * smmm / d2t       !K/s
            4266     2               ! for accmulated diabatic heating (unit: deg K, in potential temperature)
            4267     2   p    v                  acphysc(i,k) = acphysc(i,k) + avcp(i) * sccc
            4268     2   p    v                  acphyse(i,k) = acphyse(i,k) + avcp(i) * seee
            4269     2   p    v                  acphysd(i,k) = acphysd(i,k) + ascp(i) * sddd
            4270     2   p    v                  acphyss(i,k) = acphyss(i,k) + ascp(i) * ssss
            4271     2   p    v                  acphysf(i,k) = acphysf(i,k) + afcp(i) * sfff
            4272     2   p    v                  acphysm(i,k) = acphysm(i,k) + afcp(i) * smmm
            4273     2               
            4274     2               !JJS modified by JJS on 5/1/2007  ^^^^^
            4275     2               
            4276     2               !JJS   2010/10/19  vvvvv
            4277     2               !      radar reflectivity calculation
            4278     2               
            4279     2   s    s                call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))   !Di 20160114
            4280     2   s    s                call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))   !Di 20160114
            4281     2   s    s                call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))   !Di 20160114
            4282     2   s    s                call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))   !Di 20160114
            4283     2               
            4284     2   m    m              a_1=1.e6*r00(i)*qr(i)
            4285     2   m    m              a_2=1.e6*r00(i)*qs(i)
            4286     2   s    s              a_3=1.e6*r00(i)*qg(i)
            4287     2   m    m              a_4=1.e6*r00(i)*qh(i)
            4288     2               
            4289     2   m    m              ucor=3071.29/tnw**0.75
            4290     2   m    m              ucos=687.97*roqs**0.25/tns**0.75
            4291     2   m    m              ucog=687.97*roqg**0.25/tng**0.75
            4292     2   m    m              ucog2=687.97*roqg2**.25/tng**.75
            4293     2   m    m              ucoh=687.97*roqh**0.25/tnh**0.75
            4294     2   p    v              uwet=4.464**0.95
            4295     2               
            4296     2   p    v              ftnw=1.
            4297     3   s    s              if(qr(i).gt.cmin .and. qc(i).lt.cmin)then
            4298     3   p    v                   bin_factor(i)=0.11*(1000.*qr(i))**(-1.27) + 0.98
            4299     3               !            bin_factor(i)=min(bin_factor(i),1.35)
            4300     3   p    v                   bin_factor(i)=min(bin_factor(i),1.30)
            4301     3   p    v                   ftnw=1./bin_factor(i)**3.50
            4302     3   s    s                   ftnwmin=r00(i)*qr(i)/draimax
            4303     3   s    s                   if(qr(i).le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            4304     3   p    v              endif
            4305     2   p    v              a_11=ucor*(max(0.,a_1))**1.75/ftnw**0.75
            4306     2               
            4307     2   s    s              ftns(i)=1.
            4308     2   s    s              ftng(i)=1.
            4309     2   m    m              ftns(i)=ftns0(i)**0.75
            4310     2   m    m              ftng(i)=ftng0(i)**0.75
            4311     2   m    m              ftnh(i)=ftnh0(i)**0.75  ! Di 20160114
            4312     2   s    s              fros(i)=1.
            4313     2   m    m              fros(i)=fros0(i)**.25
            4314     2   p    v              a_22=ucos*(max(0.,a_2))**1.75/ftns(i)*fros(i)
            4315     2   p    v              a_33=ucog*(max(0.,a_3))**1.75/ftng(i)
            4316     2   m    m              if(a_3.ge.qrog2) a_33=ucog2*(max(0.,a_3))**1.75/ftng(i)
            4317     2   p    v              a_44=ucoh*(max(0.,a_4))**1.75/ftnh(i) ! Di 20160114
            4318     2               
            4319     3   p    v               IF (TAIR(i).LT.273.16) THEN
            4320     3   p    v                  ZDRY = MAX(1.e-9,A_11+A_22+A_33+A_44) !rain,snow,graupel,hail,cloud ice,cloud water
            4321     3   p    v                  DBZ(i,k) = 10.*ALOG10(ZDRY)
            4322     3   p    v               ELSE
            4323     3   p    v                  ZWET0 = A_11+UWET*(A_22+A_33+A_44)**.95
            4324     3   p    v                  ZWET = MAX(1.e-9,ZWET0)
            4325     3   p    v                  DBZ(i,k) = 10.*ALOG10(ZWET)
            4326     3   p    v               ENDIF
            4327     2               
            4328     2               !JJS   2010/10/19  ^^^^^
            4329     2               
            4330     2   p    m              ENDDO
            4331     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrn, qcs, re_rain_gsfc, qcg
                                   <<<      re_snow_gsfc, qch, re_graupel_gsfc, qcl
                                   <<<      re_hail_gsfc, re_cloud_gsfc, qci
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 7  FILL 13
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4332     2   s    s              DO i=1,irestrict
            4333     2               
            4334     2               #if ( WRF_CHEM == 1)
            4335     2                     ! EMK...Nuclei only calculated when coupling
            4336     2                     if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            4337     2                           chem_opt == 302 .or. chem_opt == 303) .and. &
            4338     2                           (gsfcgce_gocart_coupling == 1) ) then
            4339     2                        icn_diag(i,k) = icn_out(i)  ! #/Litre
            4340     2                        nc_diag(i,k) = ccn_out(i)  ! #/cm3
            4341     2                     else
            4342     2                        icn_diag(i,k) = 0
            4343     2                        nc_diag(i,k) = 0
            4344     2                     end if
            4345     2               #endif
            4346     2               
            4347     2               !JJS 20140305 vvvvv  Calculate effective radius for all cloud species
            4348     2               !   eff_rad is a function of the slope parameter (Lambda)
            4349     2               
            4350     2                   ! rain
            4351     3   p    v            if (qrn(i,k) .lt. cmin) then
            4352     3   p    v               re_rain_gsfc(i,k) = 0.e0
            4353     3   p    v            else
            4354     3   pi   v               re_rain_gsfc(i,k) = eff_rad(zr(i))
            4355     3   p    v            endif
            4356     2                   ! snow
            4357     3   p    v            if (qcs(i,k) .lt. cmin) then
            4358     3   p    v               re_snow_gsfc(i,k) = 0.e0
            4359     3   p    v            else
            4360     3   pi   v               re_snow_gsfc(i,k) = eff_rad(zs(i))
            4361     3   p    v            endif
            4362     2                   ! graupel
            4363     3   p    v            if (qcg(i,k) .lt. cmin) then
            4364     3   p    v               re_graupel_gsfc(i,k) = 0.e0
            4365     3   p    v            else
            4366     3   pi   v               re_graupel_gsfc(i,k) = eff_rad(zg(i))
            4367     3   p    v            endif
            4368     2                   ! hail
            4369     3   p    v            if (qch(i,k) .lt. cmin) then
            4370     3   p    v               re_hail_gsfc(i,k) = 0.e0
            4371     3   p    v            else
            4372     3   pi   v               re_hail_gsfc(i,k) = eff_rad(zh(i))
            4373     3   p    v            endif
            4374     2               
            4375     2               ! for cloud water
            4376     2               
            4377     3   p    v         if (qcl(i,k) .lt. cmin) then
            4378     3   p    v            re_cloud_gsfc(i,k) = 0.e0
            4379     3   p    v         else
            4380     3   p    v            L_cloud = qcl(i,k) * rho(i,k)             ! cloud water [g/cm3]
            4381     3               #if (WRF_CHEM == 1)
            4382     3                  ! when running with WRF_Chem and using aerosol coupling in Goddard MP
            4383     3                          ! cpi: const_pi = 4.*atan(1.)         ~ 3.1415
            4384     3                          ! roqr: 1.0 g/cm**3, liquid water density
            4385     3                          ! roqi: 0.9179, ice density
            4386     3                           if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            4387     3                                  chem_opt == 302 .or. chem_opt == 303) .and. &
            4388     3                                  (gsfcgce_gocart_coupling == 1) ) then
            4389     3                             ! for cloud water, estimate lambda (slope of gamma distribution)
            4390     3                                  mu = min(15.e0, (1000.E0/ccn_out(i) + 2.e0))
            4391     3                                  gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4392     3                                  gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4393     3                                  lambda = (4.e0/3.e0*cpi*roqr*ccn_out(i)/L_cloud*   &
            4394     3                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4395     3                                  re_cloud_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4396     3                            else
            4397     3                  ! when running with WRF_Chem but no aerosol coupling in Goddard MP
            4398     3                              if (xland(i) .eq. 1.0) then
            4399     3                                 ccn_ref = ccn_over_land
            4400     3                              else if (xland(i) .eq. 2.0) then
            4401     3                                 ccn_ref = ccn_over_water
            4402     3                              else
            4403     3                                 print *,' xland is not 1. or 2., run stopped'
            4404     3                                 ! EMK NUWRF
            4405     3               !                  call wrf_error_fatal(' xland is not 1. or 2., run stopped')
            4406     3               !                  stop
            4407     3                              endif
            4408     3                                ! for cloud water, estimate lambda (slope of gamma distribution)
            4409     3                                     mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            4410     3                                     gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4411     3                                     gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4412     3                                     lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            4413     3                                              gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4414     3                                     re_cloud_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4415     3                           endif ! chem_opt and gsfcgce_gocart_coupling
            4416     3               #else
            4417     3                  ! Not running with WRF_Chem
            4418     3                           ! ccn_over_land = 1500  ! [#/cm3] climatological value
            4419     3                           ! ccn_over_water = 150  ! [#/cm3] climatological value
            4420     4   p    v                  if (xland(i) .eq. 1.0) then
            4421     4   m    m                     ccn_ref = ccn_over_land
            4422     4   p    v                  else if (xland(i) .eq. 2.0) then
            4423     4   m    m                     ccn_ref = ccn_over_water
            4424     4   p    v                  else
            4425     4   m    m                     print *,' xland is not 1. or 2., run stopped'
            4426     4                              ! EMK NUWRF
            4427     4               !               call wrf_error_fatal(' xland is not 1. or 2., run stopped')
            4428     4               !               stop
            4429     4   p    v                  endif
            4430     3                          ! for cloud water, estimate lambda (slope of gamma distribution)
            4431     3   s    s                         mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            4432     3   m    m                         gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4433     3   m    m                         gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4434     3   m    m                         lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            4435     3                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4436     3   p    v                         re_cloud_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4437     3               #endif
            4438     3   p    v         endif ! qcl(i,k) < cmin test
            4439     2               
            4440     2               ! for cloud ice
            4441     2               
            4442     3   p    v         if (qci(i,k) .lt. cmin) then
            4443     3   p    v            re_ice_gsfc(i,k) = 0.e0
            4444     3   p    v         else
            4445     3               #if (WRF_CHEM == 1)
            4446     3               !  ! when running with WRF_Chem and using aerosol coupling in Goddard MP
            4447     3               !      I_cloud = qci(i,k) * rho(i,k)             ! cloud ice [g/cm3]
            4448     3               !      if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            4449     3               !          chem_opt == 302 .or. chem_opt == 303) .and. &
            4450     3               !          (gsfcgce_gocart_coupling == 1) ) then
            4451     3               !        ! for cloud ice, estimate lambda (slope of gamma distribution)
            4452     3               !         mu = min(15.e0, (1000.E0/(icn_out*1.e-3)  + 2.e0))
            4453     3               !         gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4454     3               !         gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4455     3               !         lambda = (4.e0/3.e0*cpi*roqi*icn_out*1.e-3/I_cloud*  &
            4456     3               !                  gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4457     3               !         re_ice_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4458     3               !      else
            4459     3                 ! when running with WRF_Chem but no aerosol coupling in Goddard MP
            4460     3                       ! for cloud ice effective radius depends on temperature profile, formula from GCE
            4461     3                        re_ice_gsfc(i,k) = 125.e0 +(tair(i)-243.16)*5.e0     ! [micron]
            4462     3                        if (tair(i) .gt. 243.16) re_ice_gsfc(i,k) = 125.e0
            4463     3                        if (tair(i) .lt. 223.16) re_ice_gsfc(i,k) = 25.e0
            4464     3               !      endif ! chem_opt and gsfcgce_gocart_coupling
            4465     3               #else
            4466     3                 ! Not running with WRF_Chem
            4467     3                    ! for cloud ice effective radius depends on temperature profile, formula from GCE
            4468     3   p    v            re_ice_gsfc(i,k) = 125.e0 +(tair(i)-243.16)*5.e0     ! [micron]
            4469     3   p    v            if (tair(i) .gt. 243.16) re_ice_gsfc(i,k) = 125.e0
            4470     3   p    v            if (tair(i) .lt. 223.16) re_ice_gsfc(i,k) = 25.e0
            4471     3               #endif
            4472     3   p    v         endif ! qci(i,k) < cmin test
            4473     2               
            4474     2               !JJS 20140305 ^^^^^  Calculate effective radius for all cloud species
            4475     2               
            4476     2   p    v       ENDDO
            4477     1               
            4478     1                1000 continue
            4479                     
            4480                     !JJS  ****************************************************************
            4481                     !JJS  convert from GCE grid back to WRF grid
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 16
                                   <<< Loop-information  End >>>
            4482     1  pp                 do k=kts,kte
            4483     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qch, qhwrf, qcg, qgwrf, qcs, qswrf, qci
                                   <<<      qiwrf, qrn, qrwrf, qcl, qlwrf, dqv
                                   <<<      qvwrf, dpt, ptwrf
                                   <<< Loop-information  End >>>
            4484     2   p    v             DO i=1,irestrict
            4485     2   p    v               ptwrf(i,k) = dpt(i,k)
            4486     2   p    v               qvwrf(i,k) = dqv(i,k)
            4487     2   p    v               qlwrf(i,k) = qcl(i,k)
            4488     2   p    v               qrwrf(i,k) = qrn(i,k)
            4489     2   p    v               qiwrf(i,k) = qci(i,k)
            4490     2   p    v               qswrf(i,k) = qcs(i,k)
            4491     2   p    v               qgwrf(i,k) = qcg(i,k)
            4492     2   p    v               qhwrf(i,k) = qch(i,k)
            4493     2   p    v             ENDDO
            4494     1   p                 enddo !k
            4495                     
            4496                     !     ****************************************************************
            4497                     
            4498                     !+---+-----------------------------------------------------------------+
            4499                     ! EMK NUWRF...Replace Greg Thompson's dBZ values with those calculated
            4500                     ! above.
            4501     1                       IF ( PRESENT (diagflag) ) THEN
            4502     2                       if (diagflag .and. do_radar_ref == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 33
                                   <<< Loop-information  End >>>
            4503     3  pp                     do k=kts,kte
            4504     3               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dbz, refl_10cm
                                   <<< Loop-information  End >>>
            4505     4   p   2v                  DO i=1,irestrict
            4506     4   p   2v                          refl_10cm(i,k) = max(-35.,dbz(i,k))
            4507     4   p   2v                  ENDDO
            4508     3   p                     end do
            4509     2               
            4510     2                       endif
            4511     1                       ENDIF
            4512                     !+---+-----------------------------------------------------------------+
            4513                     
            4514                       END SUBROUTINE saticel_s
            4515                     
            4516                       SUBROUTINE auto_conversion( L, N, P , re)
            4517                       implicit none
            4518                     !-----------------------------------------------------------------------------------------------------
            4519                     ! Comments:
            4520                     !  This subroutine compute auto conversion rate folloing Li and Daum [2004], which account for
            4521                     !  total cloud liquid water, particle number concentrations, PSD lambda, broadening parameters.
            4522                     !
            4523                     ! History:
            4524                     !  08/2010  Toshi Matsui@NASA GSFC : Initial.
            4525                     !
            4526                     !
            4527                     ! References:
            4528                     ! Liu, Y. and P. H. Daum, 2004: Parameterization of the autoconversion process. Part I: Analytical
            4529                     !   formulation of the Kessler-type parameterizations. J. Atmos. Sci, 61, 1539-1548.
            4530                     !-----------------------------------------------------------------------------------------------------
            4531                      real,intent(in) :: L    ! cloud liquid water [g cm-3]
            4532                      real,intent(in) :: N    ! total number concentration [# cm-3]
            4533                      real,intent(out) :: P   ! auto conversion rate [g cm-3 s-1]
            4534                      real,intent(out) :: re  ! cloud effective radius [micron]
            4535                     
            4536                      real :: mu   ! mu of gamma PSD [-]
            4537                      real :: eta  ! eta function [cm3 g-2 s-1]
            4538                      real :: beta, beta1, beta2     ! beta function [-]
            4539                      real :: gamfac , gfac1 , gfac2 ! gamma function [-]
            4540                      real :: R6_6power  ! mean radius of the sixth moment [cm]
            4541                      real :: R6_thresh ! threshold of  mean radius of the sixth moment [cm]
            4542                      real :: R6        ! mean radius of the sixth moment [cm]
            4543                      real :: Heaviside_func  ! Heaviside step function (0 or 1)
            4544                      real :: lambda    ! slope of gamma size ditribution [1/cm]
            4545                     ! real :: No        ! intercept  [cm-4]
            4546                     
            4547                      real,parameter :: Rc = 10.e0 * 1.e-4 ! threshold of particle radus (10 micron) [cm]
            4548                      real,parameter :: const_pi    = 3.14159e0 ! pai
            4549                      real,parameter :: const_kappa = 1.9e11    ! coefficient for water droplet collection kernel [cm-3 s-1]
            4550                                                                ! from Long [1974, JAS].
            4551                     ! real,parameter :: const_kappa = 1.9e11*10000.e0 !10000 is to adjust the order to keseller
            4552                     
            4553                     
            4554                      real,parameter :: const_rho_liq = 1.e0    ! density of liquid water [g cm-3]
            4555                      real,parameter :: eta_func = ((3.e0/(4.e0*const_pi*const_rho_liq))**2) * const_kappa  ! eta function [cm3 g-2 s-1]
            4556                                                                                                            ! a part of (eq 27b)
            4557                     
            4558                      logical,parameter :: no_thresh = .true.  ! logic to choose no threshold parameterization or not.
            4559                     
            4560                     !
            4561                     ! When no particel, no autoconversion.
            4562                     !
            4563                     ! EMK BUG FIX...Prevent overflow for small but non-zero values of L
            4564                     ! if( N <= 0.e0 .or. L <= 0.e0 ) then
            4565     1                if( N <= 0.e0 .or. L <= 1.0e-32 ) then
            4566     1                  P = 0.e0
            4567     1                  return
            4568     1                endif
            4569                     
            4570                     !
            4571                     ! check bad values of N and L
            4572                     !
            4573                     ! if( N < 0.e0 ) stop 'MSG auto_conversion: N is negative, it must be positive'
            4574                     ! if( L < 0.e0 ) stop 'MSG auto_conversion: L is negative, it must be positive'
            4575                     ! if( L > 1.e0 ) stop 'MSG auto_conversion: L is greater than 1g/cm3.'
            4576                     
            4577                     !
            4578                     ! Empirical fit of mu as a function of total particle number concentrations.
            4579                     ! From Martin et al. (1994), assign gamma shape parameter mu for cloud
            4580                     ! drops according to general dispersion characteristics.
            4581                     ! disp=~0.25 for Maritime and 0.45 for Continental.
            4582                     ! Since disp=SQRT((mu+2)/(mu+1) - 1), mu varies from 15 for Maritime (pristine air)
            4583                     ! to 2 for Continental (really dirty air).  if mu = 0 --> expnential distribution (narrow dist)
            4584                     !
            4585                     
            4586                     ! orig
            4587                      mu = MIN(15.e0, (1000.E0/N + 2.e0))
            4588                     
            4589                     
            4590                     !
            4591                     ! gamma functions
            4592                     !
            4593                      gfac1 = gamma_toshi(mu+4.e0)
            4594                      gfac2 = gamma_toshi(mu+1.e0)
            4595                      gamfac = (gfac1/gfac2)
            4596                     
            4597                     !
            4598                     ! estimate lambda (slope of gamma distribution)
            4599                     !
            4600                      lambda = (4.e0/3.e0*const_pi*const_rho_liq*N/L*gamfac)**(1.e0/3.e0)  ! [1/cm]
            4601                     
            4602                     
            4603     1                THRESH: if( no_thresh ) then !-------------------------------------------
            4604     1               
            4605     1               !
            4606     1               ! threshold of particle radius (mean radius of the sixth moment )
            4607     1               !
            4608     1                gfac1 = gamma_toshi(mu+7.e0)
            4609     1                gfac2 = gamma_toshi(mu+1.e0)
            4610     1                gamfac = (gfac1/gfac2)
            4611     1               
            4612     1                R6_6power = (1.e0 / lambda)**6.e0 * gamfac   ![cm] (eq. A3)
            4613     1               
            4614     1               !
            4615     1               ! auto conversion rate (eq. 26a)
            4616     1               !
            4617     1                P = const_kappa *   N     * R6_6power *    L      ! [g cm-3 s-1 ]
            4618     1               !    [cm-3 s-1]  * [#/cm3] *   [cm6]   * [g/cm3]
            4619     1               
            4620     1               
            4621     1                else  !with threshold ---------------------------------------------------
            4622     1               
            4623     1               !
            4624     1               ! Estimate eta under gamma PSD
            4625     1               !
            4626     1                beta1 = (6.e0+mu)*(5.e0+mu)*(4.e0+mu)
            4627     1                beta2 = (3.e0+mu)*(2.e0+mu)*(1.e0+mu)
            4628     1                beta  = beta1 / beta2
            4629     1               
            4630     1                eta = eta_func * beta  ! eta function (eq 27b) [cm3 g-2 s-1]
            4631     1               
            4632     1               !
            4633     1               ! threshold of particle radius (mean radius of the sixth moment )
            4634     1               !
            4635     1                R6_thresh = beta * Rc  ![cm] (pg 1545)
            4636     1               
            4637     1               !
            4638     1               ! mean radius of the sixth moment
            4639     1               !
            4640     1                gfac1 = gamma_toshi(6.e0+mu+1.e0)
            4641     1                gfac2 = gamma_toshi(1.e0+mu)
            4642     1                gamfac = (gfac1/gfac2)**(1.e0/6.e0)
            4643     1               
            4644     1                R6 = (1.e0 / lambda) * gamfac   ![cm] (eq. A3)
            4645     1               
            4646     1               !
            4647     1               ! Heaviside step function
            4648     1               !
            4649     2                if    ( R6 - R6_thresh <= 0.e0 ) then
            4650     2                   Heaviside_func = 0.e0
            4651     2                elseif( R6 - R6_thresh > 0.e0 ) then
            4652     2                   Heaviside_func = 1.e0
            4653     2                else
            4654     2                   ! NUWRF EMK...User WRF's library to gracefully stop MPI.
            4655     2               !    write(wrf_err_message,*)'MSG: auto_conversion: Strange value of R6= ',R6
            4656     2               !    call wrf_error_fatal(trim(wrf_err_message))
            4657     2               !   print*, 'MSG: auto_conversion: Strange value of R6= ', R6 ; stop
            4658     2                endif
            4659     1               
            4660     1               !
            4661     1               ! auto conversion rate [g cm-3 s-1 ] (eq. 27a)
            4662     1               !
            4663     1                P = eta * (1.e0/N) * (L**3) *  Heaviside_func
            4664     1               
            4665     1               !    [cm3 g-2 s-1] * [cm3] * [g3/cm9]
            4666     1               
            4667     1                endif THRESH !------------------------------------------------------------
            4668                     
            4669                     
            4670                     ! optional
            4671                     
            4672                     !
            4673                     ! estimate effective radius
            4674                     !
            4675                      gfac1 = gamma_toshi(mu+4.e0)
            4676                      gfac2 = gamma_toshi(mu+3.e0)
            4677                      gamfac = (gfac1/gfac2)
            4678                     
            4679                      re = 1.e0/lambda * gamfac * 1.e4  !effective radius [micron]
            4680                     
            4681                     !
            4682                     ! estimate No
            4683                     !
            4684                     ! call gamma_function(mu+1.e0 ,gfac1)
            4685                     ! No = N * (lambda**(mu+1)) / gfac1
            4686                     
            4687                      END subroutine auto_conversion
            4688                     
            4689                     !DIR$ ATTRIBUTES FORCEINLINE :: gamma_toshi
            4690                      real function gamma_toshi(x)
            4691                     
            4692                     !---------------------------------------------------------------------------------------------------
            4693                     ! Comments:
            4694                     !   compute the gamma function T(x) for single precision floating point.
            4695                     !       input :  x  --- argument of a(x)
            4696                     !                       ( x is not equal to 0,-1,-2,... )
            4697                     !
            4698                     ! History:
            4699                     ! 09/2009  Toshi Matsui@NASA GSFC ; Adapted to SDSU
            4700                     !
            4701                     ! References:
            4702                     !----------------------------------------------------------------------------------------------------
            4703                      implicit double precision (a-h,o-z)
            4704                      dimension g(26)
            4705                      data g/1.0d0,0.5772156649015329d0, &
            4706                            -0.6558780715202538d0, -0.420026350340952d-1, &
            4707                             0.1665386113822915d0,-.421977345555443d-1, &
            4708                             -.96219715278770d-2, .72189432466630d-2, &
            4709                             -.11651675918591d-2, -.2152416741149d-3, &
            4710                             .1280502823882d-3, -.201348547807d-4, &
            4711                             -.12504934821d-5, .11330272320d-5, &
            4712                             -.2056338417d-6, .61160950d-8, &
            4713                              .50020075d-8, -.11812746d-8, &
            4714                             .1043427d-9, .77823d-11, &
            4715                             -.36968d-11, .51d-12, &
            4716                             -.206d-13, -.54d-14, .14d-14, .1d-15/
            4717                      real :: x
            4718                     
            4719                      pi=3.141592653589793d0
            4720     1                if (x.eq.int(x)) then
            4721     2                    if (x.gt.0.0d0) then
            4722     2                        ga=1.0d0
            4723     2                        m1=int(x)-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4724     3  pp    v              do k=2,m1
            4725     3   p    v                 ga=ga*k
            4726     3   p    v              enddo
            4727     2                    else
            4728     2                       ga=1.0d+300
            4729     2                    endif
            4730     1                 else
            4731     2                    if (dabs(dble(x)).gt.1.0d0) then
            4732     2                        z=dabs(dble(x))
            4733     2                        m=int(z)
            4734     2                        r=1.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4735     3  pp    v              do k=1,m
            4736     3   p    v                 r=r*(z-k)
            4737     3   p    v              enddo
            4738     2                       z=z-m
            4739     2                    else
            4740     2                       z=dble(x)
            4741     2                    endif
            4742     1                    gr=g(26)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      g
                                   <<< Loop-information  End >>>
            4743     2   s   4s           do k=25,1,-1
            4744     2   s   4s              gr=gr*z+g(k)
            4745     2   s   4s           enddo
            4746     1                    ga=1.0d0/(gr*z)
            4747     2                    if (dabs(dble(x)).gt.1.0d0) then
            4748     2                        ga=ga*r
            4749     2                        if (x.lt.0.0d0) ga=-pi/(x*ga*dsin(pi*x))
            4750     2                    endif
            4751     1                 endif
            4752                     
            4753                       gamma_toshi = real(ga)
            4754                     
            4755                       end function gamma_toshi

             485     4   p    v                  refr2d(ic,k)=re_rain_gsfc(i,k,j)
             486     4   p    v                  refi2d(ic,k)=re_ice_gsfc(i,k,j)
             487     4   p    v                  refs2d(ic,k)=re_snow_gsfc(i,k,j)
             488     4   p    v                  refg2d(ic,k)=re_graupel_gsfc(i,k,j)
             489     4   p    v                  refh2d(ic,k)=re_hail_gsfc(i,k,j)
             490     4   p    v                  physc2d(ic,k)=physc(i,k,j)
             491     4   p    v                  physe2d(ic,k)=physe(i,k,j)
             492     4   p    v                  physd2d(ic,k)=physd(i,k,j)
             493     4   p    v                  physs2d(ic,k)=physs(i,k,j)
             494     4   p    v                  physm2d(ic,k)=physm(i,k,j)
             495     4   p    v                  physf2d(ic,k)=physf(i,k,j)

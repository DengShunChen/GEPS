            2800     2   s    s              DO i=1,irestrict
            2801     2               
            2802     2               !JJS   for calculating processes related to both ice and warm rain
            2803     2               
            2804     2               !     ***   COMPUTE ZR,ZS,ZG,VR,VS,VG      *****************************
            2805     2               
            2806     3   m    m                  if (qr(i) .gt. cmin) then
            2807     3   s    s      	       dd(i)=r00(i)*qr(i)
            2808     3   s    s      	       y1(i)=sqrt(dd(i))
            2809     3   s    s      	       y2(i)=sqrt(y1(i))
            2810     3   s    s      	       zr(i)=zrc/y2(i)
            2811     3   p    v                  endif
            2812     2               
            2813     2   m    m                  call vqrqi(1,r00(i),fv0(i),qr(i),qc(i),tair(i),vr(i))
            2814     2   s    s                  call vqrqi(2,r00(i),fv0(i),qi(i),qc(i),tair(i),vi(i))
            2815     2               
            2816     2   s    s                  ftns(i)=1.
            2817     2   s    s                  ftns0(i)=1.
            2818     2               
            2819     2   s    s                  qhz2=qhwrf(i,k)
            2820     2   s    s                  qgz2=qgwrf(i,k)
            2821     3   m    s                  if (k .lt. kte-2 .and. tairc(i) .ge. -5) then
            2822     3   s    s                     qhz2=qhwrf(i,k+1)
            2823     3   s    s                     qgz2=qgwrf(i,k+1)
            2824     3   p    v                  endif
            2825     2   s    s                  call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            2826     2   s    s                  call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            2827     2               
            2828     3   s    s      	    if (qs(i) .gt. cmin) then
            2829     3   s    s      	       dd(i)=r00(i)*qs(i)
            2830     3   s    s      	       y1(i)=dd(i)**.25
            2831     3   s    s                     ftns(i)=1.
            2832     3   s    s                     ftns(i)=ftns0(i)**0.25
            2833     3   s    s                     fros(i)=1                                        !improve4
            2834     3   s    s                     fros(i)=fros0(i)**0.25        !improve4
            2835     3   s    s                     ZS(i)=ZSC/Y1(i)*ftns(i)*fros(i)            !improve4
            2836     3   s    s                     ftns(i)=ftns0(i)**bsq
            2837     3   s    s                     fros(i)=fros0(i)**bsq         !improve4
            2838     3   s    s                     VS(i)=MAX(vscf(i)*DD(i)**BSQ/ftns(i)/fros(i), 0.)
            2839     3   p    v                  endif
            2840     2               
            2841     2   m    m                  ftng(i)=1.
            2842     2   s    s                  ftng0(i)=1.
            2843     2   s    s                  call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            2844     2               
            2845     3   s    s      	    if (qg(i) .gt. cmin) then
            2846     3   s    s      	       dd(i)=r00(i)*qg(i)
            2847     3   s    s      	       y1(i)=dd(i)**.25
            2848     3   s    s                     ftng(i)=1.
            2849     3   s    s                     ftng(i)=ftng0(i)**0.25
            2850     3               
            2851     3   s    s                     zg(i)=zgc/y1(i)*ftng(i)
            2852     3   s    s                     if(dd(i).gt.qrog2) zg(i)=zgc2/y1(i)*ftng(i)
            2853     3               
            2854     3   s    s                     ftng(i)=ftng0(i)**bgq
            2855     3   m    s      	       vg(i)=max(vgcf(i)*dd(i)**bgq/ftng(i), 0.0)
            2856     4   s    s                     if(dd(i).gt.qrog2)then
            2857     4   s    s                     ftng(i)=ftng0(i)**bgq2
            2858     4   m    s                     vg(i)=max(vgcf2(i)*dd(i)**bgq2/ftng(i), 0.e0)
            2859     4   p    s                    endif !improve4
            2860     3   p    v                 endif !qg
            2861     2               
            2862     2   s    s                 call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))
            2863     2               
            2864     3   s    s                 if (qh(i) .gt. cmin) then
            2865     3   s    s                    dd(i)=r00(i)*qh(i)
            2866     3   s    s                    y1(i)=dd(i)**.25
            2867     3   s    s                    ftnh(i)=ftnh0(i)**0.25
            2868     3   s    s                    zh(i)=zhc/y1(i)*ftnh(i)
            2869     3   s    s                    ftnh(i)=ftnh0(i)**bhq
            2870     3   m    s                    vh(i)=max(vhcr(i)*dd(i)**bhq/ftnh(i), 0.0)
            2871     3   p    v                  endif
            2872     2               
            2873     2   s    s                  if (qr(i) .le. cmin1) vr(i)=0.0
            2874     2   m    m                  if (qs(i) .le. cmin1) vs(i)=0.0
            2875     2   m    m                  if (qg(i) .le. cmin1) vg(i)=0.0
            2876     2   m    m                  if (qi(i) .le. cmin1) vi(i)=0.0
            2877     2   p    m                  if (qh(i) .le. cmin1) vh(i)=0.0

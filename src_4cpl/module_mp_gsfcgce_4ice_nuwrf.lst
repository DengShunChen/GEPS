            1275                     !-----------------------------------------------------------------------
            1276                     !c Correction of negative values
            1277                        SUBROUTINE negcor ( X, rho, dz8w,                         &
            1278                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
            1279                                           itimestep, ics,                         &
            1280                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
            1281                     !-----------------------------------------------------------------------
            1282                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
            1283                             INTENT(INOUT) ::                                     X
            1284                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
            1285                             INTENT(IN   ) ::                              rho, dz8w
            1286                       integer, INTENT(IN   ) ::                           itimestep, ics
            1287                     
            1288                     !c Local variables
            1289                     !  REAL, DIMENSION( kts:kte ) ::  Y1, Y2
            1290                       REAL   ::   A0, A1, A2
            1291                     
            1292                       A1=0.
            1293                       A2=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<< Loop-information  End >>>
            1294     1                 do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            1295     2                    do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1296     3  pp    v              do i=its,ite
            1297     3   p    v              A1=A1+max(X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
            1298     3   p    v              A2=A2+max(-X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
            1299     3   p    v              enddo
            1300     2                    enddo
            1301     1                 enddo
            1302                     
            1303                     !  A1=0.0
            1304                     !  A2=0.0
            1305                     !  do k=kts,kte
            1306                     !     A1=A1+Y1(k)
            1307                     !     A2=A2+Y2(k)
            1308                     !  enddo
            1309                     
            1310                       A0=0.0
            1311                     
            1312     1                 if (A1.NE.0.0.and.A1.GT.A2) then
            1313     1                    A0=(A1-A2)/A1
            1314     1               
            1315     2                 if (mod(itimestep,540).eq.0) then
            1316     3                    if (ics.eq.1) then
            1317     3                       write(61,*) 'kms=',kms,'  kme=',kme,'  kts=',kts,'  kte=',kte
            1318     3                       write(61,*) 'jms=',jms,'  jme=',jme,'  jts=',jts,'  jte=',jte
            1319     3                       write(61,*) 'ims=',ims,'  ime=',ime,'  its=',its,'  ite=',ite
            1320     3                    endif
            1321     3                    if (ics.eq.1) then
            1322     3                        write(61,*) 'qv timestep=',itimestep
            1323     3                        write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1324     3                    else if (ics.eq.2) then
            1325     3                            write(61,*) 'ql timestep=',itimestep
            1326     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1327     3                    else if (ics.eq.3) then
            1328     3                            write(61,*) 'qr timestep=',itimestep
            1329     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1330     3                    else if (ics.eq.4) then
            1331     3                            write(61,*) 'qi timestep=',itimestep
            1332     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1333     3                    else if (ics.eq.5) then
            1334     3                            write(61,*) 'qs timestep=',itimestep
            1335     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1336     3                    else if (ics.eq.6) then
            1337     3                            write(61,*) 'qg timestep=',itimestep
            1338     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1339     3                    else
            1340     3                            write(61,*) 'wrong cloud specieis number'
            1341     3                    endif
            1342     2                 endif
            1343     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
            1344     2   p                do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            1345     3  pp                   do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 224, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
            1346     4   p   2v                 do i=its,ite
            1347     4   p   2v                 X(i,k,j)=A0*AMAX1(X(i,k,j), 0.0)
            1348     4   p   2v                 enddo
            1349     3   p                   enddo
            1350     2   p                enddo
            1351     1                 endif
            1352                     
            1353                       END SUBROUTINE negcor

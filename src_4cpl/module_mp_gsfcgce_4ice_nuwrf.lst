            3564     2                                 +dlt2(i)*psacr(i))
            3565     2   s    s                pracs(i)=(1.-dlt2(i))*pracs(i)
            3566     2   s    s                pwacs(i)=(1.-dlt4(i))*pwacs(i)
            3567     2   s    s                pracg(i)=(1.-dlt2(i))*pracg(i)
            3568     2   s    s                psn(i)=d2t*(pgacs(i)+dgacs(i)+wgacs(i)   &
            3569     2                                  +pracs(i)+pwacs(i)+whacs(i))
            3570     2               
            3571     2   s    s                qs(i)=qs(i)+ps(i)-qracs(i)-psn(i)
            3572     3   s    s                if (qs(i) .lt. 0.0) then
            3573     3   s    s                   y2(i)=1.
            3574     3   s    s                   if (psn(i) .ne. 0.) y2(i)=qs(i)/psn(i)+1.
            3575     3   s    s                   pgacs(i)=pgacs(i)*y2(i)
            3576     3   s    s                   dgacs(i)=dgacs(i)*y2(i)
            3577     3   s    s                   wgacs(i)=wgacs(i)*y2(i)
            3578     3   s    s                   whacs(i)=whacs(i)*y2(i)
            3579     3   s    s                   pracs(i)=pracs(i)*y2(i)
            3580     3   s    s                   pwacs(i)=pwacs(i)*y2(i)
            3581     3   p    v                   qs(i)=0.0
            3582     3   p    v                endif
            3583     2   s    s                psn(i)=d2t*(pgacs(i)+dgacs(i)+wgacs(i)    &
            3584     2                                   +pracs(i)+pwacs(i))
            3585     2   s    s                qg(i)=qg(i)+pg(i)+prn(i)+psn(i)-qracg(i)
            3586     2   s    s                qg(i)=qg(i)-d2t*(pracs(i)+whacg(i)  &
            3587     2                                                                      +pracg(i)  &   !fix from JDC
            3588     2                                                                      +pg2h(i))      !fix from SEL
            3589     2               
            3590     3   s    s                if (qg(i) .lt. 0.0) then                              !fix from JDC
            3591     3   s    s                 y2(i)=1.                                             !fix from JDC
            3592     3   s    s                  if (whacg(i)+pracg(i)+pg2h(i).ne. 0.)   &                 !fix from JDC
            3593     3                               y2(i)=qg(i)/(d2t*(whacg(i)+pracg(i)+pg2h(i)))+1.  !fix from JDC & SEL
            3594     3   s    s                  whacg(i)=whacg(i)*y2(i)                         !fix from JDC
            3595     3   s    s                  pracg(i)=pracg(i)*y2(i)                         !fix from JDC
            3596     3   s    s                  pg2h(i)=pg2h(i)*y2(i)                           !fix from SEL
            3597     3   p    v                  qg(i)=0.0                                           !fix from JDC
            3598     3   p    v                endif
            3599     2               
            3600     2   m    m                  qh(i)=qh(i)+d2t*(phfr(i)+(1.-dlt3(i))*piacr(i)        &
            3601     2                                  +(1.-dlt3(i))*praci(i)+(1.-dlt2(i))*psacr(i)     &
            3602     2                                  +pracs(i)+(1.-dlt2(i))*dgacr(i)+pracg(i)         &
            3603     2                                  +dhacw(i)+dhacr(i)-primh(i)+whaci(i)             &
            3604     2                                  +whacs(i)+whacg(i)+pg2h(i))
            3605     2               
            3606     2   m    m                y1(i)=d2t*(psacw(i)+psfw(i)+dgacw(i)+piacr(i)             &
            3607     2                                +dgacr(i)+psacr(i)+pgfr(i)+phfr(i)+pihms(i)        &
            3608     2                                +pihmg(i)+dhacw(i)+dhacr(i)           +pihmh(i))     &
            3609     2                                -qracs(i)
            3610     2   s    s                pt(i)=pt(i)+afcp(i)*y1(i)
            3611     2   s    s                tair(i)=(pt(i)+tb0)*pi0(i)

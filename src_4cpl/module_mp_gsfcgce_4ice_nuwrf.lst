            3621     2   s    s                qgz2=qgwrf(i,k)
            3622     3   m    s                if (k .lt. kte-2 .and. tairc(i) .ge. -5) then
            3623     3   s    s                   qhz2=qhwrf(i,k+1)
            3624     3   s    s                   qgz2=qgwrf(i,k+1)
            3625     3   p    v                endif
            3626     2   s    s                call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            3627     2   s    s                call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            3628     2   s    s                call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            3629     2   s    s                call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))
            3630     2               
            3631     3   s    s               if (tair(i).ge.t0) then
            3632     3   s    s                 tairc(i)=tair(i)-t0
            3633     3   s    s                 ftns(i)=1.
            3634     3   s    s                 ftng(i)=1.
            3635     3   s    s                 ftnh(i)=1.
            3636     3   s    s                 ftns(i)=ftns0(i)
            3637     3   s    s                 ftng(i)=ftng0(i)
            3638     3   s    s                 ftnh(i)=ftnh0(i)
            3639     3   s    s                 dd(i)=r11t*tairc(i)*(r101r(i)/zs(i)**2+r102rf(i)  &
            3640     3                                              /zs(i)**bsh5)*ftns(i)
            3641     3   s    s                 psmlt(i)=r2is*min(qs(i),max(dd(i),0.0))
            3642     4   s    s                 if (r00(i)*qg(i).gt.qrog2) then
            3643     4   m    s                   y2(i)=(r191r(i)/zg(i)**2+r192rf2(i)/zg(i)**bgh5_2)*ftng(i)
            3644     4   s    s                 else
            3645     4   m    s                   y2(i)=(r191r(i)/zg(i)**2+r192rf(i)/zg(i)**bgh5)*ftng(i)
            3646     4   s    s                 endif
            3647     3   s    s                 dd1(i)=tairc(i)*(r19t*y2(i)+r19at*(qgacw(i) &
            3648     3                                                            +qgacr(i)))
            3649     3   s    s                 pgmlt(i)=r2ig*min(qg(i),max(dd1(i),0.0))
            3650     3               
            3651     3   m    s                 Y1(i)=TCA(i)*TAIRC(i)-ALVR(i)*DWV(i)*(RP0(i)-(QV(i)+QB0))
            3652     3   s    s                 Y3(i)=.78/ZH(i)**2+h19aq(i)*SCV(i)/ZH(i)**BHH5
            3653     3   s    s                 DDa0(i)=h19rt(i)*Y1(i)*Y3(i)*ftnh(i)+r19at*TAIRC(i)*  &
            3654     3                            (QHACW(i)+QHACR(i))
            3655     3   s    s                 PHMLT(i)=r2ih*max(0.0, min(DDa0(i), QH(i)))
            3656     3               
            3657     3   s    s                 pt(i)=pt(i)-afcp(i)*(psmlt(i)+pgmlt(i)+phmlt(i))
            3658     3   s    s                 tair(i)=(pt(i)+tb0)*pi0(i)

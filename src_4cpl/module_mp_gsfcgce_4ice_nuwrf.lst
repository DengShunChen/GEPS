            2198                       real, dimension(CHUNK) :: afcp, alvr, ascp, avcp, rp0, pi0, pir,  &
            2199                                                 pr0, r00, rrs, rrq, fv0, fvs, cp409, &
            2200                                                 rr0, zrr, zsr, zgr, zhr, &
            2201                                                 cp580, cs580, cv409, vscf, vgcf, vgcf2, &
            2202                                                 vhcr, dwvp, r3f, r4f, r5f, r6f, &
            2203                                                 r12r, r14f ,r14f2, r15af, r15af2, r15f, r18r, &
            2204                                                 r22f, r25rt, r32rt, r331r, r332rf, &
            2205                                                 r34f
            2206                     
            2207                       real :: bg3, bg3_2, bgh5, bgh5_2, bs3 ,bs6, bsh5, bw3 ,bw6 ,bwh5, &
            2208                               cmin, cmin1, cmin2, d2t, del, f2 ,f3, ft, qb0, r25a, r_nci, &
            2209                               sccc, sddd, seee, sfff, smmm, ssss, tb0, temp, ucog ,ucog2, &
            2210                               ucor ,ucos, ucoh, uwet, rdt, bnd1, c_nci, &
            2211                               r10t, r20t, r23t
            2212                     
            2213                       real :: a_1, a_2, a_3, a_4
            2214                       real :: a_11, a_22, a_33, a_44
            2215                       real :: zdry, zwet, zwet0

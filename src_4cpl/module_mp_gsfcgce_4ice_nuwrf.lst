             578                       SUBROUTINE fall_flux ( dt, ql, qr, qi, qs, qg, qh, p,       &
             579                                           rho, th, pi_mks, z, dz8w, topo, rainnc, &
             580                                           rainncv, grav, itimestep,               &
             581                                           preci3d, precs3d, precg3d, prech3d, precr3d,     &
             582                                           snownc, snowncv, sr,                    &
             583                                           graupelnc, graupelncv,                  &
             584                                           hailnc, hailncv,                        &
             585                                           vgc, vgc2, vhc, bhq,                    &
             586                                           improve,                                &
             587                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             588                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             589                     !-----------------------------------------------------------------------
             590                     ! adopted from Jiun-Dar Chern's codes for Purdue Regional Model
             591                     ! adopted by Jainn J. Shi, 6/10/2005
             592                     ! modified by Goddard 7/24/2010
             593                     ! modified by Tao 11/12/2010
             594                     !-----------------------------------------------------------------------
             595                     
             596                       IMPLICIT NONE
             597                       INTEGER, INTENT(IN   )               :: improve,            &
             598                                                               ims,ime, jms,jme, kms,kme,  &
             599                                                               its,ite, jts,jte, kts,kte
             600                       INTEGER, INTENT(IN   )               :: itimestep
             601                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             602                                INTENT(INOUT)               :: ql, qr, qi, qs, qg, qh
             603                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             604                                INTENT(IN)                  :: th, pi_mks
             605                     
             606                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             607                                INTENT(INOUT)               :: rainnc, rainncv,            &
             608                                                               snownc, snowncv, sr,        &
             609                                                               graupelnc, graupelncv,      &
             610                                                               hailnc, hailncv
             611                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             612                                INTENT(IN   )               :: rho, z, dz8w, p
             613                     
             614                       REAL,    INTENT(IN   )               :: dt, grav, vgc, vgc2, vhc, bhq
             615                     
             616                     
             617                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             618                                INTENT(IN   )               :: topo
             619                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             620                                INTENT(OUT)               :: preci3d, precs3d, precg3d, prech3d, precr3d
             621                     
             622                     ! temperary vars
             623                     
             624                       REAL,    DIMENSION( kts:kte )           :: fv
             625                       REAL                                    :: tmp1, term0
             626                       REAL                                :: pptrain, pptsnow,        &
             627                                                              pptgraul, pptice, ppthail
             628                       REAL :: qrz, qiz
             629                       REAL,    DIMENSION( kts:kte )       :: qcz, qsz, qgz, qhz,  &
             630                                                              zz, dzw, prez, rhoz,      &
             631                                                              orhoz,r00
             632                       REAL,    DIMENSION( kts:kte )       :: csed, rsed, ised, ssed, gsed, hsed
             633                     
             634                       REAL,    DIMENSION( kts:kte )       :: thz, piz
             635                     
             636                        INTEGER                    :: k, i, j
             637                     !
             638                     
             639                       REAL, DIMENSION( kts:kte )    :: vtr, vts, vtg, vth, vti
             640                     
             641                       REAL                          :: dtb, pi, consta, constc, gambp4,    &
             642                                                        gamdp4, gam4pt5, gam4bbar
             643                     
             644                     ! New local variable
             645                       REAL                          :: y1, y2, vr, vs, vg
             646                       REAL                          :: vgcr, vgcr2, vscf,   &
             647                                                        vhcr, vhcr2
             648                       REAL                          :: tair, tairc, fexp
             649                       REAL                          :: ftns, ftnsQ, ftng, ftngQ
             650                       REAL                          :: const_vt, const_d, const_m, bb1, bb2
             651                       REAL,    DIMENSION(7)         :: aice, vice
             652                       REAL                          :: ftns0, ftng0
             653                       REAL                          :: fros, fros0
             654                       REAL                          :: qhz2,qgz2
             655                     
             656                     !  DATA tslopes/0./, tslopeg/0./
             657                     !  DATA const_vt//, const_d//, const_m//
             658                       DATA aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./  ! g/m**3
             659                       DATA vice/5.,15.,30.,35.,40.,45.,50./  ! cm/s
             660                       DATA ftns/1./, ftng/1./
             661                     
             662                     
             663                     !  will be defined later using consat values
             664                        REAL     ::     rhowater
             665                        REAL     ::     rhosnow
             666                     !JJS 20140116  These variables are declared in the beginning of the module.
             667                     !JJS 20140116  No need to declared again here.
             668                     !   REAL     ::     xnor
             669                     !   REAL     ::     xnos

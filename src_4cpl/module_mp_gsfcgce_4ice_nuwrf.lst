                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            1241     3   p    v         do k = kts, kte
            1242     3   p    v                  preci3d(i,k,j)=ised(k)
            1243     3   p    v                  precs3d(i,k,j)=ssed(k)
            1244     3   p    v                  precg3d(i,k,j)=gsed(k)
            1245     3   p    v                  prech3d(i,k,j)=hsed(k)
            1246     3   p    v                  precr3d(i,k,j)=rsed(k)

            1264     2   p              RAINNCV(i,j) = pptrain + pptsnow + pptgraul + pptice + ppthail
            1265     2   p              RAINNC(i,j)  = RAINNC(i,j) + pptrain + pptsnow + pptgraul + pptice + ppthail
            1266     2   p              sr(i,j) = 0.
            1267     2   p              if (RAINNCV(i,j) .gt. 0.) sr(i,j) = (pptsnow + pptgraul + pptice + ppthail) / RAINNCV(i,j)

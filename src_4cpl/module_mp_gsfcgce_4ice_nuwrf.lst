            2084                                            re_cloud_gsfc, re_rain_gsfc, re_ice_gsfc,       &
            2085                                            re_snow_gsfc, re_graupel_gsfc, re_hail_gsfc,    & ! cloud effective radius
            2086                                            physc, physe, physd, physs, physm, physf,       &
            2087                                            acphysc, acphyse, acphysd, acphyss, acphysm, acphysf &
            2088                     #if ( WRF_CHEM == 1)
            2089                     !JJS 20110525 vvvvv
            2090                                            ,aero, icn_diag, nc_diag, gid,                   &
            2091                     !JJS 20110525 ^^^^^
            2092                     ! EMK
            2093                                            chem_opt,                                       &

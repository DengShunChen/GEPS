                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            1087     4   p   2s            do k=kts,kte-1
            1088     4   p   2s                vth(k)=0.
            1089     4               
            1090     5   p   2v               if (qhz(k) .gt. cmin) then
            1091     5   p   2v                  min_q=min0(min_q,k)
            1092     5   p   2v                  max_q=max0(max_q,k)
            1093     5               
            1094     5               ! new codes from Steve's in cgs
            1095     5   p   2v                       y1 = qhz(k)
            1096     5   p   2v                       vhcr=vhc/sqrt(r00(k))                                 !Di
            1097     5   p   2v                       vth(k)=amax1(vhcr*(y1*r00(k))**bhq, 0.e0)             !Di
            1098     5   p   2m                       vth(k)=vth(k) * 0.01  ! convert back to MKS
            1099     5               
            1100     6   p   2v                  if (k .eq. 1) then
            1101     6   p   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vth(k))
            1102     6   p   2v                  else
            1103     6   p   2m                     del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vth(k))
            1104     6   p   2v                  endif
            1105     5               !
            1106     5   p   2v               endif !qhz
            1107     4   p   2v            enddo !k
            1108     3               
            1109     4   p                 if (max_q .ge. min_q) then
            1110     4               !
            1111     4               !

            1816                           hn17=2.*cpi*tnh
            1817                           hn17a=.31*ga5hh*sqrt(ah)
            1818                           hn19=2.*cpi*tnh/alf
            1819                           hn19a=.31*ga5hh*sqrt(ah)
            1820                           hn10a=als*als/rw
            1821                           hn20=2.*cpi*tnh
            1822                           hn20b=.31*ga5hh*sqrt(ah)
            1823                     
            1824                     ! JDC add schmidt number term
            1825                           sc13    = 0.8420526
            1826                           rn102   = rn102 * sc13
            1827                           rn17a   = rn17a * sc13
            1828                           rn17a2  = rn17a2 * sc13
            1829                           rn192   = rn192 * sc13
            1830                           rn192_2 = rn192_2 * sc13
            1831                           rn232   = rn232 * sc13
            1832                           rn332   = rn332 * sc13
            1833                     
            1834                       END SUBROUTINE consat_s
            1835                     
            1836                     !JJS
            1837                     !JJS      REAL FUNCTION GAMMA(X)
            1838                     !JJS        Y=GAMMLN(X)
            1839                     !JJS        GAMMA=EXP(Y)
            1840                     !JJS      RETURN
            1841                     !JJS      END
            1842                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1843                     !JJS      real function GAMMLN (xx)
            1844                       real function gammagce (xx)
            1845                     !**********************************************************************
            1846                       implicit none
            1847                     
            1848                       real*8 cof(6),stp,half,one,fpf,x,tmp,ser
            1849                       data cof,stp /  76.18009173,-86.50532033,24.01409822, &
            1850                          -1.231739516,.120858003e-2,-.536382e-5, 2.50662827465 /
            1851                       data half,one,fpf / .5, 1., 5.5 /
            1852                     !
            1853                       real xx
            1854                       real gammln
            1855                       integer j
            1856                     
            1857                           x=xx-one
            1858                           tmp=x+fpf
            1859                           tmp=(x+half)*log(tmp)-tmp
            1860                           ser=one
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1861     1   s   fs            do  j=1,6
            1862     1   s   fs               x=x+one
            1863     1   m   fm              ser=ser+cof(j)/x
            1864     1   p   fv            enddo !j
            1865                           gammln=tmp+log(stp*ser)
            1866                     !JJS
            1867                           gammagce=exp(gammln)
            1868                     !JJS
            1869                     
            1870                      END FUNCTION gammagce
            1871                     
            1872                     !DIR$ ATTRIBUTES FORCEINLINE :: sgmap
            1873                       SUBROUTINE sgmap(isg,qcs,qcg,qcg2,qch,qch2,r00,tairc,ftnsg)
            1874                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1875                     ! compute base snow/graupel intercept scaling factor - ftnsg
            1876                     ! isg -- flag
            1877                     !        1 ftnsg=snow intercept scaling factor
            1878                     !        2 ftnsg=graupel intercept scaling factor
            1879                     !        3 ftnsg=snow density scaling factor
            1880                     ! tns is the actual intercept
            1881                     !
            1882                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1883                       IMPLICIT NONE
            1884                     
            1885                     !      common/size/ tnw,tns,tng,roqs,roqg,roqr  !defined in the beginning of the module
            1886                       integer, intent(in)  :: isg
            1887                     !  integer, intent(in)  :: i, j, k
            1888                     !  INTEGER, INTENT(IN)  :: ims,ime, jms,jme, kms,kme,  &
            1889                     !                          its,ite, jts,jte, kts,kte
            1890                       real,    intent(in)  :: r00, tairc
            1891                     !  real,    DIMENSION( ims:ime, jms:jme, kms:kme ), intent(in)  :: qcs,qcg, qch
            1892                     !  real,    DIMENSION( its:ite, jts:jte, kts:kte ), intent(in)  :: qcs,qcg, qch
            1893                       real,    intent(in)  :: qcs,qcg,qcg2,qch,qch2
            1894                       real,    intent(out) :: ftnsg
            1895                     
            1896                     
            1897                     ! LOCAL variables
            1898                     
            1899                     !!  for snomap
            1900                     !  real ::  xs,sno11,sno00,dsno11,dsno00,sexp11,sexp00,stt,   &
            1901                     !                stexp,sbase,tslopes,dsnomin,slim
            1902                     !!  for grpmap
            1903                     !  real ::  xg,grp11,grp00,dgrp11,dgrp00,gexp11,gexp00,gtt,   &
            1904                     !                gtexp,gbase,tslopeg,dgrpmin, glim
            1905                     
            1906                       real :: taird, qsg, qsg1, xx, fexp  !, cpi, cmin Di
            1907                       real :: ftnsT, sno1, dsno1, sexp1, ftnsQ, tnsmax, densno
            1908                       real :: ftngT, grp1, dgrp1, gexp1, ftngQ, tngmax
            1909                       real :: hx, gx, hgx
            1910                       real :: kk
            1911                       real :: hai2, dhai1
            1912                     !  CPI=4.*ATAN(1.)
            1913                     !  cmin=1.e-20  !4ice
            1914                     
            1915                       ftnsg=1.
            1916                     
            1917                     !  if (isg.eq.1.or.isg.eq.3) qsg=qcs(i,k,j)
            1918                     !  if (isg.eq.2.) qsg = qcg(i,k,j)
            1919                       if (isg.eq.1.or.isg.eq.3) qsg=qcs
            1920                     !NUWRF EMK...Fix options 2 and 4.
            1921                       if (isg.eq.2) qsg = qcg
            1922                       if (isg.eq.4) qsg = qch
            1923                     
            1924     1                 if (qsg .gt. cmin) then
            1925     1               
            1926     1                    qsg1=qsg*r00*1.e6
            1927     1               
            1928     1               !     if (isg.eq.1) then                          !snow
            1929     2                    if(isg.eq.1.or.isg.eq.3)then  !snow 4ice
            1930     2                       taird=min(0.,max(stt,tairc)+0.0)
            1931     2                       ftnsT=exp(-1.*tslopes*taird)
            1932     2                       sno1=sno11
            1933     2                       dsno1=dsno11
            1934     2                       sexp1=sexp11
            1935     2               
            1936     3                       if (taird.gt.stt) then
            1937     3                          sno1=sno00-(sno00-sno11)*(taird/stt)**stexp
            1938     3                          dsno1=dsno00-(dsno00-dsno11)*(taird/stt)**stexp
            1939     3                          sexp1=sexp00-(sexp00-sexp11)*(taird/stt)**stexp
            1940     3                       endif !taird
            1941     2               
            1942     2                         hx=0.
            1943     2                         gx=0.
            1944     2                         hgx=1.
            1945     2               
            1946     2                          if(qch2*1.e6*r00.gt.0.008)    &
            1947     2                             hx=max(1.,qch2*1.e6*r00*125.)
            1948     2                          if(qcg2*1.e6*r00.gt.0.040)    &
            1949     2                             gx=max(1.,qcg2*1.e6*r00*25.)
            1950     2                          hgx=hx+gx
            1951     2                          hgx=max(1.,hgx)
            1952     2               
            1953     2                       xx=xs-xs*min(slim,max(0.,(qsg1-sno1)/dsno1)**sexp1)
            1954     2                       ftnsT=ftnsT**xx
            1955     2                       fexp=xx
            1956     2                       ftnsQ=1.0
            1957     2                       ftnsQ=(qsg1/sbase)**fexp
            1958     2                       ftnsg=ftnsT*ftnsQ*hgx
            1959     2                       tnsmax=r00*qsg/dsnomin4
            1960     2               
            1961     2                       if (ftnsg*tns.gt.tnsmax) ftnsg=tnsmax/tns               !4ice
            1962     2               !        densno=0.004168*(ftnsg*tns/qsg/r00)**0.3115   !4ice Heymsfield et al. 2004
            1963     2                       densno=0.001996*(ftnsg*tns/qsg/r00)**0.2995   !Brandes et al. 2007
            1964     2                       if(isg.eq.3) ftnsg=min(densno,0.9)/roqs            !4ice
            1965     2               
            1966     2                    else if (isg.eq.2) then                      !graupel
            1967     2                           taird=min(0.,max(gtt,tairc)+0.0)
            1968     2                            ftngT=exp(-1.*tslopeg*taird)
            1969     2                            grp1=grp11
            1970     2                            dgrp1=dgrp11
            1971     2                            gexp1=gexp11
            1972     2               
            1973     3                            if (taird.gt.gtt) then
            1974     3                               grp1=grp00-(grp00-grp11)*(taird/gtt)**gtexp
            1975     3                               dgrp1=dgrp00-(dgrp00-dgrp11)*(taird/gtt)**gtexp
            1976     3                               gexp1=gexp00-(gexp00-gexp11)*(taird/gtt)**gtexp
            1977     3                            endif !taird
            1978     2               
            1979     2                            xx=xg-xg*min(glim,max(0.0,(qsg1-grp1)/dgrp1)**gexp1)
            1980     2                            ftngT=ftngT**xx
            1981     2                            fexp=xx
            1982     2                            ftngQ=1.0
            1983     2                            ftngQ=(qsg1/gbase)**fexp
            1984     2                            ftnsg=ftngT*ftngQ
            1985     2                            tngmax=r00*qsg/dgrpmin4
            1986     2                            if (ftnsg*tng.gt.tngmax) ftnsg=tngmax/tng
            1987     2               
            1988     2               	elseif(isg.eq.4)then  !hail
            1989     2                            hai2=hai00
            1990     2                            if(tairc.le.htt0.and.tairc.ge.htt1) &  !fin18
            1991     2                               hai2=hai11+(hai00-hai11)*((tairc-htt1)/(htt0-htt1))**haixp   !fin18
            1992     2                            if(tairc.le.htt1)  hai2=hai11     !fin18
            1993     2                               dhai1=hai2          !x2
            1994     2                            if(qsg1.ge.hai2)    &
            1995     2                               ftnsg=1.0-0.80*min(max((qsg1-hai2)/dhai1,0.),1.) !  fin16
            1996     2               
            1997     2                    endif !isg
            1998     1               
            1999     1                 endif !qsg
            2000                     
            2001                       end subroutine sgmap
            2002                     
            2003                     !     compute fall speed of cloud rain and ice
            2004                       SUBROUTINE vqrqi(isg,r00,fv,qri,ql,tair,ww1)
            2005                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2006                     ! compute fall speed of cloud rain and ice
            2007                     ! isg=1, for rain
            2008                     ! isg=2, for ice
            2009                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2010                       implicit none
            2011                     
            2012                       integer, intent(in) :: isg
            2013                       real, intent(in) :: r00, fv,qri,ql,tair
            2014                       real, intent(inout) :: ww1
            2015                     
            2016                     ! LOCAL variables
            2017                       integer :: ic
            2018                       real  :: y1,vr,vs,vg
            2019                       real  :: const_vt, const_d, const_m !cpi, cmin Di
            2020                       real  :: bb1, bb2,ice_fall
            2021                       real  :: bin_factor, ftnw, ftnwmin
            2022                       real, dimension(7) ::  aice, vice
            2023                       data aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./
            2024                       data vice/5,15,30,35,40,45,50/
            2025                     
            2026                     !  cmin=1.e-40
            2027                     !  CPI=4.*ATAN(1.)
            2028                          ice_fall=0.
            2029                          const_vt=1.49e4
            2030                          const_d=11.9
            2031                          const_m=1./5.38e7
            2032                     
            2033                       y1=r00*qri
            2034                       ww1=0.
            2035                     
            2036     1                 if (y1 .gt. cmin) then
            2037     1               
            2038     2                   if (isg.eq.1) then                             !  rain
            2039     2               
            2040     2                      ftnw=1.
            2041     3                          if(ql.lt.cmin .and. tair .gt. t0)then
            2042     3                            bin_factor=0.11*(1000.*qri)**(-1.27) + 0.98
            2043     3                            bin_factor=min(bin_factor, 1.30)
            2044     3                            ftnw=1./bin_factor**3.35
            2045     3                            ftnwmin=r00*qri/draimax
            2046     3                            if(qri.le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            2047     3                          endif
            2048     2               
            2049     2                              vs=sqrt( y1 )
            2050     2                              vg=sqrt( vs)
            2051     2               !               vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
            2052     2                              vr=vrc0+vrc1*vg/ftnw**0.25+vrc2*vs/ftnw**0.50+vrc3*vg*vs/ftnw**0.75
            2053     2                              ww1=max(fv*vr, 0.e0)
            2054     2               
            2055     2               
            2056     2                   else if (isg.eq.2) then                         ! cloud ice
            2057     2               
            2058     2                           y1=1.e6*r00*qri                            ! to g/m**3
            2059     2               
            2060     3                           if (y1 .gt. 1.e-6) then
            2061     3                                 y1=y1*1.e-3
            2062     3                                 bb1=const_m*y1**0.25
            2063     3                                 bb2=const_d*bb1**0.5
            2064     3                                 ww1=max(const_vt*bb2**1.31, 0.0)
            2065     3                                 ww1=ww1*100. !cm/s
            2066     3                                 if (ww1 .gt. 50.) ww1=50.               ! SLang
            2067     3                           endif  !y1
            2068     2                   endif  !isg
            2069     1                 endif !y1
            2070                     
            2071                       end subroutine vqrqi
            2072                     
            2073                       SUBROUTINE saticel_s (dt, dx, itaobraun, istatmin,                   &
            2074                                            new_ice_sat, id, improve,                       &
            2075                                            ptwrf, qvwrf, qlwrf, qrwrf,                     &
            2076                                            qiwrf, qswrf, qgwrf, qhwrf,                     &

            3528     2   s    s               psacr(i)=min(y1(i), psacr(i))
            3529     2   s    s               pgfr(i)= min(y1(i), pgfr(i))
            3530     2   s    s               phfr(i)= min(y1(i), phfr(i))
            3531     2   p    v               del=0.

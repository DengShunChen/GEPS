             473     4   p    v                  ql2d(ic,k) = ql(i,k,j)
             474     4   p    v                  qr2d(ic,k) = qr(i,k,j)
             475     4   p    v                  qi2d(ic,k) = qi(i,k,j)
             476     4   p    v                  qs2d(ic,k) = qs(i,k,j)
             477     4   p    v                  qg2d(ic,k) = qg(i,k,j)
             478     4   p    v                  qh2d(ic,k) = qh(i,k,j)
             479     4   p    v                  rho2d(ic,k) = rho(i,k,j)
             480     4   p    v                  pii2d(ic,k) = pii(i,k,j)
             481     4   p    v                  p2d(ic,k) = p(i,k,j)
             482     4   p    v                  w2d(ic,k) = w(i,k,j)
             483     4   p    v                  refl_10cm2d(ic,k)=refl_10cm(i,k,j)

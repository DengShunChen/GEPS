            4757                      SUBROUTINE Find_NaN_Inf_Double(Warning_MSG, real_input, i_in,j_in,k_in)
            4758                      implicit none
            4759                     
            4760                      real,intent(inout) :: real_input  !anykind of Non-dimensional input Real parameters
            4761                      integer,intent(in) :: i_in, j_in, k_in
            4762                      character*(*),intent(in) :: Warning_MSG
            4763                     
            4764                     !
            4765                     ! Find Infinity
            4766                     !
            4767                     !if( exp(-abs(real_input)) == 0.) then ! this formulae is bit slow
            4768                     
            4769     1                if( 1e+10/real_input == 0. ) then
            4770     1                   print*,'MSG Find_NaN_Inf: '//Warning_MSG//'Infinity at',i_in,j_in,k_in
            4771     1                   real_input = 0.
            4772     1                   return
            4773     1                endif
            4774                     
            4775                     !
            4776                     ! Find NaN
            4777                     !
            4778     1                if( real_input==0. .or. real_input>0. .or. real_input<0. .or. real_input>=0. .or. real_input<=0. ) then
            4779     1                else
            4780     1                   print*,'MSG Find_NaN_Inf: '//Warning_MSG//'NaN at',i_in,j_in,k_in
            4781     1                   real_input = 0.
            4782     1                   return
            4783     1                endif
            4784                     
            4785                      END SUBROUTINE Find_NaN_Inf_Double

            3660     3   s    s                 qs(i)=qs(i)-psmlt(i)
            3661     3   s    s                 qg(i)=qg(i)-pgmlt(i)
            3662     3   s    s                 qh(i)=qh(i)-phmlt(i)
            3663     3               
            3664     3   p    v               endif !tair  ! processes 11 & 19
            3665     2               !
            3666     2               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            3667     2               !* 24 * PIHOM : HOMOGENEOUS FREEZING OF QC TO QI (T < T00)        **24**
            3668     2               !* 25 * PIDW : DEPOSITION GROWTH OF QC TO QI ( T0 < T <= T00)     **25**
            3669     2               !* 26 * PIMLT : MELTING OF QI TO QC (T >= T0)                     **26**
            3670     2               !****** PIMM  : IMMERSION FREEZING OF QC TO QI (T < T0)           ******
            3671     2               !****** PCFR  : CONTACT NUCLEATION OF QC TO QI (T < T0)           ******
            3672     2               
            3673     2   p    s             if (qc(i).le.cmin1) qc(i)=0.0
            3674     2   p    m             if (qi(i).le.cmin1) qi(i)=0.0
            3675     2               
            3676     2   m    m             ftns(i)=1.
            3677     2   s    s             ftng(i)=1.
            3678     2   s    s             ftns0(i)=1.
            3679     2   s    s             ftng0(i)=1.
            3680     2               
            3681     2   s    s             qhz2=qhwrf(i,k)
            3682     2   s    s             qgz2=qgwrf(i,k)
            3683     3   m    s             if (k .lt. kte-2 .and. tairc(i) .ge. -5) then
            3684     3   s    s               qhz2=qhwrf(i,k+1)
            3685     3   s    s               qgz2=qgwrf(i,k+1)
            3686     3   p    v             endif
            3687     2   s    s             call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            3688     2   s    s             call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            3689     2               
            3690     3   m    s             if (tair(i).le.t00) then
            3691     3   p    s                pihom(i)=qc(i)
            3692     3   p    s             else
            3693     3   p    s                pihom(i)=0.0
            3694     3   p    v             endif
            3695     3   m    s             if (tair(i).ge.t0) then
            3696     3   p    s                pimlt(i)=qi(i)
            3697     3   p    s             else
            3698     3   p    s                pimlt(i)=0.0
            3699     3   p    v             endif
            3700     2   p    v             pidw(i)=0.0
            3701     2               
            3702     3   s    s                if (tair(i) .lt. t0 .and. tair(i) .gt. t00) then
            3703     3   s    s                  TAIRC(i)=TAIR(i)-T0
            3704     3   m    s                   y1(i) = max( min(tairc(i), -1.), -31.)
            3705     3   s    s                   it(i) = int(abs(y1(i)))
            3706     3   s    s                   y2(i)=aa1(it(i))
            3707     3   s    s                   y3(i) = aa2(it(i))
            3708     4   s    s                   if (tairc(i).le.-5.)then                       !  meyers
            3709     4   s    s                      rtair(i)=1./(tair(i)-c76)
            3710     4   s    s                      y5(i)=exp(c218-c580*rtair(i))
            3711     4   s    s                      qsi(i)=rp0(i)*y5(i)
            3712     4   p    s                      SSI(i)=(qv(i)+qb0)/qsi(i)-1.
            3713     4   p    s                      fssi=min(xssi,max(rssi,xssi*(tairc(i)+44.)/(44.0-38.0))) !max ssi f(tair)
            3714     4   p    s                      fssi=rssi
            3715     4   p    s                      wssi=ww1(i,k)/100.-2.0
            3716     4   p    s                      if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3717     4   p    s                      fssi=min(ssi(i),fssi)
            3718     4               
            3719     4   p    s                      r_nci=max(1.e-3*exp(-.639+12.96*fssi), 0.528e-3)      ! meyers et al.
            3720     4                                                                                     ! Roger found the bug on 2012/04/27
            3721     4   p    s                      if (r_nci.gt.15.) r_nci=15.                          !cap at 15000/liter
            3722     4               
            3723     4               ! Cooper curve
            3724     5   p    s                    if( tairc(i) .lt. -40.0 ) then
            3725     5   p    s                      c_nci = 5.0e-6*exp(0.304*40.0)
            3726     5   p    s                    else
            3727     5   p    s                      c_nci = 5.0e-6*exp(0.304*abs(tairc(i)))
            3728     5   s    s                    end if
            3729     4   s    s                    r_nci = c_nci
            3730     4               ! JDC cap r_nci to the amount corresponding to crystal size of ami50
            3731     4   m    s                    r_nci = max(r_nci,r00(i)*qi(i)/ami50)
            3732     4               
            3733     4               #if (WRF_CHEM == 1)
            3734     4                               ! EMK...Only execute if GOCART and coupling is on
            3735     4                               if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            3736     4                                     chem_opt == 302 .or. chem_opt == 303) .and. &
            3737     4                                     (gsfcgce_gocart_coupling == 1) ) then
            3738     4                                  !JJS 20110602 vvvvv
            3739     4                                  ! Conversion rate of cloud water to ice in the Bergeron porcess based on Meyer + DeMott formulae
            3740     4                                  !
            3741     4                                  ! convert gocart aerosol mass conc to IN
            3742     4                                  !      p0 need to be converted from g*cm/s2/cm2 to mb (hPa)
            3743     4                                  !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out)
            3744     4                                  !                icn_cgs(i,k) = max(min_icn, icn_out) * 1.e-3   !IN conc [#/cm3] <-- [#/Litter]
            3745     4                                  !                icn_cgs(i,k) = icn_out * 1.e-3 !IN conc [#/cm3]
            3746     4                                  !                r_nci = icn_cgs(i,k)  !DeMotto's formuale
            3747     4                                  r_nci = icn_out(i) * 1.e-3  !DeMotto's formuale
            3748     4                                  !JJS 20110602 ^^^^^
            3749     4                               end if
            3750     4               #endif
            3751     4               
            3752     4   p    s                      dd(i)=(r00(i)*qi(i)/r_nci)**y3(i)                  !meyers
            3753     4   p    s                      PIDW(i)=min(rr0(i)*D2T*y2(i)*r_nci*dd(i), qc(i)) !meyers
            3754     4               
            3755     4               ! JDC water vapor diffusivity correction term
            3756     4   s    s                       esi(i)  = qsi(i)/rp0(i)*c610
            3757     4   s    s                       y4(i)   = 1./tair(i)
            3758     4               !                term1     = y4(i)*(rn10a*y4(i)-rn10b)
            3759     4   m    s                       term1     = y4(i)*(rn20a*y4(i)-rn20b)
            3760     4   m    s                       term2     = rn10c*tair(i)/esi(i)
            3761     4   p    s                       fdwv      = (term1+term2)/(term1+term2*dwv0/dwv(i))
            3762     4   p    s                    PIDW(i)=min(rr0(i)*D2T*y2(i)*r_nci*dd(i)*fdwv,qc(i)) !meyers
            3763     4   s    s               endif  !tairc
            3764     3               
            3765     3   p    s                   pimm(i)=0.0
            3766     3   s    s                   pcfr(i)=0.0
            3767     3               
            3768     4   s    s                   if (qc(i) .gt. 0.0) then
            3769     4   s    s                      y4(i) = 1./(tair(i)-c358)
            3770     4   s    s                      qsw(i)=rp0(i)*exp(c172-c409*y4(i))
            3771     4   s    s                      xncld=qc(i)/4.e-9                         !cloud number
            3772     4   p    s                      esat=0.6112*exp(17.67*tairc(i)/(tairc(i)+243.5))*10.
            3773     4   p    s                      rv=0.622*esat/(p0(i,k)/1000.-esat)
            3774     4   p    s                      rlapse_m=980.616*(1.+2.5e6*rv/287./tair(i))/          &
            3775     4                                      (1004.67+2.5e6*2.5e6*rv*0.622/(287.*tair(i)*tair(i)))
            3776     4   p    s                      delT=rlapse_m*ww1(i,k)                     !Roger
            3777     4   p    s                      if (delT.lt.0.) delT=0.
            3778     4   s    s                      Bhi=1.01e-2
            3779     4   p    s                      pimm(i)=xncld*Bhi*4.e-9*exp(-tairc(i))*delT*d2t*4.e-9
            3780     4               
            3781     4   s    s                      xccld=xncld*r00(i)                           !cloud number concentration
            3782     4   p    s                      Xknud=7.37*tair(i)/(288.*Ra*p0(i,k))  ! Knudsen number
            3783     4   p    s                      alpha=1.257+0.400*exp(-1.10/Xknud)     ! Cunningham correction (P&Klett)
            3784     4               
            3785     4   p    s                      cunnF=1.+alpha*Xknud                   ! Cunningham correction (P&Klett)
            3786     4               
            3787     5   s    s                      if (tairc(i).ge.0.) then
            3788     5   m    s                          dvair=(1.718+0.0049*tairc(i))*1.e-4
            3789     5                                      !dynamic visc air (Prupp&Klett)
            3790     5   s    s                      else
            3791     5   m    s                          dvair=(1.718+0.0049*tairc(i)-1.2e-5*tairc(i)**2)*1.e-4
            3792     5                                      !dynamic visc air (Prupp&Klett)
            3793     5   s    s                      endif !tairc
            3794     4   m    s                      DIFFar=1.3804e-16*tair(i)/6./cpi/dvair/Ra*cunnF     !aerosol diffusion via P&Klett
            3795     5   s    s                      if (qv(i)+qb0-qsw(i).lt.0.) then                       !only when cloud evaporating
            3796     5   m    s                      pcfr(i)=4.e-9*4.*cpi*Rc*DIFFar*xccld*Cna*rr0(i)*d2t    !Brownian part only via Cotton
            3797     5   p    s                      endif
            3798     4   s    s                   else  !qc
            3799     4   s    s                      tairc(i)=tair(i)-t0
            3800     4   p    s                      y1(i)=max( min(tairc(i), -1.), -31.)
            3801     4   s    s                      it(i)=int(abs(y1(i)))
            3802     4   s    s                      y2(i)=aa1(it(i))
            3803     4   p    s                      y3(i)=aa2(it(i))
            3804     4   p    s                      y4(i)=exp(abs(.5*tairc(i)))
            3805     4   m    s                      dd(i)=(r00(i)*qi(i)/(r25a*y4(i)))**y3(i)
            3806     4   p    s                      pidw(i)=min(r25rt(i)*y2(i)*y4(i)*dd(i),qc(i))
            3807     4   p    s                   endif  !qc
            3808     3   p    v                endif  !tair
            3809     2               
            3810     2   p    m              ENDDO
            3811     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)

            2904     2   s    s                ftnh(i)=1.
            2905     2   s    s      	  ftns(i)=ftns0(i)
            2906     2   s    s      	  ftng(i)=ftng0(i)
            2907     2               
            2908     3   s    s                if (tair(i).lt.t0) then
            2909     3               
            2910     3   s    s                   rn1=1./300.
            2911     3   p    s                   bnd1=6.e-5
            2912     3   p    s                   esi(i)=0.25
            2913     3   m    s                   psaut(i)=r2is*max(rn1*esi(i)*(qi(i)-bnd1*fv0(i)*fv0(i)) ,0.0)
            2914     3   s    s                   ftns(i)=ftns0(i)
            2915     3   s    s                   ftng(i)=ftng0(i)
            2916     3   s    s                   fros(i)=fros0(i)
            2917     3   m    s                   ftnh(i)=ftnh0(i)
            2918     3   s    s                   esi(i)=1.0 !esi constant in consatrh via r3f/rn3; use esi( ) to make f(T)/f(q)
            2919     3   m    s                   dmicrons=(r00(i)*qs(i)/(roqs*fros(i))/cpi/(tns*ftns(i)))**.25*1.e4
            2920     3   p    s                   esi(i)=min(1.,(dmicrons/375.)**3.) ! f(dmicrons)
            2921     3               
            2922     3   s    s                   y1(i)=1.0
            2923     3   s    s                   if (vs(i).gt.0.) y1(i)=abs((vs(i)-vi(i))  &
            2924     3                                                                /vs(i))
            2925     3   m    s                   psaci(i)=r2is*y1(i)*r3f(i)*qi(i)/zs(i)**bs3*ftns(i)*esi(i)
            2926     3   p    s                   if(qs(i).le.cmin) psaci(i)=0.
            2927     3   m    s                   psacw(i)=r2is*r4f(i)*qc(i)/zs(i)**bs3*ftns(i)
            2928     3   p    s                   if(qs(i).le.cmin) psacw(i)=0.
            2929     4   m    s                   if (ihalmos.eq.1)then
            2930     4   p    s                      y2(i)=0.
            2931     4   m    s                      if((tairc(i).le.hmtemp1).and.(tairc(i).ge.hmtemp4))  &
            2932     4                                                                        y2(i)=0.5
            2933     4   p    s                      if((tairc(i).le.hmtemp2).and.(tairc(i).ge.hmtemp3))  &
            2934     4                                                                        y2(i)=1.
            2935     4   m    s                      pihms(i)=r2ih*psacw(i)*y2(i)*xnsplnt*1000.*xmsplnt
            2936     4   p    s                      psacw(i)=psacw(i)-pihms(i)
            2937     4   p    s                   endif
            2938     3   m    s                   pwacs(i)=r2is*r34f(i)*qc(i)/zs(i)**bs6*ftns(i)*fros(i)      !improve4
            2939     3   p    s                   if(qs(i).le.cmin) pwacs(i)=0.
            2940     3   m    s                   y1(i)=1./zr(i)
            2941     3   m    s                   y2(i)=y1(i)*y1(i)
            2942     3   s    s                   y3(i)=y1(i)*y2(i)
            2943     3   s    s                   y5(i)=1.0
            2944     3   s    s                   if (vr(i).gt.0.) y5(i)=abs((vr(i)-vi(i))   &
            2945     3                                                                        /vr(i))
            2946     3   m    s                   dd(i)=y5(i)*r5f(i)*qi(i)*y3(i)*(rn50+rn51*y1(i)             &
            2947     3                                                       +rn52*y2(i)+rn53*y3(i))
            2948     3   p    s                   praci(i)=max(dd(i),0.0)
            2949     3   p    s                   if (qr(i) .le. cmin) praci(i)=0.
            2950     3   m    s                   y4(i)=y3(i)*y3(i)
            2951     3   m    s                   dd1(i)=y5(i)*r6f(i)*qi(i)*y4(i)*(rn60+rn61*y1(i)       &
            2952     3                                                    +rn62*y2(i)+rn63*y3(i))
            2953     3               
            2954     3   p    s                   piacr(i)=max(dd1(i),0.0)
            2955     3   p    s                   if (qr(i) .le. cmin) piacr(i)=0.
            2956     3   s    s                else
            2957     3   m    s                   qsacw(i)=r2is*r4f(i)*qc(i)/zs(i)**bs3*ftns(i)
            2958     3   p    s                   if (qs(i) .le. cmin) psacw(i)=0.
            2959     3   p    v                endif   !tairc
            2960     2               
            2961     2               
            2962     2               !23456789012345678901234567890123456789012345678901234567890123456789012
            2963     2               !* 21 * PRAUT   AUTOCONVERSION OF QC TO QR                        **21**
            2964     2               !* 22 * PRACW : ACCRETION OF QC BY QR                             **22**
            2965     2               
            2966     2               #if (WRF_CHEM == 1)
            2967     2               !JJS 20110602 vvvvv
            2968     2                            ! EMK...Only execute when GOCART and coupling are selected
            2969     2                            if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            2970     2                                  chem_opt == 302 .or. chem_opt == 303) .and. &
            2971     2                                  (gsfcgce_gocart_coupling == 1) ) then
            2972     2                               !      sat vapor pressure [hPa,mb]
            2973     2                               e_sat = 6.11 * exp( 5423. *( 1.0/273.15 - 1./tair(i) ) )
            2974     2                               !      dry air vapor pressure [hPa, mb]
            2975     2                               e_dry = qv(i) / ( qv(i) + 0.622 ) * p0(i,k) * 1.e-3  ! p0 in [g*cm/s2/cm2]
            2976     2                               rh_rad = max(1.e-6, e_dry/e_sat*100.)  ! relative humidity [%]
            2977     2                               super_sat = max(0.001, rh_rad - 100.e0) !super saturation [%]
            2978     2                               !
            2979     2                               ! convert gocart aerosol mass conc to CN
            2980     2                               !
            2981     2                               call mass2ccn(tair(i),super_sat,aero(i,k,:),ccn_out(i) )
            2982     2                               !             nc_cgs(i,k)  = max(100., ccn_out)  !diagnostic cloud droplet conc  [#/cm3]
            2983     2                               ccn_out(i) = max(100., ccn_out(i))
            2984     2               
            2985     2               !                rho_dryair = p0(i,k) / ( tair(i) * 2.87 * 1.0e6) ! dry air density [g/cm3]
            2986     2                               L_cloud = qc(i) * rho(i,k)             ! cloud water [g/cm3]
            2987     2                               !  g/g        g/cm3
            2988     2                               !             call auto_conversion( L_cloud, nc_cgs(i,k), P_liu_daum, re_liu_daum )
            2989     2                               call auto_conversion( L_cloud, ccn_out(i), P_liu_daum, re_liu_daum )
            2990     2               
            2991     2                               praut(i) = P_liu_daum / rho(i,k)  !autoconversion rate [g/g s-1]
            2992     2                            else
            2993     2                               praut(i)=max(rn21*(qc(i)-bnd21),0.0)
            2994     2                            end if ! if (gsfcgce_gocart_coupling == 1)
            2995     2               #else
            2996     2   m    m                   praut(i)=max(rn21*(qc(i)-bnd21),0.0)
            2997     2               !JJS 20110602 ^^^^^
            2998     2               #endif
            2999     2               
            3000     2   m    m                   y1(i)=1./zr(i)
            3001     2   m    m                   y2(i)=y1(i)*y1(i)
            3002     2   s    s                   y3(i)=y1(i)*y2(i)
            3003     2   m    m                   y4(i)=r22f(i)*qc(i)*y3(i)*(rn50+rn51*y1(i)+  &
            3004     2                                    rn52*y2(i)+rn53*y3(i))
            3005     2   p    v                   pracw(i)=max(y4(i), 0.0)
            3006     2   p    s                if(qr(i) .le. cmin) pracw(i)=0.
            3007     2               
            3008     2               !* 12 * PSFW : BERGERON PROCESSES FOR QS (KOENING, 1971)          **12**
            3009     2               !* 13 * PSFI : BERGERON PROCESSES FOR QS                          **13**
            3010     2               
            3011     2   p    v                pidep(i)=0.0
            3012     2   p    v                psfw(i)=0.0
            3013     2   p    v                psfi(i)=0.0
            3014     2               
            3015     2   p    m              ENDDO
            3016     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tair, tairc, qi, y1, y2, psfw, y5, rp0
                                   <<<      qv, dwv, r00, fv0, psfi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 4  FILL 23
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
            3017     2  pp    v              DO i=1,irestrict
            3018     2               
            3019     3   p    v                  if (tair(i) .lt. t0) then
            3020     3   p    v                     y1(i)=max( min(tairc(i), -1.), -31.)
            3021     3   p    v                     it(i)=int(abs(y1(i)))
            3022     3   p    v                     y1(i)=rn12a(it(i))
            3023     3   p    v                     y2(i)=rn12b(it(i))
            3024     3   p    v                     y3(i)=rn13(it(i))
            3025     3   p    v                     psfw(i)=r2is*max(d2t*y1(i)*(y2(i)+r12r(i)*qc(i))*  &
            3026     3                                           qi(i), 0.0)
            3027     3   p    v                     psfi(i)=r2is*y3(i)*qi(i)
            3028     3               !
            3029     3   p    v                     y4(i)=1./(tair(i)-c358)
            3030     3   p    v                     y5(i)=1./(tair(i)-c76)
            3031     3   p    v                     qsw(i)=rp0(i)*exp(c172-c409*y4(i))
            3032     3   p    v                     qsi(i)=rp0(i)*exp(c218-c580*y5(i))
            3033     3   p    v                     hfact=(qv(i)+qb0-qsi(i))/(qsw(i)-qsi(i)+cmin1)
            3034     3                                   ! add cmin1 to prevent overflow of hfact
            3035     3   p    v                     if(hfact.gt.1.) hfact=1.
            3036     3   p    v                     sfact=1
            3037     3   p    v                     SSI(i)=(qv(i)+qb0)/qsi(i)-1.
            3038     3               
            3039     3   p    v                     fssi=min(xssi,max(rssi,xssi*(tairc(i)+44.)/(44.0-38.0)))  !improve4 max ssi f(tair)
            3040     3   p    v                     fssi=rssi
            3041     3   p    v                     wssi=ww1(i,k)/100.-2.0
            3042     3   p    v                     if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3043     3   p    v                     fssi=min(ssi(i),fssi)
            3044     3               
            3045     3               !  STEVE : PLEASE CHECK
            3046     4   p    v                     if (tairc(i).le.-5.) then                         !meyers
            3047     4   p    v                        r_nci=max(1.e-3*exp(-.639+12.96*fssi),0.528e-3)  !meyers et al.
            3048     4   p    v                     else
            3049     4   p    v                        r_nci=min(1.e-3*exp(-.639+12.96*fssi),0.528e-3)  !meyers et al.
            3050     4   p    v                     endif  !tairc
            3051     3               
            3052     3   p    v                     if (r_nci.gt.15.) r_nci=15.                  !cap at 15000/liter
            3053     3               
            3054     3               ! Cooper curve
            3055     4   p    v                     if( tairc(i) .lt. -40.0 ) then
            3056     4   p    v                       c_nci = 5.0e-6*exp(0.304*40.0)
            3057     4   p    v                     else
            3058     4   p    v                       c_nci = 5.0e-6*exp(0.304*abs(tairc(i)))
            3059     4   p    v                     end if
            3060     3   p    v                     r_nci = c_nci
            3061     3               ! JDC cap r_nci to the amount corresponding to crystal size of ami50
            3062     3   p    v                     r_nci = max(r_nci,r00(i)*qi(i)/ami50)
            3063     3               
            3064     3               #if (WRF_CHEM == 1)
            3065     3                              ! EMK...Only execute when GOCART and coupling is turned on.
            3066     3                              if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            3067     3                                    chem_opt == 302 .or. chem_opt == 303) .and. &
            3068     3                                    (gsfcgce_gocart_coupling == 1) ) then
            3069     3                                 !JJS 20110602 vvvvv
            3070     3                                 ! Conversion rate of cloud water to ice in the Bergeron porcess based on Meyer + DeMott formulae
            3071     3                                 !
            3072     3                                 ! convert gocart aerosol mass conc to IN
            3073     3                                 !      p0 need to be converted from g*cm/s2/cm2 to mb (hPa)
            3074     3                                 !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out)
            3075     3               !                  call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out,i,k)
            3076     3                                 ! EMK...mass2icn requires i,j,k indices, but only prints
            3077     3                                 ! the values when an error occurs.  In no case are the i,j,k
            3078     3                                 ! used to access a value in an array.
            3079     3                                 ! We will simply pass a bogus value of j=1 in the call
            3080     3                                 ! below.
            3081     3                                 call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out(i),&
            3082     3                                      i,1,k)
            3083     3               
            3084     3                                 icn_out(i) = min(1.e3, max(0.01e0 ,  icn_out(i)) )
            3085     3                                 r_nci = icn_out(i) * 1.e-3  !DeMotto's formuale
            3086     3                                 !JJS 20110602 ^^^^^
            3087     3                              end if ! if (gsfcgce_gocart_coupling == 1)
            3088     3               #endif
            3089     3               
            3090     3   p    v                     dd(i)=min((r00(i)*qi(i)/r_nci), ami40)   !mean cloud ice mass
            3091     3   p    v                     yy1=1.-aa2(it(i))
            3092     3   p    v                     sfact=(AMI50**YY1-AMI40**YY1)/(AMI50**YY1-dd(i)**YY1)
            3093     3               
            3094     3               !JDC water vapor diffusivity correction term
            3095     3   p    v                     esi(i)  = qsi(i)/rp0(i)*c610
            3096     3   p    v                     y3(i)   = 1./tair(i)
            3097     3               !               term1     = y3(i)*(rn10a*y3(i)-rn10b)
            3098     3   p    v                     term1     = y3(i)*(rn20a*y3(i)-rn20b)
            3099     3   p    v                     term2     = rn10c*tair(i)/esi(i)
            3100     3   p    v                     dd(i)   = term1+term2
            3101     3   p    v                     fdwv      = dd(i)/(term1+term2*dwv0/dwv(i))
            3102     3   p    v                     psfw(i) = max( d2t*y1(i)*fdwv*(y2(i)*fdwv   &
            3103     3                                              + r12r(i)*qc(i))*qi(i),0.0 )
            3104     3               
            3105     3   p    v                     psfw(i)=0.0
            3106     3               
            3107     4   p    v                     if (hfact.gt.0.) then
            3108     4   p    v                        psfi(i)=r2is*psfi(i)*hfact*sfact*fdwv
            3109     4   p    v                     else
            3110     4   p    v                        psfi(i)=0.
            3111     4   p    v                     endif !hfact
            3112     3               
            3113     3   p    v                     if(qi(i).le.1.e-5*fv0(i)*fv0(i)) psfi(i)=0.0
            3114     3               
            3115     3   p    v                  endif   !tair
            3116     2               
            3117     2   p    v              ENDDO

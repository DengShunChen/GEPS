            2570     2                             (gsfcgce_gocart_coupling == 1) ) then
            2571     2                          icn_diag(i,k) = icn_out(i)  ! #/Litre
            2572     2                          nc_diag(i,k) = ccn_out(i)  ! #/cm3
            2573     2                       else
            2574     2                          icn_diag(i,k) = 0.
            2575     2                          nc_diag(i,k) = 0.
            2576     2                       end if

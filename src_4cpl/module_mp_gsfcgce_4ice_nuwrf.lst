            4961                     
            4962                     !JJS 20140225
            4963                     ! Calculate cloud droplet effective radius
            4964                        real function eff_rad(lambda)
            4965                     
            4966                     #ifndef NO_IEEE_MODULE
            4967                           use, intrinsic :: ieee_arithmetic
            4968                     #endif
            4969                           implicit none
            4970                     
            4971                     !---------------------------------------------------------------------------------------------------
            4972                     ! Comments:
            4973                     ! Compute drop effective radius from slope parameters (lambda) of expoential size distribution.
            4974                     !
            4975                     ! History:
            4976                     ! 02/2014  Toshi Matsui@NASA GSFC ; Initial
            4977                     !
            4978                     ! References:
            4979                     !----------------------------------------------------------------------------------------------------
            4980                           real,intent(in)  :: lambda   ! intercept parameter [1/cm]
            4981                     
            4982                     !
            4983                     ! for no particles.
            4984                     !
            4985                     #ifndef NO_IEEE_MODULE
            4986     1                      if ( lambda <= 0.e0  .or. ieee_is_nan(lambda) ) then
            4987     1               #else
            4988     1                      if ( lambda <= 0.e0                           ) then
            4989     1               #endif
            4990     1                         eff_rad = 0.e0
            4991     1                         return
            4992     1                      endif
            4993                     
            4994                     !
            4995                     ! compute drop effective radius for exponential distribution N(D) = N0*exp(-lam*D)
            4996                     !
            4997                            eff_rad = 1.5e0 / (lambda*100.) * 1.0e+6  ! [micron]
            4998                     
            4999                        end function eff_rad
            5000                     
            5001                     END MODULE  module_mp_gce4ice

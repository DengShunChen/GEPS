                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, t850
                                   <<< Loop-information  End >>>
             313     1  pp   2v            do i=1,nxj
             314     1   p   2v            t850(i)=tt(i,lev)
             315     1   p   2v            enddo
             316                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkx, tt, t850
                                   <<< Loop-information  End >>>
             317     1                     do k=lev,2,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

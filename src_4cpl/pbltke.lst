                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.90, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkx, tt, t850
                                   <<< Loop-information  End >>>
             318     2  pp    v            do i=1,nxj
             319     2   p    v            ppd = pkx(i,k)*1000.
             320     2   p    v            ppu = pkx(i,k-1)*1000.
             321     2   p    v            ddd = (p850-ppd)*(p850-ppu)
             322     3   p    v              if( ddd .lt. 0. )then
             323     3   p    v               cc=(log(p850/ppd))/(log(ppu/ppd))
             324     3   p    v               t850(i)=(tt(i,k-1)-tt(i,k))*cc+tt(i,k)
             325     3   p    v              endif
             326     2   p    v            enddo
             327     1                     enddo
             328                     !
             329                     !soil......................................
             330                     !
             331                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             332                     !                                                                      c
             333                     !     change tt and tg from temp to potential temp                     c
             334                     !                                                                      c
             335                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

             342                     ! 250 continue
             343                     !soil
             344                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             345                     !                                                                      c
             346                     !     surface layer parameterization:                                  c
             347                     !     compute surface fluxes and save the surafce fluxex as            c
             348                     !     lower boundary cond for implicit time integration in mixpbl      c
             349                     !                                                                      c
             350                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             351                     !
             352                     ! soil
             353                     !
             354                           call landsfc( nxj,nx,lev,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt,u,v &
             355                                      , t,q,ut,vt,tt,qt,sfcw,ustar,tstar,qstar,e,eps,hflux   &
             356                                      , qflux,zl,itype                                       &
             357                                      , alb,ss,rld,stbo,pk,pk2,gfx                           &
             358                                      , km,snr,smc,stc,canopy,sigmaf,istyp,ice,land          &
             359                                      , tgclim,rhscnpy,rhsmc,aim,bim,cim,drain,snomt         &

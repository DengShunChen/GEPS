                                   <<< Loop-information  End >>>
             363     1  pp    v            do i=1,nxj
             364     2   p    v             if(t850(i).gt.273.16)then
             365     2   p    v               gesh(i)=1.
             366     2   p    v             else
             367     2   p    v               gesh(i)=0.
             368     2   p    v             endif
             369     2   p    v             if(.not.ocean(i))then

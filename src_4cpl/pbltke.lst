                                   <<<      phi, pkx, ro2
                                   <<< Loop-information  End >>>
             289     1  pp                 do 130 k = 1, lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkx, phi, ro2
                                   <<< Loop-information  End >>>
             290     2   p   2v            do 130 i = 1, nxj
             291     2   p   2v            ppu = pkx(i,k)*1000.
             292     2   p   2v            ppd = pkx(i,k+1)*1000.
             293     2   p   2v            ro2(i,k) = ( ppd - ppu ) * 100. / ( phi(i,k) - phi(i,k+1) )
             294     1   p   2v        130 continue
             295                     !
             296                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             297                     !                                                                      c
             298                     !     determine ground condition and predict ghround temp and wetness  c
             299                     !                                                                      c
             300                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             301                     !
             302                     !
             303                           dth = dt
             304                     !
             305                     !                                                                      c
             306                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
             307                     !
             308                     !
             309                     ! soil ....................................
             310                     !        to get environment temp at 850mb
             311                     !
             312                           p850=850.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

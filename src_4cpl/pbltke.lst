 External subroutine subprogram "pbltke"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine pbltke ( nxj,nx,lev                                    &
               2                                             , ktpbl,dt,g,r,cp,xkapa,hltm,ptop,tice          &
               3                                             , hice,tg,z0,land,topo,phi,pss,u,v,t,q,ut       &
               4                                             , vt,tt,qt,pk,pk2,ustar,tstar,qstar,e,eps,hflux &
               5                                             , qflux,gwclim,tgclim,ocean,ice,snr             &
               6                                             , totalp,ss,rs,alb,imx,xkmx,idg,xkmd,itype      &
               7                                             , t2,rh2,u10,v10                                &
               8                                             , rld,stbo                                      &
               9                                             , km,smc,stc,canopy,runoff,sigmaf,istyp,ivegtyp &
              10                                             , wlt,ref,tsat,dfkt,xktk,dfk)
              11                     !
              12                     !#######################################################################
              13                     !                     subroutine description
              14                     !
              15                     ! 1. function description
              16                     !
              17                     !       this subroutine is the driver of multilayer pbl calculation
              18                     !       to compute surface fluxes and vertical mixing due to eddies.
              19                     !       the surface layer calculation follows businger (1973)
              20                     !       and the eddy mixing coef calculation follows
              21                     !       detering and elting (1984)
              22                     !       (use ustar, tstar and qstar as lower b.c. for u,v,t,q update)
              23                     !
              24                     ! 2. parameter specification
              25                     !
              26                     !     nx : dimension of horizontal-direction
              27                     !    lev : dimension of z-direction
              28                     !  ktpbl : starting level to consider vertical mixing by pbl
              29                     !     dt : time step for ut, vt, tt, qt updates                (s)
              30                     !      g : gravity                                             (m/s2)
              31                     !      r : air gas constant                                    (j/kg)
              32                     !     cp : air specific heat constant                          (j/kg)
              33                     !  xkapa : r/cp
              34                     !   hltm : water vapor latent heat constant                    (j/kg)
              35                     !   ptop : model top pressure                                  (mb)
              36                     !   tice : temperature of melting point                        (k)
              37                     !   hice : latent heat of snow melting                         (j/kg)
              38                     !     tg : ground real temp. (sea or land)  (nx)               (k)
              39                     !     z0 : surface roughness length    (nx)                    (m)
              40                     !   gwet : ground wetness              (nx)
              41                     !   land : logic for bare soil land    (nx)  (=true for bare land)
              42                     !   topo : terrain geopotential   (nx)                         (m2/s2)
              43                     !    phi : odd level geopotential (nx)                         (m2/s2)
              44                     !    pss : (terrain pres -ptop)   (nx)     at current time lvl (mb)
              45                     !      u : x-direction velocity   (nx,lev) at current time lvl (m/s)
              46                     !      v : y-direction velocity   (nx,lev) at current time lvl (m/s)
              47                     !      t : potent temp on odd lvl (nx,lev) at current time lvl (k)
              48                     !      q : moisture    on odd lvl (nx,lev) at current time lvl (kg/kg)
              49                     !     ut : x-direction velocity   (nx,lev) at past/future  lvl (m/s)
              50                     !     vt : y-direction velocity   (nx,lev) at past/future  lvl (m/s)
              51                     !     tt : real temp.  on odd lvl (nx,lev) at past/future  lvl (k)
              52                     !     qt : moisture    on odd lvl (nx,lev) at past/future  lvl (kg/kg)
              53                     !     pk : p**capa on odd levels  (exner func)
              54                     !    pk2 : p**capa on even levels (exner func)
              55                     !   ustar: friction velocity         (nx)                      (m/s)
              56                     !   tstar: potential temp scale      (nx)                      (k)
              57                     !   qstar: moisture scale            (nx)                      (kg/kg)
              58                     !     e  : turbulence kinetic energy (nx,lev) at even lvls     (m2/s2)
              59                     !    eps : tke dissipation           (nx,lev)                  (m2/s2)
              60                     !   hflux: upward surface heat flux         (nx)               (w/m2)
              61                     !   qflux: upward surface moisture flux     (nx)               (w/m2)
              62                     !    gwr : soil water amount           (nx)                    (mm)
              63                     !  gwclim: soil water climate          (nx)                    (mm)
              64                     !  tgclim: climate ground temperature  (nx)                    (k)
              65                     !   ocean: logic for open water      (nx)  (=true for open water)
              66                     !     ice: logic for ice cover       (nx)  (=true for ice covered)
              67                     !     snr: snow depth in water state (nx)                      (mm)
              68                     !  totalp: total precipitation       (nx)                      (mm)
              69                     !      ss: net short wave radiat. flux down to ground (nx)     (wat/m2)
              70                     !      rs: net long  wave radiat. flux up from ground (nx)     (wat/m2)
              71                     !     alb: diffusion albedo           (nx)
              72                     !     imx: address of the two points with max xkm at the two lowest lvl
              73                     !    xkmx: max mixing coef xkm at two lowest levels            (m2/s)
              74                     !     idg: i-index address of selected point to print profile
              75                     !    xkmd: xkm profile at the selected idg point               (m2/s)
              76                     !   itype: surface layer update type, =0 use surface stress as b.c.
              77                     !                                     =1 directly update lowest levels
              78                     !      t2: 2m air temp derived by similarity theory (nx)     (K)
              79                     !     rh2: 2m air rh (nx)
              80                     !     u10: 10m air x-direction wind derived by simil. theory(nx)  (m/s)
              81                     !     v10: 10m air y-direction wind derived by simil. theory(nx)  (m/s)
              82                     !
              83                     !soil io
              84                     !
              85                     !     smc: volumetric soil moisture content (nx,km_soil)
              86                     !     stc: soil temperature                 (nx,km_soil)
              87                     !  canopy: canopy moisture content(<0.5mm)          (nx)
              88                     !  sigmaf: green vegetation fraction        (nx)
              89                     !   istyp: soil type(1-9)                   (nx)
              90                     ! ivegtyp: vegetation type(1-13)            (nx)
              91                     !  runoff: accumulate run off water(runof+drain) (nx)             (mm)
              92                     !     rld: long wave radiat. flux down to ground (nx)         (wat/m2)
              93                     !   wlt  : wiltling point of 9 soil types  (9)
              94                     !   ref  : field capacity of 9 soil types  (9)
              95                     ! tsat   : satuation point of 9 soil types (9)
              96                     ! dfkt   : soil thermal diffusivity     (22,9)     m2/s
              97                     ! xktk   : soil hydraulic conductivity  (22,9)     m/s
              98                     !  dfk   : soil hydraulic diffusivity   (22,9)     m2/s
              99                     !
             100                     ! 4. local variable
             101                     !
             102                     !    phi : geopential on odd lvl  (nx,lev) at current time lvl (m2/s2)
             103                     !    xkm : eddy mixing coef. for u,v (nx,lev)                  (m2/s)
             104                     !    xkh : eddy mixing coef. for t,q (nx,lev)                  (m2/s)
             105                     !      ts: surface air temperature    (nx)                     (k)
             106                     !    qsfc: surface moisture (specific humidity)      (nx)      (kg/kg)
             107                     !     zl : height(lev) over monin-obukhov scale height.
             108                     !          a stability indicator.                    (nx)
             109                     !     czh: ground thermal capacity                   (nx)      (j/kg.m2)
             110                     !    snow: logic for snow cover                      (nx)
             111                     !
             112                     !soil
             113                     !
             114                     !  rhscnpy: righ hand side terms of canopy prediction(nx)
             115                     !    rhsmc: righ hand side terms of smc prediction(nx,km)
             116                     !      aim: working array smc prediction           (nx,km)
             117                     !      bim: working array smc prediction           (nx,km)
             118                     !      cim: working array smc prediction           (nx,km)
             119                     !   drain: drainage water from bottom soil layer   (nx)        (mm/s)
             120                     !     snomt: snow melt rate                        (nx)        (mm/s)
             121                     !     zsoil: soil depth of soil layer(-0.1,-2.)    (nx,km)        (m)
             122                     !     runof: run off water from surface and soil   (nx)        (mm/s)
             123                     !      gfx: ground heat flx                        (nx)        (wat/m2)
             124                     !     t850: 850mb air temp                         (nx)         (K)
             125                     !     gesh: control number,control precipitation   (nx)
             126                     !           conver to snow(0) or not(1)
             127                     !
             128                     !
             129                     ! 5. calling modules
             130                     !
             131                     !     main program
             132                     !
             133                     ! 6. usage
             134                     !
             135                     !     call pbltke ( nx,lev,ktpbl,dt,g,r,cp,xkapa,hltm,ptop,tice
             136                     !    1            , hice,tg,z0,gwet,land,topo,phi,pss,u,v,t,q,ut
             137                     !    2            , vt,tt,qt,pk,pk2,ustar,tstar,qstar,e,eps,hflux
             138                     !    3            , qflux,gwr,gwclim,tgclim,ocean,ice,snr
             139                     !    4            , totalp,ss,rs,alb,imx,xkmx,idg,xkmd,itype
             140                     !    5            , rld,stbo
             141                     !    6            , km,smc,stc,canopy,runoff,sigmaf,istyp,ivegtyp
             142                     !    7            , wlt,ref,tsat,dfkt,xktk,dfk)
             143                     !
             144                     ! 7. modules called
             145                     !
             146                     !    qsatq, lansfc, landsmc, mixpbl
             147                     !
             148                     ! 8. limitation
             149                     !
             150                     !    see landsfc, landsmc, mixpbl
             151                     !
             152                     ! 9. date
             153                     !
             154                     !     created       november 1991
             155                     !     modified      july     1992,  april   1993
             156                     !     modified      jan      2005  by f. wang
             157                     !
             158                     ! 10. author
             159                     !
             160                     !      c. liou / f. wang
             161                     !
             162                     ! 11. reference
             163                     !
             164                     !  surface layer:
             165                     !       businger j.a.,1973: turbulent transfer in the atmospheric
             166                     !            surface layer.  workshop in meteorology, d. a. haugen,
             167                     !            ed., american meteorology socity, 67-98.
             168                     !  mixpbl:
             169                     !       detering, h. w., and d. etling, 1984: application of the
             170                     !            e-eps turbulence model to the atmospheric boundary
             171                     !            layer. boundary-layer meteorol., 33, 113-133.
             172                     !
             173                     !  land process:
             174                     !       Mahrt, L., and H. -L. Pan,1984: Atwo-layer model of soil hydrology.
             175                     !             Boundary Layer Meteorol., 29, 1-20.
             176                     !       Pan, H.-L., and L.Mahrt, 1987: Interaction between soil hydrology
             177                     !             and boundary-layer development. Boundary Layer Meteorol.,
             178                     !             38,185-202.
             179                     !#####################################################################
             180                     
             181                           use paramt
             182                           use const, only: RTYPE
             183                     
             184                           implicit none
             185                     
             186                     !
             187                     ! input & output variable
             188                     !
             189                     
             190                           integer  nxj,nx,lev,ktpbl,idg,itype,km
             191                           real     dt,g,r,cp,xkapa,hltm,ptop,tice,hice,stbo
             192                     
             193                           integer  imx(2)
             194                     
             195                           real     tg(nx),z0(nx),                                        &
             196                                    u(nx,lev),v(nx,lev),t(nx,lev),                        &
             197                                    ustar(nx),                                            &
             198                                    tstar(nx),qstar(nx),e(nx,lev),eps(nx,lev),hflux(nx),  &
             199                                    qflux(nx),pkd(nx),pk2d(nx),gwclim(nx),                &
             200                                    tgclim(nx),snr(nx),totalp(nx),                        &
             201                                    ss(nx),rs(nx),alb(nx),xkmx(2),xkmd(lev),              &
             202                                    t2(nx),rh2(nx),u10(nx),v10(nx)
             203                           real(kind=RTYPE) phi(nx,lev),qt(nx,lev),q(nx,lev),topo(nx),    &
             204                                            pss(nx),tt(nx,lev),ut(nx,lev),vt(nx,lev),     &
             205                                            pk(nx,lev),pk2(nx,lev)
             206                     !soil
             207                           real     smc(nx,km),stc(nx,km),canopy(nx),sigmaf(nx),          &
             208                                    rld(nx),runoff(nx)
             209                     
             210                           integer  istyp(nx),ivegtyp(nx)
             211                     !
             212                           logical  land(nx),ocean(nx),ice(nx)
             213                     !
             214                     !  local work arrays
             215                     !
             216                     !     include '../include/paramt.h'
             217                           real     hgt(im,lm),xkm(im,lm),xkh(im,lm),ts(im),              &
             218                                    qsfc(im),zl(im),czh(im),ps(im),sfcw(im),              &
             219                                    dhgt(im,lm),ro2(im,lm),dhgtz(im,lm)
             220                     !soil
             221                           real     rhscnpy(nx),rhsmc(nx,km),aim(nx,km),bim(nx,km),       &
             222                                    cim(nx,km),drain(nx),snomt(nx),zsoil(nx,km),          &
             223                                    runof(nx),gfx(nx),t850(nx),gesh(nx)
             224                     !
             225                           integer, parameter :: ntype=9, ngrid=22
             226                     
             227                           real     wlt(ntype),ref(ntype),tsat(ntype),dfkt(ngrid,ntype),  &
             228                                    xktk(ngrid,ntype),dfk(ngrid,ntype)
             229                     !soil
             230                     !
             231                           real     pk2x(nx,lev),pkx(nx,lev)
             232                     
             233                           logical snow(im)
             234                     
             235                           integer   i,k,kc
             236                           real      ppp,ttt,ppu,dth,p850,ddd,cc,ppd
             237                     !
             238                     ! --- ensure ktpbl selection is greater than 2
             239                     !
             240                           if ( ktpbl .lt. 2 )  ktpbl = 2
             241                     !
             242                     ! --- compute surface pres and surface air temp at current time level
             243                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.14, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ts, t, pss, ps, pk2
                                   <<< Loop-information  End >>>
             244     1  pp   2v            do 50 i = 1, nxj
             245     1   p   2v            ps(i) = pss(i) + ptop
             246     1   p   2v            ts(i) = t(i,lev)*pk2(i,lev)
             247     1   p   2v        50  continue
             248                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, pk2x, pkx, pk2d, pkd
                                   <<< Loop-information  End >>>
             249     1                     do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, pk2d, pkd
                                   <<< Loop-information  End >>>
             250     1  pp   2v            pkd(:) =pk(:,k)
             251     1   p   2v            pk2d(:)=pk2(:,k)
             252     1                     call vlog(pk2x(1,k),pk2d,nxj)
             253     1                     call vlog(pkx(1,k), pkd, nxj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2x, pkx
                                   <<< Loop-information  End >>>
             254     2  pp   2v            do i = 1, nxj
             255     2   p   2v              pk2x(i,k)=pk2x(i,k)*(cp/r)
             256     2   p   2v              pkx(i,k) = pkx(i,k)*(cp/r)
             257     2   p   2v            enddo
             258     1                     call vexp(pk2x(1,k),pk2x(1,k),nxj)
             259     1                     call vexp(pkx(1,k), pkx(1,k), nxj)
             260     1                     enddo
             261                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      topo, phi, hgt
                                   <<< Loop-information  End >>>
             262     1  pp                 do 100 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      topo, phi, hgt
                                   <<< Loop-information  End >>>
             263     2   p   2v            do 100 i = 1, nxj
             264     2   p   2v            hgt(i,k) = (phi(i,k) - topo(i) ) / g
             265     1   p   2v        100 continue
             266                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2x, q, pkx, t, pk, dhgtz, dhgt
                                   <<< Loop-information  End >>>
             267     1  pp    v            do 105 i = 1, nxj
             268     1   p    v            ppd = pk2x(i,1) * 1000.
             269     1   p    v            dhgt(i,1) = ( ppd - ptop ) * 100. / g
             270     1   p    v            ppp = pkx(i,1) * 1000.
             271     1   p    v            ttt = t(i,1)*pk(i,1)*(1.+0.608*q(i,1))
             272     1   p    v            dhgtz(i,1)= dhgt(i,1) * r * ttt / (100.*ppp)
             273     1   p    v        105 continue
             274                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkx, pk2x, t, pk, q, dhgt, dhgtz
                                   <<< Loop-information  End >>>
             275     1  pp                 do 110 k=2, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, pkx, pk2x, t, pk, dhgtz, dhgt
                                   <<< Loop-information  End >>>
             276     2   p    v            do 110 i=1, nxj
             277     2   p    v            ppu=pk2x(i,k-1) * 1000.
             278     2   p    v            ppd=pk2x(i,k) * 1000.
             279     2   p    v            dhgt(i,k) = ( ppd - ppu ) * 100. / g
             280     2   p    v            ppp = pkx(i,k) * 1000.
             281     2   p    v            ttt = t(i,k)*pk(i,k)*(1.+0.608*q(i,k))
             282     2   p    v            dhgtz(i,k)= dhgt(i,k) * r * ttt / (100.*ppp)
             283     1   p    v        110 continue
             284                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, ts, ro2
                                   <<< Loop-information  End >>>
             285     1  pp   2v            do 120 i = 1, nxj
             286     1   p   2v            ro2(i,lev) = 100.0*ps(i)/( r*ts(i))
             287     1   p   2v        120 continue
             288                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]

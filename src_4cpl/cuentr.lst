 External subroutine subprogram "cuentr"
  (inc)(line-no.)(nest)(optimize)
               1                     !+ Calculates entrainment/detrainment rates
               2                     !+ $Id: cuentr.f90,v 1.6 1998/10/28 12:28:44 m214003 Exp $
               3                     
               4                     !SUBROUTINE cuentr(klon,klev,klevp1,kk,ptenh,paphp1,papp1,klwmin,ldcum, &
               5                     SUBROUTINE cuentr(nxj,klon,klev,klevp1,kk,ptenh,paphp1,papp1,klwmin,ldcum, &
               6                     &      ktype,kcbot,kctop0,ppbase,pmfu,pentr,podetr,khmin,pgeoh,pdmfen,pdmfde)
               7                     
               8                       ! Description:
               9                       !
              10                       ! Calculates entrainment/detrainment rates.
              11                       !
              12                       ! Method:
              13                       !
              14                       ! This routine calculates entrainment/detrainment rates
              15                       ! for updrafts in cumulus parameterization
              16                       !
              17                       ! This routine is called from *cuasc*.
              18                       ! Input are environmental values t,q etc and updraft values t,q etc.
              19                       ! It returns entrainment/detrainment rates.
              20                       !
              21                       ! Authors:
              22                       !
              23                       ! S. Tiedtke, ECMWF, in 1989, original source
              24                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              25                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              26                       !
              27                       ! for more details see file AUTHORS
              28                       !
              29                     
              30                       USE shr_kind_mod, only: r8 => shr_kind_r8
              31                       USE mo_constants, ONLY : g,  & ! gravity acceleration
              32                                                rd    ! gas constant for dry air
              33                     
              34                       IMPLICIT NONE
              35                     
              36                       !  Scalar arguments with intent(In):
              37                     !  INTEGER, INTENT (IN) :: kk, klev, klevp1, klon
              38                       INTEGER, INTENT (IN) :: kk, klev, klevp1, klon, nxj
              39                     
              40                       !  Array arguments with intent(In):
              41                       REAL(r8), INTENT (IN) :: paphp1(klon,klevp1), papp1(klon,klev), pentr(klon), &
              42                     &                      pgeoh(klon,klev), pmfu(klon,klev), ptenh(klon,klev)
              43                       INTEGER, INTENT (IN) :: kcbot(klon), kctop0(klon), khmin(klon),  &
              44                     &                         klwmin(klon), ktype(klon)
              45                       LOGICAL, INTENT (IN) :: ldcum(klon)
              46                     
              47                       !  Array arguments with intent(InOut):
              48                       REAL(r8), INTENT (INOUT) :: pdmfde(klon), pdmfen(klon), podetr(klon,klev),  &
              49                     &                         ppbase(klon)
              50                     
              51                       !  Local scalars:
              52                       REAL(r8) :: arg, zdprho, zentr, zorgde, zpmid, zrg, zrrho, ztmzk, zzmzk
              53                       INTEGER :: ikb, ikh, iklwmin, ikt, jl
              54                       LOGICAL :: llo1, llo2
              55                     
              56                       !  Intrinsic functions
              57                       INTRINSIC MAX, MERGE, MIN, TAN
              58                     
              59                     
              60                       !  Executable statements
              61                     
              62                     !-- 1.  Calculate entrainment and detrainment rates
              63                     
              64                     !-- 1.1 Specify entrainment rates for shallow clouds
              65                     
              66                     !-- 1.2 Specify entrainment rates for deep clouds
              67                     
              68                       zrg = 1./g
              69                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 29
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptenh, paphp1, kcbot, pmfu, pentr
                                   <<<      kctop0, klwmin, ldcum, ktype, papp1
                                   <<<      ppbase, pdmfde, pdmfen, podetr
                                   <<< Loop-information  End >>>
              70     1  pp    s        DO jl = 1, nxj
              71     1   p    v          ppbase(jl) = paphp1(jl,kcbot(jl))
              72     1   p    v          zrrho = (rd*ptenh(jl,kk+1))/paphp1(jl,kk+1)
              73     1   p    v          zdprho = (paphp1(jl,kk+1)-paphp1(jl,kk))*zrg
              74     1   p    v          zpmid = 0.5*(ppbase(jl)+paphp1(jl,kctop0(jl)))
              75     1   p    v          zentr = pentr(jl)*pmfu(jl,kk+1)*zdprho*zrrho
              76     1   p    v          llo1 = kk < kcbot(jl) .AND. ldcum(jl)
              77     1   p    v          pdmfde(jl) = MERGE(zentr,0.d0,llo1)
              78     1   p    v          llo2 = llo1 .AND. ktype(jl) == 2 .AND. (ppbase(jl)-paphp1(jl,kk)<0.2E5 &
              79     1               &        .OR. paphp1(jl,kk)>zpmid)
              80     1   p    v          pdmfen(jl) = MERGE(zentr,0.d0,llo2)
              81     1   p    v          iklwmin = MAX(klwmin(jl),kctop0(jl)+2)
              82     1   p    v          llo2 = llo1 .AND. ktype(jl) == 3 .AND. (kk>=iklwmin .OR. papp1(jl,kk)> &
              83     1               &        zpmid)
              84     1   p    s          IF (llo2) pdmfen(jl) = zentr
              85     1   p    v          llo2 = llo1 .AND. ktype(jl) == 1
              86     1                   ! Turbulent entrainment
              87     1   p    s          IF (llo2) pdmfen(jl) = zentr
              88     1                   ! Organized detrainment, detrainment starts at khmin
              89     1   p    v          ikb = kcbot(jl)
              90     1   p    v          podetr(jl,kk) = 0.
              91     2   p    s          IF (llo2 .AND. kk<=khmin(jl) .AND. kk>=kctop0(jl)) THEN
              92     2   p    s            ikt = kctop0(jl)
              93     2   p    s            ikh = khmin(jl)
              94     3   p    s            IF (ikh>ikt) THEN
              95     3   p    s              zzmzk = -(pgeoh(jl,ikh)-pgeoh(jl,kk))*zrg
              96     3   p    s              ztmzk = -(pgeoh(jl,ikh)-pgeoh(jl,ikt))*zrg
              97     3   p    s              arg = 3.1415*(zzmzk/ztmzk)*0.5
              98     3   p    s              zorgde = TAN(arg)*3.1415*0.5/ztmzk
              99     3   p    s              zdprho = (paphp1(jl,kk+1)-paphp1(jl,kk))*(zrg*zrrho)
             100     3   p    s              podetr(jl,kk) = MIN(zorgde,1.d-3)*pmfu(jl,kk+1)*zdprho
             101     3   p    s            END IF
             102     2   p    v          END IF
             103     1   p    v        END DO
             104                     
             105                       RETURN
             106                     END SUBROUTINE cuentr


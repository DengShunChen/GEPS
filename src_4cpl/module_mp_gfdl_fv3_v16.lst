            1421     2                           ! accretion: pracc
            1422     2                           ! -----------------------------------------------------------------------
            1423     2               
            1424     2                           ! if (qr (k) > qrmin .and. ql (k) > 1.e-7 .and. qsat < q_plus) then
            1425     3                           if (qr (k) > qrmin .and. ql (k) > 1.e-6 .and. qsat < q_minus) then
            1426     3                               sink = dt * denfac (k) * cracw * exp (0.95 * log (qr (k) * den (k)))

            1002     2   p    v                  ql_dt (i, j, k) = ql_dt (i, j, k) + rdt * (qlz (k) - ql0 (k)) * omq
            1003     2   p    v                  qr_dt (i, j, k) = qr_dt (i, j, k) + rdt * (qrz (k) - qr0 (k)) * omq
            1004     2   p    v                  qi_dt (i, j, k) = qi_dt (i, j, k) + rdt * (qiz (k) - qi0 (k)) * omq
            1005     2   p    v                  qs_dt (i, j, k) = qs_dt (i, j, k) + rdt * (qsz (k) - qs0 (k)) * omq
            1006     2   p    v                  qg_dt (i, j, k) = qg_dt (i, j, k) + rdt * (qgz (k) - qg0 (k)) * omq
            1007     2   p    v                  cvm = c_air + qvz (k) * c_vap + (qrz (k) + qlz (k)) * c_liq + (qiz (k) + qsz (k) + qgz (k)) * c_ice
            1008     2   p    v                  pt_dt (i, j, k) = pt_dt (i, j, k) + rdt * (tz (k) - t0 (k)) * cvm / cp_air
            1009     2   p    v              enddo
            1010     1               
            1011     1                       ! -----------------------------------------------------------------------
            1012     1                       ! update cloud fraction tendency
            1013     1                       ! -----------------------------------------------------------------------
            1014     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qaz, qa0
                                   <<< Loop-information  End >>>
            1015     2  pp   2v              do k = ktop, kbot
            1016     3   p   2v                  if (do_qa) then
            1017     3       2                       qa_dt (i, j, k) = 0.
            1018     3   p   2v                  else
            1019     3   p   2v                      qa_dt (i, j, k) = qa_dt (i, j, k) + rdt * (qaz (k) / real (ntimes) - qa0 (k))
            1020     3   p   2v                  endif
            1021     2   p   2v              enddo
            1022     1               
            1023     1                       ! -----------------------------------------------------------------------
            1024     1                       ! fms diagnostics:
            1025     1                       ! -----------------------------------------------------------------------
            1026     1               
            1027     1                       ! if (id_cond > 0) then
            1028     1                       ! do k = ktop, kbot ! total condensate
            1029     1                       ! cond (i) = cond (i) + dp1 (k) * (qlz (k) + qrz (k) + qsz (k) + qiz (k) + qgz (k))
            1030     1                       ! enddo
            1031     1                       ! endif
            1032     1                       !
            1033     1                       ! if (id_vtr > 0) then
            1034     1                       ! do k = ktop, kbot
            1035     1                       ! vt_r (i, j, k) = vtrz (k)
            1036     1                       ! enddo
            1037     1                       ! endif
            1038     1                       !
            1039     1                       ! if (id_vts > 0) then
            1040     1                       ! do k = ktop, kbot
            1041     1                       ! vt_s (i, j, k) = vtsz (k)
            1042     1                       ! enddo
            1043     1                       ! endif
            1044     1                       !
            1045     1                       ! if (id_vtg > 0) then
            1046     1                       ! do k = ktop, kbot
            1047     1                       ! vt_g (i, j, k) = vtgz (k)
            1048     1                       ! enddo
            1049     1                       ! endif
            1050     1                       !
            1051     1                       ! if (id_vts > 0) then
            1052     1                       ! do k = ktop, kbot
            1053     1                       ! vt_i (i, j, k) = vtiz (k)
            1054     1                       ! enddo
            1055     1                       ! endif
            1056     1                       !
            1057     1                       ! if (id_droplets > 0) then
            1058     1                       ! do k = ktop, kbot
            1059     1                       ! qn2 (i, j, k) = ccn (k)
            1060     1                       ! enddo
            1061     1                       ! endif
            1062     1               
            1063     1                   enddo
            1064                     
            1065                     end subroutine mpdrv
            1066                     
            1067                     ! -----------------------------------------------------------------------
            1068                     !> sedimentation of heat
            1069                     ! -----------------------------------------------------------------------
            1070                     
            1071                     subroutine sedi_heat (ktop, kbot, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            1072                     
            1073                         implicit none
            1074                     
            1075                         ! input q fields are dry mixing ratios, and dm is dry air mass
            1076                     
            1077                         integer, intent (in) :: ktop, kbot
            1078                     
            1079                         real, intent (in), dimension (ktop:kbot) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            1080                     
            1081                         real, intent (inout), dimension (ktop:kbot) :: tz
            1082                     
            1083                         real, intent (in) :: cw ! heat capacity
            1084                     
            1085                         real, dimension (ktop:kbot) :: dgz, cvn
            1086                     
            1087                         real :: tmp
            1088                     
            1089                         integer :: k
            1090                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.22, ITR: 88, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv, qr, ql, qi, qs, qg, dm, dz, cvn, dgz
                                   <<< Loop-information  End >>>
            1091     1  pp    v          do k = ktop, kbot
            1092     1   p    v              dgz (k) = - 0.5 * grav * dz (k) ! > 0
            1093     1   p    v              cvn (k) = dm (k) * (cv_air + qv (k) * cv_vap + (qr (k) + ql (k)) * &
            1094     1                           c_liq + (qi (k) + qs (k) + qg (k)) * c_ice)
            1095     1   p    v          enddo
            1096                     
            1097                         ! -----------------------------------------------------------------------
            1098                         ! sjl, july 2014
            1099                         ! assumption: the ke in the falling condensates is negligible compared to the potential energy
            1100                         ! that was unaccounted for. local thermal equilibrium is assumed, and the loss in pe is transformed
            1101                         ! into internal energy (to heat the whole grid box)
            1102                         ! backward time - implicit upwind transport scheme:
            1103                         ! dm here is dry air mass
            1104                         ! -----------------------------------------------------------------------
            1105                     
            1106                         k = ktop
            1107                         tmp = cvn (k) + m1 (k) * cw
            1108                         tz (k) = (tmp * tz (k) + m1 (k) * dgz (k)) / tmp
            1109                     
            1110                         ! -----------------------------------------------------------------------
            1111                         ! implicit algorithm: can't be vectorized
            1112                         ! needs an inner i - loop for vectorization
            1113                         ! -----------------------------------------------------------------------
            1114                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dgz, cvn, tz, m1
                                   <<< Loop-information  End >>>
            1115     1   s   2s          do k = ktop + 1, kbot
            1116     1   m   2m              tz (k) = ((cvn (k) + cw * (m1 (k) - m1 (k - 1))) * tz (k) + m1 (k - 1) * &
            1117     1                           cw * tz (k - 1) + dgz (k) * (m1 (k - 1) + m1 (k))) / (cvn (k) + cw * m1 (k))
            1118     1   p   2v          enddo
            1119                     
            1120                     end subroutine sedi_heat
            1121                     
            1122                     ! -----------------------------------------------------------------------
            1123                     !> warm rain cloud microphysics
            1124                     ! -----------------------------------------------------------------------
            1125                     
            1126                     subroutine warm_rain (dt, ktop, kbot, dp, dz, tz, qv, ql, qr, qi, qs, qg, &
            1127                             den, denfac, ccn, c_praut, rh_rain, vtr, r1, m1_rain, w1, h_var)
            1128                     
            1129                         implicit none
            1130                     
            1131                         integer, intent (in) :: ktop, kbot
            1132                     
            1133                         real, intent (in) :: dt !< time step (s)
            1134                         real, intent (in) :: rh_rain, h_var
            1135                     
            1136                         real, intent (in), dimension (ktop:kbot) :: dp, dz, den
            1137                         real, intent (in), dimension (ktop:kbot) :: denfac, ccn, c_praut
            1138                     
            1139                         real, intent (inout), dimension (ktop:kbot) :: tz, vtr
            1140                         real, intent (inout), dimension (ktop:kbot) :: qv, ql, qr, qi, qs, qg
            1141                         real, intent (inout), dimension (ktop:kbot) :: m1_rain, w1
            1142                     
            1143                         real, intent (out) :: r1
            1144                     
            1145                         real, parameter :: so3 = 7. / 3.
            1146                     
            1147                         real, dimension (ktop:kbot) :: dl, dm
            1148                         real, dimension (ktop:kbot + 1) :: ze, zt
            1149                     
            1150                         real :: sink, dq, qc0, qc
            1151                         real :: qden
            1152                         real :: zs = 0.
            1153                         real :: dt5
            1154                     
            1155                         integer :: k
            1156                     
            1157                         ! fall velocity constants:
            1158                     
            1159                         real, parameter :: vconr = 2503.23638966667
            1160                         real, parameter :: normr = 25132741228.7183
            1161                         real, parameter :: thr = 1.e-8
            1162                     
            1163                         logical :: no_fall
            1164                     
            1165                         dt5 = 0.5 * dt
            1166                     
            1167                         ! -----------------------------------------------------------------------
            1168                         ! terminal speed of rain
            1169                         ! -----------------------------------------------------------------------
            1170                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      m1_rain
                                   <<< Loop-information  End >>>
            1171        pp   4v          m1_rain (:) = 0.
            1172                     
            1173          i              call check_column (ktop, kbot, qr, no_fall)
            1174                     
            1175     1                   if (no_fall) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtr
                                   <<< Loop-information  End >>>
            1176     1  pp   4v              vtr (:) = vf_min
            1177     1                       r1 = 0.
            1178     1                   else
            1179     1               
            1180     1                       ! -----------------------------------------------------------------------
            1181     1                       ! fall speed of rain
            1182     1                       ! -----------------------------------------------------------------------
            1183     1               
            1184     2                       if (const_vr) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtr
                                   <<< Loop-information  End >>>
            1185     2  pp   4v                  vtr (:) = vr_fac ! ifs_2016: 4.0
            1186     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.01, ITR: 64, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtr, qr, den
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 32
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1187     3  pp    v                  do k = ktop, kbot
            1188     3   p    v                      qden = qr (k) * den (k)
            1189     4   p    v                      if (qr (k) < thr) then
            1190     4   p    v                          vtr (k) = vr_min
            1191     4   p    v                      else
            1192     4   p    v                          vtr (k) = vr_fac * vconr * sqrt (min (10., sfcrho / den (k))) * &
            1193     4                                       exp (0.2 * log (qden / normr))
            1194     4   p    v                          vtr (k) = min (vr_max, max (vr_min, vtr (k)))
            1195     4   p    v                      endif
            1196     3   p    v                  enddo
            1197     2                       endif
            1198     1               
            1199     1                       ze (kbot + 1) = zs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, ze
                                   <<< Loop-information  End >>>
            1200     2   s   2s              do k = kbot, ktop, - 1
            1201     2   s   2s                  ze (k) = ze (k + 1) - dz (k) ! dz < 0
            1202     2   s   2s              enddo
            1203     1               
            1204     1                       ! -----------------------------------------------------------------------
            1205     1                       ! evaporation and accretion of rain for the first 1 / 2 time step
            1206     1                       ! -----------------------------------------------------------------------
            1207     1               
            1208     1                       ! if (.not. fast_sat_adj) &
            1209     1                       call revap_racc (ktop, kbot, dt5, tz, qv, ql, qr, qi, qs, qg, den, denfac, rh_rain, h_var)
            1210     1               
            1211     2                       if (do_sedi_w) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 120, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, dp, qr, qi, qs, qg, dm
                                   <<< Loop-information  End >>>
            1212     3  pp    v                  do k = ktop, kbot
            1213     3   p    v                      dm (k) = dp (k) * (1. + qv (k) + ql (k) + qr (k) + qi (k) + qs (k) + qg (k))
            1214     3   p    v                  enddo
            1215     2                       endif
            1216     1               
            1217     1                       ! -----------------------------------------------------------------------
            1218     1                       ! mass flux induced by falling rain
            1219     1                       ! -----------------------------------------------------------------------
            1220     1               
            1221     2                       if (use_ppm) then
            1222     2                           zt (ktop) = ze (ktop)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze, vtr, zt
                                   <<< Loop-information  End >>>
            1223     3  pp   2v                  do k = ktop + 1, kbot
            1224     3   p   2v                      zt (k) = ze (k) - dt5 * (vtr (k - 1) + vtr (k))
            1225     3   p   2v                  enddo
            1226     2                           zt (kbot + 1) = zs - dt * vtr (kbot)
            1227     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            1228     3   s   2s                  do k = ktop, kbot
            1229     3   s   2s                      if (zt (k + 1) >= zt (k)) zt (k + 1) = zt (k) - dz_min
            1230     3   s   2s                  enddo
            1231     2                           call lagrangian_fall_ppm (ktop, kbot, zs, ze, zt, dp, qr, r1, m1_rain, mono_prof)
            1232     2                       else
            1233     2                           call implicit_fall (dt, ktop, kbot, ze, vtr, dp, qr, r1, m1_rain)
            1234     2                       endif
            1235     1               
            1236     1                       ! -----------------------------------------------------------------------
            1237     1                       ! vertical velocity transportation during sedimentation
            1238     1                       ! -----------------------------------------------------------------------
            1239     1               
            1240     2                       if (do_sedi_w) then
            1241     2                           w1 (ktop) = (dm (ktop) * w1 (ktop) + m1_rain (ktop) * vtr (ktop)) / (dm (ktop) - m1_rain (ktop))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      m1_rain, vtr, dm, w1
                                   <<< Loop-information  End >>>
            1242     3  pp    v                  do k = ktop + 1, kbot
            1243     3   p    v                      w1 (k) = (dm (k) * w1 (k) - m1_rain (k - 1) * vtr (k - 1) + m1_rain (k) * vtr (k)) &
            1244     3                                    / (dm (k) + m1_rain (k - 1) - m1_rain (k))
            1245     3   p    v                  enddo
            1246     2                       endif
            1247     1               
            1248     1                       ! -----------------------------------------------------------------------
            1249     1                       ! heat transportation during sedimentation
            1250     1                       ! -----------------------------------------------------------------------
            1251     1               
            1252     1                       if (do_sedi_heat) &
            1253     1                           call sedi_heat (ktop, kbot, dp, m1_rain, dz, tz, qv, ql, qr, qi, qs, qg, c_liq)
            1254     1               
            1255     1                       ! -----------------------------------------------------------------------
            1256     1                       ! evaporation and accretion of rain for the remaing 1 / 2 time step
            1257     1                       ! -----------------------------------------------------------------------
            1258     1               
            1259     1                       call revap_racc (ktop, kbot, dt5, tz, qv, ql, qr, qi, qs, qg, den, denfac, rh_rain, h_var)
            1260     1               
            1261     1                   endif
            1262                     
            1263                         ! -----------------------------------------------------------------------
            1264                         ! auto - conversion
            1265                         ! assuming linear subgrid vertical distribution of cloud water
            1266                         ! following lin et al. 1994, mwr
            1267                         ! -----------------------------------------------------------------------
            1268                     
            1269     1                   if (irain_f /= 0) then
            1270     1               
            1271     1                       ! -----------------------------------------------------------------------
            1272     1                       ! no subgrid varaibility
            1273     1                       ! -----------------------------------------------------------------------
            1274     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, ccn, den, ql, c_praut, qr
                                   <<< Loop-information  End >>>
            1275     2  pp    v              do k = ktop, kbot
            1276     2   p    v                  qc0 = fac_rc * ccn (k)
            1277     3   p    v                  if (tz (k) > t_wfr) then
            1278     4   p    v                      if (use_ccn) then
            1279     4                                   ! -----------------------------------------------------------------------
            1280     4                                   ! ccn is formulted as ccn = ccn_surface * (den / den_surface)
            1281     4                                   ! -----------------------------------------------------------------------
            1282     4                                   qc = qc0
            1283     4   p    v                      else
            1284     4   p    v                          qc = qc0 / den (k)
            1285     4   p    v                      endif
            1286     3   p    v                      dq = ql (k) - qc
            1287     4   p    v                      if (dq > 0.) then
            1288     4   p    v                          sink = min (dq, dt * c_praut (k) * den (k) * exp (so3 * log (ql (k))))
            1289     4   p    v                          ql (k) = ql (k) - sink
            1290     4   p    v                          qr (k) = qr (k) + sink
            1291     4   p    v                      endif
            1292     3   p    v                  endif
            1293     2   p    v              enddo
            1294     1               
            1295     1                   else
            1296     1               
            1297     1                       ! -----------------------------------------------------------------------
            1298     1                       ! with subgrid varaibility
            1299     1                       ! -----------------------------------------------------------------------
            1300     1               
            1301     1                       call linear_prof (kbot - ktop + 1, ql (ktop), dl (ktop), z_slope_liq, h_var)
            1302     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 21
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.94, ITR: 64, MVE: 4, POL: L)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr, ql, dl, tz, c_praut, ccn, den
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 28
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1303     2  pp    v              do k = ktop, kbot
            1304     2   p    v                  qc0 = fac_rc * ccn (k)
            1305     3   p    v                  if (tz (k) > t_wfr + dt_fr) then
            1306     3   p    v                      dl (k) = min (max (1.e-6, dl (k)), 0.5 * ql (k))
            1307     3                               ! --------------------------------------------------------------------
            1308     3                               ! as in klein's gfdl am2 stratiform scheme (with subgrid variations)
            1309     3                               ! --------------------------------------------------------------------
            1310     4   p    v                      if (use_ccn) then
            1311     4                                   ! --------------------------------------------------------------------
            1312     4                                   ! ccn is formulted as ccn = ccn_surface * (den / den_surface)
            1313     4                                   ! --------------------------------------------------------------------
            1314     4                                   qc = qc0
            1315     4   p    v                      else
            1316     4   p    v                          qc = qc0 / den (k)
            1317     4   p    v                      endif
            1318     3   p    v                      dq = 0.5 * (ql (k) + dl (k) - qc)
            1319     3                               ! --------------------------------------------------------------------
            1320     3                               ! dq = dl if qc == q_minus = ql - dl
            1321     3                               ! dq = 0 if qc == q_plus = ql + dl
            1322     3                               ! --------------------------------------------------------------------
            1323     4   p    v                      if (dq > 0.) then ! q_plus > qc
            1324     4                                   ! --------------------------------------------------------------------
            1325     4                                   ! revised continuous form: linearly decays (with subgrid dl) to zero at qc == ql + dl
            1326     4                                   ! --------------------------------------------------------------------
            1327     4   p    v                          sink = min (1., dq / dl (k)) * dt * c_praut (k) * den (k) * exp (so3 * log (ql (k)))
            1328     4   p    v                          ql (k) = ql (k) - sink
            1329     4   p    v                          qr (k) = qr (k) + sink
            1330     4   p    v                      endif
            1331     3   p    v                  endif
            1332     2   p    v              enddo
            1333     1                   endif
            1334                     
            1335                     end subroutine warm_rain
            1336                     
            1337                     ! -----------------------------------------------------------------------
            1338                     !> evaporation of rain
            1339                     ! -----------------------------------------------------------------------
            1340                     
            1341                     subroutine revap_racc (ktop, kbot, dt, tz, qv, ql, qr, qi, qs, qg, den, denfac, rh_rain, h_var)
            1342                     
            1343                         implicit none
            1344                     
            1345                         integer, intent (in) :: ktop, kbot
            1346                     
            1347                         real, intent (in) :: dt ! time step (s)
            1348                         real, intent (in) :: rh_rain, h_var
            1349                     
            1350                         real, intent (in), dimension (ktop:kbot) :: den, denfac
            1351                     

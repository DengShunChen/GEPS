            1639     1               
            1640     1   p    v              pgacr = 0.
            1641     1   p    v              pgacw = 0.
            1642     1   p    v              tc = tz - tice
            1643     1               
            1644     2   p    v              if (tc .ge. 0.) then
            1645     2               
            1646     2                           ! -----------------------------------------------------------------------
            1647     2                           ! melting of snow
            1648     2                           ! -----------------------------------------------------------------------
            1649     2               
            1650     2   p    v                  dqs0 = ces0 / p1 (k) - qv
            1651     2               
            1652     3   p    v                  if (qs > qcmin) then
            1653     3               
            1654     3                               ! -----------------------------------------------------------------------
            1655     3                               ! psacw: accretion of cloud water by snow
            1656     3                               ! only rate is used (for snow melt) since tc > 0.
            1657     3                               ! -----------------------------------------------------------------------
            1658     3               
            1659     4   p    v                      if (ql > qrmin) then
            1660     4   p    v                          factor = denfac (k) * csacw * exp (0.8125 * log (qs * den (k)))
            1661     4   p    v                          psacw = factor / (1. + dts * factor) * ql ! rate
            1662     4   p    v                      else
            1663     4   p    v                          psacw = 0.
            1664     4   p    v                      endif
            1665     3               
            1666     3                               ! -----------------------------------------------------------------------
            1667     3                               ! psacr: accretion of rain by melted snow
            1668     3                               ! pracs: accretion of snow by rain
            1669     3                               ! -----------------------------------------------------------------------
            1670     3               
            1671     4   p    v                      if (qr > qrmin) then

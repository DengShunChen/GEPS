            1683     3                               ! -----------------------------------------------------------------------
            1684     3               
            1685     3   pi   v                      psmlt = max (0., smlt (tc, dqs0, qs * den (k), psacw, psacr, csmlt, &
            1686     3                                   den (k), denfac (k)))
            1687     3   p    v                      sink = min (qs, dts * (psmlt + pracs), tc / icpk (k))
            1688     3   p    v                      qs = qs - sink
            1689     3                               ! sjl, 20170321:
            1690     3   p    v                      tmp = min (sink, dim (qs_mlt, ql)) ! max ql due to snow melt
            1691     3   p    v                      ql = ql + tmp

            1361     1                   do k = ktop, kbot
            1362     1               
            1363     2                       if (tz (k) > t_wfr .and. qr (k) > qrmin) then
            1364     2               
            1365     2                           ! -----------------------------------------------------------------------
            1366     2                           ! define heat capacity and latent heat coefficient

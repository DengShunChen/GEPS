             318                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max,  &
             319                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max,    &
             320                             qi0_crt, qr0_crt, fast_sat_adj, rh_inc, rh_ins, rh_inr, const_vi,     &
             321                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             322                             tau_g2v, tau_v2g, sat_adj0, c_piacr, tau_imlt, tau_v2l, tau_l2v,      &
             323                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs,           &
             324                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice,        &
             325                             rad_snow, rad_graupel, rad_rain, cld_min, use_ppm, mono_prof,         &
             326                             do_sedi_heat, sedi_transport, do_sedi_w, de_ice, icloud_f, irain_f,   &
             327                             mp_print, reiflag, rewmin, rewmax, reimin, reimax, rermin, rermax,    &
             328                             resmin, resmax, regmin, regmax, tintqs, do_melt
             329                     
             330                         public                                                                    &
             331                             mp_time, t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             332                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max,  &
             333                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max,    &
             334                             qi0_crt, qr0_crt, fast_sat_adj, rh_inc, rh_ins, rh_inr, const_vi,     &
             335                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             336                             tau_g2v, tau_v2g, sat_adj0, c_piacr, tau_imlt, tau_v2l, tau_l2v,      &
             337                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs,           &
             338                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice,        &
             339                             rad_snow, rad_graupel, rad_rain, cld_min, use_ppm, mono_prof,         &
             340                             do_sedi_heat, sedi_transport, do_sedi_w, de_ice, icloud_f, irain_f,   &
             341                             mp_print, reiflag, rewmin, rewmax, reimin, reimax, rermin, rermax,    &
             342                             resmin, resmax, regmin, regmax, tintqs, do_melt
             343                     
             344                     contains
             345                     
             346                     ! -----------------------------------------------------------------------
             347                     ! the driver of the gfdl cloud microphysics
             348                     ! -----------------------------------------------------------------------
             349                     
             350                     !>@brief The subroutine 'gfdl_cloud_microphys_driver' executes the full GFDL
             351                     !! cloud microphysics.
             352                     subroutine gfdl_cloud_microphys_driver                                    &
             353                                 ( qv, ql, qr, qi, qs, qg, qa, qn,                             &
             354                                   qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt, qa_dt,            &
             355                                   pt_dt, pt, w, uin, vin, udt, vdt,                           &
             356                                   dz, delp, area, dt_in, land,                                &
             357                                   rain, snow, ice, graupel,                                   &
             358                                   rhc, hydrostatic, phys_hydrostatic,                     &
             359                     !              iis, iie, jjs, jje, kks, kke, ktop, kbot, seconds,          &  !FV3 v16
             360                     !              p, lradar, refl_10cm, reset )
             361                                   iis, iie, jjs, jje, kks, kke, ktop, kbot )
             362                     
             363                         implicit none
             364                     
             365                         logical, intent (in) :: hydrostatic, phys_hydrostatic
             366                     !    logical, intent (in) :: lradar, reset  !FV3 v16
             367                         integer, intent (in) :: iis, iie, jjs, jje !< physics window
             368                         integer, intent (in) :: kks, kke !< vertical dimension
             369                         integer, intent (in) :: ktop, kbot !< vertical compute domain
             370                     !    integer, intent (in) :: seconds
             371                     
             372                         real, intent (in) :: dt_in !< physics time step
             373                     
             374                         real, intent (in), dimension (:, :) :: rhc
             375                     
             376                         real, intent (in), dimension (:, :) :: area !< cell area
             377                         real, intent (in), dimension (:, :) :: land !< land fraction
             378                     
             379                         real, intent (in), dimension (:, :, :) :: delp, dz, uin, vin
             380                     !    real, intent (in), dimension (:, :, :) :: p  !FV3 v16
             381                         real, intent (in), dimension (:, :, :) :: pt, qv, ql, qr, qg, qa, qn
             382                     
             383                         real, intent (inout), dimension (:, :, :) :: qi, qs
             384                         real, intent (inout), dimension (:, :, :) :: pt_dt, qa_dt, udt, vdt, w
             385                         real, intent (inout), dimension (:, :, :) :: qv_dt, ql_dt, qr_dt
             386                         real, intent (inout), dimension (:, :, :) :: qi_dt, qs_dt, qg_dt
             387                     
             388                     !    real, intent (out), dimension (:, :, :) :: refl_10cm  !FV3 v16
             389                         real, intent (out), dimension (:, :) :: rain, snow, ice, graupel
             390                     
             391                         logical :: melti = .false.
             392                         logical :: lradar = .false. , reset = .false. !FV3 v16
             393                         ! logical :: used
             394                     
             395                         real :: mpdt, rdt, dts, convt, tot_prec
             396                     
             397                         integer :: i, j, k
             398                         integer :: is, ie, js, je !< physics window
             399                         integer :: ks, ke !< vertical dimension
             400                         integer :: days, ntimes, kflip
             401                     
             402                         real, dimension (iie - iis + 1, jje - jjs + 1) :: prec_mp, prec1, cond, w_var, rh0
             403                     
             404                         real, dimension (iie - iis + 1, jje - jjs + 1, kke - kks + 1) :: vt_r, vt_s, vt_g, vt_i, qn2
             405                     
             406                         real, dimension (size (pt, 1), size (pt, 3)) :: m2_rain, m2_sol
             407                     
             408                         real :: allmax
             409                     !+---+-----------------------------------------------------------------+
             410                     !For 3D reflectivity calculations
             411                       REAL, DIMENSION(ktop:kbot):: qv1d, t1d, p1d, qr1d, qs1d, qg1d, dBZ
             412                     !+---+-----------------------------------------------------------------+
             413                     
             414                         is = 1
             415                         js = 1
             416                         ks = 1
             417                         ie = iie - iis + 1
             418                         je = jje - jjs + 1
             419                         ke = kke - kks + 1
             420                         ! call mpp_clock_begin (gfdl_mp_clock)
             421                     
             422                         ! -----------------------------------------------------------------------
             423                         ! define heat capacity of dry air and water vapor based on hydrostatical property
             424                         ! -----------------------------------------------------------------------
             425                     
             426     1                   if (phys_hydrostatic .or. hydrostatic) then
             427     1                       c_air = cp_air
             428     1                       c_vap = cp_vap
             429     1                       p_nonhydro = .false.
             430     1                   else
             431     1                       c_air = cv_air
             432     1                       c_vap = cv_vap
             433     1                       p_nonhydro = .true.
             434     1                   endif
             435                         d0_vap = c_vap - c_liq
             436                         lv00 = hlv0 - d0_vap * t_ice
             437                     
             438                         if (hydrostatic) do_sedi_w = .false.
             439                     
             440                         ! -----------------------------------------------------------------------
             441                         ! define latent heat coefficient used in wet bulb and bigg mechanism
             442                         ! -----------------------------------------------------------------------
             443                     
             444                         latv = hlv
             445                         lati = hlf
             446                         lats = latv + lati
             447                         lat2 = lats * lats
             448                     
             449                         lcp = latv / cp_air
             450                         icp = lati / cp_air
             451                         tcp = (latv + lati) / cp_air
             452                     
             453                         ! tendency zero out for am moist processes should be done outside the driver
             454                     
             455                         ! -----------------------------------------------------------------------
             456                         ! define cloud microphysics sub time step
             457                         ! -----------------------------------------------------------------------
             458                     
             459                         mpdt   = min (dt_in, mp_time)
             460                         rdt    = 1. / dt_in
             461                         ntimes = nint (dt_in / mpdt)
             462                     
             463                         ! small time step:
             464                         dts = dt_in / real (ntimes)
             465                     
             466                         ! call get_time (time, seconds, days)
             467                     
             468                         ! -----------------------------------------------------------------------
             469                         ! initialize precipitation
             470                         ! -----------------------------------------------------------------------
             471                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             472     1  pp               do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cond
                                   <<< Loop-information  End >>>
             473     2   p   2v              do i = is, ie
             474     2   p   2v                  graupel (i, j) = 0.
             475     2   p   2v                  rain (i, j) = 0.
             476     2   p   2v                  snow (i, j) = 0.
             477     2   p   2v                  ice (i, j) = 0.
             478     2   p   2v                  cond (i, j) = 0.
             479     2   p   2v              enddo
             480     1   p               enddo
             481                     
             482                         ! -----------------------------------------------------------------------
             483                         ! major cloud microphysics
             484                         ! -----------------------------------------------------------------------
             485                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 200
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             486     1                   do j = js, je
             487     1                       call mpdrv (hydrostatic, uin, vin, w, delp, pt, qv, ql, qr, qi, qs, qg,&
             488     1                           qa, qn, dz, is, ie, js, je, ks, ke, ktop, kbot, j, dt_in, ntimes,  &
             489     1                           rain (:, j), snow (:, j), graupel (:, j), ice (:, j), m2_rain,     &
             490     1                           m2_sol, cond (:, j), area (:, j), land (:, j), udt, vdt, pt_dt,    &
             491     1                           qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt, qa_dt, w_var, vt_r,      &
             492     1                           vt_s, vt_g, vt_i, qn2, rhc)
             493     1                   enddo
             494                     
             495                         ! -----------------------------------------------------------------------
             496                         ! no clouds allowed above ktop
             497                         ! -----------------------------------------------------------------------
             498                     
             499     1                   if (ks < ktop) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             500     2  pp                   do k = ks, ktop
             501     3   p                       if (do_qa) then
             502     4   p                           do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             503     5   p   4v                          do i = is, ie
             504     5   p   4v                              qa_dt (i, j, k) = 0.
             505     5   p   4v                          enddo
             506     4   p                           enddo
             507     3   p                       else
             508     4   p                           do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             509     5   p   4v                          do i = is, ie
             510     5                                       ! qa_dt (i, j, k) = - qa (i, j, k) * rdt
             511     5   p   4v                              qa_dt (i, j, k) = 0. ! gfs
             512     5   p   4v                          enddo
             513     4   p                           enddo
             514     3   p                       endif
             515     2   p                   enddo
             516     1                   endif
             517                     
             518                         ! -----------------------------------------------------------------------
             519                         ! diagnostic output
             520                         ! -----------------------------------------------------------------------
             521                     
             522                         ! if (id_vtr > 0) then
             523                         ! used = send_data (id_vtr, vt_r, time, is_in = iis, js_in = jjs)
             524                         ! endif
             525                     
             526                         ! if (id_vts > 0) then
             527                         ! used = send_data (id_vts, vt_s, time, is_in = iis, js_in = jjs)
             528                         ! endif
             529                     
             530                         ! if (id_vtg > 0) then
             531                         ! used = send_data (id_vtg, vt_g, time, is_in = iis, js_in = jjs)
             532                         ! endif
             533                     
             534                         ! if (id_vti > 0) then
             535                         ! used = send_data (id_vti, vt_i, time, is_in = iis, js_in = jjs)
             536                         ! endif
             537                     
             538                         ! if (id_droplets > 0) then
             539                         ! used = send_data (id_droplets, qn2, time, is_in = iis, js_in = jjs)
             540                         ! endif
             541                     
             542                         ! if (id_var > 0) then
             543                         ! used = send_data (id_var, w_var, time, is_in = iis, js_in = jjs)
             544                         ! endif
             545                     
             546                         !! convert to mm / day  (original)
             547                         ! convt = 86400. * rdt * rgrav
             548                     
             549                         !! convert to mm / s
             550                         ! convt = rdt * rgrav
             551                     
             552                         ! convert to mm
             553                          convt = rgrav
             554                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prec_mp
                                   <<< Loop-information  End >>>
             555     1  pp               do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.76, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prec_mp
                                   <<< Loop-information  End >>>
             556     2   p    v              do i = is, ie
             557     2   p    v                  rain (i, j) = rain (i, j) * convt
             558     2   p    v                  snow (i, j) = snow (i, j) * convt
             559     2   p    v                  ice (i, j) = ice (i, j) * convt
             560     2   p    v                  graupel (i, j) = graupel (i, j) * convt
             561     2   p    v                  prec_mp (i, j) = rain (i, j) + snow (i, j) + ice (i, j) + graupel (i, j)
             562     2   p    v              enddo
             563     1   p               enddo
             564                     
             565                         ! if (id_cond > 0) then
             566                         ! do j = js, je
             567                         ! do i = is, ie
             568                         ! cond (i, j) = cond (i, j) * rgrav
             569                         ! enddo
             570                         ! enddo
             571                         ! used = send_data (id_cond, cond, time, is_in = iis, js_in = jjs)
             572                         ! endif
             573                     
             574                         ! if (id_snow > 0) then
             575                         ! used = send_data (id_snow, snow, time, iis, jjs)
             576                         ! used = send_data (id_snow, snow, time, is_in = iis, js_in = jjs)
             577                         ! if (mp_print .and. seconds == 0) then
             578                         ! tot_prec = g_sum (snow, is, ie, js, je, area, 1)
             579                         ! if (master) write (*, *) 'mean snow = ', tot_prec
             580                         ! endif
             581                         ! endif
             582                         !
             583                         ! if (id_graupel > 0) then
             584                         ! used = send_data (id_graupel, graupel, time, iis, jjs)
             585                         ! used = send_data (id_graupel, graupel, time, is_in = iis, js_in = jjs)
             586                         ! if (mp_print .and. seconds == 0) then
             587                         ! tot_prec = g_sum (graupel, is, ie, js, je, area, 1)
             588                         ! if (master) write (*, *) 'mean graupel = ', tot_prec
             589                         ! endif
             590                         ! endif
             591                         !
             592                         ! if (id_ice > 0) then
             593                         ! used = send_data (id_ice, ice, time, iis, jjs)
             594                         ! used = send_data (id_ice, ice, time, is_in = iis, js_in = jjs)
             595                         ! if (mp_print .and. seconds == 0) then
             596                         ! tot_prec = g_sum (ice, is, ie, js, je, area, 1)
             597                         ! if (master) write (*, *) 'mean ice_mp = ', tot_prec
             598                         ! endif
             599                         ! endif
             600                         !
             601                         ! if (id_rain > 0) then
             602                         ! used = send_data (id_rain, rain, time, iis, jjs)
             603                         ! used = send_data (id_rain, rain, time, is_in = iis, js_in = jjs)
             604                         ! if (mp_print .and. seconds == 0) then
             605                         ! tot_prec = g_sum (rain, is, ie, js, je, area, 1)
             606                         ! if (master) write (*, *) 'mean rain = ', tot_prec
             607                         ! endif
             608                         ! endif
             609                         !
             610                         ! if (id_rh > 0) then !not used?
             611                         ! used = send_data (id_rh, rh0, time, iis, jjs)
             612                         ! used = send_data (id_rh, rh0, time, is_in = iis, js_in = jjs)
             613                         ! endif
             614                         !
             615                         !
             616                         ! if (id_prec > 0) then
             617                         ! used = send_data (id_prec, prec_mp, time, iis, jjs)
             618                         ! used = send_data (id_prec, prec_mp, time, is_in = iis, js_in = jjs)
             619                         ! endif
             620                     
             621                         ! if (mp_print) then
             622                         ! prec1 (:, :) = prec1 (:, :) + prec_mp (:, :)
             623                         ! if (seconds == 0) then
             624                         ! prec1 (:, :) = prec1 (:, :) * dt_in / 86400.
             625                         ! tot_prec = g_sum (prec1, is, ie, js, je, area, 1)
             626                         ! if (master) write (*, *) 'daily prec_mp = ', tot_prec
             627                         ! prec1 (:, :) = 0.
             628                         ! endif
             629                         ! endif
             630                     
             631                         ! call mpp_clock_end (gfdl_mp_clock)
             632                     
             633     1                   if ( lradar ) then
             634     1                      ! Only set melti to true at the output times
             635     2                      if ( reset ) then
             636     2                        melti = .true.
             637     2                      else
             638     2                        melti = .false.
             639     2                      endif
             640     1               !       do j = js, je
             641     1               !          do i = is, ie
             642     1               !             do k = ktop,kbot
             643     1               !               kflip = kbot - ktop + 1 - k + 1
             644     1               !               t1d(k)  = pt(i,j,kflip)
             645     1               !               p1d(k)  = p (i,j,kflip)
             646     1               !               qv1d(k) = qv(i,j,kflip)/(1.-qv(i,j,kflip))
             647     1               !               qr1d(k) = qr(i,j,kflip)
             648     1               !               qs1d(k) = qs(i,j,kflip)
             649     1               !               qg1d(k) = qg(i,j,kflip)
             650     1               !             enddo
             651     1               !             call refl10cm_gfdl (qv1d, qr1d, qs1d, qg1d,                 &
             652     1               !                       t1d, p1d, dBZ, ktop, kbot, i,j, melti)
             653     1               !             do k = ktop,kbot
             654     1               !                kflip = kbot - ktop + 1 - k + 1
             655     1               !                refl_10cm(i,j,kflip) = MAX(-35., dBZ(k))
             656     1               !             enddo
             657     1               !          enddo
             658     1               !       enddo
             659     1                   endif
             660                     
             661                     
             662                     end subroutine gfdl_cloud_microphys_driver
             663                     
             664                     ! -----------------------------------------------------------------------
             665                     !>@brief gfdl cloud microphysics, major program
             666                     !>@details lin et al., 1983, jam, 1065 - 1092, and
             667                     !! rutledge and hobbs, 1984, jas, 2949 - 2972
             668                     !! terminal fall is handled lagrangianly by conservative fv algorithm
             669                     !>@param pt: temperature (k)
             670                     !>@param 6 water species:
             671                     !>@param 1) qv: water vapor (kg / kg)
             672                     !>@param 2) ql: cloud water (kg / kg)
             673                     !>@param 3) qr: rain (kg / kg)
             674                     !>@param 4) qi: cloud ice (kg / kg)
             675                     !>@param 5) qs: snow (kg / kg)
             676                     !>@param 6) qg: graupel (kg / kg)
             677                     ! -----------------------------------------------------------------------
             678                     subroutine mpdrv (hydrostatic, uin, vin, w, delp, pt, qv, ql, qr, qi, qs,     &
             679                             qg, qa, qn, dz, is, ie, js, je, ks, ke, ktop, kbot, j, dt_in, ntimes, &
             680                             rain, snow, graupel, ice, m2_rain, m2_sol, cond, area1, land,         &
             681                             u_dt, v_dt, pt_dt, qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt, qa_dt,   &
             682                             w_var, vt_r, vt_s, vt_g, vt_i, qn2, rhc)
             683                     
             684                         implicit none
             685                     
             686                         logical, intent (in) :: hydrostatic
             687                     
             688                         integer, intent (in) :: j, is, ie, js, je, ks, ke
             689                         integer, intent (in) :: ntimes, ktop, kbot
             690                     
             691                         real, intent (in) :: dt_in
             692                         real, intent (in), dimension (is:, ks:) :: rhc
             693                     
             694                         real, intent (in), dimension (is:) :: area1, land
             695                     
             696                         real, intent (in), dimension (is:, js:, ks:) :: uin, vin, delp, pt, dz
             697                         real, intent (in), dimension (is:, js:, ks:) :: qv, ql, qr, qg, qa, qn
             698                     
             699                         real, intent (inout), dimension (is:, js:, ks:) :: qi, qs
             700                         real, intent (inout), dimension (is:, js:, ks:) :: u_dt, v_dt, w, pt_dt, qa_dt
             701                         real, intent (inout), dimension (is:, js:, ks:) :: qv_dt, ql_dt, qr_dt, qi_dt, qs_dt, qg_dt
             702                     
             703                         real, intent (inout), dimension (is:) :: rain, snow, ice, graupel, cond
             704                     
             705                         real, intent (out), dimension (is:, js:) :: w_var
             706                     
             707                         real, intent (out), dimension (is:, js:, ks:) :: vt_r, vt_s, vt_g, vt_i, qn2
             708                     
             709                         real, intent (out), dimension (is:, ks:) :: m2_rain, m2_sol
             710                     
             711                         real, dimension (ktop:kbot) :: qvz, qlz, qrz, qiz, qsz, qgz, qaz
             712                         real, dimension (ktop:kbot) :: vtiz, vtsz, vtgz, vtrz
             713                         real, dimension (ktop:kbot) :: dp0, dp1, dz0, dz1
             714                         real, dimension (ktop:kbot) :: qv0, ql0, qr0, qi0, qs0, qg0, qa0
             715                         real, dimension (ktop:kbot) :: t0, den, den0, tz, p1, denfac
             716                         real, dimension (ktop:kbot) :: ccn, c_praut, m1_rain, m1_sol, m1
             717                         real, dimension (ktop:kbot) :: u0, v0, u1, v1, w1
             718                         real, dimension (ktop:kbot) :: rhcz
             719                     
             720                         real :: cpaut, rh_adj, rh_rain

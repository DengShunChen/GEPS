            3638                         deallocate (table2)
            3639                         deallocate (table3)
            3640                         deallocate (tablew)
            3641                         deallocate (des)
            3642                         deallocate (des2)
            3643                         deallocate (des3)
            3644                         deallocate (desw)
            3645                     
            3646                         tables_are_initialized = .false.
            3647                     

            4216                     ! =======================================================================
            4217                     !>@brief saturation water vapor pressure table ii
            4218                     ! 1 - phase table
            4219                     ! =======================================================================
            4220                     
            4221                     subroutine qs_tablew (n)
            4222                     
            4223                         implicit none
            4224                     
            4225                         integer, intent (in) :: n
            4226                     
            4227                         real :: delt = 0.1
            4228                         real :: tmin, tem, fac0, fac1, fac2
            4229                     
            4230                         integer :: i
            4231                     
            4232                         tmin = table_ice - 160.
            4233                     
            4234                         ! -----------------------------------------------------------------------
            4235                         ! compute es over water
            4236                         ! -----------------------------------------------------------------------
            4237                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tablew
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4238     1  pp    v          do i = 1, n
            4239     1   p    v              tem = tmin + delt * real (i - 1)
            4240     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4241     1   p    v              fac1 = fac0 * lv0
            4242     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4243     1   p    v              tablew (i) = e00 * exp (fac2)
            4244     1   p    v          enddo
            4245                     
            4246                     end subroutine qs_tablew
            4247                     
            4248                     ! =======================================================================
            4249                     !>@brief saturation water vapor pressure table iii
            4250                     ! 2 - phase table
            4251                     ! =======================================================================
            4252                     
            4253                     subroutine qs_table2 (n)
            4254                     
            4255                         implicit none
            4256                     
            4257                         integer, intent (in) :: n
            4258                     
            4259                         real :: delt = 0.1
            4260                         real :: tmin, tem0, tem1, fac0, fac1, fac2
            4261                     
            4262                         integer :: i, i0, i1
            4263                     
            4264                         tmin = table_ice - 160.
            4265                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4266     1  pp    v          do i = 1, n
            4267     1   p    v              tem0 = tmin + delt * real (i - 1)
            4268     1   p    v              fac0 = (tem0 - t_ice) / (tem0 * t_ice)
            4269     2   p    v              if (i <= 1600) then
            4270     2                           ! -----------------------------------------------------------------------
            4271     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4272     2                           ! -----------------------------------------------------------------------
            4273     2   p    v                  fac1 = fac0 * li2
            4274     2   p    v                  fac2 = (d2ice * log (tem0 / t_ice) + fac1) / rvgas
            4275     2   p    v              else
            4276     2                           ! -----------------------------------------------------------------------
            4277     2                           ! compute es over water between 0 deg c and 102 deg c.
            4278     2                           ! -----------------------------------------------------------------------
            4279     2   p    v                  fac1 = fac0 * lv0
            4280     2   p    v                  fac2 = (dc_vap * log (tem0 / t_ice) + fac1) / rvgas
            4281     2   p    v              endif
            4282     1   p    v              table2 (i) = e00 * exp (fac2)
            4283     1   p    v          enddo
            4284                     
            4285                         ! -----------------------------------------------------------------------
            4286                         ! smoother around 0 deg c
            4287                         ! -----------------------------------------------------------------------
            4288                     
            4289                         i0 = 1600
            4290                         i1 = 1601
            4291                         tem0 = 0.25 * (table2 (i0 - 1) + 2. * table (i0) + table2 (i0 + 1))
            4292                         tem1 = 0.25 * (table2 (i1 - 1) + 2. * table (i1) + table2 (i1 + 1))
            4293                         table2 (i0) = tem0
            4294                         table2 (i1) = tem1
            4295                     
            4296                     end subroutine qs_table2
            4297                     
            4298                     ! =======================================================================
            4299                     !>@brief saturation water vapor pressure table iv
            4300                     ! 2 - phase table with " - 2 c" as the transition point
            4301                     ! =======================================================================
            4302                     
            4303                     subroutine qs_table3 (n)
            4304                     
            4305                         implicit none
            4306                     
            4307                         integer, intent (in) :: n
            4308                     
            4309                         real :: delt = 0.1
            4310                         real :: esbasw, tbasw, esbasi, tmin, tem, aa, b, c, d, e
            4311                         real :: tem0, tem1
            4312                     
            4313                         integer :: i, i0, i1
            4314                     
            4315                         esbasw = 1013246.0
            4316                         tbasw = table_ice + 100.
            4317                         esbasi = 6107.1
            4318                         tmin = table_ice - 160.
            4319                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 42
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4320     1  pp    v          do i = 1, n
            4321     1   p    v              tem = tmin + delt * real (i - 1)
            4322     1                       ! if (i <= 1600) then
            4323     2   p    v              if (i <= 1580) then ! change to - 2 c
            4324     2                           ! -----------------------------------------------------------------------
            4325     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4326     2                           ! see smithsonian meteorological tables page 350.
            4327     2                           ! -----------------------------------------------------------------------
            4328     2   p    v                  aa = - 9.09718 * (table_ice / tem - 1.)
            4329     2   p    v                  b = - 3.56654 * alog10 (table_ice / tem)
            4330     2   p    v                  c = 0.876793 * (1. - tem / table_ice)
            4331     2   p    v                  e = alog10 (esbasi)
            4332     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + e)
            4333     2   p    v              else
            4334     2                           ! -----------------------------------------------------------------------
            4335     2                           ! compute es over water between - 2 deg c and 102 deg c.
            4336     2                           ! see smithsonian meteorological tables page 350.
            4337     2                           ! -----------------------------------------------------------------------
            4338     2   p    v                  aa = - 7.90298 * (tbasw / tem - 1.)
            4339     2   p    v                  b = 5.02808 * alog10 (tbasw / tem)
            4340     2   p    v                  c = - 1.3816e-7 * (10 ** ((1. - tem / tbasw) * 11.344) - 1.)
            4341     2   p    v                  d = 8.1328e-3 * (10 ** ((tbasw / tem - 1.) * (- 3.49149)) - 1.)
            4342     2   p    v                  e = alog10 (esbasw)
            4343     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + d + e)
            4344     2   p    v              endif
            4345     1   p    v          enddo
            4346                     
            4347                         ! -----------------------------------------------------------------------
            4348                         ! smoother around - 2 deg c
            4349                         ! -----------------------------------------------------------------------
            4350                     
            4351                         i0 = 1580
            4352                         i1 = 1581
            4353                         tem0 = 0.25 * (table3 (i0 - 1) + 2. * table (i0) + table3 (i0 + 1))
            4354                         tem1 = 0.25 * (table3 (i1 - 1) + 2. * table (i1) + table3 (i1 + 1))
            4355                         table3 (i0) = tem0
            4356                         table3 (i1) = tem1
            4357                     
            4358                     end subroutine qs_table3
            4359                     
            4360                     ! =======================================================================
            4361                     ! compute the saturated specific humidity for table
            4362                     ! note: this routine is based on "moist" mixing ratio
            4363                     !>@brief The function 'qs_blend' computes the saturated specific humidity
            4364                     !! with a blend of water and ice depending on the temperature.
            4365                     ! =======================================================================
            4366                     
            4367                     real function qs_blend (t, p, q)
            4368                     
            4369                         implicit none
            4370                     
            4371                         real, intent (in) :: t, p, q
            4372                     
            4373                         real :: es, ap1, tmin
            4374                     
            4375                         integer :: it
            4376                     
            4377                         tmin = table_ice - 160.
            4378                         ap1 = 10. * dim (t, tmin) + 1.
            4379                         ap1 = min (2621., ap1)
            4380                         it = ap1
            4381                         es = table (it) + (ap1 - it) * des (it)
            4382                         qs_blend = eps * es * (1. + zvir * q) / p
            4383                     
            4384                     end function qs_blend
            4385                     
            4386                     ! =======================================================================
            4387                     !>@brief saturation water vapor pressure table i
            4388                     ! 3 - phase table
            4389                     ! =======================================================================
            4390                     
            4391                     subroutine qs_table (n)
            4392                     
            4393                         implicit none
            4394                     
            4395                         integer, intent (in) :: n
            4396                     
            4397                         real :: delt = 0.1
            4398                         real :: tmin, tem, esh20
            4399                         real :: wice, wh2o, fac0, fac1, fac2
            4400                         real :: esupc (200)
            4401                     
            4402                         integer :: i
            4403                     
            4404                         tmin = table_ice - 160.
            4405                     
            4406                         ! -----------------------------------------------------------------------
            4407                         ! compute es over ice between - 160 deg c and 0 deg c.
            4408                         ! -----------------------------------------------------------------------
            4409                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.46, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 48
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4410     1  pp    v          do i = 1, 1600
            4411     1   p    v              tem = tmin + delt * real (i - 1)
            4412     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4413     1   p    v              fac1 = fac0 * li2
            4414     1   p    v              fac2 = (d2ice * log (tem / t_ice) + fac1) / rvgas
            4415     1   p    v              table (i) = e00 * exp (fac2)
            4416     1   p    v          enddo
            4417                     
            4418                         ! -----------------------------------------------------------------------
            4419                         ! compute es over water between - 20 deg c and 102 deg c.
            4420                         ! -----------------------------------------------------------------------
            4421                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            4422     1  pp    v          do i = 1, 1221
            4423     1   p    v              tem = 253.16 + delt * real (i - 1)
            4424     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4425     1   p    v              fac1 = fac0 * lv0
            4426     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4427     1   p    v              esh20 = e00 * exp (fac2)
            4428     2   p    v              if (i <= 200) then
            4429     2   p    v                  esupc (i) = esh20
            4430     2   p    v              else
            4431     2   p    v                  table (i + 1400) = esh20
            4432     2   p    v              endif
            4433     1   p    v          enddo
            4434                     
            4435                         ! -----------------------------------------------------------------------
            4436                         ! derive blended es over ice and supercooled water between - 20 deg c and 0 deg c
            4437                         ! -----------------------------------------------------------------------
            4438                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table, (unknown)
                                   <<< Loop-information  End >>>
            4439     1   s   2v          do i = 1, 200
            4440     1   p   2v              tem = 253.16 + delt * real (i - 1)
            4441     1   p   2v              wice = 0.05 * (table_ice - tem)
            4442     1   p   2v              wh2o = 0.05 * (tem - 253.16)
            4443     1   p   2v              table (i + 1400) = wice * table (i + 1400) + wh2o * esupc (i)
            4444     1   p   2v          enddo
            4445                     
            4446                     end subroutine qs_table
            4447                     
            4448                     ! =======================================================================
            4449                     ! compute the saturated specific humidity and the gradient of saturated specific humidity
            4450                     ! input t in deg k, p in pa; p = rho rdry tv, moist pressure
            4451                     !>@brief The function 'qsmith' computes the saturated specific humidity
            4452                     !! with a blend of water and ice depending on the temperature in 3D.
            4453                     !@details It als oincludes the option for computing des/dT.
            4454                     ! =======================================================================
            4455                     
            4456                     subroutine qsmith (im, km, ks, t, p, q, qs, dqdt)
            4457                     
            4458                         implicit none
            4459                     
            4460                         integer, intent (in) :: im, km, ks
            4461                     
            4462                         real, intent (in), dimension (im, km) :: t, p, q
            4463                     
            4464                         real, intent (out), dimension (im, km) :: qs
            4465                     
            4466                         real, intent (out), dimension (im, km), optional :: dqdt
            4467                     
            4468                         real :: eps10, ap1, tmin
            4469                     
            4470                         real, dimension (im, km) :: es
            4471                     
            4472                         integer :: i, k, it
            4473                     
            4474                         tmin = table_ice - 160.
            4475                         eps10 = 10. * eps
            4476                     
            4477     1                   if (.not. tables_are_initialized) then
            4478     1                       call qsmith_init
            4479     1                   endif
            4480                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, es, qs
                                   <<< Loop-information  End >>>
            4481     1  pp               do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, p, t, qs, es
                                   <<< Loop-information  End >>>
            4482     2   p    v              do i = 1, im
            4483     2   p    v                  ap1 = 10. * dim (t (i, k), tmin) + 1.
            4484     2   p    v                  ap1 = min (2621., ap1)
            4485     2   p    v                  it = ap1
            4486     2   p    v                  es (i, k) = table (it) + (ap1 - it) * des (it)
            4487     2   p    v                  qs (i, k) = eps * es (i, k) * (1. + zvir * q (i, k)) / p (i, k)
            4488     2   p    v              enddo
            4489     1   p               enddo
            4490                     
            4491     1                   if (present (dqdt)) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, dqdt
                                   <<< Loop-information  End >>>
            4492     2  pp                   do k = ks, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, p, dqdt
                                   <<< Loop-information  End >>>
            4493     3   p    v                  do i = 1, im
            4494     3   p    v                      ap1 = 10. * dim (t (i, k), tmin) + 1.
            4495     3   p    v                      ap1 = min (2621., ap1) - 0.5
            4496     3   p    v                      it = ap1
            4497     3   p    v                      dqdt (i, k) = eps10 * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) * (1. + zvir * q (i, k)) / p (i, k)
            4498     3   p    v                  enddo
            4499     2   p                   enddo
            4500     1                   endif
            4501                     
            4502                     end subroutine qsmith
            4503                     
            4504                     ! =======================================================================
            4505                     !>@brief The subroutine 'neg_adj' fixes negative water species.
            4506                     !>@details This is designed for 6-class micro-physics schemes.
            4507                     ! =======================================================================
            4508                     
            4509                     subroutine neg_adj (ktop, kbot, pt, dp, qv, ql, qr, qi, qs, qg)
            4510                     
            4511                         implicit none
            4512                     
            4513                         integer, intent (in) :: ktop, kbot
            4514                     
            4515                         real, intent (in), dimension (ktop:kbot) :: dp
            4516                     
            4517                         real, intent (inout), dimension (ktop:kbot) :: pt, qv, ql, qr, qi, qs, qg
            4518                     
            4519                         real, dimension (ktop:kbot) :: lcpk, icpk
            4520                     
            4521                         real :: dq, cvm
            4522                     
            4523                         integer :: k
            4524                     
            4525                         ! -----------------------------------------------------------------------
            4526                         ! define heat capacity and latent heat coefficient
            4527                         ! -----------------------------------------------------------------------
            4528                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 142
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 4529,4535)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.19, ITR: 64, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv, pt, qg, lcpk, qs, ql, qr, qi, icpk
                                   <<< Loop-information  End >>>
            4529     1  pp    v          do k = ktop, kbot
            4530     1   p    v              cvm = c_air + qv (k) * c_vap + (qr (k) + ql (k)) * c_liq + (qi (k) + qs (k) + qg (k)) * c_ice
            4531     1   p    v              lcpk (k) = (lv00 + d0_vap * pt (k)) / cvm
            4532     1   p    v              icpk (k) = (li00 + dc_ice * pt (k)) / cvm
            4533     1   p    v          enddo
            4534                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            4535     1                   do k = ktop, kbot
            4536     1               
            4537     1                       ! -----------------------------------------------------------------------
            4538     1                       ! ice phase:
            4539     1                       ! -----------------------------------------------------------------------
            4540     1               
            4541     1                       ! if cloud ice < 0, borrow from snow
            4542     2                       if (qi (k) < 0.) then
            4543     2                           qs (k) = qs (k) + qi (k)
            4544     2                           qi (k) = 0.
            4545     2                       endif
            4546     1                       ! if snow < 0, borrow from graupel
            4547     2                       if (qs (k) < 0.) then
            4548     2                           qg (k) = qg (k) + qs (k)
            4549     2                           qs (k) = 0.
            4550     2                       endif
            4551     1                       ! if graupel < 0, borrow from rain
            4552     2                       if (qg (k) < 0.) then
            4553     2                           qr (k) = qr (k) + qg (k)
            4554     2                           pt (k) = pt (k) - qg (k) * icpk (k) ! heating
            4555     2                           qg (k) = 0.
            4556     2                       endif
            4557     1               
            4558     1                       ! -----------------------------------------------------------------------
            4559     1                       ! liquid phase:
            4560     1                       ! -----------------------------------------------------------------------
            4561     1               
            4562     1                       ! if rain < 0, borrow from cloud water
            4563     2                       if (qr (k) < 0.) then
            4564     2                           ql (k) = ql (k) + qr (k)
            4565     2                           qr (k) = 0.
            4566     2                       endif
            4567     1                       ! if cloud water < 0, borrow from water vapor
            4568     2                       if (ql (k) < 0.) then
            4569     2                           qv (k) = qv (k) + ql (k)
            4570     2                           pt (k) = pt (k) - ql (k) * lcpk (k) ! heating
            4571     2                           ql (k) = 0.
            4572     2                       endif
            4573     1               
            4574     1                   enddo
            4575                     
            4576                         ! -----------------------------------------------------------------------
            4577                         ! fix water vapor; borrow from below
            4578                         ! -----------------------------------------------------------------------
            4579                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            4580     1   s   2s          do k = ktop, kbot - 1
            4581     2   s   2m              if (qv (k) < 0.) then
            4582     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            4583     2   s   2v                  qv (k) = 0.
            4584     2   s   2v              endif
            4585     1   s   2v          enddo
            4586                     
            4587                         ! -----------------------------------------------------------------------
            4588                         ! bottom layer; borrow from above
            4589                         ! -----------------------------------------------------------------------
            4590                     
            4591     1                   if (qv (kbot) < 0. .and. qv (kbot - 1) > 0.) then
            4592     1                       dq = min (- qv (kbot) * dp (kbot), qv (kbot - 1) * dp (kbot - 1))
            4593     1                       qv (kbot - 1) = qv (kbot - 1) - dq / dp (kbot - 1)
            4594     1                       qv (kbot) = qv (kbot) + dq / dp (kbot)
            4595     1                   endif
            4596                     
            4597                     end subroutine neg_adj
            4598                     
            4599                     ! =======================================================================
            4600                     ! compute global sum
            4601                     !>@brief quick local sum algorithm
            4602                     ! =======================================================================
            4603                     
            4604                     !real function g_sum (p, ifirst, ilast, jfirst, jlast, area, mode)
            4605                     !
            4606                     ! use mpp_mod, only: mpp_sum
            4607                     !
            4608                     ! implicit none
            4609                     !
            4610                     ! integer, intent (in) :: ifirst, ilast, jfirst, jlast
            4611                     ! integer, intent (in) :: mode ! if == 1 divided by area
            4612                     !
            4613                     ! real, intent (in), dimension (ifirst:ilast, jfirst:jlast) :: p, area
            4614                     !
            4615                     ! integer :: i, j
            4616                     !
            4617                     ! real :: gsum
            4618                     !
            4619                     ! if (global_area < 0.) then
            4620                     ! global_area = 0.
            4621                     ! do j = jfirst, jlast
            4622                     ! do i = ifirst, ilast
            4623                     ! global_area = global_area + area (i, j)
            4624                     ! enddo
            4625                     ! enddo
            4626                     ! call mpp_sum (global_area)
            4627                     ! endif
            4628                     !
            4629                     ! gsum = 0.
            4630                     ! do j = jfirst, jlast
            4631                     ! do i = ifirst, ilast
            4632                     ! gsum = gsum + p (i, j) * area (i, j)
            4633                     ! enddo
            4634                     ! enddo
            4635                     ! call mpp_sum (gsum)
            4636                     !
            4637                     ! if (mode == 1) then
            4638                     ! g_sum = gsum / global_area
            4639                     ! else
            4640                     ! g_sum = gsum
            4641                     ! endif
            4642                     !
            4643                     !end function g_sum

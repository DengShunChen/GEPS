            1502                     !>@author: Shian-Jiann lin, gfdl
            1503                     ! =======================================================================
            1504                     
            1505                     subroutine icloud (ktop, kbot, tzk, p1, qvk, qlk, qrk, qik, qsk, qgk, dp1, &
            1506                             den, denfac, vts, vtg, vtr, qak, rh_adj, rh_rain, dts, h_var, rhck)
            1507                     
            1508                         implicit none
            1509                     
            1510                         integer, intent (in) :: ktop, kbot
            1511                     
            1512                         real, intent (in), dimension (ktop:kbot) :: p1, dp1, den, denfac, vts, vtg, vtr
            1513                     
            1514                         real, intent (inout), dimension (ktop:kbot) :: tzk, qvk, qlk, qrk, qik, qsk, qgk, qak
            1515                     
            1516                         real, intent (in) :: rh_adj, rh_rain, dts, h_var
            1517                         real, intent (in), dimension (ktop:kbot) :: rhck
            1518                     
            1519                         real, dimension (ktop:kbot) :: lcpk, icpk, tcpk, di, lhl, lhi
            1520                         real, dimension (ktop:kbot) :: cvm, q_liq, q_sol
            1521                     
            1522                         real :: rdts, fac_g2v, fac_v2g, fac_i2s, fac_imlt
            1523                         real :: tz, qv, ql, qr, qi, qs, qg, melt
            1524                         real :: pracs, psacw, pgacw, psacr, pgacr, pgaci, praci, psaci
            1525                         real :: pgmlt, psmlt, pgfr, pgaut, psaut, pgsub
            1526                         real :: tc, tsq, dqs0, qden, qim, qsm
            1527                         real :: dt5, factor, sink, qi_crt
            1528                         real :: tmp, qsw, qsi, dqsdt, dq
            1529                         real :: dtmp, qc, q_plus, q_minus
            1530                     
            1531                         integer :: k
            1532                     
            1533                         dt5 = 0.5 * dts
            1534                     
            1535                         rdts = 1. / dts
            1536                     
            1537                         ! -----------------------------------------------------------------------
            1538                         ! define conversion scalar / factor
            1539                         ! -----------------------------------------------------------------------
            1540                     
            1541                         fac_i2s = 1. - exp (- dts / tau_i2s)
            1542                         fac_g2v = 1. - exp (- dts / tau_g2v)
            1543                         fac_v2g = 1. - exp (- dts / tau_v2g)
            1544                     
            1545                         fac_imlt = 1. - exp (- dt5 / tau_imlt)
            1546                     
            1547                         ! -----------------------------------------------------------------------
            1548                         ! define heat capacity and latend heat coefficient
            1549                         ! -----------------------------------------------------------------------
            1550                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 72
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1551,1566)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qlk, qrk, qvk, qik, qsk, qgk, tzk, q_liq
                                   <<<      lhi, q_sol, cvm, icpk, den
                                   <<< Loop-information  End >>>
            1551     1  pp    v          do k = ktop, kbot
            1552     1   p    v              lhi (k) = li00 + dc_ice * tzk (k)
            1553     1   p    v              q_liq (k) = qlk (k) + qrk (k)
            1554     1   p    v              q_sol (k) = qik (k) + qsk (k) + qgk (k)
            1555     1   p    v              cvm (k) = c_air + qvk (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1556     1   p    v              icpk (k) = lhi (k) / cvm (k)
            1557     1   p    v          enddo
            1558                     
            1559                         ! -----------------------------------------------------------------------
            1560                         ! sources of cloud ice: pihom, cold rain, and the sat_adj
            1561                         ! (initiation plus deposition)
            1562                         ! sources of snow: cold rain, auto conversion + accretion (from cloud ice)
            1563                         ! sat_adj (deposition; requires pre - existing snow) ; initial snow comes from auto conversion
            1564                         ! -----------------------------------------------------------------------
            1565                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1566     1                   do k = ktop, kbot
            1567     2                       if (tzk (k) > tice .and. qik (k) > qcmin) then
            1568     2               
            1569     2                           ! -----------------------------------------------------------------------
            1570     2                           ! pimlt: instant melting of cloud ice
            1571     2                           ! -----------------------------------------------------------------------
            1572     2               
            1573     2                           melt = min (qik (k), fac_imlt * (tzk (k) - tice) / icpk (k))
            1574     2                           tmp = min (melt, dim (ql_mlt, qlk (k))) ! max ql amount
            1575     2                           qlk (k) = qlk (k) + tmp
            1576     2                           qrk (k) = qrk (k) + melt - tmp
            1577     2                           qik (k) = qik (k) - melt
            1578     2                           q_liq (k) = q_liq (k) + melt
            1579     2                           q_sol (k) = q_sol (k) - melt
            1580     2                           cvm (k) = c_air + qvk (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1581     2                           tzk (k) = tzk (k) - melt * lhi (k) / cvm (k)
            1582     2               
            1583     2                       elseif (tzk (k) < t_wfr .and. qlk (k) > qcmin) then
            1584     2               
            1585     2                           ! -----------------------------------------------------------------------
            1586     2                           ! pihom: homogeneous freezing of cloud water into cloud ice
            1587     2                           ! this is the 1st occurance of liquid water freezing in the split mp process
            1588     2                           ! -----------------------------------------------------------------------
            1589     2               
            1590     2                           dtmp = t_wfr - tzk (k)
            1591     2                           factor = min (1., dtmp / dt_fr)
            1592     2                           sink = min (qlk (k) * factor, dtmp / icpk (k))
            1593     2                           qi_crt = qi_gen * min (qi_lim, 0.1 * (tice - tzk (k))) / den (k)
            1594     2                           tmp = min (sink, dim (qi_crt, qik (k)))
            1595     2                           qlk (k) = qlk (k) - sink
            1596     2                           qsk (k) = qsk (k) + sink - tmp
            1597     2                           qik (k) = qik (k) + tmp
            1598     2                           q_liq (k) = q_liq (k) - sink
            1599     2                           q_sol (k) = q_sol (k) + sink
            1600     2                           cvm (k) = c_air + qvk (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1601     2                           tzk (k) = tzk (k) + sink * lhi (k) / cvm (k)
            1602     2               
            1603     2                       endif
            1604     1                   enddo
            1605                     
            1606                         ! -----------------------------------------------------------------------
            1607                         ! vertical subgrid variability
            1608                         ! -----------------------------------------------------------------------
            1609                     
            1610                         call linear_prof (kbot - ktop + 1, qik (ktop), di (ktop), z_slope_ice, h_var)
            1611                     
            1612                         ! -----------------------------------------------------------------------
            1613                         ! update capacity heat and latend heat coefficient
            1614                         ! -----------------------------------------------------------------------
            1615                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tzk, cvm, icpk, lhi, tcpk, lcpk, lhl
                                   <<< Loop-information  End >>>
            1616     1  pp    v          do k = ktop, kbot
            1617     1   p    v              lhl (k) = lv00 + d0_vap * tzk (k)
            1618     1   p    v              lhi (k) = li00 + dc_ice * tzk (k)
            1619     1   p    v              lcpk (k) = lhl (k) / cvm (k)
            1620     1   p    v              icpk (k) = lhi (k) / cvm (k)
            1621     1   p    v              tcpk (k) = lcpk (k) + icpk (k)
            1622     1   p    v          enddo
            1623                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4

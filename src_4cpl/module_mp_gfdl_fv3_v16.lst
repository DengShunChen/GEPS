            1368     2               
            1369     2                           lhl (k) = lv00 + d0_vap * tz (k)
            1370     2                           q_liq (k) = ql (k) + qr (k)
            1371     2                           q_sol (k) = qi (k) + qs (k) + qg (k)
            1372     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1373     2                           lcpk (k) = lhl (k) / cvm (k)
            1374     2               

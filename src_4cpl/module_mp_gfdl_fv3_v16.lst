            1694     3                               ! sjl, 20170321:
            1695     3   p    v                      q_liq (k) = q_liq (k) + sink
            1696     3   p    v                      q_sol (k) = q_sol (k) - sink
            1697     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1698     3   p    v                      tz = tz - sink * lhi (k) / cvm (k)
            1699     3   p    v                      tc = tz - tice

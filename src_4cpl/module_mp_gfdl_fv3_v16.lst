            1710     2                           ! -----------------------------------------------------------------------
            1711     2                           ! melting of graupel
            1712     2                           ! -----------------------------------------------------------------------
            1713     2               
            1714     3   p    v                  if (qg > qcmin .and. tc > 0.) then
            1715     3               
            1716     3                               ! -----------------------------------------------------------------------
            1717     3                               ! pgacr: accretion of rain by graupel
            1718     3                               ! -----------------------------------------------------------------------
            1719     3               
            1720     3   p    v                      if (qr > qrmin) &
            1721     3                                   pgacr = min (acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1722     3                                       den (k)), rdts * qr)
            1723     3               
            1724     3                               ! -----------------------------------------------------------------------
            1725     3                               ! pgacw: accretion of cloud water by graupel
            1726     3                               ! -----------------------------------------------------------------------
            1727     3               
            1728     3   p    v                      qden = qg * den (k)
            1729     4   p    v                      if (ql > qrmin) then
            1730     4   p    v                          factor = cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            1731     4   p    v                          pgacw = factor / (1. + dts * factor) * ql ! rate
            1732     4   p    v                      endif
            1733     3               
            1734     3                               ! -----------------------------------------------------------------------
            1735     3                               ! pgmlt: graupel melt
            1736     3                               ! -----------------------------------------------------------------------
            1737     3               
            1738     3   pi   v                      pgmlt = dts * gmlt (tc, dqs0, qden, pgacw, pgacr, cgmlt, den (k))
            1739     3   p    v                      pgmlt = min (max (0., pgmlt), qg, tc / icpk (k))
            1740     3   p    v                      qg = qg - pgmlt
            1741     3   p    v                      qr = qr + pgmlt
            1742     3   p    v                      q_liq (k) = q_liq (k) + pgmlt
            1743     3   p    v                      q_sol (k) = q_sol (k) - pgmlt
            1744     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1745     3   p    v                      tz = tz - pgmlt * lhi (k) / cvm (k)
            1746     3               
            1747     3   p    v                  endif
            1748     2               
            1749     2   p    v              else
            1750     2               
            1751     2                           ! -----------------------------------------------------------------------
            1752     2                           ! cloud ice proc:
            1753     2                           ! -----------------------------------------------------------------------
            1754     2               
            1755     2                           ! -----------------------------------------------------------------------
            1756     2                           ! psaci: accretion of cloud ice by snow
            1757     2                           ! -----------------------------------------------------------------------
            1758     2               
            1759     3   p    v                  if (qi > 3.e-7) then ! cloud ice sink terms
            1760     3               
            1761     4   p    v                      if (qs > 1.e-7) then
            1762     4                                   ! -----------------------------------------------------------------------
            1763     4                                   ! sjl added (following lin eq. 23) the temperature dependency
            1764     4                                   ! to reduce accretion, use esi = exp (0.05 * tc) as in hong et al 2004
            1765     4                                   ! -----------------------------------------------------------------------
            1766     4   p    v                          factor = dts * denfac (k) * csaci * exp (0.05 * tc + 0.8125 * log (qs * den (k)))
            1767     4   p    v                          psaci = factor / (1. + factor) * qi
            1768     4   p    v                      else
            1769     4   p    v                          psaci = 0.
            1770     4   p    v                      endif
            1771     3               
            1772     3                               ! -----------------------------------------------------------------------
            1773     3                               ! pasut: autoconversion: cloud ice -- > snow
            1774     3                               ! -----------------------------------------------------------------------
            1775     3               
            1776     3                               ! -----------------------------------------------------------------------
            1777     3                               ! similar to lfo 1983: eq. 21 solved implicitly
            1778     3                               ! threshold from wsm6 scheme, hong et al 2004, eq (13) : qi0_crt ~0.8e-4
            1779     3                               ! -----------------------------------------------------------------------
            1780     3               
            1781     3   p    v                      qim = qi0_crt / den (k)
            1782     3               
            1783     3                               ! -----------------------------------------------------------------------
            1784     3                               ! assuming linear subgrid vertical distribution of cloud ice
            1785     3                               ! the mismatch computation following lin et al. 1994, mwr
            1786     3                               ! -----------------------------------------------------------------------
            1787     3               
            1788     4   p    v                      if (const_vi) then
            1789     4   p    v                          tmp = fac_i2s
            1790     4   p    v                      else
            1791     4   p    v                          tmp = fac_i2s * exp (0.025 * tc)
            1792     4   p    v                      endif
            1793     3               
            1794     3   p    v                      di (k) = max (di (k), qrmin)
            1795     3   p    v                      q_plus = qi + di (k)
            1796     4   p    v                      if (q_plus > (qim + qrmin)) then
            1797     5   p    v                          if (qim > (qi - di (k))) then
            1798     5   p    v                              dq = (0.25 * (q_plus - qim) ** 2) / di (k)
            1799     5   p    v                          else
            1800     5   p    v                              dq = qi - qim
            1801     5   p    v                          endif
            1802     4   p    v                          psaut = tmp * dq
            1803     4   p    v                      else
            1804     4   p    v                          psaut = 0.
            1805     4   p    v                      endif
            1806     3                               ! -----------------------------------------------------------------------
            1807     3                               ! sink is no greater than 75% of qi
            1808     3                               ! -----------------------------------------------------------------------
            1809     3   p    v                      sink = min (0.75 * qi, psaci + psaut)
            1810     3   p    v                      qi = qi - sink
            1811     3   p    v                      qs = qs + sink
            1812     3               
            1813     3                               ! -----------------------------------------------------------------------
            1814     3                               ! pgaci: accretion of cloud ice by graupel
            1815     3                               ! -----------------------------------------------------------------------
            1816     3               
            1817     4   p    v                      if (qg > 1.e-6) then
            1818     4                                   ! -----------------------------------------------------------------------
            1819     4                                   ! factor = dts * cgaci / sqrt (den (k)) * exp (0.05 * tc + 0.875 * log (qg * den (k)))
            1820     4                                   ! simplified form: remove temp dependency & set the exponent "0.875" -- > 1
            1821     4                                   ! -----------------------------------------------------------------------
            1822     4   p    v                          factor = dts * cgaci * sqrt (den (k)) * qg
            1823     4   p    v                          pgaci = factor / (1. + factor) * qi
            1824     4   p    v                          qi = qi - pgaci
            1825     4   p    v                          qg = qg + pgaci
            1826     4   p    v                      endif
            1827     3               
            1828     3   p    v                  endif
            1829     2               
            1830     2                           ! -----------------------------------------------------------------------
            1831     2                           ! cold - rain proc:
            1832     2                           ! -----------------------------------------------------------------------
            1833     2               
            1834     2                           ! -----------------------------------------------------------------------
            1835     2                           ! rain to ice, snow, graupel processes:
            1836     2                           ! -----------------------------------------------------------------------
            1837     2               
            1838     2   p    v                  tc = tz - tice
            1839     2               
            1840     3   p    v                  if (qr > 1.e-7 .and. tc < 0.) then
            1841     3               
            1842     3                               ! -----------------------------------------------------------------------
            1843     3                               ! * sink * terms to qr: psacr + pgfr
            1844     3                               ! source terms to qs: psacr
            1845     3                               ! source terms to qg: pgfr
            1846     3                               ! -----------------------------------------------------------------------
            1847     3               
            1848     3                               ! -----------------------------------------------------------------------
            1849     3                               ! psacr accretion of rain by snow
            1850     3                               ! -----------------------------------------------------------------------
            1851     3               
            1852     4   p    v                      if (qs > 1.e-7) then ! if snow exists
            1853     4   pi   v                          psacr = dts * acr3d (vts (k), vtr (k), qr, qs, csacr, acco (1, 2), den (k))
            1854     4   p    v                      else
            1855     4   p    v                          psacr = 0.
            1856     4   p    v                      endif
            1857     3               
            1858     3                               ! -----------------------------------------------------------------------
            1859     3                               ! pgfr: rain freezing -- > graupel
            1860     3                               ! -----------------------------------------------------------------------
            1861     3               
            1862     3   p    v                      pgfr = dts * cgfr (1) / den (k) * (exp (- cgfr (2) * tc) - 1.) * &
            1863     3                                   exp (1.75 * log (qr * den (k)))
            1864     3               
            1865     3                               ! -----------------------------------------------------------------------
            1866     3                               ! total sink to qr
            1867     3                               ! -----------------------------------------------------------------------
            1868     3               
            1869     3   p    v                      sink = psacr + pgfr
            1870     3   p    v                      factor = min (sink, qr, - tc / icpk (k)) / max (sink, qrmin)
            1871     3               
            1872     3   p    v                      psacr = factor * psacr
            1873     3   p    v                      pgfr = factor * pgfr
            1874     3               
            1875     3   p    v                      sink = psacr + pgfr
            1876     3   p    v                      qr = qr - sink
            1877     3   p    v                      qs = qs + psacr
            1878     3   p    v                      qg = qg + pgfr
            1879     3   p    v                      q_liq (k) = q_liq (k) - sink
            1880     3   p    v                      q_sol (k) = q_sol (k) + sink
            1881     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1882     3   p    v                      tz = tz + sink * lhi (k) / cvm (k)
            1883     3               
            1884     3   p    v                  endif
            1885     2               
            1886     2                           ! -----------------------------------------------------------------------
            1887     2                           ! update capacity heat and latend heat coefficient
            1888     2                           ! -----------------------------------------------------------------------
            1889     2               
            1890     2   p    v                  lhi (k) = li00 + dc_ice * tz
            1891     2   p    v                  icpk (k) = lhi (k) / cvm (k)
            1892     2               
            1893     2                           ! -----------------------------------------------------------------------
            1894     2                           ! graupel production terms:
            1895     2                           ! -----------------------------------------------------------------------
            1896     2               
            1897     3   p    v                  if (qs > 1.e-7) then
            1898     3               
            1899     3                               ! -----------------------------------------------------------------------
            1900     3                               ! accretion: snow -- > graupel
            1901     3                               ! -----------------------------------------------------------------------
            1902     3               
            1903     4   p    v                      if (qg > qrmin) then
            1904     4   pi   v                          sink = dts * acr3d (vtg (k), vts (k), qs, qg, cgacs, acco (1, 4), den (k))
            1905     4   p    v                      else
            1906     4   p    v                          sink = 0.
            1907     4   p    v                      endif
            1908     3               
            1909     3                               ! -----------------------------------------------------------------------
            1910     3                               ! autoconversion snow -- > graupel
            1911     3                               ! -----------------------------------------------------------------------
            1912     3               
            1913     3   p    v                      qsm = qs0_crt / den (k)
            1914     4   p    v                      if (qs > qsm) then
            1915     4   p    v                          factor = dts * 1.e-3 * exp (0.09 * (tz - tice))
            1916     4   p    v                          sink = sink + factor / (1. + factor) * (qs - qsm)
            1917     4   p    v                      endif
            1918     3   p    v                      sink = min (qs, sink)
            1919     3   p    v                      qs = qs - sink
            1920     3   p    v                      qg = qg + sink
            1921     3               
            1922     3   p    v                  endif ! snow existed
            1923     2               
            1924     3   p    v                  if (qg > 1.e-7 .and. tz < tice0) then
            1925     3               
            1926     3                               ! -----------------------------------------------------------------------
            1927     3                               ! pgacw: accretion of cloud water by graupel
            1928     3                               ! -----------------------------------------------------------------------
            1929     3               
            1930     4   p    v                      if (ql > 1.e-6) then
            1931     4   p    v                          qden = qg * den (k)
            1932     4   p    v                          factor = dts * cgacw * qden / sqrt (den (k) * sqrt (sqrt (qden)))
            1933     4   p    v                          pgacw = factor / (1. + factor) * ql
            1934     4   p    v                      else
            1935     4   p    v                          pgacw = 0.
            1936     4   p    v                      endif
            1937     3               
            1938     3                               ! -----------------------------------------------------------------------
            1939     3                               ! pgacr: accretion of rain by graupel
            1940     3                               ! -----------------------------------------------------------------------
            1941     3               
            1942     4   p    v                      if (qr > 1.e-6) then
            1943     4   pi   v                          pgacr = min (dts * acr3d (vtg (k), vtr (k), qr, qg, cgacr, acco (1, 3), &
            1944     4                                       den (k)), qr)
            1945     4   p    v                      else
            1946     4   p    v                          pgacr = 0.
            1947     4   p    v                      endif
            1948     3               
            1949     3   p    v                      sink = pgacr + pgacw
            1950     3   p    v                      factor = min (sink, dim (tice, tz) / icpk (k)) / max (sink, qrmin)
            1951     3   p    v                      pgacr = factor * pgacr
            1952     3   p    v                      pgacw = factor * pgacw
            1953     3               
            1954     3   p    v                      sink = pgacr + pgacw
            1955     3   p    v                      qg = qg + sink
            1956     3   p    v                      qr = qr - pgacr
            1957     3   p    v                      ql = ql - pgacw
            1958     3   p    v                      q_liq (k) = q_liq (k) - sink
            1959     3   p    v                      q_sol (k) = q_sol (k) + sink
            1960     3   p    v                      cvm (k) = c_air + qv * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1961     3   p    v                      tz = tz + sink * lhi (k) / cvm (k)
            1962     3               
            1963     3   p    v                  endif
            1964     2               
            1965     2   p    v              endif
            1966     1               
            1967     1   p    v              tzk (k) = tz
            1968     1   p    v              qvk (k) = qv
            1969     1   p    v              qlk (k) = ql
            1970     1   p    v              qik (k) = qi
            1971     1   p    v              qrk (k) = qr
            1972     1   p    v              qsk (k) = qs
            1973     1   p    v              qgk (k) = qg
            1974     1               
            1975     1   p    v          enddo
            1976                     
            1977                         ! -----------------------------------------------------------------------
            1978                         ! subgrid cloud microphysics
            1979                         ! -----------------------------------------------------------------------
            1980                     
            1981                         call subgrid_z_proc (ktop, kbot, p1, den, denfac, dts, rh_adj, tzk, qvk, &
            1982                             qlk, qrk, qik, qsk, qgk, qak, h_var, rhck, rh_rain)
            1983                     
            1984                     end subroutine icloud
            1985                     
            1986                     ! =======================================================================
            1987                     !>temperature sentive high vertical resolution processes
            1988                     ! =======================================================================
            1989                     
            1990                     subroutine subgrid_z_proc (ktop, kbot, p1, den, denfac, dts, rh_adj, tz, qv, &
            1991                         ql, qr, qi, qs, qg, qa, h_var, rhcz, rh_rain)
            1992                     
            1993                         implicit none
            1994                     
            1995                         integer, intent (in) :: ktop, kbot
            1996                     
            1997                         real, intent (in), dimension (ktop:kbot) :: p1, den, denfac
            1998                     
            1999                         real, intent (in) :: dts, rh_adj, h_var, rh_rain
            2000                         real, intent (in), dimension (ktop:kbot) :: rhcz
            2001                     
            2002                         real, intent (inout), dimension (ktop:kbot) :: tz, qv, ql, qr, qi, qs, qg, qa
            2003                     
            2004                         real, dimension (ktop:kbot) :: lcpk, icpk, tcpk, tcp3, lhl, lhi
            2005                         real, dimension (ktop:kbot) :: cvm, q_liq, q_sol, q_cond
            2006                     
            2007                         real :: fac_v2l, fac_l2v
            2008                     
            2009                         real :: pidep, qi_crt
            2010                     
            2011                         ! -----------------------------------------------------------------------
            2012                         ! qstar over water may be accurate only down to - 80 deg c with ~10% uncertainty
            2013                         ! must not be too large to allow psc
            2014                         ! -----------------------------------------------------------------------
            2015                     
            2016                         real :: rh, rqi, tin, qsw, qsi, qpz, qstar
            2017                         real :: dqsdt, dwsdt, dq, dq0, factor, tmp
            2018                         real :: q_plus, q_minus, dt_evap, dt_pisub
            2019                         real :: evap, sink, tc, pisub, q_adj, dtmp
            2020                         real :: pssub, pgsub, tsq, qden, fac_g2v, fac_v2g
            2021                     
            2022                         integer :: k
            2023                     
            2024     1                   if (fast_sat_adj) then
            2025     1                       dt_evap = 0.5 * dts
            2026     1                   else
            2027     1                       dt_evap = dts
            2028     1                   endif
            2029                     
            2030                         ! -----------------------------------------------------------------------
            2031                         ! define conversion scalar / factor
            2032                         ! -----------------------------------------------------------------------
            2033                     
            2034                         fac_v2l = 1. - exp (- dt_evap / tau_v2l)
            2035                         fac_l2v = 1. - exp (- dt_evap / tau_l2v)
            2036                     
            2037                         fac_g2v = 1. - exp (- dts / tau_g2v)
            2038                         fac_v2g = 1. - exp (- dts / tau_v2g)
            2039                     
            2040                         ! -----------------------------------------------------------------------
            2041                         ! define heat capacity and latend heat coefficient
            2042                         ! -----------------------------------------------------------------------
            2043                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 171
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.81, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, qi, qr, ql, qv, q_sol, cvm, q_liq
                                   <<<      qg, tz, icpk, lhi, tcp3, tcpk, lcpk, lhl
                                   <<< Loop-information  End >>>
            2044     1  pp    v          do k = ktop, kbot
            2045     1   p    v              lhl (k) = lv00 + d0_vap * tz (k)
            2046     1   p    v              lhi (k) = li00 + dc_ice * tz (k)
            2047     1   p    v              q_liq (k) = ql (k) + qr (k)
            2048     1   p    v              q_sol (k) = qi (k) + qs (k) + qg (k)
            2049     1   p    v              cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2050     1   p    v              lcpk (k) = lhl (k) / cvm (k)
            2051     1   p    v              icpk (k) = lhi (k) / cvm (k)
            2052     1   p    v              tcpk (k) = lcpk (k) + icpk (k)
            2053     1   p    v              tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2054     1   p    v          enddo
            2055                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p1
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 9
                                   <<<      SIMD&FP   : SPILL 7  FILL 17
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2056     1                   do k = ktop, kbot
            2057     1               
            2058     1                       if (p1 (k) < p_min) cycle
            2059     1               
            2060     1                       ! -----------------------------------------------------------------------
            2061     1                       ! instant deposit all water vapor to cloud ice when temperature is super low
            2062     1                       ! -----------------------------------------------------------------------
            2063     1               
            2064     2                       if (tz (k) < t_min) then
            2065     2                           sink = dim (qv (k), 1.e-7)
            2066     2                           qv (k) = qv (k) - sink
            2067     2                           qi (k) = qi (k) + sink
            2068     2                           q_sol (k) = q_sol (k) + sink
            2069     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2070     2                           tz (k) = tz (k) + sink * (lhl (k) + lhi (k)) / cvm (k)
            2071     2                           if (.not. do_qa) qa (k) = qa (k) + 1. ! air fully saturated; 100 % cloud cover
            2072     2                           cycle
            2073     2                       endif
            2074     1               
            2075     1                       ! -----------------------------------------------------------------------
            2076     1                       ! update heat capacity and latend heat coefficient
            2077     1                       ! -----------------------------------------------------------------------
            2078     1               
            2079     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2080     1                       lhi (k) = li00 + dc_ice * tz (k)
            2081     1                       lcpk (k) = lhl (k) / cvm (k)
            2082     1                       icpk (k) = lhi (k) / cvm (k)
            2083     1                       tcpk (k) = lcpk (k) + icpk (k)
            2084     1                       tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            2085     1               
            2086     1                       ! -----------------------------------------------------------------------
            2087     1                       ! instant evaporation / sublimation of all clouds if rh < rh_adj -- > cloud free
            2088     1                       ! -----------------------------------------------------------------------
            2089     1               
            2090     1                       qpz = qv (k) + ql (k) + qi (k)
            2091     1                       tin = tz (k) - (lhl (k) * (ql (k) + qi (k)) + lhi (k) * qi (k)) / (c_air + &
            2092     1                           qpz * c_vap + qr (k) * c_liq + (qs (k) + qg (k)) * c_ice)
            2093     2                       if (tin > t_sub + 6.) then
            2094     2    i                      rh = qpz / iqs1 (tin, den (k))
            2095     3                           if (rh < rh_adj) then ! qpz / rh_adj < qs
            2096     3                               tz (k) = tin
            2097     3                               qv (k) = qpz
            2098     3                               ql (k) = 0.
            2099     3                               qi (k) = 0.
            2100     3                               cycle ! cloud free
            2101     3                           endif
            2102     2                       endif
            2103     1               
            2104     1                       ! -----------------------------------------------------------------------
            2105     1                       ! cloud water < -- > vapor adjustment:
            2106     1                       ! -----------------------------------------------------------------------
            2107     1               
            2108     1    i                  qsw = wqs2 (tz (k), den (k), dwsdt)
            2109     1               !        dq0 = qsw - qv (k)
            2110     1                       dq0 = qsw * rhcz (k) - qv (k)   !xb141
            2111     2                       if (dq0 > 0.) then
            2112     2                           ! SJL 20170703 added ql factor to prevent the situation of high ql and low RH
            2113     2                           ! factor = min (1., fac_l2v * sqrt (max (0., ql (k)) / 1.e-5) * 10. * dq0 / qsw)
            2114     2                           ! factor = fac_l2v
            2115     2                           ! factor = 1
            2116     2                           factor = min (1., fac_l2v * (10. * dq0 / qsw)) ! the rh dependent factor = 1 at 90%
            2117     2                           evap = min (ql (k), factor * dq0 / (1. + tcp3 (k) * dwsdt))
            2118     2                       else ! condensate all excess vapor into cloud water
            2119     2                           ! -----------------------------------------------------------------------
            2120     2                           ! evap = fac_v2l * dq0 / (1. + tcp3 (k) * dwsdt)
            2121     2                           ! sjl, 20161108
            2122     2                           ! -----------------------------------------------------------------------
            2123     2                           evap = dq0 / (1. + tcp3 (k) * dwsdt)
            2124     2                       endif
            2125     1                       qv (k) = qv (k) + evap
            2126     1                       ql (k) = ql (k) - evap
            2127     1                       q_liq (k) = q_liq (k) - evap
            2128     1                       cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2129     1                       tz (k) = tz (k) - evap * lhl (k) / cvm (k)
            2130     1               
            2131     1                       ! -----------------------------------------------------------------------
            2132     1                       ! update heat capacity and latend heat coefficient
            2133     1                       ! -----------------------------------------------------------------------
            2134     1               
            2135     1                       lhi (k) = li00 + dc_ice * tz (k)
            2136     1                       icpk (k) = lhi (k) / cvm (k)
            2137     1               
            2138     1                       ! -----------------------------------------------------------------------
            2139     1                       ! enforce complete freezing below - 48 c
            2140     1                       ! -----------------------------------------------------------------------
            2141     1               
            2142     1                       dtmp = t_wfr - tz (k) ! [ - 40, - 48]
            2143     2                       if (dtmp > 0. .and. ql (k) > qcmin) then
            2144     2                           sink = min (ql (k), ql (k) * dtmp * 0.125, dtmp / icpk (k))
            2145     2                           ql (k) = ql (k) - sink
            2146     2                           qi (k) = qi (k) + sink
            2147     2                           q_liq (k) = q_liq (k) - sink
            2148     2                           q_sol (k) = q_sol (k) + sink
            2149     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2150     2                           tz (k) = tz (k) + sink * lhi (k) / cvm (k)
            2151     2                       endif
            2152     1               
            2153     1                       ! -----------------------------------------------------------------------
            2154     1                       ! update heat capacity and latend heat coefficient
            2155     1                       ! -----------------------------------------------------------------------
            2156     1               
            2157     1                       lhi (k) = li00 + dc_ice * tz (k)
            2158     1                       icpk (k) = lhi (k) / cvm (k)
            2159     1               
            2160     1                       ! -----------------------------------------------------------------------
            2161     1                       ! bigg mechanism
            2162     1                       ! -----------------------------------------------------------------------
            2163     1               
            2164     2                       if (fast_sat_adj) then
            2165     2                           dt_pisub = 0.5 * dts
            2166     2                       else
            2167     2                           dt_pisub = dts
            2168     2                           tc = tice - tz (k)
            2169     3                           if (ql (k) > qrmin .and. tc > 0.) then
            2170     3                               sink = 3.3333e-10 * dts * (exp (0.66 * tc) - 1.) * den (k) * ql (k) * ql (k)
            2171     3                               sink = min (ql (k), tc / icpk (k), sink)
            2172     3                               ql (k) = ql (k) - sink
            2173     3                               qi (k) = qi (k) + sink
            2174     3                               q_liq (k) = q_liq (k) - sink
            2175     3                               q_sol (k) = q_sol (k) + sink
            2176     3                               cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2177     3                               tz (k) = tz (k) + sink * lhi (k) / cvm (k)
            2178     3                           endif ! significant ql existed
            2179     2                       endif
            2180     1               
            2181     1                       ! -----------------------------------------------------------------------
            2182     1                       ! update capacity heat and latend heat coefficient
            2183     1                       ! -----------------------------------------------------------------------
            2184     1               
            2185     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2186     1                       lhi (k) = li00 + dc_ice * tz (k)
            2187     1                       lcpk (k) = lhl (k) / cvm (k)
            2188     1                       icpk (k) = lhi (k) / cvm (k)
            2189     1                       tcpk (k) = lcpk (k) + icpk (k)
            2190     1               
            2191     1                       ! -----------------------------------------------------------------------
            2192     1                       ! sublimation / deposition of ice
            2193     1                       ! -----------------------------------------------------------------------
            2194     1               
            2195     2                       if (tz (k) < tice) then
            2196     2    i                      qsi = iqs2 (tz (k), den (k), dqsdt)
            2197     2                           dq = qv (k) - qsi
            2198     2                           sink = dq / (1. + tcpk (k) * dqsdt)
            2199     3                           if (qi (k) > qrmin) then
            2200     3                               ! eq 9, hong et al. 2004, mwr
            2201     3                               ! for a and b, see dudhia 1989: page 3103 eq (b7) and (b8)
            2202     3                               pidep = dt_pisub * dq * 349138.78 * exp (0.875 * log (qi (k) * den (k))) &
            2203     3                                    / (qsi * den (k) * lat2 / (0.0243 * rvgas * tz (k) ** 2) + 4.42478e4)
            2204     3                           else
            2205     3                               pidep = 0.
            2206     3                           endif
            2207     3                           if (dq > 0.) then ! vapor - > ice
            2208     3                               tmp = tice - tz (k)
            2209     3                               ! 20160912: the following should produce more ice at higher altitude
            2210     3                               ! qi_crt = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp))) / den (k)
            2211     3                               qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den (k)
            2212     3                               sink = min (sink, max (qi_crt - qi (k), pidep), tmp / tcpk (k))
            2213     3                           else ! ice -- > vapor
            2214     3                               pidep = pidep * min (1., dim (tz (k), t_sub) * 0.2)
            2215     3                               sink = max (pidep, sink, - qi (k))
            2216     3                           endif
            2217     2                           qv (k) = qv (k) - sink
            2218     2                           qi (k) = qi (k) + sink
            2219     2                           q_sol (k) = q_sol (k) + sink
            2220     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2221     2                           tz (k) = tz (k) + sink * (lhl (k) + lhi (k)) / cvm (k)
            2222     2                       endif
            2223     1               
            2224     1                       ! -----------------------------------------------------------------------
            2225     1                       ! update capacity heat and latend heat coefficient
            2226     1                       ! -----------------------------------------------------------------------
            2227     1               
            2228     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2229     1                       lhi (k) = li00 + dc_ice * tz (k)
            2230     1                       lcpk (k) = lhl (k) / cvm (k)
            2231     1                       icpk (k) = lhi (k) / cvm (k)
            2232     1                       tcpk (k) = lcpk (k) + icpk (k)
            2233     1               
            2234     1                       ! -----------------------------------------------------------------------
            2235     1                       ! sublimation / deposition of snow
            2236     1                       ! this process happens for all temp rage
            2237     1                       ! -----------------------------------------------------------------------
            2238     1               
            2239     2                       if (qs (k) > qrmin) then
            2240     2    i                      qsi = iqs2 (tz (k), den (k), dqsdt)
            2241     2                           qden = qs (k) * den (k)
            2242     2                           tmp = exp (0.65625 * log (qden))
            2243     2                           tsq = tz (k) * tz (k)
            2244     2                           dq = (qsi - qv (k)) / (1. + tcpk (k) * dqsdt)
            2245     2                           pssub = cssub (1) * tsq * (cssub (2) * sqrt (qden) + cssub (3) * tmp * &
            2246     2                               sqrt (denfac (k))) / (cssub (4) * tsq + cssub (5) * qsi * den (k))
            2247     2                           pssub = (qsi - qv (k)) * dts * pssub
            2248     3                           if (pssub > 0.) then ! qs -- > qv, sublimation
            2249     3                               pssub = min (pssub * min (1., dim (tz (k), t_sub) * 0.2), qs (k))
            2250     3                           else
            2251     4                               if (tz (k) > tice) then
            2252     4                                   pssub = 0. ! no deposition
            2253     4                               else
            2254     4                                   pssub = max (pssub, dq, (tz (k) - tice) / tcpk (k))
            2255     4                               endif
            2256     3                           endif
            2257     2                           qs (k) = qs (k) - pssub
            2258     2                           qv (k) = qv (k) + pssub
            2259     2                           q_sol (k) = q_sol (k) - pssub
            2260     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2261     2                           tz (k) = tz (k) - pssub * (lhl (k) + lhi (k)) / cvm (k)
            2262     2                       endif
            2263     1               
            2264     1                       ! -----------------------------------------------------------------------
            2265     1                       ! update capacity heat and latend heat coefficient
            2266     1                       ! -----------------------------------------------------------------------
            2267     1               
            2268     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2269     1                       lhi (k) = li00 + dc_ice * tz (k)
            2270     1                       lcpk (k) = lhl (k) / cvm (k)
            2271     1                       icpk (k) = lhi (k) / cvm (k)
            2272     1                       tcpk (k) = lcpk (k) + icpk (k)
            2273     1               
            2274     1                       ! -----------------------------------------------------------------------
            2275     1                       ! simplified 2 - way grapuel sublimation - deposition mechanism
            2276     1                       ! -----------------------------------------------------------------------
            2277     1               
            2278     2                       if (qg (k) > qrmin) then
            2279     2    i                      qsi = iqs2 (tz (k), den (k), dqsdt)
            2280     2                           dq = (qv (k) - qsi) / (1. + tcpk (k) * dqsdt)
            2281     2                           pgsub = (qv (k) / qsi - 1.) * qg (k)
            2282     3                           if (pgsub > 0.) then ! deposition
            2283     4                               if (tz (k) > tice) then
            2284     4                                   pgsub = 0. ! no deposition
            2285     4                               else
            2286     4                                   pgsub = min (fac_v2g * pgsub, 0.2 * dq, ql (k) + qr (k), &
            2287     4                                       (tice - tz (k)) / tcpk (k))
            2288     4                               endif
            2289     3                           else ! submilation
            2290     3                               pgsub = max (fac_g2v * pgsub, dq) * min (1., dim (tz (k), t_sub) * 0.1)
            2291     3                           endif
            2292     2                           qg (k) = qg (k) + pgsub
            2293     2                           qv (k) = qv (k) - pgsub
            2294     2                           q_sol (k) = q_sol (k) + pgsub
            2295     2                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2296     2                           tz (k) = tz (k) + pgsub * (lhl (k) + lhi (k)) / cvm (k)
            2297     2                       endif
            2298     1               
            2299     1               #ifdef USE_MIN_EVAP
            2300     1                       ! -----------------------------------------------------------------------
            2301     1                       ! update capacity heat and latend heat coefficient
            2302     1                       ! -----------------------------------------------------------------------
            2303     1               
            2304     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2305     1                       lcpk (k) = lhl (k) / cvm (k)
            2306     1               
            2307     1                       ! -----------------------------------------------------------------------
            2308     1                       ! * minimum evap of rain in dry environmental air
            2309     1                       ! -----------------------------------------------------------------------
            2310     1               
            2311     1                       if (qr (k) > qcmin) then
            2312     1                           qsw = wqs2 (tz (k), den (k), dqsdt)
            2313     1                           sink = min (qr (k), dim (rh_rain * qsw, qv (k)) / (1. + lcpk (k) * dqsdt))
            2314     1                           qv (k) = qv (k) + sink
            2315     1                           qr (k) = qr (k) - sink
            2316     1                           q_liq (k) = q_liq (k) - sink
            2317     1                           cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            2318     1                           tz (k) = tz (k) - sink * lhl (k) / cvm (k)
            2319     1                       endif
            2320     1               #endif
            2321     1               
            2322     1                       ! -----------------------------------------------------------------------
            2323     1                       ! update capacity heat and latend heat coefficient
            2324     1                       ! -----------------------------------------------------------------------
            2325     1               
            2326     1                       lhl (k) = lv00 + d0_vap * tz (k)
            2327     1                       cvm (k) = c_air + (qv (k) + q_liq (k) + q_sol (k)) * c_vap
            2328     1                       lcpk (k) = lhl (k) / cvm (k)
            2329     1               
            2330     1                       ! -----------------------------------------------------------------------
            2331     1                       ! compute cloud fraction
            2332     1                       ! -----------------------------------------------------------------------
            2333     1               
            2334     1                       ! -----------------------------------------------------------------------
            2335     1                       ! combine water species
            2336     1                       ! -----------------------------------------------------------------------
            2337     1               
            2338     1                       if (do_qa) cycle
            2339     1               
            2340     2                       if (rad_snow) then
            2341     2                           q_sol (k) = qi (k) + qs (k)
            2342     2                       else
            2343     2                           q_sol (k) = qi (k)
            2344     2                       endif
            2345     2                       if (rad_rain) then
            2346     2                           q_liq (k) = ql (k) + qr (k)
            2347     2                       else
            2348     2                           q_liq (k) = ql (k)
            2349     2                       endif
            2350     1                       q_cond (k) = q_liq (k) + q_sol (k)
            2351     1               
            2352     1                       qpz = qv (k) + q_cond (k) ! qpz is conserved
            2353     1               
            2354     1                       ! -----------------------------------------------------------------------
            2355     1                       ! use the "liquid - frozen water temperature" (tin) to compute saturated specific humidity
            2356     1                       ! -----------------------------------------------------------------------
            2357     1               
            2358     1                       tin = tz (k) - (lcpk (k) * q_cond (k) + icpk (k) * q_sol (k)) ! minimum temperature
            2359     1                       ! tin = tz (k) - ((lv00 + d0_vap * tz (k)) * q_cond (k) + &
            2360     1                       ! (li00 + dc_ice * tz (k)) * q_sol (k)) / (c_air + qpz * c_vap)
            2361     1               
            2362     1                       ! -----------------------------------------------------------------------
            2363     1                       ! determine saturated specific humidity
            2364     1                       ! -----------------------------------------------------------------------
            2365     1               
            2366     2                       if (tin <= t_wfr) then
            2367     2                           ! ice phase:
            2368     2    i                      qstar = iqs1 (tin, den (k))
            2369     2                       elseif (tin >= tice) then
            2370     2                           ! liquid phase:
            2371     2    i                      qstar = wqs1 (tin, den (k))
            2372     2                       else
            2373     2                           ! mixed phase:
            2374     2    i                      qsi = iqs1 (tin, den (k))
            2375     2    i                      qsw = wqs1 (tin, den (k))
            2376     3                           if (q_cond (k) > 3.e-6) then
            2377     3                               rqi = q_sol (k) / q_cond (k)
            2378     3                           else
            2379     3                               ! -----------------------------------------------------------------------
            2380     3                               ! mostly liquid water q_cond (k) at initial cloud development stage
            2381     3                               ! -----------------------------------------------------------------------
            2382     3                               rqi = (tice - tin) / (tice - t_wfr)
            2383     3                           endif
            2384     2                           qstar = rqi * qsi + (1. - rqi) * qsw
            2385     2                       endif
            2386     1               
            2387     1                       ! -----------------------------------------------------------------------
            2388     1                       ! assuming subgrid linear distribution in horizontal; this is effectively a smoother for the
            2389     1                       ! binary cloud scheme
            2390     1                       ! -----------------------------------------------------------------------
            2391     1               
            2392     2                       if (qpz > qrmin) then
            2393     2                           ! partial cloudiness by pdf:
            2394     2                           dq = max (qcmin, h_var * qpz)
            2395     2                           q_plus = qpz + dq ! cloud free if qstar > q_plus
            2396     2                           q_minus = qpz - dq
            2397     3                           if (qstar < q_minus) then
            2398     3                               qa (k) = qa (k) + 1. ! air fully saturated; 100 % cloud cover
            2399     3                           elseif (qstar < q_plus .and. q_cond (k) > qc_crt) then
            2400     3                               qa (k) = qa (k) + (q_plus - qstar) / (dq + dq) ! partial cloud cover
            2401     3                               ! qa (k) = sqrt (qa (k) + (q_plus - qstar) / (dq + dq))
            2402     3                           endif
            2403     2                       endif
            2404     1               
            2405     1                   enddo
            2406                     
            2407                     end subroutine subgrid_z_proc
            2408                     
            2409                     ! =======================================================================
            2410                     !> rain evaporation
            2411                     ! =======================================================================
            2412                     
            2413                     subroutine revap_rac1 (hydrostatic, is, ie, dt, tz, qv, ql, qr, qi, qs, qg, den, hvar)
            2414                     
            2415                         implicit none
            2416                     
            2417                         logical, intent (in) :: hydrostatic
            2418                     
            2419                         integer, intent (in) :: is, ie
            2420                     
            2421                         real, intent (in) :: dt ! time step (s)
            2422                     
            2423                         real, intent (in), dimension (is:ie) :: den, hvar, qi, qs, qg
            2424                     
            2425                         real, intent (inout), dimension (is:ie) :: tz, qv, qr, ql
            2426                     
            2427                         real, dimension (is:ie) :: lcp2, denfac, q_liq, q_sol, cvm, lhl
            2428                     
            2429                         real :: dqv, qsat, dqsdt, evap, qden, q_plus, q_minus, sink
            2430                         real :: tin, t2, qpz, dq, dqh
            2431                     
            2432                         integer :: i
            2433                     
            2434                         ! -----------------------------------------------------------------------
            2435                         ! define latend heat coefficient
            2436                         ! -----------------------------------------------------------------------
            2437                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, qg, tz, qs, q_sol, cvm, q_liq
                                   <<<      qi, qr, lcp2, lhl
                                   <<< Loop-information  End >>>
            2438     1  pp    v          do i = is, ie
            2439     1   p    v              lhl (i) = lv00 + d0_vap * tz (i)
            2440     1   p    v              q_liq (i) = ql (i) + qr (i)
            2441     1   p    v              q_sol (i) = qi (i) + qs (i) + qg (i)
            2442     1   p    v              cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2443     1   p    v              lcp2 (i) = lhl (i) / cvm (i)
            2444     1                       ! denfac (i) = sqrt (sfcrho / den (i))
            2445     1   p    v          enddo
            2446                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 5
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2447     1                   do i = is, ie
            2448     2                       if (qr (i) > qrmin .and. tz (i) > t_wfr) then
            2449     2                           qpz = qv (i) + ql (i)
            2450     2                           tin = tz (i) - lcp2 (i) * ql (i) ! presence of clouds suppresses the rain evap
            2451     2    i                      qsat = wqs2 (tin, den (i), dqsdt)
            2452     2                           dqh = max (ql (i), hvar (i) * max (qpz, qcmin))
            2453     2                           dqv = qsat - qv (i)
            2454     2                           q_minus = qpz - dqh
            2455     2                           q_plus = qpz + dqh
            2456     2               
            2457     2                           ! -----------------------------------------------------------------------
            2458     2                           ! qsat must be > q_minus to activate evaporation
            2459     2                           ! qsat must be < q_plus to activate accretion
            2460     2                           ! -----------------------------------------------------------------------
            2461     2               
            2462     2                           ! -----------------------------------------------------------------------
            2463     2                           ! rain evaporation
            2464     2                           ! -----------------------------------------------------------------------
            2465     2               
            2466     3                           if (dqv > qvmin .and. qsat > q_minus) then
            2467     4                               if (qsat > q_plus) then
            2468     4                                   dq = qsat - qpz
            2469     4                               else
            2470     4                                   ! q_minus < qsat < q_plus
            2471     4                                   ! dq == dqh if qsat == q_minus
            2472     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            2473     4                               endif
            2474     3                               qden = qr (i) * den (i)
            2475     3                               t2 = tin * tin
            2476     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * exp (0.725 * log (qden))) &
            2477     3                                    / (crevp (4) * t2 + crevp (5) * qsat * den (i))
            2478     3                               evap = min (qr (i), dt * evap, dqv / (1. + lcp2 (i) * dqsdt))
            2479     3                               qr (i) = qr (i) - evap
            2480     3                               qv (i) = qv (i) + evap
            2481     3                               q_liq (i) = q_liq (i) - evap
            2482     3                               cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2483     3                               tz (i) = tz (i) - evap * lhl (i) / cvm (i)
            2484     3                           endif
            2485     2               
            2486     2                           ! -----------------------------------------------------------------------
            2487     2                           ! accretion: pracc
            2488     2                           ! -----------------------------------------------------------------------
            2489     2               
            2490     3                           if (qr (i) > qrmin .and. ql (i) > 1.e-8 .and. qsat < q_plus) then
            2491     3                               denfac (i) = sqrt (sfcrho / den (i))
            2492     3                               sink = dt * denfac (i) * cracw * exp (0.95 * log (qr (i) * den (i)))
            2493     3                               sink = sink / (1. + sink) * ql (i)
            2494     3                               ql (i) = ql (i) - sink
            2495     3                               qr (i) = qr (i) + sink
            2496     3                           endif
            2497     2                       endif
            2498     1                   enddo
            2499                     
            2500                     end subroutine revap_rac1
            2501                     
            2502                     ! =======================================================================
            2503                     !>@brief The subroutine 'terminal_fall' computes terminal fall speed.
            2504                     !>@details It considers cloud ice, snow, and graupel's melting during fall.
            2505                     ! =======================================================================
            2506                     
            2507                     subroutine terminal_fall (dtm, ktop, kbot, tz, qv, ql, qr, qg, qs, qi, dz, dp, &
            2508                             den, vtg, vts, vti, r1, g1, s1, i1, m1_sol, w1)
            2509                     
            2510                         implicit none
            2511                     
            2512                         integer, intent (in) :: ktop, kbot
            2513                     
            2514                         real, intent (in) :: dtm ! time step (s)
            2515                     
            2516                         real, intent (in), dimension (ktop:kbot) :: vtg, vts, vti, den, dp, dz
            2517                     
            2518                         real, intent (inout), dimension (ktop:kbot) :: qv, ql, qr, qg, qs, qi, tz, m1_sol, w1
            2519                     
            2520                         real, intent (out) :: r1, g1, s1, i1
            2521                     
            2522                         real, dimension (ktop:kbot + 1) :: ze, zt
            2523                     
            2524                         real :: qsat, dqsdt, dt5, evap, dtime
            2525                         real :: factor, frac
            2526                         real :: tmp, precip, tc, sink
            2527                     
            2528                         real, dimension (ktop:kbot) :: lcpk, icpk, cvm, q_liq, q_sol, lhl, lhi
            2529                         real, dimension (ktop:kbot) :: m1, dm
            2530                     
            2531                         real :: zs = 0.
            2532                         real :: fac_imlt
            2533                     
            2534                         integer :: k, k0, m
            2535                     
            2536                         logical :: no_fall
            2537                     
            2538                         dt5 = 0.5 * dtm
            2539                         fac_imlt = 1. - exp (- dt5 / tau_imlt)
            2540                     

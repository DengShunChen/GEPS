            4645                     ! ==========================================================================
            4646                     !>@brief The subroutine 'interpolate_z' interpolates to a prescribed height.
            4647                     ! ==========================================================================
            4648                     
            4649                     subroutine interpolate_z (is, ie, js, je, km, zl, hgt, a3, a2)
            4650                     
            4651                         implicit none
            4652                     
            4653                         integer, intent (in) :: is, ie, js, je, km
            4654                     
            4655                         real, intent (in), dimension (is:ie, js:je, km) :: a3
            4656                     
            4657                         real, intent (in), dimension (is:ie, js:je, km + 1) :: hgt !< hgt (k) > hgt (k + 1)
            4658                     
            4659                         real, intent (in) :: zl
            4660                     
            4661                         real, intent (out), dimension (is:ie, js:je) :: a2
            4662                     
            4663                         real, dimension (km) :: zm !< middle layer height
            4664                     
            4665                         integer :: i, j, k
            4666                     
            4667                         !$omp parallel do default (none) shared (is, ie, js, je, km, hgt, zl, a2, a3) private (zm)
            4668                     
            4669     1   p               do j = js, je
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4670     2   p                   do i = is, ie
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4671     3   p   2v                  do k = 1, km
            4672     3   p   2v                      zm (k) = 0.5 * (hgt (i, j, k) + hgt (i, j, k + 1))
            4673     3   p   2v                  enddo
            4674     3   p                       if (zl >= zm (1)) then
            4675     3   p                           a2 (i, j) = a3 (i, j, 1)
            4676     3   p                       elseif (zl <= zm (km)) then
            4677     3   p                           a2 (i, j) = a3 (i, j, km)
            4678     3   p                       else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4679     4   p                           do k = 1, km - 1
            4680     5   p                               if (zl <= zm (k) .and. zl >= zm (k + 1)) then
            4681     5   p                                   a2 (i, j) = a3 (i, j, k) + (a3 (i, j, k + 1) - a3 (i, j, k)) * (zm (k) - zl) / (zm (k) - zm (k + 1))
            4682     5   p                                   exit
            4683     5   p                               endif
            4684     4   p                           enddo
            4685     3   p                       endif
            4686     2   p                   enddo
            4687     1   p               enddo
            4688                     
            4689                     end subroutine interpolate_z
            4690                     
            4691                     ! =======================================================================
            4692                     !>@brief The subroutine 'cloud_diagnosis' diagnoses the radius of cloud
            4693                     !! species.
            4694                     !>author Linjiong Zhoum, Shian-Jiann Lin
            4695                     ! =======================================================================
            4696                     
            4697                     subroutine cloud_diagnosis                                              &
            4698                     !   --- input  :
            4699                             ( is, ie, ks, ke, den, delp, lsm,                               &
            4700                               qmw, qmi, qmr, qms, qmg, t,                                   &
            4701                     !   --- output :
            4702                               rew, rei, rer, res, reg)
            4703                     !
            4704                         implicit none
            4705                     
            4706                         integer, intent (in) :: is, ie, ks, ke
            4707                         integer, intent (in), dimension (is:ie) :: lsm ! land sea mask, 0: ocean, 1: land, 2: sea ice
            4708                     
            4709                         real, intent (in), dimension (is:ie, ks:ke) :: t
            4710                         real, intent (in), dimension (is:ie, ks:ke) :: den, delp
            4711                         real, intent (in), dimension (is:ie, ks:ke) :: qmw, qmi, qmr, qms, qmg !< units: kg / kg
            4712                     
            4713                         real, intent (out), dimension (is:ie, ks:ke) :: rew, rei, rer, res, reg !< units: micron
            4714                     
            4715                         real, dimension (is:ie, ks:ke) :: qcw, qci, qcr, qcs, qcg !< units: g / m^2
            4716                     
            4717                         integer :: i, k
            4718                     
            4719                         real :: lambdar, lambdas, lambdag
            4720                         real :: dpg, rei_fac, mask, ccn, bw
            4721                         real, parameter :: rho_0 = 50.e-3
            4722                     
            4723                         real :: rhow = 1.0e3, rhor = 1.0e3, rhos = 1.0e2, rhog = 4.0e2
            4724                         real :: n0r = 8.0e6, n0s = 3.0e6, n0g = 4.0e6
            4725                         real :: alphar = 0.8, alphas = 0.25, alphag = 0.5
            4726                         real :: gammar = 17.837789, gammas = 8.2850630, gammag = 11.631769
            4727                         real :: qmin = 1.0e-12, beta = 1.22, qmin1 = 9.e-6
            4728                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            4729     1  pp               do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmg, den, qms, reg, res, qmr, rer, qmi
                                   <<<      t, rei, qmw, lsm, rew, delp, qcw, qci
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      qcr: 2, qcs: 2, qcg: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 18  FILL 43
                                   <<<      PREDICATE : SPILL 5  FILL 13
                                   <<< Loop-information  End >>>
            4730     2   p    v              do i = is, ie
            4731     2               
            4732     2   p    v                  dpg = abs (delp (i, k)) / grav
            4733     2   p    v                  mask = min (max (real(lsm (i)), 0.0), 2.0)
            4734     2               
            4735     2                           ! -----------------------------------------------------------------------
            4736     2                           ! cloud water (Martin et al., 1994)
            4737     2                           ! -----------------------------------------------------------------------
            4738     2               
            4739     2   p    v                  ccn = 0.80 * (- 1.15e-3 * (ccn_o ** 2) + 0.963 * ccn_o + 5.30) * abs (mask - 1.0) + &
            4740     2                               0.67 * (- 2.10e-4 * (ccn_l ** 2) + 0.568 * ccn_l - 27.9) * (1.0 - abs (mask - 1.0))
            4741     2               
            4742     3   p    v                  if (qmw (i, k) .gt. qmin) then
            4743     3   p    v                      qcw (i, k) = dpg * qmw (i, k) * 1.0e3
            4744     3   p    v                      rew (i, k) = exp (1.0 / 3.0 * log ((3.0 * den (i, k) * qmw (i, k)) / (4.0 * pi * rhow * ccn))) * 1.0e4
            4745     3   p    v                      rew (i, k) = max (rewmin, min (rewmax, rew (i, k)))
            4746     3   p    v                  else
            4747     3   p    v                      qcw (i, k) = 0.0
            4748     3   p    v                      rew (i, k) = rewmin
            4749     3   p    v                  endif
            4750     2               
            4751     3   p    v                  if (reiflag .eq. 1) then
            4752     3               
            4753     3                               ! -----------------------------------------------------------------------
            4754     3                               ! cloud ice (Heymsfield and Mcfarquhar, 1996)
            4755     3                               ! -----------------------------------------------------------------------
            4756     3               
            4757     4   p    v                      if (qmi (i, k) .gt. qmin1) then
            4758     4   p    v                          qci (i, k) = dpg * qmi (i, k) * 1.0e3
            4759     4   p    v                          rei_fac = log (1.0e3 * qmi (i, k) * den (i, k))
            4760     5   p    v                          if (t (i, k) - tice .lt. - 50) then
            4761     5   p    v                              rei (i, k) = beta / 9.917 * exp (0.109 * rei_fac) * 1.0e3
            4762     5   p    v                          elseif (t (i, k) - tice .lt. - 40) then
            4763     5   p    v                              rei (i, k) = beta / 9.337 * exp (0.080 * rei_fac) * 1.0e3
            4764     5   p    v                          elseif (t (i, k) - tice .lt. - 30) then
            4765     5   p    v                              rei (i, k) = beta / 9.208 * exp (0.055 * rei_fac) * 1.0e3
            4766     5   p    v                          else
            4767     5   p    v                              rei (i, k) = beta / 9.387 * exp (0.031 * rei_fac) * 1.0e3
            4768     5   p    v                          endif
            4769     4   p    v                          rei (i, k) = max (reimin, min (reimax, rei (i, k)))
            4770     4   p    v                      else
            4771     4   p    v                          qci (i, k) = 0.0
            4772     4   p    v                          rei (i, k) = reimin
            4773     4   p    v                      endif
            4774     3               
            4775     3   p    v                  endif
            4776     2               
            4777     3   p    v                  if (reiflag .eq. 2) then
            4778     3               
            4779     3                               ! -----------------------------------------------------------------------
            4780     3                               ! cloud ice (Wyser, 1998)
            4781     3                               ! -----------------------------------------------------------------------
            4782     3               
            4783     4   p    v                      if (qmi (i, k) .gt. qmin1) then
            4784     4   p    v                          qci (i, k) = dpg * qmi (i, k) * 1.0e3
            4785     4   p    v                          bw = - 2. + 1.e-3 * log10 (den (i, k) * qmi (i, k) / rho_0) * max (0.0, tice - t (i, k)) ** 1.5
            4786     4   p    v                          rei (i, k) = 377.4 + bw * (203.3 + bw * (37.91 + 2.3696 * bw))
            4787     4   p    v                          rei (i, k) = max (reimin, min (reimax, rei (i, k)))
            4788     4   p    v                      else
            4789     4   p    v                          qci (i, k) = 0.0
            4790     4   p    v                          rei (i, k) = reimin
            4791     4   p    v                      endif
            4792     3               
            4793     3   p    v                  endif
            4794     2               
            4795     2                           ! -----------------------------------------------------------------------
            4796     2                           ! rain (Lin et al., 1983)
            4797     2                           ! -----------------------------------------------------------------------
            4798     2               
            4799     3   p    v                  if (qmr (i, k) .gt. qmin) then
            4800     3   p    v                      qcr (i, k) = dpg * qmr (i, k) * 1.0e3
            4801     3   p    v                      lambdar = exp (0.25 * log (pi * rhor * n0r / qmr (i, k) / den (i, k)))
            4802     3   p    v                      rer (i, k) = 0.5 * exp (log (gammar / 6) / alphar) / lambdar * 1.0e6
            4803     3   p    v                      rer (i, k) = max (rermin, min (rermax, rer (i, k)))
            4804     3   p    v                  else
            4805     3   p    v                      qcr (i, k) = 0.0
            4806     3   p    v                      rer (i, k) = rermin
            4807     3   p    v                  endif
            4808     2               
            4809     2                           ! -----------------------------------------------------------------------
            4810     2                           ! snow (Lin et al., 1983)
            4811     2                           ! -----------------------------------------------------------------------
            4812     2               
            4813     3   p    v                  if (qms (i, k) .gt. qmin1) then
            4814     3   p    v                      qcs (i, k) = dpg * qms (i, k) * 1.0e3
            4815     3   p    v                      lambdas = exp (0.25 * log (pi * rhos * n0s / qms (i, k) / den (i, k)))
            4816     3   p    v                      res (i, k) = 0.5 * exp (log (gammas / 6) / alphas) / lambdas * 1.0e6
            4817     3   p    v                      res (i, k) = max (resmin, min (resmax, res (i, k)))
            4818     3   p    v                  else
            4819     3   p    v                      qcs (i, k) = 0.0
            4820     3   p    v                      res (i, k) = resmin
            4821     3   p    v                  endif
            4822     2               
            4823     2                           ! -----------------------------------------------------------------------
            4824     2                           ! graupel (Lin et al., 1983)
            4825     2                           ! -----------------------------------------------------------------------
            4826     2               
            4827     3   p    v                  if (qmg (i, k) .gt. qmin) then
            4828     3   p    v                      qcg (i, k) = dpg * qmg (i, k) * 1.0e3
            4829     3   p    v                      lambdag = exp (0.25 * log (pi * rhog * n0g / qmg (i, k) / den (i, k)))
            4830     3   p    v                      reg (i, k) = 0.5 * exp (log (gammag / 6) / alphag) / lambdag * 1.0e6
            4831     3   p    v                      reg (i, k) = max (regmin, min (regmax, reg (i, k)))
            4832     3   p    v                  else
            4833     3   p    v                      qcg (i, k) = 0.0
            4834     3   p    v                      reg (i, k) = regmin
            4835     3   p    v                  endif
            4836     2               
            4837     2   p    v              enddo
            4838     1   p               enddo
            4839                     
            4840                     end subroutine cloud_diagnosis
            4841                     
            4842                     !+---+-----------------------------------------------------------------+
            4843                     
            4844                           subroutine refl10cm_gfdl (qv1d, qr1d, qs1d, qg1d,                 &
            4845                                            t1d, p1d, dBZ, kts, kte, ii,jj, melti)
            4846                     
            4847                           IMPLICIT NONE
            4848                     
            4849                     !..Sub arguments
            4850                           INTEGER, INTENT(IN):: kts, kte, ii,jj
            4851                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            4852                                           qv1d, qr1d, qs1d, qg1d, t1d, p1d
            4853                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: dBZ
            4854                     
            4855                     !..Local variables
            4856                           REAL, DIMENSION(kts:kte):: temp, pres, qv, rho
            4857                           REAL, DIMENSION(kts:kte):: rr, rs, rg
            4858                     !      REAL:: temp_C
            4859                     
            4860                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilams, ilamg
            4861                           DOUBLE PRECISION, DIMENSION(kts:kte):: N0_r, N0_s, N0_g
            4862                           DOUBLE PRECISION:: lamr, lams, lamg
            4863                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            4864                     
            4865                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            4866                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            4867                     
            4868                           INTEGER:: i, k, k_0, kbot, n
            4869                           LOGICAL, INTENT(IN):: melti
            4870                           DOUBLE PRECISION:: cback, x, eta, f_d
            4871                     !+---+
            4872                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            4873     1  pp   4v            do k = kts, kte
            4874     1   p   4v               dBZ(k) = -35.0
            4875     1   p   4v            enddo
            4876                     
            4877                     !+---+-----------------------------------------------------------------+
            4878                     !..Put column of data into local arrays.
            4879                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 14
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, p1d, t1d, pres, N0_g
                                   <<<      L_qg, N0_s, L_qs, N0_r, L_qr, qv1d, qv
                                   <<<      rho, ilamr
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      rr: 2, ilams: 2, rs: 2, ilamg: 2, rg: 2
                                   <<<      temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 1  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4880     1  pp    v            do k = kts, kte
            4881     1   p    v               temp(k) = t1d(k)
            4882     1               !         temp_C = min(-0.001, temp(K)-273.15)
            4883     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            4884     1   p    v               pres(k) = p1d(k)
            4885     1   p    v               rho(k) = 0.622*pres(k)/(rdgas*temp(k)*(qv(k)+0.622))
            4886     1               
            4887     2   p    v               if (qr1d(k) .gt. 1.E-9) then
            4888     2   p    v                  rr(k) = qr1d(k)*rho(k)
            4889     2   p    v                  N0_r(k) = n0r
            4890     2   p    v                  lamr = (xam_r*xcrg(3)*N0_r(k)/rr(k))**(1./xcre(1))
            4891     2   p    v                  ilamr(k) = 1./lamr
            4892     2   p    v                  L_qr(k) = .true.
            4893     2   p    v               else
            4894     2   p    v                  rr(k) = 1.E-12
            4895     2   p    v                  L_qr(k) = .false.
            4896     2   p    v               endif
            4897     1               
            4898     2   p    v               if (qs1d(k) .gt. 1.E-9) then
            4899     2   p    v                  rs(k) = qs1d(k)*rho(k)
            4900     2   p    v                  N0_s(k) = n0s
            4901     2   p    v                  lams = (xam_s*xcsg(3)*N0_s(k)/rs(k))**(1./xcse(1))
            4902     2   p    v                  ilams(k) = 1./lams
            4903     2   p    v                  L_qs(k) = .true.
            4904     2   p    v               else
            4905     2   p    v                  rs(k) = 1.E-12
            4906     2   p    v                  L_qs(k) = .false.
            4907     2   p    v               endif
            4908     1               
            4909     2   p    v               if (qg1d(k) .gt. 1.E-9) then
            4910     2   p    v                  rg(k) = qg1d(k)*rho(k)
            4911     2   p    v                  N0_g(k) = n0g
            4912     2   p    v                  lamg = (xam_g*xcgg(3)*N0_g(k)/rg(k))**(1./xcge(1))
            4913     2   p    v                  ilamg(k) = 1./lamg
            4914     2   p    v                  L_qg(k) = .true.
            4915     2   p    v               else
            4916     2   p    v                  rg(k) = 1.E-12
            4917     2   p    v                  L_qg(k) = .false.
            4918     2   p    v               endif
            4919     1   p    v            enddo
            4920                     
            4921                     !+---+-----------------------------------------------------------------+
            4922                     !..Locate K-level of start of melting (k_0 is level above).
            4923                     !+---+-----------------------------------------------------------------+
            4924                           k_0 = kts
            4925     1                    K_LOOP:do k = kte-1, kts, -1
            4926     2                        if ( melti .and. (temp(k).gt.273.15) .and. L_qr(k)          &
            4927     2                             .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            4928     2                           k_0 = MAX(k+1, k_0)
            4929     2                           EXIT K_LOOP
            4930     2                        endif
            4931     1                     enddo K_LOOP
            4932                     !+---+-----------------------------------------------------------------+
            4933                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            4934                     !.. and non-water-coated snow and graupel when below freezing are
            4935                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            4936                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, ilams, L_qr, N0_s
                                   <<<      ilamr, N0_r
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 4
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4937     1  pp    v            do k = kts, kte
            4938     1   p    v               ze_rain(k) = 1.e-22
            4939     1   p    v               ze_snow(k) = 1.e-22
            4940     1   p    v               ze_graupel(k) = 1.e-22
            4941     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*xcrg(4)*ilamr(k)**xcre(4)
            4942     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)     &
            4943     1                                                * (xam_s/900.0)*(xam_s/900.0)          &
            4944     1                                                * N0_s(k)*xcsg(4)*ilams(k)**xcse(4)
            4945     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)  &
            4946     1                                                   * (xam_g/900.0)*(xam_g/900.0)       &
            4947     1                                                   * N0_g(k)*xcgg(4)*ilamg(k)**xcge(4)
            4948     1   p    v            enddo
            4949                     
            4950                     
            4951                     !+---+-----------------------------------------------------------------+
            4952                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            4953                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            4954                     !.. extremely simple based on amount found above the melting level.
            4955                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            4956                     !.. routines).
            4957                     !+---+-----------------------------------------------------------------+
            4958                     
            4959     1                     if (melti .and. k_0.ge.kts+1) then
            4960     2                      do k = k_0-1, kts, -1
            4961     2               
            4962     2               !..Reflectivity contributed by melting snow
            4963     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            4964     3                          fmelt_s = MAX(0.005d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            4965     3                          eta = 0.d0
            4966     3                          lams = 1./ilams(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<< Loop-information  End >>>
            4967     4                          do n = 1, nrbins
            4968     4                             x = xam_s * xxDs(n)**xbm_s
            4969     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocms),DBLE(xobms), &
            4970     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            4971     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            4972     4                                   inclusionstring_s, hoststring_s,                    &
            4973     4                                   hostmatrixstring_s, hostinclusionstring_s)
            4974     4                             f_d = N0_s(k)*xxDs(n)**xmu_s * DEXP(-lams*xxDs(n))
            4975     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            4976     4                          enddo
            4977     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4978     3                         endif
            4979     2               
            4980     2               
            4981     2               !..Reflectivity contributed by melting graupel
            4982     2               
            4983     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            4984     3                          fmelt_g = MAX(0.005d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            4985     3                          eta = 0.d0
            4986     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, simpson, xdtg
                                   <<< Loop-information  End >>>
            4987     4                          do n = 1, nrbins
            4988     4                             x = xam_g * xxDg(n)**xbm_g
            4989     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocmg),DBLE(xobmg), &
            4990     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            4991     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            4992     4                                   inclusionstring_g, hoststring_g,                    &
            4993     4                                   hostmatrixstring_g, hostinclusionstring_g)
            4994     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            4995     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            4996     4                          enddo
            4997     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4998     3                         endif
            4999     2               
            5000     2                      enddo
            5001     1                     endif
            5002                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            5003     1  pp    v            do k = kte, kts, -1
            5004     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            5005     1   p    v            enddo
            5006                     
            5007                     
            5008                           end subroutine refl10cm_gfdl

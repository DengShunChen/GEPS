            1629     1               
            1630     1   p    v              if (p1 (k) < p_min) cycle
            1631     1               
            1632     1   p    v              tz = tzk (k)
            1633     1   p    v              qv = qvk (k)
            1634     1   p    v              ql = qlk (k)
            1635     1   p    v              qi = qik (k)
            1636     1   p    v              qr = qrk (k)
            1637     1   p    v              qs = qsk (k)

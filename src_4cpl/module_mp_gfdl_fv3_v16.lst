            3649                     
            3650                     ! =======================================================================
            3651                     ! qsmith table initialization
            3652                     !>@brief The subroutine 'setup_con' sets up constants and calls 'qsmith_init'.
            3653                     ! =======================================================================
            3654                     
            3655                     subroutine setup_con
            3656                     
            3657                         implicit none
            3658                     
            3659                         ! master = (mpp_pe () .eq.mpp_root_pe ())
            3660                     
            3661                         rgrav = 1. / grav
            3662                     
            3663                         if (.not. qsmith_tables_initialized) call qsmith_init
            3664                     
            3665                         qsmith_tables_initialized = .true.
            3666                     
            3667                     end subroutine setup_con
            3668                     
            3669                     ! =======================================================================
            3670                     !>@brief The function 'acr3d' is an accretion function (lin et al. 1983)
            3671                     ! =======================================================================
            3672                     
            3673                     real function acr3d (v1, v2, q1, q2, c, cac, rho)
            3674                     
            3675                         implicit none
            3676                     
            3677                         real, intent (in) :: v1, v2, c, rho
            3678                         real, intent (in) :: q1, q2 ! mixing ratio!!!
            3679                         real, intent (in) :: cac (3)
            3680                     
            3681                         real :: t1, s1, s2
            3682                     
            3683                         ! integer :: k
            3684                         !
            3685                         ! real :: a
            3686                         !
            3687                         ! a = 0.0
            3688                         ! do k = 1, 3
            3689                         ! a = a + cac (k) * ((q1 * rho) ** ((7 - k) * 0.25) * (q2 * rho) ** (k * 0.25))
            3690                         ! enddo
            3691                         ! acr3d = c * abs (v1 - v2) * a / rho
            3692                     
            3693                         ! optimized
            3694                     
            3695                         t1 = sqrt (q1 * rho)
            3696                         s1 = sqrt (q2 * rho)
            3697                         s2 = sqrt (s1) ! s1 = s2 ** 2
            3698                         acr3d = c * abs (v1 - v2) * q1 * s2 * (cac (1) * t1 + cac (2) * sqrt (t1) * s2 + cac (3) * s1)
            3699                     
            3700                     end function acr3d
            3701                     
            3702                     ! =======================================================================
            3703                     !> melting of snow function (lin et al. 1983)
            3704                     !  note: psacw and psacr must be calc before smlt is called
            3705                     ! =======================================================================
            3706                     
            3707                     real function smlt (tc, dqs, qsrho, psacw, psacr, c, rho, rhofac)
            3708                     
            3709                         implicit none
            3710                     
            3711                         real, intent (in) :: tc, dqs, qsrho, psacw, psacr, c (5), rho, rhofac
            3712                     
            3713                         smlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qsrho) + &
            3714                             c (4) * qsrho ** 0.65625 * sqrt (rhofac)) + c (5) * tc * (psacw + psacr)
            3715                     
            3716                     end function smlt
            3717                     
            3718                     ! =======================================================================
            3719                     !> melting of graupel function (lin et al. 1983)
            3720                     !  note: pgacw and pgacr must be calc before gmlt is called
            3721                     ! =======================================================================
            3722                     
            3723                     real function gmlt (tc, dqs, qgrho, pgacw, pgacr, c, rho)
            3724                     
            3725                         implicit none
            3726                     
            3727                         real, intent (in) :: tc, dqs, qgrho, pgacw, pgacr, c (5), rho
            3728                     
            3729                         gmlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qgrho) + &
            3730                             c (4) * qgrho ** 0.6875 / rho ** 0.25) + c (5) * tc * (pgacw + pgacr)
            3731                     
            3732                     end function gmlt
            3733                     
            3734                     ! =======================================================================
            3735                     ! initialization
            3736                     ! prepare saturation water vapor pressure tables
            3737                     ! =======================================================================
            3738                     !>@brief The subroutine 'qsmith_init' initializes lookup tables for saturation
            3739                     !! water vapor pressure for the following utility routines that are designed
            3740                     !! to return qs consistent with the assumptions in FV3.
            3741                     !>@details The calculations are highly accurate values based on the Clausius-Clapeyron
            3742                     !! equation.
            3743                     ! =======================================================================
            3744                     subroutine qsmith_init
            3745                     
            3746                         implicit none
            3747                     
            3748                         integer, parameter :: length = 2621
            3749                     
            3750                         integer :: i
            3751                     
            3752     1                   if (.not. tables_are_initialized) then
            3753     1               
            3754     1                       ! master = (mpp_pe () .eq. mpp_root_pe ())
            3755     1                       ! if (master) print *, ' gfdl mp: initializing qs tables'
            3756     1               
            3757     1                       ! debug code
            3758     1                       ! print *, mpp_pe (), allocated (table), allocated (table2), &
            3759     1                       ! allocated (table3), allocated (tablew), allocated (des), &
            3760     1                       ! allocated (des2), allocated (des3), allocated (desw)
            3761     1                       ! end debug code
            3762     1               
            3763     1                       ! generate es table (dt = 0.1 deg. c)
            3764     1               
            3765     1                       allocate (table (length))
            3766     1                       allocate (table2 (length))
            3767     1                       allocate (table3 (length))
            3768     1                       allocate (tablew (length))
            3769     1                       allocate (des (length))
            3770     1                       allocate (des2 (length))
            3771     1                       allocate (des3 (length))
            3772     1                       allocate (desw (length))
            3773     1               
            3774     1                       call qs_table (length)
            3775     1                       call qs_table2 (length)
            3776     1                       call qs_table3 (length)
            3777     1    i                  call qs_tablew (length)
            3778     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.62, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3, table2, table, tablew, des, des3
                                   <<<      desw, des2
                                   <<< Loop-information  End >>>
            3779     2  pp    v              do i = 1, length - 1
            3780     2   p    v                  des (i) = max (0., table (i + 1) - table (i))
            3781     2   p    v                  des2 (i) = max (0., table2 (i + 1) - table2 (i))
            3782     2   p    v                  des3 (i) = max (0., table3 (i + 1) - table3 (i))
            3783     2   p    v                  desw (i) = max (0., tablew (i + 1) - tablew (i))
            3784     2   p    v              enddo
            3785     1                       des (length) = des (length - 1)
            3786     1                       des2 (length) = des2 (length - 1)
            3787     1                       des3 (length) = des3 (length - 1)
            3788     1                       desw (length) = desw (length - 1)
            3789     1               
            3790     1                       tables_are_initialized = .true.
            3791     1               
            3792     1                   endif
            3793                     
            3794                     end subroutine qsmith_init
            3795                     
            3796                     ! =======================================================================
            3797                     ! compute the saturated specific humidity for table ii
            3798                     !>@brief The function 'wqs1' returns the saturation vapor pressure over pure
            3799                     !! liquid water for a given temperature and air density.
            3800                     ! =======================================================================
            3801                     
            3802                     real function wqs1 (ta, den)
            3803                     
            3804                         implicit none
            3805                     
            3806                         !> pure water phase; universal dry / moist formular using air density
            3807                         !> input "den" can be either dry or moist air density
            3808                     
            3809                         real, intent (in) :: ta, den
            3810                     
            3811                         real :: es, ap1, tmin
            3812                     
            3813                         integer :: it
            3814                     
            3815                         tmin = table_ice - 160.
            3816                         ap1 = 10. * dim (ta, tmin) + 1.
            3817                         ap1 = min (2621., ap1)
            3818                         it = ap1
            3819                         es = tablew (it) + (ap1 - it) * desw (it)
            3820                         wqs1 = es / (rvgas * ta * den)
            3821                     
            3822                     end function wqs1
            3823                     
            3824                     ! =======================================================================
            3825                     ! compute the gradient of saturated specific humidity for table ii
            3826                     !>@brief The function 'wqs2' returns the saturation vapor pressure over pure
            3827                     !! liquid water for a given temperature and air density, as well as the
            3828                     !! analytic dqs/dT: rate of change of saturation vapor pressure WRT temperature.
            3829                     ! =======================================================================
            3830                     
            3831                     real function wqs2 (ta, den, dqdt)
            3832                     
            3833                         implicit none
            3834                     
            3835                         !> pure water phase; universal dry / moist formular using air density
            3836                         !> input "den" can be either dry or moist air density
            3837                     
            3838                         real, intent (in) :: ta, den
            3839                     
            3840                         real, intent (out) :: dqdt
            3841                     
            3842                         real :: es, ap1, tmin
            3843                     
            3844                         integer :: it
            3845                     
            3846                         tmin = table_ice - 160.
            3847                     
            3848                         if (.not. tables_are_initialized) call qsmith_init
            3849                     
            3850                         ap1 = 10. * dim (ta, tmin) + 1.
            3851                         ap1 = min (2621., ap1)
            3852                         it = ap1
            3853                         es = tablew (it) + (ap1 - it) * desw (it)
            3854                         wqs2 = es / (rvgas * ta * den)
            3855                         it = ap1 - 0.5
            3856                         ! finite diff, del_t = 0.1:
            3857                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            3858                     
            3859                     end function wqs2
            3860                     
            3861                     ! =======================================================================
            3862                     ! compute wet buld temperature
            3863                     !>@brief The function 'wet_bulb' uses 'wqs2' to compute the wet-bulb temperature
            3864                     !! from the mixing ratio and the temperature.
            3865                     ! =======================================================================
            3866                     
            3867                     real function wet_bulb (q, t, den)
            3868                     
            3869                         implicit none
            3870                     
            3871                         real, intent (in) :: t, q, den
            3872                     
            3873                         real :: qs, tp, dqdt
            3874                     
            3875                         wet_bulb = t
            3876          i              qs = wqs2 (wet_bulb, den, dqdt)
            3877                         tp = 0.5 * (qs - q) / (1. + lcp * dqdt) * lcp
            3878                         wet_bulb = wet_bulb - tp
            3879                     
            3880                         ! tp is negative if super - saturated
            3881     1                   if (tp > 0.01) then
            3882     1    i                  qs = wqs2 (wet_bulb, den, dqdt)
            3883     1                       tp = (qs - q) / (1. + lcp * dqdt) * lcp
            3884     1                       wet_bulb = wet_bulb - tp
            3885     1                   endif
            3886                     
            3887                     end function wet_bulb
            3888                     
            3889                     ! =======================================================================
            3890                     !>@brief The function 'iqs1' computes the saturated specific humidity
            3891                     !! for table iii
            3892                     ! =======================================================================
            3893                     
            3894                     real function iqs1 (ta, den)
            3895                     
            3896                         implicit none
            3897                     
            3898                         !> water - ice phase; universal dry / moist formular using air density
            3899                         !> input "den" can be either dry or moist air density
            3900                     
            3901                         real, intent (in) :: ta, den
            3902                     
            3903                         real :: es, ap1, tmin
            3904                     
            3905                         integer :: it
            3906                     
            3907                         tmin = table_ice - 160.
            3908                         ap1 = 10. * dim (ta, tmin) + 1.
            3909                         ap1 = min (2621., ap1)
            3910                         it = ap1
            3911                         es = table2 (it) + (ap1 - it) * des2 (it)
            3912                         iqs1 = es / (rvgas * ta * den)
            3913                     
            3914                     end function iqs1
            3915                     
            3916                     ! =======================================================================
            3917                     !>@brief The function 'iqs2' computes the gradient of saturated specific
            3918                     !! humidity for table iii
            3919                     ! =======================================================================
            3920                     
            3921                     real function iqs2 (ta, den, dqdt)
            3922                     
            3923                         implicit none
            3924                     
            3925                         !> water - ice phase; universal dry / moist formular using air density
            3926                         !> input "den" can be either dry or moist air density
            3927                     
            3928                         real, intent (in) :: ta, den
            3929                     
            3930                         real, intent (out) :: dqdt
            3931                     
            3932                         real :: es, ap1, tmin
            3933                     
            3934                         integer :: it
            3935                     
            3936                         tmin = table_ice - 160.
            3937                         ap1 = 10. * dim (ta, tmin) + 1.
            3938                         ap1 = min (2621., ap1)
            3939                         it = ap1
            3940                         es = table2 (it) + (ap1 - it) * des2 (it)
            3941                         iqs2 = es / (rvgas * ta * den)
            3942                         it = ap1 - 0.5
            3943                         dqdt = 10. * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) / (rvgas * ta * den)
            3944                     
            3945                     end function iqs2
            3946                     
            3947                     ! =======================================================================
            3948                     !>@brief The function 'qs1d_moist' computes the gradient of saturated
            3949                     !! specific humidity for table iii.
            3950                     ! =======================================================================
            3951                     
            3952                     real function qs1d_moist (ta, qv, pa, dqdt)
            3953                     
            3954                         implicit none
            3955                     
            3956                         real, intent (in) :: ta, pa, qv
            3957                     
            3958                         real, intent (out) :: dqdt
            3959                     
            3960                         real :: es, ap1, tmin, eps10
            3961                     
            3962                         integer :: it
            3963                     
            3964                         tmin = table_ice - 160.
            3965                         eps10 = 10. * eps
            3966                         ap1 = 10. * dim (ta, tmin) + 1.
            3967                         ap1 = min (2621., ap1)
            3968                         it = ap1
            3969                         es = table2 (it) + (ap1 - it) * des2 (it)
            3970                         qs1d_moist = eps * es * (1. + zvir * qv) / pa
            3971                         it = ap1 - 0.5
            3972                         dqdt = eps10 * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) * (1. + zvir * qv) / pa
            3973                     
            3974                     end function qs1d_moist
            3975                     
            3976                     ! =======================================================================
            3977                     ! compute the gradient of saturated specific humidity for table ii
            3978                     !>@brief The function 'wqsat2_moist' computes the saturated specific humidity
            3979                     !! for pure liquid water , as well as des/dT.
            3980                     ! =======================================================================
            3981                     
            3982                     real function wqsat2_moist (ta, qv, pa, dqdt)
            3983                     
            3984                         implicit none
            3985                     
            3986                         real, intent (in) :: ta, pa, qv
            3987                     
            3988                         real, intent (out) :: dqdt
            3989                     
            3990                         real :: es, ap1, tmin, eps10
            3991                     
            3992                         integer :: it
            3993                     
            3994                         tmin = table_ice - 160.
            3995                         eps10 = 10. * eps
            3996                         ap1 = 10. * dim (ta, tmin) + 1.
            3997                         ap1 = min (2621., ap1)
            3998                         it = ap1
            3999                         es = tablew (it) + (ap1 - it) * desw (it)
            4000                         wqsat2_moist = eps * es * (1. + zvir * qv) / pa
            4001                         it = ap1 - 0.5
            4002                         dqdt = eps10 * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) * (1. + zvir * qv) / pa
            4003                     
            4004                     end function wqsat2_moist
            4005                     
            4006                     ! =======================================================================
            4007                     ! compute the saturated specific humidity for table ii
            4008                     !>@brief The function 'wqsat_moist' computes the saturated specific humidity
            4009                     !! for pure liquid water.
            4010                     ! =======================================================================
            4011                     
            4012                     real function wqsat_moist (ta, qv, pa)
            4013                     
            4014                         implicit none
            4015                     
            4016                         real, intent (in) :: ta, pa, qv
            4017                     
            4018                         real :: es, ap1, tmin
            4019                     
            4020                         integer :: it
            4021                     
            4022                         tmin = table_ice - 160.
            4023                         ap1 = 10. * dim (ta, tmin) + 1.
            4024                         ap1 = min (2621., ap1)
            4025                         it = ap1
            4026                         es = tablew (it) + (ap1 - it) * desw (it)
            4027                         wqsat_moist = eps * es * (1. + zvir * qv) / pa
            4028                     
            4029                     end function wqsat_moist
            4030                     
            4031                     ! =======================================================================
            4032                     !>@brief The function 'qs1d_m' computes the saturated specific humidity
            4033                     !! for table iii
            4034                     ! =======================================================================
            4035                     
            4036                     real function qs1d_m (ta, qv, pa)
            4037                     
            4038                         implicit none
            4039                     
            4040                         real, intent (in) :: ta, pa, qv
            4041                     
            4042                         real :: es, ap1, tmin
            4043                     
            4044                         integer :: it
            4045                     
            4046                         tmin = table_ice - 160.
            4047                         ap1 = 10. * dim (ta, tmin) + 1.
            4048                         ap1 = min (2621., ap1)
            4049                         it = ap1
            4050                         es = table2 (it) + (ap1 - it) * des2 (it)
            4051                         qs1d_m = eps * es * (1. + zvir * qv) / pa
            4052                     
            4053                     end function qs1d_m
            4054                     
            4055                     ! =======================================================================
            4056                     !>@brief The function 'd_sat' computes the difference in saturation
            4057                     !! vapor * density * between water and ice
            4058                     ! =======================================================================
            4059                     
            4060                     real function d_sat (ta, den)
            4061                     
            4062                         implicit none
            4063                     
            4064                         real, intent (in) :: ta, den
            4065                     
            4066                         real :: es_w, es_i, ap1, tmin
            4067                     
            4068                         integer :: it
            4069                     
            4070                         tmin = table_ice - 160.
            4071                         ap1 = 10. * dim (ta, tmin) + 1.
            4072                         ap1 = min (2621., ap1)
            4073                         it = ap1
            4074                         es_w = tablew (it) + (ap1 - it) * desw (it)
            4075                         es_i = table2 (it) + (ap1 - it) * des2 (it)
            4076                         d_sat = dim (es_w, es_i) / (rvgas * ta * den) ! take positive difference
            4077                     
            4078                     end function d_sat
            4079                     
            4080                     ! =======================================================================
            4081                     !>@brief The function 'esw_table' computes the saturated water vapor
            4082                     !! pressure for table ii
            4083                     ! =======================================================================
            4084                     
            4085                     real function esw_table (ta)
            4086                     
            4087                         implicit none
            4088                     
            4089                         real, intent (in) :: ta
            4090                     
            4091                         real :: ap1, tmin
            4092                     
            4093                         integer :: it
            4094                     
            4095                         tmin = table_ice - 160.
            4096                         ap1 = 10. * dim (ta, tmin) + 1.
            4097                         ap1 = min (2621., ap1)
            4098                         it = ap1
            4099                         esw_table = tablew (it) + (ap1 - it) * desw (it)
            4100                     
            4101                     end function esw_table
            4102                     
            4103                     ! =======================================================================
            4104                     !>@brief The function 'es2_table' computes the saturated water
            4105                     !! vapor pressure for table iii
            4106                     ! =======================================================================
            4107                     
            4108                     real function es2_table (ta)
            4109                     
            4110                         implicit none
            4111                     
            4112                         real, intent (in) :: ta
            4113                     
            4114                         real :: ap1, tmin
            4115                     
            4116                         integer :: it
            4117                     
            4118                         tmin = table_ice - 160.
            4119                         ap1 = 10. * dim (ta, tmin) + 1.
            4120                         ap1 = min (2621., ap1)
            4121                         it = ap1
            4122                         es2_table = table2 (it) + (ap1 - it) * des2 (it)
            4123                     
            4124                     end function es2_table

            1376     2                           qpz = qv (k) + ql (k)
            1377     2    i                      qsat = wqs2 (tin, den (k), dqsdt)
            1378     2                           dqh = max (ql (k), h_var * max (qpz, qcmin))
            1379     2                           dqh = min (dqh, 0.2 * qpz) ! new limiter
            1380     2                           dqv = qsat - qv (k) ! use this to prevent super - sat the gird box
            1381     2                           q_minus = qpz - dqh
            1382     2                           q_plus = qpz + dqh
            1383     2               
            1384     2                           ! -----------------------------------------------------------------------
            1385     2                           ! qsat must be > q_minus to activate evaporation
            1386     2                           ! qsat must be < q_plus to activate accretion
            1387     2                           ! -----------------------------------------------------------------------
            1388     2               
            1389     2                           ! -----------------------------------------------------------------------
            1390     2                           ! rain evaporation
            1391     2                           ! -----------------------------------------------------------------------
            1392     2               
            1393     3                           if (dqv > qvmin .and. qsat > q_minus) then
            1394     4                               if (qsat > q_plus) then
            1395     4                                   dq = qsat - qpz
            1396     4                               else
            1397     4                                   ! -----------------------------------------------------------------------
            1398     4                                   ! q_minus < qsat < q_plus
            1399     4                                   ! dq == dqh if qsat == q_minus
            1400     4                                   ! -----------------------------------------------------------------------
            1401     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            1402     4                               endif
            1403     3                               qden = qr (k) * den (k)
            1404     3                               t2 = tin * tin
            1405     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * &
            1406     3                                   exp (0.725 * log (qden))) / (crevp (4) * t2 + crevp (5) * qsat * den (k))
            1407     3                               evap = min (qr (k), dt * evap, dqv / (1. + lcpk (k) * dqsdt))
            1408     3                               ! -----------------------------------------------------------------------
            1409     3                               ! alternative minimum evap in dry environmental air
            1410     3                               ! sink = min (qr (k), dim (rh_rain * qsat, qv (k)) / (1. + lcpk (k) * dqsdt))
            1411     3                               ! evap = max (evap, sink)
            1412     3                               ! -----------------------------------------------------------------------
            1413     3                               qr (k) = qr (k) - evap
            1414     3                               qv (k) = qv (k) + evap
            1415     3                               q_liq (k) = q_liq (k) - evap
            1416     3                               cvm (k) = c_air + qv (k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
            1417     3                               tz (k) = tz (k) - evap * lhl (k) / cvm (k)

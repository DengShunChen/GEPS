            2820                     subroutine check_column (ktop, kbot, q, no_fall)
            2821                     
            2822                         implicit none
            2823                     
            2824                         integer, intent (in) :: ktop, kbot
            2825                     
            2826                         real, intent (in) :: q (ktop:kbot)
            2827                     
            2828                         logical, intent (out) :: no_fall
            2829                     
            2830                         integer :: k
            2831                     
            2832                         no_fall = .true.
            2833                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr, qi, qs, qg, q
                                   <<< Loop-information  End >>>
            2834     1                   do k = ktop, kbot
            2835     2                       if (q (k) > qrmin) then
            2836     2                           no_fall = .false.
            2837     2                           exit
            2838     2                       endif
            2839     1                   enddo
            2840                     
            2841                     end subroutine check_column
            2842                     
            2843                     ! =======================================================================
            2844                     !>@brief The subroutine 'implicit_fall' computes the time-implicit monotonic
            2845                     !! scheme.
            2846                     !>@author Shian-Jiann Lin, 2016
            2847                     ! =======================================================================
            2848                     
            2849                     subroutine implicit_fall (dt, ktop, kbot, ze, vt, dp, q, precip, m1)
            2850                     
            2851                         implicit none
            2852                     
            2853                         integer, intent (in) :: ktop, kbot
            2854                     
            2855                         real, intent (in) :: dt
            2856                     
            2857                         real, intent (in), dimension (ktop:kbot + 1) :: ze
            2858                     
            2859                         real, intent (in), dimension (ktop:kbot) :: vt, dp
            2860                     
            2861                         real, intent (inout), dimension (ktop:kbot) :: q
            2862                     
            2863                         real, intent (out), dimension (ktop:kbot) :: m1
            2864                     
            2865                         real, intent (out) :: precip
            2866                     
            2867                         real, dimension (ktop:kbot) :: dz, qm, dd
            2868                     
            2869                         integer :: k
            2870                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dp, vt, ze, dd, dz
                                   <<< Loop-information  End >>>
            2871     1  pp    v          do k = ktop, kbot
            2872     1   p    v              dz (k) = ze (k) - ze (k + 1)
            2873     1   p    v              dd (k) = dt * vt (k)
            2874     1   p    v              q (k) = q (k) * dp (k)
            2875     1   p    v          enddo
            2876                     
            2877                         ! -----------------------------------------------------------------------
            2878                         ! sedimentation: non - vectorizable loop
            2879                         ! -----------------------------------------------------------------------
            2880                     
            2881                         qm (ktop) = q (ktop) / (dz (ktop) + dd (ktop))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.19, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qm, dz, dd, q
                                   <<< Loop-information  End >>>
            2882     1   s   2s          do k = ktop + 1, kbot
            2883     1   m   2m              qm (k) = (q (k) + dd (k - 1) * qm (k - 1)) / (dz (k) + dd (k))
            2884     1   p   2v          enddo
            2885                     
            2886                         ! -----------------------------------------------------------------------
            2887                         ! qm is density at this stage
            2888                         ! -----------------------------------------------------------------------
            2889                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qm
                                   <<< Loop-information  End >>>
            2890     1  pp   2v          do k = ktop, kbot
            2891     1   p   2v              qm (k) = qm (k) * dz (k)
            2892     1   p   2v          enddo
            2893                     
            2894                         ! -----------------------------------------------------------------------
            2895                         ! output mass fluxes: non - vectorizable loop
            2896                         ! -----------------------------------------------------------------------
            2897                     
            2898                         m1 (ktop) = q (ktop) - qm (ktop)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            2899     1   s   2s          do k = ktop + 1, kbot
            2900     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            2901     1   p   2v          enddo
            2902                         precip = m1 (kbot)
            2903                     
            2904                         ! -----------------------------------------------------------------------
            2905                         ! update:
            2906                         ! -----------------------------------------------------------------------
            2907                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            2908     1  pp   2v          do k = ktop, kbot
            2909     1   p   2v              q (k) = qm (k) / dp (k)
            2910     1   p   2v          enddo
            2911                     
            2912                     end subroutine implicit_fall
            2913                     
            2914                     ! =======================================================================
            2915                     !> lagrangian scheme
            2916                     !  developed by sj lin, ????
            2917                     ! =======================================================================
            2918                     
            2919                     subroutine lagrangian_fall_ppm (ktop, kbot, zs, ze, zt, dp, q, precip, m1, mono)
            2920                     
            2921                         implicit none
            2922                     
            2923                         integer, intent (in) :: ktop, kbot
            2924                     
            2925                         real, intent (in) :: zs
            2926                     
            2927                         logical, intent (in) :: mono
            2928                     
            2929                         real, intent (in), dimension (ktop:kbot + 1) :: ze, zt
            2930                     
            2931                         real, intent (in), dimension (ktop:kbot) :: dp
            2932                     
            2933                         ! m1: flux
            2934                         real, intent (inout), dimension (ktop:kbot) :: q, m1
            2935                     
            2936                         real, intent (out) :: precip
            2937                     
            2938                         real, dimension (ktop:kbot) :: qm, dz
            2939                     
            2940                         real :: a4 (4, ktop:kbot)
            2941                     
            2942                         real :: pl, pr, delz, esl
            2943                     
            2944                         integer :: k, k0, n, m
            2945                     
            2946                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            2947                     
            2948                         ! -----------------------------------------------------------------------
            2949                         ! density:
            2950                         ! -----------------------------------------------------------------------
            2951                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            2952     1  pp    v          do k = ktop, kbot
            2953     1   p    v              dz (k) = zt (k) - zt (k + 1) ! note: dz is positive
            2954     1   p    v              q (k) = q (k) * dp (k)
            2955     1   p    v              a4 (1, k) = q (k) / dz (k)
            2956     1   p    v              qm (k) = 0.
            2957     1   p    v          enddo
            2958                     
            2959                         ! -----------------------------------------------------------------------
            2960                         ! construct vertical profile with zt as coordinate
            2961                         ! -----------------------------------------------------------------------
            2962                     
            2963                         call cs_profile (a4 (1, ktop), dz (ktop), kbot - ktop + 1, mono)
            2964                     
            2965                         k0 = ktop
            2966     1                   do k = ktop, kbot
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            2967     2                       do n = k0, kbot
            2968     3                           if (ze (k) <= zt (n) .and. ze (k) >= zt (n + 1)) then
            2969     3                               pl = (zt (n) - ze (k)) / dz (n)
            2970     4                               if (zt (n + 1) <= ze (k + 1)) then
            2971     4                                   ! entire new grid is within the original grid
            2972     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            2973     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            2974     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            2975     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            2976     4                                   k0 = n
            2977     4                                   goto 555
            2978     4                               else
            2979     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            2980     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            2981     5                                   if (n < kbot) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            2982     6                                       do m = n + 1, kbot
            2983     6                                           ! locate the bottom edge: ze (k + 1)
            2984     7                                           if (ze (k + 1) < zt (m + 1)) then
            2985     7                                               qm (k) = qm (k) + q (m)
            2986     7                                           else
            2987     7                                               delz = zt (m) - ze (k + 1)
            2988     7                                               esl = delz / dz (m)
            2989     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            2990     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            2991     7                                               k0 = m
            2992     7                                               goto 555
            2993     7                                           endif
            2994     6                                       enddo
            2995     5                                   endif
            2996     4                                   goto 555
            2997     4                               endif
            2998     3                           endif
            2999     2                       enddo
            3000     1                       555 continue
            3001     1                   enddo
            3002                     
            3003                         m1 (ktop) = q (ktop) - qm (ktop)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3004     1   s   2s          do k = ktop + 1, kbot
            3005     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3006     1   p   2v          enddo
            3007                         precip = m1 (kbot)
            3008                     
            3009                         ! convert back to * dry * mixing ratio:
            3010                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            3011                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3012     1  pp   2v          do k = ktop, kbot
            3013     1   p   2v              q (k) = qm (k) / dp (k)
            3014     1   p   2v          enddo
            3015                     
            3016                     end subroutine lagrangian_fall_ppm
            3017                     
            3018                     subroutine cs_profile (a4, del, km, do_mono)
            3019                     
            3020                         implicit none
            3021                     
            3022                         integer, intent (in) :: km !< vertical dimension
            3023                     
            3024                         real, intent (in) :: del (km)
            3025                     
            3026                         logical, intent (in) :: do_mono
            3027                     
            3028                         real, intent (inout) :: a4 (4, km)
            3029                     
            3030                         real, parameter :: qp_min = 1.e-6
            3031                     
            3032                         real :: gam (km)
            3033                         real :: q (km + 1)
            3034                         real :: d4, bet, a_bot, grat, pmp, lac
            3035                         real :: pmp_1, lac_1, pmp_2, lac_2
            3036                         real :: da1, da2, a6da
            3037                     
            3038                         integer :: k
            3039                     
            3040                         logical extm (km)
            3041                     
            3042                         grat = del (2) / del (1) ! grid ratio
            3043                         bet = grat * (grat + 0.5)
            3044                         q (1) = (2. * grat * (grat + 1.) * a4 (1, 1) + a4 (1, 2)) / bet
            3045                         gam (1) = (1. + grat * (grat + 1.5)) / bet
            3046                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 10, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, q, gam, del
                                   <<< Loop-information  End >>>
            3047     1   s   2s          do k = 2, km
            3048     1   p   2v              d4 = del (k - 1) / del (k)
            3049     1   m   2m              bet = 2. + 2. * d4 - gam (k - 1)
            3050     1   m   2m              q (k) = (3. * (a4 (1, k - 1) + d4 * a4 (1, k)) - q (k - 1)) / bet
            3051     1   s   2s              gam (k) = d4 / bet
            3052     1   p   2v          enddo
            3053                     
            3054                         a_bot = 1. + d4 * (d4 + 1.5)
            3055                         q (km + 1) = (2. * d4 * (d4 + 1.) * a4 (1, km) + a4 (1, km - 1) - a_bot * q (km)) &
            3056                              / (d4 * (d4 + 0.5) - a_bot * gam (km))
            3057                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, q
                                   <<< Loop-information  End >>>
            3058     1   s   2s          do k = km, 1, - 1
            3059     1   s   2s              q (k) = q (k) - gam (k) * q (k + 1)
            3060     1   s   2s          enddo
            3061                     
            3062                         ! -----------------------------------------------------------------------
            3063                         ! apply constraints
            3064                         ! -----------------------------------------------------------------------
            3065                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam
                                   <<< Loop-information  End >>>
            3066     1  pp   2v          do k = 2, km
            3067     1   p   2v              gam (k) = a4 (1, k) - a4 (1, k - 1)
            3068     1   p   2v          enddo
            3069                     
            3070                         ! -----------------------------------------------------------------------
            3071                         ! apply large - scale constraints to all fields if not local max / min
            3072                         ! -----------------------------------------------------------------------
            3073                     
            3074                         ! -----------------------------------------------------------------------
            3075                         ! top:
            3076                         ! -----------------------------------------------------------------------
            3077                     
            3078                         q (1) = max (q (1), 0.)
            3079                         q (2) = min (q (2), max (a4 (1, 1), a4 (1, 2)))
            3080                         q (2) = max (q (2), min (a4 (1, 1), a4 (1, 2)), 0.)
            3081                     
            3082                         ! -----------------------------------------------------------------------
            3083                         ! interior:
            3084                         ! -----------------------------------------------------------------------
            3085                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 127
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.62, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, q
                                   <<< Loop-information  End >>>
            3086     1  pp    v          do k = 3, km - 1
            3087     2   p    v              if (gam (k - 1) * gam (k + 1) > 0.) then
            3088     2   p    v                  q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3089     2   p    v                  q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3090     2   p    v              else
            3091     3   p    v                  if (gam (k - 1) > 0.) then
            3092     3                               ! there exists a local max
            3093     3   p    v                      q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3094     3   p    v                  else
            3095     3                               ! there exists a local min
            3096     3   p    v                      q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3097     3   p    v                      q (k) = max (q (k), 0.0)
            3098     3   p    v                  endif
            3099     2   p    v              endif
            3100     1   p    v          enddo
            3101                     
            3102                         ! -----------------------------------------------------------------------
            3103                         ! bottom :
            3104                         ! -----------------------------------------------------------------------
            3105                     
            3106                         q (km) = min (q (km), max (a4 (1, km - 1), a4 (1, km)))
            3107                         q (km) = max (q (km), min (a4 (1, km - 1), a4 (1, km)), 0.)
            3108                         ! q (km + 1) = max (q (km + 1), 0.)
            3109                     
            3110                         ! -----------------------------------------------------------------------
            3111                         ! f (s) = al + s * [ (ar - al) + a6 * (1 - s) ] (0 <= s <= 1)
            3112                         ! -----------------------------------------------------------------------
            3113                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, a4
                                   <<< Loop-information  End >>>
            3114     1  pp   2v          do k = 1, km - 1
            3115     1   p   2v              a4 (2, k) = q (k)
            3116     1   p   2v              a4 (3, k) = q (k + 1)
            3117     1   p   2v          enddo
            3118                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, extm
                                   <<< Loop-information  End >>>
            3119     1  pp   2v          do k = 2, km - 1
            3120     2   p   2v              if (gam (k) * gam (k + 1) > 0.0) then
            3121     2   p   2v                  extm (k) = .false.
            3122     2   p   2v              else
            3123     2   p   2v                  extm (k) = .true.
            3124     2   p   2v              endif
            3125     1   p   2v          enddo
            3126                     
            3127     1                   if (do_mono) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 88
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.98, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, extm
                                   <<< Loop-information  End >>>
            3128     2  pp    v              do k = 3, km - 2
            3129     3   p    v                  if (extm (k)) then
            3130     3                               ! positive definite constraint only if true local extrema
            3131     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3132     4   p    v                          a4 (2, k) = a4 (1, k)
            3133     4   p    v                          a4 (3, k) = a4 (1, k)
            3134     4   p    v                      endif
            3135     3   p    v                  else
            3136     3   p    v                      a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3137     4   p    v                      if (abs (a4 (4, k)) > abs (a4 (2, k) - a4 (3, k))) then
            3138     4                                   ! check within the smooth region if subgrid profile is non - monotonic
            3139     4   p    v                          pmp_1 = a4 (1, k) - 2.0 * gam (k + 1)
            3140     4   p    v                          lac_1 = pmp_1 + 1.5 * gam (k + 2)
            3141     4   p    v                          a4 (2, k) = min (max (a4 (2, k), min (a4 (1, k), pmp_1, lac_1)), &
            3142     4                                       max (a4 (1, k), pmp_1, lac_1))
            3143     4   p    v                          pmp_2 = a4 (1, k) + 2.0 * gam (k)
            3144     4   p    v                          lac_2 = pmp_2 - 1.5 * gam (k - 1)
            3145     4   p    v                          a4 (3, k) = min (max (a4 (3, k), min (a4 (1, k), pmp_2, lac_2)), &
            3146     4                                       max (a4 (1, k), pmp_2, lac_2))
            3147     4   p    v                      endif
            3148     3   p    v                  endif
            3149     2   p    v              enddo
            3150     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extm, a4
                                   <<< Loop-information  End >>>
            3151     2  pp    v              do k = 3, km - 2
            3152     3   p    v                  if (extm (k)) then
            3153     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3154     4   p    v                          a4 (2, k) = a4 (1, k)
            3155     4   p    v                          a4 (3, k) = a4 (1, k)
            3156     4   p    v                      endif
            3157     3   p    v                  endif
            3158     2   p    v              enddo
            3159     1                   endif
            3160                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3161     1  pp   2v          do k = 1, km - 1
            3162     1   p   2v              a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3163     1   p   2v          enddo
            3164                     
            3165                         k = km - 1
            3166     1                   if (extm (k)) then
            3167     1                       a4 (2, k) = a4 (1, k)
            3168     1                       a4 (3, k) = a4 (1, k)
            3169     1                       a4 (4, k) = 0.
            3170     1                   else
            3171     1                       da1 = a4 (3, k) - a4 (2, k)
            3172     1                       da2 = da1 ** 2
            3173     1                       a6da = a4 (4, k) * da1
            3174     2                       if (a6da < - da2) then
            3175     2                           a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3176     2                           a4 (3, k) = a4 (2, k) - a4 (4, k)
            3177     2                       elseif (a6da > da2) then
            3178     2                           a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3179     2                           a4 (2, k) = a4 (3, k) - a4 (4, k)
            3180     2                       endif
            3181     1                   endif
            3182                     
            3183                         call cs_limiters (km - 1, a4)
            3184                     
            3185                         ! -----------------------------------------------------------------------
            3186                         ! bottom layer:
            3187                         ! -----------------------------------------------------------------------
            3188                     
            3189                         a4 (2, km) = a4 (1, km)
            3190                         a4 (3, km) = a4 (1, km)
            3191                         a4 (4, km) = 0.
            3192                     
            3193                     end subroutine cs_profile
            3194                     
            3195                     subroutine cs_limiters (km, a4)
            3196                     
            3197                         implicit none
            3198                     
            3199                         integer, intent (in) :: km
            3200                     
            3201                         real, intent (inout) :: a4 (4, km) !< ppm array
            3202                     
            3203                         real, parameter :: r12 = 1. / 12.
            3204                     
            3205                         integer :: k
            3206                     
            3207                         ! -----------------------------------------------------------------------
            3208                         ! positive definite constraint
            3209                         ! -----------------------------------------------------------------------
            3210                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.59, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3211     1  pp    v          do k = 1, km
            3212     2   p    v              if (abs (a4 (3, k) - a4 (2, k)) < - a4 (4, k)) then
            3213     3   p    v                  if ((a4 (1, k) + 0.25 * (a4 (3, k) - a4 (2, k)) ** 2 / a4 (4, k) + a4 (4, k) * r12) < 0.) then
            3214     4   p    v                      if (a4 (1, k) < a4 (3, k) .and. a4 (1, k) < a4 (2, k)) then
            3215     4   p    v                          a4 (3, k) = a4 (1, k)
            3216     4   p    v                          a4 (2, k) = a4 (1, k)
            3217     4   p    v                          a4 (4, k) = 0.
            3218     4   p    v                      elseif (a4 (3, k) > a4 (2, k)) then
            3219     4   p    v                          a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3220     4   p    v                          a4 (3, k) = a4 (2, k) - a4 (4, k)
            3221     4   p    v                      else
            3222     4   p    v                          a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3223     4   p    v                          a4 (2, k) = a4 (3, k) - a4 (4, k)
            3224     4   p    v                      endif
            3225     3   p    v                  endif
            3226     2   p    v              endif
            3227     1   p    v          enddo
            3228                     
            3229                     end subroutine cs_limiters
            3230                     
            3231                     ! =======================================================================
            3232                     !>@brief The subroutine 'fall_speed' calculates vertical fall speed.
            3233                     ! =======================================================================
            3234                     
            3235                     subroutine fall_speed (ktop, kbot, den, qs, qi, qg, ql, tk, vts, vti, vtg)
            3236                     
            3237                         implicit none
            3238                     
            3239                         integer, intent (in) :: ktop, kbot
            3240                     
            3241                         real, intent (in), dimension (ktop:kbot) :: den, qs, qi, qg, ql, tk
            3242                         real, intent (out), dimension (ktop:kbot) :: vts, vti, vtg
            3243                     
            3244                         ! fall velocity constants:
            3245                     
            3246                         real, parameter :: thi = 1.0e-8 !< cloud ice threshold for terminal fall
            3247                         real, parameter :: thg = 1.0e-8
            3248                         real, parameter :: ths = 1.0e-8
            3249                     
            3250                         real, parameter :: aa = - 4.14122e-5
            3251                         real, parameter :: bb = - 0.00538922
            3252                         real, parameter :: cc = - 0.0516344
            3253                         real, parameter :: dd = 0.00216078
            3254                         real, parameter :: ee = 1.9714
            3255                     
            3256                         ! marshall - palmer constants
            3257                     
            3258                         real, parameter :: vcons = 6.6280504
            3259                         real, parameter :: vcong = 87.2382675
            3260                         real, parameter :: norms = 942477796.076938
            3261                         real, parameter :: normg = 5026548245.74367
            3262                     
            3263                         real, dimension (ktop:kbot) :: qden, tc, rhof
            3264                     
            3265                         real :: vi0
            3266                     
            3267                         integer :: k
            3268                     
            3269                         ! -----------------------------------------------------------------------
            3270                         ! marshall - palmer formula
            3271                         ! -----------------------------------------------------------------------
            3272                     
            3273                         ! -----------------------------------------------------------------------
            3274                         ! try the local air density -- for global model; the true value could be
            3275                         ! much smaller than sfcrho over high mountains
            3276                         ! -----------------------------------------------------------------------
            3277                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.17, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, rhof
                                   <<< Loop-information  End >>>
            3278     1  pp   2v          do k = ktop, kbot
            3279     1   p   2v              rhof (k) = sqrt (min (10., sfcrho / den (k)))
            3280     1   p   2v          enddo
            3281                     
            3282                         ! -----------------------------------------------------------------------
            3283                         ! ice:
            3284                         ! -----------------------------------------------------------------------
            3285                     
            3286     1                   if (const_vi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vti
                                   <<< Loop-information  End >>>
            3287     1  pp   4v              vti (:) = vi_fac
            3288     1                   else
            3289     1                       ! -----------------------------------------------------------------------
            3290     1                       ! use deng and mace (2008, grl), which gives smaller fall speed than hd90 formula
            3291     1                       ! -----------------------------------------------------------------------
            3292     1                       vi0 = 0.01 * vi_fac
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, tk, den, tc, vti
                                   <<< Loop-information  End >>>
            3293     2  pp    v              do k = ktop, kbot
            3294     3   p    v                  if (qi (k) < thi) then ! this is needed as the fall - speed maybe problematic for small qi
            3295     3   p    v                      vti (k) = vf_min
            3296     3   p    v                  else
            3297     3   p    v                      tc (k) = tk (k) - tice
            3298     3   p    v                      vti (k) = (3. + log10 (qi (k) * den (k))) * (tc (k) * (aa * tc (k) + bb) + cc) + dd * tc (k) + ee
            3299     3   p    v                      vti (k) = vi0 * exp (log_10 * vti (k))
            3300     3   p    v                      vti (k) = min (vi_max, max (vf_min, vti (k)))
            3301     3   p    v                  endif
            3302     2   p    v              enddo
            3303     1                   endif
            3304                     
            3305                         ! -----------------------------------------------------------------------
            3306                         ! snow:
            3307                         ! -----------------------------------------------------------------------
            3308                     
            3309     1                   if (const_vs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vts
                                   <<< Loop-information  End >>>
            3310     1  pp   4v              vts (:) = vs_fac ! 1. ifs_2016
            3311     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, den, rhof, vts
                                   <<< Loop-information  End >>>
            3312     2  pp    v              do k = ktop, kbot
            3313     3   p    v                  if (qs (k) < ths) then
            3314     3   p    v                      vts (k) = vf_min
            3315     3   p    v                  else
            3316     3   p    v                      vts (k) = vs_fac * vcons * rhof (k) * exp (0.0625 * log (qs (k) * den (k) / norms))
            3317     3   p    v                      vts (k) = min (vs_max, max (vf_min, vts (k)))
            3318     3   p    v                  endif
            3319     2   p    v              enddo
            3320     1                   endif
            3321                     
            3322                         ! -----------------------------------------------------------------------
            3323                         ! graupel:
            3324                         ! -----------------------------------------------------------------------
            3325                     
            3326     1                   if (const_vg) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtg
                                   <<< Loop-information  End >>>
            3327     1  pp   4v              vtg (:) = vg_fac ! 2.
            3328     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3329     2  pp    v              do k = ktop, kbot
            3330     3   p    v                  if (qg (k) < thg) then
            3331     3   p    v                      vtg (k) = vf_min
            3332     3   p    v                  else
            3333     3   p    v                      vtg (k) = vg_fac * vcong * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normg)))
            3334     3   p    v                      vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3335     3   p    v                  endif
            3336     2   p    v              enddo
            3337     1                   endif
            3338                     
            3339                     end subroutine fall_speed
            3340                     
            3341                     ! =======================================================================
            3342                     !>@brief The subroutine 'setup'm' sets up
            3343                     !! gfdl cloud microphysics parameters.
            3344                     ! =======================================================================
            3345                     
            3346                     subroutine setupm
            3347                     
            3348                         implicit none
            3349                     
            3350                         real :: gcon, cd, scm3, pisq, act (8)
            3351                         real :: vdifu, tcond
            3352                         real :: visk
            3353                         real :: ch2o, hltf
            3354                         real :: hlts, hltc, ri50
            3355                     
            3356                         real, parameter :: gam263 = 1.456943, gam275 = 1.608355, gam290 = 1.827363, &
            3357                             gam325 = 2.54925, gam350 = 3.323363, gam380 = 4.694155, &
            3358                             gam425 = 8.285063, gam450 = 11.631769, gam480 = 17.837789, &
            3359                             gam625 = 184.860962, gam680 = 496.604067
            3360                     
            3361                         ! intercept parameters
            3362                     
            3363                         real, parameter :: rnzr = 8.0e6 ! lin83
            3364                         real, parameter :: rnzs = 3.0e6 ! lin83
            3365                         real, parameter :: rnzg = 4.0e6 ! rh84
            3366                     
            3367                         ! density parameters
            3368                     
            3369                     !    real, parameter :: rhos = 0.1e3 !< lin83 (snow density; 1 / 10 of water)
            3370                     !    real, parameter :: rhog = 0.4e3 !< rh84 (graupel density)
            3371                         real, parameter :: acc (3) = (/ 5.0, 2.0, 0.5 /)
            3372                     
            3373                         real den_rc
            3374                     
            3375                         integer :: i, k
            3376                     
            3377                         pie = 4. * atan (1.0)
            3378                     
            3379                         ! s. klein's formular (eq 16) from am2
            3380                     
            3381                         fac_rc = (4. / 3.) * pie * rhor * rthresh ** 3
            3382                     
            3383     1                   if (prog_ccn) then
            3384     1                       ! if (master) write (*, *) 'prog_ccn option is .t.'
            3385     1                   else
            3386     1                       den_rc = fac_rc * ccn_o * 1.e6
            3387     1                       ! if (master) write (*, *) 'mp: for ccn_o = ', ccn_o, 'ql_rc = ', den_rc
            3388     1                       den_rc = fac_rc * ccn_l * 1.e6
            3389     1                       ! if (master) write (*, *) 'mp: for ccn_l = ', ccn_l, 'ql_rc = ', den_rc
            3390     1                   endif
            3391                     
            3392                         vdifu = 2.11e-5
            3393                         tcond = 2.36e-2
            3394                     
            3395                         visk = 1.259e-5
            3396                         hlts = 2.8336e6
            3397                         hltc = 2.5e6
            3398                         hltf = 3.336e5
            3399                     
            3400                         ch2o = 4.1855e3
            3401                         ri50 = 1.e-4
            3402                     
            3403                         pisq = pie * pie
            3404                         scm3 = (visk / vdifu) ** (1. / 3.)
            3405                     
            3406                         cracs = pisq * rnzr * rnzs * rhos
            3407                         csacr = pisq * rnzr * rnzs * rhor
            3408                         cgacr = pisq * rnzr * rnzg * rhor
            3409                         cgacs = pisq * rnzg * rnzs * rhos
            3410                         cgacs = cgacs * c_pgacs
            3411                     
            3412                         ! act: 1 - 2:racs (s - r) ; 3 - 4:sacr (r - s) ;
            3413                         ! 5 - 6:gacr (r - g) ; 7 - 8:gacs (s - g)
            3414                     
            3415                         act (1) = pie * rnzs * rhos
            3416                         act (2) = pie * rnzr * rhor
            3417                         act (6) = pie * rnzg * rhog
            3418                         act (3) = act (2)
            3419                         act (4) = act (1)
            3420                         act (5) = act (2)
            3421                         act (7) = act (1)
            3422                         act (8) = act (6)
            3423                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<< Loop-information  End >>>
            3424     1   s    v          do i = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3425     2   p   fv              do k = 1, 4
            3426     2   p   fv                  acco (i, k) = acc (i) / (act (2 * k - 1) ** ((7 - i) * 0.25) * act (2 * k) ** (i * 0.25))
            3427     2   p   fv              enddo
            3428     1   p    v          enddo
            3429                     
            3430                         gcon = 40.74 * sqrt (sfcrho) ! 44.628
            3431                     
            3432                         csacw = pie * rnzs * clin * gam325 / (4. * act (1) ** 0.8125)
            3433                         ! decreasing csacw to reduce cloud water --- > snow
            3434                     
            3435                         craci = pie * rnzr * alin * gam380 / (4. * act (2) ** 0.95)
            3436                         csaci = csacw * c_psaci
            3437                     
            3438                         cgacw = pie * rnzg * gam350 * gcon / (4. * act (6) ** 0.875)
            3439                         ! cgaci = cgacw * 0.1
            3440                     
            3441                         ! sjl, may 28, 2012
            3442                         cgaci = cgacw * 0.05
            3443                         ! sjl, may 28, 2012
            3444                     
            3445                         cracw = craci ! cracw = 3.27206196043822
            3446                         cracw = c_cracw * cracw
            3447                     
            3448                         ! subl and revp: five constants for three separate processes
            3449                     
            3450                         cssub (1) = 2. * pie * vdifu * tcond * rvgas * rnzs
            3451                         cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzg
            3452                         crevp (1) = 2. * pie * vdifu * tcond * rvgas * rnzr
            3453                         cssub (2) = 0.78 / sqrt (act (1))
            3454                         cgsub (2) = 0.78 / sqrt (act (6))
            3455                         crevp (2) = 0.78 / sqrt (act (2))
            3456                         cssub (3) = 0.31 * scm3 * gam263 * sqrt (clin / visk) / act (1) ** 0.65625
            3457                         cgsub (3) = 0.31 * scm3 * gam275 * sqrt (gcon / visk) / act (6) ** 0.6875
            3458                         crevp (3) = 0.31 * scm3 * gam290 * sqrt (alin / visk) / act (2) ** 0.725
            3459                         cssub (4) = tcond * rvgas
            3460                         cssub (5) = hlts ** 2 * vdifu
            3461                         cgsub (4) = cssub (4)
            3462                         crevp (4) = cssub (4)
            3463                         cgsub (5) = cssub (5)
            3464                         crevp (5) = hltc ** 2 * vdifu
            3465                     
            3466                         cgfr (1) = 20.e2 * pisq * rnzr * rhor / act (2) ** 1.75
            3467                         cgfr (2) = 0.66
            3468                     
            3469                         ! smlt: five constants (lin et al. 1983)
            3470                     
            3471                         csmlt (1) = 2. * pie * tcond * rnzs / hltf
            3472                         csmlt (2) = 2. * pie * vdifu * rnzs * hltc / hltf
            3473                         csmlt (3) = cssub (2)
            3474                         csmlt (4) = cssub (3)
            3475                         csmlt (5) = ch2o / hltf
            3476                     
            3477                         ! gmlt: five constants
            3478                     
            3479                         cgmlt (1) = 2. * pie * tcond * rnzg / hltf
            3480                         cgmlt (2) = 2. * pie * vdifu * rnzg * hltc / hltf
            3481                         cgmlt (3) = cgsub (2)
            3482                         cgmlt (4) = cgsub (3)
            3483                         cgmlt (5) = ch2o / hltf
            3484                     
            3485                         es0 = 6.107799961e2 ! ~6.1 mb
            3486                         ces0 = eps * es0
            3487                     
            3488                     end subroutine setupm
            3489                     
            3490                     ! =======================================================================
            3491                     ! initialization of gfdl cloud microphysics
            3492                     !>@brief The subroutine 'gfdl_cloud_microphys_init' initializes the GFDL
            3493                     !! cloud microphysics.
            3494                     ! =======================================================================
            3495                     
            3496                     !subroutine gfdl_cloud_microphys_init (me, master, nlunit, input_nml_file, logunit, fn_nml)
            3497                     subroutine gfdl_cloud_microphys_init ()
            3498                     
            3499                         implicit none
            3500                     
            3501                     !    integer, intent (in) :: me
            3502                     !    integer, intent (in) :: master
            3503                     !    integer, intent (in) :: nlunit
            3504                     !    integer, intent (in) :: logunit
            3505                     
            3506                     !    character (len = 64), intent (in) :: fn_nml
            3507                     !    character (len = *),  intent (in) :: input_nml_file(:)
            3508                     
            3509                     !    integer :: ios
            3510                     !    logical :: exists
            3511                     
            3512                         ! integer, intent (in) :: id, jd, kd
            3513                         ! integer, intent (in) :: axes (4)
            3514                         ! type (time_type), intent (in) :: time
            3515                     
            3516                         ! integer :: unit, io, ierr, k, logunit
            3517                         ! logical :: flag
            3518                         ! real :: tmp, q1, q2
            3519                     
            3520                         ! master = (mpp_pe () .eq.mpp_root_pe ())
            3521                     
            3522                     !#ifdef INTERNAL_FILE_NML
            3523                     !    read (input_nml_file, nml = gfdl_cloud_microphysics_nml)
            3524                     !#else
            3525                     !    inquire (file = trim (fn_nml), exist = exists)
            3526                     !    if (.not. exists) then
            3527                     !        write (6, *) 'gfdl - mp :: namelist file: ', trim (fn_nml), ' does not exist'
            3528                     !        stop
            3529                     !    else
            3530                     !        open (unit = nlunit, file = fn_nml, readonly, status = 'old', iostat = ios)
            3531                     !    endif
            3532                     !    rewind (nlunit)
            3533                     !    read (nlunit, nml = gfdl_cloud_microphysics_nml)
            3534                     !    close (nlunit)
            3535                     !#endif
            3536                     
            3537                         ! write version number and namelist to log file
            3538                     !    if (me == master) then
            3539                     !        write (logunit, *) " ========================================================= "
            3540                     !        write (logunit, *) "gfdl_cloud_microphys_mod"
            3541                     !!        write (logunit, nml = gfdl_cloud_microphysics_nml)
            3542                     !    endif
            3543                     
            3544     1                   if (do_setup) then
            3545     1    i                  call setup_con
            3546     1                       call setupm
            3547     1                       do_setup = .false.
            3548     1                   endif
            3549                     
            3550                         log_10 = log (10.)
            3551                     
            3552                         tice0 = tice - 0.01
            3553                         t_wfr = tice - 40.0 ! supercooled water can exist down to - 48 c, which is the "absolute"
            3554                     
            3555                         ! if (master) write (logunit, nml = gfdl_cloud_microphys_nml)
            3556                         !
            3557                         ! id_vtr = register_diag_field (mod_name, 'vt_r', axes (1:3), time, &
            3558                         ! 'rain fall speed', 'm / s', missing_value = missing_value)
            3559                         ! id_vts = register_diag_field (mod_name, 'vt_s', axes (1:3), time, &
            3560                         ! 'snow fall speed', 'm / s', missing_value = missing_value)
            3561                         ! id_vtg = register_diag_field (mod_name, 'vt_g', axes (1:3), time, &
            3562                         ! 'graupel fall speed', 'm / s', missing_value = missing_value)
            3563                         ! id_vti = register_diag_field (mod_name, 'vt_i', axes (1:3), time, &
            3564                         ! 'ice fall speed', 'm / s', missing_value = missing_value)
            3565                     
            3566                         ! id_droplets = register_diag_field (mod_name, 'droplets', axes (1:3), time, &
            3567                         ! 'droplet number concentration', '# / m3', missing_value = missing_value)
            3568                         ! id_rh = register_diag_field (mod_name, 'rh_lin', axes (1:2), time, &
            3569                         ! 'relative humidity', 'n / a', missing_value = missing_value)
            3570                     
            3571                         ! id_rain = register_diag_field (mod_name, 'rain_lin', axes (1:2), time, &
            3572                         ! 'rain_lin', 'mm / day', missing_value = missing_value)
            3573                         ! id_snow = register_diag_field (mod_name, 'snow_lin', axes (1:2), time, &
            3574                         ! 'snow_lin', 'mm / day', missing_value = missing_value)
            3575                         ! id_graupel = register_diag_field (mod_name, 'graupel_lin', axes (1:2), time, &
            3576                         ! 'graupel_lin', 'mm / day', missing_value = missing_value)
            3577                         ! id_ice = register_diag_field (mod_name, 'ice_lin', axes (1:2), time, &
            3578                         ! 'ice_lin', 'mm / day', missing_value = missing_value)
            3579                         ! id_prec = register_diag_field (mod_name, 'prec_lin', axes (1:2), time, &
            3580                         ! 'prec_lin', 'mm / day', missing_value = missing_value)
            3581                     
            3582                         ! if (master) write (*, *) 'prec_lin diagnostics initialized.', id_prec
            3583                     
            3584                         ! id_cond = register_diag_field (mod_name, 'cond_lin', axes (1:2), time, &
            3585                         ! 'total condensate', 'kg / m ** 2', missing_value = missing_value)
            3586                         ! id_var = register_diag_field (mod_name, 'var_lin', axes (1:2), time, &
            3587                         ! 'subgrid variance', 'n / a', missing_value = missing_value)
            3588                     
            3589                         ! call qsmith_init
            3590                     
            3591                         ! testing the water vapor tables
            3592                     
            3593                         ! if (mp_debug .and. master) then
            3594                         ! write (*, *) 'testing water vapor tables in gfdl_cloud_microphys'
            3595                         ! tmp = tice - 90.
            3596                         ! do k = 1, 25
            3597                         ! q1 = wqsat_moist (tmp, 0., 1.e5)
            3598                         ! q2 = qs1d_m (tmp, 0., 1.e5)
            3599                         ! write (*, *) nint (tmp - tice), q1, q2, 'dq = ', q1 - q2
            3600                         ! tmp = tmp + 5.
            3601                         ! enddo
            3602                         ! endif
            3603                     
            3604                         ! if (master) write (*, *) 'gfdl_cloud_micrphys diagnostics initialized.'
            3605                     
            3606                         module_is_initialized = .true.
            3607                     
            3608                     !+---+-----------------------------------------------------------------+
            3609                     !..Set these variables needed for computing radar reflectivity.  These
            3610                     !.. get used within radar_init to create other variables used in the
            3611                     !.. radar module.
            3612                     
            3613                        xam_r = pi*rhor/6.
            3614                        xbm_r = 3.
            3615                        xmu_r = 0.
            3616                        xam_s = pi*rhos/6.
            3617                        xbm_s = 3.
            3618                        xmu_s = 0.
            3619                        xam_g = pi*rhog/6.
            3620                        xbm_g = 3.
            3621                        xmu_g = 0.
            3622                     
            3623                        call radar_init
            3624                     
            3625                     end subroutine gfdl_cloud_microphys_init
            3626                     

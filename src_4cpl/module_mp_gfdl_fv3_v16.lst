                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dq
                                   <<< Loop-information  End >>>
            1461     2  pp   2v              do k = 2, km
            1462     2   p   2v                  dq (k) = 0.5 * (q (k) - q (k - 1))
            1463     2   p   2v              enddo
            1464     1                       dm (1) = 0.
            1465     1               
            1466     1                       ! -----------------------------------------------------------------------
            1467     1                       ! use twice the strength of the positive definiteness limiter (lin et al 1994)
            1468     1                       ! -----------------------------------------------------------------------
            1469     1               

 External subroutine subprogram "ctemp3"
  (inc)(line-no.)(nest)(optimize)
             172                     
             173                           subroutine ctemp3 ( mn,lm,g,r,pr,zz,tp,zc,mode )
             174                     !
             175                     !     convert geopotential height to temperature on lm*2-1 p-levels
             176                     !
             177                     !  input parameters:
             178                     !
             179                     !     mn       :  horizontal dimension
             180                     !     lm       :  vertical dimension
             181                     !     g        :  gravity (=9.806)
             182                     !     r        :  gas constant (=287.04)
             183                     !     pr(mn,lm)   :  presure (mb)
             184                     !     zz(mn,lm):  geopotential height of the pr pressure levels (m)
             185                     !     zc       :  converge criterion of hydrostatic iterations (m)
             186                     !     mode     :  mode to compute temperature at the bottom (lm) level;
             187                     !                 = 0     , using std atmosphere lapse rate
             188                     !                 = others, extrapolating from (lm-1) and (lm-1/2)
             189                     !
             190                     !  output parameter:
             191                     !
             192                     !     tp(mn,lm*2-1): temperature at the pressure levels and levels in
             193                     !                    between them  ( tp(lm*2-1) is for pr(lm) level )
             194                     !
             195                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
             196                     !
             197                           use rank
             198                     
             199                           dimension pr(mn,lm),zz(mn,lm),tp(mn,lm*2-1)
             200                     !
             201                     !  work arrays
             202                     !
             203                           dimension zdif(mn),pdif(mn),znew(mn,lm),tt(mn,lm)            &
             204                                   , plog(mn,lm*2-1),zhyd(mn,lm*2-1)
             205                     !
             206                           lmd2 = lm / 2
             207                           lmp1 = lm + 1
             208                           lm2m1= lm*2 - 1
             209                           lm2m2= lm*2 - 2
             210                           lm2m3= lm*2 - 3
             211                           lmtd2= lm2m1 / 2
             212                     !
             213                     !***********************************************************************
             214                     !          flip vertical index of pr and zz for ctemp simulation
             215                     !***********************************************************************
             216                     !
             217     1                     do 100 kt = 1, lmd2
             218     1                     kb = lmp1 - kt
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pr, zz, pdif, zdif
                                   <<< Loop-information  End >>>
             219     2  pp    v            do 110 i = 1,mn
             220     2   p    v            zdif(i)  = zz(i,kt)
             221     2   p    v            zz(i,kt) = zz(i,kb)
             222     2   p    v            zz(i,kb) = zdif(i)
             223     2   p    v            pdif(i)  = pr(i,kt)
             224     2   p    v            pr(i,kt) = pr(i,kb)
             225     2   p    v            pr(i,kb) = pdif(i)
             226     2   p    v        110 continue
             227     1                 100 continue
             228                     !
             229                     !***********************************************************************
             230                     !          compute hydrostatic temperature at middle p-levels
             231                     !                 ( use tt as the work array to store it )
             232                     !***********************************************************************
             233                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pr, plog
                                   <<< Loop-information  End >>>
             234     1  pp                 do 200 l = 1, lm2m1, 2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pr, plog
                                   <<< Loop-information  End >>>
             235     2   p    v            do 200 i = 1, mn
             236     2   p    v            plog(i,l) = log(pr(i,(l+1)/2))
             237     1   p    v        200 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog
                                   <<< Loop-information  End >>>
             238     1  pp                 do 210 l = 2, lm2m2, 2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog
                                   <<< Loop-information  End >>>
             239     2   p   2v            do 210 i = 1, mn
             240     2   p   2v            plog(i,l) = 0.5*(plog(i,l-1)+plog(i,l+1))
             241     1   p   2v        210 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog, zhyd
                                   <<< Loop-information  End >>>
             242     1  pp   2v            do 220 l = 1, lm2m2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             243     2   p   2             do 220 i = 1, mn
             244     2   p   2v            dlp = plog(i,l)-plog(i,l+1)
             245     2   p   2v            zhyd(i,l) = dlp*r/g
             246     1   p   2v        220 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zhyd, zz, tt
                                   <<< Loop-information  End >>>
             247     1  pp                 do 240 l = 2, lm
             248     1   p                 l1 = 2*l- 3
             249     1   p                 l2 = l1 + 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zz, zhyd, tt
                                   <<< Loop-information  End >>>
             250     2   p   2v            do 230 i = 1, mn
             251     2   p   2v            tt(i,l-1) = (zz(i,l)-zz(i,l-1))/(zhyd(i,l1)+zhyd(i,l2))
             252     2   p   2v        230 continue
             253     1   p             240 continue
             254                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 23
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.61, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdif, plog, pr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 21
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             255     1  pp    v            do i = 1, mn
             256     1               !cc   pdif(i) = (pr(i,1)/exp(plog(i,2)))**0.19023
             257     1   p    v            fff = 0.19023 * ( log(pr(i,1)) - plog(i,2) )
             258     1   p    v            pdif(i) = exp( fff )
             259     1   p    v            end do
             260                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog, pdif, tt, tp
                                   <<< Loop-information  End >>>
             261     1                     do 390 iter = 1 , 10
             262     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, tp
                                   <<< Loop-information  End >>>
             263     2  pp                 do 310 l = 2, lm2m2, 2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, tp
                                   <<< Loop-information  End >>>
             264     3   p   2v            do 310 i = 1, mn
             265     3   p   2v            tp(i,l)  = tt(i,l/2)
             266     2   p   2v        310 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog, tt, tp
                                   <<< Loop-information  End >>>
             267     2  pp                 do 325 l = 3, lm2m2, 2
             268     2   p                 l1 = (l-1)/2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog, tt, tp
                                   <<< Loop-information  End >>>
             269     3   p    v            do 320 i = 1,mn
             270     3   p    v            xl1 = (plog(i,l-1)-plog(i,l))/(plog(i,l-1)-plog(i,l+1))
             271     3   p    v            tp(i,l) = tt(i,l1)+(tt(i,l1+1)-tt(i,l1))*xl1
             272     3   p    v        320 continue
             273     2   p             325 continue
             274     2                     if ( mode .eq. 0 )  then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdif, tt, tp
                                   <<< Loop-information  End >>>
             275     3  pp   2v               do 330 i = 1, mn
             276     3   p   2v               tp(i,1) = tt(i,1) * pdif(i)
             277     3   p   2v        330    continue
             278     2                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog, tp
                                   <<< Loop-information  End >>>
             279     3  pp    v               do 335 i = 1, mn
             280     3   p    v               tp(i,1) = tp(i,2)+(tp(i,2)-tp(i,3))*(plog(i,1)-plog(i,2))    &
             281     3                                / (plog(i,2)-plog(i,3))
             282     3   p    v        335    continue
             283     2                     endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 284,289)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp, zhyd, zz, znew
                                   <<< Loop-information  End >>>
             284     2  pp    v            do 340 i = 1, mn
             285     2   p    v            tp(i,lm2m1) = tp(i,lm2m2) + 1.5e-3*( zz(i,lm) - (zz(i,lm-1)     &
             286     2                                 + 0.5*(tp(i,lm2m2)+tp(i,lm2m3))*zhyd(i,lm2m3)) )
             287     2   p    v        340 continue
             288     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             289     2                     do 350 i = 1, mn
             290     2                     znew(i,1) = zz(i,1)
             291     2                 350 continue
             292     1                     zmax = 0.0
             293     2                     do 370 l = 2, lm
             294     2                     l1 = 2*l- 3
             295     2                     l2 = l1 + 1
             296     2                     l3 = l2 + 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 250
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.92, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      znew, tp, zhyd, tt, zz, zdif
                                   <<< Loop-information  End >>>
             297     3  pp    v            do 360 i = 1, mn
             298     3   p    v            znew(i,l)  = znew(i,l-1) + 0.5*(tp(i,l1)+tp(i,l2))*zhyd(i,l1)   &
             299     3                                              + 0.5*(tp(i,l2)+tp(i,l3))*zhyd(i,l2)
             300     3   p    v            zdif(i)    = znew(i,l) - znew(i,l-1) - zz(i,l) + zz(i,l-1)
             301     3   p    v            tt(i,l-1)  = tt(i,l-1) - zdif(i)/(zhyd(i,l1)+zhyd(i,l2))
             302     3   p    v            zdif(i)    = abs(zdif(i))
             303     3   p    v        360 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             304     3  pp    v            do 365 i = 1, mn
             305     3   p    v            zmax = max( zmax, zdif(i) )
             306     3   p    v        365 continue
             307     2                 370 continue
             308     1                     if ( zmax .lt. zc ) go to 400
             309     1                 390 continue
             310                           if(myrank .eq. 0) print 800, zc, zmax
             311                       800 format(1x,'** warning: ctemp2 does not converage in 10'         &
             312                                 ,' iterations !!  zcrit =',f6.2,', zdifmax = ',e13.6)
             313                       400 continue
             314                     !
             315                     !***********************************************************************
             316                     !          flip vertical index of pr and zz back to normal index
             317                     !***********************************************************************
             318                     !
             319     1                     do 420 kt = 1, lmd2
             320     1                     kb = lmp1 - kt
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pr, zz, pdif, zdif
                                   <<< Loop-information  End >>>
             321     2  pp    v            do 410 i = 1, mn
             322     2   p    v            zdif(i)  = zz(i,kt)
             323     2   p    v            zz(i,kt) = zz(i,kb)
             324     2   p    v            zz(i,kb) = zdif(i)

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plog
                                   <<< Loop-information  End >>>
              70     1  pp   2v            do 210 l = 2, lm2m2, 2
              71     1   p   2v            plog(l) = 0.5*(plog(l-1)+plog(l+1))
              72     1   p   2v        210 continue

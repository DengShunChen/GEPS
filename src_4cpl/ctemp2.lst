               1                           subroutine ctemp2 ( mn,lm,g,r,pr,zz,tp,zc,mode )
               2                     !
               3                     !     convert geopotential height to temperature on lm*2-1 p-levels
               4                     !
               5                     !  input parameters:
               6                     !
               7                     !     mn       :  horizontal dimension
               8                     !     lm       :  vertical dimension
               9                     !     g        :  gravity (=9.806)
              10                     !     r        :  gas constant (=287.04)
              11                     !     pr(lm)   :  presure (mb)
              12                     !     zz(mn,lm):  geopotential height of the pr pressure levels (m)
              13                     !     zc       :  converge criterion of hydrostatic iterations (m)
              14                     !     mode     :  mode to compute temperature at the bottom (lm) level;
              15                     !                 = 0     , using std atmosphere lapse rate
              16                     !                 = others, extrapolating from (lm-1) and (lm-1/2)
              17                     !
              18                     !  output parameter:
              19                     !
              20                     !     tp(mn,lm*2-1): temperature at the pressure levels and levels in
              21                     !                    between them  ( tp(lm*2-1) is for pr(lm) level )
              22                     !
              23                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              24                     !
              25                           use rank
              26                     
              27                           implicit  none
              28                     
              29                           integer   mn,lm,mode
              30                           real      pr(lm),zz(mn,lm),tp(mn,lm*2-1)
              31                     !
              32                     !  work arrays
              33                     !
              34                           real      zdif(mn),znew(mn,lm),tt(mn,lm),plog(lm*2-1),zhyd(lm*2-1)
              35                     
              36                           integer   lmd2,lmp1,lm2m1,lm2m2,lm2m3,lmtd2,kt,kb,i,l,l1,l2,l3,iter
              37                           real      zc,r,g,pxxx,dlp,tpx,xl1,zmax
              38                     !
              39                           lmd2 = lm / 2
              40                           lmp1 = lm + 1
              41                           lm2m1= lm*2 - 1
              42                           lm2m2= lm*2 - 2
              43                           lm2m3= lm*2 - 3
              44                           lmtd2= lm2m1 / 2
              45                     !
              46                     !***********************************************************************
              47                     !          flip vertical index of pr and zz for ctemp simulation
              48                     !***********************************************************************
              49                     !
              50     1                     do 100 kt = 1, lmd2
              51     1                     kb = lmp1 - kt
              52     1                     pxxx   = pr(kt)
              53     1                     pr(kt) = pr(kb)
              54     1                     pr(kb) = pxxx
                                   <<< Loop-information Start >>>

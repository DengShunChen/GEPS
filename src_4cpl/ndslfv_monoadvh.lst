 External subroutine subprogram "ndslfv_monoadvh2_yx"
  (inc)(line-no.)(nest)(optimize)
            1116                     !
            1117                     !
            1118                           subroutine ndslfv_monoadvh2_yx(ddtemp,qvadv,pten,vdzonl,vdmerd  &
            1119                                     , lonsperlat,deltim,levs)
            1120                     !
            1121                     ! a routine to do non-iteration semi-Lagrangain advection
            1122                     ! considering advection  with monotonicity in interpolation
            1123                     ! contact: hann-ming henry juang
            1124                     ! program log
            1125                     ! 2011 02 20 : henry juang, created for ndsl advection
            1126                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            1127                     !
            1128                           use param
            1129                           use grid
            1130                           use index
            1131                           use const
            1132                           use rank
            1133                     
            1134                           implicit none
            1135                     
            1136                           real(kind=RTYPE) pten(nx,levs,my_max)
            1137                           real(kind=RTYPE) ddtemp(nx,levs,my_max),qvadv(nx,levs,ncld,my_max)
            1138                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            1139                     !      real(kind=RTYPE) plev(lonfull,levs+1)
            1140                     !      integer,intent(in):: global_lats_a(my)
            1141                           integer,intent(in):: lonsperlat(my)
            1142                           real(kind=RTYPE),   intent(in):: deltim
            1143                     
            1144                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            1145                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            1146                           real(kind=RTYPE)      qqlon(lonfull,levs*ndslhvar,latpart)
            1147                     !      real(kind=RTYPE)      rrlon(lonfull,levs*ndslhvar,latpart)
            1148                     
            1149                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            1150                           real(kind=RTYPE)      qqlat(latfull,levs*ndslhvar,lonpart)
            1151                     !      real(kind=RTYPE)      rrlat(latfull,levs*ndslhvar,lonpart)
            1152                           real(kind=RTYPE)      xr    (lonfull,levs)
            1153                           real(kind=RTYPE)      xcp   (lonfull,levs)
            1154                           real(kind=RTYPE)      sumrq (lonfull,levs)
            1155                           real(kind=RTYPE)      xkappa(lonfull,levs)
            1156                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            1157                     
            1158                     !      logical   lprint
            1159                     
            1160                           integer mono,mass,levs
            1161                           integer nlevs,nvars!,levh
            1162                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            1163                           integer kuu, kvv, kqq, ktt, kup, nqq
            1164                           integer ku , kv , kq , kt , kp
            1165                     !
            1166                     !      lprint = .false.
            1167                     
            1168                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            1169                     !
            1170                           mono  = 1
            1171                           mass  = 0
            1172                           cons0 = 0.0
            1173                           cons1 = 1.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon
                                   <<< Loop-information  End >>>
            1174        pp   4v            qqlon = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vvlon, uulon
                                   <<< Loop-information  End >>>
            1175        pp   2v            uulon = 0.
            1176         p   2v            vvlon = 0.
            1177                     !
            1178                     !      levh = ncld * levs
            1179                     !
            1180                     !      kuu = 1
            1181                     !      kvv = kuu + levs
            1182                     !      kuu = kvv + levs
            1183                           kuu = 1
            1184                           kvv = kuu + levs
            1185                           ktt = kvv + levs
            1186                           kup = ktt + levs
            1187                     !!      kqq = kup + levs
            1188                           kqq = ktt + levs
            1189                     
            1190                           nvars = ndslhvar
            1191                           nlevs = nvars * levs
            1192                     !
            1193                           rdt2 = 0.5 / deltim
            1194                     !
            1195                     ! =================================================================
            1196                     !   prepare wind and variable in flux form with gaussina weight
            1197                     ! =================================================================
            1198                     !
            1199                     
            1200                     !$omp parallel do                                                      &
            1201                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kt,kv,ku,kp,kq) &
            1202                     !$omp schedule(dynamic)
            1203     1   p                 do lan=1,jlistnum
            1204     1               
            1205     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            1206     1   p                   lat = jlist1(lan)
            1207     1   p                   lons_lat = lonsperlat(lat)
            1208     1               !        rma  = 1. / cosglat(lat) / con_rerth
            1209     1               !        rm2a = rma / cosglat(lat)
            1210     1   p                   rma  = 1. / cosl(lat)
            1211     1   p                   rm2a = rma / cosl(lat)
            1212     1               !
            1213     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            1214     2   p                   do k=1,levs
            1215     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            1216     3   p   2v                do i=1,lons_lat
            1217     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            1218     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            1219     3               !hmhj use real(kind=RTYPE) wind
            1220     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            1221     3               !hmhj use virtual wind
            1222     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            1223     3               !for CWB GFS
            1224     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            1225     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            1226     3   p   2v                enddo
            1227     2   p                   enddo
            1228     1               !        if( lprint ) then
            1229     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            1230     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            1231     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            1232     1               !        endif
            1233     1               !
            1234     1               ! u v t at n-1
            1235     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            1236     2   p                   do k=1,levs
            1237     2   p                     ku=kuu+k-1
            1238     2   p                     kv=kvv+k-1
            1239     2   p                     kt=ktt+k-1
            1240     2   p                     kp=kup+k-1
            1241     2   p                     kk=levs-k+1
            1242     2               !ch>
            1243     2               !       KL=lev-Llist(k)+1
            1244     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            1245     3   p    v                do i=1,lons_lat
            1246     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            1247     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            1248     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            1249     3               !!          qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            1250     3               
            1251     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            1252     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            1253     3   p    v                  qqlon(i,kt,lan) = ddtemp(i,k,lan)
            1254     3               !!            qqlon(i,kp,lan) = pten(i,k,lan)
            1255     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            1256     3   p    v                enddo
            1257     2   p                   enddo
            1258     1               ! rq at n-1
            1259     2   p                   do n=1,ncld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvadv, qqlon
                                   <<< Loop-information  End >>>
            1260     3   p                   do k=1,levs
            1261     3   p                     kq=kqq+k-1+(n-1)*levs
            1262     3   p                     kk=levs-k+1+(n-1)*levs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvadv, qqlon
                                   <<< Loop-information  End >>>
            1263     4   p   2v                do i=1,lons_lat
            1264     4               !ch         qqlon(i,kq,lan) = qm(i,kk,lan)
            1265     4   p   2v                  qqlon(i,kq,lan) = qvadv(i,k,n,lan)
            1266     4   p   2v                enddo
            1267     3   p                   enddo
            1268     2   p                   enddo
            1269     1               ! add surface pressure perturbation for removing resonance
            1270     1               !       rkt = con_g / ( con_rd * 300.0 )
            1271     1               !       do i=1,lons_lat
            1272     1               !         ilan=i+jlonf
            1273     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
            1274     1               !       enddo
            1275     1               !
            1276     1               ! save qqlon into n+1 for later as tendency
            1277     1               ! z d t at n+1
            1278     1               !        do k=1,levs
            1279     1               !          kk=levs-k+1
            1280     1               !          ku=kuu+k-1
            1281     1               !          kv=kvv+k-1
            1282     1               !          kt=ktt+k-1
            1283     1               !          kug=g_d+k-1
            1284     1               !          kvg=g_z+k-1
            1285     1               !          ktg=g_t+k-1
            1286     1               !          do i=1,lons_lat
            1287     1               !            ilan=i+jlonf
            1288     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
            1289     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
            1290     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
            1291     1               !          enddo
            1292     1               !        enddo
            1293     1               ! change h to theta
            1294     1               !
            1295     1               ! ----- prepare xr, xcp, xkapa
            1296     1               !
            1297     1               !       xr    = cons0
            1298     1               !       xcp   = cons0
            1299     1               !       sumrq = cons0
            1300     1               !
            1301     1               !       do n=1,ntrac
            1302     1               !         nqq = kqq + (n-1)*levs
            1303     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
            1304     1               !           do k=1,levs
            1305     1               !             kq=nqq+k-1
            1306     1               !             do i=1,lons_lat
            1307     1               !               xr   (i,k) = xr   (i,k) + qqlon(i,kq,lan)*ri(n)
            1308     1               !               xcp  (i,k) = xcp  (i,k) + qqlon(i,kq,lan)*cpi(n)
            1309     1               !               sumrq(i,k) = sumrq(i,k) + qqlon(i,kq,lan)
            1310     1               !             enddo
            1311     1               !           enddo
            1312     1               !         endif
            1313     1               !       enddo
            1314     1               !       do k=1,levs
            1315     1               !         do i=1,lons_lat
            1316     1               !           xr (i,k)   = ( cons1 - sumrq(i,k) )*ri(0)  + xr (i,k)
            1317     1               !           xcp(i,k)   = ( cons1 - sumrq(i,k) )*cpi(0) + xcp(i,k)
            1318     1               !           xkappa(i,k) = xr(i,k) / xcp(i,k)
            1319     1               !         enddo
            1320     1               !       enddo
            1321     1               !
            1322     1               !       do k=1,levs
            1323     1               !         kt=ktt+k-1
            1324     1               !         ku=kuu+k-1
            1325     1               !         do i=1,lons_lat
            1326     1               !           pi = (qqlon(i,ku,lan)*0.005)**xkappa(i,k)
            1327     1               !           qqlon(i,kt,lan) = qqlon(i,kt,lan)/pi
            1328     1               !         enddo
            1329     1               !       enddo
            1330     1               !
            1331     1               ! rq  no need for tendency
            1332     1               !
            1333     1               !        if( lprint ) then
            1334     1               !        print *,' ------------------------------------------- '
            1335     1               !        ilan=1+jlonf
            1336     1               !        call mymaxmin(grid_gr(ilan,g_ttm),lons_lat,lonfull,1,' n-1 t ')
            1337     1               !        call mymaxmin(grid_gr(ilan,g_rrm ),lons_lat,lonfull,1,' n-1 q ')
            1338     1               !        call mymaxmin(grid_gr(ilan,g_zem),lons_lat,lonfull,1,' n-1 z ')
            1339     1               !        call mymaxmin(grid_gr(ilan,g_dim),lons_lat,lonfull,1,' n-1 d ')
            1340     1               !        print *,' ------------------------------------------- '
            1341     1               !        call mymaxmin(qqlon(1,ktt,lan),lons_lat,lonfull,1,' red t ')
            1342     1               !        call mymaxmin(qqlon(1,kqq,lan),lons_lat,lonfull,1,' red q ')
            1343     1               !        call mymaxmin(qqlon(1,kvv,lan),lons_lat,lonfull,1,' red z ')
            1344     1               !        call mymaxmin(qqlon(1,kuu,lan),lons_lat,lonfull,1,' red d ')
            1345     1               !        endif
            1346     1               
            1347     1               !       call cyclic_cell_intpx(levs,lons_lat,lonf,uulon(1,1,lan))
            1348     1               
            1349     1               !        if( lprint ) then
            1350     1               !        print *,' ------------------------------------------- '
            1351     1               !        call mymaxmin(qqlon(1,ktt,lan),lonfull,lonfull,1,' full t ')
            1352     1               !        call mymaxmin(qqlon(1,kqq,lan),lonfull,lonfull,1,' full q ')
            1353     1               !        call mymaxmin(qqlon(1,kvv,lan),lonfull,lonfull,1,' full z ')
            1354     1               !        call mymaxmin(qqlon(1,kuu,lan),lonfull,lonfull,1,' full d ')
            1355     1               !        endif
            1356     1               
            1357     1               !!        rrlon(:,:,lan) = qqlon(:,:,lan)
            1358     1               !
            1359     1               ! first set positive advection in east-west direction
            1360     1               !
            1361     1               !!        call cyclic_cell_massadvx(lons_lat,lonfull,lev,nvars,deltim,   &
            1362     1               !!                         uulon(1,1,lan),qqlon(1,1,lan),mass)
            1363     1               !       call cyclic_mono_advectx (lonfull,lev,nvars,deltim,               &
            1364     1               !    &                   uulon(1,1,lan),rrlon(1,1,lan),mono)
            1365     1               
            1366     1               !!        call cyclic_cell_intpx(nlevs,lons_lat,lonfull,rrlon(1,1,lan))
            1367     1   p                   call cyclic_cell_intpx(nlevs,lons_lat,lonfull,qqlon(1,1,lan))
            1368     1   p                   call cyclic_cell_intpx(levs,lons_lat,lonfull,vvlon(1,1,lan))
            1369     1               
            1370     1               !        if( lprint ) then
            1371     1               !        print *,' done cyclic_massadvx with mass= ',mass
            1372     1               !        print *,' ------------------------------------------- '
            1373     1               !        call mymaxmin(rrlon(1,ktt,lan),lonfull,lonfull,1,' advx t ')
            1374     1               !        call mymaxmin(rrlon(1,kqq,lan),lonfull,lonfull,1,' advx q ')
            1375     1               !        call mymaxmin(rrlon(1,kvv,lan),lonfull,lonfull,1,' advx z ')
            1376     1               !        call mymaxmin(rrlon(1,kuu,lan),lonfull,lonfull,1,' advx d ')
            1377     1               !        print *,' done the first x adv for lan=',lan
            1378     1               !        print *,' =========================================== '
            1379     1               !        endif
            1380     1               
            1381     1   p                 enddo
            1382                     !$omp end parallel do
            1383                     
            1384                     ! ---------------------------------------------------------------------
            1385                     ! mpi para from east-west full grid to north-south full grid

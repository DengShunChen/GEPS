 External subroutine subprogram "ndslfv_monoadvh2_fgnl"
  (inc)(line-no.)(nest)(optimize)
            1650                     ! ------------------------------
            1651                           subroutine ndslfv_monoadvh2_fgnl(vdzonl,vdmerd,ddtemp    &
            1652                                     , lonsperlat,deltim,levs,nvars,forward)
            1653                     !
            1654                     ! a routine to do non-iteration semi-Lagrangain advection
            1655                     ! considering advection  with monotonicity in interpolation
            1656                     ! contact: hann-ming henry juang
            1657                     ! program log
            1658                     ! 2011 02 20 : henry juang, created for ndsl advection
            1659                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            1660                     !
            1661                           use param
            1662                           use grid
            1663                           use index
            1664                           use const
            1665                           use rank
            1666                     
            1667                           implicit none
            1668                     
            1669                           integer nvars
            1670                           real(kind=RTYPE) ddtemp(nx,levs,my_max)
            1671                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            1672                           integer,intent(in):: lonsperlat(my)
            1673                           real(kind=RTYPE),   intent(in):: deltim
            1674                     
            1675                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            1676                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            1677                           real(kind=RTYPE)      qqlon(lonfull,levs*nvars,latpart)
            1678                           real(kind=RTYPE)      rrlon(lonfull,levs*nvars,latpart)
            1679                     
            1680                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            1681                           real(kind=RTYPE)      qqlat(latfull,levs*nvars,lonpart)
            1682                           real(kind=RTYPE)      rrlat(latfull,levs*nvars,lonpart)
            1683                           real(kind=RTYPE)      xr    (lonfull,levs)
            1684                           real(kind=RTYPE)      xcp   (lonfull,levs)
            1685                           real(kind=RTYPE)      sumrq (lonfull,levs)
            1686                           real(kind=RTYPE)      xkappa(lonfull,levs)
            1687                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            1688                     
            1689                     !      logical   lprint
            1690                     
            1691                           integer mono,mass,levs
            1692                           integer nlevs!,levh
            1693                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            1694                           integer kuu, kvv, ktt, kup, nqq
            1695                           integer ku , kv , kt,  kp
            1696                           logical forward
            1697                     !
            1698                     !      lprint = .false.
            1699                     
            1700                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            1701                     !
            1702                           mono  = 1
            1703                           mass  = 0
            1704                           cons0 = 0.0
            1705                           cons1 = 1.0
            1706                     !
            1707                     !      levh = ncld * lev
            1708                     !
            1709                     !      kuu = 1
            1710                     !      kvv = kuu + lev
            1711                     !      kuu = kvv + lev
            1712                           kuu = 1
            1713                           kvv = kuu + levs
            1714                           ktt = kvv + levs
            1715                           kup = ktt + levs
            1716                     
            1717                     !      nvars = 3
            1718                           nlevs = nvars * levs
            1719                     !
            1720                           rdt2 = 0.5 / deltim
            1721                     !
            1722                     ! =================================================================
            1723                     !   prepare wind and variable in flux form with gaussina weight
            1724                     ! =================================================================
            1725                     !
            1726                     
            1727                     !$omp parallel do                                                      &
            1728                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kv,ku,kt) &
            1729                     !$omp schedule(dynamic)
            1730     1   p                 do lan=1,jlistnum
            1731     1               
            1732     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            1733     1   p                   lat = jlist1(lan)
            1734     1   p                   lons_lat = lonsperlat(lat)
            1735     1               !        rma  = 1. / cosglat(lat) / con_rerth
            1736     1               !        rm2a = rma / cosglat(lat)
            1737     1   p                   rma  = 1. / cosl(lat)
            1738     1   p                   rm2a = rma / cosl(lat)
            1739     1               !
            1740     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            1741     2   p                   do k=1,levs
            1742     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            1743     3   p   2v                do i=1,lons_lat
            1744     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            1745     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            1746     3               !hmhj use real(kind=RTYPE) wind
            1747     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            1748     3               !hmhj use virtual wind
            1749     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            1750     3               !for CWB GFS
            1751     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            1752     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            1753     3   p   2v                enddo
            1754     2   p                   enddo
            1755     1               !        if( lprint ) then
            1756     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            1757     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            1758     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            1759     1               !        endif
            1760     1               !
            1761     1               ! u v t at n-1
            1762     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            1763     2   p                   do k=1,levs
            1764     2   p                     ku=kuu+k-1
            1765     2   p                     kv=kvv+k-1
            1766     2   p                     kt=ktt+k-1
            1767     2   p                     kk=levs-k+1
            1768     2               !ch>
            1769     2               !       KL=lev-Llist(k)+1
            1770     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            1771     3   p    v                do i=1,lons_lat
            1772     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            1773     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            1774     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            1775     3               !!            qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            1776     3               
            1777     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            1778     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            1779     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,k,lan)
            1780     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            1781     3   p    v                enddo
            1782     2   p                   enddo
            1783     1               ! add surface pressure perturbation for removing resonance
            1784     1               !       rkt = con_g / ( con_rd * 300.0 )
            1785     1               !       do i=1,lons_lat
            1786     1               !         ilan=i+jlonf
            1787     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
            1788     1               !       enddo
            1789     1               !
            1790     1               ! save qqlon into n+1 for later as tendency
            1791     1               ! z d t at n+1
            1792     1               !        do k=1,lev
            1793     1               !          kk=lev-k+1
            1794     1               !          ku=kuu+k-1
            1795     1               !          kv=kvv+k-1
            1796     1               !          kt=ktt+k-1
            1797     1               !          kug=g_d+k-1
            1798     1               !          kvg=g_z+k-1
            1799     1               !          ktg=g_t+k-1
            1800     1               !          do i=1,lons_lat
            1801     1               !            ilan=i+jlonf
            1802     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
            1803     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
            1804     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
            1805     1               !          enddo
            1806     1               !        enddo
            1807     1               ! change h to theta
            1808     1               !
            1809     1               ! ----- prepare xr, xcp, xkapa
            1810     1               !
            1811     1               !       xr    = cons0
            1812     1               !       xcp   = cons0
            1813     1               !       sumrq = cons0
            1814     1               !
            1815     1               !       do n=1,ntrac
            1816     1               !         nqq = kqq + (n-1)*levs
            1817     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
            1818     1               !           do k=1,lev
            1819     1               !             kq=nqq+k-1
            1820     1               !             do i=1,lons_lat
            1821     1               !               xr   (i,k) = xr   (i,k) + qqlon(i,kq,lan)*ri(n)
            1822     1               !               xcp  (i,k) = xcp  (i,k) + qqlon(i,kq,lan)*cpi(n)
            1823     1               !               sumrq(i,k) = sumrq(i,k) + qqlon(i,kq,lan)
            1824     1               !             enddo
            1825     1               !           enddo
            1826     1               !         endif
            1827     1               !       enddo
            1828     1               !       do k=1,lev
            1829     1               !         do i=1,lons_lat
            1830     1               !           xr (i,k)   = ( cons1 - sumrq(i,k) )*ri(0)  + xr (i,k)
            1831     1               !           xcp(i,k)   = ( cons1 - sumrq(i,k) )*cpi(0) + xcp(i,k)
            1832     1               !           xkappa(i,k) = xr(i,k) / xcp(i,k)
            1833     1               !         enddo
            1834     1               !       enddo
            1835     1               !
            1836     1               !       do k=1,lev
            1837     1               !         kt=ktt+k-1
            1838     1               !         ku=kuu+k-1
            1839     1               !         do i=1,lons_lat
            1840     1               !           pi = (qqlon(i,ku,lan)*0.005)**xkappa(i,k)

 External subroutine subprogram "ndslfv_monoadvh2_fgnl_xy"
  (inc)(line-no.)(nest)(optimize)
            2156                     ! ------------------------------
            2157                           subroutine ndslfv_monoadvh2_fgnl_xy(vdzonl,vdmerd,ddtemp    &
            2158                                     , lonsperlat,deltim,levs,nvars,forward)
            2159                     !
            2160                     ! a routine to do non-iteration semi-Lagrangain advection
            2161                     ! considering advection  with monotonicity in interpolation
            2162                     ! contact: hann-ming henry juang
            2163                     ! program log
            2164                     ! 2011 02 20 : henry juang, created for ndsl advection
            2165                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            2166                     !
            2167                           use param
            2168                           use grid
            2169                           use index
            2170                           use const
            2171                           use rank
            2172                     
            2173                           implicit none
            2174                     
            2175                           integer nvars
            2176                           real(kind=RTYPE) ddtemp(nx,levs,my_max)
            2177                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            2178                           integer,intent(in):: lonsperlat(my)
            2179                           real(kind=RTYPE),   intent(in):: deltim
            2180                     
            2181                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            2182                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            2183                           real(kind=RTYPE)      qqlon(lonfull,levs*nvars,latpart)
            2184                     !      real(kind=RTYPE)      rrlon(lonfull,levs*nvars,latpart)
            2185                     
            2186                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            2187                           real(kind=RTYPE)      qqlat(latfull,levs*nvars,lonpart)
            2188                     !      real(kind=RTYPE)      rrlat(latfull,levs*nvars,lonpart)
            2189                           real(kind=RTYPE)      xr    (lonfull,levs)
            2190                           real(kind=RTYPE)      xcp   (lonfull,levs)
            2191                           real(kind=RTYPE)      sumrq (lonfull,levs)
            2192                           real(kind=RTYPE)      xkappa(lonfull,levs)
            2193                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            2194                     
            2195                     !      logical   lprint
            2196                     
            2197                           integer mono,mass,levs
            2198                           integer nlevs!,levh
            2199                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            2200                           integer kuu, kvv, ktt, kup, nqq
            2201                           integer ku , kv , kt,  kp
            2202                           logical forward
            2203                     !
            2204                     !      lprint = .false.
            2205                     
            2206                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            2207                     !
            2208                           mono  = 1
            2209                           mass  = 0
            2210                           cons0 = 0.0
            2211                           cons1 = 1.0
            2212                     !
            2213                     !      levh = ncld * lev
            2214                     !
            2215                     !      kuu = 1
            2216                     !      kvv = kuu + lev
            2217                     !      kuu = kvv + lev
            2218                           kuu = 1
            2219                           kvv = kuu + levs
            2220                           ktt = kvv + levs
            2221                           kup = ktt + levs
            2222                     
            2223                     !      nvars = 3
            2224                           nlevs = nvars * levs
            2225                     !
            2226                           rdt2 = 0.5 / deltim
            2227                     !
            2228                     ! =================================================================
            2229                     !   prepare wind and variable in flux form with gaussina weight
            2230                     ! =================================================================
            2231                     !
            2232                     
            2233                     !$omp parallel do                                                      &
            2234                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kv,ku,kt) &
            2235                     !$omp schedule(dynamic)
            2236     1   p                 do lan=1,jlistnum
            2237     1               
            2238     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            2239     1   p                   lat = jlist1(lan)
            2240     1   p                   lons_lat = lonsperlat(lat)
            2241     1               !        rma  = 1. / cosglat(lat) / con_rerth
            2242     1               !        rm2a = rma / cosglat(lat)
            2243     1   p                   rma  = 1. / cosl(lat)
            2244     1   p                   rm2a = rma / cosl(lat)
            2245     1               !
            2246     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            2247     2   p                   do k=1,levs
            2248     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            2249     3   p   2v                do i=1,lons_lat
            2250     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            2251     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            2252     3               !hmhj use real(kind=RTYPE) wind
            2253     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            2254     3               !hmhj use virtual wind
            2255     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            2256     3               !for CWB GFS
            2257     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            2258     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            2259     3   p   2v                enddo
            2260     2   p                   enddo
            2261     1               !        if( lprint ) then
            2262     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            2263     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            2264     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            2265     1               !        endif
            2266     1               !
            2267     1               ! u v t at n-1
            2268     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            2269     2   p                   do k=1,levs
            2270     2   p                     ku=kuu+k-1
            2271     2   p                     kv=kvv+k-1
            2272     2   p                     kt=ktt+k-1
            2273     2   p                     kk=levs-k+1
            2274     2               !ch>
            2275     2               !       KL=lev-Llist(k)+1
            2276     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            2277     3   p    v                do i=1,lons_lat
            2278     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            2279     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            2280     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            2281     3               !!            qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            2282     3               
            2283     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            2284     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            2285     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,k,lan)
            2286     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            2287     3   p    v                enddo
            2288     2   p                   enddo

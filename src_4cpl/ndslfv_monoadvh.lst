 External subroutine subprogram "ndslfv_monoadvh2_fgnl_yx"
  (inc)(line-no.)(nest)(optimize)
            2662                     ! ------------------------------
            2663                           subroutine ndslfv_monoadvh2_fgnl_yx(vdzonl,vdmerd,ddtemp    &
            2664                                     , lonsperlat,deltim,levs,nvars,forward)
            2665                     !
            2666                     ! a routine to do non-iteration semi-Lagrangain advection
            2667                     ! considering advection  with monotonicity in interpolation
            2668                     ! contact: hann-ming henry juang
            2669                     ! program log
            2670                     ! 2011 02 20 : henry juang, created for ndsl advection
            2671                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            2672                     !
            2673                           use param
            2674                           use grid
            2675                           use index
            2676                           use const
            2677                           use rank
            2678                     
            2679                           implicit none
            2680                     
            2681                           integer nvars
            2682                           real(kind=RTYPE) ddtemp(nx,levs,my_max)
            2683                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            2684                           integer,intent(in):: lonsperlat(my)
            2685                           real(kind=RTYPE),   intent(in):: deltim
            2686                     
            2687                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            2688                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            2689                           real(kind=RTYPE)      qqlon(lonfull,levs*nvars,latpart)
            2690                     !      real(kind=RTYPE)      rrlon(lonfull,levs*nvars,latpart)
            2691                     
            2692                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            2693                           real(kind=RTYPE)      qqlat(latfull,levs*nvars,lonpart)
            2694                     !      real(kind=RTYPE)      rrlat(latfull,levs*nvars,lonpart)
            2695                           real(kind=RTYPE)      xr    (lonfull,levs)
            2696                           real(kind=RTYPE)      xcp   (lonfull,levs)
            2697                           real(kind=RTYPE)      sumrq (lonfull,levs)
            2698                           real(kind=RTYPE)      xkappa(lonfull,levs)
            2699                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            2700                     
            2701                     !      logical   lprint
            2702                     
            2703                           integer mono,mass,levs
            2704                           integer nlevs!,levh
            2705                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            2706                           integer kuu, kvv, ktt, kup, nqq
            2707                           integer ku , kv , kt,  kp
            2708                           logical forward
            2709                     !
            2710                     !      lprint = .false.
            2711                     
            2712                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            2713                     !
            2714                           mono  = 1
            2715                           mass  = 0
            2716                           cons0 = 0.0
            2717                           cons1 = 1.0
            2718                     !
            2719                     !      levh = ncld * lev
            2720                     !
            2721                     !      kuu = 1
            2722                     !      kvv = kuu + lev
            2723                     !      kuu = kvv + lev
            2724                           kuu = 1
            2725                           kvv = kuu + levs
            2726                           ktt = kvv + levs
            2727                           kup = ktt + levs
            2728                     
            2729                     !      nvars = 3
            2730                           nlevs = nvars * levs
            2731                     !
            2732                           rdt2 = 0.5 / deltim
            2733                     !
            2734                     ! =================================================================
            2735                     !   prepare wind and variable in flux form with gaussina weight
            2736                     ! =================================================================
            2737                     !
            2738                     
            2739                     !$omp parallel do                                                      &
            2740                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kv,ku,kt) &
            2741                     !$omp schedule(dynamic)
            2742     1   p                 do lan=1,jlistnum
            2743     1               
            2744     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            2745     1   p                   lat = jlist1(lan)
            2746     1   p                   lons_lat = lonsperlat(lat)
            2747     1               !        rma  = 1. / cosglat(lat) / con_rerth
            2748     1               !        rm2a = rma / cosglat(lat)
            2749     1   p                   rma  = 1. / cosl(lat)
            2750     1   p                   rm2a = rma / cosl(lat)
            2751     1               !
            2752     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            2753     2   p                   do k=1,levs
            2754     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            2755     3   p   2v                do i=1,lons_lat
            2756     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            2757     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            2758     3               !hmhj use real(kind=RTYPE) wind
            2759     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            2760     3               !hmhj use virtual wind
            2761     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            2762     3               !for CWB GFS
            2763     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            2764     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            2765     3   p   2v                enddo
            2766     2   p                   enddo
            2767     1               !        if( lprint ) then
            2768     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            2769     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            2770     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')

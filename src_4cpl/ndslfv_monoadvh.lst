 External subroutine subprogram "ndslfv_monoadvh2"
  (inc)(line-no.)(nest)(optimize)
              44                     !
              45                           subroutine ndslfv_monoadvh2(ddtemp,qvadv,pten,vdzonl,vdmerd    &
              46                                     , lonsperlat,deltim,levs)
              47                     !
              48                     ! a routine to do non-iteration semi-Lagrangain advection
              49                     ! considering advection  with monotonicity in interpolation
              50                     ! contact: hann-ming henry juang
              51                     ! program log
              52                     ! 2011 02 20 : henry juang, created for ndsl advection
              53                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
              54                     !
              55                           use param
              56                           use grid
              57                           use index
              58                           use const
              59                           use rank
              60                     
              61                           implicit none
              62                     
              63                           real(kind=RTYPE) pten(nx,levs,my_max)
              64                           real(kind=RTYPE) ddtemp(nx,levs,my_max),qvadv(nx,levs,ncld,my_max)
              65                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
              66                     !      real(kind=RTYPE) plev(lonfull,lev+1)
              67                     !      integer,intent(in):: global_lats_a(my)
              68                           integer,intent(in):: lonsperlat(my)
              69                           real(kind=RTYPE),   intent(in):: deltim
              70                     
              71                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
              72                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
              73                           real(kind=RTYPE)      qqlon(lonfull,levs*ndslhvar,latpart)
              74                           real(kind=RTYPE)      rrlon(lonfull,levs*ndslhvar,latpart)
              75                     
              76                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
              77                           real(kind=RTYPE)      qqlat(latfull,levs*ndslhvar,lonpart)
              78                           real(kind=RTYPE)      rrlat(latfull,levs*ndslhvar,lonpart)
              79                           real(kind=RTYPE)      xr    (lonfull,levs)
              80                           real(kind=RTYPE)      xcp   (lonfull,levs)
              81                           real(kind=RTYPE)      sumrq (lonfull,levs)
              82                           real(kind=RTYPE)      xkappa(lonfull,levs)
              83                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
              84                     
              85                     !      logical   lprint
              86                     
              87                           integer mono,mass,levs
              88                           integer nlevs,nvars!,levh
              89                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
              90                           integer kuu, kvv, kqq, ktt, kup, nqq
              91                           integer ku , kv , kq , kt , kp
              92                     !
              93                     !      lprint = .false.
              94                     
              95                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
              96                     !
              97                           mono  = 1
              98                           mass  = 0
              99                           cons0 = 0.0
             100                           cons1 = 1.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rrlon, qqlon
                                   <<< Loop-information  End >>>
             101        pp   2v            qqlon = 0.
             102         p   2v            rrlon = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vvlon, uulon
                                   <<< Loop-information  End >>>
             103        pp   2v            uulon = 0.
             104         p   2v            vvlon = 0.
             105                     !
             106                     !      levh = ncld * lev
             107                     !
             108                     !      kuu = 1
             109                     !      kvv = kuu + lev
             110                     !      kuu = kvv + lev
             111                           kuu = 1
             112                           kvv = kuu + levs
             113                           ktt = kvv + levs
             114                           kup = ktt + levs
             115                     !!      kqq = kup + levs
             116                           kqq = ktt + levs
             117                     
             118                           nvars = ndslhvar
             119                           nlevs = nvars * levs
             120                     !
             121                           rdt2 = 0.5 / deltim
             122                     !
             123                     ! =================================================================
             124                     !   prepare wind and variable in flux form with gaussina weight
             125                     ! =================================================================
             126                     !
             127                     
             128                     !$omp parallel do                                                      &
             129                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kt,kv,ku,kp,kq) &
             130                     !$omp schedule(dynamic)
             131     1   p                 do lan=1,jlistnum
             132     1               
             133     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
             134     1   p                   lat = jlist1(lan)
             135     1   p                   lons_lat = lonsperlat(lat)
             136     1               !        rma  = 1. / cosglat(lat) / con_rerth
             137     1               !        rm2a = rma / cosglat(lat)
             138     1   p                   rma  = 1. / cosl(lat)
             139     1   p                   rm2a = rma / cosl(lat)
             140     1               !
             141     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
             142     2   p                   do k=1,levs
             143     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
             144     3   p   2v                do i=1,lons_lat
             145     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
             146     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
             147     3               !hmhj use real(kind=RTYPE) wind

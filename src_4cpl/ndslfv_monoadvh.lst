             586                     !
             587                     ! a routine to do non-iteration semi-Lagrangain advection
             588                     ! considering advection  with monotonicity in interpolation
             589                     ! contact: hann-ming henry juang
             590                     ! program log
             591                     ! 2011 02 20 : henry juang, created for ndsl advection
             592                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
             593                     !
             594                           use param
             595                           use grid
             596                           use index
             597                           use const
             598                           use rank
             599                     
             600                           implicit none
             601                     
             602                           real(kind=RTYPE) pten(nx,levs,my_max)
             603                           real(kind=RTYPE) ddtemp(nx,levs,my_max),qvadv(nx,levs,ncld,my_max)
             604                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
             605                     !      real(kind=RTYPE) plev(lonfull,lev+1)
             606                     !      integer,intent(in):: global_lats_a(my)
             607                           integer,intent(in):: lonsperlat(my)
             608                           real(kind=RTYPE),   intent(in):: deltim
             609                     
             610                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
             611                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
             612                           real(kind=RTYPE)      qqlon(lonfull,levs*ndslhvar,latpart)
             613                     !      real(kind=RTYPE)      rrlon(lonfull,lev*ndslhvar,latpart)
             614                     
             615                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
             616                           real(kind=RTYPE)      qqlat(latfull,levs*ndslhvar,lonpart)
             617                     !      real(kind=RTYPE)      rrlat(latfull,levs*ndslhvar,lonpart)
             618                           real(kind=RTYPE)      xr    (lonfull,levs)
             619                           real(kind=RTYPE)      xcp   (lonfull,levs)
             620                           real(kind=RTYPE)      sumrq (lonfull,levs)
             621                           real(kind=RTYPE)      xkappa(lonfull,levs)
             622                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
             623                     
             624                     !      logical   lprint
             625                     
             626                           integer mono,mass,levs
             627                           integer nlevs,nvars!,levh
             628                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
             629                           integer kuu, kvv, kqq, ktt, kup, nqq
             630                           integer ku , kv , kq , kt , kp
             631                     !
             632                     !      lprint = .false.
             633                     
             634                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
             635                     !
             636                           mono  = 1
             637                           mass  = 0
             638                           cons0 = 0.0
             639                           cons1 = 1.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon
                                   <<< Loop-information  End >>>
             640        pp   4v            qqlon = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vvlon, uulon
                                   <<< Loop-information  End >>>
             641        pp   2v            uulon = 0.
             642         p   2v            vvlon = 0.
             643                     !
             644                     !      levh = ncld * lev
             645                     !
             646                     !      kuu = 1
             647                     !      kvv = kuu + lev
             648                     !      kuu = kvv + lev
             649                           kuu = 1
             650                           kvv = kuu + levs
             651                           ktt = kvv + levs
             652                           kup = ktt + levs
             653                     !!      kqq = kup + levs
             654                           kqq = ktt + levs
             655                     
             656                           nvars = ndslhvar
             657                           nlevs = nvars * levs
             658                     !
             659                           rdt2 = 0.5 / deltim
             660                     !
             661                     ! =================================================================
             662                     !   prepare wind and variable in flux form with gaussina weight
             663                     ! =================================================================
             664                     !
             665                     
             666                     !$omp parallel do                                                      &
             667                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kt,kv,ku,kp,kq) &
             668                     !$omp schedule(dynamic)
             669     1   p                 do lan=1,jlistnum
             670     1               
             671     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
             672     1   p                   lat = jlist1(lan)
             673     1   p                   lons_lat = lonsperlat(lat)
             674     1               !        rma  = 1. / cosglat(lat) / con_rerth
             675     1               !        rm2a = rma / cosglat(lat)
             676     1   p                   rma  = 1. / cosl(lat)
             677     1   p                   rm2a = rma / cosl(lat)
             678     1               !
             679     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
             680     2   p                   do k=1,levs
             681     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
             682     3   p   2v                do i=1,lons_lat
             683     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
             684     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
             685     3               !hmhj use real(kind=RTYPE) wind
             686     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
             687     3               !hmhj use virtual wind
             688     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
             689     3               !for CWB GFS
             690     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
             691     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
             692     3   p   2v                enddo
             693     2   p                   enddo
             694     1               !        if( lprint ) then
             695     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
             696     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
             697     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
             698     1               !        endif
             699     1               !
             700     1               ! u v t at n-1
             701     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
             702     2   p                   do k=1,levs
             703     2   p                     ku=kuu+k-1
             704     2   p                     kv=kvv+k-1
             705     2   p                     kt=ktt+k-1
             706     2   p                     kp=kup+k-1
             707     2   p                     kk=levs-k+1
             708     2               !ch>
             709     2               !       KL=lev-Llist(k)+1
             710     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
             711     3   p    v                do i=1,lons_lat
             712     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
             713     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
             714     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
             715     3               !!          qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
             716     3               
             717     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
             718     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
             719     3   p    v                  qqlon(i,kt,lan) = ddtemp(i,k,lan)
             720     3               !!            qqlon(i,kp,lan) = pten(i,k,lan)
             721     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
             722     3   p    v                enddo
             723     2   p                   enddo
             724     1               ! rq at n-1
             725     2   p                   do n=1,ncld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvadv, qqlon
                                   <<< Loop-information  End >>>
             726     3   p                   do k=1,levs
             727     3   p                     kq=kqq+k-1+(n-1)*levs
             728     3   p                     kk=levs-k+1+(n-1)*levs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvadv, qqlon
                                   <<< Loop-information  End >>>
             729     4   p   2v                do i=1,lons_lat
             730     4               !ch         qqlon(i,kq,lan) = qm(i,kk,lan)
             731     4   p   2v                  qqlon(i,kq,lan) = qvadv(i,k,n,lan)
             732     4   p   2v                enddo
             733     3   p                   enddo
             734     2   p                   enddo
             735     1               ! add surface pressure perturbation for removing resonance
             736     1               !       rkt = con_g / ( con_rd * 300.0 )
             737     1               !       do i=1,lons_lat
             738     1               !         ilan=i+jlonf
             739     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
             740     1               !       enddo
             741     1               !
             742     1               ! save qqlon into n+1 for later as tendency
             743     1               ! z d t at n+1
             744     1               !        do k=1,lev
             745     1               !          kk=lev-k+1
             746     1               !          ku=kuu+k-1
             747     1               !          kv=kvv+k-1
             748     1               !          kt=ktt+k-1
             749     1               !          kug=g_d+k-1
             750     1               !          kvg=g_z+k-1
             751     1               !          ktg=g_t+k-1
             752     1               !          do i=1,lons_lat
             753     1               !            ilan=i+jlonf
             754     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
             755     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
             756     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
             757     1               !          enddo
             758     1               !        enddo
             759     1               ! change h to theta
             760     1               !
             761     1               ! ----- prepare xr, xcp, xkapa
             762     1               !
             763     1               !       xr    = cons0
             764     1               !       xcp   = cons0
             765     1               !       sumrq = cons0
             766     1               !
             767     1               !       do n=1,ntrac
             768     1               !         nqq = kqq + (n-1)*levs
             769     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
             770     1               !           do k=1,lev
             771     1               !             kq=nqq+k-1
             772     1               !             do i=1,lons_lat
             773     1               !               xr   (i,k) = xr   (i,k) + qqlon(i,kq,lan)*ri(n)
             774     1               !               xcp  (i,k) = xcp  (i,k) + qqlon(i,kq,lan)*cpi(n)
             775     1               !               sumrq(i,k) = sumrq(i,k) + qqlon(i,kq,lan)
             776     1               !             enddo
             777     1               !           enddo
             778     1               !         endif
             779     1               !       enddo
             780     1               !       do k=1,lev
             781     1               !         do i=1,lons_lat
             782     1               !           xr (i,k)   = ( cons1 - sumrq(i,k) )*ri(0)  + xr (i,k)
             783     1               !           xcp(i,k)   = ( cons1 - sumrq(i,k) )*cpi(0) + xcp(i,k)
             784     1               !           xkappa(i,k) = xr(i,k) / xcp(i,k)
             785     1               !         enddo
             786     1               !       enddo
             787     1               !
             788     1               !       do k=1,lev
             789     1               !         kt=ktt+k-1
             790     1               !         ku=kuu+k-1
             791     1               !         do i=1,lons_lat
             792     1               !           pi = (qqlon(i,ku,lan)*0.005)**xkappa(i,k)
             793     1               !           qqlon(i,kt,lan) = qqlon(i,kt,lan)/pi
             794     1               !         enddo
             795     1               !       enddo
             796     1               !
             797     1               ! rq  no need for tendency
             798     1               !
             799     1               !        if( lprint ) then
             800     1               !        print *,' ------------------------------------------- '
             801     1               !        ilan=1+jlonf
             802     1               !        call mymaxmin(grid_gr(ilan,g_ttm),lons_lat,lonfull,1,' n-1 t ')
             803     1               !        call mymaxmin(grid_gr(ilan,g_rrm ),lons_lat,lonfull,1,' n-1 q ')
             804     1               !        call mymaxmin(grid_gr(ilan,g_zem),lons_lat,lonfull,1,' n-1 z ')
             805     1               !        call mymaxmin(grid_gr(ilan,g_dim),lons_lat,lonfull,1,' n-1 d ')
             806     1               !        print *,' ------------------------------------------- '
             807     1               !        call mymaxmin(qqlon(1,ktt,lan),lons_lat,lonfull,1,' red t ')
             808     1               !        call mymaxmin(qqlon(1,kqq,lan),lons_lat,lonfull,1,' red q ')
             809     1               !        call mymaxmin(qqlon(1,kvv,lan),lons_lat,lonfull,1,' red z ')
             810     1               !        call mymaxmin(qqlon(1,kuu,lan),lons_lat,lonfull,1,' red d ')
             811     1               !        endif
             812     1               
             813     1               !       call cyclic_cell_intpx(levs,lons_lat,lonf,uulon(1,1,lan))
             814     1               
             815     1               !        if( lprint ) then
             816     1               !        print *,' ------------------------------------------- '
             817     1               !        call mymaxmin(qqlon(1,ktt,lan),lonfull,lonfull,1,' full t ')
             818     1               !        call mymaxmin(qqlon(1,kqq,lan),lonfull,lonfull,1,' full q ')
             819     1               !        call mymaxmin(qqlon(1,kvv,lan),lonfull,lonfull,1,' full z ')
             820     1               !        call mymaxmin(qqlon(1,kuu,lan),lonfull,lonfull,1,' full d ')
             821     1               !        endif
             822     1               
             823     1               !!        rrlon(:,:,lan) = qqlon(:,:,lan)
             824     1               !
             825     1               ! first set positive advection in east-west direction
             826     1               !
             827     1   p                   call cyclic_cell_massadvx(lons_lat,lonfull,levs,nvars,deltim,   &
             828     1                                        uulon(1,1,lan),qqlon(1,1,lan),mass)
             829     1               !       call cyclic_mono_advectx (lonfull,levs,nvars,deltim,               &
             830     1               !    &                   uulon(1,1,lan),rrlon(1,1,lan),mono)
             831     1               
             832     1               !!        call cyclic_cell_intpx(nlevs,lons_lat,lonfull,rrlon(1,1,lan))
             833     1   p                   call cyclic_cell_intpx(nlevs,lons_lat,lonfull,qqlon(1,1,lan))
             834     1   p                   call cyclic_cell_intpx(levs,lons_lat,lonfull,vvlon(1,1,lan))
             835     1               
             836     1               !        if( lprint ) then
             837     1               !        print *,' done cyclic_massadvx with mass= ',mass
             838     1               !        print *,' ------------------------------------------- '
             839     1               !        call mymaxmin(rrlon(1,ktt,lan),lonfull,lonfull,1,' advx t ')
             840     1               !        call mymaxmin(rrlon(1,kqq,lan),lonfull,lonfull,1,' advx q ')
             841     1               !        call mymaxmin(rrlon(1,kvv,lan),lonfull,lonfull,1,' advx z ')
             842     1               !        call mymaxmin(rrlon(1,kuu,lan),lonfull,lonfull,1,' advx d ')
             843     1               !        print *,' done the first x adv for lan=',lan
             844     1               !        print *,' =========================================== '
             845     1               !        endif
             846     1               
             847     1   p                 enddo
             848                     !$omp end parallel do
             849                     
             850                     ! ---------------------------------------------------------------------
             851                     ! mpi para from east-west full grid to north-south full grid
             852                     ! ---------------------------------------------------------------------
             853                     !
             854                     ! para vvlon, qqlon, and rrlon to vvlat, qqlat, rrlat
             855                     !       if( lprint ) print *,' ndslfv_advect transport from we to ns '
             856                     
             857                            call para_we2ns(vvlon,vvlat,levs,my)
             858                     !!       call para_we2ns(rrlon,rrlat,nlevs,my)
             859                            call para_we2ns(qqlon,qqlat,nlevs,my)
             860                     
             861                     !       if( lprint ) then
             862                     !       print *,' ------------ after we2ns ---------------------- '
             863                     !       do lon=1,mylonlen
             864                     !        print *,'  lon=',lon
             865                     !        call mymaxmin(vvlat(1,1  ,lon),latfull,latfull,1,' we2ns v')
             866                     !        call mymaxmin(rrlat(1,kqq,lon),latfull,latfull,1,' we2ns r')
             867                     !        call mymaxmin(qqlat(1,kqq,lon),latfull,latfull,1,' we2ns q')
             868                     !       enddo
             869                     !       endif
             870                     !
             871                     ! ---------------------------------------------------------------------
             872                     ! -------------- in north-soutn great circle -------------------
             873                     ! ---------------------------------------------------------------------
             874                     
             875                     !      if ( myrank .eq. 0 ) lprint = .true.
             876                     !       if( lprint ) then
             877                     !       print *,' ndslfv_advect adv loop in y '
             878                     !       print *,' mylonlen=',mylonlen
             879                     !       endif
             880                     
             881                     !$omp parallel do private(lon,k,j,ku,kv) &
             882                     !$omp schedule(dynamic)
             883     1   p                  do lon=1,mylonlen
             884     1               !
             885     1               !        if( lprint ) print *,' lon=',lon
             886     1               ! convert wind before advy
             887     2   p                   do k=1,levs
             888     2   p                     ku=kuu+k-1
             889     2   p                     kv=kvv+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlat
                                   <<< Loop-information  End >>>
             890     3   p   2v                do j=1,lathalf
             891     3   p   2v                  qqlat(j,ku,lon) = -qqlat(j,ku,lon)
             892     3   p   2v                  qqlat(j,kv,lon) = -qqlat(j,kv,lon)
             893     3   p   2v                enddo
             894     2   p                   enddo
             895     1               ! first set advection in north-south direction in great circle through two poles
             896     1               !
             897     1               !!        call fixend_cell_massadvy(latfull,lathalf,lev,nvars,deltim, &
             898     1               !!                         vvlat(1,1,lon),rrlat(1,1,lon),mass)
             899     1               !       call cyclic_cell_massadvy(latfull,levs,nvars,deltim,
             900     1               !    &                   vvlat(1,1,lon),rrlat(1,1,lon),mass)
             901     1               !       call cyclic_mono_advecty (latfull,levs,nvars,deltim,
             902     1               !    &                   vvlat(1,1,lon),rrlat(1,1,lon),mono)
             903     1               
             904     1               !        if( lprint ) then
             905     1               !        print *,' ------------------------------------------- '
             906     1               !        call mymaxmin(rrlat(1,kuu,lon),latfull,latfull,1,' advry u ')
             907     1               !        call mymaxmin(rrlat(1,kvv,lon),latfull,latfull,1,' advry v ')
             908     1               !        call mymaxmin(rrlat(1,ktt,lon),latfull,latfull,1,' advry t ')
             909     1               !        call mymaxmin(rrlat(1,kqq,lon),latfull,latfull,1,' advry q ')
             910     1               !        call mymaxmin(rrlat(1,kvv,lon),latfull,latfull,1,' advry z ')
             911     1               !        call mymaxmin(rrlat(1,kuu,lon),latfull,latfull,1,' advry d ')
             912     1               !        endif
             913     1               !
             914     1               ! second set advection in north-south direction in great circle through two poles
             915     1               !
             916     1               !        call fixend_cell_massadvy(latfull,lathalf,levs,nvars,deltim, &
             917     1               !                         vvlat(1,1,lon),qqlat(1,1,lon),mass)
             918     1   p                   call cyclic_cell_massadvy(latfull,levs,nvars,deltim,          &
             919     1                                       vvlat(1,1,lon),qqlat(1,1,lon),mass)
             920     1               !       call cyclic_mono_advecty (my,levs,nvars,deltim,
             921     1               !    &                   vvlat(1,1,lon),qqlat(1,1,lon),mono)
             922     1               
             923     1               !        if( lprint ) then
             924     1               !        print *,' ------------------------------------------- '
             925     1               !        call mymaxmin(qqlat(1,kuu,lon),latfull,latfull,1,' advqy u ')
             926     1               !        call mymaxmin(qqlat(1,kvv,lon),latfull,latfull,1,' advqy v ')
             927     1               !        call mymaxmin(qqlat(1,ktt,lon),latfull,latfull,1,' advqy t ')
             928     1               !        call mymaxmin(qqlat(1,kqq,lon),latfull,latfull,1,' advqy q ')
             929     1               !        call mymaxmin(qqlat(1,kvv,lon),latfull,latfull,1,' advqy z ')
             930     1               !        call mymaxmin(qqlat(1,kuu,lon),latfull,latfull,1,' advqy d ')
             931     1               !        print *,' done with y at lon=',lon
             932     1               !        endif
             933     1               
             934     1               ! convert wind back after advy
             935     2   p                   do k=1,levs
             936     2   p                     ku=kuu+k-1
             937     2   p                     kv=kvv+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlat

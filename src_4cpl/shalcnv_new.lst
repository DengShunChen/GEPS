                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vo, ktcon, vshear, cnvflg, uo, kb
                                   <<< Loop-information  End >>>
             883     2  pp    v              do i = 1, im
             884     3   p    v                if (cnvflg(i)) then
             885     4   p    v                  if(k.gt.kb(i).and.k.le.ktcon(i)) then
             886     4   p    v                    shear= sqrt((uo(i,k)-uo(i,k-1)) ** 2  &
             887     4                                       + (vo(i,k)-vo(i,k-1)) ** 2)
             888     4   p    v                    vshear(i) = vshear(i) + shear
             889     4   p    v                  endif
             890     3   p    v                endif
             891     2   p    v              enddo
             892     1                     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

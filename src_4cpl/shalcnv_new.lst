                                   <<< Loop-information  End >>>
             857     2  pp    v            do i = 1, im
             858     3   p    v              if(cnvflg(i)) then
             859     3   p    v                k = ktcon(i) - 1
             860     3   p    v                gamma = el2orc * qeso(i,k) / (to(i,k)**2)
             861     3   p    v                qrch = qeso(i,k) &

             802                     !
             803                     !  compute cloud moisture property, detraining cloud water
             804                     !    and precipitation in overshooting layers
             805                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             806     1                     do k = 2, km1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 138
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 64, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, ktcon, ktcon1, qo, xlamue, zi
                                   <<<      xlamud, qcko, to, qeso, dbyo, eta
                                   <<<    PREFETCH(SOFT) : 24
                                   <<<     SEQUENTIAL : 24
                                   <<<      del: 2, dellal: 2, qcko: 10, pwo: 10
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             807     2  pp    v              do i = 1, im
             808     3   p    v                if (cnvflg(i)) then
             809     4   p    v                  if(k.ge.ktcon(i).and.k.lt.ktcon1(i)) then
             810     4   p    v                    dz    = zi(i,k) - zi(i,k-1)
             811     4   p    v                    gamma = el2orc * qeso(i,k) / (to(i,k)**2)
             812     4   p    v                    qrch = qeso(i,k) + gamma * dbyo(i,k) / (hvap * (1. + gamma))
             813     4               !j
             814     4   p    v                    tem  = 0.5 * (xlamue(i,k)+xlamue(i,k-1)) * dz
             815     4   p    v                    tem1 = 0.5 * xlamud(i) * dz
             816     4   p    v                    factor = 1. + tem - tem1
             817     4   p    v                    qcko(i,k) = ((1.-tem1)*qcko(i,k-1)+tem*0.5*  &
             818     4                                          (qo(i,k)+qo(i,k-1)))/factor
             819     4               !j
             820     4   p    v                    dq = eta(i,k) * (qcko(i,k) - qrch)
             821     4               !
             822     4               !  check if there is excess moisture to release latent heat
             823     4               !
             824     5   p    v                    if(dq.gt.0.) then
             825     5   p    v                      etah = .5 * (eta(i,k) + eta(i,k-1))
             826     6   p    v                      if(ncloud.gt.0.) then
             827     6   p    v                        dp = 1000. * del(i,k)
             828     6   p    v                        qlk = dq / (eta(i,k) + etah * (c0 + c1) * dz)
             829     6   p    v                        dellal(i,k) = etah * c1 * dz * qlk * g / dp
             830     6   p    v                      else
             831     6   p    v                        qlk = dq / (eta(i,k) + etah * c0 * dz)
             832     6   p    v                      endif
             833     5   p    v                      qcko(i,k) = qlk + qrch
             834     5   p    v                      pwo(i,k) = etah * c0 * dz * qlk
             835     5   p    v                    endif
             836     4   p    v                  endif
             837     3   p    v                endif
             838     2   p    v              enddo
             839     1                     enddo

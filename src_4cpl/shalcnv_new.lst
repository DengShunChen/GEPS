                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             893     1  pp    s            do i = 1, im
             894     2   p    m              if(cnvflg(i)) then
             895     2   p    s                vshear(i) = 1.e3 * vshear(i) / (zi(i,ktcon(i))-zi(i,kb(i)))
             896     2   p    s                e1=1.591-.639*vshear(i) &
             897     2                            +.0953*(vshear(i)**2)-.00496*(vshear(i)**3)
             898     2   p    s                edt(i)=1.-e1
             899     2   p    s                val =         .9
             900     2   p    s                edt(i) = min(edt(i),val)
             901     2   p    s                val =         .0
             902     2   p    s                edt(i) = max(edt(i),val)
             903     2   p    v              endif
             904     1   p    v            enddo
             905                     !
             906                     !--- what would the change be, that a cloud with unit mass
             907                     !--- will do to the environment?
             908                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3

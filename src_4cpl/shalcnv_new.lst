             737     2  pp    v              do i = 1, im
             738     3   p    v                if (cnvflg(i)) then
             739     4   p    v                  if(k.ge.kbcon(i).and.k.lt.ktcon(i)) then
             740     4   p    v                    dz1 = zo(i,k+1) - zo(i,k)
             741     4   p    v                    gamma = el2orc * qeso(i,k) / (to(i,k)**2)
             742     4   p    v                    rfact =  1. + delta * cp * gamma &

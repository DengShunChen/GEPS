                                   <<<      dellav
                                   <<< Loop-information  End >>>
             910     2   p    v              do i = 1, im
             911     3   p    v                if(cnvflg(i) .and. k .le. kmax(i)) then
             912     3   p    v                  dellah(i,k) = 0.
             913     3   p    v                  dellaq(i,k) = 0.
             914     3   p    v                  dellau(i,k) = 0.
             915     3   p    v                  dellav(i,k) = 0.
             916     3   p    v                endif
             917     2   p    v              enddo
             918     1   p                 enddo
             919                     !
             920                     !--- changed due to subsidence and entrainment
             921                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             922     1  pp                 do k = 2, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kb, ktcon, heo, eta, xlamue, zi
                                   <<<      hcko, xlamud, del, dellah
                                   <<<    PREFETCH(SOFT) : 30
                                   <<<     SEQUENTIAL : 30
                                   <<<      qcko: 4, qo: 4, dellaq: 2, ucko: 4
                                   <<<      uo: 4, dellau: 2, vcko: 4, vo: 4
                                   <<<      dellav: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             923     2   p    v              do i = 1, im
             924     3   p    v                if (cnvflg(i)) then
             925     4   p    v                  if(k.gt.kb(i).and.k.lt.ktcon(i)) then
             926     4   p    v                    dp = 1000. * del(i,k)
             927     4   p    v                    dz = zi(i,k) - zi(i,k-1)
             928     4               !
             929     4   p    v                    dv1h = heo(i,k)
             930     4   p    v                    dv2h = .5 * (heo(i,k) + heo(i,k-1))
             931     4   p    v                    dv3h = heo(i,k-1)
             932     4   p    v                    dv1q = qo(i,k)
             933     4   p    v                    dv2q = .5 * (qo(i,k) + qo(i,k-1))
             934     4   p    v                    dv3q = qo(i,k-1)
             935     4   p    v                    dv1u = uo(i,k)
             936     4   p    v                    dv2u = .5 * (uo(i,k) + uo(i,k-1))
             937     4   p    v                    dv3u = uo(i,k-1)
             938     4   p    v                    dv1v = vo(i,k)
             939     4   p    v                    dv2v = .5 * (vo(i,k) + vo(i,k-1))
             940     4   p    v                    dv3v = vo(i,k-1)
             941     4               !
             942     4   p    v                    tem  = 0.5 * (xlamue(i,k)+xlamue(i,k-1))
             943     4   p    v                    tem1 = xlamud(i)
             944     4               !
             945     4   p    v                    dellah(i,k) = dellah(i,k) +                               &
             946     4                          ( eta(i,k)*dv1h - eta(i,k-1)*dv3h                            &
             947     4                         -  tem*eta(i,k-1)*dv2h*dz                                     &
             948     4                         +  tem1*eta(i,k-1)*.5*(hcko(i,k)+hcko(i,k-1))*dz              &
             949     4                              ) *g/dp
             950     4               !
             951     4   p    v                    dellaq(i,k) = dellaq(i,k) +                               &
             952     4                          ( eta(i,k)*dv1q - eta(i,k-1)*dv3q                            &
             953     4                         -  tem*eta(i,k-1)*dv2q*dz                                     &
             954     4                         +  tem1*eta(i,k-1)*.5*(qcko(i,k)+qcko(i,k-1))*dz              &
             955     4                              ) *g/dp
             956     4               !
             957     4   p    v                    dellau(i,k) = dellau(i,k) +                               &
             958     4                          ( eta(i,k)*dv1u - eta(i,k-1)*dv3u                            &
             959     4                         -  tem*eta(i,k-1)*dv2u*dz                                     &
             960     4                         +  tem1*eta(i,k-1)*.5*(ucko(i,k)+ucko(i,k-1))*dz              &
             961     4                         -  pgcon*eta(i,k-1)*(dv1u-dv3u)                               &
             962     4                              ) *g/dp
             963     4               !
             964     4   p    v                    dellav(i,k) = dellav(i,k) +                               &
             965     4                          ( eta(i,k)*dv1v - eta(i,k-1)*dv3v                            &
             966     4                         -  tem*eta(i,k-1)*dv2v*dz                                     &
             967     4                         +  tem1*eta(i,k-1)*.5*(vcko(i,k)+vcko(i,k-1))*dz              &
             968     4                         -  pgcon*eta(i,k-1)*(dv1v-dv3v)                               &
             969     4                              ) *g/dp
             970     4               !
             971     4   p    v                  endif
             972     3   p    v                endif
             973     2   p    v              enddo
             974     1   p                 enddo
             975                     !
             976                     !------- cloud top
             977                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 159
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             978     1  pp    s            do i = 1, im
             979     2   p    m              if(cnvflg(i)) then
             980     2   p    s                indx = ktcon(i)
             981     2   p    s                dp = 1000. * del(i,indx)
             982     2   p    s                dv1h = heo(i,indx-1)
             983     2   p    s                dellah(i,indx) = eta(i,indx-1) * (hcko(i,indx-1) - dv1h) * g / dp
             984     2   p    s                dv1q = qo(i,indx-1)
             985     2   p    s                dellaq(i,indx) = eta(i,indx-1) * (qcko(i,indx-1) - dv1q) * g / dp
             986     2   p    s                dv1u = uo(i,indx-1)
             987     2   p    s                dellau(i,indx) = eta(i,indx-1) * (ucko(i,indx-1) - dv1u) * g / dp
             988     2   p    s                dv1v = vo(i,indx-1)
             989     2   p    s                dellav(i,indx) = eta(i,indx-1) * (vcko(i,indx-1) - dv1v) * g / dp
             990     2               !
             991     2               !  cloud water
             992     2               !
             993     2   p    s                dellal(i,indx) = eta(i,indx-1) * qlko_ktcon(i) * g / dp
             994     2   p    v              endif
             995     1   p    v            enddo

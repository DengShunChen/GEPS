 External subroutine subprogram "vstruc_hybrid"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine vstruc_hybrid ( nxj,nx,lev,cp,radsq,sigma,dsigma,pt,tt,qt &
               2                                             ,ptop,pk,pk2,spal,odpsig,that,qhat,phi,ncld )
               3                     !
               4                     !  subroutine to compute several intermediate pressure dependent
               5                     !  variables and parameters
               6                     !
               7                     ! *** input ****
               8                     !
               9                     !  nx: e-w dimension no.
              10                     !  lev: number of vertical levels
              11                     !  pk: odd (full) level p**capa
              12                     !  pk2: even( half) level p**capa
              13                     !  cp: specific heat of air
              14                     !  radsq: (rad of earth)**2
              15                     !  dsig: sigma layer thicknesses
              16                     !  sig: sigma levels
              17                     !  pt: terrain pressure
              18                     !  tt: virtual potential temperature
              19                     !  qt: specific humidity
              20                     !
              21                     ! *** output ***
              22                     !
              23                     !  phi: geopotential
              24                     !  spal: energy conversion term (sigma*ps*alpha)
              25                     !  odpsig: reciprical of layer mass
              26                     !  that: even level potential temp (thickness temp)
              27                     !  qhat: even level specific humidity
              28                     !
              29                     ! **************************************************
              30                     !
              31                           implicit none
              32                     
              33                           integer  nxj,nx,lev,ncld
              34                     
              35                           real     pk(nx,lev),pk2(nx,lev),spal(nx,lev),odpsig(nx,lev)       &
              36                           , tt(nx,lev),qt(nx,lev*ncld),that(nx,lev),qhat(nx,lev*ncld)       &
              37                           , phi(nx,lev),pt(nx),dsigma(lev,2),sigma(lev+1,2)
              38                           real     dpk(nx,lev),dphi(nx,lev)
              39                     
              40                           real     capa,pk2top,top,cpr2,cp,radsq,ptop
              41                           integer  i,n,k,nk,kk
              42                     !
              43                     !  compute time dependent pressure variables
              44                     !
              45                           capa=1.0/3.5
              46                           pk2top=(ptop/1000.)**capa
              47                     
              48                           cpr2= cp/radsq
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk2, tt, dpk, spal, odpsig
                                   <<< Loop-information  End >>>
              49     1  pp    v            do 115 i=1,nxj
              50     1   p    v            odpsig(i,1)= 1.0/(dsigma(1,2)+dsigma(1,1)*pt(i))
              51     1   p    v            dpk   (i,1)= pk2(i,1)-pk2top
              52     1   p    v            spal  (i,1)= cpr2*tt(i,1)*(sigma(2,1)+sigma(1,1))/2.              &
              53     1                                    *dpk(i,1)*odpsig(i,1)
              54     1   p    v        115 continue
              55                     !
              56                     !
              57                     !  half-level specific humidity, interpolate in p**capa
              58                     !
              59     1                     do n=1,ncld
              60     1                     nk=(n-1)*lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, qt, qhat
                                   <<< Loop-information  End >>>
              61     2  pp                 do k=1,lev-1
              62     2   p                 kk=nk+k
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, qt, qhat
                                   <<< Loop-information  End >>>
              63     3   p    v            do i=1,nxj
              64     3   p    v            qhat(i,kk+1)= qt(i,kk+1)+(qt(i,kk)-qt(i,kk+1))                    &
              65     3                      *(pk(i,k+1)-pk2(i,k))/(pk(i,k+1)-pk(i,k))
              66     3   p    v            enddo
              67     2   p                 enddo
              68     1                     enddo
              69                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk2, pk, tt, odpsig, dpk, that, spal
                                   <<< Loop-information  End >>>
              70     1  pp                 do 160 k=1,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk2, pk, tt, that, dpk, spal, odpsig
                                   <<< Loop-information  End >>>
              71     2   p    v            do 160 i=1,nxj
              72     2               !
              73     2               !  recipricol of layer pressure depth
              74     2               !
              75     2   p    v            odpsig(i,k+1)= 1.0/(dsigma(k+1,2)+dsigma(k+1,1)*pt(i))
              76     2   p    v            dpk   (i,k+1)= pk2(i,k+1) - pk2(i,k)
              77     2               !
              78     2               !  half level potential temperature, defined as weighted combination
              79     2               !  of full level thicknesses, not an interpolation
              80     2               !
              81     2               !  half level potential temperature, interpolate in p**capa
              82     2               !
              83     2               !  in hybrid coord. proposed by Hnery Juang, we can choose
              84     2               !  a better way to define that
              85     2               !
              86     2   p    v            that(i,k+1)= tt(i,k+1)+(tt(i,k)-tt(i,k+1))                        &
              87     2                      *(pk(i,k+1)-pk2(i,k))/(pk(i,k+1)-pk(i,k))
              88     2               !
              89     2               !  energy conversion term for terrain pressure contribution to
              90     2               !  horizontal pressure gradient
              91     2               !
              92     2   p    v            spal(i,k+1)= cpr2*tt(i,k+1)*(sigma(k+1,1)+sigma(k+2,1))/2.        &
              93     2                                *dpk(i,k+1)*odpsig(i,k+1)
              94     2               !
              95     1   p    v        160 continue
              96                     !
              97                     !  hydrostatic equation: note that terrain geopotential is excluded.
              98                     !  it it constant forcing term that is included when laplacian of
              99                     !  geopotential is computed in divergence equation.
             100                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpk, tt, dphi
                                   <<< Loop-information  End >>>
             101     1  pp                 do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpk, tt, dphi
                                   <<< Loop-information  End >>>
             102     2   p   2v              do i=1,nxj
             103     2   p   2v                dphi(i,k)= cp*tt(i,k)*dpk(i,k)
             104     2   p   2v              enddo
             105     1   p                 enddo
             106                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dphi, phi
                                   <<< Loop-information  End >>>
             107     1  pp   2v            do i=1,nxj
             108     1   p   2v              phi(i,lev)= dphi(i,lev)/2.
             109     1   p   2v            enddo
             110                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dphi, phi
                                   <<< Loop-information  End >>>
             111     1                     do k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phi, dphi
                                   <<< Loop-information  End >>>
             112     2  pp   2v              do i=1,nxj
             113     2   p   2v                phi(i,k)= phi(i,k+1)+(dphi(i,k)+dphi(i,k+1))/2.
             114     2   p   2v              enddo
             115     1                     enddo
             116                     !
             117                           return
             118                           end


             226     3   p    v                do i = 1, nxj
             227     3   p    v                  phy3d(i,k,1) = ftp(i,k)    ! effective radius for liquid water (micron)
             228     3   p    v                  phy3d(i,k,2) = ftp1(i,k)   ! effective radius for ice water    (micron)
             229     3   p    v                  phy3d(i,k,3) = fqp(i,k)    ! effective radius for snow water   (micron)
             230     3   p    v                  phy3d(i,k,4) = fqp1(i,k)   ! effective radius for rain water   (micron)

             157     2   p    v               prsl(i,kc)=plt(i,k)*0.1 ! change to cb
             158     2   p    v               prslk(i,kc)=(plt(i,k)/1000.)**xkapa
             159     2   p    v               tgrs(i,kc)=tt(i,k)
             160     2   p    v               qgrs(i,kc)=qt(i,k)

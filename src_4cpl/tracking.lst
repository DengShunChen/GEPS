 External subroutine subprogram "findtrk"
  (inc)(line-no.)(nest)(optimize)
             457                     !
             458                     subroutine findtrk(fld,nx,my,ix,iy,rx,ry,tlon,tlat,index,lfound,min_trk_pres,range_le30,range_gt30)
             459                     !-------------------------------------------------------------------------
             460                     !       Finding Tropical Cyclone Center Position
             461                     !
             462                     !       fld     : fields
             463                     !       nx      : total grid points at x-axis
             464                     !       my      : total grid points at y-axis
             465                     !       ix      : center position at x-axis with integer
             466                     !       iy      : center position at y-axis with integer
             467                     !       rx      : center position at x-axis with float number
             468                     !       ry      : center position at y-axis with float number
             469                     !       index   : different field
             470                     !       lfound  : logical flag of finding typhoon
             471                     !
             472                     !       hx      : Newton's Metod ajustment at x-axis
             473                     !       hy      : Newton's Metod ajustment at y-axis
             474                     !
             475                     !-------------------------------------------------------------------------
             476                     !
             477                       use rank
             478                       use const, only: RTYPE
             479                     !  use mod_typhoon, only : min_trk_pres
             480                     
             481                       implicit none
             482                     
             483                       integer :: i,j
             484                       integer :: nx,my,ix,iy,index
             485                       integer :: ib,ie,jb,je
             486                       real(kind=RTYPE) :: fld(nx,my)
             487                       real    :: fldavg
             488                       real    :: tlon(nx),tlat(my)
             489                       logical :: lfound
             490                     
             491                       integer :: ixyrange
             492                       real    :: f0,f1,f2,f3,f4
             493                       real    :: xxx,yyy,hx,hy,rx,ry
             494                       real    :: max_value, min_value, min_trk_pres
             495                       integer :: range_le30, range_gt30
             496                     
             497                     !-------------------------------------------------------------------------
             498                     !     max. Typhoon moving speed is around 50 km/h, which in t320(about
             499                     !     50 km) resolution, the serch area should be bigger than
             500                     !     50*(tracking interval)
             501                     !-------------------------------------------------------------------------
             502                     ! data ixyrange/4/    ! for 3 hours tracking interval
             503                     ! data ixyrange/6/    ! for 3 hours tracking interval, grid points. T320
             504                     !  data ixyrange/12/    ! for 3 hours tracking interval, grid points. T512
             505                     ! data ixyrange/16/
             506                     ! data ixyrange/8/    ! river's original setup
             507                     !
             508     1                if (tlat(iy) .le. 30. ) then
             509     1                  ixyrange=range_le30
             510     1               !   ixyrange=8
             511     1                else
             512     1                  ixyrange=range_gt30
             513     1               !   ixyrange=14
             514     1                endif
             515                     
             516                     ! print*, 'range_le30 = ',range_le30
             517                     ! print*, 'range_gt30 = ',range_gt30
             518                     
             519                      if(myrank.eq.0) print*,'tlat = ',tlat(iy),' ixyrange = ',ixyrange
             520                     
             521                     !-- set search domain
             522                       ib=max(ix-ixyrange,1)
             523                       ie=min(ix+ixyrange,nx)
             524                       jb=max(iy-ixyrange,1)
             525                       je=min(iy+ixyrange,my)
             526                     !
             527     1                 if(index.eq.1 .or. index.eq.4 .or. index.eq.5)then
             528     1                   min_value=99999.
             529     2                   do j=jb,je
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<< Loop-information  End >>>
             530     3  pp    s          do i=ib,ie
             531     3   p    v            fldavg=fld(i,j)
             532     4   p    s            if(fldavg.lt.min_value)then
             533     4   p    m              ix=i
             534     4   p    v              iy=j
             535     4   p    s              min_value=fldavg
             536     4   p    v            endif
             537     3   p    v          enddo
             538     2                   enddo
             539     1               
             540     2                   if(myrank.eq.0) then
             541     2                     write(6,*)'ib/ie/jb/je/ix/iy/min_value/index = ',ib,ie,jb,je,ix,iy,min_value,index
             542     2                   endif
             543     1               
             544     1               !  if the vortex is too weak
             545     2                   if(index.eq.1) then
             546     2               !      if(min_value.le.999. )then
             547     3                     if(min_value .le. min_trk_pres)then
             548     3                       lfound=.true.
             549     3                     else
             550     3                       lfound=.false.
             551     3                       return
             552     3                     endif
             553     2               !    if(myrank.eq.0) then
             554     2               !    print*,'min_trk_pres=',min_trk_pres
             555     2               !    endif
             556     2                   endif
             557     1               
             558     1               !--- check center position
             559     1                   f0=fld(ix,iy)
             560     1                   f1=fld( min(ix+1,nx) , iy )
             561     1                   f2=fld( ix , min(iy+1,my) )
             562     1                   f3=fld( max(ix-1, 1) , iy )
             563     1                   f4=fld( ix , max(iy-1, 1) )
             564     1               
             565     2                   if ( f0.gt.f1 .or. f0.gt.f2 .or. f0.gt.f3 .or. f0.gt.f4 ) then
             566     3                     if(myrank.eq.0) then
             567     3                       write(6,*)'findtrk : f0 greater than surrounding values ,index = ',index
             568     3                       write(6,*)'ix/iy/f0/f1/f2/f3/f4/index = ',ix,iy,f0,f1,f2,f3,f4,index
             569     3                     endif
             570     2                     lfound=.false.
             571     2                   else
             572     2                     xxx=f1-2.*f0+f3
             573     2                     yyy=f2-2.*f0+f4
             574     2               
             575     2                     ! x-direction
             576     3                     if(xxx.ne.0.) then
             577     3                       hx = 0.5*(f1-f3)/(f1-2.*f0+f3)
             578     3                     else
             579     3                       hx=0.
             580     3                     endif
             581     2               
             582     2                     ! y-direction
             583     3                     if(yyy.ne.0.) then
             584     3                       hy = 0.5*(f2-f4)/(f2-2.*f0+f4)
             585     3                     else
             586     3                       hy=0.
             587     3                     endif
             588     2                     rx=real(ix)-hx
             589     2                     ry=real(iy)-hy
             590     2                     !ix=int(rx+0.5)
             591     2                     !iy=int(ry+0.5)
             592     2                     lfound=.true.
             593     2                   endif
             594     1               !------------------------------------------------------------
             595     1                 else if(index.eq.2 .or. index.eq.3)then
             596     1                   max_value=-99999.
             597     2                   do  j=jb,je
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<< Loop-information  End >>>
             598     3  pp    s          do  i=ib,ie
             599     3   p    v            fldavg=fld(i,j)
             600     4   p    s            if(fldavg.gt.max_value)then
             601     4   p    m              ix=i
             602     4   p    v              iy=j
             603     4   p    s              max_value=fldavg
             604     4   p    v            endif
             605     3   p    v          enddo
             606     2                   enddo
             607     2                   if(myrank.eq.0) then
             608     2                     write(6,*)'ib/ie/jb/je/ix/iy/max_value/index = ',ib,ie,jb,je,ix,iy,max_value,index
             609     2                   endif
             610     1                   !--- check center position
             611     1                   f0=fld(ix,iy)
             612     1                   f1=fld( min(ix+1,nx) , iy )
             613     1                   f2=fld( ix , min(iy+1,my) )
             614     1                   f3=fld( max(ix-1, 1) , iy )
             615     1                   f4=fld( ix , max(iy-1, 1) )
             616     1               
             617     2                   if ( f0 .lt. f1 .or. f0 .lt. f2 .or. f0 .lt. f3 .or. f0 .lt. f4 ) then
             618     3                     if(myrank.eq.0) then
             619     3                       write(6,*)'findtrk : f0 lower than surrounding ,index=',index
             620     3                       write(6,*)'ix/iy/f0/f1/f2/f3/f4/index = ',ix,iy,f0,f1,f2,f3,f4,index
             621     3                     endif
             622     2                     lfound=.false.
             623     2                   else
             624     2                     xxx=f1-2.*f0+f3
             625     2                     yyy=f2-2.*f0+f4
             626     2                     ! x-direction
             627     3                     if(xxx.ne.0.) then
             628     3                       hx = 0.5*(f1-f3)/(f1-2.*f0+f3)
             629     3                     else
             630     3                       hx=0.
             631     3                     endif
             632     2                     ! y-direction
             633     3                     if(yyy.ne.0.) then
             634     3                       hy = 0.5*(f2-f4)/(f2-2.*f0+f4)
             635     3                     else
             636     3                       hy=0.
             637     3                     endif
             638     2                     rx=real(ix)-hx
             639     2                     ry=real(iy)-hy
             640     2                     ix=int(rx+0.5)
             641     2                     iy=int(ry+0.5)
             642     2                     lfound=.true.
             643     2                   endif
             644     1                 endif
             645                     !
             646                     return
             647                     end subroutine findtrk


             286     5                     do nty=1,nstm ! output all the number of forecasted typhoon
             287     5               
             288     5                       if(nty.eq.1) n=100
             289     5                       if(nty.eq.2) n=5100
             290     5                       if(nty.eq.3) n=10100
             291     5                       if(nty.eq.4) n=15100
             292     5               !
             293     5                       p6lat(nty)=nodata
             294     5                       p6lon(nty)=nodata
             295     5                       tcslp(nty)=nodata
             296     5                       smxv(nty)=nodata
             297     5                       smr30(nty)=nodata
             298     5                       smr50(nty)=nodata
             299     5                       tclat(nty)=tflat(0,1,nty)
             300     5                       if (tclat(nty) .eq. undef) tclat(nty)=99999.
             301     5                       tclon(nty)=tflon(0,1,nty)
             302     5                       if (tclon(nty) .eq. undef) tclon(nty)=99999.
             303     5                       write(work(n+1),'(1x,a15)') typname(nty)
             304     5                       write(work(n+2),'(i16.0)') nint(p6lat(nty)*10000)
             305     5                       write(work(n+3),'(i16.0)') nint(p6lon(nty)*10000)
             306     5                       write(work(n+4),'(i16.0)') nint(tclat(nty)*10000)
             307     5                       write(work(n+5),'(i16.0)') nint(tclon(nty)*10000)
             308     5                       write(work(n+6),'(i16.0)') nint(tcslp(nty)*10000)
             309     5                       write(work(n+7),'(i16.0)') nint(smxv(nty)*10000)
             310     5                       write(work(n+8),'(i16.0)') nint(smr30(nty)*10000)
             311     5                       write(work(n+9),'(i16.0)') nint(smr50(nty)*10000)
             312     5               !

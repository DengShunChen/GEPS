 External subroutine subprogram "tracking"
  (inc)(line-no.)(nest)(optimize)
               1                     subroutine tracking(tau,dt_trk,dt,nx,my,                                  &
               2                                         ntyph,typname,ixtyp,jytyp,tlon,tlat,tflon,tflat,idtg, &
               3                                         nrec,typhoon,tensity)
               4                     !---------------------------------------------------------------------------!
               5                     !  This subroutine is doing to find posiotn of vortex center
               6                     !
               7                     !  Input :
               8                     !       tau     : forcast time
               9                     !       dt_trk  : tracking frequency
              10                     !       dt      : delta t in seconds
              11                     !       nx      : x-asixs of model points
              12                     !       ny      : y-asixs of model points
              13                     !       typtrk  : (:,:,1) Sea level pressure filed
              14                     !               : (:,:,2) 850 hPa vorticity
              15                     !               : (:,:,3) 700 hPa vorticity
              16                     !               : (:,:,4) 850 hPa geopotential height
              17                     !               : (:,:,5) 500 hPa geopotential height
              18                     !       ntyph   : numbers of typhoon
              19                     !       typname : typhoon name
              20                     !       idtg    : date time
              21                     !       tlon    : lon valuse at model grid point
              22                     !       tlat    : lat valuse at model grid point
              23                     !
              24                     !  Output :
              25                     !       tflon   : typhoon center longitude
              26                     !       tflat   : typhoon center latitude
              27                     !
              28                     !---------------------------------------------------------------------------!
              29                     !  Thanks to TWRF team, CWB for Technical supporting.
              30                     !
              31                     !                                       Created by Chen, Jen-Her
              32                     !                                       Modified by Chen, Deng-Shun
              33                     !                                       Date : 7 Aug, 2014
              34                     !
              35                     !  log:
              36                     !   2014-08-27  Chen, Deng-Shun   Be able to output every 6-hour
              37                     !   2014-09-02  Chen, Deng-Shun   Changed track data format
              38                     !   2014-10-13  Chen, Deng-Shun   Changed search domain size from 4 grid points to 6 grid points,
              39                     !                                 in order to consider the high moving speed within mid-lattitude area.
              40                     !   2015-02-06  Chen, Deng-Shun   Bug fixed. This bugs will cause run-time error
              41                     !   2015-11-10  Chen, Deng-Shun   Changed from Fortran 77 code to 90
              42                     !   2019-10-22  Liu, Pang-Yen     Reducing memory
              43                     !
              44                     !---------------------------------------------------------------------------!
              45                     !
              46                       use mpe
              47                       use rank
              48                       use index
              49                       use mod_typhoon,only:write_mem,write_tau,typtrk
              50                       use const,only:ifilout,RTYPE
              51                       use param,only:my_max
              52                     !  use mod_outflds,only:ifilout
              53                     !  use param
              54                       implicit none
              55                     
              56                     ! parameters
              57                       integer, parameter   :: ntau=168, nvar=5
              58                       real, parameter      :: undef=-99.999
              59                       real, parameter      :: nodata=99999.
              60                       integer,parameter    :: datalength=25000
              61                     !---
              62                       integer :: nx,my, ntyph, ndt, write_mem2
              63                       character*2 :: mem
              64                       real :: tau,dt_trk,dt
              65                     
              66                       integer :: ixtyp(nvar,ntyph),jytyp(nvar,ntyph),nrec(ntyph)
              67                     !byl  real :: slp(nx,my),v850(nx,my),v700(nx,my),h850(nx,my),h500(nx,my)
              68                     !byl  real :: field(nx,my,nvar)
              69                       real(kind=RTYPE) :: field(nx,my)
              70                       real :: tlon(nx),tlat(my)
              71                     
              72                       real :: tflon(0:ntau,nvar,ntyph),tflat(0:ntau,nvar,ntyph)
              73                       real :: tclat(ntyph),tclon(ntyph)
              74                       real :: p6lat(ntyph),p6lon(ntyph),tcslp(ntyph)
              75                       real :: smxv(ntyph),smr30(ntyph),smr50(ntyph)
              76                       real :: slat(0:ntau),slon(0:ntau)
              77                       real :: sten(0:ntau),speed1(0:ntau)
              78                       real :: tensity(0:ntau,nvar,ntyph)
              79                       real :: rixtyp(nvar),rjytyp(nvar)
              80                       real :: dist,speed,slatpre,slonpre
              81                       logical :: typhoon
              82                       character(15)  :: typname(ntyph)
              83                       integer(8) idtg,idtg8
              84                       character*80 trkpath
              85                       character*150 trkfilename
              86                     !---
              87                       logical :: lfound(nvar,ntyph)
              88                       logical :: WriteTrack=.false. ,DoFindTrack=.false.
              89                       character(15) :: trackfile,tensfile
              90                       character*100 line, headerline, tauline
              91                       integer ityp, ist
              92                       integer il,nty,n_h_lat,n_h_lon,n_h_ten,n_h_spd
              93                       logical l_loop
              94                       integer istat,a
              95                     !
              96                       integer itauo(0:ntau,10)  ! The array size should be specified use SAVE is applied
              97                       save itauo
              98                     
              99                       real  dtx_tau,dtaup
             100                       integer n,i,j,nc,ip, nt, ntime
             101                     !DMS variable
             102                           character dmsdb*10

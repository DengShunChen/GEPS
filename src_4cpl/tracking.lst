 External subroutine subprogram "greatcir"
  (inc)(line-no.)(nest)(optimize)
             693                     
             694                     subroutine greatcir(lon1,lat1,lon2,lat2,dist)
             695                     !--------------------------------------------------------------c
             696                     !    calculate distance of lon1,lon2 lat1,lat2
             697                     !==============================================================c
             698                           integer np
             699                           real dist
             700                           real lon1,lat1,lon2,lat2
             701                           real dlon,dlat
             702                     !
             703                           pi=4.0*atan(1.0)
             704                           rad=6370. ! earth radius in km
             705                           torad=pi/180.
             706                           dlon=(lon2-lon1)*torad
             707                           dlat=(lat2-lat1)*torad
             708                           a=sin(dlat/2.)*sin(dlat/2.)+cos(lat1*torad)*cos(lat2*torad)*sin(dlon/2.)*sin(dlon/2.)
             709                           c=2.*atan2(sqrt(a), sqrt(1-a))
             710                           dist=rad*c
             711                     !      print *,'The distance between (lon1,lat1) and (lon2,lat2) = ',dist
             712                     !      print *,'lon1,lat1,lon2,lat2= ',lon1,lat1,lon2,lat2
             713                     !
             714                     return
             715                     end subroutine greatcir
             716                     !


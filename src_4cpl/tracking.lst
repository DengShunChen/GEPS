             111                           character domain1*16
             112                           character dmskeytrack*34
             113                     !
             114                           data tytrack /'TYTRACKGT'/
             115                           data domain1 /'CWB GFS  T511L60'/
             116                           data dmstail/'X0025000'/
             117                           data dmsdb/'test'/
             118                           data epsno/'00'/
             119                     
             120                     ! for judging the undef value
             121                       real ::  min_trk_pres,distpre
             122                       real, save    :: rixtyp_savep(60,5,10), rjytyp_savep(60,5,10)
             123                       logical, save :: lfound_save(60,5,10)
             124                       integer :: range_le30, range_gt30
             125                     
             126                     !---------------------------------------------------------------------------c
             127                     ! get resolution dependent tracking range
             128                       range_le30 = int(50*dt_trk*nx/36000)+2
             129                       range_gt30 = int(87.5*dt_trk*nx/36000)+2
             130                     
             131                     ! Using five fields to the TC center
             132                     !byl  field(:,:,1) =  slp(:,:)      ! sea level pressure
             133                     !byl  field(:,:,2) = v850(:,:)      ! 850hPa vorticity
             134                     !byl  field(:,:,3) = v700(:,:)      ! 700hPa vorticity
             135                     !byl  field(:,:,4) = h850(:,:)      ! 850hPa height
             136                     !byl  field(:,:,5) = h500(:,:)      ! 500hPa height
             137                     
             138                     ! initialize
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.55, ITR: 96, MVE: 2, POL: S)
                                   <<<    FULL UNROLLING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lfound
                                   <<< Loop-information  End >>>
             139        pp  10v        lfound=.false.
             140                       dtx_tau=dt/3600.
             141                       ndt=int((6./dt_trk)+0.001)
             142                     
             143                     ! checking write track time
             144                     !  dtaup= mod(tau+0.001, real(write_tau))
             145                       dtaup= mod(tau+0.001, 6.)   ! every 6 hrs will output
             146                       WriteTrack=(dtaup .lt. dtx_tau)
             147                     !  print*,'WriteTrack',dtaup,dtx_tau,WriteTrack
             148                     
             149                     ! do tracking
             150                       dtaup= mod(tau+0.001, tau)
             151                       DoFindTrack=(dtaup .lt. dtx_tau)
             152                     !  print*,'DoFindTrack',dtaup,dtx_tau,DoFindTrack
             153                       if(myrank.eq.0)print *,' in tracking tau=',tau
             154                     
             155     1                 if(DoFindTrack)then
             156     1                 !for multi-typhoon
             157     2                   do n=1,ntyph
             158     2               
             159     2                     itauo(0,n)=0
             160     2                     nrec(n)=nrec(n)+1
             161     2                     nc=nrec(n)
             162     2                     itauo(nc,n)=int(tau+0.01)
             163     2               !
             164     3                     if (nc .le. 72/dt_trk+1) then                                     ! 3-day fcst
             165     3                       min_trk_pres=1007.
             166     3                     else if (nc .gt. 72/dt_trk+1 .and. nc .le. 120/dt_trk+1) then     ! 3~5-day fcst
             167     3                       min_trk_pres=1003.
             168     3                     else                                                              ! 5~7-day fcst
             169     3                       min_trk_pres=1000.
             170     3                     endif
             171     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 5  FILL 39
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             172     3                     do ip=1,nvar
             173     3                       call unify_reduceintp(nx,my,my_max,typtrk(1,1,ip),field)
             174     3               !byl        call findtrk(field(:,:,ip),nx,my,ixtyp(ip,n),jytyp(ip,n),rixtyp(ip),rjytyp(ip),tlon,tlat,ip,lfound(ip,n),min_trk_pres,range_le30,range_gt30)
             175     3                       call findtrk(field,nx,my,ixtyp(ip,n),jytyp(ip,n),rixtyp(ip),rjytyp(ip),tlon,tlat,ip,lfound(ip,n),min_trk_pres,range_le30,range_gt30)
             176     3               !      enddo
             177     3               
             178     3               ! for pressure -999*3 check
             179     4                     if (nc .ge. 3) then
             180     4               
             181     4               !      do ip=1,nvar
             182     4               
             183     5                     if (lfound(ip,n)) then
             184     5                       call xy2ll(rixtyp(ip),rjytyp(ip),tflon(nc,ip,n),tflat(nc,ip,n),tlon,tlat,nx,my)
             185     5               
             186     6                       if (lfound_save(nc-1,ip,n)) then
             187     6               
             188     6                       call xy2ll(rixtyp_savep(nc-1,ip,n),rjytyp_savep(nc-1,ip,n),tflon(nc-1,ip,n),tflat(nc-1,ip,n),tlon,tlat,nx,my)
             189     6    i                  call greatcir(tflon(nc,ip,n),tflat(nc,ip,n),tflon(nc-1,ip,n),tflat(nc-1,ip,n),distpre)
             190     6               
             191     6               !        if(myrank .eq. 0) print*,'dist pre-1 = ',distpre
             192     7                       if (distpre .gt. dt_trk*85) then
             193     7                          lfound(ip,n)=.false.
             194     7                       endif
             195     6               
             196     6                       else ! (lfound_save(nc-1,1,n) == .false.) then
             197     6               
             198     7                         if (lfound_save(nc-2,ip,n)) then
             199     7               
             200     7                           call xy2ll(rixtyp_savep(nc-2,ip,n),rjytyp_savep(nc-2,ip,n),tflon(nc-2,ip,n),tflat(nc-2,ip,n),tlon,tlat,nx,my)
             201     7    i                      call greatcir(tflon(nc,ip,n),tflat(nc,ip,n),tflon(nc-2,ip,n),tflat(nc-2,ip,n),distpre)
             202     7               
             203     7               !            if(myrank .eq. 0)print*,'dist pre-2 = ',distpre
             204     8                           if (distpre .gt. dt_trk*85*2) then
             205     8                             lfound(ip,n)=.false.
             206     8                           endif
             207     7               
             208     7                         else ! lfound_save(nc-2,1,n) == .false.
             209     7                           lfound(ip,n)=.false.
             210     7                         endif
             211     6                       endif
             212     5               
             213     5                     endif
             214     4               
             215     4               !      enddo
             216     4                     endif ! nc > 3
             217     3               
             218     3               !      do ip=1,nvar
             219     3                        rixtyp_savep(nc,ip,n)=rixtyp(ip)
             220     3                        rjytyp_savep(nc,ip,n)=rjytyp(ip)
             221     3                        lfound_save(nc,ip,n)=lfound(ip,n)
             222     3               !      enddo
             223     3               ! for pressure -999*3 check
             224     3               
             225     3               !      do ip=1,nvar
             226     4                       if(lfound(ip,n))then
             227     4                         call xy2ll(rixtyp(ip),rjytyp(ip),tflon(nc,ip,n),tflat(nc,ip,n),tlon,tlat,nx,my)
             228     4                         i=ixtyp(ip,n) ; j=jytyp(ip,n)
             229     5                         if(ip .eq. 4) then
             230     5                           tensity(nc,ip,n)=field(i,j)!+1457.0
             231     5                         elseif(ip .eq. 5) then
             232     5                           tensity(nc,ip,n)=field(i,j)!+5574.0
             233     5                         else
             234     5                           tensity(nc,ip,n)=field(i,j)
             235     5                         endif
             236     4                       else
             237     4                         tflon(nc,ip,n)=undef ; tflat(nc,ip,n)=undef
             238     4                         tensity(nc,ip,n)=undef
             239     4                       endif
             240     3                     enddo ! ip=1,nvar
             241     2               !
             242     3                     if(myrank.eq.0)then
             243     3                       print *,' tau=',tau,' typhoon=',typname(n),' nrec=',nrec(n)
             244     3                       print *,' lfound=',lfound(1,n),' fcst slp =',tensity(nc,1,n)
             245     3                       print *,' at ',tflon(nc,1,n),tflat(nc,1,n)
             246     3                       print *,' itauo=',itauo(nc,n)
             247     3                     endif
             248     2                   enddo ! end of do n typhoons
             249     1               !
             250     1                   DoFindTrack=.false.
             251     1                 endif
             252                     !
             253                     !
             254                          dfile=ifilout
             255                     
             256                          write(idtgc,'(i12)') idtg
             257                          write(mem,'(i2.2)') write_mem
             258                          cdtg=idtgc(1:10)
             259     1                if(WriteTrack)then
             260     2                   if(myrank.eq.0)then
             261     3                    if(idtg.ge.200000000000)then
             262     3                    idtg8=(idtg-200000000000)/100
             263     3                    else
             264     3                    idtg8=(idtg-190000000000)/100
             265     3                    endif
             266     2                   call dmsmsg('ERR',ist)
             267     2                     print *,'dmsdb= ',dfile,'  ist= ',ist,'cdtg=',cdtg,'mem=',mem
             268     2               !
             269     3                    do il=1,5
             270     4                     if (il.NE.4) then
             271     4               
             272     4                     if (il.eq.1) dmshead='SSL'
             273     4                     if (il.eq.2) dmshead='850'
             274     4                     if (il.eq.3) dmshead='700'
             275     4                     if (il.eq.5) dmshead='500'
             276     4               

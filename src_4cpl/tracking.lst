 External subroutine subprogram "xy2ll"
  (inc)(line-no.)(nest)(optimize)
             648                     
             649                     subroutine xy2ll (rx,ry,lon,lat,tlon,tlat,nx,my)
             650                     !------------------------------------------------------------------c
             651                     !     convert model x-y to lat-lon position
             652                     !------------------------------------------------------------------c
             653                       use rank
             654                       implicit none
             655                     
             656                       integer nx,my,ix,iy
             657                       real rx,ry, dx, dy
             658                       real lon,lat, dlon, dlat
             659                       real tlon(nx), tlat(my)
             660                     !
             661                       ix=int(rx)
             662                       iy=int(ry)
             663                     
             664                       dx=rx-real(ix)
             665                       dy=ry-real(iy)
             666                     !
             667     1                 if (ix+1 .gt. nx) then
             668     1                   if(myrank.eq.0) print*,'Warning !! ix+1 greater than nx !!'
             669     1               !    dlon=tlon(1)-tlon(ix)
             670     1                   if ( ix .eq. nx ) dlon=tlon(ix+1-nx)-tlon(ix)
             671     1                   if ( ix .gt. nx ) dlon=tlon(ix+1-nx)-tlon(ix-nx)
             672     1                 else if ( ix .lt. 1 ) then
             673     1                   if(myrank.eq.0) print*,'Warning !! ix smaller than 1 !!'
             674     1                   if ( ix+1 .eq. 1  ) dlon=tlon(ix+1)-tlon(ix+nx)
             675     1                   if ( ix+1 .lt. 1  ) dlon=tlon(ix+1+nx)-tlon(ix+nx)
             676     1                 else
             677     1                   dlon=tlon(ix+1)-tlon(ix)
             678     1                 endif
             679                     
             680     1                 if (iy+1 .gt. my) then
             681     1                   if(myrank.eq.0) print*,'Warning !! iy+1 greater than my !!'
             682     1                   dlat=0.
             683     1                 else
             684     1                   dlat=tlat(iy+1)-tlat(iy)
             685     1                 endif
             686                     !
             687                       lon=tlon(ix)+(dx*dlon)
             688                       lat=tlat(iy)+(dy*dlat)
             689                       if(myrank.eq.0) print*,'xy2ll : x/y/lon/lat =',rx,ry,lon,lat
             690                     
             691                     return
             692                     end subroutine xy2ll


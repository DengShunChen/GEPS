 External subroutine subprogram "reducegrid"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine reducegrid(qtt,jtrun,qttcut,jf,lcapd,lonfd,octah)
               2                     !
               3                     ! subroutine greduceg		programmer: hann-ming juang
               4                     !                                  modify : jen_her Chen
               5                     !
               6                     ! purpose: global reduce grid initial routine to compute lcapd and lonfd
               7                     !          the maximal value of qtt and the accuray of the digit (ndigit)
               8                     !          are used to determine the resolution lcapd and grid point
               9                     !          lonfd for each latitude. The lonfd is determined by the
              10                     !          checks of factors only 2, 3 and 5 with at least one 2, and
              11                     !          it is larger than lcapd*3+1.
              12                     !
              13                     ! input:
              14                     !	qtt	coefficient for spectral transform at given lat
              15                     !	lnt2	dimension of qtt at given lat
              16                     !	jtrun	wave dimension
              17                     !	qttcut	minimax value of accuracy for qtt
              18                     !       jf      position of y-direction at given lat
              19                     !       octah   option of Octahedral Gaussian reduced grid
              20                     ! output:
              21                     !	lcapd	wave resolution for reduced grid
              22                     !	lonfd	number of reduced grid point for latitude
              23                     !
              24                           use const, only: RTYPE
              25                     !
              26                           implicit  none
              27                     
              28                           integer, parameter :: nibm=40
              29                     !
              30                           integer  jtrun,j,k,l,m,n,lonfd,lcapd,ind,mwave,jf
              31                           integer  need,lonfi,lonff,lonfo,ii,lonf,jtime,ktime,ltime,        &
              32                                    mtime,ntime
              33                     
              34                           real(kind=RTYPE) qtt(jtrun+1,jtrun+1)
              35                           real     qttcut
              36                     !
              37                     !!!      integer  ibmfft(nibm)
              38                           logical octah
              39                     !!      data ibm/.true./
              40                     !!      data ibm/.false./
              41                     !!      data ibmfft/2560,2304,2112,2048,1920,1680,1536,1440,1320,1280     &
              42                     !!      ,           1152,1056, 960, 840, 768, 640, 576, 512, 480, 384     &
              43                     !!      ,            360, 330, 288, 256, 240, 192, 180, 168, 144, 132     &
              44                     !!      ,            120,  96,  72,  64,  48,  36,  24,  16,  12,   8/
              45                     !
              46                     !     Calculate the minimum grid length at given latitude for resolving spectrum
              47                     !
              48                           ind=0
              49                           mwave=0
              50                     !
              51     1                     if( octah ) then
              52     2                      do m=1,jtrun
              53     2                        need=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              54     3  pp    v               do n=m,jtrun
              55     4   p    v                 if(abs(qtt(n,m)).ge.qttcut) then
              56     4   p    v                    need=1
              57     4   p    v                 endif
              58     3   p    v               enddo
              59     2                        mwave=mwave+need
              60     2                      enddo
              61     1               !byl       lcapd=mwave
              62     1               !
              63     1               !byl       lonfi=2*(lcapd-1)+1
              64     1               !byl       lonff=lonfi+mod(lonfi,2)
              65     1               !     Octahedral Gaussian reduced grid with Cubic truncation
              66     1                      lonfo=16+4*jf
              67     1                      lcapd=min((lonfo-1)/2+1,jtrun)
              68     1               !byl       if ( lonfo .lt. lonff )                                          &
              69     1               !byl           print *,'Warning!! not enough grid lengh at j=',jf
              70     1               !byl         go to 200
              71     1                     else
              72     2                      do m=1,jtrun
              73     2                        need=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              74     3  pp    v               do n=m,jtrun
              75     4   p    v                 if(abs(qtt(n,m)).ge.qttcut) then
              76     4   p    v                    need=1
              77     4   p    v                 endif
              78     3   p    v               enddo
              79     2                        mwave=mwave+need
              80     2                      enddo
              81     1                      lcapd=mwave
              82     1               !
              83     1                      lonfi=2*(lcapd-1)+1
              84     1                      lonff=lonfi+mod(lonfi,2)
              85     1               #ifdef USE_FFTW
              86     1                       lonfo=lonff
              87     1               #else
              88     1                      do 100 ii=0,100,2
              89     1                       lonf=lonff+ii
              90     1                       lonfo=lonf
              91     1                       jtime=nint(log(float(lonf))/log(2.))
              92     1                       do j=1,jtime
              93     1                         if( mod(lonf,2).eq.0 ) then
              94     1                           lonf=lonf/2
              95     1                           if( lonf.eq.1 ) go to 200
              96     1                         endif
              97     1                       enddo
              98     1                       ktime=nint(log(float(lonf))/log(3.))
              99     1                       do k=1,ktime
             100     1                         if( mod(lonf,3).eq.0 ) then
             101     1                           lonf=lonf/3
             102     1                           if( lonf.eq.1 ) go to 200
             103     1                         endif
             104     1                       enddo
             105     1                       ltime=nint(log(float(lonf))/log(5.))
             106     1                       do l=1,ltime
             107     1                         if( mod(lonf,5).eq.0 ) then
             108     1                           lonf=lonf/5
             109     1                           if( lonf.eq.1 ) go to 200
             110     1                         endif
             111     1                       enddo
             112     1                       mtime=nint(log(float(lonf))/log(7.))
             113     1                       do l=1,mtime
             114     1                         if( mod(lonf,7).eq.0 ) then
             115     1                           lonf=lonf/7
             116     1                           if( lonf.eq.1 ) go to 200
             117     1                         endif
             118     1                       enddo
             119     1                       ntime=nint(log(float(lonf))/log(11.))
             120     1                       do l=1,ntime
             121     1                         if( mod(lonf,11).eq.0 ) then
             122     1                           lonf=lonf/11
             123     1                           if( lonf.eq.1 ) go to 200
             124     1                         endif
             125     1                       enddo
             126     1                100   continue
             127     1               !
             128     1               #endif
             129     1                     endif
             130                     !
             131                      200  lonfd=lonfo
             132                     !
             133                           return
             134                           end


              71     2  pp    v            do 90 i = 1, nxj
              72     2   p    v            pl2(i,kbot)= sigma(k+1,1)*pt(i)+sigma(k+1,2)+ptop
              73     2               !      pl2(i,kbot)= sig(k+1)*pt(i)+ptop
              74     2   p    v            pk2(i,k)   = opok*pk2(i,k)
              75     2   p    v            pk(i,k)    = (pl2(i,kbot)*pk2(i,k)-pl2(i,ktop)*pk2(i,k-1)) &
              76     2                                / (capap1*(pl2(i,kbot)-pl2(i,ktop)))
              77     2   p    v            plt(i,k)   = 1000.0*pk(i,k)*pk(i,k)*pk(i,k)*sqrt(pk(i,k))
              78     1   p    v         90 continue
              79                     !
              80                           return
              81                           end


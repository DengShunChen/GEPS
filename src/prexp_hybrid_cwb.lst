                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2d, pk2
                                   <<< Loop-information  End >>>
              54     1  pp   2v            pk2(:,k)= pk2d(:,k)
              55     1                     enddo
              56                     
              57                           kbot= 1
              58                           k= 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 243
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pt, plt, pk, pl2
                                   <<< Loop-information  End >>>
              59     1  pp    v            do 80 i=1, nxj
              60     1   p    v            pl2(i,kbot)= sigma(2,1)*pt(i)+sigma(2,2)+ptop
              61     1               !      pl2(i,kbot)= sig(2)*pt(i)+ptop
              62     1   p    v            pk2(i,k)   = opok*pk2(i,k)
              63     1   p    v            pk(i,k)    = (pl2(i,kbot)*pk2(i,k)-ptopk) &
              64     1                                / (capap1*(pl2(i,kbot)-ptop))
              65     1   p    v            plt(i,k)   = 1000.0*pk(i,k)*pk(i,k)*pk(i,k)*sqrt(pk(i,k))
              66     1   p    v         80 continue
              67                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk2, pl2, pk, plt
                                   <<< Loop-information  End >>>
              68     1                     do 90 k = 2, lev
              69     1                     ktop= kbot
              70     1                     kbot= 3 - ktop
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk2d
                                   <<< Loop-information  End >>>
              42     2  pp   2v            do i=1,nxj
              43     2   p   2v            pk2d(i,k)= sigma(k+1,1)*pt(i)+sigma(k+1,2)+ptop
              44     2               !      pk2(i,k)= sig(k+1)*pt(i)+ptop
              45     2   p   2v            enddo
              46     1                     call vlog(pk2d(1,k),pk2d(1,k),nxj)
              47     1                     enddo
              48                     !
                                   <<< Loop-information Start >>>

                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2d
                                   <<< Loop-information  End >>>
              50     2  pp   2v            do i=1,nxj
              51     2   p   2v            pk2d(i,k)=capa*pk2d(i,k)
              52     2   p   2v            enddo
              53     1                     call vexp(pk2d(1,k),pk2d(1,k),nxj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

               1                           subroutine prexp_hybrid_cwb ( nxj,nx,lev,ptop,sigma,pt,pk,pk2,plt )
               2                     !
               3                     !  subroutine to compute p to the kapa on odd and even levels
               4                     !
               5                     ! *** input ****
               6                     !
               7                     !  nx: e-w dimension no.
               8                     !  lev: number of vertical levels
               9                     !  sig: sigma levels
              10                     !  pt: terrain pressure
              11                     !
              12                     ! *** output ***
              13                     !
              14                     !  pk: odd (full) level p**capa
              15                     !  pk2: even( half) level p**capa
              16                     !
              17                     ! **************************************************
              18                     !
              19                           use const, only: RTYPE
              20                     !
              21                           implicit  none
              22                           integer   nxj,nx,lev
              23                           real      ptop
              24                     
              25                           real      plt(nx,lev),pk2d(nx,lev)
              26                           real(kind=RTYPE) pt(nx),sigma(lev+1,2),pk2(nx,lev),pk(nx,lev)
              27                     !
              28                           real      pl2(nx,2)
              29                     !
              30                     !  compute  pressure variables
              31                     !
              32                           integer k,i,ktop,kbot
              33                           real    capa,capap1,opok,ptopk
              34                     
              35                           capa  = 1.0/3.5
              36                           capap1= 1.0+capa
              37                           opok  = 1.0/1000.0**capa
              38                     !
              39                           ptopk= ptop*opok*ptop**capa
              40                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pk2d
                                   <<< Loop-information  End >>>
              41     1                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843

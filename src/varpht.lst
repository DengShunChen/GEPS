               1                           subroutine varpht (nx,my,my_max,lev,cp,dsig,pk2,pk,pt,sgeo,tt,phi &
               2                           ,                  phicor,tcor)
               3                     !
               4                     !  varpht does a calculus of variations adjustment of input
               5                     !  geopotential and temperature in arrays phi and tt, yielding
               6                     !  hydrostatically consistent output geopotential and temperature
               7                     !  in arrays phi and tt.  see barker (1980) monthly weather
               8                     !  review no. 8 "solving for temperature using unnaturally
               9                     !  latticed hydrostatic equations" for more technical details.
              10                     !
              11                     !  **** input ****
              12                     !
              13                     !  cp: specific heat of air
              14                     !  dsig: sigma coordinate layer thicknesses
              15                     !  pk2: half level exner function
              16                     !  pk: full level exner function
              17                     !  pt: terrain pressure
              18                     !  sgeo: terrain geopotential
              19                     !  tt: temperatures
              20                     !  phi: geopotentials
              21                     !  phicor:  work array
              22                     !  tcor:  work array
              23                     !
              24                     ! **** output ****
              25                     !
              26                     !  tt: adjusted temperatures
              27                     !  phi: adjusted geopotentials
              28                     !
              29                     !     include '../include/mpe.h'
              30                     !     include '../include/rank.h'
              31                     !     include '../include/index.h'
              32                           use mpe
              33                           use rank
              34                           use index
              35                     
              36                           implicit  none
              37                     
              38                           integer   nx,my,my_max,lev
              39                           integer   i,j,k,jj,kk
              40                           real      cp,temx
              41                     
              42                           real      dsig(lev),tt(nx,lev,my_max)                          &
              43                           , phi(nx,lev,my_max),pt(nx,my),sgeo(nx,my),pk(nx,lev,my_max)   &
              44                           , pk2(nx,lev,my_max),phicor(nx,lev,my_max),tcor(nx,lev,my_max)
              45                     !
              46                     !sun  include '../include/paramt.h'.. change im,lm to nx,lev
              47                     
              48                           real      dp(nx,lev),elam(nx,lev),a(nx,lev),b(nx,lev),c(nx,lev)
              49                           real      tweght(lev),rmst(lev),rmsf(lev),biast(lev),biasf(lev)
              50                           character*16 crec
              51                     !
              52                     !  tweght is an array of coefficients used tt determine the
              53                     !  respective weights given tt the input geopotential and
              54                     !  temperature.  the larger the value of tweght, the more the
              55                     !  adjustment is biased to fitting the geopotential at the expense
              56                     !  of temperature fit.  values in excess of those used here will
              57                     !  cause unaceptable buckling of the temperature sounding.
              58                     !
              59                     !      data tweght/lev*0.0001/
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tweght
                                   <<< Loop-information  End >>>
              60     1  pp   4v            do 1 k=1,lev
              61     1   p   4v              tweght(k)=0.0001
              62     1   p   4v       1    continue
              63                           tweght(lev)=   0.00001
              64                           tweght(lev-1)= 0.0001
              65                           tweght(1)=.0005
              66                           tweght(2)=.00025
              67                     !
              68                     !  compute pressure variables in the sigma levels of the
              69                     !  forecast model.
              70                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, pt, tcor, dp, tt, sgeo, phi, b
                                   <<<      elam, phicor
                                   <<< Loop-information  End >>>
              71     1                     do 100 jj =1, jlistnum
              72     1                     j=jlist1(jj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, pt, tcor, dp
                                   <<< Loop-information  End >>>
              73     2  pp   2v            do 121 i=1,nx
              74     2   p   2v            dp(i,1)= dsig(1)*pt(i,j)
              75     2   p   2v            tcor(i,1,jj)= cp*pk2(i,1,jj)/pk(i,1,jj)-cp
              76     2   p   2v        121 continue
              77     1               !ocl nounroll
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, pk, pt, pk2, phi, tcor, tt, phicor
                                   <<<      elam, c, b, a
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      dp: 4
                                   <<< Loop-information  End >>>
              78     2                     do 111 k=1,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 174
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.43, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pt, dp, pk2, pk, phi, elam, phicor
                                   <<<      tcor, c, b, a
                                   <<<    PREFETCH(SOFT) : 2
                                   <<<     SEQUENTIAL : 2
                                   <<<      dp: 2
                                   <<< Loop-information  End >>>
              79     3  pp    v            do 113 i=1,nx
              80     3   p    v            dp(i,k+1)= dsig(k+1)*pt(i,j)
              81     3   p    v            tcor(i,k+1,jj)= cp*(pk2(i,k+1,jj)/pk(i,k+1,jj))-cp
              82     3   p    v            phicor(i,k,jj)= cp-cp*(pk2(i,k,jj)/pk(i,k+1,jj))
              83     3   p    v            elam(i,k)= phi(i,k,jj)-phi(i,k+1,jj)-(tcor(i,k,jj)*tt(i,k,jj) &
              84     3                      +phicor(i,k,jj)*tt(i,k+1,jj))
              85     3   p    v            a(i,k+1)= (tcor(i,k+1,jj)*phicor(i,k,jj)*tweght(k+1)-1.0)     &
              86     3                      *dp(i,k)/dp(i,k+1)
              87     3   p    v            b(i,k)=tcor(i,k,jj)*tcor(i,k,jj)*tweght(k)+1.0                &
              88     3                      +dp(i,k)/dp(i,k+1)*(phicor(i,k,jj)*phicor(i,k,jj)            &
              89     3                      *tweght(k+1)+1.0)
              90     3   p    v            c(i,k)=phicor(i,k,jj)*tcor(i,k+1,jj)*tweght(k+1)-1.0
              91     3   p    v        113 continue
              92     2                 111 continue
              93     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 80, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, sgeo, tcor, b, phi, elam
                                   <<< Loop-information  End >>>
              94     2  pp    v            do 101 i=1,nx
              95     2   p    v            elam(i,lev)= phi(i,lev,jj)-sgeo(i,j)-tcor(i,lev,jj)*tt(i,lev,jj)
              96     2   p    v            b(i,lev)=tcor(i,lev,jj)*tcor(i,lev,jj)*tweght(lev)+1.0
              97     2   p    v        101 continue
              98     1               !
              99     1                     call trdiv2(nx,lev,a,b,c,elam)
             100     1               !
             101     1               !ocl nounroll
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, elam, tcor, phicor, phi, tt
                                   <<< Loop-information  End >>>
             102     2                     do 400 k=2,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 267
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.82, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, phicor, phi, tt, elam, tcor
                                   <<< Loop-information  End >>>
             103     3  pp    v            do 400 i=1,nx
             104     3   p    v            tcor(i,k,jj)=(elam(i,k)*tcor(i,k,jj)*dp(i,k)                &
             105     3                      +elam(i,k-1)*phicor(i,k-1,jj)*dp(i,k-1))*tweght(k)/dp(i,k)
             106     3   p    v            phicor(i,k,jj)=-(elam(i,k)*dp(i,k)-elam(i,k-1)              &
             107     3                      *dp(i,k-1))/dp(i,k)
             108     3   p    v            phi(i,k,jj)= phi(i,k,jj)+phicor(i,k,jj)
             109     3   p    v            tt(i,k,jj)= tt(i,k,jj)+tcor(i,k,jj)
             110     2   p    v        400 continue
             111     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 112, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tcor, phi, tt, elam, phicor
                                   <<< Loop-information  End >>>
             112     2  pp    v            do 510 i=1,nx
             113     2   p    v            tcor(i,1,jj)= elam(i,1)*tcor(i,1,jj)*tweght(1)
             114     2   p    v            phicor(i,1,jj)= -elam(i,1)
             115     2   p    v            phi(i,1,jj)= phi(i,1,jj)+phicor(i,1,jj)
             116     2   p    v            tt(i,1,jj)= tt(i,1,jj)+tcor(i,1,jj)

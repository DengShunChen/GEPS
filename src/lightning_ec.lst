 External subroutine subprogram "lightning_ec"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine lightning_ec                                           &
               2                                      (nxj,klon,klev,ptu,pqu,ztenh,zqenh                     &
               3                                      ,plu,rho,kcbot,kctop,pgeo,papn,pf                  &
               4                                      ,ft,lndj,kuo)
               5                     
               6                     !reference:
               7                     !Lopez P., 2016: A lightning parameterization for the ECMWF Integrated Forecasting System. Mon. Wea. Rev., 144, 3057-3075.
               8                     
               9                     !input-------------------------------------------
              10                     !     nxj:
              11                     !     klon:
              12                     !     klev:
              13                     !     ptu: cloud temperature (K)
              14                     !     pqu: cloud specific humidity (kg/kg)
              15                     !     ztenh: environment temperature (K)
              16                     !     zqenh: environment specific humidity (kg/kg)
              17                     !     plu:convective cloud water (kg/kg)
              18                     !     kcbot: cloud base level
              19                     !     kctop: cloud top level
              20                     !     pgeo: geopotential height (m)
              21                     !     papn: pressure field (hPa)
              22                     !     pf: convective snow flux (kgm^-2s^-1))
              23                     !     rho: air parcel density (kgm-3)
              24                     !output------------------------------------------
              25                     !     ft: flash density (km^2day^-1)
              26                     
              27                     !      use mpe
              28                     !      use rank
              29                           use physcons, only:vtmpc1 => con_fvirt, g => con_g
              30                           use const,    only:RTYPE
              31                     
              32                           implicit none
              33                           integer jl,jk,klev,klon,nxj
              34                           integer kcbot(klon),kctop(klon)
              35                           integer lndj(klon),kuo(klon)
              36                           real    ptu(klon,klev)  ,pqu(klon,klev)                   &
              37                                  ,ztenh(klon,klev),zqenh(klon,klev)                 &
              38                                  ,papn(klon,klev)  ,pf(klon,klev)                   &
              39                                  ,rho(klon,klev),plu(klon,klev), pap(klon,klev)
              40                           real(kind=RTYPE) pgeo(klon,klev)
              41                           real    qgraup(klon,klev),qsnow(klon,klev)
              42                           real,parameter::  vgraup= 3.0, &     ! typical fall speed for graupel (ms^-1)
              43                                             vsnow = 0.5, &     ! typical fall speed for snow (ms^-1)
              44                                             alpha = 32.4
              45                           real    beta,zdz,zdp
              46                           real    charg(klon),           &     !charging rate
              47                                   ft(klon),              &     !lightning flash density (flashes km^-2 day^-1)
              48                                   cape(klon)
              49                     !-------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rho, pf, lndj, papn, pap, qgraup, qsnow
                                   <<< Loop-information  End >>>
              50     1  pp                 do jk = 1,klev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lndj, rho, papn, pf, pap, qgraup, qsnow
                                   <<< Loop-information  End >>>
              51     2   p    v             do jl = 1,nxj
              52     3   p    v               if (lndj(jl) .eq. 1) then
              53     3   p    v                   beta = 0.7    !over land
              54     3   p    v                else
              55     3   p    v                   beta = 0.45   !over ocean or ice
              56     3   p    v               end if
              57     2   p    v               pap(jl,jk) = papn(jl,jk)*100. !mb to Pa
              58     2   p    v               qgraup(jl,jk) = beta*pf(jl,jk)/(rho(jl,jk)*vgraup)
              59     2   p    v               qsnow(jl,jk) = (1-beta)*pf(jl,jk)/(rho(jl,jk)*vsnow)
              60     2   p    v              end do
              61     1   p                  end do
              62                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ft, cape, charg
                                   <<< Loop-information  End >>>
              63        pp   2v             charg = 0.
              64         p   2v             cape = 0.
              65         p   2v             ft = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              66     1  pp                  do jl = 1,nxj
              67     2   p                   if ( kuo(jl) .eq. 1 )then
              68     3   p    s              do jk = 1,klev-1
              69     3               
              70     4   p    m                if (ztenh(jl,jk) .ge. 248.15 .and. ztenh(jl,jk) .le. 273.15) then
              71     4   p    s                  zdz = (pgeo(jl,jk)-pgeo(jl,jk+1))/g
              72     4   p    s                  charg(jl) = charg(jl) + (qgraup(jl,jk)*                     &
              73     4                                       (plu(jl,jk) + qsnow(jl,jk)))*rho(jl,jk)*zdz
              74     4   p    v                end if
              75     3               
              76     4   p    s                if (jk .le. kcbot(jl) .and. jk .gt. kctop(jl)) then
              77     4   p    s                  zdp = pap(jl,jk) - pap(jl,jk-1)
              78     4   p    s                  cape(jl) = cape(jl) +                                       &
              79     4                                ((ptu(jl,jk)-ztenh(jl,jk))/ztenh(jl,jk) +              &
              80     4                                 vtmpc1*(pqu(jl,jk)-zqenh(jl,jk))-plu(jl,jk))*zdp
              81     4   p    v                end if
              82     3   p    v              end do
              83     2   p                   cape(jl) = max(cape(jl),0.)
              84     2   p                   ft(jl) = alpha*charg(jl)*sqrt(cape(jl))*                        &
              85     2                                (min(pgeo(jl,kcbot(jl))/g*1.0e-3,1.8))**2
              86     2   p                    end if
              87     1   p                  end do
              88                     
              89                     !       if (myrank .eq. 0) print*,"maxft=",maxval(ft),   &
              90                     !                                 "minft=",minval(ft)
              91                     !       if (myrank .eq. 0) print*,"maxcape=",maxval(cape),   &
              92                     !                                 "mincape=",minval(cape)
              93                           return
              94                           end subroutine lightning_ec


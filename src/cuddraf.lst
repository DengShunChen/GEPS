               1                     !+ calculates cumulus downdraft descent
               2                     !+ $Id: cuddraf.f90,v 1.5 1998/11/03 14:32:01 m214003 Exp $
               3                     
               4                     !SUBROUTINE cuddraf(klon,klev,klevp1,ptenh,pqenh,puen,pven,&
               5                     SUBROUTINE cuddraf(nxj,klon,klev,klevp1,ptenh,pqenh,puen,pven,&
               6                     &      pgeoh,paphp1,prfl,ptd,pqd,pud,pvd,pmfd,pmfds,pmfdq, &
               7                     &      pdmfdp,lddraf,ed)
               8                     
               9                       ! Description:
              10                       !
              11                       ! Calculates cumulus downdraft descent.
              12                       !
              13                       ! Method:
              14                       !
              15                       ! Produce the vertical profiles for cumulus downdrafts
              16                       ! (i.e. t,q,u and v and fluxes)
              17                       !
              18                       ! This routine is called from *cumastr*.
              19                       ! Input is t,q,p,phi,u,v at half levels.
              20                       ! It returns fluxes of s,q and evaporation rate
              21                       ! and u,v at levels where downdraft occurs
              22                       !
              23                       ! Calculate moist descent for entraining/detraining plume by
              24                       !    a) moving air dry-adiabatically to next level below and
              25                       !    b) correcting for evaporation to obtain saturated state.
              26                       !
              27                       ! *cuadjtq* for adjusting t and q due to evaporation in saturated descent
              28                       !
              29                       ! 1. calculate moist descent for cumulus downdraft by
              30                       !    (a) calculating entrainment rates, assuming
              31                       !        linear decrease of massflux in pbl
              32                       !    (b) doing moist descent - evaporative cooling
              33                       !        and moistening is calculated in *cuadjtq*
              34                       !    (c) checking for negative buoyancy and
              35                       !        specifying final t,q,u,v and downward fluxes
              36                       !
              37                       ! Authors:
              38                       !
              39                       ! M. Tiedtke, ECMWF, in December 1986 and December 1989, original source
              40                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              41                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              42                       !
              43                       ! for more details see file AUTHORS
              44                       !
              45                     
              46                       USE shr_kind_mod, only: r8 => shr_kind_r8
              47                       USE mo_constants,    ONLY: rd,      &! gas constant for dry air
              48                                                  cpd,     &! specific heat at constant pressure
              49                                                  rcpd,    &! rcpd=1./cpd
              50                                                  vtmpc1,  &! vtmpc1=rv/rd-1
              51                                                  g         ! gravity acceleration
              52                       USE mo_cumulus_flux, ONLY: entrdd,  &! entrainment rate for cumulus downdrafts
              53                                                  cmfcmin, &! minimum massflux value (for safety)
              54                                                  lmfdudv   ! true if cumulus friction is switched on
              55                     
              56                       IMPLICIT NONE
              57                     
              58                       !  Scalar arguments with intent(In):
              59                     !  INTEGER, INTENT (IN) :: klon, klev, klevp1
              60                       INTEGER, INTENT (IN) :: klon, nxj, klev, klevp1
              61                     
              62                       !  Array arguments with intent(In):
              63                       REAL(r8), INTENT (IN) :: paphp1(klon,klevp1), pgeoh(klon,klev), pqenh(klon,klev), &
              64                     &                      ptenh(klon,klev), puen(klon,klev), pven(klon,klev)
              65                       LOGICAL, INTENT (IN) :: lddraf(klon)
              66                     
              67                       !  Array arguments with intent(InOut):
              68                       REAL(r8), INTENT (INOUT) :: pdmfdp(klon,klev), pmfd(klon,klev), pmfdq(klon,klev), &
              69                     &                         pmfds(klon,klev),&
              70                     &                         pqd(klon,klev), prfl(klon), ptd(klon,klev), &
              71                     &                         pud(klon,klev), pvd(klon,klev)&
              72                     &                         , ed(klon,klev) !downd draft entrainment
              73                     
              74                       !  Local scalars:
              75                       REAL(r8) :: zbuo, zdmfdp, zentr, zmfdqk, zmfdsk, zmfduk, zmfdvk, zmfdxtk, &
              76                     &      zqdde, zqeen, zsdde, zseen, zxtdde, zxteen
              77                       INTEGER :: icall, ik, is, itopde, jk, jl, jt
              78                       LOGICAL :: llo1
              79                     
              80                       !  Local arrays:
              81                       REAL(r8) :: zcond(klon), zdmfde(klon), zdmfen(klon), zph(klon)
              82                       LOGICAL :: llo2(klon)
              83                     
              84                       !  External subroutines
              85                       EXTERNAL cuadjtq
              86                     
              87                       !  Intrinsic functions
              88                       INTRINSIC MAX, MERGE, MIN
              89                     
              90                       !  Executable statements

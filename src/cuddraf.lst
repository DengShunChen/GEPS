             150     3   p    v              zbuo = ptd(jl,jk)*(1.+vtmpc1*pqd(jl,jk)) - ptenh(jl,jk)*(1.+vtmpc1* &
             151     3               &            pqenh(jl,jk))
             152     3   p    v              llo1 = zbuo < 0. .AND. (prfl(jl)-pmfd(jl,jk)*zcond(jl)>0.)
             153     3   p    v              pmfd(jl,jk) = MERGE(pmfd(jl,jk),0.d0,llo1)
             154     3   p    v              pmfds(jl,jk) = (cpd*ptd(jl,jk)+pgeoh(jl,jk))*pmfd(jl,jk)
             155     3   p    v              pmfdq(jl,jk) = pqd(jl,jk)*pmfd(jl,jk)
             156     3   p    v              zdmfdp = -pmfd(jl,jk)*zcond(jl)
             157     3   p    v              pdmfdp(jl,jk-1) = zdmfdp
             158     3   p    v              prfl(jl) = prfl(jl) + zdmfdp
             159     3   p    v            END IF

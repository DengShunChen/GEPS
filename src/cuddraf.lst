                                   <<<    Standard iteration count: 156
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.24, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmfdq, pqenh, pgeoh, llo2, pqd, ptenh
                                   <<<      zdmfen, zdmfde, pmfds, ptd, pmfd, zcond
                                   <<< Loop-information  End >>>
             123     2  pp    v          DO jl = 1, nxj
             124     3   p    v            IF (llo2(jl)) THEN
             125     3   p    v              pmfd(jl,jk) = pmfd(jl,jk-1) + zdmfen(jl) - zdmfde(jl)
             126     3   p    v              zseen = (cpd*ptenh(jl,jk-1)+pgeoh(jl,jk-1))*zdmfen(jl)
             127     3   p    v              zqeen = pqenh(jl,jk-1)*zdmfen(jl)
             128     3   p    v              zsdde = (cpd*ptd(jl,jk-1)+pgeoh(jl,jk-1))*zdmfde(jl)
             129     3   p    v              zqdde = pqd(jl,jk-1)*zdmfde(jl)
             130     3   p    v              zmfdsk = pmfds(jl,jk-1) + zseen - zsdde
             131     3   p    v              zmfdqk = pmfdq(jl,jk-1) + zqeen - zqdde
             132     3   p    v              pqd(jl,jk) = zmfdqk*(1./MIN(-cmfcmin,pmfd(jl,jk)))
             133     3   p    v              ptd(jl,jk) = (zmfdsk*(1./MIN(-cmfcmin,pmfd(jl,jk)))-pgeoh(jl,jk))* &
             134     3               &            rcpd
             135     3   p    v              ptd(jl,jk) = MIN(400.,ptd(jl,jk))
             136     3   p    v              ptd(jl,jk) = MAX(100.,ptd(jl,jk))
             137     3   p    v              zcond(jl) = pqd(jl,jk)
             138     3   p    v            END IF
             139     2   p    v          END DO
             140     1               
             141     1                   ik = jk

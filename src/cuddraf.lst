             143     1               !    CALL cuadjtq(klon,klev,ik,zph,ptd,pqd,llo2,icall)
             144     1                   CALL cuadjtq(nxj,klon,klev,ik,zph,ptd,pqd,llo2,icall)
             145     1               
             146     1               !    DO jl = 1, klon

                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              95     2  pp    v          DO jl = 1, nxj
              96     2   p    v            zph(jl) = paphp1(jl,jk)
              97     2   p    v            llo2(jl) = lddraf(jl) .AND. pmfd(jl,jk-1) < 0.
              98     2   p    v            is = is + MERGE(1,0,llo2(jl))
              99     2   p    v          END DO
             100     1                   IF (is==0) CYCLE
             101     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paphp1, ptenh, pmfd, llo2, zdmfde
                                   <<<      zdmfen
                                   <<< Loop-information  End >>>
             102     2  pp    v          DO jl = 1, nxj
             103     3   p    v            IF (llo2(jl)) THEN
             104     3   p    v              zentr = entrdd*pmfd(jl,jk-1)*rd*ptenh(jl,jk-1)/(g*paphp1(jl,jk-1))* &
             105     3               &            (paphp1(jl,jk)-paphp1(jl,jk-1))
             106     3   p    v              zdmfen(jl) = zentr
             107     3   p    v              zdmfde(jl) = zentr
             108     3   p    v            END IF
             109     2   p    v          END DO
             110     1                   itopde = klev - 2
             111     2                   IF (jk>itopde) THEN
             112     2               !      DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 381
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paphp1, pmfd, llo2, zdmfen, zdmfde
                                   <<< Loop-information  End >>>
             113     3  pp    v            DO jl = 1, nxj
             114     4   p    v              IF (llo2(jl)) THEN
             115     4   p    v                zdmfen(jl) = 0.
             116     4   p    v                zdmfde(jl) = pmfd(jl,itopde)*(paphp1(jl,jk)-paphp1(jl,jk-1))/ &
             117     4               &              (paphp1(jl,klevp1)-paphp1(jl,itopde))
             118     4   p    v              END IF
             119     3   p    v            END DO
             120     2                   END IF
             121     1               
             122     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>

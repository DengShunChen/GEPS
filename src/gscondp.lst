               1                           subroutine gscondp (im,ix,km,dt,prsl,ps,q,cwm,t &
               2                           ,                  tp, qp, psp, tp1, qp1, psp1 &
               3                           ,                  u,deltaq, sup, lprnt, kdt)
               4                     !
               5                     !     ******************************************************************
               6                     !     *                                                                *
               7                     !     *  subroutine for grid-scale condensation & evaporation          *
               8                     !     *  for the mrf model at ncep.                                    *
               9                     !     *                                                                *
              10                     !     ******************************************************************
              11                     !     *                                                                *

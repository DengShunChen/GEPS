              18                     !     ******************************************************************
              19                     !----------------------------------------------------------------------
              20                     !----------------------------------------------------------------------
              21                     !
              22                     !      use namelist_def, only: nsdfi,fhdfi
              23                     
              24                           implicit none
              25                           real  psat, hvap, grav, hfus, ttp, rd, rv, cp, eps, epsm1, thgni
              26                           parameter(  psat = 6.1078e+2 )
              27                           parameter(  hvap = 2.5000e+6 )
              28                           parameter(  grav = 9.80665e+0 )
              29                           parameter(  hfus = 3.3358e+5 )
              30                           parameter(   ttp = 2.7316e+2 )
              31                           parameter(    rd = 2.8705e+2 )
              32                           parameter(    rv = 4.6150e+2 )
              33                           parameter(    cp = 1.0046e+3 )
              34                           parameter(   eps = rd/rv )
              35                           parameter( epsm1 = eps-1 )
              36                           parameter( thgni = -38.15 )
              37                           real fpvs
              38                     !
              39                           real                    g,    h1,   h2, h1000                  &
              40                           ,                     d00,  d125,  d5,   elwv, eliv            &
              41                           ,                     epsq, tm10,  eliw, arcp                  &
              42                           ,                     a1,   r,     cpr,  rcpr, rcp
              43                           parameter (h1=1.e0,       h2=2.e0,               h1000=1000.0  &
              44                           ,          d00=0.e0,      d125=.125e0,           d5=0.5e0      &
              45                           ,          a1=psat                                             &
              46                           ,          elwv=hvap,     eliv=hvap+hfus, g=grav               &
              47                           ,          epsq=2.e-12,   tm10=ttp-10.,   r=rd &
              48                           ,          cpr=cp*r,      rcpr=h1/cpr,    rcp=h1/cp)
              49                     !
              50                           real, parameter :: cons_0=0.0, cons_m15=-15.0
              51                     !
              52                           integer im, ix, km
              53                           real                  q(ix,km),    t(ix,km),    cwm(ix,km)     &
              54                     !      ,                     prsl(ix,km), ps(im), dt,  dtf &
              55                           ,                     prsl(ix,km), ps(im), dt                  &
              56                           ,                     tp(ix,km),   qp(ix,km),   psp(im)        &
              57                           ,                     tp1(ix,km),  qp1(ix,km),  psp1(im)       &
              58                           ,                     deltaq(ix,km),deltaqik
              59                            real                 qtmp,qwtmp,qtpd,qsc,usc
              60                            real, intent(in) ::  sup
              61                            logical iice
              62                     
              63                     !
              64                           real                   qi(im), qint(im), u(ix,km), ccrik, e0   &
              65                           ,                      cond,   rdt, us, cclimit, climit        &
              66                           ,                      u00b,   u00t, tmt0, tmt15, qik, cwmik   &
              67                           ,                 ai, bi, qw(im,km), u00ik, tik, pres, pp0, fi &
              68                           ,                      at, aq, ap, fiw, elv, qc, rqik          &
              69                           ,                      rqikk, tx1, tx2, tx3, es, qs            &
              70                           ,                      tsq, delq, condi, cone0, us00, ccrik1   &
              71                           ,                      aa, ab, ac, ad, ae, af, ag              &
              72                           ,                      el2orc, albycp, vprs(im)
              73                           integer iw(im,km), i, k, iwik, kdt
              74                           logical lprnt
              75                     !
              76                     !-----------------prepare constants for later uses-----------------
              77                     !
              78                     
              79                           el2orc = hvap*hvap / (rv*cp)
              80                           albycp = hvap / cp
              81                     !
              82                           rdt     = h1/dt
              83                           us      = h1
              84                           cclimit = 1.0e-3
              85                           climit  = 1.0e-20
              86                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      iw
                                   <<< Loop-information  End >>>
              87     1  pp   4             do  i = 1, im
              88     1   p   4               iw(i,km) = d00
              89     1   p   4             enddo
              90                     !  the global qsat computation is done in Pa
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
              91     1                     do i = 1, im
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.30, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
              92     2   m                 do k = 1, km
              93     2   p                     pres  = prsl(i,k)*h1000
              94     2   m                     qwtmp = min(pres, fpvs(t(i,k)))
              95     2   p                     qw(i,k) = eps * qwtmp / (pres + epsm1 * qwtmp)
              96     2   p                     qw(i,k) = max(qw(i,k),epsq)
              97     2   p                 enddo
              98     1                     enddo
              99                     !      if (tp(1,1) .lt. 1.) then
             100                     !        do k = 1, km
             101                     !          do i = 1, im
             102                     !            tp(i,k) = t(i,k)
             103                     !            qp(i,k) = max(q(i,k),epsq)
             104                     !            tp1(i,k) = t(i,k)
             105                     !            qp1(i,k) = max(q(i,k),epsq)
             106                     !          enddo
             107                     !        enddo
             108                     !        do i = 1, im
             109                     !          psp(i)  = ps(i)
             110                     !          psp1(i) = ps(i)
             111                     !        enddo
             112                     !        do k = 1, km
             113                     !          do i = 1, im
             114                     !            deltaq(i,k) = (1-u(i,k))*qw(i,k)
             115                     !          enddo
             116                     !        enddo
             117                     !      endif
             118     1                     if(kdt == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, tp, tp1, qp1, qp
                                   <<< Loop-information  End >>>
             119     2  pp                   do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, tp, qp, tp1, qp1
                                   <<< Loop-information  End >>>
             120     3   p   2                 do i = 1, im
             121     3   p   2                   tp(i,k) = t(i,k)
             122     3   p   2                   qp(i,k) = max(q(i,k),epsq)
             123     3   p   2                   tp1(i,k) = t(i,k)
             124     3   p   2                   qp1(i,k) = max(q(i,k),epsq)
             125     3   p   2                 enddo
             126     2   p                   enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, psp, psp1
                                   <<< Loop-information  End >>>
             127     2  pp   2               do i = 1, im
             128     2   p   2                 psp(i)  = ps(i)
             129     2   p   2                 psp1(i) = ps(i)
             130     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u, qw, deltaq
                                   <<< Loop-information  End >>>
             131     2  pp                   do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 20, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u, deltaq, qw
                                   <<< Loop-information  End >>>
             132     3   p   2                 do i = 1, im
             133     3   p   2                   deltaq(i,k) = (1-u(i,k))*qw(i,k)
             134     3   p   2                 enddo
             135     2   p                   enddo
             136     1                     endif
             137                     !
             138                     !c*************************************************************
             139                     !c*******begining of  grid-scale condensation/evap. loop*******
             140                     !c*************************************************************
             141                     !
             142                     !     do k = km-1,2,-1
             143     1                     do k = km,1,-1
             144     1               !       vprs(:) = fpvs(t(:,k))       ! fpvs in pa
             145     1               !c-----------------------------------------------------------------------
             146     1               !c------------------qw, qi and qint--------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 220
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, qw, q, cwm, deltaq, qi, qint
                                   <<< Loop-information  End >>>
             147     2  pp                   do i = 1, im
             148     2   p                     tmt0  = t(i,k)-273.16
             149     2   p                     tmt15 = min(tmt0,cons_m15)
             150     2   p                     qik   = max(q(i,k),epsq)
             151     2   p                     cwmik = max(cwm(i,k),climit)
             152     2   p                     deltaqik = deltaq(i,k)
             153     2   p                     qi(i)   = qw(i,k)
             154     2   p                     qint(i) = qw(i,k)
             155     2               !         if (tmt0 .le. -40.) qint(i) = qi(i)
             156     2               !c-------------------ice-water id number iw------------------------------
             157     3   p                     if(tmt0 < -15.0) then
             158     3   p                       u00ik = u(i,k)
             159     3   p                       fi = qik + deltaqik -qi(i)
             160     4   p                       if(fi > d00.or.cwmik > climit) then
             161     4   p                          iw(i,k) = 1
             162     4   p                       else
             163     4   p                         iw(i,k) = 0
             164     4   p                       end if
             165     3   p                     end if
             166     2               !
             167     3   p                     if(tmt0 >= 0.0) then
             168     3   p                       iw(i,k) = 0
             169     3   p                     end if
             170     2               !
             171     3   p                     if (tmt0 < 0.0 .and. tmt0 >= -15.0) then
             172     3   p                       iw(i,k) = 0
             173     4   p                       if (k < km) then
             174     4   p                       if (iw(i,k+1) == 1 .and. cwmik > climit) iw(i,k) = 1
             175     4   p                       endif
             176     3   p                     end if
             177     2   p                   enddo
             178     1               !c--------------condensation and evaporation of cloud--------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, cwm, prsl, u, deltaq, psp1, ps
                                   <<<      tp1, qp1, iw, qint, qi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 7  FILL 14
                                   <<<      SIMD&FP   : SPILL 19  FILL 34
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             179     2   s                   do i = 1, im
             180     2               !c------------------------at, aq and dp/dt-------------------------------
             181     2   p                     qik   = max(q(i,k),epsq)
             182     2   p                     cwmik = max(cwm(i,k),climit)
             183     2   p                     iwik  = iw(i,k)
             184     2   p                     u00ik = u(i,k)
             185     2   p                     iice = .false.
             186     2   p                     deltaqik = deltaq(i,k)
             187     2   p                     tik   = t(i,k)
             188     2   p                     pres  = prsl(i,k) * h1000
             189     2   p                     pp0   = (pres / ps(i)) * psp1(i)
             190     2   p                     at    = (tik-tp1(i,k)) * rdt
             191     2   p                     aq    = (qik-qp1(i,k)) * rdt
             192     2   p                     ap    = (pres-pp0)    * rdt
             193     3   p                     if(tik - 273.16 < thgni) then  ! has to be consistent with radiation
             194     3   p                       iice = .true.
             195     3   p                     endif
             196     2               !c----------------the satuation specific humidity------------------------
             197     2   p                     fiw   = float(iwik)
             198     2   p                     elv   = (h1-fiw)*elwv    + fiw*eliv
             199     2   p                     qc    = (h1-fiw)*qint(i) + fiw*qi(i)
             200     2               !     if (lprnt) print *,' qc=',qc,' qint=',qint(i),' qi=',qi(i)
             201     2               !c----------------the relative humidity----------------------------------
             202     3   p                     if(qc <= 1.0e-10) then
             203     3   p                       rqik=d00
             204     3   p                     else
             205     3   p                       rqik = qik/qc
             206     3   p                     endif
             207     3   p                     if(iice) then
             208     3   p                       qsc = qc * sup
             209     3   p                       usc = sup
             210     3   p                     else
             211     3   p                       qsc = qc
             212     3   p                       usc = us
             213     3   p                     endif
             214     2               !c----------------cloud cover ratio ccrik--------------------------------
             215     3   p                      if(rqik >= usc) then
             216     3   p                         ccrik = us
             217     3   p                      else
             218     3   p                         qtmp = qik + cwmik -qsc
             219     4   p                         if(deltaqik > epsq) then
             220     5   p                           if(qtmp <= -deltaqik) then
             221     5   p                             ccrik = d00
             222     5   p                           elseif(qtmp >= deltaqik) then
             223     5   p                             ccrik = us
             224     5   p                           else
             225     5   p                             ccrik = 0.5 * qtmp / deltaqik + 0.5
             226     5   p                             ccrik = max(ccrik, 0.)
             227     5   p                             ccrik = min(ccrik, 1.)
             228     5   p                           endif
             229     4   p                         else
             230     5   p                           if(qtmp > 0.) then
             231     5   p                             ccrik = us
             232     5   p                           else
             233     5   p                             ccrik = d00
             234     5   p                           endif
             235     4   p                         endif
             236     3   p                      endif
             237     2               !c-----------correct ccr if it is too small in large cwm regions--------
             238     2               !         if(ccrik.ge.0.01.and.ccrik.le.0.2.and
             239     2               !    &          .cwmik.ge.0.2e-3) then
             240     2               !          ccrik=min(1.0,cwmik*1.0e3)
             241     2               !         end if
             242     2               !c----------------------------------------------------------------------
             243     2               !   if no cloud exists then evaporate any existing cloud condensate
             244     2               !c----------------evaporation of cloud water-----------------------------
             245     2   p                     e0 = d00
             246     3   p                     if (ccrik <= cclimit.and.cwmik > climit) then
             247     3               !
             248     3               !   first iteration - increment halved
             249     3               !
             250     3   s                       tx1 = tik
             251     3   p                       tx3 = qik
             252     3               
             253     3   s                       es   = min(pres, fpvs(tx1))
             254     3   s                       qs   = eps * es / (pres + epsm1*es)
             255     4   s                       if(qs < cons_0) then
             256     4   s                         print*, 'warning : qs - deltaqik < 0.0'
             257     4   s                         print*, 'qs, deltaqik:',qs,deltaqik
             258     4   p                       endif
             259     3   s                       tsq  = tx1 * tx1
             260     3   s                       delq = 0.5*(qs-deltaqik-tx3)*tsq / (tsq + el2orc*qs)
             261     3               !
             262     3   p                       tx2   = delq
             263     3   s                       tx1   = tx1 - delq * albycp
             264     3   s                       tx3   = tx3 + delq
             265     3               !
             266     3               !   second iteration
             267     3               !
             268     3   s                       es   = min(pres, fpvs(tx1))
             269     3   s                       qs   = eps * es / (pres + epsm1*es)
             270     4   s                       if(qs < cons_0) then
             271     4   s                         print*, 'warning : qs - deltaqik < 0.0'
             272     4   s                         print*, 'qs, deltaqik:',qs,deltaqik
             273     4   p                       endif
             274     3   s                       tsq  = tx1 * tx1
             275     3   s                       delq = (qs-deltaqik-tx3)*tsq / (tsq + el2orc * qs)
             276     3               !
             277     3   p                       tx2  = tx2 + delq
             278     3   s                       tx1  = tx1 - delq * albycp
             279     3   p                       tx3  = tx3 + delq
             280     3               !
             281     3               !   third iteration
             282     3               !
             283     3   s                       es   = min(pres, fpvs(tx1))
             284     3   s                       qs   = eps * es / (pres + epsm1*es)
             285     4   s                       if(qs < cons_0) then
             286     4   s                         print*, 'warning : qs - deltaqik < 0.0'
             287     4   s                         print*, 'qs, deltaqik:',qs,deltaqik
             288     4   p                       endif
             289     3   s                       tsq  = tx1 * tx1
             290     3   p                       delq = (qs-deltaqik-tx3)*tsq / (tsq + el2orc * qs)
             291     3               
             292     3   p                       tx2 = tx2 + delq
             293     3               
             294     3   p                       e0 = max(tx2*rdt, cons_0)
             295     3   p                       e0 = min(cwmik*rdt,   e0)
             296     3   p                       e0 = max(cons_0,e0)
             297     3   p                     end if
             298     2               !   if cloud cover > 0.2 condense water vapor in to cloud condensate
             299     2               !c-----------the eqs. for cond. has been reorganized to reduce cpu------
             300     2   p                     cond = d00
             301     2               !         if (ccrik .gt. 0.20 .and. qc .gt. epsq) then
             302     3   p                     if (ccrik > cclimit .and. qc > epsq) then
             303     3   p                        us00   = deltaqik / qc
             304     3   p                        ccrik1 = 1.0 - ccrik
             305     3   p                        aa     = eps*elv*pres*qik
             306     3   p                        ab     = ccrik*ccrik1*deltaqik
             307     3   p                        ac     = ab + 0.5*cwmik+ 0.5 * ccrik * (qc-qsc)
             308     3   p                        ad     = ab * ccrik1 + 0.5*ccrik*ccrik1*qc*(us-usc)
             309     3   p                        ae     = cpr*tik*tik
             310     3   p                        af     = ae * pres
             311     3   p                        ag     = aa * elv
             312     3   p                        ai     = cp * aa
             313     3   p                        cond   = (ac-ad)*(af*aq-ai*at+ae*qik*ap)/(ac*(af+ag))
             314     3               !c-----------check & correct if over condensation occurs-----------------
             315     3   p                        condi  = (qik   -u00ik   *qc*1.0)*rdt
             316     3   p                        cond   = min(cond, condi)
             317     3               !c----------check & correct if supersatuation is too high----------------
             318     3               !             qtemp=qik-max(0.,(cond-e0))*dt
             319     3               !             if(qc.le.1.0e-10) then
             320     3               !               rqtmp=0.0
             321     3               !             else
             322     3               !               rqtmp=qtemp/qc
             323     3               !             end if
             324     3               !             if(rqtmp.ge.1.10) then
             325     3               !               cond=(qik-1.10*qc)*rdt
             326     3               !             end if
             327     3               !c-----------------------------------------------------------------------
             328     3   p                        cond = max(cond, d00)
             329     3               !c-------------------update of t, q and cwm------------------------------
             330     3   p                     end if
             331     2   p                     cone0    = (cond-e0) * dt
             332     2   p                     cwm(i,k) = cwm(i,k) + cone0
             333     2               !     if (lprnt .and. i .eq. ipr) print *,' t=',t(i,k),' cone0',cone0
             334     2               !    &,' cond=',cond,' e0=',e0,' elv=',elv,' rcp=',rcp,' k=',k
             335     2               !    &,' cwm=',cwm(i,k)
             336     2   p                     t(i,k)   = t(i,k)   + elv*rcp*cone0
             337     2   p                     q(i,k)   = q(i,k)   - cone0
             338     2   p                   enddo                                  ! end of i-loop!
             339     1                     enddo                                    ! end of k-loop!
             340                     !
             341                     !*********************************************************************
             342                     !****************end of the condensation/evaporation loop*************
             343                     !*********************************************************************
             344                     !
             345                     !----------------store t, q, ps for next time step
             346                     
             347                     !      if (dt > dtf+0.001) then     ! three time level

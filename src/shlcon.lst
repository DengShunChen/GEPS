              71                                    ,tlclx(im),plclx(im),hhx(im,lm),pokx(im,lm)
              72                     ! for new kcu
              73                           real      tlcl(im),plcl(im),zlcl(im),telcl(im),rcup(im)
              74                           integer   klcl(im),klfc(im),klcl0(im)
              75                     !
              76                           real      tmp1(im)
              77                     !
              78                           integer nshl,kmax,nxlev,i,k,itt,ii,kclb,ktpmin,ktp,ka,kc,ntrac
              79                           real    ptop,hltm,xkapa,cp,r,g,dt,hlcl,xkapa1,rh,xlog10,fac
              80                           real    tdp,tsx,aln10,p_lcl,ddd,cc,zhig,dhh,www,xsc1,xsc2,tp1,hhu
              81                           real    hhl,wkl,zzl,ddp
              82                     
              83                           data hlcl / 200.0 /
              84                     !
              85                           nshl = 0
              86                           xkapa1 = 1.0/xkapa
              87                           kmax = lev - ktshl + 1
              88                           nxlev = nx * lev

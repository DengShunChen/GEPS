               1                           subroutine shlcon ( nxj,nx,lev,ktshl,dt,g,r,cp,xkapa,hltm,ptop,dsigma &
               2                                             , tg,pok,pst,topo,phi,po,tt,qt,nshl,rcup,ncld )
               3                     !
               4                     !     shallow convection parameterization, vertical mixing of t and q
               5                     !     (following hogen et al., 1990, tiedtke, et al., 1988)
               6                     !
               7                     !     c.-s. liou  april 1992
               8                     !     modify to f90 by C-H Lee and sort by River Chen in 2015
               9                     !
              10                     !     conditions for shallow convection:
              11                     !     (1) tg       > t surface air (ts)
              12                     !     (2) rh(lev)   > 0.8
              13                     !     (3) surface lcl is within lowest 200 mb of the atmosphere
              14                     !     (4) the atmosphere is moist unstable somewhere in lowest 200 mb
              15                     !
              16                     !     mixing coef.:
              17                     !     xsc = 10.0 m2/s,  from surface to active cloud layer top
              18                     !     xsc = 2.0  m2/s,  at layer just above the cloud top (inversion)
              19                     !     xsc = 0.0      ,  elsewhere
              20                     !
              21                     !     parameters:
              22                     !
              23                     !     nx : horizontal dimension
              24                     !    lev : vertical dimension
              25                     !  ktshl : highest sigma level allowed for shallow convection
              26                     !     dt : time step for shallow convection adjustment
              27                     !      g : gravity
              28                     !      r : gas constant
              29                     !     cp : heat specific of air
              30                     !  xkapa : r/cp
              31                     !   hltm : constant of latent heat release for water vaper
              32                     !   ptop : model top pressure (mb),
              33                     !   dsigma : sigma level thickness (lev),
              34                     !     tg : ground surface temperature (nx),                 (k)
              35                     !    pst : (terrain pressure - ptop) (nx),                  (mb)
              36                     !    pok : odd level pressure**kapa (nx,lev),               (mb)
              37                     !   topo : terrain geopotential (nx),                       (m2/s2)
              38                     !    phi : geopotential on odd levels                       (m2/s2)
              39                     !     po : odd level pressure (nx,lev),                     (mb)
              40                     !     tt : real temperature on odd levels (nx,lev),         (k)
              41                     !     qt : specific humidity on odd levels (nx,lev),        (kg/kg)
              42                     !   nshl : total shallow convection active points
              43                     !
              44                     !  local work arrays
              45                     !
              46                     !    xsc : mixing coef. due to shallow convection (nx,lev)  (m2/s2)
              47                     !
              48                     
              49                           use paramt
              50                           use const, only: RTYPE
              51                     
              52                           implicit  none
              53                     
              54                           integer   nxj,nx,lev,ktshl,ncld
              55                     
              56                           real      tg(nx),po(nx,lev)                                   &
              57                                   , ql(nx,lev),ttmp(nx)
              58                           real(kind=RTYPE) tt(nx,lev),qt(nx,lev*ncld),phi(nx,lev)       &
              59                                   ,        topo(nx),pst(nx),dsigma(lev,2),pok(nx,lev)
              60                     !
              61                     !     local work arrays
              62                     !
              63                           logical cld(im)
              64                     !
              65                           real      xsc(im,lm),ps(im),aa(im,lm,4)                       &
              66                                   , ts(im),wk(im),pp(im),zz(im),hh(im)

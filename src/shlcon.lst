 External subroutine subprogram "theta_e"
  (inc)(line-no.)(nest)(optimize)
             490                     
             491                     
             492                             subroutine theta_e(nx,lev,p,t,q,thetae)
             493                     !***********************************************************************
             494                     ! file name        : theta_e.f                                         *
             495                     !                                                                      *
             496                     ! description      : To derive equivalent potential temperature.       *
             497                     !                                                                      *
             498                     ! data file        : none                                              *
             499                     !                                                                      *
             500                     ! I/O parameters   :                                                   *
             501                     !                                                                      *
             502                     !  input:
             503                     !          p(nx,lev)  real        pressure(hPa).                       *
             504                     !          t(nx,lev)  real        temperature(K).                      *
             505                     !          q(nx,lev) real         specific humility (g/g)              *
             506                     !                                                                      *
             507                     !  output:
             508                     !          thetae(nx,lev) real    equivalent potential temperature(K). *
             509                     !
             510                     ! inter. parameter :                                                   *
             511                     !          p0         real        1000. hPa pressure.                  *
             512                     !          theta      real        potential temperature(K).            *
             513                     !          rgas       real        gas constant for dry air.            *
             514                     !          cp         real        specific heat of dry air at constant *
             515                     !                                 pressure.                            *
             516                     !          aslon      real        constant, = 0.622                    *
             517                     !                                                                      *
             518                     ! called fun./sub. : none                                              *
             519                     !                                                                      *
             520                     !                                                                      *
             521                     ! reference        : Bolton,D., 1980: The computation of equivalent    *
             522                     !                    potential temperature. MOn. Wea. Rev., 108,       *
             523                     !                    1046-1053.                                        *
             524                     !                                                                      *
             525                     ! auther           : Deng Shiung Ming                                  *
             526                     !                    - Institude for Information Industry              *
             527                     !
             528                     ! create date      : Jul. 31, 1994                                     *
             529                     !----------------------------------------------------------------------*
             530                     ! modified by      :  Chin-Tzu Fong                                    *
             531                     ! modified date    :  Apr. 25, 1995                                    *
             532                     ! modified reason  :  Fit into the structure of GFS                    *
             533                     ! modify to f90 by C-H Lee and sort by River Chen
             534                     !***********************************************************************
             535                     
             536                             parameter( p0=1000.,rgas=287.,cp=1004.,aslon=0.622 )
             537                             dimension p(nx,lev),t(nx,lev),q(nx,lev),thetae(nx,lev)
             538                             dimension td(nx,lev)
             539                     !
             540                             dimension tmp1(nx,lev),tmp2(nx,lev),tmp3(nx,lev)
             541                     !
             542                     !* To compute dew-point temperature
             543                     
             544                     !       do 50 i = 1, nx*lev
             545                     
             546                     !* To compute vapor pressure from specific humidity.
             547                     
             548                     !       p_td=q(i,1)*p(i,1)/(aslon+q(i,1)*(1.-aslon))
             549                     
             550                     !* To derive dew-point temperature from vapor pressure.
             551                     
             552                     !       rlog=log(p_td/6.112)
             553                     !       td(i,1)=243.5*rlog/(17.67-rlog) + 273.15
             554                     ! 50    continue
             555                     !
             556                     !       do 100 k = 1, lev
             557                     !       do 100 i = 1, nx
             558                     
             559                     !* To compute potential temperature.
             560                     
             561                     !       theta=t(i,k)*(p0/p(i,k))**(rgas/cp)
             562                     
             563                     !* To compute isentropic condensation temperature.
             564                     
             565                     !       tc=1./(1./(td(i,k)-56.)+log(t(i,k)/td(i,k))/800.)+56.
             566                     
             567                     !* To compute mixing ratio.
             568                     
             569                     !       tdz=td(i,k)-273.15
             570                     !       p_w=6.112*exp(17.67*tdz/(tdz+243.5))
             571                     !       w=aslon*p_w/(p(i,k)-p_w)
             572                     
             573                     !* To compute equivalent potential temperature.
             574                     
             575                     !       if( p(i,k).gt.100. )then
             576                     !         thetae(i,k)=theta*exp(2675.*w/tc)
             577                     !       else
             578                     !         thetae(i,k)=theta
             579                     !       endif
             580                     ! 100   continue
             581                     !---
             582                     
             583                     !* To compute dew-point temperature
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.46, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, p, td
                                   <<< Loop-information  End >>>
             584     1  pp   2v            do i=1,nx*lev
             585     1   p   2v              p_td=q(i,1)*p(i,1)/(aslon+q(i,1)*(1.-aslon))
             586     1   p   2v              td(i,1)=p_td/6.112
             587     1   p   2v            enddo
             588                           call vlog(td,td,nx*lev)
             589                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 590,598)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.28, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      td, p, tmp1
                                   <<< Loop-information  End >>>
             590     1  pp   2v            do 50 i = 1, nx*lev
             591     1               !       p_td=q(i,1)*p(i,1)/(aslon+q(i,1)*(1.-aslon))
             592     1               !       rlog=log(p_td/6.112)
             593     1   p   2v              rlog=td(i,1)
             594     1   p   2v              td(i,1)=243.5*rlog/(17.67-rlog) + 273.15
             595     1   p   2v        50  continue
             596                     
             597                     !* To compute potential temperature.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             598     1                     do i=1,nx*lev
             599     1                       tmp1(i,1)=p0/p(i,1)
             600     1                      enddo
             601                           call vlog(tmp1,tmp1,nx*lev)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      td, tmp1, t, tmp3, tmp2
                                   <<< Loop-information  End >>>
             602     1  pp    v            do i=1,nx*lev
             603     1   p    v              tmp1(i,1)=(rgas/cp)*tmp1(i,1)
             604     1   p    v              tmp2(i,1)=t(i,1)/td(i,1)
             605     1   p    v              tdz=td(i,1)-273.15
             606     1   p    v              tmp3(i,1)=(17.67*tdz/(tdz+243.5))
             607     1   p    v            enddo
             608                           call vexp(tmp1,tmp1,nx*lev)
             609                           call vlog(tmp2,tmp2,nx*lev)
             610                           call vexp(tmp3,tmp3,nx*lev)
             611                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 40
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp3, tmp2, p, tmp1, t, td, thetae
                                   <<< Loop-information  End >>>
             612     1  pp    v            do 100 i = 1, nx*lev
             613     1               !       theta=t(i,1)*(p0/p(i,1))**(rgas/cp)
             614     1               !       tc=1./(1./(td(i,1)-56.)+log(t(i,1)/td(i,1))/800.)+56.
             615     1               !       tdz=td(i,1)-273.15
             616     1               !       p_w=6.112*exp(17.67*tdz/(tdz+243.5))
             617     1   p    v              theta=t(i,1)*tmp1(i,1)
             618     1   p    v              tc=1./(1./(td(i,1)-56.)+tmp2(i,1)/800.)+56.
             619     1   p    v              p_w=6.112*tmp3(i,1)
             620     1   p    v              w=aslon*p_w/(p(i,1)-p_w)
             621     2   p    v              if( p(i,1).gt.100. )then
             622     2   p    v                thetae(i,1)=theta*exp(2675.*w/tc)
             623     2   p    v              else
             624     2   p    v                thetae(i,1)=theta
             625     2   p    v              endif
             626     1   p    v        100 continue
             627                     !
             628                             return
             629                             end


               1                           subroutine postq ( nxj,nx,lev,ncld,dsigma,pt,q,qbarrw,cosl )
               2                     
               3                           implicit  none
               4                           integer   nxj,nx,lev,ncld
               5                           real      cosl,qmin
               6                           real      q(nx,lev*ncld),dsigma(lev,2),pt(nx),qbarrw(ncld)
               7                           data qmin/1.0e-10/
               8                     
               9                           integer   k,n,kk,i,klev
              10                           real      fac,dsigp
              11                     !
              12     1                     do 10 k = 1,lev-1
              13     2                     do 15 n=1,ncld
              14     2                       kk=(n-1)*lev+k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]

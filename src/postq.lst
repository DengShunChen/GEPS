              15     3  pp    s            do 20 i = 1,nxj
              16     4   p    m              if (q(i,kk).lt.qmin)  then
              17     4   p    s              fac= (dsigma(k  ,1)*pt(i)+dsigma(k  ,2))/   &
              18     4                            (dsigma(k+1,1)*pt(i)+dsigma(k+1,2))
              19     4   p    s                q(i,kk+1) = q(i,kk+1)+fac*q(i,kk)-qmin
              20     4   p    s                q(i,kk) = qmin
              21     4   p    v              endif
              22     3   p    v       20   continue
              23     2                15   continue
              24     1                10   continue
              25                     !
              26     1                     do n=1,ncld
              27     1                       klev=(n-1)*lev+lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<< Loop-information  End >>>
              28     2  pp    s            do 30 i = 1,nxj
              29     3   p    m              if (q(i,klev).lt.qmin)  then
              30     3   p    s                dsigp = dsigma(lev,1)*pt(i)+dsigma(lev,2)
              31     3   p    s                qbarrw(n) = qbarrw(n)+dsigp*(qmin-q(i,klev))*cosl
              32     3   p    s                q(i,klev) = qmin
              33     3   p    v              endif

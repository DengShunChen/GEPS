              91                           character*10 fulldtg,Wfulldtg
              92                           character*80 filist
              93                           character cdtg*12
              94                           character*80 pathname,logicname,truefile
              95                           character*64 type_r,type_w,argument
              96                           integer istat4,istat5,istat6,istat7
              97                     
              98                           data pathname/'NWPETCGLB'/
              99                           data logicname/'filist'/
             100                     
             101                     
             102                           namelist /filst/ ifilin,cwbout,bckfile,namlsts &
             103                                          , ifilout,crdate,ocards,phyout,cntrl &
             104                                          , ifilin_ncep, ifilin_sst, ifilin_nc &
             105                                          , ifilin_ClmANA,ifilin_ClmFCT,ifilout_grb
             106                     

             108                     
             109                           namelist /stochy_physics/ ncep_seeds, &
             110                                        use_zmtnblck, &
             111                                        sppt, sppt_seed, sppt_decort, sppt_lscale, &
             112                                        sppt_sigtop1, sppt_sigtop2, sppt_sigbot1, sppt_sigbot2, &
             113                                        sppt_sfclimit, sppt_logit, &
             114                                        shum, shum_seed, shum_decort, shum_lscale, &
             115                                        shum_sigefold, &
             116                                        skeb, skeb_seed, skeb_decort, skeb_lscale, &
             117                                        skeb_sigtop1, skeb_sigtop2, skeb_sigbot1, skeb_sigbot2, &
             118                                        skeb_vdof, skebnorm, skebfilt, &
             119                                        ssst, ssst_seed, ssst_decort, ssst_lscale
             120                           namelist /grb_conf/ grbmem,grbnumm
             121                     
             122                     ! for ECHAM4 Tiedtke cumulus scheme
             123                           call cuparam
             124                           call inicon
             125                           call set_lookup_tables
             126                     
             127                           capa= 1.0/3.5
             128                           rgas= capa*cp
             129                           pi  = 4.0*atan(1.0)
             130                           radsq= rad*rad
             131                     !
             132                           call gpvs
             133                     !----------------------------------------------------------------!
             134                     !
             135                     !  read namlist of path/file name(operation)
             136                     !
             137                           call getfname(pathname,logicname,truefile,istat)
             138     1                     if(istat.ne.0)then
             139     1                       print *,'getfname : error','RANK=',myrank
             140     1                       call mpe_finalize
             141     1                       call dmsexit(-1)
             142     1                     else
             143     1                       if(myrank .eq. 0) print *,truefile
             144     1                     endif
             145                     !
             146                           open (unit=12,file=trim(truefile),form='formatted')
             147                     !!      open (unit=77,file='output.dat',form='formatted')
             148                     !
             149                           read (12,filst,end=110)
             150                     !
             151                       110 continue
             152                           close(12)
             153                     !
             154                           if(myrank .eq. 0) print filst
             155                     !
             156                     !  read namelist for model parameters
             157                     !
             158                           open (unit=1,file=trim(namlsts),form='formatted')
             159                     !
             160                           read (1,modlst,end=120)
             161                       120 continue
             162                           read (1,typ,end=121)
             163                       121 continue
             164                           ! read stochastic_physics
             165                           read (1,stochy_physics,end=122)
             166                       122 continue
             167                           read (1,grb_conf,end=123)
             168                       123 continue
             169                           close(1)
             170                     !
             171                           open (unit=1,file=trim(namlsts),form='formatted')
             172                     
             173     1                     if(do_sit) then
             174     1                       read (1,sit_nml,end=130)
             175     2                       if(myrank .eq. 0) then
             176     2                         print *, 'chlee debug...'
             177     2                         print sit_nml
             178     2                       endif
             179     2                       if(.NOT. ldailyFCTsst)then
             180     2                         print *,'do_sit=.true., auto set: ldailyFCTsst=.true.' &
             181     2                             ,',dailyClm_option=1, check ifilin_sst & ifilin_ClmANA'&
             182     2                             ,'is in filelist.'
             183     2                         ldailyFCTsst=.true.
             184     2                         dailyClm_option=1
             185     2                       endif
             186     1                 130 continue
             187     1                     endif
             188                           close(1)
             189                     
             190                     !
             191                           open (unit=2,file=trim(crdate),form='formatted')
             192                     !
             193                     ! read in idtg*12
             194                           read(2,'(i8.8)')idtg8
             195                           close(2)
             196                     ! transfer idtg8 to idtg*12
             197     1                     if(idtg8.gt.60000000)then
             198     1                       idtg = 190000000000 + idtg8*100
             199     1                     else
             200     1                       idtg = 200000000000 + idtg8*100
             201     1                     endif
             202                     !
             203                           write(cdtg,900)idtg
             204                      900  format(i12.12)
             205                     !
             206                           if(myrank .eq. 0) print*,' dtg=',cdtg
             207                     !-----------------------------------------------------------------------
             208                           read(cdtg,'(i4,i2,i2,i2,i2)') idate(1),idate(2),idate(3),idate(5)&
             209                                                        ,ii
             210                     !-----------------------------------------------------------------------
             211                     !
             212                           call days (cdtg,julian,hours)
             213                     !
             214                           flag =.false.
             215     1                     if(myrank .eq. 0)then
             216     1                       call recmsg('gfs',ifromtau,itotau,istat)
             217     1                       flag =.true.
             218     1                     endif
             219                     !ch   call mpe_broadcast(istat,1,flag,mpe_integer)
             220                           call mpe_bcast(istat,1,0,mpe_integer)
             221                     
             222     1                     if(istat.eq.-1)then
             223     1                       if(myrank.eq.0) print *,'RECMSG ERROR','RANK=',myrank
             224     1                       call mpe_finalize
             225     1                       call dmsexit(-1)
             226     1                     else if(istat.eq.1)then
             227     1                       call mpe_finalize
             228     1                       call dmsexit(0)
             229     1                     endif
             230                     !
             231                     !ch   call mpe_broadcast(ifromtau,1,flag,mpe_integer)
             232                     !ch   call mpe_broadcast(itotau,1,flag,mpe_integer)
             233                           call mpe_bcast(ifromtau,1,0,mpe_integer)
             234                           call mpe_bcast(itotau,1,0,mpe_integer)
             235                     !
             236                           taui=float(ifromtau)
             237                           taue=float(itotau)
             238                           tauo=float(itotau)+0.000001
             239                     !
             240                           tau   = 0.0
             241                           restrt=.false.
             242     1                     if (taui.gt.0.0)  then
             243     1                       itaui=ifromtau
             244     1                       itau= int(taui) + 0.001
             245     1                       itau= min(itau,itaui)
             246     1                       taui= float(itau)
             247     1                       restrt=.true.
             248     1                       if(myrank .eq. 0) print*,' restarting at tau=',itau
             249     1                       hours = hours+taui
             250     1                       julian= julian+hours/24.0+0.001
             251     1                       hours = mod(hours,24.)
             252     1                     endif
             253                     !
             254                           if(myrank .eq. 0) print modlst
             255                           if(myrank .eq. 0) print typ
             256                           if(myrank .eq. 0) print stochy_physics
             257                     !
             258     1                     if (taui .ge. taue)  then
             259     1                       if(myrank .eq. 0)  &
             260     1                        print *,'******** aborting run, taui.ge.taue ******* '
             261     1                       stop
             262     1                     endif
             263                     
             264                     !
             265                     !  build pointer arrays for locating zonal and total wavenumber
             266                     !  values in the one-dimensional spherical harmonic arrays.
             267                     !
             268                     !  original allocation system only for spectral space
             269                     !
             270                           call sortml (jtrun,mlmax,msort,lsort,mlsort)
             271                     !
             272                     !  new allocation system in parallization for both spectral
             273                     !  and grid spaces
             274                     !
             275                     
             276                           call make_list
             277                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             278     1  pp                 do 150 m =1,mlistnum
             279     1   p                  mf=mlist(m)
             280     1               !
             281     1   p                  rm=mf-1
             282     1   p                  if (mf.eq.1)  rm= 0.0
             283     1   p                  cim(m) = rm
             284     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             285     2   p    s            do 150 l=mf,jtrun
             286     2   p    v             rl = l
             287     2   p    v             rlm= rl-1.0
             288     2   p    v             if (mf.eq.1)  rm= 0.0
             289     2   p    v             eps4(l,m)= rl*rlm/radsq
             290     3   p    s             if ( l.eq.1 ) then
             291     3   p    m              wdfac(1,m) = 0. ; wcfac(1,m) = 0.
             292     3   p    s             else
             293     3   p    s              wdfac(l,m) = 1.0/(radsq*eps4(l,m))
             294     3   p    s              wcfac(l,m) = cim(m)*wdfac(l,m)
             295     3   p    v             endif
             296     1   p    v        150 continue
             297                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aki, bki, sigma
                                   <<< Loop-information  End >>>
             298     1  pp   2v            do k=1,lev+1
             299     1   p   2v              sigma(k,1) = bki(k)
             300     1   p   2v              sigma(k,2) = aki(k)
             301     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, dsigma
                                   <<< Loop-information  End >>>
             302     1  pp    v            do k=1,lev
             303     1   p    v              dsigma(k,1) = sigma(k+1,1) - sigma(k,1)
             304     1   p    v              dsigma(k,2) = sigma(k+1,2) - sigma(k,2)
             305     1   p    v            enddo
             306                     !--------------------------------------------------------------------------
             307                     !   for rrtmg
             308                     !--------------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, si
                                   <<< Loop-information  End >>>
             309     1  pp   2v            do k=1,lev+1
             310     1   p   2v               si(lev+2-k)=sigma(k,1)+sigma(k,2)/1000.
             311     1   p   2v            enddo
             312                     !--------------------------------------------------------------------------
             313                     !     build matrices for semi-implicit and normal mode initialization
             314                     !
             315                            call matrix_hybrid_cwb ( cp,sigma,dsigma,ptop,ptmean,tmean,spalm &
             316                                       , eigval,evecin,evectr,arrhyd,arsddt,pmcor,tmcor )
             317                     !
             318                     !  gaussian quadrature weights and latitudes
             319                     !
             320                           one = 1.0
             321                           onem= -one
             322                           call gausl3 (my,onem,one,weight,sinl)
             323                     !
             324                           my2= my/2
             325                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      onocos, sinl, weight, cosl
                                   <<< Loop-information  End >>>
             326     1   s    s            do 180 j = 1, my2
             327     1   s    s            sinl(my+1-j)  = -sinl(j)
             328     1   s    s            weight(my+1-j)= weight(j)
             329     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             330     1   s    s            onocos(my+1-j)= onocos(j)

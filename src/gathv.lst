 External subroutine subprogram "gathv"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gathv (mn,nx,lev,ipt,fyy,f,tp1)
               2                     !
               3                     !  sorting routine to find coefficients for cubic splines for each
               4                     !  interpolation grid element.  see bicubv for parameter descriptions
               5                     !
               6                           use const, only: RTYPE
               7                     !
               8                           implicit  none
               9                     
              10                           integer   mn,nx,lev,ipt(mn)
              11                           real(kind=RTYPE) fyy(nx*lev),f(nx*lev)
              12                           real      tp1(mn,4)
              13                           integer   i,inx
              14                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, ipt
                                   <<< Loop-information  End >>>
              15     1  pp    v            do 20 i=1,mn
              16     1   p    v            tp1(i,1)= fyy(ipt(i))
              17     1   p    v            tp1(i,3)= f  (ipt(i))
              18     1   p    v            inx= ipt(i)-nx
              19     1   p    v            tp1(i,2)= fyy(inx)
              20     1   p    v            tp1(i,4)= f  (inx)
              21     1   p    v         20 continue
              22                     !
              23                           return
              24                           end


               1                           subroutine lgndr (my2,jtrun,jtmax,sinl,poly,dpoly)
               2                     !
               3                     !  generate legendre polynomials and their derivatives on the
               4                     !  gaussian latitudes
               5                     !
               6                     ! ***input***
               7                     !
               8                     !  my2: number of gaussian latitudes from south pole and equator
               9                     !  jtrun: zonal wavenumber truncation limit
              10                     !  jtmax: maximum amount of zonal wave located in each pe
              11                     !  sinl: sin of gaussian latitudes
              12                     !
              13                     !  ***output***
              14                     !
              15                     !  poly: associated legendre coefficients
              16                     !  dpoly: d(poly)/d(sinl)
              17                     !
              18                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              19                     !
              20                     ! ******************************************************************
              21                     !
              22                     ! ref= belousov, s. l., 1962= tables of normalized associated
              23                     !        legendre polynomials. pergamon press, new york
              24                     !
              25                           use index
              26                           use const, only: RTYPE
              27                     !
              28                           implicit none
              29                     
              30                           integer  my2,jtrun,jtmax
              31                     
              32                           real(kind=RTYPE) poly(jtrun,my2,jtmax),dpoly(jtrun,my2,jtmax), &
              33                                            sinl(my2)
              34                     !
              35                           real     pnm(jtrun+1,jtrun+1),dpnm(jtrun+1,jtrun+1)
              36                     !
              37                     ! sinl is sin(latitude) = cos(colatitude)
              38                     ! pnm(np,mp) is legendre polynomial p(n,m) with np=n+1, mp=m+1
              39                     ! pnm(mp,np+1) is x derivative of p(n,m) with np=n+1, mp=m+1
              40                     !
              41                           integer  n,j,jtrunp,k,kp,m,mp,np,nps,mf,l,mlst
              42                           real     xx,sn,sn2i,rt2,c1,c3,c4,c5,c6,c7,c8,cf,theta,fn,fn2,  &
              43                                    fn2s,ang,s1,s2,a,b,c,d,e,fk,fm,fm1,fm2,fm3,fms,fnp,fnp2
              44                     !
              45                           jtrunp= jtrun+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
              46        pp   4v            pnm=0.0
              47     1                     do 1001 j=1,my2
              48     1                     xx= sinl(j)
              49     1                     sn= sqrt(1.0-xx*xx)
              50     1               	sn2i = 1.0/(1.0 - xx*xx)
              51     1                     rt2= sqrt(2.0)
              52     1               	c1 = rt2
              53     1               !
              54     1                     pnm(1,1) = 1.0/rt2
              55     1                     theta=-atan(xx/sqrt(1.0-xx*xx))+2.0*atan(1.0)
              56     1               !
              57     2                     do 20 n=1,jtrun
              58     2               	np = n + 1
              59     2                     fn=n
              60     2               	fn2 = fn + fn
              61     2               	fn2s = fn2*fn2
              62     2               ! eq 22
              63     2                     c1= c1*sqrt(1.0-1.0/fn2s)
              64     2                     c3= c1/sqrt(fn*(fn+1.0))
              65     2               	ang = fn*theta
              66     2               	s1 = 0.0
              67     2               	s2 = 0.0
              68     2               	c4 = 1.0
              69     2               	c5 = fn
              70     2               	a = -1.0
              71     2               	b = 0.0
              72     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              73     3   s    s            do 27 kp=1,np,2
              74     3   p    v      	k = kp - 1
              75     3   m    m            s2= s2+c5*sin(ang)*c4
              76     3   p    v            if (k.eq.n) c4 = 0.5*c4
              77     3   m    m            s1= s1+c4*cos(ang)
              78     3   s    s      	a = a + 2.0
              79     3   s    s      	b = b + 1.0
              80     3   p    v            fk=k
              81     3   m    m      	ang = theta*(fn - fk - 2.0)
              82     3   s    s      	c4 = (a*(fn - b + 1.0)/(b*(fn2 - a)))*c4
              83     3   s    s      	c5 = c5 - 2.0
              84     3   p    v         27 continue
              85     2               ! eq 19
              86     2               	pnm(np,1) = s1*c1
              87     2               ! eq 21
              88     2               	pnm(np,2) = s2*c3
              89     2                  20 continue
              90     1               !
              91     2                     do 4 mp=3,jtrunp
              92     2               	m = mp - 1
              93     2                     fm= m
              94     2               	fm1 = fm - 1.0
              95     2               	fm2 = fm - 2.0
              96     2               	fm3 = fm - 3.0
              97     2                     c6= sqrt(1.0+1.0/(fm+fm))
              98     2               ! eq 23
              99     2               	pnm(mp,mp) = c6*sn*pnm(m,m)
             100     2                     if (mp - jtrunp) 3,4,4
             101     2                   3 continue
             102     2               	nps = mp + 1
             103     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
             104     3   s    s            do 41 np=nps,jtrunp
             105     3   p    v      	n = np - 1
             106     3   p    v            fn= n
             107     3   p    v      	fn2 = fn + fn
             108     3   p    v      	c7 = (fn2 + 1.0)/(fn2 - 1.0)
             109     3   p    v      	c8 = (fm1 + fn)/((fm + fn)*(fm2 + fn))
             110     3   p    v            c= sqrt((fn2+1.0)*c8*(fm3+fn)/(fn2-3.0))
             111     3   p    v            d= -sqrt(c7*c8*(fn-fm1))
             112     3   p    v            e= sqrt(c7*(fn-fm)/(fn+fm))
             113     3               ! eq 17
             114     3   m    m      	pnm(np,mp) = c*pnm(np-2,mp-2) &
             115     3                                 + xx*(d*pnm(np-1,mp-2) + e*pnm(np - 1,mp))
             116     3   p    v         41 continue
             117     2                   4 continue
             118     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
             119     2  pp                 do 50 mp=1,jtrun
             120     2   p                 fm= mp-1.0
             121     2   p           	fms = fm*fm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
             122     3   p    v            do 50 np=mp,jtrun
             123     3   p    v            fnp= np
             124     3   p    v      	fnp2 = fnp + fnp
             125     3   p    v      	cf = (fnp*fnp - fms)*(fnp2 - 1.0)/(fnp2 + 1.0)
             126     3   p    v            cf= sqrt(cf)
             127     3               ! der
             128     3   p    v            dpnm(np,mp)   = -sn2i*(cf*pnm(np+1,mp) - fnp*xx*pnm(np,mp))
             129     2   p    v         50 continue
             130     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm, poly, dpoly
                                   <<< Loop-information  End >>>
             131     2  pp                 do 71 m=1,mlistnum
             132     2   p                 mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      poly, pnm, dpnm, dpoly
                                   <<< Loop-information  End >>>
             133     3   p   2v            do 71 l=mf,jtrun
             134     3               !ibm--- poly & dpoly: 2nd & 3rd dimension is transposed
             135     3               !ibm     poly(l,m,j)= pnm(l,mf)
             136     3               !ibm     dpoly(l,m,j)=dpnm(l,mf)
             137     3   p   2v            poly(l,j,m)= pnm(l,mf)
             138     3   p   2v            dpoly(l,j,m)=dpnm(l,mf)
             139     2   p   2v         71 continue
             140     1                     mlst=ilist(1)
             141     1               !ibm     if(mlst .ne. 0) dpoly(1,mlst,j)= 0.0
             142     1                     if(mlst .ne. 0) dpoly(1,j,mlst)= 0.0
             143     1               !
             144     1                1001 continue
             145                     !
             146                           return
             147                           end


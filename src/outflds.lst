                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt_org, qt
                                   <<< Loop-information  End >>>
             155     3   p   4v                do i = 1,nxj
             156     3   p   4v                  qt(i,k,jj) = qt_org(i,k,jj)
             157     3   p   4v                enddo
             158     2   p                   enddo
             159     1   p                 enddo
             160                     !
             161     1                     if(ncld.ge.2)then
             162     1                       ntrac=2
             163     1                     else

             304                     !
             305                           if(myrank.eq.0)print*,' outfld : start surfout, lwrite = ',lwrite
             306                           call surfout (nx,my,my_max,ifilout,itau,idtg,taudir,ntau,pdiff,pt  &
             307                                        ,ptop,typtrk(1,1,1),ptend,glob,ggdef,lwrite)
             308                     !
             309                     !  obtain the the bottom pressure for the following interpolations
             310                     !  bt2 will be used in geoptential interpolations
             311                     !
             312                           pl1000= log(1000.1)
             313                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pdiff, pllp, slp

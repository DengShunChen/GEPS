             211                     !
             212                           alaps = 0.0065
             213                           rdg = rgas/grav
             214                     !
             215                     !  hydrostatic equation
             216                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, tt, sgeo, phi
                                   <<< Loop-information  End >>>
             217     1  pp                 do jj =1,jlistnum
             218     1   p                   j=jlist1(jj)
             219     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.57, ITR: 72, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, sgeo, tt, phi
                                   <<< Loop-information  End >>>
             220     2   p    v              do i=1,nxj
             221     2   p    v                phi(i,lev,jj)= cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj)) &
             222     2                                      + sgeo(i,jj)
             223     2   p    v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, tt, phi
                                   <<< Loop-information  End >>>
             224     2   p                   do k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 104, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, pk2, phi
                                   <<< Loop-information  End >>>
             225     3   p    v                do i=1,nxj
             226     3   p    v                  phi(i,k,jj)= phi(i,k+1,jj)+cp*(tt(i,k,jj)*(pk2(i,k,jj)-pk(i,k,jj)) &

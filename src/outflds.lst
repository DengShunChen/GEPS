             344                     !
             345     1                     if(numz.gt.0.or.numt.gt.0.or.numq.gt.0) then
             346     1               !
             347     1               !  temperature output
             348     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             349     2  pp                 do jj =1,jlistnum
             350     2   p                   j=jlist1(jj)
             351     2   p                   nxj=nxdef_2d(j)
             352     2               !
             353     2               !  bottom boundary condition for temperature:
             354     2               !  limits for 1000 mb boundary condition are (1) standard lapse rate
             355     2               !  from bottom model level for terrain height and (2) layer mean temp
             356     2               !  of slp and 1000 mb.  Boundary condition is linear combination
             357     2               !  of these two cases weighted with subterrainean thickness.
             358     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, tmp
                                   <<< Loop-information  End >>>
             359     3   p                   do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, tmp
                                   <<< Loop-information  End >>>
             360     4   p   2v                do i = 1,nxj
             361     4   p   2v                  tmp(i,k,jj) = tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             362     4   p   2v                enddo
             363     3   p                   enddo
             364     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, pt, slp, plog, plt, tmp, bt1
                                   <<<      t1000
                                   <<< Loop-information  End >>>
             365     3   p    v              do i=1,nxj
             366     3   p    v                slp(i,jj) = max( slp(i,jj), pt(i,jj) )
             367     3   p    v                splog= log(slp(i,jj))
             368     3   p    v                dx= log(slp(i,jj)/(pt(i,jj)+ptop))
             369     3               !          bx= tmp(i,lev,jj)*(1.0/sig(lev+1))**0.19023 + sgeo(i,jj)*0.00065
             370     3   p    v                bx= tmp(i,lev,jj) + sgeo(i,jj)*0.00065
             371     4   p    v                if ( sgeo(i,jj) .ge. 1000.0 )  then
             372     4   p    v                  tmid = sgeo(i,jj)/(dx*rgas)
             373     4   p    v                  ax = tmp(i,lev,jj)+ (tmid-tmp(i,lev,jj))*(splog-plog(i,lev,jj)) &
             374     4                               / (log((slp(i,jj)+pt(i,jj)+ptop)*0.5)-plog(i,lev,jj))
             375     4   p    v                else
             376     4   p    v                  ax = bx
             377     4   p    v                endif
             378     3   p    v                cx = (sgeo(i,jj)-1000.0)/(10000.0-1000.0)
             379     3   p    v                cx = max (0.0, min (1.0, cx))
             380     3   p    v                dx = cx*cx
             381     3   p    v                tsf = dx*ax + (1.0-dx)*bx
             382     3   p    v                tadia= tmp(i,lev,jj)*(slp(i,jj)/plt(i,lev,jj))**0.25
             383     3   p    v                tsf  = max( tmp(i,lev,jj), min( tsf,tadia ) )
             384     4   p    v                if ( slp(i,jj) .gt. 1000.1 )  then
             385     4   p    v                  bt1(i,jj)= tsf
             386     4   p    v                  t1000(i,jj) = tsf
             387     4   p    v                else
             388     4   p    v                  bt1(i,jj)= tsf + (tsf-tmp(i,lev,jj))*(pl1000-splog)  &
             389     4                                    / (splog - plog(i,lev,jj))
             390     4   p    v                  t1000(i,jj) = bt1(i,jj)
             391     4   p    v                endif
             392     3   p    v              enddo

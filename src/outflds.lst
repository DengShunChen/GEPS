             228     3   p    v                enddo
             229     2   p                   enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             230     2   p                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.89, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             231     3   p    v                do i=1,nxj
             232     3   p    v                  plog(i,k,jj)= log(plt(i,k,jj))
             233     3   p    v                enddo
             234     2   p                   enddo
             235     1   p                 enddo
             236                     !
             237                     !  compute sea level pressure and update pdiff
             238                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             239                     !
             240                     !  llts layer's temperature is used to derive an alternative
             241                     !  surface skin temperature
             242                     !
             243                     !      if( itau .gt. 0 )then
             244                     !
             245                           llts = lev-5
             246                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             247     1  pp                 do jj = 1, jlistnum
             248     1   p                   j=jlist1(jj)
             249     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, sgeo, plt, qt, pt, phi, hld2
                                   <<<      hld1, pdiff, pllp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             250     2   p    v              do i=1,nxj
             251     2   p    v                ttb  = tt(i,lev,jj)*pk(i,lev,jj)/(1.0+0.608*qt(i,lev,jj))
             252     2   p    v                ttp  = tt(i,llts,jj)*pk(i,llts,jj)/(1.0+0.608*qt(i,llts,jj))
             253     2   p    v                ttt1 = ttb + alaps*rdg*ttb*   &
             254     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             255     2   p    v                ttt2 = ttp + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             256     2   p    v                hld1(i,jj) = 0.25*ttt1 + 0.75*ttt2
             257     2   p    v                hld2(i,jj) = hld1(i,jj) + alaps*sgeo(i,jj)/grav
             258     3   p    v                if( sgeo(i,jj) .lt. 0.1 ) then
             259     3   p    v                  anlslp = pt(i,jj) + ptop
             260     3   p    v                else if( hld1(i,jj) .le. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             261     3   p    v                  apha = rgas*(290.5-hld1(i,jj))/sgeo(i,jj)
             262     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             263     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             264     3                                    apha*ttt*apha*ttt) )
             265     3   p    v                else if( hld1(i,jj) .gt. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             266     3   p    v                  hld1(i,jj) = (hld1(i,jj)+290.5)*0.5
             267     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             268     3   p    v                else if( hld1(i,jj) .lt. 255.0 .and. hld2(i,jj) .lt. 255.0 ) then
             269     3   p    v                  hld1(i,jj) = (hld1(i,jj)+255.0)*0.5
             270     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             271     3   p    v                else
             272     3   p    v                  apha = alaps * rdg
             273     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             274     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             275     3                                    apha*ttt*apha*ttt) )
             276     3   p    v                endif
             277     2   p    v                pllp(i,jj) = anlslp - pt(i,jj)
             278     2   p    v                pdiff(i,jj)=pllp(i,jj)
             279     2   p    v              enddo
             280     1   p                 enddo
             281                     !
             282                     !      else
             283                     !
             284                     !  pllp equal to pdiff at the initial time, tau=0
             285                     !
             286                     !      do jj = 1, jlistnum
             287                     !        j=jlist1(jj)
             288                     !        nxj=nxdef(j)
             289                     !        do i = 1, nxj
             290                     !          pllp(i,j) = pdiff(i,jj)
             291                     !        enddo
             292                     !      enddo
             293                     !
             294                     !      endif     ! end of ( itau .gt. 0 )
             295                     !
             296                     !      call mpe_unify(pllp,nx,my,2,mpe_double)
             297                     !      call mpe_unify(pt,nx,my,2,mpe_double)
             298                     !      call mpe_unify(ptend,nx,my,2,mpe_double)
             299                     !
             300                     !

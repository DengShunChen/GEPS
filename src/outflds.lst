             177     5   p   2v                      ngq = ngq + 1
             178     5   p   2v                      qt(i,kk,jj) = 0.0
             179     5   p   2v                    endif
             180     4   p   2v                  enddo
             181     3   p                     enddo
             182     2               !         ntt = ntt + nxj*lev

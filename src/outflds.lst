                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.72, ITR: 224, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt
                                   <<< Loop-information  End >>>
             175     4   p   2v                  do i = 1,nxj

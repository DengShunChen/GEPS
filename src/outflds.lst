             148                     !
             149                     !  copy qt into local qt arrays
             150                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             151     1  pp                 do jj = 1, jlistnum
             152     1   p                   j=jlist1(jj)
             153     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt_org, qt
                                   <<< Loop-information  End >>>
             154     2   p                   do k = 1, lev*ncld
                                   <<< Loop-information Start >>>

             316     1                       nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pllp, slp, pt, pdiff
                                   <<< Loop-information  End >>>
             317     2  pp   2v              do i = 1, nxj
             318     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             319     3   p   2v                if( slp(i,jj) .le. 1000.1) then
             320     3   p   2v                  pllp(i,jj) = 1000.1
             321     3   p   2v                else

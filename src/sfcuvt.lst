 External subroutine subprogram "sfcuvt"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine sfcuvt ( nxj,mn,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt &
               2                                             , ut,vt,tt,qt,ustar,tstar,qstar,hflux,qflux   &
               3                                             , qsfc,t2,q2,rh2,rh10,u10,v10 )
               4                     !
               5                     !##################################################################
               6                     !                     subroutine description
               7                     !
               8                     ! 1. function description
               9                     !
              10                     !       this subroutine calculated surface t2 u10 v10
              11                     !
              12                     ! 2. parameter specification
              13                     !
              14                     !     mn : dimension of horizontal-direction
              15                     !     dt : time step for ut, vt, tt, qt updates               (s)
              16                     !      g : gravity                                            (m/s2)
              17                     !      r : air gas constant                                   (j/kg)
              18                     !     cp : air specific heat constant                         (j/kg)
              19                     !   hltm : water vapor latent heat constant                   (j/kg)
              20                     !     tg : ground potential temp. (sea or land)    (mn)      (k)
              21                     !     z0 : surface roughness length                (mn)      (m)
              22                     !  ocean : logical array for ocean  (mn)      (true = open water)
              23                     !     ps : surface pressure     (mn)     at current time lvl (mb)
              24                     !     ts : surface air temp
              25                     !    hgt : height above ground  (mn,kk)  at current time lvl (m)
              26                     !     ut : x-direction velocity (mn,kk) at past/future  lvl (m/s)
              27                     !     vt : y-direction velocity (mn,kk) at past/future  lvl (m/s)
              28                     !     tt : potent temp on odd lvl(mn,kk) at past/future  lvl (k)
              29                     !     qt : moisture    on odd lvl(mn,kk) at past/future  lvl (kg/kg)
              30                     !   sfcw : surface wind speed                       (mn)     (m/s)
              31                     !   ustar: surface friction velocity                (mn)     (m/s)
              32                     !   tstar: surface potential temp scale             (mn)     (k)
              33                     !   qstar: surface moisture scale                   (mn)     (kg/kg)
              34                     !   hflux: upward surface heat flux, =-ro*cp*ustar*tstar   (mn)  (w/m2)
              35                     !   qflux: upward surface moist flux,=-ro*hltm*ustar*qstar (mn)  (w/m2)
              36                     !    qsfc: surface satuated specific humidity       (mn)     (kg/kg)
              37                     !     t2 : surface air temperature at 2m             (mn)   (k)
              38                     !    u10 : surface wind in x-direction at 10m        (mn)   (m/s)
              39                     !    v10 : surface wind in y-direction at 10m        (mn)   (m/s)
              40                     !
              41                     ! 4. local work arrays
              42                     !
              43                     !    phim: non-dimensional vertically integrated wind shear function
              44                     !          (businger , 1973)                        (mn)
              45                     !    phih: non-dimensional vertically integrated temperature/moisture
              46                     !          gradient function (businger , 1973)      (mn)
              47                     !    sfcw: wind speed on mass point                 (mn)     (m/s)
              48                     !    zsz0: log(zs/z0)                               (mn)     (m/m)
              49                     !     zl : height(kk) over monin-obukhov scale height.
              50                     !          a stability indicator.                   (mn)
              51                     !
              52                     ! 5. calling modules
              53                     !
              54                     !    getrdy.f
              55                     !
              56                     ! 6. usage
              57                     !
              58                     !     call sfcuvt ( mn,kk,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt
              59                     !    1            , ut,vt,tt,qt,sfcw,ustar,tstar,qstar,hflux,qflux
              60                     !    2            , qsfc,t2,u10,v10 )
              61                     !
              62                     ! 7. modules called
              63                     !
              64                     !
              65                     ! 8. limitation
              66                     !
              67                     !   ** 1.5e-5 <= z0 (sea) <= 0.01
              68                     !   **   -2.0 <=    zl    <= 2.0
              69                     !   **            ustar   >= 1.e-7,  <= 1.e+1
              70                     !   **            tatrt              <= 5.e+1
              71                     !   **            qatrt              <= 5.e+0
              72                     !   **              zs    >= 10.0
              73                     !   **             sfcw   >= 0.01
              74                     !
              75                     ! 9. date
              76                     !
              77                     !     created            10/1/1989
              78                     !     modified           7/23/1990
              79                     !     rewritten          nov. 1991
              80                     !
              81                     ! 10. author
              82                     !      c. liou / f. wang / s. chang
              83                     !
              84                     ! 11. reference
              85                     !       businger j.a.,1973: turbulent transfer in the atmospheric
              86                     !            surface layer.  workshop in meteorology, d. a. haugen,
              87                     !            ed., american meteorology socity, 67-98.
              88                     !#####################################################################
              89                     
              90                           implicit   none
              91                     !
              92                     ! input & output variable
              93                     !
              94                           integer nxj,mn
              95                     
              96                           real    dt,g,r,cp,hltm
              97                     
              98                           real    tg(mn),z0(mn),ps(mn),hgt(mn)                           &
              99                                   , ut(mn),vt(mn),tt(mn),qt(mn),sfcw(mn)                 &
             100                                   , ustar(mn),tstar(mn),qstar(mn)                        &
             101                                   , qsfc(mn),ts(mn),hflux(mn),qflux(mn)                  &
             102                                   , u10(mn),v10(mn),t2(mn),t10(mn),rh2(mn),rh10(mn)
             103                     
             104                           logical ocean(mn)
             105                     !
             106                     !  local work arrays
             107                     !
             108                     !sun  include '../include/paramt.h' .. change im to mn
             109                     !     include '../include/paramt.h'
             110                     !
             111                           real      phim(mn),phih(mn),zsz0(mn),rosfc(mn)                 &
             112                                   , wu(mn),wv(mn),wt(mn),wq(mn),zl(mn)                   &
             113                                   , q2(mn),p2(mn),q10(mn),p10(mn)
             114                     
             115                           integer   i,it1
             116                           real      xkapa,g04,pihalf,xx,yy,btest,bl,al,zl2,zl10,xx10,phim10 &
             117                                     ,phih2,phih10
             118                     !
             119                     !
             120                     !
             121                     !          cccccccccccccccccccccccccccccccccccccccccccccc
             122                     !          c                                            c
             123                     !          c         similarity surface layer           c
             124                     !          c         paulson 1970, businger 1973        c
             125                     !          c                                            c
             126                     !          cccccccccccccccccccccccccccccccccccccccccccccc
             127                     !
             128                           xkapa = r/cp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, ts, rosfc
                                   <<< Loop-information  End >>>
             129     1  pp   2v            do 10 i = 1, nxj
             130     1   p   2v            rosfc(i) = 100.0*ps(i)/( r*ts(i))
             131     1   p   2v        10  continue
             132                     !
             133                     !           iterate 3 times to match u*, t*, q*, and z/l
             134                     !
             135     1                     do 900 it1 = 1, 3
             136     1               !
             137     1               !           charnock's relation for surface roughness over oceans
             138     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hgt, qstar, ut, tt, ustar, tstar, vt, zl
                                   <<<      wv, wu, ocean, sfcw, z0, qsfc, qt, wq
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      tg: 2, wt: 2, phih: 2, rosfc: 2
                                   <<<      qflux: 2, hflux: 2, phim: 2, zsz0: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             139     2  pp    v            do 100 i = 1, nxj
             140     3   p    v            if ( ocean(i) )  then
             141     3   p    v               z0(i) = 0.032 *ustar(i)*ustar(i)/g
             142     3   p    v               z0(i)= max(1.5e-5,min(z0(i),0.01))
             143     3   p    v            endif
             144     2               ! 100 continue
             145     2               !     do 140 i=1,nxj
             146     2               !
             147     2               !           compute surface wind
             148     2               !
             149     2   p    v            sfcw(i)= max( 1.0e-2,sqrt( ut(i)*ut(i)+vt(i)*vt(i)))
             150     2               ! 140 continue
             151     2               !
             152     2               !           compute z/l
             153     2               !
             154     2               !           limit minimum depth of surface layer
             155     2               !           (saved in zsz0) for surface flux calculation
             156     2               !
             157     2               !
             158     2   p    v            g04 = g*0.4
             159     2               !     do 200 i=1,nxj
             160     2   p    v            zsz0(i) = max(10.0,hgt(i))
             161     2   p    v            zl(i) = g04*zsz0(i)*tstar(i)*(1.+0.61*qstar(i)) /      &
             162     2                             (tt(i)*ustar(i)*ustar(i))
             163     2   p    v            zl(i)= max(-2.0,min(zl(i),2.0))
             164     2               ! 200 continue
             165     2               !
             166     2               !           compute phi functions  (see businger 1973, or paulson 1970)
             167     2               !
             168     2   p    v            pihalf = 3.141592654 * 0.5
             169     2               !     do 240 i = 1, nxj
             170     3   p    v            if(zl(i) .lt. 0.0) then
             171     3   p    v               xx = exp(0.25*log(1.0 - 15.0*zl(i)))
             172     3   p    v               phim(i) = 2.0*log(0.5*(1.0+xx)) + log(0.5*(1.0+xx*xx))     &
             173     3                                         - 2.0*atan(xx) + pihalf
             174     3   p    v               phih(i) = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl(i))))
             175     3   p    v            else
             176     3   p    v               phim(i) = -4.7  * zl(i)
             177     3   p    v               phih(i) = -6.35 * zl(i)
             178     3   p    v            endif
             179     2               ! 240 continue
             180     2               !
             181     2               !     do 300 i = 1, nxj
             182     2   p    v            zsz0(i) = log(zsz0(i)/z0(i))
             183     2   p    v            phim(i) = zsz0(i) - phim(i)
             184     2   p    v            phih(i) = zsz0(i) - phih(i)
             185     2   p    v            phim(i)= max(phim(i),1.0e-3)
             186     2   p    v            phih(i)= max(phih(i),1.0e-3)
             187     2               ! 300 continue
             188     2               !
             189     2               !     compute new ut, vt, tt, and qt for ustar, tstar, qstar updates
             190     2               !     using crank-nicolson (bl=0.5) time scheme for weak forcing or
             191     2               !        or backward (bl=1.) time scheme for strong forcing
             192     2               !
             193     2               !     do 340 i = 1, nxj
             194     2   p    v            yy    = dt*ustar(i) * ustar(i) / (2.0*hgt(i)*sfcw(i))
             195     2   p    v            btest = 0.5 + (yy-1.0)*0.5
             196     2   p    v            bl    = max (0.5, min (1.0, btest) )
             197     2   p    v            al    = 1.0 - bl
             198     2   p    v            wu(i) = ut(i) * (1.0-al*yy) / (1.0+bl*yy)
             199     2   p    v            wv(i) = vt(i) * (1.0-al*yy) / (1.0+bl*yy)
             200     2   p    v            xx    = 0.4*dt*ustar(i) / (0.74*2.0*hgt(i)*phih(i))
             201     2   p    v            wt(i) = ( tt(i)*(1.0-al*xx) + xx*tg(i) )   / (1.0+bl*xx)
             202     2   p    v            wq(i) = ( qt(i)*(1.0-al*xx) + xx*qsfc(i) ) / (1.0+bl*xx)
             203     2               ! 340 continue
             204     2               !
             205     2               !     update ustar, tstar and qstar
             206     2               !
             207     2               !     do 360 i = 1, nxj
             208     2               ! phon-ju
             209     2               ! add blending for stability
             210     2               !
             211     2   p    v            wu(i)=0.5*(ut(i)+wu(i))
             212     2   p    v            wv(i)=0.5*(vt(i)+wv(i))
             213     2   p    v            wt(i)=0.5*(tt(i)+wt(i))
             214     2   p    v            wq(i)=0.5*(qt(i)+wq(i))
             215     2               ! add over
             216     2   p    v            sfcw(i) = max (1.0e-2, sqrt( wu(i)*wu(i) + wv(i)*wv(i) ))
             217     2   p    v            ustar(i) = 0.4*sfcw(i) / phim(i)
             218     2   p    v            tstar(i) = 0.4*        (wt(i)-tg(i))  /(0.74*phih(i))
             219     2   p    v            qstar(i) = 0.4*        (wq(i)-qsfc(i))/(0.74*phih(i))
             220     2   p    v            ustar(i)= max(ustar(i),1.0e-7)
             221     2   p    v            ustar(i)= min(ustar(i),10.000)
             222     2   p    v            tstar(i)= min(tstar(i),50.00)
             223     2   p    v            qstar(i)= min(qstar(i),5.000)
             224     2               ! 360 continue
             225     2               !
             226     2               !     do 400 i = 1, nxj
             227     2   p    v            hflux(i) = -rosfc(i)*cp*ustar(i)*tstar(i)
             228     2   p    v            qflux(i) = -rosfc(i)*hltm*ustar(i)*qstar(i)
             229     2               ! 400 continue
             230     2               !
             231     2   p    v        100 continue
             232     1               !
             233     1                 900 continue
             234                     !
             235                     !ccc for output of t2, u10 and v10
             236                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, rosfc, p2, zl, hgt, p10, z0, wv
                                   <<<      phim, wu, u10, v10, phih, tg, wt, t10
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      wq: 2, qsfc: 2, q10: 2, t2: 2, q2: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 33  FILL 61
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             237     1  pp    v            do i=1,nxj
             238     1   p    v            zl2=zl(i)*2./hgt(i)
             239     1   p    v            zl10=zl(i)*10./hgt(i)
             240     2   p    v            if(zl(i) .lt. 0.0) then
             241     2   p    v               xx10 = exp(0.25*log(1.0 - 15.0*zl10))
             242     2   p    v               phim10 = 2.0*log(0.5*(1.0+xx10)) + log(0.5*(1.0+xx10*xx10))  &
             243     2                                         - 2.0*atan(xx10) + pihalf
             244     2   p    v               phih2 = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl2)))
             245     2   p    v               phih10 = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl10)))
             246     2   p    v            else
             247     2   p    v               phim10 = -4.7  * zl10
             248     2   p    v               phih2 = -6.35 * zl2
             249     2   p    v               phih10 = -6.35 * zl10
             250     2   p    v            endif
             251     1   p    v            phim10 =log( 10./z0(i)) - phim10
             252     1   p    v            phih2 =log( 2./z0(i)) - phih2
             253     1   p    v            phih10 =log( 10./z0(i)) - phih10
             254     1   p    v            phim10= max(phim10,1.0e-3)
             255     1   p    v            phih2= max(phih2,1.0e-3)
             256     1   p    v            phih10= max(phih10,1.0e-3)
             257     1               !
             258     1   p    v            v10(i)=wv(i)*phim10/phim(i)
             259     1   p    v            u10(i)=wu(i)*phim10/phim(i)
             260     1               !
             261     1   p    v            t2(i)=tg(i)*(1.-phih2/phih(i))+wt(i)*phih2/phih(i)
             262     1   p    v            t10(i)=tg(i)*(1.-phih10/phih(i))+wt(i)*phih10/phih(i)
             263     1               !
             264     1   p    v            q2(i)=qsfc(i)*(1.-phih2/phih(i))+wq(i)*phih2/phih(i)
             265     1   p    v            q10(i)=qsfc(i)*(1.-phih10/phih(i))+wq(i)*phih10/phih(i)
             266     1               !

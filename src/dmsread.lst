 External subroutine subprogram "dmsread_split"
  (inc)(line-no.)(nest)(optimize)
             141                     !-------------------------------------------------
             142                           subroutine dmsread_split(nx,my,lrec,lenc,kflag,ifile,z,istat)
             143                     !
             144                     !  subroutine to read data in pressure level fields
             145                     !
             146                     ! **** input ****
             147                     !
             148                     !  lrec: field identifaction label
             149                     !  lenc: no. of data values in a 2-d lrec field
             150                     !  ifile: path/file name containing initial fields
             151                     !
             152                     ! **** output ****
             153                     !
             154                     !  z: array containing gaussian grid 2-d field
             155                     !  istat: status code. .ne. zero means bad read
             156                     !
             157                           use mpe
             158                           use rank
             159                           use index
             160                     
             161                           implicit  none
             162                           integer   nx,my,lenc,istat
             163                     
             164                           real      z(nx,my)
             165                     !
             166                           logical t_flg
             167                     !
             168                           character lrec*26,ifile*80,kflag*1
             169                     !
             170                           character key*34,crmk*88
             171                     !
             172                           write(key,1000)lrec,kflag,lenc
             173                      1000 format(a26,a1,i7.7)
             174                     !
             175                           t_flg=.false.
             176                     !
             177     1                     if(col_rank .eq. 0) then
             178     1                     call dmsget(ifile,key//char(0),z,istat)
             179     1                     t_flg=.true.
             180     1                     endif
             181                     !
             182                     !ch   call mpe_broadcast(z,nx*my,t_flg,mpe_double)
             183                     !ch   call mpe_broadcast(istat,1,t_flg,mpe_integer)
             184                           call mpe_bcast_col(z,nx*my,0,mpe_double)
             185                           call mpe_bcast_col(istat,1,0,mpe_integer)
             186                     !
             187     1                     if(istat.ne.0) then
             188     1               !
             189     1                     write(crmk,100) key
             190     1                 100 format('#######  record ',a34,' missing  ######')
             191     1               !
             192     2                     if(col_rank .eq. 0) then
             193     2                     print*, crmk
             194     2                     print *,'istat=',istat
             195     2               !CWB2016 force mpi code abort
             196     2                     stop'dmsread: fatal error !'
             197     2                     endif
             198     1                     call mpe_finalize
             199     1                     call dmsexit(-1)
             200     1               !
             201     1                     else
             202     1               !

 External subroutine subprogram "dmsread"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine dmsread(nx,my,lrec,lenc,kflag,ifile,z,istat)
               2                     !
               3                     !  subroutine to read data in pressure level fields
               4                     !
               5                     ! **** input ****
               6                     !
               7                     !  lrec: field identifaction label
               8                     !  lenc: no. of data values in a 2-d lrec field
               9                     !  ifile: path/file name containing initial fields
              10                     !
              11                     ! **** output ****
              12                     !
              13                     !  z: array containing gaussian grid 2-d field
              14                     !  istat: status code. .ne. zero means bad read
              15                     !
              16                           use mpe
              17                           use rank
              18                           use index
              19                     
              20                           implicit  none
              21                           integer   nx,my,lenc,istat
              22                     
              23                           real      z(nx,my)
              24                     !
              25                           logical t_flg
              26                     !
              27                           character lrec*26,ifile*80,kflag*1
              28                     !
              29                           character key*34,crmk*88
              30                     !
              31                           write(key,1000)lrec,kflag,lenc
              32                      1000 format(a26,a1,i7.7)
              33                     !
              34                           t_flg=.false.
              35                     !
              36     1                     if(myrank .eq. 0) then
              37     1                     call dmsget(ifile,key//char(0),z,istat)
              38     1                     t_flg=.true.
              39     1                     endif
              40                     !
              41                     !ch   call mpe_broadcast(z,nx*my,t_flg,mpe_double)
              42                     !ch   call mpe_broadcast(istat,1,t_flg,mpe_integer)
              43                           call mpe_bcast(z,nx*my,0,mpe_double)
              44                           call mpe_bcast(istat,1,0,mpe_integer)
              45                     !
              46     1                     if(istat.ne.0) then
              47     1               !
              48     1                     write(crmk,100) key
              49     1                 100 format('#######  record ',a34,' missing  ######')
              50     1               !
              51     2                     if(myrank .eq. 0) then
              52     2                     print*, crmk
              53     2                     print *,'istat=',istat
              54     2               !CWB2016 force mpi code abort
              55     2                     stop'dmsread: fatal error !'
              56     2                     endif
              57     1                     call mpe_finalize
              58     1                     call dmsexit(-1)
              59     1               !
              60     1                     else
              61     1               !
              62     1               #ifdef VERBOSE
              63     1                     if(myrank .eq. 0) print *,'dms key=',key,' found'
              64     1               #endif
              65     1               !
              66     1                     endif
              67                     !
              68                           return
              69                           end


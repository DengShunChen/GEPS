 Module "mersenne_twister"
  (inc)(line-no.)(nest)(optimize)
               1                     !$$$  Module Documentation Block
               2                     !
               3                     ! Module: mersenne_twister   Modern random number generator
               4                     !   Prgmmr: Iredell          Org: W/NX23     date: 2005-06-14
               5                     !
               6                     ! Abstract: This module calculates random numbers using the Mersenne twister.
               7                     !   (It has been adapted to a Fortran 90 module from open source software.
               8                     !   The comments from the original software are given below in the remarks.)
               9                     !   The Mersenne twister (aka MT19937) is a state-of-the-art random number
              10                     !   generator based on Mersenne primes and originally developed in 1997 by
              11                     !   Matsumoto and Nishimura. It has a period before repeating of 2^19937-1,
              12                     !   which certainly should be good enough for geophysical purposes. :-)
              13                     !   Considering the algorithm's robustness, it runs fairly speedily.
              14                     !   (Some timing statistics are given below in the remarks.)
              15                     !   This adaptation uses the standard Fortran 90 random number interface,
              16                     !   which can generate an arbitrary number of random numbers at one time.
              17                     !   The random numbers generated are uniformly distributed between 0 and 1.
              18                     !   The module also can generate random numbers from a Gaussian distribution
              19                     !   with mean 0 and standard deviation 1, using a Numerical Recipes algorithm.
              20                     !   The module also can generate uniformly random integer indices.
              21                     !   There are also thread-safe versions of the generators in this adaptation,
              22                     !   necessitating the passing of generator states which must be kept private.
              23                     !
              24                     ! Program History Log:
              25                     !   2005-06-14  Mark Iredell
              26                     !
              27                     ! Usage:
              28                     !   The module can be compiled with 4-byte reals or with 8-byte reals, but
              29                     !   4-byte integers are required. The module should be endian-independent.
              30                     !   The Fortran 90 interfaces random_seed and random_number are overloaded
              31                     !   and can be used as in the standard by adding the appropriate use statement
              32                     !     use mersenne_twister
              33                     !   In the below use cases, harvest is a real array of arbitrary size,
              34                     !   and iharvest is an integer array of arbitrary size.
              35                     !   To generate uniformly distributed random numbers between 0 and 1,
              36                     !     call random_number(harvest)
              37                     !   To generate Gaussian distributed random numbers with 0 mean and 1 sigma,
              38                     !     call random_gauss(harvest)
              39                     !   To generate uniformly distributed random integer indices between 0 and n,
              40                     !     call random_index(n,iharvest)
              41                     !   In standard "saved" mode, the random number generator can be used without
              42                     !   setting a seed. But to set a seed, only 1 non-zero integer is required, e.g.
              43                     !     call random_setseed(4357) ! set default seed
              44                     !   The full generator state can be set via the standard interface random_seed,
              45                     !   but it is recommended to use this method only to restore saved states, e.g.
              46                     !     call random_seed(size=lsave)  ! get size of generator state seed array
              47                     !     allocate isave(lsave)         ! allocate seed array
              48                     !     call random_seed(get=isave)   ! fill seed array (then maybe save to disk)
              49                     !     call random_seed(put=isave)   ! restore state (after read from disk maybe)
              50                     !   Locally kept generator states can also be saved in a seed array, e.g.
              51                     !     type(random_stat):: stat
              52                     !     call random_seed(get=isave,stat=stat)  ! fill seed array
              53                     !     call random_seed(put=isave,stat=stat)  ! restore state
              54                     !   To generate random numbers in a threaded region, the "thread-safe" mode
              55                     !   must be used where generator states of type random_state are passed, e.g.
              56                     !     type(random_stat):: stat(8)
              57                     !     do i=1,8                               ! threadable loop
              58                     !       call random_setseed(7171*i,stat(i))  ! thread-safe call
              59                     !     enddo
              60                     !     do i=1,8                               ! threadable loop
              61                     !       call random_number(harvest,stat(i))  ! thread-safe call
              62                     !     enddo
              63                     !     do i=1,8                               ! threadable loop
              64                     !       call random_gauss(harvest,stat(i))   ! thread-safe call
              65                     !     enddo
              66                     !     do i=1,8                               ! threadable loop
              67                     !       call random_index(n,iharvest,stat(i))! thread-safe call
              68                     !     enddo
              69                     !   There is also a relatively inefficient "interactive" mode available, where
              70                     !   setting seeds and generating random numbers are done in the same call.
              71                     !   There is also a functional mode available, returning one value at a time.
              72                     !
              73                     ! Public Defined Types:
              74                     !   random_stat       Generator state (private contents)
              75                     !
              76                     ! Public Subprograms:
              77                     !   random_seed         determine size or put or get state
              78                     !     size              optional integer output size of seed array
              79                     !     put               optional integer(:) input seed array
              80                     !     get               optional integer(:) output seed array
              81                     !     stat              optional type(random_stat) (thread-safe mode)
              82                     !   random_setseed      set seed (thread-safe mode)
              83                     !     inseed            integer seed input
              84                     !     stat              type(random_stat) output
              85                     !   random_setseed      set seed (saved mode)
              86                     !     inseed            integer seed input
              87                     !   random_number       get mersenne twister random numbers (thread-safe mode)
              88                     !     harvest           real(:) numbers output
              89                     !     stat              type(random_stat) input
              90                     !   random_number       get mersenne twister random numbers (saved mode)
              91                     !     harvest           real(:) numbers output
              92                     !   random_number       get mersenne twister random numbers (interactive mode)
              93                     !     harvest           real(:) numbers output
              94                     !     inseed            integer seed input
              95                     !   random_number_f     get mersenne twister random number (functional mode)
              96                     !     harvest           real number output
              97                     !   random_gauss        get gaussian random numbers (thread-safe mode)
              98                     !     harvest           real(:) numbers output
              99                     !     stat              type(random_stat) input
             100                     !   random_gauss        get gaussian random numbers (saved mode)
             101                     !     harvest           real(:) numbers output
             102                     !   random_gauss        get gaussian random numbers (interactive mode)
             103                     !     harvest           real(:) numbers output
             104                     !     inseed            integer seed input
             105                     !   random_gauss_f      get gaussian random number (functional mode)
             106                     !     harvest           real number output
             107                     !   random_index        get random indices (thread-safe mode)
             108                     !     imax              integer maximum index input
             109                     !     iharvest          integer(:) numbers output
             110                     !     stat              type(random_stat) input
             111                     !   random_index        get random indices (saved mode)
             112                     !     imax              integer maximum index input
             113                     !     iharvest          integer(:) numbers output
             114                     !   random_index        get random indices (interactive mode)
             115                     !     imax              integer maximum index input
             116                     !     iharvest          integer(:) numbers output
             117                     !     inseed            integer seed input
             118                     !   random_index_f      get random index (functional mode)
             119                     !     imax              integer maximum index input
             120                     !     iharvest          integer number output
             121                     !
             122                     ! Remarks:
             123                     !   (1) Here are the comments in the original open source code:
             124                     !     A C-program for MT19937: Real number version
             125                     !     genrand() generates one pseudorandom real number (double)
             126                     !     which is uniformly distributed on [0,1]-interval, for each
             127                     !     call. sgenrand(seed) set initial values to the working area
             128                     !     of 624 words. Before genrand(), sgenrand(seed) must be
             129                     !     called once. (seed is any 32-bit integer except for 0).
             130                     !     Integer generator is obtained by modifying two lines.
             131                     !     Coded by Takuji Nishimura, considering the suggestions by
             132                     !     Topher Cooper and Marc Rieffel in July-Aug. 1997.
             133                     !     This library is free software; you can redistribute it and/or
             134                     !     modify it under the terms of the GNU Library General Public
             135                     !     License as published by the Free Software Foundation; either
             136                     !     version 2 of the License, or (at your option) any later
             137                     !     version.
             138                     !     This library is distributed in the hope that it will be useful,
             139                     !     but WITHOUT ANY WARRANTY; without even the implied warranty of
             140                     !     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
             141                     !     See the GNU Library General Public License for more details.
             142                     !     You should have received a copy of the GNU Library General
             143                     !     Public License along with this library; if not, write to the
             144                     !     Free Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA
             145                     !     02111-1307  USA
             146                     !     Copyright (C) 1997 Makoto Matsumoto and Takuji Nishimura.
             147                     !     When you use this, send an email to: matumoto@math.keio.ac.jp
             148                     !     with an appropriate reference to your work.
             149                     !     Fortran translation by Hiroshi Takano.  Jan. 13, 1999.
             150                     !
             151                     !   (2) On a single IBM Power4 processor on the NCEP operational cluster (2005)
             152                     !     each Mersenne twister random number takes less than 30 ns, about 3 times
             153                     !     slower than the default random number generator, and each random number
             154                     !     from a Gaussian distribution takes less than 150 ns.
             155                     !
             156                     ! Attributes:
             157                     !   Language: Fortran 90
             158                     !
             159                     !$$$
             160                           module mersenne_twister
             161                             private
             162                     !  Public declarations
             163                             public random_stat
             164                             public random_seed
             165                             public random_setseed
             166                             public random_number
             167                             public random_number_f
             168                             public random_gauss
             169                             public random_gauss_f
             170                             public random_index
             171                             public random_index_f
             172                     !  Parameters
             173                             integer,parameter:: n=624
             174                             integer,parameter:: m=397
             175                             integer,parameter:: mata=-1727483681 ! constant vector a
             176                             integer,parameter:: umask=-2147483648 ! most significant w-r bits
             177                             integer,parameter:: lmask =2147483647 ! least significant r bits
             178                             integer,parameter:: tmaskb=-1658038656 ! tempering parameter
             179                             integer,parameter:: tmaskc=-272236544 ! tempering parameter
             180                             integer,parameter:: mag01(0:1)=(/0,mata/)
             181                             integer,parameter:: iseed=4357
             182                             integer,parameter:: nrest=n+6
             183                     !  Defined types
             184                             type random_stat
             185                               private
             186                               integer:: mti=n+1
             187                               integer:: mt(0:n-1)
             188                               integer:: iset
             189                               real:: gset
             190                             end type
             191                     !  Saved data
             192                             type(random_stat),save:: sstat
             193                     !  Overloaded interfaces
             194                             interface random_setseed
             195                               module procedure random_setseed_s
             196                               module procedure random_setseed_t
             197                             end interface
             198                             interface random_number
             199                               module procedure random_number_i
             200                               module procedure random_number_s
             201                               module procedure random_number_t
             202                             end interface
             203                             interface random_gauss
             204                               module procedure random_gauss_i
             205                               module procedure random_gauss_s
             206                               module procedure random_gauss_t
             207                             end interface
             208                             interface random_index
             209                               module procedure random_index_i
             210                               module procedure random_index_s
             211                               module procedure random_index_t
             212                             end interface
             213                     !  All the subprograms
             214                           contains
             215                     !  Subprogram random_seed
             216                     !  Sets and gets state; overloads Fortran 90 standard.
             217                             subroutine random_seed(size,put,get,stat)
             218                               implicit none
             219                               integer,intent(out),optional:: size
             220                               integer,intent(in),optional:: put(nrest)
             221                               integer,intent(out),optional:: get(nrest)
             222                               type(random_stat),intent(inout),optional:: stat
             223     1                         if(present(size)) then     ! return size of seed array
             224     1               !     if(present(put).or.present(get))&
             225     1               !      call errmsg('RANDOM_SEED: more than one option set - some ignored')
             226     1                           size=nrest
             227     1                         elseif(present(put)) then  ! restore from seed array
             228     1               !     if(present(get))&
             229     1               !      call errmsg('RANDOM_SEED: more than one option set - some ignored')
             230     2                           if(present(stat)) then
             231     2                             stat%mti=put(1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stat, put
                                   <<< Loop-information  End >>>
             232     2   s   3v                    stat%mt=put(2:n+1)
             233     2                             stat%iset=put(n+2)
             234     2                             stat%gset=transfer(put(n+3:nrest),stat%gset)
                                   <<< Loop-information Start >>>

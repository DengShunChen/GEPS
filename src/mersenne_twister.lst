                                   <<<      stat
                                   <<< Loop-information  End >>>
             235     3   s   2v                    if(stat%mti.lt.0.or.stat%mti.gt.n.or.any(stat%mt.eq.0).or. &
             236     3                    &         stat%iset.lt.0.or.stat%iset.gt.1) then
             237     3                               call random_setseed_t(iseed,stat)
             238     3               !         call errmsg('RANDOM_SEED: invalid seeds put - default seeds used')
             239     3                             endif
             240     2                           else
             241     2                             sstat%mti=put(1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstat, put
                                   <<< Loop-information  End >>>
             242     2   s   3v                    sstat%mt=put(2:n+1)
             243     2                             sstat%iset=put(n+2)
             244     2                             sstat%gset=transfer(put(n+3:nrest),sstat%gset)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.37, ITR: 160, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstat
                                   <<< Loop-information  End >>>
             245     3   s   2v                    if(sstat%mti.lt.0.or.sstat%mti.gt.n.or.any(sstat%mt.eq.0)  &
             246     3                    &         .or.sstat%iset.lt.0.or.sstat%iset.gt.1) then
             247     3                               call random_setseed_t(iseed,sstat)
             248     3               !         call errmsg('RANDOM_SEED: invalid seeds put - default seeds used')
             249     3                             endif
             250     2                           endif
             251     1                         elseif(present(get)) then  ! save to seed array
             252     2                           if(present(stat)) then
             253     2                             if(stat%mti.eq.n+1) call random_setseed_t(iseed,stat)
             254     2                             get(1)=stat%mti
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600

             393                               call random_gauss_t(harvest,sstat)
             394                             end subroutine
             395                     !  Subprogram random_gauss_t
             396                     !  Generates Gaussian random numbers in thread-safe mode.
             397                             subroutine random_gauss_t(harvest,stat)
             398                               implicit none
             399                               real,intent(out):: harvest(:)
             400                               type(random_stat),intent(inout):: stat
             401                               integer mx,my,mz,j
             402                               real r2(2),r,g1,g2
             403                               mz=size(harvest)
             404                               if(mz.le.0) return
             405                               mx=0
             406     1                         if(stat%iset.eq.1) then
             407     1                           mx=1
             408     1                           harvest(1)=stat%gset
             409     1                           stat%iset=0
             410     1                         endif
             411                               my=(mz-mx)/2*2+mx
             412     1                         do
             413     1                           call random_number_t(harvest(mx+1:my),stat)
             414     2                           do j=mx,my-2,2
             415     2    i                        call rgauss(harvest(j+1),harvest(j+2),r,g1,g2)
             416     3                             if(r.lt.1.) then
             417     3                               harvest(mx+1)=g1
             418     3                               harvest(mx+2)=g2
             419     3                               mx=mx+2
             420     3                             endif
             421     2                           enddo
             422     1                           if(mx.eq.my) exit
             423     1                         enddo
             424     1                         if(my.lt.mz) then
             425     2                           do
             426     2                             call random_number_t(r2,stat)
             427     2    i                        call rgauss(r2(1),r2(2),r,g1,g2)
             428     2                             if(r.lt.1.) exit
             429     2                           enddo
             430     1                           harvest(mz)=g1
             431     1                           stat%gset=g2
             432     1                           stat%iset=1
             433     1                         endif
             434                             contains
             435                     !  Numerical Recipes algorithm to generate Gaussian random numbers.
             436                               subroutine rgauss(r1,r2,r,g1,g2)
             437                                 real,intent(in):: r1,r2
             438                                 real,intent(out):: r,g1,g2
             439                                 real v1,v2,fac
             440                                 v1=2.*r1-1.
             441                                 v2=2.*r2-1.
             442                                 r=v1**2+v2**2
             443     1                           if(r.lt.1.) then
             444     1                             fac=sqrt(-2.*log(r)/r)
             445     1                             g1=v1*fac
             446     1                             g2=v2*fac
             447     1                           endif
             448                               end subroutine
             449                             end subroutine

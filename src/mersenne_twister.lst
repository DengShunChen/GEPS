             325                     !  Subprogram random_number_t
             326                     !  Generates random numbers in thread-safe mode.
             327                             subroutine random_number_t(harvest,stat)
             328                               implicit none
             329                               real,intent(out):: harvest(:)
             330                               type(random_stat),intent(inout):: stat
             331                               integer j,kk,y
             332                               integer tshftu,tshfts,tshftt,tshftl
             333                               tshftu(y)=ishft(y,-11)
             334                               tshfts(y)=ishft(y,7)
             335                               tshftt(y)=ishft(y,15)
             336                               tshftl(y)=ishft(y,-18)
             337     1                         do j=1,size(harvest)
             338     2                           if(stat%mti.ge.n) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.26, ITR: 128, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             339     3   s   2v                    do kk=0,n-m-1
             340     3   p   2v                      y=ior(iand(stat%mt(kk),umask),iand(stat%mt(kk+1),lmask))
             341     3   p   2v                      stat%mt(kk)=ieor(ieor(stat%mt(kk+m),ishft(y,-1)),        &
             342     3                    &   mag01(iand(y,1)))
             343     3   p   2v                    enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 12, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             344     3   s   2s                    do kk=n-m,n-2
             345     3   p   2v                      y=ior(iand(stat%mt(kk),umask),iand(stat%mt(kk+1),lmask))
             346     3   m   2m                      stat%mt(kk)=ieor(ieor(stat%mt(kk+(m-n)),ishft(y,-1)),    &
             347     3                    &   mag01(iand(y,1)))
             348     3   p   2v                    enddo
             349     2                             y=ior(iand(stat%mt(n-1),umask),iand(stat%mt(0),lmask))
             350     2                             stat%mt(n-1)=ieor(ieor(stat%mt(m-1),ishft(y,-1)),          &
             351     2                    &   mag01(iand(y,1)))
             352     2                             stat%mti=0
             353     2                           endif
             354     1                           y=stat%mt(stat%mti)
             355     1                           y=ieor(y,tshftu(y))
             356     1                           y=ieor(y,iand(tshfts(y),tmaskb))
             357     1                           y=ieor(y,iand(tshftt(y),tmaskc))
             358     1                           y=ieor(y,tshftl(y))
             359     2                           if(y.lt.0) then
             360     2                             harvest(j)=(real(y)+2.0**32)/(2.0**32-1.0)
             361     2                           else
             362     2                             harvest(j)=real(y)/(2.0**32-1.0)
             363     2                           endif
             364     1                           stat%mti=stat%mti+1
             365     1                         enddo
             366                             end subroutine

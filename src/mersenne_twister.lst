                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             263     2       f                     get(n+3:nrest)=transfer(sstat%gset,get,nrest-(n+3)+1)
             264     2                           endif
             265     1                         else                       ! reset default seed
             266     2                           if(present(stat)) then
             267     2                             call random_setseed_t(iseed,stat)
             268     2                           else
             269     2                             call random_setseed_t(iseed,sstat)
             270     2                           endif
             271     1                         endif
             272                             end subroutine
             273                     !  Subprogram random_setseed_s
             274                     !  Sets seed in saved mode.
             275                             subroutine random_setseed_s(inseed)
             276                               implicit none
             277                               integer,intent(in):: inseed
             278                               call random_setseed_t(inseed,sstat)
             279                             end subroutine
             280                     !  Subprogram random_setseed_t
             281                     !  Sets seed in thread-safe mode.
             282                             subroutine random_setseed_t(inseed,stat)
             283                               implicit none
             284                               integer,intent(in):: inseed
             285                               type(random_stat),intent(out):: stat
             286                               integer ii,mti
             287                               ii=inseed
             288                               if(ii.eq.0) ii=iseed
             289                               stat%mti=n
             290                               stat%mt(0)=iand(ii,-1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stat
                                   <<< Loop-information  End >>>
             291     1   s   2s                do mti=1,n-1

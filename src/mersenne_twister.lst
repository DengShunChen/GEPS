                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             257     2       f                     get(n+3:nrest)=transfer(stat%gset,get,nrest-(n+3)+1)
             258     2                           else
             259     2                             if(sstat%mti.eq.n+1) call random_setseed_t(iseed,sstat)
             260     2                             get(1)=sstat%mti
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)

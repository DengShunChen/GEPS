             341     4   p    v                  a1=a1_coeff*var_temp**2
             342     4   p    v                  a2=a1*a2_coeff
             343     4                        ! Revise e-folding height based on PBL height and topographic std. dev. -- M. Toy 3/12/2018
             344     4   p    v                  H_efold = max(2*hprime(j),hpbl(j))
             345     4   p    v                  H_efold = min(H_efold,Hefold_nom)
             346     4   p    v                  za(j,k) = 0.5*(phii(j,k)+phii(j,k+1))/g
             347     4               !            wsp=SQRT(u1(j,k)**2 + v1(j,k)**2)
             348     4   p    v                  utmp=u1(j,k)+b(j,k)*deltim
             349     4   p    v                  vtmp=v1(j,k)+a(j,k)*deltim
             350     4   p    v                  wsp=SQRT(utmp*utmp + vtmp*vtmp)

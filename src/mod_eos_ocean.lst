             125                       ! ----------------------------------------------------------------------
             126                       real FUNCTION tmelts(s)
             127                       !!!  USE sit_constants_mod,     ONLY: tmelt
             128                         IMPLICIT NONE
             129                         real, INTENT(in) :: s
             130                     !   It is found that when water start to freeze, the sanility increases, while salinity increase to
             131                     !      centain level, e.g., 1694, tmelts can be as low as -323 K, then the model crash.
             132                         tmelts=tmelt-0.0575*s+1.710523E-3*s**1.5-2.154996E-4*s**2
             133                       END FUNCTION tmelts
             134                     ! ----------------------------------------------------------------------
             135                       real FUNCTION rhofn(T,s)
             136                       !*********************
             137                       ! Unesco 1983. Algorithms for computations of fundamental properties of seawater.
             138                       ! Unesco Technical Papers in Marine Science No 44, 53pp.
             139                       ! Fofonoff and Millard (Unesco, 1983)
             140                       !*********************
             141                       ! CALCUL SALINE WATER DENSITY
             142                       ! (assume standard sea water at P= 1 atm)
             143                       ! UNESCO (1981)
             144                       ! T: water temperature in K
             145                       ! tc: water temperature in degree C
             146                       ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             147                       !    which is KCl with mass fraction 32.4356E-3.
             148                       ! rhofn: kg/m3
             149                       !*********************
             150                       !!!  USE sit_constants_mod,     ONLY: tmelt
             151                         IMPLICIT NONE
             152                         real, INTENT(in) :: T,s
             153                         real :: tc, rhow
             154                         real :: rho_pure_water              ! density of the reference pure water (IUPAC, 1976)
             155                       !
             156                         tc=T-tmelt
             157                         rho_pure_water= 999.842594 + 6.793952E-2*tc - 9.095290E-3*tc**2 &
             158                           + 1.001685E-4*tc**3 - 1.120083E-6*tc**4 + 6.536332E-9*tc**5
             159                         rhofn= rho_pure_water &
             160                           + (8.24493E-1 -4.0899E-3*tc +7.6438E-5*tc**2 &
             161                               - 8.2467E-7*tc**3 +5.3875E-9*tc**4) *s &
             162                           + (-5.72466E-3 +1.0227E-4*tc -1.6546E-6*tc**2 )*s**(1.5) &
             163                           + 4.8314E-4*s**2
             164                       END FUNCTION rhofn
             165                     !*******************************************************************
             166                       real FUNCTION rhofn_Wright1997(T,s,p)
             167                       !*********************
             168                       ! Unesco 1983. Algorithms for computations of fundamental properties of seawater.
             169                       ! Unesco Technical Papers in Marine Science No 44, 53pp.
             170                       ! Fofonoff and Millard (Unesco, 1983)
             171                       !*********************
             172                       ! CALCUL SALINE WATER DENSITY
             173                       ! (assume standard sea water at P= 1 atm)
             174                       ! UNESCO (1981)
             175                       ! T: water temperature in K
             176                       ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             177                       !    which is KCl with mass fraction 32.4356E-3.
             178                       ! p=in situ pressure (dbars) (~ m depth)
             179                       ! rhofn2: kg/m3
             180                       !*********************
             181                       ! ref:
             182                       ! Wright, D.G., 1997: An Equation of State for Use in Ocean Models: Eckart¡¦s Formula Revisited.
             183                       !   J. Atmos. Oceanic Technol., 14, 735¡V740.
             184                       !
             185                       !!!  USE sit_constants_mod,     ONLY: tmelt
             186                         IMPLICIT NONE
             187                         real, INTENT(in) :: T,s,p
             188                         real :: tc  !   tc: water temperature in degree C
             189                         real :: pt  !   pt: potential temperature in deg C at surface
             190                       !
             191                         tc=T-tmelt
             192                         pt=theta(s,tc,p,0.)
             193          i              rhofn_Wright1997=r(pt,s,p)*1000.
             194                       END FUNCTION rhofn_Wright1997
             195                     
             196                     !*******************************************************************
             197                     FUNCTION r(t,s,p)
             198                     !!! Dan Wright's full e.o.s.
             199                     !!! r: density (g/cm**3)
             200                     !!! t: potential temperature at 0 dbar (deg C)
             201                     !!! s: salinity (PSU)
             202                     !!! ref:
             203                     !!! Wright, D.G., 1997: An Equation of State for Use in Ocean Models: Eckart¡¦s Formula Revisited.
             204                     !!!   J. Atmos. Oceanic Technol., 14, 735¡V740.
             205                     !!!
             206                         real:: r,t,s,p
             207                         real:: p02,p01
             208                         p02=1747.4508988+t*(11.51588-0.046331033*t)              &
             209                               -s*(3.85429655+0.01353985*t)
             210                         p01=p/10d0+5884.81703666+t*(39.803732+t*(-0.3191477      &
             211                     !   p01=       5884.81703666+t*(39.803732+t*(-0.3191477
             212                               +t*0.0004291133))+2.6126277*s
             213                         r=p01/(p02+0.7028423*p01)
             214                         RETURN
             215                     END FUNCTION r
             216                     !*******************************************************************
             217                     !*******************************************************************
             218                     FUNCTION theta(sal,ts,ps,pr)
             219                     !   ...sal=salinity
             220                     !   ...ts=in situ temp (deg cel)
             221                     !   ...ps=in situ pressure (dbars)
             222                     !   ...pr=reference pressure (dbars)
             223                     !   dbar = 10000 Pa = 10 kPa ~ rhow*g*1 m
             224                     !   1 m depth of water ~ 1 dbar
             225                     !
             226                         real:: theta,sal,ts,ps,pr
             227                         real:: delp,hafp,delt1,t1,delt2,t2,delt3,t3,             &
             228                           delt4,t4
             229                         delp=pr-ps
             230                         hafp=ps+.5*delp
             231          i              delt1=delp*gamma0(sal,ts,ps)
             232                         t1=ts+.5*delt1
             233          i              delt2=delp*gamma0(sal,t1,hafp)
             234                         t2=t1+.2928932*(delt2-delt1)
             235          i              delt3=delp*gamma0(sal,t2,hafp)
             236                         t3=t2+1.707107*(delt3-0.5857864*delt2-0.1213203*delt1)
             237          i              delt4=delp*gamma0(sal,t3,pr)
             238                         t4=t3+0.16666667*(delt4-6.828427*delt3+                  &
             239                            4.828427*delt2+delt1)
             240                         theta=t4
             241                         RETURN
             242                     END FUNCTION theta
             243                     !*******************************************************************
             244                     !*******************************************************************
             245                     FUNCTION gamma0(ss,tt,p)
             246                     !   ...adiabatic temperature gradient(deg c/dbar)
             247                     !   ...according to bryden (1973),dsr,20,401-408
             248                     !   ...copied from bio auxilary library
             249                         real:: gamma0,ss,tt,p
             250                         real:: xx
             251                         xx=ss-35.
             252                         gamma0=0.35803e-4+0.18932e-5*xx+p*(0.18741e-7-           &
             253                             0.11351e-9*xx-0.46206e-12*p)                         &
             254                             +tt*(0.85258e-5-0.42393e-7*xx+p*(-0.67795e-9+        &
             255                             0.27759e-11*xx+0.18676e-13*p)                        &
             256                             +tt*(-0.68360e-7+p*(0.87330e-11-0.21687e-15*p)       &
             257                             +tt*(0.66228e-9-0.54481e-13*p)))
             258                         RETURN
             259                     END FUNCTION gamma0
             260                     !*******************************************************************
             261                     !*******************************************************************
             262                       ! ----------------------------------------------------------------------
             263                       real FUNCTION drhodt(tc,s)
             264                       !*********************
             265                       ! CALCUL temp. derivate of SALINE WATER DENSITY d(rho)/dT
             266                       ! (assume standard sea water at P= 1 atm)
             267                       ! UNESCO (1981)
             268                       ! tc: water temperature in degree C
             269                       ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             270                       !    which is KCl with mass fraction 32.4356E-3.
             271                       ! drhodt: kg/m3/K
             272                       !*********************
             273                         IMPLICIT NONE
             274                         real, INTENT(in) :: tc,s
             275                     !
             276                         drhodt=0.06793952 + s**1.5*(0.00010227 - 3.3092e-6*tc) - 0.01819058*tc   &
             277                           + 0.0003005055*tc**2 - 4.480332e-6*tc**3 + 3.268166e-8*tc**4           &
             278                           + s*(-0.0040899 + 0.000152876*tc - 2.4740100e-6*tc**2 + 2.155e-8*tc**3)
             279                       END FUNCTION drhodt
             280                     ! ----------------------------------------------------------------------
             281                       real FUNCTION d2rhodt2(tc,s)
             282                       !*********************
             283                       ! CALCUL second temp. derivate of SALINE WATER DENSITY d2(rho)/dT2
             284                       ! (assume standard sea water at P= 1 atm)
             285                       ! UNESCO (1981)
             286                       ! tc: water temperatur (degree c)
             287                       ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             288                       !    which is KCl with mass fraction 32.4356E-3.
             289                       ! d2rhodt2: kg/m3/K2
             290                       !*********************
             291                         IMPLICIT NONE
             292                         real, INTENT(in) :: tc,s
             293                     !
             294                         d2rhodt2= -0.01819058 - 3.3092e-6*s**1.5 + 0.000601011*tc                &
             295                           - 0.000013440995999999998*tc**2 + 1.3072664000000002e-7*tc**3           &
             296                           +  s*(0.000152876 - 4.9480200000000004e-6*tc + 6.465e-8*tc**2)
             297                     
             298                       END FUNCTION d2rhodt2
             299                     ! ----------------------------------------------------------------------
             300                     !!! http://www.marine.csiro.au/~jackett/TEOS-10/
             301                     !!!
             302                     ! ----------------------------------------------------------------------
             303                       real FUNCTION tmaxden(s)
             304                     !*********************
             305                     ! CALCUL temp. at max density of saline water (K)
             306                     ! (assume standard sea water at P= 1 atm)
             307                     ! UNESCO (1981)
             308                     ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             309                     !    which is KCl with mass fraction 32.4356E-3.
             310                     ! Newton method
             311                     ! tmaxden: temp. at max density of water at salinity s (K)
             312                     !*********************
             313                     !!!    USE sit_constants_mod,     ONLY: tmelt
             314                         IMPLICIT NONE
             315                         real, INTENT(in) :: s
             316                         INTEGER  :: jj
             317                     !
             318                         tmaxden=0.   ! set first guess of temperature (= 0 degree c)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             319     1   s   fs          DO jj=0, 5      ! iteration 5 times
             320     1   mi  fm            tmaxden=tmaxden-drhodt(tmaxden,s)/d2rhodt2(tmaxden,s)
             321     1   p   fv          END DO
             322                         tmaxden=tmaxden+tmelt   ! change unit to K
             323                       END FUNCTION tmaxden
             324                     
             325                     ! ----------------------------------------------------------------------
             326                     
             327                       real FUNCTION rho_from_theta(s,th,p)
             328                     !  Algorithms for density, potential temperature, conservative temperature and freezing temperature of seawater
             329                     !  by
             330                     !  David R Jackett, Trevor J McDougall, Rainer Feistel, Daniel G Wright and Stephen M Griffies
             331                     !  submitted to
             332                     !  Journal of Atmospheric and Oceanonic Technology, 2005
             333                     !
             334                     !  !   in-situ density from potential temperature, as in
             335                     !   Jackett, McDougall, Feistel, Wright and Griffies (2004), submitted JAOT
             336                     !
             337                     !   s                : salinity                           (psu)
             338                     !   th               : potential temperature              (deg C, ITS-90)
             339                     !   p                : gauge pressure                     (dbar)
             340                     !                      (absolute pressure - 10.1325 dbar)
             341                     !
             342                     !   rho_from_theta   : in-situ density                    (kg m^-3)
             343                     !
             344                     !   check value      : rho_from_theta(20,20,1000) = 1017.728868019642
             345                     !
             346                     !   DRJ on 10/12/03
             347                     
             348                     
             349                     !!!  implicit real*8(a-h,o-z)
             350                       IMPLICIT NONE
             351                       real, INTENT(in) :: s,th,p
             352                       real :: th2,anum,aden,pth,sqrts
             353                     
             354                       th2 = th*th; sqrts = sqrt(s)
             355                     
             356                       anum =          9.9984085444849347d+02 +    &
             357                                  th*( 7.3471625860981584d+00 +    &
             358                                  th*(-5.3211231792841769d-02 +    &
             359                                  th*  3.6492439109814549d-04)) +  &
             360                                   s*( 2.5880571023991390d+00 -    &
             361                                  th*  6.7168282786692355d-03 +    &
             362                                   s*  1.9203202055760151d-03)
             363                     
             364                       aden =          1.0000000000000000d+00 +    &
             365                                  th*( 7.2815210113327091d-03 +    &
             366                                  th*(-4.4787265461983921d-05 +    &
             367                                  th*( 3.3851002965802430d-07 +    &
             368                                  th*  1.3651202389758572d-10))) + &
             369                                   s*( 1.7632126669040377d-03 -    &
             370                                  th*( 8.8066583251206474d-06 +    &
             371                                 th2*  1.8832689434804897d-10) +   &
             372                               sqrts*( 5.7463776745432097d-06 +    &
             373                                 th2*  1.4716275472242334d-09))
             374                     
             375                     
             376     1                 IF(p.ne.0.d0) then
             377     1               
             378     1                     pth = p*th
             379     1               
             380     1                     anum = anum +        p*( 1.1798263740430364d-02 +   &
             381     1                                        th2*  9.8920219266399117d-08 +   &
             382     1                                          s*  4.6996642771754730d-06 -   &
             383     1                                          p*( 2.5862187075154352d-08 +   &
             384     1                                        th2*  3.2921414007960662d-12))
             385     1               
             386     1                     aden = aden +        p*( 6.7103246285651894d-06 -   &
             387     1                                   pth*(th2*  2.4461698007024582d-17 +   &
             388     1                                          p*  9.1534417604289062d-18))
             389     1                 END IF
             390                       rho_from_theta = anum/aden
             391                     !	Note:   this function should always be run in double precision
             392                     !               (since rho is returned rather than sigma = rho-1.0d3)
             393                      END FUNCTION rho_from_theta
             394                     !-----------------------------------------------------------------------
             395                       real FUNCTION theta_from_t(s,t,p,pr)
             396                     !   potential temperature from in-situ temperature, as in
             397                     !   Jackett, McDougall, Feistel, Wright and Griffies (2004), submitted JAOT
             398                     !
             399                     !   s                : salinity                           (psu)
             400                     !   t                : in-situ temperature                (deg C, ITS-90)
             401                     !   p                : gauge pressure                     (dbar)
             402                     !                      (absolute pressure - 10.1325 dbar)
             403                     !   pr               : reference pressure                 (dbar)
             404                     !
             405                     !   theta_from_t     : potential temperature              (deg C, ITS-90)
             406                     !
             407                     !   calls            : de_dt_F and entropy_diff_F
             408                     !
             409                     !   check values     : theta_from_t(35,20,4000,0) = 19.21108374301637
             410                     !                                                           (with nloops=1)
             411                     !                      theta_from_t(35,20,4000,0) = 19.21108374301171
             412                     !                                                           (with nloops=2)
             413                     !
             414                     !   DRJ on 10/12/03
             415                     
             416                     !!!  implicit real*8(a-h,o-z)
             417                       IMPLICIT NONE
             418                       real, INTENT(in) :: s,t,p,pr
             419                       real :: th0,de_dt,dentropy,theta
             420                       INTEGER :: n,nloops
             421                     
             422                       th0 = t+(p-pr)*( 8.65483913395442d-6   - &
             423                                    s*  1.41636299744881d-6   - &
             424                               (p+pr)*  7.38286467135737d-9   + &
             425                                    t*(-8.38241357039698d-6   + &
             426                                    s*  2.83933368585534d-8   + &
             427                                    t*  1.77803965218656d-8   + &
             428                               (p+pr)*  1.71155619208233d-10))
             429                       de_dt = 13.6d0
             430                       nloops = 2					! default
             431                       !    NOTE: nloops = 1 gives theta with a maximum error of 5.48x10^-06
             432                       !          nloops = 2 gives theta with a maximum error of 2.84x10^-14
             433                       n = 1
             434     1                 DO WHILE(n.le.nloops)
             435     1                   dentropy = entropy_diff_F(s,t,p,th0,pr)
             436     1                   theta = th0-dentropy/de_dt
             437     1                   theta = 0.5d0*(theta+th0)
             438     1    i              de_dt = de_dt_F(s,theta,pr)
             439     1                   theta = th0-dentropy/de_dt
             440     1                   n = n+1; th0 = theta
             441     1                 END DO
             442                       theta_from_t = th0
             443                       END FUNCTION theta_from_t
             444                     !-----------------------------------------------------------------------
             445                       real FUNCTION entropy_diff_F(s,t,p,th0,pr)
             446                     
             447                     !   entropy difference from differentiating the Gibbs potential in
             448                     !   Feistel (2003), Prog. Ocean. 58, 43-114, and taking differences
             449                     !
             450                     !   s                : salinity                           (psu)
             451                     !   t                : in-situ temperature                (deg C, ITS-90)
             452                     !   th0              : potential temperature              (deg C, ITS-90)
             453                     !   p                : gauge pressure                     (dbar)
             454                     !                      (absolute pressure - 10.1325 dbar)
             455                     !   pr               : reference pressure                 (dbar)
             456                     !
             457                     !   entropy_diff     : entropy(s,th0,pr)-entropy(s,t,p)   (kJ/kgK)
             458                     !
             459                     !   DRJ on 10/12/03
             460                     !!!  implicit real*8(a-h,o-z)
             461                       IMPLICIT NONE
             462                       real, INTENT(in) :: s,t,p,th0,pr
             463                       real :: kTp,x2,x,y,z,z1,fTp,gTp,hTp,yz
             464                       x2 = 2.5d-2*s; x = sqrt(x2); y = 2.5d-2*th0; z = 1.0d-4*pr; z1 = z
             465                       fTp = -5.90578348518236d0 + y*(24715.571866078d0 + &
             466                                      y*(-2210.2236124548363d0 + y*(592.743745734632d0 + &
             467                                      y*(-290.12956292128547d0 + (113.90630790850321d0 - &
             468                                                          21.35571525415769d0*y)*y))))
             469                       gTp = y*(-1858.920033948178d0 + y*(781.281858144429d0 + &
             470                                       y*(-388.6250910633612d0 + 87.18719211065d0*y)))
             471                       hTp = y*(317.440355256842d0 + y*(-202.5696441786141d0 + &
             472                                                                67.5605099586024d0*y))
             473     1                 IF(z.ne.0.d0) then
             474     1                      yz = y*z
             475     1                      fTp = fTp + z*(270.983805184062d0 + z*(-776.153611613101d0 + &
             476     1                                   z*(196.51255088122d0 + z*(-28.9796526294175d0 + &
             477     1                             2.13290083518327d0*z)))) + y*(z*(-2910.0729080936d0 + &
             478     1                                 z*(1513.116771538718d0 + z*(-546.959324647056d0 + &
             479     1                               (111.1208127634436d0 - 8.68841343834394d0*z)*z))) + &
             480     1                              y*(z*(2017.52334943521d0 + z*(-1498.081172457456d0 + &
             481     1                                z*(718.6359919632359d0 + z*(-146.4037555781616d0 + &
             482     1                         4.9892131862671505d0*z)))) + y*(z*(-1591.873781627888d0 + &
             483     1                                 z*(1207.261522487504d0 + z*(-608.785486935364d0 + &
             484     1                        105.4993508931208d0*z))) + y*(y*(67.41756835751434d0*y*z + &
             485     1                                 z*(-381.06836198507096d0 + (133.7383902842754d0 - &
             486     1                             49.023632509086724d0*z)*z)) + z*(973.091553087975d0 + &
             487     1                                    z*(-602.603274510125d0 + (276.361526170076d0 - &
             488     1                                                  32.40953340386105d0*z)*z))))))
             489     1                      gTp = gTp + z*(-729.116529735046d0 + z*(343.956902961561d0 + &
             490     1                                     z*(-124.687671116248d0 + (31.656964386073d0 - &
             491     1                          7.04658803315449d0*z)*z))) + y*(z*(1721.528607567954d0 + &
             492     1                                  z*(-674.819060538734d0 + z*(356.629112415276d0 + &
             493     1                                 z*(-88.4080716616d0 + 15.84003094423364d0*z)))) + &
             494     1                            y*(y*z*(1190.914967948748d0 + z*(-298.904564555024d0 + &
             495     1                              145.9491676006352d0*z)) + z*(-2082.7344423998043d0 + &
             496     1                                  z*(614.668925894709d0 + z*(-340.685093521782d0 + &
             497     1                                                       33.3848202979239d0*z)))))
             498     1                      hTp = hTp + z*(175.292041186547d0 + z*(-83.1923927801819d0 + &
             499     1                            29.483064349429d0*z)) + y*(y*(1380.9597954037708d0*z - &
             500     1                                 938.26075044542d0*y*z) + z*(-766.116132004952d0 + &
             501     1                                (108.3834525034224d0 - 51.2796974779828d0*z)*z))
             502     1                 ENDIF
             503                       y = 2.5d-2*t; z = 1.0d-4*p
             504                       fTp = fTp +5.90578348518236d0 - y*(24715.571866078d0 + &
             505                                      y*(-2210.2236124548363d0 + y*(592.743745734632d0 + &
             506                                      y*(-290.12956292128547d0 + (113.90630790850321d0 - &
             507                                                          21.35571525415769d0*y)*y))))
             508                       gTp = gTp - y*(-1858.920033948178d0 + y*(781.281858144429d0 + &
             509                                   y*(-388.6250910633612d0 + 87.18719211065d0*y)))
             510                       hTp = hTp - y*(317.440355256842d0 + y*(-202.5696441786141d0 + &
             511                                                            67.5605099586024d0*y))
             512                       kTp = 22.6683558512829d0*(z1-z)
             513     1                 IF(z.ne.0.d0) then
             514     1                     yz = y*z
             515     1                     fTp = fTp - ( z*(270.983805184062d0 + z*(-776.153611613101d0 + &
             516     1                                    z*(196.51255088122d0 + z*(-28.9796526294175d0 + &
             517     1                              2.13290083518327d0*z)))) + y*(z*(-2910.0729080936d0 + &
             518     1                                  z*(1513.116771538718d0 + z*(-546.959324647056d0 + &
             519     1                                (111.1208127634436d0 - 8.68841343834394d0*z)*z))) + &
             520     1                               y*(z*(2017.52334943521d0 + z*(-1498.081172457456d0 + &
             521     1                                 z*(718.6359919632359d0 + z*(-146.4037555781616d0 + &
             522     1                          4.9892131862671505d0*z)))) + y*(z*(-1591.873781627888d0 + &
             523     1                                  z*(1207.261522487504d0 + z*(-608.785486935364d0 + &
             524     1                         105.4993508931208d0*z))) + y*(y*(67.41756835751434d0*y*z + &
             525     1                                  z*(-381.06836198507096d0 + (133.7383902842754d0 - &
             526     1                              49.023632509086724d0*z)*z)) + z*(973.091553087975d0 + &
             527     1                                     z*(-602.603274510125d0 + (276.361526170076d0 - &
             528     1                                                  32.40953340386105d0*z)*z)))))))
             529     1                     gTp = gTp - ( z*(-729.116529735046d0 + z*(343.956902961561d0 + &
             530     1                                      z*(-124.687671116248d0 + (31.656964386073d0 - &
             531     1                           7.04658803315449d0*z)*z))) + y*(z*(1721.528607567954d0 + &
             532     1                                   z*(-674.819060538734d0 + z*(356.629112415276d0 + &
             533     1                                  z*(-88.4080716616d0 + 15.84003094423364d0*z)))) + &
             534     1                             y*(y*z*(1190.914967948748d0 + z*(-298.904564555024d0 + &
             535     1                               145.9491676006352d0*z)) + z*(-2082.7344423998043d0 + &
             536     1                                   z*(614.668925894709d0 + z*(-340.685093521782d0 + &
             537     1                                                       33.3848202979239d0*z))))))
             538     1                     hTp = hTp - ( z*(175.292041186547d0 + z*(-83.1923927801819d0 + &
             539     1                             29.483064349429d0*z)) + y*(y*(1380.9597954037708d0*z - &
             540     1                                  938.26075044542d0*y*z) + z*(-766.116132004952d0 + &
             541     1                                (108.3834525034224d0 - 51.2796974779828d0*z)*z)))
             542     1                 ENDIF
             543                       entropy_diff_F = 2.5d-2*(fTp+x2*(gTp+x*hTp+x2*kTp))
             544                       END FUNCTION entropy_diff_F
             545                     !-----------------------------------------------------------------------
             546                       real FUNCTION de_dt_F(s,t,p)
             547                     !   d(entropy)/dt from twice differentiating the Gibbs potential in
             548                     !   Feistel (2003), Prog. Ocean. 58, 43-114
             549                     !
             550                     !   s                : salinity                           (psu)
             551                     !   t                : in-situ temperature                (deg C, ITS-90)
             552                     !   p                : gauge pressure                     (dbar)
             553                     !                      (absolute pressure - 10.1325 dbar)
             554                     !
             555                     !   de_dt_F          : d(entropy)/dt                      (J/kgK^2)
             556                     !
             557                     !   check value      : de_dt_F(35,20,4000) = 13.35022011370635
             558                     !
             559                     !   DRJ on 10/12/03
             560                     !!!  implicit real*8(a-h,o-z)
             561                       IMPLICIT NONE
             562                       real, INTENT(in) :: s,t,p
             563                       real :: x2,x,y,z,z1,de_dt
             564                       x2 = 2.5d-2*s; x = sqrt(x2); y = 2.5d-2*t; z = 1.0d-4*p
             565                       de_dt = 24715.571866078d0 + x2*(-1858.920033948178d0 + &
             566                                       x*(317.440355256842d0 + y*(-405.1392883572282d0 + &
             567                                      202.6815298758072d0*y)) + y*(1562.563716288858d0 + &
             568                                      y*(-1165.8752731900836d0 + 348.7487684426d0*y))) + &
             569                                     y*(-4420.4472249096725d0 + y*(1778.231237203896d0 + &
             570                                        y*(-1160.5182516851419d0 + (569.531539542516d0 - &
             571                                                          128.13429152494615d0*y)*y)))
             572                     
             573                     
             574     1                 IF(z.ne.0.d0) then
             575     1                     de_dt = de_dt + &
             576     1                                 z*(-2910.0729080936d0 + x2*(1721.528607567954d0 + &
             577     1                              y*(-4165.4688847996085d0 + 3572.7449038462437d0*y) + &
             578     1                                  x*(-766.116132004952d0 + (2761.9195908075417d0 - &
             579     1                               2814.78225133626d0*y)*y)) + y*(4035.04669887042d0 + &
             580     1                                  y*(-4775.621344883664d0 + y*(3892.3662123519d0 + &
             581     1                            y*(-1905.341809925355d0 + 404.50541014508605d0*y)))) + &
             582     1                                z*(1513.116771538718d0 + x2*(-674.819060538734d0 + &
             583     1                                    108.3834525034224d0*x + (1229.337851789418d0 - &
             584     1                              896.713693665072d0*y)*y) + y*(-2996.162344914912d0 + &
             585     1                                  y*(3621.784567462512d0 + y*(-2410.4130980405d0 + &
             586     1                                668.691951421377d0*y))) + z*(-546.959324647056d0 + &
             587     1                                   x2*(356.629112415276d0 - 51.2796974779828d0*x + &
             588     1                               y*(-681.370187043564d0 + 437.84750280190565d0*y)) + &
             589     1                               y*(1437.2719839264719d0 + y*(-1826.356460806092d0 + &
             590     1                              (1105.446104680304d0 - 245.11816254543362d0*y)*y)) + &
             591     1                                   z*(111.1208127634436d0 + x2*(-88.4080716616d0 + &
             592     1                                 66.7696405958478d0*y) + y*(-292.8075111563232d0 + &
             593     1                               (316.49805267936244d0 - 129.6381336154442d0*y)*y) + &
             594     1                                   (-8.68841343834394d0 + 15.84003094423364d0*x2 + &
             595     1                                                    9.978426372534301d0*y)*z))))
             596     1               
             597     1                 ENDIF
             598                     
             599                       de_dt_F = 6.25d-4*de_dt
             600                     
             601                       END FUNCTION de_dt_F
             602                       !*******************************************************************
             603                       real FUNCTION rhofn_Jackett2005(T,s,p)
             604                       !  Algorithms for density, potential temperature, conservative temperature and freezing temperature of seawater
             605                       !  by
             606                       !  David R Jackett, Trevor J McDougall, Rainer Feistel, Daniel G Wright and Stephen M Griffies
             607                       !  submitted to
             608                       !  Journal of Atmospheric and Oceanonic Technology, 2005
             609                       !*********************
             610                       ! CALCUL SALINE WATER DENSITY
             611                       ! (assume standard sea water at P= 1 atm)
             612                       ! T: water temperature in K
             613                       ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             614                       !    which is KCl with mass fraction 32.4356E-3.
             615                       ! p=in situ pressure (dbars) (~ m depth)
             616                       ! rhofn2: kg/m3
             617                       !*********************
             618                       ! ref:
             619                       ! Wright, D.G., 1997: An Equation of State for Use in Ocean Models: Eckart¡¦s Formula Revisited.
             620                       !   J. Atmos. Oceanic Technol., 14, 735¡V740.
             621                       !
             622                       !!!  USE sit_constants_mod,     ONLY: tmelt
             623                         IMPLICIT NONE
             624                         real, INTENT(in) :: T,s,p
             625                         real :: tc  !   tc: water temperature in degree C
             626                         real :: pt  !   pt: potential temperature in deg C at surface
             627                       !
             628                         tc=T-tmelt
             629                         pt=theta_from_t(s,tc,p,0.)
             630                         rhofn_Jackett2005=rho_from_theta(s,pt,p)
             631                       END FUNCTION rhofn_Jackett2005
             632                     !*******************************************************************
             633                     
             634                     !*******************************************************************
             635                       real FUNCTION rhofn2(T,s,p)
             636                       !*********************
             637                       !*********************
             638                       ! CALCUL SALINE WATER DENSITY
             639                       ! (assume standard sea water at P= 1 atm)
             640                       ! T: water temperature in K
             641                       ! s: practial salinity. Note fresh water s=0, standard sea water s=35,
             642                       !    which is KCl with mass fraction 32.4356E-3.
             643                       ! p=in situ gauge pressure (dbars) (~ m depth)
             644                       ! rhofn2: kg/m3
             645                       !*********************
             646                       !
             647                         IMPLICIT NONE
             648                         real, INTENT(in) :: T,s,p
             649          i              rhofn2=rhofn_Jackett2005(T,s,p)
             650                       END FUNCTION rhofn2
             651                     
             652                     !--------------------------------------------------------------------------------------
             653                     REAL(dp) FUNCTION CalcSm(StabilityParameter,z0w,liw)
             654                     !    USE mo_constants
             655                     
             656                     	IMPLICIT NONE
             657                     
             658                     	REAL(dp) z0w,liw
             659                     	REAL(dp) Sm,x
             660                     	REAL(dp) StabilityParameter
             661                     
             662                     !
             663                     !	Brutsaert (1992)
             664                     !
             665     1               	if (StabilityParameter > 0.00) then
             666     2               		if (StabilityParameter >= 1.00)	then
             667     2               			CalcSm= -5.-5.*log(StabilityParameter)
             668     2               		else
             669     2               			CalcSm= -5.*StabilityParameter
             670     2               		endif
             671     1               	else
             672     2               		if (StabilityParameter >= -0.0059)	then
             673     2               			CalcSm= 0.
             674     2               		else if ( (StabilityParameter <= -0.0059) .AND. (StabilityParameter >= -15.025) )then
             675     2               			CalcSm= 1.47*log( (0.28+(-StabilityParameter)**0.75)/(0.28+(0.0059-z0w*liw)**0.75) )&
             676     2               &					-1.29*( (-StabilityParameter)**(1/3)-(0.0059-z0w*liw)**(1/3) )
             677     2               		else
             678     2               			CalcSm= 1.47*log( (0.28+15.025**0.75)/(0.28+(0.0059-z0w*liw)**0.75) )&
             679     2               &					-1.29*( 15.025**(1/3)-(0.0059-z0w*liw)**(1/3) )
             680     2               		endif
             681     1               	endif
             682                     !
             683                     !	Businger (1971)
             684                     !
             685                     !	if (StabilityParameter > 0.00) then
             686                     !		if (StabilityParameter >= 1.00)	then
             687                     !			CalcSm= -5.-5.*log(StabilityParameter)
             688                     !		else
             689                     !			CalcSm= -5.*StabilityParameter
             690                     !		endif
             691                     !	else
             692                     !		x = (1.-16.0*StabilityParameter)**0.25
             693                     !		CalcSm= 2.*log((1.+x)/2.)+log((1+(x**2.0))/2.0)-2.*atan(x)+API/2.0
             694                     !	endif
             695                     
             696                         RETURN
             697                     END FUNCTION CalcSm
             698                     !--------------------------------------------------------------------------------------
             699                     REAL(dp) FUNCTION AirVaporPressure(AirTemperature,RelativeHumidity)
             700                       IMPLICIT NONE
             701                     
             702                     	REAL(dp) AirTemperature
             703                     	REAL(dp) RelativeHumidity
             704                     !	REAL SaturatedVaporPressure
             705          i          	AirVaporPressure= SaturatedVaporPressure(AirTemperature)*RelativeHumidity
             706                     
             707                     	RETURN
             708                     END FUNCTION AirVaporPressure
             709                     !--------------------------------------------------------------------------------------
             710                     REAL(dp) FUNCTION SaturatedVaporPressure(T)
             711                       IMPLICIT NONE
             712                     
             713                     	REAL(dp) T
             714                     	REAL(dp) Tr
             715                     	Tr= 1.00 - 373.15/T
             716                     	SaturatedVaporPressure= 1013.25*exp(13.3185*Tr-1.976*(Tr**2.0)-&
             717                     &		0.6445*(Tr**3.0)-0.1299*(Tr**4.0))
             718                     
             719                     	RETURN
             720                     END FUNCTION SaturatedVaporPressure
             721                     !--------------------------------------------------------------------------------------
             722                     
             723                     END MODULE mod_eos_ocean


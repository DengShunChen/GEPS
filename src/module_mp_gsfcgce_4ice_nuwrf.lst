            1370     4               !           X(i,k,j)=A0*AMAX1(X(i,k,j), 0.0)
            1371     4   p   2v                 X(i,k,j)=A0*DMAX1(X(i,k,j), 0.0)
            1372     4   p   2v                 enddo
            1373     3   p                   enddo
            1374     2   p                enddo
            1375     1                 endif
            1376                     
            1377                       END SUBROUTINE negcor

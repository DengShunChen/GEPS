            2498                     !
            2499                     !     ******   THREE CLASSES OF ICE-PHASE   (LIN ET AL, 1983)  *********
            2500                     
            2501                           d2t=dt
            2502                     
            2503                           r2ig=1.
            2504                           r2is=1.
            2505                           r2ih=1.
            2506                     
            2507                     !C  TAO 2007 END
            2508                     
            2509                           cmin=1.e-20
            2510                     !JJS  10/7/2008
            2511                           cmin1=1.e-20
            2512                           cmin2=1.e-35
            2513                     
            2514                           xssi=0.16  ! maximum allowable ice supersaturation from SEL
            2515                           rssi=0.05  ! maximum allowable residual ice supersaturation SEL
            2516                           xsubi=0.70  ! ice RH below which qi must sublimate
            2517                     
            2518                     !  HALLET-MOSSOP RIME SPLINTERING parameters
            2519                           ihalmos=1
            2520                           xnsplnt=370.     ! peak # splinters per milligram of rime
            2521                           xmsplnt=4.4e-8   ! mass of a splinter (from Ferrier 1994)
            2522                           hmtemp1=-2.
            2523                           hmtemp2=-4.
            2524                           hmtemp3=-6.
            2525                           hmtemp4=-8.
            2526                     
            2527              s            it(:)=1
            2528                     !!!!!!!!08/07/12
            2529                           f2=rd1*d2t
            2530                           f3=rd2*d2t
            2531                     
            2532                           ft=dt/d2t
            2533                     
            2534                           bw3=bw+3.
            2535                           bs3=bs+3.
            2536                           bg3=bg+3.
            2537                           bh3=bh+3
            2538                           bsh5=2.5+bsh
            2539                           bgh5=2.5+bgh
            2540                           bhh5=2.5+bhh
            2541                           bwh5=2.5+bwh
            2542                           bw6=bw+6.
            2543                           bs6=bs+6.
            2544                     !      betah=.5*beta
            2545                     
            2546                           r10t=rn10*d2t
            2547                           r25a=rn25
            2548                     
            2549                           rdt=1./d2t
            2550                           r11t=rn11*d2t
            2551                           r19t=rn19*d2t
            2552                           r19at=rn19a*d2t
            2553                           r20t=rn20*d2t
            2554                           r23t=rn23*d2t
            2555                           r30t=rn30*d2t
            2556                           r33t=rn33*d2t
            2557                           bg3_2=bg2+3
            2558                           bgh5_2=2.5+bgh2
            2559                     
            2560                     !JJS 20150831
            2561                     ! Calculate the threshold for reducing spurious evaporation
            2562                     ! a function of dx (grid resolution in km)
            2563                     
            2564                           thresh_evap = -39.974 * exp(-1.194 * dx/1000.)
            2565                     
            2566                     !      if ( wrf_dm_on_monitor() .and. itimestep.eq.1 .and. &
            2567                     !           i.eq.its .and. j.eq.jts ) then
            2568                     !         print *,'GSFCGCE 4ice scheme inside satice improve=',improve
            2569                     !         print *,'dx, thresh_evap = ', dx, thresh_evap
            2570                     !         print *,'no reduce suprious evaporation adjustment'
            2571                     !      endif
            2572                     
            2573                           Rc=1.e-3               ! cloud droplet radius 10 microns
            2574                           Ra=1.e-5               ! aerosol radius 0.1 microns
            2575                           Cna=500.               ! contact nuclei conc per cc
            2576                           Bhi=1.01e-2            ! pollen (Deihl et al. 2006)
            2577                     
            2578                     !C    ******************************************************************
            2579                     
            2580     1                 do 1000 k=kts,kte
            2581     1                      kp=k+1
            2582     1                      tb0=0.
            2583     1                      qb0=0.
            2584     1               
            2585     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

            3908     4                               if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            3909     4                                     chem_opt == 302 .or. chem_opt == 303) .and. &
            3910     4                                     (gsfcgce_gocart_coupling == 1) ) then
            3911     4                                  !JJS 20110602 vvvvv
            3912     4                                  ! Conversion rate of cloud water to ice in the Bergeron porcess based on Meyer + DeMott formulae
            3913     4                                  !
            3914     4                                  ! convert gocart aerosol mass conc to IN
            3915     4                                  !      p0 need to be converted from g*cm/s2/cm2 to mb (hPa)
            3916     4                                  !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out)
            3917     4                                  !                icn_cgs(i,k) = max(min_icn, icn_out) * 1.e-3   !IN conc [#/cm3] <-- [#/Litter]
            3918     4                                  !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out,i,k)
            3919     4                                  !                icn_out = min(1.e3, max(0.01e0 ,  icn_out) )
            3920     4                                  !                icn_cgs(i,k) = icn_out * 1.e-3 !IN conc [#/cm3]
            3921     4                                  !                r_nci = icn_cgs(i,k)  !DeMotto's formuale
            3922     4                                  r_nci = icn_out(i) * 1.e-3  !DeMotto's formuale
            3923     4                                  !JJS 20110602 ^^^^^
            3924     4                               end if
            3925     4               #endif
            3926     4               
            3927     4   s    s                      pidep(i)=max(R32RT(i)*1.e4*fssi*sqrt(r_nci)*y3(i)/     & !meyers
            3928     4                               dd(i)*fdwv, -qi(i))                    !fix SEL
            3929     4   s    s                      if(qi(i).le.cmin) pidep(i)=0.
            3930     4   s    s                      dd(i)=max(1.e-9*r_nci/r00(i)-qci(i,k)*1.e-9/ami50, 0.)
            3931     4   s    s                      pint(i)=max(min(dd(i),dm(i)),0.)
            3932     4   s    s                      pint(i)=min(pint(i)+pidep(i), dep(i))
            3933     4   s    s                      pt(i)=pt(i)+ascp(i)*pint(i)
            3934     4   s    s                      tair(i)=(pt(i)+tb0)*pi0(i)
            3935     4   s    s                      qv(i)=qv(i)-pint(i)
            3936     4   s    s                      qi(i)=qi(i)+pint(i)

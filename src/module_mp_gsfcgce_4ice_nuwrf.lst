            3589     2   s    s                pracs(i)=(1.-dlt2(i))*pracs(i)
            3590     2   s    s                pwacs(i)=(1.-dlt4(i))*pwacs(i)
            3591     2   s    s                pracg(i)=(1.-dlt2(i))*pracg(i)
            3592     2   s    s                psn(i)=d2t*(pgacs(i)+dgacs(i)+wgacs(i)   &
            3593     2                                  +pracs(i)+pwacs(i)+whacs(i))
            3594     2               

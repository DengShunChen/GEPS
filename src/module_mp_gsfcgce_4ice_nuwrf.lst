            1787                           rn21=1.e-3
            1788                           bnd21=1.5e-3
            1789                     !
            1790                           erc=1.
            1791                           rn22=.25*cpi*erc*tnw
            1792                     !
            1793                           rn23=2.*cpi*tnw
            1794                           rn23a=.31*ga5bh*sqrt(ac1)
            1795                           rn23b=alv*alv/rw
            1796                           rn231=.78
            1797                           rn232=.31*ga3*sqrt(3.e3/dva)
            1798                     !
            1799                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1800                     !cc
            1801                     !cc        "c0" in routine      "consat" (2d), "consatrh" (3d)
            1802                     !cc        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
            1803                     !cc        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
            1804                     
            1805                            itaobraun=0
            1806                     
            1807                              cn0=1.e-8
            1808                              beta=-.6
            1809                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1810                     !
            1811                           rn25=cn0
            1812                           rn30b=alv/tca
            1813                           rn30c=ars/(dwv*amw)
            1814                           rn31=1.e-17
            1815                     
            1816                           rn32=4.*51.545e-4
            1817                     !!
            1818                           rn33=4.*tns
            1819                           rn331=.65
            1820                           rn332=.44*sqrt(as/dva)*ga5dh
            1821                     !
            1822                           amc=1./(24.*4.e-9)
            1823                           rn34=cpi2*esc*amc*as*roqs*tns*ga6d
            1824                           rn35=alv*alv/(cp*rw)
            1825                     
            1826                           gn17=2.*cpi*tng                                                      !4ice revised
            1827                           gn17a=.31*ga5gh*sqrt(ag)                                             !4ice revised
            1828                           gn17a2=.31*ga5gh2*sqrt(ag2)                                          !4ice revised
            1829                     
            1830                           ehs=1.
            1831                           hn9=cpi2*ehs*tns*tnh*roqs
            1832                           ehg=0.3
            1833                           hn10=cpi2*ehg*tng*tnh*roqg
            1834                           ehw=1.
            1835                           hn14=.25*cpi*ehw*tnh*ga3h*ah
            1836                           ehi=1.
            1837                           hn15a=.25*cpi*ehi*tnh*ga3h*ah
            1838                           ehr=1.
            1839                           hn16=cpi2*ehr*tnh*tnw*roqr
            1840                           hn17=2.*cpi*tnh
            1841                           hn17a=.31*ga5hh*sqrt(ah)
            1842                           hn19=2.*cpi*tnh/alf
            1843                           hn19a=.31*ga5hh*sqrt(ah)
            1844                           hn10a=als*als/rw
            1845                           hn20=2.*cpi*tnh
            1846                           hn20b=.31*ga5hh*sqrt(ah)
            1847                     
            1848                     ! JDC add schmidt number term
            1849                           sc13    = 0.8420526
            1850                           rn102   = rn102 * sc13
            1851                           rn17a   = rn17a * sc13
            1852                           rn17a2  = rn17a2 * sc13
            1853                           rn192   = rn192 * sc13
            1854                           rn192_2 = rn192_2 * sc13
            1855                           rn232   = rn232 * sc13
            1856                           rn332   = rn332 * sc13
            1857                     
            1858                       END SUBROUTINE consat_s
            1859                     
            1860                     !JJS
            1861                     !JJS      REAL FUNCTION GAMMA(X)
            1862                     !JJS        Y=GAMMLN(X)
            1863                     !JJS        GAMMA=EXP(Y)
            1864                     !JJS      RETURN
            1865                     !JJS      END
            1866                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1867                     !JJS      real function GAMMLN (xx)
            1868                       real function gammagce (xx)
            1869                     !**********************************************************************
            1870                       implicit none
            1871                     
            1872                       real*8 cof(6),stp,half,one,fpf,x,tmp,ser
            1873                       data cof,stp /  76.18009173,-86.50532033,24.01409822, &
            1874                          -1.231739516,.120858003e-2,-.536382e-5, 2.50662827465 /
            1875                       data half,one,fpf / .5, 1., 5.5 /
            1876                     !
            1877                       real xx
            1878                       real gammln
            1879                       integer j
            1880                     
            1881                           x=xx-one
            1882                           tmp=x+fpf
            1883                           tmp=(x+half)*log(tmp)-tmp
            1884                           ser=one
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1885     1   s   fs            do  j=1,6
            1886     1   s   fs               x=x+one
            1887     1   m   fm              ser=ser+cof(j)/x
            1888     1   p   fv            enddo !j
            1889                           gammln=tmp+log(stp*ser)
            1890                     !JJS
            1891                           gammagce=exp(gammln)
            1892                     !JJS
            1893                     
            1894                      END FUNCTION gammagce
            1895                     
            1896                     !DIR$ ATTRIBUTES FORCEINLINE :: sgmap
            1897                       SUBROUTINE sgmap(isg,qcs,qcg,qcg2,qch,qch2,r00,tairc,ftnsg)
            1898                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1899                     ! compute base snow/graupel intercept scaling factor - ftnsg
            1900                     ! isg -- flag
            1901                     !        1 ftnsg=snow intercept scaling factor
            1902                     !        2 ftnsg=graupel intercept scaling factor
            1903                     !        3 ftnsg=snow density scaling factor
            1904                     ! tns is the actual intercept
            1905                     !
            1906                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1907                       IMPLICIT NONE
            1908                     
            1909                     !      common/size/ tnw,tns,tng,roqs,roqg,roqr  !defined in the beginning of the module
            1910                       integer, intent(in)  :: isg
            1911                     !  integer, intent(in)  :: i, j, k
            1912                     !  INTEGER, INTENT(IN)  :: ims,ime, jms,jme, kms,kme,  &
            1913                     !                          its,ite, jts,jte, kts,kte
            1914                       real,    intent(in)  :: r00, tairc
            1915                     !  real,    DIMENSION( ims:ime, jms:jme, kms:kme ), intent(in)  :: qcs,qcg, qch
            1916                     !  real,    DIMENSION( its:ite, jts:jte, kts:kte ), intent(in)  :: qcs,qcg, qch
            1917                       real,    intent(in)  :: qcs,qcg,qcg2,qch,qch2
            1918                       real,    intent(out) :: ftnsg
            1919                     
            1920                     
            1921                     ! LOCAL variables
            1922                     
            1923                     !!  for snomap
            1924                     !  real ::  xs,sno11,sno00,dsno11,dsno00,sexp11,sexp00,stt,   &
            1925                     !                stexp,sbase,tslopes,dsnomin,slim
            1926                     !!  for grpmap
            1927                     !  real ::  xg,grp11,grp00,dgrp11,dgrp00,gexp11,gexp00,gtt,   &
            1928                     !                gtexp,gbase,tslopeg,dgrpmin, glim
            1929                     
            1930                       real :: taird, qsg, qsg1, xx, fexp  !, cpi, cmin Di
            1931                       real :: ftnsT, sno1, dsno1, sexp1, ftnsQ, tnsmax, densno
            1932                       real :: ftngT, grp1, dgrp1, gexp1, ftngQ, tngmax
            1933                       real :: hx, gx, hgx
            1934                       real :: kk
            1935                       real :: hai2, dhai1
            1936                     !  CPI=4.*ATAN(1.)
            1937                     !  cmin=1.e-20  !4ice
            1938                     
            1939                       ftnsg=1.
            1940                     
            1941                     !  if (isg.eq.1.or.isg.eq.3) qsg=qcs(i,k,j)
            1942                     !  if (isg.eq.2.) qsg = qcg(i,k,j)
            1943                       if (isg.eq.1.or.isg.eq.3) qsg=qcs
            1944                     !NUWRF EMK...Fix options 2 and 4.
            1945                       if (isg.eq.2) qsg = qcg
            1946                       if (isg.eq.4) qsg = qch
            1947                     
            1948     1                 if (qsg .gt. cmin) then
            1949     1               
            1950     1                    qsg1=qsg*r00*1.e6
            1951     1               
            1952     1               !     if (isg.eq.1) then                          !snow
            1953     2                    if(isg.eq.1.or.isg.eq.3)then  !snow 4ice
            1954     2                       taird=min(0.,max(stt,tairc)+0.0)
            1955     2                       ftnsT=exp(-1.*tslopes*taird)
            1956     2                       sno1=sno11
            1957     2                       dsno1=dsno11
            1958     2                       sexp1=sexp11
            1959     2               
            1960     3                       if (taird.gt.stt) then
            1961     3                          sno1=sno00-(sno00-sno11)*(taird/stt)**stexp
            1962     3                          dsno1=dsno00-(dsno00-dsno11)*(taird/stt)**stexp
            1963     3                          sexp1=sexp00-(sexp00-sexp11)*(taird/stt)**stexp
            1964     3                       endif !taird
            1965     2               
            1966     2                         hx=0.
            1967     2                         gx=0.
            1968     2                         hgx=1.
            1969     2               
            1970     2                          if(qch2*1.e6*r00.gt.0.008)    &
            1971     2                             hx=max(1.,qch2*1.e6*r00*125.)
            1972     2                          if(qcg2*1.e6*r00.gt.0.040)    &
            1973     2                             gx=max(1.,qcg2*1.e6*r00*25.)
            1974     2                          hgx=hx+gx
            1975     2                          hgx=max(1.,hgx)
            1976     2               
            1977     2                       xx=xs-xs*min(slim,max(0.,(qsg1-sno1)/dsno1)**sexp1)
            1978     2                       ftnsT=ftnsT**xx
            1979     2                       fexp=xx
            1980     2                       ftnsQ=1.0
            1981     2                       ftnsQ=(qsg1/sbase)**fexp
            1982     2                       ftnsg=ftnsT*ftnsQ*hgx
            1983     2                       tnsmax=r00*qsg/dsnomin4
            1984     2               
            1985     2                       if (ftnsg*tns.gt.tnsmax) ftnsg=tnsmax/tns               !4ice
            1986     2               !        densno=0.004168*(ftnsg*tns/qsg/r00)**0.3115   !4ice Heymsfield et al. 2004
            1987     2                       densno=0.001996*(ftnsg*tns/qsg/r00)**0.2995   !Brandes et al. 2007
            1988     2                       if(isg.eq.3) ftnsg=min(densno,0.9)/roqs            !4ice
            1989     2               
            1990     2                    else if (isg.eq.2) then                      !graupel
            1991     2                           taird=min(0.,max(gtt,tairc)+0.0)
            1992     2                            ftngT=exp(-1.*tslopeg*taird)
            1993     2                            grp1=grp11
            1994     2                            dgrp1=dgrp11
            1995     2                            gexp1=gexp11
            1996     2               
            1997     3                            if (taird.gt.gtt) then
            1998     3                               grp1=grp00-(grp00-grp11)*(taird/gtt)**gtexp
            1999     3                               dgrp1=dgrp00-(dgrp00-dgrp11)*(taird/gtt)**gtexp
            2000     3                               gexp1=gexp00-(gexp00-gexp11)*(taird/gtt)**gtexp
            2001     3                            endif !taird
            2002     2               
            2003     2                            xx=xg-xg*min(glim,max(0.0,(qsg1-grp1)/dgrp1)**gexp1)
            2004     2                            ftngT=ftngT**xx
            2005     2                            fexp=xx
            2006     2                            ftngQ=1.0
            2007     2                            ftngQ=(qsg1/gbase)**fexp
            2008     2                            ftnsg=ftngT*ftngQ
            2009     2                            tngmax=r00*qsg/dgrpmin4
            2010     2                            if (ftnsg*tng.gt.tngmax) ftnsg=tngmax/tng
            2011     2               
            2012     2               	elseif(isg.eq.4)then  !hail
            2013     2                            hai2=hai00
            2014     2                            if(tairc.le.htt0.and.tairc.ge.htt1) &  !fin18
            2015     2                               hai2=hai11+(hai00-hai11)*((tairc-htt1)/(htt0-htt1))**haixp   !fin18
            2016     2                            if(tairc.le.htt1)  hai2=hai11     !fin18
            2017     2                               dhai1=hai2          !x2
            2018     2                            if(qsg1.ge.hai2)    &
            2019     2                               ftnsg=1.0-0.80*min(max((qsg1-hai2)/dhai1,0.),1.) !  fin16
            2020     2               
            2021     2                    endif !isg
            2022     1               
            2023     1                 endif !qsg
            2024                     
            2025                       end subroutine sgmap
            2026                     
            2027                     !     compute fall speed of cloud rain and ice
            2028                       SUBROUTINE vqrqi(isg,r00,fv,qri,ql,tair,ww1)
            2029                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2030                     ! compute fall speed of cloud rain and ice
            2031                     ! isg=1, for rain
            2032                     ! isg=2, for ice
            2033                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2034                       implicit none
            2035                     
            2036                       integer, intent(in) :: isg
            2037                       real, intent(in) :: r00, fv,qri,ql,tair
            2038                       real, intent(inout) :: ww1
            2039                     
            2040                     ! LOCAL variables
            2041                       integer :: ic
            2042                       real  :: y1,vr,vs,vg
            2043                       real  :: const_vt, const_d, const_m !cpi, cmin Di
            2044                       real  :: bb1, bb2,ice_fall
            2045                       real  :: bin_factor, ftnw, ftnwmin
            2046                       real, dimension(7) ::  aice, vice
            2047                       data aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./
            2048                       data vice/5,15,30,35,40,45,50/
            2049                     
            2050                     !  cmin=1.e-40
            2051                     !  CPI=4.*ATAN(1.)
            2052                          ice_fall=0.
            2053                          const_vt=1.49e4
            2054                          const_d=11.9
            2055                          const_m=1./5.38e7
            2056                     
            2057                       y1=r00*qri
            2058                       ww1=0.
            2059                     
            2060     1                 if (y1 .gt. cmin) then
            2061     1               
            2062     2                   if (isg.eq.1) then                             !  rain
            2063     2               
            2064     2                      ftnw=1.
            2065     3                          if(ql.lt.cmin .and. tair .gt. t0)then
            2066     3                            bin_factor=0.11*(1000.*qri)**(-1.27) + 0.98
            2067     3                            bin_factor=min(bin_factor, 1.30)
            2068     3                            ftnw=1./bin_factor**3.35
            2069     3                            ftnwmin=r00*qri/draimax
            2070     3                            if(qri.le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            2071     3                          endif
            2072     2               
            2073     2                              vs=sqrt( y1 )
            2074     2                              vg=sqrt( vs)
            2075     2               !               vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
            2076     2                              vr=vrc0+vrc1*vg/ftnw**0.25+vrc2*vs/ftnw**0.50+vrc3*vg*vs/ftnw**0.75
            2077     2                              ww1=max(fv*vr, 0.e0)
            2078     2               
            2079     2               
            2080     2                   else if (isg.eq.2) then                         ! cloud ice
            2081     2               
            2082     2                           y1=1.e6*r00*qri                            ! to g/m**3
            2083     2               
            2084     3                           if (y1 .gt. 1.e-6) then
            2085     3                                 y1=y1*1.e-3
            2086     3                                 bb1=const_m*y1**0.25
            2087     3                                 bb2=const_d*bb1**0.5
            2088     3                                 ww1=max(const_vt*bb2**1.31, 0.0)
            2089     3                                 ww1=ww1*100. !cm/s
            2090     3                                 if (ww1 .gt. 50.) ww1=50.               ! SLang
            2091     3                           endif  !y1
            2092     2                   endif  !isg
            2093     1                 endif !y1
            2094                     
            2095                       end subroutine vqrqi
            2096                     
            2097                       SUBROUTINE saticel_s (dt, dx, itaobraun, istatmin,                   &
            2098                                            new_ice_sat, id, improve,                       &
            2099                                            ptwrf, qvwrf, qlwrf, qrwrf,                     &
            2100                                            qiwrf, qswrf, qgwrf, qhwrf,                     &
            2101                                            rho_mks, pi_mks, p0_mks, w_mks,                 &
            2102                                            itimestep, xland,                               &
            2103                                            refl_10cm, diagflag, do_radar_ref,              & ! GT added for reflectivity calcs
            2104                     !                       ids,ide, jds,jde, kds,kde,                      &
            2105                                            ims,ime, jms,jme, kms,kme,                      &
            2106                                            its,ite, jts,jte, kts,kte,                      &
            2107                     !NUWRF BEGIN
            2108                                            re_cloud_gsfc, re_rain_gsfc, re_ice_gsfc,       &
            2109                                            re_snow_gsfc, re_graupel_gsfc, re_hail_gsfc,    & ! cloud effective radius
            2110                                            physc, physe, physd, physs, physm, physf,       &
            2111                                            acphysc, acphyse, acphysd, acphyss, acphysm, acphysf &
            2112                     #if ( WRF_CHEM == 1)
            2113                     !JJS 20110525 vvvvv
            2114                                            ,aero, icn_diag, nc_diag, gid,                   &
            2115                     !JJS 20110525 ^^^^^
            2116                     ! EMK
            2117                                            chem_opt,                                       &
            2118                                            gsfcgce_gocart_coupling                        &
            2119                     #endif
            2120                                            ,ii,j,irestrict)
            2121                     !NUWRF END

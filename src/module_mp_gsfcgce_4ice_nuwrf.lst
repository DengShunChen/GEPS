            4830                           REAL, DIMENSION(kts:kte):: rr, rs, rg
            4831                     
            4832                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilams, ilamg
            4833                           DOUBLE PRECISION, DIMENSION(kts:kte):: N0_r, N0_s, N0_g
            4834                           DOUBLE PRECISION:: lamr, lams, lamg
            4835                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            4836                     
            4837                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            4838                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            4839                     
            4840                           INTEGER:: i, k, k_0, kbot, n
            4841                           LOGICAL:: melti
            4842                     
            4843                           DOUBLE PRECISION:: cback, x, eta, f_d
            4844                           REAL, PARAMETER:: R=287.
            4845                           REAL, PARAMETER:: PIx=3.1415926536
            4846                     
            4847                     !+---+
            4848                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            4849     1  pp   4v            do k = kts, kte
            4850     1   p   4v               dBZ(k) = -35.0
            4851     1   p   4v            enddo
            4852                     
            4853                     !+---+-----------------------------------------------------------------+
            4854                     !..Put column of data into local arrays.
            4855                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 14
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, p1d, t1d, pres, N0_g
                                   <<<      L_qg, N0_s, L_qs, N0_r, L_qr, qv1d, qv
                                   <<<      rho, ilamr
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      rr: 2, ilams: 2, rs: 2, rg: 2, ilamg: 2
                                   <<<      temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 1  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4856     1  pp    v            do k = kts, kte
            4857     1   p    v               temp(k) = t1d(k)
            4858     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            4859     1   p    v               pres(k) = p1d(k)
            4860     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            4861     1               
            4862     2   p    v               if (qr1d(k) .gt. 1.E-9) then
            4863     2   p    v                  rr(k) = qr1d(k)*rho(k)
            4864     2   p    v                  N0_r(k) = xnor
            4865     2   p    v                  lamr = (xam_r*xcrg(3)*N0_r(k)/rr(k))**(1./xcre(1))
            4866     2   p    v                  ilamr(k) = 1./lamr
            4867     2   p    v                  L_qr(k) = .true.
            4868     2   p    v               else
            4869     2   p    v                  rr(k) = 1.E-12
            4870     2   p    v                  L_qr(k) = .false.
            4871     2   p    v               endif
            4872     1               
            4873     2   p    v               if (qs1d(k) .gt. 1.E-9) then
            4874     2   p    v                  rs(k) = qs1d(k)*rho(k)
            4875     2   p    v                  N0_s(k) = xnos
            4876     2   p    v                  lams = (xam_s*xcsg(3)*N0_s(k)/rs(k))**(1./xcse(1))
            4877     2   p    v                  ilams(k) = 1./lams
            4878     2   p    v                  L_qs(k) = .true.
            4879     2   p    v               else
            4880     2   p    v                  rs(k) = 1.E-12
            4881     2   p    v                  L_qs(k) = .false.
            4882     2   p    v               endif
            4883     1               
            4884     2   p    v               if (qg1d(k) .gt. 1.E-9) then
            4885     2   p    v                  rg(k) = qg1d(k)*rho(k)
            4886     2   p    v                     N0_g(k) = xnog
            4887     2   p    v                  lamg = (xam_g*xcgg(3)*N0_g(k)/rg(k))**(1./xcge(1))
            4888     2   p    v                  ilamg(k) = 1./lamg
            4889     2   p    v                  L_qg(k) = .true.
            4890     2   p    v               else
            4891     2   p    v                  rg(k) = 1.E-12
            4892     2   p    v                  L_qg(k) = .false.
            4893     2   p    v               endif
            4894     1   p    v            enddo
            4895                     
            4896                     !+---+-----------------------------------------------------------------+
            4897                     !..Locate K-level of start of melting (k_0 is level above).
            4898                     !+---+-----------------------------------------------------------------+
            4899                           melti = .false.
            4900                           k_0 = kts
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp
                                   <<< Loop-information  End >>>
            4901     1                     do k = kte-1, kts, -1
            4902     2                        if ( (temp(k).gt.273.15) .and. L_qr(k)                         &
            4903     2                                                 .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            4904     2                           k_0 = MAX(k+1, k_0)
            4905     2                           melti=.true.
            4906     2                           goto 195
            4907     2                        endif
            4908     1                     enddo
            4909                      195  continue
            4910                     
            4911                     !+---+-----------------------------------------------------------------+
            4912                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            4913                     !.. and non-water-coated snow and graupel when below freezing are
            4914                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            4915                     !+---+-----------------------------------------------------------------+
            4916                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, ilams, L_qr, N0_s
                                   <<<      ilamr, N0_r
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 4
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4917     1  pp    v            do k = kts, kte
            4918     1   p    v               ze_rain(k) = 1.e-22
            4919     1   p    v               ze_snow(k) = 1.e-22
            4920     1   p    v               ze_graupel(k) = 1.e-22
            4921     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*xcrg(4)*ilamr(k)**xcre(4)
            4922     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PIx)*(6.0/PIx)     &
            4923     1                                                * (xam_s/900.0)*(xam_s/900.0)          &
            4924     1                                                * N0_s(k)*xcsg(4)*ilams(k)**xcse(4)
            4925     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PIx)*(6.0/PIx)  &
            4926     1                                                   * (xam_g/900.0)*(xam_g/900.0)       &
            4927     1                                                   * N0_g(k)*xcgg(4)*ilamg(k)**xcge(4)
            4928     1   p    v            enddo
            4929                     
            4930                     
            4931                     !+---+-----------------------------------------------------------------+
            4932                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            4933                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            4934                     !.. extremely simple based on amount found above the melting level.
            4935                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            4936                     !.. routines).
            4937                     !+---+-----------------------------------------------------------------+
            4938                     
            4939     1                     if (melti .and. k_0.ge.kts+1) then
            4940     2                      do k = k_0-1, kts, -1
            4941     2               
            4942     2               !..Reflectivity contributed by melting snow
            4943     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            4944     3                          fmelt_s = MAX(0.005d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            4945     3                          eta = 0.d0
            4946     3                          lams = 1./ilams(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<< Loop-information  End >>>
            4947     4                          do n = 1, nrbins
            4948     4                             x = xam_s * xxDs(n)**xbm_s
            4949     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocms),DBLE(xobms), &
            4950     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            4951     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            4952     4                                   inclusionstring_s, hoststring_s,                    &
            4953     4                                   hostmatrixstring_s, hostinclusionstring_s)
            4954     4                             f_d = N0_s(k)*xxDs(n)**xmu_s * DEXP(-lams*xxDs(n))
            4955     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            4956     4                          enddo
            4957     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4958     3                         endif
            4959     2               
            4960     2               !..Reflectivity contributed by melting graupel
            4961     2               
            4962     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            4963     3                          fmelt_g = MAX(0.005d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            4964     3                          eta = 0.d0
            4965     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, simpson, xdtg
                                   <<< Loop-information  End >>>
            4966     4                          do n = 1, nrbins
            4967     4                             x = xam_g * xxDg(n)**xbm_g
            4968     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocmg),DBLE(xobmg), &
            4969     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            4970     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            4971     4                                   inclusionstring_g, hoststring_g,                    &
            4972     4                                   hostmatrixstring_g, hostinclusionstring_g)
            4973     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            4974     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            4975     4                          enddo
            4976     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            4977     3                         endif
            4978     2               
            4979     2                      enddo
            4980     1                     endif
            4981                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            4982     1  pp    v            do k = kte, kts, -1
            4983     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            4984     1   p    v            enddo
            4985                     
            4986                           end subroutine refl10cm_gsfc

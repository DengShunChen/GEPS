            3969     3               
            3970     3   s    s                  if(ww1(i,k) .ge. thresh_evap)  cnd(i)=max(0.,cnd(i)) !reduce spurious evap
            3971     3               
            3972     3   s    s                  pt(i)=pt(i)+avcp(i)*cnd(i)
            3973     3   s    s                  tair(i)=(pt(i)+tb0)*pi0(i)
            3974     3   s    s                  qv(i)=qv(i)-cnd(i)
            3975     3   s    s                  qc(i)=qc(i)+cnd(i)
            3976     3   p    v               endif
            3977     3   s    s               if (tair(i).le.273.16) THEN
            3978     3               !c    ******   deposition or sublimation of qi    ******
            3979     3   s    s                  y1(i)=1./(tair(i)-c358)
            3980     3   s    s                  qsw(i)=rp0(i)*exp(c172-c409*y1(i))
            3981     3   s    s                  y2(i)=1./(tair(i)-c76)
            3982     3   s    s                  qsi(i)=rp0(i)*exp(c218-c580*y2(i))
            3983     3   s    s                  fssi=min(xssi,max(rssi,xssi*(tair(i)-t0+44.0)/(44.0-38.0)))
            3984     3   s    s                  fssi=rssi

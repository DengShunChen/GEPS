            2824     2   s    s              DO i=1,irestrict
            2825     2               
            2826     2               !JJS   for calculating processes related to both ice and warm rain
            2827     2               
            2828     2               !     ***   COMPUTE ZR,ZS,ZG,VR,VS,VG      *****************************
            2829     2               
            2830     3   m    m                  if (qr(i) .gt. cmin) then
            2831     3   s    s      	       dd(i)=r00(i)*qr(i)
            2832     3   s    s      	       y1(i)=sqrt(dd(i))
            2833     3   s    s      	       y2(i)=sqrt(y1(i))
            2834     3   s    s      	       zr(i)=zrc/y2(i)
            2835     3   p    v                  endif
            2836     2               
            2837     2   m    m                  call vqrqi(1,r00(i),fv0(i),qr(i),qc(i),tair(i),vr(i))
            2838     2   s    s                  call vqrqi(2,r00(i),fv0(i),qi(i),qc(i),tair(i),vi(i))
            2839     2               
            2840     2   s    s                  ftns(i)=1.
            2841     2   s    s                  ftns0(i)=1.
            2842     2               
            2843     2   s    s                  qhz2=qhwrf(i,k)
            2844     2   s    s                  qgz2=qgwrf(i,k)
            2845     3   m    s                  if (k .lt. kte-2 .and. tairc(i) .ge. -5) then
            2846     3   s    s                     qhz2=qhwrf(i,k+1)
            2847     3   s    s                     qgz2=qgwrf(i,k+1)
            2848     3   p    v                  endif
            2849     2   s    s                  call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            2850     2   s    s                  call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            2851     2               
            2852     3   s    s      	    if (qs(i) .gt. cmin) then
            2853     3   s    s      	       dd(i)=r00(i)*qs(i)
            2854     3   s    s      	       y1(i)=dd(i)**.25
            2855     3   s    s                     ftns(i)=1.
            2856     3   s    s                     ftns(i)=ftns0(i)**0.25
            2857     3   s    s                     fros(i)=1                                        !improve4
            2858     3   s    s                     fros(i)=fros0(i)**0.25        !improve4
            2859     3   s    s                     ZS(i)=ZSC/Y1(i)*ftns(i)*fros(i)            !improve4
            2860     3   s    s                     ftns(i)=ftns0(i)**bsq
            2861     3   s    s                     fros(i)=fros0(i)**bsq         !improve4
            2862     3   s    s                     VS(i)=MAX(vscf(i)*DD(i)**BSQ/ftns(i)/fros(i), 0.)
            2863     3   p    v                  endif
            2864     2               
            2865     2   m    m                  ftng(i)=1.
            2866     2   s    s                  ftng0(i)=1.
            2867     2   s    s                  call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            2868     2               
            2869     3   s    s      	    if (qg(i) .gt. cmin) then
            2870     3   s    s      	       dd(i)=r00(i)*qg(i)
            2871     3   s    s      	       y1(i)=dd(i)**.25
            2872     3   s    s                     ftng(i)=1.
            2873     3   s    s                     ftng(i)=ftng0(i)**0.25
            2874     3               
            2875     3   s    s                     zg(i)=zgc/y1(i)*ftng(i)
            2876     3   s    s                     if(dd(i).gt.qrog2) zg(i)=zgc2/y1(i)*ftng(i)
            2877     3               
            2878     3   s    s                     ftng(i)=ftng0(i)**bgq
            2879     3   m    s      	       vg(i)=max(vgcf(i)*dd(i)**bgq/ftng(i), 0.0)
            2880     4   s    s                     if(dd(i).gt.qrog2)then
            2881     4   s    s                     ftng(i)=ftng0(i)**bgq2
            2882     4   m    s                     vg(i)=max(vgcf2(i)*dd(i)**bgq2/ftng(i), 0.e0)
            2883     4   p    s                    endif !improve4
            2884     3   p    v                 endif !qg
            2885     2               
            2886     2   s    s                 call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))
            2887     2               
            2888     3   s    s                 if (qh(i) .gt. cmin) then
            2889     3   s    s                    dd(i)=r00(i)*qh(i)
            2890     3   s    s                    y1(i)=dd(i)**.25
            2891     3   s    s                    ftnh(i)=ftnh0(i)**0.25
            2892     3   s    s                    zh(i)=zhc/y1(i)*ftnh(i)
            2893     3   s    s                    ftnh(i)=ftnh0(i)**bhq
            2894     3   m    s                    vh(i)=max(vhcr(i)*dd(i)**bhq/ftnh(i), 0.0)
            2895     3   p    v                  endif
            2896     2               
            2897     2   s    s                  if (qr(i) .le. cmin1) vr(i)=0.0
            2898     2   m    m                  if (qs(i) .le. cmin1) vs(i)=0.0
            2899     2   m    m                  if (qg(i) .le. cmin1) vg(i)=0.0
            2900     2   m    m                  if (qi(i) .le. cmin1) vi(i)=0.0
            2901     2   p    m                  if (qh(i) .le. cmin1) vh(i)=0.0
            2902     2               
            2903     2               !!     ******************************************************************
            2904     2               !!     ***   Y1 : DYNAMIC VISCOSITY OF AIR (U)
            2905     2               !!     ***   DWV : DIFFUSIVITY OF WATER VAPOR IN AIR (PI)
            2906     2               !!     ***   TCA : THERMAL CONDUCTIVITY OF AIR (KA)
            2907     2               !!     ***   Y2 : KINETIC VISCOSITY (V)
            2908     2               !
            2909     2               
            2910     2               !*  1 * PSAUT : AUTOCONVERSION OF QI TO QS                        ***1**
            2911     2               !*  3 * PSACI : ACCRETION OF QI TO QS                             ***3**
            2912     2               !*  4 * PSACW : ACCRETION OF QC BY QS (RIMING) (QSACW FOR PSMLT)  ***4**
            2913     2               !*  5 * PRACI : ACCRETION OF QI BY QR                             ***5**
            2914     2               !*  6 * PIACR : ACCRETION OF QR OR QG BY QI                       ***6**
            2915     2               !* 34 * pwacs : collection of qs by qc                            **34**
            2916     2               
            2917     2   p    v                pihms(i)=0.0
            2918     2   s    s                pihmg(i)=0.0
            2919     2   s    s                psaut(i)=0.0
            2920     2   s    s                psaci(i)=0.0
            2921     2   s    s                praci(i)=0.0
            2922     2   s    s                piacr(i)=0.0
            2923     2   s    s                psacw(i)=0.0
            2924     2   s    s                pwacs(i)=0.0
            2925     2   s    s                qsacw(i)=0.0
            2926     2   s    s                ftns(i)=1.
            2927     2   s    s                ftng(i)=1.
            2928     2   s    s                ftnh(i)=1.
            2929     2   s    s      	  ftns(i)=ftns0(i)
            2930     2   s    s      	  ftng(i)=ftng0(i)
            2931     2               
            2932     3   s    s                if (tair(i).lt.t0) then
            2933     3               
            2934     3   s    s                   rn1=1./300.
            2935     3   p    s                   bnd1=6.e-5
            2936     3   p    s                   esi(i)=0.25
            2937     3   m    s                   psaut(i)=r2is*max(rn1*esi(i)*(qi(i)-bnd1*fv0(i)*fv0(i)) ,0.0)
            2938     3   s    s                   ftns(i)=ftns0(i)
            2939     3   s    s                   ftng(i)=ftng0(i)
            2940     3   s    s                   fros(i)=fros0(i)
            2941     3   m    s                   ftnh(i)=ftnh0(i)
            2942     3   s    s                   esi(i)=1.0 !esi constant in consatrh via r3f/rn3; use esi( ) to make f(T)/f(q)
            2943     3   m    s                   dmicrons=(r00(i)*qs(i)/(roqs*fros(i))/cpi/(tns*ftns(i)))**.25*1.e4
            2944     3   p    s                   esi(i)=min(1.,(dmicrons/375.)**3.) ! f(dmicrons)
            2945     3               
            2946     3   s    s                   y1(i)=1.0
            2947     3   s    s                   if (vs(i).gt.0.) y1(i)=abs((vs(i)-vi(i))  &
            2948     3                                                                /vs(i))
            2949     3   m    s                   psaci(i)=r2is*y1(i)*r3f(i)*qi(i)/zs(i)**bs3*ftns(i)*esi(i)
            2950     3   p    s                   if(qs(i).le.cmin) psaci(i)=0.
            2951     3   m    s                   psacw(i)=r2is*r4f(i)*qc(i)/zs(i)**bs3*ftns(i)
            2952     3   p    s                   if(qs(i).le.cmin) psacw(i)=0.
            2953     4   m    s                   if (ihalmos.eq.1)then
            2954     4   p    s                      y2(i)=0.
            2955     4   m    s                      if((tairc(i).le.hmtemp1).and.(tairc(i).ge.hmtemp4))  &
            2956     4                                                                        y2(i)=0.5
            2957     4   p    s                      if((tairc(i).le.hmtemp2).and.(tairc(i).ge.hmtemp3))  &
            2958     4                                                                        y2(i)=1.
            2959     4   m    s                      pihms(i)=r2ih*psacw(i)*y2(i)*xnsplnt*1000.*xmsplnt
            2960     4   p    s                      psacw(i)=psacw(i)-pihms(i)
            2961     4   p    s                   endif
            2962     3   m    s                   pwacs(i)=r2is*r34f(i)*qc(i)/zs(i)**bs6*ftns(i)*fros(i)      !improve4
            2963     3   p    s                   if(qs(i).le.cmin) pwacs(i)=0.
            2964     3   m    s                   y1(i)=1./zr(i)
            2965     3   m    s                   y2(i)=y1(i)*y1(i)
            2966     3   s    s                   y3(i)=y1(i)*y2(i)
            2967     3   s    s                   y5(i)=1.0
            2968     3   s    s                   if (vr(i).gt.0.) y5(i)=abs((vr(i)-vi(i))   &
            2969     3                                                                        /vr(i))
            2970     3   m    s                   dd(i)=y5(i)*r5f(i)*qi(i)*y3(i)*(rn50+rn51*y1(i)             &
            2971     3                                                       +rn52*y2(i)+rn53*y3(i))
            2972     3   p    s                   praci(i)=max(dd(i),0.0)
            2973     3   p    s                   if (qr(i) .le. cmin) praci(i)=0.
            2974     3   m    s                   y4(i)=y3(i)*y3(i)
            2975     3   m    s                   dd1(i)=y5(i)*r6f(i)*qi(i)*y4(i)*(rn60+rn61*y1(i)       &
            2976     3                                                    +rn62*y2(i)+rn63*y3(i))
            2977     3               
            2978     3   p    s                   piacr(i)=max(dd1(i),0.0)
            2979     3   p    s                   if (qr(i) .le. cmin) piacr(i)=0.
            2980     3   s    s                else
            2981     3   m    s                   qsacw(i)=r2is*r4f(i)*qc(i)/zs(i)**bs3*ftns(i)
            2982     3   p    s                   if (qs(i) .le. cmin) psacw(i)=0.
            2983     3   p    v                endif   !tairc
            2984     2               
            2985     2               
            2986     2               !23456789012345678901234567890123456789012345678901234567890123456789012
            2987     2               !* 21 * PRAUT   AUTOCONVERSION OF QC TO QR                        **21**
            2988     2               !* 22 * PRACW : ACCRETION OF QC BY QR                             **22**
            2989     2               
            2990     2               #if (WRF_CHEM == 1)
            2991     2               !JJS 20110602 vvvvv
            2992     2                            ! EMK...Only execute when GOCART and coupling are selected
            2993     2                            if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            2994     2                                  chem_opt == 302 .or. chem_opt == 303) .and. &
            2995     2                                  (gsfcgce_gocart_coupling == 1) ) then
            2996     2                               !      sat vapor pressure [hPa,mb]
            2997     2                               e_sat = 6.11 * exp( 5423. *( 1.0/273.15 - 1./tair(i) ) )
            2998     2                               !      dry air vapor pressure [hPa, mb]
            2999     2                               e_dry = qv(i) / ( qv(i) + 0.622 ) * p0(i,k) * 1.e-3  ! p0 in [g*cm/s2/cm2]
            3000     2                               rh_rad = max(1.e-6, e_dry/e_sat*100.)  ! relative humidity [%]
            3001     2                               super_sat = max(0.001, rh_rad - 100.e0) !super saturation [%]
            3002     2                               !
            3003     2                               ! convert gocart aerosol mass conc to CN
            3004     2                               !
            3005     2                               call mass2ccn(tair(i),super_sat,aero(i,k,:),ccn_out(i) )
            3006     2                               !             nc_cgs(i,k)  = max(100., ccn_out)  !diagnostic cloud droplet conc  [#/cm3]
            3007     2                               ccn_out(i) = max(100., ccn_out(i))
            3008     2               
            3009     2               !                rho_dryair = p0(i,k) / ( tair(i) * 2.87 * 1.0e6) ! dry air density [g/cm3]
            3010     2                               L_cloud = qc(i) * rho(i,k)             ! cloud water [g/cm3]
            3011     2                               !  g/g        g/cm3
            3012     2                               !             call auto_conversion( L_cloud, nc_cgs(i,k), P_liu_daum, re_liu_daum )
            3013     2                               call auto_conversion( L_cloud, ccn_out(i), P_liu_daum, re_liu_daum )
            3014     2               
            3015     2                               praut(i) = P_liu_daum / rho(i,k)  !autoconversion rate [g/g s-1]
            3016     2                            else
            3017     2                               praut(i)=max(rn21*(qc(i)-bnd21),0.0)
            3018     2                            end if ! if (gsfcgce_gocart_coupling == 1)
            3019     2               #else
            3020     2   m    m                   praut(i)=max(rn21*(qc(i)-bnd21),0.0)
            3021     2               !JJS 20110602 ^^^^^
            3022     2               #endif
            3023     2               
            3024     2   m    m                   y1(i)=1./zr(i)
            3025     2   m    m                   y2(i)=y1(i)*y1(i)
            3026     2   s    s                   y3(i)=y1(i)*y2(i)
            3027     2   m    m                   y4(i)=r22f(i)*qc(i)*y3(i)*(rn50+rn51*y1(i)+  &
            3028     2                                    rn52*y2(i)+rn53*y3(i))
            3029     2   p    v                   pracw(i)=max(y4(i), 0.0)
            3030     2   p    s                if(qr(i) .le. cmin) pracw(i)=0.
            3031     2               
            3032     2               !* 12 * PSFW : BERGERON PROCESSES FOR QS (KOENING, 1971)          **12**
            3033     2               !* 13 * PSFI : BERGERON PROCESSES FOR QS                          **13**
            3034     2               
            3035     2   p    v                pidep(i)=0.0
            3036     2   p    v                psfw(i)=0.0
            3037     2   p    v                psfi(i)=0.0
            3038     2               
            3039     2   p    m              ENDDO
            3040     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tair, tairc, qi, y1, y2, psfw, y5, rp0
                                   <<<      qv, dwv, r00, fv0, psfi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 4  FILL 23
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
            3041     2  pp    v              DO i=1,irestrict
            3042     2               
            3043     3   p    v                  if (tair(i) .lt. t0) then
            3044     3   p    v                     y1(i)=max( min(tairc(i), -1.), -31.)
            3045     3   p    v                     it(i)=int(abs(y1(i)))
            3046     3   p    v                     y1(i)=rn12a(it(i))
            3047     3   p    v                     y2(i)=rn12b(it(i))
            3048     3   p    v                     y3(i)=rn13(it(i))
            3049     3   p    v                     psfw(i)=r2is*max(d2t*y1(i)*(y2(i)+r12r(i)*qc(i))*  &
            3050     3                                           qi(i), 0.0)
            3051     3   p    v                     psfi(i)=r2is*y3(i)*qi(i)
            3052     3               !
            3053     3   p    v                     y4(i)=1./(tair(i)-c358)
            3054     3   p    v                     y5(i)=1./(tair(i)-c76)
            3055     3   p    v                     qsw(i)=rp0(i)*exp(c172-c409*y4(i))
            3056     3   p    v                     qsi(i)=rp0(i)*exp(c218-c580*y5(i))
            3057     3   p    v                     hfact=(qv(i)+qb0-qsi(i))/(qsw(i)-qsi(i)+cmin1)
            3058     3                                   ! add cmin1 to prevent overflow of hfact
            3059     3   p    v                     if(hfact.gt.1.) hfact=1.
            3060     3   p    v                     sfact=1
            3061     3   p    v                     SSI(i)=(qv(i)+qb0)/qsi(i)-1.
            3062     3               
            3063     3   p    v                     fssi=min(xssi,max(rssi,xssi*(tairc(i)+44.)/(44.0-38.0)))  !improve4 max ssi f(tair)
            3064     3   p    v                     fssi=rssi
            3065     3   p    v                     wssi=ww1(i,k)/100.-2.0
            3066     3   p    v                     if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3067     3   p    v                     fssi=min(ssi(i),fssi)
            3068     3               
            3069     3               !  STEVE : PLEASE CHECK
            3070     4   p    v                     if (tairc(i).le.-5.) then                         !meyers
            3071     4   p    v                        r_nci=max(1.e-3*exp(-.639+12.96*fssi),0.528e-3)  !meyers et al.
            3072     4   p    v                     else
            3073     4   p    v                        r_nci=min(1.e-3*exp(-.639+12.96*fssi),0.528e-3)  !meyers et al.
            3074     4   p    v                     endif  !tairc
            3075     3               
            3076     3   p    v                     if (r_nci.gt.15.) r_nci=15.                  !cap at 15000/liter
            3077     3               
            3078     3               ! Cooper curve
            3079     4   p    v                     if( tairc(i) .lt. -40.0 ) then
            3080     4   p    v                       c_nci = 5.0e-6*exp(0.304*40.0)
            3081     4   p    v                     else
            3082     4   p    v                       c_nci = 5.0e-6*exp(0.304*abs(tairc(i)))
            3083     4   p    v                     end if
            3084     3   p    v                     r_nci = c_nci
            3085     3               ! JDC cap r_nci to the amount corresponding to crystal size of ami50
            3086     3   p    v                     r_nci = max(r_nci,r00(i)*qi(i)/ami50)
            3087     3               
            3088     3               #if (WRF_CHEM == 1)
            3089     3                              ! EMK...Only execute when GOCART and coupling is turned on.
            3090     3                              if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            3091     3                                    chem_opt == 302 .or. chem_opt == 303) .and. &
            3092     3                                    (gsfcgce_gocart_coupling == 1) ) then
            3093     3                                 !JJS 20110602 vvvvv
            3094     3                                 ! Conversion rate of cloud water to ice in the Bergeron porcess based on Meyer + DeMott formulae
            3095     3                                 !
            3096     3                                 ! convert gocart aerosol mass conc to IN
            3097     3                                 !      p0 need to be converted from g*cm/s2/cm2 to mb (hPa)
            3098     3                                 !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out)
            3099     3               !                  call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out,i,k)
            3100     3                                 ! EMK...mass2icn requires i,j,k indices, but only prints
            3101     3                                 ! the values when an error occurs.  In no case are the i,j,k
            3102     3                                 ! used to access a value in an array.
            3103     3                                 ! We will simply pass a bogus value of j=1 in the call
            3104     3                                 ! below.
            3105     3                                 call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out(i),&
            3106     3                                      i,1,k)
            3107     3               
            3108     3                                 icn_out(i) = min(1.e3, max(0.01e0 ,  icn_out(i)) )
            3109     3                                 r_nci = icn_out(i) * 1.e-3  !DeMotto's formuale
            3110     3                                 !JJS 20110602 ^^^^^
            3111     3                              end if ! if (gsfcgce_gocart_coupling == 1)
            3112     3               #endif
            3113     3               
            3114     3   p    v                     dd(i)=min((r00(i)*qi(i)/r_nci), ami40)   !mean cloud ice mass
            3115     3   p    v                     yy1=1.-aa2(it(i))
            3116     3   p    v                     sfact=(AMI50**YY1-AMI40**YY1)/(AMI50**YY1-dd(i)**YY1)
            3117     3               
            3118     3               !JDC water vapor diffusivity correction term
            3119     3   p    v                     esi(i)  = qsi(i)/rp0(i)*c610
            3120     3   p    v                     y3(i)   = 1./tair(i)
            3121     3               !               term1     = y3(i)*(rn10a*y3(i)-rn10b)
            3122     3   p    v                     term1     = y3(i)*(rn20a*y3(i)-rn20b)
            3123     3   p    v                     term2     = rn10c*tair(i)/esi(i)
            3124     3   p    v                     dd(i)   = term1+term2
            3125     3   p    v                     fdwv      = dd(i)/(term1+term2*dwv0/dwv(i))
            3126     3   p    v                     psfw(i) = max( d2t*y1(i)*fdwv*(y2(i)*fdwv   &
            3127     3                                              + r12r(i)*qc(i))*qi(i),0.0 )
            3128     3               
            3129     3   p    v                     psfw(i)=0.0
            3130     3               
            3131     4   p    v                     if (hfact.gt.0.) then
            3132     4   p    v                        psfi(i)=r2is*psfi(i)*hfact*sfact*fdwv
            3133     4   p    v                     else
            3134     4   p    v                        psfi(i)=0.
            3135     4   p    v                     endif !hfact
            3136     3               
            3137     3   p    v                     if(qi(i).le.1.e-5*fv0(i)*fv0(i)) psfi(i)=0.0
            3138     3               
            3139     3   p    v                  endif   !tair
            3140     2               
            3141     2   p    v              ENDDO
            3142     1               !dir$ vector aligned

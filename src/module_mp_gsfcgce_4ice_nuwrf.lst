            2449     2  pp                  do k = kts, kte
            2450     2               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      physc, physe, physd, physs, physf, physm
                                   <<<      acphysc, acphyse, acphysd, acphyss
                                   <<<      acphysf, acphysm
                                   <<< Loop-information  End >>>
            2451     3   p    v               DO i=1,irestrict
            2452     3   p    v                   physc(i,k)=0.
            2453     3   p    v                   physe(i,k)=0.
            2454     3   p    v                   physd(i,k)=0.
            2455     3   p    v                   physs(i,k)=0.
            2456     3   p    v                   physf(i,k)=0.

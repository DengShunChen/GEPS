            3986     3   s    s                  if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3987     3   s    s                  y3(i)=1.+min((qsw(i)-qsi(i))/qsi(i), fssi)
            3988     3   s    s                  y4(i)=qsi(i)*y3(i)

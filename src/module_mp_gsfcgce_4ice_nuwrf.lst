                                   <<<      vi: 2, qi: 2, r15af2: 2, r15af: 2
                                   <<<      r192rf: 2, r191r: 2, r192rf2: 2
                                   <<<      pgwet: 2, whaci: 2, whacs: 2, whacg: 2

             502     4               #if ( WRF_CHEM == 1)
             503     4                           aero3d(ic,k,:)=aero(i,k,j,:)
             504     4               #endif
             505     4   p    v                ENDDO
             506     3   p                    enddo
             507     2               
             508     3   p              IF ( min(CHUNK,ite-ii+1) .gt. 0 ) THEN
             509     3   p              call saticel_s( dt_in, dx, itaobraun, istatmin,               &
             510     3                                  new_ice_sat, id, improve,                     &
             511     3                                  th2d, qv2d, ql2d, qr2d,                       &
             512     3                                  qi2d, qs2d, qg2d, qh2d,                       &
             513     3                                  rho2d, pii2d, p2d, w2d,                       &
             514     3                                  itimestep, xland1d,                           &
             515     3                                  refl_10cm2d, diagflag, do_radar_ref,         & ! GT added for reflectivity calcs

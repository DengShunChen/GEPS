            3532     4   s    s                 temp = temp*temp*temp*temp*temp*temp*temp
            3533     4   s    s                 pgfr(i)=r2ig*max(r18r(i)*(y1(i)-1.)*temp, 0.0)
            3534     4               !           pgfr(i)=r2ig*max(r18r(i)*(y1(i)-1.)/zr(i)**7., 0.0)

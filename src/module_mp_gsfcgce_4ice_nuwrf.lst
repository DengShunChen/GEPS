             525     3               !JJS 20110525     vvvvv
             526     3                                  ,aero3d, icn_diag2d, nc_diag2d, gid,          &
             527     3               !JJS 20110525     ^^^^^
             528     3               !EMK
             529     3                                  chem_opt,                                     &
             530     3                                  gsfcgce_gocart_coupling                       &
             531     3               #endif
             532     3                                 ,ii, j, min(CHUNK,ite-ii+1))
             533     3               !NUWRF END
             534     3   p              ENDIF
             535     2               
             536     3   p                    do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      acphysf, acphysm, acphyss, acphysd
                                   <<<      acphyse, acphysc, physf, physm
                                   <<<      (unknown)
                                   <<<    PREFETCH(SOFT) : 76
                                   <<<     SEQUENTIAL : 76
                                   <<<      physs: 2, physd: 2, physe: 2, physc: 2
                                   <<<      refl_10cm: 2, re_hail_gsfc: 2
                                   <<<      re_graupel_gsfc: 2, re_snow_gsfc: 2
                                   <<<      re_ice_gsfc: 2, re_rain_gsfc: 2
                                   <<<      re_cloud_gsfc: 2, qh: 2, qg: 2, qs: 2
                                   <<<      qi: 2, qr: 2, ql: 2, qv: 2, th: 2
                                   <<<      (unknown): 38
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 45
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             537     4   p    v                DO ic=1,min(CHUNK,ite-ii+1)
             538     4   p    v                  i = ii+ic -1
             539     4   p    v                  th(i,k,j) = th2d(ic,k)
             540     4   p    v                  qv(i,k,j) = qv2d(ic,k)
             541     4   p    v                  ql(i,k,j) = ql2d(ic,k)
             542     4   p    v                  qr(i,k,j) = qr2d(ic,k)
             543     4   p    v                  qi(i,k,j) = qi2d(ic,k)
             544     4   p    v                  qs(i,k,j) = qs2d(ic,k)

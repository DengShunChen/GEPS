                                   <<<      PREDICATE : SPILL 3  FILL 4
                                   <<< Loop-information  End >>>
            3143     2  pp    v              DO i=1,irestrict
            3144     2               
            3145     2               !TTT***** QG=QG+MIN(PGDRY,PGWET)
            3146     2               !*  9 * PGACS : ACCRETION OF QS BY QG (DGACS,WGACS: DRY AND WET)  ***9**
            3147     2               !* 14 * DGACW : ACCRETION OF QC BY QG (QGACW FOR PGMLT)           **14**
            3148     2               !* 16 * DGACR : ACCRETION OF QR TO QG (QGACR FOR PGMLT)           **16**
            3149     2               !*******PGDRY : DGACW+DGACI+DGACR+DGACS                           ******
            3150     2               !* 15 * DGACI : ACCRETION OF QI BY QG (WGACI FOR WET GROWTH)      **15**
            3151     2               !* 17 * PGWET : WET GROWTH OF QG                                  **17**
            3152     2               !*  Steve turned off PGWET, set PGWET = 0.
            3153     2               !*  Steve turned off wgaci, set wgaci = 0.
            3154     2               
            3155     2   p    v               y1(i)=abs( vg(i)-vs(i) )
            3156     2   p    v               y2(i)=zs(i)*zg(i)
            3157     2   p    v               y3(i)=5./y2(i)
            3158     2   p    v               y4(i)=.08*y3(i)*y3(i)
            3159     2   p    v               y5(i)=.05*y3(i)*y4(i)
            3160     2   p    v               y2(i)=y1(i)*(y3(i)/zs(i)**5+y4(i)/zs(i)**3        &
            3161     2                                        +y5(i)/zs(i))
            3162     2               
            3163     2   p    v               pgacs(i)=r2ig*r2is*r9rf(i)*y2(i)*ftns(i)*ftng(i)*fros(i) !improve4
            3164     2   p    v              if(qs(i).le.cmin) pgacs(i)=0.
            3165     2   p    v              if(qg(i).le.cmin) pgacs(i)=0.
            3166     2   p    v               dgacs(i)=pgacs(i)
            3167     2   p    v               dgacs(i)=0.0             !Lang et al. 2007
            3168     2               !crh     wgacs(i)=10.*r9rf(i)*y2(i)
            3169     2   p    v               wgacs(i)=0.0
            3170     2   p    v               wgacs(i)=10.*r9rf(i)*y2(i)*ftns(i)*ftng(i)*fros(i)         !4ice revised
            3171     2               !        if(r00(i)*qg(i).gt.qrog2)then                                      !4ice revised
            3172     2               !         wgacs(i)=10.*r9rf(i)*y2(i)*ftns(i)*ftng(i)*fros(i)        !4ice revised
            3173     2               !        endif                                                             !4ice revised
            3174     2   p    v               if(qg(i).le.cmin) wgacs(i)=0.                !4ice revised2
            3175     2   p    v               if(qs(i).le.cmin) wgacs(i)=0.                !4ice revised2
            3176     2               
            3177     2   p    v              dhacs(i)=0.0
            3178     2   p    v              whacs(i)=0.0
            3179     2   p    v              y1(i)=abs( vh(i)-vs(i) )
            3180     2   p    v              y2(i)=zs(i)*zh(i)

            4785                      SUBROUTINE Find_NaN_Inf_Double(Warning_MSG, real_input, i_in,j_in,k_in)
            4786                      implicit none
            4787                     
            4788                      real,intent(inout) :: real_input  !anykind of Non-dimensional input Real parameters
            4789                      integer,intent(in) :: i_in, j_in, k_in
            4790                      character*(*),intent(in) :: Warning_MSG
            4791                     
            4792                     !
            4793                     ! Find Infinity
            4794                     !
            4795                     !if( exp(-abs(real_input)) == 0.) then ! this formulae is bit slow
            4796                     
            4797     1                if( 1e+10/real_input == 0. ) then
            4798     1                   print*,'MSG Find_NaN_Inf: '//Warning_MSG//'Infinity at',i_in,j_in,k_in
            4799     1                   real_input = 0.
            4800     1                   return
            4801     1                endif
            4802                     
            4803                     !
            4804                     ! Find NaN
            4805                     !
            4806     1                if( real_input==0. .or. real_input>0. .or. real_input<0. .or. real_input>=0. .or. real_input<=0. ) then
            4807     1                else
            4808     1                   print*,'MSG Find_NaN_Inf: '//Warning_MSG//'NaN at',i_in,j_in,k_in
            4809     1                   real_input = 0.
            4810     1                   return
            4811     1                endif
            4812                     
            4813                      END SUBROUTINE Find_NaN_Inf_Double

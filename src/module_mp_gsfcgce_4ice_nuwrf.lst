            3836     2   s    s              DO i=1,irestrict
            3837     2               
            3838     2               !      STEVE: PLEASE CHECK
            3839     2   p    v             y1(i)=pihom(i)+pidw(i)+pimm(i)+pcfr(i)-pimlt(i)
            3840     2               
            3841     3   p    v               if (y1(i).gt.qc(i)) then
            3842     3   p    v                  y1(i)=qc(i)
            3843     3   p    v                  y2(i)=1.
            3844     3   p    v                  y3(i)=pihom(i)+pidw(i)+pimm(i)+pcfr(i)
            3845     3   p    v                  if(y3(i).ne.0.) y2(i)=(qc(i)+pimlt(i))/y3(i)
            3846     3   p    v                  pihom(i)=pihom(i)*y2(i)
            3847     3   p    v                  pidw(i)=pidw(i)*y2(i)
            3848     3   p    v                  pimm(i)=pimm(i)*y2(i)
            3849     3   p    v                  pcfr(i)=pcfr(i)*y2(i)
            3850     3   p    v               endif  !y1
            3851     2               
            3852     2   p    v               pt(i)=pt(i)+afcp(i)*y1(i)
            3853     2   p    v               tair(i)=(pt(i)+tb0)*pi0(i)
            3854     2   p    v               qc(i)=qc(i)-y1(i)
            3855     2   p    v               qi(i)=qi(i)+y1(i)
            3856     2               
            3857     2               !* 31 * pint  : initiation of qi                                  **31**
            3858     2               !* 32 * pidep : deposition of qi                                  **32**
            3859     2               !
            3860     2               !     CALCULATION OF PINT USES DIFFERENT VALUES OF THE INTERCEPT AND SLOPE FOR
            3861     2               !     THE FLETCHER EQUATION. ALSO, ONLY INITIATE MORE ICE IF THE NEW NUMBER
            3862     2               !     CONCENTRATION EXCEEDS THAT ALREADY PRESENT.
            3863     2               
            3864     2   s    s               tair(i)=(pt(i)+tb0)*pi0(i)
            3865     3   s    s               if (tair(i) .lt. t0) then
            3866     3   s    s                  if (qi(i) .le. cmin) qi(i)=0.
            3867     3   s    s                  tairc(i)=tair(i)-t0
            3868     3   s    s                  rtair(i)=1./(tair(i)-c76)
            3869     3   s    s                  y2(i)=exp(c218-c580*rtair(i))
            3870     3   s    s                  qsi(i)=rp0(i)*y2(i)
            3871     3   s    s                  esi(i)=c610*y2(i)
            3872     3   s    s                  ssi(i)=(qv(i)+qb0)/qsi(i)-1.
            3873     3   s    s                  y1(i)=1./tair(i)
            3874     3   s    s                  y3(i)=SQRT(qi(i))
            3875     3               ! JDC water vapor diffusivity correction term
            3876     3   s    s                  term1   = y1(i)*(rn20a*y1(i)-rn20b)
            3877     3   s    s                  term2   = rn10c*tair(i)/esi(i)
            3878     3   s    s                  dd(i) = term1+term2
            3879     3   s    s                  fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            3880     3               
            3881     3   s    s                  dm(i)=max(qv(i)+qb0-qsi(i),0.0)
            3882     3   s    s                  rsub1(i)=cs580(i)*qsi(i)*rtair(i)*rtair(i)
            3883     3   s    s                  dep(i)=dm(i)/(1.+rsub1(i))
            3884     4   s    s                  if (tairc(i).le.-5.) then
            3885     4   s    s                      y4(i)=1./(tair(i)-c358)
            3886     4   s    s                      qsw(i)=rp0(i)*exp(c172-c409*y4(i))
            3887     4   s    s                      fssi=min(xssi,max(rssi,xssi*(tairc(i)+44.)/(44.-38.)))
            3888     4   s    s                      fssi=rssi
            3889     4   s    s                      wssi=ww1(i,k)/100.-2.0
            3890     4   s    s                      if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3891     4   s    s                      fssi=min(ssi(i),fssi)
            3892     4               !               r_nci=min(1.e-3*exp(-.639+12.96*fssi),1.)
            3893     4   s    s                      r_nci=max(1.e-3*exp(-.639+12.96*fssi),0.528e-3)
            3894     4   m    m             	        if (r_nci.gt.15.) r_nci=15.
            3895     4               
            3896     4               ! Cooper curve
            3897     5   s    s                      if( tairc(i) .lt. -40.0 ) then
            3898     5   m    m                        c_nci = 5.0e-6*exp(0.304*40.0)
            3899     5   s    s                      else
            3900     5   m    s                        c_nci = 5.0e-6*exp(0.304*abs(tairc(i)))
            3901     5   s    s                      end if
            3902     4   s    s                      r_nci = c_nci
            3903     4               ! JDC cap r_nci to the amount corresponding to crystal size of ami50
            3904     4   s    s                      r_nci = max(r_nci,r00(i)*qi(i)/ami50)
            3905     4               
            3906     4               #if (WRF_CHEM == 1)

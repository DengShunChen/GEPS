            3761     4                                     (gsfcgce_gocart_coupling == 1) ) then
            3762     4                                  !JJS 20110602 vvvvv
            3763     4                                  ! Conversion rate of cloud water to ice in the Bergeron porcess based on Meyer + DeMott formulae
            3764     4                                  !
            3765     4                                  ! convert gocart aerosol mass conc to IN
            3766     4                                  !      p0 need to be converted from g*cm/s2/cm2 to mb (hPa)
            3767     4                                  !                call mass2icn(p0(i,k)*0.001,tair(i),aero(i,k,:), icn_out)
            3768     4                                  !                icn_cgs(i,k) = max(min_icn, icn_out) * 1.e-3   !IN conc [#/cm3] <-- [#/Litter]
            3769     4                                  !                icn_cgs(i,k) = icn_out * 1.e-3 !IN conc [#/cm3]
            3770     4                                  !                r_nci = icn_cgs(i,k)  !DeMotto's formuale
            3771     4                                  r_nci = icn_out(i) * 1.e-3  !DeMotto's formuale
            3772     4                                  !JJS 20110602 ^^^^^
            3773     4                               end if
            3774     4               #endif
            3775     4               
            3776     4   p    s                      dd(i)=(r00(i)*qi(i)/r_nci)**y3(i)                  !meyers
            3777     4   p    s                      PIDW(i)=min(rr0(i)*D2T*y2(i)*r_nci*dd(i), qc(i)) !meyers
            3778     4               
            3779     4               ! JDC water vapor diffusivity correction term
            3780     4   s    s                       esi(i)  = qsi(i)/rp0(i)*c610
            3781     4   s    s                       y4(i)   = 1./tair(i)
            3782     4               !                term1     = y4(i)*(rn10a*y4(i)-rn10b)
            3783     4   m    s                       term1     = y4(i)*(rn20a*y4(i)-rn20b)
            3784     4   m    s                       term2     = rn10c*tair(i)/esi(i)
            3785     4   p    s                       fdwv      = (term1+term2)/(term1+term2*dwv0/dwv(i))
            3786     4   p    s                    PIDW(i)=min(rr0(i)*D2T*y2(i)*r_nci*dd(i)*fdwv,qc(i)) !meyers
            3787     4   s    s               endif  !tairc
            3788     3               
            3789     3   p    s                   pimm(i)=0.0
            3790     3   s    s                   pcfr(i)=0.0
            3791     3               
            3792     4   s    s                   if (qc(i) .gt. 0.0) then
            3793     4   s    s                      y4(i) = 1./(tair(i)-c358)
            3794     4   s    s                      qsw(i)=rp0(i)*exp(c172-c409*y4(i))
            3795     4   s    s                      xncld=qc(i)/4.e-9                         !cloud number
            3796     4   p    s                      esat=0.6112*exp(17.67*tairc(i)/(tairc(i)+243.5))*10.
            3797     4   p    s                      rv=0.622*esat/(p0(i,k)/1000.-esat)
            3798     4   p    s                      rlapse_m=980.616*(1.+2.5e6*rv/287./tair(i))/          &
            3799     4                                      (1004.67+2.5e6*2.5e6*rv*0.622/(287.*tair(i)*tair(i)))
            3800     4   p    s                      delT=rlapse_m*ww1(i,k)                     !Roger
            3801     4   p    s                      if (delT.lt.0.) delT=0.
            3802     4   s    s                      Bhi=1.01e-2
            3803     4   p    s                      pimm(i)=xncld*Bhi*4.e-9*exp(-tairc(i))*delT*d2t*4.e-9
            3804     4               
            3805     4   s    s                      xccld=xncld*r00(i)                           !cloud number concentration
            3806     4   p    s                      Xknud=7.37*tair(i)/(288.*Ra*p0(i,k))  ! Knudsen number
            3807     4   p    s                      alpha=1.257+0.400*exp(-1.10/Xknud)     ! Cunningham correction (P&Klett)
            3808     4               
            3809     4   p    s                      cunnF=1.+alpha*Xknud                   ! Cunningham correction (P&Klett)
            3810     4               
            3811     5   s    s                      if (tairc(i).ge.0.) then
            3812     5   m    s                          dvair=(1.718+0.0049*tairc(i))*1.e-4
            3813     5                                      !dynamic visc air (Prupp&Klett)
            3814     5   s    s                      else
            3815     5   m    s                          dvair=(1.718+0.0049*tairc(i)-1.2e-5*tairc(i)**2)*1.e-4
            3816     5                                      !dynamic visc air (Prupp&Klett)
            3817     5   s    s                      endif !tairc
            3818     4   m    s                      DIFFar=1.3804e-16*tair(i)/6./cpi/dvair/Ra*cunnF     !aerosol diffusion via P&Klett
            3819     5   s    s                      if (qv(i)+qb0-qsw(i).lt.0.) then                       !only when cloud evaporating
            3820     5   m    s                      pcfr(i)=4.e-9*4.*cpi*Rc*DIFFar*xccld*Cna*rr0(i)*d2t    !Brownian part only via Cotton
            3821     5   p    s                      endif
            3822     4   s    s                   else  !qc
            3823     4   s    s                      tairc(i)=tair(i)-t0
            3824     4   p    s                      y1(i)=max( min(tairc(i), -1.), -31.)
            3825     4   s    s                      it(i)=int(abs(y1(i)))
            3826     4   s    s                      y2(i)=aa1(it(i))
            3827     4   p    s                      y3(i)=aa2(it(i))
            3828     4   p    s                      y4(i)=exp(abs(.5*tairc(i)))
            3829     4   m    s                      dd(i)=(r00(i)*qi(i)/(r25a*y4(i)))**y3(i)
            3830     4   p    s                      pidw(i)=min(r25rt(i)*y2(i)*y4(i)*dd(i),qc(i))
            3831     4   p    s                   endif  !qc
            3832     3   p    v                endif  !tair
            3833     2               
            3834     2   p    m              ENDDO
            3835     1               !dir$ vector aligned

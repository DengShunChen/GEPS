            2811     2               !     ******************************************************************
            2812     2               !     ***   Y1 : DYNAMIC VISCOSITY OF AIR (U)
            2813     2               !     ***   DWV : DIFFUSIVITY OF WATER VAPOR IN AIR (PI)
            2814     2               !     ***   TCA : THERMAL CONDUCTIVITY OF AIR (KA)
            2815     2               !     ***   Y2 : KINETIC VISCOSITY (V)
            2816     2               
            2817     2   p    v               y1(i)=c149*tair(i)**1.5/(tair(i)+120.)
            2818     2   p    v               dwv(i)=dwvp(i)*tair(i)**1.81
            2819     2   p    v               tca(i)=c141*y1(i)
            2820     2   p    v               scv(i)=1./((rr0(i)*y1(i))**.1666667*dwv(i)**.3333333)
            2821     2               

            4057     3   s    s                  call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            4058     3   s    s                  call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            4059     3   s    s                  call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            4060     3   s    s                  call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))
            4061     3               
            4062     3   m    m                  ftns(i)=ftns0(i)
            4063     3   m    m                  ftng(i)=ftng0(i)
            4064     3   m    m                  ftnh(i)=ftnh0(i)
            4065     3               
            4066     3   s    s                  Y4(i)=r10t*SSI(i)*(r101r(i)/ZS(i)**2+r102rf(i)/ZS(i)**BSH5)   &
            4067     3                                               /DD(i)*ftns(i)*fdwv
            4068     3   s    s                  PSDEP(i)=r2is*max(-QS(i), Y4(i))
            4069     3   s    s                  if(qs(i).le.cmin) psdep(i)=0.
            4070     3   s    s                  DD(i)=Y3(i)*(RN20A*Y3(i)-RN20B)+RN10C*TAIR(i)/ESI(i)
            4071     3   s    s                  Y2(i)=r191r(i)/ZG(i)**2+r192rf(i)/ZG(i)**BGH5
            4072     3   s    s                  if(r00(i)*qg(i).gt.qrog2) &
            4073     3                             y2(i)=(r191r(i)/zg(i)**2+r192rf2(i)/zg(i)**bgh5_2)
            4074     3   s    s                    PGDEP(i)=r2ig*MAX(-qg(i), R20T*SSI(i)*Y2(i)/DD(i)          &
            4075     3                                                    *ftng(i)*fdwv)
            4076     3   s    s                  if(qg(i).le.cmin) pgdep(i)=0.
            4077     3   s    s                 Y1(i)=h10ar(i)/(TCA(i)*TAIR(i)**2)+1./(DWV(i)*QSI(i))
            4078     3   s    s                 Y2(i)=.78/ZH(i)**2+h20bq(i)*SCV(i)/ZH(i)**BHH5
            4079     3   s    s                 PHDEP(i)=r2ih*MAX(-qh(i), h20t(i)*ftnh(i)*SSI(i)*Y2(i)/Y1(i))
            4080     3   s    s                      if(qh(i).le.cmin) phdep(i)=0.
            4081     3   s    s                PSSUB(i)=min(PSDEP(i), 0.)
            4082     3   s    s                PSDEP(i)=max(PSDEP(i), 0.)
            4083     3   s    s                PGSUB(i)=min(PGDEP(i), 0.)
            4084     3   s    s                PGDEP(i)=max(PGDEP(i), 0.)
            4085     3   s    s                PHSUB(i)=min(PHDEP(i), 0.)
            4086     3   s    s                PHDEP(i)=max(PHDEP(i), 0.)
            4087     3               
            4088     3               !      ******************************************************************
            4089     3   s    s                    Y5(i)=min(0.,DD1(i))
            4090     3   s    s                    DD1(i)=max(0.,DD1(i))
            4091     3               
            4092     4   s    s               IF(DLT1(i).EQ.1.)THEN                              !Di
            4093     4   s    s                 Y1(i)=PSDEP(i)+PGDEP(i)+PHDEP(i)
            4094     5   s    s                 IF(Y1(i).ge.DD1(i))THEN
            4095     5   s    s                  PSDEP(i)=PSDEP(i)/Y1(i)*DD1(i)            !...
            4096     5   s    s                  PGDEP(i)=PGDEP(i)/Y1(i)*DD1(i)
            4097     5   s    s                  PHDEP(i)=PHDEP(i)/Y1(i)*DD1(i)
            4098     5   p    v                 ENDIF
            4099     4   s    s               ENDIF                                                !Di
            4100     3               
            4101     4   s    s               if(qc(i).le.1.e-5) then
            4102     4   s    s                vap_frac=2.0*min((tairc(i)/(t00-t0))**2,1.0)
            4103     4   s    s                pvapg(i)=vap_frac*pgdep(i)
            4104     4   s    s                pvaph(i)=vap_frac*phdep(i)
            4105     4   s    s               endif
            4106     3   s    s               if(pgdep(i).gt.0.)          &
            4107     3                          pvapg(i)=min(pvapg(i),qg(i)+pgdep(i))
            4108     3   s    s               if(phdep(i).gt.0.)          &
            4109     3                          pvaph(i)=min(pvaph(i),qh(i)+phdep(i))
            4110     3               
            4111     3               
            4112     4   s    s               IF(DLT1(i).EQ.0.)THEN
            4113     4   s    s                 Y1(i)=MAX(PSsub(i)+PGsub(i)+phsub(i), Y5(i))
            4114     5   s    s                 IF(Y5(i).gt.(PSsub(i)+PGsub(i)+phsub(i)))THEN
            4115     5   s    s                  Y3(i)=(PSsub(i)+PGsub(i)+phsub(i))
            4116     6   s    s                  IF(Y3(i).ne.0.0)THEN
            4117     6   s    s                   PSsub(i)=PSsub(i)/Y3(i)*Y5(i)
            4118     6   s    s                   PGsub(i)=PGsub(i)/Y3(i)*Y5(i)
            4119     6   s    s                   Phsub(i)=Phsub(i)/Y3(i)*Y5(i)
            4120     6   p    v                  ENDIF
            4121     5   p    v                 ENDIF
            4122     4   s    s               ENDIF
            4123     3   s    s                PSSUB(i)=-PSSUB(i)
            4124     3   s    s                PGSUB(i)=-PGSUB(i)
            4125     3   s    s                PHSUB(i)=-PHSUB(i)
            4126     3   s    s                Y1(i)=PSDEP(i)+PGDEP(i)+PHDEP(i)  &
            4127     3                                -PSsub(i)-PGsub(i)-PHsub(i)
            4128     3               
            4129     3   s    s                 pt(i)=pt(i)+ascp(i)*y1(i)
            4130     3   p    v                 tair(i)=(pt(i)+tb0)*pi0(i)
            4131     3   s    s                 qv(i)=qv(i)-y1(i)
            4132     3   s    s                 qs(i)=qs(i)+psdep(i)-pssub(i)+pvapg(i)+pvaph(i)
            4133     3   s    s                 qg(i)=qg(i)+pgdep(i)-pgsub(i)-pvapg(i)
            4134     3   s    s                 qh(i)=qh(i)+phdep(i)-phsub(i)-pvaph(i)
            4135     3   p    v                 endif   ! if (tair(i) .lt. t0)
            4136     2               
            4137     2               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            4138     2               ! Steve did not make any improvement on this process
            4139     2   p    v                 ern(i)=0.0
            4140     3   p    v                 if (qr(i) .gt. 0.0) then
            4141     3   m    m                   tair(i)=(pt(i)+tb0)*pi0(i)
            4142     3   s    s                   rtair(i)=1./(tair(i)-c358)
            4143     3   s    s      	     y2(i)=exp( c172-c409*rtair(i) )
            4144     3   s    s      	     esw(i)=c610*y2(i)
            4145     3   s    s                   qsw(i)=rp0(i)*y2(i)
            4146     3   s    s                   ssw(i)=(qv(i)+qb0)/qsw(i)-1.
            4147     3   s    s                   dm(i)=qv(i)+qb0-qsw(i)
            4148     3   s    s                   rsub1(i)=cv409(i)*qsw(i)*rtair(i)*rtair(i)
            4149     3   s    s                   dd1(i)=max(-dm(i)/(1.+rsub1(i)),0.0)
            4150     3   s    s                   y3(i)=1./tair(i)
            4151     3               ! JDC water vapor diffusivity correction term
            4152     3   s    s                   term1   = y3(i)*(rn30a*y3(i)-rn10b)
            4153     3   s    s                   term2   = rn10c*tair(i)/esw(i)
            4154     3   s    s                   dd(i) = term1+term2
            4155     3   m    m                   fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            4156     3   p    v                   ftnw=1.
            4157     4   m    m                   if (qr(i) .gt. cmin.and.tair(i).gt.t0) then   !no need to check qc, no qc if ssw < 0
            4158     4   s    s                       bin_factor(i)=0.11*(1000.*qr(i))**(-1.27) + 0.98
            4159     4   s    s                       bin_factor(i)=min(bin_factor(i),1.30)
            4160     4   s    s                       ftnw=1./bin_factor(i)**3.35
            4161     4   s    s                       ftnwmin=r00(i)*qr(i)/draimax
            4162     4   s    s                       if(qr(i).le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            4163     4               
            4164     4   s    s                       y4(i)=r00(i)*qr(i)
            4165     4   s    s                       y1(i)=sqrt(y4(i))
            4166     4   s    s                       y2(i)=sqrt(y1(i))
            4167     4   s    s                       zr(i)=zrc/y2(i)*ftnw**0.25
            4168     4   p    v                   endif !qr
            4169     3   s    s                   y1(i)=-r23t*ssw(i)*(r231r(i)/zr(i)**2+r232rf(i)/       &
            4170     3                                                     zr(i)**3)/dd(i)*ftnw*fdwv
            4171     3   s    s                   ern(i)=min(dd1(i),qr(i),max(y1(i),0.0))
            4172     3   s    s                   pt(i)=pt(i)-avcp(i)*ern(i)
            4173     3   m    m                   tair(i)=(pt(i)+tb0)*pi0(i)
            4174     3   s    s                   tairc(i)=tair(i)-t0
            4175     3   s    s                   qv(i)=qv(i)+ern(i)
            4176     3   s    s                   qr(i)=qr(i)-ern(i)
            4177     3   p    v                endif !qr
            4178     2               
            4179     2               !!!!
            4180     2               !!  add processes 30 & 33 fpr pmltg and pmlts
            4181     2               !!
            4182     2               !!!!
            4183     2               
            4184     2               !* 30 * pmltg : evaporation of melting qg                         **30**
            4185     2               !* 33 * pmlts : evaporation of melting qs                         **33**
            4186     2               
            4187     2   m    m                pmlts(i)=0.0
            4188     2   s    s                pmltg(i)=0.0
            4189     2               
            4190     2   m    m                tair(i)=(pt(i)+tb0)*pi0(i)
            4191     2   s    s                tairc(i)=tair(i)-t0
            4192     2               
            4193     2   p    v                ftns0(i)=1.
            4194     2   p    v                ftng0(i)=1.
            4195     2               
            4196     2   m    m                qhz2=qhwrf(i,k)
            4197     2   s    s                qgz2=qgwrf(i,k)
            4198     3   m    m                if (k .lt. kte-2 .and. tairc(i) .ge. -5) then
            4199     3   s    s                  qhz2=qhwrf(i,k+1)
            4200     3   s    s                  qgz2=qgwrf(i,k+1)
            4201     3   p    v                endif
            4202     2   s    s                call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))
            4203     2   s    s                call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))
            4204     2   s    s                call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))
            4205     2               
            4206     3   s    s                if (tair(i) .ge. t0) then
            4207     3   s    s                   ftns(i)=1.
            4208     3   s    s                   ftng(i)=1.
            4209     3   m    m                      ftns(i)=ftns0(i)
            4210     3   m    m                      ftng(i)=ftng0(i)
            4211     3   s    s                   rtair(i)=1./(t0-c358)
            4212     3   s    s                   y2(i)=exp( c172-c409*rtair(i) )
            4213     3   s    s                   esw(i)=c610*y2(i)
            4214     3   s    s                   qsw(i)=rp0(i)*y2(i)
            4215     3   s    s                   ssw(i)=1.-(qv(i)+qb0)/qsw(i)
            4216     3   s    s                   dm(i)=qsw(i)-qv(i)-qb0
            4217     3   s    s                   rsub1(i)=cv409(i)*qsw(i)*rtair(i)*rtair(i)
            4218     3   s    s                   dd1(i)=max(dm(i)/(1.+rsub1(i)),0.0)
            4219     3   s    s                   y3(i)=1./tair(i)
            4220     3               ! JDC water vapor diffusivity correction term
            4221     3   s    s                  term1   = y3(i)*(rn30a*y3(i)-rn10b)
            4222     3   s    s                  term2   = rn10c*tair(i)/esw(i)
            4223     3   s    s                  dd(i) = term1+term2
            4224     3   s    s                  fdwv    = dd(i)/(term1+term2*dwv0/dwv(i))
            4225     3   s    s                   y1(i)=ftng(i)*r30t*ssw(i)*(r191r(i)/zg(i)**2+r192rf(i)    &
            4226     3                                  /zg(i)**bgh5)/dd(i)*fdwv
            4227     3   s    s                   if(r00(i)*qg(i).gt.qrog2)                   &
            4228     3                              y1(i)=ftng(i)*r30t*ssw(i)*(r191r(i)/zg(i)**2+r192rf2(i) &
            4229     3                                     /zg(i)**bgh5_2)/dd(i)*fdwv
            4230     3   s    s                   pmltg(i)=r2ig*min(qg(i),max(y1(i),0.0))
            4231     3   s    s                   y1(i)=ftns(i)*r33t*ssw(i)*(r331r(i)/zs(i)**2+r332rf(i)    &
            4232     3                                                          /zs(i)**bsh5)/dd(i)*fdwv
            4233     3   s    s                   pmlts(i)=r2is*min(qs(i),max(y1(i),0.0))
            4234     3   s    s                   y1(i)=min(pmltg(i)+pmlts(i),dd1(i))
            4235     3   s    s                   pmltg(i)=y1(i)-pmlts(i)
            4236     3   p    v                   pt(i)=pt(i)-ascp(i)*y1(i)
            4237     3   p    v                   tair(i)=(pt(i)+tb0)*pi0(i)
            4238     3   p    v                   qv(i)=qv(i)+y1(i)
            4239     3   s    s                   qs(i)=qs(i)-pmlts(i)
            4240     3   s    s                   qg(i)=qg(i)-pmltg(i)
            4241     3   p    v                endif  !tair t0
            4242     2               ! end   Processes 30 and 33
            4243     2               
            4244     2   s    s                  if (qc(i) .le. cmin) qc(i)=0.
            4245     2   m    m                  if (qr(i) .le. cmin) qr(i)=0.
            4246     2   p    v                  if (qi(i) .le. cmin) qi(i)=0.
            4247     2   m    m                  if (qs(i) .le. cmin) qs(i)=0.
            4248     2   m    m                  if (qg(i) .le. cmin) qg(i)=0.
            4249     2   m    m                  if (qh(i) .le. cmin) qh(i)=0.
            4250     2   p    v                  dpt(i,k)=pt(i)
            4251     2   p    v                  dqv(i,k)=qv(i)
            4252     2   s    s                  qcl(i,k)=qc(i)
            4253     2   s    s                  qrn(i,k)=qr(i)
            4254     2   p    v                  qci(i,k)=qi(i)
            4255     2   s    s                  qcs(i,k)=qs(i)
            4256     2   s    s                  qcg(i,k)=qg(i)
            4257     2   s    s                  qch(i,k)=qh(i)
            4258     2               
            4259     2               !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            4260     2               !c     henry:  please take a look  (start)
            4261     2               !JJS modified by JJS on 5/1/2007  vvvvv
            4262     2               
            4263     2   s    s                  dd(i)=max(-cnd(i), 0.)
            4264     2   s    s                  cnd(i)=max(cnd(i), 0.)
            4265     2   s    s                  dd1(i)=max(-dep(i), 0.)  !bug fix by Di
            4266     2   s    s                  dep(i)=max(dep(i), 0.)
            4267     2   p    v                  del=0.
            4268     2   p    v                  IF(whacr(i) .LT. 0.) DEL=1.
            4269     2               
            4270     2               
            4271     2               !!!!!!!!!!!DDDDDDDDDDDDDD double check
            4272     2   p    v                  sccc=cnd(i)
            4273     2   s    s                  seee=dd(i)+ern(i)
            4274     2               !            sddd=dep(i)+amax1(pint(i),0.0)+psdep(i)+pgdep(i)+phdep(i)
            4275     2   s    s                  sddd=dep(i)+dmax1(pint(i),0.0)+psdep(i)+pgdep(i)+phdep(i)
            4276     2               !            ssss=dd1(i)-amin1(pint(i),0.0)+pssub(i)+pgsub(i)+phsub(i)+pmlts(i)+pmltg(i)
            4277     2   s    s                  ssss=dd1(i)-dmin1(pint(i),0.0)+pssub(i)+pgsub(i)+phsub(i)+pmlts(i)+pmltg(i)
            4278     2   p    v                  smmm=psmlt(i)+pgmlt(i)+pimlt(i)+qracs(i)+phmlt(i)+qracg(i) &
            4279     2                                -del*whacr(i)
            4280     2   p    v                  sfff=psacw(i)*d2t+piacr(i)*d2t+psfw(i)*d2t+pgfr(i)*d2t   &
            4281     2                               +dgacw(i)*d2t+dgacr(i)*d2t+psacr(i)*d2t+pihom(i) &
            4282     2                               +pidw(i)+pimm(i)+pcfr(i)+pihms(i)*d2t    &
            4283     2                               +pihmg(i)*d2t+phfr(i)*d2t+dhacw(i)*d2t+dhacr(i)*d2t+pihmh(i)*d2t
            4284     2               
            4285     2               ! for snapsot diabatic heating rate (deg K / s)
            4286     2   m    m                  physc(i,k) = avc * sccc / d2t       !K/s
            4287     2   m    m                  physe(i,k) = avc * seee / d2t       !K/s
            4288     2   m    m                  physd(i,k) = asc * sddd / d2t       !K/s
            4289     2   m    m                  physs(i,k) = asc * ssss / d2t       !K/s
            4290     2   m    m                  physf(i,k) = afc * sfff / d2t       !K/s
            4291     2   m    m                  physm(i,k) = afc * smmm / d2t       !K/s
            4292     2               ! for accmulated diabatic heating (unit: deg K, in potential temperature)
            4293     2   p    v                  acphysc(i,k) = acphysc(i,k) + avcp(i) * sccc
            4294     2   p    v                  acphyse(i,k) = acphyse(i,k) + avcp(i) * seee
            4295     2   p    v                  acphysd(i,k) = acphysd(i,k) + ascp(i) * sddd
            4296     2   p    v                  acphyss(i,k) = acphyss(i,k) + ascp(i) * ssss
            4297     2   p    v                  acphysf(i,k) = acphysf(i,k) + afcp(i) * sfff
            4298     2   p    v                  acphysm(i,k) = acphysm(i,k) + afcp(i) * smmm
            4299     2               
            4300     2               !JJS modified by JJS on 5/1/2007  ^^^^^
            4301     2               
            4302     2               !JJS   2010/10/19  vvvvv
            4303     2               !      radar reflectivity calculation
            4304     2               
            4305     2   s    s                call sgmap(1,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftns0(i))   !Di 20160114
            4306     2   s    s                call sgmap(2,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftng0(i))   !Di 20160114
            4307     2   s    s                call sgmap(3,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),fros0(i))   !Di 20160114
            4308     2   s    s                call sgmap(4,qs(i),qg(i),qgz2,qh(i),qhz2,r00(i),tairc(i),ftnh0(i))   !Di 20160114
            4309     2               
            4310     2   m    m              a_1=1.e6*r00(i)*qr(i)
            4311     2   m    m              a_2=1.e6*r00(i)*qs(i)
            4312     2   s    s              a_3=1.e6*r00(i)*qg(i)
            4313     2   m    m              a_4=1.e6*r00(i)*qh(i)
            4314     2               
            4315     2   m    m              ucor=3071.29/tnw**0.75
            4316     2   m    m              ucos=687.97*roqs**0.25/tns**0.75
            4317     2   m    m              ucog=687.97*roqg**0.25/tng**0.75
            4318     2   m    m              ucog2=687.97*roqg2**.25/tng**.75
            4319     2   m    m              ucoh=687.97*roqh**0.25/tnh**0.75
            4320     2   p    v              uwet=4.464**0.95
            4321     2               
            4322     2   p    v              ftnw=1.
            4323     3   s    s              if(qr(i).gt.cmin .and. qc(i).lt.cmin)then
            4324     3   p    v                   bin_factor(i)=0.11*(1000.*qr(i))**(-1.27) + 0.98
            4325     3               !            bin_factor(i)=min(bin_factor(i),1.35)
            4326     3   p    v                   bin_factor(i)=min(bin_factor(i),1.30)
            4327     3   p    v                   ftnw=1./bin_factor(i)**3.50
            4328     3   s    s                   ftnwmin=r00(i)*qr(i)/draimax
            4329     3   s    s                   if(qr(i).le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            4330     3   p    v              endif
            4331     2   p    v              a_11=ucor*(max(0.,a_1))**1.75/ftnw**0.75
            4332     2               
            4333     2   s    s              ftns(i)=1.
            4334     2   s    s              ftng(i)=1.
            4335     2   m    m              ftns(i)=ftns0(i)**0.75
            4336     2   m    m              ftng(i)=ftng0(i)**0.75
            4337     2   m    m              ftnh(i)=ftnh0(i)**0.75  ! Di 20160114
            4338     2   s    s              fros(i)=1.
            4339     2   m    m              fros(i)=fros0(i)**.25
            4340     2   p    v              a_22=ucos*(max(0.,a_2))**1.75/ftns(i)*fros(i)
            4341     2   p    v              a_33=ucog*(max(0.,a_3))**1.75/ftng(i)
            4342     2   m    m              if(a_3.ge.qrog2) a_33=ucog2*(max(0.,a_3))**1.75/ftng(i)
            4343     2   p    v              a_44=ucoh*(max(0.,a_4))**1.75/ftnh(i) ! Di 20160114
            4344     2               
            4345     3   p    v               IF (TAIR(i).LT.273.16) THEN
            4346     3   p    v                  ZDRY = MAX(1.e-9,A_11+A_22+A_33+A_44) !rain,snow,graupel,hail,cloud ice,cloud water
            4347     3               !            DBZ(i,k) = 10.*ALOG10(ZDRY)
            4348     3   p    v                  DBZ(i,k) = 10.*DLOG10(ZDRY)
            4349     3   p    v               ELSE
            4350     3   p    v                  ZWET0 = A_11+UWET*(A_22+A_33+A_44)**.95
            4351     3   p    v                  ZWET = MAX(1.e-9,ZWET0)
            4352     3               !            DBZ(i,k) = 10.*ALOG10(ZWET)
            4353     3   p    v                  DBZ(i,k) = 10.*DLOG10(ZWET)
            4354     3   p    v               ENDIF
            4355     2               
            4356     2               !JJS   2010/10/19  ^^^^^
            4357     2               
            4358     2   p    m              ENDDO
            4359     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrn, qcs, re_rain_gsfc, qcg
                                   <<<      re_snow_gsfc, qch, re_graupel_gsfc, qcl
                                   <<<      re_hail_gsfc, re_cloud_gsfc, qci
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 7  FILL 13
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4360     2   s    s              DO i=1,irestrict
            4361     2               
            4362     2               #if ( WRF_CHEM == 1)
            4363     2                     ! EMK...Nuclei only calculated when coupling
            4364     2                     if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            4365     2                           chem_opt == 302 .or. chem_opt == 303) .and. &
            4366     2                           (gsfcgce_gocart_coupling == 1) ) then
            4367     2                        icn_diag(i,k) = icn_out(i)  ! #/Litre
            4368     2                        nc_diag(i,k) = ccn_out(i)  ! #/cm3
            4369     2                     else
            4370     2                        icn_diag(i,k) = 0
            4371     2                        nc_diag(i,k) = 0
            4372     2                     end if
            4373     2               #endif
            4374     2               
            4375     2               !JJS 20140305 vvvvv  Calculate effective radius for all cloud species
            4376     2               !   eff_rad is a function of the slope parameter (Lambda)
            4377     2               
            4378     2                   ! rain
            4379     3   p    v            if (qrn(i,k) .lt. cmin) then
            4380     3   p    v               re_rain_gsfc(i,k) = 0.e0
            4381     3   p    v            else
            4382     3   pi   v               re_rain_gsfc(i,k) = eff_rad(zr(i))
            4383     3   p    v            endif
            4384     2                   ! snow
            4385     3   p    v            if (qcs(i,k) .lt. cmin) then
            4386     3   p    v               re_snow_gsfc(i,k) = 0.e0
            4387     3   p    v            else
            4388     3   pi   v               re_snow_gsfc(i,k) = eff_rad(zs(i))
            4389     3   p    v            endif
            4390     2                   ! graupel
            4391     3   p    v            if (qcg(i,k) .lt. cmin) then
            4392     3   p    v               re_graupel_gsfc(i,k) = 0.e0
            4393     3   p    v            else
            4394     3   pi   v               re_graupel_gsfc(i,k) = eff_rad(zg(i))
            4395     3   p    v            endif
            4396     2                   ! hail
            4397     3   p    v            if (qch(i,k) .lt. cmin) then
            4398     3   p    v               re_hail_gsfc(i,k) = 0.e0
            4399     3   p    v            else
            4400     3   pi   v               re_hail_gsfc(i,k) = eff_rad(zh(i))
            4401     3   p    v            endif
            4402     2               
            4403     2               ! for cloud water
            4404     2               
            4405     3   p    v         if (qcl(i,k) .lt. cmin) then
            4406     3   p    v            re_cloud_gsfc(i,k) = 0.e0
            4407     3   p    v         else
            4408     3   p    v            L_cloud = qcl(i,k) * rho(i,k)             ! cloud water [g/cm3]
            4409     3               #if (WRF_CHEM == 1)
            4410     3                  ! when running with WRF_Chem and using aerosol coupling in Goddard MP
            4411     3                          ! cpi: const_pi = 4.*atan(1.)         ~ 3.1415
            4412     3                          ! roqr: 1.0 g/cm**3, liquid water density
            4413     3                          ! roqi: 0.9179, ice density
            4414     3                           if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            4415     3                                  chem_opt == 302 .or. chem_opt == 303) .and. &
            4416     3                                  (gsfcgce_gocart_coupling == 1) ) then
            4417     3                             ! for cloud water, estimate lambda (slope of gamma distribution)
            4418     3                                  mu = min(15.e0, (1000.E0/ccn_out(i) + 2.e0))
            4419     3                                  gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4420     3                                  gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4421     3                                  lambda = (4.e0/3.e0*cpi*roqr*ccn_out(i)/L_cloud*   &
            4422     3                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4423     3                                  re_cloud_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4424     3                            else
            4425     3                  ! when running with WRF_Chem but no aerosol coupling in Goddard MP
            4426     3                              if (xland(i) .eq. 1.0) then
            4427     3                                 ccn_ref = ccn_over_land
            4428     3                              else if (xland(i) .eq. 2.0) then
            4429     3                                 ccn_ref = ccn_over_water
            4430     3                              else
            4431     3                                 print *,' xland is not 1. or 2., run stopped'
            4432     3                                 ! EMK NUWRF
            4433     3               !                  call wrf_error_fatal(' xland is not 1. or 2., run stopped')
            4434     3               !                  stop
            4435     3                              endif
            4436     3                                ! for cloud water, estimate lambda (slope of gamma distribution)
            4437     3                                     mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            4438     3                                     gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4439     3                                     gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4440     3                                     lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            4441     3                                              gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4442     3                                     re_cloud_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4443     3                           endif ! chem_opt and gsfcgce_gocart_coupling
            4444     3               #else
            4445     3                  ! Not running with WRF_Chem
            4446     3                           ! ccn_over_land = 1500  ! [#/cm3] climatological value
            4447     3                           ! ccn_over_water = 150  ! [#/cm3] climatological value
            4448     4   p    v                  if (xland(i) .eq. 1.0) then
            4449     4   m    m                     ccn_ref = ccn_over_land
            4450     4   p    v                  else if (xland(i) .eq. 2.0) then
            4451     4   m    m                     ccn_ref = ccn_over_water
            4452     4   p    v                  else
            4453     4   m    m                     print *,' xland is not 1. or 2., run stopped'
            4454     4                              ! EMK NUWRF
            4455     4               !               call wrf_error_fatal(' xland is not 1. or 2., run stopped')
            4456     4               !               stop
            4457     4   p    v                  endif
            4458     3                          ! for cloud water, estimate lambda (slope of gamma distribution)
            4459     3   s    s                         mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            4460     3   m    m                         gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4461     3   m    m                         gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4462     3   m    m                         lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            4463     3                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4464     3   p    v                         re_cloud_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4465     3               #endif
            4466     3   p    v         endif ! qcl(i,k) < cmin test
            4467     2               
            4468     2               ! for cloud ice
            4469     2               
            4470     3   p    v         if (qci(i,k) .lt. cmin) then
            4471     3   p    v            re_ice_gsfc(i,k) = 0.e0
            4472     3   p    v         else
            4473     3               #if (WRF_CHEM == 1)
            4474     3               !  ! when running with WRF_Chem and using aerosol coupling in Goddard MP
            4475     3               !      I_cloud = qci(i,k) * rho(i,k)             ! cloud ice [g/cm3]
            4476     3               !      if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
            4477     3               !          chem_opt == 302 .or. chem_opt == 303) .and. &
            4478     3               !          (gsfcgce_gocart_coupling == 1) ) then
            4479     3               !        ! for cloud ice, estimate lambda (slope of gamma distribution)
            4480     3               !         mu = min(15.e0, (1000.E0/(icn_out*1.e-3)  + 2.e0))
            4481     3               !         gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4482     3               !         gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4483     3               !         lambda = (4.e0/3.e0*cpi*roqi*icn_out*1.e-3/I_cloud*  &
            4484     3               !                  gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4485     3               !         re_ice_gsfc(i,k) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4486     3               !      else
            4487     3                 ! when running with WRF_Chem but no aerosol coupling in Goddard MP
            4488     3                       ! for cloud ice effective radius depends on temperature profile, formula from GCE
            4489     3                        re_ice_gsfc(i,k) = 125.e0 +(tair(i)-243.16)*5.e0     ! [micron]
            4490     3                        if (tair(i) .gt. 243.16) re_ice_gsfc(i,k) = 125.e0
            4491     3                        if (tair(i) .lt. 223.16) re_ice_gsfc(i,k) = 25.e0
            4492     3               !      endif ! chem_opt and gsfcgce_gocart_coupling
            4493     3               #else
            4494     3                 ! Not running with WRF_Chem
            4495     3                    ! for cloud ice effective radius depends on temperature profile, formula from GCE
            4496     3   p    v            re_ice_gsfc(i,k) = 125.e0 +(tair(i)-243.16)*5.e0     ! [micron]
            4497     3   p    v            if (tair(i) .gt. 243.16) re_ice_gsfc(i,k) = 125.e0
            4498     3   p    v            if (tair(i) .lt. 223.16) re_ice_gsfc(i,k) = 25.e0
            4499     3               #endif
            4500     3   p    v         endif ! qci(i,k) < cmin test
            4501     2               
            4502     2               !JJS 20140305 ^^^^^  Calculate effective radius for all cloud species
            4503     2               
            4504     2   p    v       ENDDO
            4505     1               
            4506     1                1000 continue
            4507                     
            4508                     !JJS  ****************************************************************
            4509                     !JJS  convert from GCE grid back to WRF grid
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 16
                                   <<< Loop-information  End >>>
            4510     1  pp                 do k=kts,kte
            4511     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qch, qhwrf, qcg, qgwrf, qcs, qswrf, qci
                                   <<<      qiwrf, qrn, qrwrf, qcl, qlwrf, dqv
                                   <<<      qvwrf, dpt, ptwrf
                                   <<< Loop-information  End >>>
            4512     2   p    v             DO i=1,irestrict
            4513     2   p    v               ptwrf(i,k) = dpt(i,k)
            4514     2   p    v               qvwrf(i,k) = dqv(i,k)
            4515     2   p    v               qlwrf(i,k) = qcl(i,k)
            4516     2   p    v               qrwrf(i,k) = qrn(i,k)
            4517     2   p    v               qiwrf(i,k) = qci(i,k)
            4518     2   p    v               qswrf(i,k) = qcs(i,k)
            4519     2   p    v               qgwrf(i,k) = qcg(i,k)
            4520     2   p    v               qhwrf(i,k) = qch(i,k)
            4521     2   p    v             ENDDO
            4522     1   p                 enddo !k
            4523                     
            4524                     !     ****************************************************************
            4525                     
            4526                     !+---+-----------------------------------------------------------------+
            4527                     ! EMK NUWRF...Replace Greg Thompson's dBZ values with those calculated
            4528                     ! above.
            4529     1                       IF ( PRESENT (diagflag) ) THEN
            4530     2                       if (diagflag .and. do_radar_ref == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 33
                                   <<< Loop-information  End >>>
            4531     3  pp                     do k=kts,kte
            4532     3               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dbz, refl_10cm
                                   <<< Loop-information  End >>>
            4533     4   p   2v                  DO i=1,irestrict
            4534     4   p   2v                          refl_10cm(i,k) = max(-35.,dbz(i,k))
            4535     4   p   2v                  ENDDO
            4536     3   p                     end do
            4537     2               
            4538     2                       endif
            4539     1                       ENDIF
            4540                     !+---+-----------------------------------------------------------------+
            4541                     
            4542                       END SUBROUTINE saticel_s
            4543                     
            4544                       SUBROUTINE auto_conversion( L, N, P , re)
            4545                       implicit none
            4546                     !-----------------------------------------------------------------------------------------------------
            4547                     ! Comments:
            4548                     !  This subroutine compute auto conversion rate folloing Li and Daum [2004], which account for
            4549                     !  total cloud liquid water, particle number concentrations, PSD lambda, broadening parameters.
            4550                     !
            4551                     ! History:
            4552                     !  08/2010  Toshi Matsui@NASA GSFC : Initial.
            4553                     !
            4554                     !
            4555                     ! References:
            4556                     ! Liu, Y. and P. H. Daum, 2004: Parameterization of the autoconversion process. Part I: Analytical
            4557                     !   formulation of the Kessler-type parameterizations. J. Atmos. Sci, 61, 1539-1548.
            4558                     !-----------------------------------------------------------------------------------------------------
            4559                      real,intent(in) :: L    ! cloud liquid water [g cm-3]
            4560                      real,intent(in) :: N    ! total number concentration [# cm-3]
            4561                      real,intent(out) :: P   ! auto conversion rate [g cm-3 s-1]
            4562                      real,intent(out) :: re  ! cloud effective radius [micron]
            4563                     
            4564                      real :: mu   ! mu of gamma PSD [-]
            4565                      real :: eta  ! eta function [cm3 g-2 s-1]
            4566                      real :: beta, beta1, beta2     ! beta function [-]
            4567                      real :: gamfac , gfac1 , gfac2 ! gamma function [-]
            4568                      real :: R6_6power  ! mean radius of the sixth moment [cm]
            4569                      real :: R6_thresh ! threshold of  mean radius of the sixth moment [cm]
            4570                      real :: R6        ! mean radius of the sixth moment [cm]
            4571                      real :: Heaviside_func  ! Heaviside step function (0 or 1)
            4572                      real :: lambda    ! slope of gamma size ditribution [1/cm]
            4573                     ! real :: No        ! intercept  [cm-4]
            4574                     
            4575                      real,parameter :: Rc = 10.e0 * 1.e-4 ! threshold of particle radus (10 micron) [cm]
            4576                      real,parameter :: const_pi    = 3.14159e0 ! pai
            4577                      real,parameter :: const_kappa = 1.9e11    ! coefficient for water droplet collection kernel [cm-3 s-1]
            4578                                                                ! from Long [1974, JAS].
            4579                     ! real,parameter :: const_kappa = 1.9e11*10000.e0 !10000 is to adjust the order to keseller
            4580                     
            4581                     
            4582                      real,parameter :: const_rho_liq = 1.e0    ! density of liquid water [g cm-3]
            4583                      real,parameter :: eta_func = ((3.e0/(4.e0*const_pi*const_rho_liq))**2) * const_kappa  ! eta function [cm3 g-2 s-1]
            4584                                                                                                            ! a part of (eq 27b)
            4585                     
            4586                      logical,parameter :: no_thresh = .true.  ! logic to choose no threshold parameterization or not.
            4587                     
            4588                     !
            4589                     ! When no particel, no autoconversion.
            4590                     !
            4591                     ! EMK BUG FIX...Prevent overflow for small but non-zero values of L
            4592                     ! if( N <= 0.e0 .or. L <= 0.e0 ) then
            4593     1                if( N <= 0.e0 .or. L <= 1.0e-32 ) then
            4594     1                  P = 0.e0
            4595     1                  return
            4596     1                endif
            4597                     
            4598                     !
            4599                     ! check bad values of N and L
            4600                     !
            4601                     ! if( N < 0.e0 ) stop 'MSG auto_conversion: N is negative, it must be positive'
            4602                     ! if( L < 0.e0 ) stop 'MSG auto_conversion: L is negative, it must be positive'
            4603                     ! if( L > 1.e0 ) stop 'MSG auto_conversion: L is greater than 1g/cm3.'
            4604                     
            4605                     !
            4606                     ! Empirical fit of mu as a function of total particle number concentrations.
            4607                     ! From Martin et al. (1994), assign gamma shape parameter mu for cloud
            4608                     ! drops according to general dispersion characteristics.
            4609                     ! disp=~0.25 for Maritime and 0.45 for Continental.
            4610                     ! Since disp=SQRT((mu+2)/(mu+1) - 1), mu varies from 15 for Maritime (pristine air)
            4611                     ! to 2 for Continental (really dirty air).  if mu = 0 --> expnential distribution (narrow dist)
            4612                     !
            4613                     
            4614                     ! orig
            4615                      mu = MIN(15.e0, (1000.E0/N + 2.e0))
            4616                     
            4617                     
            4618                     !
            4619                     ! gamma functions
            4620                     !
            4621                      gfac1 = gamma_toshi(mu+4.e0)
            4622                      gfac2 = gamma_toshi(mu+1.e0)
            4623                      gamfac = (gfac1/gfac2)
            4624                     
            4625                     !
            4626                     ! estimate lambda (slope of gamma distribution)
            4627                     !
            4628                      lambda = (4.e0/3.e0*const_pi*const_rho_liq*N/L*gamfac)**(1.e0/3.e0)  ! [1/cm]
            4629                     
            4630                     
            4631     1                THRESH: if( no_thresh ) then !-------------------------------------------
            4632     1               
            4633     1               !
            4634     1               ! threshold of particle radius (mean radius of the sixth moment )
            4635     1               !
            4636     1                gfac1 = gamma_toshi(mu+7.e0)
            4637     1                gfac2 = gamma_toshi(mu+1.e0)
            4638     1                gamfac = (gfac1/gfac2)
            4639     1               
            4640     1                R6_6power = (1.e0 / lambda)**6.e0 * gamfac   ![cm] (eq. A3)
            4641     1               
            4642     1               !
            4643     1               ! auto conversion rate (eq. 26a)
            4644     1               !
            4645     1                P = const_kappa *   N     * R6_6power *    L      ! [g cm-3 s-1 ]
            4646     1               !    [cm-3 s-1]  * [#/cm3] *   [cm6]   * [g/cm3]
            4647     1               
            4648     1               
            4649     1                else  !with threshold ---------------------------------------------------
            4650     1               
            4651     1               !
            4652     1               ! Estimate eta under gamma PSD
            4653     1               !
            4654     1                beta1 = (6.e0+mu)*(5.e0+mu)*(4.e0+mu)
            4655     1                beta2 = (3.e0+mu)*(2.e0+mu)*(1.e0+mu)
            4656     1                beta  = beta1 / beta2
            4657     1               
            4658     1                eta = eta_func * beta  ! eta function (eq 27b) [cm3 g-2 s-1]
            4659     1               
            4660     1               !
            4661     1               ! threshold of particle radius (mean radius of the sixth moment )
            4662     1               !
            4663     1                R6_thresh = beta * Rc  ![cm] (pg 1545)
            4664     1               
            4665     1               !
            4666     1               ! mean radius of the sixth moment
            4667     1               !
            4668     1                gfac1 = gamma_toshi(6.e0+mu+1.e0)
            4669     1                gfac2 = gamma_toshi(1.e0+mu)
            4670     1                gamfac = (gfac1/gfac2)**(1.e0/6.e0)
            4671     1               
            4672     1                R6 = (1.e0 / lambda) * gamfac   ![cm] (eq. A3)
            4673     1               
            4674     1               !
            4675     1               ! Heaviside step function
            4676     1               !
            4677     2                if    ( R6 - R6_thresh <= 0.e0 ) then
            4678     2                   Heaviside_func = 0.e0
            4679     2                elseif( R6 - R6_thresh > 0.e0 ) then
            4680     2                   Heaviside_func = 1.e0
            4681     2                else
            4682     2                   ! NUWRF EMK...User WRF's library to gracefully stop MPI.
            4683     2               !    write(wrf_err_message,*)'MSG: auto_conversion: Strange value of R6= ',R6
            4684     2               !    call wrf_error_fatal(trim(wrf_err_message))
            4685     2               !   print*, 'MSG: auto_conversion: Strange value of R6= ', R6 ; stop
            4686     2                endif
            4687     1               
            4688     1               !
            4689     1               ! auto conversion rate [g cm-3 s-1 ] (eq. 27a)
            4690     1               !
            4691     1                P = eta * (1.e0/N) * (L**3) *  Heaviside_func
            4692     1               
            4693     1               !    [cm3 g-2 s-1] * [cm3] * [g3/cm9]
            4694     1               
            4695     1                endif THRESH !------------------------------------------------------------
            4696                     
            4697                     
            4698                     ! optional
            4699                     
            4700                     !
            4701                     ! estimate effective radius
            4702                     !
            4703                      gfac1 = gamma_toshi(mu+4.e0)
            4704                      gfac2 = gamma_toshi(mu+3.e0)
            4705                      gamfac = (gfac1/gfac2)
            4706                     
            4707                      re = 1.e0/lambda * gamfac * 1.e4  !effective radius [micron]
            4708                     
            4709                     !
            4710                     ! estimate No
            4711                     !
            4712                     ! call gamma_function(mu+1.e0 ,gfac1)
            4713                     ! No = N * (lambda**(mu+1)) / gfac1
            4714                     
            4715                      END subroutine auto_conversion
            4716                     
            4717                     !DIR$ ATTRIBUTES FORCEINLINE :: gamma_toshi
            4718                      real function gamma_toshi(x)
            4719                     
            4720                     !---------------------------------------------------------------------------------------------------
            4721                     ! Comments:
            4722                     !   compute the gamma function T(x) for single precision floating point.
            4723                     !       input :  x  --- argument of a(x)
            4724                     !                       ( x is not equal to 0,-1,-2,... )
            4725                     !
            4726                     ! History:
            4727                     ! 09/2009  Toshi Matsui@NASA GSFC ; Adapted to SDSU
            4728                     !
            4729                     ! References:
            4730                     !----------------------------------------------------------------------------------------------------
            4731                      implicit double precision (a-h,o-z)
            4732                      dimension g(26)
            4733                      data g/1.0d0,0.5772156649015329d0, &
            4734                            -0.6558780715202538d0, -0.420026350340952d-1, &
            4735                             0.1665386113822915d0,-.421977345555443d-1, &
            4736                             -.96219715278770d-2, .72189432466630d-2, &
            4737                             -.11651675918591d-2, -.2152416741149d-3, &
            4738                             .1280502823882d-3, -.201348547807d-4, &
            4739                             -.12504934821d-5, .11330272320d-5, &
            4740                             -.2056338417d-6, .61160950d-8, &
            4741                              .50020075d-8, -.11812746d-8, &
            4742                             .1043427d-9, .77823d-11, &
            4743                             -.36968d-11, .51d-12, &
            4744                             -.206d-13, -.54d-14, .14d-14, .1d-15/
            4745                      real :: x
            4746                     
            4747                      pi=3.141592653589793d0
            4748     1                if (x.eq.int(x)) then
            4749     2                    if (x.gt.0.0d0) then
            4750     2                        ga=1.0d0
            4751     2                        m1=int(x)-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4752     3  pp    v              do k=2,m1
            4753     3   p    v                 ga=ga*k
            4754     3   p    v              enddo
            4755     2                    else
            4756     2                       ga=1.0d+300
            4757     2                    endif
            4758     1                 else
            4759     2                    if (dabs(dble(x)).gt.1.0d0) then
            4760     2                        z=dabs(dble(x))
            4761     2                        m=int(z)
            4762     2                        r=1.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4763     3  pp    v              do k=1,m
            4764     3   p    v                 r=r*(z-k)
            4765     3   p    v              enddo
            4766     2                       z=z-m
            4767     2                    else
            4768     2                       z=dble(x)
            4769     2                    endif
            4770     1                    gr=g(26)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      g
                                   <<< Loop-information  End >>>
            4771     2   s   4s           do k=25,1,-1
            4772     2   s   4s              gr=gr*z+g(k)
            4773     2   s   4s           enddo
            4774     1                    ga=1.0d0/(gr*z)
            4775     2                    if (dabs(dble(x)).gt.1.0d0) then
            4776     2                        ga=ga*r
            4777     2                        if (x.lt.0.0d0) ga=-pi/(x*ga*dsin(pi*x))
            4778     2                    endif
            4779     1                 endif
            4780                     
            4781                       gamma_toshi = real(ga)
            4782                     
            4783                       end function gamma_toshi

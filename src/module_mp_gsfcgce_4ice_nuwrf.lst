                                   <<<      qracg: 2, rp0: 2, qv: 2, alvr: 2
                                   <<<      h15ar: 2, h9r: 2, h10r: 2, h17r: 2
                                   <<<      scv: 2, h17aq: 2, r16rf: 2, tca: 2
                                   <<<      dwv: 2

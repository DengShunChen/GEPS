            3665     3   s    s                 psmlt(i)=r2is*min(qs(i),max(dd(i),0.0))
            3666     4   s    s                 if (r00(i)*qg(i).gt.qrog2) then
            3667     4   m    s                   y2(i)=(r191r(i)/zg(i)**2+r192rf2(i)/zg(i)**bgh5_2)*ftng(i)
            3668     4   s    s                 else

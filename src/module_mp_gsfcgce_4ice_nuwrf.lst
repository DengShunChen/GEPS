            3744     4                                                                                     ! Roger found the bug on 2012/04/27
            3745     4   p    s                      if (r_nci.gt.15.) r_nci=15.                          !cap at 15000/liter
            3746     4               
            3747     4               ! Cooper curve
            3748     5   p    s                    if( tairc(i) .lt. -40.0 ) then
            3749     5   p    s                      c_nci = 5.0e-6*exp(0.304*40.0)
            3750     5   p    s                    else
            3751     5   p    s                      c_nci = 5.0e-6*exp(0.304*abs(tairc(i)))
            3752     5   s    s                    end if
            3753     4   s    s                    r_nci = c_nci
            3754     4               ! JDC cap r_nci to the amount corresponding to crystal size of ami50

                                   <<<      dgaci, dgacs, dgacw, dgacr, pimm, pcfr
                                   <<<      pihms, pihmg, pihom, pimlt, pidw, wgacs
                                   <<<      wgaci, pgwet, qgacr, ftns
                                   <<<    PREFETCH(SOFT) : 296
                                   <<<     SEQUENTIAL : 296

            3670     4   s    s                 endif
            3671     3   s    s                 dd1(i)=tairc(i)*(r19t*y2(i)+r19at*(qgacw(i) &
            3672     3                                                            +qgacr(i)))
            3673     3   s    s                 pgmlt(i)=r2ig*min(qg(i),max(dd1(i),0.0))
            3674     3               

            2459     3   p    v                   acphyse(i,k)=0.
            2460     3   p    v                   acphysd(i,k)=0.
            2461     3   p    v                   acphyss(i,k)=0.
            2462     3   p    v                   acphysf(i,k)=0.
            2463     3   p    v                   acphysm(i,k)=0.
            2464     3   p    v             ENDDO
            2465     2   p                  enddo !k
            2466     1               !      if ( wrf_dm_on_monitor() .and. i.eq.its .and. j.eq.jts ) then
            2467     1               !       write(6, *) '    latent heating variables have been initialized to 0. at timestep = ', itimestep
            2468     1               !      endif
            2469     1                  endif
            2470                     
            2471                     !JJS  convert from mks to cgs, and move from WRF grid to GCE grid
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<< Loop-information  End >>>
            2472     1  pp                 do k=kts,kte
            2473     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qhwrf, qch, qgwrf, qcg, qswrf, qcs
                                   <<<      qiwrf, qci, qrwrf, qrn, qlwrf, qcl
                                   <<<      qvwrf, dqv, ptwrf, dpt
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      w_mks: 2, ww1: 2, pi_mks: 2, pi: 2
                                   <<<      p0_mks: 2, rho_mks: 2, p0: 2, rho: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2474     2   p    v              DO i=1,irestrict
            2475     2   p    v               rho(i,k)=rho_mks(i,k)*0.001
            2476     2   p    v               p0(i,k)=p0_mks(i,k)*10.0
            2477     2   p    v               pi(i,k)=pi_mks(i,k)
            2478     2   p    v               ww1(i,k)=w_mks(i,k)*100.
            2479     2   p    v               dpt(i,k)=ptwrf(i,k)
            2480     2   p    v               dqv(i,k)=qvwrf(i,k)
            2481     2   p    v               qcl(i,k)=qlwrf(i,k)
            2482     2   p    v               qrn(i,k)=qrwrf(i,k)
            2483     2   p    v               qci(i,k)=qiwrf(i,k)
            2484     2   p    v               qcs(i,k)=qswrf(i,k)
            2485     2   p    v               qcg(i,k)=qgwrf(i,k)
            2486     2   p    v               qch(i,k)=qhwrf(i,k)
            2487     2   p    v              ENDDO
            2488     1   p                 enddo !k
            2489                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 33
                                   <<< Loop-information  End >>>
            2490     1  pp                 do k=kts,kte
            2491     1               !dir$ vector aligned
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rho, fv
                                   <<< Loop-information  End >>>
            2492     2   p   2v              DO i=1,irestrict
            2493     2   p   2v                  fv(i,k)=sqrt(rho(i,1)/rho(i,k))
            2494     2   p   2v              ENDDO
            2495     1   p                 enddo !k
            2496                     !JJS

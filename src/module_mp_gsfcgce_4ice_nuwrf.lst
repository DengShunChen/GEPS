            4990                     !JJS 20140225
            4991                     ! Calculate cloud droplet effective radius
            4992                        real function eff_rad(lambda)
            4993                     
            4994                     #ifndef NO_IEEE_MODULE
            4995                           use, intrinsic :: ieee_arithmetic
            4996                     #endif
            4997                           implicit none
            4998                     
            4999                     !---------------------------------------------------------------------------------------------------
            5000                     ! Comments:
            5001                     ! Compute drop effective radius from slope parameters (lambda) of expoential size distribution.
            5002                     !
            5003                     ! History:
            5004                     ! 02/2014  Toshi Matsui@NASA GSFC ; Initial
            5005                     !
            5006                     ! References:
            5007                     !----------------------------------------------------------------------------------------------------
            5008                           real,intent(in)  :: lambda   ! intercept parameter [1/cm]
            5009                     
            5010                     !
            5011                     ! for no particles.
            5012                     !
            5013                     #ifndef NO_IEEE_MODULE
            5014     1                      if ( lambda <= 0.e0  .or. ieee_is_nan(lambda) ) then
            5015     1               #else
            5016     1                      if ( lambda <= 0.e0                           ) then
            5017     1               #endif
            5018     1                         eff_rad = 0.e0
            5019     1                         return
            5020     1                      endif
            5021                     
            5022                     !
            5023                     ! compute drop effective radius for exponential distribution N(D) = N0*exp(-lam*D)
            5024                     !
            5025                            eff_rad = 1.5e0 / (lambda*100.) * 1.0e+6  ! [micron]
            5026                     
            5027                        end function eff_rad
            5028                     

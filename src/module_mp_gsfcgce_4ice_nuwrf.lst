            3727     3   s    s                  TAIRC(i)=TAIR(i)-T0
            3728     3   m    s                   y1(i) = max( min(tairc(i), -1.), -31.)
            3729     3   s    s                   it(i) = int(abs(y1(i)))
            3730     3   s    s                   y2(i)=aa1(it(i))
            3731     3   s    s                   y3(i) = aa2(it(i))
            3732     4   s    s                   if (tairc(i).le.-5.)then                       !  meyers
            3733     4   s    s                      rtair(i)=1./(tair(i)-c76)
            3734     4   s    s                      y5(i)=exp(c218-c580*rtair(i))
            3735     4   s    s                      qsi(i)=rp0(i)*y5(i)
            3736     4   p    s                      SSI(i)=(qv(i)+qb0)/qsi(i)-1.
            3737     4   p    s                      fssi=min(xssi,max(rssi,xssi*(tairc(i)+44.)/(44.0-38.0))) !max ssi f(tair)
            3738     4   p    s                      fssi=rssi
            3739     4   p    s                      wssi=ww1(i,k)/100.-2.0
            3740     4   p    s                      if(wssi.gt.0.) fssi=rssi+min(xssi,wssi*0.01)
            3741     4   p    s                      fssi=min(ssi(i),fssi)
            3742     4               

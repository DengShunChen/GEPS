             517     3                                  ims,ime, jms,jme, kms,kme,                    & ! memory dims
             518     3                                  its,ite, jts,jte, kts,kte,                    & ! tile   dims
             519     3               !NUWRF BEGIN
             520     3                                  refc2d, refr2d, refi2d, refs2d, refg2d, refh2d,  & ! cloud effective radius

            3957     3   s    s               if (tair(i).ge.t00) THEN
            3958     3   s    s                  y1(i)=1./(tair(i)-c358)
            3959     3   s    s                  qsw(i)=rp0(i)*exp(c172-c409*y1(i))
            3960     3   s    s                  dd(i)=cp409(i)*y1(i)*y1(i)
            3961     3   s    s                  dm(i)=qv(i)+qb0-qsw(i)
            3962     3   s    s                  cnd(i)=dm(i)/(1.+avcp(i)*dd(i)*qsw(i))
            3963     3               !c    ******   condensation or evaporation of qc  ******

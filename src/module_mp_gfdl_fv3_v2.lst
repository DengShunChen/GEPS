            4543                     ! =======================================================================
            4544                     
            4545                     subroutine qs_table2 (n)
            4546                     
            4547                         implicit none
            4548                     
            4549                         integer, intent (in) :: n
            4550                     
            4551                         real (kind = r8) :: delt = 0.1
            4552                         real (kind = r8) :: tmin, tem0, tem1, fac0, fac1, fac2
            4553                     
            4554                         integer :: i, i0, i1
            4555                     
            4556                         tmin = table_ice - 160.
            4557                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4558     1  pp    v          do i = 1, n
            4559     1   p    v              tem0 = tmin + delt * real (i - 1)
            4560     1   p    v              fac0 = (tem0 - t_ice) / (tem0 * t_ice)
            4561     2   p    v              if (i <= 1600) then
            4562     2                           ! -----------------------------------------------------------------------
            4563     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4564     2                           ! -----------------------------------------------------------------------
            4565     2   p    v                  fac1 = fac0 * li2
            4566     2   p    v                  fac2 = (d2ice * log (tem0 / t_ice) + fac1) / rvgas
            4567     2   p    v              else
            4568     2                           ! -----------------------------------------------------------------------
            4569     2                           ! compute es over water between 0 deg c and 102 deg c.
            4570     2                           ! -----------------------------------------------------------------------
            4571     2   p    v                  fac1 = fac0 * lv0
            4572     2   p    v                  fac2 = (dc_vap * log (tem0 / t_ice) + fac1) / rvgas
            4573     2   p    v              endif
            4574     1   p    v              table2 (i) = e00 * exp (fac2)
            4575     1   p    v          enddo
            4576                     
            4577                         ! -----------------------------------------------------------------------
            4578                         ! smoother around 0 deg c
            4579                         ! -----------------------------------------------------------------------
            4580                     
            4581                         i0 = 1600
            4582                         i1 = 1601
            4583                         tem0 = 0.25 * (table2 (i0 - 1) + 2. * table (i0) + table2 (i0 + 1))
            4584                         tem1 = 0.25 * (table2 (i1 - 1) + 2. * table (i1) + table2 (i1 + 1))
            4585                         table2 (i0) = tem0
            4586                         table2 (i1) = tem1
            4587                     
            4588                     end subroutine qs_table2

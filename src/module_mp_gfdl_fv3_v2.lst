            4590                     ! =======================================================================
            4591                     ! saturation water vapor pressure table iv
            4592                     ! 2 - phase table with " - 2 c" as the transition point
            4593                     ! =======================================================================
            4594                     
            4595                     subroutine qs_table3 (n)
            4596                     
            4597                         implicit none
            4598                     
            4599                         integer, intent (in) :: n
            4600                     
            4601                         real (kind = r8) :: delt = 0.1
            4602                         real (kind = r8) :: esbasw, tbasw, esbasi, tmin, tem, aa, b, c, d, e
            4603                         real (kind = r8) :: tem0, tem1
            4604                     
            4605                         integer :: i, i0, i1
            4606                     
            4607                         esbasw = 1013246.0
            4608                         tbasw = table_ice + 100.
            4609                         esbasi = 6107.1
            4610                         tmin = table_ice - 160.
            4611                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 23  FILL 42
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4612     1  pp    v          do i = 1, n
            4613     1   p    v              tem = tmin + delt * real (i - 1)
            4614     1                       ! if (i <= 1600) then
            4615     2   p    v              if (i <= 1580) then ! change to - 2 c
            4616     2                           ! -----------------------------------------------------------------------
            4617     2                           ! compute es over ice between - 160 deg c and 0 deg c.
            4618     2                           ! see smithsonian meteorological tables page 350.
            4619     2                           ! -----------------------------------------------------------------------
            4620     2   p    v                  aa = - 9.09718 * (table_ice / tem - 1.)
            4621     2   p    v                  b = - 3.56654 * log10 (table_ice / tem)
            4622     2   p    v                  c = 0.876793 * (1. - tem / table_ice)
            4623     2   p    v                  e = log10 (esbasi)
            4624     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + e)
            4625     2   p    v              else
            4626     2                           ! -----------------------------------------------------------------------
            4627     2                           ! compute es over water between - 2 deg c and 102 deg c.
            4628     2                           ! see smithsonian meteorological tables page 350.
            4629     2                           ! -----------------------------------------------------------------------
            4630     2   p    v                  aa = - 7.90298 * (tbasw / tem - 1.)
            4631     2   p    v                  b = 5.02808 * log10 (tbasw / tem)
            4632     2   p    v                  c = - 1.3816e-7 * (10 ** ((1. - tem / tbasw) * 11.344) - 1.)
            4633     2   p    v                  d = 8.1328e-3 * (10 ** ((tbasw / tem - 1.) * (- 3.49149)) - 1.)
            4634     2   p    v                  e = log10 (esbasw)
            4635     2   p    v                  table3 (i) = 0.1 * 10 ** (aa + b + c + d + e)
            4636     2   p    v              endif
            4637     1   p    v          enddo
            4638                     
            4639                         ! -----------------------------------------------------------------------
            4640                         ! smoother around - 2 deg c
            4641                         ! -----------------------------------------------------------------------
            4642                     
            4643                         i0 = 1580
            4644                         i1 = 1581
            4645                         tem0 = 0.25 * (table3 (i0 - 1) + 2. * table (i0) + table3 (i0 + 1))
            4646                         tem1 = 0.25 * (table3 (i1 - 1) + 2. * table (i1) + table3 (i1 + 1))
            4647                         table3 (i0) = tem0
            4648                         table3 (i1) = tem1
            4649                     
            4650                     end subroutine qs_table3
            4651                     
            4652                     ! =======================================================================
            4653                     ! compute the saturated specific humidity for table
            4654                     ! note: this routine is based on "moist" mixing ratio
            4655                     ! =======================================================================
            4656                     
            4657                     real function qs_blend (t, p, q)
            4658                     
            4659                         implicit none
            4660                     
            4661                         real, intent (in) :: t, p, q
            4662                     
            4663                         real :: es, ap1, tmin
            4664                     
            4665                         integer :: it
            4666                     
            4667                         tmin = table_ice - 160.
            4668                         ap1 = 10. * dim (t, tmin) + 1.
            4669                         ap1 = min (2621., ap1)
            4670                         it = ap1
            4671                         es = table (it) + (ap1 - it) * des (it)
            4672                         qs_blend = eps * es * (1. + zvir * q) / p
            4673                     
            4674                     end function qs_blend

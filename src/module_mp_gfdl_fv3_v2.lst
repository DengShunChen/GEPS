            4508                     ! =======================================================================
            4509                     ! saturation water vapor pressure table ii
            4510                     ! 1 - phase table
            4511                     ! =======================================================================
            4512                     
            4513                     subroutine qs_tablew (n)
            4514                     
            4515                         implicit none
            4516                     
            4517                         integer, intent (in) :: n
            4518                     
            4519                         real (kind = r8) :: delt = 0.1
            4520                         real (kind = r8) :: tmin, tem, fac0, fac1, fac2
            4521                     
            4522                         integer :: i
            4523                     
            4524                         tmin = table_ice - 160.
            4525                     
            4526                         ! -----------------------------------------------------------------------
            4527                         ! compute es over water
            4528                         ! -----------------------------------------------------------------------
            4529                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tablew
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4530     1  pp    v          do i = 1, n
            4531     1   p    v              tem = tmin + delt * real (i - 1)
            4532     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4533     1   p    v              fac1 = fac0 * lv0
            4534     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4535     1   p    v              tablew (i) = e00 * exp (fac2)
            4536     1   p    v          enddo
            4537                     
            4538                     end subroutine qs_tablew

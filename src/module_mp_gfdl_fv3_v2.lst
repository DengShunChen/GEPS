            2558     3               
            2559     4                               if (icloud_f .eq. 2) then
            2560     5                                   if (qstar < qpz) then
            2561     5                                       qa (k) = 1.
            2562     5                                   else
            2563     5                                       qa (k) = 0.
            2564     5                                   endif
            2565     4                               elseif (icloud_f .eq. 3) then
            2566     5                                   if (qstar < qpz) then
            2567     5                                       qa (k) = 1.
            2568     5                                   else
            2569     6                                       if (qstar < q_plus) then
            2570     6                                           qa (k) = (q_plus - qstar) / (dq * f_dq_p)
            2571     6                                       else
            2572     6                                           qa (k) = 0.
            2573     6                                       endif
            2574     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2575     6                                       if (q_cond (k) > qcldmin) then
            2576     6                                           qa (k) = max (cld_min, qa (k))
            2577     6                                       endif
            2578     5                                       qa (k) = min (1., qa (k))
            2579     5                                   endif
            2580     4                               else
            2581     5                                   if (qstar < q_minus) then
            2582     5                                       qa (k) = 1.
            2583     5                                   else
            2584     6                                       if (qstar < q_plus) then
            2585     7                                           if (icloud_f .eq. 0) then
            2586     7                                               qa (k) = (q_plus - qstar) / (dq * f_dq_p + dq * f_dq_m)
            2587     7                                           else
            2588     7                                               qa (k) = (q_plus - qstar) / ((dq * f_dq_p + dq * f_dq_m) * (1. - q_cond (k)))
            2589     7                                           endif
            2590     6                                       else
            2591     6                                           qa (k) = 0.
            2592     6                                       endif
            2593     5                                       ! impose minimum cloudiness if substantial q_cond (k) exist
            2594     6                                       if (q_cond (k) > qcldmin) then
            2595     6                                           qa (k) = max (cld_min, qa (k))
            2596     6                                       endif
            2597     5                                       qa (k) = min (1., qa (k))
            2598     5                                   endif
            2599     4                               endif
            2600     3                           else
            2601     3                               qa (k) = 0.
            2602     3                           endif
            2603     2                       endif
            2604     1               
            2605     1                   enddo
            2606                     
            2607                     end subroutine subgrid_z_proc

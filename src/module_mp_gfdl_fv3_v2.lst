            3847                     
            3848                     !    character (len = 64), intent (in) :: fn_nml
            3849                     !    character (len = *), intent (in) :: input_nml_file (:)
            3850                     
            3851                     !    logical :: exists
            3852                     
            3853                     !#ifdef INTERNAL_FILE_NML
            3854                     !    read (input_nml_file, nml = gfdl_mp_nml)
            3855                     !#else

            4329                     
            4330                     ! =======================================================================
            4331                     ! compute the saturated specific humidity for table iii
            4332                     ! =======================================================================
            4333                     
            4334                     real function qs1d_m (ta, qv, pa)
            4335                     
            4336                         implicit none
            4337                     
            4338                         real, intent (in) :: ta, pa, qv
            4339                     
            4340                         real :: es, ap1, tmin
            4341                     
            4342                         integer :: it
            4343                     
            4344                         tmin = table_ice - 160.
            4345                         ap1 = 10. * dim (ta, tmin) + 1.
            4346                         ap1 = min (2621., ap1)
            4347                         it = ap1
            4348                         es = table2 (it) + (ap1 - it) * des2 (it)
            4349                         qs1d_m = eps * es * (1. + zvir * qv) / pa
            4350                     
            4351                     end function qs1d_m

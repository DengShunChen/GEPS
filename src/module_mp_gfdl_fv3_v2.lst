            4290                     
            4291                         real :: es, ap1, tmin, eps10
            4292                     
            4293                         integer :: it
            4294                     
            4295                         tmin = table_ice - 160.
            4296                         eps10 = 10. * eps
            4297                         ap1 = 10. * dim (ta, tmin) + 1.
            4298                         ap1 = min (2621., ap1)
            4299                         it = ap1
            4300                         es = tablew (it) + (ap1 - it) * desw (it)
            4301                         wqsat2_moist = eps * es * (1. + zvir * qv) / pa
            4302                         it = ap1 - 0.5
            4303                         dqdt = eps10 * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) * (1. + zvir * qv) / pa
            4304                     
            4305                     end function wqsat2_moist
            4306                     
            4307                     ! =======================================================================
            4308                     ! compute the saturated specific humidity for table ii
            4309                     ! =======================================================================
            4310                     
            4311                     real function wqsat_moist (ta, qv, pa)
            4312                     
            4313                         implicit none
            4314                     
            4315                         real, intent (in) :: ta, pa, qv
            4316                     
            4317                         real :: es, ap1, tmin
            4318                     
            4319                         integer :: it
            4320                     
            4321                         tmin = table_ice - 160.

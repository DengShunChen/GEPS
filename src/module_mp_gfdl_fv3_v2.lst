            4729     1   s   2v          do i = 1, 200
            4730     1   p   2v              tem = 253.16 + delt * real (i - 1)
            4731     1   p   2v              wice = 0.05 * (table_ice - tem)
            4732     1   p   2v              wh2o = 0.05 * (tem - 253.16)
            4733     1   p   2v              table (i + 1400) = wice * table (i + 1400) + wh2o * esupc (i)
            4734     1   p   2v          enddo
            4735                     
            4736                     end subroutine qs_table

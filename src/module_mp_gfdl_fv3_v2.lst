             248                     
             249                         ! -----------------------------------------------------------------------
             250                         ! wrf / wsm6 scheme: qi_gen = 4.92e-11 * (1.e3 * exp (0.1 * tmp)) ** 1.33
             251                         ! optimized: qi_gen = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tmp)))
             252                         ! qi_gen ~ 4.808e-7 at 0 c; 1.818e-6 at - 10 c, 9.82679e-5 at - 40c
             253                         ! the following value is constructed such that qc_crt = 0 at zero c and @ - 10c matches
             254                         ! wrf / wsm6 ice initiation scheme; qi_crt = qi_gen * min (qi_lim, 0.1 * tmp) / den
             255                         ! -----------------------------------------------------------------------
             256                     
             257                         real :: sat_adj0 = 0.90 ! adjustment factor (0: no, 1: full) during fast_sat_adj
             258                     
             259                         real :: qc_crt = 5.0e-8 ! mini condensate mixing ratio to allow partial cloudiness
             260                     
             261                         real :: qi_lim = 1. ! cloud ice limiter to prevent large ice build up
             262                     
             263                         real :: ql_mlt = 2.0e-3 ! max value of cloud water allowed from melted cloud ice
             264                         real :: qs_mlt = 1.0e-6 ! max cloud water due to snow melt
             265                     
             266                         real :: ql_gen = 1.0e-3 ! max cloud water generation during remapping step if do_sat_adj = .t.
             267                         real :: qi_gen = 1.82e-6 ! max cloud ice generation during remapping step
             268                     
             269                         ! cloud condensate upper bounds: "safety valves" for ql & qi
             270                     
             271                         real :: ql0_max = 2.0e-3 ! max cloud water value (auto converted to rain)
             272                         real :: qi0_max = 1.0e-4 ! max cloud ice value (by other sources)
             273                     
             274                     !    real :: qi0_crt = 1.0e-4 ! cloud ice to snow autoconversion threshold (was 1.e-4)
             275                         real :: qi0_crt = 0.2e-4 ! cloud ice to snow autoconversion threshold (was 1.e-4)
             276                         ! qi0_crt if negative, its magnitude is used as the mixing ration threshold; otherwise, used as density
             277                         real :: qr0_crt = 1.0e-4 ! rain to snow or graupel / hail threshold
             278                         ! lin et al. (1983) used * mixing ratio * = 1.e-4 (hail)
             279                         real :: qs0_crt = 1.0e-3 ! snow to graupel density threshold (0.6e-3 in purdue lin scheme)
             280                     
             281                         real :: c_paut = 0.55 ! autoconversion cloud water to rain (use 0.5 to reduce autoconversion)
             282                         real :: c_psaci = 0.02 ! accretion: cloud ice to snow (was 0.1 in zetac)
             283                         real :: c_piacr = 5.0 ! accretion: rain to ice: (not used)
             284                         real :: c_cracw = 0.9 ! rain accretion efficiency
             285                         real :: c_pgacs = 2.0e-3 ! snow to graupel "accretion" eff. (was 0.1 in zetac)
             286                     
             287                         ! decreasing clin to reduce csacw (so as to reduce cloud water --- > snow)
             288                     
             289                         real :: alin = 842.0 ! "a" in lin et al. (1983)
             290                         real :: clin = 4.8 ! "c" in lin et al. (1983), 4.8 -- > 6. (to ehance ql -- > qs)
             291                     
             292                         logical :: const_vi = .false. ! if .t. the constants are specified by v * _fac
             293                         logical :: const_vs = .false. ! if .t. the constants are specified by v * _fac
             294                         logical :: const_vg = .false. ! if .t. the constants are specified by v * _fac
             295                         logical :: const_vr = .false. ! if .t. the constants are specified by v * _fac
             296                     
             297                     !    real :: vi_fac = 1. ! ifs: if const_vi: 1 / 3
             298                         real :: vi_fac = 0.9 ! CWB FV3
             299                         real :: vs_fac = 1. ! ifs: if const_vs: 1.
             300                         real :: vg_fac = 1. ! ifs: if const_vg: 2.
             301                         real :: vr_fac = 1. ! ifs: if const_vr: 4.
             302                     
             303                         real :: vi_max = 0.5 ! max fall speed for ice
             304                         real :: vs_max = 5.0 ! max fall speed for snow
             305                         real :: vg_max = 8.0 ! max fall speed for graupel
             306                         real :: vr_max = 12. ! max fall speed for rain
             307                     
             308                         real :: xr_a = 0.25 ! p value in xu and randall, 1996
             309                         real :: xr_b = 100. ! alpha_0 value in xu and randall, 1996
             310                         real :: xr_c = 0.49 ! gamma value in xu and randall, 1996
             311                     
             312                         real :: te_err = 1.e-14 ! 64bit: 1.e-14, 32bit: 1.e-7
             313                     
             314                         logical :: do_sat_adj = .false. ! has fast saturation adjustments
             315                         logical :: z_slope_liq = .true. ! use linear mono slope for autocconversions
             316                         logical :: z_slope_ice = .false. ! use linear mono slope for autocconversions
             317                         logical :: use_ccn = .false. ! must be true when prog_ccn is false
             318                         logical :: use_ppm = .false. ! use ppm fall scheme
             319                         logical :: use_ppm_ice = .false. ! use ppm fall scheme for cloud ice
             320                     !    logical :: use_semi = .true. ! use Semi-Lagrangian sedimentation
             321                     !    logical :: use_semi_ice = .false. ! use Semi-Lagrangian sedimentation for cloud ice
             322                         logical :: mono_prof = .true. ! perform terminal fall with mono ppm scheme
             323                         logical :: do_hail = .false. ! use hail parameters instead of graupel
             324                         logical :: hd_icefall = .false. ! use heymsfield and donner, 1990's fall speed of cloud ice
             325                         logical :: gce_icefall = .false. ! use Goddard's fall speed of cloud ice
             326                         logical :: use_xr_cloud = .false. ! use xu and randall, 1996's cloud diagnosis
             327                         logical :: use_park_cloud = .false. ! park et al. 2016
             328                         logical :: use_gi_cloud = .false. ! gultepe and isaac (2007, grl)
             329                         logical :: use_rhc_cevap = .false. ! cap of rh for cloud water evaporation
             330                         logical :: use_rhc_revap = .false. ! cap of rh for rain evaporation
             331                         logical :: consv_checker = .false. ! turn on energy and water conservation checker
             332                         logical :: do_warm_rain_mp = .false. ! do warm rain cloud microphysics only
             333                         ! turn off to save time, turn on only in c48 64bit
             334                     
             335                         real :: g2, log_10
             336                     
             337                         real :: rh_thres = 0.75
             338                         real :: rhc_cevap = 0.85 ! cloud water
             339                         real :: rhc_revap = 0.85 ! rain
             340                     
             341                         real :: f_dq_p = 1.0
             342                         real :: f_dq_m = 1.0
             343                         logical :: do_cld_adj = .false.
             344                     
             345                         integer :: inflag = 1 ! ice nucleation scheme
             346                         ! 1: hong et al., 2004
             347                         ! 2: meyers et al., 1992
             348                         ! 3: meyers et al., 1992
             349                         ! 4: cooper, 1986
             350                         ! 5: flecther, 1962
             351                     
             352                         integer :: rewflag = 1
             353                         ! 1: martin et al., 1994
             354                         ! 2: martin et al., 1994, gfdl revision
             355                         ! 3: kiehl et al., 1994
             356                     
             357                         integer :: reiflag = 5
             358                         ! 1: heymsfield and mcfarquhar, 1996
             359                         ! 2: donner et al., 1997
             360                         ! 3: fu, 2007
             361                         ! 4: kristjansson et al., 2000
             362                         ! 5: wyser, 1998
             363                         ! 6: Heymsfield et al.,2014  !not finished (by xb141)
             364                     
             365                         integer :: ccnflag = 1
             366                         ! 1: default in GFDL MP v2
             367                         ! 2: same as use_ccn=f in GFDL MP v1, ccn=ccn0/den
             368                         ! 3: same as use_ccn=t in GFDL MP v1, ccn=ccn0/densfc
             369                         ! -----------------------------------------------------------------------
             370                         ! namelist
             371                         ! -----------------------------------------------------------------------
             372                     
             373                         namelist / gfdl_mp_nml / &
             374                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             375                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             376                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             377                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             378                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             379                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             380                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             381                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             382                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             383                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             384                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             385                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             386                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &
             387                             rh_thres, f_dq_p, f_dq_m, do_cld_adj
             388                     
             389                         public &
             390                             t_min, t_sub, tau_r2g, tau_smlt, tau_g2r, dw_land, dw_ocean, &
             391                             vi_fac, vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vi_max, &
             392                             vs_max, vg_max, vr_max, qs_mlt, qs0_crt, qi_gen, ql0_max, qi0_max, &
             393                             qi0_crt, do_sat_adj, rh_inc, rh_ins, rh_inr, const_vi, &
             394                             const_vs, const_vg, const_vr, use_ccn, rthresh, ccn_l, ccn_o, qc_crt, &
             395                             tau_g2v, tau_v2g, sat_adj0, tau_imlt, tau_v2l, tau_l2v, &
             396                             tau_i2s, tau_l2r, qi_lim, ql_gen, c_paut, c_psaci, c_pgacs, &
             397                             z_slope_liq, z_slope_ice, prog_ccn, c_cracw, alin, clin, tice, &
             398                             rad_snow, rad_graupel, rad_rain, cld_fac, cld_min, use_ppm, use_ppm_ice, mono_prof, &
             399                             do_sedi_heat, sedi_transport, do_sedi_w, icloud_f, irain_f, &
             400                             ntimes, disp_heat, do_hail, use_xr_cloud, xr_a, xr_b, xr_c, tau_revp, tice_mlt, hd_icefall, &
             401                             do_cond_timescale, mp_time, consv_checker, te_err, use_park_cloud, &
             402                             use_gi_cloud, use_rhc_cevap, use_rhc_revap, inflag, do_warm_rain_mp, &

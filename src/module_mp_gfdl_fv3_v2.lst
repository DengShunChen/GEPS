                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            4712     1  pp    v          do i = 1, 1221
            4713     1   p    v              tem = 253.16 + delt * real (i - 1)
            4714     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4715     1   p    v              fac1 = fac0 * lv0
            4716     1   p    v              fac2 = (dc_vap * log (tem / t_ice) + fac1) / rvgas
            4717     1   p    v              esh20 = e00 * exp (fac2)
            4718     2   p    v              if (i <= 200) then
            4719     2   p    v                  esupc (i) = esh20
            4720     2   p    v              else
            4721     2   p    v                  table (i + 1400) = esh20
            4722     2   p    v              endif
            4723     1   p    v          enddo
            4724                     
            4725                         ! -----------------------------------------------------------------------
            4726                         ! derive blended es over ice and supercooled water between - 20 deg c and 0 deg c
            4727                         ! -----------------------------------------------------------------------
            4728                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]

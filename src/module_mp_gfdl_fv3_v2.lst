            1141                     subroutine sedi_heat (ks, ke, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            1142                         ! revised with a precise energy conserving form: s. - j. lin, jan 22, 2018
            1143                         ! input q fields are dry mixing ratios, and dm is dry air mass
            1144                         implicit none
            1145                         integer, intent (in) :: ks, ke
            1146                         real, intent (in), dimension (ks:ke) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            1147                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1148                         real, intent (in) :: cw ! heat capacity
            1149                         ! local:
            1150                         real, dimension (ks:ke) :: dgz, cv0

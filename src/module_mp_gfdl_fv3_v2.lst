            3166                     ! =======================================================================
            3167                     ! time - implicit monotonic scheme
            3168                     ! developed by sj lin, 2016
            3169                     ! =======================================================================
            3170                     
            3171                     subroutine implicit_fall (dt, ks, ke, ze, vt, dp, q, precip, m1)
            3172                     
            3173                         implicit none
            3174                     
            3175                         integer, intent (in) :: ks, ke
            3176                         real, intent (in) :: dt
            3177                         real, intent (in), dimension (ks:ke + 1) :: ze
            3178                         real, intent (in), dimension (ks:ke) :: vt, dp
            3179                         real, intent (inout), dimension (ks:ke) :: q
            3180                         real, intent (out), dimension (ks:ke) :: m1
            3181                         real, intent (out) :: precip
            3182                         real, dimension (ks:ke) :: dz, qm, dd
            3183                         integer :: k
            3184                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dp, vt, ze, dd, dz
                                   <<< Loop-information  End >>>
            3185     1  pp    v          do k = ks, ke
            3186     1   p    v              dz (k) = ze (k) - ze (k + 1)
            3187     1   p    v              dd (k) = dt * vt (k)
            3188     1   p    v              q (k) = q (k) * dp (k)
            3189     1   p    v          enddo
            3190                     
            3191                         ! -----------------------------------------------------------------------
            3192                         ! sedimentation: non - vectorizable loop
            3193                         ! -----------------------------------------------------------------------
            3194                     
            3195                         qm (ks) = q (ks) / (dz (ks) + dd (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.19, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qm, dz, dd, q
                                   <<< Loop-information  End >>>
            3196     1   s   2s          do k = ks + 1, ke
            3197     1   m   2m              qm (k) = (q (k) + dd (k - 1) * qm (k - 1)) / (dz (k) + dd (k))
            3198     1   p   2v          enddo
            3199                     
            3200                         ! -----------------------------------------------------------------------
            3201                         ! qm is density at this stage
            3202                         ! -----------------------------------------------------------------------
            3203                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qm
                                   <<< Loop-information  End >>>
            3204     1  pp   2v          do k = ks, ke
            3205     1   p   2v              qm (k) = qm (k) * dz (k)
            3206     1   p   2v          enddo
            3207                     
            3208                         ! -----------------------------------------------------------------------
            3209                         ! output mass fluxes: non - vectorizable loop
            3210                         ! -----------------------------------------------------------------------
            3211                     
            3212                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3213     1   s   2s          do k = ks + 1, ke
            3214     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3215     1   p   2v          enddo
            3216                         precip = m1 (ke)
            3217                     
            3218                         ! -----------------------------------------------------------------------
            3219                         ! update:
            3220                         ! -----------------------------------------------------------------------
            3221                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3222     1  pp   2v          do k = ks, ke
            3223     1   p   2v              q (k) = qm (k) / dp (k) !dry dp used inside MP
            3224     1   p   2v          enddo
            3225                     
            3226                     end subroutine implicit_fall
            3227                     
            3228                     ! =======================================================================
            3229                     ! lagrangian scheme
            3230                     ! developed by sj lin, around 2006
            3231                     ! =======================================================================
            3232                     
            3233                     subroutine lagrangian_fall_ppm (ks, ke, zs, ze, zt, dp, q, precip, m1, mono)
            3234                     
            3235                         implicit none
            3236                     
            3237                         integer, intent (in) :: ks, ke
            3238                         real, intent (in) :: zs
            3239                         logical, intent (in) :: mono
            3240                         real, intent (in), dimension (ks:ke + 1) :: ze, zt
            3241                         real, intent (in), dimension (ks:ke) :: dp
            3242                     
            3243                         ! m1: flux
            3244                         real, intent (inout), dimension (ks:ke) :: q, m1
            3245                         real, intent (out) :: precip
            3246                         real, dimension (ks:ke) :: qm, dz
            3247                     
            3248                         real :: a4 (4, ks:ke)
            3249                         real :: pl, pr, delz, esl
            3250                         integer :: k, k0, n, m
            3251                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            3252                     
            3253                         ! -----------------------------------------------------------------------
            3254                         ! density:
            3255                         ! -----------------------------------------------------------------------
            3256                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            3257     1  pp    v          do k = ks, ke
            3258     1   p    v              dz (k) = zt (k) - zt (k + 1) ! note: dz is positive
            3259     1   p    v              q (k) = q (k) * dp (k)
            3260     1   p    v              a4 (1, k) = q (k) / dz (k)
            3261     1   p    v              qm (k) = 0.
            3262     1   p    v          enddo
            3263                     
            3264                         ! -----------------------------------------------------------------------
            3265                         ! construct vertical profile with zt as coordinate
            3266                         ! -----------------------------------------------------------------------
            3267                     
            3268                         call cs_profile (a4 (1, ks), dz (ks), ke - ks + 1, mono)
            3269                     
            3270                         k0 = ks
            3271     1                   do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3272     2                       do n = k0, ke
            3273     3                           if (ze (k) <= zt (n) .and. ze (k) >= zt (n + 1)) then
            3274     3                               pl = (zt (n) - ze (k)) / dz (n)
            3275     4                               if (zt (n + 1) <= ze (k + 1)) then
            3276     4                                   ! entire new grid is within the original grid
            3277     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            3278     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            3279     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            3280     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            3281     4                                   k0 = n
            3282     4                                   goto 555
            3283     4                               else
            3284     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            3285     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            3286     5                                   if (n < ke) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            3287     6                                       do m = n + 1, ke
            3288     6                                           ! locate the bottom edge: ze (k + 1)
            3289     7                                           if (ze (k + 1) < zt (m + 1)) then
            3290     7                                               qm (k) = qm (k) + q (m)
            3291     7                                           else
            3292     7                                               delz = zt (m) - ze (k + 1)
            3293     7                                               esl = delz / dz (m)
            3294     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            3295     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            3296     7                                               k0 = m
            3297     7                                               goto 555
            3298     7                                           endif
            3299     6                                       enddo
            3300     5                                   endif
            3301     4                                   goto 555
            3302     4                               endif
            3303     3                           endif
            3304     2                       enddo
            3305     1                       555 continue
            3306     1                   enddo
            3307                     
            3308                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            3309     1   s   2s          do k = ks + 1, ke
            3310     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            3311     1   p   2v          enddo
            3312                         precip = m1 (ke)
            3313                     
            3314                         ! convert back to * dry * mixing ratio:
            3315                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            3316                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            3317     1  pp   2v          do k = ks, ke
            3318     1   p   2v              q (k) = qm (k) / dp (k)
            3319     1   p   2v          enddo
            3320                     
            3321                     end subroutine lagrangian_fall_ppm
            3322                     
            3323                     subroutine cs_profile (a4, del, km, do_mono)
            3324                     
            3325                         implicit none
            3326                     
            3327                         integer, intent (in) :: km ! vertical dimension
            3328                         real, intent (in) :: del (km)
            3329                         logical, intent (in) :: do_mono
            3330                         real, intent (inout) :: a4 (4, km)
            3331                         real, parameter :: qp_min = 1.e-6
            3332                         real :: gam (km)
            3333                         real :: q (km + 1)
            3334                         real :: d4, bet, a_bot, grat, pmp, lac
            3335                         real :: pmp_1, lac_1, pmp_2, lac_2
            3336                         real :: da1, da2, a6da
            3337                     
            3338                         integer :: k
            3339                     
            3340                         logical extm (km)
            3341                     
            3342                         grat = del (2) / del (1) ! grid ratio
            3343                         bet = grat * (grat + 0.5)
            3344                         q (1) = (2. * grat * (grat + 1.) * a4 (1, 1) + a4 (1, 2)) / bet
            3345                         gam (1) = (1. + grat * (grat + 1.5)) / bet
            3346                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 10, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, q, gam, del
                                   <<< Loop-information  End >>>
            3347     1   s   2s          do k = 2, km
            3348     1   p   2v              d4 = del (k - 1) / del (k)
            3349     1   m   2m              bet = 2. + 2. * d4 - gam (k - 1)
            3350     1   m   2m              q (k) = (3. * (a4 (1, k - 1) + d4 * a4 (1, k)) - q (k - 1)) / bet
            3351     1   s   2s              gam (k) = d4 / bet
            3352     1   p   2v          enddo
            3353                     
            3354                         a_bot = 1. + d4 * (d4 + 1.5)
            3355                         q (km + 1) = (2. * d4 * (d4 + 1.) * a4 (1, km) + a4 (1, km - 1) - a_bot * q (km)) &
            3356                              / (d4 * (d4 + 0.5) - a_bot * gam (km))
            3357                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, q
                                   <<< Loop-information  End >>>
            3358     1   s   2s          do k = km, 1, - 1
            3359     1   s   2s              q (k) = q (k) - gam (k) * q (k + 1)
            3360     1   s   2s          enddo
            3361                     
            3362                         ! -----------------------------------------------------------------------
            3363                         ! apply constraints
            3364                         ! -----------------------------------------------------------------------
            3365                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam
                                   <<< Loop-information  End >>>
            3366     1  pp   2v          do k = 2, km
            3367     1   p   2v              gam (k) = a4 (1, k) - a4 (1, k - 1)
            3368     1   p   2v          enddo
            3369                     
            3370                         ! -----------------------------------------------------------------------
            3371                         ! apply large - scale constraints to all fields if not local max / min
            3372                         ! -----------------------------------------------------------------------
            3373                     
            3374                         ! -----------------------------------------------------------------------
            3375                         ! top:
            3376                         ! -----------------------------------------------------------------------
            3377                     
            3378                         q (1) = max (q (1), 0.)
            3379                         q (2) = min (q (2), max (a4 (1, 1), a4 (1, 2)))
            3380                         q (2) = max (q (2), min (a4 (1, 1), a4 (1, 2)), 0.)
            3381                     
            3382                         ! -----------------------------------------------------------------------
            3383                         ! interior:
            3384                         ! -----------------------------------------------------------------------
            3385                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 127
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.62, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, q
                                   <<< Loop-information  End >>>
            3386     1  pp    v          do k = 3, km - 1
            3387     2   p    v              if (gam (k - 1) * gam (k + 1) > 0.) then
            3388     2   p    v                  q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3389     2   p    v                  q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3390     2   p    v              else
            3391     3   p    v                  if (gam (k - 1) > 0.) then
            3392     3                               ! there exists a local max
            3393     3   p    v                      q (k) = max (q (k), min (a4 (1, k - 1), a4 (1, k)))
            3394     3   p    v                  else
            3395     3                               ! there exists a local min
            3396     3   p    v                      q (k) = min (q (k), max (a4 (1, k - 1), a4 (1, k)))
            3397     3   p    v                      q (k) = max (q (k), 0.0)
            3398     3   p    v                  endif
            3399     2   p    v              endif
            3400     1   p    v          enddo
            3401                     
            3402                         ! -----------------------------------------------------------------------
            3403                         ! bottom :
            3404                         ! -----------------------------------------------------------------------
            3405                     
            3406                         q (km) = min (q (km), max (a4 (1, km - 1), a4 (1, km)))
            3407                         q (km) = max (q (km), min (a4 (1, km - 1), a4 (1, km)), 0.)
            3408                         ! q (km + 1) = max (q (km + 1), 0.)
            3409                     
            3410                         ! -----------------------------------------------------------------------
            3411                         ! f (s) = al + s * [ (ar - al) + a6 * (1 - s) ] (0 <= s <= 1)
            3412                         ! -----------------------------------------------------------------------
            3413                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, a4
                                   <<< Loop-information  End >>>
            3414     1  pp   2v          do k = 1, km - 1
            3415     1   p   2v              a4 (2, k) = q (k)
            3416     1   p   2v              a4 (3, k) = q (k + 1)
            3417     1   p   2v          enddo
            3418                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.40, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gam, extm
                                   <<< Loop-information  End >>>
            3419     1  pp   2v          do k = 2, km - 1
            3420     2   p   2v              if (gam (k) * gam (k + 1) > 0.0) then
            3421     2   p   2v                  extm (k) = .false.
            3422     2   p   2v              else
            3423     2   p   2v                  extm (k) = .true.
            3424     2   p   2v              endif
            3425     1   p   2v          enddo
            3426                     
            3427     1                   if (do_mono) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 88
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.98, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, gam, extm
                                   <<< Loop-information  End >>>
            3428     2  pp    v              do k = 3, km - 2
            3429     3   p    v                  if (extm (k)) then
            3430     3                               ! positive definite constraint only if true local extrema
            3431     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3432     4   p    v                          a4 (2, k) = a4 (1, k)
            3433     4   p    v                          a4 (3, k) = a4 (1, k)
            3434     4   p    v                      endif
            3435     3   p    v                  else
            3436     3   p    v                      a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3437     4   p    v                      if (abs (a4 (4, k)) > abs (a4 (2, k) - a4 (3, k))) then
            3438     4                                   ! check within the smooth region if subgrid profile is non - monotonic
            3439     4   p    v                          pmp_1 = a4 (1, k) - 2.0 * gam (k + 1)
            3440     4   p    v                          lac_1 = pmp_1 + 1.5 * gam (k + 2)
            3441     4   p    v                          a4 (2, k) = min (max (a4 (2, k), min (a4 (1, k), pmp_1, lac_1)), &
            3442     4                                       max (a4 (1, k), pmp_1, lac_1))
            3443     4   p    v                          pmp_2 = a4 (1, k) + 2.0 * gam (k)
            3444     4   p    v                          lac_2 = pmp_2 - 1.5 * gam (k - 1)
            3445     4   p    v                          a4 (3, k) = min (max (a4 (3, k), min (a4 (1, k), pmp_2, lac_2)), &
            3446     4                                       max (a4 (1, k), pmp_2, lac_2))
            3447     4   p    v                      endif
            3448     3   p    v                  endif
            3449     2   p    v              enddo
            3450     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      extm, a4
                                   <<< Loop-information  End >>>
            3451     2  pp    v              do k = 3, km - 2
            3452     3   p    v                  if (extm (k)) then
            3453     4   p    v                      if (a4 (1, k) < qp_min .or. extm (k - 1) .or. extm (k + 1)) then
            3454     4   p    v                          a4 (2, k) = a4 (1, k)
            3455     4   p    v                          a4 (3, k) = a4 (1, k)
            3456     4   p    v                      endif
            3457     3   p    v                  endif
            3458     2   p    v              enddo
            3459     1                   endif
            3460                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 192, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3461     1  pp   2v          do k = 1, km - 1
            3462     1   p   2v              a4 (4, k) = 6. * a4 (1, k) - 3. * (a4 (2, k) + a4 (3, k))
            3463     1   p   2v          enddo
            3464                     
            3465                         k = km - 1
            3466     1                   if (extm (k)) then
            3467     1                       a4 (2, k) = a4 (1, k)
            3468     1                       a4 (3, k) = a4 (1, k)
            3469     1                       a4 (4, k) = 0.
            3470     1                   else
            3471     1                       da1 = a4 (3, k) - a4 (2, k)
            3472     1                       da2 = da1 ** 2
            3473     1                       a6da = a4 (4, k) * da1
            3474     2                       if (a6da < - da2) then
            3475     2                           a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3476     2                           a4 (3, k) = a4 (2, k) - a4 (4, k)
            3477     2                       elseif (a6da > da2) then
            3478     2                           a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3479     2                           a4 (2, k) = a4 (3, k) - a4 (4, k)
            3480     2                       endif
            3481     1                   endif
            3482                     
            3483                         call cs_limiters (km - 1, a4)
            3484                     
            3485                         ! -----------------------------------------------------------------------
            3486                         ! bottom layer:
            3487                         ! -----------------------------------------------------------------------
            3488                     
            3489                         a4 (2, km) = a4 (1, km)
            3490                         a4 (3, km) = a4 (1, km)
            3491                         a4 (4, km) = 0.
            3492                     
            3493                     end subroutine cs_profile
            3494                     
            3495                     subroutine cs_limiters (km, a4)
            3496                     
            3497                         implicit none
            3498                     
            3499                         integer, intent (in) :: km
            3500                     
            3501                         real, intent (inout) :: a4 (4, km) ! ppm array
            3502                     
            3503                         real, parameter :: r12 = 1. / 12.
            3504                     
            3505                         integer :: k
            3506                     
            3507                         ! -----------------------------------------------------------------------
            3508                         ! positive definite constraint
            3509                         ! -----------------------------------------------------------------------
            3510                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 259
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.59, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4
                                   <<< Loop-information  End >>>
            3511     1  pp    v          do k = 1, km
            3512     2   p    v              if (abs (a4 (3, k) - a4 (2, k)) < - a4 (4, k)) then
            3513     3   p    v                  if ((a4 (1, k) + 0.25 * (a4 (3, k) - a4 (2, k)) ** 2 / a4 (4, k) + a4 (4, k) * r12) < 0.) then
            3514     4   p    v                      if (a4 (1, k) < a4 (3, k) .and. a4 (1, k) < a4 (2, k)) then
            3515     4   p    v                          a4 (3, k) = a4 (1, k)
            3516     4   p    v                          a4 (2, k) = a4 (1, k)
            3517     4   p    v                          a4 (4, k) = 0.
            3518     4   p    v                      elseif (a4 (3, k) > a4 (2, k)) then
            3519     4   p    v                          a4 (4, k) = 3. * (a4 (2, k) - a4 (1, k))
            3520     4   p    v                          a4 (3, k) = a4 (2, k) - a4 (4, k)
            3521     4   p    v                      else
            3522     4   p    v                          a4 (4, k) = 3. * (a4 (3, k) - a4 (1, k))
            3523     4   p    v                          a4 (2, k) = a4 (3, k) - a4 (4, k)
            3524     4   p    v                      endif
            3525     3   p    v                  endif
            3526     2   p    v              endif
            3527     1   p    v          enddo
            3528                     
            3529                     end subroutine cs_limiters
            3530                     
            3531                     ! =======================================================================
            3532                     ! calculation of vertical fall speed
            3533                     ! =======================================================================
            3534                     
            3535                     subroutine fall_speed (ks, ke, den, qs, qi, qg, ql, tk, vts, vti, vtg)
            3536                     
            3537                         implicit none
            3538                     
            3539                         integer, intent (in) :: ks, ke
            3540                     
            3541                         real (kind = r8), intent (in), dimension (ks:ke) :: tk
            3542                         real, intent (in), dimension (ks:ke) :: den, qs, qi, qg, ql
            3543                         real, intent (out), dimension (ks:ke) :: vts, vti, vtg
            3544                     
            3545                         ! fall velocity constants:
            3546                     
            3547                         real, parameter :: thi = 1.0e-8 ! cloud ice threshold for terminal fall
            3548                         real, parameter :: thg = 1.0e-8
            3549                         real, parameter :: ths = 1.0e-8
            3550                     
            3551                         real, parameter :: aa = - 4.14122e-5
            3552                         real, parameter :: bb = - 0.00538922
            3553                         real, parameter :: cc = - 0.0516344
            3554                         real, parameter :: dd = 0.00216078
            3555                         real, parameter :: ee = 1.9714
            3556                     
            3557                         ! marshall - palmer constants
            3558                     
            3559                         real, parameter :: vcons = 6.6280504
            3560                         real, parameter :: vcong = 87.2382675
            3561                         real, parameter :: vconh = vcong * sqrt (rhoh / rhog) ! 132.087495104005
            3562                         real, parameter :: norms = 942477796.076938
            3563                         real, parameter :: normg = 5026548245.74367
            3564                         real, parameter :: normh = pi * rhoh * rnzh ! 115233618.533674
            3565                     
            3566                         real, dimension (ks:ke) :: qden, tc, rhof
            3567                     
            3568                         real :: vi0
            3569                         real :: y1, y2, r00, fv
            3570                     
            3571                         integer :: k
            3572                     
            3573                         ! -----------------------------------------------------------------------
            3574                         ! marshall - palmer formula
            3575                         ! -----------------------------------------------------------------------
            3576                     
            3577                         ! -----------------------------------------------------------------------
            3578                         ! try the local air density -- for global model; the true value could be
            3579                         ! much smaller than sfcrho over high mountains
            3580                         ! -----------------------------------------------------------------------
            3581                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.17, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, rhof
                                   <<< Loop-information  End >>>
            3582     1  pp   2v          do k = ks, ke
            3583     1   p   2v              rhof (k) = sqrt (min (10., sfcrho / den (k)))
            3584     1   p   2v          enddo
            3585                     
            3586                         ! -----------------------------------------------------------------------
            3587                         ! ice:
            3588                         ! -----------------------------------------------------------------------
            3589                     
            3590     1                   if (const_vi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vti
                                   <<< Loop-information  End >>>
            3591     1  pp   4v              vti (:) = vi_fac
            3592     1                   else
            3593     1                       ! -----------------------------------------------------------------------
            3594     1                       ! use deng and mace (2008, grl), which gives smaller fall speed than hd90 formula
            3595     1                       ! -----------------------------------------------------------------------
            3596     1                       vi0 = 0.01 * vi_fac
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, vti
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3597     2   s    s              do k = ks, ke
            3598     3   p    v                  if (qi (k) < thi) then ! this is needed as the fall - speed maybe problematic for small qi
            3599     3   m    m                      vti (k) = vf_min
            3600     3   p    v                  else
            3601     3   s    s                      tc (k) = tk (k) - tice
            3602     4   m    m                      if (hd_icefall) then
            3603     4                                   ! heymsfield and donner, 1990, jas
            3604     4   m    m                          vti (k) = vi_fac * 3.29 * (qi (k) * den (k)) ** 0.16
            3605     4   m    m                      elseif (gce_icefall) then
            3606     4                                   ! new codes from Steve's in cgs, module_mp_gsfcgce_4ice_nuwrf.f90
            3607     4   s    s                          vti (k) = 0.
            3608     4   s    s                          y1 = qi (k) * den (k) * 1000.   ! g/cm^3
            3609     5   s    s                          if (y1 .ge. 1.e-6) then
            3610     5   s    s                              y1 = qi (k)
            3611     5   s    s                              y2 = ql (k)
            3612     5   s    s                              r00 = den (k) / 1000.  !g/cm^3
            3613     5   s    s                              fv = sqrt (1.29 / ( den(k) * 1000.))
            3614     5   s    s                              call vqrqi (2, r00, fv, y1, y2, tk (k), vti (k))
            3615     5   s    s                          endif
            3616     4   m    m                          vti (k) = vti (k) * 0.01  !convert back to m/s
            3617     4   s    s                      else
            3618     4                                   ! deng and mace, 2008, grl
            3619     4   s    s                          vti (k) = (3. + log10 (qi (k) * den (k))) * (tc (k) * (aa * tc (k) + bb) + cc) + dd * tc (k) + ee
            3620     4   m    m                          vti (k) = vi0 * exp (log_10 * vti (k))
            3621     4   p    v                      endif
            3622     3   m    s                      vti (k) = min (vi_max, max (vf_min, vti (k)))
            3623     3   p    v                  endif
            3624     2   p    v              enddo
            3625     1                   endif
            3626                     
            3627                         ! -----------------------------------------------------------------------
            3628                         ! snow:
            3629                         ! -----------------------------------------------------------------------
            3630                     
            3631     1                   if (const_vs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vts
                                   <<< Loop-information  End >>>
            3632     1  pp   4v              vts (:) = vs_fac ! 1. ifs_2016
            3633     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, den, rhof, vts
                                   <<< Loop-information  End >>>
            3634     2  pp    v              do k = ks, ke
            3635     3   p    v                  if (qs (k) < ths) then
            3636     3   p    v                      vts (k) = vf_min
            3637     3   p    v                  else
            3638     3   p    v                      vts (k) = vs_fac * vcons * rhof (k) * exp (0.0625 * log (qs (k) * den (k) / norms))
            3639     3   p    v                      vts (k) = min (vs_max, max (vf_min, vts (k)))
            3640     3   p    v                  endif
            3641     2   p    v              enddo
            3642     1                   endif
            3643                     
            3644                         ! -----------------------------------------------------------------------
            3645                         ! graupel:
            3646                         ! -----------------------------------------------------------------------
            3647                     
            3648     1                   if (const_vg) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtg
                                   <<< Loop-information  End >>>
            3649     1  pp   4v              vtg (:) = vg_fac ! 2.
            3650     1                   else
            3651     2                       if (do_hail) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3652     3  pp    v                  do k = ks, ke
            3653     4   p    v                      if (qg (k) < thg) then
            3654     4   p    v                          vtg (k) = vf_min
            3655     4   p    v                      else
            3656     4   p    v                          vtg (k) = vg_fac * vconh * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normh)))
            3657     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3658     4   p    v                      endif
            3659     3   p    v                  enddo
            3660     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 320
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhof, qg, den, vtg
                                   <<< Loop-information  End >>>
            3661     3  pp    v                  do k = ks, ke
            3662     4   p    v                      if (qg (k) < thg) then
            3663     4   p    v                          vtg (k) = vf_min
            3664     4   p    v                      else
            3665     4   p    v                          vtg (k) = vg_fac * vcong * rhof (k) * sqrt (sqrt (sqrt (qg (k) * den (k) / normg)))
            3666     4   p    v                          vtg (k) = min (vg_max, max (vf_min, vtg (k)))
            3667     4   p    v                      endif
            3668     3   p    v                  enddo
            3669     2                       endif
            3670     1                   endif
            3671                     
            3672                     end subroutine fall_speed
            3673                     
            3674                     ! =======================================================================
            3675                     ! setup gfdl cloud microphysics parameters
            3676                     ! =======================================================================
            3677                     
            3678                     subroutine setupm
            3679                     
            3680                         implicit none
            3681                     
            3682                         real :: gcon, cd, scm3, pisq, act (8)
            3683                         real :: vdifu, tcond
            3684                         real :: visk
            3685                         real :: ch2o, hltf
            3686                         real :: hlts, hltc, ri50
            3687                     
            3688                         real, parameter :: gam263 = 1.456943, gam275 = 1.608355, gam290 = 1.827363, &
            3689                             gam325 = 2.54925, gam350 = 3.323363, gam380 = 4.694155, &
            3690                             gam425 = 8.285063, gam450 = 11.631769, gam480 = 17.837789, &
            3691                             gam625 = 184.860962, gam680 = 496.604067
            3692                     
            3693                         real, parameter :: acc (3) = (/ 5.0, 2.0, 0.5 /)
            3694                     
            3695                         real den_rc
            3696                     
            3697                         integer :: i, k
            3698                     
            3699                         pie = 4. * atan (1.0)
            3700                     
            3701                         ! s. klein's formular (eq 16) from am2
            3702                     
            3703                         fac_rc = (4. / 3.) * pie * rhor * rthresh ** 3
            3704                     
            3705     1                   if (prog_ccn) then
            3706     1                       ! if (master) write (*, *) 'prog_ccn option is .t.'
            3707     1                   else
            3708     1                       den_rc = fac_rc * ccn_o * 1.e6
            3709     1                       ! if (master) write (*, *) 'mp: for ccn_o = ', ccn_o, 'ql_rc = ', den_rc
            3710     1                       den_rc = fac_rc * ccn_l * 1.e6
            3711     1                       ! if (master) write (*, *) 'mp: for ccn_l = ', ccn_l, 'ql_rc = ', den_rc
            3712     1                   endif
            3713                     
            3714                         vdifu = 2.11e-5
            3715                         tcond = 2.36e-2
            3716                     
            3717                         visk = 1.259e-5
            3718                         hlts = hlv + hlf
            3719                         hltc = hlv
            3720                         hltf = hlf
            3721                     
            3722                         ch2o = c_liq
            3723                         ri50 = 1.e-4
            3724                     
            3725                         pisq = pie * pie
            3726                         scm3 = (visk / vdifu) ** (1. / 3.)
            3727                     
            3728                         cracs = pisq * rnzr * rnzs * rhos
            3729                         csacr = pisq * rnzr * rnzs * rhor
            3730     1                   if (do_hail) then
            3731     1                       cgacr = pisq * rnzr * rnzh * rhor
            3732     1                       cgacs = pisq * rnzh * rnzs * rhos
            3733     1                   else
            3734     1                       cgacr = pisq * rnzr * rnzg * rhor
            3735     1                       cgacs = pisq * rnzg * rnzs * rhos
            3736     1                   endif
            3737                         cgacs = cgacs * c_pgacs
            3738                     
            3739                         ! act: 1 - 2:racs (s - r) ; 3 - 4:sacr (r - s) ;
            3740                         ! 5 - 6:gacr (r - g) ; 7 - 8:gacs (s - g)
            3741                     
            3742                         act (1) = pie * rnzs * rhos
            3743                         act (2) = pie * rnzr * rhor
            3744     1                   if (do_hail) then
            3745     1                       act (6) = pie * rnzh * rhoh
            3746     1                   else
            3747     1                       act (6) = pie * rnzg * rhog
            3748     1                   endif
            3749                         act (3) = act (2)
            3750                         act (4) = act (1)
            3751                         act (5) = act (2)
            3752                         act (7) = act (1)
            3753                         act (8) = act (6)
            3754                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 4)
                                   <<< Loop-information  End >>>
            3755     1   s    v          do i = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3756     2   p   fv              do k = 1, 4
            3757     2   p   fv                  acco (i, k) = acc (i) / (act (2 * k - 1) ** ((7 - i) * 0.25) * act (2 * k) ** (i * 0.25))
            3758     2   p   fv              enddo
            3759     1   p    v          enddo
            3760                     
            3761                         gcon = 40.74 * sqrt (sfcrho) ! 44.628
            3762                     
            3763                         csacw = pie * rnzs * clin * gam325 / (4. * act (1) ** 0.8125)
            3764                         ! decreasing csacw to reduce cloud water --- > snow
            3765                     
            3766                         craci = pie * rnzr * alin * gam380 / (4. * act (2) ** 0.95)
            3767                         csaci = csacw * c_psaci
            3768                     
            3769     1                   if (do_hail) then
            3770     1                       cgacw = pie * rnzh * gam350 * gcon / (4. * act (6) ** 0.875)
            3771     1                   else
            3772     1                       cgacw = pie * rnzg * gam350 * gcon / (4. * act (6) ** 0.875)
            3773     1                   endif
            3774                         ! cgaci = cgacw * 0.1
            3775                     
            3776                         ! sjl, may 28, 2012
            3777                         cgaci = cgacw * 0.05
            3778                         ! sjl, may 28, 2012
            3779                     
            3780                         cracw = craci ! cracw = 3.27206196043822
            3781                         cracw = c_cracw * cracw
            3782                     
            3783                         ! subl and revp: five constants for three separate processes
            3784                     
            3785                         cssub (1) = 2. * pie * vdifu * tcond * rvgas * rnzs
            3786     1                   if (do_hail) then
            3787     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzh
            3788     1                   else
            3789     1                       cgsub (1) = 2. * pie * vdifu * tcond * rvgas * rnzg
            3790     1                   endif
            3791                         crevp (1) = 2. * pie * vdifu * tcond * rvgas * rnzr
            3792                         cssub (2) = 0.78 / sqrt (act (1))
            3793                         cgsub (2) = 0.78 / sqrt (act (6))
            3794                         crevp (2) = 0.78 / sqrt (act (2))
            3795                         cssub (3) = 0.31 * scm3 * gam263 * sqrt (clin / visk) / act (1) ** 0.65625
            3796                         cgsub (3) = 0.31 * scm3 * gam275 * sqrt (gcon / visk) / act (6) ** 0.6875
            3797                         crevp (3) = 0.31 * scm3 * gam290 * sqrt (alin / visk) / act (2) ** 0.725
            3798                         cssub (4) = tcond * rvgas
            3799                         cssub (5) = hlts ** 2 * vdifu
            3800                         cgsub (4) = cssub (4)
            3801                         crevp (4) = cssub (4)
            3802                         cgsub (5) = cssub (5)
            3803                         crevp (5) = hltc ** 2 * vdifu
            3804                     
            3805                         cgfr (1) = 20.e2 * pisq * rnzr * rhor / act (2) ** 1.75
            3806                         cgfr (2) = 0.66
            3807                     
            3808                         ! smlt: five constants (lin et al. 1983)
            3809                     
            3810                         csmlt (1) = 2. * pie * tcond * rnzs / hltf
            3811                         csmlt (2) = 2. * pie * vdifu * rnzs * hltc / hltf
            3812                         csmlt (3) = cssub (2)
            3813                         csmlt (4) = cssub (3)
            3814                         csmlt (5) = ch2o / hltf
            3815                     
            3816                         ! gmlt: five constants
            3817                     
            3818     1                   if (do_hail) then
            3819     1                       cgmlt (1) = 2. * pie * tcond * rnzh / hltf
            3820     1                       cgmlt (2) = 2. * pie * vdifu * rnzh * hltc / hltf
            3821     1                   else
            3822     1                       cgmlt (1) = 2. * pie * tcond * rnzg / hltf
            3823     1                       cgmlt (2) = 2. * pie * vdifu * rnzg * hltc / hltf
            3824     1                   endif
            3825                         cgmlt (3) = cgsub (2)
            3826                         cgmlt (4) = cgsub (3)
            3827                         cgmlt (5) = ch2o / hltf
            3828                     
            3829                         es0 = e00
            3830                         ces0 = eps * es0
            3831                     
            3832                     end subroutine setupm
            3833                     

            3919                     
            3920                     subroutine setup_con
            3921                     
            3922                         implicit none
            3923                     
            3924                         ! master = (mpp_pe () .eq.mpp_root_pe ())
            3925                     
            3926                         if (.not. qsmith_tables_initialized) call qsmith_init
            3927                     
            3928                         qsmith_tables_initialized = .true.
            3929                     
            3930                     end subroutine setup_con
            3931                     
            3932                     ! =======================================================================
            3933                     ! accretion function (lin et al. 1983)
            3934                     ! =======================================================================
            3935                     
            3936                     real function acr3d (v1, v2, q1, q2, c, cac, rho)
            3937                     
            3938                         implicit none
            3939                     
            3940                         real, intent (in) :: v1, v2, c, rho
            3941                         real, intent (in) :: q1, q2 ! mixing ratio!!!
            3942                         real, intent (in) :: cac (3)
            3943                     
            3944                         real :: t1, s1, s2
            3945                     
            3946                         ! integer :: k
            3947                         !
            3948                         ! real :: a
            3949                         !
            3950                         ! a = 0.0
            3951                         ! do k = 1, 3
            3952                         ! a = a + cac (k) * ((q1 * rho) ** ((7 - k) * 0.25) * (q2 * rho) ** (k * 0.25))
            3953                         ! enddo
            3954                         ! acr3d = c * abs (v1 - v2) * a / rho
            3955                     
            3956                         ! optimized
            3957                     
            3958                         t1 = sqrt (q1 * rho)
            3959                         s1 = sqrt (q2 * rho)
            3960                         s2 = sqrt (s1) ! s1 = s2 ** 2
            3961                         acr3d = c * abs (v1 - v2) * q1 * s2 * (cac (1) * t1 + cac (2) * sqrt (t1) * s2 + cac (3) * s1)
            3962                     
            3963                     end function acr3d
            3964                     
            3965                     ! =======================================================================
            3966                     ! melting of snow function (lin et al. 1983)
            3967                     ! note: psacw and psacr must be calc before smlt is called
            3968                     ! =======================================================================
            3969                     
            3970                     real function smlt (tc, dqs, qsrho, psacw, psacr, c, rho, rhofac)
            3971                     
            3972                         implicit none
            3973                     
            3974                         real, intent (in) :: tc, dqs, qsrho, psacw, psacr, c (5), rho, rhofac
            3975                     
            3976                         smlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qsrho) + &
            3977                             c (4) * qsrho ** 0.65625 * sqrt (rhofac)) + c (5) * tc * (psacw + psacr)
            3978                     
            3979                     end function smlt
            3980                     
            3981                     ! =======================================================================
            3982                     ! melting of graupel function (lin et al. 1983)
            3983                     ! note: pgacw and pgacr must be calc before gmlt is called
            3984                     ! =======================================================================
            3985                     
            3986                     real function gmlt (tc, dqs, qgrho, pgacw, pgacr, c, rho)
            3987                     
            3988                         implicit none
            3989                     
            3990                         real, intent (in) :: tc, dqs, qgrho, pgacw, pgacr, c (5), rho
            3991                     
            3992                         gmlt = (c (1) * tc / rho - c (2) * dqs) * (c (3) * sqrt (qgrho) + &
            3993                             c (4) * qgrho ** 0.6875 / rho ** 0.25) + c (5) * tc * (pgacw + pgacr)
            3994                     
            3995                     end function gmlt
            3996                     
            3997                     ! =======================================================================
            3998                     ! initialization
            3999                     ! prepare saturation water vapor pressure tables
            4000                     ! =======================================================================
            4001                     
            4002                     subroutine qsmith_init
            4003                     
            4004                         implicit none
            4005                     
            4006                         integer, parameter :: length = 2621
            4007                     
            4008                         integer :: i
            4009                     
            4010     1                   if (.not. tables_are_initialized) then
            4011     1               
            4012     1                       allocate (table (length))
            4013     1                       allocate (table2 (length))
            4014     1                       allocate (table3 (length))
            4015     1                       allocate (tablew (length))
            4016     1                       allocate (des (length))
            4017     1                       allocate (des2 (length))
            4018     1                       allocate (des3 (length))
            4019     1                       allocate (desw (length))
            4020     1               
            4021     1                       call qs_table (length)
            4022     1                       call qs_table2 (length)
            4023     1                       call qs_table3 (length)
            4024     1    i                  call qs_tablew (length)
            4025     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 189
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.62, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table3, table2, table, tablew, des, des3
                                   <<<      desw, des2
                                   <<< Loop-information  End >>>
            4026     2  pp    v              do i = 1, length - 1
            4027     2   p    v                  des (i) = max (0., table (i + 1) - table (i))
            4028     2   p    v                  des2 (i) = max (0., table2 (i + 1) - table2 (i))
            4029     2   p    v                  des3 (i) = max (0., table3 (i + 1) - table3 (i))
            4030     2   p    v                  desw (i) = max (0., tablew (i + 1) - tablew (i))
            4031     2   p    v              enddo
            4032     1                       des (length) = des (length - 1)
            4033     1                       des2 (length) = des2 (length - 1)
            4034     1                       des3 (length) = des3 (length - 1)
            4035     1                       desw (length) = desw (length - 1)
            4036     1               
            4037     1                       tables_are_initialized = .true.
            4038     1               
            4039     1                   endif
            4040                     
            4041                     end subroutine qsmith_init
            4042                     
            4043                     ! =======================================================================
            4044                     ! compute the saturated specific humidity for table ii
            4045                     ! =======================================================================
            4046                     
            4047                     real function wqs1 (ta, den)
            4048                     
            4049                         implicit none
            4050                     
            4051                         ! pure water phase; universal dry / moist formular using air density
            4052                         ! input "den" can be either dry or moist air density
            4053                     
            4054                         real, intent (in) :: ta, den
            4055                     
            4056                         real :: es, ap1, tmin
            4057                     
            4058                         integer :: it
            4059                     
            4060                         tmin = table_ice - 160.
            4061                         ap1 = 10. * dim (ta, tmin) + 1.
            4062                         ap1 = min (2621., ap1)
            4063                         it = ap1
            4064                         es = tablew (it) + (ap1 - it) * desw (it)
            4065                         wqs1 = es / (rvgas * ta * den)
            4066                     
            4067                     end function wqs1
            4068                     
            4069                     ! =======================================================================
            4070                     ! compute the gradient of saturated specific humidity for table ii
            4071                     ! =======================================================================
            4072                     
            4073                     real function wqs2 (ta, den, dqdt)
            4074                     
            4075                         implicit none
            4076                     
            4077                         ! pure water phase; universal dry / moist formular using air density
            4078                         ! input "den" can be either dry or moist air density
            4079                     
            4080                         real, intent (in) :: ta, den
            4081                         real, intent (out) :: dqdt
            4082                         real :: es, ap1, tmin
            4083                         integer :: it
            4084                     
            4085                         tmin = table_ice - 160.
            4086                     
            4087                         if (.not. tables_are_initialized) call qsmith_init
            4088                     
            4089                         ap1 = 10. * dim (ta, tmin) + 1.
            4090                         ap1 = min (2621., ap1)
            4091                         it = ap1
            4092                         es = tablew (it) + (ap1 - it) * desw (it)
            4093                         wqs2 = es / (rvgas * ta * den)
            4094                         it = ap1 - 0.5
            4095                         ! finite diff, del_t = 0.1:
            4096                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            4097                     
            4098                     end function wqs2
            4099                     
            4100                     !xb141 >>>>>>
            4101                     ! =======================================================================
            4102                     ! compute the gradient of saturated specific humidity for table ii
            4103                     ! which is tuned by rhc
            4104                     ! =======================================================================
            4105                     real function wqs2_rhc (ta, den, rhc, dqdt)
            4106                     
            4107                         implicit none
            4108                     
            4109                         ! pure water phase; universal dry / moist formular using air density
            4110                         ! input "den" can be either dry or moist air density
            4111                     
            4112                         real, intent (in) :: ta, den, rhc
            4113                         real, intent (out) :: dqdt
            4114                         real :: es, ap1, tmin
            4115                         integer :: it
            4116                     
            4117                         tmin = table_ice - 160.
            4118                     
            4119                         if (.not. tables_are_initialized) call qsmith_init
            4120                     
            4121                         ap1 = 10. * dim (ta, tmin) + 1.
            4122                         ap1 = min (2621., ap1)
            4123                         it = ap1
            4124                         es = tablew (it) + (ap1 - it) * desw (it)
            4125                         wqs2_rhc = es / (rvgas * ta * den) * rhc
            4126                         it = ap1 - 0.5
            4127                         ! finite diff, del_t = 0.1:
            4128                         dqdt = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta * den)
            4129                     
            4130                     end function wqs2_rhc
            4131                     !xb141 <<<<<
            4132                     
            4133                     ! =======================================================================
            4134                     ! =======================================================================
            4135                     ! compute the gradient of saturated specific humidity for table ii
            4136                     ! it is the same as "wqs2", but written as vector function
            4137                     ! =======================================================================
            4138                     
            4139                     subroutine wqs2_vect (is, ie, ta, den, wqsat, dqdt)
            4140                     
            4141                         implicit none
            4142                     
            4143                         ! pure water phase; universal dry / moist formular using air density
            4144                         ! input "den" can be either dry or moist air density
            4145                     
            4146                         integer, intent (in) :: is, ie
            4147                     
            4148                         real, intent (in), dimension (is:ie) :: ta, den
            4149                     
            4150                         real, intent (out), dimension (is:ie) :: wqsat, dqdt
            4151                     
            4152                         real :: es, ap1, tmin
            4153                     
            4154                         integer :: i, it
            4155                     
            4156                         tmin = t_ice - 160.
            4157                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.90, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ta, den, wqsat, dqdt
                                   <<< Loop-information  End >>>
            4158     1  pp    v          do i = is, ie
            4159     1   p    v              ap1 = 10. * dim (ta (i), tmin) + 1.
            4160     1   p    v              ap1 = min (2621., ap1)
            4161     1   p    v              it = ap1
            4162     1   p    v              es = tablew (it) + (ap1 - it) * desw (it)
            4163     1   p    v              wqsat (i) = es / (rvgas * ta (i) * den (i))
            4164     1   p    v              it = ap1 - 0.5
            4165     1                       ! finite diff, del_t = 0.1:
            4166     1   p    v              dqdt (i) = 10. * (desw (it) + (ap1 - it) * (desw (it + 1) - desw (it))) / (rvgas * ta (i) * den (i))
            4167     1   p    v          enddo
            4168                     
            4169                     end subroutine wqs2_vect
            4170                     
            4171                     ! =======================================================================
            4172                     ! compute wet buld temperature
            4173                     ! =======================================================================
            4174                     
            4175                     real function wet_bulb (q, t, den)
            4176                     
            4177                         implicit none
            4178                     
            4179                         real, intent (in) :: t, q, den
            4180                     
            4181                         real :: qs, tp, dqdt
            4182                     
            4183                         wet_bulb = t
            4184          i              qs = wqs2 (wet_bulb, den, dqdt)
            4185                         tp = 0.5 * (qs - q) / (1. + lcp * dqdt) * lcp
            4186                         wet_bulb = wet_bulb - tp
            4187                     
            4188                         ! tp is negative if super - saturated
            4189     1                   if (tp > 0.01) then
            4190     1    i                  qs = wqs2 (wet_bulb, den, dqdt)
            4191     1                       tp = (qs - q) / (1. + lcp * dqdt) * lcp
            4192     1                       wet_bulb = wet_bulb - tp
            4193     1                   endif
            4194                     
            4195                     end function wet_bulb
            4196                     
            4197                     ! =======================================================================
            4198                     ! compute the saturated specific humidity for table iii
            4199                     ! =======================================================================
            4200                     
            4201                     real function iqs1 (ta, den)
            4202                     
            4203                         implicit none
            4204                     
            4205                         ! water - ice phase; universal dry / moist formular using air density
            4206                         ! input "den" can be either dry or moist air density
            4207                     
            4208                         real, intent (in) :: ta, den
            4209                     
            4210                         real :: es, ap1, tmin
            4211                     
            4212                         integer :: it
            4213                     
            4214                         tmin = table_ice - 160.
            4215                         ap1 = 10. * dim (ta, tmin) + 1.
            4216                         ap1 = min (2621., ap1)
            4217                         it = ap1
            4218                         es = table2 (it) + (ap1 - it) * des2 (it)
            4219                         iqs1 = es / (rvgas * ta * den)
            4220                     
            4221                     end function iqs1
            4222                     
            4223                     ! =======================================================================
            4224                     ! compute the gradient of saturated specific humidity for table iii
            4225                     ! =======================================================================
            4226                     
            4227                     real function iqs2 (ta, den, dqdt)
            4228                     
            4229                         implicit none
            4230                     
            4231                         ! water - ice phase; universal dry / moist formular using air density
            4232                         ! input "den" can be either dry or moist air density
            4233                     
            4234                         real (kind = r8), intent (in) :: ta
            4235                         real, intent (in) :: den
            4236                         real, intent (out) :: dqdt
            4237                         real (kind = r8) :: tmin, es, ap1
            4238                         integer :: it
            4239                     
            4240                         tmin = table_ice - 160.
            4241                         ap1 = 10. * dim (ta, tmin) + 1.
            4242                         ap1 = min (2621., ap1)
            4243                         it = ap1
            4244                         es = table2 (it) + (ap1 - it) * des2 (it)
            4245                         iqs2 = es / (rvgas * ta * den)
            4246                         it = ap1 - 0.5
            4247                         dqdt = 10. * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) / (rvgas * ta * den)
            4248                     
            4249                     end function iqs2
            4250                     
            4251                     ! =======================================================================
            4252                     ! compute the gradient of saturated specific humidity for table iii
            4253                     ! =======================================================================
            4254                     
            4255                     real function qs1d_moist (ta, qv, pa, dqdt)
            4256                     
            4257                         implicit none
            4258                     
            4259                         real, intent (in) :: ta, pa, qv
            4260                     
            4261                         real, intent (out) :: dqdt
            4262                     
            4263                         real :: es, ap1, tmin, eps10
            4264                     
            4265                         integer :: it
            4266                     
            4267                         tmin = table_ice - 160.
            4268                         eps10 = 10. * eps
            4269                         ap1 = 10. * dim (ta, tmin) + 1.
            4270                         ap1 = min (2621., ap1)
            4271                         it = ap1
            4272                         es = table2 (it) + (ap1 - it) * des2 (it)
            4273                         qs1d_moist = eps * es * (1. + zvir * qv) / pa
            4274                         it = ap1 - 0.5
            4275                         dqdt = eps10 * (des2 (it) + (ap1 - it) * (des2 (it + 1) - des2 (it))) * (1. + zvir * qv) / pa
            4276                     
            4277                     end function qs1d_moist
            4278                     
            4279                     ! =======================================================================
            4280                     ! compute the gradient of saturated specific humidity for table ii

            4677                     ! saturation water vapor pressure table i
            4678                     ! 3 - phase table
            4679                     ! =======================================================================
            4680                     
            4681                     subroutine qs_table (n)
            4682                     
            4683                         implicit none
            4684                     
            4685                         integer, intent (in) :: n
            4686                     
            4687                         real (kind = r8) :: delt = 0.1
            4688                         real (kind = r8) :: tmin, tem, esh20
            4689                         real (kind = r8) :: wice, wh2o, fac0, fac1, fac2
            4690                         real (kind = r8) :: esupc (200)
            4691                     
            4692                         integer :: i
            4693                     
            4694                         tmin = table_ice - 160.
            4695                     
            4696                         ! -----------------------------------------------------------------------
            4697                         ! compute es over ice between - 160 deg c and 0 deg c.
            4698                         ! -----------------------------------------------------------------------
            4699                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.46, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 48
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4700     1  pp    v          do i = 1, 1600
            4701     1   p    v              tem = tmin + delt * real (i - 1)
            4702     1   p    v              fac0 = (tem - t_ice) / (tem * t_ice)
            4703     1   p    v              fac1 = fac0 * li2
            4704     1   p    v              fac2 = (d2ice * log (tem / t_ice) + fac1) / rvgas
            4705     1   p    v              table (i) = e00 * exp (fac2)
            4706     1   p    v          enddo
            4707                     
            4708                         ! -----------------------------------------------------------------------
            4709                         ! compute es over water between - 20 deg c and 102 deg c.
            4710                         ! -----------------------------------------------------------------------
            4711                     
                                   <<< Loop-information Start >>>

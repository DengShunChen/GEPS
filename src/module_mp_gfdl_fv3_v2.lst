            4353                     ! =======================================================================
            4354                     ! computes the difference in saturation vapor * density * between water and ice
            4355                     ! =======================================================================
            4356                     
            4357                     real function d_sat (ta, den)
            4358                     
            4359                         implicit none
            4360                     
            4361                         real, intent (in) :: ta, den
            4362                     
            4363                         real :: es_w, es_i, ap1, tmin
            4364                     
            4365                         integer :: it
            4366                     
            4367                         tmin = table_ice - 160.
            4368                         ap1 = 10. * dim (ta, tmin) + 1.
            4369                         ap1 = min (2621., ap1)
            4370                         it = ap1
            4371                         es_w = tablew (it) + (ap1 - it) * desw (it)
            4372                         es_i = table2 (it) + (ap1 - it) * des2 (it)
            4373                         d_sat = dim (es_w, es_i) / (rvgas * ta * den) ! take positive difference
            4374                     
            4375                     end function d_sat

                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, p, dqdt
                                   <<< Loop-information  End >>>
            4780     3   p    v                  do i = 1, im
            4781     3   p    v                      ap1 = 10. * dim (t (i, k), tmin) + 1.
            4782     3   p    v                      ap1 = min (2621., ap1) - 0.5
            4783     3   p    v                      it = ap1
            4784     3   p    v                      dqdt (i, k) = eps10 * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) * (1. + zvir * q (i, k)) / p (i, k)
            4785     3   p    v                  enddo
            4786     2   p                   enddo
            4787     1                   endif
            4788                     
            4789                     end subroutine qsmith
            4790                     
            4791                     ! =======================================================================
            4792                     ! fix negative water species
            4793                     ! this is designed for 6 - class micro - physics schemes
            4794                     ! =======================================================================
            4795                     
            4796                     subroutine neg_adj (ks, ke, pt, dp, qv, ql, qr, qi, qs, qg, cond)
            4797                     
            4798                         implicit none
            4799                     
            4800                         integer, intent (in) :: ks, ke
            4801                         real, intent (in), dimension (ks:ke) :: dp
            4802                         real (kind = r8), intent (inout), dimension (ks:ke) :: pt
            4803                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4804                         real, intent (out) :: cond
            4805                     
            4806                         real, dimension (ks:ke) :: lcpk, icpk
            4807                     
            4808                         real :: dq, cvm
            4809                     
            4810                         integer :: k
            4811                     
            4812                         ! -----------------------------------------------------------------------
            4813                         ! define heat capacity and latent heat coefficient
            4814                         ! -----------------------------------------------------------------------
            4815                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 297
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg, pt, qv, qr, ql, lcpk, qi, qs, icpk
                                   <<< Loop-information  End >>>
            4816     1  pp    v          do k = ks, ke
            4817     1   p    v              cvm = 1. + qv (k) * c1_vap + (qr (k) + ql (k)) * c1_liq + (qi (k) + qs (k) + qg (k)) * c1_ice
            4818     1   p    v              lcpk (k) = (lv00 + d1_vap * pt (k)) / cvm
            4819     1   p    v              icpk (k) = (li00 + d1_ice * pt (k)) / cvm
            4820     1   p    v          enddo
            4821                     
            4822                         cond = 0
            4823                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 121
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4824     1  pp    v          do k = ks, ke
            4825     1               
            4826     1                       ! -----------------------------------------------------------------------
            4827     1                       ! ice phase:
            4828     1                       ! -----------------------------------------------------------------------
            4829     1               
            4830     1                       ! if cloud ice < 0, borrow from snow
            4831     2   p    v              if (qi (k) < 0.) then
            4832     2   p    v                  qs (k) = qs (k) + qi (k)
            4833     2   p    v                  qi (k) = 0.
            4834     2   p    v              endif
            4835     1                       ! if snow < 0, borrow from graupel
            4836     2   p    v              if (qs (k) < 0.) then
            4837     2   p    v                  qg (k) = qg (k) + qs (k)
            4838     2   p    v                  qs (k) = 0.
            4839     2   p    v              endif
            4840     1                       ! if graupel < 0, borrow from rain
            4841     2   p    v              if (qg (k) < 0.) then
            4842     2   p    v                  qr (k) = qr (k) + qg (k)
            4843     2   p    v                  pt (k) = pt (k) - qg (k) * icpk (k) ! heating
            4844     2   p    v                  qg (k) = 0.
            4845     2   p    v              endif
            4846     1               
            4847     1                       ! -----------------------------------------------------------------------
            4848     1                       ! liquid phase:
            4849     1                       ! -----------------------------------------------------------------------
            4850     1               
            4851     1                       ! if rain < 0, borrow from cloud water
            4852     2   p    v              if (qr (k) < 0.) then
            4853     2   p    v                  ql (k) = ql (k) + qr (k)
            4854     2   p    v                  qr (k) = 0.
            4855     2   p    v              endif
            4856     1                       ! if cloud water < 0, borrow from water vapor
            4857     2   p    v              if (ql (k) < 0.) then
            4858     2   p    v                  cond = cond - ql (k) * dp (k)
            4859     2   p    v                  qv (k) = qv (k) + ql (k)
            4860     2   p    v                  pt (k) = pt (k) - ql (k) * lcpk (k) ! heating
            4861     2   p    v                  ql (k) = 0.
            4862     2   p    v              endif
            4863     1               
            4864     1   p    v          enddo
            4865                     
            4866                         ! -----------------------------------------------------------------------
            4867                         ! fix water vapor; borrow from below
            4868                         ! -----------------------------------------------------------------------
            4869                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            4870     1   s   2s          do k = ks, ke - 1
            4871     2   s   2m              if (qv (k) < 0.) then
            4872     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            4873     2   s   2v                  qv (k) = 0.
            4874     2   s   2v              endif
            4875     1   s   2v          enddo
            4876                     
            4877                         ! -----------------------------------------------------------------------
            4878                         ! bottom layer; borrow from above
            4879                         ! -----------------------------------------------------------------------
            4880                     
            4881     1                   if (qv (ke) < 0. .and. qv (ke - 1) > 0.) then
            4882     1                       dq = min (- qv (ke) * dp (ke), qv (ke - 1) * dp (ke - 1))
            4883     1                       qv (ke - 1) = qv (ke - 1) - dq / dp (ke - 1)
            4884     1                       qv (ke) = qv (ke) + dq / dp (ke)
            4885     1                   endif
            4886                     
            4887                     end subroutine neg_adj
            4888                     
            4889                     !-------------------------------------------------------------------
            4890                           SUBROUTINE semi_lagrange_sedim(km,dzl,wwl,rql,precip,pfsan,dt,R1)
            4891                     !-------------------------------------------------------------------
            4892                     !
            4893                     ! This routine is a semi-Lagrangain forward advection for hydrometeors
            4894                     ! with mass conservation and positive definite advection
            4895                     ! 2nd order interpolation with monotonic piecewise parabolic method is used.
            4896                     ! This routine is under assumption of decfl < 1 for semi_Lagrangian
            4897                     !
            4898                     ! km     number of layers
            4899                     ! dzl    depth of model layer in meter (m)
            4900                     ! wwl    terminal velocity at model layer (m/s)
            4901                     ! rql    dry air density*mixing ratio
            4902                     ! precip precipitation at surface (mm)
            4903                     ! pfsan  precipitation fluxes (mm?)
            4904                     ! dt     time step (s)
            4905                     ! R1     minimum q, =1.E-12 in new Thompson MP
            4906                     !
            4907                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            4908                     !         implemented by song-you hong
            4909                     ! reference: Juang, H.-M., and S.-Y. Hong, 2010: Forward semi-Lagrangian advection
            4910                     !         with mass conservation and positive definiteness for falling
            4911                     !         hydrometeors. *Mon.  Wea. Rev.*, *138*, 1778-1791
            4912                     !
            4913                           implicit none
            4914                     
            4915                           integer, intent(in) :: km
            4916                           real, intent(in) ::  dt, R1
            4917                           real, intent(in) :: dzl(km),wwl(km)
            4918                           real, intent(out) :: precip
            4919                           real, intent(inout) :: rql(km)
            4920                           real, intent(out)  :: pfsan(km)
            4921                           integer  k,m,kk,kb,kt
            4922                           real  tl,tl2,qql,dql,qqd
            4923                           real  th,th2,qqh,dqh
            4924                           real  zsum,qsum,dim,dip,con1,fa1,fa2
            4925                           real  allold, decfl
            4926                           real  dz(km), ww(km), qq(km)
            4927                           real  wi(km+1), zi(km+1), za(km+2)
            4928                           real  qn(km)
            4929                           real  dza(km+1), qa(km+1), qmi(km+1), qpi(km+1)
            4930                           real  net_flx(km)
            4931                     !
            4932                           precip = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa
                                   <<< Loop-information  End >>>
            4933        pp   4v            qa(:) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, dz, wwl, dzl, qq
                                   <<< Loop-information  End >>>
            4934        pp   2v            qq(:) = 0.0
            4935         p   2v            dz(:) = dzl(:)
            4936         p   2v            ww(:) = wwl(:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rql, net_flx, ww, qq, pfsan
                                   <<< Loop-information  End >>>
            4937     1  pp   2v            do k = 1,km
            4938     2   p   2v              if(rql(k).gt.R1) then
            4939     2   p   2v                qq(k) = rql(k)
            4940     2   p   2v              else
            4941     2   p   2v                ww(k) = 0.0
            4942     2   p   2v              endif
            4943     1   p   2v              pfsan(k) = 0.0
            4944     1   p   2v              net_flx(k) = 0.0
            4945     1   p   2v            enddo
            4946                     ! skip for no precipitation for all layers
            4947                           allold = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4948     1  pp    v            do k=1,km
            4949     1   p    v              allold = allold + qq(k)
            4950     1   p    v            enddo
            4951     1                     if(allold.le.0.0) then
            4952     1                        return
            4953     1                     endif
            4954                     !
            4955                     ! compute interface values
            4956                           zi(1)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi
                                   <<< Loop-information  End >>>
            4957     1   s   2s            do k=1,km
            4958     1   s   2s              zi(k+1) = zi(k)+dz(k)
            4959     1   s   2s            enddo
            4960                     ! plm is 2nd order, we can use 2nd order wi or 3rd order wi
            4961                     ! 2nd order interpolation to get wi
            4962                     !      wi(1) = ww(1)
            4963                     !      wi(km+1) = ww(km)
            4964                     !      do k=2,km
            4965                     !        wi(k) = (ww(k)*dz(k-1)+ww(k-1)*dz(k))/(dz(k-1)+dz(k))
            4966                     !      enddo
            4967                     ! 3rd order interpolation to get wi
            4968                           fa1 = 9./16.
            4969                           fa2 = 1./16.
            4970                           wi(1) = ww(1)
            4971                           wi(2) = 0.5*(ww(2)+ww(1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            4972     1  pp   2v            do k=3,km-1
            4973     1   p   2v              wi(k) = fa1*(ww(k)+ww(k-1))-fa2*(ww(k+1)+ww(k-2))
            4974     1   p   2v            enddo
            4975                           wi(km) = 0.5*(ww(km)+ww(km-1))
            4976                           wi(km+1) = ww(km)
            4977                     
            4978                     ! terminate of top of raingroup
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            4979     1  pp   2v            do k=2,km
            4980     1   p   2v              if( ww(k).eq.0.0 ) wi(k)=ww(k-1)
            4981     1   p   2v            enddo
            4982                     
            4983                     ! diffusivity of wi
            4984                           con1 = 0.05
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, dz
                                   <<< Loop-information  End >>>
            4985     1   s   2s            do k=km,1,-1
            4986     1   m   2m              decfl = (wi(k+1)-wi(k))*dt/dz(k)
            4987     2   s   2s              if( decfl .gt. con1 ) then
            4988     2   s   2s                wi(k) = wi(k+1) - con1*dz(k)/dt
            4989     2   p   2v              endif
            4990     1   p   2v            enddo
            4991                     ! compute arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, zi, za
                                   <<< Loop-information  End >>>
            4992     1  pp   2v            do k=1,km+1
            4993     1   p   2v              za(k) = zi(k) - wi(k)*dt
            4994     1   p   2v            enddo
            4995                           za(km+2) = zi(km+1)
            4996                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za, dza
                                   <<< Loop-information  End >>>
            4997     1  pp   2v            do k=1,km+1
            4998     1   p   2v              dza(k) = za(k+1)-za(k)
            4999     1   p   2v            enddo
            5000                     
            5001                     ! computer deformation at arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qq, dza, qa
                                   <<< Loop-information  End >>>
            5002     1  pp   2v            do k=1,km
            5003     1   p   2v              qa(k) = qq(k)*dz(k)/dza(k)
            5004     1   p   2v            enddo
            5005                           qa(km+1) = 0.0
            5006                     
            5007                     ! estimate values at arrival cell interface with monotone
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qmi, qpi
                                   <<< Loop-information  End >>>
            5008     1  pp    v            do k=2,km
            5009     1   p    v              dip=(qa(k+1)-qa(k))/(dza(k+1)+dza(k))
            5010     1   p    v              dim=(qa(k)-qa(k-1))/(dza(k-1)+dza(k))
            5011     2   p    v              if( dip*dim.le.0.0 ) then
            5012     2   p    v                qmi(k)=qa(k)
            5013     2   p    v                qpi(k)=qa(k)
            5014     2   p    v              else
            5015     2   p    v                qpi(k)=qa(k)+0.5*(dip+dim)*dza(k)
            5016     2   p    v                qmi(k)=2.0*qa(k)-qpi(k)
            5017     3   p    v                if( qpi(k).lt.0.0 .or. qmi(k).lt.0.0 ) then
            5018     3   p    v                  qpi(k) = qa(k)
            5019     3   p    v                  qmi(k) = qa(k)
            5020     3   p    v                endif
            5021     2   p    v              endif
            5022     1   p    v            enddo
            5023                           qpi(1)=qa(1)
            5024                           qmi(1)=qa(1)
            5025                           qmi(km+1)=qa(km+1)
            5026                           qpi(km+1)=qa(km+1)
            5027                     
            5028                     ! interpolation to regular point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            5029        pp   4v            qn = 0.0
            5030                           kb=1
            5031                           kt=1
            5032     1                     intp : do k=1,km
            5033     1                            kb=max(kb-1,1)
            5034     1                            kt=max(kt-1,1)
            5035     1               ! find kb and kt
            5036     2                            if( zi(k).ge.za(km+1) ) then
            5037     2                              exit intp
            5038     2                            else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            5039     3                              find_kb : do kk=kb,km
            5040     4                                        if( zi(k).le.za(kk+1) ) then
            5041     4                                          kb = kk
            5042     4                                          exit find_kb
            5043     4                                        else
            5044     4                                          cycle find_kb
            5045     4                                        endif
            5046     3                              enddo find_kb
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            5047     3                              find_kt : do kk=kt,km+2
            5048     4                                        if( zi(k+1).le.za(kk) ) then
            5049     4                                          kt = kk
            5050     4                                          exit find_kt
            5051     4                                        else
            5052     4                                          cycle find_kt
            5053     4                                        endif
            5054     3                              enddo find_kt
            5055     2                              kt = kt - 1
            5056     2               ! compute q with piecewise constant method
            5057     3                              if( kt.eq.kb ) then
            5058     3                                tl=(zi(k)-za(kb))/dza(kb)
            5059     3                                th=(zi(k+1)-za(kb))/dza(kb)
            5060     3                                tl2=tl*tl
            5061     3                                th2=th*th
            5062     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            5063     3                                qqh=qqd*th2+qmi(kb)*th
            5064     3                                qql=qqd*tl2+qmi(kb)*tl
            5065     3                                qn(k) = (qqh-qql)/(th-tl)
            5066     3                                net_flx(k) = (qa(k)*dza(k)-(qqh-qql))  !xb141
            5067     3                              else if( kt.gt.kb ) then
            5068     3                                tl=(zi(k)-za(kb))/dza(kb)
            5069     3                                tl2=tl*tl
            5070     3                                qqd=0.5*(qpi(kb)-qmi(kb))
            5071     3                                qql=qqd*tl2+qmi(kb)*tl
            5072     3                                dql = qa(kb)-qql
            5073     3                                zsum  = (1.-tl)*dza(kb)
            5074     3                                qsum  = dql*dza(kb)
            5075     4                                if( kt-kb.gt.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5076     5  pp    v                       do m=kb+1,kt-1
            5077     5   p    v                         zsum = zsum + dza(m)
            5078     5   p    v                         qsum = qsum + qa(m) * dza(m)
            5079     5   p    v                       enddo
            5080     4                                endif
            5081     3                                th=(zi(k+1)-za(kt))/dza(kt)
            5082     3                                th2=th*th
            5083     3                                qqd=0.5*(qpi(kt)-qmi(kt))
            5084     3                                dqh=qqd*th2+qmi(kt)*th
            5085     3                                zsum  = zsum + th*dza(kt)
            5086     3                                qsum  = qsum + dqh*dza(kt)
            5087     3                                qn(k) = qsum/zsum
            5088     3                                net_flx(k) = (qa(k)*dza(k)-qsum)  !xb141
            5089     3                              endif
            5090     2                              cycle intp
            5091     2                            endif
            5092     1               
            5093     1                      enddo intp
            5094                     
            5095                     ! rain out
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5096     1                     sum_precip: do k=1,km
            5097     2                                   if( za(k).lt.0.0 .and. za(k+1).le.0.0 ) then
            5098     2                                     precip = precip + qa(k)*dza(k)
            5099     2                                     cycle sum_precip
            5100     2                                   else if ( za(k).lt.0.0 .and. za(k+1).gt.0.0 ) then
            5101     2                                     th = (0.0-za(k))/dza(k)
            5102     2                                     th2 = th*th
            5103     2                                     qqd = 0.5*(qpi(k)-qmi(k))
            5104     2                                     qqh = qqd*th2+qmi(k)*th
            5105     2                                     precip = precip + qqh*dza(k)
            5106     2                                     exit sum_precip
            5107     2                                   endif
            5108     1                                   exit sum_precip
            5109     1                     enddo sum_precip
            5110                           precip = precip*grav  !xb141, because convt=1./grav
            5111                     
            5112                     ! calculating precipitation fluxes

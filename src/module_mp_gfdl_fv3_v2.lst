            2610                     ! rain evaporation
            2611                     ! =======================================================================
            2612                     
            2613                     subroutine revap_rac1 (hydrostatic, is, ie, dt, tz, qv, ql, qr, qi, qs, qg, den, hvar)
            2614                     
            2615                         implicit none
            2616                     
            2617                         logical, intent (in) :: hydrostatic
            2618                     
            2619                         integer, intent (in) :: is, ie
            2620                     
            2621                         real, intent (in) :: dt ! time step (s)
            2622                     
            2623                         real, intent (in), dimension (is:ie) :: den, hvar, qi, qs, qg
            2624                     
            2625                         real, intent (inout), dimension (is:ie) :: tz, qv, qr, ql
            2626                     
            2627                         real, dimension (is:ie) :: lcp2, denfac, q_liq, q_sol, cvm, lhl
            2628                     
            2629                         real :: dqv, qsat, dqsdt, evap, qden, q_plus, q_minus, sink
            2630                         real :: tin, t2, qpz, dq, dqh
            2631                     
            2632                         integer :: i
            2633                     
            2634                         ! -----------------------------------------------------------------------
            2635                         ! define latend heat coefficient
            2636                         ! -----------------------------------------------------------------------
            2637                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qv, qg, tz, qs, q_sol, cvm, q_liq
                                   <<<      qi, qr, lcp2, lhl
                                   <<< Loop-information  End >>>
            2638     1  pp    v          do i = is, ie
            2639     1   p    v              lhl (i) = lv00 + d0_vap * tz (i)
            2640     1   p    v              q_liq (i) = ql (i) + qr (i)
            2641     1   p    v              q_sol (i) = qi (i) + qs (i) + qg (i)
            2642     1   p    v              cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2643     1   p    v              lcp2 (i) = lhl (i) / cvm (i)
            2644     1                       ! denfac (i) = sqrt (sfcrho / den (i))
            2645     1   p    v          enddo
            2646                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 5
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2647     1                   do i = is, ie
            2648     2                       if (qr (i) > qrmin .and. tz (i) > t_wfr) then
            2649     2                           qpz = qv (i) + ql (i)
            2650     2                           tin = tz (i) - lcp2 (i) * ql (i) ! presence of clouds suppresses the rain evap
            2651     2    i                      qsat = wqs2 (tin, den (i), dqsdt)
            2652     2                           dqh = max (ql (i), hvar (i) * max (qpz, qcmin))
            2653     2                           dqv = qsat - qv (i)
            2654     2                           q_minus = qpz - dqh
            2655     2                           q_plus = qpz + dqh
            2656     2               
            2657     2                           ! -----------------------------------------------------------------------
            2658     2                           ! qsat must be > q_minus to activate evaporation
            2659     2                           ! qsat must be < q_plus to activate accretion
            2660     2                           ! -----------------------------------------------------------------------
            2661     2               
            2662     2                           ! -----------------------------------------------------------------------
            2663     2                           ! rain evaporation
            2664     2                           ! -----------------------------------------------------------------------
            2665     2               
            2666     3                           if (dqv > qvmin .and. qsat > q_minus) then
            2667     4                               if (qsat > q_plus) then
            2668     4                                   dq = qsat - qpz
            2669     4                               else
            2670     4                                   ! q_minus < qsat < q_plus
            2671     4                                   ! dq == dqh if qsat == q_minus
            2672     4                                   dq = 0.25 * (q_minus - qsat) ** 2 / dqh
            2673     4                               endif
            2674     3                               qden = qr (i) * den (i)
            2675     3                               t2 = tin * tin
            2676     3                               evap = crevp (1) * t2 * dq * (crevp (2) * sqrt (qden) + crevp (3) * exp (0.725 * log (qden))) &
            2677     3                                    / (crevp (4) * t2 + crevp (5) * qsat * den (i))
            2678     3                               evap = min (qr (i), dt * evap, dqv / (1. + lcp2 (i) * dqsdt))
            2679     3                               qr (i) = qr (i) - evap
            2680     3                               qv (i) = qv (i) + evap
            2681     3                               q_liq (i) = q_liq (i) - evap
            2682     3                               cvm (i) = c_air + qv (i) * c_vap + q_liq (i) * c_liq + q_sol (i) * c_ice
            2683     3                               tz (i) = tz (i) - evap * lhl (i) / cvm (i)
            2684     3                           endif
            2685     2               
            2686     2                           ! -----------------------------------------------------------------------
            2687     2                           ! accretion: pracc
            2688     2                           ! -----------------------------------------------------------------------
            2689     2               
            2690     3                           if (qr (i) > qrmin .and. ql (i) > 1.e-8 .and. qsat < q_plus) then
            2691     3                               denfac (i) = sqrt (sfcrho / den (i))
            2692     3                               sink = dt * denfac (i) * cracw * exp (0.95 * log (qr (i) * den (i)))
            2693     3                               sink = sink / (1. + sink) * ql (i)
            2694     3                               ql (i) = ql (i) - sink
            2695     3                               qr (i) = qr (i) + sink
            2696     3                           endif
            2697     2                       endif
            2698     1                   enddo
            2699                     
            2700                     end subroutine revap_rac1
            2701                     
            2702                     ! =======================================================================
            2703                     ! compute terminal fall speed

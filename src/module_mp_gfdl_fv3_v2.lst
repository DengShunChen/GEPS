             404                             rewflag, reiflag, ccnflag
             405                     
             406                     contains
             407                     
             408                     ! -----------------------------------------------------------------------
             409                     ! the driver of the gfdl cloud microphysics
             410                     ! -----------------------------------------------------------------------
             411                     
             412                     subroutine gfdl_cld_mp_driver                                              &
             413                                 ( qv, ql, qr, qi, qs, qg, qa, qnl, qni,                        &
             414                                   pt, w, ua, va, dz, delp, gsize, dts, hs,                     &
             415                                   land,                                                        &
             416                                   rain, snow, ice, graupel, hydrostatic,                       &
             417                                   is, ie, ks, ke, q_con, cappa, consv_te, te,                  &
             418                     #ifdef EXT_DIAG
             419                                   prefluxr, prefluxi, prefluxs, prefluxg,                      &
             420                                   condensation, deposition, evaporation, sublimation,          &
             421                     #endif
             422                                   rhc, last_step, do_inline_mp )
             423                     
             424                         implicit none
             425                     
             426                         logical, intent (in) :: hydrostatic
             427                         logical, intent (in) :: last_step
             428                         logical, intent (in) :: consv_te
             429                         logical, intent (in) :: do_inline_mp
             430                     
             431                         integer, intent (in) :: is, ie ! physics window
             432                         integer, intent (in) :: ks, ke ! vertical dimension
             433                     
             434                         real, intent (in) :: dts ! physics time step
             435                     
             436                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             437                     
             438                         real, intent (in), dimension (is:ie) :: hs, gsize, land
             439                     
             440                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             441                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             442                     
             443                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             444                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             445                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             446                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             447                         real, intent (inout), dimension (is:ie, ks:ke) :: te
             448                     #ifdef EXT_DIAG
             449                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             450                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             451                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             452                     #endif
             453                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             454                         ! logical :: used
             455                     !    real, dimension (is:ie) :: w_var
             456                     !    real, dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             457                         real, dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             458                     #ifndef EXT_DIAG
             459                         real, dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             460                         real, dimension (is:ie) :: condensation, deposition
             461                         real, dimension (is:ie) :: evaporation, sublimation
             462                     #endif
             463                     
             464     1                   if (last_step) then
             465     1                       p_min = p0_min ! final clean - up
             466     1                   else
             467     1                       p_min = 30.e2 ! time saving trick
             468     1                   endif
             469                     
             470                         ! -----------------------------------------------------------------------
             471                         ! define heat capacity of dry air and water vapor based on hydrostatical property
             472                         ! -----------------------------------------------------------------------
             473                     
             474     1                   if (hydrostatic) then
             475     1                       c_air = cp_air
             476     1                       c_vap = cp_vap
             477     1                       do_sedi_w = .false.
             478     1                   else
             479     1                       c_air = cv_air
             480     1                       c_vap = cv_vap
             481     1                   endif
             482                         d0_vap = c_vap - c_liq
             483                     
             484                         ! scaled constants (to reduce fp errors for 32 - bit) :
             485                         d1_vap = d0_vap / c_air
             486                         d1_ice = dc_ice / c_air
             487                     
             488                         ! lv0 = hlv0 - (c_vap - c_liq) * t_ice! 3.13905782e6, evaporation latent heat coefficient at 0 deg k
             489                         lv00 = (hlv0 - d0_vap * t_ice) / c_air
             490                         li00 = (hlf0 - dc_ice * t_ice) / c_air
             491                         li20 = lv00 + li00
             492                     
             493                         c1_vap = c_vap / c_air
             494                         c1_liq = c_liq / c_air
             495                         c1_ice = c_ice / c_air
             496                     
             497                         ! -----------------------------------------------------------------------
             498                         ! define latent heat coefficient used in wet bulb and bigg mechanism
             499                         ! -----------------------------------------------------------------------
             500                     
             501                         lat2 = (hlv + hlf) ** 2
             502                     
             503                         lcp = hlv / cp_air
             504                         icp = hlf / cp_air
             505                         tcp = (hlv + hlf) / cp_air
             506                     
             507                         ! tendency zero out for am moist processes should be done outside the driver
             508                     
             509                         ! -----------------------------------------------------------------------
             510                         ! major cloud microphysics
             511                         ! -----------------------------------------------------------------------
             512                     
             513                         call mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, qg, &
             514                             qa, qnl, qni, dz, is, ie, ks, ke, dts, &
             515                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             516                     #ifdef oldmask
             517                             land, &
             518                     #endif
             519                     !        w_var, vt_r, vt_s, vt_g, vt_i,
             520                             q_con, cappa, consv_te, te, &
             521                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             522                             evaporation, sublimation, rhc, last_step, do_inline_mp)
             523                     
             524                     end subroutine gfdl_cld_mp_driver
             525                     
             526                     ! -----------------------------------------------------------------------
             527                     ! gfdl cloud microphysics, major program
             528                     ! lin et al., 1983, jam, 1065 - 1092, and
             529                     ! rutledge and hobbs, 1984, jas, 2949 - 2972
             530                     ! terminal fall is handled lagrangianly by conservative fv algorithm
             531                     ! pt: temperature (k)
             532                     ! 6 water species:
             533                     ! 1) qv: water vapor (kg / kg)
             534                     ! 2) ql: cloud water (kg / kg)
             535                     ! 3) qr: rain (kg / kg)
             536                     ! 4) qi: cloud ice (kg / kg)
             537                     ! 5) qs: snow (kg / kg)
             538                     ! 6) qg: graupel (kg / kg)
             539                     ! -----------------------------------------------------------------------
             540                     
             541                     subroutine mpdrv (hydrostatic, ua, va, w, delp, pt, qv, ql, qr, qi, qs, &
             542                             qg, qa, qnl, qni, dz, is, ie, ks, ke, dt_in, &
             543                             rain, snow, graupel, ice, m2_rain, m2_sol, gsize, hs, &
             544                     #ifdef oldmask
             545                             land, &
             546                     #endif
             547                     !        w_var, vt_r, vt_s, vt_g, vt_i,
             548                             q_con, cappa, consv_te, te, &
             549                             prefluxr, prefluxi, prefluxs, prefluxg, condensation, deposition, &
             550                             evaporation, sublimation, rhc, last_step, do_inline_mp )
             551                     
             552                         implicit none
             553                     
             554                         logical, intent (in) :: hydrostatic
             555                         logical, intent (in) :: last_step
             556                         logical, intent (in) :: consv_te
             557                         logical, intent (in) :: do_inline_mp
             558                         integer, intent (in) :: is, ie, ks, ke
             559                         real, intent (in) :: dt_in
             560                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             561                         real, intent (in), dimension (is:ie) :: gsize
             562                         real, intent (in), dimension (is:ie) :: hs
             563                     #ifdef oldmask
             564                         real, intent (in), dimension (is:ie) :: land
             565                     #endif
             566                         real, intent (in), dimension (is:ie, ks:ke) :: dz
             567                         real, intent (in), dimension (is:ie, ks:ke) :: qnl, qni
             568                     
             569                         real, intent (inout), dimension (is:ie, ks:ke) :: delp
             570                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             571                         real, intent (inout), dimension (is:ie, ks:ke) :: pt, ua, va, w
             572                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxr, prefluxi, prefluxs, prefluxg
             573                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             574                         real, intent (inout), dimension (is:ie) :: rain, snow, ice, graupel
             575                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             576                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             577                     
             578                     !    real, intent (out), dimension (is:ie) :: w_var
             579                     !    real, intent (out), dimension (is:ie, ks:ke) :: vt_r, vt_s, vt_g, vt_i
             580                         real, intent (out), dimension (is:ie, ks:ke) :: m2_rain, m2_sol
             581                         real, intent (out), dimension (is:ie, ks:ke) :: te
             582                         ! local:
             583                         real, dimension (ks:ke) :: q_liq, q_sol
             584                         real, dimension (ks:ke) :: qvz, qlz, qrz, qiz, qsz, qgz, qaz
             585                         real, dimension (ks:ke) :: vtiz, vtsz, vtgz, vtrz, pfr, pfi, pfs, pfg
             586                         real, dimension (ks:ke) :: dp1, dz1
             587                         real, dimension (ks:ke) :: den, p1, denfac
             588                         real, dimension (ks:ke) :: ccn, cin, c_praut, m1_rain, m1_sol, m1
             589                         real, dimension (ks:ke) :: u0, v0, u1, v1, w1
             590                         real, dimension (ks:ke) :: rhcz
             591                     
             592                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg, te_end, tw_beg, tw_end
             593                         real (kind = r8), dimension (is:ie, ks:ke) :: te_beg_0, te_end_0, tw_beg_0, tw_end_0
             594                         real (kind = r8), dimension (is:ie) :: te_b_beg, te_b_end, tw_b_beg, tw_b_end, dte, te_loss
             595                         real (kind = r8), dimension (is:ie) :: te_b_beg_0, te_b_end_0, tw_b_beg_0, tw_b_end_0
             596                         real (kind = r8), dimension (ks:ke) :: te1, te2
             597                     
             598                         real :: cpaut, rh_adj, rh_rain
             599                         real :: r1, s1, i1, g1, rdt, ccn0
             600                         real :: dt_rain
             601                         real :: s_leng, t_land, t_ocean, h_var, tmp
             602                         real (kind = r8), dimension (ks:ke) :: dp0, tz, cvm
             603                         real (kind = r8) :: con_r8, c8
             604                         real :: convt
             605                         real :: dts, q_cond
             606                         real :: nl, ni
             607                         real :: cond, dep, reevap, sub
             608                     
             609                         integer :: i, k, n
             610                     
             611                         logical  :: last_step_cld=.false.
             612                     
             613                         ntimes = max (ntimes, int (dt_in / min (dt_in, mp_time)))
             614                         dts = dt_in / real (ntimes)
             615                     
             616                         dt_rain = dts * 0.5
             617                         rdt = one_r8 / dts
             618                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dte
                                   <<< Loop-information  End >>>
             619        pp   4v          dte = 0.0
             620                     
             621                         !! convert to mm / day (original)
             622                         ! convt = 86400. * rdt * rgrav
             623                     
             624                         !! convert to mm / s
             625                         ! convt = rdt * rgrav
             626                     
             627                         ! convert to mm
             628                         convt = rgrav
             629                     
             630                         ! -----------------------------------------------------------------------
             631                         ! use local variables
             632                         ! -----------------------------------------------------------------------
             633                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, q_liq, cvm, u1, qsz, v1, qiz
                                   <<<      qrz, qlz, qvz, qgz, w1, dp1, den, ccn
                                   <<<      c_praut, dp0, m1, v0, u0, qaz
                                   <<< Loop-information  End >>>
             634     1                   do i = is, ie
             635     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
             636     2  pp   4v              do k = ks, ke
             637     3   p   4v                  if (do_inline_mp) then
             638     3               #ifdef MOIST_CAPPA
             639     3                               tz (k) = pt (i, k) / ((1. + zvir * qv (i, k)) * (1. - (ql (i, k) + qr (i, k) + qi (i, k) + qs (i, k) + qg (i, k))))
             640     3               #else
             641     3       4                       tz (k) = pt (i, k) / (1. + zvir * qv (i, k))
             642     3               #endif
             643     3   p   4v                  else
             644     3   p   4v                      tz (k) = pt (i, k)
             645     3   p   4v                  endif
             646     2   p   4v              enddo
             647     1               
             648     1                       ! -----------------------------------------------------------------------
             649     1                       ! total energy checker
             650     1                       ! -----------------------------------------------------------------------
             651     1               
             652     2                       if (consv_checker) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 184
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.42, ITR: 40, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, q_sol, cvm, q_liq
                                   <<< Loop-information  End >>>
             653     3  pp    v                  do k = ks, ke
             654     3   p    v                      q_liq (k) = ql (i, k) + qr (i, k)
             655     3   p    v                      q_sol (k) = qi (i, k) + qs (i, k) + qg (i, k)
             656     3   p    v                      cvm (k) = c_air * (1.0 - qv (i, k) - q_liq (k) - q_sol (k)) + &
             657     3                                   qv (i, k) * c_vap + q_liq (k) * c_liq + q_sol (k) * c_ice
             658     3   p    v                      te_beg_0 (i, k) = cvm (k) * tz (k) + lv00 * c_air * qv (i, k) - li00 * c_air * q_sol (k)
             659     4   p    v                      if (hydrostatic) then
             660     4                                   te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2)
             661     4   p    v                      else
             662     4   p    v                          te_beg_0 (i, k) = te_beg_0 (i, k) + 0.5 * (ua (i, k) ** 2 + va (i, k) ** 2 + w (i, k) ** 2)
             663     4   p    v                      endif
             664     3   p    v                      te_beg_0 (i, k) = rgrav * te_beg_0 (i, k) * delp (i, k) * gsize (i) ** 2.0
             665     3   p    v                      tw_beg_0 (i, k) = rgrav * (qv (i, k) + q_liq (k) + q_sol (k)) * delp (i, k) * gsize (i) ** 2.0

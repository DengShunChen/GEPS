            5126                     !     compute fall speed of cloud rain and ice
            5127                           SUBROUTINE vqrqi(isg,r00,fv,qri,ql,tair,ww1)
            5128                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            5129                     ! compute fall speed of cloud rain and ice
            5130                     ! isg=1, for rain
            5131                     ! isg=2, for ice
            5132                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            5133                           implicit none
            5134                     
            5135                           integer, intent(in) :: isg
            5136                           real, intent(in) :: r00, fv,qri,ql,tair
            5137                           real, intent(inout) :: ww1
            5138                     
            5139                     ! LOCAL variables
            5140                           integer :: ic
            5141                           real  :: y1,vr,vs,vg
            5142                           real  :: const_vt, const_d, const_m !cpi, cmin Di
            5143                           real  :: cmin, draimax, tnw, vrc0, vrc1, vrc2, vrc3, zrc, cpi, roqr
            5144                           real  :: bb1, bb2,ice_fall
            5145                           real  :: bin_factor, ftnw, ftnwmin
            5146                           real, dimension(7) ::  aice, vice
            5147                           data aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./
            5148                           data vice/5,15,30,35,40,45,50/
            5149                     
            5150                           ice_fall=0.
            5151                           const_vt=1.49e4
            5152                           const_d=11.9
            5153                           const_m=1./5.38e7
            5154                           cmin=1.E-20
            5155                           cpi=4.*atan(1.)
            5156                           roqr=1.  !rain density (g/cm^3)
            5157                           tnw=0.08
            5158                     
            5159                           draimax=0.0500 !maximum rain diameter (cm)
            5160                           draimax=draimax**4.*roqr*cpi
            5161                           zrc=(cpi*roqr*tnw)**0.25
            5162                           vrc0=-26.7
            5163                           vrc1=20600./zrc
            5164                           vrc2=-204500./(zrc*zrc)
            5165                           vrc3=906000./(zrc*zrc*zrc)
            5166                     
            5167                           y1=r00*qri
            5168                           ww1=0.
            5169                     
            5170     1                     if (y1 .gt. cmin) then
            5171     1               
            5172     2                     if (isg.eq.1) then                             !  rain
            5173     2               
            5174     2                        ftnw=1.
            5175     3                          if(ql.lt.cmin .and. tair .gt. t_ice)then
            5176     3                            bin_factor=0.11*(1000.*qri)**(-1.27) + 0.98
            5177     3                            bin_factor=min(bin_factor, 1.30)
            5178     3                            ftnw=1./bin_factor**3.35
            5179     3                            ftnwmin=r00*qri/draimax
            5180     3                            if(qri.le.0.001) ftnw=max(ftnw,ftnwmin/tnw)
            5181     3                          endif
            5182     2               
            5183     2                              vs=sqrt( y1 )
            5184     2                              vg=sqrt( vs)
            5185     2               !               vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
            5186     2                              vr=vrc0+vrc1*vg/ftnw**0.25+vrc2*vs/ftnw**0.50+vrc3*vg*vs/ftnw**0.75
            5187     2                              ww1=max(fv*vr, 0.e0)
            5188     2               
            5189     2               
            5190     2                     else if (isg.eq.2) then                         ! cloud ice
            5191     2               
            5192     2                           y1=1.e6*r00*qri                            ! to g/m**3
            5193     2               
            5194     3                           if (y1 .gt. 1.e-6) then
            5195     3                                 y1=y1*1.e-3
            5196     3                                 bb1=const_m*y1**0.25
            5197     3                                 bb2=const_d*bb1**0.5
            5198     3                                 ww1=max(const_vt*bb2**1.31, 0.0)
            5199     3                                 ww1=ww1*100. !cm/s
            5200     3                                 if (ww1 .gt. 50.) ww1=50.               ! SLang
            5201     3                           endif  !y1
            5202     2                     endif  !isg
            5203     1                     endif !y1
            5204                     
            5205                           end subroutine vqrqi

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      canfac, sigmaf, partlnd, ep, canopy
                                   <<<      flag, ec
                                   <<< Loop-information  End >>>
             918     1  pp    v             do i=1,nxj
             919     2   p    v              if(flag(i))then
             920     2   p    v              ec(i)=sigmaf(i)*canfac(i)*ep(i)/hltm
             921     2   p    v              ec(i)=ec(i)*partlnd(i)
             922     2   p    v              ec(i)=min(ec(i),canopy(i)/dt)
             923     2   p    v              endif
             924     1   p    v             enddo
             925                     !
             926                     ! sum up total evaporation
             927                     !
                                   <<< Loop-information Start >>>

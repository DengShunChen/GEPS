                                   <<< Loop-information  End >>>
             339     1  pp   2v            do i=1,nxj
             340     2   p   2v            if(ocean(i))then
             341     2   p   2v             zsoil(i,1)=0.
             342     2   p   2v            elseif(land(i))then
             343     2   p   2v             zsoil(i,1)=-.1
             344     2   p   2v            else
             345     2   p   2v             zsoil(i,1)=-3./km
             346     2   p   2v            endif
             347     1   p   2v            enddo
             348                     !
                                   <<< Loop-information Start >>>

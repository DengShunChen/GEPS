 External function subprogram "xtsoil"
  (inc)(line-no.)(nest)(optimize)
            1393                     
            1394                     !---- function area -----
            1395                     !
            1396                           real function xtsoil(theta,ktype,tsat,dfkt)
            1397                     !
            1398                     ! xtsoil : heat diffusivity (m2/s)
            1399                     !
            1400                           parameter (ntype=9,ngrid=22)
            1401                           dimension dfkt(ngrid,ntype),tsat(ntype)
            1402                           w = (theta / tsat(ktype)) * 20. + 1.
            1403                           kw = w
            1404                           kw = min(kw,21)
            1405                           kw = max(kw,1)
            1406                           xtsoil = dfkt(kw,ktype)+(w-kw)*(dfkt(kw+1,ktype)-dfkt(kw,ktype))
            1407                           return
            1408                           end


             160                                     u(mn,kk),v(mn,kk),t(mn,kk),                        &
             161                                     sfcw(mn),ustar(mn),                                &
             162                                     tstar(mn),qstar(mn),e(mn,kk),eps(mn,kk),hflux(mn), &
             163                                     qflux(mn),qsfc(mn),zl(mn),ts(mn),                  &
             164                     ! for pm-evap.
             165                                     ss(mn),rld(mn),gfx(mn),                            &

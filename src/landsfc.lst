             811     1  pp    s             do i=1,nxj
             812     2   p    m              if(flag(i))then
             813     2   pi   s              df1(i)=funcdf(smc(i,1),istyp(i),tsat,dfk)
             814     2   pi   s              xkt1(i)=funckt(smc(i,1),istyp(i),tsat,xktk)
             815     2   p    v              endif
             816     2   p    s              if(flag(i).and.stc(i,1).lt.t0c)then
             817     2   p    s              df1(i)=0.
             818     2   p    s              xkt1(i)=0.
             819     2   p    v              endif
             820     1               !
             821     2   p    s              if(flag(i))then
             822     2               !       tref(i)=0.75*tsat(istyp(i))
             823     2               !       twilt(i)=twlt(istyp(i))
             824     2               !       fx(i)=-2.*df1(i)*(smc(i,1)-0.23)/zsoil(i,1)-xkt1(i)
             825     2   p    s              tref(i)=smref(istyp(i))
             826     2   p    s              twilt(i)=smwlt(istyp(i))
             827     2   p    s              smcdry(i)=smdry(istyp(i))
             828     2   p    s              fx(i)=-2.*df1(i)*(smc(i,1)-smcdry(i))/zsoil(i,1)-xkt1(i)
             829     2   p    s              fx(i)=min(fx(i),ep(i)/hltm)
             830     2   p    s              fx(i)=max(fx(i),0.)
             831     2               !
             832     2               !       edir(i)=fx(i)*(1-sigmaf(i))*partlnd(i)
             833     2               !---another dir evap =(1-sigmaf)*ep*beta (mahfouf and noilhan 1991)
             834     2               !
             835     2   p    s              edir(i)=(1-sigmaf(i))*partlnd(i)*beta(i)*ep(i)/hltm
             836     2               
             837     2   p    v              endif
             838     1   p    v             enddo
             839                     !
             840                     ! et: transpiration from all levels of the soil
             841                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 86
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

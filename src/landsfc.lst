            1409                     
            1410                           function funckt(theta,ktype,tsat,xktk)
            1411                     !
            1412                     ! funckt : hydraulic conductivity (m/s)
            1413                     !
            1414                           parameter (ntype=9,ngrid=22)
            1415                           dimension xktk(ngrid,ntype),tsat(ntype)
            1416                           w = (theta / tsat(ktype)) * 20. + 1.
            1417                           kw = w
            1418                           kw = min(kw,21)
            1419                           kw = max(kw,1)
            1420                           funckt = xktk(kw,ktype)+(w-kw)*(xktk(kw+1,ktype)-xktk(kw,ktype))
            1421                           return
            1422                           end


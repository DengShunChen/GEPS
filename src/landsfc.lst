                                   <<< Loop-information  End >>>
             842     1  pp    v             do i=1,nxj
             843     2   p    v              if(flag(i))then
             844     2               !
             845     2   p    v              rcs = 1.
             846     2   p    v              rct = 1.
             847     2   p    v              rcq = 1.
             848     2               !
             849     2               !  resistance due to solar effect
             850     2               !
             851     2   p    v              ff  = .55* 2.* ss(i)/rgl(ivegtyp(i))
             852     2   p    v              rcs = (ff + rs(i)/rsmax(ivegtyp(i)))/(1.+ff)
             853     2   p    v              rcs = max(rcs, 0.0001)
             854     2               !
             855     2               !  resistance due to thermal effect
             856     2               !
             857     2               !         rct = 1. - .0016 * (topt - ta(i)) ** 2
             858     2               !         rct = max(rct,.0001)
             859     2               !
             860     2               !  resistance due to humidity
             861     2               !
             862     2               !         rcq = 1. / (1. + hs(ivegtyp(i)) * (qs1(i) - qt(i,kk)))
             863     2               !         rcq = max(rcq,.0001)
             864     2               !
             865     2               !  compute resistance without the effect of soil moisture
             866     2               !
             867     2   p    v               rs(i) = rs(i) / (rcs * rct * rcq)
             868     2   p    v              endif
             869     1               !
             870     2   p    v              if(flag(i))then
             871     2   p    v              canfac(i)=(canopy(i)/scanop)**cfactr
             872     2   p    v              etpfac(i)=sigmaf(i)*(1.-canfac(i))/hltm
             873     2   p    v              gx(i)=(smc(i,1)-twilt(i))/(tref(i)-twilt(i))
             874     2   p    v              gx(i)=max(gx(i),0.)
             875     2   p    v              gx(i)=min(gx(i),1.)
             876     2               !
             877     2               ! resistance due to soil moisture deficit
             878     2               !
             879     2               !       rss = 1.0
             880     2   p    v              rss =gx(i)*(zsoil(i,1)/zsoil(i,km))
             881     2   p    v              rss =max(rss,0.0001)
             882     2   p    v              rsi(i)=rs(i)/rss
             883     2               !
             884     2               ! transpiration la monteith
             885     2               !
             886     2   p    v              termc(i)=delta(i)+rsmall(i)*(1.+rsi(i)*sfcw(i)*phih(i))
             887     2   p    v              etp(i)=(termb(i)+terma(i))/termc(i)
             888     2   p    v              et(i,1)=etp(i)*etpfac(i)*partlnd(i)
             889     2               !
             890     2   p    v              endif
             891     1   p    v             enddo
             892                     !
             893     1                      do k=2,km
                                   <<< Loop-information Start >>>

                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      land, zsoil, ocean
                                   <<< Loop-information  End >>>
             350     2  pp    v             do i=1,nxj
             351     3   p    v             if(ocean(i))then
             352     3   p    v              zsoil(i,k)=0.
             353     3   p    v             elseif(land(i))then
             354     3   p    v              zsoil(i,k)=zsoil(i,k-1)+(-2.-zsoil(i,1))/(km-1)
             355     3   p    v             else

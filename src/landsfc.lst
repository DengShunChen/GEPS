                                   <<<      drain, canfac, etpfac, fx, rhscnpy, gfx
                                   <<<      snomt, etp, ep, evap, ec, edir
                                   <<< Loop-information  End >>>
             372     1  pp    v            do i = 1,nxj
             373     1   p    v              edir(i) = 0.
             374     1   p    v              ec(i) = 0.
             375     1   p    v              evap(i) = 0.
             376     1   p    v              ep(i) = 0.

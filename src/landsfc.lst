             901     3               !
             902     3               !       rss = 1.
             903     3   p    v              rss =gx(i)*(zsoil(i,k)-zsoil(i,k-1))/zsoil(i,km)
             904     3   p    v              rss =max(rss,1.e-6)
             905     3   p    v              rsi(i)=rs(i)/rss
             906     3               !

                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             894     2  pp    v              do i=1,nxj
             895     3   p    v              if(flag(i))then
             896     3   p    v              gx(i)=(smc(i,k)-twilt(i))/(tref(i)-twilt(i))
             897     3   p    v              gx(i)=max(gx(i),0.)
             898     3   p    v              gx(i)=min(gx(i),1.)
             899     3               !

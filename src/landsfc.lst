             908     3               !
             909     3   p    v              termc(i)=delta(i)+rsmall(i)*(1.+rsi(i)*sfcw(i)*phih(i))
             910     3   p    v              etp(i)=(termb(i)+terma(i))/termc(i)
             911     3   p    v              et(i,k)=etp(i)*etpfac(i)*partlnd(i)
             912     3   p    v              endif
             913     2   p    v              enddo
             914     1                      enddo
             915                     !
             916                     ! ec: canopy re-evaporation
             917                     !
                                   <<< Loop-information Start >>>

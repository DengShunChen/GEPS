                                   <<<      flag, canopy, canfac, sigmaf, etpfac
                                   <<<      twilt, tref, smc, gx, zsoil, ivegtyp, ss
                                   <<<      rs, rsi, sfcw
                                   <<<    PREFETCH(SOFT) : 18
                                   <<<     SEQUENTIAL : 18
                                   <<<      partlnd: 2, phih: 2, rsmall: 2, delta: 2
                                   <<<      termc: 2, termb: 2, terma: 2, etp: 2

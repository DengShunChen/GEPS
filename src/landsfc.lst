             383     1   p    v              canfac(i) = 0.
             384     1   p    v              drain(i) =0.
             385     1   p    v            enddo
             386                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, twork
                                   <<< Loop-information  End >>>
             387     1  pp   2v            do i=1,nxj
             388     1   p   2v            twork(i)=tt(i,kk)*pk(i,kk)
             389     1   p   2v            enddo
             390                           call qsatq(nxj,twork,p1,qs1)
             391                           call qsatq(nxj,tsurf,ps,qs0)
             392                     !
             393                     ! define surfce specific humidity
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 223
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.74, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsfc, beta, istyp, smc, qt, qs0, ocean
                                   <<< Loop-information  End >>>
             394     1  pp    v            do i=1,nxj
             395     2   p    v            if(ocean(i).or. istyp(i).eq.0)then
             396     2   p    v            qsfc(i)=qs0(i)
             397     2   p    v            else
             398     2   p    v            beta(i)=(smc(i,1)-smwlt(istyp(i)))/(smref(istyp(i))-smwlt(istyp(i)))
             399     2   p    v            qsfc(i)=beta(i)*qs0(i)+(1.-beta(i))*qt(i,kk)
             400     2   p    v            qsfc(i)=min(qs0(i),qsfc(i) )
             401     2   p    v            endif
             402     1   p    v            enddo
             403                     !
             404                     !
             405                     !           charnock's relation for surface roughness over oceans
             406                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.58, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ustar, vt, ocean, ut, sfcw, z0
                                   <<< Loop-information  End >>>
             407     1  pp    v            do 100 i = 1, nxj
             408     2   p    v            if ( ocean(i) )  then
             409     2   p    v               z0(i) = 0.032 *ustar(i)*ustar(i)/g
             410     2   p    v               z0(i)= max(1.5e-5,min(z0(i),0.01))
             411     2   p    v            endif
             412     1               !
             413     1               !
             414     1               !           compute surface wind
             415     1               !
             416     1   p    v            sfcw(i)= max( 1.0e-2,sqrt( ut(i,kk)*ut(i,kk)+vt(i,kk)*vt(i,kk)))
             417     1   p    v        100 continue
             418                     !
             419                     !           compute surface wind
             420                     !
             421                     !------------------------------------------------------------
             422                     ! for ocean
             423                     !
             424                     !           iterate 3 times to match u*, t*, q*, and z/l
             425                     !
             426                     !
             427     1                     do  it1 = 1, 3
             428     1               !
             429     1               !           charnock's relation for surface roughness over oceans
             430     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, hgt, ustar, qstar, tstar, sfcw, zl
                                   <<<      vt, wv, ut, wu, ocean, z0, qt, qsfc, wq
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      tg: 2, pk2: 2, wt: 2, phih: 2, phim: 2
                                   <<<      zsz0: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 6
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             431     2  pp    v            do  i = 1, nxj
             432     3   p    v            if ( ocean(i) )  then
             433     3               !
             434     3   p    v               z0(i) = 0.032 *ustar(i)*ustar(i)/g
             435     3   p    v               z0(i)= max(1.5e-5,min(z0(i),0.01))
             436     3   p    v            endif
             437     2               !
             438     2               !
             439     2               !
             440     2               !           compute z/l
             441     2               !
             442     2               !           limit minimum depth of surface layer
             443     2               !           (saved in zsz0) for surface flux calculation
             444     2               !
             445     2               !
             446     2   p    v            g04 = g*0.4
             447     2   p    v            zsz0(i) = max(10.0,hgt(i,kk))
             448     2   p    v            zl(i) = g04*zsz0(i)*tstar(i)*(1.+0.61*qstar(i)) /   &
             449     2                             (tt(i,kk)*ustar(i)*ustar(i))
             450     2   p    v            zl(i)= max(-2.0,min(zl(i),2.0))
             451     2               !
             452     2               !
             453     2               !           compute phi functions  (see businger 1973, or paulson 1970)
             454     2               !
             455     2   p    v            pihalf = 3.141592654 * 0.5
             456     2               !
             457     3   p    v            if(zl(i) .lt. 0.0) then
             458     3               !ibm        xx1 = exp(0.25*log(1.0 - 15.0*zl(i)))
             459     3               !ibm        phim(i) = 2.0*log(0.5*(1.0+xx1)) + log(0.5*(1.0+xx1*xx1))
             460     3               !ibm    1                    - 2.0*atan(xx1) + pihalf
             461     3   p    v               xx1 = sqrt(sqrt(1.0 - 15.0*zl(i)))
             462     3   p    v               phim(i) = log(((0.5*(1.0+xx1))**2)*(0.5*(1.0+xx1*xx1)))  &
             463     3                                         - 2.0*atan(xx1) + pihalf
             464     3   p    v               phih(i) = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl(i))))
             465     3   p    v            else
             466     3   p    v               phim(i) = -4.7  * zl(i)
             467     3   p    v               phih(i) = -6.35 * zl(i)
             468     3   p    v            endif
             469     2               !
             470     2   p    v            zsz0(i) = log(zsz0(i)/z0(i))
             471     2   p    v            phim(i) = zsz0(i) - phim(i)
             472     2   p    v            phih(i) = zsz0(i) - phih(i)
             473     2   p    v            phim(i)= max(phim(i),1.0e-3)
             474     2   p    v            phih(i)= max(phih(i),1.0e-3)
             475     2               !
             476     2               !     compute new ut, vt, tt, and qt for ustar, tstar, qstar updates
             477     2               !     using crank-nicolson (bl=0.5) time scheme for weak forcing or
             478     2               !        or backward (bl=1.) time scheme for strong forcing
             479     2               !
             480     2   p    v            yy1   = dt*ustar(i) * ustar(i) / (2.0*hgt(i,kk)*sfcw(i))
             481     2   p    v            btest = 0.5 + (yy1-1.0)*0.5
             482     2   p    v            bl    = max (0.5, min (1.0, btest) )
             483     2   p    v            al    = 1.0 - bl
             484     2   p    v            wu(i) = ut(i,kk) * (1.0-al*yy1) / (1.0+bl*yy1)
             485     2   p    v            wv(i) = vt(i,kk) * (1.0-al*yy1) / (1.0+bl*yy1)
             486     2   p    v            xx1    = 0.4*dt*ustar(i) / (0.74*2.0*hgt(i,kk)*phih(i))
             487     2   p    v            wt(i) = ( tt(i,kk)*(1.0-al*xx1)+xx1*tg(i)/pk2(i,kk) )/(1.0+bl*xx1)
             488     2   p    v            wq(i) = ( qt(i,kk)*(1.0-al*xx1) + xx1*qsfc(i) ) / (1.0+bl*xx1)
             489     2               !
             490     2               !     update ustar, tstar and qstar
             491     2               !
             492     2               ! phon-ju
             493     2               ! add blending for stability
             494     2               !
             495     2   p    v            wu(i)=0.5*(ut(i,kk)+wu(i))
             496     2   p    v            wv(i)=0.5*(vt(i,kk)+wv(i))
             497     2   p    v            wt(i)=0.5*(tt(i,kk)+wt(i))
             498     2   p    v            wq(i)=0.5*(qt(i,kk)+wq(i))
             499     2               ! add over
             500     2   p    v            sfcw(i) = max (1.0e-2, sqrt( wu(i)*wu(i) + wv(i)*wv(i) ))
             501     2   p    v            ustar(i) = 0.4*sfcw(i) / phim(i)
             502     2   p    v            tstar(i) = 0.4*        (wt(i)-tg(i)/pk2(i,kk))  /(0.74*phih(i))
             503     2   p    v            qstar(i) = 0.4*        (wq(i)-qsfc(i))/(0.74*phih(i))
             504     2   p    v            ustar(i)= max(ustar(i),1.0e-7)
             505     2   p    v            ustar(i)= min(ustar(i),10.000)
             506     2   p    v            tstar(i)= min(tstar(i),50.00)
             507     2   p    v            qstar(i)= min(qstar(i),5.000)
             508     2               !
             509     2   p    v            enddo
             510     1                     enddo
             511                     !---- iteration end
             512                     !
             513                     !ccc for output of t2, u10 and v10
             514                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, hgt, rosfc, wt1, phim, phih, zl, z0
                                   <<<      wv, wu, u10, v10, qsfc, wq, wt, q2
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      pk2: 2, tg: 2, t2: 2
                                   <<< Loop-information  End >>>
             515     1  pp    v            do i=1,nxj
             516     1               !
             517     1   p    v            zl2=zl(i)*2./hgt(i,kk)
             518     1   p    v            zl10=zl(i)*10./hgt(i,kk)
             519     2   p    v            if(zl(i) .lt. 0.0) then
             520     2               !ibm        xx10 = exp(0.25*log(1.0 - 15.0*zl10))
             521     2               !ibm        phim10 = 2.0*log(0.5*(1.0+xx10)) + log(0.5*(1.0+xx10*xx10))
             522     2               !ibm    1                    - 2.0*atan(xx10) + pihalf
             523     2   p    v               xx10 = sqrt(sqrt(1.0 - 15.0*zl10))
             524     2   p    v               phim10 = log(((0.5*(1.0+xx10))**2)*(0.5*(1.0+xx10*xx10)))   &
             525     2                                         - 2.0*atan(xx10) + pihalf
             526     2   p    v               phih2 = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl2)))
             527     2   p    v            else
             528     2   p    v               phim10 = -4.7  * zl10
             529     2   p    v               phih2 = -6.35 * zl2
             530     2   p    v            endif
             531     1   p    v            phim10 =log( 10./z0(i)) - phim10
             532     1   p    v            phih2 =log( 2./z0(i)) - phih2
             533     1   p    v            phim10= max(phim10,1.0e-3)
             534     1   p    v            phih2= max(phih2,1.0e-3)
             535     1               !
             536     1   p    v            v10(i)=wv(i)*phim10/phim(i)
             537     1   p    v            u10(i)=wu(i)*phim10/phim(i)
             538     1               !
             539     1   p    v            q2(i)=qsfc(i)*(1.-phih2/phih(i))+wq(i)*phih2/phih(i)
             540     1   p    v            t2(i)=tg(i)/pk2(i,kk)*(1.-phih2/phih(i))+wt(i)*phih2/phih(i)
             541     1               !
             542     1               ! convert t2 from potential temp. to temp
             543     1   p    v            p2=(ps(i)*100.-rosfc(i)*g*2.)/100.
             544     1   p    v            wt1(i)=p2
             545     1   p    v            t2(i)=t2(i)*(p2/1000.)**xkapa
             546     1               !f    t2(i)=t2(i)*exp(xkapa*log(p2/1000.))
             547     1               
             548     1               ! do transfer from cwb-sfc to match ncep-sfc
             549     1   p    v            phih(i)=0.4*0.4/0.74/phim(i)/phih(i)
             550     1   p    v            phim(i)=0.4*0.4/phim(i)/phim(i)
             551     1               !
             552     1   p    v            enddo
             553                     !
             554                           call qsatq( nxj, t2, wt1, wt2)
             555                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q2, wt2, rh2
                                   <<< Loop-information  End >>>
             556     1  pp   2v            do i=1,nxj
             557     1   p   2v             q2(i)=min(wt2(i),q2(i))
             558     1   p   2v             rh2(i)=q2(i)/wt2(i)
             559     1   p   2v            enddo
             560                     !
             561                     !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
             562                     !
             563                     ! surface layer for land or ice
             564                     !
             565                     !     refer to ncep
             566                     !
             567                     !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
             568                     !
             569                     !---- ncepsfc
             570     1                     if(ncepsfc)then
             571     1               !
             572     2                     do  i=1,nxj
             573     3                     if(.not. ocean(i))then
             574     3                     zsz0(i) = max(10.0,hgt(i,kk))
             575     3                     wt1(i)=tt(i,kk)*pk2(i,kk)*(1.+0.61*qt(i,kk))
             576     3                     wt2(i)=tg(i)*(1.+0.61*qsfc(i))
             577     3                     rb(i) = g*zsz0(i)*( wt1(i)-wt2(i))/(0.5*(wt1(i)+wt2(i)))  &
             578     3                             /(sfcw(i)*sfcw(i))
             579     3               !
             580     3               !
             581     3               !  compute stability indices (rb and hlinf)
             582     3               !
             583     3                       z0max(i) = min(z0(i),hgt(i,kk))
             584     3                       ztmax(i) = z0max(i)
             585     4                       if(ocean(i)) then
             586     4                         restar(i) = ustar(i) * z0max(i) / vis
             587     4                         restar(i) = max(restar(i),.000001)
             588     4               !         restar(i) = alog(restar(i))
             589     4               !         restar(i) = min(restar(i),5.)
             590     4               !         restar(i) = max(restar(i),-5.)
             591     4               !         rat(i) = aa1 + bb1 * restar(i) + cc1 * restar(i) ** 2
             592     4               !         rat(i) = rat(i) / (1. + bb2 * restar(i)
             593     4               !    &                       + cc2 * restar(i) ** 2)
             594     4               ! rat taken from zeng,zhao and dickinson 1997
             595     4               !ibm      rat(i) = 2.67*restar(i)**.25-2.57
             596     4                         rat(i) = 2.67*sqrt(sqrt(restar(i)))-2.57
             597     4                         rat(i) = min(rat(i),7.)
             598     4                         ztmax(i) = z0max(i) * exp(-rat(i))
             599     4                       endif
             600     3               !
             601     3                       dtv(i) = wt1(i) - wt2(i)
             602     3                       adtv(i) = abs(dtv(i))
             603     3                       adtv(i) = max(adtv(i),.001)
             604     3                       dtv(i) = sign(1.,dtv(i)) * adtv(i)
             605     3                       rb(i) = g * dtv(i) * hgt(i,kk)/ (.5 * (wt1(i) + wt2(i))  &
             606     3                               * sfcw(i) * sfcw(i))
             607     3                       rb(i) = max(rb(i),-5000.)
             608     3                       fm(i) = log((z0max(i)+hgt(i,kk)) / z0max(i))
             609     3                       fh(i) = log((ztmax(i)+hgt(i,kk)) / ztmax(i))
             610     3                       hlinf(i) = rb(i) * fm(i) * fm(i) / fh(i)
             611     3               !
             612     3               !
             613     3               !  stable case
             614     3               !
             615     3               !
             616     4                       if(dtv(i).ge.0.) then
             617     4                         hl1(i) = hlinf(i)
             618     4                       endif
             619     4                       if(dtv(i).ge.0..and.hlinf(i).gt..25) then
             620     4                         hl0inf = z0max(i) * hlinf(i) / hgt(i,kk)
             621     4                         hltinf = ztmax(i) * hlinf(i) / hgt(i,kk)
             622     4                         aa = sqrt(1. + 4. * alpha * hlinf(i))
             623     4                         aa0 = sqrt(1. + 4. * alpha * hl0inf)
             624     4                         bb = aa
             625     4                         bb0 = sqrt(1. + 4. * alpha * hltinf)
             626     4                         pm(i) = aa0 - aa + log((aa + 1.) / (aa0 + 1.))
             627     4                         ph(i) = bb0 - bb + log((bb + 1.) / (bb0 + 1.))
             628     4                         fms = fm(i) - pm(i)
             629     4                         fhs = fh(i) - ph(i)
             630     4                         hl1(i) = fms * fms * rb(i) / fhs
             631     4                       endif
             632     3               !
             633     3               !  second iteration
             634     3               !
             635     3               !
             636     4                       if(dtv(i).ge.0.) then
             637     4                         hl0 = z0max(i) * hl1(i) /hgt(i,kk)
             638     4                         hlt = ztmax(i) * hl1(i) /hgt(i,kk)
             639     4                         aa = sqrt(1. + 4. * alpha * hl1(i))
             640     4                         aa0 = sqrt(1. + 4. * alpha * hl0)
             641     4                         bb = aa
             642     4                         bb0 = sqrt(1. + 4. * alpha * hlt)
             643     4                         pm(i) = aa0 - aa + log((aa + 1.) / (aa0 + 1.))
             644     4                         ph(i) = bb0 - bb + log((bb + 1.) / (bb0 + 1.))
             645     4               !
             646     4               !         hl110(i) = hl1(i) * 10. /hgt(i,kk)
             647     4               !         aa = sqrt(1. + 4. * alpha * hl110(i))
             648     4               !         pm10(i) = aa0 - aa + log((aa + 1.) / (aa0 + 1.))
             649     4               !         hl12(i) = hl1(i) * 2. /hgt(i,kk)
             650     4               !         aa = sqrt(1. + 4. * alpha * hl12(i))
             651     4               !         bb = sqrt(1. + 4. * alpha * hl12(i))
             652     4               !         ph2(i) = bb0 - bb + log((bb + 1.) / (bb0 + 1.))
             653     4                       endif
             654     3               !
             655     3               !  unstable case
             656     3               !
             657     3               !
             658     3               !  check for unphysical obukhov length
             659     3               !
             660     3               !
             661     4                       if(dtv(i).lt.0.) then
             662     4                         olinf(i) = hgt(i,kk) / hlinf(i)
             663     5                         if(abs(olinf(i)).le.50. * z0max(i)) then
             664     5                           hlinf(i) = -hgt(i,kk) / (50. * z0max(i))
             665     5                         endif
             666     4                       endif
             667     3               !
             668     3               !
             669     3               !  get pm and ph
             670     3               !
             671     3               !
             672     4                       if(dtv(i).lt.0..and.hlinf(i).ge.-.5) then
             673     4                         hl1(i) = hlinf(i)
             674     4                         pm(i) = (a0 + a1 * hl1(i)) * hl1(i)                    &
             675     4                                 / (1. + b1 * hl1(i) + b2 * hl1(i) * hl1(i))
             676     4                         ph(i) = (a0p + a1p * hl1(i)) * hl1(i)                  &
             677     4                                 / (1. + b1p * hl1(i) + b2p * hl1(i) * hl1(i))
             678     4                       endif
             679     4                       if(dtv(i).lt.0.and.hlinf(i).lt.-.5) then
             680     4                         hl1(i) = -hlinf(i)
             681     4               !ibm         pm(i) = log(hl1(i)) + 2. * hl1(i) ** (-.25) - .8776
             682     4               !ibm         ph(i) = log(hl1(i)) + .5 * hl1(i) ** (-.5) + 1.386
             683     4                         hl1x=sqrt(hl1(i))
             684     4                         pm(i) = log(hl1(i)) + 2./(sqrt(hl1x)) - .8776
             685     4                         ph(i) = log(hl1(i)) + .5/hl1x + 1.386
             686     4                       endif
             687     3               !
             688     3               !  finish the exchange coefficient computation to provide fm and fh
             689     3               !
             690     3               !
             691     3                       fm(i) = fm(i) - pm(i)
             692     3                       fh(i) = fh(i) - ph(i)
             693     3               !       fm10(i) = fm10(i) - pm10(i)
             694     3               !       fh2(i) = fh2(i) - ph2(i)
             695     3               !
             696     3                       phim(i) = ca * ca / (fm(i) * fm(i))
             697     3                       phih(i) = ca * ca / (fm(i) * fh(i))
             698     3                       ustar(i) = sqrt(phim(i) * sfcw(i) * sfcw(i))
             699     3               !
             700     3                      endif
             701     2                     enddo
             702     1               !
             703     2                     do i=1,nxj
             704     3                     if(.not. ocean(i))then
             705     3                     yy1   =dt*ustar(i)*ustar(i) / (2.0*hgt(i,kk)*sfcw(i))
             706     3                     btest = 0.5 + (yy1-1.0)*0.5
             707     3                     bl    = max (0.5, min (1.0, btest) )
             708     3                     al    = 1.0 - bl
             709     3               
             710     3                     wu(i)=ut(i,kk) * (1.-al*yy1) / (1.+bl*yy1)
             711     3                     wv(i)=vt(i,kk) * (1.-al*yy1) / (1.+bl*yy1)
             712     3                     endif
             713     2                     enddo
             714     1               !
             715     2                     do i=1,nxj
             716     3                     if(.not. ocean(i))then
             717     3                     wu(i) = 0.5*(wu(i)+ut(i,kk))
             718     3                     wv(i) = 0.5*(wv(i)+vt(i,kk))
             719     3                     sfcw(i) =max( 1.0e-2,sqrt( wu(i)*wu(i)+wv(i)*wv(i) ))
             720     3                     ustar(i)=sqrt(phim(i)*sfcw(i)*sfcw(i))
             721     3                     endif
             722     2                     enddo
             723     1               !
             724     1                     endif
             725                     !---- ncepsfc end
             726                     !
             727                     !---------------------------------------------------------
             728                     !  define roughness and evaporation  over ocean
             729                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 263
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.73, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ustar, sfcw, wq, phih, qsfc, ocean
                                   <<<      rosfc, z0, evap
                                   <<< Loop-information  End >>>
             730     1  pp    v            do i=1,nxj
             731     2   p    v            if(ocean(i))then
             732     2   p    v             z0(i) = 0.032 *ustar(i)*ustar(i)/g
             733     2   p    v             z0(i)= max(1.5e-5,min(z0(i),0.01))
             734     2               !
             735     2   p    v             evap(i)=rosfc(i)*hltm*phih(i)*sfcw(i)*(qsfc(i)-wq(i))
             736     2   p    v            endif
             737     1               
             738     1   p    v            enddo
             739                     !
             740                     ! ...................................
             741                     ! prepare for penman-monteith method. to calculate potential evaporation
             742                     ! ...................................
             743                     ! change wt from potential tmp. to temperature
             744                     !
             745                     !
             746                     ! compute soil/snow/ice heat flux(gfx)
             747                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 169
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gfx, land
                                   <<< Loop-information  End >>>
             748     1  pp    s            do i=1,nxj
             749     1   p    v            gfx(i)=0.
             750     2   p    m            if(land(i))then
             751     2   p    s             smcz(i)=0.5*(smc(i,1)+0.2)
             752     2   pi   s             dft0(i)=xtsoil(smcz(i),istyp(i),tsat,dfkt)
             753     2   p    s            elseif(ice(i))then
             754     2   p    s             dft0(i)=2.2
             755     2   p    v            endif
             756     1   p    v            enddo
             757                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 154
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 40, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gfx, flagsnw, zsoil, dft0, stsoil, tsurf
                                   <<<      snr, factsnw, twork, ocean
                                   <<< Loop-information  End >>>
             758     1  pp    v             do i=1,nxj
             759     2   p    v             if(.not. ocean(i))then
             760     3   p    v              if(flagsnw(i))then
             761     3   p    v               tflx=min(twork(i),tsurf(i))
             762     3   p    v               gfx(i)=-dfsnow*(tflx-stsoil(i,1))/             &
             763     3                               (factsnw(i)*max(snr(i)/1000.,0.001))
             764     3   p    v              else
             765     3   p    v               gfx(i)=-dft0(i)*(tsurf(i)-stsoil(i,1))/(-0.5*zsoil(i,1))
             766     3   p    v              endif
             767     2   p    v             gfx(i)=max(gfx(i),-200.)
             768     2   p    v             gfx(i)=min(gfx(i),200.)
             769     2   p    v             endif
             770     1   p    v             enddo
             771                     !
             772                     ! calculate potential evaporation: ep(w/m2)
             773                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 131
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ocean, twork, t12, t14, tt, pk2, ta
                                   <<<      phih, sfcw, rosfc, rch, rld, gfx, ss
                                   <<<      rnet, rsmall
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      qt: 2, qs1: 2, delta: 2, termb: 2
                                   <<<      terma: 2, ep: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             774     1  pp    v            do i=1,nxj
             775     2   p    v            if(.not.ocean(i))then
             776     2   p    v            t12(i)=twork(i)*twork(i)
             777     2   p    v            t14(i)=t12(i)*t12(i)
             778     2               !
             779     2   p    v            ta(i)=tt(i,kk)*pk2(i,kk)
             780     2               !
             781     2   p    v            rch(i)=rosfc(i)*cp*phih(i)*sfcw(i)
             782     2               !
             783     2               ! rnet=ss+ld-stbo*t14-gfx-rho*cp*ch*v*(t1-ta)
             784     2               !
             785     2               !     gfx(i)=-rosfc(i)*cp*ustar(i)*tstar(i)*0.1
             786     2   p    v            rnet(i)=ss(i)+rld(i)-stbo*t14(i)+gfx(i)-rch(i)*(twork(i)-ta(i))
             787     2               !
             788     2               ! rsmall=4*sigma*t1**3/rch +1
             789     2               !
             790     2   p    v            rsmall(i)=4.*stbo*twork(i)*t12(i)/rch(i) +1.
             791     2               !
             792     2               ! delta= hltm/cp *dqs/dt
             793     2               !
             794     2   p    v            delta(i)=hltm/cp*(0.622* 2.5e+6 *qs1(i))/(r*t12(i))
             795     2               !
             796     2   p    v            terma(i)=rnet(i)*delta(i)
             797     2   p    v            termb(i)=rsmall(i)*hltm*(rch(i)/cp)*(qs1(i)-qt(i,kk))
             798     2               !
             799     2   p    v            ep(i)=termb(i)+terma(i)
             800     2   p    v            ep(i)=ep(i)/(rsmall(i)+delta(i))
             801     2   p    v            endif
             802     1   p    v            enddo
             803                     !
             804                     ! actual evaporation over land in three parts: edir, et, and ec
             805                     !
             806                     ! edir :direct evaporation from soil
             807                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ep, land, flag
                                   <<< Loop-information  End >>>
             808     1  pp   2v             do i=1,nxj

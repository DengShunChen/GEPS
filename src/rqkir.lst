 External subroutine subprogram "rqkir"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine rqkir ( nr,nx,lev,ign,ozon,coefkr,pa,ta,fkg )
               2                     !
               3                     !#####################################################################
               4                     !
               5                     !  compute the absorption coefficient at the temperature t for the
               6                     !  19 pressures by
               7                     !        ln k = a + b * ( t - tcon ) + c * ( t - tcon ) ** 2
               8                     !  and the absorption coefficient at conditions other than those 19
               9                     !  pressures is interpolated linearly with pressure (Fu, 1991).
              10                     !  ( note : tcon = 250 for ozone, otherwise, tcon = 245 )
              11                     !
              12                     !  ++ input variables :
              13                     !     ign    : total given g-value intervals
              14                     !     ozon   : logical constant for checking if it is ozone absorption
              15                     !     coefkr : coefficients to calculate the absorption coefficients
              16                     !              i.e. the above's a, b, and c
              17                     !
              18                     !  ++ output variables :
              19                     !     fkg    : absorption coefficients
              20                     !
              21                     !######################################################################
              22                     !
              23                           implicit  none
              24                     
              25                           integer   nr,nx,lev,ign
              26                     
              27                           logical   ozon
              28                     
              29                           real      coefkr(3,19,ign),pa(nx*lev),ta(nx*lev),fkg(nx*lev,ign)
              30                     !
              31                     !  local arrays
              32                     !
              33                           real      taa(nx*lev),paa(nx*lev)
              34                           real      stanp(19)
              35                     !
              36                           data stanp / 0.251, 0.398, 0.631, 1.000, 1.58, 2.51,     &
              37                                        3.98, 6.31, 10.0, 15.8, 25.1, 39.8, 63.1,   &
              38                                        100.0, 158.0, 251.0, 398.0, 631.0, 1000.0 /
              39                     
              40                           integer   ltop,i,j,ig,jd,jj
              41                           real      tcon,t1,t2,x1,x2
              42                     !
              43                           ltop = 9
              44                     !
              45     1                     if ( ozon ) then
              46     1                       tcon = 250.
              47     1                     else
              48     1               	tcon = 245.
              49     1                     end if
              50                     !
              51                     !  the below polynomial function valid only for 200 to 300 K
              52                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 327
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.14, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pa, paa, ta, taa
                                   <<< Loop-information  End >>>
              53     1  pp   2v            do 50 i = 1, nr*lev
              54     1   p   2v            taa(i) = min( 300., max( 200., ta(i) ) )
              55     1   p   2v            paa(i) = min( 999.999, max( stanp(ltop)+0.001, pa(i) ) )
              56     1   p   2v         50 continue
              57                     !
              58                           jd = 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              59     1  pp                 do 500 ig = 1, ign
              60     2   p                  do 400 j = ltop, 19, jd
              61     2   p                  jj = j + jd
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taa, paa
                                   <<< Loop-information  End >>>
              62     3   p    s              do 300 i = 1, nr*lev
              63     3   p    v              t1 = (taa(i)-tcon)
              64     3   p    v              t2 = t1 * t1
              65     4   p    m              if( paa(i).gt.stanp(j) .and. paa(i).le.stanp(jj) ) then
              66     4   p    s       	x1 = coefkr(1,j,ig)+coefkr(2,j,ig)*t1+coefkr(3,j,ig)*t2
              67     4   p    s       	x2 = coefkr(1,jj,ig)+coefkr(2,jj,ig)*t1+coefkr(3,jj,ig)*t2
              68     4   p    s      	fkg(i,ig) = exp ( x1 + ( x2-x1 ) / ( stanp(jj)-stanp(j) )  &
              69     4                                   * ( paa(i)-stanp(j) ) )
              70     4   p    v              end if
              71     3   p    v        300   continue
              72     2   p             400  continue
              73     1   p             500 continue
              74                     !
              75                     !ccc----
              76                     !     do 200 ig = 1, ign
              77                     !     do 100  i = 1, nr*lev
              78                     !     ll = int( ( log10(pa(i)/1000.)/0.2 )+19.0001 )
              79                     !     ll = min(ll,18)
              80                     !org  t1 = (ta(i)-tcon)
              81                     !     t1 = (taa(i)-tcon)
              82                     !     t2 = t1 * t1
              83                     !     if ( ll .lt. 1 ) then
              84                     !       x1 = exp ( coefkr(1,1,ig) + coefkr(2,1,ig) * t1
              85                     !    1       + coefkr(3,1,ig) * t2 )
              86                     !       fkg(i,ig) = x1 * pa(i) / stanp(1)
              87                     !     else
              88                     !       x1 = exp ( coefkr(1,ll,ig) + coefkr(2,ll,ig)
              89                     !    1       * t1 + coefkr(3,ll,ig) * t2 )
              90                     !       x2 = exp ( coefkr(1,ll+1,ig) + coefkr(2,ll+1,ig)
              91                     !    1       * t1 + coefkr(3,ll+1,ig) * t2 )
              92                     !       fkg(i,ig) = x1 + ( x2 - x1 ) / ( stanp(ll+1) - stanp(ll) )
              93                     !    1              * ( pa(i) - stanp(ll) )
              94                     !     end if
              95                     ! 100 continue
              96                     ! 200 continue
              97                     !cc----
              98                           return
              99                           end


             611                           hours = hours + dtx_tau
             612     1                     if ( hours .gt. 24. .and. mod(hours,24.) .le. dtx_tau+0.0001 )  then
             613     1                        hours = mod ( hours,24.0 )
             614     1                        julian= julian + 1
             615     1                        if ( julian .gt. yrd ) julian = julian - yrd
             616     1                        doozon = .true.
             617     1                        doclxu = .true.
             618     1                     endif
             619                           leap = mod ( year , 4 )
             620                           yrd = 365
             621                           if ( leap .eq. 0 ) yrd = 366
             622                     !
             623                           icrad = frad*3600.0/dt + 0.0001 ! frad =1.0 set in block.f
             624                           iter  = tau*3600.0/dt  + 0.0001
             625                           uprad = .false.
             626                           if ( (mod(iter,icrad).eq.0) .or. (iter.eq.1) )  uprad = .true.
             627                           doozon = doozon .and. dorad
             628                           uprad  = uprad  .and. dorad

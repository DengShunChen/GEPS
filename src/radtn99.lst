 External subroutine subprogram "radtn99"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine radtn99 ( fluxcl,ozon,nxj,nx,lev,ncld,lvlw,julian    &
               2                                            , stbo,s0,g                                    &
               3                                            , cp,ptop,dsigma,sinl,cosz,alb,tg,curate,pst   &
               4                                            , pl,tt,qtx,o3lx,plcl,cumtop,ss,rs             &
               5                                            , asol_clr,olr_clr,ss_clr,rs_clr               &
               6                                            , dtrad,asr,alr,asr_clr,alr_clr                &
               7                                            , xsr,xlr,acld,aflxd,aflxu,il,ib,cof           &
               8                                            , sdpbl,ctot,rld,sld,chig,cmid,clow,asl,atl    &
               9                     !---------------------------------------------------------------------
              10                                            , afusl,afdsl,afuir,afdir                      &
              11                                            , afuslr,afdslr,afuirr,afdirr                  &
              12                                            , asl_clr,atl_clr,clds,rld_clr,sld_clr)
              13                     !######################################################################c
              14                     !                                                                      c
              15                     ! a. function:                                                         c
              16                     !  main radiation driver, does both long and short wave radiation      c
              17                     !  calculations.
              18                     !  solar radiation scheme is a two-scheme method and parameterizations
              19                     !  of gas absorption and cloud optical property are based on fu and liou
              20                     !  , jas 1993.
              21                     !  longwave radiation scheme is delta two and four-stream based on
              22                     !  work of Fu et.al. 1998.
              23                     !                                                                      c
              24                     ! b. common block specification:                                       c
              25                     !  none                                                                c
              26                     !                                                                      c
              27                     ! c. parameter specification:                                          c
              28                     !  none                                                                c
              29                     !                                                                      c
              30                     ! d. input/output variables                                            c
              31                     !  (1) input variables:                                                c
              32                     !
              33                     !  fluxcl: logical constant to perform cloud forcing calculation       c
              34                     !          if .T., perform calculation for both clear and cloudy skys
              35                     !          if .F., perform calculation only for cloudy sky
              36                     !  ozon  : logical constant to include ozon in sw/lw rad calculation   c
              37                     !  nx    : horizontal dimension of the model                           c
              38                     !  lev   : vertical layers of the model                                c
              39                     !  lvlw  : horizontal dimension for coarse resolution long wave calcu. c
              40                     !  julian: julian day ( julian = 1 for january 1 )                     c
              41                     !  stbo  : stefan-boltzman constant (5.669e-8)                         c
              42                     !  s0    : solar constant (1368.3)                                     c
              43                     !  g     : gravity constant (9.806)                                    c
              44                     !  cp    : air heat constant (1004.)                                   c
              45                     !  ptop  : model top pressure (mb) (must be > 0.0)                     c
              46                     !  dsigma(lev): sigma layer thickness                                    c
              47                     !  sinl  : sin of latitude of current ring                             c
              48                     !  cosz(nx): zenith angle at grid points                               c
              49                     !  alb(nx) : surface albedo                                            c
              50                     !  tg(nx)  : ground real temperature (k)                               c
              51                     !  curate(nx): cup precipitation rate (mm/day) -- cwb std units --     c
              52                     !  pst(nx): = (terrain pressure - ptop) (mb)                           c
              53                     !  pl(nx,lev) : pressure at prediction levels (mb)                     c
              54                     !  tt(nx,lev) : real temperature at prediction levels (k)              c
              55                     !  qt(nx,lev) : specific humidity at prediction levels (kg/kg)         c
              56                     !  o3l(nx,lev): ozone mixing ratio from climatology    (kg/kg)         c
              57                     !  plcl(nx)  : pressure at cloud bottom (mb)                           c
              58                     !  cumtop(nx): pressure at cloud top (mb)                              c
              59                     !  il(nx)    : address index for spline interp. (expand to fine grids) c
              60                     !  ib(lvlw)  : address index for compress to coarse grids              c
              61                     !  cof(lvlw,3): constant coefficients for spline interpolation         c
              62                     !
              63                     !  (2) output variables:                                               c
              64                     !  plcl(nx)  : total column solar radiation absorption (input changed) c
              65                     !  cumtop(nx): outgoing long wave radiation at model top (input changed)
              66                     !  ss(nx): net short wave flux down to ground surface (wat/m**2)       c
              67                     !  rs(nx): net long  wave flux up from ground surface (wat/m**2)       c
              68                     !  dtrad(nx,lev): total temp change due to radiation (k/day)           c
              69                     !  asr(lev): average temp change due to short wave radtn (k/day)       c
              70                     !  alr(lev): average temp change due to long  wave radtn (k/day)       c
              71                     !  xsr(lev): maximum heating     due to short wave radtn (k/day)       c
              72                     !  xlr(lev): maximum cooling     due to long  wave radtn (k/day)       c
              73                     !  acld(lev): average total cloud fraction assuming random overlap     c
              74                     !  aflxd(lev+2): average downward long wave flux (wat/m**2)            c
              75                     !  aflxu(lev+2): average upward   long wave flux (wat/m**2)            c
              76                     !
              77                     !  ** for clear-sky
              78                     !  asol_clr(nx), olr_clr(nx), ss_clr(nx), rs_clr(nx)
              79                     !  asr_clr(lev), alr_clr(lev)
              80                     !                                                                      c
              81                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              82                     !                                                                      c
              83                     !######################################################################c
              84                     !
              85                           use const, only: RTYPE
              86                     !
              87                           implicit none
              88                           integer, parameter :: ibsl = 11, ibir = 12
              89                     !
              90                           logical fluxcl,ozon
              91                           integer nxj,nx,lev,ncld,lvlw,julian
              92                           real    stbo,s0,cp,ptop
              93                     
              94                           real    cosz(nx),alb(nx),tg(nx),curate(nx),                      &
              95                                   pl(nx,lev),qt(nx,lev),o3l(nx,lev),plcl(nx),              &
              96                                   cumtop(nx),ss(nx),rs(nx),dtrad(nx,lev),asr(lev),alr(lev),&
              97                                   xsr(lev),xlr(lev),acld(lev),aflxd(lev+2),aflxu(lev+2),   &
              98                                   cof(lvlw,3),ctot(nx),chig(nx),cmid(nx),clow(nx),         &
              99                                   ttmp(nx,lev)
             100                     
             101                           integer il(nx),ib(lvlw)
             102                     
             103                           real(kind=RTYPE) qtx(nx,lev*ncld),o3lx(nx,lev),pst(nx),sdpbl(nx) &
             104                                   ,        dsigma(lev,2),sigma(lev+1,2),tt(nx,lev)
             105                     !
             106                     !  clear part
             107                     !
             108                           real    ss_clr(nx),rs_clr(nx),asol_clr(nx),olr_clr(nx), &
             109                                   asr_clr(lev),alr_clr(lev)
             110                     !
             111                     !     local work arrays
             112                     !
             113                           real    asl(nx,lev),atl(nx,lev),clds(nx,lev),fluxdd(nx,lev+3), &
             114                                   fluxuu(nx,lev+2)
             115                           real    wk1(nx),wk2(nx)
             116                           real    cvclds(nx,lev),cufrac(nx)
             117                     !
             118                     !  working arrays for new radiation scheme
             119                     !
             120                           real    pa(nx*lev),ta(nx*lev),wa(nx*lev),oa(nx*lev),tga(nx),  &
             121                                   clda(nx*lev),cufa(nx),clwca(nx*lev),ciwca(nx*lev),    &
             122                                   crea(nx*lev),cdea(nx*lev)
             123                           real    pu(nx*(lev+1)),u0(nx),as(nx,ibsl),ee(nx,ibir)
             124                           real    fusl(nx*(lev+1)),fdsl(nx*(lev+1)),fuslr(nx*(lev+1)),  &
             125                                   fdslr(nx*(lev+1)),fuir(nx*(lev+1)),fdir(nx*(lev+1)),  &
             126                                   fuirr(nx*(lev+1)),fdirr(nx*(lev+1))
             127                           real    asl_clr(nx,lev),atl_clr(nx,lev)
             128                           integer ibs(nx)
             129                     
             130                     !cmy----
             131                           real afusl(nx,lev+1),afdsl(nx,lev+1),afuslr(nx,lev+1),        &
             132                                afdslr(nx,lev+1),afuir(nx,lev+1),afdir(nx,lev+1),        &
             133                                afuirr(nx,lev+1),afdirr(nx,lev+1)
             134                     !cmy----
             135                     
             136                           real    clwc(nx,lev),ciwc(nx,lev),cre(nx,lev),cde(nx,lev),    &
             137                                   cldb(nx,lev)
             138                           real    qtr(nx,lev)
             139                     !
             140                     !  for soil model with the need to obtain surface downward ir flux
             141                     !
             142                           real    rld(nx),sld(nx)
             143                     !----------------------------------------------------------------------------
             144                     !  for clear part
             145                     !----------------------------------------------------------------------------
             146                           real    rld_clr(nx),sld_clr(nx)
             147                     !----------------------------------------------------------------------------
             148                     !
             149                           logical lwfull
             150                     
             151                           integer i,j,k,nxlev,nqt,ls,lhig,lmid,nsol,jk,jj,nb,nsn,nxjl,nrn
             152                           real    sinl,g,umn2o,umch4,umco2,fac,qtz,fac_o3,www,ptopc
             153                           real    cld_maxran,vmin,xxx,xim
             154                           real    cldmaxv
             155                     !
             156                           real    d2r,r2d,deg_ju,deg_lat,cosl2,arg
             157                     
             158                     !
             159                     ! --  ls: number of top levels in which no clouds are allowed
             160                     !
             161                           data ls /1/  ! don't change
             162                     !
             163                     !  for co2, ch4 and n2o, uniform mixing is assumed through the
             164                     !  atmosphere with concentrations of 330, 1.6 and  0.28 ppmv,
             165                     !  respectively.
             166                     !
             167                     !ccc  data umco2 / 330.0 /, umch4 / 1.6 /, umn2o / 0.28 /
             168                     !
             169                     !  increase the co2 concentrations for 330 to 360 based on IPCC report
             170                     !  ( ~375 ppm at the year of 2005 )
             171                     !  2008/10/7
             172                     
             173                           data umco2 / 360.0 /, umch4 / 1.6 /, umn2o / 0.28 /
             174                     !
             175                           nxlev= nx*lev
             176                           lwfull= lvlw.eq.nxj
             177                           fac= 86400.0*g/(cp*100.0)
             178                     !
             179                     !  compute sigma values at even levels
             180                     !
             181                           sigma(1,1) = 0.0
             182                           sigma(1,2) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.00, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dsigma, sigma
                                   <<< Loop-information  End >>>
             183     1   s   2s            do 130 k = 1, lev
             184     1   s   2s            sigma(k+1,1) = sigma(k,1) + dsigma(k,1)
             185     1   s   2s            sigma(k+1,2) = sigma(k,2) + dsigma(k,2)
             186     1   s   2s        130 continue
             187                     !
             188                     ! --- ensure qt > 1.0e-12 (i.e. positive specific humidity)
             189                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qtx, o3lx, qt, o3l, qtr
                                   <<< Loop-information  End >>>
             190     1  pp                 do 135 k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      o3lx, o3l, qt, qtr, qtx
                                   <<< Loop-information  End >>>
             191     2   p   2v            do 135 i = 1, nxj
             192     2   p   2v            qt(i,k) = max ( 1.0e-12, qtx(i,k) )
             193     2   p   2v            o3l(i,k)= max ( 1.0e-12, o3lx(i,k) )
             194     2   p   2v            qtr(i,k)= 0.
             195     1   p   2v        135 continue
             196                     !
             197     1                     if( ncld .ge. 2 )then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qtx, qtr
                                   <<< Loop-information  End >>>
             198     2  pp                 do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qtx, qtr
                                   <<< Loop-information  End >>>
             199     3   p   2v            do i = 1, nxj
             200     3   p   2v             qtr(i,k)= qtx(i,lev+k)
             201     3   p   2v            enddo
             202     2   p                 enddo
             203     1                     endif
             204                     !
             205                     !  avoid too much water vapor at upper layers
             206                     !  2002/10/31
             207                     !
             208                     !  modify this water vapor limit with an opposite direction
             209                     !  of setting a min amount for water vapor of upper layers
             210                     !  because that too much warm bias was found in summer
             211                     !  2008/10/7
             212                     !
             213                           nqt=0
             214                     !
             215     1                     if( nqt .eq. 2 )then
             216     1                       ttmp(:,:)=tt(:,:)
             217     1                       call qsatq_2d ( nxj,nx,lev,ttmp,pl,asl )
             218     2                       do k = 1, lev/2
             219     3                       do i = 1, nxj
             220     3               !jh          if( pl(i,k) .lt. 150. )then
             221     3               !jh          if( pl(i,k) .lt. 70. )then
             222     4                         if( pl(i,k) .lt. 50. )then
             223     4                           qtz = min( 5.e-6, asl(i,k)*0.2 )
             224     4                           qt(i,k) = max( qtz,  qt(i,k) )
             225     4                         endif
             226     3               !jh         if( pl(i,k) .lt. 50. ) qt(i,k) = min( 5.e-5, qt(i,k) )
             227     3                        if( pl(i,k) .lt. 30. ) qt(i,k) = min( 5.e-5, qt(i,k) )
             228     3                       enddo
             229     2                       enddo
             230     1                     endif
             231                     !
             232                     !  reduce o3 amount at the top layer
             233                     !  2002/10/31
             234                     !
             235                     !  modify the reducing factor for 0.5 to 0.8
             236                     !  2008/10/7
             237                     !
             238     1                     if(ncld.eq.2)then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      o3l
                                   <<< Loop-information  End >>>
             239     2  pp                   do k=1,8
             240     2   p                     fac_o3=k*0.1
             241     2   p                     if(fac_o3.le.0.3)fac_o3=0.3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      o3l
                                   <<< Loop-information  End >>>
             242     3   p   2v              do i = 1, nxj
             243     3               !         o3l(i,k) = o3l(i,1)*0.8
             244     3   p   2v               o3l(i,k) = o3l(i,k)*fac_o3
             245     3   p   2v              end do
             246     2   p                   end do
             247     1                     endif
             248                     !
             249                     !  initialize cloud optical parameters
             250                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ciwc, clwc, cde, cre
                                   <<< Loop-information  End >>>
             251        pp   2v            cre = 5.0
             252         p   2v            cde = 20.
             253         p   2v            clwc = 0.
             254         p   2v            ciwc = 0.
             255                     !
             256                     !  zero out arrays for clear parts
             257                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sld_clr, rld_clr, olr_clr, asol_clr
                                   <<<      rs_clr, ss_clr
                                   <<< Loop-information  End >>>
             258        pp   2v            ss_clr = 0.
             259         p   2v            rs_clr = 0.
             260         p   2v            asol_clr = 0.
             261         p   2v            olr_clr = 0.
             262                     !--------------------------------------------------------------------------
             263         p   2v            rld_clr = 0.
             264         p   2v            sld_clr = 0.
             265                     !--------------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      atl_clr, asl_clr
                                   <<< Loop-information  End >>>
             266        pp   2v            asl_clr = 0.

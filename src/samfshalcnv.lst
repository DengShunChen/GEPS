                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             458     2   s    s              do i=1,im
             459     3   p    v                if (cnvflg(i) .and. k <= kmax(i)-1) then
             460     3   p    v                  dz      = .5 * (zo(i,k+1) - zo(i,k))
             461     3   p    v                  dp      = .5 * (pfld(i,k+1) - pfld(i,k))
             462     3   s    s                  es      = 0.01 * fpvs(to(i,k+1))      ! fpvs is in pa
             463     3               !byl            call qsatq_cwb(1,to(i,k+1),pfld(i,k+1),es)
             464     3   s    s                  pprime  = pfld(i,k+1) + epsm1 * es
             465     3   s    s                  qs      = eps * es / pprime
             466     3   s    s                  dqsdp   = - qs / pprime
             467     3   s    s                  desdt   = es * (fact1 / to(i,k+1) + fact2 / (to(i,k+1)**2))
             468     3   p    v                  dqsdt   = qs * pfld(i,k+1) * desdt / (es * pprime)
             469     3   m    m                  gamma   = el2orc * qeso(i,k+1) / (to(i,k+1)**2)

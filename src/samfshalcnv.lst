             481     2   s    s              do i=1,im
             482     3   p    v                if (cnvflg(i) .and. k <= kmax(i)-1) then
             483     3   m    m                  qeso(i,k) = 0.01 * fpvs(to(i,k))      ! fpvs is in pa
             484     3               !byl            call qsatq_cwb(1,to(i,k),po(i,k),qeso(i,k))

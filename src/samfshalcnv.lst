             556     3   p    s                if(pdot(i) <= w4) then
             557     3   p    s                  tem = (pdot(i) - w4) / (w3 - w4)
             558     3   p    s                elseif(pdot(i) >= -w4) then
             559     3   p    s                  tem = - (pdot(i) + w4) / (w4 - w3)

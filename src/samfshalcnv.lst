             406     3   m    m                  qeso(i,k) = 0.01 * fpvs(to(i,k))      ! fpvs is in pa
             407     3               !byl            call qsatq_cwb(1,to(i,k),pfld(i,k),qeso(i,k))
             408     3   p    v                  qeso(i,k) = eps * qeso(i,k) / (pfld(i,k) + epsm1*qeso(i,k))
             409     3   p    v                  val1      =             1.e-8
             410     3   p    v                  qeso(i,k) = max(qeso(i,k), val1)
             411     3   p    v                  val2      =           1.e-10
             412     3   p    v                  qo(i,k)   = max(qo(i,k), val2 )

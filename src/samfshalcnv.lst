                                   <<<      t1, c0, c0t
                                   <<< Loop-information  End >>>
             263     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.71, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      c0, t1, c0t
                                   <<< Loop-information  End >>>
             264     2   p    v              do i = 1, im
             265     3   p    v                if(t1(i,k) > 273.16) then
             266     3   p    v                  c0t(i,k) = c0(i)
             267     3   p    v                else
             268     3   p    v                  tem = d0 * (t1(i,k) - 273.16)
             269     3   p    v                  tem1 = exp(tem)
             270     3   p    v                  c0t(i,k) = c0(i) * tem1
             271     3   p    v                endif
             272     2   p    v              enddo
             273     1   p                 enddo

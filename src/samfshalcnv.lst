             455                     !
             456                     !> - Calculate the temperature, water vapor mixing ratio, and pressure at interface levels.
             457     1                     do k = 1, km1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<<    SPILLS :

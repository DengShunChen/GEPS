            1077                     !     lhtrlw0  = present( htrlw0 )
            1078                     !     lflwprf  = present( flwprf )
            1079                     
            1080                     !     if (myrank .eq. 0) print *,' #### present (htrswb)=',lhtrswb
            1081                     !     if (myrank .eq. 0) print *,' #### present (htrsw0)=',lhtrsw0
            1082                     !     if (myrank .eq. 0) print *,' #### present (fswprf)=',lfswprf
            1083                     !     if (myrank .eq. 0) print *,' #### present (scmpsw)=',lscmpsw
            1084                     !     if (myrank .eq. 0) print *,' #### present (htrlwb)=',lhtrlwb
            1085                     !     if (myrank .eq. 0) print *,' #### present (htrlw0)=',lhtrlw0
            1086                     !     if (myrank .eq. 0) print *,' #### present (flwprf)=',lflwprf
            1087                     
            1088                     !
            1089                           lp1 = lm + 1               ! num of in/out levels
            1090                     
            1091                     !  --- ...  set local /level/layer indexes corresponding to in/out variables
            1092                     
            1093                           lmk = lm + ltp             ! num of local layers
            1094                           lmp = lmk + 1              ! num of local levels
            1095                     
            1096     1                     if ( lextop ) then
            1097     2                       if ( ivflip == 1 ) then    ! vertical from sfc upward
            1098     2                         kd = 0                   ! index diff between in/out and local
            1099     2                         kt = 1                   ! index diff between lyr and upper bound
            1100     2                         kb = 0                   ! index diff between lyr and lower bound
            1101     2                         lla = lmk                ! local index at the 2nd level from top
            1102     2                         llb = lmp                ! local index at toa level
            1103     2                         lya = lm                 ! local index for the 2nd layer from top
            1104     2                         lyb = lp1                ! local index for the top layer
            1105     2                       else                       ! vertical from toa downward
            1106     2                         kd = 1                   ! index diff between in/out and local
            1107     2                         kt = 0                   ! index diff between lyr and upper bound
            1108     2                         kb = 1                   ! index diff between lyr and lower bound
            1109     2                         lla = 2                  ! local index at the 2nd level from top
            1110     2                         llb = 1                  ! local index at toa level
            1111     2                         lya = 2                  ! local index for the 2nd layer from top
            1112     2                         lyb = 1                  ! local index for the top layer
            1113     2                       endif                    ! end if_ivflip_block
            1114     1                     else
            1115     1                       kd = 0
            1116     2                       if ( ivflip == 1 ) then  ! vertical from sfc upward
            1117     2                         kt = 1                   ! index diff between lyr and upper bound
            1118     2                         kb = 0                   ! index diff between lyr and lower bound
            1119     2                       else                     ! vertical from toa downward
            1120     2                         kt = 0                   ! index diff between lyr and upper bound
            1121     2                         kb = 1                   ! index diff between lyr and lower bound
            1122     2                       endif                    ! end if_ivflip_block
            1123     1                     endif   ! end if_lextop_block
            1124                     
            1125                           raddt = min(dtsw, dtlw)
            1126                     

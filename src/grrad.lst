            1128     1                       if ( me == 0 .and. myrank == 0) then
            1129     1                           print *,'###################################################'
            1130     1                           print *,'### In grrad start !! ###'
            1131     1                           print *,'###################################################'
            1132     1                           print *,'### ix=',ix,' im=',im,' lm=',lm,' me=',me

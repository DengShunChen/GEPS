            1069                     !===> ...  begin here
            1070                     !
            1071                     !     lhtrswb  = present( htrswb )
            1072                     !     lhtrsw0  = present( htrsw0 )
            1073                     !     lfswprf  = present( fswprf )
            1074                     !     lscmpsw  = present( scmpsw )
            1075                     !

             182                           use module_radiation_aerosols,only : nf_aesw, nf_aelw, setaer,    &
             183                          &                                     aer_init, aer_update
             184                     !    &,                                    nspc1                        ! optn for aod output
             185                           use module_radiation_surface, only : nf_albd, sfc_init, setalb,   &
             186                          &                                     setemis
             187                           use module_radiation_clouds,  only : nf_clds, cld_init,           &
             188                          &                                     progcld1, progcld2, progcld3,&
             189                          &					   progcld4, diagcld1,          &
             190                                                                progcld5, progcld5o,         &
             191                                                                progclduni, progcld6,        &
             192                                                                progcld_thompson, progcld_gce
             193                     
             194                           use module_radsw_parameters,  only : topfsw_type, sfcfsw_type,    &
             195                          &                                     profsw_type,cmpfsw_type,nbdsw
             196                           use module_radsw_main,        only : rswinit,  swrad
             197                     
             198                           use module_radlw_parameters,  only : topflw_type, sfcflw_type,    &
             199                          &                                     proflw_type, nbdlw
             200                           use module_radlw_main,        only : rlwinit,  lwrad
             201                     !
             202                     !    implicit   none
             203                     !
             204                     !
             205                           private
             206                     
             207                     !  ---  version tag and last revision date
             208                           character(40), parameter ::                                       &
             209                          &   vtagrad='ncep-radiation_driver    v5.2  jan 2013 '
             210                     !    &   vtagrad='ncep-radiation_driver    v5.1  nov 2012 '
             211                     !    &   vtagrad='ncep-radiation_driver    v5.0  aug 2012 '
             212                     
             213                     !  ---  constant values
             214                           real (kind=kind_phys) :: qmin, qme5, qme6, epsq
             215                     !     parameter (qmin=1.0e-10, qme5=1.0e-5,  qme6=1.0e-6,  epsq=1.0e-12)
             216                           parameter (qmin=1.0e-10, qme5=1.0e-7,  qme6=1.0e-7,  epsq=1.0e-12)
             217                     !     parameter (qmin=1.0e-10, qme5=1.0e-20, qme6=1.0e-20, epsq=1.0e-12)
             218                           real, parameter :: prsmin = 1.0e-6 ! toa pressure minimum value in mb (hpa)
             219                     
             220                     !  ---  control flags set in subr radinit:
             221                           integer :: itsfc  =0            ! flag for lw sfc air/ground interface temp setting
             222                     
             223                     !  ---  data input control variables set in subr radupdate:
             224                           integer :: month0=0,   iyear0=0,   monthd=0
             225                           logical :: loz1st =.true.       ! first-time clim ozone data read flag
             226                     
             227                     !  ---  optional extra top layer on top of low ceiling models
             228                           integer, parameter :: ltp = 0   ! no extra top layer
             229                     !     integer, parameter :: ltp = 1   ! add an extra top layer
             230                           logical, parameter :: lextop = (ltp > 0)
             231                     
             232                     
             233                     !  ---  publicly accessible module programs:
             234                     
             235                           public radinit, radupdate, grrad
             236                     
             237                     
             238                     ! =================
             239                           contains
             240                     ! =================
             241                     
             242                     
             243                     !-----------------------------------
             244                           subroutine radinit                                                &
             245                     !...................................
             246                     
             247                     !  ---  inputs:
             248                          &     ( si, nlay, me, myrank )
             249                     !  ---  outputs:
             250                     !          ( none )
             251                     
             252                     ! =================   subprogram documentation block   ================ !
             253                     !                                                                       !
             254                     ! subprogram:   radinit     initialization of radiation calculations    !
             255                     !                                                                       !
             256                     ! usage:        call radinit                                            !
             257                     !                                                                       !
             258                     ! attributes:                                                           !
             259                     !   language:  fortran 90                                               !
             260                     !   machine:   ibm sp                                                   !
             261                     !                                                                       !
             262                     !  ====================  defination of variables  ====================  !
             263                     !                                                                       !
             264                     ! input parameters:                                                     !
             265                     !   nlay             : number of model vertical layers                  !
             266                     !   me               : print control flag                               !
             267                     !                                                                       !
             268                     !  outputs: (none)                                                      !
             269                     !                                                                       !
             270                     !  external module variables:  (in module physpara)                     !
             271                     !   isolar   : solar constant cntrol flag                               !
             272                     !              = 0: use the old fixed solar constant in "physcon"       !
             273                     !              =10: use the new fixed solar constant in "physcon"       !
             274                     !              = 1: use noaa ann-mean tsi tbl abs-scale with cycle apprx!
             275                     !              = 2: use noaa ann-mean tsi tbl tim-scale with cycle apprx!
             276                     !              = 3: use cmip5 ann-mean tsi tbl tim-scale with cycl apprx!
             277                     !              = 4: use cmip5 mon-mean tsi tbl tim-scale with cycl apprx!
             278                     !   iaerflg  : 3-digit aerosol flag (abc for volc, lw, sw)              !
             279                     !              a:=0 use background stratospheric aerosol                !
             280                     !                =1 include stratospheric vocanic aeros                 !
             281                     !              b:=0 no topospheric aerosol in lw radiation              !
             282                     !                =1 compute tropspheric aero in 1 broad band for lw     !
             283                     !                =2 compute tropspheric aero in multi bands for lw      !
             284                     !              c:=0 no topospheric aerosol in sw radiation              !
             285                     !                =1 include tropspheric aerosols for sw                 !
             286                     !   ico2flg  : co2 data source control flag                             !
             287                     !              =0: use prescribed global mean co2 (old  oper)           !
             288                     !              =1: use observed co2 annual mean value only              !
             289                     !              =2: use obs co2 monthly data with 2-d variation          !
             290                     !   ictmflg  : =yyyy#, external data ic time/date control flag          !
             291                     !              =   -2: same as 0, but superimpose seasonal cycle        !
             292                     !                      from climatology data set.                       !
             293                     !              =   -1: use user provided external data for the          !
             294                     !                      forecast time, no extrapolation.                 !
             295                     !              =    0: use data at initial cond time, if not            !
             296                     !                      available, use latest, no extrapolation.         !
             297                     !              =    1: use data at the forecast time, if not            !
             298                     !                      available, use latest and extrapolation.         !
             299                     !              =yyyy0: use yyyy data for the forecast time,             !
             300                     !                      no further data extrapolation.                   !
             301                     !              =yyyy1: use yyyy data for the fcst. if needed, do        !
             302                     !                      extrapolation to match the fcst time.            !
             303                     !   ioznflg  : ozone data source control flag                           !
             304                     !              =0: use climatological ozone profile                     !
             305                     !              =1: use interactive ozone profile                        !
             306                     !   ialbflg  : albedo scheme control flag                               !
             307                     !              =0: climatology, based on surface veg types              !
             308                     !              =1: modis retrieval based surface albedo scheme          !
             309                     !   iemsflg  : emissivity scheme cntrl flag (ab 2-digit integer)        !
             310                     !              a:=0 set sfc air/ground t same for lw radiation          !
             311                     !                =1 set sfc air/ground t diff for lw radiation          !
             312                     !              b:=0 use fixed sfc emissivity=1.0 (black-body)           !
             313                     !                =1 use varying climtology sfc emiss (veg based)        !
             314                     !                =2 future development (not yet)                        !
             315                     !   icldflg  : cloud optical property scheme control flag               !
             316                     !              =0: use diagnostic cloud scheme                          !
             317                     !              =1: use prognostic cloud scheme (default)                !
             318                     !   icmphys  : cloud microphysics scheme control flag                   !
             319                     !              =1 zhao/carr/sundqvist microphysics scheme               !
             320                     !              =2 brad ferrier microphysics scheme                      !
             321                     !	       =3 zhao/carr/sundqvist microphysics+pdf cloud & cnvc,cnvw!
             322                     !   iovrsw   : control flag for cloud overlap in sw radiation           !
             323                     !   iovrlw   : control flag for cloud overlap in lw radiation           !
             324                     !              =0: random overlapping clouds                            !
             325                     !              =1: max/ran overlapping clouds                           !
             326                     !   isubcsw  : sub-column cloud approx control flag in sw radiation     !
             327                     !   isubclw  : sub-column cloud approx control flag in lw radiation     !
             328                     !              =0: with out sub-column cloud approximation              !
             329                     !              =1: mcica sub-col approx. prescribed random seed         !
             330                     !              =2: mcica sub-col approx. provided random seed           !
             331                     !   lcrick   : control flag for eliminating crick                       !
             332                     !              =t: apply layer smoothing to eliminate crick             !
             333                     !              =f: do not apply layer smoothing                         !
             334                     !   lcnorm   : control flag for in-cld condensate                       !
             335                     !              =t: normalize cloud condensate                           !
             336                     !              =f: not normalize cloud condensate                       !
             337                     !   lnoprec  : precip effect in radiation flag (ferrier microphysics)   !
             338                     !              =t: snow/rain has no impact on radiation                 !
             339                     !              =f: snow/rain has impact on radiation                    !
             340                     !   ivflip   : vertical index direction control flag                    !
             341                     !              =0: index from toa to surface                            !
             342                     !              =1: index from surface to toa                            !
             343                     !                                                                       !
             344                     !  subroutines called: sol_init, aer_init, gas_init, cld_init,          !
             345                     !                      sfc_init, rlwinit, rswinit                       !
             346                     !                                                                       !
             347                     !  usage:       call radinit                                            !
             348                     !                                                                       !
             349                     !  ===================================================================  !
             350                     !
             351                           implicit none
             352                     
             353                     !  ---  inputs:
             354                           integer, intent(in) :: nlay, me, myrank
             355                     
             356                           real (kind=kind_phys), intent(in) :: si(:)
             357                     
             358                     !  ---  outputs: (none, to module variables)
             359                     
             360                     !  ---  locals:
             361                     
             362                     !
             363                     !===> ...  begin here
             364                     !
             365                     !  ---  set up control variables
             366                           itsfc  = iemsflg / 10             ! sfc air/ground temp control
             367                           loz1st = (ioznflg == 0)           ! first-time clim ozone data read flag
             368                           month0 = 0
             369                           iyear0 = 0
             370                           monthd = 0
             371                     
             372     1                     if (me == 0 .and. myrank == 0) then
             373     1               !       print *,' new radiation program structures -- sep 01 2004'
             374     1                       print *,' new radiation program structures became oper. ',      &
             375     1                    &          '  may 01 2007'
             376     1                       print *, vtagrad                !print out version tag
             377     1                       print *,' - selected control flag settings: ictmflg=',ictmflg,  &
             378     1                    &    ' isolar =',isolar, ' ico2flg=',ico2flg,' iaerflg=',iaerflg,  &
             379     1                    &    ' ialbflg=',ialbflg,' iemsflg=',iemsflg,' icldflg=',icldflg,  &
             380     1                    &    ' icmphys=',icmphys,' ioznflg=',ioznflg
             381     1                       print *,' ivflip=',ivflip,' iovrsw=',iovrsw,' iovrlw=',iovrlw,  &
             382     1                    &    ' isubcsw=',isubcsw,' isubclw=',isubclw
             383     1                       print *,' lcrick=',lcrick,' lcnorm=',lcnorm,' lnoprec=',lnoprec
             384     1                       print *,' ltp =',ltp,', add extra top layer =',lextop
             385     1               
             386     2                       if ( ictmflg==0 .or. ictmflg==-2 ) then
             387     2                         print *,'   data usage is limited by initial condition!'
             388     2                         print *,'   no volcanic aerosols'
             389     2                       endif
             390     1               
             391     2                       if ( isubclw == 0 ) then
             392     2                         print *,' - isubclw=',isubclw,' no mcica, use grid ',         &
             393     2                    &            'averaged cloud in lw radiation'
             394     2                       elseif ( isubclw == 1 ) then
             395     2                         print *,' - isubclw=',isubclw,' use mcica with fixed ',       &
             396     2                    &            'permutation seeds for lw random number generator'
             397     2                       elseif ( isubclw == 2 ) then
             398     2                         print *,' - isubclw=',isubclw,' use mcica with random ',      &
             399     2                    &            'permutation seeds for lw random number generator'
             400     2                       else
             401     2                         print *,' - error!!! isubclw=',isubclw,' is not a ',          &
             402     2                    &            'valid option '
             403     2                         stop
             404     2                       endif
             405     1               
             406     2                       if ( isubcsw == 0 ) then
             407     2                         print *,' - isubcsw=',isubcsw,' no mcica, use grid ',         &
             408     2                    &            'averaged cloud in sw radiation'
             409     2                       elseif ( isubcsw == 1 ) then
             410     2                         print *,' - isubcsw=',isubcsw,' use mcica with fixed ',       &
             411     2                    &            'permutation seeds for sw random number generator'
             412     2                       elseif ( isubcsw == 2 ) then
             413     2                         print *,' - isubcsw=',isubcsw,' use mcica with random ',      &
             414     2                    &            'permutation seeds for sw random number generator'
             415     2                       else
             416     2                         print *,' - error!!! isubcsw=',isubcsw,' is not a ',          &
             417     2                    &            'valid option '
             418     2                         stop
             419     2                       endif
             420     1               
             421     2                       if ( isubcsw /= isubclw ) then
             422     2                         print *,' - *** notice *** isubcsw /= isubclw !!!',           &
             423     2                    &            isubcsw, isubclw
             424     2                       endif
             425     1                     endif
             426                     
             427                     !  --- ...  call astronomy initialization routine
             428                     
             429                           if (me == 0 .and. myrank ==0)print *,'call sol_init'
             430                           call sol_init ( me , myrank )
             431                     
             432                     !  --- ...  call aerosols initialization routine
             433                     
             434                           if (me == 0 .and. myrank == 0)print *,'call aer_init'
             435                           call aer_init ( nlay, me , myrank )
             436                     
             437                     !  --- ...  call co2 and other gases initialization routine
             438                     
             439                           if (me ==0 .and. myrank == 0)print *,'call gas_init'
             440                           call gas_init ( me , myrank )
             441                     
             442                     !  --- ...  call surface initialization routine
             443                     
             444                           if (me == 0 .and. myrank == 0)print *,'call sfc_init'
             445                           call sfc_init ( me , myrank )
             446                     
             447                     !  --- ...  call cloud initialization routine
             448                     
             449                           if (me == 0 .and. myrank == 0)print *,'call cld_init'
             450                           call cld_init ( si, nlay, me, myrank )
             451                     
             452                     !  --- ...  call lw radiation initialization routine
             453                     
             454                           if (me == 0 .and. myrank == 0)print *,'call rlw_init'
             455                           call rlwinit ( me , myrank )
             456                     
             457                     !  --- ...  call sw radiation initialization routine
             458                     
             459                           if (me == 0 .and. myrank == 0)print *,'call rsw_init'
             460                           call rswinit ( me ,myrank)
             461                     !
             462                           return
             463                     !...................................
             464                           end subroutine radinit
             465                     !-----------------------------------
             466                     
             467                     
             468                     !-----------------------------------
             469                           subroutine radupdate                                              &
             470                     !...................................
             471                     !  ---  inputs:
             472                          &     ( idate,jdate,deltsw,deltim,lsswr, me, myrank,               &
             473                     !  ---  outputs:
             474                          &       slag,sdec,cdec,solcon                                      &
             475                          &     )
             476                     
             477                     ! =================   subprogram documentation block   ================ !
             478                     !                                                                       !
             479                     ! subprogram:   radupdate   calls many update subroutines to check and  !
             480                     !   update radiation required but time varying data sets and module     !
             481                     !   variables.                                                          !
             482                     !                                                                       !
             483                     ! usage:        call radupdate                                          !
             484                     !                                                                       !
             485                     ! attributes:                                                           !
             486                     !   language:  fortran 90                                               !
             487                     !   machine:   ibm sp                                                   !
             488                     !                                                                       !
             489                     !  ====================  defination of variables  ====================  !
             490                     !                                                                       !
             491                     ! input parameters:                                                     !
             492                     !   idate(8)       : ncep absolute date and time of initial condition   !
             493                     !                    (yr, mon, day, t-zone, hr, min, sec, mil-sec)      !
             494                     !   jdate(8)       : ncep absolute date and time at fcst time           !
             495                     !                    (yr, mon, day, t-zone, hr, min, sec, mil-sec)      !
             496                     !   deltsw         : sw radiation calling frequency in seconds          !
             497                     !   deltim         : model timestep in seconds                          !
             498                     !   lsswr          : logical flags for sw radiation calculations        !
             499                     !   me             : print control flag                                 !
             500                     !                                                                       !
             501                     !  outputs:                                                             !
             502                     !   slag           : equation of time in radians                        !
             503                     !   sdec, cdec     : sin and cos of the solar declination angle         !
             504                     !   solcon         : sun-earth distance adjusted solar constant (w/m2)  !
             505                     !                                                                       !
             506                     !  external module variables:                                           !
             507                     !   isolar   : solar constant cntrl  (in module physpara)               !
             508                     !              = 0: use the old fixed solar constant in "physcon"       !
             509                     !              =10: use the new fixed solar constant in "physcon"       !
             510                     !              = 1: use noaa ann-mean tsi tbl abs-scale with cycle apprx!
             511                     !              = 2: use noaa ann-mean tsi tbl tim-scale with cycle apprx!
             512                     !              = 3: use cmip5 ann-mean tsi tbl tim-scale with cycl apprx!
             513                     !              = 4: use cmip5 mon-mean tsi tbl tim-scale with cycl apprx!
             514                     !   ictmflg  : =yyyy#, external data ic time/date control flag          !
             515                     !              =   -2: same as 0, but superimpose seasonal cycle        !
             516                     !                      from climatology data set.                       !
             517                     !              =   -1: use user provided external data for the          !
             518                     !                      forecast time, no extrapolation.                 !
             519                     !              =    0: use data at initial cond time, if not            !
             520                     !                      available, use latest, no extrapolation.         !
             521                     !              =    1: use data at the forecast time, if not            !
             522                     !                      available, use latest and extrapolation.         !
             523                     !              =yyyy0: use yyyy data for the forecast time,             !
             524                     !                      no further data extrapolation.                   !
             525                     !              =yyyy1: use yyyy data for the fcst. if needed, do        !
             526                     !                      extrapolation to match the fcst time.            !
             527                     !                                                                       !
             528                     !  module variables:                                                    !
             529                     !   loz1st   : first-time clim ozone data read flag                     !
             530                     !                                                                       !
             531                     !  subroutines called: sol_update, aer_update, gas_update               !
             532                     !                                                                       !
             533                     !  ===================================================================  !
             534                     !
             535                           implicit none
             536                     
             537                     !  ---  inputs:
             538                           integer, intent(in) :: idate(:), jdate(:), me, myrank
             539                           logical, intent(in) :: lsswr
             540                     
             541                           real (kind=kind_phys), intent(in) :: deltsw, deltim
             542                     
             543                     !  ---  outputs:
             544                           real (kind=kind_phys), intent(out) :: slag, sdec, cdec, solcon
             545                     
             546                     !  ---  locals:
             547                           integer :: iyear, imon, iday, ihour
             548                           integer :: kyear, kmon, kday, khour
             549                     
             550                           logical :: lmon_chg       ! month change flag
             551                           logical :: lco2_chg       ! cntrl flag for updating co2 data
             552                           logical :: lsol_chg       ! cntrl flag for updating solar constant
             553                     !
             554                     !===> ...  begin here
             555                     !
             556                     !  --- ...  time stamp at fcst time
             557                     
             558                           iyear = jdate(1)
             559                           imon  = jdate(2)
             560                           iday  = jdate(3)
             561                           ihour = jdate(5)
             562                     
             563                     !  --- ...  set up time stamp used for green house gases (** currently co2 only)
             564                     
             565     1                     if ( ictmflg==0 .or. ictmflg==-2 ) then  ! get external data at initial condition time
             566     1                       kyear = idate(1)
             567     1                       kmon  = idate(2)
             568     1                       kday  = idate(3)
             569     1                       khour = idate(5)
             570     1                     else                           ! get external data at fcst or specified time
             571     1                       kyear = iyear
             572     1                       kmon  = imon
             573     1                       kday  = iday
             574     1                       khour = ihour
             575     1                     endif   ! end if_ictmflg_block
             576                     
             577     1                     if ( month0 /= imon ) then
             578     1                       lmon_chg = .true.
             579     1                       month0 = imon
             580     1                     else
             581     1                       lmon_chg = .false.
             582     1                     endif
             583                     
             584                     !  --- ...  call astronomy update routine, yearly update, no time interpolation
             585                     
             586     1                     if (lsswr) then
             587     1               
             588     2                       if ( isolar == 0 .or. isolar == 10 ) then
             589     2                         lsol_chg = .false.
             590     2                       elseif ( iyear0 /= iyear ) then
             591     2                         lsol_chg = .true.
             592     2                       else
             593     2                         lsol_chg = ( isolar==4 .and. lmon_chg )
             594     2                       endif
             595     1                       iyear0 = iyear
             596     1               
             597     1                       if (me == 0 .and. myrank ==0) print *,'call sol_update'
             598     1                       call sol_update                                                 &
             599     1               !  ---  inputs:
             600     1                    &     ( myrank, jdate,kyear,deltsw,deltim,lsol_chg, me,            &
             601     1               !  ---  outputs:
             602     1                    &       slag,sdec,cdec,solcon                                      &
             603     1                    &     )
             604     1               
             605     1                     endif  ! end_if_lsswr_block
             606                     
             607                     !  --- ...  call aerosols update routine, monthly update, no time interpolation
             608                     
             609     1                     if ( lmon_chg ) then
             610     1                       if (me == 0 .and. myrank ==0) print *,'call aer_update'
             611     1                       call aer_update ( myrank, iyear, imon, me )
             612     1                     endif
             613                     
             614                     !  --- ...  call co2 and other gases update routine
             615                     
             616     1                     if ( monthd /= kmon ) then
             617     1                       monthd = kmon
             618     1                       lco2_chg = .true.
             619     1                     else
             620     1                       lco2_chg = .false.
             621     1                     endif
             622                     
             623                           if (me == 0 .and. myrank ==0) print *,'call gas_update'
             624                           call gas_update ( myrank, kyear,kmon,kday,khour,loz1st,lco2_chg, me )
             625                     
             626                           if ( loz1st ) loz1st = .false.
             627                     
             628                     !  --- ...  call surface update routine (currently not needed)
             629                     !     call sfc_update ( iyear, imon, me )
             630                     
             631                     !  --- ...  call clouds update routine (currently not needed)
             632                     !     call cld_update ( iyear, imon, me )
             633                     !
             634                           return
             635                     !...................................
             636                           end subroutine radupdate
             637                     !-----------------------------------
             638                     
             639                     
             640                     !-----------------------------------
             641                           subroutine grrad                                                  &
             642                     !...................................
             643                     !  ---  inputs:
             644                                ( prsi,prsl,prslk,tgrs,qgrs,tracer,vvl,slmsk,                &
             645                                  xlon,xlat,tsfc,snowd,sncovr,snoalb,zorl,hprim,             &
             646                                  alvsf,alnsf,alvwf,alnwf,facsf,facwf,fice,tisfc,            &
             647                                  sinlat,coslat,solhr,jdate,solcon,                          &
             648                                  cv,cvt,cvb,                                                &
             649                                  icsdsw,icsdlw,ntcw,ncld,ntoz,ntrac,nfxr,                   &
             650                                  dtlw,dtsw,lsswr,lslwr,lssav,                               &
             651                                  ix,im,lm,me,lprnt,ipt,kdt,myrank,                          &
             652                                  ntiw,ntrw,ntsw,ntgl,uni_cloud,lmfshal,lmfdeep2,            &
             653                                  deltaq,sup,cnvw,cnvc,phy_f3d,                              &
             654                     !  ---  outputs:
             655                                  htrsw,sfalb,coszen,coszdg,                                 &
             656                                  htrlw,tsflw,semis,                                         &
             657                     !  ---  input/output:
             658                                  cldcov,fluxr,                                              &
             659                     !! ---  optional outputs:
             660                                  htrsw0,htrlw0,                                             &
             661                                  fusl,fdsl,fuir,fdir,                                       &
             662                                  fuslr,fdslr,fuirr,fdirr                                    &
             663                                )
             664                     
             665                     ! =================   subprogram documentation block   ================ !
             666                     !                                                                       !
             667                     !    this program is the driver of radiation calculation subroutines. * !
             668                     !    it sets up profile variables for radiation input, including      * !
             669                     !    clouds, surface albedos, atmospheric aerosols, ozone, etc.       * !
             670                     !                                                                     * !
             671                     !    usage:        call grrad                                         * !
             672                     !                                                                     * !
             673                     !    subprograms called:                                              * !
             674                     !                  setalb, setemis, setaer, getozn, getgases,         * !
             675                     !                  progcld1, progcld2, diagcds,                       * !
             676                     !                  swrad, lwrad, fpvs                                 * !
             677                     !                                                                     * !
             678                     !    attributes:                                                      * !
             679                     !      language:   fortran 90                                         * !
             680                     !      machine:    ibm-sp, sgi                                        * !
             681                     !                                                                     * !
             682                     !                                                                     * !
             683                     !  ====================  defination of variables  ====================  !
             684                     !                                                                       !
             685                     !    input variables:                                                   !
             686                     !      prsi  (ix,lm+1) : model level pressure in cb (kpa)               !
             687                     !      prsl  (ix,lm)   : model layer mean pressure in cb (kpa)          !
             688                     !      prslk (ix,lm)   : exner function = (p/p0)**rocp                  !
             689                     !      tgrs  (ix,lm)   : model layer mean temperature in k              !
             690                     !      qgrs  (ix,lm)   : layer specific humidity in gm/gm               !
             691                     !      tracer(ix,lm,ntrac):layer prognostic tracer amount/mixing-ratio  !
             692                     !                        incl: oz, cwc, aeros, etc.                     !
             693                     !      vvl   (ix,lm)   : layer mean vertical velocity in cb/sec         !
             694                     !      slmsk (im)      : sea/land mask array (sea:0,land:1,sea-ice:2)   !
             695                     !      xlon  (im)      : grid longitude in radians, ok for both 0->2pi  !
             696                     !                        or -pi -> +pi ranges                           !
             697                     !      xlat  (im)      : grid latitude in radians, default to pi/2 ->   !
             698                     !                        -pi/2 range, otherwise adj in subr called      !
             699                     !      tsfc  (im)      : surface temperature in k                       !
             700                     !      snowd (im)      : snow depth water equivalent in mm              !
             701                     !      sncovr(im)      : snow cover in fraction                         !
             702                     !      snoalb(im)      : maximum snow albedo in fraction                !
             703                     !      zorl  (im)      : surface roughness in cm                        !
             704                     !      hprim (im)      : topographic standard deviation in m            !
             705                     !      alvsf (im)      : mean vis albedo with strong cosz dependency    !
             706                     !      alnsf (im)      : mean nir albedo with strong cosz dependency    !
             707                     !      alvwf (im)      : mean vis albedo with weak cosz dependency      !
             708                     !      alnwf (im)      : mean nir albedo with weak cosz dependency      !
             709                     !      facsf (im)      : fractional coverage with strong cosz dependen  !
             710                     !      facwf (im)      : fractional coverage with weak cosz dependency  !
             711                     !      fice  (im)      : ice fraction over open water grid              !
             712                     !      tisfc (im)      : surface temperature over ice fraction          !
             713                     !      sinlat(im)      : sine of the grids' corresponding latitudes     !
             714                     !      coslat(im)      : cosine of the grids' corresponding latitudes   !
             715                     !      solhr           : hour time after 00z at the t-stepe             !
             716                     !      jdate (8)       : current forecast date and time                 !
             717                     !                        (yr, mon, day, t-zone, hr, min, sec, mil-sec)  !
             718                     !      solcon          : solar constant (sun-earth distant adjusted)    !
             719                     !      cv    (im)      : fraction of convective cloud                   !
             720                     !      cvt, cvb (im)   : convective cloud top/bottom pressure in cb     !
             721                     !      fcice           : fraction of cloud ice  (in ferrier scheme)     !
             722                     !      frain           : fraction of rain water (in ferrier scheme)     !
             723                     !      rrime           : mass ratio of total to unrimed ice ( >= 1 )    !
             724                     !      flgmin          : minimim large ice fraction                     !
             725                     !      icsdsw/icsdlw   : auxiliary cloud control arrays passed to main  !
             726                     !           (im)         radiations. if isubcsw/isubclw (input to init) !
             727                     !                        are set to 2, the arrays contains provided     !
             728                     !                        random seeds for sub-column clouds generators  !
             729                     !      ntcw            : =0 no cloud condensate calculated              !
             730                     !                        >0 array index location for cloud condensate   !
             731                     !      ncld            : only used when ntcw .gt. 0                     !
             732                     !      ntoz            : =0 climatological ozone profile                !
             733                     !                        >0 interactive ozone profile                   !
             734                     !      ntrac           : dimension veriable for array oz                !
             735                     !      nfxr            : second dimension of input/output array fluxr   !
             736                     !      dtlw, dtsw      : time duration for lw/sw radiation call in sec  !
             737                     !      lsswr, lslwr    : logical flags for sw/lw radiation calls        !
             738                     !      lssav           : logical flag for store 3-d cloud field         !
             739                     !      ix,im           : horizontal dimention and num of used points    !
             740                     !      lm              : vertical layer dimension                       !
             741                     !      me              : control flag for parallel process              !
             742                     !      lprnt           : control flag for diagnostic print out          !
             743                     !      ipt             : index for diagnostic printout point            !
             744                     !      kdt             : time-step number                               !
             745                     !      deltaq          : half width of uniform total water distribution !
             746                     !      sup             : supersaturation in pdf cloud when t is very low!
             747                     !      cnvw            : layer convective cloud water                   !
             748                     !      cnvc            : layer convective cloud cover                   !
             749                     !                                                                       !
             750                     !    output variables:                                                  !
             751                     !      htrsw (ix,lm)   : total sky sw heating rate in k/sec             !
             752                     !      topfsw(im)      : sw radiation fluxes at toa, components:        !
             753                     !                      (check module_radsw_parameters for definition)   !
             754                     !       %upfxc           - total sky upward sw flux at toa (w/m**2)     !
             755                     !       %dnflx           - total sky downward sw flux at toa (w/m**2)   !
             756                     !       %upfx0           - clear sky upward sw flux at toa (w/m**2)     !
             757                     !      sfcfsw(im)      : sw radiation fluxes at sfc, components:        !
             758                     !                      (check module_radsw_parameters for definition)   !
             759                     !       %upfxc           - total sky upward sw flux at sfc (w/m**2)     !
             760                     !       %dnfxc           - total sky downward sw flux at sfc (w/m**2)   !
             761                     !       %upfx0           - clear sky upward sw flux at sfc (w/m**2)     !
             762                     !       %dnfx0           - clear sky downward sw flux at sfc (w/m**2)   !
             763                     !      sfalb (im)      : mean surface diffused sw albedo                !
             764                     !      coszen(im)      : mean cos of zenith angle over rad call period  !
             765                     !      coszdg(im)      : daytime mean cosz over rad call period         !
             766                     !      htrlw (ix,lm)   : total sky lw heating rate in k/sec             !
             767                     !      topflw(im)      : lw radiation fluxes at top, component:         !
             768                     !                        (check module_radlw_paramters for definition)  !
             769                     !       %upfxc           - total sky upward lw flux at toa (w/m**2)     !
             770                     !       %upfx0           - clear sky upward lw flux at toa (w/m**2)     !
             771                     !      sfcflw(im)      : lw radiation fluxes at sfc, component:         !
             772                     !                        (check module_radlw_paramters for definition)  !
             773                     !       %upfxc           - total sky upward lw flux at sfc (w/m**2)     !
             774                     !       %upfx0           - clear sky upward lw flux at sfc (w/m**2)     !
             775                     !       %dnfxc           - total sky downward lw flux at sfc (w/m**2)   !
             776                     !       %dnfx0           - clear sky downward lw flux at sfc (w/m**2)   !
             777                     !      semis (im)      : surface lw emissivity in fraction              !
             778                     !      cldcov(ix,lm)   : 3-d cloud fraction                             !
             779                     !      tsflw (im)      : surface air temp during lw calculation in k    !
             780                     !                                                                       !
             781                     !    input and output variables:                                        !
             782                     !      fluxr (ix,nfxr) : to save time accumulated 2-d fields defined as:!
             783                     !                 1      - toa total sky upwd lw radiation flux         !
             784                     !                 2      - toa total sky upwd sw radiation flux         !
             785                     !                 3      - sfc total sky upwd sw radiation flux         !
             786                     !                 4      - sfc total sky dnwd sw radiation flux         !
             787                     !                 5      - high domain cloud fraction                   !
             788                     !                 6      - mid  domain cloud fraction                   !
             789                     !                 7      - low  domain cloud fraction                   !
             790                     !                 8      - high domain mean cloud top pressure          !
             791                     !                 9      - mid  domain mean cloud top pressure          !
             792                     !                10      - low  domain mean cloud top pressure          !
             793                     !                11      - high domain mean cloud base pressure         !
             794                     !                12      - mid  domain mean cloud base pressure         !
             795                     !                13      - low  domain mean cloud base pressure         !
             796                     !                14      - high domain mean cloud top temperature       !
             797                     !                15      - mid  domain mean cloud top temperature       !
             798                     !                16      - low  domain mean cloud top temperature       !
             799                     !                17      - total cloud fraction                         !
             800                     !                18      - boundary layer domain cloud fraction         !
             801                     !                19      - sfc total sky dnwd lw radiation flux         !
             802                     !                20      - sfc total sky upwd lw radiation flux         !
             803                     !                21      - sfc total sky dnwd sw uv-b radiation flux    !
             804                     !                22      - sfc clear sky dnwd sw uv-b radiation flux    !
             805                     !                23      - toa incoming solar radiation flux            !
             806                     !                24      - sfc vis beam dnwd sw radiation flux          !
             807                     !                25      - sfc vis diff dnwd sw radiation flux          !
             808                     !                26      - sfc nir beam dnwd sw radiation flux          !
             809                     !                27      - sfc nir diff dnwd sw radiation flux          !
             810                     !                28      - toa clear sky upwd lw radiation flux         !
             811                     !                29      - toa clear sky upwd sw radiation flux         !
             812                     !                30      - sfc clear sky dnwd lw radiation flux         !
             813                     !                31      - sfc clear sky upwd sw radiation flux         !
             814                     !                32      - sfc clear sky dnwd sw radiation flux         !
             815                     !                33      - sfc clear sky upwd lw radiation flux         !
             816                     !optional        34      - aeros opt depth at 550nm (all components)    !
             817                     !               ....     - optional for test and future use             !
             818                     !                                                                       !
             819                     !    optional output variables:                                         !
             820                     !      htrswb(ix,lm,nbdsw) : spectral band total sky sw heating rate    !
             821                     !      htrlwb(ix,lm,nbdlw) : spectral band total sky lw heating rate    !
             822                     !                                                                       !
             823                     !                                                                       !
             824                     !    definitions of internal variable arrays:                           !
             825                     !                                                                       !
             826                     !     1. fixed gases:         (defined in 'module_radiation_gases')     !
             827                     !          gasvmr(:,:,1)  -  co2 volume mixing ratio                    !
             828                     !          gasvmr(:,:,2)  -  n2o volume mixing ratio                    !
             829                     !          gasvmr(:,:,3)  -  ch4 volume mixing ratio                    !
             830                     !          gasvmr(:,:,4)  -  o2  volume mixing ratio                    !
             831                     !          gasvmr(:,:,5)  -  co  volume mixing ratio                    !
             832                     !          gasvmr(:,:,6)  -  cf11 volume mixing ratio                   !
             833                     !          gasvmr(:,:,7)  -  cf12 volume mixing ratio                   !
             834                     !          gasvmr(:,:,8)  -  cf22 volume mixing ratio                   !
             835                     !          gasvmr(:,:,9)  -  ccl4 volume mixing ratio                   !
             836                     !                                                                       !
             837                     !     2. cloud profiles:      (defined in 'module_radiation_clouds')    !
             838                     !                ---  for  prognostic cloud  ---                        !
             839                     !          clouds(:,:,1)  -  layer total cloud fraction                 !
             840                     !          clouds(:,:,2)  -  layer cloud liq water path                 !
             841                     !          clouds(:,:,3)  -  mean effective radius for liquid cloud     !
             842                     !          clouds(:,:,4)  -  layer cloud ice water path                 !
             843                     !          clouds(:,:,5)  -  mean effective radius for ice cloud        !
             844                     !          clouds(:,:,6)  -  layer rain drop water path                 !
             845                     !          clouds(:,:,7)  -  mean effective radius for rain drop        !
             846                     !          clouds(:,:,8)  -  layer snow flake water path                !
             847                     !          clouds(:,:,9)  -  mean effective radius for snow flake       !
             848                     !                ---  for  diagnostic cloud  ---                        !
             849                     !          clouds(:,:,1)  -  layer total cloud fraction                 !
             850                     !          clouds(:,:,2)  -  layer cloud optical depth                  !
             851                     !          clouds(:,:,3)  -  layer cloud single scattering albedo       !
             852                     !          clouds(:,:,4)  -  layer cloud asymmetry factor               !
             853                     !                                                                       !
             854                     !     3. surface albedo:      (defined in 'module_radiation_surface')   !
             855                     !          sfcalb( :,1 )  -  near ir direct beam albedo                 !
             856                     !          sfcalb( :,2 )  -  near ir diffused albedo                    !
             857                     !          sfcalb( :,3 )  -  uv+vis direct beam albedo                  !
             858                     !          sfcalb( :,4 )  -  uv+vis diffused albedo                     !
             859                     !                                                                       !
             860                     !     4. sw aerosol profiles: (defined in 'module_radiation_aerosols')  !
             861                     !          faersw(:,:,:,1)-  sw aerosols optical depth                  !
             862                     !          faersw(:,:,:,2)-  sw aerosols single scattering albedo       !
             863                     !          faersw(:,:,:,3)-  sw aerosols asymmetry parameter            !
             864                     !                                                                       !
             865                     !     5. lw aerosol profiles: (defined in 'module_radiation_aerosols')  !
             866                     !          faerlw(:,:,:,1)-  lw aerosols optical depth                  !
             867                     !          faerlw(:,:,:,2)-  lw aerosols single scattering albedo       !
             868                     !          faerlw(:,:,:,3)-  lw aerosols asymmetry parameter            !
             869                     !                                                                       !
             870                     !     6. sw fluxes at toa:    (defined in 'module_radsw_main')          !
             871                     !        (topfsw_type -- derived data type for toa rad fluxes)          !
             872                     !          topfsw(:)%upfxc  -  total sky upward flux at toa             !
             873                     !          topfsw(:)%dnfxc  -  total sky downward flux at toa           !
             874                     !          topfsw(:)%upfx0  -  clear sky upward flux at toa             !
             875                     !                                                                       !
             876                     !     7. lw fluxes at toa:    (defined in 'module_radlw_main')          !
             877                     !        (topflw_type -- derived data type for toa rad fluxes)          !
             878                     !          topflw(:)%upfxc  -  total sky upward flux at toa             !
             879                     !          topflw(:)%upfx0  -  clear sky upward flux at toa             !
             880                     !                                                                       !
             881                     !     8. sw fluxes at sfc:    (defined in 'module_radsw_main')          !
             882                     !        (sfcfsw_type -- derived data type for sfc rad fluxes)          !
             883                     !          sfcfsw(:)%upfxc  -  total sky upward flux at sfc             !
             884                     !          sfcfsw(:)%dnfxc  -  total sky downward flux at sfc           !
             885                     !          sfcfsw(:)%upfx0  -  clear sky upward flux at sfc             !
             886                     !          sfcfsw(:)%dnfx0  -  clear sky downward flux at sfc           !
             887                     !                                                                       !
             888                     !     9. lw fluxes at sfc:    (defined in 'module_radlw_main')          !
             889                     !        (sfcflw_type -- derived data type for sfc rad fluxes)          !
             890                     !          sfcflw(:)%upfxc  -  total sky upward flux at sfc             !
             891                     !          sfcflw(:)%dnfxc  -  total sky downward flux at sfc           !
             892                     !          sfcflw(:)%dnfx0  -  clear sky downward flux at sfc           !
             893                     !                                                                       !
             894                     !! optional radiation outputs:                                          !
             895                     !!   10. sw flux profiles:    (defined in 'module_radsw_main')          !
             896                     !!       (profsw_type -- derived data type for rad vertical profiles)   !
             897                     !!         fswprf(:,:)%upfxc - total sky upward flux                    !
             898                     !!         fswprf(:,:)%dnfxc - total sky downward flux                  !
             899                     !!         fswprf(:,:)%upfx0 - clear sky upward flux                    !
             900                     !!         fswprf(:,:)%dnfx0 - clear sky downward flux                  !
             901                     !!                                                                      !
             902                     !!   11. lw flux profiles:    (defined in 'module_radlw_main')          !
             903                     !!       (proflw_type -- derived data type for rad vertical profiles)   !
             904                     !!         flwprf(:,:)%upfxc - total sky upward flux                    !
             905                     !!         flwprf(:,:)%dnfxc - total sky downward flux                  !
             906                     !!         flwprf(:,:)%upfx0 - clear sky upward flux                    !
             907                     !!         flwprf(:,:)%dnfx0 - clear sky downward flux                  !
             908                     !!                                                                      !
             909                     !!   12. sw sfc components:   (defined in 'module_radsw_main')          !
             910                     !!       (cmpfsw_type -- derived data type for component sfc fluxes)    !
             911                     !!         scmpsw(:)%uvbfc  -  total sky downward uv-b flux at sfc      !
             912                     !!         scmpsw(:)%uvbf0  -  clear sky downward uv-b flux at sfc      !
             913                     !!         scmpsw(:)%nirbm  -  total sky sfc downward nir direct flux   !
             914                     !!         scmpsw(:)%nirdf  -  total sky sfc downward nir diffused flux !
             915                     !!         scmpsw(:)%visbm  -  total sky sfc downward uv+vis direct flx !
             916                     !!         scmpsw(:)%visdf  -  total sky sfc downward uv+vis diff flux  !
             917                     !                                                                       !
             918                     !    external module variables:                                         !
             919                     !     ivflip           : control flag for in/out vertical indexing      !
             920                     !                        =0 index from toa to surface                   !
             921                     !                        =1 index from surface to toa                   !
             922                     !     icmphys          : cloud microphysics scheme control flag         !
             923                     !                        =1 zhao/carr/sundqvist microphysics scheme     !
             924                     !                        =2 brad ferrier microphysics scheme            !
             925                     !                        =3 zhao/carr/sundqvist microphysics +pdf cloud !
             926                     !                                                                       !
             927                     !    module variables:                                                  !
             928                     !     itsfc            : =0 use same sfc skin-air/ground temp           !
             929                     !                        =1 use diff sfc skin-air/ground temp (not yet) !
             930                     !                                                                       !
             931                     !  ======================  end of definations  =======================  !

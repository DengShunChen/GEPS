 Module "module_radiation_driver"
  (inc)(line-no.)(nest)(optimize)
               1                     !!!!!  ==========================================================  !!!!!
               2                     !!!!!             'module_radiation_driver' descriptions           !!!!!
               3                     !!!!!  ==========================================================  !!!!!
               4                     !                                                                      !
               5                     !   this is the radiation driver module.  it prepares atmospheric      !
               6                     !   profiles and invokes main radiation calculations.                  !
               7                     !                                                                      !
               8                     !   in module 'module_radiation_driver' there are twe externally       !
               9                     !   callable subroutine:                                               !
              10                     !                                                                      !
              11                     !      'radinit'    -- initialization routine                          !
              12                     !         input:                                                       !
              13                     !           ( si, nlay, me )                                           !
              14                     !         output:                                                      !
              15                     !           ( none )                                                   !
              16                     !                                                                      !
              17                     !      'radupdate'  -- update time sensitive data used by radiations   !
              18                     !         input:                                                       !
              19                     !           ( idate,jdate,deltsw,deltim,lsswr, me )                    !
              20                     !         output:                                                      !
              21                     !           ( slag,sdec,cdec,solcon )                                  !
              22                     !                                                                      !
              23                     !      'grrad'      -- setup and invoke main radiation calls           !
              24                     !         input:                                                       !
              25                     !          ( prsi,prsl,prslk,tgrs,qgrs,tracer,vvl,slmsk,               !
              26                     !            xlon,xlat,tsfc,snowd,sncovr,snoalb,zorl,hprim,            !
              27                     !            alvsf,alnsf,alvwf,alnwf,facsf,facwf,                      !
              28                     !            sinlat,coslat,solhr,jdate,solcon,                         !
              29                     !            cv,cvt,cvb,                                               !
              30                     !            icsdsw,icsdlw,ntcw,ncld,ntoz,ntrac,nfxr,                 !
              31                     !            dtlw,dtsw,lsswr,lslwr,lssav,                              !
              32                     !            ix, im, lm, me, lprnt, ipt, kdt,                          !
              33                     !         output:                                                      !
              34                     !            htrsw,topfsw,sfcfsw,sfalb,coszen,coszdg,                  !
              35                     !            htrlw,topflw,sfcflw,tsflw,semis,cldcov,                   !
              36                     !         input/output:                                                !
              37                     !            fluxr                                                     !
              38                     !         optional output:                                             !
              39                     !            htrlw0,htrsw0,htrswb,htrlwb                               !
              40                     !                                                                      !
              41                     !                                                                      !
              42                     !   external modules referenced:                                       !
              43                     !       'module physpara'                   in 'physpara.f'            !
              44                     !       'module funcphys'                   in 'funcphys.f'            !
              45                     !       'module physcons'                   in 'physcons.f'            !
              46                     !                                                                      !
              47                     !       'module module_radiation_gases'     in 'radiation_gases.f'     !
              48                     !       'module module_radiation_aerosols'  in 'radiation_aerosols.f'  !
              49                     !       'module module_radiation_surface'   in 'radiation_surface.f'   !
              50                     !       'module module_radiation_clouds'    in 'radiation_clouds.f'    !
              51                     !                                                                      !
              52                     !       'module module_radsw_cntr_para'     in 'radsw_xxxx_param.f'    !
              53                     !       'module module_radsw_parameters'    in 'radsw_xxxx_param.f'    !
              54                     !       'module module_radsw_main'          in 'radsw_xxxx_main.f'     !
              55                     !                                                                      !
              56                     !       'module module_radlw_cntr_para'     in 'radlw_xxxx_param.f'    !
              57                     !       'module module_radlw_parameters'    in 'radlw_xxxx_param.f'    !
              58                     !       'module module_radlw_main'          in 'radlw_xxxx_main.f'     !
              59                     !                                                                      !
              60                     !    where xxxx may vary according to different scheme selection       !
              61                     !                                                                      !
              62                     !                                                                      !
              63                     !   program history log:                                               !
              64                     !     mm-dd-yy    ncep         - created program grrad                 !
              65                     !     08-12-03    yu-tai hou   - re-written for modulized radiations   !
              66                     !     11-06-03    yu-tai hou   - modified                              !
              67                     !     01-18-05    s. moorthi   - noah/ice model changes added          !
              68                     !     05-10-05    yu-tai hou   - modified module structure             !
              69                     !     12-xx-05    s. moorthi   - sfc lw flux adj by mean temperature   !
              70                     !     02-20-06    yu-tai hou   - add time variation for co2 data, and  !
              71                     !                                solar const. add sfc emiss change     !
              72                     !     03-21-06    s. moorthi   - added surface temp over ice           !
              73                     !     07-28-06    yu-tai hou   - add stratospheric vocanic aerosols    !
              74                     !     03-14-07    yu-tai hou   - add generalized spectral band interp  !
              75                     !                                for aerosol optical prop. (sw and lw) !
              76                     !     04-10-07    yu-tai hou   - spectral band sw/lw heating rates     !
              77                     !     05-04-07    yu-tai hou   - make options for clim based and modis !
              78                     !                                based (h. wei and c. marshall) albedo !
              79                     !     09-05-08    yu-tai hou   - add the initial date and time 'idate' !
              80                     !                    and control param 'ictm' to the passing param list!
              81                     !                    to handel different time/date requirements for    !
              82                     !                    external data (co2, aeros, solcon, ...)           !
              83                     !     10-10-08    yu-tai hou   - add the ictm=-2 option for combining  !
              84                     !                    initial condition data with seasonal cycle from   !
              85                     !                    climatology.                                      !
              86                     !     03-12-09    yu-tai hou   - use two time stamps to keep tracking  !
              87                     !                    dates for init cond and fcst time. remove volcanic!
              88                     !                    aerosols data in climate hindcast (ictm=-2).      !
              89                     !     03-16-09    yu-tai hou   - included sub-column clouds approx.    !
              90                     !                    control flags isubcsw/isubclw in initialization   !
              91                     !                    subroutine. passed auxiliary cloud control arrays !
              92                     !                    icsdsw/icsdlw (if isubcsw/isubclw =2, it will be  !
              93                     !                    the user provided permutation seeds) to the sw/lw !
              94                     !                    radiation calculation programs. also moved cloud  !
              95                     !                    overlapping control flags iovrsw/iovrlw from main !
              96                     !                    radiation routines to the initialization routines.!
              97                     !     04-02-09    yu-tai hou   - modified surface control flag iems to !
              98                     !                    have additional function of if the surface-air    !
              99                     !                    interface have the same or different temperature  !
             100                     !                    for radiation calculations.                       !
             101                     !     04-03-09    yu-tai hou   - modified to add lw surface emissivity !
             102                     !                    as output variable. changed the sign of sfcnsw to !
             103                     !                    be positive value denote solar flux goes into the !
             104                     !                    ground (this is needed to reduce sign confusion   !
             105                     !                    in other part of model)                           !
             106                     !     09-09-09    fanglin yang (thru s.moorthi) added qme5 qme6 to e-20!
             107                     !     01-09-10    sarah lu     - added gocart option, revised grrad for!
             108                     !                    gocart coupling. calling argument modifed: ldiag3 !
             109                     !                    removed; cldcov/fluxr sequence changed; cldcov is !
             110                     !                    changed from accumulative to instant field and    !
             111                     !                    from input/output to output field                 !
             112                     !     01-24-10    sarah lu     - added aod to fluxr, added prslk and   !
             113                     !                    oz to setaer input argument (for gocart coupling),!
             114                     !                    added tau_gocart to setaer output argument (for,  !
             115                     !                    aerosol diag by index of nv_aod)                  !
             116                     !     07-08-10    s.moorthi - updated the nems version for new physics !
             117                     !     07-28-10    yu-tai hou   - changed grrad interface to allow all  !
             118                     !                    components of sw/lw toa/sfc instantaneous values  !
             119                     !                    being passed to the calling program. moved the    !
             120                     !                    computaion of sfc net sw flux (sfcnsw) to the     !
             121                     !                    calling program. merged carlos' nmmb modification.!
             122                     !     07-30-10    s. moorthi - corrected some errors associated with   !
             123                     !                    unit changes                                      !
             124                     !     12-02-10    s. moorthi/y. hou - removed the use of aerosol flags !
             125                     !                    'iaersw' 'iaerlw' from radiations and replaced    !
             126                     !                    them by using the runtime variable laswflg and    !
             127                     !                    lalwflg defined in module radiation_aerosols.     !
             128                     !                    also replaced param nspc in grrad with the use of !
             129                     !                    max_num_gridcomp in module radiation_aerosols.    !
             130                     !     jun 2012    yu-tai hou   - added sea/land madk 'slmsk' to the    !
             131                     !                    argument list of subrotine setaer call for the    !
             132                     !                    newly modified horizontal bi-linear interpolation !
             133                     !                    in climatological aerosols schem. also moved the  !
             134                     !                    virtual temperature calculations in subroutines   !
             135                     !                    'radiation_clouds' and 'radiation_aerosols' to    !
             136                     !                    'grrad' to reduce repeat comps. renamed var oz as !
             137                     !                    tracer to reflect that it carries various prog    !
             138                     !                    tracer quantities.                                !
             139                     !                              - modified to add 4 compontents of sw   !
             140                     !                    surface downward fluxes to the output. (vis/nir;  !
             141                     !                    direct/diffused). re-arranged part of the fluxr   !
             142                     !                    variable fields and filled the unused slots for   !
             143                     !                    the new components.  added check print of select  !
             144                     !                    data (co2 value for now).                         !
             145                     !                              - changed the initialization subrution  !
             146                     !                    'radinit' into two parts: 'radinit' is called at  !
             147                     !                    the start of model run to set up radiation related!
             148                     !                    fixed parameters; and 'radupdate' is called in    !
             149                     !                    the time-loop to update time-varying data sets    !
             150                     !                    and module variables.                             !
             151                     !     sep 2012    h-m lin/y-t hou added option of extra top layer for  !
             152                     !                    models with low toa ceiling. the extra layer will !
             153                     !                    help ozone absorption at higher altitude.         !
             154                     !     nov 2012    yu-tai hou   - modified control parameters through   !
             155                     !                    module 'physpara'.                                !
             156                     !     jan 2013    yu-tai hou   - updated subr radupdate for including  !
             157                     !                    options of annual/monthly solar constant table.   !
             158                     !     mar 2013    h-m lin/y-t hou corrected a bug in extra top layer   !
             159                     !                    when using ferrier microphysics.                  !
             160                     !     may 2013    s. mooorthi - removed fpkapx                         !
             161                     !     jul 2013    r. sun - added pdf cld and convective cloud water and!
             162                     !	             cover for radiation                               !
             163                     !                                                                      !

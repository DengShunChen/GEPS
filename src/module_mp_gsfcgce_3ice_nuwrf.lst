            4357     6                             qsi(i,j)=rp0*exp(c218-c580*rtair(i,j))
            4358     6                             ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            4359     6               !
            4360     6                             y1(i,j)=r10ar/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            4361     6                                     *qsi(i,j))
            4362     6                             y2(i,j)=.78/zs(i,j)**2+r101f*scv(i,j)/zs(i,j)**bsh5
            4363     6                             psdep(i,j)=r10t*ssi(i,j)*y2(i,j)/y1(i,j)
            4364     6                             pssub(i,j)=psdep(i,j)
            4365     6                             psdep(i,j)=r2is*max(psdep(i,j), 0.)
            4366     6                             pssub(i,j)=r2is*max(-qs(i,j), min(pssub(i,j), 0.))
            4367     6               
            4368     7                             if (ihail.eq.1) then
            4369     7                                y2(i,j)=.78/zg(i,j)**2+r20bq*scv(i,j)/zg(i,j)**bgh5
            4370     7                             else
            4371     7                                y2(i,j)=.78/zg(i,j)**2+r20bs*scv(i,j)/zg(i,j)**bgh5
            4372     7                             endif
            4373     6               
            4374     6                             pgsub(i,j)=r2ig*r20t*ssi(i,j)*y2(i,j)/y1(i,j)
            4375     6                             dm(i,j)=qv(i,j)+qb0-qsi(i,j)
            4376     6                             rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            4377     6               
            4378     6               !     ********   DEPOSITION OR SUBLIMATION OF QS  **********************
            4379     6               
            4380     6                             y1(i,j)=dm(i,j)/(1.+rsub1(i,j))
            4381     6                             psdep(i,j)=r2is*min(psdep(i,j),max(y1(i,j),0.))
            4382     6                             y2(i,j)=min(y1(i,j),0.)
            4383     6                             pssub(i,j)=r2is*max(pssub(i,j),y2(i,j))
            4384     6               
            4385     6               !     ********   SUBLIMATION OF QG   ***********************************
            4386     6               
            4387     6                             dd(i,j)=max((-y2(i,j)-qs(i,j)), 0.)
            4388     6                             pgsub(i,j)=r2ig*min(dd(i,j), qg(i,j), max(pgsub(i,j),0.))
            4389     6               
            4390     6                             psdep(i,j)=dlt1(i,j)*psdep(i,j)
            4391     6                             pssub(i,j)=(1.-dlt1(i,j))*pssub(i,j)
            4392     6                             pgsub(i,j)=(1.-dlt1(i,j))*pgsub(i,j)
            4393     6               
            4394     6                             pt(i,j)=pt(i,j)+ascp*(psdep(i,j)+pssub(i,j)-pgsub(i,j))
            4395     6                             qv(i,j)=qv(i,j)+pgsub(i,j)-pssub(i,j)-psdep(i,j)
            4396     6                             qs(i,j)=qs(i,j)+psdep(i,j)+pssub(i,j)
            4397     6                             qg(i,j)=qg(i,j)-pgsub(i,j)
            4398     6               
            4399     6                          endif ! tair
            4400     5               
            4401     5                       else   ! IF (IMPROVE .NE. 3)
            4402     5               
            4403     6                          if (tair(i,j) .lt. t0) then
            4404     6               
            4405     6                             rtair(i,j)=1./(tair(i,j)-c76)
            4406     6                             y2(i,j)=exp(c218-c580*rtair(i,j))
            4407     6                             qsi(i,j)=rp0*y2(i,j)
            4408     6                             esi(i,j)=c610*y2(i,j)
            4409     6               
            4410     6                             SSI(I,J)=(QV(I,J)+QB0)/QSI(I,J)-1.
            4411     6                             IF (DLT1(I,J).EQ.1.) SSI(I,J)=max(SSI(I,J),0.)
            4412     6                             IF (DLT1(I,J).EQ.0.) SSI(I,J)=min(SSI(I,J),0.)
            4413     6                             DM(I,J)=QV(I,J)+QB0-QSI(I,J)
            4414     6                             RSUB1(I,J)=CS580*QSI(I,J)*RTAIR(I,J)*RTAIR(I,J)
            4415     6                             DD1(I,J)=DM(I,J)/(1.+RSUB1(I,J))
            4416     6                             Y3(I,J)=1./TAIR(I,J)
            4417     6                             DD(I,J)=Y3(I,J)*(RN10A*Y3(I,J)-RN10B)+RN10C*TAIR(I,J)/ESI(I,J)
            4418     6                             TAIRC(I,J)=TAIR(I,J)-T0
            4419     6               !
            4420     6                           ftns(i,j)=1.
            4421     6                           ftng(i,j)=1.
            4422     6                           ftns0(i,j)=1.
            4423     6                           ftng0(i,j)=1.
            4424     6               !            IF (IMPROVE .GE. 3) THEN
            4425     6                           call sgmap(1,qs(i,j),r00,tairc(i,j),ftns0(i,j))
            4426     6                           call sgmap(2,qg(i,j),r00,tairc(i,j),ftng0(i,j))
            4427     6                           ftns(i,j)=ftns0(i,j)
            4428     6                           ftng(i,j)=ftng0(i,j)
            4429     6               !            ENDIF
            4430     6               !
            4431     6                             Y4(I,J)=R10T*SSI(I,J)*(R101R/ZS(I,J)**2+R102RF/ZS(I,J)**BSH5)   &
            4432     6                                               /DD(I,J)*ftns(i,j)
            4433     6                             PSDEP(I,J)=max(-QS(I,J), Y4(I,J))
            4434     6                             DD(I,J)=Y3(I,J)*(RN20A*Y3(I,J)-RN20B)+RN10C*TAIR(I,J)/ESI(I,J)
            4435     6                             Y2(I,J)=R191R/ZG(I,J)**2+R192RF/ZG(I,J)**BGH5
            4436     6                             PGDEP(I,J)=MAX(-qg(i,j), R20T*SSI(I,J)*Y2(I,J)/DD(I,J)          &
            4437     6                                                    *ftng(i,j))
            4438     6               !      ******************************************************************
            4439     6                             Y5(I,J)=min(0.,DD1(I,J))
            4440     6                             DD1(I,J)=max(0.,DD1(I,J))
            4441     7                             IF (DLT1(I,J).EQ.1.) THEN
            4442     7                                Y1(I,J)=MIN(PSDEP(I,J)+PGDEP(I,J), DD1(I,J) )
            4443     8                                IF (PSDEP(I,J).ge.DD1(I,J)) THEN
            4444     8                                   PSDEP(I,J)=DD1(I,J)
            4445     8                                   PGDEP(I,J)=0.
            4446     8                                ENDIF
            4447     7                                IF (DD1(I,J).gt.PSDEP(I,J).and.(PSDEP(I,J)+PGDEP(I,J)).gt.  &
            4448     7                                   DD1(I,J)) PGDEP(I,J)=Y1(I,J)-PSDEP(I,J)
            4449     7                             ENDIF
            4450     7                             IF (DLT1(I,J).EQ.0.) THEN
            4451     7                                Y1(I,J)=MAX(PSDEP(I,J)+PGDEP(I,J), Y5(I,J) )
            4452     8                                IF (Y5(I,J).gt.(PSDEP(I,J)+PGDEP(I,J))) THEN
            4453     8                                   Y3(I,J)=(PSDEP(I,J)+PGDEP(I,J))
            4454     9                                   IF (Y3(I,J).ne.0.0) THEN
            4455     9                                      PSDEP(I,J)=PSDEP(I,J)/Y3(I,J)*Y5(I,J)
            4456     9                                      PGDEP(I,J)=PGDEP(I,J)/Y3(I,J)*Y5(I,J)
            4457     9                                   ENDIF
            4458     8                                ENDIF
            4459     7                             ENDIF
            4460     6               
            4461     6                             PSSUB(i,j)=r2is*min(PSDEP(i,j), 0.)
            4462     6                             PSDEP(i,j)=r2is*max(PSDEP(i,j), 0.)
            4463     6                             PGSUB(i,j)=r2ig*min(PGDEP(i,j), 0.)
            4464     6                             PGDEP(i,j)=r2ig*max(PGDEP(i,j), 0.)
            4465     6               
            4466     6                             pt(i,j)=pt(i,j)+ascp*y1(i,j)
            4467     6                             qv(i,j)=qv(i,j)-y1(i,j)
            4468     6                             qs(i,j)=qs(i,j)+psdep(i,j)+pssub(i,j)
            4469     6                             qg(i,j)=qg(i,j)+pgdep(i,j)+pgsub(i,j)
            4470     6               
            4471     6                          endif   ! if (tair(i,j) .lt. t0)
            4472     5               
            4473     5                       endif !  if (improve.ne.3)
            4474     4               

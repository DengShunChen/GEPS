            4854     5                              stop
            4855     5                           endif
            4856     4                          ! for cloud water, estimate lambda (slope of gamma distribution)
            4857     4                                  mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            4858     4                                  gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4859     4                                  gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4860     4                                  lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &

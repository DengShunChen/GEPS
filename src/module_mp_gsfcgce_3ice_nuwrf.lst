            1565                           rn9=cpi2*tns*tng*roqs
            1566                             if (improve.eq.-1) egs=.01
            1567                             if (improve .eq. 3) rn9=cpi2*egs*tns*tng*roqs
            1568                     !
            1569                           rn10=2.*cpi*tns
            1570                             If (improve .eq. 3)  rn10=4.*tns
            1571                           rn101=.31*ga5dh*sqrt(cc1)
            1572                           rn10a=als*als/rw
            1573     1                     If (improve .eq. 3) then
            1574     1                        rn101=.65
            1575     1                        rn102=.44*sqrt(as/dva)*ga5dh
            1576     1                        rn10a=alv*als*amw/(tca*ars)
            1577     1                     endif
            1578                           rn10b=alv/tca
            1579                           rn10c=ars/(dwv*amw)
            1580                     !
            1581                           rn11=2.*cpi*tns/alf
            1582                             If (improve .eq. 3)  rn11=2.*cpi*tns*tca/alf
            1583                           rn11a=cw/alf
            1584                     
            1585                     !     AMI50=1.51e-7
            1586                           ami50=3.84e-6               ! 6/15/02 tao's
            1587                     !     AMI40=2.41e-8
            1588                           ami40=3.08e-8               ! 6/15/02 tao's
            1589                           ami50=4.8e-7*(100./50.)**3         ! Roger: actually = 3.84e-6
            1590                             if (improve.eq.3) ami50=4.8e-7
            1591                     !       ami40=2.46e-7
            1592                     !       ami40=2.46e-7*.5**3              ! Roger: actually = 3.08e-8
            1593                             if (improve.eq.3) ami40=2.46e-7
            1594                     !
            1595                           eiw=1.
            1596                     !     UI50=20.
            1597                           ui50=100. ! 6/15/02 tao's
            1598                           ri50=2.*5.e-3
            1599                             if (improve.eq.3) ri50=5.e-3
            1600                     !
            1601                           cmn=1.05e-15
            1602                           rn12=cpi*eiw*ui50*ri50**2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aa2, aa1, BergCon3, BergCon1, rn25a
                                   <<<      BergCon2, rn12b, rn13, BergCon4, rn12a
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 7  FILL 11
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1603     1  pp    v            do k=1,31
            1604     1   p    v               y1=1.-aa2(k)
            1605     1   p    v               rn13(k)=aa1(k)*y1/(ami50**y1-ami40**y1)
            1606     1   p    v               rn12a(k)=rn13(k)/ami50
            1607     1   p    v               rn12b(k)=aa1(k)*ami50**aa2(k)
            1608     1   p    v               rn25a(k)=aa1(k)*cmn**aa2(k)
            1609     1   p    v                 BergCon1(k)=6.*aa1(k)*ami50**(aa2(k)-1.)
            1610     1   p    v               BergCon2(k)=-2.*aa1(k)*ami50**aa2(k)*1.2
            1611     1               
            1612     1   p    v               BergCon3(k)=6.*aa2(k)/((aa2(k)+1.)*(aa2(k)+2.))        &
            1613     1                                  *aa1(k)*ami50**(aa2(k)-1.)
            1614     1   p    v               BergCon4(k)=2.*(1.-aa2(k))/((aa2(k)+1.)*(aa2(k)+2.))   &
            1615     1                                  *aa1(k)*ami50**aa2(k)*1.2
            1616     1   p    v            enddo
            1617                     !
            1618                           egw=1.    !Roger: ewc in Steve's code
            1619                     
            1620                             if(improve.ge.3) egw=0.65
            1621                     
            1622                           rn14=.25*cpi*egw*tng*ga3g*ag
            1623                     !       egc=1.
            1624                     !       rn14=.25*cpi*egc*ac2*tng*ga3g      ! ac2 = ag in Steve's code
            1625                           egi=.1
            1626                             if(improve.eq.-1) egi=.001
            1627                           rn15=.25*cpi*egi*tng*ga3g*ag
            1628                     !     rn15=.25*cpi*egi*tng*ac2*ga3g        ! ac2 = ag in Steve's code
            1629                     
            1630                           egi=1.
            1631                           rn15a=.25*cpi*egi*tng*ga3g*ag
            1632                     !     rn15a=.25*cpi*egi*tng*ac2*ga3g       ! ac2 = ag in Steve's code
            1633                     
            1634                           egr=1.
            1635                           rn16=cpi2*egr*tng*tnw*roqr
            1636                           rn17=2.*cpi*tng
            1637                           rn17a=.31*ga5gh*sqrt(ag)
            1638                           rn17b=cw-ci
            1639                           rn17c=cw
            1640     1                     if (improve .eq. 3) then
            1641     1                        rn171=2.*cpi*tng*alv*dwv
            1642     1                        rn172=2.*cpi*tng*tca
            1643     1                        rn17a=.31*ga5gh*sqrt(ag/dva)
            1644     1                     endif
            1645                     !
            1646                           apri=.66
            1647                           bpri=1.e-4
            1648                           bpri=0.5*bpri                        ! 6/17/02 tao's
            1649                           rn18=20.*cpi2*bpri*tnw*roqr
            1650                           rn18a=apri
            1651                           rn19=2.*cpi*tng/alf
            1652                     !      if (improve .eq. 3) rn19=2.*cpi*tng*tca/alf
            1653                            rn191=.78                     !Are this same as rnn191 (listed below)?
            1654                            rn192=.31*ga5gh*sqrt(ag/dva)  !Are this same as rnn192 (listed below)?
            1655                           rn19a=.31*ga5gh*sqrt(ag)
            1656                           rn19b=cw/alf
            1657                     
            1658                     !      rnn191=.78
            1659                     !      rnn192=.31*ga5gh*sqrt(ag/dva)
            1660     1                      if (improve .eq. 3) then
            1661     1                         rn19=2.*cpi*tng*tca/alf
            1662     1                         rn19a=cw/alf
            1663     1                      endif
            1664                     !
            1665                           rn20=2.*cpi*tng
            1666                           rn20a=als*als/rw
            1667                           rn20b=.31*ga5gh*sqrt(ag)
            1668                           rn30a=alv*alv*amw/(tca*ars) ! EMK per Roger's 20110816 code
            1669                           rn30=2.*cpi*tng             ! EMK per Roger's 20110816 code
            1670     1                     if (improve .eq. 3) then
            1671     1                        rn20a=als*als*amw/(tca*ars)
            1672     1                        rn20b=als/tca
            1673     1               !         rn30=2.*cpi*tng
            1674     1               !         rn30a=alv*alv*amw/(tca*ars)
            1675     1                     endif
            1676                     !
            1677                           bnd3=2.e-3
            1678                           rn21=1.e3*1.569e-12/0.15
            1679                              if (improve .eq. 3)  rn21=1.e-3
            1680                           bnd21=1.5e-3
            1681                     !
            1682                           erw=1. ! erc in Steve's code
            1683                           rn22=.25*cpi*erw*ac1*tnw*ga3b
            1684     1                     if (improve .eq. 3) then
            1685     1                        erc=1.
            1686     1                        rn22=.25*cpi*erc*tnw
            1687     1                     endif
            1688                     !
            1689                           rn23=2.*cpi*tnw
            1690                           rn23a=.31*ga5bh*sqrt(ac1)
            1691                           rn23b=alv*alv/rw
            1692     1                     if (improve .eq. 3) then
            1693     1                        rn231=.78
            1694     1                        rn232=.31*ga3*sqrt(3.e3/dva)
            1695     1                     endif
            1696                     !
            1697                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1698                     !cc
            1699                     !cc        "c0" in routine      "consat" (2d), "consatrh" (3d)
            1700                     !cc        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
            1701                     !cc        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
            1702                     
            1703                            if (improve .eq. 3) itaobraun=1
            1704                     
            1705     1                      if (itaobraun .eq. 0) then
            1706     1                        cn0=1.e-8
            1707     1                        beta=-.6
            1708     1                      else if (itaobraun .eq. 1) then
            1709     1                        cn0=1.e-6
            1710     1                        beta=-.46
            1711     1                      endif
            1712                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1713                     !
            1714                           rn25=cn0
            1715                     !      rn30a=alv*als*amw/(tca*ars)
            1716                           rn30b=alv/tca
            1717                           rn30c=ars/(dwv*amw)
            1718                           rn31=1.e-17
            1719                     
            1720                           rn32=4.*51.545e-4
            1721                     !!
            1722                           rn33=4.*tns
            1723                            rn331=.65
            1724                            rn332=.44*sqrt(as/dva)*ga5dh
            1725                     !        rn332=.44*sqrt(ac1/dva)*ga5dh
            1726                     !
            1727     1                     if (improve .eq. 3) then
            1728     1               !         rn30=2.*cpi*tng
            1729     1                        amc=1./(24.*4.e-9)
            1730     1                        rn34=cpi2*esc*amc*as*roqs*tns*ga6d
            1731     1               !         print *,'rn34, cpi2, esc, amc, as, roqs, tns, ga6d = ', rn34, cpi2, esc, amc, as, roqs, tns, ga6d
            1732     1                        rn35=alv*alv/(cp*rw)
            1733     1                     endif
            1734                         return
            1735                       END SUBROUTINE consat_s
            1736                     
            1737                     !JJS
            1738                     !JJS      REAL FUNCTION GAMMA(X)
            1739                     !JJS        Y=GAMMLN(X)
            1740                     !JJS        GAMMA=EXP(Y)
            1741                     !JJS      RETURN
            1742                     !JJS      END
            1743                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1744                     !JJS      real function GAMMLN (xx)
            1745                       real function gammagce (xx)
            1746                     !**********************************************************************
            1747                       real*8 cof(6),stp,half,one,fpf,x,tmp,ser
            1748                       data cof,stp /  76.18009173,-86.50532033,24.01409822, &
            1749                          -1.231739516,.120858003e-2,-.536382e-5, 2.50662827465 /
            1750                       data half,one,fpf / .5, 1., 5.5 /
            1751                     !
            1752                           x=xx-one
            1753                           tmp=x+fpf
            1754                           tmp=(x+half)*log(tmp)-tmp
            1755                           ser=one
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1756     1   s   fs            do  j=1,6
            1757     1   s   fs               x=x+one
            1758     1   m   fm              ser=ser+cof(j)/x
            1759     1   p   fv            enddo !j
            1760                           gammln=tmp+log(stp*ser)
            1761                     !JJS
            1762                           gammagce=exp(gammln)
            1763                     !JJS
            1764                           return
            1765                      END FUNCTION gammagce
            1766                     
            1767                     ! compute base snow/graupel intercept scaling factor
            1768                       subroutine sgmap(isg,qsg,r00,tairc,ftnsg)
            1769                       implicit none
            1770                     
            1771                     !      common/size/ tnw,tns,tng,roqs,roqg,roqr  !defined in the beginning of the module
            1772                       integer, intent(in)  :: isg
            1773                       real,    intent(in)  :: qsg, r00, tairc
            1774                       real,    intent(out) :: ftnsg
            1775                     
            1776                     ! LOCAL variables
            1777                     
            1778                     !  for snomap
            1779                       real ::  xs,sno11,sno00,dsno11,dsno00,sexp11,sexp00,stt,   &
            1780                                     stexp,sbase,tslopes,dsnomin,slim
            1781                     !  for grpmap
            1782                       real ::  xg,grp11,grp00,dgrp11,dgrp00,gexp11,gexp00,gtt,   &
            1783                                     gtexp,gbase,tslopeg,dgrpmin, glim
            1784                     
            1785                       real :: taird, qsg1, xx, fexp, cpi, cmin
            1786                       real :: ftnsT, sno1, dsno1, sexp1, ftnsQ, tnsmax
            1787                       real :: ftngT, grp1, dgrp1, gexp1, ftngQ, tngmax
            1788                     
            1789                       CPI=4.*ATAN(1.)
            1790                       cmin=1.e-20
            1791                     
            1792                       tslopes=0.03579323   ! increase tns by 3.5 from 0 to -35C
            1793                       tslopeg=0.03138892   ! increase tng by  3 from  0 to -35C
            1794                     
            1795                       dsnomin=0.0110       !minimum snow diameter (cm)
            1796                       dgrpmin=0.0145       !minimum graupel diameter (cm)
            1797                     
            1798                       dsnomin=dsnomin**4.*roqs*cpi
            1799                       dgrpmin=dgrpmin**4.*roqg*cpi
            1800                     
            1801                       xs=0.97
            1802                       sno11=0.65                !cold aloft
            1803                       sno00=0.30                !near melting level
            1804                       dsno11=1.25               !Tao 02/23/2012 used to be 1.15
            1805                       dsno00=0.60               !Tao 02/23/2012 used to be 0.70
            1806                       sexp11=1.2
            1807                       sexp00=0.7
            1808                       stt=-20.
            1809                       stexp=0.25
            1810                       slim=0.95
            1811                       sbase=0.00110
            1812                     
            1813                       xg=0.98
            1814                       grp11=0.75
            1815                       grp00=0.45
            1816                       dgrp11=3.95
            1817                       dgrp00=0.25
            1818                       gexp11=0.35
            1819                       gexp00=0.6
            1820                       gtt=-20.
            1821                       gtexp=0.30
            1822                       glim=0.90
            1823                       gbase=0.0058
            1824                     
            1825                       ftnsg=1.
            1826                     
            1827     1                 if (qsg .gt. cmin) then
            1828     1               
            1829     1                    taird=min(0.,max(-35.,tairc)+0.0)
            1830     1                    qsg1=qsg*r00*1.e6
            1831     1               
            1832     2                    if (isg.eq.1) then                          !snow
            1833     2                       ftnsT=exp(-1.*tslopes*taird)
            1834     2                       sno1=sno11
            1835     2                       dsno1=dsno11
            1836     2                       sexp1=sexp11
            1837     2               
            1838     3                       if (taird.gt.stt) then
            1839     3                          sno1=sno00-(sno00-sno11)*(taird/stt)**stexp
            1840     3                          dsno1=dsno00-(dsno00-dsno11)*(taird/stt)**stexp
            1841     3                          sexp1=sexp00-(sexp00-sexp11)*(taird/stt)**stexp
            1842     3                       endif !taird
            1843     2               
            1844     2                       xx=xs-xs*min(slim,max(0.,(qsg1-sno1)/dsno1)**sexp1)
            1845     2                       ftnsT=ftnsT**xx
            1846     2                       fexp=xx
            1847     2                       ftnsQ=1.0
            1848     2                       ftnsQ=(qsg1/sbase)**fexp
            1849     2                       ftnsg=ftnsT*ftnsQ
            1850     2                       tnsmax=r00*qsg/dsnomin
            1851     2               
            1852     2                       if (ftnsg*tns.gt.tnsmax) ftnsg=tnsmax/tns
            1853     2               
            1854     2                    else if (isg.eq.2) then                      !graupel
            1855     2               
            1856     2                            ftngT=exp(-1.*tslopeg*taird)
            1857     2                            grp1=grp11
            1858     2                            dgrp1=dgrp11
            1859     2                            gexp1=gexp11
            1860     2               
            1861     3                            if (taird.gt.gtt) then
            1862     3                               grp1=grp00-(grp00-grp11)*(taird/gtt)**gtexp
            1863     3                               dgrp1=dgrp00-(dgrp00-dgrp11)*(taird/gtt)**gtexp
            1864     3                               gexp1=gexp00-(gexp00-gexp11)*(taird/gtt)**gtexp
            1865     3                            endif !taird
            1866     2               
            1867     2                            xx=xg-xg*min(glim,max(0.0,(qsg1-grp1)/dgrp1)**gexp1)
            1868     2                            ftngT=ftngT**xx
            1869     2                            fexp=xx
            1870     2                            ftngQ=1.0
            1871     2                            ftngQ=(qsg1/gbase)**fexp
            1872     2                            ftnsg=ftngT*ftngQ
            1873     2                            tngmax=r00*qsg/dgrpmin
            1874     2                            if (ftnsg*tng.gt.tngmax) ftnsg=tngmax/tng
            1875     2               
            1876     2                    endif !isg
            1877     1               
            1878     1                 endif !qsg
            1879                     
            1880                       return
            1881                       end subroutine sgmap
            1882                     
            1883                     !     compute fall speed of cloud rain and ice
            1884                       subroutine vqrqi(isg,improve,r00,fv,qri,ww1)
            1885                       implicit none
            1886                     
            1887                     !      common/size/ tnw,tns,tng,roqs,roqg,roqr    ! defined in the beginning of the module
            1888                     !      common/rterv/ zrc,zgc,zsc,vr0,vr1,vr2,vr3,vgc,vsc   ! defined in the beginning of the module
            1889                     
            1890                       integer, intent(in) :: isg, improve
            1891                       real, intent(in) :: r00, fv
            1892                       real, intent(inout) :: qri, ww1
            1893                     
            1894                     ! LOCAL variables
            1895                       integer :: ic
            1896                       real  :: y1,vr,vs,vg
            1897                       real  :: cmin, cpi, const_vt, const_d, const_m
            1898                       real  :: bb1, bb2
            1899                       real, dimension(7) ::  aice, vice
            1900                       data aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./
            1901                       data vice/5,15,30,35,40,45,50/
            1902                     
            1903                       cmin=1.e-40
            1904                       CPI=4.*ATAN(1.)
            1905     1                 if (improve.gt.2) then
            1906     1                    const_vt=1.49e4
            1907     1                    const_d=11.9
            1908     1                    const_m=1./5.38e7
            1909     1                 endif
            1910                     
            1911                       y1=r00*qri
            1912                       ww1=0.
            1913                     
            1914     1                 if (y1 .gt. cmin) then
            1915     1               
            1916     2                   if (isg.eq.1) then                             !  rain
            1917     2               
            1918     2                      vs=sqrt( y1 )
            1919     2                      vg=sqrt( vs )
            1920     2               !       vr=vr0+vr1*vg+vr2*vs+vr3*vg*vs
            1921     2                      vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
            1922     2                      ww1=max(fv*vr, 0.e0)
            1923     2               
            1924     2                   else if (isg.eq.2) then                         ! cloud ice
            1925     2               
            1926     2                           y1=1.e6*r00*qri                            ! to g/m**3
            1927     2               
            1928     3                           if (y1 .gt. 1.e-6) then
            1929     4                              if (improve.eq.3) then                      ! from Hong et al. (2004)
            1930     4                                 y1=y1*1.e-3
            1931     4                                 bb1=const_m*y1**0.25
            1932     4                                 bb2=const_d*bb1**0.5
            1933     4                                 ww1=max(const_vt*bb2**1.31, 0.0)
            1934     4                                 ww1=ww1*100. !cm/s
            1935     4                                 if (ww1 .gt. 50.) ww1=50.               ! SLang
            1936     4                              else                                      ! from Starr & Cox (1985)
            1937     5                                 if (y1 .gt. aice(7)) then
            1938     5                                    ww1=vice(7)
            1939     5                                 else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 308
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1940     6   s   fs                           do ic=1,6
            1941     7   p   fm                              if (y1.gt.aice(ic) .and. y1.le.aice(ic+1)) then
            1942     7   p   fm                                 ww1=vice(ic)+(vice(ic+1)-vice(ic))*    &
            1943     7                                            (y1-aice(ic))/(aice(ic+1)-aice(ic))
            1944     7   p   fv                                 if (ww1 .le. 0.0) ww1=0.
            1945     7   p   fv                              endif
            1946     6   p   fv                           enddo
            1947     5                                 endif  !y1
            1948     4                              endif  !imrpove
            1949     3                           endif  !y1
            1950     2                   endif  !isg
            1951     1                 endif !y1
            1952                     
            1953                       return
            1954                       end subroutine vqrqi
            1955                     
            1956                       SUBROUTINE saticel_s (dt, ihail, itaobraun, ice2, istatmin,          &
            1957                                            new_ice_sat, id, improve,                       &
            1958                                            ptwrf, qvwrf, qlwrf, qrwrf,                     &
            1959                                            qiwrf, qswrf, qgwrf,                            &
            1960                                            rho_mks, pi_mks, p0_mks, w_mks,                 &
            1961                                            itimestep, xland,                               &
            1962                                            refl_10cm, diagflag, do_radar_ref,           & ! GT added for reflectivity calcs
            1963                                            refc, refr, refi, refs, refg,                   & ! cloud effective radius
            1964                     !                       ids,ide, jds,jde, kds,kde,                      &
            1965                                            ims,ime, jms,jme, kms,kme,                      &
            1966                                            its,ite, jts,jte, kts,kte,                      &
            1967                     !NUWRF BEGIN
            1968                                            physc, physe, physd, physs, physm, physf,       &
            1969                                            acphysc, acphyse, acphysd, acphyss, acphysm, acphysf &
            1970                     #if ( WRF_CHEM == 1)
            1971                     !JJS 20110525 vvvvv
            1972                                            ,aero, icn_diag, nc_diag, gid,                   &
            1973                     !JJS 20110525 ^^^^^
            1974                     ! EMK
            1975                                            chem_opt,                                       &
            1976                                            gsfcgce_gocart_coupling                        &
            1977                     #endif
            1978                                            )
            1979                     !NUWRF END
            1980                     !-----------------------------------------------------------------------
            1981                     !  USE module_dm
            1982                       IMPLICIT NONE
            1983                     !-----------------------------------------------------------------------
            1984                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1985                     !                                                                         c
            1986                     !   History:                                                              c
            1987                     !                                                                         c
            1988                     !   Coded by Tao (1989-2003), modified by S. Lang (2006/07)               c
            1989                     !                                                                         c
            1990                     !   Implemented into WRF  by Jainn Shi 2006/2007                          c

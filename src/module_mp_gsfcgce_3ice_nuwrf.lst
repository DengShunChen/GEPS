             312                     !+---+-----------------------------------------------------------------+
             313                     
             314                     
             315                     !
             316                     !c  ihail = 0    for graupel, for tropical region
             317                     !c  ihail = 1    for hail, for mid-lat region
             318                     
             319                     ! itaobraun: 0 for Tao's constantis, 1 for Braun's constants
             320                     !c        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
             321                     !c        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
             322                        itaobraun = 0 ! Set to zero in NUWRF
             323                     
             324                     ! Use Steve's new improvement   9/18/2009
             325                     
             326                         improve = 3
             327                     !   improve = -20         ! to use the original codes
             328                     
             329                     !c  ice2 = 0    for 3 ice --- ice, snow and graupel/hail
             330                     !c  ice2 = 1    for 2 ice --- ice and snow only
             331                     !c  ice2 = 2    for 2 ice --- ice and graupel only, use ihail = 0 only
             332                     !c  ice2 = 3    for 0 ice --- no ice, warm only
             333                     
             334                     !  if (ice2 .eq. 2) ihail = 0
             335                     
             336                       i24h=nint(86400./dt_in)
             337     1                 if (mod(itimestep,i24h).eq.1) then
             338     1               !     write(6,*) 'ihail=',ihail,'  ice2=',ice2
             339     2                    if (ice2.eq.0) then
             340     2               !        write(6,*) 'Running 3-ice scheme in GSFCGCE with'
             341     3                       if (ihail.eq.0) then
             342     3               !           write(6,*) '     ice, snow and graupel'
             343     3                       else if (ihail.eq.1) then
             344     3               !                write(6,*) '     ice, snow and hail'
             345     3                       else
             346     3               !             write(6,*) 'ihail has to be either 1 or 0'
             347     3               !             call wrf_error_fatal ('gsfcgce_2ice in namelist.input has to be either 1 or 0')
             348     3                            stop
             349     3                       endif !ihail
             350     2                    else if (ice2.eq.1) then
             351     2               !             write(6,*) 'Running 2-ice scheme in GSFCGCE with'
             352     2               !             write(6,*) '     ice and snow'
             353     2                    else if (ice2.eq.2) then
             354     2               !             write(6,*) 'Running 2-ice scheme in GSFCGCE with'
             355     2               !             write(6,*) '     ice and graupel'
             356     2                    else if (ice2.eq.3) then
             357     2               !             write(6,*) 'Running warm rain only scheme in GSFCGCE without any ice'
             358     2                    else
             359     2               !             write(6,*) 'gsfcgce_2ice in namelist.input has to be 0, 1, 2, or 3'
             360     2               !             call wrf_error_fatal ('gsfcgce_2ice in namelist.input has to be 0, 1, 2, or 3')
             361     2                            stop
             362     2                    endif !ice2
             363     1                 endif !itimestep
             364                     
             365                     !c  new_ice_sat = 0, 1, 2, or 3
             366                         new_ice_sat = 3 ! Set to 3 in NUWRF
             367                     
             368                     !c istatmin
             369                         istatmin = 180
             370                     
             371                     !c id = 0  without in-line staticstics
             372                     !c id = 1  with in-line staticstics
             373                         id = 0
             374                     
             375                     !c ibud = 0 no calculation of dth, dqv, dqrest and dqall
             376                     !c ibud = 1 yes
             377                         ibud = 0
             378                     
             379                     !jjs   dt=dt_in
             380                     !jjs   rhoe_s=1.29
             381                     !
             382                     !   IF (P_QI .lt. P_FIRST_SCALAR .or. P_QS .lt. P_FIRST_SCALAR) THEN
             383                     !      CALL wrf_error_fatal3 ( "module_mp_lin.b" , 130 ,  'module_mp_lin: Improper use of Lin et al scheme; no ice phase. Please chose another one.')
             384                     !   ENDIF
             385                     
             386                     !NUWRF BEGIN
             387                     #if ( WRF_CHEM == 1)
             388                     ! JJS 20110525 vvvvv
             389                     ! Create CCN and IN candidate look-up table. Only need to run once at the first timestep of each run
             390                     !    if (itimestep .eq. 1) call makelut_ccn_icn
             391                     ! EMK 2011/08/25
             392                           if (mod(itimestep,i24h).eq.1)   &
             393                     !         print *, 'in mp_gsfcgce_3ice_nuwrf, chem_opt, gsfcgce_gocart_coupling  = ', chem_opt, gsfcgce_gocart_coupling
             394                           if (first_makelut) then
             395                              ! EMK...Only execute when GOCART and coupling turned on.
             396                              if ( (chem_opt == 300 .or. chem_opt == 301 .or. &
             397                                    chem_opt == 302 .or. chem_opt == 303) .and. &
             398                                    (gsfcgce_gocart_coupling == 1)) then
             399                     !            if ( wrf_dm_on_monitor() ) print *,'Goddard MP coupled with Gocart Aerosol'
             400                                 call makelut_ccn_icn
             401                                 first_makelut = .false. ! This value is saved for subsequent calls.
             402                              end if
             403                           end if
             404                     ! JJS 20110525 ^^^^^
             405                     #endif
             406                     
             407                     !c  set up constants used internally in GCE
             408                     
             409                        call consat_s (ihail, itaobraun, improve)
             410                     !NUWRF END
             411                     
             412                     ! calculte fallflux and precipiation in MKS system
             413                     
             414                        call fall_flux(    dt_in, qr, qi, qs, qg, p,               &
             415                                           rho, th, pii, z, dz8w, ht, rainnc,      &
             416                                           rainncv, grav,itimestep,                &
             417                                           snownc, snowncv, sr,                    &
             418                                           graupelnc, graupelncv,                  &
             419                                           ihail, ice2, improve,                   &
             420                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             421                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             422                     
             423                           ! EMK NUWRF...Moved this WRF radar reflectivity initialization to after
             424                           ! fall_flux, as the rhohail and rhograul variables are set in that
             425                           ! subroutine.
             426     1                     IF (NCALL .EQ. 0) THEN
             427     1               !..Set these variables needed for computing radar reflectivity.  These
             428     1               !.. get used within radar_init to create other variables used in the
             429     1               !.. radar module.
             430     1                        xam_r = 3.14159*rhowater/6.
             431     1                        xbm_r = 3.
             432     1                        xmu_r = 0.
             433     1                        xam_s = 3.14159*rhosnow/6.
             434     1                        xbm_s = 3.
             435     1                        xmu_s = 0.
             436     2                        if (ihail .eq. 1) then
             437     2                           xam_g = 3.14159*rhohail/6.
             438     2                        else
             439     2                           xam_g = 3.14159*rhograul/6.
             440     2                        endif
             441     1                        xbm_g = 3.
             442     1                        xmu_g = 0.
             443     1               
             444     1                        call radar_init
             445     1                        NCALL = 1
             446     1                     ENDIF
             447                     !-----------------------------------------------------------------------
             448                     
             449     1                     IF (NCALL .EQ. 0) THEN
             450     1               !..Set these variables needed for computing radar reflectivity.  These
             451     1               !.. get used within radar_init to create other variables used in the
             452     1               !.. radar module.
             453     1                        xam_r = 3.14159*rhowater/6.
             454     1                        xbm_r = 3.
             455     1                        xmu_r = 0.
             456     1                        xam_s = 3.14159*rhosnow/6.
             457     1                        xbm_s = 3.
             458     1                        xmu_s = 0.
             459     2                        if (ihail .eq. 1) then
             460     2                           xam_g = 3.14159*rhohail/6.
             461     2                        else
             462     2                           xam_g = 3.14159*rhograul/6.
             463     2                        endif
             464     1                        xbm_g = 3.
             465     1                        xmu_g = 0.
             466     1               
             467     1                        call radar_init
             468     1                        NCALL = 1
             469     1                     ENDIF
             470                     
             471                     !c Negative values correction
             472                     
             473                     !   iskip = 1
             474                     !
             475                     !   if (iskip.eq.0) then
             476                     !      call negcor(qv,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             477                     !                           itimestep,1,             &
             478                     !                           its,ite,jts,jte,kts,kte)
             479                     !      call negcor(ql,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             480                     !                           itimestep,2,             &
             481                     !                           its,ite,jts,jte,kts,kte)
             482                     !      call negcor(qr,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             483                     !                           itimestep,3,             &
             484                     !                           its,ite,jts,jte,kts,kte)
             485                     !      call negcor(qi,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             486                     !                           itimestep,4,             &
             487                     !                           its,ite,jts,jte,kts,kte)
             488                     !      call negcor(qs,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             489                     !                           itimestep,5,             &
             490                     !                           its,ite,jts,jte,kts,kte)
             491                     !      call negcor(qg,rho,dz8w,ims,ime,jms,jme,kms,kme, &
             492                     !                           itimestep,6,             &
             493                     !                           its,ite,jts,jte,kts,kte)
             494                     !!   else if (mod(itimestep,i24h).eq.1) then
             495                     !!      print *,'no neg correction in mp at timestep=',itimestep
             496                     !   endif ! iskip
             497                     
             498                     !c microphysics in GCE
             499                     
             500                        call SATICEL_S( dt_in, IHAIL, itaobraun, ICE2, istatmin,      &
             501                                        new_ice_sat, id, improve,                     &
             502                     !                   th, th_old, qv, ql, qr,                      &
             503                                        th, qv, ql, qr,                               &
             504                                        qi, qs, qg,                                   &
             505                     !                   qvold, qlold, qrold,                         &
             506                     !                   qiold, qsold, qgold,                         &
             507                                        rho, pii, p, w,                               &
             508                                        itimestep, xland,                             &
             509                                        refl_10cm, diagflag, do_radar_ref,           & ! GT added for reflectivity calcs
             510                                        refc, refr, refi, refs, refg,                 & ! cloud effective radius
             511                     !                   ids,ide, jds,jde, kds,kde,                    & ! domain dims
             512                                        ims,ime, jms,jme, kms,kme,                    & ! memory dims
             513                                        its,ite, jts,jte, kts,kte,                    & ! tile   dims
             514                     !NUWRF BEGIN
             515                                        physc, physe, physd, physs, physm, physf,     &
             516                                        acphysc, acphyse, acphysd, acphyss, acphysm, acphysf &
             517                     
             518                     #if ( WRF_CHEM == 1)
             519                     !JJS 20110525     vvvvv
             520                                        ,aero, icn_diag, nc_diag, gid,                 &
             521                     !JJS 20110525     ^^^^^
             522                     !EMK
             523                                        chem_opt,                                     &
             524                                        gsfcgce_gocart_coupling                       &
             525                     #endif
             526                                        )
             527                     !NUWRF END
             528                     
             529                       END SUBROUTINE gsfcgce_3ice_nuwrf
             530                     
             531                       SUBROUTINE fall_flux ( dt, qr, qi, qs, qg, p,               &
             532                                           rho, th, pi_mks, z, dz8w, topo, rainnc, &
             533                                           rainncv, grav, itimestep,               &
             534                                           snownc, snowncv, sr,                    &
             535                                           graupelnc, graupelncv,                  &
             536                                           ihail, ice2, improve,                   &
             537                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             538                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             539                     !-----------------------------------------------------------------------
             540                     ! adopted from Jiun-Dar Chern's codes for Purdue Regional Model
             541                     ! adopted by Jainn J. Shi, 6/10/2005
             542                     ! modified by Goddard 7/24/2010
             543                     ! modified by Tao 11/12/2010
             544                     !-----------------------------------------------------------------------
             545                     
             546                       IMPLICIT NONE
             547                       INTEGER, INTENT(IN   )               :: ihail, ice2, improve,       &
             548                                                               ims,ime, jms,jme, kms,kme,  &
             549                                                               its,ite, jts,jte, kts,kte
             550                       INTEGER, INTENT(IN   )               :: itimestep
             551                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             552                                INTENT(INOUT)               :: qr, qi, qs, qg
             553                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             554                                INTENT(IN)                  :: th, pi_mks
             555                     
             556                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             557                                INTENT(INOUT)               :: rainnc, rainncv,            &
             558                                                               snownc, snowncv, sr,        &
             559                                                               graupelnc, graupelncv
             560                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             561                                INTENT(IN   )               :: rho, z, dz8w, p
             562                     
             563                       REAL,    INTENT(IN   )               :: dt, grav
             564                     
             565                     
             566                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             567                                INTENT(IN   )               :: topo
             568                     
             569                     ! temperary vars
             570                     
             571                       REAL,    DIMENSION( kts:kte )           :: fv
             572                       REAL                                    :: tmp1, term0
             573                       REAL                                :: pptrain, pptsnow,        &
             574                                                              pptgraul, pptice
             575                       REAL,    DIMENSION( kts:kte )       :: qrz, qiz, qsz, qgz,      &
             576                                                              zz, dzw, prez, rhoz,     &
             577                                                              orhoz
             578                       REAL,    DIMENSION( kts:kte )       :: thz, piz
             579                     
             580                        INTEGER                    :: k, i, j
             581                     !
             582                     
             583                       REAL, DIMENSION( kts:kte )    :: vtr, vts, vtg, vti
             584                     
             585                       REAL                          :: dtb, pi, consta, constc, gambp4,    &
             586                                                        gamdp4, gam4pt5, gam4bbar
             587                     
             588                     !NUWRF BEGIN
             589                     ! New local variable
             590                       INTEGER                       :: ic, igce
             591                       REAL                          :: y1, vr, vs, vg
             592                       REAL                          :: tslopes, tslopeg, vgcr, vscf
             593                       REAL                          :: tair, tairc, fexp
             594                       REAL                          :: ftns, ftnsQ, ftng, ftngQ
             595                       REAL                          :: const_vt, const_d, const_m, bb1, bb2
             596                       REAL,    DIMENSION(7)         :: aice, vice
             597                       REAL                          :: cmin, r00
             598                       REAL                          :: ftns0, ftng0
             599                     
             600                       DATA tslopes/0./, tslopeg/0./
             601                     !  DATA const_vt//, const_d//, const_m//
             602                       DATA aice/1.e-6, 1.e-5, 1.e-4, 1.e-3, 0.01, 0.1, 1./  ! g/m**3
             603                       DATA vice/5.,15.,30.,35.,40.,45.,50./  ! cm/s
             604                       DATA igce/0/
             605                       DATA ftns/1./, ftng/1./
             606                     
             607                     
             608                     !JJS 20140116  These variables are declared in the beginning of the module.
             609                     !JJS 20140116  No need to declared again here.
             610                     !  will be defined later using consat values
             611                        REAL     ::     rhowater
             612                        REAL     ::     rhosnow
             613                     !   REAL     ::     xnor, xnoh, rhohail   !define in the begining of the module
             614                     !   REAL     ::     xnos, xnog, rhograul  !define in the begining of the module
             615                     !
             616                     !NUWRF END
             617                     
             618                        REAL    , PARAMETER ::                              &
             619                     !             constb = 0.8, constd = 0.25, o6 = 1./6.,           &
             620                                  constb = 0.8, constd = 0.11, o6 = 1./6.,            &
             621                                  cdrag = 0.6
             622                     
             623                       REAL    , PARAMETER ::     abar = 19.3, bbar = 0.37,           &
             624                                                           p0 = 1.0e5
             625                       REAL    , PARAMETER ::     rhoe_s = 1.29
             626                     
             627                     ! for terminal velocity flux
             628                       INTEGER                       :: min_q, max_q
             629                       REAL                          :: t_del_tv, del_tv, flux, fluxin, fluxout ,tmpqrz
             630                       LOGICAL                       :: notlast
             631                     
             632                       if (improve.eq.3) igce=1
             633                     
             634                     !  if (itimestep.eq.1) then
             635                     !     write(6, *) 'in fall_flux'
             636                     !     write(6, *) 'igce=',igce
             637                     !     write(6, *) 'improve=',improve
             638                     
             639                     !     write(6, *) 'ims=', ims, '  ime=', ime
             640                     !     write(6, *) 'jms=', jms, '  jme=', jme
             641                     !     write(6, *) 'kms=', kms, '  kme=', kme
             642                     !     write(6, *) 'its=', its, '  ite=', ite
             643                     !     write(6, *) 'jts=', jts, '  jte=', jte
             644                     !     write(6, *) 'kts=', kts, '  kte=', kte
             645                     !     write(6, *) 'dt=', dt
             646                     !     write(6, *) 'ihail=', ihail
             647                     !     write(6, *) 'ICE2=', ICE2
             648                     !     write(6, *) 'dt=', dt
             649                     !   endif
             650                     
             651                     !-----------------------------------------------------------------------
             652                     !  This program calculates precipitation fluxes due to terminal velocities.
             653                     !-----------------------------------------------------------------------
             654                     
             655                        dtb=dt
             656                        pi=acos(-1.)
             657                     
             658                     !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
             659                           xnor = tnw*1.0e8
             660                           rhowater = roqr*1000.
             661                           xnos = tns*1.0e8             ! Consistent with ConSat
             662                           rhosnow = roqs*1000.
             663                     
             664                     ! tng and roqg are assigned with hail numbers in consat if (ihail.eq.1)
             665                           xnog = tng*1.0e8
             666                           rhograul = roqg*1000.
             667     1                     if (ihail.eq.1) then
             668     1                        xnoh = xnog
             669     1                        rhohail = rhograul
             670     1                     endif
             671                     
             672                        consta=2115.0*0.01**(1-constb)
             673                     !   constc=152.93*0.01**(1-constd)
             674                        constc=78.63*0.01**(1-constd)
             675                     
             676                     !  Gamma function
             677                        gambp4=gammagce(constb+4.)
             678                        gamdp4=gammagce(constd+4.)
             679                        gam4pt5=gammagce(4.5)
             680                        gam4bbar=gammagce(4.+bbar)
             681                     !
             682                           cmin=1.e-10
             683                     !
             684                     !***********************************************************************
             685                     ! Calculate precipitation fluxes due to terminal velocities.
             686                     !***********************************************************************
             687                     !
             688                     !- Calculate termianl velocity (vt?)  of precipitation q?z
             689                     !- Find maximum vt? to determine the small delta t
             690                     
             691     1                j_loop:  do j = jts, jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, fv, orhoz, dzw, zz, prez, piz, thz
                                   <<<      qsz, qiz, qrz, qgz
                                   <<< Loop-information  End >>>
             692     2                i_loop:  do i = its, ite
             693     2               
             694     2                  pptrain = 0.
             695     2                  pptsnow = 0.
             696     2                  pptgraul = 0.
             697     2                  pptice  = 0.
             698     2               
             699     2                  ! in MKS system
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 214
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dzw, zz, prez, piz, thz, fv, orhoz, rhoz
                                   <<<      qsz, qiz, qrz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 48
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             700     3  pp    v         do k = kts, kte
             701     3   p    v            qrz(k)=qr(i,k,j)
             702     3   p    v              qiz(k)=qi(i,k,j)
             703     3   p    v              qsz(k)=qs(i,k,j)
             704     3   p    v            rhoz(k)=rho(i,k,j)
             705     3   p    v            thz(k)=th(i,k,j)
             706     3   p    v            piz(k)=pi_mks(i,k,j)
             707     3   p    v            orhoz(k)=1./rhoz(k)
             708     3   p    v            prez(k)=p(i,k,j)
             709     3   p    v            fv(k)=sqrt(rhoe_s/rhoz(k))
             710     3               !      fv(k)=sqrt(rho(i,1,j)/rhoz(k))
             711     3   p    v            zz(k)=z(i,k,j)
             712     3   p    v            dzw(k)=dz8w(i,k,j)
             713     3   p    v         enddo !k
             714     2               
             715     3                  IF (ice2.eq.0 .or. ice2.eq.2) THEN
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<< Loop-information  End >>>
             716     4  pp   4v            DO k = kts, kte
             717     4   p   4v               qgz(k)=qg(i,k,j)
             718     4   p   4v            ENDDO
             719     3                  ELSE
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<< Loop-information  End >>>
             720     4  pp   4v            DO k = kts, kte
             721     4   p   4v               qgz(k)=0.
             722     4   p   4v            ENDDO
             723     3                  ENDIF
             724     2               
             725     2               
             726     2               !
             727     2               !-- rain
             728     2               !
             729     2                   t_del_tv=0.
             730     2                   del_tv=dtb
             731     2                   notlast=.true.
             732     3                   DO while (notlast)
             733     3               !
             734     3                     min_q=kte
             735     3                     max_q=kts-1
             736     3               !
             737     3               
             738     3               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrz, vtr
                                   <<< Loop-information  End >>>
             739     4   s    s            do k=kts,kte-1
             740     4               
             741     4   s    s               vtr(k)=0.
             742     4               
             743     5   p    v               if (qrz(k) .gt. cmin) then
             744     5   p    v                  min_q=min0(min_q,k)
             745     5   p    v                  max_q=max0(max_q,k)
             746     5               
             747     5   p    v                igce = 1
             748     6   p    v                if (igce.ne.1) then
             749     6               ! old codes from Chern's in MKS
             750     6               !            min_q=min0(min_q,k)
             751     6               !            max_q=max0(max_q,k)
             752     6   p    v                  tmp1=sqrt(pi*rhowater*xnor/rhoz(k)/qrz(k))
             753     6   p    v                  tmp1=sqrt(tmp1)
             754     6   p    v                  vtr(k)=consta*gambp4*fv(k)/tmp1**constb
             755     6   m    m                  vtr(k)=vtr(k)/6.
             756     6   p    v                else
             757     6               ! new codes from Steve's in cgs
             758     6   p    v                  y1=rhoz(k)*0.001*qrz(k)  ! rhoz(k) need to be in CGS
             759     6   p    v                  vs=sqrt( y1 )
             760     6   p    v                  vg=sqrt( vs )
             761     6   p    v                  vr=vrc0+vrc1*vg+vrc2*vs+vrc3*vg*vs
             762     6   p    v                  vtr(k)=max(fv(k)*vr, 0.0)
             763     6                             !vrc0, vrc1, vrc2, vrc3 are dfined in new consat_s
             764     6   m    m                  vtr(k)=vtr(k) * 0.01  ! convert back to MKS
             765     6   p    v                 endif
             766     5               
             767     5   s    s                 if (.not. vtr(k) .gt. 0.0) cycle ! EMK NUWRF Bug fix
             768     5               
             769     6   s    s                  if (k .eq. 1) then
             770     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtr(k))
             771     6   m    m                     del_tv=dmin1(del_tv,0.9*(zz(k)-topo(i,j))/vtr(k))
             772     6   p    v                  else
             773     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtr(k))
             774     6   m    m                     del_tv=dmin1(del_tv,0.9*(zz(k)-zz(k-1))/vtr(k))
             775     6   p    v                  endif
             776     5               !         else
             777     5               !            vtr(k)=0.

            4817     4                                  chem_opt == 302 .or. chem_opt == 303) .and. &
            4818     4                                  (gsfcgce_gocart_coupling == 1) ) then
            4819     4                             ! for cloud water, estimate lambda (slope of gamma distribution)
            4820     4                                  mu = min(15.e0, (1000.E0/ccn_out + 2.e0))
            4821     4                                  gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            4822     4                                  gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4823     4                                  lambda = (4.e0/3.e0*cpi*roqr*ccn_out/L_cloud*   &
            4824     4                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4825     4                                  refc(i,k,j) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4826     4                            else

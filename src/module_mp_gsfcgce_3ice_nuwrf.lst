            2824     4               
            2825     4               !* 21 * PRAUT   AUTOCONVERSION OF QC TO QR                        **21**
            2826     4               !* 22 * PRACW : ACCRETION OF QC BY QR                             **22**
            2827     4                               pracw(i,j)=0.
            2828     4                               praut(i,j)=0.0
            2829     5                                 if (improve .ge. 3 .or. improve .eq. -1) then  !Di Wu
            2830     5                                    praut(i,j)=max(rn21*(qc(i,j)-bnd21),0.0)
            2831     5               
            2832     5                                    y1(i,j)=1./zr(i,j)
            2833     5                                    y2(i,j)=y1(i,j)*y1(i,j)
            2834     5                                    y3(i,j)=y1(i,j)*y2(i,j)
            2835     5                                    y4(i,j)=r22f*qc(i,j)*y3(i,j)*(rn50+rn51*y1(i,j)+  &
            2836     5                                            rn52*y2(i,j)+rn53*y3(i,j))
            2837     5                                    pracw(i,j)=max(y4(i,j), 0.0)
            2838     5                                    if (qr(i,j) .le. cmin) pracw(i,j)=0.
            2839     5                                else                                 ! below is 2007 saticel_s
            2840     5                                    pracw(i,j)=r22f*qc(i,j)/zr(i,j)**bw3
            2841     5                                    y1(i,j)=qc(i,j)-bnd3
            2842     6                                    if (y1(i,j).gt.0.0) then
            2843     6                                       praut(i,j)=r00*y1(i,j)*y1(i,j)/(1.2e-4+rn21/y1(i,j))
            2844     6                                    endif
            2845     5                                 endif
            2846     4               
            2847     4               !C********   HANDLING THE NEGATIVE CLOUD WATER (QC)    ******************
            2848     4                                Y1(I,J)=QC(I,J)/D2T
            2849     4                                PRAUT(I,J)=MIN(Y1(I,J), PRAUT(I,J))
            2850     4                                PRACW(I,J)=MIN(Y1(I,J), PRACW(I,J))
            2851     4                                Y1(I,J)=(PRAUT(I,J)+PRACW(I,J))*D2T
            2852     4               
            2853     5                              if (qc(i,j) .lt. y1(i,j) .and. y1(i,j) .ge. cmin2) then
            2854     5                                  y2(i,j)=qc(i,j)/(y1(i,j)+cmin2)
            2855     5                                  praut(i,j)=praut(i,j)*y2(i,j)
            2856     5                                  pracw(i,j)=pracw(i,j)*y2(i,j)
            2857     5                                  qc(i,j)=0.0
            2858     5                              else
            2859     5                                 qc(i,j)=qc(i,j)-y1(i,j)
            2860     5                              endif
            2861     4               
            2862     4                              PR(I,J)=(PRAUT(I,J)+PRACW(I,J))*D2T
            2863     4                              QR(I,J)=QR(I,J)+PR(I,J)
            2864     4               
            2865     4               !*****   TAO ET AL (1989) SATURATION TECHNIQUE  ***********************
            2866     4               
            2867     4                             cnd(i,j)=0.0
            2868     4                             tair(i,j)=(pt(i,j)+tb0)*pi0
            2869     4                             y1(i,j)=1./(tair(i,j)-c358)
            2870     4                             qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2871     4                             dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2872     4                             dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            2873     4                             cnd(i,j)=dm(i,j)/(1.+avcp*dd(i,j)*qsw(i,j))
            2874     4               !c    ******   condensation or evaporation of qc  ******
            2875     4                             cnd(i,j)=max(-qc(i,j), cnd(i,j))
            2876     4                             pt(i,j)=pt(i,j)+avcp*cnd(i,j)
            2877     4                             qv(i,j)=qv(i,j)-cnd(i,j)
            2878     4                             qc(i,j)=qc(i,j)+cnd(i,j)
            2879     4               
            2880     4               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            2881     4                           ern(i,j)=0.0
            2882     4               
            2883     5                           if (qr(i,j).gt.0.0) then
            2884     5                              tair(i,j)=(pt(i,j)+tb0)*pi0
            2885     5                              rtair(i,j)=1./(tair(i,j)-c358)
            2886     5                              qsw(i,j)=rp0*exp(c172-c409*rtair(i,j))
            2887     5                              ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.0
            2888     5                              dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            2889     5                              rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            2890     5                              dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)), 0.0)
            2891     5                              y1(i,j)=.78/zr(i,j)**2+r23af*scv(i,j)/zr(i,j)**bwh5
            2892     5                              y2(i,j)=r23br/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            2893     5                                      *qsw(i,j))
            2894     5               !cccc
            2895     5                              ern(i,j)=r23t*ssw(i,j)*y1(i,j)/y2(i,j)
            2896     5                              ern(i,j)=min(dd1(i,j),qr(i,j),max(ern(i,j),0.))
            2897     5               
            2898     5               !JJS 20090708 vvvvv
            2899     5               ! xli - reducing evaporation rate according to fitq
            2900     6                              if (qr(i,j) .gt. 1.e-6 ) then
            2901     6                                 fact_fit=0.11*(qr(i,j)*1.e3)**(-1.27)+0.98
            2902     6                                 ern(i,j)=ern(i,j)/fact_fit
            2903     6                              endif
            2904     5               !JJS 20090708 ^^^^^
            2905     5               
            2906     5                              pt(i,j)=pt(i,j)-avcp*ern(i,j)
            2907     5                              qv(i,j)=qv(i,j)+ern(i,j)
            2908     5                              qr(i,j)=qr(i,j)-ern(i,j)
            2909     5                           endif

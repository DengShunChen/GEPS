            5397     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocmg),DBLE(xobmg), &
            5398     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            5399     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            5400     4                                   inclusionstring_g, hoststring_g,                    &
            5401     4                                   hostmatrixstring_g, hostinclusionstring_g)
            5402     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            5403     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            5404     4                          enddo
            5405     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            5406     3                         endif
            5407     2               

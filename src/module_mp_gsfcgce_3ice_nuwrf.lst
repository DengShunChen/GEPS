                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            5411     1  pp    v            do k = kte, kts, -1
            5412     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            5413     1   p    v            enddo

            1165     2               !   psnowc(i,j)=psnowc(i,j)+pptsnow
            1166     2               !   pgrauc(i,j)=pgrauc(i,j)+pptgraul
            1167     2               !   picec(i,j)=picec(i,j)+pptice
            1168     2               !
            1169     2               
            1170     2               !   write(6,*) 'i=',i,' j=',j,'   ', pptrain, pptsnow, pptgraul, pptice
            1171     2               !   call flush(6)
            1172     2               
            1173     2                  snowncv(i,j) = pptsnow
            1174     2                  snownc(i,j) = snownc(i,j) + pptsnow
            1175     2                  graupelncv(i,j) = pptgraul
            1176     2                  graupelnc(i,j) = graupelnc(i,j) + pptgraul
            1177     2                  RAINNCV(i,j) = pptrain + pptsnow + pptgraul + pptice
            1178     2                  RAINNC(i,j)  = RAINNC(i,j) + pptrain + pptsnow + pptgraul + pptice
            1179     2                  sr(i,j) = 0.
            1180     2                  if (RAINNCV(i,j) .gt. 0.) sr(i,j) = (pptsnow + pptgraul + pptice) / RAINNCV(i,j)
            1181     2               
            1182     2                 ENDDO i_loop
            1183     1                 ENDDO j_loop
            1184                     
            1185                     !  if (itimestep.eq.6480) then
            1186                     !     write(51,*) 'in the end of fallflux, itimestep=',itimestep
            1187                     !     do j=jts,jte
            1188                     !        do i=its,ite
            1189                     !           if (rainnc(i,j).gt.400.) then
            1190                     !              write(50,*) 'i=',i,' j=',j,' rainnc=',rainnc
            1191                     !           endif
            1192                     !        enddo
            1193                     !     enddo
            1194                     !  endif
            1195                     
            1196                       RETURN
            1197                       END SUBROUTINE fall_flux
            1198                     
            1199                     !-----------------------------------------------------------------------
            1200                     !c Correction of negative values
            1201                        SUBROUTINE negcor ( X, rho, dz8w,                         &
            1202                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
            1203                                           itimestep, ics,                         &
            1204                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
            1205                     !-----------------------------------------------------------------------
            1206                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
            1207                             INTENT(INOUT) ::                                     X
            1208                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
            1209                             INTENT(IN   ) ::                              rho, dz8w
            1210                       integer, INTENT(IN   ) ::                           itimestep, ics
            1211                     
            1212                     !c Local variables
            1213                     !  REAL, DIMENSION( kts:kte ) ::  Y1, Y2
            1214                       REAL   ::   A0, A1, A2
            1215                     
            1216                       A1=0.
            1217                       A2=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<< Loop-information  End >>>
            1218     1                 do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            1219     2                    do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1220     3  pp    v              do i=its,ite
            1221     3   p    v              A1=A1+max(X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
            1222     3   p    v              A2=A2+max(-X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
            1223     3   p    v              enddo
            1224     2                    enddo
            1225     1                 enddo
            1226                     
            1227                     !  A1=0.0
            1228                     !  A2=0.0
            1229                     !  do k=kts,kte
            1230                     !     A1=A1+Y1(k)
            1231                     !     A2=A2+Y2(k)
            1232                     !  enddo
            1233                     
            1234                       A0=0.0
            1235                     
            1236     1                 if (A1.NE.0.0.and.A1.GT.A2) then
            1237     1                    A0=(A1-A2)/A1
            1238     1               
            1239     1               !  if (mod(itimestep,540).eq.0) then
            1240     1               !     if (ics.eq.1) then
            1241     1               !        write(61,*) 'kms=',kms,'  kme=',kme,'  kts=',kts,'  kte=',kte
            1242     1               !        write(61,*) 'jms=',jms,'  jme=',jme,'  jts=',jts,'  jte=',jte
            1243     1               !        write(61,*) 'ims=',ims,'  ime=',ime,'  its=',its,'  ite=',ite
            1244     1               !     endif
            1245     1               !     if (ics.eq.1) then
            1246     1               !         write(61,*) 'qv timestep=',itimestep
            1247     1               !         write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1248     1               !     else if (ics.eq.2) then
            1249     1               !             write(61,*) 'ql timestep=',itimestep
            1250     1               !             write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1251     1               !     else if (ics.eq.3) then
            1252     1               !             write(61,*) 'qr timestep=',itimestep
            1253     1               !             write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1254     1               !     else if (ics.eq.4) then
            1255     1               !             write(61,*) 'qi timestep=',itimestep
            1256     1               !             write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1257     1               !     else if (ics.eq.5) then
            1258     1               !             write(61,*) 'qs timestep=',itimestep
            1259     1               !             write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1260     1               !     else if (ics.eq.6) then
            1261     1               !             write(61,*) 'qg timestep=',itimestep
            1262     1               !             write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1263     1               !     else
            1264     1               !             write(61,*) 'wrong cloud specieis number'
            1265     1               !     endif
            1266     1               !  endif
            1267     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
            1268     2   p                do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            1269     3  pp                   do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 224, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
            1270     4   p   2v                 do i=its,ite
            1271     4               !           X(i,k,j)=A0*AMAX1(X(i,k,j), 0.0)
            1272     4   p   2v                 X(i,k,j)=A0*DMAX1(X(i,k,j), 0.0)
            1273     4   p   2v                 enddo
            1274     3   p                   enddo
            1275     2   p                enddo
            1276     1                 endif
            1277                     
            1278                       END SUBROUTINE negcor

            4983     2               !                   ENDDO
            4984     2               !                endif
            4985     2               !                call refl10cm_gsfc (qv1d, qr1d, qs1d, qg1d,             &
            4986     2               !                        t1d, p1d, dBZ_GT, kts, kte, i, j, ihail)
            4987     2               !                do k = kts, kte
            4988     2               !                   refl_10cm(i,k,j) = MAX(-35., dBZ_GT(k))
            4989     2               !                enddo
            4990     2               !             enddo
            4991     2               !             enddo
            4992     2                        endif
            4993     1                        ENDIF
            4994                     !+---+-----------------------------------------------------------------+
            4995                     
            4996                           return
            4997                     
            4998                       END SUBROUTINE saticel_s
            4999                     
            5000                       SUBROUTINE auto_conversion( L, N, P , re)
            5001                       implicit none
            5002                     !-----------------------------------------------------------------------------------------------------
            5003                     ! Comments:
            5004                     !  This subroutine compute auto conversion rate folloing Li and Daum [2004], which account for
            5005                     !  total cloud liquid water, particle number concentrations, PSD lambda, broadening parameters.
            5006                     !
            5007                     ! History:
            5008                     !  08/2010  Toshi Matsui@NASA GSFC : Initial.
            5009                     !
            5010                     !
            5011                     ! References:
            5012                     ! Liu, Y. and P. H. Daum, 2004: Parameterization of the autoconversion process. Part I: Analytical
            5013                     !   formulation of the Kessler-type parameterizations. J. Atmos. Sci, 61, 1539-1548.
            5014                     !-----------------------------------------------------------------------------------------------------
            5015                      real,intent(in) :: L    ! cloud liquid water [g cm-3]
            5016                      real,intent(in) :: N    ! total number concentration [# cm-3]
            5017                      real,intent(out) :: P   ! auto conversion rate [g cm-3 s-1]
            5018                      real,intent(out) :: re  ! cloud effective radius [micron]
            5019                     
            5020                      real :: mu   ! mu of gamma PSD [-]
            5021                      real :: eta  ! eta function [cm3 g-2 s-1]
            5022                      real :: beta, beta1, beta2     ! beta function [-]
            5023                      real :: gamfac , gfac1 , gfac2 ! gamma function [-]
            5024                      real :: R6_6power  ! mean radius of the sixth moment [cm]
            5025                      real :: R6_thresh ! threshold of  mean radius of the sixth moment [cm]
            5026                      real :: R6        ! mean radius of the sixth moment [cm]
            5027                      real :: Heaviside_func  ! Heaviside step function (0 or 1)
            5028                      real :: lambda    ! slope of gamma size ditribution [1/cm]
            5029                     ! real :: No        ! intercept  [cm-4]
            5030                     
            5031                      real,parameter :: Rc = 10.e0 * 1.e-4 ! threshold of particle radus (10 micron) [cm]
            5032                      real,parameter :: const_pi    = 3.14159e0 ! pai
            5033                      real,parameter :: const_kappa = 1.9e11    ! coefficient for water droplet collection kernel [cm-3 s-1]
            5034                                                                ! from Long [1974, JAS].
            5035                     ! real,parameter :: const_kappa = 1.9e11*10000.e0 !10000 is to adjust the order to keseller
            5036                     
            5037                     
            5038                      real,parameter :: const_rho_liq = 1.e0    ! density of liquid water [g cm-3]
            5039                      real,parameter :: eta_func = ((3.e0/(4.e0*const_pi*const_rho_liq))**2) * const_kappa  ! eta function [cm3 g-2 s-1]
            5040                                                                                                            ! a part of (eq 27b)
            5041                     
            5042                      logical,parameter :: no_thresh = .true.  ! logic to choose no threshold parameterization or not.
            5043                     
            5044                     
            5045                     !
            5046                     ! When no particel, no autoconversion.
            5047                     !
            5048                     ! EMK BUG FIX...Prevent overflow for small but non-zero values of L
            5049                     ! if( N <= 0.e0 .or. L <= 0.e0 ) then
            5050     1                if( N <= 0.e0 .or. L <= 1.0e-32 ) then
            5051     1                  P = 0.e0
            5052     1                  return
            5053     1                endif
            5054                     
            5055                     !
            5056                     ! check bad values of N and L
            5057                     !
            5058                     ! if( N < 0.e0 ) stop 'MSG auto_conversion: N is negative, it must be positive'
            5059                     ! if( L < 0.e0 ) stop 'MSG auto_conversion: L is negative, it must be positive'
            5060                     ! if( L > 1.e0 ) stop 'MSG auto_conversion: L is greater than 1g/cm3.'
            5061                     
            5062                     !
            5063                     ! Empirical fit of mu as a function of total particle number concentrations.
            5064                     ! From Martin et al. (1994), assign gamma shape parameter mu for cloud
            5065                     ! drops according to general dispersion characteristics.
            5066                     ! disp=~0.25 for Maritime and 0.45 for Continental.
            5067                     ! Since disp=SQRT((mu+2)/(mu+1) - 1), mu varies from 15 for Maritime (pristine air)
            5068                     ! to 2 for Continental (really dirty air).  if mu = 0 --> expnential distribution (narrow dist)
            5069                     !
            5070                     
            5071                     ! orig
            5072                      mu = MIN(15.e0, (1000.E0/N + 2.e0))
            5073                     
            5074                     
            5075                     !
            5076                     ! gamma functions
            5077                     !
            5078                      gfac1 = gamma_toshi(mu+4.e0)
            5079                      gfac2 = gamma_toshi(mu+1.e0)
            5080                      gamfac = (gfac1/gfac2)
            5081                     
            5082                     !
            5083                     ! estimate lambda (slope of gamma distribution)
            5084                     !
            5085                      lambda = (4.e0/3.e0*const_pi*const_rho_liq*N/L*gamfac)**(1.e0/3.e0)  ! [1/cm]
            5086                     
            5087                     
            5088     1                THRESH: if( no_thresh ) then !-------------------------------------------
            5089     1               
            5090     1               !
            5091     1               ! threshold of particle radius (mean radius of the sixth moment )
            5092     1               !
            5093     1                gfac1 = gamma_toshi(mu+7.e0)
            5094     1                gfac2 = gamma_toshi(mu+1.e0)
            5095     1                gamfac = (gfac1/gfac2)
            5096     1               
            5097     1                R6_6power = (1.e0 / lambda)**6.e0 * gamfac   ![cm] (eq. A3)
            5098     1               
            5099     1               !
            5100     1               ! auto conversion rate (eq. 26a)
            5101     1               !
            5102     1                P = const_kappa *   N     * R6_6power *    L      ! [g cm-3 s-1 ]
            5103     1               !    [cm-3 s-1]  * [#/cm3] *   [cm6]   * [g/cm3]
            5104     1               
            5105     1               
            5106     1                else  !with threshold ---------------------------------------------------
            5107     1               
            5108     1               !
            5109     1               ! Estimate eta under gamma PSD
            5110     1               !
            5111     1                beta1 = (6.e0+mu)*(5.e0+mu)*(4.e0+mu)
            5112     1                beta2 = (3.e0+mu)*(2.e0+mu)*(1.e0+mu)
            5113     1                beta  = beta1 / beta2
            5114     1               
            5115     1                eta = eta_func * beta  ! eta function (eq 27b) [cm3 g-2 s-1]
            5116     1               
            5117     1               !
            5118     1               ! threshold of particle radius (mean radius of the sixth moment )
            5119     1               !
            5120     1                R6_thresh = beta * Rc  ![cm] (pg 1545)
            5121     1               
            5122     1               !
            5123     1               ! mean radius of the sixth moment
            5124     1               !
            5125     1                gfac1 = gamma_toshi(6.e0+mu+1.e0)
            5126     1                gfac2 = gamma_toshi(1.e0+mu)
            5127     1                gamfac = (gfac1/gfac2)**(1.e0/6.e0)
            5128     1               
            5129     1                R6 = (1.e0 / lambda) * gamfac   ![cm] (eq. A3)
            5130     1               
            5131     1               !
            5132     1               ! Heaviside step function
            5133     1               !
            5134     2                if    ( R6 - R6_thresh <= 0.e0 ) then
            5135     2                   Heaviside_func = 0.e0
            5136     2                elseif( R6 - R6_thresh > 0.e0 ) then
            5137     2                   Heaviside_func = 1.e0
            5138     2                else
            5139     2                  print*, 'MSG: auto_conversion: Strange value of R6= ', R6 ; stop
            5140     2                endif
            5141     1               
            5142     1               !
            5143     1               ! auto conversion rate [g cm-3 s-1 ] (eq. 27a)
            5144     1               !
            5145     1                P = eta * (1.e0/N) * (L**3) *  Heaviside_func
            5146     1               
            5147     1               !    [cm3 g-2 s-1] * [cm3] * [g3/cm9]
            5148     1               
            5149     1                endif THRESH !------------------------------------------------------------
            5150                     
            5151                     
            5152                     ! optional
            5153                     
            5154                     !
            5155                     ! estimate effective radius
            5156                     !
            5157                      gfac1 = gamma_toshi(mu+4.e0)
            5158                      gfac2 = gamma_toshi(mu+3.e0)
            5159                      gamfac = (gfac1/gfac2)
            5160                     
            5161                      re = 1.e0/lambda * gamfac * 1.e4  !effective radius [micron]
            5162                     
            5163                     !
            5164                     ! estimate No
            5165                     !
            5166                     ! call gamma_function(mu+1.e0 ,gfac1)
            5167                     ! No = N * (lambda**(mu+1)) / gfac1
            5168                     
            5169                      RETURN
            5170                      END subroutine auto_conversion
            5171                     
            5172                      real function gamma_toshi(x)
            5173                     
            5174                     !---------------------------------------------------------------------------------------------------
            5175                     ! Comments:
            5176                     !   compute the gamma function T(x) for single precision floating point.
            5177                     !       input :  x  --- argument of a(x)
            5178                     !                       ( x is not equal to 0,-1,-2,... )
            5179                     !
            5180                     ! History:
            5181                     ! 09/2009  Toshi Matsui@NASA GSFC ; Adapted to SDSU
            5182                     !
            5183                     ! References:
            5184                     !----------------------------------------------------------------------------------------------------
            5185                      implicit double precision (a-h,o-z)
            5186                      dimension g(26)
            5187                      data g/1.0d0,0.5772156649015329d0, &
            5188                            -0.6558780715202538d0, -0.420026350340952d-1, &
            5189                             0.1665386113822915d0,-.421977345555443d-1, &
            5190                             -.96219715278770d-2, .72189432466630d-2, &
            5191                             -.11651675918591d-2, -.2152416741149d-3, &
            5192                             .1280502823882d-3, -.201348547807d-4, &
            5193                             -.12504934821d-5, .11330272320d-5, &
            5194                             -.2056338417d-6, .61160950d-8, &
            5195                              .50020075d-8, -.11812746d-8, &
            5196                             .1043427d-9, .77823d-11, &
            5197                             -.36968d-11, .51d-12, &
            5198                             -.206d-13, -.54d-14, .14d-14, .1d-15/
            5199                      real :: x
            5200                     
            5201                      pi=3.141592653589793d0
            5202     1                if (x.eq.int(x)) then
            5203     2                    if (x.gt.0.0d0) then
            5204     2                        ga=1.0d0
            5205     2                        m1=int(x)-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5206     3  pp    v              do k=2,m1
            5207     3   p    v                 ga=ga*k
            5208     3   p    v              enddo
            5209     2                    else
            5210     2                       ga=1.0d+300
            5211     2                    endif
            5212     1                 else
            5213     2                    if (dabs(dble(x)).gt.1.0d0) then
            5214     2                        z=dabs(dble(x))
            5215     2                        m=int(z)
            5216     2                        r=1.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5217     3  pp    v              do k=1,m
            5218     3   p    v                 r=r*(z-k)
            5219     3   p    v              enddo
            5220     2                       z=z-m
            5221     2                    else
            5222     2                       z=dble(x)
            5223     2                    endif
            5224     1                    gr=g(26)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      g
                                   <<< Loop-information  End >>>
            5225     2   s   4s           do k=25,1,-1
            5226     2   s   4s              gr=gr*z+g(k)
            5227     2   s   4s           enddo
            5228     1                    ga=1.0d0/(gr*z)
            5229     2                    if (dabs(dble(x)).gt.1.0d0) then
            5230     2                        ga=ga*r
            5231     2                        if (x.lt.0.0d0) ga=-pi/(x*ga*dsin(pi*x))
            5232     2                    endif
            5233     1                 endif
            5234                     
            5235                       gamma_toshi = real(ga)
            5236                     
            5237                       return
            5238                       end function gamma_toshi
            5239                     
            5240                     !+---+-----------------------------------------------------------------+
            5241                     
            5242                           subroutine refl10cm_gsfc (qv1d, qr1d, qs1d, qg1d,                 &
            5243                                            t1d, p1d, dBZ, kts, kte, ii, jj, ihail)
            5244                     
            5245                           IMPLICIT NONE
            5246                     
            5247                     !..Sub arguments
            5248                           INTEGER, INTENT(IN):: kts, kte, ii, jj, ihail
            5249                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            5250                                           qv1d, qr1d, qs1d, qg1d, t1d, p1d
            5251                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: dBZ
            5252                     
            5253                     !..Local variables
            5254                           REAL, DIMENSION(kts:kte):: temp, pres, qv, rho
            5255                           REAL, DIMENSION(kts:kte):: rr, rs, rg
            5256                     
            5257                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilams, ilamg
            5258                           DOUBLE PRECISION, DIMENSION(kts:kte):: N0_r, N0_s, N0_g
            5259                           DOUBLE PRECISION:: lamr, lams, lamg
            5260                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            5261                     
            5262                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            5263                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            5264                     
            5265                           INTEGER:: i, k, k_0, kbot, n
            5266                           LOGICAL:: melti
            5267                     
            5268                           DOUBLE PRECISION:: cback, x, eta, f_d
            5269                           REAL, PARAMETER:: R=287.
            5270                           REAL, PARAMETER:: PIx=3.1415926536
            5271                     
            5272                     !+---+
            5273                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            5274     1  pp   4v            do k = kts, kte
            5275     1   p   4v               dBZ(k) = -35.0
            5276     1   p   4v            enddo
            5277                     
            5278                     !+---+-----------------------------------------------------------------+
            5279                     !..Put column of data into local arrays.
            5280                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 14
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, t1d, p1d, pres, N0_g
                                   <<<      L_qg, N0_s, L_qs, N0_r, L_qr, qv1d, qv
                                   <<<      rho, ilamr
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      rr: 2, ilams: 2, rs: 2, ilamg: 2, rg: 2
                                   <<<      temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 19
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5281     1  pp    v            do k = kts, kte
            5282     1   p    v               temp(k) = t1d(k)
            5283     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            5284     1   p    v               pres(k) = p1d(k)
            5285     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            5286     1               
            5287     2   p    v               if (qr1d(k) .gt. 1.E-9) then
            5288     2   p    v                  rr(k) = qr1d(k)*rho(k)
            5289     2   p    v                  N0_r(k) = xnor
            5290     2   p    v                  lamr = (xam_r*xcrg(3)*N0_r(k)/rr(k))**(1./xcre(1))
            5291     2   p    v                  ilamr(k) = 1./lamr
            5292     2   p    v                  L_qr(k) = .true.
            5293     2   p    v               else
            5294     2   p    v                  rr(k) = 1.E-12
            5295     2   p    v                  L_qr(k) = .false.
            5296     2   p    v               endif
            5297     1               
            5298     2   p    v               if (qs1d(k) .gt. 1.E-9) then
            5299     2   p    v                  rs(k) = qs1d(k)*rho(k)
            5300     2   p    v                  N0_s(k) = xnos
            5301     2   p    v                  lams = (xam_s*xcsg(3)*N0_s(k)/rs(k))**(1./xcse(1))
            5302     2   p    v                  ilams(k) = 1./lams
            5303     2   p    v                  L_qs(k) = .true.
            5304     2   p    v               else
            5305     2   p    v                  rs(k) = 1.E-12
            5306     2   p    v                  L_qs(k) = .false.
            5307     2   p    v               endif
            5308     1               
            5309     2   p    v               if (qg1d(k) .gt. 1.E-9) then
            5310     2   p    v                  rg(k) = qg1d(k)*rho(k)
            5311     3   p    v                  if (ihail.eq.1) then
            5312     3                              N0_g(k) = xnoh
            5313     3   p    v                  else
            5314     3   p    v                     N0_g(k) = xnog
            5315     3   p    v                  endif
            5316     2   p    v                  lamg = (xam_g*xcgg(3)*N0_g(k)/rg(k))**(1./xcge(1))
            5317     2   p    v                  ilamg(k) = 1./lamg
            5318     2   p    v                  L_qg(k) = .true.
            5319     2   p    v               else
            5320     2   p    v                  rg(k) = 1.E-12
            5321     2   p    v                  L_qg(k) = .false.
            5322     2   p    v               endif
            5323     1   p    v            enddo
            5324                     
            5325                     !+---+-----------------------------------------------------------------+
            5326                     !..Locate K-level of start of melting (k_0 is level above).
            5327                     !+---+-----------------------------------------------------------------+
            5328                           melti = .false.
            5329                           k_0 = kts
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp
                                   <<< Loop-information  End >>>
            5330     1                     do k = kte-1, kts, -1
            5331     2                        if ( (temp(k).gt.273.15) .and. L_qr(k)                         &
            5332     2                                                 .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            5333     2                           k_0 = MAX(k+1, k_0)
            5334     2                           melti=.true.
            5335     2                           goto 195
            5336     2                        endif
            5337     1                     enddo
            5338                      195  continue
            5339                     
            5340                     !+---+-----------------------------------------------------------------+
            5341                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            5342                     !.. and non-water-coated snow and graupel when below freezing are
            5343                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            5344                     !+---+-----------------------------------------------------------------+
            5345                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, ilams, L_qr, N0_s
                                   <<<      ilamr, N0_r
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 4
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5346     1  pp    v            do k = kts, kte
            5347     1   p    v               ze_rain(k) = 1.e-22
            5348     1   p    v               ze_snow(k) = 1.e-22
            5349     1   p    v               ze_graupel(k) = 1.e-22
            5350     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*xcrg(4)*ilamr(k)**xcre(4)
            5351     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PIx)*(6.0/PIx)     &
            5352     1                                                * (xam_s/900.0)*(xam_s/900.0)          &
            5353     1                                                * N0_s(k)*xcsg(4)*ilams(k)**xcse(4)
            5354     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PIx)*(6.0/PIx)  &
            5355     1                                                   * (xam_g/900.0)*(xam_g/900.0)       &
            5356     1                                                   * N0_g(k)*xcgg(4)*ilamg(k)**xcge(4)
            5357     1   p    v            enddo
            5358                     
            5359                     
            5360                     !+---+-----------------------------------------------------------------+
            5361                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            5362                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            5363                     !.. extremely simple based on amount found above the melting level.
            5364                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            5365                     !.. routines).
            5366                     !+---+-----------------------------------------------------------------+
            5367                     
            5368     1                     if (melti .and. k_0.ge.kts+1) then
            5369     2                      do k = k_0-1, kts, -1
            5370     2               
            5371     2               !..Reflectivity contributed by melting snow
            5372     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            5373     3                          fmelt_s = MAX(0.005d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            5374     3                          eta = 0.d0
            5375     3                          lams = 1./ilams(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<< Loop-information  End >>>
            5376     4                          do n = 1, nrbins
            5377     4                             x = xam_s * xxDs(n)**xbm_s
            5378     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocms),DBLE(xobms), &
            5379     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            5380     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            5381     4                                   inclusionstring_s, hoststring_s,                    &
            5382     4                                   hostmatrixstring_s, hostinclusionstring_s)
            5383     4                             f_d = N0_s(k)*xxDs(n)**xmu_s * DEXP(-lams*xxDs(n))
            5384     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            5385     4                          enddo
            5386     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            5387     3                         endif
            5388     2               
            5389     2               !..Reflectivity contributed by melting graupel
            5390     2               
            5391     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            5392     3                          fmelt_g = MAX(0.005d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            5393     3                          eta = 0.d0
            5394     3                          lamg = 1./ilamg(k)

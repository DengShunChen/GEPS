            4546     6                               call sgmap(1,qs(i,j),r00,tairc(i,j),ftns0(i,j))
            4547     6                               call sgmap(2,qg(i,j),r00,tairc(i,j),ftng0(i,j))
            4548     6                               ftns(i,j)=ftns0(i,j)
            4549     6                               ftng(i,j)=ftng0(i,j)
            4550     6                            endif

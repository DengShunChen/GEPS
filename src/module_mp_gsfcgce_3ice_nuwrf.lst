            5418                     
            5419                     !JJS 20140225
            5420                     ! Calculate cloud droplet effective radius
            5421                        real function eff_rad(lambda)
            5422                     
            5423                           implicit none
            5424                     
            5425                     !---------------------------------------------------------------------------------------------------
            5426                     ! Comments:
            5427                     ! Compute drop effective radius from slope parameters (lambda) of expoential size distribution.
            5428                     !
            5429                     ! History:
            5430                     ! 02/2014  Toshi Matsui@NASA GSFC ; Initial
            5431                     !
            5432                     ! References:
            5433                     !----------------------------------------------------------------------------------------------------
            5434                           real,intent(in)  :: lambda   ! intercept parameter [1/cm]
            5435                     !      real,intent(out) :: re  !effective radius [micron]
            5436                     
            5437                     !
            5438                     ! for no particles.
            5439                     !
            5440                     !       if ( lambda <= 0.e0  .or. isnan(lambda) ) then
            5441     1                      if ( lambda <= 0.e0 ) then
            5442     1                         eff_rad = 0.e0
            5443     1                         return
            5444     1                      endif
            5445                     
            5446                     !
            5447                     ! compute drop effective radius for exponential distribution N(D) = N0*exp(-lam*D)
            5448                     !
            5449                            eff_rad = 1.5e0 / (lambda*100.) * 1.0e+6  ! [micron]
            5450                        return
            5451                        end function eff_rad
            5452                     
            5453                     END MODULE  module_mp_gsfcgce_3ice_nuwrf

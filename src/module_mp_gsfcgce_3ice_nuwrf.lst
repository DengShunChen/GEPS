            4661     3                       a_3=1.e6*r00*qg(i,j)
            4662     3               
            4663     3               !   if (a_1+a_2+a_3 .ge. 1.e-8)  then
            4664     3               
            4665     3                     tair(i,j)=(pt(i,j)+tb0)*pi0
            4666     3                     tairc(i,j)=tair(i,j) - t0
            4667     3               !vvvvvvvvvvvv 20110816 vvvvvvvvvvvvvvvvv
            4668     3                     uwet=4.464**0.95
            4669     3               !^^^^^^^^^^^^ 20110816 ^^^^^^^^^^^^^^^^^
            4670     4                     if (improve .eq. 3) then      !using new dbz formula from Xiping
            4671     4                           ftns(i,j)=1.
            4672     4                           ftns0(i,j)=1.
            4673     4                           ftng(i,j)=1.
            4674     4                           ftng0(i,j)=1.
            4675     4                           call sgmap(1,qs(i,j),r00,tairc(i,j),ftns0(i,j))
            4676     4                           call sgmap(2,qg(i,j),r00,tairc(i,j),ftng0(i,j))
            4677     4                        A_C = 49.6 * 1.E-6
            4678     4                        A_I = 9.4 * 1.E-6
            4679     4                        RE_C = 10.            ! UM
            4680     4                        RE_I = 25.            ! UM
            4681     4                        RE_S = 75.            ! UM
            4682     4               !vvvvvvvvvvvvv Tao 20110722
            4683     4               !         tairc5=min(0.,max(-35.,tairc(i,j)+5.0))
            4684     4               !         fexp=-0.2-tairc5/100.
            4685     4               !^^^^^^^^^^^^^ Tao 20110722
            4686     4                        ucor=3071.29/tnw**0.75
            4687     4               
            4688     4               ! Caculate temperature dependent ucog
            4689     4               !         ftng(i,j)=1.
            4690     4               !vvvvvvvvvvvvv Tao 20110722
            4691     4                        ftng(i,j)=ftng0(i,j)**0.75
            4692     4               !         ftng(i,j)=exp(-1.*tslopeg*tairc5)
            4693     4               !         ftngQ=1.0
            4694     4               !         if (qg(i,j).gt.cmin) ftngQ=(qg(i,j)/0.001)**fexp
            4695     4               !         ftng(i,j)=ftng(i,j)*ftngQ
            4696     4               !^^^^^^^^^^^^^ Tao 20110722
            4697     4               
            4698     4               ! Caculate temperature dependent ucos
            4699     4               !         ftns(i,j)=1.
            4700     4               !vvvvvvvvvvvvv Tao 20110722
            4701     4                        ftns(i,j)=ftns0(i,j)**0.75
            4702     4               !         ftns(i,j)=exp(-1.*tslopes*tairc5)
            4703     4               !         ftnsQ=1.0
            4704     4               !         if (qs(i,j).gt.cmin) ftnsQ=(qs(i,j)/0.001)**fexp
            4705     4               !         ftns(i,j)=ftns(i,j)*ftnsQ
            4706     4               !^^^^^^^^^^^^^ Tao 20110722
            4707     4               !
            4708     4               !vvvvvvvvvvvvvv 20110816 vvvvvvvvvvvvvvvvvvvvvvvv
            4709     4               !          ucos=687.97*roqs**0.25/ftns(i,j)**0.75
            4710     4               !          ucog=687.97*roqg**0.25/ftng(i,j)**0.75
            4711     4                         ucos=687.97*roqs**0.25/tns**0.75/ftns(i,j)
            4712     4                         ucog=687.97*roqg**0.25/tng**0.75/ftng(i,j)
            4713     4               !^^^^^^^^^^^^^^ 20110816 ^^^^^^^^^^^^^^^^^^^^^^^^^
            4714     4               
            4715     4                         a_11=ucor*(max(1.e-12,a_1))**1.75
            4716     4               !         a_22=ucos*(max(1.e-12,a_2))**1.75
            4717     4               !         a_33=ucog*(max(1.e-12,a_3))**1.75
            4718     4               
            4719     4               !vvvvvvvvvvvvvv 20110816 vvvvvvvvvvvvvvvvvvvvvvvv
            4720     4               !         a_22=ucos*(max(1.e-12,a_2))**1.75/ftns(i,j)
            4721     4               !         a_33=ucog*(max(1.e-12,a_3))**1.75/ftng(i,j)
            4722     4                        a_22=ucos*(max(1.e-12,a_2))**1.75
            4723     4                        a_33=ucog*(max(1.e-12,a_3))**1.75
            4724     4               !vvvvvvvvvvvvvv 20110816 vvvvvvvvvvvvvvvvvvvvvvvv
            4725     4               
            4726     4                        W_C = r00 * QC(I,J) * 1000.   !LIQUID WATER CONTENT IN G/M^3
            4727     4                        W_I = r00 * QI(I,J) * 1000.   !ICE WATER CONTENT IN G/M^3
            4728     4                        W_S = r00 * QS(I,J) * 1000.   !ICE WATER CONTENT IN G/M^3
            4729     4               
            4730     4               ! Xiping's formula
            4731     4               !         ZE_CLD = A_C * W_C * RE_C**3 + A_I * W_I * RE_I**3   &  !ZE IN  mm^6/m^3
            4732     4               !                 + A_I * W_S * RE_S**3  ! (as cloud particles NOT precipitation)
            4733     4                        ZE_CLD = A_C * W_C * RE_C**3 + A_I * W_I * RE_I**3      !ZE IN  mm^6/m^3
            4734     4                                 ! (use a_22 and ucos instead)
            4735     5                        IF (TAIR(I,J).LT.273.16) THEN
            4736     5               !            ZDRY = MAX(1.e-4,A_11+A_33+ZE_CLD) ! Xiping's  !rain,snow,cloud ice,cloud water,graupel
            4737     5                           ZDRY = MAX(1.e-4,A_11+A_22+A_33+ZE_CLD) !rain,snow,cloud ice,cloud water,graupel
            4738     5               !            DBZ(I,K,J) = 10.*ALOG10(ZDRY)
            4739     5                           DBZ(I,K,J) = 10.*DLOG10(ZDRY)
            4740     5                        ELSE
            4741     5               !            A_44 = A_11+UWET*(A_22+A_33)**.95         ! old formula
            4742     5               !            A_44 = A_11+UWET*A_33**.95+ZE_CLD         ! Xiping's
            4743     5                           A_44 = A_11+UWET*(A_22+A_33)**.95+ZE_CLD
            4744     5                           ZWET = MAX(1.e-4,A_44)
            4745     5               !            DBZ(I,K,J) = 10.*ALOG10(ZWET)
            4746     5                           DBZ(I,K,J) = 10.*DLOG10(ZWET)
            4747     5                        ENDIF
            4748     4               
            4749     4                     else ! using old dbz formula from Tao
            4750     4                        ucor=3071.29/tnw**0.75
            4751     4                        ucos=687.97*roqs**0.25/tns**0.75
            4752     4                        ucog=687.97*roqg**0.25/tng**0.75
            4753     4                        uwet=4.464**0.95
            4754     4                        a_11=ucor*(max(1.e-5,a_1))**1.75
            4755     4                        a_22=ucos*(max(1.e-5,a_2))**1.75
            4756     4                        a_33=ucog*(max(1.e-5,a_3))**1.75
            4757     4                        zdry=max(1.e-20,a_11+a_22+a_33)
            4758     4                        dbz(i,k,j)=10.*log10(zdry)

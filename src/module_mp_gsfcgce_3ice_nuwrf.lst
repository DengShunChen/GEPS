            4552     5                            rtair(i,j)=1./(t0-c358)
            4553     5                            y2(i,j)=exp( c172-c409*rtair(i,j) )
            4554     5                            esw(i,j)=c610*y2(i,j)
            4555     5                            qsw(i,j)=rp0*y2(i,j)
            4556     5                            ssw(i,j)=1.-(qv(i,j)+qb0)/qsw(i,j)
            4557     5                            dm(i,j)=qsw(i,j)-qv(i,j)-qb0
            4558     5                            rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            4559     5                            dd1(i,j)=max(dm(i,j)/(1.+rsub1(i,j)),0.0)
            4560     5                            y3(i,j)=1./tair(i,j)
            4561     5                            dd(i,j)=y3(i,j)*(rn30a*y3(i,j)-rn10b)+rn10c*tair(i,j)       &
            4562     5                                                            /esw(i,j)
            4563     5                            y1(i,j)=ftng(i,j)*r30t*ssw(i,j)*(r191r/zg(i,j)**2+r192rf    &
            4564     5                                  /zg(i,j)**bgh5)/dd(i,j)
            4565     5                            pmltg(i,j)=min(qg(i,j),max(y1(i,j),0.0))
            4566     5                            y1(i,j)=ftns(i,j)*r33t*ssw(i,j)*(r331r/zs(i,j)**2+r332rf    &
            4567     5                                                          /zs(i,j)**bsh5)/dd(i,j)
            4568     5                            pmlts(i,j)=min(qs(i,j),max(y1(i,j),0.0))
            4569     5                            y1(i,j)=min(pmltg(i,j)+pmlts(i,j),dd1(i,j))
            4570     5                            pmltg(i,j)=y1(i,j)-pmlts(i,j)
            4571     5                            pt(i,j)=pt(i,j)-ascp*y1(i,j)
            4572     5                            qv(i,j)=qv(i,j)+y1(i,j)
            4573     5                            qs(i,j)=qs(i,j)-pmlts(i,j)
            4574     5                            qg(i,j)=qg(i,j)-pmltg(i,j)
            4575     5                         endif
            4576     4               ! end   Processes 30 and 33

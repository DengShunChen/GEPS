            4839     4                                     gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            4840     4                                     lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            4841     4                                              gamfac1)**(1.e0/3.e0)  ! [1/cm]
            4842     4                                     refc(i,k,j) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            4843     4                           endif ! chem_opt and gsfcgce_gocart_coupling
            4844     4               #else
            4845     4                 ! Not running with WRF_Chem
            4846     4                           ! ccn_over_land = 1500  ! [#/cm3] climatological value
            4847     4                           ! ccn_over_water = 150  ! [#/cm3] climatological value
            4848     5                           if (xland(i,j) .eq. 1.0) then
            4849     5                              ccn_ref = ccn_over_land
            4850     5                           else if (xland(i,j) .eq. 2.0) then
            4851     5                              ccn_ref = ccn_over_water

            4476     4               
            4477     4               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            4478     4               ! Steve did not make any improvement on this process
            4479     4               
            4480     5                      if (qr(i,j) .gt. 0.0) then
            4481     5                         tair(i,j)=(pt(i,j)+tb0)*pi0
            4482     5                         rtair(i,j)=1./(tair(i,j)-c358)
            4483     6                         if (improve.eq.3) then
            4484     6               	     y2(i,j)=exp( c172-c409*rtair(i,j) )
            4485     6               	     esw(i,j)=c610*y2(i,j)
            4486     6                            qsw(i,j)=rp0*y2(i,j)
            4487     6                            ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.
            4488     6                            dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            4489     6                            rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            4490     6                            dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)),0.0)
            4491     6                            y3(i,j)=1./tair(i,j)
            4492     6                            dd(i,j)=y3(i,j)*(rn30a*y3(i,j)-rn10b)+rn10c*tair(i,j)  &
            4493     6                                            /esw(i,j)
            4494     6                            y1(i,j)=-r23t*ssw(i,j)*(r231r/zr(i,j)**2+r232rf/       &
            4495     6                                                     zr(i,j)**3)/dd(i,j)
            4496     6                            ern(i,j)=min(dd1(i,j),qr(i,j),max(y1(i,j),0.0))
            4497     6                         else
            4498     6               !               tair(i,j)=(pt(i,j)+tb0)*pi0
            4499     6               !               rtair(i,j)=1./(tair(i,j)-c358)
            4500     6                            qsw(i,j)=rp0*exp(c172-c409*rtair(i,j))
            4501     6                            ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.0
            4502     6                            dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            4503     6                            rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            4504     6                            dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)), 0.0)
            4505     6                            y1(i,j)=.78/zr(i,j)**2+r23af*scv(i,j)/zr(i,j)**bwh5
            4506     6                            y2(i,j)=r23br/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j)   &
            4507     6                                      *qsw(i,j))
            4508     6               !cccc
            4509     6                            ern(i,j)=r23t*ssw(i,j)*y1(i,j)/y2(i,j)
            4510     6                            ern(i,j)=min(dd1(i,j),qr(i,j),max(ern(i,j),0.))
            4511     6               
            4512     6               !JJS 20090708 vvvvv
            4513     6               ! xli - reducing evaporation rate according to fitq
            4514     6               !             if (ihail .eq. 1 .and. qr(i,j) .gt. 1.e-6 ) then
            4515     7                             if (qr(i,j) .gt. 1.e-6 ) then  !Tao 20120224 apply to all options
            4516     7                               fact_fit=0.11*(qr(i,j)*1.e3)**(-1.27)+0.98
            4517     7                               ern(i,j)=ern(i,j)/fact_fit
            4518     7                            endif
            4519     6               !JJS 20090708 ^^^^^
            4520     6                         endif
            4521     5                             pt(i,j)=pt(i,j)-avcp*ern(i,j)
            4522     5                             qv(i,j)=qv(i,j)+ern(i,j)
            4523     5                             qr(i,j)=qr(i,j)-ern(i,j)
            4524     5                       endif

            3562                     ! snow to graupel autoconversion, Lin et al. (1983)
            3563                     ! =======================================================================
            3564                     
            3565                     subroutine pgaut (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, den)
            3566                     
            3567                         implicit none
            3568                     
            3569                         ! -----------------------------------------------------------------------
            3570                         ! input / output arguments
            3571                         ! -----------------------------------------------------------------------
            3572                     
            3573                         integer, intent (in) :: ks, ke
            3574                     
            3575                         real, intent (in) :: dts
            3576                     
            3577                         real, intent (in), dimension (ks:ke) :: den
            3578                     
            3579                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            3580                     
            3581                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            3582                     
            3583                         ! -----------------------------------------------------------------------
            3584                         ! local variables

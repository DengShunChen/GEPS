            5310                         integer :: k
            5311                     
            5312                         real, dimension (ks:ke) :: dgz, cv0
            5313                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv, ql, qr, qi, qs, dp, m1, dz, qg, cv0
                                   <<<      dgz, dm
                                   <<< Loop-information  End >>>
            5314     1  pp    v          do k = ks + 1, ke
            5315     1   p    v              dgz (k) = - 0.5 * grav * (dz (k - 1) + dz (k))
            5316     1   p    v              cv0 (k) = dm (k) * (cv_air + qv (k) * cv_vap + (qr (k) + ql (k)) * c_liq + &
            5317     1                            (qi (k) + qs (k) + qg (k)) * c_ice) + cw * (m1 (k) - m1 (k - 1))
            5318     1   p    v          enddo
            5319                     

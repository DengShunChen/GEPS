            5278                         w (ks) = w (ks) + m1 (ks) * vt (ks) / dm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.23, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, m1, w, dm
                                   <<< Loop-information  End >>>
            5279     1   s   2s          do k = ks + 1, ke
            5280     1   m   2m              w (k) = (dm (k) * w (k) + m1 (k - 1) * (w (k - 1) - vt (k - 1)) + m1 (k) * vt (k)) / &
            5281     1                            (dm (k) + m1 (k - 1))
            5282     1   p   2v          enddo

            5809     4   p    s                          rew (i, k) = exp (1.0 / 3.0 * log ((3.0 * qmw (i, k) * rho) / &
            5810     4                                        (4.0 * pi * rhow * ccnw))) * 1.0e4
            5811     4   p    s                          rew (i, k) = max (rewmin, min (rewmax, rew (i, k)))
            5812     4   p    s                      else
            5813     4   p    s                          qcw (i, k) = 0.0

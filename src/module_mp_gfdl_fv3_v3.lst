            5290                     subroutine sedi_heat (ks, ke, dm, m1, dz, tz, qv, ql, qr, qi, qs, qg, cw)
            5291                     
            5292                         implicit none
            5293                     
            5294                         ! -----------------------------------------------------------------------
            5295                         ! input / output arguments
            5296                         ! -----------------------------------------------------------------------
            5297                     
            5298                         integer, intent (in) :: ks, ke
            5299                     
            5300                         real, intent (in) :: cw
            5301                     
            5302                         real, intent (in), dimension (ks:ke) :: dm, m1, dz, qv, ql, qr, qi, qs, qg
            5303                     
            5304                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz

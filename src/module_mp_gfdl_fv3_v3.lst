            3690                     ! =======================================================================
            3691                     ! temperature sentive high vertical resolution processes
            3692                     ! =======================================================================
            3693                     
            3694                     subroutine subgrid_z_proc (ks, ke, den, denfac, dts, rh_adj, tz, qv, ql, qr, &
            3695                             qi, qs, qg, dp, ccn, cin, cond, dep, reevap, sub, rhc)
            3696                     
            3697                         implicit none
            3698                     
            3699                         ! -----------------------------------------------------------------------
            3700                         ! input / output arguments
            3701                         ! -----------------------------------------------------------------------
            3702                     
            3703                         integer, intent (in) :: ks, ke
            3704                     
            3705                         real, intent (in) :: dts, rh_adj
            3706                     
            3707                         real, intent (in), dimension (ks:ke) :: den, denfac, ccn, dp
            3708                         real, intent (in), dimension (ks:ke) :: rhc
            3709                     
            3710                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, cin
            3711                     
            3712                         real, intent (out) :: cond, dep, reevap, sub
            3713                     
            3714                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            3715                     
            3716                         ! -----------------------------------------------------------------------
            3717                         ! local variables
            3718                         ! -----------------------------------------------------------------------
            3719                     
            3720                         real, dimension (ks:ke) :: q_liq, q_sol, q_cond, lcpk, icpk, tcpk, tcp3
            3721                     
            3722                         real (kind = r8), dimension (ks:ke) :: cvm, te8
            3723                     
            3724                         ! -----------------------------------------------------------------------
            3725                         ! initialization
            3726                         ! -----------------------------------------------------------------------
            3727                     
            3728                         cond = 0
            3729                         dep = 0
            3730                         reevap = 0
            3731                         sub = 0
            3732                     
            3733                         ! -----------------------------------------------------------------------
            3734                         ! calculate heat capacities and latent heat coefficients
            3735                         ! -----------------------------------------------------------------------
            3736                     
            3737                         call cal_mhc_lhc (ks, ke, qv, ql, qr, qi, qs, qg, q_liq, q_sol, cvm, te8, tz, &
            3738                             lcpk, icpk, tcpk, tcp3)
            3739                     
            3740                         ! -----------------------------------------------------------------------
            3741                         ! instant processes (include deposition, evaporation, and sublimation)
            3742                         ! -----------------------------------------------------------------------
            3743                     
            3744     1                   if (.not. do_warm_rain_mp) then
            3745     1               
            3746     1                       call pinst (ks, ke, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3747     1                           lcpk, icpk, tcpk, tcp3, rh_adj, dep, sub, reevap)
            3748     1               
            3749     1                   endif
            3750                     
            3751                         ! -----------------------------------------------------------------------
            3752                         ! cloud water condensation and evaporation
            3753                         ! -----------------------------------------------------------------------
            3754                     
            3755                         call pcond_pevap (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3756                             lcpk, icpk, tcpk, tcp3, cond, reevap, rhc)
            3757                     
            3758     1                   if (.not. do_warm_rain_mp) then
            3759     1               
            3760     1                       ! -----------------------------------------------------------------------
            3761     1                       ! enforce complete freezing below t_wfr
            3762     1                       ! -----------------------------------------------------------------------
            3763     1               
            3764     1    i                  call pcomp (ks, ke, qv, ql, qr, qi, qs, qg, tz, cvm, te8, lcpk, icpk, tcpk, tcp3)
            3765     1               
            3766     1                       ! -----------------------------------------------------------------------
            3767     1                       ! Wegener Bergeron Findeisen process
            3768     1                       ! -----------------------------------------------------------------------
            3769     1               
            3770     1                       call pwbf (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, lcpk, icpk, tcpk, tcp3)
            3771     1               
            3772     1                       ! -----------------------------------------------------------------------
            3773     1                       ! Bigg freezing mechanism
            3774     1                       ! -----------------------------------------------------------------------
            3775     1               
            3776     1    i                  call pbigg (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, ccn, lcpk, icpk, tcpk, tcp3)
            3777     1               
            3778     1                       ! -----------------------------------------------------------------------
            3779     1                       ! cloud ice deposition and sublimation
            3780     1                       ! -----------------------------------------------------------------------
            3781     1               
            3782     1                       call pidep_pisub (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3783     1                           lcpk, icpk, tcpk, tcp3, cin, dep, sub)
            3784     1               
            3785     1                       ! -----------------------------------------------------------------------
            3786     1                       ! snow deposition and sublimation
            3787     1                       ! -----------------------------------------------------------------------
            3788     1               
            3789     1                       call psdep_pssub (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3790     1                           denfac, lcpk, icpk, tcpk, tcp3, dep, sub)
            3791     1               
            3792     1                       ! -----------------------------------------------------------------------
            3793     1                       ! graupel deposition and sublimation
            3794     1                       ! -----------------------------------------------------------------------
            3795     1               
            3796     1                       call pgdep_pgsub (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3797     1                           denfac, lcpk, icpk, tcpk, tcp3, dep, sub)
            3798     1               
            3799     1                   endif
            3800                     
            3801                     end subroutine subgrid_z_proc
            3802                     
            3803                     ! =======================================================================
            3804                     ! instant processes (include deposition, evaporation, and sublimation)
            3805                     ! =======================================================================
            3806                     
            3807                     subroutine pinst (ks, ke, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3808                             lcpk, icpk, tcpk, tcp3, rh_adj, dep, sub, reevap)
            3809                     
            3810                         implicit none
            3811                     
            3812                         ! -----------------------------------------------------------------------
            3813                         ! input / output arguments
            3814                         ! -----------------------------------------------------------------------
            3815                     
            3816                         integer, intent (in) :: ks, ke
            3817                     
            3818                         real, intent (in) :: rh_adj
            3819                     
            3820                         real, intent (in), dimension (ks:ke) :: den, dp
            3821                     
            3822                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            3823                     
            3824                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            3825                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            3826                     
            3827                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            3828                     
            3829                         real, intent (out) :: dep, reevap, sub
            3830                     
            3831                         ! -----------------------------------------------------------------------
            3832                         ! local variables
            3833                         ! -----------------------------------------------------------------------
            3834                     
            3835                         integer :: k
            3836                     
            3837                         real :: sink, tin, qpz, rh, dqdt, tmp
            3838                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, ql, qv, qi, qs, qg, qr, te8
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 23
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3839     1                   do k = ks, ke
            3840     1               
            3841     1                       ! -----------------------------------------------------------------------
            3842     1                       ! instant deposit all water vapor to cloud ice when temperature is super low
            3843     1                       ! -----------------------------------------------------------------------
            3844     1               
            3845     2                       if (tz (k) .lt. t_min) then
            3846     2               
            3847     2                           sink = dim (qv (k), qcmin)
            3848     2                           dep = dep + sink * dp (k)
            3849     2               
            3850     2                           call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3851     2                                - sink, 0., 0., sink, 0., 0., te8 (k), cvm (k), tz (k), &
            3852     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            3853     2               
            3854     2                       endif
            3855     1               
            3856     1                       ! -----------------------------------------------------------------------
            3857     1                       ! instant evaporation / sublimation of all clouds when rh < rh_adj
            3858     1                       ! -----------------------------------------------------------------------
            3859     1               
            3860     1                       qpz = qv (k) + ql (k) + qi (k)
            3861     1    i                  tin = (te8 (k) - lv00 * qpz + li00 * (qs (k) + qg (k))) / &
            3862     1                           mhc (qpz, qr (k), qs (k) + qg (k))
            3863     1               
            3864     2                       if (tin .gt. t_sub + 6.) then
            3865     2               
            3866     2    i                      rh = qpz / iqs (tin, den (k), dqdt)
            3867     3                           if (rh .lt. rh_adj) then
            3868     3               
            3869     3                               sink = ql (k)
            3870     3                               tmp = qi (k)
            3871     3               
            3872     3                               reevap = reevap + sink * dp (k)
            3873     3                               sub = sub + tmp * dp (k)
            3874     3               
            3875     3                               call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3876     3                                   sink + tmp, - sink, 0., - tmp, 0., 0., te8 (k), cvm (k), tz (k), &
            3877     3                                   lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            3878     3               
            3879     3                           endif
            3880     2               
            3881     2                       endif
            3882     1               
            3883     1                   enddo
            3884                     
            3885                     end subroutine pinst
            3886                     
            3887                     ! =======================================================================
            3888                     ! cloud water condensation and evaporation, Hong and Lim (2006)
            3889                     ! =======================================================================
            3890                     
            3891                     subroutine pcond_pevap (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            3892                             lcpk, icpk, tcpk, tcp3, cond, reevap, rhc)
            3893                     
            3894                         implicit none
            3895                     
            3896                         ! -----------------------------------------------------------------------
            3897                         ! input / output arguments
            3898                         ! -----------------------------------------------------------------------
            3899                     
            3900                         integer, intent (in) :: ks, ke
            3901                     
            3902                         real, intent (in) :: dts
            3903                     
            3904                         real, intent (in), dimension (ks:ke) :: den, dp
            3905                         real, intent (in), dimension (ks:ke) :: rhc
            3906                     
            3907                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            3908                     
            3909                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            3910                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            3911                     
            3912                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            3913                     
            3914                         real, intent (out) :: cond, reevap
            3915                     
            3916                         ! -----------------------------------------------------------------------
            3917                         ! local variables
            3918                         ! -----------------------------------------------------------------------
            3919                     
            3920                         integer :: k
            3921                     
            3922                         real :: sink, tin, qpz, dqdt, qsw, rh_tem, dq, factor, fac_l2v, fac_v2l
            3923                     
            3924                         fac_l2v = 1. - exp (- dts / tau_l2v)
            3925                         fac_v2l = 1. - exp (- dts / tau_v2l)
            3926                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, den, qv, ql, rhc, qi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 19
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3927     1                   do k = ks, ke
            3928     1               
            3929     1                       tin = tz (k)
            3930     1               !        qsw = wqs (tin, den (k), dqdt)
            3931     1    i                  qsw = wqs (tin, den (k), dqdt) * rhc (k)  !xb141
            3932     1                       qpz = qv (k) + ql (k) + qi (k)
            3933     1                       rh_tem = qpz / qsw
            3934     1                       dq = qsw - qv (k)
            3935     2                       if (dq .gt. 0.) then
            3936     2                           factor = min (1., fac_l2v * (rh_fac * dq / qsw))
            3937     2                           sink = min (ql (k), factor * dq / (1. + tcp3 (k) * dqdt))
            3938     3                           if (use_rhc_cevap .and. rh_tem .ge. rhc_cevap) then
            3939     3                               sink = 0.
            3940     3                           endif
            3941     2                           reevap = reevap + sink * dp (k)
            3942     2                       elseif (do_cond_timescale) then
            3943     2                           factor = min (1., fac_v2l * (rh_fac * (- dq) / qsw))
            3944     2                           sink = - min (qv (k), factor * (- dq) / (1. + tcp3 (k) * dqdt))
            3945     2                           cond = cond - sink * dp (k)
            3946     2                       else
            3947     2                           sink = - min (qv (k), - dq / (1. + tcp3 (k) * dqdt))
            3948     2                           cond = cond - sink * dp (k)
            3949     2                       endif
            3950     1               
            3951     1                       call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3952     1                           sink, - sink, 0., 0., 0., 0., te8 (k), cvm (k), tz (k), &
            3953     1                           lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            3954     1               
            3955     1                   enddo
            3956                     
            3957                     end subroutine pcond_pevap
            3958                     
            3959                     ! =======================================================================
            3960                     ! enforce complete freezing below t_wfr, Lin et al. (1983)
            3961                     ! =======================================================================
            3962                     
            3963                     subroutine pcomp (ks, ke, qv, ql, qr, qi, qs, qg, tz, cvm, te8, lcpk, icpk, tcpk, tcp3)
            3964                     
            3965                         implicit none
            3966                     
            3967                         ! -----------------------------------------------------------------------
            3968                         ! input / output arguments
            3969                         ! -----------------------------------------------------------------------
            3970                     
            3971                         integer, intent (in) :: ks, ke
            3972                     
            3973                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            3974                     
            3975                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            3976                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            3977                     
            3978                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            3979                     
            3980                         ! -----------------------------------------------------------------------
            3981                         ! local variables

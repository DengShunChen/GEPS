            2680     1               
            2681     1                       dqh = max (ql (k), h_var * max (qpz, qcmin))
            2682     1                       dqh = min (dqh, 0.2 * qpz)
            2683     1                       q_minus = qpz - dqh
            2684     1                       q_plus = qpz + dqh
            2685     1               
            2686     1                       ! -----------------------------------------------------------------------

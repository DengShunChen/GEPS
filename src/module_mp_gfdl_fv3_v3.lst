            7734                     ! =======================================================================
            7735                     ! compute wet buld temperature, core function
            7736                     ! Knox et al. (2017)
            7737                     ! =======================================================================
            7738                     
            7739                     function wet_bulb_core (qv, tk, den, lcp)
            7740                     
            7741                         implicit none
            7742                     
            7743                         real :: wet_bulb_core
            7744                     
            7745                         ! -----------------------------------------------------------------------
            7746                         ! input / output arguments
            7747                         ! -----------------------------------------------------------------------
            7748                     
            7749                         real, intent (in) :: qv, tk, den, lcp
            7750                     
            7751                         ! -----------------------------------------------------------------------
            7752                         ! local variables
            7753                         ! -----------------------------------------------------------------------
            7754                     
            7755                         logical :: do_adjust = .false.
            7756                     
            7757                         real :: factor = 1 / 3.
            7758                         real :: qsat, tp, dqdt
            7759                     
            7760                         wet_bulb_core = tk
            7761                         qsat = wqs (wet_bulb_core, den, dqdt)
            7762                         tp = factor * (qsat - qv) / (1. + lcp * dqdt) * lcp
            7763                         wet_bulb_core = wet_bulb_core - tp
            7764                     
            7765     1                   if (do_adjust .and. tp .gt. 0.0) then
            7766     1                       qsat = wqs (wet_bulb_core, den, dqdt)
            7767     1                       tp = (qsat - qv) / (1. + lcp * dqdt) * lcp
            7768     1                       wet_bulb_core = wet_bulb_core - tp
            7769     1                   endif
            7770                     
            7771                     end function wet_bulb_core
            7772                     
            7773                     ! =======================================================================
            7774                     ! compute wet buld temperature, dry air case
            7775                     ! =======================================================================
            7776                     
            7777                     function wet_bulb_dry (qv, tk, den)
            7778                     
            7779                         implicit none
            7780                     
            7781                         real :: wet_bulb_dry
            7782                     
            7783                         ! -----------------------------------------------------------------------
            7784                         ! input / output arguments
            7785                         ! -----------------------------------------------------------------------
            7786                     
            7787                         real, intent (in) :: qv, tk, den
            7788                     
            7789                         ! -----------------------------------------------------------------------
            7790                         ! local variables
            7791                         ! -----------------------------------------------------------------------
            7792                     
            7793                         real :: lcp
            7794                     
            7795                         lcp = hlv / cp_air
            7796                     
            7797          i              wet_bulb_dry = wet_bulb_core (qv, tk, den, lcp)
            7798                     
            7799                     end function wet_bulb_dry
            7800                     
            7801                     ! =======================================================================
            7802                     ! compute wet buld temperature, moist air case
            7803                     ! =======================================================================
            7804                     
            7805                     function wet_bulb_moist (qv, ql, qi, qr, qs, qg, tk, den)
            7806                     
            7807                         implicit none
            7808                     
            7809                         real :: wet_bulb_moist
            7810                     
            7811                         ! -----------------------------------------------------------------------
            7812                         ! input / output arguments
            7813                         ! -----------------------------------------------------------------------
            7814                     
            7815                         real, intent (in) :: qv, ql, qi, qr, qs, qg, tk, den
            7816                     
            7817                         ! -----------------------------------------------------------------------
            7818                         ! local variables
            7819                         ! -----------------------------------------------------------------------
            7820                     
            7821                         real :: lcp, q_liq, q_sol
            7822                     
            7823                         real (kind = r8) :: cvm
            7824                     
            7825                         q_liq = ql + qr
            7826                         q_sol = qi + qs + qg
            7827          i              cvm = mhc (qv, q_liq, q_sol)
            7828                         lcp = (lv00 + d1_vap * tk) / cvm
            7829                     
            7830          i              wet_bulb_moist = wet_bulb_core (qv, tk, den, lcp)
            7831                     
            7832                     end function wet_bulb_moist

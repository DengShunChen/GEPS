            5827     4   p    s                          rew (i, k) = 14.0 * abs (mask - 1.0) + &
            5828     4                                        (8.0 + (14.0 - 8.0) * min (1.0, max (0.0, - tc / 30.0))) * &
            5829     4                                        (1.0 - abs (mask - 1.0))
            5830     4   p    s                          rew (i, k) = rew (i, k) + (14.0 - rew (i, k)) * &
            5831     4                                       min (1.0, max (0.0, snowd (i) / 1000.0))

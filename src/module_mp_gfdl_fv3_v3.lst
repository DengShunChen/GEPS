            3619                     subroutine pgacw_pgacr (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, denfac, &
            3620                             vtr, vtg, lcpk, icpk, tcpk, tcp3)
            3621                     
            3622                         implicit none
            3623                     
            3624                         ! -----------------------------------------------------------------------
            3625                         ! input / output arguments
            3626                         ! -----------------------------------------------------------------------
            3627                     
            3628                         integer, intent (in) :: ks, ke
            3629                     
            3630                         real, intent (in) :: dts
            3631                     
            3632                         real, intent (in), dimension (ks:ke) :: den, denfac, vtr, vtg
            3633                     
            3634                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            3635                     
            3636                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            3637                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            3638                     
            3639                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            3640                     
            3641                         ! -----------------------------------------------------------------------
            3642                         ! local variables
            3643                         ! -----------------------------------------------------------------------
            3644                     
            3645                         integer :: k
            3646                     
            3647                         real :: tc, factor, sink, qden
            3648                         real :: pgacw, pgacr
            3649                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 13
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3650     1   s    s          do k = ks, ke
            3651     1               
            3652     1   m    m              tc = tz (k) - tice
            3653     1               
            3654     2   s    s              if (tc .lt. 0. .and. qg (k) .gt. qcmin) then
            3655     2               
            3656     2   s    s                  pgacw = 0.
            3657     3   s    s                  if (ql (k) .gt. qcmin) then
            3658     3   s    s                      qden = qg (k) * den (k)
            3659     4   s    s                      if (do_hail) then
            3660     4   mi   s                          factor = dts * acr2d (qden, cgacw, denfac (k), blinh, muh)
            3661     4   s    s                      else
            3662     4   mi   s                          factor = dts * acr2d (qden, cgacw, denfac (k), bling, mug)
            3663     4   s    s                      endif
            3664     3   s    s                      pgacw = factor / (1. + factor) * ql (k)
            3665     3   s    s                  endif
            3666     2               

            3590                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
            3591     1   s    s          do k = ks, ke
            3592     1               
            3593     1   p    v              tc = tz (k) - tice
            3594     1               
            3595     2   m    m              if (tc .lt. 0. .and. qs (k) .gt. qcmin) then
            3596     2               
            3597     2   s    s                  sink = 0
            3598     2   s    s                  qsm = qs0_crt / den (k)
            3599     3   s    s                  if (qs (k) .gt. qsm) then
            3600     3   s    s                      factor = dts * 1.e-3 * exp (0.09 * (tz (k) - tice))
            3601     3   s    s                      sink = factor / (1. + factor) * (qs (k) - qsm)
            3602     3   s    s                  endif
            3603     2               
            3604     2   s    s                  sink = min (fs2g_fac * qs (k), sink)
            3605     2               
            3606     2   si   s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3607     2                               0., 0., 0., 0., - sink, sink)
            3608     2               
            3609     2   p    v              endif
            3610     1               
            3611     1   p    v          enddo
            3612                     
            3613                     end subroutine pgaut

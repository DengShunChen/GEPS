              98                         real, parameter :: grav = 9.80665 ! acceleration due to gravity (m/s^2)
              99                     
             100                         real, parameter :: rgrav = 1.0 / grav ! inversion of gravity acceleration (s^2/m)
             101                     
             102                         real, parameter :: pi = 4.0 * atan (1.0) ! ratio of circle circumference to diameter
             103                     
             104                         real, parameter :: rdgas = 287.05 ! gas constant for dry air (J/kg/K)
             105                         real, parameter :: rvgas = 461.50 ! gas constant for water vapor (J/kg/K)
             106                     
             107                         real, parameter :: eps = rdgas / rvgas ! 0.6219934995
             108                         real, parameter :: zvir = rvgas / rdgas - 1. ! 0.6077338443
             109                     
             110                         real, parameter :: tice = 273.16 ! freezing temperature (K)
             111                     
             112                         real, parameter :: cp_air = 1.0046e3 ! heat capacity of dry air at constant pressure (J/kg/K)
             113                         real, parameter :: cp_vap = 4.0 * rvgas ! 1846.0, heat capacity of water vapore at constnat pressure (J/kg/K)
             114                         real, parameter :: cv_air = cp_air - rdgas ! 717.55, heat capacity of dry air at constant volume (J/kg/K)
             115                         real, parameter :: cv_vap = 3.0 * rvgas ! 1384.5, heat capacity of water vapor at constant volume (J/kg/K)
             116                     
             117                         real, parameter :: c_ice = 2.106e3 ! heat capacity of ice at 0 deg C (J/kg/K)
             118                         real, parameter :: c_liq = 4.218e3 ! heat capacity of water at 0 deg C (J/kg/K)
             119                     
             120                         real, parameter :: dc_vap = cp_vap - c_liq ! - 2.372e3, isobaric heating / cooling (J/kg/K)
             121                         real, parameter :: dc_ice = c_liq - c_ice ! 2.112e3, isobaric heating / colling (J/kg/K)
             122                         real, parameter :: d2_ice = cp_vap - c_ice ! - 260.0, isobaric heating / cooling (J/kg/K)
             123                     
             124                         real, parameter :: hlv = 2.5e6 ! latent heat of evaporation (J/kg)
             125                         real, parameter :: hlf = 3.3358e5 ! latent heat of fusion (J/kg)
             126                     
             127                         real, parameter :: visk = 1.259e-5 ! kinematic viscosity of air (m^2/s)
             128                         real, parameter :: vdifu = 2.11e-5 ! diffusivity of water vapor in air (m^2/s)
             129                         real, parameter :: tcond = 2.36e-2 ! thermal conductivity of air (J/m/s/K)
             130                     
             131                         real (kind = r8), parameter :: lv0 = hlv - dc_vap * tice ! 3.14893552e6, evaporation latent heat coeff. at 0 deg K (J/kg)
             132                         real (kind = r8), parameter :: li0 = hlf - dc_ice * tice ! - 2.2691392e5, fussion latent heat coeff. at 0 deg K (J/kg)
             133                         real (kind = r8), parameter :: li2 = lv0 + li0 ! 2.9220216e6, sublimation latent heat coeff. at 0 deg K (J/kg)
             134                     
             135                         real (kind = r8), parameter :: e00 = 611.21 ! saturation vapor pressure at 0 deg C (Pa)

            5514                     ! =======================================================================
            5515                     ! cloud water to rain autoconversion, simple version
            5516                     ! =======================================================================
            5517                     
            5518                     subroutine praut_simp (ks, ke, dts, tz, qv, ql, qr, qi, qs, qg)
            5519                     
            5520                         implicit none
            5521                     
            5522                         ! -----------------------------------------------------------------------
            5523                         ! input / output arguments
            5524                         ! -----------------------------------------------------------------------
            5525                     
            5526                         integer, intent (in) :: ks, ke
            5527                     
            5528                         real, intent (in) :: dts
            5529                     
            5530                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            5531                     
            5532                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            5533                     
            5534                         ! -----------------------------------------------------------------------
            5535                         ! local variables
            5536                         ! -----------------------------------------------------------------------
            5537                     
            5538                         integer :: k
            5539                     
            5540                         real :: tc, sink, fac_l2r
            5541                     
            5542                         fac_l2r = 1. - exp (- dts / tau_l2r)
            5543                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<< Loop-information  End >>>
            5544     1   s   2s          do k = ks, ke
            5545     1               
            5546     1   p   2v              tc = tz (k) - t_wfr
            5547     1               
            5548     2   m   2m              if (tc .gt. 0 .and. ql (k) .gt. ql0_max) then
            5549     2               
            5550     2   s   2s                  sink = fac_l2r * (ql (k) - ql0_max)
            5551     2               
            5552     2   si  2s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            5553     2                               0., - sink, sink, 0., 0., 0.)
            5554     2               
            5555     2   p   2v              endif
            5556     1               
            5557     1   p   2v          enddo
            5558                     
            5559                     end subroutine praut_simp

            5561                     ! =======================================================================
            5562                     ! cloud ice to snow autoconversion, simple version
            5563                     ! =======================================================================
            5564                     
            5565                     subroutine psaut_simp (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, den)
            5566                     
            5567                         implicit none
            5568                     
            5569                         ! -----------------------------------------------------------------------
            5570                         ! input / output arguments
            5571                         ! -----------------------------------------------------------------------
            5572                     
            5573                         integer, intent (in) :: ks, ke
            5574                     
            5575                         real, intent (in) :: dts
            5576                     
            5577                         real, intent (in), dimension (ks:ke) :: den
            5578                     
            5579                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            5580                     
            5581                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            5582                     
            5583                         ! -----------------------------------------------------------------------
            5584                         ! local variables
            5585                         ! -----------------------------------------------------------------------
            5586                     
            5587                         integer :: k
            5588                     
            5589                         real :: tc, sink, fac_i2s, qim
            5590                     
            5591                         fac_i2s = 1. - exp (- dts / tau_i2s)
            5592                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, den
                                   <<< Loop-information  End >>>
            5593     1   s   2s          do k = ks, ke
            5594     1               
            5595     1   p   2v              tc = tz (k) - tice
            5596     1               
            5597     1   p   2v              qim = qi0_max / den (k)
            5598     1               
            5599     2   m   2m              if (tc .lt. 0. .and. qi (k) .gt. qim) then
            5600     2               
            5601     2   s   2s                  sink = fac_i2s * (qi (k) - qim)
            5602     2               
            5603     2   si  2s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            5604     2                               0., 0., 0., - sink, sink, 0.)
            5605     2               
            5606     2   p   2v              endif
            5607     1               
            5608     1   p   2v          enddo
            5609                     
            5610                     end subroutine psaut_simp

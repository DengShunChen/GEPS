            5033                     ! =======================================================================
            5034                     ! vertical subgrid variability used for cloud ice and cloud water autoconversion
            5035                     ! edges: qe == qbar + / - dm
            5036                     ! =======================================================================
            5037                     
            5038                     subroutine linear_prof (km, q, dm, z_var, h_var)
            5039                     
            5040                         implicit none
            5041                     
            5042                         ! -----------------------------------------------------------------------
            5043                         ! input / output arguments
            5044                         ! -----------------------------------------------------------------------
            5045                     
            5046                         integer, intent (in) :: km
            5047                     
            5048                         logical, intent (in) :: z_var
            5049                     
            5050                         real, intent (in) :: q (km), h_var
            5051                     
            5052                         real, intent (out) :: dm (km)
            5053                     
            5054                         ! -----------------------------------------------------------------------
            5055                         ! local variables
            5056                         ! -----------------------------------------------------------------------
            5057                     
            5058                         integer :: k
            5059                     
            5060                         real :: dq (km)
            5061                     
            5062     1                   if (z_var) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dq
                                   <<< Loop-information  End >>>
            5063     2  pp   2v              do k = 2, km
            5064     2   p   2v                  dq (k) = 0.5 * (q (k) - q (k - 1))
            5065     2   p   2v              enddo
            5066     1                       dm (1) = 0.
            5067     1                       ! -----------------------------------------------------------------------
            5068     1                       ! use twice the strength of the positive definiteness limiter (Lin et al. 1994)
            5069     1                       ! -----------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 88, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dq, dm, q
                                   <<< Loop-information  End >>>
            5070     2  pp    v              do k = 2, km - 1
            5071     2   p    v                  dm (k) = 0.5 * min (abs (dq (k) + dq (k + 1)), 0.5 * q (k))
            5072     3   p    v                  if (dq (k) * dq (k + 1) .le. 0.) then
            5073     4   p    v                      if (dq (k) .gt. 0.) then
            5074     4   p    v                          dm (k) = min (dm (k), dq (k), - dq (k + 1))
            5075     4   p    v                      else
            5076     4   p    v                          dm (k) = 0.
            5077     4   p    v                      endif
            5078     3   p    v                  endif
            5079     2   p    v              enddo
            5080     1                       dm (km) = 0.
            5081     1                       ! -----------------------------------------------------------------------
            5082     1                       ! impose a presumed background horizontal variability that is proportional to the value itself
            5083     1                       ! -----------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 4.00, ITR: 224, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dm, q
                                   <<< Loop-information  End >>>
            5084     2  pp   2v              do k = 1, km
            5085     2   p   2v                  dm (k) = max (dm (k), 0.0, h_var * q (k))
            5086     2   p   2v              enddo
            5087     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.40, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, dm
                                   <<< Loop-information  End >>>
            5088     2  pp   2v              do k = 1, km
            5089     2   p   2v                  dm (k) = max (0.0, h_var * q (k))
            5090     2   p   2v              enddo
            5091     1                   endif
            5092                     
            5093                     end subroutine linear_prof
            5094                     
            5095                     ! =======================================================================
            5096                     ! accretion function, Lin et al. (1983)
            5097                     ! =======================================================================
            5098                     
            5099                     function acr2d (qden, c, denfac, blin, mu)
            5100                     
            5101                         implicit none
            5102                     
            5103                         real :: acr2d
            5104                     
            5105                         ! -----------------------------------------------------------------------
            5106                         ! input / output arguments
            5107                         ! -----------------------------------------------------------------------
            5108                     
            5109                         real, intent (in) :: qden, c, denfac, blin, mu
            5110                     
            5111                         acr2d = denfac * c * exp (1. / (mu + 3) * (2 + mu + blin) * log (6 * qden))
            5112                     
            5113                     end function acr2d
            5114                     
            5115                     ! =======================================================================
            5116                     ! accretion function, Lin et al. (1983)
            5117                     ! =======================================================================
            5118                     
            5119                     function acr3d (v1, v2, q1, q2, c, acco, acc1, acc2, den)
            5120                     
            5121                         implicit none
            5122                     
            5123                         real :: acr3d
            5124                     
            5125                         ! -----------------------------------------------------------------------
            5126                         ! input / output arguments
            5127                         ! -----------------------------------------------------------------------
            5128                     
            5129                         real, intent (in) :: v1, v2, c, den, q1, q2, acco (3), acc1, acc2
            5130                     
            5131                         ! -----------------------------------------------------------------------
            5132                         ! local variables
            5133                         ! -----------------------------------------------------------------------
            5134                     
            5135                         integer :: i
            5136                     
            5137                         real :: t1, t2, tmp
            5138                     
            5139                         t1 = exp (1. / (acc1 + 3) * log (6 * q1 * den))
            5140                         t2 = exp (1. / (acc2 + 3) * log (6 * q2 * den))
            5141                     
            5142                         acr3d = c * abs (v1 - v2) / den
            5143                     
            5144                         tmp = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5145     1       f           do i = 1, 3
            5146     1       f               tmp = tmp + acco (i) * exp ((6 + acc1 - i) * log (t1)) * exp ((acc2 + i - 1) * log (t2))
            5147     1       f           enddo
            5148                     
            5149                         acr3d = acr3d * tmp
            5150                     
            5151                     end function acr3d
            5152                     
            5153                     ! =======================================================================
            5154                     ! ventilation coefficient, Lin et al. (1983)
            5155                     ! =======================================================================
            5156                     
            5157                     function vent_coeff (qden, c1, c2, denfac, blin, mu)
            5158                     
            5159                         implicit none
            5160                     
            5161                         real :: vent_coeff
            5162                     
            5163                         ! -----------------------------------------------------------------------
            5164                         ! input / output arguments
            5165                         ! -----------------------------------------------------------------------
            5166                     
            5167                         real, intent (in) :: qden, c1, c2, denfac, blin, mu
            5168                     
            5169                         vent_coeff = c1 + c2 * exp (1. / (mu + 3) * (3 + 2 * mu + blin) / 2 * log (6 * qden)) * &
            5170                             sqrt (denfac) / exp (1. / (mu + 3) * (1 + mu) * log (6 * qden))
            5171                     
            5172                     end function vent_coeff
            5173                     
            5174                     ! =======================================================================
            5175                     ! sublimation or evaporation function, Lin et al. (1983)
            5176                     ! =======================================================================
            5177                     
            5178                     function psub (t2, dq, qden, qsat, c, den, denfac, blin, mu, cpk, cvm)
            5179                     
            5180                         implicit none
            5181                     
            5182                         real :: psub
            5183                     
            5184                         ! -----------------------------------------------------------------------
            5185                         ! input / output arguments
            5186                         ! -----------------------------------------------------------------------
            5187                     
            5188                         real, intent (in) :: t2, dq, qden, qsat, c (5), den, denfac, blin, cpk, mu
            5189                     
            5190                         real (kind = r8), intent (in) :: cvm
            5191                     
            5192          i              psub = c (1) * t2 * dq * exp (1. / (mu + 3) * (1 + mu) * log (6 * qden)) * &
            5193                             vent_coeff (qden, c (2), c (3), denfac, blin, mu) / &
            5194                              (c (4) * t2 + c (5) * (cpk * cvm) ** 2 * qsat * den)
            5195                     
            5196                     end function psub
            5197                     
            5198                     ! =======================================================================
            5199                     ! melting function, Lin et al. (1983)
            5200                     ! =======================================================================
            5201                     
            5202                     function pmlt (tc, dq, qden, pxacw, pxacr, c, den, denfac, blin, mu, lcpk, icpk, cvm)
            5203                     
            5204                         implicit none
            5205                     
            5206                         real :: pmlt
            5207                     
            5208                         ! -----------------------------------------------------------------------
            5209                         ! input / output arguments
            5210                         ! -----------------------------------------------------------------------
            5211                     
            5212                         real, intent (in) :: tc, dq, qden, pxacw, pxacr, c (4), den, denfac, blin, lcpk, icpk, mu
            5213                     
            5214                         real (kind = r8), intent (in) :: cvm
            5215                     
            5216          i              pmlt = (c (1) / (icpk * cvm) * tc / den - c (2) * lcpk / icpk * dq) * &
            5217                             exp (1. / (mu + 3) * (1 + mu) * log (6 * qden)) * &
            5218                             vent_coeff (qden, c (3), c (4), denfac, blin, mu) + &
            5219                             c_liq / (icpk * cvm) * tc * (pxacw + pxacr)
            5220                     
            5221                     end function pmlt
            5222                     
            5223                     ! =======================================================================
            5224                     ! sedimentation of horizontal momentum
            5225                     ! =======================================================================
            5226                     
            5227                     subroutine sedi_uv (ks, ke, m1, dp, u, v)
            5228                     
            5229                         implicit none
            5230                     
            5231                         ! -----------------------------------------------------------------------
            5232                         ! input / output arguments
            5233                         ! -----------------------------------------------------------------------
            5234                     
            5235                         integer, intent (in) :: ks, ke
            5236                     
            5237                         real, intent (in), dimension (ks:ke) :: m1, dp
            5238                     
            5239                         real, intent (inout), dimension (ks:ke) :: u, v
            5240                     
            5241                         ! -----------------------------------------------------------------------
            5242                         ! local variables
            5243                         ! -----------------------------------------------------------------------
            5244                     
            5245                         integer :: k
            5246                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.79, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u, v, dp, m1
                                   <<< Loop-information  End >>>
            5247     1   s   2s          do k = ks + 1, ke
            5248     1   m   2m              u (k) = (dp (k) * u (k) + m1 (k - 1) * u (k - 1)) / (dp (k) + m1 (k - 1))
            5249     1   m   2m              v (k) = (dp (k) * v (k) + m1 (k - 1) * v (k - 1)) / (dp (k) + m1 (k - 1))
            5250     1   p   2v          enddo
            5251                     
            5252                     end subroutine sedi_uv
            5253                     
            5254                     ! =======================================================================

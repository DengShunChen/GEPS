            7161                     
            7162                     subroutine update_qt (qv, ql, qr, qi, qs, qg, dqv, dql, dqr, dqi, dqs, dqg, te8, &
            7163                             cvm, tk, lcpk, icpk, tcpk, tcp3)
            7164                     
            7165                         implicit none
            7166                     
            7167                         ! -----------------------------------------------------------------------
            7168                         ! input / output arguments
            7169                         ! -----------------------------------------------------------------------
            7170                     
            7171                         real, intent (in) :: dqv, dql, dqr, dqi, dqs, dqg
            7172                     
            7173                         real (kind = r8), intent (in) :: te8
            7174                     
            7175                         real, intent (inout) :: qv, ql, qr, qi, qs, qg
            7176                     

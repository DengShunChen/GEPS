            5410                     
            5411                     subroutine pgfr_simp (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, &
            5412                             lcpk, icpk, tcpk, tcp3)
            5413                     
            5414                         implicit none
            5415                     
            5416                         ! -----------------------------------------------------------------------
            5417                         ! input / output arguments
            5418                         ! -----------------------------------------------------------------------
            5419                     
            5420                         integer, intent (in) :: ks, ke
            5421                     
            5422                         real, intent (in) :: dts
            5423                     
            5424                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            5425                     
            5426                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            5427                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            5428                     
            5429                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            5430                     
            5431                         ! -----------------------------------------------------------------------
            5432                         ! local variables
            5433                         ! -----------------------------------------------------------------------
            5434                     
            5435                         integer :: k
            5436                     
            5437                         real :: tc, sink, fac_r2g
            5438                     
            5439                         fac_r2g = 1. - exp (- dts / tau_r2g)
            5440                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 14
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5441     1   s    s          do k = ks, ke
            5442     1               
            5443     1   s    s              tc = tz (k) - tice
            5444     1               
            5445     2   s    s              if (tc .lt. 0. .and. qr (k) .gt. qcmin) then
            5446     2               
            5447     2   s    s                  sink = (- tc * 0.025) ** 2 * qr (k)
            5448     2   s    s                  sink = min (qr (k), sink, - fac_r2g * tc / icpk (k))
            5449     2               

             341                         real :: muh = 1.0 ! shape parameter of hail in Gamma distribution (Federer and Waldvogel 1975)
             342                     
             343                         real :: alinw = 3.e7 ! "a" in Lin et al. (1983) for cloud water (Ikawa and Saito 1990)
             344                     #ifdef PSD_paper_setting
             345                         real :: alini = 11.72 ! "a" in Lin et al. (1983) for cloud ice (Ikawa and Saita 1990)
             346                     #else
             347                         real :: alini = 7.e2 ! "a" in Lin et al. (1983) for cloud ice (Ikawa and Saita 1990)
             348                     #endif
             349                         real :: alinr = 842.0 ! "a" in Lin et al. (1983) for rain (Liu and Orville 1969)
             350                         real :: alins = 4.8 ! "a" in Lin et al. (1983) for snow (straka 2009)
             351                         real :: aling = 1.0 ! "a" in Lin et al. (1983), similar to a, but for graupel (Pruppacher and Klett 2010)
             352                         real :: alinh = 1.0 ! "a" in Lin et al. (1983), similar to a, but for hail (Pruppacher and Klett 2010)
             353                     
             354                         real :: blinw = 2.0 ! "b" in Lin et al. (1983) for cloud water (Ikawa and Saito 1990)
             355                     #ifdef PSD_paper_setting
             356                         real :: blini = 0.41 ! "b" in Lin et al. (1983) for cloud ice (Ikawa and Saita 1990)
             357                     #else
             358                         real :: blini = 1.0 ! "b" in Lin et al. (1983) for cloud ice (Ikawa and Saita 1990)
             359                     #endif
             360                         real :: blinr = 0.8 ! "b" in Lin et al. (1983) for rain (Liu and Orville 1969)
             361                         real :: blins = 0.25 ! "b" in Lin et al. (1983) for snow (straka 2009)
             362                         real :: bling = 0.5 ! "b" in Lin et al. (1983), similar to b, but for graupel (Pruppacher and Klett 2010)
             363                         real :: blinh = 0.5 ! "b" in Lin et al. (1983), similar to b, but for hail (Pruppacher and Klett 2010)
             364                     
             365                         real :: tice_mlt = 273.16 ! can set ice melting temperature to 268 based on observation (Kay et al. 2016) (K)
             366                     
             367                         real :: t_min = 178.0 ! minimum temperature to freeze - dry all water vapor (K)
             368                         real :: t_sub = 184.0 ! minimum temperature for sublimation of cloud ice (K)
             369                     
             370                         real :: rh_inc = 0.25 ! rh increment for complete evaporation of cloud water and cloud ice
             371                         real :: rh_inr = 0.25 ! rh increment for minimum evaporation of rain
             372                         real :: rh_ins = 0.25 ! rh increment for sublimation of snow
             373                     
             374                         real :: tau_r2g = 900.0 ! rain freezing to graupel time scale (s)
             375                         real :: tau_i2s = 1000.0 ! cloud ice to snow autoconversion time scale (s)
             376                         real :: tau_l2r = 900.0 ! cloud water to rain autoconversion time scale (s)
             377                         real :: tau_v2l = 150.0 ! water vapor to cloud water condensation time scale (s)
             378                         real :: tau_l2v = 300.0 ! cloud water to water vapor evaporation time scale (s)
             379                         real :: tau_revp = 0.0 ! rain evaporation time scale (s)
             380                         real :: tau_imlt = 1200.0 ! cloud ice melting time scale (s)
             381                         real :: tau_smlt = 900.0 ! snow melting time scale (s)
             382                         real :: tau_gmlt = 600.0 ! graupel melting time scale (s)
             383                         real :: tau_wbf = 300.0 ! graupel melting time scale (s)
             384                     
             385                         real :: dw_land = 0.20 ! base value for subgrid deviation / variability over land
             386                         real :: dw_ocean = 0.10 ! base value for subgrid deviation / variability over ocean
             387                     
             388                     #ifdef MERRA2_aeroclimfix
             389                         real :: ccn_o = 66. ! ccn over ocean (1/cm^3) from Zhou et al. 2022
             390                         real :: ccn_l = 159. ! ccn over land (1/cm^3) from Zhou et al. 2022
             391                     #else
             392                         real :: ccn_o = 90.0 ! ccn over ocean (1/cm^3)
             393                         real :: ccn_l = 270.0 ! ccn over land (1/cm^3)
             394                     #endif
             395                     
             396                         real :: rthresh = 10.0e-6 ! critical cloud drop radius (micron) for autoconversion
             397                     
             398                         real :: cld_min = 0.05 ! minimum cloud fraction
             399                     
             400                         real :: qi_lim = 1.0 ! cloud ice limiter (0: no, 1: full, >1: extra) to prevent large ice build up
             401                     
             402                         real :: ql_mlt = 2.0e-3 ! maximum cloud water allowed from melted cloud ice (kg/kg)
             403                         real :: qs_mlt = 1.0e-6 ! maximum cloud water allowed from melted snow (kg/kg)
             404                     
             405                         real :: ql_gen = 1.0e-3 ! maximum cloud water generation during remapping step (kg/kg)
             406                     
             407                         real :: ql0_max = 2.0e-3 ! maximum cloud water value (autoconverted to rain) (kg/kg)
             408                         real :: qi0_max = 1.0e-4 ! maximum cloud ice value (autoconverted to snow) (kg/m^3)
             409                     
             410                     !    real :: qi0_crt = 1.0e-4 ! cloud ice to snow autoconversion threshold (kg/m^3)
             411                         real :: qi0_crt = 0.2e-4 ! cloud ice to snow autoconversion threshold (kg/m^3)
             412                         real :: qs0_crt = 1.0e-3 ! snow to graupel autoconversion threshold (0.6e-3 in Purdue Lin scheme) (kg/m^3)
             413                     
             414                         real :: c_paut = 0.55 ! cloud water to rain autoconversion efficiency
             415                         real :: c_psacw = 1.0 ! cloud water to snow accretion efficiency
             416                         real :: c_psaci = 0.02 ! cloud ice to snow accretion efficiency (was 0.1 in ZETAC)
             417                         real :: c_pracw = 0.9 ! cloud water to rain accretion efficiency
             418                         real :: c_praci = 1.0 ! cloud ice to rain accretion efficiency
             419                         real :: c_pgacw = 1.0 ! cloud water to graupel accretion efficiency
             420                         real :: c_pgaci = 0.05 ! cloud ice to graupel accretion efficiency (was 0.1 in ZETAC)
             421                         real :: c_pracs = 1.0 ! snow to rain accretion efficiency
             422                         real :: c_psacr = 1.0 ! rain to snow accretion efficiency
             423                         real :: c_pgacr = 1.0 ! rain to graupel accretion efficiency
             424                         real :: c_pgacs = 0.01 ! snow to graupel accretion efficiency (was 0.1 in ZETAC)
             425                     
             426                         real :: is_fac = 0.2 ! cloud ice sublimation temperature factor
             427                         real :: ss_fac = 0.2 ! snow sublimation temperature factor
             428                         real :: gs_fac = 0.2 ! graupel sublimation temperature factor
             429                     
             430                         real :: rh_fac = 10.0 ! cloud water condensation / evaporation relative humidity factor
             431                     
             432                         real :: vw_fac = 1.0
             433                     !    real :: vi_fac = 1.0 ! IFS: if const_vi: 1 / 3
             434                         real :: vi_fac = 0.9 ! IFS: if const_vi: 1 / 3
             435                         real :: vs_fac = 1.0 ! IFS: if const_vs: 1.
             436                         real :: vg_fac = 1.0 ! IFS: if const_vg: 2.
             437                         real :: vr_fac = 1.0 ! IFS: if const_vr: 4.
             438                     
             439                         real :: vw_max = 0.01 ! maximum fall speed for cloud water (m/s)
             440                         real :: vi_max = 0.5 ! maximum fall speed for cloud ice (m/s)
             441                         real :: vs_max = 5.0 ! maximum fall speed for snow (m/s)
             442                         real :: vg_max = 8.0 ! maximum fall speed for graupel (m/s)
             443                         real :: vr_max = 12.0 ! maximum fall speed for rain (m/s)
             444                     
             445                         real :: xr_a = 0.25 ! p value in Xu and Randall (1996)
             446                         real :: xr_b = 100.0 ! alpha_0 value in Xu and Randall (1996)
             447                         real :: xr_c = 0.49 ! gamma value in Xu and Randall (1996)
             448                     
             449                         real :: te_err = 1.e-14 ! 64bit: 1.e-14, 32bit: 1.e-7; turn off to save computer time
             450                     
             451                         real :: rh_thres = 0.75 ! minimum relative humidity for cloud fraction
             452                         real :: rhc_cevap = 0.85 ! maximum relative humidity for cloud water evaporation
             453                         real :: rhc_revap = 0.85 ! maximum relative humidity for rain evaporation
             454                     
             455                         real :: f_dq_p = 1.0 ! cloud fraction adjustment for supersaturation
             456                         real :: f_dq_m = 1.0 ! cloud fraction adjustment for undersaturation
             457                     
             458                         real :: fi2s_fac = 1.0 ! maximum sink of cloud ice to form snow: 0-1
             459                         real :: fi2g_fac = 1.0 ! maximum sink of cloud ice to form graupel: 0-1
             460                         real :: fs2g_fac = 1.0 ! maximum sink of snow to form graupel: 0-1
             461                     
             462                         real :: beta = 1.22 ! defined in Heymsfield and Mcfarquhar (1996)
             463                     
             464                         real :: rewmin = 5.0, rewmax = 15.0 ! minimum and maximum effective radius for cloud water (micron)
             465                         real :: reimin = 10.0, reimax = 150.0 ! minimum and maximum effective radius for cloud ice (micron)
             466                         real :: rermin = 15.0, rermax = 10000.0 ! minimum and maximum effective radius for rain (micron)
             467                         real :: resmin = 150.0, resmax = 10000.0 ! minimum and maximum effective radius for snow (micron)
             468                         real :: regmin = 150.0, regmax = 10000.0 ! minimum and maximum effective radius for graupel
             469                         !real :: rewmax = 15.0, rermin = 15.0 ! Kokhanovsky (2004)
             470                     
             471                         ! -----------------------------------------------------------------------
             472                         ! local shared variables
             473                         ! -----------------------------------------------------------------------
             474                     
             475                         real :: acco (3, 10), acc (20)
             476                         real :: cracs, csacr, cgacr, cgacs, csacw, craci, csaci, cgacw, cgaci, cracw
             477                         real :: cssub (5), cgsub (5), crevp (5), cgfr (2), csmlt (4), cgmlt (4)
             478                     
             479                         real :: t_wfr, fac_rc, c_air, c_vap, d0_vap
             480                     
             481                         real (kind = r8) :: lv00, li00, li20, cpaut
             482                         real (kind = r8) :: d1_vap, d1_ice, c1_vap, c1_liq, c1_ice
             483                         real (kind = r8) :: vconw, vconr, vconi, vcons, vcong, vconh
             484                         real (kind = r8) :: normw, normr, normi, norms, normg, normh
             485                         real (kind = r8) :: expow, expor, expoi, expos, expog, expoh
             486                     
             487                         real, allocatable :: table0 (:), table1 (:), table2 (:), table3 (:), table4 (:)
             488                         real, allocatable :: des0 (:), des1 (:), des2 (:), des3 (:), des4 (:)
             489                     

            4096                         ! -----------------------------------------------------------------------
            4097                     
            4098                         integer :: k
            4099                     
            4100                         real :: sink, tc
            4101                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 22
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4102     1   s    s          do k = ks, ke
            4103     1               
            4104     1   s    s              tc = tice - tz (k)
            4105     1               
            4106     2   s    s              if (tc .gt. 0 .and. ql (k) .gt. qcmin) then
            4107     2               
            4108     2   s    s                  sink = 100. / (rhow * ccn (k)) * dts * (exp (0.66 * tc) - 1.) * ql (k) ** 2
            4109     2   s    s                  sink = min (ql (k), sink, tc / icpk (k))
            4110     2               
            4111     2   s    s                  call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            4112     2                               0., - sink, 0., sink, 0., 0., te8 (k), cvm (k), tz (k), &
            4113     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            4114     2               

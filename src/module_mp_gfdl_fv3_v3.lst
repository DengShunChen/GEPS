            7190                         qg = qg + dqg
            7191                     
            7192          i              cvm = mhc (qv, ql, qr, qi, qs, qg)
            7193                         tk = (te8 - lv00 * qv + li00 * (qi + qs + qg)) / cvm
            7194                     
            7195                         lcpk = (lv00 + d1_vap * tk) / cvm
            7196                         icpk = (li00 + d1_ice * tk) / cvm
            7197                         tcpk = (li20 + (d1_vap + d1_ice) * tk) / cvm

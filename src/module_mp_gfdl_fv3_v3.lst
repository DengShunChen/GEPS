            6869     7   p    v                                      z_e = z_e + fac_g * exp (1. / (mug + 3) * (mug + 6) * log (6 * qden))
            6870     7   p    v                                  else
            6871     7   p    v                                      z_e = z_e + fac_g * exp (1. / (mug + 3) * (mug + 6) * log (6 * qden)) / alpha
            6872     7   p    v                                  endif
            6873     6   p    v                              endif
            6874     6   p    v                              if (radg_flag .eq. 2) then
            6875     6   p    v                                  z_e = z_e + fac_g * exp (1. / (mug + 3) * (mug + 6) * log (6 * qden))
            6876     6   p    v                              endif
            6877     5   p    v                          endif
            6878     5   p    v                          if (radg_flag .eq. 3) then
            6879     5   p    v                              z_e = z_e + mp_const * exp (1.6 * log (qden * vtg (k)))
            6880     5   p    v                          endif
            6881     4   p    v                      endif
            6882     3               
            6883     3   p    v                      dbz (i, j, k) = 10. * log10 (max (0.01, z_e))
            6884     3   p    v                  enddo
            6885     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6886     3  pp    v                  do k = mp_top + 1, npz
            6887     3   p    v                      maxdbz (i, j) = max (dbz (i, j, k), maxdbz (i, j))
            6888     3   p    v                  enddo
            6889     2               
            6890     2                           allmax = max (maxdbz (i, j), allmax)
            6891     2               
            6892     2                       enddo
            6893     1                   enddo
            6894                     
            6895                     end subroutine rad_ref

            7274                         integer, parameter :: n_min = 1600
            7275                     
            7276                         real (kind = r8) :: delt = 0.1
            7277                         real (kind = r8) :: tmin, tem, esh
            7278                         real (kind = r8) :: wice, wh2o, fac0, fac1, fac2
            7279                         real (kind = r8) :: esbasw, tbasw, esbasi, a, b, c, d, e
            7280                         real (kind = r8) :: esupc (n_blend)
            7281                     
            7282                         esbasw = 1013246.0
            7283                         tbasw = tice + 100.
            7284                         esbasi = 6107.1
            7285                         tmin = tice - n_min * delt
            7286                     
            7287                         ! -----------------------------------------------------------------------
            7288                         ! compute es over ice between - (n_min * delt) deg C and 0 deg C
            7289                         ! -----------------------------------------------------------------------
            7290                     
            7291     1                   if (do_smith_table) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.36, ITR: 80, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 33
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            7292     2  pp    v              do i = 1, n_min
            7293     2   p    v                  tem = tmin + delt * real (i - 1)
            7294     2   p    v                  a = - 9.09718 * (tice / tem - 1.)
            7295     2   p    v                  b = - 3.56654 * log10 (tice / tem)
            7296     2   p    v                  c = 0.876793 * (1. - tem / tice)
            7297     2   p    v                  e = log10 (esbasi)
            7298     2   p    v                  table (i) = 0.1 * exp ((a + b + c + e) * log (10.))
            7299     2   p    v              enddo
            7300     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22

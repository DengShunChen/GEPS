            2906                             lcpk, icpk, tcpk, tcp3)
            2907                     
            2908     1                   if (.not. do_warm_rain_mp) then
            2909     1               
            2910     1                       ! -----------------------------------------------------------------------
            2911     1                       ! cloud ice melting to form cloud water and rain
            2912     1                       ! -----------------------------------------------------------------------
            2913     1               
            2914     1                       call pimlt (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, lcpk, icpk, tcpk, tcp3)
            2915     1               
            2916     1                       ! -----------------------------------------------------------------------
            2917     1                       ! cloud water freezing to form cloud ice and snow
            2918     1                       ! -----------------------------------------------------------------------
            2919     1               
            2920     1                       call pifr (ks, ke, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, lcpk, icpk, tcpk, tcp3)
            2921     1               

             491                         ! namelist
             492                         ! -----------------------------------------------------------------------
             493                     
             494                         namelist / gfdl_mp_nml / &
             495                             t_min, t_sub, tau_r2g, tau_smlt, tau_gmlt, dw_land, dw_ocean, vw_fac, vi_fac, &
             496                             vr_fac, vs_fac, vg_fac, ql_mlt, do_qa, fix_negative, vw_max, vi_max, vs_max, &
             497                             vg_max, vr_max, qs_mlt, qs0_crt, ql0_max, qi0_max, qi0_crt, ifflag, &
             498                             rh_inc, rh_ins, rh_inr, const_vw, const_vi, const_vs, const_vg, const_vr, rthresh, &
             499                             ccn_l, ccn_o, igflag, c_paut, tau_imlt, tau_v2l, tau_l2v, tau_i2s, &
             500                             tau_l2r, qi_lim, ql_gen, do_hail, inflag, c_psacw, c_psaci, c_pracs, &
             501                             c_psacr, c_pgacr, c_pgacs, c_pgacw, c_pgaci, z_slope_liq, z_slope_ice, &
             502                             prog_ccn, c_pracw, c_praci, rad_snow, rad_graupel, rad_rain, cld_min, &
             503                             use_ppm, mono_prof, do_sedi_uv, do_sedi_w, do_sedi_heat, icloud_f, &
             504                             irain_f, xr_a, xr_b, xr_c, ntimes, tau_revp, tice_mlt, do_cond_timescale, &
             505                             mp_time, consv_checker, te_err, use_rhc_cevap, use_rhc_revap, tau_wbf, &
             506                             do_warm_rain_mp, rh_thres, f_dq_p, f_dq_m, do_cld_adj, rhc_cevap, &
             507                             rhc_revap, beta, liq_ice_combine, rewflag, reiflag, rerflag, resflag, &
             508                             regflag, rewmin, rewmax, reimin, reimax, rermin, rermax, resmin, &
             509                             resmax, regmin, regmax, fs2g_fac, fi2s_fac, fi2g_fac, do_sedi_melt, &
             510                             radr_flag, rads_flag, radg_flag, do_wbf, do_psd_water_fall, do_psd_ice_fall, &
             511                             n0w_sig, n0i_sig, n0r_sig, n0s_sig, n0g_sig, n0h_sig, n0w_exp, n0i_exp, &
             512                             n0r_exp, n0s_exp, n0g_exp, n0h_exp, muw, mui, mur, mus, mug, muh, &
             513                             alinw, alini, alinr, alins, aling, alinh, blinw, blini, blinr, blins, bling, blinh, &
             514                             do_new_acc_water, do_new_acc_ice, is_fac, ss_fac, gs_fac, rh_fac, &
             515                             snow_grauple_combine
             516                     

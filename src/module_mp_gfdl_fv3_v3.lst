             540                     contains
             541                     
             542                     ! =======================================================================
             543                     ! GFDL cloud microphysics initialization
             544                     ! =======================================================================
             545                     
             546                     !subroutine gfdl_cld_mp_init (me, master, nlunit, input_nml_file, logunit, fn_nml)
             547                     subroutine gfdl_cld_mp_init ()
             548                     
             549                         implicit none
             550                     
             551                         ! -----------------------------------------------------------------------
             552                         ! input / output arguments
             553                         ! -----------------------------------------------------------------------
             554                     
             555                     !    integer, intent (in) :: me, master, nlunit, logunit
             556                     
             557                     !    character (len = 64), intent (in) :: fn_nml
             558                     
             559                     !    character (len = *), intent (in) :: input_nml_file (:)
             560                     
             561                         ! -----------------------------------------------------------------------
             562                         ! local variables
             563                         ! -----------------------------------------------------------------------
             564                     
             565                         logical :: exists
             566                     
             567                         ! -----------------------------------------------------------------------
             568                         ! read namelist
             569                         ! -----------------------------------------------------------------------
             570                     
             571                     !#ifdef INTERNAL_FILE_NML
             572                     !    read (input_nml_file, nml = gfdl_mp_nml)
             573                     !#else
             574                     !    inquire (file = trim (fn_nml), exist = exists)
             575                     !    if (.not. exists) then
             576                     !        write (6, *) 'gfdl - mp :: namelist file: ', trim (fn_nml), ' does not exist'
             577                     !        stop
             578                     !    else
             579                     !        open (unit = nlunit, file = fn_nml, readonly, status = 'old')
             580                     !    endif
             581                     !    rewind (nlunit)
             582                     !    read (nlunit, nml = gfdl_mp_nml)
             583                     !    close (nlunit)
             584                     !#endif
             585                     
             586                         ! -----------------------------------------------------------------------
             587                         ! write namelist to log file
             588                         ! -----------------------------------------------------------------------
             589                     
             590                     !    if (me .eq. master) then
             591                     !        write (logunit, *) " ================================================================== "
             592                     !        write (logunit, *) "gfdl_mp_mod"
             593                     !        write (logunit, nml = gfdl_mp_nml)
             594                     !    endif
             595                     
             596                         ! -----------------------------------------------------------------------
             597                         ! initialize microphysics variables
             598                         ! -----------------------------------------------------------------------
             599                     
             600                         if (.not. tables_are_initialized) call qs_init
             601                     
             602                         call setup_mp
             603                     
             604                     end subroutine gfdl_cld_mp_init
             605                     
             606                     ! =======================================================================
             607                     ! GFDL cloud microphysics driver
             608                     ! =======================================================================
             609                     
             610                     subroutine gfdl_cld_mp_driver                                              &
             611                                 ( qv, ql, qr, qi, qs, qg, qa, qnl, qni,                        &
             612                                   pt, wa, ua, va, delz, delp, gsize, dtm, hs,                  &
             613                                   land,                                                        &
             614                                   water,                                                       &
             615                                   rain, snow, ice, graupel, hydrostatic,                       &
             616                                   is, ie, ks, ke, q_con, cappa, consv_te, te,                  &
             617                     #ifdef EXT_DIAG
             618                                   prefluxw, prefluxr, prefluxi, prefluxs, prefluxg,            &
             619                                   condensation, deposition, evaporation, sublimation,          &
             620                     #endif
             621                                   rhc, last_step, do_inline_mp )
             622                     
             623                         implicit none
             624                     
             625                         ! -----------------------------------------------------------------------
             626                         ! input / output arguments
             627                         ! -----------------------------------------------------------------------
             628                     
             629                         integer, intent (in) :: is, ie, ks, ke
             630                     
             631                         logical, intent (in) :: hydrostatic, last_step, consv_te, do_inline_mp
             632                     
             633                         real, intent (in) :: dtm
             634                     
             635                         real, intent (in), dimension (is:ie) :: hs, gsize, land
             636                     
             637                         real, intent (in), dimension (is:ie, ks:ke) :: delz, qnl, qni
             638                         real, intent (in), dimension (is:ie, ks:ke) :: rhc
             639                     
             640                         real, intent (inout), dimension (is:ie, ks:ke) :: delp, pt, ua, va, wa, te
             641                         real, intent (inout), dimension (is:ie, ks:ke) :: qv, ql, qr, qi, qs, qg, qa
             642                     
             643                         real, intent (inout), dimension (is:, ks:) :: q_con, cappa
             644                     
             645                         real, intent (inout), dimension (is:ie) :: water, rain, ice, snow, graupel
             646                     #ifdef EXT_DIAG
             647                         real, intent (inout), dimension (is:ie, ks:ke) :: prefluxw, prefluxr, prefluxi, prefluxs, prefluxg
             648                         real, intent (inout), dimension (is:ie) :: condensation, deposition
             649                         real, intent (inout), dimension (is:ie) :: evaporation, sublimation
             650                     #else
             651                         real, dimension (is:ie, ks:ke) :: prefluxw, prefluxr, prefluxi, prefluxs, prefluxg
             652                         real, dimension (is:ie) :: condensation, deposition
             653                         real, dimension (is:ie) :: evaporation, sublimation
             654                     #endif
             655                     
             656                         ! -----------------------------------------------------------------------
             657                         ! define various heat capacities and latent heat coefficients at 0 deg K
             658                         ! -----------------------------------------------------------------------
             659                     
             660                         call setup_mhc_lhc (hydrostatic)
             661                     
             662                         ! -----------------------------------------------------------------------
             663                         ! major cloud microphysics driver
             664                         ! -----------------------------------------------------------------------
             665                     
             666                         call mpdrv (hydrostatic, ua, va, wa, delp, pt, qv, ql, qr, qi, qs, qg, qa, &
             667                             qnl, qni, delz, is, ie, ks, ke, dtm, water, rain, ice, snow, graupel, &
             668                     #ifdef oldmask
             669                             land, &
             670                     #endif
             671                             gsize, hs, q_con, cappa, consv_te, te, prefluxw, prefluxr, prefluxi, &
             672                             prefluxs, prefluxg, condensation, deposition, evaporation, sublimation, &
             673                             rhc, last_step, do_inline_mp, .false., .true.)
             674                     
             675                     end subroutine gfdl_cld_mp_driver
             676                     
             677                     ! =======================================================================
             678                     ! GFDL cloud microphysics end
             679                     ! =======================================================================
             680                     
             681                     subroutine gfdl_cld_mp_end
             682                     
             683                         implicit none
             684                     
             685                         ! -----------------------------------------------------------------------
             686                         ! free up memory
             687                         ! -----------------------------------------------------------------------
             688                     
             689                         deallocate (table0)
             690                         deallocate (table1)
             691                         deallocate (table2)
             692                         deallocate (table3)
             693                         deallocate (table4)
             694                         deallocate (des0)
             695                         deallocate (des1)
             696                         deallocate (des2)
             697                         deallocate (des3)
             698                         deallocate (des4)
             699                     
             700                         tables_are_initialized = .false.
             701                     
             702                     end subroutine gfdl_cld_mp_end
             703                     
             704                     ! =======================================================================
             705                     ! setup cloud microphysics parameters
             706                     ! =======================================================================
             707                     
             708                     subroutine setup_mp
             709                     
             710                         implicit none
             711                     
             712                         integer :: i, k
             713                     
             714                         real :: gcon, hcon, scm3, pisq, act (20), ace (20), occ (3)
             715                     
             716                         ! -----------------------------------------------------------------------
             717                         ! complete freezing temperature
             718                         ! -----------------------------------------------------------------------
             719                     
             720     1                   if (do_warm_rain_mp) then
             721     1                       t_wfr = t_min
             722     1                   else
             723     1                       t_wfr = tice - 40.0
             724     1                   endif
             725                     
             726                         ! -----------------------------------------------------------------------
             727                         ! cloud water autoconversion, Hong et al. (2004)
             728                         ! -----------------------------------------------------------------------
             729                     
             730                         fac_rc = (4. / 3.) * pi * rhor * rthresh ** 3
             731                     
             732                         cpaut = c_paut * 0.104 * grav / 1.717e-5
             733                     
             734                         ! -----------------------------------------------------------------------
             735                         ! terminal velocities parameters of rain, snow, and graupel or hail, Lin et al. (1983)
             736                         ! -----------------------------------------------------------------------
             737                     
             738                         gcon = 40.74 ! (4 * g * rhog / (3 * CD * rho0)) ** 0.5 in Lin et al. (1983)
             739                         hcon = gcon * sqrt (rhoh / rhog)
             740                     
             741                         vconw = alinw * gamma (3 + muw + blinw) / gamma (3 + muw)
             742                         vconi = alini * gamma (3 + mui + blini) / gamma (3 + mui)
             743                         vconr = alinr * gamma (3 + mur + blinr) / gamma (3 + mur)
             744                         vcons = alins * gamma (3 + mus + blins) / gamma (3 + mus)
             745                         vcong = aling * gamma (3 + mug + bling) / gamma (3 + mug) * gcon
             746                         vconh = alinh * gamma (3 + muh + blinh) / gamma (3 + muh) * hcon

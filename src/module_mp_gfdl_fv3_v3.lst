                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.21, ITR: 8, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      m1, tz, cv0, dgz
                                   <<< Loop-information  End >>>
            5320     1   s   2s          do k = ks + 1, ke
            5321     1   m   2m              tz (k) = (cv0 (k) * tz (k) + m1 (k - 1) * (cw * tz (k - 1) + dgz (k))) / &
            5322     1                            (cv0 (k) + cw * m1 (k - 1))
            5323     1   p   2v          enddo
            5324                     
            5325                     end subroutine sedi_heat

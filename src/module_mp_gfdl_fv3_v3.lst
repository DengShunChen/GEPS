            2480                     
            2481                     subroutine zezt (ks, ke, dts, zs, dz, vt, ze, zt)
            2482                     
            2483                         implicit none
            2484                     
            2485                         ! -----------------------------------------------------------------------
            2486                         ! input / output arguments
            2487                         ! -----------------------------------------------------------------------
            2488                     
            2489                         integer, intent (in) :: ks, ke
            2490                     
            2491                         real, intent (in) :: dts
            2492                     
            2493                         real, intent (in), dimension (ks:ke) :: dz, vt
            2494                     

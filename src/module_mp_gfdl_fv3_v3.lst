            5460                     ! =======================================================================
            5461                     ! snow melting to form cloud water and rain, simple version
            5462                     ! =======================================================================
            5463                     
            5464                     subroutine psmlt_simp (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, &
            5465                             lcpk, icpk, tcpk, tcp3)
            5466                     
            5467                         implicit none
            5468                     
            5469                         ! -----------------------------------------------------------------------
            5470                         ! input / output arguments
            5471                         ! -----------------------------------------------------------------------
            5472                     
            5473                         integer, intent (in) :: ks, ke
            5474                     
            5475                         real, intent (in) :: dts
            5476                     
            5477                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            5478                     
            5479                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            5480                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            5481                     
            5482                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            5483                     
            5484                         ! -----------------------------------------------------------------------
            5485                         ! local variables
            5486                         ! -----------------------------------------------------------------------
            5487                     
            5488                         integer :: k
            5489                     
            5490                         real :: tc, tmp, sink, fac_smlt
            5491                     
            5492                         fac_smlt = 1. - exp (- dts / tau_smlt)
            5493                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 7
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5494     1   s    s          do k = ks, ke
            5495     1               
            5496     1   s    s              tc = tz (k) - tice
            5497     1               
            5498     2   s    s              if (tc .ge. 0. .and. qs (k) .gt. qcmin) then
            5499     2               
            5500     2   s    s                  sink = (tc * 0.1) ** 2 * qs (k)
            5501     2   s    s                  sink = min (qs (k), sink, fac_smlt * tc / icpk (k))
            5502     2   s    s                  tmp = min (sink, dim (qs_mlt, ql (k)))
            5503     2               
            5504     2   s    s                  call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            5505     2                               0., tmp, sink - tmp, 0., - sink, 0., te8 (k), cvm (k), tz (k), &
            5506     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            5507     2               
            5508     2   s    s              endif
            5509     1               
            5510     1   s    s          enddo
            5511                     
            5512                     end subroutine psmlt_simp

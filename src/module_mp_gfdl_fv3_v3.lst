            7313                     
            7314     1                   if (do_smith_table) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 12
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            7315     2  pp    v              do i = 1, n - n_min + n_blend
            7316     2   p    v                  tem = tice + delt * (real (i - 1) - n_blend)
            7317     2   p    v                  a = - 7.90298 * (tbasw / tem - 1.)
            7318     2   p    v                  b = 5.02808 * log10 (tbasw / tem)
            7319     2   p    v                  c = - 1.3816e-7 * (exp ((1. - tem / tbasw) * 11.344 * log (10.)) - 1.)
            7320     2   p    v                  d = 8.1328e-3 * (exp ((tbasw / tem - 1.) * (- 3.49149) * log (10.)) - 1.)
            7321     2   p    v                  e = log10 (esbasw)
            7322     2   p    v                  esh = 0.1 * exp ((a + b + c + d + e) * log (10.))
            7323     3   p    v                  if (i .le. n_blend) then
            7324     3   p    v                      esupc (i) = esh
            7325     3   p    v                  else
            7326     3   p    v                      table (i + n_min - n_blend) = esh
            7327     3   p    v                  endif
            7328     2   p    v              enddo
            7329     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            7330     2  pp    v              do i = 1, n - n_min + n_blend
            7331     2   p    v                  tem = tice + delt * (real (i - 1) - n_blend)
            7332     2   p    v                  fac0 = (tem - tice) / (tem * tice)
            7333     2   p    v                  fac1 = fac0 * lv0
            7334     2   p    v                  fac2 = (dc_vap * log (tem / tice) + fac1) / rvgas
            7335     2   p    v                  esh = e00 * exp (fac2)
            7336     3   p    v                  if (i .le. n_blend) then
            7337     3   p    v                      esupc (i) = esh
            7338     3   p    v                  else
            7339     3   p    v                      table (i + n_min - n_blend) = esh
            7340     3   p    v                  endif
            7341     2   p    v              enddo
            7342     1                   endif
            7343                     
            7344                         ! -----------------------------------------------------------------------
            7345                         ! derive blended es over ice and supercooled water between - (n_blend * delt) deg C and 0 deg C
            7346                         ! -----------------------------------------------------------------------
            7347                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.66, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      esupc, table
                                   <<< Loop-information  End >>>
            7348     1  pp   2v          do i = 1, n_blend
            7349     1   p   2v              tem = tice + delt * (real (i - 1) - n_blend)
            7350     1   p   2v              wice = 1.0 / (delt * n_blend) * (tice - tem)
            7351     1   p   2v              wh2o = 1.0 / (delt * n_blend) * (tem - tice + delt * n_blend)
            7352     1   p   2v              table (i + n_min - n_blend) = wice * table (i + n_min - n_blend) + wh2o * esupc (i)
            7353     1   p   2v          enddo
            7354                     
            7355                     end subroutine qs_table_core
            7356                     
            7357                     ! =======================================================================
            7358                     ! saturation water vapor pressure table 0, water only
            7359                     ! useful for idealized experiments
            7360                     ! it can also be used in warm rain microphyscis only
            7361                     ! =======================================================================
            7362                     
            7363                     subroutine qs_table0 (n)
            7364                     
            7365                         implicit none
            7366                     
            7367                         ! -----------------------------------------------------------------------
            7368                         ! input / output arguments
            7369                         ! -----------------------------------------------------------------------
            7370                     
            7371                         integer, intent (in) :: n
            7372                     
            7373                         ! -----------------------------------------------------------------------
            7374                         ! local variables
            7375                         ! -----------------------------------------------------------------------
            7376                     
            7377                         integer :: i
            7378                     
            7379                         real (kind = r8) :: delt = 0.1
            7380                         real (kind = r8) :: tmin, tem, fac0, fac1, fac2
            7381                     
            7382                         tmin = tice - 160.
            7383                     
            7384                         ! -----------------------------------------------------------------------
            7385                         ! compute es over water only
            7386                         ! -----------------------------------------------------------------------
            7387                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      table0
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 96
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            7388     1  pp    v          do i = 1, n
            7389     1   p    v              tem = tmin + delt * real (i - 1)
            7390     1   p    v              fac0 = (tem - tice) / (tem * tice)
            7391     1   p    v              fac1 = fac0 * lv0
            7392     1   p    v              fac2 = (dc_vap * log (tem / tice) + fac1) / rvgas
            7393     1   p    v              table0 (i) = e00 * exp (fac2)
            7394     1   p    v          enddo
            7395                     
            7396                     end subroutine qs_table0

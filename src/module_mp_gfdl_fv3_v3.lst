            1542                     ! =======================================================================
            1543                     ! fix negative water species
            1544                     ! =======================================================================
            1545                     
            1546                     subroutine neg_adj (ks, ke, tz, dp, qv, ql, qr, qi, qs, qg, cond)
            1547                     
            1548                         implicit none
            1549                     
            1550                         ! -----------------------------------------------------------------------
            1551                         ! input / output arguments
            1552                         ! -----------------------------------------------------------------------
            1553                     
            1554                         integer, intent (in) :: ks, ke
            1555                     
            1556                         real, intent (in), dimension (ks:ke) :: dp
            1557                     
            1558                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1559                     
            1560                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            1561                     
            1562                         real, intent (out) :: cond
            1563                     
            1564                         ! -----------------------------------------------------------------------
            1565                         ! local variables
            1566                         ! -----------------------------------------------------------------------
            1567                     
            1568                         integer :: k
            1569                     
            1570                         real :: dq, sink
            1571                     
            1572                         real, dimension (ks:ke) :: q_liq, q_sol, lcpk, icpk, tcpk, tcp3
            1573                     
            1574                         real (kind = r8), dimension (ks:ke) :: cvm, te8
            1575                     
            1576                         ! -----------------------------------------------------------------------
            1577                         ! initialization
            1578                         ! -----------------------------------------------------------------------
            1579                     
            1580                         cond = 0
            1581                     
            1582                         ! -----------------------------------------------------------------------
            1583                         ! calculate moist heat capacity and latent heat coefficients
            1584                         ! -----------------------------------------------------------------------
            1585                     
            1586                         call cal_mhc_lhc (ks, ke, qv, ql, qr, qi, qs, qg, q_liq, q_sol, cvm, te8, tz, &
            1587                             lcpk, icpk, tcpk, tcp3)
            1588                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, qs, qg, qr, ql
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 17
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1589     1   s    s          do k = ks, ke
            1590     1               
            1591     1                       ! -----------------------------------------------------------------------
            1592     1                       ! fix negative solid-phase hydrometeors
            1593     1                       ! -----------------------------------------------------------------------
            1594     1               
            1595     1                       ! if cloud ice < 0, borrow from snow
            1596     2   m    s              if (qi (k) .lt. 0.) then
            1597     2   s    s                  sink = min (- qi (k), max (0., qs (k)))
            1598     2   si   s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            1599     2                               0., 0., 0., sink, - sink, 0.)
            1600     2   p    v              endif
            1601     1               
            1602     1                       ! if snow < 0, borrow from graupel
            1603     2   s    s              if (qs (k) .lt. 0.) then
            1604     2   s    s                  sink = min (- qs (k), max (0., qg (k)))
            1605     2   si   s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            1606     2                               0., 0., 0., 0., sink, - sink)
            1607     2   p    v              endif
            1608     1               
            1609     1                       ! if graupel < 0, borrow from rain
            1610     2   s    s              if (qg (k) .lt. 0.) then
            1611     2   s    s                  sink = min (- qg (k), max (0., qr (k)))
            1612     2   s    s                  call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            1613     2                               0., 0., - sink, 0., 0., sink, te8 (k), cvm (k), tz (k), &
            1614     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            1615     2   p    v              endif
            1616     1               
            1617     1                       ! -----------------------------------------------------------------------
            1618     1                       ! fix negative liquid-phase hydrometeors
            1619     1                       ! -----------------------------------------------------------------------
            1620     1               
            1621     1                       ! if rain < 0, borrow from cloud water
            1622     2   s    s              if (qr (k) .lt. 0.) then
            1623     2   s    s                  sink = min (- qr (k), max (0., ql (k)))
            1624     2   si   s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            1625     2                               0., - sink, sink, 0., 0., 0.)
            1626     2   p    v              endif
            1627     1               
            1628     1                       ! if cloud water < 0, borrow from water vapor
            1629     2   s    s              if (ql (k) .lt. 0.) then
            1630     2   s    s                  sink = min (- ql (k), max (0., qv (k)))
            1631     2   m    m                  cond = cond + sink * dp (k)
            1632     2   s    s                  call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            1633     2                                - sink, sink, 0., 0., 0., 0., te8 (k), cvm (k), tz (k), &
            1634     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            1635     2   p    v              endif
            1636     1               
            1637     1   p    v          enddo
            1638                     
            1639                         ! -----------------------------------------------------------------------
            1640                         ! fix negative water vapor
            1641                         ! -----------------------------------------------------------------------
            1642                     
            1643                         ! if water vapor < 0, borrow water vapor from below
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv
                                   <<< Loop-information  End >>>
            1644     1   s   2s          do k = ks, ke - 1
            1645     2   s   2m              if (qv (k) .lt. 0.) then
            1646     2   s   2s                  qv (k + 1) = qv (k + 1) + qv (k) * dp (k) / dp (k + 1)
            1647     2   s   2v                  qv (k) = 0.
            1648     2   s   2v              endif
            1649     1   s   2v          enddo
            1650                     
            1651                         ! if water vapor < 0, borrow water vapor from above
            1652     1                   if (qv (ke) .lt. 0. .and. qv (ke - 1) .gt. 0.) then
            1653     1                       dq = min (- qv (ke) * dp (ke), qv (ke - 1) * dp (ke - 1))
            1654     1                       qv (ke - 1) = qv (ke - 1) - dq / dp (ke - 1)
            1655     1                       qv (ke) = qv (ke) + dq / dp (ke)
            1656     1                   endif
            1657                     
            1658                     end subroutine neg_adj
            1659                     
            1660                     ! =======================================================================
            1661                     ! full microphysics loop
            1662                     ! =======================================================================
            1663                     
            1664                     subroutine mp_full (ks, ke, ntimes, tz, qv, ql, qr, qi, qs, qg, dp, dz, rhc, u, v, w, &
            1665                             den, denfac, ccn, cin, dts, rh_adj, rh_rain, h_var, dte, water, rain, ice, &
            1666                             snow, graupel, prefluxw, prefluxr, prefluxi, prefluxs, prefluxg, &
            1667                             condensation, deposition, evaporation, sublimation, convt)
            1668                     
            1669                         implicit none
            1670                     
            1671                         ! -----------------------------------------------------------------------
            1672                         ! input / output arguments
            1673                         ! -----------------------------------------------------------------------
            1674                     
            1675                         integer, intent (in) :: ks, ke, ntimes
            1676                     
            1677                         real, intent (in) :: dts, rh_adj, rh_rain, h_var, convt
            1678                     
            1679                         real, intent (in), dimension (ks:ke) :: dp, dz, den, denfac, ccn
            1680                         real, intent (in), dimension (ks:ke) :: rhc
            1681                     
            1682                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, u, v, w, cin
            1683                         real, intent (inout), dimension (ks:ke) :: prefluxw, prefluxr, prefluxi, prefluxs, prefluxg
            1684                     
            1685                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1686                     
            1687                         real, intent (inout) :: water, rain, ice, snow, graupel
            1688                         real, intent (inout) :: condensation, deposition
            1689                         real, intent (inout) :: evaporation, sublimation
            1690                     
            1691                         real (kind = r8), intent (inout) :: dte
            1692                     
            1693                         ! -----------------------------------------------------------------------
            1694                         ! local variables
            1695                         ! -----------------------------------------------------------------------
            1696                     
            1697                         integer :: n
            1698                     
            1699                         real :: w1, r1, i1, s1, g1, cond, dep, reevap, sub
            1700                     
            1701                         real, dimension (ks:ke) :: vtw, vtr, vti, vts, vtg, pfw, pfr, pfi, pfs, pfg
            1702                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfg, prefluxg, pfs, prefluxs, pfi
                                   <<<      prefluxi, pfr, prefluxr, pfw, prefluxw
                                   <<< Loop-information  End >>>
            1703     1                   do n = 1, ntimes
            1704     1               
            1705     1                       ! -----------------------------------------------------------------------
            1706     1                       ! sedimentation of cloud ice, snow, graupel or hail, and rain
            1707     1                       ! -----------------------------------------------------------------------
            1708     1               
            1709     1                       call sedimentation (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, &
            1710     1                           dz, dp, vtw, vtr, vti, vts, vtg, w1, r1, i1, s1, g1, pfw, pfr, pfi, pfs, pfg, &
            1711     1                           u, v, w, den, denfac, dte)
            1712     1               
            1713     1                       water = water + w1 * convt
            1714     1                       rain = rain + r1 * convt
            1715     1                       ice = ice + i1 * convt
            1716     1                       snow = snow + s1 * convt
            1717     1                       graupel = graupel + g1 * convt
            1718     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 272
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 48, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfg, prefluxg, pfs, prefluxs, pfi
                                   <<<      prefluxi, pfr, prefluxr, pfw, prefluxw
                                   <<< Loop-information  End >>>
            1719     1  pp    v              prefluxw = prefluxw + pfw * convt
            1720     1   p    v              prefluxr = prefluxr + pfr * convt
            1721     1   p    v              prefluxi = prefluxi + pfi * convt
            1722     1   p    v              prefluxs = prefluxs + pfs * convt
            1723     1   p    v              prefluxg = prefluxg + pfg * convt
            1724     1               
            1725     1                       ! -----------------------------------------------------------------------
            1726     1                       ! warm rain cloud microphysics
            1727     1                       ! -----------------------------------------------------------------------
            1728     1               
            1729     1    i                  call warm_rain (dts, ks, ke, dp, dz, tz, qv, ql, qr, qi, qs, qg, &
            1730     1                           den, denfac, vtw, vtr, ccn, rh_rain, h_var, reevap)
            1731     1               
            1732     1                       evaporation = evaporation + reevap * convt
            1733     1               
            1734     1                       ! -----------------------------------------------------------------------
            1735     1                       ! ice cloud microphysics
            1736     1                       ! -----------------------------------------------------------------------
            1737     1               
            1738     1                       call ice_cloud (ks, ke, tz, qv, ql, qr, qi, qs, qg, den, &
            1739     1                           denfac, vtw, vtr, vti, vts, vtg, dts, h_var)
            1740     1               
            1741     1                       ! -----------------------------------------------------------------------
            1742     1                       ! temperature sentive high vertical resolution processes
            1743     1                       ! -----------------------------------------------------------------------
            1744     1               
            1745     1                       call subgrid_z_proc (ks, ke, den, denfac, dts, rh_adj, tz, qv, ql, &
            1746     1                           qr, qi, qs, qg, dp, ccn, cin, cond, dep, reevap, sub, rhc)
            1747     1               
            1748     1                       condensation = condensation + cond * convt
            1749     1                       deposition = deposition + dep * convt
            1750     1                       evaporation = evaporation + reevap * convt
            1751     1                       sublimation = sublimation + sub * convt
            1752     1               
            1753     1                   enddo
            1754                     
            1755                     end subroutine mp_full
            1756                     
            1757                     ! =======================================================================
            1758                     ! fast microphysics loop
            1759                     ! =======================================================================
            1760                     
            1761                     subroutine mp_fast (ks, ke, tz, qv, ql, qr, qi, qs, qg, dtm, dp, den, rhc, &
            1762                             ccn, cin, condensation, deposition, evaporation, sublimation, convt)
            1763                     
            1764                         implicit none
            1765                     
            1766                         ! -----------------------------------------------------------------------
            1767                         ! input / output arguments
            1768                         ! -----------------------------------------------------------------------
            1769                     
            1770                         integer, intent (in) :: ks, ke
            1771                     
            1772                         real, intent (in) :: dtm, convt
            1773                     
            1774                         real, intent (in), dimension (ks:ke) :: dp, den, ccn
            1775                         real, intent (in), dimension (ks:ke) :: rhc
            1776                     
            1777                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, cin
            1778                     
            1779                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1780                     
            1781                         real, intent (inout) :: condensation, deposition
            1782                         real, intent (inout) :: evaporation, sublimation
            1783                     
            1784                         ! -----------------------------------------------------------------------
            1785                         ! local variables
            1786                         ! -----------------------------------------------------------------------
            1787                     
            1788                         real :: cond, dep, reevap, sub
            1789                     
            1790                         real, dimension (ks:ke) :: q_liq, q_sol, lcpk, icpk, tcpk, tcp3
            1791                     
            1792                         real (kind = r8), dimension (ks:ke) :: cvm, te8
            1793                     
            1794                         ! -----------------------------------------------------------------------
            1795                         ! initialization
            1796                         ! -----------------------------------------------------------------------
            1797                     
            1798                         cond = 0
            1799                         dep = 0
            1800                         reevap = 0
            1801                         sub = 0
            1802                     
            1803                         ! -----------------------------------------------------------------------
            1804                         ! calculate heat capacities and latent heat coefficients
            1805                         ! -----------------------------------------------------------------------
            1806                     
            1807                         call cal_mhc_lhc (ks, ke, qv, ql, qr, qi, qs, qg, q_liq, q_sol, cvm, te8, tz, &
            1808                             lcpk, icpk, tcpk, tcp3)
            1809                     
            1810     1                   if (.not. do_warm_rain_mp) then
            1811     1               
            1812     1                       ! -----------------------------------------------------------------------
            1813     1                       ! cloud ice melting to form cloud water and rain
            1814     1                       ! -----------------------------------------------------------------------
            1815     1               
            1816     1                       call pimlt (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, cvm, te8, &
            1817     1                           lcpk, icpk, tcpk, tcp3)
            1818     1               
            1819     1                       ! -----------------------------------------------------------------------
            1820     1                       ! enforce complete freezing below t_wfr
            1821     1                       ! -----------------------------------------------------------------------
            1822     1               
            1823     1    i                  call pcomp (ks, ke, qv, ql, qr, qi, qs, qg, tz, cvm, te8, &
            1824     1                           lcpk, icpk, tcpk, tcp3)
            1825     1               
            1826     1                   endif
            1827                     
            1828                         ! -----------------------------------------------------------------------
            1829                         ! cloud water condensation and evaporation
            1830                         ! -----------------------------------------------------------------------
            1831                     
            1832                         call pcond_pevap (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            1833                             lcpk, icpk, tcpk, tcp3, cond, reevap, rhc)
            1834                     
            1835                         condensation = condensation + cond * convt
            1836                         evaporation = evaporation + reevap * convt
            1837                     
            1838     1                   if (.not. do_warm_rain_mp) then
            1839     1               
            1840     1                       ! -----------------------------------------------------------------------
            1841     1                       ! cloud water freezing to form cloud ice and snow
            1842     1                       ! -----------------------------------------------------------------------
            1843     1               
            1844     1                       call pifr (ks, ke, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, &
            1845     1                           lcpk, icpk, tcpk, tcp3)
            1846     1               
            1847     1                       ! -----------------------------------------------------------------------
            1848     1                       ! Wegener Bergeron Findeisen process
            1849     1                       ! -----------------------------------------------------------------------
            1850     1               
            1851     1                       call pwbf (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, &
            1852     1                           lcpk, icpk, tcpk, tcp3)
            1853     1               
            1854     1                       ! -----------------------------------------------------------------------
            1855     1                       ! Bigg freezing mechanism
            1856     1                       ! -----------------------------------------------------------------------
            1857     1               
            1858     1    i                  call pbigg (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, cvm, te8, ccn, &
            1859     1                           lcpk, icpk, tcpk, tcp3)
            1860     1               
            1861     1                       ! -----------------------------------------------------------------------
            1862     1                       ! rain freezing to form graupel
            1863     1                       ! -----------------------------------------------------------------------
            1864     1               
            1865     1    i                  call pgfr_simp (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, cvm, te8, &
            1866     1                           lcpk, icpk, tcpk, tcp3)
            1867     1               
            1868     1                       ! -----------------------------------------------------------------------
            1869     1                       ! snow melting to form cloud water and rain
            1870     1                       ! -----------------------------------------------------------------------
            1871     1               
            1872     1                       call psmlt_simp (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, cvm, te8, &
            1873     1                           lcpk, icpk, tcpk, tcp3)
            1874     1               
            1875     1                   endif
            1876                     
            1877                         ! -----------------------------------------------------------------------
            1878                         ! cloud water to rain autoconversion
            1879                         ! -----------------------------------------------------------------------
            1880                     
            1881          i              call praut_simp (ks, ke, dtm, tz, qv, ql, qr, qi, qs, qg)
            1882                     
            1883     1                   if (.not. do_warm_rain_mp) then
            1884     1               
            1885     1                       ! -----------------------------------------------------------------------
            1886     1                       ! cloud ice deposition and sublimation
            1887     1                       ! -----------------------------------------------------------------------
            1888     1               
            1889     1                       call pidep_pisub (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            1890     1                           lcpk, icpk, tcpk, tcp3, cin, dep, sub)
            1891     1               
            1892     1                       deposition = deposition + dep * convt
            1893     1                       sublimation = sublimation + sub * convt
            1894     1               
            1895     1                       ! -----------------------------------------------------------------------
            1896     1                       ! cloud ice to snow autoconversion
            1897     1                       ! -----------------------------------------------------------------------
            1898     1               
            1899     1    i                  call psaut_simp (ks, ke, dtm, qv, ql, qr, qi, qs, qg, tz, den)
            1900     1               
            1901     1                   endif
            1902                     
            1903                     end subroutine mp_fast
            1904                     
            1905                     ! =======================================================================
            1906                     ! sedimentation of cloud ice, snow, graupel or hail, and rain
            1907                     ! =======================================================================
            1908                     
            1909                     subroutine sedimentation (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, &
            1910                             vtw, vtr, vti, vts, vtg, w1, r1, i1, s1, g1, pfw, pfr, pfi, pfs, pfg, &
            1911                             u, v, w, den, denfac, dte)
            1912                     
            1913                         implicit none
            1914                     
            1915                         ! -----------------------------------------------------------------------
            1916                         ! input / output arguments
            1917                         ! -----------------------------------------------------------------------
            1918                     
            1919                         integer, intent (in) :: ks, ke
            1920                     
            1921                         real, intent (in) :: dts
            1922                     
            1923                         real, intent (in), dimension (ks:ke) :: dp, dz, den, denfac
            1924                     
            1925                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, u, v, w
            1926                     
            1927                         real, intent (out) :: w1, r1, i1, s1, g1
            1928                     
            1929                         real, intent (out), dimension (ks:ke) :: vtw, vtr, vti, vts, vtg, pfw, pfr, pfi, pfs, pfg
            1930                     
            1931                         real (kind = r8), intent (inout) :: dte
            1932                     
            1933                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            1934                     
            1935                         ! -----------------------------------------------------------------------
            1936                         ! local variables
            1937                         ! -----------------------------------------------------------------------
            1938                     
            1939                         integer :: k
            1940                     
            1941                         real, dimension (ks:ke) :: q_liq, q_sol, lcpk, icpk, tcpk, tcp3
            1942                     
            1943                         real (kind = r8), dimension (ks:ke) :: te8, cvm
            1944                     
            1945                         w1 = 0.
            1946                         r1 = 0.
            1947                         i1 = 0.
            1948                         s1 = 0.
            1949                         g1 = 0.
            1950                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfg, pfs, pfi, pfr, pfw, vtg, vts, vti
                                   <<<      vtr, vtw
                                   <<< Loop-information  End >>>
            1951        pp    v          vtw = 0.
            1952         p    v          vtr = 0.
            1953         p    v          vti = 0.
            1954         p    v          vts = 0.
            1955         p    v          vtg = 0.
            1956                     
            1957         p    v          pfw = 0.
            1958         p    v          pfr = 0.
            1959         p    v          pfi = 0.
            1960         p    v          pfs = 0.
            1961         p    v          pfg = 0.
            1962                     
            1963                         ! -----------------------------------------------------------------------
            1964                         ! calculate heat capacities and latent heat coefficients
            1965                         ! -----------------------------------------------------------------------
            1966                     
            1967                         call cal_mhc_lhc (ks, ke, qv, ql, qr, qi, qs, qg, q_liq, q_sol, cvm, te8, tz, &
            1968                             lcpk, icpk, tcpk, tcp3)
            1969                     
            1970                         ! -----------------------------------------------------------------------
            1971                         ! terminal fall and melting of falling cloud ice into rain
            1972                         ! -----------------------------------------------------------------------
            1973                     
            1974     1                   if (do_psd_ice_fall) then
            1975     1                       call term_rsg (ks, ke, qi, den, denfac, vi_fac, vconi, blini, normi, expoi, mui, vi_max, const_vi, vti)
            1976     1                   else
            1977     1                       call term_ice (ks, ke, tz, qi, den, vi_fac, vi_max, const_vi, vti)
            1978     1                   endif
            1979                     
            1980     1                   if (do_sedi_melt) then
            1981     1                       call sedi_melt (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, &
            1982     1                           vti, r1, tau_imlt, cvm, icpk, "qi")
            1983     1                   endif
            1984                     
            1985                         call terminal_fall (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, den, &
            1986                             vti, i1, pfi, u, v, w, dte, "qi")
            1987                     
            1988                         pfi (ks) = max (0.0, pfi (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfi
                                   <<< Loop-information  End >>>
            1989     1  pp   2v          do k = ke, ks + 1, -1
            1990     1   p   2v              pfi (k) = max (0.0, pfi (k) - pfi (k - 1))
            1991     1   p   2v          enddo
            1992                     
            1993                         ! -----------------------------------------------------------------------
            1994                         ! terminal fall and melting of falling snow into rain
            1995                         ! -----------------------------------------------------------------------
            1996                     
            1997                         call term_rsg (ks, ke, qs, den, denfac, vs_fac, vcons, blins, norms, expos, mus, vs_max, const_vs, vts)
            1998                     
            1999     1                   if (do_sedi_melt) then
            2000     1                       call sedi_melt (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, &
            2001     1                           vts, r1, tau_smlt, cvm, icpk, "qs")
            2002     1                   endif
            2003                     
            2004                         call terminal_fall (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, den, &
            2005                             vts, s1, pfs, u, v, w, dte, "qs")
            2006                     
            2007                         pfs (ks) = max (0.0, pfs (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfs
                                   <<< Loop-information  End >>>
            2008     1  pp   2v          do k = ke, ks + 1, -1
            2009     1   p   2v              pfs (k) = max (0.0, pfs (k) - pfs (k - 1))
            2010     1   p   2v          enddo
            2011                     
            2012                         ! -----------------------------------------------------------------------
            2013                         ! terminal fall and melting of falling graupel into rain
            2014                         ! -----------------------------------------------------------------------
            2015                     
            2016     1                   if (do_hail) then
            2017     1                       call term_rsg (ks, ke, qg, den, denfac, vg_fac, vconh, blinh, normh, expoh, muh, vg_max, const_vg, vtg)
            2018     1                   else
            2019     1                       call term_rsg (ks, ke, qg, den, denfac, vg_fac, vcong, bling, normg, expog, mug, vg_max, const_vg, vtg)
            2020     1                   endif
            2021                     
            2022     1                   if (do_sedi_melt) then
            2023     1                       call sedi_melt (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, &
            2024     1                           vtg, r1, tau_gmlt, cvm, icpk, "qg")
            2025     1                   endif
            2026                     
            2027                         call terminal_fall (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, den, &
            2028                             vtg, g1, pfg, u, v, w, dte, "qg")
            2029                     
            2030                         pfg (ks) = max (0.0, pfg (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfg
                                   <<< Loop-information  End >>>
            2031     1  pp   2v          do k = ke, ks + 1, -1
            2032     1   p   2v              pfg (k) = max (0.0, pfg (k) - pfg (k - 1))
            2033     1   p   2v          enddo
            2034                     
            2035                         ! -----------------------------------------------------------------------
            2036                         ! terminal fall of cloud water
            2037                         ! -----------------------------------------------------------------------
            2038                     
            2039     1                   if (do_psd_water_fall) then
            2040     1               
            2041     1                       call term_rsg (ks, ke, ql, den, denfac, vw_fac, vconw, blinw, normw, expow, muw, vw_max, const_vw, vtw)
            2042     1               
            2043     1                       call terminal_fall (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, den, &
            2044     1                           vtw, w1, pfw, u, v, w, dte, "ql")
            2045     1               
            2046     1                       pfw (ks) = max (0.0, pfw (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfw
                                   <<< Loop-information  End >>>
            2047     2  pp   2v              do k = ke, ks + 1, -1
            2048     2   p   2v                  pfw (k) = max (0.0, pfw (k) - pfw (k - 1))
            2049     2   p   2v              enddo
            2050     1               
            2051     1                   endif
            2052                     
            2053                         ! -----------------------------------------------------------------------
            2054                         ! terminal fall of rain
            2055                         ! -----------------------------------------------------------------------
            2056                     
            2057                         call term_rsg (ks, ke, qr, den, denfac, vr_fac, vconr, blinr, normr, expor, mur, vr_max, const_vr, vtr)
            2058                     
            2059                         call terminal_fall (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, den, &
            2060                             vtr, r1, pfr, u, v, w, dte, "qr")
            2061                     
            2062                         pfr (ks) = max (0.0, pfr (ks))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pfr
                                   <<< Loop-information  End >>>
            2063     1  pp   2v          do k = ke, ks + 1, -1
            2064     1   p   2v              pfr (k) = max (0.0, pfr (k) - pfr (k - 1))
            2065     1   p   2v          enddo
            2066                     
            2067                     end subroutine sedimentation
            2068                     
            2069                     ! =======================================================================
            2070                     ! terminal velocity for cloud ice
            2071                     ! =======================================================================
            2072                     
            2073                     subroutine term_ice (ks, ke, tz, q, den, v_fac, v_max, const_v, vt)
            2074                     
            2075                         implicit none
            2076                     
            2077                         ! -----------------------------------------------------------------------
            2078                         ! input / output arguments
            2079                         ! -----------------------------------------------------------------------
            2080                     
            2081                         integer, intent (in) :: ks, ke
            2082                     
            2083                         logical, intent (in) :: const_v
            2084                     
            2085                         real, intent (in) :: v_fac, v_max
            2086                     
            2087                         real, intent (in), dimension (ks:ke) :: q, den
            2088                     
            2089                         real (kind = r8), intent (in), dimension (ks:ke) :: tz
            2090                     
            2091                         real, intent (out), dimension (ks:ke) :: vt
            2092                     
            2093                         ! -----------------------------------------------------------------------
            2094                         ! local variables
            2095                         ! -----------------------------------------------------------------------
            2096                     
            2097                         integer :: k
            2098                     
            2099                         real :: qden
            2100                     
            2101                         real, parameter :: aa = - 4.14122e-5
            2102                         real, parameter :: bb = - 0.00538922
            2103                         real, parameter :: cc = - 0.0516344
            2104                         real, parameter :: dd = 0.00216078
            2105                         real, parameter :: ee = 1.9714
            2106                     
            2107                         real, dimension (ks:ke) :: tc
            2108                     
            2109     1                   if (const_v) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt
                                   <<< Loop-information  End >>>
            2110     1  pp   4v              vt (:) = v_fac
            2111     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 381
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.02, ITR: 64, MVE: 4, POL: L)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, vt, tc, q, den
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 32
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2112     2  pp    v              do k = ks, ke
            2113     2   p    v                  qden = q (k) * den (k)
            2114     3   p    v                  if (q (k) .lt. qfmin) then
            2115     3   p    v                      vt (k) = 0.0
            2116     3   p    v                  else
            2117     3   p    v                      tc (k) = tz (k) - tice
            2118     4   p    v                      if (ifflag .eq. 1) then
            2119     4   p    v                          vt (k) = (3. + log10 (qden)) * (tc (k) * (aa * tc (k) + bb) + cc) + &
            2120     4                                       dd * tc (k) + ee
            2121     4   p    v                          vt (k) = 0.01 * v_fac * exp (vt (k) * log (10.))
            2122     4   p    v                      endif
            2123     3   p    v                      if (ifflag .eq. 2) &
            2124     3                                   vt (k) = v_fac * 3.29 * exp (0.16 * log (qden))
            2125     3   p    v                      vt (k) = min (v_max, max (0.0, vt (k)))
            2126     3   p    v                  endif
            2127     2   p    v              enddo
            2128     1                   endif
            2129                     
            2130                     end subroutine term_ice
            2131                     
            2132                     ! =======================================================================
            2133                     ! terminal velocity for rain, snow, and graupel, Lin et al. (1983)
            2134                     ! =======================================================================
            2135                     
            2136                     subroutine term_rsg (ks, ke, q, den, denfac, v_fac, vcon, blin, norm, expo, mu, v_max, const_v, vt)
            2137                     
            2138                         implicit none
            2139                     
            2140                         ! -----------------------------------------------------------------------
            2141                         ! input / output arguments
            2142                         ! -----------------------------------------------------------------------
            2143                     
            2144                         integer, intent (in) :: ks, ke
            2145                     
            2146                         logical, intent (in) :: const_v
            2147                     
            2148                         real, intent (in) :: v_fac, blin, v_max, mu
            2149                     
            2150                         real (kind = r8), intent (in) :: vcon, norm, expo
            2151                     
            2152                         real, intent (in), dimension (ks:ke) :: q, den, denfac
            2153                     
            2154                         real, intent (out), dimension (ks:ke) :: vt
            2155                     
            2156                         ! -----------------------------------------------------------------------
            2157                         ! local variables
            2158                         ! -----------------------------------------------------------------------
            2159                     
            2160                         integer :: k
            2161                     
            2162                         real :: qden
            2163                     
            2164     1                   if (const_v) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt
                                   <<< Loop-information  End >>>
            2165     1  pp   4v              vt (:) = v_fac
            2166     1                   else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, den, denfac, vt
                                   <<< Loop-information  End >>>
            2167     2  pp    v              do k = ks, ke
            2168     2   p    v                  qden = q (k) * den (k)
            2169     3   p    v                  if (q (k) .lt. qfmin) then
            2170     3   p    v                      vt (k) = 0.0
            2171     3   p    v                  else
            2172     3   p    v                      vt (k) = v_fac * vcon * denfac (k) * exp (1. / (mu + 3) * blin * log (6 * qden / norm)) * &
            2173     3                                   exp (- blin * log (expo))
            2174     3   p    v                      vt (k) = min (v_max, max (0.0, vt (k)))
            2175     3   p    v                  endif
            2176     2   p    v              enddo
            2177     1                   endif
            2178                     
            2179                     end subroutine term_rsg
            2180                     
            2181                     ! =======================================================================
            2182                     ! melting during sedimentation
            2183                     ! =======================================================================
            2184                     
            2185                     subroutine sedi_melt (dts, ks, ke, tz, qv, ql, qr, qi, qs, qg, dz, dp, &
            2186                             vt, r1, tau_mlt, cvm, icpk, qflag)
            2187                     
            2188                         implicit none
            2189                     
            2190                         ! -----------------------------------------------------------------------
            2191                         ! input / output arguments
            2192                         ! -----------------------------------------------------------------------
            2193                     
            2194                         integer, intent (in) :: ks, ke
            2195                     
            2196                         real, intent (in) :: dts, tau_mlt
            2197                     
            2198                         real, intent (in), dimension (ks:ke) :: vt, dp, dz, icpk
            2199                     
            2200                         real (kind = r8), intent (in), dimension (ks:ke) :: cvm
            2201                     
            2202                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            2203                     
            2204                         real, intent (inout) :: r1
            2205                     
            2206                         real (kind = r8), intent (inout), dimension (ks:ke) :: tz
            2207                     
            2208                         character (len = 2), intent (in) :: qflag
            2209                     
            2210                         ! -----------------------------------------------------------------------
            2211                         ! local variables
            2212                         ! -----------------------------------------------------------------------
            2213                     
            2214                         integer :: k, m
            2215                     
            2216                         real :: dtime, sink, zs
            2217                     
            2218                         real, dimension (ks:ke) :: q
            2219                     
            2220                         real, dimension (ks:ke + 1) :: ze, zt
            2221                     
            2222                         call zezt (ks, ke, dts, zs, dz, vt, ze, zt)
            2223                     
            2224     1                   select case (qflag)
            2225     1                       case ("qi")
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qi, q
                                   <<< Loop-information  End >>>
            2226     1  pp   4v                  q = qi
            2227     1                       case ("qs")
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs, q
                                   <<< Loop-information  End >>>
            2228     1  pp   4v                  q = qs
            2229     1                       case ("qg")
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg, q
                                   <<< Loop-information  End >>>
            2230     1  pp   4v                  q = qg
            2231     1                       case default
            2232     1                           print *, "gfdl_mp: qflag error!"
            2233     1                   end select
            2234                     
            2235                         ! -----------------------------------------------------------------------
            2236                         ! melting to rain
            2237                         ! -----------------------------------------------------------------------
            2238                     
            2239     1                   do k = ke - 1, ks, - 1
            2240     1                       if (vt (k) .lt. 1.e-10) cycle
            2241     2                       if (q (k) .gt. qcmin) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 13
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2242     3                           do m = k + 1, ke
            2243     3                               if (zt (k + 1) .ge. ze (m)) exit
            2244     4                               if (zt (k) .lt. ze (m + 1) .and. tz (m) .gt. tice) then
            2245     4                                   dtime = min (dts, (ze (m) - ze (m + 1)) / vt (k))
            2246     4                                   dtime = min (1.0, dtime / tau_mlt)
            2247     4                                   sink = min (q (k) * dp (k) / dp (m), dtime * (tz (m) - tice) / icpk (m))
            2248     4                                   q (k) = q (k) - sink * dp (m) / dp (k)
            2249     5                                   if (zt (k) .lt. zs) then
            2250     5                                       r1 = r1 + sink * dp (m)
            2251     5                                   else
            2252     5                                       qr (m) = qr (m) + sink
            2253     5                                   endif
            2254     5                                   select case (qflag)
            2255     5                                       case ("qi")
            2256     5                                           qi (k) = q (k)
            2257     5                                       case ("qs")
            2258     5                                           qs (k) = q (k)
            2259     5                                       case ("qg")
            2260     5                                           qg (k) = q (k)
            2261     5                                       case default
            2262     5                                           print *, "gfdl_mp: qflag error!"
            2263     5                                   end select
            2264     4    i                              tz (m) = (tz (m) * cvm (m) - li00 * sink) / &
            2265     4                                       mhc (qv (k), ql (m), qr (m), qi (m), qs (m), qg (m))
            2266     4                               endif
            2267     3                               if (q (k) .lt. qcmin) exit
            2268     3                           enddo
            2269     2                       endif
            2270     1                   enddo
            2271                     
            2272                     end subroutine sedi_melt

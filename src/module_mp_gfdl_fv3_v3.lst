            7479                     ! =======================================================================
            7480                     ! compute the saturated specific humidity, core function
            7481                     ! =======================================================================
            7482                     
            7483                     function qs_core (length, tk, den, dqdt, table, des)
            7484                     
            7485                         implicit none
            7486                     
            7487                         real :: qs_core
            7488                     
            7489                         ! -----------------------------------------------------------------------
            7490                         ! input / output arguments
            7491                         ! -----------------------------------------------------------------------
            7492                     
            7493                         integer, intent (in) :: length
            7494                     
            7495                         real, intent (in) :: tk, den
            7496                     
            7497                         real, intent (in), dimension (length) :: table, des
            7498                     
            7499                         real, intent (out) :: dqdt
            7500                     
            7501                         ! -----------------------------------------------------------------------
            7502                         ! local variables
            7503                         ! -----------------------------------------------------------------------
            7504                     
            7505                         integer :: it
            7506                     
            7507                         real :: es, ap1, tmin
            7508                     
            7509                         if (.not. tables_are_initialized) call qs_init
            7510                     
            7511                         tmin = tice - 160.
            7512                         ap1 = 10. * dim (tk, tmin) + 1.
            7513                         ap1 = min (2621., ap1)
            7514                         it = ap1
            7515                         es = table (it) + (ap1 - it) * des (it)
            7516                         qs_core = es / (rvgas * tk * den)
            7517                         it = ap1 - 0.5
            7518                         dqdt = 10. * (des (it) + (ap1 - it) * (des (it + 1) - des (it))) / (rvgas * tk * den)
            7519                     
            7520                     end function qs_core
            7521                     

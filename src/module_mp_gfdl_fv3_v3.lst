            6170                     ! =======================================================================
            6171                     ! cloud radii diagnosis built for gfdl cloud microphysics
            6172                     ! =======================================================================
            6173                     
            6174                     subroutine cloud_diagnosis_v3                                                   &
            6175                           ( is, ie, ks, ke, lsm, p, delp, t, &
            6176                             qw, qi, qr, qs, qg, qa, &
            6177                             rew, rei, rer, res, reg, snowd )
            6178                     
            6179                         implicit none
            6180                     
            6181                         ! -----------------------------------------------------------------------
            6182                         ! input / output arguments
            6183                         ! -----------------------------------------------------------------------
            6184                     

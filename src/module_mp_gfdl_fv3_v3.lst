            3983                     
            3984                         integer :: k
            3985                     
            3986                         real :: tc, sink
            3987                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 19
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3988     1   s    s          do k = ks, ke
            3989     1               
            3990     1   s    s              tc = t_wfr - tz (k)
            3991     1               
            3992     2   s    s              if (tc .gt. 0. .and. ql (k) .gt. qcmin) then
            3993     2               
            3994     2   s    s                  sink = ql (k) * tc / dt_fr
            3995     2   s    s                  sink = min (ql (k), sink, tc / icpk (k))
            3996     2               
            3997     2   s    s                  call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3998     2                               0., - sink, 0., sink, 0., 0., te8 (k), cvm (k), tz (k), &
            3999     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            4000     2               
            4001     2   s    s              endif
            4002     1               
            4003     1   s    s          enddo
            4004                     
            4005                     end subroutine pcomp
            4006                     
            4007                     ! =======================================================================
            4008                     ! Wegener Bergeron Findeisen process, Storelvmo and Tan (2015)
            4009                     ! =======================================================================
            4010                     
            4011                     subroutine pwbf (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, lcpk, icpk, tcpk, tcp3)
            4012                     
            4013                         implicit none
            4014                     
            4015                         ! -----------------------------------------------------------------------
            4016                         ! input / output arguments
            4017                         ! -----------------------------------------------------------------------
            4018                     
            4019                         integer, intent (in) :: ks, ke
            4020                     
            4021                         real, intent (in) :: dts
            4022                     
            4023                         real, intent (in), dimension (ks:ke) :: den
            4024                     
            4025                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            4026                     
            4027                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4028                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            4029                     
            4030                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            4031                     
            4032                         ! -----------------------------------------------------------------------
            4033                         ! local variables
            4034                         ! -----------------------------------------------------------------------
            4035                     
            4036                         integer :: k
            4037                     
            4038                         real :: tc, tin, sink, dqdt, qsw, qsi, qim, tmp, fac_wbf
            4039                     
            4040                         if (.not. do_wbf) return
            4041                     
            4042                         fac_wbf = 1. - exp (- dts / tau_wbf)
            4043                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz, den
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 16
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4044     1                   do k = ks, ke
            4045     1               
            4046     1                       tc = tice - tz (k)
            4047     1               
            4048     1                       tin = tz (k)
            4049     1    i                  qsw = wqs (tin, den (k), dqdt)
            4050     1    i                  qsi = iqs (tin, den (k), dqdt)
            4051     1               
            4052     2                       if (tc .gt. 0. .and. ql (k) .gt. qcmin .and. qi (k) .gt. qcmin .and. &
            4053     2               			qv (k) .gt. qsi .and. qv (k) .lt. qsw) then
            4054     2               
            4055     2                           sink = min (fac_wbf * ql (k), tc / icpk (k))
            4056     2                           qim = qi0_crt / den (k)
            4057     2                           tmp = min (sink, dim (qim, qi (k)))
            4058     2               
            4059     2                           call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            4060     2                               0., - sink, 0., tmp, sink - tmp, 0., te8 (k), cvm (k), tz (k), &
            4061     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            4062     2               
            4063     2                       endif
            4064     1               
            4065     1                   enddo
            4066                     
            4067                     end subroutine pwbf
            4068                     
            4069                     ! =======================================================================
            4070                     ! Bigg freezing mechanism, Bigg (1953)
            4071                     ! =======================================================================
            4072                     
            4073                     subroutine pbigg (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, ccn, lcpk, icpk, tcpk, tcp3)
            4074                     
            4075                         implicit none
            4076                     
            4077                         ! -----------------------------------------------------------------------
            4078                         ! input / output arguments
            4079                         ! -----------------------------------------------------------------------
            4080                     
            4081                         integer, intent (in) :: ks, ke
            4082                     
            4083                         real, intent (in) :: dts
            4084                     
            4085                         real, intent (in), dimension (ks:ke) :: ccn
            4086                     
            4087                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            4088                     
            4089                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4090                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            4091                     
            4092                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            4093                     
            4094                         ! -----------------------------------------------------------------------

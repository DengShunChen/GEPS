            3668     3   s    s                  if (qr (k) .gt. qcmin) then
            3669     3   s    s                      pgacr = min (dts * acr3d (vtg (k), vtr (k), qr (k), qg (k), cgacr, acco (:, 3), &
            3670     3                                   acc (5), acc (6), den (k)), qr (k))
            3671     3   s    s                  endif
            3672     2               
            3673     2   s    s                  sink = pgacr + pgacw
            3674     2   s    s                  factor = min (sink, dim (tice, tz (k)) / icpk (k)) / max (sink, qcmin)
            3675     2   s    s                  pgacr = factor * pgacr
            3676     2   s    s                  pgacw = factor * pgacw

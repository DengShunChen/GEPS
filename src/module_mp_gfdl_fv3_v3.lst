            5257                     
            5258                     subroutine sedi_w (ks, ke, m1, w, vt, dm)
            5259                     
            5260                         implicit none
            5261                     
            5262                         ! -----------------------------------------------------------------------
            5263                         ! input / output arguments
            5264                         ! -----------------------------------------------------------------------
            5265                     
            5266                         integer, intent (in) :: ks, ke
            5267                     

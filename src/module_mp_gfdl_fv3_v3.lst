            3547     2               
            3548     2   s    s                  sink = dts * acr3d (vtg (k), vts (k), qs (k), qg (k), cgacs, acco (:, 4), &
            3549     2                               acc (7), acc (8), den (k))
            3550     2   s    s                  sink = min (fs2g_fac * qs (k), sink)
            3551     2               
            3552     2   si   s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &

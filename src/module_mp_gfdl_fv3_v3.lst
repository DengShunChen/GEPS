            7043                     
            7044                         real (kind = r8), intent (out), optional :: te_loss
            7045                     
            7046                         real (kind = r8), intent (out), dimension (ks:ke) :: te, tw
            7047                     
            7048                         ! -----------------------------------------------------------------------
            7049                         ! local variables
            7050                         ! -----------------------------------------------------------------------
            7051                     
            7052                         integer :: k
            7053                     
            7054                         real :: q_cond
            7055                     
            7056                         real (kind = r8) :: con_r8
            7057                     
            7058                         real, dimension (ks:ke) :: q_liq, q_sol
            7059                     
            7060                         real (kind = r8), dimension (ks:ke) :: cvm
            7061                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.44, ITR: 5, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q_liq, qv, ua, delp, wa, q_sol, ql, qr
                                   <<<      va, qi, qs, cvm, qg
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      tz: 2, te: 2, tw: 2
                                   <<< Loop-information  End >>>
            7062     1   s    s           do k = ks, ke
            7063     1   m    m               q_liq (k) = ql (k) + qr (k)
            7064     1   m    m               q_sol (k) = qi (k) + qs (k) + qg (k)
            7065     1   p    v               q_cond = q_liq (k) + q_sol (k)
            7066     1   p    v               con_r8 = one_r8 - (qv (k) + q_cond)
            7067     2   p    v               if (moist_q) then
            7068     2    i                       cvm (k) = mhc (con_r8, qv (k), q_liq (k), q_sol (k))
            7069     2   p    v               else
            7070     2   pi   v                   cvm (k) = mhc (qv (k), q_liq (k), q_sol (k))
            7071     2   p    v               endif
            7072     1   p    v               te (k) = (cvm (k) * tz (k) + lv00 * qv (k) - li00 * q_sol (k)) * c_air
            7073     2   p    v               if (hydrostatic) then
            7074     2                            te (k) = te (k) + 0.5 * (ua (k) ** 2 + va (k) ** 2)
            7075     2   p    v               else
            7076     2   p    v                   te (k) = te (k) + 0.5 * (ua (k) ** 2 + va (k) ** 2 + wa (k) ** 2)
            7077     2   p    v               endif
            7078     1   p    v               te (k) = rgrav * te (k) * delp (k) * gsize ** 2.0
            7079     1   p    v               tw (k) = rgrav * (qv (k) + q_cond) * delp (k) * gsize ** 2.0
            7080     1   p    v           enddo
            7081                          te_b = (dte - li00 * c_air * (ice + snow + graupel) * dts / 86400) * gsize ** 2.0
            7082                          tw_b = (water + rain + ice + snow + graupel) * dts / 86400 * gsize ** 2.0
            7083                     
            7084     1                    if (present (te_loss)) then
            7085     1                         ! total energy change due to sedimentation and its heating
            7086     1                         te_loss = dte * gsize ** 2.0
            7087     1                    endif
            7088                     
            7089                     end subroutine mtetw

            7094                     
            7095                     subroutine cal_mhc_lhc (ks, ke, qv, ql, qr, qi, qs, qg, q_liq, q_sol, &
            7096                             cvm, te8, tz, lcpk, icpk, tcpk, tcp3)
            7097                     
            7098                         implicit none
            7099                     
            7100                         ! -----------------------------------------------------------------------
            7101                         ! input / output arguments
            7102                         ! -----------------------------------------------------------------------
            7103                     
            7104                         integer, intent (in) :: ks, ke
            7105                     
            7106                         real, intent (in), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            7107                     
            7108                         real (kind = r8), intent (in), dimension (ks:ke) :: tz
            7109                     
            7110                         real, intent (out), dimension (ks:ke) :: q_liq, q_sol, lcpk, icpk, tcpk, tcp3
            7111                     
            7112                         real (kind = r8), intent (out), dimension (ks:ke) :: cvm, te8
            7113                     
            7114                         ! -----------------------------------------------------------------------
            7115                         ! local variables
            7116                         ! -----------------------------------------------------------------------
            7117                     
            7118                         integer :: k
            7119                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.95, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv, q_liq, tz, q_sol, qi, qs, ql, qr, qg
                                   <<<      cvm, te8, lcpk, icpk
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      tcpk: 2, tcp3: 2
                                   <<< Loop-information  End >>>
            7120     1   s    s          do k = ks, ke
            7121     1   m    m              q_liq (k) = ql (k) + qr (k)
            7122     1   m    m              q_sol (k) = qi (k) + qs (k) + qg (k)
            7123     1   pi   v              cvm (k) = mhc (qv (k), q_liq (k), q_sol (k))
            7124     1   p    v              te8 (k) = cvm (k) * tz (k) + lv00 * qv (k) - li00 * q_sol (k)
            7125     1   p    v              lcpk (k) = (lv00 + d1_vap * tz (k)) / cvm (k)
            7126     1   p    v              icpk (k) = (li00 + d1_ice * tz (k)) / cvm (k)
            7127     1   p    v              tcpk (k) = (li20 + (d1_vap + d1_ice) * tz (k)) / cvm (k)
            7128     1   p    v              tcp3 (k) = lcpk (k) + icpk (k) * min (1., dim (tice, tz (k)) / (tice - t_wfr))
            7129     1   p    v          enddo
            7130                     
            7131                     end subroutine cal_mhc_lhc

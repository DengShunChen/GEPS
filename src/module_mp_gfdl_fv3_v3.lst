            7834                     !-------------------------------------------------------------------
            7835                           SUBROUTINE semi_lagrange_sedim(km,dzl,wwl,rql,precip,pfsan,dt,R1)
            7836                     !-------------------------------------------------------------------
            7837                     !
            7838                     ! This routine is a semi-Lagrangain forward advection for hydrometeors
            7839                     ! with mass conservation and positive definite advection
            7840                     ! 2nd order interpolation with monotonic piecewise parabolic method is used.
            7841                     ! This routine is under assumption of decfl < 1 for semi_Lagrangian
            7842                     !
            7843                     ! km     number of layers
            7844                     ! dzl    depth of model layer in meter (m)
            7845                     ! wwl    terminal velocity at model layer (m/s)
            7846                     ! rql    dry air density*mixing ratio
            7847                     ! precip precipitation at surface (mm)
            7848                     ! pfsan  precipitation fluxes (mm?)
            7849                     ! dt     time step (s)
            7850                     ! R1     minimum q, =1.E-12 in new Thompson MP
            7851                     !
            7852                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            7853                     !         implemented by song-you hong
            7854                     ! reference: Juang, H.-M., and S.-Y. Hong, 2010: Forward semi-Lagrangian advection
            7855                     !         with mass conservation and positive definiteness for falling
            7856                     !         hydrometeors. *Mon.  Wea. Rev.*, *138*, 1778-1791
            7857                     !
            7858                           implicit none
            7859                     
            7860                           integer, intent(in) :: km
            7861                           real, intent(in) ::  dt, R1
            7862                           real, intent(in) :: dzl(km),wwl(km)
            7863                           real, intent(out) :: precip
            7864                           real, intent(inout) :: rql(km)
            7865                           real, intent(out)  :: pfsan(km)
            7866                           integer  k,m,kk,kb,kt
            7867                           real  tl,tl2,qql,dql,qqd
            7868                           real  th,th2,qqh,dqh
            7869                           real  zsum,qsum,dim,dip,con1,fa1,fa2
            7870                           real  allold, decfl
            7871                           real  dz(km), ww(km), qq(km)
            7872                           real  wi(km+1), zi(km+1), za(km+2)
            7873                           real  qn(km)
            7874                           real  dza(km+1), qa(km+1), qmi(km+1), qpi(km+1)
            7875                           real  net_flx(km)
            7876                     !
            7877                           precip = 0.0
                                   <<< Loop-information Start >>>

            3406                         ! -----------------------------------------------------------------------
            3407                         ! local variables
            3408                         ! -----------------------------------------------------------------------
            3409                     
            3410                         integer :: k
            3411                     
            3412                         real :: tc, factor, sink, qden
            3413                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 20
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3414     1   s    s          do k = ks, ke
            3415     1               
            3416     1   p    v              tc = tz (k) - tice
            3417     1               
            3418     2   m    s              if (tc .lt. 0. .and. qi (k) .gt. qcmin) then
            3419     2               
            3420     2   s    s                  sink = 0.
            3421     2   s    s                  qden = qg (k) * den (k)
            3422     3   s    s                  if (qg (k) .gt. qcmin) then
            3423     4   s    s                      if (do_new_acc_ice) then
            3424     4   m    s                          sink = dts * acr3d (vtg (k), vti (k), qi (k), qg (k), cgaci, acco (:, 10), &
            3425     4                                       acc (19), acc (20), den (k))
            3426     4   s    s                      else
            3427     5   m    s                          if (do_hail) then
            3428     5   mi   m                              factor = dts * acr2d (qden, cgaci, denfac (k), blinh, muh)
            3429     5   s    s                          else
            3430     5   mi   s                              factor = dts * acr2d (qden, cgaci, denfac (k), bling, mug)
            3431     5   s    s                          endif
            3432     4   m    s                          sink = factor / (1. + factor) * qi (k)
            3433     4   p    s                      endif
            3434     3   s    s                  endif
            3435     2               
            3436     2   s    s                  sink = min (fi2g_fac * qi (k), sink)
            3437     2               
            3438     2   si   s                  call update_qq (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3439     2                               0., 0., 0., - sink, 0., sink)
            3440     2               
            3441     2   p    v              endif
            3442     1               
            3443     1   p    v          enddo
            3444                     
            3445                     end subroutine pgaci
            3446                     
            3447                     ! =======================================================================
            3448                     ! snow accretion with rain and rain freezing to form graupel, Lin et al. (1983)
            3449                     ! =======================================================================
            3450                     
            3451                     subroutine psacr_pgfr (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, cvm, te8, den, denfac, &
            3452                             vtr, vts, lcpk, icpk, tcpk, tcp3)
            3453                     
            3454                         implicit none
            3455                     
            3456                         ! -----------------------------------------------------------------------
            3457                         ! input / output arguments
            3458                         ! -----------------------------------------------------------------------
            3459                     
            3460                         integer, intent (in) :: ks, ke
            3461                     
            3462                         real, intent (in) :: dts
            3463                     
            3464                         real, intent (in), dimension (ks:ke) :: den, denfac, vtr, vts
            3465                     
            3466                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            3467                     
            3468                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            3469                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            3470                     
            3471                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            3472                     
            3473                         ! -----------------------------------------------------------------------
            3474                         ! local variables
            3475                         ! -----------------------------------------------------------------------
            3476                     
            3477                         integer :: k
            3478                     
            3479                         real :: tc, factor, sink
            3480                         real :: psacr, pgfr
            3481                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 10
                                   <<<      SIMD&FP   : SPILL 1  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3482     1   s    s          do k = ks, ke
            3483     1               
            3484     1   s    s              tc = tz (k) - tice
            3485     1               
            3486     2   s    s              if (tc .lt. 0. .and. qr (k) .gt. qcmin) then
            3487     2               
            3488     2   s    s                  psacr = 0.
            3489     3   s    s                  if (qs (k) .gt. qcmin) then
            3490     3   s    s                      psacr = dts * acr3d (vts (k), vtr (k), qr (k), qs (k), csacr, acco (:, 2), &
            3491     3                                   acc (3), acc (4), den (k))
            3492     3   s    s                  endif
            3493     2               
            3494     2   s    s                  pgfr = dts * cgfr (1) / den (k) * (exp (- cgfr (2) * tc) - 1.) * &
            3495     2                               exp (1. / (mur + 3) * (6 + mur) * log (6 * qr (k) * den (k)))
            3496     2               
            3497     2   s    s                  sink = psacr + pgfr
            3498     2   s    s                  factor = min (sink, qr (k), - tc / icpk (k)) / max (sink, qcmin)
            3499     2   s    s                  psacr = factor * psacr
            3500     2   s    s                  pgfr = factor * pgfr
            3501     2               
            3502     2   s    s                  sink = min (qr (k), psacr + pgfr)
            3503     2               
            3504     2   s    s                  call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            3505     2                               0., 0., - sink, 0., psacr, pgfr, te8 (k), cvm (k), tz (k), &
            3506     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            3507     2               
            3508     2   s    s              endif
            3509     1               
            3510     1   s    s          enddo
            3511                     
            3512                     end subroutine psacr_pgfr
            3513                     

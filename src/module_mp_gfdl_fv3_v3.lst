            4117     1   s    s          enddo
            4118                     
            4119                     end subroutine pbigg
            4120                     
            4121                     ! =======================================================================
            4122                     ! cloud ice deposition and sublimation, Hong et al. (2004)
            4123                     ! =======================================================================
            4124                     
            4125                     subroutine pidep_pisub (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            4126                             lcpk, icpk, tcpk, tcp3, cin, dep, sub)
            4127                     
            4128                         implicit none
            4129                     
            4130                         ! -----------------------------------------------------------------------
            4131                         ! input / output arguments
            4132                         ! -----------------------------------------------------------------------
            4133                     
            4134                         integer, intent (in) :: ks, ke
            4135                     
            4136                         real, intent (in) :: dts
            4137                     
            4138                         real, intent (in), dimension (ks:ke) :: den, dp
            4139                     
            4140                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            4141                     
            4142                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, cin
            4143                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            4144                     
            4145                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            4146                     
            4147                         real, intent (out) :: dep, sub
            4148                     
            4149                         ! -----------------------------------------------------------------------
            4150                         ! local variables
            4151                         ! -----------------------------------------------------------------------
            4152                     
            4153                         integer :: k
            4154                     
            4155                         real :: sink, tin, dqdt, qsi, dq, pidep, tmp, tc, qi_gen, qi_crt
            4156                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 22
                                   <<<      SIMD&FP   : SPILL 1  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4157     1                   do k = ks, ke
            4158     1               
            4159     2                       if (tz (k) .lt. tice) then
            4160     2               
            4161     2                           pidep = 0.
            4162     2                           tin = tz (k)
            4163     2    i                      qsi = iqs (tin, den (k), dqdt)
            4164     2                           dq = qv (k) - qsi
            4165     2                           tmp = dq / (1. + tcpk (k) * dqdt)
            4166     2               
            4167     3                           if (qi (k) .gt. qcmin) then
            4168     4                               if (.not. prog_ccn) then
            4169     4                                   if (inflag .eq. 1) &
            4170     4                                       cin (k) = 5.38e7 * exp (0.75 * log (qi (k) * den (k)))
            4171     4                                   if (inflag .eq. 2) &
            4172     4                                       cin (k) = exp (- 2.80 + 0.262 * (tice - tz (k))) * 1000.0
            4173     4                                   if (inflag .eq. 3) &
            4174     4                                       cin (k) = exp (- 0.639 + 12.96 * (qv (k) / qsi - 1.0)) * 1000.0
            4175     4                                   if (inflag .eq. 4) &
            4176     4                                       cin (k) = 5.e-3 * exp (0.304 * (tice - tz (k))) * 1000.0
            4177     4                                   if (inflag .eq. 5) &
            4178     4                                       cin (k) = 1.e-5 * exp (0.5 * (tice - tz (k))) * 1000.0
            4179     4                               endif
            4180     3                               pidep = dts * dq * 4.0 * 11.9 * exp (0.5 * log (qi (k) * den (k) * cin (k))) / &
            4181     3                                    (qsi * den (k) * (tcpk (k) * cvm (k)) ** 2 / (tcond * rvgas * tz (k) ** 2) + &
            4182     3                                   1 / vdifu)
            4183     3                           endif
            4184     2               
            4185     3                           if (dq .gt. 0.) then
            4186     3                               tc = tice - tz (k)
            4187     3                               qi_gen = 4.92e-11 * exp (1.33 * log (1.e3 * exp (0.1 * tc)))
            4188     3                               if (igflag .eq. 1) &
            4189     3                                   qi_crt = qi_gen / den (k)
            4190     3                               if (igflag .eq. 2) &
            4191     3                                   qi_crt = qi_gen * min (qi_lim, 0.1 * tc) / den (k)
            4192     3                               if (igflag .eq. 3) &
            4193     3                                   qi_crt = 1.82e-6 * min (qi_lim, 0.1 * tc) / den (k)
            4194     3                               if (igflag .eq. 4) &
            4195     3                                   qi_crt = max (qi_gen, 1.82e-6) * min (qi_lim, 0.1 * tc) / den (k)
            4196     3                               sink = min (tmp, max (qi_crt - qi (k), pidep), tc / tcpk (k))
            4197     3                               dep = dep + sink * dp (k)
            4198     3                           else
            4199     3                               pidep = pidep * min (1., dim (tz (k), t_sub) * is_fac)
            4200     3                               sink = max (pidep, tmp, - qi (k))
            4201     3                               sub = sub - sink * dp (k)
            4202     3                           endif
            4203     2               
            4204     2                           call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            4205     2                                - sink, 0., 0., sink, 0., 0., te8 (k), cvm (k), tz (k), &
            4206     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            4207     2               
            4208     2                       endif
            4209     1               
            4210     1                   enddo
            4211                     
            4212                     end subroutine pidep_pisub
            4213                     
            4214                     ! =======================================================================
            4215                     ! snow deposition and sublimation, Lin et al. (1983)
            4216                     ! =======================================================================
            4217                     
            4218                     subroutine psdep_pssub (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            4219                             denfac, lcpk, icpk, tcpk, tcp3, dep, sub)
            4220                     
            4221                         implicit none
            4222                     
            4223                         ! -----------------------------------------------------------------------
            4224                         ! input / output arguments
            4225                         ! -----------------------------------------------------------------------
            4226                     
            4227                         integer, intent (in) :: ks, ke
            4228                     
            4229                         real, intent (in) :: dts
            4230                     
            4231                         real, intent (in), dimension (ks:ke) :: den, dp, denfac
            4232                     
            4233                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            4234                     
            4235                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4236                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            4237                     
            4238                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            4239                     
            4240                         real, intent (out) :: dep, sub
            4241                     
            4242                         ! -----------------------------------------------------------------------
            4243                         ! local variables
            4244                         ! -----------------------------------------------------------------------
            4245                     
            4246                         integer :: k
            4247                     
            4248                         real :: sink, tin, dqdt, qsi, qden, t2, dq, pssub
            4249                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 18
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4250     1                   do k = ks, ke
            4251     1               
            4252     2                       if (qs (k) .gt. qcmin) then
            4253     2               
            4254     2                           tin = tz (k)
            4255     2    i                      qsi = iqs (tin, den (k), dqdt)
            4256     2                           qden = qs (k) * den (k)
            4257     2                           t2 = tz (k) * tz (k)
            4258     2                           dq = qsi - qv (k)
            4259     2    i                      pssub = psub (t2, dq, qden, qsi, cssub, den (k), denfac (k), blins, mus, tcpk (k), cvm (k))
            4260     2                           pssub = dts * pssub
            4261     2                           dq = dq / (1. + tcpk (k) * dqdt)
            4262     3                           if (pssub .gt. 0.) then
            4263     3                               sink = min (pssub * min (1., dim (tz (k), t_sub) * ss_fac), qs (k))
            4264     3                               sub = sub + sink * dp (k)
            4265     3                           else
            4266     3                               sink = 0.
            4267     4                               if (tz (k) .le. tice) then
            4268     4                                   sink = max (pssub, dq, (tz (k) - tice) / tcpk (k))
            4269     4                               endif
            4270     3                               dep = dep - sink * dp (k)
            4271     3                           endif
            4272     2               
            4273     2                           call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            4274     2                               sink, 0., 0., 0., - sink, 0., te8 (k), cvm (k), tz (k), &
            4275     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            4276     2               
            4277     2                       endif
            4278     1               
            4279     1                   enddo
            4280                     
            4281                     end subroutine psdep_pssub
            4282                     
            4283                     ! =======================================================================
            4284                     ! graupel deposition and sublimation, Lin et al. (1983)
            4285                     ! =======================================================================
            4286                     
            4287                     subroutine pgdep_pgsub (ks, ke, dts, qv, ql, qr, qi, qs, qg, tz, dp, cvm, te8, den, &
            4288                             denfac, lcpk, icpk, tcpk, tcp3, dep, sub)
            4289                     
            4290                         implicit none
            4291                     
            4292                         ! -----------------------------------------------------------------------
            4293                         ! input / output arguments
            4294                         ! -----------------------------------------------------------------------
            4295                     
            4296                         integer, intent (in) :: ks, ke
            4297                     
            4298                         real, intent (in) :: dts
            4299                     
            4300                         real, intent (in), dimension (ks:ke) :: den, dp, denfac
            4301                     
            4302                         real (kind = r8), intent (in), dimension (ks:ke) :: te8
            4303                     
            4304                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg
            4305                         real, intent (inout), dimension (ks:ke) :: lcpk, icpk, tcpk, tcp3
            4306                     
            4307                         real (kind = r8), intent (inout), dimension (ks:ke) :: cvm, tz
            4308                     
            4309                         real, intent (out) :: dep, sub
            4310                     
            4311                         ! -----------------------------------------------------------------------
            4312                         ! local variables
            4313                         ! -----------------------------------------------------------------------
            4314                     
            4315                         integer :: k
            4316                     
            4317                         real :: sink, tin, dqdt, qsi, qden, t2, dq, pgsub
            4318                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 28
                                   <<<      SIMD&FP   : SPILL 2  FILL 3
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4319     1                   do k = ks, ke
            4320     1               
            4321     2                       if (qg (k) .gt. qcmin) then
            4322     2               
            4323     2                           tin = tz (k)
            4324     2    i                      qsi = iqs (tin, den (k), dqdt)
            4325     2                           qden = qg (k) * den (k)
            4326     2                           t2 = tz (k) * tz (k)
            4327     2                           dq = qsi - qv (k)
            4328     3                           if (do_hail) then
            4329     3    i                          pgsub = psub (t2, dq, qden, qsi, cgsub, den (k), denfac (k), blinh, muh, tcpk (k), cvm (k))
            4330     3                           else
            4331     3    i                          pgsub = psub (t2, dq, qden, qsi, cgsub, den (k), denfac (k), bling, mug, tcpk (k), cvm (k))
            4332     3                           endif
            4333     2                           pgsub = dts * pgsub
            4334     2                           dq = dq / (1. + tcpk (k) * dqdt)
            4335     3                           if (pgsub .gt. 0.) then
            4336     3                               sink = min (pgsub * min (1., dim (tz (k), t_sub) * gs_fac), qg (k))
            4337     3                               sub = sub + sink * dp (k)
            4338     3                           else
            4339     3                               sink = 0.
            4340     4                               if (tz (k) .le. tice) then
            4341     4                                   sink = max (pgsub, dq, (tz (k) - tice) / tcpk (k))
            4342     4                               endif
            4343     3                               dep = dep - sink * dp (k)
            4344     3                           endif
            4345     2               
            4346     2                           call update_qt (qv (k), ql (k), qr (k), qi (k), qs (k), qg (k), &
            4347     2                               sink, 0., 0., 0., 0., - sink, te8 (k), cvm (k), tz (k), &
            4348     2                               lcpk (k), icpk (k), tcpk (k), tcp3 (k))
            4349     2               
            4350     2                       endif
            4351     1               
            4352     1                   enddo
            4353                     
            4354                     end subroutine pgdep_pgsub
            4355                     
            4356                     ! =======================================================================
            4357                     ! cloud fraction diagnostic
            4358                     ! =======================================================================
            4359                     
            4360                     subroutine cloud_fraction (ks, ke, pz, den, qv, ql, qr, qi, qs, qg, qa, tz, h_var, gsize)
            4361                     
            4362                         implicit none
            4363                     
            4364                         ! -----------------------------------------------------------------------
            4365                         ! input / output arguments
            4366                         ! -----------------------------------------------------------------------
            4367                     
            4368                         integer, intent (in) :: ks, ke
            4369                     
            4370                         real, intent (in) :: h_var, gsize
            4371                     
            4372                         real, intent (in), dimension (ks:ke) :: pz, den
            4373                     
            4374                         real (kind = r8), intent (in), dimension (ks:ke) :: tz
            4375                     
            4376                         real, intent (inout), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, qa
            4377                     
            4378                         ! -----------------------------------------------------------------------
            4379                         ! local variables
            4380                         ! -----------------------------------------------------------------------
            4381                     
            4382                         integer :: k
            4383                     
            4384                         real :: q_plus, q_minus
            4385                         real :: rh, rqi, tin, qsw, qsi, qpz, qstar, sigma, gam
            4386                         real :: dqdt, dq, liq, ice
            4387                         real :: qa10, qa100
            4388                     
            4389                         real, dimension (ks:ke) :: q_liq, q_sol, q_cond, lcpk, icpk, tcpk, tcp3
            4390                     
            4391                         real (kind = r8), dimension (ks:ke) :: cvm, te8
            4392                     
            4393                         ! -----------------------------------------------------------------------
            4394                         ! calculate heat capacities and latent heat coefficients
            4395                         ! -----------------------------------------------------------------------
            4396                     
            4397                         call cal_mhc_lhc (ks, ke, qv, ql, qr, qi, qs, qg, q_liq, q_sol, cvm, te8, tz, &
            4398                             lcpk, icpk, tcpk, tcp3)
            4399                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q_sol, qi, q_liq, ql, qv, te8, q_cond
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 10  FILL 27
                                   <<<      SIMD&FP   : SPILL 1  FILL 7
                                   <<<      SCALABLE  : SPILL 0  FILL 3
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4400     1                   do k = ks, ke
            4401     1               
            4402     1                       ! combine water species
            4403     1               
            4404     1                       ice = q_sol (k)
            4405     1                       q_sol (k) = qi (k)
            4406     2                       if (rad_snow) then
            4407     2                           q_sol (k) = qi (k) + qs (k)
            4408     3                           if (rad_graupel) then
            4409     3                               q_sol (k) = qi (k) + qs (k) + qg (k)
            4410     3                           endif
            4411     2                       endif
            4412     1               
            4413     1                       liq = q_liq (k)
            4414     1                       q_liq (k) = ql (k)
            4415     2                       if (rad_rain) then
            4416     2                           q_liq (k) = ql (k) + qr (k)
            4417     2                       endif
            4418     1               
            4419     1                       q_cond (k) = q_liq (k) + q_sol (k)
            4420     1                       qpz = qv (k) + q_cond (k)
            4421     1               
            4422     1                       ! use the "liquid - frozen water temperature" (tin) to compute saturated specific humidity
            4423     1               
            4424     1                       ice = ice - q_sol (k)
            4425     1                       liq = liq - q_liq (k)
            4426     1    i                  tin = (te8 (k) - lv00 * qpz + li00 * ice) / mhc (qpz, liq, ice)
            4427     1               
            4428     1                       ! calculate saturated specific humidity
            4429     1               
            4430     2                       if (tin .le. t_wfr) then
            4431     2    i                      qstar = iqs (tin, den (k), dqdt)
            4432     2                       elseif (tin .ge. tice) then
            4433     2    i                      qstar = wqs (tin, den (k), dqdt)
            4434     2                       else
            4435     2    i                      qsi = iqs (tin, den (k), dqdt)
            4436     2    i                      qsw = wqs (tin, den (k), dqdt)
            4437     3                           if (q_cond (k) .gt. qcmin) then
            4438     3                               rqi = q_sol (k) / q_cond (k)
            4439     3                           else
            4440     3                               rqi = (tice - tin) / (tice - t_wfr)
            4441     3                           endif
            4442     2                           qstar = rqi * qsi + (1. - rqi) * qsw
            4443     2                       endif
            4444     1               
            4445     1                       ! cloud schemes
            4446     1               
            4447     1                       rh = qpz / qstar
            4448     1               
            4449     2                       if (cfflag .eq. 1) then
            4450     3                           if (rh .gt. rh_thres .and. qpz .gt. qcmin) then
            4451     3               
            4452     3                               dq = h_var * qpz
            4453     4                               if (do_cld_adj) then
            4454     4                                   q_plus = qpz + dq * f_dq_p * min (1.0, max (0.0, (pz (k) - 200.e2) / &
            4455     4                                        (1000.e2 - 200.e2)))
            4456     4                               else
            4457     4                                   q_plus = qpz + dq * f_dq_p
            4458     4                               endif
            4459     3                               q_minus = qpz - dq * f_dq_m
            4460     3               
            4461     4                               if (icloud_f .eq. 2) then
            4462     5                                   if (qstar .lt. qpz) then
            4463     5                                       qa (k) = 1.
            4464     5                                   else
            4465     5                                       qa (k) = 0.
            4466     5                                   endif
            4467     4                               elseif (icloud_f .eq. 3) then
            4468     5                                   if (qstar .lt. qpz) then
            4469     5                                       qa (k) = 1.
            4470     5                                   else
            4471     6                                       if (qstar .lt. q_plus) then
            4472     6                                           qa (k) = (q_plus - qstar) / (dq * f_dq_p)
            4473     6                                       else
            4474     6                                           qa (k) = 0.
            4475     6                                       endif
            4476     6                                       if (q_cond (k) .gt. qcmin) then
            4477     6                                           qa (k) = max (cld_min, qa (k))
            4478     6                                       endif
            4479     5                                       qa (k) = min (1., qa (k))
            4480     5                                   endif
            4481     4                               else
            4482     5                                   if (qstar .lt. q_minus) then
            4483     5                                       qa (k) = 1.
            4484     5                                   else
            4485     6                                       if (qstar .lt. q_plus) then
            4486     7                                           if (icloud_f .eq. 0) then
            4487     7                                               qa (k) = (q_plus - qstar) / (dq * f_dq_p + dq * f_dq_m)
            4488     7                                           else
            4489     7                                               qa (k) = (q_plus - qstar) / ((dq * f_dq_p + dq * f_dq_m) * &
            4490     7                                                    (1. - q_cond (k)))
            4491     7                                           endif
            4492     6                                       else
            4493     6                                           qa (k) = 0.
            4494     6                                       endif
            4495     6                                       if (q_cond (k) .gt. qcmin) then
            4496     6                                           qa (k) = max (cld_min, qa (k))
            4497     6                                       endif
            4498     5                                       qa (k) = min (1., qa (k))
            4499     5                                   endif
            4500     4                               endif
            4501     3                           else
            4502     3                               qa (k) = 0.
            4503     3                           endif
            4504     2                       endif
            4505     1               
            4506     2                       if (cfflag .eq. 2) then
            4507     3                           if (rh .ge. 1.0) then
            4508     3                               qa (k) = 1.0
            4509     3                           elseif (rh .gt. rh_thres .and. q_cond (k) .gt. qcmin) then
            4510     3                               qa (k) = exp (xr_a * log (rh)) * (1.0 - exp (- xr_b * max (0.0, q_cond (k)) / &
            4511     3                                   max (1.e-5, exp (xr_c * log (max (1.e-10, 1.0 - rh) * qstar)))))
            4512     3                               qa (k) = max (0.0, min (1., qa (k)))
            4513     3                           else
            4514     3                               qa (k) = 0.0
            4515     3                           endif
            4516     2                       endif
            4517     1               
            4518     2                       if (cfflag .eq. 3) then
            4519     3                           if (q_cond (k) .gt. qcmin) then
            4520     3                               qa (k) = 1. / 50. * (5.77 * (100. - gsize / 1000.) * &
            4521     3                                   exp (1.07 * log (max (qcmin * 1000., q_cond (k) * 1000.))) + &
            4522     3                                   4.82 * (gsize / 1000. - 50.) * &
            4523     3                                   exp (0.94 * log (max (qcmin * 1000., q_cond (k) * 1000.))))
            4524     3                               qa (k) = qa (k) * (0.92 / 0.96 * q_liq (k) / q_cond (k) + &
            4525     3                                   1.0 / 0.96 * q_sol (k) / q_cond (k))
            4526     3                               qa (k) = max (0.0, min (1., qa (k)))
            4527     3                           else
            4528     3                               qa (k) = 0.0
            4529     3                           endif
            4530     2                       endif
            4531     1               
            4532     2                       if (cfflag .eq. 4) then
            4533     2                           sigma = 0.28 + exp (0.49 * log (max (qcmin * 1000., q_cond (k) * 1000.)))
            4534     2                           gam = max (0.0, q_cond (k) * 1000.) / sigma
            4535     3                           if (gam .lt. 0.18) then
            4536     3                               qa10 = 0.
            4537     3                           elseif (gam .gt. 2.0) then
            4538     3                               qa10 = 1.0
            4539     3                           else
            4540     3                               qa10 = - 0.1754 + 0.9811 * gam - 0.2223 * gam ** 2 + 0.0104 * gam ** 3
            4541     3                               qa10 = max (0.0, min (1., qa10))
            4542     3                           endif
            4543     3                           if (gam .lt. 0.12) then
            4544     3                               qa100 = 0.
            4545     3                           elseif (gam .gt. 1.85) then
            4546     3                               qa100 = 1.0
            4547     3                           else
            4548     3                               qa100 = - 0.0913 + 0.7213 * gam + 0.1060 * gam ** 2 - 0.0946 * gam ** 3
            4549     3                               qa100 = max (0.0, min (1., qa100))
            4550     3                           endif
            4551     2                           qa (k) = qa10 + (log10 (gsize / 1000.) - 1) * (qa100 - qa10)
            4552     2                           qa (k) = max (0.0, min (1., qa (k)))
            4553     2                       endif
            4554     1               
            4555     1                   enddo
            4556                     
            4557                     end subroutine cloud_fraction
            4558                     
            4559                     ! =======================================================================
            4560                     ! piecewise parabolic lagrangian scheme
            4561                     ! =======================================================================
            4562                     
            4563                     subroutine lagrangian_fall_ppm (ks, ke, zs, ze, zt, dp, q, precip, m1, mono)
            4564                     
            4565                         implicit none
            4566                     
            4567                         ! -----------------------------------------------------------------------
            4568                         ! input / output arguments
            4569                         ! -----------------------------------------------------------------------
            4570                     
            4571                         integer, intent (in) :: ks, ke
            4572                     
            4573                         logical, intent (in) :: mono
            4574                     
            4575                         real, intent (in) :: zs
            4576                     
            4577                         real, intent (in), dimension (ks:ke + 1) :: ze, zt
            4578                     
            4579                         real, intent (in), dimension (ks:ke) :: dp
            4580                     
            4581                         real, intent (inout), dimension (ks:ke) :: q
            4582                     
            4583                         real, intent (inout) :: precip
            4584                     
            4585                         real, intent (out), dimension (ks:ke) :: m1
            4586                     
            4587                         ! -----------------------------------------------------------------------
            4588                         ! local variables
            4589                         ! -----------------------------------------------------------------------
            4590                     
            4591                         integer :: k, k0, n, m
            4592                     
            4593                         real :: a4 (4, ks:ke), pl, pr, delz, esl
            4594                     
            4595                         real, parameter :: r3 = 1. / 3., r23 = 2. / 3.
            4596                     
            4597                         real, dimension (ks:ke) :: qm, dz
            4598                     
            4599                         ! -----------------------------------------------------------------------
            4600                         ! density:
            4601                         ! -----------------------------------------------------------------------
            4602                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, q, zt, qm, a4, dz
                                   <<< Loop-information  End >>>
            4603     1  pp    v          do k = ks, ke
            4604     1   p    v              dz (k) = zt (k) - zt (k + 1)
            4605     1   p    v              q (k) = q (k) * dp (k)
            4606     1   p    v              a4 (1, k) = q (k) / dz (k)
            4607     1   p    v              qm (k) = 0.
            4608     1   p    v          enddo
            4609                     
            4610                         ! -----------------------------------------------------------------------
            4611                         ! construct vertical profile with zt as coordinate
            4612                         ! -----------------------------------------------------------------------
            4613                     
            4614                         call cs_profile (a4 (1, ks), dz (ks), ke - ks + 1, mono)
            4615                     
            4616                         k0 = ks
            4617     1                   do k = ks, ke
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            4618     2                       do n = k0, ke
            4619     3                           if (ze (k) .le. zt (n) .and. ze (k) .ge. zt (n + 1)) then
            4620     3                               pl = (zt (n) - ze (k)) / dz (n)
            4621     4                               if (zt (n + 1) .le. ze (k + 1)) then
            4622     4                                   ! entire new grid is within the original grid
            4623     4                                   pr = (zt (n) - ze (k + 1)) / dz (n)
            4624     4                                   qm (k) = a4 (2, n) + 0.5 * (a4 (4, n) + a4 (3, n) - a4 (2, n)) * (pr + pl) - &
            4625     4                                       a4 (4, n) * r3 * (pr * (pr + pl) + pl ** 2)
            4626     4                                   qm (k) = qm (k) * (ze (k) - ze (k + 1))
            4627     4                                   k0 = n
            4628     4                                   goto 555
            4629     4                               else
            4630     4                                   qm (k) = (ze (k) - zt (n + 1)) * (a4 (2, n) + 0.5 * (a4 (4, n) + &
            4631     4                                       a4 (3, n) - a4 (2, n)) * (1. + pl) - a4 (4, n) * (r3 * (1. + pl * (1. + pl))))
            4632     5                                   if (n .lt. ke) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zt
                                   <<< Loop-information  End >>>
            4633     6                                       do m = n + 1, ke
            4634     6                                           ! locate the bottom edge: ze (k + 1)
            4635     7                                           if (ze (k + 1) .lt. zt (m + 1)) then
            4636     7                                               qm (k) = qm (k) + q (m)
            4637     7                                           else
            4638     7                                               delz = zt (m) - ze (k + 1)
            4639     7                                               esl = delz / dz (m)
            4640     7                                               qm (k) = qm (k) + delz * (a4 (2, m) + 0.5 * esl * &
            4641     7                                                    (a4 (3, m) - a4 (2, m) + a4 (4, m) * (1. - r23 * esl)))
            4642     7                                               k0 = m
            4643     7                                               goto 555
            4644     7                                           endif
            4645     6                                       enddo
            4646     5                                   endif
            4647     4                                   goto 555
            4648     4                               endif
            4649     3                           endif
            4650     2                       enddo
            4651     1                       555 continue
            4652     1                   enddo
            4653                     
            4654                         m1 (ks) = q (ks) - qm (ks)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.83, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, qm, m1
                                   <<< Loop-information  End >>>
            4655     1   s   2s          do k = ks + 1, ke
            4656     1   m   2m              m1 (k) = m1 (k - 1) + q (k) - qm (k)
            4657     1   p   2v          enddo
            4658                         precip = precip + m1 (ke)
            4659                     
            4660                         ! -----------------------------------------------------------------------
            4661                         ! convert back to * dry * mixing ratio:
            4662                         ! dp must be dry air_mass (because moist air mass will be changed due to terminal fall) .
            4663                         ! -----------------------------------------------------------------------
            4664                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.31, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, qm, q
                                   <<< Loop-information  End >>>
            4665     1  pp   2v          do k = ks, ke
            4666     1   p   2v              q (k) = qm (k) / dp (k)
            4667     1   p   2v          enddo
            4668                     
            4669                     end subroutine lagrangian_fall_ppm
            4670                     
            4671                     ! =======================================================================
            4672                     ! construct vertical profile
            4673                     ! =======================================================================
            4674                     
            4675                     subroutine cs_profile (a4, del, km, do_mono)
            4676                     
            4677                         implicit none
            4678                     
            4679                         ! -----------------------------------------------------------------------
            4680                         ! input / output arguments
            4681                         ! -----------------------------------------------------------------------
            4682                     
            4683                         integer, intent (in) :: km
            4684                     
            4685                         logical, intent (in) :: do_mono
            4686                     
            4687                         real, intent (in) :: del (km)
            4688                     
            4689                         real, intent (inout) :: a4 (4, km)
            4690                     
            4691                         ! -----------------------------------------------------------------------
            4692                         ! local variables
            4693                         ! -----------------------------------------------------------------------
            4694                     
            4695                         integer :: k
            4696                     
            4697                         logical :: extm (km)
            4698                     
            4699                         real, parameter :: qp_min = 1.e-6
            4700                     
            4701                         real :: gam (km), q (km + 1), d4, bet, a_bot, grat, pmp, lac
            4702                         real :: pmp_1, lac_1, pmp_2, lac_2, da1, da2, a6da
            4703                     
            4704                         grat = del (2) / del (1) ! grid ratio
            4705                         bet = grat * (grat + 0.5)
            4706                         q (1) = (2. * grat * (grat + 1.) * a4 (1, 1) + a4 (1, 2)) / bet
            4707                         gam (1) = (1. + grat * (grat + 1.5)) / bet
            4708                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 10, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a4, q, gam, del

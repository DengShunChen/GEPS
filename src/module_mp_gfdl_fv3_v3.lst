            7031                     
            7032                         logical, intent (in) :: moist_q, hydrostatic
            7033                     
            7034                         real, intent (in) :: gsize, water, rain, ice, snow, graupel, dts
            7035                     
            7036                         real, intent (in), dimension (ks:ke) :: qv, ql, qr, qi, qs, qg, ua, va, wa, delp
            7037                     
            7038                         real (kind = r8), intent (in) :: dte
            7039                     
            7040                         real (kind = r8), intent (in), dimension (ks:ke) :: tz
            7041                     

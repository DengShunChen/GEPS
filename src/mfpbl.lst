 External subroutine subprogram "mfpbl"
  (inc)(line-no.)(nest)(optimize)
               1                     !>  \file mfpbl.f
               2                     !!  This file contains the subroutine that calculates the updraft properties and mass flux for use in the Hybrid EDMF PBL scheme.
               3                     
               4                     !>  \ingroup PBL
               5                     !!  \brief This subroutine is used for calculating the mass flux and updraft properties.
               6                     !!
               7                     !!  The mfpbl routines works as follows: if the PBL is convective, first, the ascending parcel entrainment rate is calculated as a function of height. Next, a surface parcel is initiated according to surface layer properties and the updraft buoyancy is ca
               8                     !!  \param[in] im number of used points
               9                     !!  \param[in] ix horizontal dimension
              10                     !!  \param[in] km vertical layer dimension
              11                     !!  \param[in] ntrac number of tracers
              12                     !!  \param[in] delt physics time step
              13                     !!  \param[in] cnvflg flag to denote a strongly unstable (convective) PBL
              14                     !!  \param[in] zl height of grid centers
              15                     !!  \param[in] zm height of grid interfaces
              16                     !!  \param[in] thvx virtual potential temperature at grid centers (\f$ K \f$)
              17                     !!  \param[in] q1 layer mean tracer concentration (units?)
              18                     !!  \param[in] t1 layer mean temperature (\f$ K \f$)
              19                     !!  \param[in] u1 u component of layer wind (\f$ m s^{-1} \f$)
              20                     !!  \param[in] v1 v component of layer wind (\f$ m s^{-1} \f$)
              21                     !!  \param[in,out] hpbl PBL top height (m)
              22                     !!  \param[in,out] kpbl PBL top index
              23                     !!  \param[in] sflx total surface heat flux (units?)
              24                     !!  \param[in] ustar surface friction velocity
              25                     !!  \param[in] wstar convective velocity scale
              26                     !!  \param[out] xmf updraft mass flux
              27                     !!  \param[in,out] tcko updraft temperature (\f$ K \f$)
              28                     !!  \param[in,out] qcko updraft tracer concentration (units?)
              29                     !!  \param[in,out] ucko updraft u component of horizontal momentum (\f$ m s^{-1} \f$)
              30                     !!  \param[in,out] vcko updraft v component of horizontal momentum (\f$ m s^{-1} \f$)
              31                     !!
              32                     !!  \section general General Algorithm
              33                     !!  -# Determine an updraft parcel's entrainment rate, buoyancy, and vertical velocity.
              34                     !!  -# Recalculate the PBL height (previously calculated in moninedmf) and the parcel's entrainment rate.
              35                     !!  -# Calculate the mass flux profile and updraft properties.
              36                     !!  \section detailed Detailed Algorithm
              37                     !!  @{
              38                           subroutine mfpbl(im,ix,km,ntrac,delt,cnvflg,                      &
              39                              zl,zm,thvx,q1,t1,u1,v1,hpbl,kpbl,                              &
              40                              sflx,ustar,wstar,xmf,tcko,qcko,ucko,vcko)
              41                     !
              42                           use machine , only : kind_phys
              43                           use physcons, grav => con_g, cp => con_cp
              44                     !
              45                           implicit none
              46                     !
              47                           integer              im, ix, km, ntrac
              48                     !    &,                    me
              49                           integer              kpbl(im)
              50                           logical              cnvflg(im)
              51                           real(kind=kind_phys) delt
              52                           real(kind=kind_phys) q1(ix,km,ntrac), t1(ix,km),                  &
              53                                                u1(ix,km),  v1(ix,km),                       &
              54                                                thvx(im,km),                                 &
              55                                                zl(im,km),  zm(im,km+1),                     &
              56                                                hpbl(im),   sflx(im),    ustar(im),          &
              57                                                wstar(im),  xmf(im,km),                      &
              58                                                tcko(im,km),qcko(im,km,ntrac),               &
              59                                                ucko(im,km),vcko(im,km)
              60                     !
              61                     !  local variables and arrays
              62                     !
              63                           integer   i, j, k, n, kmpbl
              64                     !
              65                           real(kind=kind_phys) dt2,     dz,      ce0, &
              66                                                h1,      factor,  gocp, &
              67                                                g,       c1,      d1, &
              68                                                b1,      f1,      bb1,     bb2,   &
              69                                                alp,     a1,      qmin,    zfmin, &
              70                                                xmmx,    rbint,   tau,            &
              71                     !    &                     rbint,   tau, &
              72                                                tem,     tem1,    tem2, &
              73                                                ptem,    ptem1,   ptem2, &
              74                                                pgcon
              75                     !
              76                           real(kind=kind_phys) sigw1(im),   usws3(im),  xlamax(im), &
              77                                                rbdn(im),    rbup(im),   delz(im)
              78                     !
              79                           real(kind=kind_phys) wu2(im,km),     xlamue(im,km), &
              80                                                thvu(im,km),    zi(im,km), &
              81                                                buo(im,km)
              82                     !
              83                           logical totflg, flg(im)
              84                     !
              85                     !  physical parameters
              86                           parameter(g=grav)
              87                           parameter(gocp=g/cp)
              88                     !     parameter(ce0=0.37,qmin=1.e-8,alp=1.0,pgcon=0.55)
              89                           parameter(ce0=0.38,qmin=1.e-8,alp=1.0,pgcon=0.55)
              90                           parameter(a1=0.08,b1=0.5,f1=0.15,c1=0.3,d1=2.58,tau=500.)
              91                           parameter(zfmin=1.e-8,h1=0.33333333)
              92                     !
              93                     !c-----------------------------------------------------------------------
              94                     !
              95                     !************************************************************************
              96                     !
              97                           kmpbl = km/2 + 1
              98                           dt2 = delt
              99                     !> Since the mfpbl subroutine is called regardless of whether the PBL is convective, a check of the convective PBL flag is performed and the subroutine returns back to moninedmf (with the output variables set to the initialized values) if the PBL is not c
             100                           totflg = .true.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
             101     1  pp    v            do i=1,im
             102     1   p    v              totflg = totflg .and. (.not. cnvflg(i))
             103     1   p    v            enddo
             104                           if(totflg) return
             105                     !!
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, zm, zi
                                   <<< Loop-information  End >>>
             106     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zm, cnvflg, zi
                                   <<< Loop-information  End >>>
             107     2   p   2v              do i=1,im
             108     3   p   2v                if (cnvflg(i)) then
             109     3   p   2v                  zi(i,k) = zm(i,k+1)
             110     3   p   2v                endif
             111     2   p   2v              enddo
             112     1   p                 enddo
             113                     !>  ## Determine an updraft parcel's entrainment rate, buoyancy, and vertical velocity.
             114                     !!  Calculate the entrainment rate according to equation 16 in Siebesma et al. (2007) \cite siebesma_et_al_2007 for all levels (xlamue) and a default entrainment rate (xlamax) for use above the PBL top.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             115     1  pp    s            do i=1,im
             116     2   p    m              if(cnvflg(i)) then
             117     2   p    s                k = kpbl(i) / 2
             118     2   p    s                k = max(k, 1)
             119     2   p    s                delz(i) = zl(i,k+1) - zl(i,k)
             120     2   p    s                xlamax(i) = ce0 / delz(i)
             121     2   p    v              endif
             122     1   p    v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, kpbl, delz, hpbl, zi, xlamax
                                   <<<      xlamue
                                   <<< Loop-information  End >>>
             123     1  pp                 do k = 1, kmpbl
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.65, ITR: 48, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xlamue, kpbl, delz, hpbl, zi, xlamax
                                   <<<      cnvflg
                                   <<< Loop-information  End >>>
             124     2   p    v              do i=1,im
             125     3   p    v                if(cnvflg(i)) then
             126     4   p    v                  if(k < kpbl(i)) then
             127     4   p    v                    ptem = 1./(zi(i,k)+delz(i))
             128     4   p    v                    tem = max((hpbl(i)-zi(i,k)+delz(i)) ,delz(i))
             129     4   p    v                    ptem1 = 1./tem
             130     4   p    v                    xlamue(i,k) = ce0 * (ptem+ptem1)
             131     4   p    v                  else
             132     4   p    v                    xlamue(i,k) = xlamax(i)
             133     4   p    v                  endif
             134     3   p    v                endif
             135     2   p    v              enddo
             136     1   p                 enddo
             137                     !
             138                     !  compute thermal excess
             139                     !
             140                     !>  Using equations 17 and 7 from Siebesma et al (2007) \cite siebesma_et_al_2007 along with \f$u_*\f$, \f$w_*\f$, and the previously diagnosed PBL height, the initial \f$\theta_v\f$ of the updraft (and its surface buoyancy) is calculated.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 38
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, ustar, wstar, hpbl, zl, usws3
                                   <<<      sflx, thvx, sigw1, thvu, buo
                                   <<< Loop-information  End >>>
             141     1  pp    v            do i=1,im
             142     2   p    v              if(cnvflg(i)) then
             143     2   p    v                tem = zl(i,1)/hpbl(i)
             144     2   p    v                usws3(i) = (ustar(i)/wstar(i))**3.
             145     2   p    v                tem1 = usws3(i) + 0.6*tem
             146     2   p    v                tem2 = max((1.-tem), zfmin)
             147     2   p    v                ptem = (tem1**h1) * sqrt(tem2)
             148     2   p    v                sigw1(i) = 1.3 * ptem * wstar(i)
             149     2   p    v                ptem1 = alp * sflx(i) / sigw1(i)
             150     2   p    v                thvu(i,1) = thvx(i,1) + ptem1
             151     2   p    v                buo(i,1) = g * (thvu(i,1)/thvx(i,1)-1.)
             152     2   p    v              endif
             153     1   p    v            enddo
             154                     !
             155                     !  compute potential temperature and buoyancy for updraft air parcel
             156                     !
             157                     !>  From the second level to the middle of the vertical domain, the updraft virtual potential temperature is calculated using the entraining updraft equation as in equation 10 of Siebesma et al (2007) \cite siebesma_et_al_2007, discretized as
             158                     !!  \f[
             159                     !!  \frac{\theta_{v,u}^k - \theta_{v,u}^{k-1}}{\Delta z}=-\epsilon^{k-1}\left[\frac{1}{2}\left(\theta_{v,u}^k + \theta_{v,u}^{k-1}\right)-\frac{1}{2}\left(\overline{\theta_{v}}^k + \overline{\theta_v}^{k-1}\right)\right]
             160                     !!  \f]
             161                     !!  where the superscript \f$k\f$ denotes model level, and subscript \f$u\f$ denotes an updraft property, and the overbar denotes the grid-scale mean value.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, zl, thvx, xlamue, thvu, buo
                                   <<< Loop-information  End >>>
             162     1                     do k = 2, kmpbl
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 276
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zl, thvx, xlamue, thvu, cnvflg, buo
                                   <<< Loop-information  End >>>
             163     2  pp    v              do i=1,im
             164     3   p    v                if(cnvflg(i)) then
             165     3   p    v                  dz = zl(i,k) - zl(i,k-1)
             166     3   p    v                  tem = xlamue(i,k-1) * dz
             167     3   p    v                  ptem = 2. + tem
             168     3   p    v                  ptem1 = (2. - tem) / ptem
             169     3   p    v                  tem1 = tem  * (thvx(i,k)+thvx(i,k-1)) / ptem
             170     3   p    v                  thvu(i,k) = ptem1 * thvu(i,k-1) + tem1
             171     3   p    v                  buo(i,k) = g * (thvu(i,k)/thvx(i,k)-1.)
             172     3   p    v                endif
             173     2   p    v              enddo
             174     1                     enddo
             175                     !
             176                     !  compute updraft velocity square(wu2)
             177                     !
             178                     !>  Rather than use the vertical velocity equation given as equation 15 in Siebesma et al (2007) \cite siebesma_et_al_2007 (which parameterizes the pressure term in terms of the updraft vertical velocity itself), this scheme uses the more widely used form
             179                     !!  \f[
             180                     !!  \frac{w_{u,k}^2 - w_{u,k-1}^2}{\Delta z} = -2b_1\frac{1}{2}\left(\epsilon_k + \epsilon_{k-1}\right)\frac{1}{2}\left(w_{u,k}^2 + w_{u,k-1}^2\right) + 2b_2B
             181                     !!  \f]
             182                     !! The constants used in the scheme are labeled \f$bb1 = 2b_1\f$ and \f$bb2 = 2b_2\f$ and are tuned to be equal to 1.8 and 3.5, respectively, close to the values proposed by Soares et al. (2004) \cite soares_et_al_2004 .
             183                     !     tem = 1.-2.*f1
             184                     !     bb1 = 2. * b1 / tem
             185                     !     bb2 = 2. / tem
             186                     !  from soares et al. (2004,qjrms)
             187                     !     bb1 = 2.
             188                     !     bb2 = 4.
             189                     !
             190                     !  from bretherton et al. (2004, mwr)
             191                     !     bb1 = 4.
             192                     !     bb2 = 2.
             193                     !
             194                     !  from our tuning
             195                     !      bb1 = 1.8    !(org)
             196                           bb1 = 2.8     !(lin)
             197                     
             198                           bb2 = 3.5
             199                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zi, xlamue, buo, cnvflg, wu2
                                   <<< Loop-information  End >>>
             200     1  pp   2v            do i = 1, im
             201     2   p   2v              if(cnvflg(i)) then
             202     2               !
             203     2               !         tem = zi(i,1)/hpbl(i)
             204     2               !         tem1 = usws3(i) + 0.6*tem
             205     2               !         tem2 = max((1.-tem), zfmin)
             206     2               !         ptem = (tem1**h1) * sqrt(tem2)
             207     2               !         ptem1 = 1.3 * ptem * wstar(i)
             208     2               !         wu2(i,1) = d1*d1*ptem1*ptem1
             209     2               !
             210     2   p   2v                dz   = zi(i,1)
             211     2   p   2v                tem  = 0.5*bb1*xlamue(i,1)*dz
             212     2   p   2v                tem1 = bb2 * buo(i,1) * dz
             213     2   p   2v                ptem1 = 1. + tem
             214     2   p   2v                wu2(i,1) = tem1 / ptem1
             215     2               !
             216     2   p   2v              endif
             217     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cnvflg, xlamue, zi, buo, wu2
                                   <<< Loop-information  End >>>
             218     1                     do k = 2, kmpbl
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.68, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      buo, cnvflg, wu2, xlamue, zi
                                   <<< Loop-information  End >>>
             219     2  pp    v              do i = 1, im
             220     3   p    v                if(cnvflg(i)) then
             221     3   p    v                  dz    = zi(i,k) - zi(i,k-1)
             222     3   p    v                  tem  = 0.25*bb1*(xlamue(i,k)+xlamue(i,k-1))*dz

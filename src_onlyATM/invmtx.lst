               1                           subroutine invmtx (a,na,v,nv,n,d,ip,ier)
               2                     !
               3                     !
               4                     ! dimension of           a(na,n),v(nv,n),ip(2*n)
               5                     ! arguments
               6                     !
               7                     !
               8                     ! purpose                invmtx calculates the inverse of the input
               9                     !                        matrix a using gaussian elimination with full
              10                     !                        pivoting.
              11                     !
              12                     !
              13                     ! usage                  call invmtx (a,na,v,nv,n,d,ip,ier)
              14                     !
              15                     ! arguments
              16                     !
              17                     ! on input               a
              18                     !                          a two-dimensional variable with row dimension
              19                     !                          na and column dimension n.  on input, a
              20                     !                          contains the elements of the matrix to be
              21                     !                          inverted.
              22                     !
              23                     !                        na
              24                     !                          an integer input variable set equal to the
              25                     !                          row dimension of a as declared in the
              26                     !                          dimension statement of the calling program.
              27                     !
              28                     !                        nv
              29                     !                          an integer input variable set equal to the
              30                     !                          row dimension of v as declared in the
              31                     !                          dimension statement of the calling program.
              32                     !
              33                     !                        n
              34                     !                          an integer input variable set equal to the
              35                     !                          column dimension of a.
              36                     !
              37                     !                        ip
              38                     !                          an integer array used internally for working
              39                     !                          storage.  it must have dimension at least
              40                     !                          2*n.
              41                     !
              42                     ! on output              v
              43                     !                          a two-dimensional variable with row dimension
              44                     !                          nv and column dimension n.  on output, v
              45                     !                          contains the inverse of a.
              46                     !                               if a is entered twice in the parameter
              47                     !                               list, replacing v, then on output the
              48                     !                               array a will contain the inverse matrix,
              49                     !                               and the original a will be destroyed.
              50                     !
              51                     !                        d
              52                     !                          a real variable which on output contains the
              53                     !                          determinant of a.
              54                     !
              55                     !                        ier
              56                     !                          an integer error flag.
              57                     !                            = 33  if the matrix a is singular.
              58                     !                            =  0  otherwise.
              59                     !
              60                     ! entry points           invmtx
              61                     !
              62                     ! common blocks          none
              63                     !
              64                     ! i/o                    if the
              65                     !                        matrix a has a zero pivot element (i.e., a is

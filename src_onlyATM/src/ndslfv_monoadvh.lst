 External subroutine subprogram "ndslfv_monoadvh2_fgnl_xy"
  (inc)(line-no.)(nest)(optimize)
            2144                     ! ------------------------------
            2145                           subroutine ndslfv_monoadvh2_fgnl_xy(vdzonl,vdmerd,ddtemp    &
            2146                                     , lonsperlat,deltim,levs,nvars)
            2147                     !
            2148                     ! a routine to do non-iteration semi-Lagrangain advection
            2149                     ! considering advection  with monotonicity in interpolation
            2150                     ! contact: hann-ming henry juang
            2151                     ! program log
            2152                     ! 2011 02 20 : henry juang, created for ndsl advection
            2153                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            2154                     !
            2155                           use param
            2156                           use grid
            2157                           use index
            2158                           use const
            2159                           use rank
            2160                     
            2161                           implicit none
            2162                     
            2163                           integer nvars
            2164                           real(kind=RTYPE) ddtemp(nx,levs,my_max)
            2165                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            2166                           integer,intent(in):: lonsperlat(my)
            2167                           real(kind=RTYPE),   intent(in):: deltim
            2168                     
            2169                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            2170                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            2171                           real(kind=RTYPE)      qqlon(lonfull,levs*nvars,latpart)
            2172                     !      real(kind=RTYPE)      rrlon(lonfull,levs*nvars,latpart)
            2173                     
            2174                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            2175                           real(kind=RTYPE)      qqlat(latfull,levs*nvars,lonpart)
            2176                     !      real(kind=RTYPE)      rrlat(latfull,levs*nvars,lonpart)
            2177                           real(kind=RTYPE)      xr    (lonfull,levs)
            2178                           real(kind=RTYPE)      xcp   (lonfull,levs)
            2179                           real(kind=RTYPE)      sumrq (lonfull,levs)
            2180                           real(kind=RTYPE)      xkappa(lonfull,levs)
            2181                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            2182                     
            2183                     !      logical   lprint
            2184                     
            2185                           integer mono,mass,levs
            2186                           integer nlevs!,levh
            2187                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            2188                           integer kuu, kvv, ktt, kup, nqq
            2189                           integer ku , kv , kt,  kp
            2190                     !
            2191                     !      lprint = .false.
            2192                     
            2193                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            2194                     !
            2195                           mono  = 1
            2196                           mass  = 0
            2197                           cons0 = 0.0
            2198                           cons1 = 1.0
            2199                     !
            2200                     !      levh = ncld * lev
            2201                     !
            2202                     !      kuu = 1
            2203                     !      kvv = kuu + lev
            2204                     !      kuu = kvv + lev
            2205                           kuu = 1
            2206                           kvv = kuu + levs
            2207                           ktt = kvv + levs
            2208                           kup = ktt + levs
            2209                     
            2210                     !      nvars = 3
            2211                           nlevs = nvars * levs
            2212                     !
            2213                           rdt2 = 0.5 / deltim
            2214                     !
            2215                     ! =================================================================
            2216                     !   prepare wind and variable in flux form with gaussina weight
            2217                     ! =================================================================
            2218                     !
            2219                     
            2220                     !$omp parallel do                                                      &
            2221                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kv,ku,kt) &
            2222                     !$omp schedule(dynamic)
            2223     1   p                 do lan=1,jlistnum
            2224     1               
            2225     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            2226     1   p                   lat = jlist1(lan)
            2227     1   p                   lons_lat = lonsperlat(lat)
            2228     1               !        rma  = 1. / cosglat(lat) / con_rerth
            2229     1               !        rm2a = rma / cosglat(lat)
            2230     1   p                   rma  = 1. / cosl(lat)
            2231     1   p                   rm2a = rma / cosl(lat)
            2232     1               !
            2233     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            2234     2   p                   do k=1,levs
            2235     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            2236     3   p   2v                do i=1,lons_lat
            2237     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            2238     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            2239     3               !hmhj use real(kind=RTYPE) wind
            2240     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            2241     3               !hmhj use virtual wind
            2242     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            2243     3               !for CWB GFS
            2244     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            2245     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            2246     3   p   2v                enddo
            2247     2   p                   enddo
            2248     1               !        if( lprint ) then
            2249     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            2250     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            2251     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            2252     1               !        endif
            2253     1               !
            2254     1               ! u v t at n-1
            2255     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            2256     2   p                   do k=1,levs
            2257     2   p                     ku=kuu+k-1
            2258     2   p                     kv=kvv+k-1
            2259     2   p                     kt=ktt+k-1
            2260     2   p                     kk=levs-k+1
            2261     2               !ch>
            2262     2               !       KL=lev-Llist(k)+1
            2263     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            2264     3   p    v                do i=1,lons_lat
            2265     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            2266     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            2267     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            2268     3               !!            qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            2269     3               
            2270     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            2271     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            2272     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,k,lan)
            2273     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            2274     3   p    v                enddo
            2275     2   p                   enddo
            2276     1               ! add surface pressure perturbation for removing resonance
            2277     1               !       rkt = con_g / ( con_rd * 300.0 )
            2278     1               !       do i=1,lons_lat
            2279     1               !         ilan=i+jlonf
            2280     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
            2281     1               !       enddo
            2282     1               !
            2283     1               ! save qqlon into n+1 for later as tendency
            2284     1               ! z d t at n+1
            2285     1               !        do k=1,lev
            2286     1               !          kk=lev-k+1
            2287     1               !          ku=kuu+k-1
            2288     1               !          kv=kvv+k-1
            2289     1               !          kt=ktt+k-1
            2290     1               !          kug=g_d+k-1
            2291     1               !          kvg=g_z+k-1
            2292     1               !          ktg=g_t+k-1
            2293     1               !          do i=1,lons_lat
            2294     1               !            ilan=i+jlonf
            2295     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
            2296     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
            2297     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
            2298     1               !          enddo
            2299     1               !        enddo
            2300     1               ! change h to theta
            2301     1               !
            2302     1               ! ----- prepare xr, xcp, xkapa
            2303     1               !
            2304     1               !       xr    = cons0
            2305     1               !       xcp   = cons0
            2306     1               !       sumrq = cons0
            2307     1               !
            2308     1               !       do n=1,ntrac
            2309     1               !         nqq = kqq + (n-1)*levs
            2310     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
            2311     1               !           do k=1,lev
            2312     1               !             kq=nqq+k-1
            2313     1               !             do i=1,lons_lat
            2314     1               !               xr   (i,k) = xr   (i,k) + qqlon(i,kq,lan)*ri(n)
            2315     1               !               xcp  (i,k) = xcp  (i,k) + qqlon(i,kq,lan)*cpi(n)
            2316     1               !               sumrq(i,k) = sumrq(i,k) + qqlon(i,kq,lan)
            2317     1               !             enddo
            2318     1               !           enddo
            2319     1               !         endif
            2320     1               !       enddo
            2321     1               !       do k=1,lev
            2322     1               !         do i=1,lons_lat
            2323     1               !           xr (i,k)   = ( cons1 - sumrq(i,k) )*ri(0)  + xr (i,k)
            2324     1               !           xcp(i,k)   = ( cons1 - sumrq(i,k) )*cpi(0) + xcp(i,k)
            2325     1               !           xkappa(i,k) = xr(i,k) / xcp(i,k)
            2326     1               !         enddo
            2327     1               !       enddo
            2328     1               !
            2329     1               !       do k=1,lev
            2330     1               !         kt=ktt+k-1
            2331     1               !         ku=kuu+k-1
            2332     1               !         do i=1,lons_lat
            2333     1               !           pi = (qqlon(i,ku,lan)*0.005)**xkappa(i,k)
            2334     1               !           qqlon(i,kt,lan) = qqlon(i,kt,lan)/pi
            2335     1               !         enddo
            2336     1               !       enddo
            2337     1               !
            2338     1               ! rq  no need for tendency
            2339     1               !
            2340     1               !        if( lprint ) then
            2341     1               !        print *,' ------------------------------------------- '
            2342     1               !        ilan=1+jlonf
            2343     1               !        call mymaxmin(grid_gr(ilan,g_ttm),lons_lat,lonfull,1,' n-1 t ')

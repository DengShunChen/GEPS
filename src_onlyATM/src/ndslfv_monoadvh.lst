 External subroutine subprogram "ndslfv_monoadvh2_yx"
  (inc)(line-no.)(nest)(optimize)
            1108                     !
            1109                     !
            1110                           subroutine ndslfv_monoadvh2_yx(ddtemp,qvadv,pten,vdzonl,vdmerd  &
            1111                                     , lonsperlat,deltim,levs)
            1112                     !
            1113                     ! a routine to do non-iteration semi-Lagrangain advection
            1114                     ! considering advection  with monotonicity in interpolation
            1115                     ! contact: hann-ming henry juang
            1116                     ! program log
            1117                     ! 2011 02 20 : henry juang, created for ndsl advection
            1118                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            1119                     !
            1120                           use param
            1121                           use grid
            1122                           use index
            1123                           use const
            1124                           use rank
            1125                     
            1126                           implicit none
            1127                     
            1128                           real(kind=RTYPE) pten(nx,levs,my_max)
            1129                           real(kind=RTYPE) ddtemp(nx,levs,my_max),qvadv(nx,levs,ncld,my_max)
            1130                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            1131                     !      real(kind=RTYPE) plev(lonfull,levs+1)
            1132                     !      integer,intent(in):: global_lats_a(my)
            1133                           integer,intent(in):: lonsperlat(my)
            1134                           real(kind=RTYPE),   intent(in):: deltim
            1135                     
            1136                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            1137                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            1138                           real(kind=RTYPE)      qqlon(lonfull,levs*ndslhvar,latpart)
            1139                     !      real(kind=RTYPE)      rrlon(lonfull,levs*ndslhvar,latpart)
            1140                     
            1141                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            1142                           real(kind=RTYPE)      qqlat(latfull,levs*ndslhvar,lonpart)
            1143                     !      real(kind=RTYPE)      rrlat(latfull,levs*ndslhvar,lonpart)
            1144                           real(kind=RTYPE)      xr    (lonfull,levs)
            1145                           real(kind=RTYPE)      xcp   (lonfull,levs)
            1146                           real(kind=RTYPE)      sumrq (lonfull,levs)
            1147                           real(kind=RTYPE)      xkappa(lonfull,levs)
            1148                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            1149                     
            1150                     !      logical   lprint
            1151                     
            1152                           integer mono,mass,levs
            1153                           integer nlevs,nvars!,levh
            1154                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            1155                           integer kuu, kvv, kqq, ktt, kup, nqq
            1156                           integer ku , kv , kq , kt , kp
            1157                     !
            1158                     !      lprint = .false.
            1159                     
            1160                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            1161                     !
            1162                           mono  = 1
            1163                           mass  = 0
            1164                           cons0 = 0.0
            1165                           cons1 = 1.0
            1166                     !
            1167                     !      levh = ncld * levs
            1168                     !
            1169                     !      kuu = 1
            1170                     !      kvv = kuu + levs
            1171                     !      kuu = kvv + levs
            1172                           kuu = 1
            1173                           kvv = kuu + levs
            1174                           ktt = kvv + levs
            1175                           kup = ktt + levs
            1176                     !!      kqq = kup + levs
            1177                           kqq = ktt + levs
            1178                     
            1179                           nvars = ndslhvar
            1180                           nlevs = nvars * levs
            1181                     !
            1182                           rdt2 = 0.5 / deltim
            1183                     !
            1184                     ! =================================================================
            1185                     !   prepare wind and variable in flux form with gaussina weight
            1186                     ! =================================================================
            1187                     !
            1188                     
            1189                     !$omp parallel do                                                      &
            1190                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kt,kv,ku,kp,kq) &
            1191                     !$omp schedule(dynamic)
            1192     1   p                 do lan=1,jlistnum
            1193     1               
            1194     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            1195     1   p                   lat = jlist1(lan)
            1196     1   p                   lons_lat = lonsperlat(lat)
            1197     1               !        rma  = 1. / cosglat(lat) / con_rerth
            1198     1               !        rm2a = rma / cosglat(lat)
            1199     1   p                   rma  = 1. / cosl(lat)
            1200     1   p                   rm2a = rma / cosl(lat)
            1201     1               !
            1202     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            1203     2   p                   do k=1,levs
            1204     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            1205     3   p   2v                do i=1,lons_lat
            1206     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            1207     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            1208     3               !hmhj use real(kind=RTYPE) wind
            1209     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            1210     3               !hmhj use virtual wind
            1211     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            1212     3               !for CWB GFS
            1213     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            1214     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            1215     3   p   2v                enddo
            1216     2   p                   enddo
            1217     1               !        if( lprint ) then
            1218     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            1219     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            1220     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            1221     1               !        endif
            1222     1               !
            1223     1               ! u v t at n-1
            1224     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            1225     2   p                   do k=1,levs
            1226     2   p                     ku=kuu+k-1
            1227     2   p                     kv=kvv+k-1
            1228     2   p                     kt=ktt+k-1
            1229     2   p                     kp=kup+k-1
            1230     2   p                     kk=levs-k+1
            1231     2               !ch>
            1232     2               !       KL=lev-Llist(k)+1
            1233     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            1234     3   p    v                do i=1,lons_lat
            1235     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            1236     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            1237     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            1238     3               !!          qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            1239     3               
            1240     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            1241     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            1242     3   p    v                  qqlon(i,kt,lan) = ddtemp(i,k,lan)
            1243     3               !!            qqlon(i,kp,lan) = pten(i,k,lan)
            1244     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            1245     3   p    v                enddo
            1246     2   p                   enddo
            1247     1               ! rq at n-1
            1248     2   p                   do n=1,ncld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvadv, qqlon
                                   <<< Loop-information  End >>>
            1249     3   p                   do k=1,levs
            1250     3   p                     kq=kqq+k-1+(n-1)*levs
            1251     3   p                     kk=levs-k+1+(n-1)*levs
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qvadv, qqlon
                                   <<< Loop-information  End >>>
            1252     4   p   2v                do i=1,lons_lat
            1253     4               !ch         qqlon(i,kq,lan) = qm(i,kk,lan)
            1254     4   p   2v                  qqlon(i,kq,lan) = qvadv(i,k,n,lan)
            1255     4   p   2v                enddo
            1256     3   p                   enddo
            1257     2   p                   enddo
            1258     1               ! add surface pressure perturbation for removing resonance
            1259     1               !       rkt = con_g / ( con_rd * 300.0 )
            1260     1               !       do i=1,lons_lat
            1261     1               !         ilan=i+jlonf
            1262     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
            1263     1               !       enddo
            1264     1               !
            1265     1               ! save qqlon into n+1 for later as tendency
            1266     1               ! z d t at n+1
            1267     1               !        do k=1,levs
            1268     1               !          kk=levs-k+1
            1269     1               !          ku=kuu+k-1
            1270     1               !          kv=kvv+k-1
            1271     1               !          kt=ktt+k-1
            1272     1               !          kug=g_d+k-1
            1273     1               !          kvg=g_z+k-1
            1274     1               !          ktg=g_t+k-1
            1275     1               !          do i=1,lons_lat
            1276     1               !            ilan=i+jlonf
            1277     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
            1278     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
            1279     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
            1280     1               !          enddo
            1281     1               !        enddo
            1282     1               ! change h to theta
            1283     1               !
            1284     1               ! ----- prepare xr, xcp, xkapa
            1285     1               !
            1286     1               !       xr    = cons0
            1287     1               !       xcp   = cons0
            1288     1               !       sumrq = cons0
            1289     1               !
            1290     1               !       do n=1,ntrac
            1291     1               !         nqq = kqq + (n-1)*levs
            1292     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
            1293     1               !           do k=1,levs
            1294     1               !             kq=nqq+k-1
            1295     1               !             do i=1,lons_lat
            1296     1               !               xr   (i,k) = xr   (i,k) + qqlon(i,kq,lan)*ri(n)
            1297     1               !               xcp  (i,k) = xcp  (i,k) + qqlon(i,kq,lan)*cpi(n)
            1298     1               !               sumrq(i,k) = sumrq(i,k) + qqlon(i,kq,lan)
            1299     1               !             enddo
            1300     1               !           enddo
            1301     1               !         endif
            1302     1               !       enddo
            1303     1               !       do k=1,levs
            1304     1               !         do i=1,lons_lat
            1305     1               !           xr (i,k)   = ( cons1 - sumrq(i,k) )*ri(0)  + xr (i,k)
            1306     1               !           xcp(i,k)   = ( cons1 - sumrq(i,k) )*cpi(0) + xcp(i,k)
            1307     1               !           xkappa(i,k) = xr(i,k) / xcp(i,k)
            1308     1               !         enddo
            1309     1               !       enddo
            1310     1               !
            1311     1               !       do k=1,levs
            1312     1               !         kt=ktt+k-1
            1313     1               !         ku=kuu+k-1
            1314     1               !         do i=1,lons_lat
            1315     1               !           pi = (qqlon(i,ku,lan)*0.005)**xkappa(i,k)
            1316     1               !           qqlon(i,kt,lan) = qqlon(i,kt,lan)/pi
            1317     1               !         enddo
            1318     1               !       enddo
            1319     1               !
            1320     1               ! rq  no need for tendency
            1321     1               !
            1322     1               !        if( lprint ) then
            1323     1               !        print *,' ------------------------------------------- '
            1324     1               !        ilan=1+jlonf
            1325     1               !        call mymaxmin(grid_gr(ilan,g_ttm),lons_lat,lonfull,1,' n-1 t ')
            1326     1               !        call mymaxmin(grid_gr(ilan,g_rrm ),lons_lat,lonfull,1,' n-1 q ')
            1327     1               !        call mymaxmin(grid_gr(ilan,g_zem),lons_lat,lonfull,1,' n-1 z ')
            1328     1               !        call mymaxmin(grid_gr(ilan,g_dim),lons_lat,lonfull,1,' n-1 d ')
            1329     1               !        print *,' ------------------------------------------- '
            1330     1               !        call mymaxmin(qqlon(1,ktt,lan),lons_lat,lonfull,1,' red t ')
            1331     1               !        call mymaxmin(qqlon(1,kqq,lan),lons_lat,lonfull,1,' red q ')
            1332     1               !        call mymaxmin(qqlon(1,kvv,lan),lons_lat,lonfull,1,' red z ')
            1333     1               !        call mymaxmin(qqlon(1,kuu,lan),lons_lat,lonfull,1,' red d ')
            1334     1               !        endif
            1335     1               
            1336     1               !       call cyclic_cell_intpx(levs,lons_lat,lonf,uulon(1,1,lan))
            1337     1               
            1338     1               !        if( lprint ) then
            1339     1               !        print *,' ------------------------------------------- '
            1340     1               !        call mymaxmin(qqlon(1,ktt,lan),lonfull,lonfull,1,' full t ')
            1341     1               !        call mymaxmin(qqlon(1,kqq,lan),lonfull,lonfull,1,' full q ')
            1342     1               !        call mymaxmin(qqlon(1,kvv,lan),lonfull,lonfull,1,' full z ')
            1343     1               !        call mymaxmin(qqlon(1,kuu,lan),lonfull,lonfull,1,' full d ')
            1344     1               !        endif
            1345     1               
            1346     1               !!        rrlon(:,:,lan) = qqlon(:,:,lan)
            1347     1               !
            1348     1               ! first set positive advection in east-west direction
            1349     1               !
            1350     1               !!        call cyclic_cell_massadvx(lons_lat,lonfull,lev,nvars,deltim,   &
            1351     1               !!                         uulon(1,1,lan),qqlon(1,1,lan),mass)
            1352     1               !       call cyclic_mono_advectx (lonfull,lev,nvars,deltim,               &
            1353     1               !    &                   uulon(1,1,lan),rrlon(1,1,lan),mono)
            1354     1               
            1355     1               !!        call cyclic_cell_intpx(nlevs,lons_lat,lonfull,rrlon(1,1,lan))
            1356     1   p                   call cyclic_cell_intpx(nlevs,lons_lat,lonfull,qqlon(1,1,lan))
            1357     1   p                   call cyclic_cell_intpx(levs,lons_lat,lonfull,vvlon(1,1,lan))
            1358     1               
            1359     1               !        if( lprint ) then
            1360     1               !        print *,' done cyclic_massadvx with mass= ',mass
            1361     1               !        print *,' ------------------------------------------- '
            1362     1               !        call mymaxmin(rrlon(1,ktt,lan),lonfull,lonfull,1,' advx t ')
            1363     1               !        call mymaxmin(rrlon(1,kqq,lan),lonfull,lonfull,1,' advx q ')
            1364     1               !        call mymaxmin(rrlon(1,kvv,lan),lonfull,lonfull,1,' advx z ')
            1365     1               !        call mymaxmin(rrlon(1,kuu,lan),lonfull,lonfull,1,' advx d ')
            1366     1               !        print *,' done the first x adv for lan=',lan
            1367     1               !        print *,' =========================================== '
            1368     1               !        endif
            1369     1               
            1370     1   p                 enddo
            1371                     !$omp end parallel do
            1372                     
            1373                     ! ---------------------------------------------------------------------
            1374                     ! mpi para from east-west full grid to north-south full grid
            1375                     ! ---------------------------------------------------------------------
            1376                     !
            1377                     ! para vvlon, qqlon, and rrlon to vvlat, qqlat, rrlat
            1378                     !       if( lprint ) print *,' ndslfv_advect transport from we to ns '
            1379                     
            1380                            call para_we2ns(vvlon,vvlat,levs,my)
            1381                     !!       call para_we2ns(rrlon,rrlat,nlevs,my)
            1382                            call para_we2ns(qqlon,qqlat,nlevs,my)
            1383                     
            1384                     !       if( lprint ) then
            1385                     !       print *,' ------------ after we2ns ---------------------- '
            1386                     !       do lon=1,mylonlen
            1387                     !        print *,'  lon=',lon
            1388                     !        call mymaxmin(vvlat(1,1  ,lon),latfull,latfull,1,' we2ns v')
            1389                     !        call mymaxmin(rrlat(1,kqq,lon),latfull,latfull,1,' we2ns r')
            1390                     !        call mymaxmin(qqlat(1,kqq,lon),latfull,latfull,1,' we2ns q')
            1391                     !       enddo
            1392                     !       endif
            1393                     !
            1394                     ! ---------------------------------------------------------------------
            1395                     ! -------------- in north-soutn great circle -------------------
            1396                     ! ---------------------------------------------------------------------
            1397                     
            1398                     !      if ( myrank .eq. 0 ) lprint = .true.
            1399                     !       if( lprint ) then
            1400                     !       print *,' ndslfv_advect adv loop in y '
            1401                     !       print *,' mylonlen=',mylonlen
            1402                     !       endif
            1403                     
            1404                     !$omp parallel do private(lon,k,j,ku,kv) &
            1405                     !$omp schedule(dynamic)
            1406     1   p                  do lon=1,mylonlen
            1407     1               !
            1408     1               !        if( lprint ) print *,' lon=',lon
            1409     1               ! convert wind before advy
            1410     2   p                   do k=1,levs
            1411     2   p                     ku=kuu+k-1
            1412     2   p                     kv=kvv+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlat
                                   <<< Loop-information  End >>>
            1413     3   p   2v                do j=1,lathalf
            1414     3   p   2v                  qqlat(j,ku,lon) = -qqlat(j,ku,lon)
            1415     3   p   2v                  qqlat(j,kv,lon) = -qqlat(j,kv,lon)
            1416     3   p   2v                enddo
            1417     2   p                   enddo
            1418     1               
            1419     1               ! first set advection in north-south direction in great circle through two poles
            1420     1               !
            1421     1               !!        call fixend_cell_massadvy(latfull,lathalf,lev,nvars,deltim, &
            1422     1               !!                         vvlat(1,1,lon),rrlat(1,1,lon),mass)
            1423     1               !       call cyclic_cell_massadvy(latfull,lev,nvars,deltim,
            1424     1               !    &                   vvlat(1,1,lon),rrlat(1,1,lon),mass)
            1425     1               !       call cyclic_mono_advecty (latfull,lev,nvars,deltim,
            1426     1               !    &                   vvlat(1,1,lon),rrlat(1,1,lon),mono)
            1427     1               
            1428     1               !        if( lprint ) then
            1429     1               !        print *,' ------------------------------------------- '
            1430     1               !        call mymaxmin(rrlat(1,kuu,lon),latfull,latfull,1,' advry u ')
            1431     1               !        call mymaxmin(rrlat(1,kvv,lon),latfull,latfull,1,' advry v ')
            1432     1               !        call mymaxmin(rrlat(1,ktt,lon),latfull,latfull,1,' advry t ')
            1433     1               !        call mymaxmin(rrlat(1,kqq,lon),latfull,latfull,1,' advry q ')
            1434     1               !        call mymaxmin(rrlat(1,kvv,lon),latfull,latfull,1,' advry z ')

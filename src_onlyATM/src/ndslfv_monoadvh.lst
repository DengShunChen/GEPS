 External subroutine subprogram "ndslfv_monoadvh2"
  (inc)(line-no.)(nest)(optimize)
              43                     !
              44                           subroutine ndslfv_monoadvh2(ddtemp,qvadv,pten,vdzonl,vdmerd    &
              45                                     , lonsperlat,deltim,levs)
              46                     !
              47                     ! a routine to do non-iteration semi-Lagrangain advection
              48                     ! considering advection  with monotonicity in interpolation
              49                     ! contact: hann-ming henry juang
              50                     ! program log
              51                     ! 2011 02 20 : henry juang, created for ndsl advection
              52                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
              53                     !
              54                           use param
              55                           use grid
              56                           use index
              57                           use const
              58                           use rank
              59                     
              60                           implicit none
              61                     
              62                           real(kind=RTYPE) pten(nx,levs,my_max)
              63                           real(kind=RTYPE) ddtemp(nx,levs,my_max),qvadv(nx,levs,ncld,my_max)
              64                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
              65                     !      real(kind=RTYPE) plev(lonfull,lev+1)
              66                     !      integer,intent(in):: global_lats_a(my)
              67                           integer,intent(in):: lonsperlat(my)
              68                           real(kind=RTYPE),   intent(in):: deltim
              69                     
              70                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
              71                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
              72                           real(kind=RTYPE)      qqlon(lonfull,levs*ndslhvar,latpart)
              73                           real(kind=RTYPE)      rrlon(lonfull,levs*ndslhvar,latpart)
              74                     
              75                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
              76                           real(kind=RTYPE)      qqlat(latfull,levs*ndslhvar,lonpart)
              77                           real(kind=RTYPE)      rrlat(latfull,levs*ndslhvar,lonpart)
              78                           real(kind=RTYPE)      xr    (lonfull,levs)
              79                           real(kind=RTYPE)      xcp   (lonfull,levs)
              80                           real(kind=RTYPE)      sumrq (lonfull,levs)
              81                           real(kind=RTYPE)      xkappa(lonfull,levs)
              82                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
              83                     
              84                     !      logical   lprint
              85                     
              86                           integer mono,mass,levs
              87                           integer nlevs,nvars!,levh
              88                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
              89                           integer kuu, kvv, kqq, ktt, kup, nqq
              90                           integer ku , kv , kq , kt , kp
              91                     !
              92                     !      lprint = .false.
              93                     
              94                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
              95                     !
              96                           mono  = 1
              97                           mass  = 0
              98                           cons0 = 0.0
              99                           cons1 = 1.0
             100                     !
             101                     !      levh = ncld * lev
             102                     !
             103                     !      kuu = 1
             104                     !      kvv = kuu + lev
             105                     !      kuu = kvv + lev
             106                           kuu = 1
             107                           kvv = kuu + levs
             108                           ktt = kvv + levs
             109                           kup = ktt + levs
             110                     !!      kqq = kup + levs
             111                           kqq = ktt + levs
             112                     
             113                           nvars = ndslhvar
             114                           nlevs = nvars * levs
             115                     !
             116                           rdt2 = 0.5 / deltim
             117                     !
             118                     ! =================================================================
             119                     !   prepare wind and variable in flux form with gaussina weight
             120                     ! =================================================================
             121                     !
             122                     
             123                     !$omp parallel do                                                      &
             124                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kt,kv,ku,kp,kq) &
             125                     !$omp schedule(dynamic)
             126     1   p                 do lan=1,jlistnum
             127     1               
             128     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
             129     1   p                   lat = jlist1(lan)
             130     1   p                   lons_lat = lonsperlat(lat)
             131     1               !        rma  = 1. / cosglat(lat) / con_rerth
             132     1               !        rm2a = rma / cosglat(lat)
             133     1   p                   rma  = 1. / cosl(lat)
             134     1   p                   rm2a = rma / cosl(lat)
             135     1               !
             136     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
             137     2   p                   do k=1,levs
             138     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
             139     3   p   2v                do i=1,lons_lat
             140     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
             141     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
             142     3               !hmhj use real(kind=RTYPE) wind
             143     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
             144     3               !hmhj use virtual wind
             145     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
             146     3               !for CWB GFS
             147     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
             148     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
             149     3   p   2v                enddo
             150     2   p                   enddo
             151     1               !        if( lprint ) then
             152     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
             153     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
             154     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
             155     1               !        endif
             156     1               !
             157     1               ! u v t at n-1
             158     1               !

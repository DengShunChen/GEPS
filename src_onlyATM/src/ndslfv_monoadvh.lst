 External subroutine subprogram "ndslfv_monoadvh2_xy"
  (inc)(line-no.)(nest)(optimize)
             577                     !
             578                     !
             579                           subroutine ndslfv_monoadvh2_xy(ddtemp,qvadv,pten,vdzonl,vdmerd  &
             580                                     , lonsperlat,deltim,levs)
             581                     !
             582                     ! a routine to do non-iteration semi-Lagrangain advection
             583                     ! considering advection  with monotonicity in interpolation
             584                     ! contact: hann-ming henry juang
             585                     ! program log
             586                     ! 2011 02 20 : henry juang, created for ndsl advection
             587                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
             588                     !
             589                           use param
             590                           use grid
             591                           use index
             592                           use const
             593                           use rank
             594                     
             595                           implicit none
             596                     
             597                           real(kind=RTYPE) pten(nx,levs,my_max)
             598                           real(kind=RTYPE) ddtemp(nx,levs,my_max),qvadv(nx,levs,ncld,my_max)
             599                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
             600                     !      real(kind=RTYPE) plev(lonfull,lev+1)
             601                     !      integer,intent(in):: global_lats_a(my)
             602                           integer,intent(in):: lonsperlat(my)
             603                           real(kind=RTYPE),   intent(in):: deltim
             604                     
             605                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
             606                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
             607                           real(kind=RTYPE)      qqlon(lonfull,levs*ndslhvar,latpart)
             608                     !      real(kind=RTYPE)      rrlon(lonfull,lev*ndslhvar,latpart)
             609                     
             610                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
             611                           real(kind=RTYPE)      qqlat(latfull,levs*ndslhvar,lonpart)
             612                     !      real(kind=RTYPE)      rrlat(latfull,levs*ndslhvar,lonpart)
             613                           real(kind=RTYPE)      xr    (lonfull,levs)
             614                           real(kind=RTYPE)      xcp   (lonfull,levs)
             615                           real(kind=RTYPE)      sumrq (lonfull,levs)
             616                           real(kind=RTYPE)      xkappa(lonfull,levs)
             617                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
             618                     
             619                     !      logical   lprint
             620                     
             621                           integer mono,mass,levs
             622                           integer nlevs,nvars!,levh

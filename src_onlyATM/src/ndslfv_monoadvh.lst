             159     2   p                   do k=1,levs
             160     2   p                     ku=kuu+k-1
             161     2   p                     kv=kvv+k-1
             162     2   p                     kt=ktt+k-1
             163     2   p                     kp=kup+k-1
             164     2   p                     kk=levs-k+1
             165     2               !ch>
             166     2               !       KL=lev-Llist(k)+1
             167     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
             168     3   p    v                do i=1,lons_lat
             169     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
             170     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
             171     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
             172     3               !!            qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)

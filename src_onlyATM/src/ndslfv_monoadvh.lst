 External subroutine subprogram "ndslfv_monoadvh2_fgnl_yx"
  (inc)(line-no.)(nest)(optimize)
            2649                     ! ------------------------------
            2650                           subroutine ndslfv_monoadvh2_fgnl_yx(vdzonl,vdmerd,ddtemp    &
            2651                                     , lonsperlat,deltim,levs,nvars)
            2652                     !
            2653                     ! a routine to do non-iteration semi-Lagrangain advection
            2654                     ! considering advection  with monotonicity in interpolation
            2655                     ! contact: hann-ming henry juang
            2656                     ! program log
            2657                     ! 2011 02 20 : henry juang, created for ndsl advection
            2658                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            2659                     !
            2660                           use param
            2661                           use grid
            2662                           use index
            2663                           use const
            2664                           use rank
            2665                     
            2666                           implicit none
            2667                     
            2668                           integer nvars
            2669                           real(kind=RTYPE) ddtemp(nx,levs,my_max)
            2670                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            2671                           integer,intent(in):: lonsperlat(my)
            2672                           real(kind=RTYPE),   intent(in):: deltim
            2673                     
            2674                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            2675                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            2676                           real(kind=RTYPE)      qqlon(lonfull,levs*nvars,latpart)
            2677                     !      real(kind=RTYPE)      rrlon(lonfull,levs*nvars,latpart)
            2678                     
            2679                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            2680                           real(kind=RTYPE)      qqlat(latfull,levs*nvars,lonpart)
            2681                     !      real(kind=RTYPE)      rrlat(latfull,levs*nvars,lonpart)
            2682                           real(kind=RTYPE)      xr    (lonfull,levs)
            2683                           real(kind=RTYPE)      xcp   (lonfull,levs)
            2684                           real(kind=RTYPE)      sumrq (lonfull,levs)
            2685                           real(kind=RTYPE)      xkappa(lonfull,levs)
            2686                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            2687                     
            2688                     !      logical   lprint
            2689                     
            2690                           integer mono,mass,levs
            2691                           integer nlevs!,levh
            2692                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            2693                           integer kuu, kvv, ktt, kup, nqq
            2694                           integer ku , kv , kt,  kp
            2695                     !
            2696                     !      lprint = .false.
            2697                     
            2698                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            2699                     !
            2700                           mono  = 1
            2701                           mass  = 0
            2702                           cons0 = 0.0
            2703                           cons1 = 1.0
            2704                     !
            2705                     !      levh = ncld * lev
            2706                     !
            2707                     !      kuu = 1
            2708                     !      kvv = kuu + lev
            2709                     !      kuu = kvv + lev
            2710                           kuu = 1
            2711                           kvv = kuu + levs
            2712                           ktt = kvv + levs
            2713                           kup = ktt + levs
            2714                     
            2715                     !      nvars = 3
            2716                           nlevs = nvars * levs
            2717                     !
            2718                           rdt2 = 0.5 / deltim
            2719                     !
            2720                     ! =================================================================
            2721                     !   prepare wind and variable in flux form with gaussina weight
            2722                     ! =================================================================
            2723                     !
            2724                     
            2725                     !$omp parallel do                                                      &
            2726                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kv,ku,kt) &
            2727                     !$omp schedule(dynamic)
            2728     1   p                 do lan=1,jlistnum
            2729     1               
            2730     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            2731     1   p                   lat = jlist1(lan)
            2732     1   p                   lons_lat = lonsperlat(lat)
            2733     1               !        rma  = 1. / cosglat(lat) / con_rerth
            2734     1               !        rm2a = rma / cosglat(lat)
            2735     1   p                   rma  = 1. / cosl(lat)
            2736     1   p                   rm2a = rma / cosl(lat)
            2737     1               !
            2738     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            2739     2   p                   do k=1,levs
            2740     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            2741     3   p   2v                do i=1,lons_lat
            2742     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            2743     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            2744     3               !hmhj use real(kind=RTYPE) wind
            2745     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            2746     3               !hmhj use virtual wind
            2747     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            2748     3               !for CWB GFS
            2749     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            2750     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            2751     3   p   2v                enddo
            2752     2   p                   enddo
            2753     1               !        if( lprint ) then
            2754     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            2755     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            2756     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            2757     1               !        endif
            2758     1               !
            2759     1               ! u v t at n-1
            2760     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            2761     2   p                   do k=1,levs
            2762     2   p                     ku=kuu+k-1
            2763     2   p                     kv=kvv+k-1
            2764     2   p                     kt=ktt+k-1
            2765     2   p                     kk=levs-k+1
            2766     2               !ch>
            2767     2               !       KL=lev-Llist(k)+1
            2768     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            2769     3   p    v                do i=1,lons_lat
            2770     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            2771     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            2772     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            2773     3               !!            qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            2774     3               
            2775     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            2776     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            2777     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,k,lan)
            2778     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            2779     3   p    v                enddo
            2780     2   p                   enddo
            2781     1               ! add surface pressure perturbation for removing resonance
            2782     1               !       rkt = con_g / ( con_rd * 300.0 )
            2783     1               !       do i=1,lons_lat
            2784     1               !         ilan=i+jlonf
            2785     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
            2786     1               !       enddo
            2787     1               !
            2788     1               ! save qqlon into n+1 for later as tendency
            2789     1               ! z d t at n+1
            2790     1               !        do k=1,lev
            2791     1               !          kk=lev-k+1
            2792     1               !          ku=kuu+k-1
            2793     1               !          kv=kvv+k-1
            2794     1               !          kt=ktt+k-1
            2795     1               !          kug=g_d+k-1
            2796     1               !          kvg=g_z+k-1
            2797     1               !          ktg=g_t+k-1
            2798     1               !          do i=1,lons_lat
            2799     1               !            ilan=i+jlonf
            2800     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
            2801     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
            2802     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
            2803     1               !          enddo
            2804     1               !        enddo
            2805     1               ! change h to theta
            2806     1               !
            2807     1               ! ----- prepare xr, xcp, xkapa
            2808     1               !
            2809     1               !       xr    = cons0
            2810     1               !       xcp   = cons0
            2811     1               !       sumrq = cons0
            2812     1               !
            2813     1               !       do n=1,ntrac
            2814     1               !         nqq = kqq + (n-1)*levs
            2815     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
            2816     1               !           do k=1,lev
            2817     1               !             kq=nqq+k-1

            1639                     ! ------------------------------
            1640                           subroutine ndslfv_monoadvh2_fgnl(vdzonl,vdmerd,ddtemp    &
            1641                                     , lonsperlat,deltim,levs,nvars)
            1642                     !
            1643                     ! a routine to do non-iteration semi-Lagrangain advection
            1644                     ! considering advection  with monotonicity in interpolation
            1645                     ! contact: hann-ming henry juang
            1646                     ! program log
            1647                     ! 2011 02 20 : henry juang, created for ndsl advection
            1648                     ! 2013 06 20 : Henry Juang correct wind direction for north-south advection
            1649                     !
            1650                           use param
            1651                           use grid
            1652                           use index
            1653                           use const
            1654                           use rank
            1655                     
            1656                           implicit none
            1657                     
            1658                           integer nvars
            1659                           real(kind=RTYPE) ddtemp(nx,levs,my_max)
            1660                           real(kind=RTYPE) vdmerd(nx,levs,my_max),vdzonl(nx,levs,my_max)
            1661                           integer,intent(in):: lonsperlat(my)
            1662                           real(kind=RTYPE),   intent(in):: deltim
            1663                     
            1664                           real(kind=RTYPE)      uulon(lonfull,levs,latpart)
            1665                           real(kind=RTYPE)      vvlon(lonfull,levs,latpart)
            1666                           real(kind=RTYPE)      qqlon(lonfull,levs*nvars,latpart)
            1667                           real(kind=RTYPE)      rrlon(lonfull,levs*nvars,latpart)
            1668                     
            1669                           real(kind=RTYPE)      vvlat(latfull,levs,lonpart)
            1670                           real(kind=RTYPE)      qqlat(latfull,levs*nvars,lonpart)
            1671                           real(kind=RTYPE)      rrlat(latfull,levs*nvars,lonpart)
            1672                           real(kind=RTYPE)      xr    (lonfull,levs)
            1673                           real(kind=RTYPE)      xcp   (lonfull,levs)
            1674                           real(kind=RTYPE)      sumrq (lonfull,levs)
            1675                           real(kind=RTYPE)      xkappa(lonfull,levs)
            1676                           real(kind=RTYPE)      rdt2, rkt, pi, cons0, cons1, rma, rm2a
            1677                     
            1678                     !      logical   lprint
            1679                     
            1680                           integer mono,mass,levs
            1681                           integer nlevs!,levh
            1682                           integer i,j,n,k,lon,lan,lat,lons_lat,irc,kk,KL
            1683                           integer kuu, kvv, ktt, kup, nqq
            1684                           integer ku , kv , kt,  kp
            1685                     !
            1686                     !      lprint = .false.
            1687                     
            1688                     !      if( lprint ) print *,' enter ndslfv_monoadvh '
            1689                     !
            1690                           mono  = 1
            1691                           mass  = 0
            1692                           cons0 = 0.0
            1693                           cons1 = 1.0
            1694                     !
            1695                     !      levh = ncld * lev
            1696                     !
            1697                     !      kuu = 1
            1698                     !      kvv = kuu + lev
            1699                     !      kuu = kvv + lev
            1700                           kuu = 1
            1701                           kvv = kuu + levs
            1702                           ktt = kvv + levs
            1703                           kup = ktt + levs
            1704                     
            1705                     !      nvars = 3
            1706                           nlevs = nvars * levs
            1707                     !
            1708                           rdt2 = 0.5 / deltim
            1709                     !
            1710                     ! =================================================================
            1711                     !   prepare wind and variable in flux form with gaussina weight
            1712                     ! =================================================================
            1713                     !
            1714                     
            1715                     !$omp parallel do                                                      &
            1716                     !$omp private(lan,lat,lons_lat,rma,rm2a,i,n,kk,k,kv,ku,kt) &
            1717                     !$omp schedule(dynamic)
            1718     1   p                 do lan=1,jlistnum
            1719     1               
            1720     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
            1721     1   p                   lat = jlist1(lan)
            1722     1   p                   lons_lat = lonsperlat(lat)
            1723     1               !        rma  = 1. / cosglat(lat) / con_rerth
            1724     1               !        rm2a = rma / cosglat(lat)
            1725     1   p                   rma  = 1. / cosl(lat)
            1726     1   p                   rm2a = rma / cosl(lat)
            1727     1               !
            1728     1               ! wind at time step n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut_sl, vt_sl, uulon, vvlon
                                   <<< Loop-information  End >>>
            1729     2   p                   do k=1,levs
            1730     2   p                     kk=levs-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      uulon, ut_sl, vt_sl, vvlon
                                   <<< Loop-information  End >>>
            1731     3   p   2v                do i=1,lons_lat
            1732     3               !ch         uulon(i,k,lan) = ut(i,kk,lan) * rm2a
            1733     3   p   2v                  uulon(i,k,lan) = ut_sl(i,k ,lan) * rm2a
            1734     3               !hmhj use real(kind=RTYPE) wind
            1735     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) * rma
            1736     3               !hmhj use virtual wind
            1737     3               !            vvlon(i,k,lan) = grid_gr(ilan,kvg) / con_rerth
            1738     3               !for CWB GFS
            1739     3               !ch         vvlon(i,k,lan) = vt(i,kk,lan) * rma
            1740     3   p   2v                  vvlon(i,k,lan) = vt_sl(i,k ,lan) * rma
            1741     3   p   2v                enddo
            1742     2   p                   enddo
            1743     1               !        if( lprint ) then
            1744     1               !          call mymaxmin(uulon(1,1,lan),lons_lat,lonfull,1,' uu1 in deg')
            1745     1               !          call mymaxmin(uulon(1,5,lan),lons_lat,lonfull,1,' uu5 in deg')
            1746     1               !          call mymaxmin(vvlon(1,1,lan),lons_lat,lonfull,1,' vv in deg')
            1747     1               !        endif
            1748     1               !
            1749     1               ! u v t at n-1
            1750     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
            1751     2   p                   do k=1,levs
            1752     2   p                     ku=kuu+k-1
            1753     2   p                     kv=kvv+k-1
            1754     2   p                     kt=ktt+k-1
            1755     2   p                     kk=levs-k+1
            1756     2               !ch>
            1757     2               !       KL=lev-Llist(k)+1
            1758     2               !ch<
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
            1759     3   p    v                do i=1,lons_lat
            1760     3               !ch         qqlon(i,ku,lan) = uum(i,kk,lan)
            1761     3               !ch         qqlon(i,kv,lan) = vvm(i,kk,lan)
            1762     3               !ch         qqlon(i,kt,lan) = ttm(i,kk,lan)
            1763     3               !!            qqlon(i,kp,lan) = dsigma(kk,1)*ptp(i,lan)+dsigma(kk,2)
            1764     3               
            1765     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,k,lan)
            1766     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,k,lan)
            1767     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,k,lan)
            1768     3               !!            qqlon(i,kp,lan) = dsigma(KL,1)*ptp_sl(i,lan)+dsigma(KL,2)
            1769     3   p    v                enddo
            1770     2   p                   enddo
            1771     1               ! add surface pressure perturbation for removing resonance
            1772     1               !       rkt = con_g / ( con_rd * 300.0 )
            1773     1               !       do i=1,lons_lat
            1774     1               !         ilan=i+jlonf
            1775     1               !         qqlon(i,kuu,lan) = log(plev(i,1))+grid_gr(ilan,g_gz)*rkt
            1776     1               !       enddo
            1777     1               !
            1778     1               ! save qqlon into n+1 for later as tendency
            1779     1               ! z d t at n+1
            1780     1               !        do k=1,lev
            1781     1               !          kk=lev-k+1
            1782     1               !          ku=kuu+k-1
            1783     1               !          kv=kvv+k-1
            1784     1               !          kt=ktt+k-1
            1785     1               !          kug=g_d+k-1
            1786     1               !          kvg=g_z+k-1
            1787     1               !          ktg=g_t+k-1
            1788     1               !          do i=1,lons_lat
            1789     1               !            ilan=i+jlonf
            1790     1               !            grid_gr(ilan,kug) = qqlon(i,ku,lan)
            1791     1               !            grid_gr(ilan,kvg) = qqlon(i,kv,lan)
            1792     1               !            grid_gr(ilan,ktg) = qqlon(i,kt,lan)
            1793     1               !          enddo
            1794     1               !        enddo
            1795     1               ! change h to theta
            1796     1               !
            1797     1               ! ----- prepare xr, xcp, xkapa
            1798     1               !
            1799     1               !       xr    = cons0
            1800     1               !       xcp   = cons0
            1801     1               !       sumrq = cons0
            1802     1               !
            1803     1               !       do n=1,ntrac
            1804     1               !         nqq = kqq + (n-1)*levs
            1805     1               !         if( ri(n) .ne. cons0 .and. cpi(n) .ne. cons0 ) then
            1806     1               !           do k=1,lev
            1807     1               !             kq=nqq+k-1
            1808     1               !             do i=1,lons_lat
            1809     1               !               xr   (i,k) = xr   (i,k) + qqlon(i,kq,lan)*ri(n)
            1810     1               !               xcp  (i,k) = xcp  (i,k) + qqlon(i,kq,lan)*cpi(n)
            1811     1               !               sumrq(i,k) = sumrq(i,k) + qqlon(i,kq,lan)
            1812     1               !             enddo
            1813     1               !           enddo
            1814     1               !         endif
            1815     1               !       enddo
            1816     1               !       do k=1,lev
            1817     1               !         do i=1,lons_lat
            1818     1               !           xr (i,k)   = ( cons1 - sumrq(i,k) )*ri(0)  + xr (i,k)
            1819     1               !           xcp(i,k)   = ( cons1 - sumrq(i,k) )*cpi(0) + xcp(i,k)
            1820     1               !           xkappa(i,k) = xr(i,k) / xcp(i,k)
            1821     1               !         enddo
            1822     1               !       enddo
            1823     1               !
            1824     1               !       do k=1,lev
            1825     1               !         kt=ktt+k-1
            1826     1               !         ku=kuu+k-1
            1827     1               !         do i=1,lons_lat
            1828     1               !           pi = (qqlon(i,ku,lan)*0.005)**xkappa(i,k)
            1829     1               !           qqlon(i,kt,lan) = qqlon(i,kt,lan)/pi
            1830     1               !         enddo
            1831     1               !       enddo
            1832     1               !
            1833     1               ! rq  no need for tendency
            1834     1               !
            1835     1               !        if( lprint ) then
            1836     1               !        print *,' ------------------------------------------- '
            1837     1               !        ilan=1+jlonf
            1838     1               !        call mymaxmin(grid_gr(ilan,g_ttm),lons_lat,lonfull,1,' n-1 t ')
            1839     1               !        call mymaxmin(grid_gr(ilan,g_rrm ),lons_lat,lonfull,1,' n-1 q ')
            1840     1               !        call mymaxmin(grid_gr(ilan,g_zem),lons_lat,lonfull,1,' n-1 z ')
            1841     1               !        call mymaxmin(grid_gr(ilan,g_dim),lons_lat,lonfull,1,' n-1 d ')
            1842     1               !        print *,' ------------------------------------------- '
            1843     1               !        call mymaxmin(qqlon(1,ktt,lan),lons_lat,lonfull,1,' red t ')
            1844     1               !        call mymaxmin(qqlon(1,kqq,lan),lons_lat,lonfull,1,' red q ')
            1845     1               !        call mymaxmin(qqlon(1,kvv,lan),lons_lat,lonfull,1,' red z ')
            1846     1               !        call mymaxmin(qqlon(1,kuu,lan),lons_lat,lonfull,1,' red d ')
            1847     1               !        endif
            1848     1               
            1849     1               !       call cyclic_cell_intpx(levs,lons_lat,lonf,uulon(1,1,lan))
            1850     1               
            1851     1               !        if( lprint ) then
            1852     1               !        print *,' ------------------------------------------- '
            1853     1               !        call mymaxmin(qqlon(1,ktt,lan),lonfull,lonfull,1,' full t ')
            1854     1               !        call mymaxmin(qqlon(1,kqq,lan),lonfull,lonfull,1,' full q ')
            1855     1               !        call mymaxmin(qqlon(1,kvv,lan),lonfull,lonfull,1,' full z ')
            1856     1               !        call mymaxmin(qqlon(1,kuu,lan),lonfull,lonfull,1,' full d ')
            1857     1               !        endif
            1858     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, rrlon
                                   <<< Loop-information  End >>>
            1859     1   p   4v              rrlon(:,:,lan) = qqlon(:,:,lan)
            1860     1               !
            1861     1               ! first set positive advection in east-west direction
            1862     1               !
            1863     1   p                   call cyclic_cell_massadvxl(lons_lat,lonfull,levs,nvars,deltim, &
            1864     1                                        uulon(1,1,lan),rrlon(1,1,lan),mass)
            1865     1               !       call cyclic_mono_advectx (lonfull,levs,nvars,deltim,               &
            1866     1               !    &                   uulon(1,1,lan),rrlon(1,1,lan),mono)
            1867     1               
            1868     1   p                   call cyclic_cell_intpxl(nlevs,lons_lat,lonfull,rrlon(1,1,lan))
            1869     1   p                   call cyclic_cell_intpxl(nlevs,lons_lat,lonfull,qqlon(1,1,lan))
            1870     1   p                   call cyclic_cell_intpxl(levs,lons_lat,lonfull,vvlon(1,1,lan))
            1871     1               
            1872     1               !        if( lprint ) then
            1873     1               !        print *,' done cyclic_massadvx with mass= ',mass
            1874     1               !        print *,' ------------------------------------------- '

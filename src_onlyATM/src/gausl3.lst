 External subroutine subprogram "gausl3"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gausl3 (n,xa,xb,wt,ab)
               2                     !
               3                     ! weights and abscissas for nth order gaussian quadrature on (xa,xb).
               4                     ! input arguments
               5                     !
               6                     ! n  -the order desired
               7                     ! xa -the left endpoint of the interval of integration
               8                     ! xb -the right endpoint of the interval of integration
               9                     ! output arguments
              10                     ! ab -the n calculated abscissas
              11                     ! wt -the n calculated weights
              12                     !
              13                     ! modify to f90 by C-H Lee and sort by River Chen in 2015
              14                     !
              15                           use rank
              16                           use const, only: RTYPE
              17                     
              18                           implicit double precision (a-h,o-z)
              19                     !
              20                           real  xa,xb
              21                           real(kind=RTYPE) ab(n),wt(n)
              22                     !
              23                     ! machine dependent constants---
              24                     !  tol - convergence criterion for double precision iteration
              25                     !  pi  - given to 15 significant digits
              26                     !  c1  -  1/8                     these are coefficients in mcmahon"s
              27                     !  c2  -  -31/(2*3*8**2)          expansions of the kth zero of the
              28                     !  c3  -  3779/(2*3*5*8**3)       bessel function j0(x) (cf. abramowitz,
              29                     !  c4  -  -6277237/(3*5*7*8**5)   handbook of mathematical functions).
              30                     !  u   -  (1-(2/pi)**2)/4
              31                     !
              32                     !      data tol/1.d-14/,pi/3.14159265358979/,u/.148678816357662/
              33                           data tol/1.d-14/
              34                           data c1,c2,c3,c4/.125,-.080729166666667,.246028645833333, &
              35                                           -1.82443876720609 /
              36                     !
              37                     ! maximum number of iterations before giving up on convergence
              38                     !
              39                           data maxit /5/
              40                     !
              41                     ! arithmetic statement function for converting integer to double
              42                     !
              43                           dbli(i) = dble(float(i))
              44                     !
              45                           pi = 4.*atan(1.)
              46                           u  = (1-(2/pi)**2)/4.
              47                           ddif = .5d0*(dble(xb)-dble(xa))
              48                           dsum = .5d0*(dble(xb)+dble(xa))
              49                           if (n .gt. 1) go to 101
              50                           ab(1) = 0.
              51                           wt(1) = 2.*ddif
              52                           go to 107
              53                       101 continue
              54                           nnp1 = n*(n+1)
              55                           cond = 1./sqrt((.5+float(n))**2+u)
              56                           lim = n/2
              57                     !
              58     1                     do 105 k=1,lim
              59     1               	 b = (float(k)-.25)*pi
              60     1               	 bisq = 1./(b*b)
              61     1               !
              62     1               ! rootbf approximates the kth zero of the bessel function j0(x)
              63     1               !
              64     1               	 rootbf = b*(1.+bisq*(c1+bisq*(c2+bisq*(c3+bisq*c4))))
              65     1               !
              66     1               !      initial guess for kth root of legendre poly p-sub-n(x)
              67     1               !
              68     1               	 dzero = cos(rootbf*cond)
              69     2               	 do 103 i=1,maxit
              70     2               !
              71     2               	    dpm2 = 1.d0
              72     2               	    dpm1 = dzero
              73     2               !
              74     2               !       recursion relation for legendre polynomials
              75     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.12, ITR: 8, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
              76     3   s   2s      	    do 102 nn=2,n
              77     3   m   2m      		dp = (dbli(2*nn-1)*dzero*dpm1-dbli(nn-1)*dpm2)/dbli(nn)
              78     3   s   2s      		dpm2 = dpm1
              79     3   s   2s      		dpm1 = dp
              80     3   p   2v        102       continue
              81     2               	    dtmp = 1.d0/(1.d0-dzero*dzero)
              82     2               	    dppr = dbli(n)*(dpm2-dzero*dp)*dtmp
              83     2               	    dp2pri = (2.d0*dzero*dppr-dbli(nnp1)*dp)*dtmp
              84     2               	    drat = dp/dppr
              85     2               !
              86     2               !       cubically-convergent iterative improvement of root
              87     2               !
              88     2               	    dzeri = dzero-drat*(1.d0+drat*dp2pri/(2.d0*dppr))
              89     2               	    ddum= dabs(dzeri-dzero)
              90     2               	 if (ddum .le. tol) go to 104
              91     2               	    dzero = dzeri
              92     2                 103    continue
              93     1               !
              94     1               	 if(myrank .eq. 0) print 504
              95     1               !
              96     1                 504    format(1x,' in gausl3, convergence failed')
              97     1                 104    continue
              98     1               	 ddifx = ddif*dzero
              99     1               	 ab(k) = dsum-ddifx
             100     1               	 wt(k) = 2.d0*(1.d0-dzero*dzero)/(dbli(n)*dpm2)**2*ddif
             101     1               	 i = n-k+1
             102     1               	 ab(i) = dsum+ddifx
             103     1               	 wt(i) = wt(k)
             104     1                 105 continue
             105                     !
             106                           if (mod(n,2) .eq. 0) go to 107
             107                           ab(lim+1) = dsum
             108                           nm1 = n-1
             109                           dprod = n
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             110     1  pp    v            do 106 k=1,nm1,2
             111     1   p    v      	 dprod = dbli(nm1-k)*dprod/dbli(n-k)
             112     1   p    v        106 continue
             113                           wt(lim+1) = 2.d0/dprod**2*ddif
             114                       107 return
             115                           end


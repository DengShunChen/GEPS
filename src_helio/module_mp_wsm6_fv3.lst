             714     5   p    v                    qrs(i,k,1) = qrs(i,k,1) - pgmlt(i,k)
             715     5   p    v                    t(i,k) = t(i,k) + xlf/cpm(i,k)*pgmlt(i,k)
             716     5   p    v                    t_tmp(i,k) = t(i,k)

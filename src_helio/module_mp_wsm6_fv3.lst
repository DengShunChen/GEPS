                                   <<<      rainncv, sr
                                   <<< Loop-information  End >>>
             500     1                     do loop = 1,loops
             501     1               !
             502     1               !----------------------------------------------------------------
             503     1               !     initialize the large scale variables
             504     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flgcld, mstep
                                   <<< Loop-information  End >>>
             505     2  pp   2v            do i = its, ite
             506     2   p   2v              mstep(i) = 1
             507     2   p   2v              flgcld(i) = .true.
             508     2   p   2v            enddo
             509     1               !
             510     1               !     do k = kts, kte
             511     1               !       do i = its, ite
             512     1               !         denfac(i,k) = sqrt(den0/den(i,k))
             513     1               !       enddo
             514     1               !     enddo
             515     1               !      do k = kts, kte
             516     1               !        CALL VREC( tvec1(its), den(its,k), ite-its+1)
             517     1               !        do i = its, ite
             518     1               !          tvec1(i) = tvec1(i)*den0
             519     1               !        enddo
             520     1               !        CALL VSQRT( denfac(its,k), tvec1(its), ite-its+1)
             521     1               !      enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, denfac, tvec1
                                   <<< Loop-information  End >>>
             522     2                     do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.20, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, denfac, tvec1
                                   <<< Loop-information  End >>>
             523     3  pp   2v              do i = its, ite
             524     3   p   2v                tvec1(i) = den0 / den(i,k)
             525     3   p   2v                denfac(i,k) = sqrt(tvec1(i))
             526     3   p   2v              enddo
             527     2                     enddo
             528     1               !
             529     1               ! Inline expansion for fpvs
             530     1               !         qs(i,k,1) = fpvs(t(i,k),0,rd,rv,cpv,cliq,cicec,xlv0,xls,psat,t0c)
             531     1               !         qs(i,k,2) = fpvs(t(i,k),1,rd,rv,cpv,cliq,cicec,xlv0,xls,psat,t0c)
             532     1                     xls = xlv0 + xlf0
             533     1                     hsub = xls
             534     1                     hvap = xlv0
             535     1                     cvap = cpv
             536     1                     ttp=t0c+0.01
             537     1                     dldt=cvap-cliq
             538     1                     xa=-dldt/rv
             539     1                     xb=xa+hvap/(rv*ttp)
             540     1                     dldti=cvap-cicec
             541     1                     xai=-dldti/rv
             542     1                     xbi=xai+hsub/(rv*ttp)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             543     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, q, rh, qs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             544     3   p    v              do i = its, ite
             545     3   p    v                tr=ttp/t(i,k)
             546     3   p    v                qs(i,k,1)=psat*exp(log(tr)*(xa))*exp(xb*(1.-tr))
             547     3   p    v                qs(i,k,1) = min(qs(i,k,1),0.99*p(i,k))
             548     3   p    v                qs(i,k,1) = ep2 * qs(i,k,1) / (p(i,k) - qs(i,k,1))
             549     3   p    v                qs(i,k,1) = max(qs(i,k,1),qmin)
             550     3   p    v                rh(i,k,1) = max(q(i,k) / qs(i,k,1),qmin)
             551     3   p    v                tr=ttp/t(i,k)
             552     4   p    v                if(t(i,k).lt.ttp) then
             553     4   p    v                  qs(i,k,2)=psat*exp(log(tr)*(xai))*exp(xbi*(1.-tr))
             554     4   p    v                else
             555     4   p    v                  qs(i,k,2)=psat*exp(log(tr)*(xa))*exp(xb*(1.-tr))
             556     4   p    v                endif
             557     3   p    v                qs(i,k,2) = min(qs(i,k,2),0.99*p(i,k))
             558     3   p    v                qs(i,k,2) = ep2 * qs(i,k,2) / (p(i,k) - qs(i,k,2))
             559     3   p    v                qs(i,k,2) = max(qs(i,k,2),qmin)
             560     3   p    v                rh(i,k,2) = max(q(i,k) / qs(i,k,2),qmin)
             561     3   p    v              enddo
             562     2   p                 enddo
             563     1               !

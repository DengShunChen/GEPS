                                   <<< Loop-information  End >>>
             612     3   p   2v              do i = its, ite
             613     3   p   2v                temp = (den(i,k)*max(qci(i,k,2),qmin))
             614     3   p   2v                temp = sqrt(sqrt(temp*temp*temp))
             615     3   p   2v                xni(i,k) = min(max(5.38e7*temp,1.e3),1.e6)
             616     3   p   2v              enddo
             617     2   p                 enddo

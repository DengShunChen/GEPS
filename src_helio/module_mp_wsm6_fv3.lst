             694     5                                        +precs2*work2(i,k)*coeres)/den(i,k)
             695     5   p    v                    psmlt(i,k) = min(max(psmlt(i,k)*dtcld/mstep(i),                &
             696     5                                         -qrs(i,k,2)/mstep(i)),0.)
             697     5   p    v                    qrs(i,k,2) = qrs(i,k,2) + psmlt(i,k)
             698     5   p    v                    qrs(i,k,1) = qrs(i,k,1) - psmlt(i,k)
             699     5   p    v                    t(i,k) = t(i,k) + xlf/cpm(i,k)*psmlt(i,k)
             700     5   p    v                    t_tmp(i,k) = t(i,k)

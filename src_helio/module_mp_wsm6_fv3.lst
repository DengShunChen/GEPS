             166                                         ,den                                           &
             167                                         ,p, del, phii                                  &
             168                                         ,delt                                          &
             169                                         ,rainncv                                       &
             170                                         ,sr                                            &
             171                                         ,islmsk                                        &
             172                                         ,ims,ime, kms,kme                              &
             173                                         ,its,ite, kts,kte                              &
             174                                         ,snow=snow,snowncv=snowncv                     &
             175                                         ,graupel=graupel,graupelncv=graupelncv         &
             176                                                                              )

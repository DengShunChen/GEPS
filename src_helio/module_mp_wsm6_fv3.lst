             680     3   p    v              do i = its, ite
             681     3   p    v                supcol = t0c-t(i,k)
             682     3   p    v                n0sfac(i,k) = max(min(exp(alpha*supcol),n0smax/n0s),1.)
             683     4   p    v                if(t(i,k).gt.t0c) then
             684     4               !---------------------------------------------------------------
             685     4               ! psmlt: melting of snow [HL A33] [RH83 A25]
             686     4               !       (T>T0: S->R)
             687     4               !---------------------------------------------------------------
             688     4   p    v                  xlf = xlf0
             689     4   p    v                  work2(i,k) = venfac(p(i,k),t(i,k),den(i,k))
             690     5   p    v                  if(qrs(i,k,2).gt.0.) then
             691     5   p    v                    coeres = rslope2(i,k,2)*sqrt(rslope(i,k,2)*rslopeb(i,k,2))
             692     5   p    v                    psmlt(i,k) = xka(t(i,k),den(i,k))/xlf*(t0c-t(i,k))*pi/2.       &

                                   <<<      qrs, qci
                                   <<< Loop-information  End >>>
             152     2   p    v               DO i=its,ite
             153     2   p    v                  qci(i,k,1) = qc(i,k)
             154     2   p    v                  qci(i,k,2) = qi(i,k)
             155     2   p    v                  qrs(i,k,1) = qr(i,k)
             156     2   p    v                  qrs(i,k,2) = qs(i,k)
             157     2   p    v                  qrs(i,k,3) = qg(i,k)
             158     2   p    v                  q(i,k)     = qq(i,k) / (1.-qq(i,k))
             159     2   p    v                  tmp = MAX(1.E-10, q(i,k))
             160     2   p    v                  den(i,k) = p(i,k)/(Rd*t(i,k)*(1. + eps1*tmp))

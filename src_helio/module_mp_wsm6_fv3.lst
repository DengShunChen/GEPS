             709     5                                        *(t0c-t(i,k))*(precg1*rslope2(i,k,3)                &
             710     5                                        +precg2*work2(i,k)*coeres)/den(i,k)
             711     5   p    v                    pgmlt(i,k) = min(max(pgmlt(i,k)*dtcld/mstep(i),                &

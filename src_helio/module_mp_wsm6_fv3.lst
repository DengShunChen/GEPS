                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             178     2   p    v               DO I=its,ite
             179     2   p    v                  qc(i,k) = qci(i,k,1)
             180     2   p    v                  qi(i,k) = qci(i,k,2)
             181     2   p    v                  qr(i,k) = qrs(i,k,1)
             182     2   p    v                  qs(i,k) = qrs(i,k,2)
             183     2   p    v                  qg(i,k) = qrs(i,k,3)
             184     2   p    v                  qq(i,k) = q(i,k) / (1.+q(i,k))
             185     2   p    v               ENDDO
             186     1   p                    ENDDO
             187                     
             188                     !+---+-----------------------------------------------------------------+
             189                              has_reqc = 1
             190                              has_reqi = 1
             191                              has_reqs = 1
             192                     
             193     1                       if (has_reqc.ne.0 .and. has_reqi.ne.0 .and. has_reqs.ne.0) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      re_qs, re_qi, re_qc, qs1d, qi1d, qc1d
                                   <<<      den1d, t1d
                                   <<< Loop-information  End >>>
             194     2                         do i=its,ite
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.61, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qs1d, qi1d, qc1d, den1d, t1d, re_qs
                                   <<<      re_qi, re_qc
                                   <<< Loop-information  End >>>
             195     3  pp    v                  do k=kts,kte
             196     3   p    v                    re_qc(k) = 2.51E-6
             197     3   p    v                    re_qi(k) = 10.01E-6
             198     3   p    v                    re_qs(k) = 25.E-6
             199     3               
             200     3   p    v                    t1d(k)  = t(i,k)
             201     3   p    v                    den1d(k)= den(i,k)
             202     3   p    v                    qc1d(k) = qc(i,k)
             203     3   p    v                    qi1d(k) = qi(i,k)
             204     3   p    v                    qs1d(k) = qs(i,k)
             205     3   p    v                  enddo
             206     2                           islmski = islmsk(i)
             207     2                           call effectRad_wsm6(t1d, qc1d, qi1d, qs1d, den1d,           &
             208     2                                               qmin, t0c, re_qc, re_qi, re_qs,         &
             209     2                                               islmski,                                & !rsun
             210     2                                               kts, kte, i)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 208
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 56, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      re_qi, re_qc, re_qs
                                   <<< Loop-information  End >>>
             211     3  pp    v                  do k=kts,kte
             212     3   p    v                    re_cloud(i,k) = MAX(2.51E-6,  MIN(re_qc(k),  50.E-6))*1.e6
             213     3   p    v                    re_ice(i,k)   = MAX(10.01E-6, MIN(re_qi(k), 125.E-6))*1.e6
             214     3   p    v                    re_snow(i,k)  = MAX(25.E-6,   MIN(re_qs(k), 999.E-6))*1.e6
             215     3   p    v                  enddo
             216     2                         enddo
             217     1                       endif     ! has_reqc, etc...
             218                     !+---+-----------------------------------------------------------------+
             219                       END SUBROUTINE wsm6
             220                     !===================================================================
             221                     !
             222                       SUBROUTINE wsm62D(t, q                                          &
             223                                        ,qci, qrs, den, p, del,phii                    &
             224                                        ,delt                                          &
             225                                        ,rainncv                                       &
             226                                        ,sr                                            &
             227                                        ,islmsk                                        & !rsun
             228                                        ,ims,ime, kms,kme                              &
             229                                        ,its,ite, kts,kte                              &
             230                                        ,snow,snowncv                                  &
             231                                        ,graupel,graupelncv                            &
             232                                                                                       )
             233                     !-------------------------------------------------------------------
             234                       IMPLICIT NONE
             235                     !-------------------------------------------------------------------
             236                     !
             237                     !  This code is a 6-class GRAUPEL phase microphyiscs scheme (WSM6) of the
             238                     !  Single-Moment MicroPhyiscs (WSMMP). The WSMMP assumes that ice nuclei
             239                     !  number concentration is a function of temperature, and seperate assumption
             240                     !  is developed, in which ice crystal number concentration is a function
             241                     !  of ice amount. A theoretical background of the ice-microphysics and related
             242                     !  processes in the WSMMPs are described in Hong et al. (2004).
             243                     !  All production terms in the WSM6 scheme are described in Hong and Lim (2006).
             244                     !  All units are in m.k.s. and source/sink terms in kgkg-1s-1.
             245                     !
             246                     !  WSM6 cloud scheme
             247                     !
             248                     !  Coded by Song-You Hong and Jeong-Ock Jade Lim (Yonsei Univ.)
             249                     !           Summer 2003
             250                     !
             251                     !  Implemented by Song-You Hong (Yonsei Univ.) and Jimy Dudhia (NCAR)
             252                     !           Summer 2004
             253                     !
             254                     !  further modifications :
             255                     !        semi-lagrangian sedimentation (JH,2010),hong, aug 2009
             256                     !        ==> higher accuracy and efficient at lower resolutions
             257                     !        reflectivity computation from greg thompson, lim, jun 2011
             258                     !        ==> only diagnostic, but with removal of too large drops
             259                     !        add hail option from afwa, aug 2014
             260                     !        ==> switch graupel or hail by changing no, den, fall vel.
             261                     !        effective radius of hydrometeors, bae from kiaps, jan 2015
             262                     !        ==> consistency in solar insolation of rrtmg radiation
             263                     !        bug fix in melting terms, bae from kiaps, nov 2015
             264                     !        ==> density of air is divided, which has not been
             265                     !
             266                     !  Reference) Hong, Dudhia, Chen (HDC, 2004) Mon. Wea. Rev.
             267                     !             Hong and Lim (HL, 2006) J. Korean Meteor. Soc.
             268                     !             Dudhia, Hong and Lim (DHL, 2008) J. Meteor. Soc. Japan
             269                     !             Lin, Farley, Orville (LFO, 1983) J. Appl. Meteor.
             270                     !             Rutledge, Hobbs (RH83, 1983) J. Atmos. Sci.

             766     3                                          +tstepsnow(i)
             767     4   p    v              IF ( PRESENT (snowncv) .AND. PRESENT (snow)) THEN
             768     4   p    v                snowncv(i) = fallsum_qsi*delz(i,kts)/denr*dtcld                  &
             769     4                                          +snowncv(i)
             770     4   p    v                snow(i) = fallsum_qsi*delz(i,kts)/denr*dtcld*1000. + snow(i)

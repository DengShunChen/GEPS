             797     3   p    v                xlf = xls-xl(i,k)
             798     3   p    v                if(supcol.lt.0.) xlf = xlf0
             799     4   p    v                if(supcol.lt.0.and.qci(i,k,2).gt.0.) then
             800     4   p    v                  qci(i,k,1) = qci(i,k,1) + qci(i,k,2)
             801     4   p    v                  t(i,k) = t(i,k) - xlf/cpm(i,k)*qci(i,k,2)
             802     4   p    v                  qci(i,k,2) = 0.
             803     4   p    v                endif
             804     3               !---------------------------------------------------------------
             805     3               ! pihmf: homogeneous freezing of cloud water below -40c [HL A45]
             806     3               !        (T<-40C: C->I)
             807     3               !---------------------------------------------------------------
             808     4   p    v                if(supcol.gt.40..and.qci(i,k,1).gt.0.) then
             809     4   p    v                  qci(i,k,2) = qci(i,k,2) + qci(i,k,1)
             810     4   p    v                  t(i,k) = t(i,k) + xlf/cpm(i,k)*qci(i,k,1)
             811     4   p    v                  qci(i,k,1) = 0.
             812     4   p    v                endif
             813     3               !---------------------------------------------------------------
             814     3               ! pihtf: heterogeneous freezing of cloud water [HL A44]
             815     3               !        (T0>T>-40C: C->I)
             816     3               !---------------------------------------------------------------
             817     4   p    v                if(supcol.gt.0..and.qci(i,k,1).gt.qmin) then
             818     5   p    v                  if(islmsk(i) == 1) then
             819     5   p    v                    xncr = xncrl
             820     5   p    v                  else
             821     5   p    v                    xncr = xncro
             822     5   p    v                  endif
             823     4               !           pfrzdtc = min(pfrz1*(exp(pfrz2*supcol)-1.)                         &
             824     4               !              *den(i,k)/denr/xncr*qci(i,k,1)**2*dtcld,qci(i,k,1))
             825     4   p    v                  supcolt=min(supcol,50.)
             826     4   p    v                  pfrzdtc = min(pfrz1*(exp(pfrz2*supcolt)-1.)                        &
             827     4                           *den(i,k)/denr/xncr*qci(i,k,1)*qci(i,k,1)*dtcld,qci(i,k,1))
             828     4   p    v                  qci(i,k,2) = qci(i,k,2) + pfrzdtc
             829     4   p    v                  t(i,k) = t(i,k) + xlf/cpm(i,k)*pfrzdtc
             830     4   p    v                  qci(i,k,1) = qci(i,k,1)-pfrzdtc
             831     4   p    v                endif
             832     3               !---------------------------------------------------------------
             833     3               ! pgfrz: freezing of rain water [HL A20] [LFO 45]
             834     3               !        (T<T0, R->G)
             835     3               !---------------------------------------------------------------
             836     4   p    v                if(supcol.gt.0..and.qrs(i,k,1).gt.0.) then
             837     4               !           pfrzdtr = min(20.*pi**2*pfrz1*n0r*denr/den(i,k)                    &
             838     4               !                 *(exp(pfrz2*supcol)-1.)*rslope3(i,k,1)**2                    &
             839     4               !                 *rslope(i,k,1)*dtcld,qrs(i,k,1))
             840     4   p    v                  temp = rslope3(i,k,1)
             841     4   p    v                  temp = temp*temp*rslope(i,k,1)
             842     4   p    v                  supcolt=min(supcol,50.)
             843     4   p    v                  pfrzdtr = min(20.*(pi*pi)*pfrz1*n0r*denr/den(i,k)                  &
             844     4                                 *(exp(pfrz2*supcolt)-1.)*temp*dtcld,                         &
             845     4                                 qrs(i,k,1))
             846     4   p    v                  qrs(i,k,3) = qrs(i,k,3) + pfrzdtr
             847     4   p    v                  t(i,k) = t(i,k) + xlf/cpm(i,k)*pfrzdtr
             848     4   p    v                  qrs(i,k,1) = qrs(i,k,1)-pfrzdtr
             849     4   p    v                endif
             850     3   p    v              enddo
             851     2   p                 enddo
             852     1               !
             853     1               !
             854     1               !----------------------------------------------------------------
             855     1               !     update the slope parameters for microphysics computation
             856     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, t, qrs_tmp, t_tmp
                                   <<< Loop-information  End >>>
             857     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, t, qrs_tmp, t_tmp
                                   <<< Loop-information  End >>>
             858     3   p    v              do i = its, ite
             859     3   p    v                    t_tmp(i,k) = t(i,k)
             860     3   p    v                qrs_tmp(i,k,1) = qrs(i,k,1)
             861     3   p    v                qrs_tmp(i,k,2) = qrs(i,k,2)
             862     3   p    v                qrs_tmp(i,k,3) = qrs(i,k,3)
             863     3   p    v              enddo
             864     2   p                 enddo
             865     1                     call slope_wsm6(qrs_tmp,den_tmp,denfac,t_tmp,rslope,rslopeb,rslope2,rslope3, &
             866     1                                    work1,its,ite,kts,kte)
             867     1               !------------------------------------------------------------------
             868     1               !     work1:  the thermodynamic term in the denominator associated with
             869     1               !             heat conduction and vapor diffusion
             870     1               !             (ry88, y93, h85)
             871     1               !     work2: parameter associated with the ventilation effects(y93)
             872     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             873     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, den, work2, qs, work1, xl
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 3  FILL 6
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             874     3   p    v              do i = its, ite
             875     3   p    v                work1(i,k,1) = diffac(xl(i,k),p(i,k),t(i,k),den(i,k),qs(i,k,1))
             876     3   p    v                work1(i,k,2) = diffac(xls,p(i,k),t(i,k),den(i,k),qs(i,k,2))
             877     3   p    v                work2(i,k) = venfac(p(i,k),t(i,k),den(i,k))
             878     3   p    v              enddo
             879     2   p                 enddo
             880     1               !
             881     1               !===============================================================
             882     1               !
             883     1               ! warm rain processes
             884     1               !
             885     1               ! - follows the processes in RH83 and LFO except for autoconcersion
             886     1               !
             887     1               !===============================================================
             888     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             889     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, work2, rslopeb, rslope, rslope2, rh
                                   <<<      work1, qci, denfac, rslope3, islmsk
                                   <<<      pracw, q, qs, praut, prevp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             890     3   p    v              do i = its, ite
             891     3   p    v                supsat = max(q(i,k),qmin)-qs(i,k,1)
             892     3   p    v                satdt = supsat/dtcld
             893     3               !---------------------------------------------------------------
             894     3               ! praut: auto conversion rate from cloud to rain [HDC 16]
             895     3               !        (C->R)
             896     3               !---------------------------------------------------------------
             897     4   p    v                if(islmsk(i) == 1 ) then
             898     4   p    v                  qc0 = qc0l
             899     4   p    v                  qck1 = qck1l
             900     4   p    v                else
             901     4   p    v                  qc0 = qc0o
             902     4   p    v                  qck1 = qck1o
             903     4   p    v                endif
             904     4   p    v                if(qci(i,k,1).gt.qc0) then
             905     4   p    v                  praut(i,k) = qck1*qci(i,k,1)**(7./3.)
             906     4   p    v                  praut(i,k) = min(praut(i,k),qci(i,k,1)/dtcld)
             907     4   p    v                endif
             908     3               !---------------------------------------------------------------
             909     3               ! pracw: accretion of cloud water by rain [HL A40] [LFO 51]
             910     3               !        (C->R)
             911     3               !---------------------------------------------------------------
             912     4   p    v                if(qrs(i,k,1).gt.qcrmin.and.qci(i,k,1).gt.qmin) then
             913     4   p    v                  pracw(i,k) = min(pacrr*rslope3(i,k,1)*rslopeb(i,k,1)               &
             914     4                                       *qci(i,k,1)*denfac(i,k),qci(i,k,1)/dtcld)
             915     4   p    v                endif
             916     3               !---------------------------------------------------------------
             917     3               ! prevp: evaporation/condensation rate of rain [HDC 14]
             918     3               !        (V->R or R->V)
             919     3               !---------------------------------------------------------------
             920     4   p    v                if(qrs(i,k,1).gt.0.) then
             921     4   p    v                  coeres = rslope2(i,k,1)*sqrt(rslope(i,k,1)*rslopeb(i,k,1))
             922     4   p    v                  prevp(i,k) = (rh(i,k,1)-1.)*(precr1*rslope2(i,k,1)                 &
             923     4                                        +precr2*work2(i,k)*coeres)/work1(i,k,1)
             924     5   p    v                  if(prevp(i,k).lt.0.) then
             925     5   p    v                    prevp(i,k) = max(prevp(i,k),-qrs(i,k,1)/dtcld)
             926     5   p    v                    prevp(i,k) = max(prevp(i,k),satdt/2.)
             927     5   p    v                  else
             928     5   p    v                    prevp(i,k) = min(prevp(i,k),satdt/2.)
             929     5   p    v                  endif
             930     4   p    v                endif
             931     3   p    v              enddo
             932     2   p                 enddo
             933     1               !
             934     1               !===============================================================
             935     1               !
             936     1               ! cold rain processes
             937     1               !
             938     1               ! - follows the revised ice microphysics processes in HDC
             939     1               ! - the processes same as in RH83 and RH84  and LFO behave
             940     1               !   following ice crystal hapits defined in HDC, inclduing
             941     1               !   intercept parameter for snow (n0s), ice crystal number
             942     1               !   concentration (ni), ice nuclei number concentration
             943     1               !   (n0i), ice diameter (d)
             944     1               !
             945     1               !===============================================================
             946     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             947     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, qsum, qci, den, pgacs, xni, t
                                   <<<      n0sfac, rslope3, rslopeb, denfac
                                   <<<      rslope2, rslope
                                   <<<    PREFETCH(SOFT) : 72
                                   <<<     SEQUENTIAL : 72
                                   <<<      rslope2: 4, rslope3: 4, rslopeb: 4
                                   <<<      psaci: 2, rslope: 2, pgaci: 2, praci: 2
                                   <<<      piacr: 2, pracs: 2, qci: 2, psacw: 2
                                   <<<      pgacw: 2, paacw: 2, psacr: 2, pseml: 2
                                   <<<      pgacr: 2, pgeml: 2, work1: 4, psaut: 2
                                   <<<      pgaut: 2, rh: 4, q: 2, qs: 2, prevp: 2
                                   <<<      pidep: 2, work2: 2, psdep: 2, pgdep: 2
                                   <<<      pigen: 2, pgevp: 2, psevp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 38
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 63  FILL 149
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
             948     3   p    v              do i = its, ite
             949     3   p    v                supcol = t0c-t(i,k)
             950     3   p    v                n0sfac(i,k) = max(min(exp(alpha*supcol),n0smax/n0s),1.)
             951     3   p    v                supsat = max(q(i,k),qmin)-qs(i,k,2)
             952     3   p    v                satdt = supsat/dtcld
             953     3   p    v                ifsat = 0
             954     3               !-------------------------------------------------------------
             955     3               ! Ni: ice crystal number concentraiton   [HDC 5c]
             956     3               !-------------------------------------------------------------
             957     3               !         xni(i,k) = min(max(5.38e7*(den(i,k)                                  &
             958     3               !                      *max(qci(i,k,2),qmin))**0.75,1.e3),1.e6)
             959     3   p    v                temp = (den(i,k)*max(qci(i,k,2),qmin))
             960     3   p    v                temp = sqrt(sqrt(temp*temp*temp))
             961     3   p    v                xni(i,k) = min(max(5.38e7*temp,1.e3),1.e6)
             962     3   p    v                eacrs = exp(0.07*(-supcol))
             963     3               !
             964     3   p    v                xmi = den(i,k)*qci(i,k,2)/xni(i,k)
             965     3   p    v                diameter  = min(dicon * sqrt(xmi),dimax)
             966     3   p    v                vt2i = 1.49e4*diameter**1.31
             967     3   p    v                vt2r=pvtr*rslopeb(i,k,1)*denfac(i,k)
             968     3   p    v                vt2s=pvts*rslopeb(i,k,2)*denfac(i,k)
             969     3   p    v                vt2g=pvtg*rslopeb(i,k,3)*denfac(i,k)
             970     3   p    v                qsum(i,k) = max( (qrs(i,k,2)+qrs(i,k,3)), 1.E-15)
             971     4   p    v                if(qsum(i,k) .gt. 1.e-15) then
             972     4   p    v                vt2ave=(vt2s*qrs(i,k,2)+vt2g*qrs(i,k,3))/(qsum(i,k))
             973     4   p    v                else
             974     4   p    v                vt2ave=0.
             975     4   p    v                endif
             976     4   p    v                if(supcol.gt.0.and.qci(i,k,2).gt.qmin) then
             977     5   p    v                  if(qrs(i,k,1).gt.qcrmin) then
             978     5               !-------------------------------------------------------------
             979     5               ! praci: Accretion of cloud ice by rain [HL A15] [LFO 25]
             980     5               !        (T<T0: I->R)
             981     5               !-------------------------------------------------------------
             982     5   p    v                    acrfac = 2.*rslope3(i,k,1)+2.*diameter*rslope2(i,k,1)            &
             983     5                                     +diameter**2*rslope(i,k,1)
             984     5   p    v                    praci(i,k) = pi*qci(i,k,2)*n0r*abs(vt2r-vt2i)*acrfac/4.
             985     5   p    v                    praci(i,k) = min(praci(i,k),qci(i,k,2)/dtcld)
             986     5               !-------------------------------------------------------------
             987     5               ! piacr: Accretion of rain by cloud ice [HL A19] [LFO 26]
             988     5               !        (T<T0: R->S or R->G)
             989     5               !-------------------------------------------------------------
             990     5   p    v                    piacr(i,k) = pi**2*avtr*n0r*denr*xni(i,k)*denfac(i,k)            &
             991     5                                         *g6pbr*rslope3(i,k,1)*rslope3(i,k,1)                 &
             992     5                                         *rslopeb(i,k,1)/24./den(i,k)
             993     5   p    v                    piacr(i,k) = min(piacr(i,k),qrs(i,k,1)/dtcld)
             994     5   p    v                  endif
             995     4               !-------------------------------------------------------------
             996     4               ! psaci: Accretion of cloud ice by snow [HDC 10]
             997     4               !        (T<T0: I->S)
             998     4               !-------------------------------------------------------------
             999     5   p    v                  if(qrs(i,k,2).gt.qcrmin) then
            1000     5   p    v                    acrfac = 2.*rslope3(i,k,2)+2.*diameter*rslope2(i,k,2)            &
            1001     5                                     +diameter**2*rslope(i,k,2)
            1002     5   p    v                    psaci(i,k) = pi*qci(i,k,2)*eacrs*n0s*n0sfac(i,k)                 &
            1003     5                                         *abs(vt2ave-vt2i)*acrfac/4.
            1004     5   p    v                    psaci(i,k) = min(psaci(i,k),qci(i,k,2)/dtcld)
            1005     5   p    v                  endif
            1006     4               !-------------------------------------------------------------
            1007     4               ! pgaci: Accretion of cloud ice by graupel [HL A17] [LFO 41]
            1008     4               !        (T<T0: I->G)
            1009     4               !-------------------------------------------------------------
            1010     5   p    v                  if(qrs(i,k,3).gt.qcrmin) then
            1011     5   p    v                    egi = exp(0.07*(-supcol))
            1012     5   p    v                    acrfac = 2.*rslope3(i,k,3)+2.*diameter*rslope2(i,k,3)            &
            1013     5                                     +diameter**2*rslope(i,k,3)
            1014     5   p    v                    pgaci(i,k) = pi*egi*qci(i,k,2)*n0g*abs(vt2ave-vt2i)*acrfac/4.
            1015     5   p    v                    pgaci(i,k) = min(pgaci(i,k),qci(i,k,2)/dtcld)
            1016     5   p    v                  endif
            1017     4   p    v                endif
            1018     3               !-------------------------------------------------------------
            1019     3               ! psacw: Accretion of cloud water by snow  [HL A7] [LFO 24]
            1020     3               !        (T<T0: C->S, and T>=T0: C->R)
            1021     3               !-------------------------------------------------------------
            1022     4   p    v                if(qrs(i,k,2).gt.qcrmin.and.qci(i,k,1).gt.qmin) then
            1023     4   p    v                  psacw(i,k) = min(pacrc*n0sfac(i,k)*rslope3(i,k,2)*rslopeb(i,k,2)   &
            1024     4                                       *qci(i,k,1)*denfac(i,k),qci(i,k,1)/dtcld)
            1025     4   p    v                endif
            1026     3               !-------------------------------------------------------------
            1027     3               ! pgacw: Accretion of cloud water by graupel [HL A6] [LFO 40]
            1028     3               !        (T<T0: C->G, and T>=T0: C->R)
            1029     3               !-------------------------------------------------------------
            1030     4   p    v                if(qrs(i,k,3).gt.qcrmin.and.qci(i,k,1).gt.qmin) then
            1031     4   p    v                  pgacw(i,k) = min(pacrg*rslope3(i,k,3)*rslopeb(i,k,3)               &
            1032     4                                       *qci(i,k,1)*denfac(i,k),qci(i,k,1)/dtcld)
            1033     4   p    v                endif
            1034     3               !-------------------------------------------------------------
            1035     3               ! paacw: Accretion of cloud water by averaged snow/graupel
            1036     3               !        (T<T0: C->G or S, and T>=T0: C->R)
            1037     3               !-------------------------------------------------------------
            1038     4   p    v                if(qsum(i,k) .gt. 1.e-15) then
            1039     4   p    v                  paacw(i,k) = (qrs(i,k,2)*psacw(i,k)+qrs(i,k,3)*pgacw(i,k))         &
            1040     4                                       /(qsum(i,k))
            1041     4   p    v                endif
            1042     3               !-------------------------------------------------------------
            1043     3               ! pracs: Accretion of snow by rain [HL A11] [LFO 27]
            1044     3               !         (T<T0: S->G)
            1045     3               !-------------------------------------------------------------
            1046     4   p    v                if(qrs(i,k,2).gt.qcrmin.and.qrs(i,k,1).gt.qcrmin) then
            1047     5   p    v                  if(supcol.gt.0) then
            1048     5   p    v                    acrfac = 5.*rslope3(i,k,2)*rslope3(i,k,2)*rslope(i,k,1)          &
            1049     5                                     +2.*rslope3(i,k,2)*rslope2(i,k,2)*rslope2(i,k,1)         &
            1050     5                                     +.5*rslope2(i,k,2)*rslope2(i,k,2)*rslope3(i,k,1)
            1051     5   p    v                    pracs(i,k) = pi**2*n0r*n0s*n0sfac(i,k)*abs(vt2r-vt2ave)          &
            1052     5                                         *(dens/den(i,k))*acrfac
            1053     5   p    v                    pracs(i,k) = min(pracs(i,k),qrs(i,k,2)/dtcld)
            1054     5   p    v                  endif
            1055     4               !-------------------------------------------------------------
            1056     4               ! psacr: Accretion of rain by snow [HL A10] [LFO 28]
            1057     4               !         (T<T0:R->S or R->G) (T>=T0: enhance melting of snow)
            1058     4               !-------------------------------------------------------------
            1059     4   p    v                  acrfac = 5.*rslope3(i,k,1)*rslope3(i,k,1)*rslope(i,k,2)            &
            1060     4                                   +2.*rslope3(i,k,1)*rslope2(i,k,1)*rslope2(i,k,2)           &
            1061     4                                   +.5*rslope2(i,k,1)*rslope2(i,k,1)*rslope3(i,k,2)
            1062     4   p    v                  psacr(i,k) = pi**2*n0r*n0s*n0sfac(i,k)*abs(vt2ave-vt2r)            &
            1063     4                                       *(denr/den(i,k))*acrfac
            1064     4   p    v                  psacr(i,k) = min(psacr(i,k),qrs(i,k,1)/dtcld)
            1065     4   p    v                endif
            1066     3               !-------------------------------------------------------------
            1067     3               ! pgacr: Accretion of rain by graupel [HL A12] [LFO 42]
            1068     3               !         (T<T0: R->G) (T>=T0: enhance melting of graupel)
            1069     3               !-------------------------------------------------------------
            1070     4   p    v                if(qrs(i,k,3).gt.qcrmin.and.qrs(i,k,1).gt.qcrmin) then
            1071     4   p    v                  acrfac = 5.*rslope3(i,k,1)*rslope3(i,k,1)*rslope(i,k,3)            &
            1072     4                                   +2.*rslope3(i,k,1)*rslope2(i,k,1)*rslope2(i,k,3)           &
            1073     4                                   +.5*rslope2(i,k,1)*rslope2(i,k,1)*rslope3(i,k,3)
            1074     4   p    v                  pgacr(i,k) = pi**2*n0r*n0g*abs(vt2ave-vt2r)*(denr/den(i,k))        &
            1075     4                                       *acrfac
            1076     4   p    v                  pgacr(i,k) = min(pgacr(i,k),qrs(i,k,1)/dtcld)
            1077     4   p    v                endif
            1078     3               !
            1079     3               !-------------------------------------------------------------
            1080     3               ! pgacs: Accretion of snow by graupel [HL A13] [LFO 29]
            1081     3               !        (S->G): This process is eliminated in V3.0 with the
            1082     3               !        new combined snow/graupel fall speeds
            1083     3               !-------------------------------------------------------------
            1084     4   p    v                if(qrs(i,k,3).gt.qcrmin.and.qrs(i,k,2).gt.qcrmin) then
            1085     4   p    v                  pgacs(i,k) = 0.
            1086     4   p    v                endif
            1087     4   p    v                if(supcol.le.0) then
            1088     4   p    v                  xlf = xlf0
            1089     4               !-------------------------------------------------------------
            1090     4               ! pseml: Enhanced melting of snow by accretion of water [HL A34]
            1091     4               !        (T>=T0: S->R)
            1092     4               !-------------------------------------------------------------
            1093     4   p    v                  if(qrs(i,k,2).gt.0.)                                               &
            1094     4                             pseml(i,k) = min(max(cliq*supcol*(paacw(i,k)+psacr(i,k))         &
            1095     4                                         /xlf,-qrs(i,k,2)/dtcld),0.)
            1096     4               !-------------------------------------------------------------
            1097     4               ! pgeml: Enhanced melting of graupel by accretion of water [HL A24] [RH84 A21-A22]
            1098     4               !        (T>=T0: G->R)
            1099     4               !-------------------------------------------------------------
            1100     4   p    v                  if(qrs(i,k,3).gt.0.)                                               &
            1101     4                             pgeml(i,k) = min(max(cliq*supcol*(paacw(i,k)+pgacr(i,k))         &
            1102     4                                         /xlf,-qrs(i,k,3)/dtcld),0.)
            1103     4   p    v                endif
            1104     4   p    v                if(supcol.gt.0) then
            1105     4               !-------------------------------------------------------------
            1106     4               ! pidep: Deposition/Sublimation rate of ice [HDC 9]
            1107     4               !       (T<T0: V->I or I->V)
            1108     4               !-------------------------------------------------------------
            1109     5   p    v                  if(qci(i,k,2).gt.0.and.ifsat.ne.1) then
            1110     5   p    v                    pidep(i,k) = 4.*diameter*xni(i,k)*(rh(i,k,2)-1.)/work1(i,k,2)
            1111     5   p    v                    supice = satdt-prevp(i,k)
            1112     6   p    v                    if(pidep(i,k).lt.0.) then
            1113     6   p    v                      pidep(i,k) = max(max(pidep(i,k),satdt/2.),supice)
            1114     6   p    v                      pidep(i,k) = max(pidep(i,k),-qci(i,k,2)/dtcld)
            1115     6   p    v                    else
            1116     6   p    v                      pidep(i,k) = min(min(pidep(i,k),satdt/2.),supice)
            1117     6   p    v                    endif
            1118     5   p    v                    if(abs(prevp(i,k)+pidep(i,k)).ge.abs(satdt)) ifsat = 1
            1119     5   p    v                  endif
            1120     4               !-------------------------------------------------------------
            1121     4               ! psdep: deposition/sublimation rate of snow [HDC 14]
            1122     4               !        (T<T0: V->S or S->V)
            1123     4               !-------------------------------------------------------------
            1124     5   p    v                  if(qrs(i,k,2).gt.0..and.ifsat.ne.1) then
            1125     5   p    v                    coeres = rslope2(i,k,2)*sqrt(rslope(i,k,2)*rslopeb(i,k,2))
            1126     5   p    v                    psdep(i,k) = (rh(i,k,2)-1.)*n0sfac(i,k)*(precs1*rslope2(i,k,2)   &
            1127     5                                          + precs2*work2(i,k)*coeres)/work1(i,k,2)
            1128     5   p    v                    supice = satdt-prevp(i,k)-pidep(i,k)
            1129     6   p    v                    if(psdep(i,k).lt.0.) then
            1130     6   p    v                      psdep(i,k) = max(psdep(i,k),-qrs(i,k,2)/dtcld)
            1131     6   p    v                      psdep(i,k) = max(max(psdep(i,k),satdt/2.),supice)
            1132     6   p    v                    else
            1133     6   p    v                      psdep(i,k) = min(min(psdep(i,k),satdt/2.),supice)
            1134     6   p    v                    endif
            1135     5   p    v                    if(abs(prevp(i,k)+pidep(i,k)+psdep(i,k)).ge.abs(satdt))          &
            1136     5                               ifsat = 1
            1137     5   p    v                  endif
            1138     4               !-------------------------------------------------------------
            1139     4               ! pgdep: deposition/sublimation rate of graupel [HL A21] [LFO 46]
            1140     4               !        (T<T0: V->G or G->V)
            1141     4               !-------------------------------------------------------------
            1142     5   p    v                  if(qrs(i,k,3).gt.0..and.ifsat.ne.1) then
            1143     5   p    v                    coeres = rslope2(i,k,3)*sqrt(rslope(i,k,3)*rslopeb(i,k,3))
            1144     5   p    v                    pgdep(i,k) = (rh(i,k,2)-1.)*(precg1*rslope2(i,k,3)               &
            1145     5                                             +precg2*work2(i,k)*coeres)/work1(i,k,2)
            1146     5   p    v                    supice = satdt-prevp(i,k)-pidep(i,k)-psdep(i,k)
            1147     6   p    v                    if(pgdep(i,k).lt.0.) then
            1148     6   p    v                      pgdep(i,k) = max(pgdep(i,k),-qrs(i,k,3)/dtcld)
            1149     6   p    v                      pgdep(i,k) = max(max(pgdep(i,k),satdt/2.),supice)
            1150     6   p    v                    else
            1151     6   p    v                      pgdep(i,k) = min(min(pgdep(i,k),satdt/2.),supice)
            1152     6   p    v                    endif
            1153     5   p    v                    if(abs(prevp(i,k)+pidep(i,k)+psdep(i,k)+pgdep(i,k)).ge.          &
            1154     5                               abs(satdt)) ifsat = 1
            1155     5   p    v                  endif
            1156     4               !-------------------------------------------------------------
            1157     4               ! pigen: generation(nucleation) of ice from vapor [HL 50] [HDC 7-8]
            1158     4               !       (T<T0: V->I)
            1159     4               !-------------------------------------------------------------
            1160     5   p    v                  if(supsat.gt.0.and.ifsat.ne.1) then
            1161     5   p    v                    supice = satdt-prevp(i,k)-pidep(i,k)-psdep(i,k)-pgdep(i,k)
            1162     5   p    v                    xni0 = 1.e3*exp(0.1*supcol)
            1163     5   p    v                    roqi0 = 4.92e-11*xni0**1.33
            1164     5   p    v                    pigen(i,k) = max(0.,(roqi0/den(i,k)-max(qci(i,k,2),0.))/dtcld)
            1165     5   p    v                    pigen(i,k) = min(min(pigen(i,k),satdt),supice)
            1166     5   p    v                  endif
            1167     4               !
            1168     4               !-------------------------------------------------------------
            1169     4               ! psaut: conversion(aggregation) of ice to snow [HDC 12]
            1170     4               !        (T<T0: I->S)
            1171     4               !-------------------------------------------------------------
            1172     5   p    v                  if(qci(i,k,2).gt.0.) then
            1173     5   p    v                    qimax = roqimax/den(i,k)
            1174     5   p    v                    psaut(i,k) = max(0.,(qci(i,k,2)-qimax)/dtcld)
            1175     5   p    v                  endif
            1176     4               !
            1177     4               !-------------------------------------------------------------
            1178     4               ! pgaut: conversion(aggregation) of snow to graupel [HL A4] [LFO 37]
            1179     4               !        (T<T0: S->G)
            1180     4               !-------------------------------------------------------------
            1181     5   p    v                  if(qrs(i,k,2).gt.0.) then
            1182     5   p    v                    alpha2 = 1.e-3*exp(0.09*(-supcol))
            1183     5   p    v                    pgaut(i,k) = min(max(0.,alpha2*(qrs(i,k,2)-qs0)),qrs(i,k,2)/dtcld)
            1184     5   p    v                  endif
            1185     4   p    v                endif
            1186     3               !
            1187     3               !-------------------------------------------------------------
            1188     3               ! psevp: Evaporation of melting snow [HL A35] [RH83 A27]
            1189     3               !       (T>=T0: S->V)
            1190     3               !-------------------------------------------------------------
            1191     4   p    v                if(supcol.lt.0.) then
            1192     5   p    v                  if(qrs(i,k,2).gt.0..and.rh(i,k,1).lt.1.) then
            1193     5   p    v                    coeres = rslope2(i,k,2)*sqrt(rslope(i,k,2)*rslopeb(i,k,2))
            1194     5   p    v                    psevp(i,k) = (rh(i,k,1)-1.)*n0sfac(i,k)*(precs1                  &
            1195     5                                          *rslope2(i,k,2)+precs2*work2(i,k)                   &
            1196     5                                          *coeres)/work1(i,k,1)
            1197     5   p    v                    psevp(i,k) = min(max(psevp(i,k),-qrs(i,k,2)/dtcld),0.)
            1198     5   p    v                  endif
            1199     4               !-------------------------------------------------------------
            1200     4               ! pgevp: Evaporation of melting graupel [HL A25] [RH84 A19]
            1201     4               !       (T>=T0: G->V)
            1202     4               !-------------------------------------------------------------
            1203     5   p    v                  if(qrs(i,k,3).gt.0..and.rh(i,k,1).lt.1.) then
            1204     5   p    v                    coeres = rslope2(i,k,3)*sqrt(rslope(i,k,3)*rslopeb(i,k,3))
            1205     5   p    v                    pgevp(i,k) = (rh(i,k,1)-1.)*(precg1*rslope2(i,k,3)               &
            1206     5                                        +precg2*work2(i,k)*coeres)/work1(i,k,1)
            1207     5   p    v                    pgevp(i,k) = min(max(pgevp(i,k),-qrs(i,k,3)/dtcld),0.)
            1208     5   p    v                  endif
            1209     4   p    v                endif
            1210     3   p    v              enddo
            1211     2   p                 enddo
            1212     1               !
            1213     1               !
            1214     1               !----------------------------------------------------------------
            1215     1               !     check mass conservation of generation terms and feedback to the
            1216     1               !     large scale
            1217     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1218     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, qrs, pracw, praut, paacw, qci, pgacs
                                   <<<      psevp, prevp, pgevp, pgeml, pseml, q, xl
                                   <<<    PREFETCH(SOFT) : 34
                                   <<<     SEQUENTIAL : 34
                                   <<<      cpm: 2, pracs: 2, pigen: 2, psaut: 2
                                   <<<      praci: 2, pidep: 2, piacr: 2, qci: 2
                                   <<<      psaci: 2, pgaci: 2, psacr: 2, pgacr: 2
                                   <<<      pgaut: 2, psdep: 2, qrs: 2, pgdep: 2
                                   <<<      work2: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 32
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 21  FILL 47
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1219     3   p    v              do i = its, ite
            1220     3               !
            1221     3   p    v                delta2=0.
            1222     3   p    v                delta3=0.
            1223     3   p    v                if(qrs(i,k,1).lt.1.e-4.and.qrs(i,k,2).lt.1.e-4) delta2=1.
            1224     3   p    v                if(qrs(i,k,1).lt.1.e-4) delta3=1.
            1225     4   p    v                if(t(i,k).le.t0c) then
            1226     4               !
            1227     4               !     cloud water
            1228     4               !
            1229     4   p    v                  value = max(qmin,qci(i,k,1))
            1230     4   p    v                  source = (praut(i,k)+pracw(i,k)+paacw(i,k)+paacw(i,k))*dtcld
            1231     5   p    v                  if (source.gt.value) then
            1232     5   p    v                    factor = value/source
            1233     5   p    v                    praut(i,k) = praut(i,k)*factor
            1234     5   p    v                    pracw(i,k) = pracw(i,k)*factor
            1235     5   p    v                    paacw(i,k) = paacw(i,k)*factor
            1236     5   p    v                  endif
            1237     4               !
            1238     4               !     cloud ice
            1239     4               !
            1240     4   p    v                  value = max(qmin,qci(i,k,2))
            1241     4   p    v                  source = (psaut(i,k)-pigen(i,k)-pidep(i,k)+praci(i,k)+psaci(i,k)   &
            1242     4                                   +pgaci(i,k))*dtcld
            1243     5   p    v                  if (source.gt.value) then
            1244     5   p    v                    factor = value/source
            1245     5   p    v                    psaut(i,k) = psaut(i,k)*factor
            1246     5   p    v                    pigen(i,k) = pigen(i,k)*factor
            1247     5   p    v                    pidep(i,k) = pidep(i,k)*factor
            1248     5   p    v                    praci(i,k) = praci(i,k)*factor
            1249     5   p    v                    psaci(i,k) = psaci(i,k)*factor
            1250     5   p    v                    pgaci(i,k) = pgaci(i,k)*factor
            1251     5   p    v                  endif
            1252     4               !
            1253     4               !     rain
            1254     4               !
            1255     4   p    v                  value = max(qmin,qrs(i,k,1))
            1256     4   p    v                  source = (-praut(i,k)-prevp(i,k)-pracw(i,k)+piacr(i,k)+psacr(i,k)  &
            1257     4                                    +pgacr(i,k))*dtcld
            1258     5   p    v                  if (source.gt.value) then
            1259     5   p    v                    factor = value/source
            1260     5   p    v                    praut(i,k) = praut(i,k)*factor
            1261     5   p    v                    prevp(i,k) = prevp(i,k)*factor
            1262     5   p    v                    pracw(i,k) = pracw(i,k)*factor
            1263     5   p    v                    piacr(i,k) = piacr(i,k)*factor
            1264     5   p    v                    psacr(i,k) = psacr(i,k)*factor
            1265     5   p    v                    pgacr(i,k) = pgacr(i,k)*factor
            1266     5   p    v                  endif
            1267     4               !
            1268     4               !     snow
            1269     4               !
            1270     4   p    v                  value = max(qmin,qrs(i,k,2))
            1271     4   p    v                  source = -(psdep(i,k)+psaut(i,k)-pgaut(i,k)+paacw(i,k)+piacr(i,k)  &
            1272     4                                    *delta3+praci(i,k)*delta3-pracs(i,k)*(1.-delta2)          &
            1273     4                                    +psacr(i,k)*delta2+psaci(i,k)-pgacs(i,k) )*dtcld
            1274     5   p    v                  if (source.gt.value) then
            1275     5   p    v                    factor = value/source
            1276     5   p    v                    psdep(i,k) = psdep(i,k)*factor
            1277     5   p    v                    psaut(i,k) = psaut(i,k)*factor
            1278     5   p    v                    pgaut(i,k) = pgaut(i,k)*factor
            1279     5   p    v                    paacw(i,k) = paacw(i,k)*factor
            1280     5   p    v                    piacr(i,k) = piacr(i,k)*factor
            1281     5   p    v                    praci(i,k) = praci(i,k)*factor
            1282     5   p    v                    psaci(i,k) = psaci(i,k)*factor
            1283     5   p    v                    pracs(i,k) = pracs(i,k)*factor
            1284     5   p    v                    psacr(i,k) = psacr(i,k)*factor
            1285     5   p    v                    pgacs(i,k) = pgacs(i,k)*factor
            1286     5   p    v                  endif
            1287     4               !
            1288     4               !     graupel
            1289     4               !
            1290     4   p    v                  value = max(qmin,qrs(i,k,3))
            1291     4   p    v                  source = -(pgdep(i,k)+pgaut(i,k)                                   &
            1292     4                                    +piacr(i,k)*(1.-delta3)+praci(i,k)*(1.-delta3)            &
            1293     4                                    +psacr(i,k)*(1.-delta2)+pracs(i,k)*(1.-delta2)            &
            1294     4                                    +pgaci(i,k)+paacw(i,k)+pgacr(i,k)+pgacs(i,k))*dtcld
            1295     5   p    v                  if (source.gt.value) then
            1296     5   p    v                    factor = value/source
            1297     5   p    v                    pgdep(i,k) = pgdep(i,k)*factor
            1298     5   p    v                    pgaut(i,k) = pgaut(i,k)*factor
            1299     5   p    v                    piacr(i,k) = piacr(i,k)*factor
            1300     5   p    v                    praci(i,k) = praci(i,k)*factor
            1301     5   p    v                    psacr(i,k) = psacr(i,k)*factor
            1302     5   p    v                    pracs(i,k) = pracs(i,k)*factor
            1303     5   p    v                    paacw(i,k) = paacw(i,k)*factor
            1304     5   p    v                    pgaci(i,k) = pgaci(i,k)*factor
            1305     5   p    v                    pgacr(i,k) = pgacr(i,k)*factor
            1306     5   p    v                    pgacs(i,k) = pgacs(i,k)*factor
            1307     5   p    v                  endif
            1308     4               !
            1309     4   p    v                  work2(i,k)=-(prevp(i,k)+psdep(i,k)+pgdep(i,k)+pigen(i,k)+pidep(i,k))
            1310     4               !     update
            1311     4   p    v                  q(i,k) = q(i,k)+work2(i,k)*dtcld
            1312     4   p    v                  qci(i,k,1) = max(qci(i,k,1)-(praut(i,k)+pracw(i,k)                 &
            1313     4                                          +paacw(i,k)+paacw(i,k))*dtcld,0.)
            1314     4   p    v                  qrs(i,k,1) = max(qrs(i,k,1)+(praut(i,k)+pracw(i,k)                 &
            1315     4                                          +prevp(i,k)-piacr(i,k)-pgacr(i,k)                   &
            1316     4                                          -psacr(i,k))*dtcld,0.)
            1317     4   p    v                  qci(i,k,2) = max(qci(i,k,2)-(psaut(i,k)+praci(i,k)                 &
            1318     4                                          +psaci(i,k)+pgaci(i,k)-pigen(i,k)-pidep(i,k))       &
            1319     4                                          *dtcld,0.)
            1320     4   p    v                  qrs(i,k,2) = max(qrs(i,k,2)+(psdep(i,k)+psaut(i,k)+paacw(i,k)      &
            1321     4                                          -pgaut(i,k)+piacr(i,k)*delta3                       &
            1322     4                                          +praci(i,k)*delta3+psaci(i,k)-pgacs(i,k)            &
            1323     4                                          -pracs(i,k)*(1.-delta2)+psacr(i,k)*delta2)          &
            1324     4                                          *dtcld,0.)
            1325     4   p    v                  qrs(i,k,3) = max(qrs(i,k,3)+(pgdep(i,k)+pgaut(i,k)                 &
            1326     4                                          +piacr(i,k)*(1.-delta3)                             &
            1327     4                                          +praci(i,k)*(1.-delta3)+psacr(i,k)*(1.-delta2)      &
            1328     4                                          +pracs(i,k)*(1.-delta2)+pgaci(i,k)+paacw(i,k)       &
            1329     4                                          +pgacr(i,k)+pgacs(i,k))*dtcld,0.)
            1330     4   p    v                  xlf = xls-xl(i,k)
            1331     4   p    v                  xlwork2 = -xls*(psdep(i,k)+pgdep(i,k)+pidep(i,k)+pigen(i,k))       &
            1332     4                                     -xl(i,k)*prevp(i,k)-xlf*(piacr(i,k)+paacw(i,k)           &
            1333     4                                     +paacw(i,k)+pgacr(i,k)+psacr(i,k))
            1334     4   p    v                  t(i,k) = t(i,k)-xlwork2/cpm(i,k)*dtcld
            1335     4   p    v                else
            1336     4               !
            1337     4               !     cloud water
            1338     4               !
            1339     4   p    v                  value = max(qmin,qci(i,k,1))
            1340     4   p    v                  source=(praut(i,k)+pracw(i,k)+paacw(i,k)+paacw(i,k))*dtcld
            1341     5   p    v                  if (source.gt.value) then
            1342     5   p    v                    factor = value/source
            1343     5   p    v                    praut(i,k) = praut(i,k)*factor
            1344     5   p    v                    pracw(i,k) = pracw(i,k)*factor
            1345     5   p    v                    paacw(i,k) = paacw(i,k)*factor
            1346     5   p    v                  endif
            1347     4               !
            1348     4               !     rain
            1349     4               !
            1350     4   p    v                  value = max(qmin,qrs(i,k,1))
            1351     4   p    v                  source = (-paacw(i,k)-praut(i,k)+pseml(i,k)+pgeml(i,k)-pracw(i,k)  &
            1352     4                                    -paacw(i,k)-prevp(i,k))*dtcld
            1353     5   p    v                  if (source.gt.value) then
            1354     5   p    v                    factor = value/source
            1355     5   p    v                    praut(i,k) = praut(i,k)*factor
            1356     5   p    v                    prevp(i,k) = prevp(i,k)*factor
            1357     5   p    v                    pracw(i,k) = pracw(i,k)*factor
            1358     5   p    v                    paacw(i,k) = paacw(i,k)*factor
            1359     5   p    v                    pseml(i,k) = pseml(i,k)*factor
            1360     5   p    v                    pgeml(i,k) = pgeml(i,k)*factor
            1361     5   p    v                  endif
            1362     4               !
            1363     4               !     snow
            1364     4               !
            1365     4   p    v                  value = max(qcrmin,qrs(i,k,2))
            1366     4   p    v                  source=(pgacs(i,k)-pseml(i,k)-psevp(i,k))*dtcld
            1367     5   p    v                  if (source.gt.value) then
            1368     5   p    v                    factor = value/source
            1369     5   p    v                    pgacs(i,k) = pgacs(i,k)*factor
            1370     5   p    v                    psevp(i,k) = psevp(i,k)*factor
            1371     5   p    v                    pseml(i,k) = pseml(i,k)*factor
            1372     5   p    v                  endif
            1373     4               !
            1374     4               !     graupel
            1375     4               !
            1376     4   p    v                  value = max(qcrmin,qrs(i,k,3))
            1377     4   p    v                  source=-(pgacs(i,k)+pgevp(i,k)+pgeml(i,k))*dtcld
            1378     5   p    v                  if (source.gt.value) then
            1379     5   p    v                    factor = value/source
            1380     5   p    v                    pgacs(i,k) = pgacs(i,k)*factor
            1381     5   p    v                    pgevp(i,k) = pgevp(i,k)*factor
            1382     5   p    v                    pgeml(i,k) = pgeml(i,k)*factor
            1383     5   p    v                  endif
            1384     4   p    v                  work2(i,k)=-(prevp(i,k)+psevp(i,k)+pgevp(i,k))
            1385     4               !     update
            1386     4   p    v                  q(i,k) = q(i,k)+work2(i,k)*dtcld
            1387     4   p    v                  qci(i,k,1) = max(qci(i,k,1)-(praut(i,k)+pracw(i,k)                 &
            1388     4                                   +paacw(i,k)+paacw(i,k))*dtcld,0.)
            1389     4   p    v                  qrs(i,k,1) = max(qrs(i,k,1)+(praut(i,k)+pracw(i,k)                 &
            1390     4                                   +prevp(i,k)+paacw(i,k)+paacw(i,k)-pseml(i,k)               &
            1391     4                                   -pgeml(i,k))*dtcld,0.)
            1392     4   p    v                  qrs(i,k,2) = max(qrs(i,k,2)+(psevp(i,k)-pgacs(i,k)                 &
            1393     4                                   +pseml(i,k))*dtcld,0.)
            1394     4   p    v                  qrs(i,k,3) = max(qrs(i,k,3)+(pgacs(i,k)+pgevp(i,k)                 &
            1395     4                                   +pgeml(i,k))*dtcld,0.)
            1396     4   p    v                  xlf = xls-xl(i,k)
            1397     4   p    v                  xlwork2 = -xl(i,k)*(prevp(i,k)+psevp(i,k)+pgevp(i,k))              &
            1398     4                                     -xlf*(pseml(i,k)+pgeml(i,k))
            1399     4   p    v                  t(i,k) = t(i,k)-xlwork2/cpm(i,k)*dtcld
            1400     4   p    v                endif
            1401     3   p    v              enddo
            1402     2   p                 enddo
            1403     1               !
            1404     1               ! Inline expansion for fpvs
            1405     1               !         qs(i,k,1) = fpvs(t(i,k),0,rd,rv,cpv,cliq,cicec,xlv0,xls,psat,t0c)
            1406     1               !         qs(i,k,2) = fpvs(t(i,k),1,rd,rv,cpv,cliq,cicec,xlv0,xls,psat,t0c)
            1407     1                     hsub = xls
            1408     1                     hvap = xlv0
            1409     1                     cvap = cpv
            1410     1                     ttp=t0c+0.01
            1411     1                     dldt=cvap-cliq
            1412     1                     xa=-dldt/rv
            1413     1                     xb=xa+hvap/(rv*ttp)
            1414     1                     dldti=cvap-cicec
            1415     1                     xai=-dldti/rv
            1416     1                     xbi=xai+hsub/(rv*ttp)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1417     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, p, qs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1418     3   p    v              do i = its, ite
            1419     3   p    v                tr=ttp/t(i,k)
            1420     3   p    v                qs(i,k,1)=psat*exp(log(tr)*(xa))*exp(xb*(1.-tr))
            1421     3   p    v                qs(i,k,1) = min(qs(i,k,1),0.99*p(i,k))
            1422     3   p    v                qs(i,k,1) = ep2 * qs(i,k,1) / (p(i,k) - qs(i,k,1))
            1423     3   p    v                qs(i,k,1) = max(qs(i,k,1),qmin)
            1424     3   p    v                tr=ttp/t(i,k)
            1425     4   p    v                if(t(i,k).lt.ttp) then
            1426     4   p    v                  qs(i,k,2)=psat*exp(log(tr)*(xai))*exp(xbi*(1.-tr))
            1427     4   p    v                else
            1428     4   p    v                  qs(i,k,2)=psat*exp(log(tr)*(xa))*exp(xb*(1.-tr))
            1429     4   p    v                endif
            1430     3   p    v                qs(i,k,2) = min(qs(i,k,2),0.99*p(i,k))
            1431     3   p    v                qs(i,k,2) = ep2 * qs(i,k,2) / (p(i,k) - qs(i,k,2))
            1432     3   p    v                qs(i,k,2) = max(qs(i,k,2),qmin)
            1433     3   p    v              enddo
            1434     2   p                 enddo
            1435     1               !
            1436     1               !----------------------------------------------------------------
            1437     1               !  pcond: condensational/evaporational rate of cloud water [HL A46] [RH83 A6]
            1438     1               !     if there exists additional water vapor condensated/if
            1439     1               !     evaporation of cloud water is not enough to remove subsaturation
            1440     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, cpm, qs, q, xl, qci, work1, pcond
                                   <<<      work2
                                   <<< Loop-information  End >>>
            1441     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xl, q, pcond, t, cpm, qci, qs, work1
                                   <<<      work2
                                   <<< Loop-information  End >>>
            1442     3   p    v              do i = its, ite
            1443     3   p    v                work1(i,k,1) = conden(t(i,k),q(i,k),qs(i,k,1),xl(i,k),cpm(i,k))
            1444     3   p    v                work2(i,k) = qci(i,k,1)+work1(i,k,1)
            1445     3   p    v                pcond(i,k) = min(max(work1(i,k,1)/dtcld,0.),max(q(i,k),0.)/dtcld)
            1446     3   p    v                if(qci(i,k,1).gt.0..and.work1(i,k,1).lt.0.)                          &
            1447     3                           pcond(i,k) = max(work1(i,k,1),-qci(i,k,1))/dtcld
            1448     3   p    v                q(i,k) = q(i,k)-pcond(i,k)*dtcld
            1449     3   p    v                qci(i,k,1) = max(qci(i,k,1)+pcond(i,k)*dtcld,0.)
            1450     3   p    v                t(i,k) = t(i,k)+pcond(i,k)*xl(i,k)/cpm(i,k)*dtcld
            1451     3   p    v              enddo
            1452     2   p                 enddo
            1453     1               !
            1454     1               !
            1455     1               !----------------------------------------------------------------
            1456     1               !     padding for small values
            1457     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qci
                                   <<< Loop-information  End >>>
            1458     2  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qci
                                   <<< Loop-information  End >>>
            1459     3   p   2v              do i = its, ite
            1460     3   p   2v                if(qci(i,k,1).le.qmin) qci(i,k,1) = 0.0
            1461     3   p   2v                if(qci(i,k,2).le.qmin) qci(i,k,2) = 0.0
            1462     3   p   2v              enddo
            1463     2   p                 enddo
            1464     1                     enddo                  ! big loops
            1465                     
            1466                       END SUBROUTINE wsm62d
            1467                     ! ...................................................................
            1468                           REAL FUNCTION rgmma(x)
            1469                     !-------------------------------------------------------------------
            1470                       IMPLICIT NONE
            1471                     !-------------------------------------------------------------------
            1472                     !     rgmma function:  use infinite product form
            1473                           REAL :: euler
            1474                           PARAMETER (euler=0.577215664901532)
            1475                           REAL :: x, y
            1476                           INTEGER :: i
            1477     1                     if(x.eq.1.)then
            1478     1                       rgmma=0.
            1479     1                         else
            1480     1                       rgmma=x*exp(euler*x)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1481     2  pp    v              do i=1,10000
            1482     2   p    v                y=float(i)
            1483     2   p    v                rgmma=rgmma*(1.000+x/y)*exp(-x/y)
            1484     2   p    v              enddo
            1485     1                       rgmma=1./rgmma
            1486     1                     endif
            1487                           END FUNCTION rgmma
            1488                     !
            1489                     !--------------------------------------------------------------------------
            1490                           REAL FUNCTION fpvs(t,ice,rd,rv,cvap,cliq,cicec,hvap,hsub,psat,t0c)
            1491                     !--------------------------------------------------------------------------
            1492                           IMPLICIT NONE
            1493                     !--------------------------------------------------------------------------
            1494                           REAL t,rd,rv,cvap,cliq,cicec,hvap,hsub,psat,t0c,dldt,xa,xb,dldti,         &
            1495                                xai,xbi,ttp,tr
            1496                           INTEGER ice
            1497                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
            1498                           ttp=t0c+0.01
            1499                           dldt=cvap-cliq
            1500                           xa=-dldt/rv
            1501                           xb=xa+hvap/(rv*ttp)
            1502                           dldti=cvap-cicec
            1503                           xai=-dldti/rv
            1504                           xbi=xai+hsub/(rv*ttp)
            1505                           tr=ttp/t
            1506     1                     if(t.lt.ttp.and.ice.eq.1) then
            1507     1                       fpvs=psat*(tr**xai)*exp(xbi*(1.-tr))
            1508     1                     else
            1509     1                       fpvs=psat*(tr**xa)*exp(xb*(1.-tr))
            1510     1                     endif
            1511                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
            1512                           END FUNCTION fpvs
            1513                     !-------------------------------------------------------------------
            1514                       SUBROUTINE wsm6init()
            1515                     !-------------------------------------------------------------------
            1516                       IMPLICIT NONE
            1517                     !-------------------------------------------------------------------
            1518                     !.... constants which may not be tunable
            1519                        REAL :: cl
            1520                        INTEGER :: hail_opt  ! RAS
            1521                     
            1522                     ! RAS13.1 define graupel parameters as graupel-like or hail-like,
            1523                     !         depending on namelist option
            1524                     
            1525                           hail_opt = 0
            1526     1                     IF (hail_opt .eq. 1) THEN !Hail!
            1527     1                        n0g       = 4.e4
            1528     1                        deng      = 700.
            1529     1                        avtg      = 285.0
            1530     1                        bvtg      = 0.8
            1531     1                        lamdagmax = 2.e4
            1532     1                     ELSE !Graupel!
            1533     1                        n0g       = 4.e6
            1534     1                        deng      = 500.
            1535     1                        avtg      = 330.0
            1536     1                        bvtg      = 0.8
            1537     1                        lamdagmax = 6.e4
            1538     1                     ENDIF
            1539                     !
            1540                        cl = cliq
            1541                        pi = 4.*atan(1.)
            1542                        xlv1 = cl-cpv
            1543                     
            1544                     !
            1545                     !rsun   qc0  = 4./3.*pi*denr*r0**3*xncr/den0  ! 0.419e-3 -- .61e-3
            1546                        qc0o  = 4./3.*pi*denr*r0**3*xncro/den0  ! 0.419e-3 -- .61e-3
            1547                        qc0l  = 4./3.*pi*denr*r0**3*xncrl/den0  ! 0.419e-3 -- .61e-3
            1548                     !rsun   qck1 = .104*9.8*peaut/(xncr*denr)**(1./3.)/xmyu*den0**(4./3.) ! 7.03
            1549                        qck1o = .104*9.8*peaut/(xncro*denr)**(1./3.)/xmyu*den0**(4./3.) ! 7.03
            1550                        qck1l = .104*9.8*peaut/(xncrl*denr)**(1./3.)/xmyu*den0**(4./3.) ! 7.03
            1551                        pidnc = pi*denr/6.        ! syb
            1552                     !
            1553                        bvtr1 = 1.+bvtr
            1554                        bvtr2 = 2.5+.5*bvtr
            1555                        bvtr3 = 3.+bvtr
            1556                        bvtr4 = 4.+bvtr
            1557                        bvtr6 = 6.+bvtr
            1558                        g1pbr = rgmma(bvtr1)
            1559                        g3pbr = rgmma(bvtr3)
            1560                        g4pbr = rgmma(bvtr4)            ! 17.837825
            1561                        g6pbr = rgmma(bvtr6)
            1562                        g5pbro2 = rgmma(bvtr2)          ! 1.8273
            1563                        pvtr = avtr*g4pbr/6.
            1564                        eacrr = 1.0
            1565                        pacrr = pi*n0r*avtr*g3pbr*.25*eacrr
            1566                        precr1 = 2.*pi*n0r*.78
            1567                        precr2 = 2.*pi*n0r*.31*avtr**.5*g5pbro2
            1568                        roqimax = 2.08e22*dimax**8
            1569                     !
            1570                        bvts1 = 1.+bvts
            1571                        bvts2 = 2.5+.5*bvts
            1572                        bvts3 = 3.+bvts
            1573                        bvts4 = 4.+bvts
            1574                        g1pbs = rgmma(bvts1)    !.8875
            1575                        g3pbs = rgmma(bvts3)
            1576                        g4pbs = rgmma(bvts4)    ! 12.0786
            1577                        g5pbso2 = rgmma(bvts2)
            1578                        pvts = avts*g4pbs/6.
            1579                        pacrs = pi*n0s*avts*g3pbs*.25
            1580                        precs1 = 4.*n0s*.65
            1581                        precs2 = 4.*n0s*.44*avts**.5*g5pbso2
            1582                        pidn0r =  pi*denr*n0r
            1583                        pidn0s =  pi*dens*n0s
            1584                     !
            1585                        pacrc = pi*n0s*avts*g3pbs*.25*eacrc
            1586                     !
            1587                        bvtg1 = 1.+bvtg
            1588                        bvtg2 = 2.5+.5*bvtg
            1589                        bvtg3 = 3.+bvtg
            1590                        bvtg4 = 4.+bvtg
            1591                        g1pbg = rgmma(bvtg1)
            1592                        g3pbg = rgmma(bvtg3)
            1593                        g4pbg = rgmma(bvtg4)
            1594                        pacrg = pi*n0g*avtg*g3pbg*.25
            1595                        g5pbgo2 = rgmma(bvtg2)
            1596                        pvtg = avtg*g4pbg/6.
            1597                        precg1 = 2.*pi*n0g*.78
            1598                        precg2 = 2.*pi*n0g*.31*avtg**.5*g5pbgo2
            1599                        pidn0g =  pi*deng*n0g
            1600                     
            1601                     !
            1602                        rslopermax = 1./lamdarmax
            1603                        rslopesmax = 1./lamdasmax
            1604                        rslopegmax = 1./lamdagmax
            1605                        rsloperbmax = rslopermax ** bvtr
            1606                        rslopesbmax = rslopesmax ** bvts
            1607                        rslopegbmax = rslopegmax ** bvtg
            1608                        rsloper2max = rslopermax * rslopermax
            1609                        rslopes2max = rslopesmax * rslopesmax
            1610                        rslopeg2max = rslopegmax * rslopegmax
            1611                        rsloper3max = rsloper2max * rslopermax
            1612                        rslopes3max = rslopes2max * rslopesmax
            1613                        rslopeg3max = rslopeg2max * rslopegmax
            1614                     
            1615                     !+---+-----------------------------------------------------------------+
            1616                     !..Set these variables needed for computing radar reflectivity.  These
            1617                     !.. get used within radar_init to create other variables used in the
            1618                     !.. radar module.
            1619                        xam_r = PI*denr/6.
            1620                        xbm_r = 3.
            1621                        xmu_r = 0.
            1622                        xam_s = PI*dens/6.
            1623                        xbm_s = 3.
            1624                        xmu_s = 0.
            1625                        xam_g = PI*deng/6.
            1626                        xbm_g = 3.
            1627                        xmu_g = 0.
            1628                     
            1629                     !+---+-----------------------------------------------------------------+
            1630                     
            1631                     !
            1632                       END SUBROUTINE wsm6init
            1633                     !------------------------------------------------------------------------------
            1634                           subroutine slope_wsm6(qrs,den,denfac,t,rslope,rslopeb,rslope2,rslope3,   &
            1635                                                 vt,its,ite,kts,kte)
            1636                       IMPLICIT NONE
            1637                       INTEGER       ::               its,ite, jts,jte, kts,kte
            1638                       REAL, DIMENSION( its:ite , kts:kte,3) ::                                     &
            1639                                                                                               qrs, &
            1640                                                                                            rslope, &
            1641                                                                                           rslopeb, &
            1642                                                                                           rslope2, &
            1643                                                                                           rslope3, &
            1644                                                                                                vt
            1645                       REAL, DIMENSION( its:ite , kts:kte) ::                                       &
            1646                                                                                               den, &
            1647                                                                                            denfac, &
            1648                                                                                                 t
            1649                       REAL, PARAMETER  :: t0c = 273.15
            1650                       REAL, DIMENSION( its:ite , kts:kte ) ::                                      &
            1651                                                                                            n0sfac
            1652                       REAL       ::  lamdar, lamdas, lamdag, x, y, z, supcol
            1653                       integer :: i, j, k
            1654                     !----------------------------------------------------------------
            1655                     !     size distributions: (x=mixing ratio, y=air density):
            1656                     !     valid for mixing ratio > 1.e-9 kg/kg.
            1657                           lamdar(x,y)=   sqrt(sqrt(pidn0r/(x*y)))      ! (pidn0r/(x*y))**.25
            1658                           lamdas(x,y,z)= sqrt(sqrt(pidn0s*z/(x*y)))    ! (pidn0s*z/(x*y))**.25
            1659                           lamdag(x,y)=   sqrt(sqrt(pidn0g/(x*y)))      ! (pidn0g/(x*y))**.25
            1660                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1661     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, den, rslope3, rslope2, rslope
                                   <<<      rslopeb, denfac, vt, t
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      n0sfac: 2, rslope3: 2, rslope2: 2
                                   <<<      rslopeb: 2, vt: 2, rslope: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 5  FILL 36
                                   <<<      PREDICATE : SPILL 2  FILL 2
                                   <<< Loop-information  End >>>
            1662     2   p    v              do i = its, ite
            1663     2   p    v                supcol = t0c-t(i,k)
            1664     2               !---------------------------------------------------------------
            1665     2               ! n0s: Intercept parameter for snow [m-4] [HDC 6]
            1666     2               !---------------------------------------------------------------
            1667     2   p    v                n0sfac(i,k) = max(min(exp(alpha*supcol),n0smax/n0s),1.)
            1668     3   p    v                if(qrs(i,k,1).le.qcrmin)then
            1669     3   p    v                  rslope(i,k,1) = rslopermax
            1670     3   p    v                  rslopeb(i,k,1) = rsloperbmax
            1671     3   p    v                  rslope2(i,k,1) = rsloper2max
            1672     3   p    v                  rslope3(i,k,1) = rsloper3max
            1673     3   p    v                else
            1674     3   p    v                  rslope(i,k,1) = 1./lamdar(qrs(i,k,1),den(i,k))
            1675     3   p    v                  rslopeb(i,k,1) = rslope(i,k,1)**bvtr
            1676     3   p    v                  rslope2(i,k,1) = rslope(i,k,1)*rslope(i,k,1)
            1677     3   p    v                  rslope3(i,k,1) = rslope2(i,k,1)*rslope(i,k,1)
            1678     3   p    v                endif
            1679     3   p    v                if(qrs(i,k,2).le.qcrmin)then
            1680     3   p    v                  rslope(i,k,2) = rslopesmax
            1681     3   p    v                  rslopeb(i,k,2) = rslopesbmax
            1682     3   p    v                  rslope2(i,k,2) = rslopes2max
            1683     3   p    v                  rslope3(i,k,2) = rslopes3max
            1684     3   p    v                else
            1685     3   p    v                  rslope(i,k,2) = 1./lamdas(qrs(i,k,2),den(i,k),n0sfac(i,k))
            1686     3   p    v                  rslopeb(i,k,2) = rslope(i,k,2)**bvts
            1687     3   p    v                  rslope2(i,k,2) = rslope(i,k,2)*rslope(i,k,2)
            1688     3   p    v                  rslope3(i,k,2) = rslope2(i,k,2)*rslope(i,k,2)
            1689     3   p    v                endif
            1690     3   p    v                if(qrs(i,k,3).le.qcrmin)then
            1691     3   p    v                  rslope(i,k,3) = rslopegmax
            1692     3   p    v                  rslopeb(i,k,3) = rslopegbmax
            1693     3   p    v                  rslope2(i,k,3) = rslopeg2max
            1694     3   p    v                  rslope3(i,k,3) = rslopeg3max
            1695     3   p    v                else
            1696     3   p    v                  rslope(i,k,3) = 1./lamdag(qrs(i,k,3),den(i,k))
            1697     3   p    v                  rslopeb(i,k,3) = rslope(i,k,3)**bvtg
            1698     3   p    v                  rslope2(i,k,3) = rslope(i,k,3)*rslope(i,k,3)
            1699     3   p    v                  rslope3(i,k,3) = rslope2(i,k,3)*rslope(i,k,3)
            1700     3   p    v                endif
            1701     2   p    v                vt(i,k,1) = pvtr*rslopeb(i,k,1)*denfac(i,k)
            1702     2   p    v                vt(i,k,2) = pvts*rslopeb(i,k,2)*denfac(i,k)
            1703     2   p    v                vt(i,k,3) = pvtg*rslopeb(i,k,3)*denfac(i,k)
            1704     2   p    v                if(qrs(i,k,1).le.0.0) vt(i,k,1) = 0.0
            1705     2   p    v                if(qrs(i,k,2).le.0.0) vt(i,k,2) = 0.0
            1706     2   p    v                if(qrs(i,k,3).le.0.0) vt(i,k,3) = 0.0
            1707     2   p    v              enddo
            1708     1   p                 enddo
            1709                       END subroutine slope_wsm6
            1710                     !-----------------------------------------------------------------------------
            1711                           subroutine slope_rain(qrs,den,denfac,t,rslope,rslopeb,rslope2,rslope3,   &
            1712                                                 vt,its,ite,kts,kte)
            1713                       IMPLICIT NONE
            1714                       INTEGER       ::               its,ite, jts,jte, kts,kte
            1715                       REAL, DIMENSION( its:ite , kts:kte) ::                                       &
            1716                                                                                               qrs, &
            1717                                                                                            rslope, &
            1718                                                                                           rslopeb, &
            1719                                                                                           rslope2, &
            1720                                                                                           rslope3, &
            1721                                                                                                vt, &
            1722                                                                                               den, &
            1723                                                                                            denfac, &
            1724                                                                                                 t
            1725                       REAL, PARAMETER  :: t0c = 273.15
            1726                       REAL, DIMENSION( its:ite , kts:kte ) ::                                      &
            1727                                                                                            n0sfac
            1728                       REAL       ::  lamdar, x, y, z, supcol
            1729                       integer :: i, j, k
            1730                     !----------------------------------------------------------------
            1731                     !     size distributions: (x=mixing ratio, y=air density):
            1732                     !     valid for mixing ratio > 1.e-9 kg/kg.
            1733                           lamdar(x,y)=   sqrt(sqrt(pidn0r/(x*y)))      ! (pidn0r/(x*y))**.25
            1734                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1735     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, den, rslope3, rslope2, rslope
                                   <<<      denfac, rslopeb, vt
                                   <<< Loop-information  End >>>
            1736     2   p    v              do i = its, ite
            1737     3   p    v                if(qrs(i,k).le.qcrmin)then
            1738     3   p    v                  rslope(i,k) = rslopermax
            1739     3   p    v                  rslopeb(i,k) = rsloperbmax
            1740     3   p    v                  rslope2(i,k) = rsloper2max
            1741     3   p    v                  rslope3(i,k) = rsloper3max
            1742     3   p    v                else
            1743     3   p    v                  rslope(i,k) = 1./lamdar(qrs(i,k),den(i,k))
            1744     3   p    v                  rslopeb(i,k) = rslope(i,k)**bvtr
            1745     3   p    v                  rslope2(i,k) = rslope(i,k)*rslope(i,k)
            1746     3   p    v                  rslope3(i,k) = rslope2(i,k)*rslope(i,k)
            1747     3   p    v                endif
            1748     2   p    v                vt(i,k) = pvtr*rslopeb(i,k)*denfac(i,k)
            1749     2   p    v                if(qrs(i,k).le.0.0) vt(i,k) = 0.0
            1750     2   p    v              enddo
            1751     1   p                 enddo
            1752                       END subroutine slope_rain
            1753                     !------------------------------------------------------------------------------
            1754                           subroutine slope_snow(qrs,den,denfac,t,rslope,rslopeb,rslope2,rslope3,   &
            1755                                                 vt,its,ite,kts,kte)
            1756                       IMPLICIT NONE
            1757                       INTEGER       ::               its,ite, jts,jte, kts,kte
            1758                       REAL, DIMENSION( its:ite , kts:kte) ::                                       &
            1759                                                                                               qrs, &
            1760                                                                                            rslope, &
            1761                                                                                           rslopeb, &
            1762                                                                                           rslope2, &
            1763                                                                                           rslope3, &
            1764                                                                                                vt, &
            1765                                                                                               den, &
            1766                                                                                            denfac, &
            1767                                                                                                 t
            1768                       REAL, PARAMETER  :: t0c = 273.15
            1769                       REAL, DIMENSION( its:ite , kts:kte ) ::                                      &
            1770                                                                                            n0sfac
            1771                       REAL       ::  lamdas, x, y, z, supcol
            1772                       integer :: i, j, k
            1773                     !----------------------------------------------------------------
            1774                     !     size distributions: (x=mixing ratio, y=air density):
            1775                     !     valid for mixing ratio > 1.e-9 kg/kg.
            1776                           lamdas(x,y,z)= sqrt(sqrt(pidn0s*z/(x*y)))    ! (pidn0s*z/(x*y))**.25
            1777                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1778     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, t, n0sfac, den, rslope2, rslope3
                                   <<<      denfac, rslopeb, vt, rslope
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1779     2   p    v              do i = its, ite
            1780     2   p    v                supcol = t0c-t(i,k)
            1781     2               !---------------------------------------------------------------
            1782     2               ! n0s: Intercept parameter for snow [m-4] [HDC 6]
            1783     2               !---------------------------------------------------------------
            1784     2   p    v                n0sfac(i,k) = max(min(exp(alpha*supcol),n0smax/n0s),1.)
            1785     3   p    v                if(qrs(i,k).le.qcrmin)then
            1786     3   p    v                  rslope(i,k) = rslopesmax
            1787     3   p    v                  rslopeb(i,k) = rslopesbmax
            1788     3   p    v                  rslope2(i,k) = rslopes2max
            1789     3   p    v                  rslope3(i,k) = rslopes3max
            1790     3   p    v                else
            1791     3   p    v                  rslope(i,k) = 1./lamdas(qrs(i,k),den(i,k),n0sfac(i,k))
            1792     3   p    v                  rslopeb(i,k) = rslope(i,k)**bvts
            1793     3   p    v                  rslope2(i,k) = rslope(i,k)*rslope(i,k)
            1794     3   p    v                  rslope3(i,k) = rslope2(i,k)*rslope(i,k)
            1795     3   p    v                endif
            1796     2   p    v                vt(i,k) = pvts*rslopeb(i,k)*denfac(i,k)
            1797     2   p    v                if(qrs(i,k).le.0.0) vt(i,k) = 0.0
            1798     2   p    v              enddo
            1799     1   p                 enddo
            1800                       END subroutine slope_snow
            1801                     !----------------------------------------------------------------------------------
            1802                           subroutine slope_graup(qrs,den,denfac,t,rslope,rslopeb,rslope2,rslope3,   &
            1803                                                 vt,its,ite,kts,kte)
            1804                       IMPLICIT NONE
            1805                       INTEGER       ::               its,ite, jts,jte, kts,kte
            1806                       REAL, DIMENSION( its:ite , kts:kte) ::                                       &
            1807                                                                                               qrs, &
            1808                                                                                            rslope, &
            1809                                                                                           rslopeb, &
            1810                                                                                           rslope2, &
            1811                                                                                           rslope3, &
            1812                                                                                                vt, &
            1813                                                                                               den, &
            1814                                                                                            denfac, &
            1815                                                                                                 t
            1816                       REAL, PARAMETER  :: t0c = 273.15
            1817                       REAL, DIMENSION( its:ite , kts:kte ) ::                                      &
            1818                                                                                            n0sfac
            1819                       REAL       ::  lamdag, x, y, z, supcol
            1820                       integer :: i, j, k
            1821                     !----------------------------------------------------------------
            1822                     !     size distributions: (x=mixing ratio, y=air density):
            1823                     !     valid for mixing ratio > 1.e-9 kg/kg.
            1824                           lamdag(x,y)=   sqrt(sqrt(pidn0g/(x*y)))      ! (pidn0g/(x*y))**.25
            1825                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1826     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, den, rslope3, rslope2, rslope
                                   <<<      denfac, rslopeb, vt
                                   <<< Loop-information  End >>>
            1827     2   p    v              do i = its, ite
            1828     2               !---------------------------------------------------------------
            1829     2               ! n0s: Intercept parameter for snow [m-4] [HDC 6]
            1830     2               !---------------------------------------------------------------
            1831     3   p    v                if(qrs(i,k).le.qcrmin)then
            1832     3   p    v                  rslope(i,k) = rslopegmax
            1833     3   p    v                  rslopeb(i,k) = rslopegbmax
            1834     3   p    v                  rslope2(i,k) = rslopeg2max
            1835     3   p    v                  rslope3(i,k) = rslopeg3max
            1836     3   p    v                else
            1837     3   p    v                  rslope(i,k) = 1./lamdag(qrs(i,k),den(i,k))
            1838     3   p    v                  rslopeb(i,k) = rslope(i,k)**bvtg
            1839     3   p    v                  rslope2(i,k) = rslope(i,k)*rslope(i,k)
            1840     3   p    v                  rslope3(i,k) = rslope2(i,k)*rslope(i,k)
            1841     3   p    v                endif
            1842     2   p    v                vt(i,k) = pvtg*rslopeb(i,k)*denfac(i,k)
            1843     2   p    v                if(qrs(i,k).le.0.0) vt(i,k) = 0.0
            1844     2   p    v              enddo
            1845     1   p                 enddo
            1846                       END subroutine slope_graup
            1847                     !---------------------------------------------------------------------------------
            1848                     !-------------------------------------------------------------------
            1849                           SUBROUTINE nislfv_rain_plm(im,km,denl,denfacl,tkl,dzl,wwl,rql,precip,dt,id,iter)
            1850                     !-------------------------------------------------------------------
            1851                     !
            1852                     ! for non-iteration semi-Lagrangain forward advection for cloud
            1853                     ! with mass conservation and positive definite advection
            1854                     ! 2nd order interpolation with monotonic piecewise linear method
            1855                     ! this routine is under assumption of decfl < 1 for semi_Lagrangian
            1856                     !
            1857                     ! dzl    depth of model layer in meter
            1858                     ! wwl    terminal velocity at model layer m/s
            1859                     ! rql    cloud density*mixing ration
            1860                     ! precip precipitation
            1861                     ! dt     time step
            1862                     ! id     kind of precip: 0 test case; 1 raindrop
            1863                     ! iter   how many time to guess mean terminal velocity: 0 pure forward.
            1864                     !        0 : use departure wind for advection
            1865                     !        1 : use mean wind for advection
            1866                     !        > 1 : use mean wind after iter-1 iterations
            1867                     !
            1868                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            1869                     !         implemented by song-you hong
            1870                     !
            1871                           implicit none
            1872                           integer  im,km,id
            1873                           real  dt
            1874                           real  dzl(im,km),wwl(im,km),rql(im,km),precip(im)
            1875                           real  denl(im,km),denfacl(im,km),tkl(im,km)
            1876                     !
            1877                           integer  i,k,n,m,kk,kb,kt,iter
            1878                           real  tl,tl2,qql,dql,qqd
            1879                           real  th,th2,qqh,dqh
            1880                           real  zsum,qsum,dim,dip,c1,con1,fa1,fa2
            1881                           real  allold, allnew, zz, dzamin, cflmax, decfl
            1882                           real  dz(km), ww(km), qq(km), wd(km), wa(km), was(km)
            1883                           real  den(km), denfac(km), tk(km)
            1884                           real  wi(km+1), zi(km+1), za(km+2) !hmhj
            1885                           real  qn(km), qr(km),tmp(km),tmp1(km),tmp2(km),tmp3(km)
            1886                           real  dza(km+1), qa(km+1), qmi(km+1), qpi(km+1)
            1887                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      precip
                                   <<< Loop-information  End >>>
            1888        pp   4v            precip(:) = 0.0
            1889                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi, ww, wd, qa, dza, qpi, qmi, qn
                                   <<< Loop-information  End >>>
            1890     1                     i_loop : do i=1,im
            1891     1               ! -----------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 381
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.57, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tk, denfac, den, ww, qq, dz
                                   <<< Loop-information  End >>>
            1892     1  pp    v            dz(:) = dzl(i,:)
            1893     1   p    v            qq(:) = rql(i,:)
            1894     1   p    v            ww(:) = wwl(i,:)
            1895     1   p    v            den(:) = denl(i,:)
            1896     1   p    v            denfac(:) = denfacl(i,:)
            1897     1   p    v            tk(:) = tkl(i,:)
            1898     1               ! skip for no precipitation for all layers
            1899     1                     allold = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            1900     2  pp    v            do k=1,km
            1901     2   p    v              allold = allold + qq(k)
            1902     2   p    v            enddo
            1903     2                     if(allold.le.0.0) then
            1904     2                       cycle i_loop
            1905     2                     endif
            1906     1               !
            1907     1               ! compute interface values
            1908     1                     zi(1)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi
                                   <<< Loop-information  End >>>
            1909     2   s   2s            do k=1,km
            1910     2   s   2s              zi(k+1) = zi(k)+dz(k)
            1911     2   s   2s            enddo
            1912     1               !
            1913     1               ! save departure wind
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wd
                                   <<< Loop-information  End >>>
            1914     1  pp   4v            wd(:) = ww(:)
            1915     1                     n=1
            1916     1                100  continue
            1917     1               ! plm is 2nd order, we can use 2nd order wi or 3rd order wi
            1918     1               ! 2nd order interpolation to get wi
            1919     1               !      wi(1) = ww(1)
            1920     1               !      wi(km+1) = ww(km)
            1921     1               !      do k=2,km
            1922     1               !        wi(k) = (ww(k)*dz(k-1)+ww(k-1)*dz(k))/(dz(k-1)+dz(k))
            1923     1               !      enddo
            1924     1               ! 3rd order interpolation to get wi
            1925     1                     fa1 = 9./16.
            1926     1                     fa2 = 1./16.
            1927     1                     wi(1) = ww(1)
            1928     1                     wi(2) = 0.5*(ww(2)+ww(1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            1929     2  pp   2v            do k=3,km-1
            1930     2   p   2v              wi(k) = fa1*(ww(k)+ww(k-1))-fa2*(ww(k+1)+ww(k-2))
            1931     2   p   2v            enddo
            1932     1                     wi(km) = 0.5*(ww(km)+ww(km-1))
            1933     1                     wi(km+1) = ww(km)
            1934     1               !
            1935     1               ! terminate of top of raingroup
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            1936     2  pp   2v            do k=2,km
            1937     2   p   2v              if( ww(k).eq.0.0 ) wi(k)=ww(k-1)
            1938     2   p   2v            enddo
            1939     1               !
            1940     1               ! diffusivity of wi
            1941     1                     con1 = 0.05
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, dz
                                   <<< Loop-information  End >>>
            1942     2   s   2s            do k=km,1,-1
            1943     2   m   2m              decfl = (wi(k+1)-wi(k))*dt/dz(k)
            1944     3   s   2s              if( decfl .gt. con1 ) then
            1945     3   s   2s                wi(k) = wi(k+1) - con1*dz(k)/dt
            1946     3   p   2v              endif
            1947     2   p   2v            enddo
            1948     1               ! compute arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, zi, za
                                   <<< Loop-information  End >>>
            1949     2  pp   2v            do k=1,km+1
            1950     2   p   2v              za(k) = zi(k) - wi(k)*dt
            1951     2   p   2v            enddo
            1952     1                     za(km+2)=zi(km+1) !hmhj
            1953     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za, dza
                                   <<< Loop-information  End >>>
            1954     2  pp   2v            do k=1,km+1 !hmhj
            1955     2   p   2v              dza(k) = za(k+1)-za(k)
            1956     2   p   2v            enddo
            1957     1               !hmhj      dza(km+1) = zi(km+1) - za(km+1)
            1958     1               !
            1959     1               ! computer deformation at arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, qq, dza, den, qr, qa
                                   <<< Loop-information  End >>>
            1960     2  pp    v            do k=1,km
            1961     2   p    v              qa(k) = qq(k)*dz(k)/dza(k)
            1962     2   p    v              qr(k) = qa(k)/den(k)
            1963     2   p    v            enddo
            1964     1                     qa(km+1) = 0.0
            1965     1               !     call maxmin(km,1,qa,' arrival points ')
            1966     1               !
            1967     1               ! compute arrival terminal velocity, and estimate mean terminal velocity
            1968     1               ! then back to use mean terminal velocity
            1969     2                     if( n.le.iter ) then
            1970     2                       call slope_rain(qr,den,denfac,tk,tmp,tmp1,tmp2,tmp3,wa,1,1,1,km)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, was
                                   <<< Loop-information  End >>>
            1971     2  pp   2v              if( n.ge.2 ) wa(1:km)=0.5*(wa(1:km)+was(1:km))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, wd, ww
                                   <<< Loop-information  End >>>
            1972     3  pp   2v              do k=1,km
            1973     3               !#ifdef DEBUG
            1974     3               !        print*,' slope_wsm3 ',qr(k)*1000.,den(k),denfac(k),tk(k),tmp(k),tmp1(k),tmp2(k),ww(k),wa(k)
            1975     3               !#endif
            1976     3               ! mean wind is average of departure and new arrival winds
            1977     3   p   2v                ww(k) = 0.5* ( wd(k)+wa(k) )
            1978     3   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, was
                                   <<< Loop-information  End >>>
            1979     2  pp   4v              was(:) = wa(:)
            1980     2                       n=n+1
            1981     2                       go to 100
            1982     2                     endif
            1983     1               !
            1984     1               ! estimate values at arrival cell interface with monotone
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qmi, qpi
                                   <<< Loop-information  End >>>
            1985     2  pp    v            do k=2,km
            1986     2   p    v              dip=(qa(k+1)-qa(k))/(dza(k+1)+dza(k))
            1987     2   p    v              dim=(qa(k)-qa(k-1))/(dza(k-1)+dza(k))
            1988     3   p    v              if( dip*dim.le.0.0 ) then
            1989     3   p    v                qmi(k)=qa(k)
            1990     3   p    v                qpi(k)=qa(k)
            1991     3   p    v              else
            1992     3   p    v                qpi(k)=qa(k)+0.5*(dip+dim)*dza(k)
            1993     3   p    v                qmi(k)=2.0*qa(k)-qpi(k)
            1994     4   p    v                if( qpi(k).lt.0.0 .or. qmi(k).lt.0.0 ) then
            1995     4   p    v                  qpi(k) = qa(k)
            1996     4   p    v                  qmi(k) = qa(k)
            1997     4   p    v                endif
            1998     3   p    v              endif
            1999     2   p    v            enddo
            2000     1                     qpi(1)=qa(1)
            2001     1                     qmi(1)=qa(1)
            2002     1                     qmi(km+1)=qa(km+1)
            2003     1                     qpi(km+1)=qa(km+1)
            2004     1               !
            2005     1               ! interpolation to regular point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            2006     1  pp   4v            qn = 0.0
            2007     1                     kb=1
            2008     1                     kt=1
            2009     2                     intp : do k=1,km
            2010     2                            kb=max(kb-1,1)
            2011     2                            kt=max(kt-1,1)
            2012     2               ! find kb and kt
            2013     3                            if( zi(k).ge.za(km+1) ) then
            2014     3                              exit intp
            2015     3                            else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            2016     4                              find_kb : do kk=kb,km
            2017     5                                        if( zi(k).le.za(kk+1) ) then
            2018     5                                          kb = kk
            2019     5                                          exit find_kb
            2020     5                                        else
            2021     5                                          cycle find_kb
            2022     5                                        endif
            2023     4                              enddo find_kb
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            2024     4                              find_kt : do kk=kt,km+2  !hmhj
            2025     5                                        if( zi(k+1).le.za(kk) ) then
            2026     5                                          kt = kk
            2027     5                                          exit find_kt
            2028     5                                        else
            2029     5                                          cycle find_kt
            2030     5                                        endif
            2031     4                              enddo find_kt
            2032     3                              kt = kt - 1
            2033     3               ! compute q with piecewise constant method
            2034     4                              if( kt.eq.kb ) then
            2035     4                                tl=(zi(k)-za(kb))/dza(kb)
            2036     4                                th=(zi(k+1)-za(kb))/dza(kb)
            2037     4                                tl2=tl*tl
            2038     4                                th2=th*th
            2039     4                                qqd=0.5*(qpi(kb)-qmi(kb))
            2040     4                                qqh=qqd*th2+qmi(kb)*th
            2041     4                                qql=qqd*tl2+qmi(kb)*tl
            2042     4                                qn(k) = (qqh-qql)/(th-tl)
            2043     4                              else if( kt.gt.kb ) then
            2044     4                                tl=(zi(k)-za(kb))/dza(kb)
            2045     4                                tl2=tl*tl
            2046     4                                qqd=0.5*(qpi(kb)-qmi(kb))
            2047     4                                qql=qqd*tl2+qmi(kb)*tl
            2048     4                                dql = qa(kb)-qql
            2049     4                                zsum  = (1.-tl)*dza(kb)
            2050     4                                qsum  = dql*dza(kb)
            2051     5                                if( kt-kb.gt.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2052     6  pp    v                       do m=kb+1,kt-1
            2053     6   p    v                         zsum = zsum + dza(m)
            2054     6   p    v                         qsum = qsum + qa(m) * dza(m)
            2055     6   p    v                       enddo
            2056     5                                endif
            2057     4                                th=(zi(k+1)-za(kt))/dza(kt)
            2058     4                                th2=th*th
            2059     4                                qqd=0.5*(qpi(kt)-qmi(kt))
            2060     4                                dqh=qqd*th2+qmi(kt)*th
            2061     4                                zsum  = zsum + th*dza(kt)
            2062     4                                qsum  = qsum + dqh*dza(kt)
            2063     4                                qn(k) = qsum/zsum
            2064     4                              endif
            2065     3                              cycle intp
            2066     3                            endif
            2067     2               !
            2068     2                      enddo intp
            2069     1               !
            2070     1               ! rain out
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            2071     2                     sum_precip: do k=1,km
            2072     3                                   if( za(k).lt.0.0 .and. za(k+1).lt.0.0 ) then
            2073     3                                     precip(i) = precip(i) + qa(k)*dza(k)
            2074     3                                     cycle sum_precip
            2075     3                                   else if ( za(k).lt.0.0 .and. za(k+1).ge.0.0 ) then
            2076     3               !hmhj for pcm         precip(i) = precip(i) + qa(k)*(0.0-za(k))
            2077     3                                     th = (0.0-za(k))/dza(k)
            2078     3                                     th2= th*th
            2079     3                                     qqd = 0.5*(qpi(k)-qmi(k))
            2080     3                                     qqh = qqd*th2+qmi(k)*th
            2081     3                                     precip(i) = precip(i) + qqh*dza(k)
            2082     3                                     exit sum_precip
            2083     3                                   endif
            2084     2                                   exit sum_precip
            2085     2                     enddo sum_precip
            2086     1               !
            2087     1               ! replace the new values
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            2088     1  pp   2v            rql(i,:) = qn(:)
            2089     1               !
            2090     1               ! ----------------------------------
            2091     1                     enddo i_loop
            2092                     !
            2093                       END SUBROUTINE nislfv_rain_plm
            2094                     !-------------------------------------------------------------------
            2095                           SUBROUTINE nislfv_rain_plm6(im,km,denl,denfacl,tkl,dzl,wwl,rql,rql2, precip1, precip2,dt,id,iter)
            2096                     !-------------------------------------------------------------------
            2097                     !
            2098                     ! for non-iteration semi-Lagrangain forward advection for cloud
            2099                     ! with mass conservation and positive definite advection
            2100                     ! 2nd order interpolation with monotonic piecewise linear method
            2101                     ! this routine is under assumption of decfl < 1 for semi_Lagrangian
            2102                     !
            2103                     ! dzl    depth of model layer in meter
            2104                     ! wwl    terminal velocity at model layer m/s
            2105                     ! rql    cloud density*mixing ration
            2106                     ! precip precipitation
            2107                     ! dt     time step
            2108                     ! id     kind of precip: 0 test case; 1 raindrop
            2109                     ! iter   how many time to guess mean terminal velocity: 0 pure forward.
            2110                     !        0 : use departure wind for advection
            2111                     !        1 : use mean wind for advection
            2112                     !        > 1 : use mean wind after iter-1 iterations
            2113                     !
            2114                     ! author: hann-ming henry juang <henry.juang@noaa.gov>
            2115                     !         implemented by song-you hong
            2116                     !
            2117                           implicit none
            2118                           integer  im,km,id
            2119                           real  dt
            2120                           real  dzl(im,km),wwl(im,km),rql(im,km),rql2(im,km),precip(im),precip1(im),precip2(im)
            2121                           real  denl(im,km),denfacl(im,km),tkl(im,km)
            2122                     !
            2123                           integer  i,k,n,m,kk,kb,kt,iter,ist
            2124                           real  tl,tl2,qql,dql,qqd
            2125                           real  th,th2,qqh,dqh
            2126                           real  zsum,qsum,dim,dip,c1,con1,fa1,fa2
            2127                           real  allold, allnew, zz, dzamin, cflmax, decfl
            2128                           real  dz(km), ww(km), qq(km), qq2(km), wd(km), wa(km), wa2(km), was(km)
            2129                           real  den(km), denfac(km), tk(km)
            2130                           real  wi(km+1), zi(km+1), za(km+2) !hmhj
            2131                           real  qn(km), qr(km),qr2(km),tmp(km),tmp1(km),tmp2(km),tmp3(km)
            2132                           real  dza(km+1), qa(km+1), qa2(km+1),qmi(km+1), qpi(km+1)
            2133                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      precip2, precip1, precip
                                   <<< Loop-information  End >>>
            2134        pp   2v            precip(:) = 0.0
            2135         p   2v            precip1(:) = 0.0
            2136         p   2v            precip2(:) = 0.0
            2137                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi, ww, wd
                                   <<< Loop-information  End >>>
            2138     1                     i_loop : do i=1,im
            2139     1               ! -----------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.56, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tk, denfac, den, ww, qq2, qq, dz
                                   <<< Loop-information  End >>>
            2140     1  pp    v            dz(:) = dzl(i,:)
            2141     1   p    v            qq(:) = rql(i,:)
            2142     1   p    v            qq2(:) = rql2(i,:)
            2143     1   p    v            ww(:) = wwl(i,:)
            2144     1   p    v            den(:) = denl(i,:)
            2145     1   p    v            denfac(:) = denfacl(i,:)
            2146     1   p    v            tk(:) = tkl(i,:)
            2147     1               ! skip for no precipitation for all layers
            2148     1                     allold = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2149     2  pp    v            do k=1,km
            2150     2   p    v              allold = allold + qq(k) + qq2(k)
            2151     2   p    v            enddo
            2152     2                     if(allold.le.0.0) then
            2153     2                       cycle i_loop
            2154     2                     endif
            2155     1               !
            2156     1               ! compute interface values
            2157     1                     zi(1)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.55, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dz, zi
                                   <<< Loop-information  End >>>
            2158     2   s   2s            do k=1,km
            2159     2   s   2s              zi(k+1) = zi(k)+dz(k)
            2160     2   s   2s            enddo
            2161     1               !
            2162     1               ! save departure wind
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wd
                                   <<< Loop-information  End >>>
            2163     1  pp   4v            wd(:) = ww(:)
            2164     1                     n=1
            2165     1                100  continue
            2166     1               ! plm is 2nd order, we can use 2nd order wi or 3rd order wi
            2167     1               ! 2nd order interpolation to get wi
            2168     1               !      wi(1) = ww(1)
            2169     1               !      wi(km+1) = ww(km)
            2170     1               !      do k=2,km
            2171     1               !        wi(k) = (ww(k)*dz(k-1)+ww(k-1)*dz(k))/(dz(k-1)+dz(k))
            2172     1               !      enddo
            2173     1               ! 3rd order interpolation to get wi
            2174     1                     fa1 = 9./16.
            2175     1                     fa2 = 1./16.
            2176     1                     wi(1) = ww(1)
            2177     1                     wi(2) = 0.5*(ww(2)+ww(1))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 640
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            2178     2  pp   2v            do k=3,km-1
            2179     2   p   2v              wi(k) = fa1*(ww(k)+ww(k-1))-fa2*(ww(k+1)+ww(k-2))
            2180     2   p   2v            enddo
            2181     1                     wi(km) = 0.5*(ww(km)+ww(km-1))
            2182     1                     wi(km+1) = ww(km)
            2183     1               !
            2184     1               ! terminate of top of raingroup
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww, wi
                                   <<< Loop-information  End >>>
            2185     2  pp   2v            do k=2,km
            2186     2   p   2v              if( ww(k).eq.0.0 ) wi(k)=ww(k-1)
            2187     2   p   2v            enddo
            2188     1               !
            2189     1               ! diffusivity of wi
            2190     1                     con1 = 0.05
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, dz
                                   <<< Loop-information  End >>>
            2191     2   s   2s            do k=km,1,-1
            2192     2   m   2m              decfl = (wi(k+1)-wi(k))*dt/dz(k)
            2193     3   s   2s              if( decfl .gt. con1 ) then
            2194     3   s   2s                wi(k) = wi(k+1) - con1*dz(k)/dt
            2195     3   p   2v              endif
            2196     2   p   2v            enddo
            2197     1               ! compute arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wi, zi, za
                                   <<< Loop-information  End >>>
            2198     2  pp   2v            do k=1,km+1
            2199     2   p   2v              za(k) = zi(k) - wi(k)*dt
            2200     2   p   2v            enddo
            2201     1                     za(km+2)=zi(km+1) !hmhj
            2202     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za, dza
                                   <<< Loop-information  End >>>
            2203     2  pp   2v            do k=1,km+1 !hmhj
            2204     2   p   2v              dza(k) = za(k+1)-za(k)
            2205     2   p   2v            enddo
            2206     1               !hmhj      dza(km+1) = zi(km+1) - za(km+1)
            2207     1               !
            2208     1               ! computer deformation at arrival point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.65, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, dza, den, qq2, dz, qr2, qa2, qr, qa
                                   <<< Loop-information  End >>>
            2209     2  pp    v            do k=1,km
            2210     2   p    v              qa(k) = qq(k)*dz(k)/dza(k)
            2211     2   p    v              qa2(k) = qq2(k)*dz(k)/dza(k)
            2212     2   p    v              qr(k) = qa(k)/den(k)
            2213     2   p    v              qr2(k) = qa2(k)/den(k)
            2214     2   p    v            enddo
            2215     1                     qa(km+1) = 0.0
            2216     1                     qa2(km+1) = 0.0
            2217     1               !     call maxmin(km,1,qa,' arrival points ')
            2218     1               !
            2219     1               ! compute arrival terminal velocity, and estimate mean terminal velocity
            2220     1               ! then back to use mean terminal velocity
            2221     2                     if( n.le.iter ) then
            2222     2                       call slope_snow(qr,den,denfac,tk,tmp,tmp1,tmp2,tmp3,wa,1,1,1,km)
            2223     2                       call slope_graup(qr2,den,denfac,tk,tmp,tmp1,tmp2,tmp3,wa2,1,1,1,km)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, qr2, qr, wa2, tmp
                                   <<< Loop-information  End >>>
            2224     3  pp    v              do k = 1, km
            2225     3   p    v                tmp(k) = max((qr(k)+qr2(k)), 1.E-15)
            2226     4   p    v                IF ( tmp(k) .gt. 1.e-15 ) THEN
            2227     4   p    v                  wa(k) = (wa(k)*qr(k) + wa2(k)*qr2(k))/tmp(k)
            2228     4   p    v                ELSE
            2229     4   p    v                  wa(k) = 0.
            2230     4   p    v                ENDIF
            2231     3   p    v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, was
                                   <<< Loop-information  End >>>
            2232     2  pp   2v              if( n.ge.2 ) wa(1:km)=0.5*(wa(1:km)+was(1:km))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, wd, ww
                                   <<< Loop-information  End >>>
            2233     3  pp   2v              do k=1,km
            2234     3               !#ifdef DEBUG
            2235     3               !        print*,' slope_wsm3 ',qr(k)*1000.,den(k),denfac(k),tk(k),tmp(k),tmp1(k),tmp2(k), &
            2236     3               !           ww(k),wa(k)
            2237     3               !#endif
            2238     3               ! mean wind is average of departure and new arrival winds
            2239     3   p   2v                ww(k) = 0.5* ( wd(k)+wa(k) )
            2240     3   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wa, was
                                   <<< Loop-information  End >>>
            2241     2  pp   4v              was(:) = wa(:)
            2242     2                       n=n+1
            2243     2                       go to 100
            2244     2                     endif
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qa2, qpi, qmi, qn
                                   <<< Loop-information  End >>>
            2245     2                     ist_loop : do ist = 1, 2
            2246     3                     if (ist.eq.2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa2, qa
                                   <<< Loop-information  End >>>
            2247     3  pp   4v             qa(:) = qa2(:)
            2248     3                     endif
            2249     2               !
            2250     2                     precip(i) = 0.
            2251     2               !
            2252     2               ! estimate values at arrival cell interface with monotone
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.85, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qa, dza, qmi, qpi
                                   <<< Loop-information  End >>>
            2253     3  pp    v            do k=2,km
            2254     3   p    v              dip=(qa(k+1)-qa(k))/(dza(k+1)+dza(k))
            2255     3   p    v              dim=(qa(k)-qa(k-1))/(dza(k-1)+dza(k))
            2256     4   p    v              if( dip*dim.le.0.0 ) then
            2257     4   p    v                qmi(k)=qa(k)
            2258     4   p    v                qpi(k)=qa(k)
            2259     4   p    v              else
            2260     4   p    v                qpi(k)=qa(k)+0.5*(dip+dim)*dza(k)
            2261     4   p    v                qmi(k)=2.0*qa(k)-qpi(k)
            2262     5   p    v                if( qpi(k).lt.0.0 .or. qmi(k).lt.0.0 ) then
            2263     5   p    v                  qpi(k) = qa(k)
            2264     5   p    v                  qmi(k) = qa(k)
            2265     5   p    v                endif
            2266     4   p    v              endif
            2267     3   p    v            enddo
            2268     2                     qpi(1)=qa(1)
            2269     2                     qmi(1)=qa(1)
            2270     2                     qmi(km+1)=qa(km+1)
            2271     2                     qpi(km+1)=qa(km+1)
            2272     2               !
            2273     2               ! interpolation to regular point
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            2274     2  pp   4v            qn = 0.0
            2275     2                     kb=1
            2276     2                     kt=1
            2277     3                     intp : do k=1,km
            2278     3                            kb=max(kb-1,1)
            2279     3                            kt=max(kt-1,1)
            2280     3               ! find kb and kt
            2281     4                            if( zi(k).ge.za(km+1) ) then
            2282     4                              exit intp
            2283     4                            else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            2284     5                              find_kb : do kk=kb,km
            2285     6                                        if( zi(k).le.za(kk+1) ) then
            2286     6                                          kb = kk
            2287     6                                          exit find_kb
            2288     6                                        else
            2289     6                                          cycle find_kb
            2290     6                                        endif
            2291     5                              enddo find_kb
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<< Loop-information  End >>>
            2292     5                              find_kt : do kk=kt,km+2  !hmhj
            2293     6                                        if( zi(k+1).le.za(kk) ) then
            2294     6                                          kt = kk
            2295     6                                          exit find_kt
            2296     6                                        else
            2297     6                                          cycle find_kt
            2298     6                                        endif
            2299     5                              enddo find_kt
            2300     4                              kt = kt - 1
            2301     4               ! compute q with piecewise constant method
            2302     5                              if( kt.eq.kb ) then
            2303     5                                tl=(zi(k)-za(kb))/dza(kb)
            2304     5                                th=(zi(k+1)-za(kb))/dza(kb)
            2305     5                                tl2=tl*tl
            2306     5                                th2=th*th
            2307     5                                qqd=0.5*(qpi(kb)-qmi(kb))
            2308     5                                qqh=qqd*th2+qmi(kb)*th
            2309     5                                qql=qqd*tl2+qmi(kb)*tl
            2310     5                                qn(k) = (qqh-qql)/(th-tl)
            2311     5                              else if( kt.gt.kb ) then
            2312     5                                tl=(zi(k)-za(kb))/dza(kb)
            2313     5                                tl2=tl*tl
            2314     5                                qqd=0.5*(qpi(kb)-qmi(kb))
            2315     5                                qql=qqd*tl2+qmi(kb)*tl
            2316     5                                dql = qa(kb)-qql
            2317     5                                zsum  = (1.-tl)*dza(kb)
            2318     5                                qsum  = dql*dza(kb)
            2319     6                                if( kt-kb.gt.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2320     7  pp    v                       do m=kb+1,kt-1
            2321     7   p    v                         zsum = zsum + dza(m)
            2322     7   p    v                         qsum = qsum + qa(m) * dza(m)
            2323     7   p    v                       enddo
            2324     6                                endif
            2325     5                                th=(zi(k+1)-za(kt))/dza(kt)
            2326     5                                th2=th*th
            2327     5                                qqd=0.5*(qpi(kt)-qmi(kt))
            2328     5                                dqh=qqd*th2+qmi(kt)*th
            2329     5                                zsum  = zsum + th*dza(kt)
            2330     5                                qsum  = qsum + dqh*dza(kt)
            2331     5                                qn(k) = qsum/zsum
            2332     5                              endif
            2333     4                              cycle intp
            2334     4                            endif
            2335     3               !
            2336     3                      enddo intp
            2337     2               !
            2338     2               ! rain out
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      za
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2339     3                     sum_precip: do k=1,km
            2340     4                                   if( za(k).lt.0.0 .and. za(k+1).lt.0.0 ) then
            2341     4                                     precip(i) = precip(i) + qa(k)*dza(k)
            2342     4                                     cycle sum_precip
            2343     4                                   else if ( za(k).lt.0.0 .and. za(k+1).ge.0.0 ) then
            2344     4               !hmhj for pcm         precip(i) = precip(i) + qa(k)*(0.0-za(k))
            2345     4                                     th = (0.0-za(k))/dza(k)
            2346     4                                     th2= th*th
            2347     4                                     qqd = 0.5*(qpi(k)-qmi(k))
            2348     4                                     qqh = qqd*th2+qmi(k)*th
            2349     4                                     precip(i) = precip(i) + qqh*dza(k)
            2350     4                                     exit sum_precip
            2351     4                                   endif
            2352     3                                   exit sum_precip
            2353     3                     enddo sum_precip
            2354     2               !
            2355     2               ! replace the new values
            2356     3                     if(ist.eq.1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            2357     3  pp   2v              rql(i,:) = qn(:)
            2358     3                       precip1(i) = precip(i)
            2359     3                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qn
                                   <<< Loop-information  End >>>
            2360     3  pp   2v              rql2(i,:) = qn(:)
            2361     3                       precip2(i) = precip(i)
            2362     3                     endif
            2363     2                     enddo ist_loop
            2364     1               !
            2365     1               ! ----------------------------------
            2366     1                     enddo i_loop
            2367                     !
            2368                       END SUBROUTINE nislfv_rain_plm6
            2369                     
            2370                     !+---+-----------------------------------------------------------------+
            2371                     
            2372                           subroutine refl10cm_wsm6 (qv1d, qr1d, qs1d, qg1d,                 &
            2373                                            t1d, p1d, dBZ, kts, kte, ii, jj)
            2374                     
            2375                           IMPLICIT NONE
            2376                     
            2377                     !..Sub arguments
            2378                           INTEGER, INTENT(IN):: kts, kte, ii, jj
            2379                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            2380                                           qv1d, qr1d, qs1d, qg1d, t1d, p1d
            2381                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: dBZ
            2382                     
            2383                     !..Local variables
            2384                           REAL, DIMENSION(kts:kte):: temp, pres, qv, rho
            2385                           REAL, DIMENSION(kts:kte):: rr, rs, rg
            2386                           REAL:: temp_C
            2387                     
            2388                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilams, ilamg
            2389                           DOUBLE PRECISION, DIMENSION(kts:kte):: N0_r, N0_s, N0_g
            2390                           DOUBLE PRECISION:: lamr, lams, lamg
            2391                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            2392                     
            2393                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            2394                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            2395                     
            2396                           INTEGER:: i, k, k_0, kbot, n
            2397                           LOGICAL:: melti
            2398                     
            2399                           DOUBLE PRECISION:: cback, x, eta, f_d
            2400                           REAL, PARAMETER:: R=287.
            2401                     
            2402                     !+---+
            2403                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            2404     1  pp   4v            do k = kts, kte
            2405     1   p   4v               dBZ(k) = -35.0
            2406     1   p   4v            enddo
            2407                     
            2408                     !+---+-----------------------------------------------------------------+
            2409                     !..Put column of data into local arrays.
            2410                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, t1d, p1d, N0_g, pres
                                   <<<      L_qg, L_qs, N0_r, L_qr, qv1d, qv, rho
                                   <<<      rr, ilamr
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      rs: 2, ilamg: 2, rg: 2, ilams: 2
                                   <<<      N0_s: 2, temp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 11
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2411     1  pp    v            do k = kts, kte
            2412     1   p    v               temp(k) = t1d(k)
            2413     1   p    v               temp_C = min(-0.001, temp(K)-273.15)
            2414     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            2415     1   p    v               pres(k) = p1d(k)
            2416     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            2417     1               
            2418     2   p    v               if (qr1d(k) .gt. 1.E-9) then
            2419     2   p    v                  rr(k) = qr1d(k)*rho(k)
            2420     2   p    v                  N0_r(k) = n0r
            2421     2   p    v                  lamr = (xam_r*xcrg(3)*N0_r(k)/rr(k))**(1./xcre(1))
            2422     2   p    v                  ilamr(k) = 1./lamr
            2423     2   p    v                  L_qr(k) = .true.
            2424     2   p    v               else
            2425     2   p    v                  rr(k) = 1.E-12
            2426     2   p    v                  L_qr(k) = .false.
            2427     2   p    v               endif
            2428     1               
            2429     2   p    v               if (qs1d(k) .gt. 1.E-9) then
            2430     2   p    v                  rs(k) = qs1d(k)*rho(k)
            2431     2   p    v                  N0_s(k) = min(n0smax, n0s*exp(-alpha*temp_C))
            2432     2   p    v                  lams = (xam_s*xcsg(3)*N0_s(k)/rs(k))**(1./xcse(1))
            2433     2   p    v                  ilams(k) = 1./lams
            2434     2   p    v                  L_qs(k) = .true.
            2435     2   p    v               else
            2436     2   p    v                  rs(k) = 1.E-12
            2437     2   p    v                  L_qs(k) = .false.
            2438     2   p    v               endif
            2439     1               
            2440     2   p    v               if (qg1d(k) .gt. 1.E-9) then
            2441     2   p    v                  rg(k) = qg1d(k)*rho(k)
            2442     2   p    v                  N0_g(k) = n0g
            2443     2   p    v                  lamg = (xam_g*xcgg(3)*N0_g(k)/rg(k))**(1./xcge(1))
            2444     2   p    v                  ilamg(k) = 1./lamg
            2445     2   p    v                  L_qg(k) = .true.
            2446     2   p    v               else
            2447     2   p    v                  rg(k) = 1.E-12
            2448     2   p    v                  L_qg(k) = .false.
            2449     2   p    v               endif
            2450     1   p    v            enddo
            2451                     
            2452                     !+---+-----------------------------------------------------------------+
            2453                     !..Locate K-level of start of melting (k_0 is level above).
            2454                     !+---+-----------------------------------------------------------------+
            2455                           melti = .false.
            2456                           k_0 = kts
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp
                                   <<< Loop-information  End >>>
            2457     1                     do k = kte-1, kts, -1
            2458     2                        if ( (temp(k).gt.273.15) .and. L_qr(k)                         &
            2459     2                                                 .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            2460     2                           k_0 = MAX(k+1, k_0)
            2461     2                           melti=.true.
            2462     2                           goto 195
            2463     2                        endif
            2464     1                     enddo
            2465                      195  continue
            2466                     
            2467                     !+---+-----------------------------------------------------------------+
            2468                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            2469                     !.. and non-water-coated snow and graupel when below freezing are
            2470                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            2471                     !+---+-----------------------------------------------------------------+
            2472                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, ilams, N0_s, L_qr
                                   <<<      ilamr, N0_r
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2473     1  pp    v            do k = kts, kte
            2474     1   p    v               ze_rain(k) = 1.e-22
            2475     1   p    v               ze_snow(k) = 1.e-22
            2476     1   p    v               ze_graupel(k) = 1.e-22
            2477     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*xcrg(4)*ilamr(k)**xcre(4)
            2478     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)     &
            2479     1                                                * (xam_s/900.0)*(xam_s/900.0)          &
            2480     1                                                * N0_s(k)*xcsg(4)*ilams(k)**xcse(4)
            2481     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)  &
            2482     1                                                   * (xam_g/900.0)*(xam_g/900.0)       &
            2483     1                                                   * N0_g(k)*xcgg(4)*ilamg(k)**xcge(4)
            2484     1   p    v            enddo
            2485                     
            2486                     
            2487                     !+---+-----------------------------------------------------------------+
            2488                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            2489                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            2490                     !.. extremely simple based on amount found above the melting level.
            2491                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            2492                     !.. routines).
            2493                     !+---+-----------------------------------------------------------------+
            2494                     
            2495     1                     if (melti .and. k_0.ge.kts+1) then
            2496     2                      do k = k_0-1, kts, -1
            2497     2               
            2498     2               !..Reflectivity contributed by melting snow
            2499     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            2500     3                          fmelt_s = MAX(0.005d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            2501     3                          eta = 0.d0
            2502     3                          lams = 1./ilams(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, simpson, xdts
                                   <<< Loop-information  End >>>
            2503     4                          do n = 1, nrbins
            2504     4                             x = xam_s * xxDs(n)**xbm_s
            2505     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocms),DBLE(xobms), &
            2506     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            2507     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            2508     4                                   inclusionstring_s, hoststring_s,                    &
            2509     4                                   hostmatrixstring_s, hostinclusionstring_s)
            2510     4                             f_d = N0_s(k)*xxDs(n)**xmu_s * DEXP(-lams*xxDs(n))
            2511     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            2512     4                          enddo
            2513     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            2514     3                         endif
            2515     2               
            2516     2               
            2517     2               !..Reflectivity contributed by melting graupel
            2518     2               
            2519     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            2520     3                          fmelt_g = MAX(0.005d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            2521     3                          eta = 0.d0
            2522     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, xdtg, simpson
                                   <<< Loop-information  End >>>
            2523     4                          do n = 1, nrbins
            2524     4                             x = xam_g * xxDg(n)**xbm_g
            2525     4                             call rayleigh_soak_wetgraupel (x,DBLE(xocmg),DBLE(xobmg), &
            2526     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            2527     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            2528     4                                   inclusionstring_g, hoststring_g,                    &
            2529     4                                   hostmatrixstring_g, hostinclusionstring_g)
            2530     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            2531     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            2532     4                          enddo
            2533     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            2534     3                         endif
            2535     2               
            2536     2                      enddo
            2537     1                     endif
            2538                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            2539     1  pp    v            do k = kte, kts, -1
            2540     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            2541     1   p    v            enddo
            2542                     
            2543                     
            2544                           end subroutine refl10cm_wsm6
            2545                     !+---+-----------------------------------------------------------------+
            2546                     
            2547                     !-----------------------------------------------------------------------
            2548                          subroutine effectRad_wsm6 (t, qc, qi, qs, rho, qmin, t0c,        &
            2549                                                     re_qc, re_qi, re_qs, islmski, kts, kte, ii)
            2550                     
            2551                     !-----------------------------------------------------------------------
            2552                     !  Compute radiation effective radii of cloud water, ice, and snow for
            2553                     !  single-moment microphysics.
            2554                     !  These are entirely consistent with microphysics assumptions, not
            2555                     !  constant or otherwise ad hoc as is internal to most radiation
            2556                     !  schemes.
            2557                     !  Coded and implemented by Soo ya Bae, KIAPS, January 2015.
            2558                     !-----------------------------------------------------------------------
            2559                     
            2560                           implicit none
            2561                     
            2562                     !..Sub arguments
            2563                           integer, intent(in) :: kts, kte, ii
            2564                           real, intent(in) :: qmin
            2565                           real, intent(in) :: t0c
            2566                           integer, intent(in) :: islmski
            2567                           real, dimension( kts:kte ), intent(in)::  t
            2568                           real, dimension( kts:kte ), intent(in)::  qc
            2569                           real, dimension( kts:kte ), intent(in)::  qi
            2570                           real, dimension( kts:kte ), intent(in)::  qs
            2571                           real, dimension( kts:kte ), intent(in)::  rho
            2572                           real, dimension( kts:kte ), intent(inout):: re_qc
            2573                           real, dimension( kts:kte ), intent(inout):: re_qi
            2574                           real, dimension( kts:kte ), intent(inout):: re_qs
            2575                     !..Local variables
            2576                           integer:: i,k
            2577                           integer :: inu_c
            2578                           real, dimension( kts:kte ):: ni
            2579                           real, dimension( kts:kte ):: rqc
            2580                           real, dimension( kts:kte ):: rqi
            2581                           real, dimension( kts:kte ):: rni
            2582                           real, dimension( kts:kte ):: rqs
            2583                           real :: temp
            2584                           real :: lamdac
            2585                           real :: supcol, n0sfac, lamdas
            2586                           real :: diai      ! diameter of ice in m
            2587                           logical :: has_qc, has_qi, has_qs
            2588                     !..Minimum microphys values
            2589                           real, parameter :: R1 = 1.E-12
            2590                           real, parameter :: R2 = 1.E-6
            2591                     !..Mass power law relations:  mass = am*D**bm
            2592                           real, parameter :: bm_r = 3.0
            2593                           real, parameter :: obmr = 1.0/bm_r
            2594                     !     real, parameter :: nc0  = 3.E8
            2595                           real  :: nc0
            2596                           real, parameter :: nc0l  = 3.E8
            2597                           real, parameter :: nc0o  = 1.E8
            2598                     !-----------------------------------------------------------------------
            2599                           has_qc = .false.
            2600                           has_qi = .false.
            2601                           has_qs = .false.
            2602                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 125
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            2603     1  pp    v            do k = kts, kte
            2604     1                       ! for cloud
            2605     1   p    v              rqc(k) = max(R1, qc(k)*rho(k))
            2606     1   p    v              if (rqc(k).gt.R1) has_qc = .true.
            2607     1                       ! for ice
            2608     1   p    v              rqi(k) = max(R1, qi(k)*rho(k))
            2609     1   p    v              temp = (rho(k)*max(qi(k),qmin))
            2610     1   p    v              temp = sqrt(sqrt(temp*temp*temp))
            2611     1   p    v              ni(k) = min(max(5.38e7*temp,1.e3),1.e6)
            2612     1   p    v              rni(k)= max(R2, ni(k)*rho(k))
            2613     1   p                   if (rqi(k).gt.R1 .and. rni(k).gt.R2) has_qi = .true.
            2614     1                       ! for snow
            2615     1   p    v              rqs(k) = max(R1, qs(k)*rho(k))
            2616     1   p                   if (rqs(k).gt.R1) has_qs = .true.
            2617     1   p    v            enddo
            2618                     
            2619     1                     if(islmski == 1) then
            2620     1                       nc0 = nc0l
            2621     1                     else
            2622     1                       nc0 = nc0o
            2623     1                     endif
            2624                     
            2625     1                     if (has_qc) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rqc, re_qc
                                   <<< Loop-information  End >>>
            2626     2  pp    v              do k=kts,kte
            2627     2   p    v                if (rqc(k).le.R1) CYCLE
            2628     2   p    v                lamdac   = (pidnc*nc0/rqc(k))**obmr
            2629     2   p    v                re_qc(k) =  max(2.51E-6,min(1.5*(1.0/lamdac),50.E-6))
            2630     2   p    v              enddo
            2631     1                     endif
            2632                     
            2633     1                    if (has_qi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.27, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ni, rqi, rni, re_qi
                                   <<< Loop-information  End >>>
            2634     2  pp   2v              do k=kts,kte
            2635     2   p   2v                if (rqi(k).le.R1 .or. rni(k).le.R2) CYCLE
            2636     2   p   2v                diai = 11.9*sqrt(rqi(k)/ni(k))
            2637     2   p   2v                re_qi(k) = max(10.01E-6,min(0.75*0.163*diai,125.E-6))
            2638     2   p   2v              enddo
            2639     1                     endif
            2640                     
            2641     1                     if (has_qs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 39
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rqs, t, re_qs
                                   <<< Loop-information  End >>>
            2642     2  pp    v              do k=kts,kte
            2643     2   p    v                if (rqs(k).le.R1) CYCLE
            2644     2   p    v                supcol = t0c-t(k)
            2645     2   p    v                n0sfac = max(min(exp(alpha*supcol),n0smax/n0s),1.)
            2646     2   p    v                lamdas = sqrt(sqrt(pidn0s*n0sfac/rqs(k)))
            2647     2   p    v                re_qs(k) = max(25.E-6,min(0.5*(1./lamdas), 999.E-6))
            2648     2   p    v              enddo
            2649     1                     endif
            2650                     
            2651                           end subroutine effectRad_wsm6
            2652                     !-----------------------------------------------------------------------
            2653                     
            2654                     END MODULE module_mp_wsm6


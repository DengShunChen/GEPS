             135                       REAL, DIMENSION( its:ite , kts:kte, 2 ) ::   qci
             136                       REAL, DIMENSION( its:ite , kts:kte, 3 ) ::   qrs
             137                       REAL, DIMENSION( ims:ime , kms:kme) ::       q
             138                       INTEGER ::               i,j,k
             139                     
             140                     !+---+-----------------------------------------------------------------+
             141                       REAL, DIMENSION(kts:kte):: qv1d, t1d, p1d, qr1d, qs1d, qg1d, dBZ
             142                     !+---+-----------------------------------------------------------------+
             143                     ! to calculate effective radius for radiation
             144                       REAL, DIMENSION( kts:kte ) :: den1d
             145                       REAL, DIMENSION( kts:kte ) :: qc1d
             146                       REAL, DIMENSION( kts:kte ) :: qi1d
             147                       REAL, DIMENSION( kts:kte ) :: re_qc, re_qi, re_qs
             148                       real :: tmp
             149                       integer :: islmski
             150                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, t, p, qg, qs, qr, qi, qc, den, q
                                   <<<      qrs, qci
                                   <<< Loop-information  End >>>
             151     1  pp                    DO k=kts,kte
                                   <<< Loop-information Start >>>

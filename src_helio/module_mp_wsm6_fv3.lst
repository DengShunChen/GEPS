             425                     !
             426                     !=================================================================
             427                     !   compute internal functions
             428                     !
             429                           cpmcal(x) = cpd*(1.-max(x,qmin))+max(x,qmin)*cpv
             430                           xlcal(x) = xlv0-xlv1*(x-t0c)
             431                     !----------------------------------------------------------------
             432                     !     diffus: diffusion coefficient of the water vapor
             433                     !     viscos: kinematic viscosity(m2s-1)
             434                     !     Optimizatin : A**B => exp(log(A)*(B))
             435                     !
             436                           diffus(x,y) = 8.794e-5 * exp(log(x)*(1.81)) / y        ! 8.794e-5*x**1.81/y
             437                           viscos(x,y) = 1.496e-6 * (x*sqrt(x)) /(x+120.)/y  ! 1.496e-6*x**1.5/(x+120.)/y
             438                           xka(x,y) = 1.414e3*viscos(x,y)*y
             439                           diffac(a,b,c,d,e) = d*a*a/(xka(c,d)*rv*c*c)+1./(e*diffus(c,b))
             440                           venfac(a,b,c) = exp(log((viscos(b,c)/diffus(b,a)))*((.3333333)))         &
             441                                          /sqrt(viscos(b,c))*sqrt(sqrt(den0/c))
             442                           conden(a,b,c,d,e) = (max(b,qmin)-c)/(1.+d*d/(rv*e)*c/(a*a))
             443                     !
             444                     !
             445                           idim = ite-its+1
             446                           kdim = kte-kts+1
             447                     !
             448                     !----------------------------------------------------------------
             449                     !     paddint 0 for negative values generated by dynamics
             450                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, qci
                                   <<< Loop-information  End >>>
             451     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrs, qci
                                   <<< Loop-information  End >>>
             452     2   p    v              do i = its, ite
             453     2   p    v                qci(i,k,1) = max(qci(i,k,1),0.0)
             454     2   p    v                qrs(i,k,1) = max(qrs(i,k,1),0.0)
             455     2   p    v                qci(i,k,2) = max(qci(i,k,2),0.0)
             456     2   p    v                qrs(i,k,2) = max(qrs(i,k,2),0.0)
             457     2   p    v                qrs(i,k,3) = max(qrs(i,k,3),0.0)
             458     2   p    v              enddo
             459     1   p                 enddo
             460                     !
             461                     !----------------------------------------------------------------
             462                     !     latent heat for phase changes and heat capacity. neglect the
             463                     !     changes during microphysical process calculation
             464                     !     emanuel(1994)
             465                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, xl, cpm
                                   <<< Loop-information  End >>>
             466     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.70, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, t, xl, cpm
                                   <<< Loop-information  End >>>
             467     2   p   2v              do i = its, ite
             468     2   p   2v                cpm(i,k) = cpmcal(q(i,k))
             469     2   p   2v                xl(i,k) = xlcal(t(i,k))
             470     2   p   2v              enddo
             471     1   p                 enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phii, den, den_tmp, delz, delz_tmp
                                   <<< Loop-information  End >>>
             472     1  pp                 do k = kts, kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.20, ITR: 104, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      den, den_tmp, phii, delz_tmp, delz
                                   <<< Loop-information  End >>>
             473     2   p    v              do i = its, ite
             474     2   p    v                delz(i,k) = (phii(i,k+1) - phii(i,k)) / g
             475     2   p    v                delz_tmp(i,k) = delz(i,k)
             476     2   p    v                den_tmp(i,k) = den(i,k)
             477     2   p    v              enddo
             478     1   p                 enddo
             479                     !
             480                     !----------------------------------------------------------------
             481                     !    initialize the surface rain, snow, graupel
             482                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tstepgraup, tstepsnow, sr, graupelncv
                                   <<<      snowncv, rainncv
                                   <<< Loop-information  End >>>
             483     1  pp   2v            do i = its, ite
             484     1   p   2v              rainncv(i) = 0.
             485     1   p   2v              if(PRESENT (snowncv) .AND. PRESENT (snow)) snowncv(i) = 0.
             486     1   p   2v              if(PRESENT (graupelncv) .AND. PRESENT (graupel)) graupelncv(i) = 0.
             487     1   p   2v              sr(i) = 0.
             488     1               ! new local array to catch step snow and graupel
             489     1   p   2v              tstepsnow(i) = 0.
             490     1   p   2v              tstepgraup(i) = 0.
             491     1   p   2v            enddo
             492                     !
             493                     !----------------------------------------------------------------
             494                     !     compute the minor time steps.
             495                     !
             496                           loops = max(nint(delt/dtcldcr),1)
             497                           dtcld = delt/loops
             498                           if(delt.le.dtcldcr) dtcld = delt
             499                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :

            2390     1               
            2391     1   p    v                  fluxr(i,6 ) = sfcflw(i)%dnfxc  ! total sky sfc lw dn
            2392     1   p    v                  fluxr(i,7 ) = sfcflw(i)%upfxc  ! total sky sfc lw up
            2393     1               
            2394     1   p    v                enddo

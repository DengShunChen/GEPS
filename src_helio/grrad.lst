            2396                     
            2397                     !  ---  save cld frac,toplyr,botlyr and top temp, note that the order
            2398                     !       of h,m,l cloud is reversed for the fluxr output.
            2399                     !  ---  save interface pressure (cb) of top/bot
            2400                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mbota, mtopa, cldsa, fluxr
                                   <<< Loop-information  End >>>
            2401     1  pp                     do j = 1, 3
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 64, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldsa, mbota, mtopa, fluxr
                                   <<< Loop-information  End >>>
            2402     2   p    v                  do i = 1, im
            2403     2   p    v                    tem0d = cldsa(i,j)
            2404     2   p    v                    itop  = mtopa(i,j) - kd
            2405     2   p    v                    ibtc  = mbota(i,j) - kd
            2406     2   p    v                    fluxr(i,11-j) = tem0d  ! cloud fraction(h,m,l,j=3,2,1)
            2407     2   p    v                    fluxr(i,14-j) = prsi(i,itop+kt) ! cloud top pressure
            2408     2   p    v                    fluxr(i,17-j) = prsi(i,ibtc+kb) ! cloud bot pressure
            2409     2   p    v                    fluxr(i,20-j) = tgrs(i,itop)    ! cloud top temp
            2410     2   p    v                  enddo
            2411     1   p                     enddo
            2412                     
            2413                     !  ---  save total cloud and bl cloud fraction
            2414                     
                                   <<< Loop-information Start >>>

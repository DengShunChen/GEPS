            1085                     !     if (myrank .eq. 0) print *,' #### present (htrlwb)=',lhtrlwb
            1086                     !     if (myrank .eq. 0) print *,' #### present (htrlw0)=',lhtrlw0
            1087                     !     if (myrank .eq. 0) print *,' #### present (flwprf)=',lflwprf
            1088                     
            1089                     !
            1090                           lp1 = lm + 1               ! num of in/out levels
            1091                     
            1092                     !  --- ...  set local /level/layer indexes corresponding to in/out variables
            1093                     
            1094                           lmk = lm + ltp             ! num of local layers
            1095                           lmp = lmk + 1              ! num of local levels
            1096                     
            1097     1                     if ( lextop ) then
            1098     2                       if ( ivflip == 1 ) then    ! vertical from sfc upward
            1099     2                         kd = 0                   ! index diff between in/out and local
            1100     2                         kt = 1                   ! index diff between lyr and upper bound
            1101     2                         kb = 0                   ! index diff between lyr and lower bound
            1102     2                         lla = lmk                ! local index at the 2nd level from top
            1103     2                         llb = lmp                ! local index at toa level
            1104     2                         lya = lm                 ! local index for the 2nd layer from top
            1105     2                         lyb = lp1                ! local index for the top layer
            1106     2                       else                       ! vertical from toa downward
            1107     2                         kd = 1                   ! index diff between in/out and local
            1108     2                         kt = 0                   ! index diff between lyr and upper bound
            1109     2                         kb = 1                   ! index diff between lyr and lower bound
            1110     2                         lla = 2                  ! local index at the 2nd level from top
            1111     2                         llb = 1                  ! local index at toa level
            1112     2                         lya = 2                  ! local index for the 2nd layer from top
            1113     2                         lyb = 1                  ! local index for the top layer
            1114     2                       endif                    ! end if_ivflip_block
            1115     1                     else
            1116     1                       kd = 0
            1117     2                       if ( ivflip == 1 ) then  ! vertical from sfc upward
            1118     2                         kt = 1                   ! index diff between lyr and upper bound
            1119     2                         kb = 0                   ! index diff between lyr and lower bound
            1120     2                       else                     ! vertical from toa downward
            1121     2                         kt = 0                   ! index diff between lyr and upper bound
            1122     2                         kb = 1                   ! index diff between lyr and lower bound
            1123     2                       endif                    ! end if_ivflip_block
            1124     1                     endif   ! end if_lextop_block
            1125                     
            1126                           raddt = min(dtsw, dtlw)

            2448     1   p    v                  fluxr(i,29) = scmpsw(i)%uvbf0  ! clear sky uv-b sw dn
            2449     1               
            2450     1               !  ---  sw sfc flux components
            2451     1               !
            2452     1   p    v                  fluxr(i,30) = scmpsw(i)%visbm  ! uv/vis beam sw dn
            2453     1   p    v                  fluxr(i,31) = scmpsw(i)%visdf  ! uv/vis diff sw dn
            2454     1   p    v                  fluxr(i,32) = scmpsw(i)%nirbm  ! nir beam sw dn
            2455     1   p    v                  fluxr(i,33) = scmpsw(i)%nirdf  ! nir diff sw dn
            2456     1               
            2457     1   p    v                enddo

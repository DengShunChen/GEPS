             181                          &                                     gas_init, gas_update
             182                           use module_radiation_aerosols,only : nf_aesw, nf_aelw, setaer,    &
             183                          &                                     aer_init, aer_update
             184                     !    &,                                    nspc1                        ! optn for aod output
             185                           use module_radiation_surface, only : nf_albd, sfc_init, setalb,   &
             186                          &                                     setemis
             187                           use module_radiation_clouds,  only : nf_clds, cld_init,           &
             188                          &                                     progcld1, progcld2, progcld3,&
             189                          &					   progcld4, diagcld1,          &
             190                                                                progcld5, progcld5o,         &
             191                                                                progclduni, progcld6
             192                     
             193                           use module_radsw_parameters,  only : topfsw_type, sfcfsw_type,    &
             194                          &                                     profsw_type,cmpfsw_type,nbdsw
             195                           use module_radsw_main,        only : rswinit,  swrad
             196                     
             197                           use module_radlw_parameters,  only : topflw_type, sfcflw_type,    &
             198                          &                                     proflw_type, nbdlw
             199                           use module_radlw_main,        only : rlwinit,  lwrad
             200                     !
             201                     !    implicit   none
             202                     !
             203                     !
             204                           private
             205                     
             206                     !  ---  version tag and last revision date
             207                           character(40), parameter ::                                       &
             208                          &   vtagrad='ncep-radiation_driver    v5.2  jan 2013 '
             209                     !    &   vtagrad='ncep-radiation_driver    v5.1  nov 2012 '
             210                     !    &   vtagrad='ncep-radiation_driver    v5.0  aug 2012 '
             211                     
             212                     !  ---  constant values
             213                           real (kind=kind_phys) :: qmin, qme5, qme6, epsq
             214                     !     parameter (qmin=1.0e-10, qme5=1.0e-5,  qme6=1.0e-6,  epsq=1.0e-12)
             215                           parameter (qmin=1.0e-10, qme5=1.0e-7,  qme6=1.0e-7,  epsq=1.0e-12)
             216                     !     parameter (qmin=1.0e-10, qme5=1.0e-20, qme6=1.0e-20, epsq=1.0e-12)
             217                           real, parameter :: prsmin = 1.0e-6 ! toa pressure minimum value in mb (hpa)
             218                     
             219                     !  ---  control flags set in subr radinit:
             220                           integer :: itsfc  =0            ! flag for lw sfc air/ground interface temp setting
             221                     
             222                     !  ---  data input control variables set in subr radupdate:
             223                           integer :: month0=0,   iyear0=0,   monthd=0
             224                           logical :: loz1st =.true.       ! first-time clim ozone data read flag
             225                     
             226                     !  ---  optional extra top layer on top of low ceiling models
             227                           integer, parameter :: ltp = 0   ! no extra top layer
             228                     !     integer, parameter :: ltp = 1   ! add an extra top layer
             229                           logical, parameter :: lextop = (ltp > 0)
             230                     
             231                     
             232                     !  ---  publicly accessible module programs:
             233                     
             234                           public radinit, radupdate, grrad
             235                     
             236                     
             237                     ! =================
             238                           contains
             239                     ! =================
             240                     
             241                     
             242                     !-----------------------------------
             243                           subroutine radinit                                                &
             244                     !...................................
             245                     
             246                     !  ---  inputs:
             247                          &     ( si, nlay, me, myrank )
             248                     !  ---  outputs:
             249                     !          ( none )
             250                     
             251                     ! =================   subprogram documentation block   ================ !
             252                     !                                                                       !
             253                     ! subprogram:   radinit     initialization of radiation calculations    !
             254                     !                                                                       !
             255                     ! usage:        call radinit                                            !
             256                     !                                                                       !
             257                     ! attributes:                                                           !
             258                     !   language:  fortran 90                                               !
             259                     !   machine:   ibm sp                                                   !
             260                     !                                                                       !
             261                     !  ====================  defination of variables  ====================  !
             262                     !                                                                       !
             263                     ! input parameters:                                                     !
             264                     !   nlay             : number of model vertical layers                  !
             265                     !   me               : print control flag                               !
             266                     !                                                                       !
             267                     !  outputs: (none)                                                      !
             268                     !                                                                       !
             269                     !  external module variables:  (in module physpara)                     !
             270                     !   isolar   : solar constant cntrol flag                               !
             271                     !              = 0: use the old fixed solar constant in "physcon"       !
             272                     !              =10: use the new fixed solar constant in "physcon"       !
             273                     !              = 1: use noaa ann-mean tsi tbl abs-scale with cycle apprx!
             274                     !              = 2: use noaa ann-mean tsi tbl tim-scale with cycle apprx!
             275                     !              = 3: use cmip5 ann-mean tsi tbl tim-scale with cycl apprx!
             276                     !              = 4: use cmip5 mon-mean tsi tbl tim-scale with cycl apprx!
             277                     !   iaerflg  : 3-digit aerosol flag (abc for volc, lw, sw)              !
             278                     !              a:=0 use background stratospheric aerosol                !
             279                     !                =1 include stratospheric vocanic aeros                 !
             280                     !              b:=0 no topospheric aerosol in lw radiation              !
             281                     !                =1 compute tropspheric aero in 1 broad band for lw     !
             282                     !                =2 compute tropspheric aero in multi bands for lw      !
             283                     !              c:=0 no topospheric aerosol in sw radiation              !
             284                     !                =1 include tropspheric aerosols for sw                 !
             285                     !   ico2flg  : co2 data source control flag                             !
             286                     !              =0: use prescribed global mean co2 (old  oper)           !
             287                     !              =1: use observed co2 annual mean value only              !
             288                     !              =2: use obs co2 monthly data with 2-d variation          !
             289                     !   ictmflg  : =yyyy#, external data ic time/date control flag          !
             290                     !              =   -2: same as 0, but superimpose seasonal cycle        !
             291                     !                      from climatology data set.                       !
             292                     !              =   -1: use user provided external data for the          !
             293                     !                      forecast time, no extrapolation.                 !
             294                     !              =    0: use data at initial cond time, if not            !
             295                     !                      available, use latest, no extrapolation.         !
             296                     !              =    1: use data at the forecast time, if not            !
             297                     !                      available, use latest and extrapolation.         !
             298                     !              =yyyy0: use yyyy data for the forecast time,             !
             299                     !                      no further data extrapolation.                   !
             300                     !              =yyyy1: use yyyy data for the fcst. if needed, do        !
             301                     !                      extrapolation to match the fcst time.            !
             302                     !   ioznflg  : ozone data source control flag                           !
             303                     !              =0: use climatological ozone profile                     !
             304                     !              =1: use interactive ozone profile                        !
             305                     !   ialbflg  : albedo scheme control flag                               !
             306                     !              =0: climatology, based on surface veg types              !
             307                     !              =1: modis retrieval based surface albedo scheme          !
             308                     !   iemsflg  : emissivity scheme cntrl flag (ab 2-digit integer)        !
             309                     !              a:=0 set sfc air/ground t same for lw radiation          !
             310                     !                =1 set sfc air/ground t diff for lw radiation          !
             311                     !              b:=0 use fixed sfc emissivity=1.0 (black-body)           !
             312                     !                =1 use varying climtology sfc emiss (veg based)        !
             313                     !                =2 future development (not yet)                        !
             314                     !   icldflg  : cloud optical property scheme control flag               !
             315                     !              =0: use diagnostic cloud scheme                          !
             316                     !              =1: use prognostic cloud scheme (default)                !
             317                     !   icmphys  : cloud microphysics scheme control flag                   !
             318                     !              =1 zhao/carr/sundqvist microphysics scheme               !
             319                     !              =2 brad ferrier microphysics scheme                      !
             320                     !	       =3 zhao/carr/sundqvist microphysics+pdf cloud & cnvc,cnvw!
             321                     !   iovrsw   : control flag for cloud overlap in sw radiation           !
             322                     !   iovrlw   : control flag for cloud overlap in lw radiation           !
             323                     !              =0: random overlapping clouds                            !
             324                     !              =1: max/ran overlapping clouds                           !
             325                     !   isubcsw  : sub-column cloud approx control flag in sw radiation     !
             326                     !   isubclw  : sub-column cloud approx control flag in lw radiation     !
             327                     !              =0: with out sub-column cloud approximation              !
             328                     !              =1: mcica sub-col approx. prescribed random seed         !
             329                     !              =2: mcica sub-col approx. provided random seed           !
             330                     !   lcrick   : control flag for eliminating crick                       !
             331                     !              =t: apply layer smoothing to eliminate crick             !
             332                     !              =f: do not apply layer smoothing                         !
             333                     !   lcnorm   : control flag for in-cld condensate                       !
             334                     !              =t: normalize cloud condensate                           !
             335                     !              =f: not normalize cloud condensate                       !
             336                     !   lnoprec  : precip effect in radiation flag (ferrier microphysics)   !
             337                     !              =t: snow/rain has no impact on radiation                 !
             338                     !              =f: snow/rain has impact on radiation                    !
             339                     !   ivflip   : vertical index direction control flag                    !
             340                     !              =0: index from toa to surface                            !
             341                     !              =1: index from surface to toa                            !
             342                     !                                                                       !
             343                     !  subroutines called: sol_init, aer_init, gas_init, cld_init,          !
             344                     !                      sfc_init, rlwinit, rswinit                       !
             345                     !                                                                       !
             346                     !  usage:       call radinit                                            !
             347                     !                                                                       !
             348                     !  ===================================================================  !
             349                     !
             350                           implicit none
             351                     
             352                     !  ---  inputs:
             353                           integer, intent(in) :: nlay, me, myrank
             354                     
             355                           real (kind=kind_phys), intent(in) :: si(:)
             356                     
             357                     !  ---  outputs: (none, to module variables)
             358                     
             359                     !  ---  locals:
             360                     
             361                     !
             362                     !===> ...  begin here
             363                     !
             364                     !  ---  set up control variables
             365                           itsfc  = iemsflg / 10             ! sfc air/ground temp control
             366                           loz1st = (ioznflg == 0)           ! first-time clim ozone data read flag
             367                           month0 = 0
             368                           iyear0 = 0
             369                           monthd = 0
             370                     
             371     1                     if (me == 0 .and. myrank == 0) then
             372     1               !       print *,' new radiation program structures -- sep 01 2004'
             373     1                       print *,' new radiation program structures became oper. ',      &
             374     1                    &          '  may 01 2007'
             375     1                       print *, vtagrad                !print out version tag
             376     1                       print *,' - selected control flag settings: ictmflg=',ictmflg,  &
             377     1                    &    ' isolar =',isolar, ' ico2flg=',ico2flg,' iaerflg=',iaerflg,  &
             378     1                    &    ' ialbflg=',ialbflg,' iemsflg=',iemsflg,' icldflg=',icldflg,  &
             379     1                    &    ' icmphys=',icmphys,' ioznflg=',ioznflg
             380     1                       print *,' ivflip=',ivflip,' iovrsw=',iovrsw,' iovrlw=',iovrlw,  &
             381     1                    &    ' isubcsw=',isubcsw,' isubclw=',isubclw
             382     1                       print *,' lcrick=',lcrick,' lcnorm=',lcnorm,' lnoprec=',lnoprec
             383     1                       print *,' ltp =',ltp,', add extra top layer =',lextop
             384     1               
             385     2                       if ( ictmflg==0 .or. ictmflg==-2 ) then
             386     2                         print *,'   data usage is limited by initial condition!'
             387     2                         print *,'   no volcanic aerosols'
             388     2                       endif
             389     1               
             390     2                       if ( isubclw == 0 ) then
             391     2                         print *,' - isubclw=',isubclw,' no mcica, use grid ',         &
             392     2                    &            'averaged cloud in lw radiation'
             393     2                       elseif ( isubclw == 1 ) then
             394     2                         print *,' - isubclw=',isubclw,' use mcica with fixed ',       &
             395     2                    &            'permutation seeds for lw random number generator'
             396     2                       elseif ( isubclw == 2 ) then
             397     2                         print *,' - isubclw=',isubclw,' use mcica with random ',      &
             398     2                    &            'permutation seeds for lw random number generator'
             399     2                       else
             400     2                         print *,' - error!!! isubclw=',isubclw,' is not a ',          &
             401     2                    &            'valid option '
             402     2                         stop
             403     2                       endif
             404     1               
             405     2                       if ( isubcsw == 0 ) then
             406     2                         print *,' - isubcsw=',isubcsw,' no mcica, use grid ',         &
             407     2                    &            'averaged cloud in sw radiation'
             408     2                       elseif ( isubcsw == 1 ) then
             409     2                         print *,' - isubcsw=',isubcsw,' use mcica with fixed ',       &
             410     2                    &            'permutation seeds for sw random number generator'
             411     2                       elseif ( isubcsw == 2 ) then
             412     2                         print *,' - isubcsw=',isubcsw,' use mcica with random ',      &
             413     2                    &            'permutation seeds for sw random number generator'
             414     2                       else
             415     2                         print *,' - error!!! isubcsw=',isubcsw,' is not a ',          &
             416     2                    &            'valid option '
             417     2                         stop
             418     2                       endif
             419     1               
             420     2                       if ( isubcsw /= isubclw ) then
             421     2                         print *,' - *** notice *** isubcsw /= isubclw !!!',           &
             422     2                    &            isubcsw, isubclw
             423     2                       endif
             424     1                     endif
             425                     
             426                     !  --- ...  call astronomy initialization routine
             427                     
             428                           if (me == 0 .and. myrank ==0)print *,'call sol_init'
             429                           call sol_init ( me , myrank )
             430                     
             431                     !  --- ...  call aerosols initialization routine
             432                     
             433                           if (me == 0 .and. myrank == 0)print *,'call aer_init'
             434                           call aer_init ( nlay, me , myrank )
             435                     
             436                     !  --- ...  call co2 and other gases initialization routine
             437                     
             438                           if (me ==0 .and. myrank == 0)print *,'call gas_init'
             439                           call gas_init ( me , myrank )
             440                     
             441                     !  --- ...  call surface initialization routine
             442                     
             443                           if (me == 0 .and. myrank == 0)print *,'call sfc_init'
             444                           call sfc_init ( me , myrank )
             445                     
             446                     !  --- ...  call cloud initialization routine
             447                     
             448                           if (me == 0 .and. myrank == 0)print *,'call cld_init'
             449                           call cld_init ( si, nlay, me, myrank )
             450                     
             451                     !  --- ...  call lw radiation initialization routine
             452                     
             453                           if (me == 0 .and. myrank == 0)print *,'call rlw_init'
             454                           call rlwinit ( me , myrank )
             455                     
             456                     !  --- ...  call sw radiation initialization routine
             457                     
             458                           if (me == 0 .and. myrank == 0)print *,'call rsw_init'
             459                           call rswinit ( me ,myrank)
             460                     !
             461                           return
             462                     !...................................
             463                           end subroutine radinit
             464                     !-----------------------------------
             465                     
             466                     
             467                     !-----------------------------------
             468                           subroutine radupdate                                              &
             469                     !...................................
             470                     !  ---  inputs:
             471                          &     ( idate,jdate,deltsw,deltim,lsswr, me, myrank,               &
             472                     !  ---  outputs:
             473                          &       slag,sdec,cdec,solcon                                      &
             474                          &     )
             475                     
             476                     ! =================   subprogram documentation block   ================ !
             477                     !                                                                       !
             478                     ! subprogram:   radupdate   calls many update subroutines to check and  !
             479                     !   update radiation required but time varying data sets and module     !
             480                     !   variables.                                                          !
             481                     !                                                                       !
             482                     ! usage:        call radupdate                                          !
             483                     !                                                                       !
             484                     ! attributes:                                                           !
             485                     !   language:  fortran 90                                               !
             486                     !   machine:   ibm sp                                                   !
             487                     !                                                                       !
             488                     !  ====================  defination of variables  ====================  !
             489                     !                                                                       !
             490                     ! input parameters:                                                     !
             491                     !   idate(8)       : ncep absolute date and time of initial condition   !
             492                     !                    (yr, mon, day, t-zone, hr, min, sec, mil-sec)      !
             493                     !   jdate(8)       : ncep absolute date and time at fcst time           !
             494                     !                    (yr, mon, day, t-zone, hr, min, sec, mil-sec)      !
             495                     !   deltsw         : sw radiation calling frequency in seconds          !
             496                     !   deltim         : model timestep in seconds                          !
             497                     !   lsswr          : logical flags for sw radiation calculations        !
             498                     !   me             : print control flag                                 !
             499                     !                                                                       !
             500                     !  outputs:                                                             !
             501                     !   slag           : equation of time in radians                        !
             502                     !   sdec, cdec     : sin and cos of the solar declination angle         !
             503                     !   solcon         : sun-earth distance adjusted solar constant (w/m2)  !
             504                     !                                                                       !
             505                     !  external module variables:                                           !
             506                     !   isolar   : solar constant cntrl  (in module physpara)               !
             507                     !              = 0: use the old fixed solar constant in "physcon"       !
             508                     !              =10: use the new fixed solar constant in "physcon"       !
             509                     !              = 1: use noaa ann-mean tsi tbl abs-scale with cycle apprx!
             510                     !              = 2: use noaa ann-mean tsi tbl tim-scale with cycle apprx!
             511                     !              = 3: use cmip5 ann-mean tsi tbl tim-scale with cycl apprx!
             512                     !              = 4: use cmip5 mon-mean tsi tbl tim-scale with cycl apprx!
             513                     !   ictmflg  : =yyyy#, external data ic time/date control flag          !
             514                     !              =   -2: same as 0, but superimpose seasonal cycle        !
             515                     !                      from climatology data set.                       !
             516                     !              =   -1: use user provided external data for the          !
             517                     !                      forecast time, no extrapolation.                 !
             518                     !              =    0: use data at initial cond time, if not            !
             519                     !                      available, use latest, no extrapolation.         !
             520                     !              =    1: use data at the forecast time, if not            !
             521                     !                      available, use latest and extrapolation.         !
             522                     !              =yyyy0: use yyyy data for the forecast time,             !
             523                     !                      no further data extrapolation.                   !
             524                     !              =yyyy1: use yyyy data for the fcst. if needed, do        !
             525                     !                      extrapolation to match the fcst time.            !
             526                     !                                                                       !
             527                     !  module variables:                                                    !
             528                     !   loz1st   : first-time clim ozone data read flag                     !
             529                     !                                                                       !
             530                     !  subroutines called: sol_update, aer_update, gas_update               !
             531                     !                                                                       !
             532                     !  ===================================================================  !
             533                     !
             534                           implicit none
             535                     
             536                     !  ---  inputs:
             537                           integer, intent(in) :: idate(:), jdate(:), me, myrank
             538                           logical, intent(in) :: lsswr
             539                     
             540                           real (kind=kind_phys), intent(in) :: deltsw, deltim
             541                     
             542                     !  ---  outputs:
             543                           real (kind=kind_phys), intent(out) :: slag, sdec, cdec, solcon
             544                     
             545                     !  ---  locals:
             546                           integer :: iyear, imon, iday, ihour
             547                           integer :: kyear, kmon, kday, khour
             548                     
             549                           logical :: lmon_chg       ! month change flag
             550                           logical :: lco2_chg       ! cntrl flag for updating co2 data
             551                           logical :: lsol_chg       ! cntrl flag for updating solar constant
             552                     !
             553                     !===> ...  begin here
             554                     !
             555                     !  --- ...  time stamp at fcst time
             556                     
             557                           iyear = jdate(1)
             558                           imon  = jdate(2)
             559                           iday  = jdate(3)
             560                           ihour = jdate(5)
             561                     
             562                     !  --- ...  set up time stamp used for green house gases (** currently co2 only)
             563                     
             564     1                     if ( ictmflg==0 .or. ictmflg==-2 ) then  ! get external data at initial condition time
             565     1                       kyear = idate(1)
             566     1                       kmon  = idate(2)
             567     1                       kday  = idate(3)
             568     1                       khour = idate(5)
             569     1                     else                           ! get external data at fcst or specified time
             570     1                       kyear = iyear
             571     1                       kmon  = imon
             572     1                       kday  = iday
             573     1                       khour = ihour
             574     1                     endif   ! end if_ictmflg_block
             575                     
             576     1                     if ( month0 /= imon ) then
             577     1                       lmon_chg = .true.
             578     1                       month0 = imon
             579     1                     else
             580     1                       lmon_chg = .false.
             581     1                     endif
             582                     
             583                     !  --- ...  call astronomy update routine, yearly update, no time interpolation
             584                     
             585     1                     if (lsswr) then
             586     1               
             587     2                       if ( isolar == 0 .or. isolar == 10 ) then
             588     2                         lsol_chg = .false.
             589     2                       elseif ( iyear0 /= iyear ) then
             590     2                         lsol_chg = .true.
             591     2                       else
             592     2                         lsol_chg = ( isolar==4 .and. lmon_chg )
             593     2                       endif
             594     1                       iyear0 = iyear
             595     1               
             596     1                       if (me == 0 .and. myrank ==0) print *,'call sol_update'
             597     1                       call sol_update                                                 &
             598     1               !  ---  inputs:
             599     1                    &     ( myrank, jdate,kyear,deltsw,deltim,lsol_chg, me,            &
             600     1               !  ---  outputs:
             601     1                    &       slag,sdec,cdec,solcon                                      &
             602     1                    &     )
             603     1               
             604     1                     endif  ! end_if_lsswr_block
             605                     
             606                     !  --- ...  call aerosols update routine, monthly update, no time interpolation
             607                     
             608     1                     if ( lmon_chg ) then
             609     1                       if (me == 0 .and. myrank ==0) print *,'call aer_update'
             610     1                       call aer_update ( myrank, iyear, imon, me )
             611     1                     endif
             612                     
             613                     !  --- ...  call co2 and other gases update routine
             614                     
             615     1                     if ( monthd /= kmon ) then
             616     1                       monthd = kmon
             617     1                       lco2_chg = .true.
             618     1                     else
             619     1                       lco2_chg = .false.
             620     1                     endif
             621                     
             622                           if (me == 0 .and. myrank ==0) print *,'call gas_update'
             623                           call gas_update ( myrank, kyear,kmon,kday,khour,loz1st,lco2_chg, me )
             624                     
             625                           if ( loz1st ) loz1st = .false.
             626                     
             627                     !  --- ...  call surface update routine (currently not needed)
             628                     !     call sfc_update ( iyear, imon, me )
             629                     
             630                     !  --- ...  call clouds update routine (currently not needed)
             631                     !     call cld_update ( iyear, imon, me )
             632                     !
             633                           return
             634                     !...................................
             635                           end subroutine radupdate
             636                     !-----------------------------------
             637                     
             638                     
             639                     !-----------------------------------
             640                           subroutine grrad                                                  &
             641                     !...................................
             642                     !  ---  inputs:
             643                                ( prsi,prsl,prslk,tgrs,qgrs,tracer,vvl,slmsk,                &
             644                                  xlon,xlat,tsfc,snowd,sncovr,snoalb,zorl,hprim,             &
             645                                  alvsf,alnsf,alvwf,alnwf,facsf,facwf,fice,tisfc,            &
             646                                  sinlat,coslat,solhr,jdate,solcon,                          &
             647                                  cv,cvt,cvb,                                                &
             648                                  icsdsw,icsdlw,ntcw,ncld,ntoz,ntrac,nfxr,                   &
             649                                  dtlw,dtsw,lsswr,lslwr,lssav,                               &
             650                                  ix,im,lm,me,lprnt,ipt,kdt,myrank,                          &
             651                                  ntiw,ntrw,ntsw,ntgl,uni_cloud,lmfshal,lmfdeep2,            &
             652                                  deltaq,sup,cnvw,cnvc,phy_f3d,                              &
             653                     !  ---  outputs:
             654                                  htrsw,sfalb,coszen,coszdg,                                 &
             655                                  htrlw,tsflw,semis,                                         &
             656                     !  ---  input/output:
             657                                  cldcov,fluxr,                                              &
             658                     !! ---  optional outputs:
             659                                  htrsw0,htrlw0,                                             &
             660                                  fusl,fdsl,fuir,fdir,                                       &
             661                                  fuslr,fdslr,fuirr,fdirr                                    &
             662                                )
             663                     
             664                     ! =================   subprogram documentation block   ================ !
             665                     !                                                                       !
             666                     !    this program is the driver of radiation calculation subroutines. * !
             667                     !    it sets up profile variables for radiation input, including      * !
             668                     !    clouds, surface albedos, atmospheric aerosols, ozone, etc.       * !
             669                     !                                                                     * !
             670                     !    usage:        call grrad                                         * !
             671                     !                                                                     * !
             672                     !    subprograms called:                                              * !
             673                     !                  setalb, setemis, setaer, getozn, getgases,         * !
             674                     !                  progcld1, progcld2, diagcds,                       * !
             675                     !                  swrad, lwrad, fpvs                                 * !
             676                     !                                                                     * !
             677                     !    attributes:                                                      * !
             678                     !      language:   fortran 90                                         * !
             679                     !      machine:    ibm-sp, sgi                                        * !
             680                     !                                                                     * !
             681                     !                                                                     * !
             682                     !  ====================  defination of variables  ====================  !
             683                     !                                                                       !
             684                     !    input variables:                                                   !
             685                     !      prsi  (ix,lm+1) : model level pressure in cb (kpa)               !
             686                     !      prsl  (ix,lm)   : model layer mean pressure in cb (kpa)          !
             687                     !      prslk (ix,lm)   : exner function = (p/p0)**rocp                  !
             688                     !      tgrs  (ix,lm)   : model layer mean temperature in k              !
             689                     !      qgrs  (ix,lm)   : layer specific humidity in gm/gm               !
             690                     !      tracer(ix,lm,ntrac):layer prognostic tracer amount/mixing-ratio  !
             691                     !                        incl: oz, cwc, aeros, etc.                     !
             692                     !      vvl   (ix,lm)   : layer mean vertical velocity in cb/sec         !
             693                     !      slmsk (im)      : sea/land mask array (sea:0,land:1,sea-ice:2)   !
             694                     !      xlon  (im)      : grid longitude in radians, ok for both 0->2pi  !
             695                     !                        or -pi -> +pi ranges                           !
             696                     !      xlat  (im)      : grid latitude in radians, default to pi/2 ->   !
             697                     !                        -pi/2 range, otherwise adj in subr called      !
             698                     !      tsfc  (im)      : surface temperature in k                       !
             699                     !      snowd (im)      : snow depth water equivalent in mm              !
             700                     !      sncovr(im)      : snow cover in fraction                         !
             701                     !      snoalb(im)      : maximum snow albedo in fraction                !
             702                     !      zorl  (im)      : surface roughness in cm                        !
             703                     !      hprim (im)      : topographic standard deviation in m            !
             704                     !      alvsf (im)      : mean vis albedo with strong cosz dependency    !
             705                     !      alnsf (im)      : mean nir albedo with strong cosz dependency    !
             706                     !      alvwf (im)      : mean vis albedo with weak cosz dependency      !
             707                     !      alnwf (im)      : mean nir albedo with weak cosz dependency      !
             708                     !      facsf (im)      : fractional coverage with strong cosz dependen  !
             709                     !      facwf (im)      : fractional coverage with weak cosz dependency  !
             710                     !      fice  (im)      : ice fraction over open water grid              !
             711                     !      tisfc (im)      : surface temperature over ice fraction          !
             712                     !      sinlat(im)      : sine of the grids' corresponding latitudes     !
             713                     !      coslat(im)      : cosine of the grids' corresponding latitudes   !
             714                     !      solhr           : hour time after 00z at the t-stepe             !
             715                     !      jdate (8)       : current forecast date and time                 !
             716                     !                        (yr, mon, day, t-zone, hr, min, sec, mil-sec)  !
             717                     !      solcon          : solar constant (sun-earth distant adjusted)    !
             718                     !      cv    (im)      : fraction of convective cloud                   !
             719                     !      cvt, cvb (im)   : convective cloud top/bottom pressure in cb     !
             720                     !      fcice           : fraction of cloud ice  (in ferrier scheme)     !
             721                     !      frain           : fraction of rain water (in ferrier scheme)     !
             722                     !      rrime           : mass ratio of total to unrimed ice ( >= 1 )    !
             723                     !      flgmin          : minimim large ice fraction                     !
             724                     !      icsdsw/icsdlw   : auxiliary cloud control arrays passed to main  !
             725                     !           (im)         radiations. if isubcsw/isubclw (input to init) !
             726                     !                        are set to 2, the arrays contains provided     !
             727                     !                        random seeds for sub-column clouds generators  !
             728                     !      ntcw            : =0 no cloud condensate calculated              !
             729                     !                        >0 array index location for cloud condensate   !
             730                     !      ncld            : only used when ntcw .gt. 0                     !
             731                     !      ntoz            : =0 climatological ozone profile                !
             732                     !                        >0 interactive ozone profile                   !
             733                     !      ntrac           : dimension veriable for array oz                !
             734                     !      nfxr            : second dimension of input/output array fluxr   !
             735                     !      dtlw, dtsw      : time duration for lw/sw radiation call in sec  !
             736                     !      lsswr, lslwr    : logical flags for sw/lw radiation calls        !
             737                     !      lssav           : logical flag for store 3-d cloud field         !
             738                     !      ix,im           : horizontal dimention and num of used points    !
             739                     !      lm              : vertical layer dimension                       !
             740                     !      me              : control flag for parallel process              !
             741                     !      lprnt           : control flag for diagnostic print out          !
             742                     !      ipt             : index for diagnostic printout point            !
             743                     !      kdt             : time-step number                               !
             744                     !      deltaq          : half width of uniform total water distribution !
             745                     !      sup             : supersaturation in pdf cloud when t is very low!
             746                     !      cnvw            : layer convective cloud water                   !
             747                     !      cnvc            : layer convective cloud cover                   !
             748                     !                                                                       !
             749                     !    output variables:                                                  !
             750                     !      htrsw (ix,lm)   : total sky sw heating rate in k/sec             !
             751                     !      topfsw(im)      : sw radiation fluxes at toa, components:        !
             752                     !                      (check module_radsw_parameters for definition)   !
             753                     !       %upfxc           - total sky upward sw flux at toa (w/m**2)     !
             754                     !       %dnflx           - total sky downward sw flux at toa (w/m**2)   !
             755                     !       %upfx0           - clear sky upward sw flux at toa (w/m**2)     !
             756                     !      sfcfsw(im)      : sw radiation fluxes at sfc, components:        !
             757                     !                      (check module_radsw_parameters for definition)   !
             758                     !       %upfxc           - total sky upward sw flux at sfc (w/m**2)     !
             759                     !       %dnfxc           - total sky downward sw flux at sfc (w/m**2)   !
             760                     !       %upfx0           - clear sky upward sw flux at sfc (w/m**2)     !
             761                     !       %dnfx0           - clear sky downward sw flux at sfc (w/m**2)   !
             762                     !      sfalb (im)      : mean surface diffused sw albedo                !
             763                     !      coszen(im)      : mean cos of zenith angle over rad call period  !
             764                     !      coszdg(im)      : daytime mean cosz over rad call period         !
             765                     !      htrlw (ix,lm)   : total sky lw heating rate in k/sec             !
             766                     !      topflw(im)      : lw radiation fluxes at top, component:         !
             767                     !                        (check module_radlw_paramters for definition)  !
             768                     !       %upfxc           - total sky upward lw flux at toa (w/m**2)     !
             769                     !       %upfx0           - clear sky upward lw flux at toa (w/m**2)     !
             770                     !      sfcflw(im)      : lw radiation fluxes at sfc, component:         !
             771                     !                        (check module_radlw_paramters for definition)  !
             772                     !       %upfxc           - total sky upward lw flux at sfc (w/m**2)     !
             773                     !       %upfx0           - clear sky upward lw flux at sfc (w/m**2)     !
             774                     !       %dnfxc           - total sky downward lw flux at sfc (w/m**2)   !
             775                     !       %dnfx0           - clear sky downward lw flux at sfc (w/m**2)   !
             776                     !      semis (im)      : surface lw emissivity in fraction              !
             777                     !      cldcov(ix,lm)   : 3-d cloud fraction                             !
             778                     !      tsflw (im)      : surface air temp during lw calculation in k    !
             779                     !                                                                       !
             780                     !    input and output variables:                                        !
             781                     !      fluxr (ix,nfxr) : to save time accumulated 2-d fields defined as:!
             782                     !                 1      - toa total sky upwd lw radiation flux         !
             783                     !                 2      - toa total sky upwd sw radiation flux         !
             784                     !                 3      - sfc total sky upwd sw radiation flux         !
             785                     !                 4      - sfc total sky dnwd sw radiation flux         !
             786                     !                 5      - high domain cloud fraction                   !
             787                     !                 6      - mid  domain cloud fraction                   !
             788                     !                 7      - low  domain cloud fraction                   !
             789                     !                 8      - high domain mean cloud top pressure          !
             790                     !                 9      - mid  domain mean cloud top pressure          !
             791                     !                10      - low  domain mean cloud top pressure          !
             792                     !                11      - high domain mean cloud base pressure         !
             793                     !                12      - mid  domain mean cloud base pressure         !
             794                     !                13      - low  domain mean cloud base pressure         !
             795                     !                14      - high domain mean cloud top temperature       !
             796                     !                15      - mid  domain mean cloud top temperature       !
             797                     !                16      - low  domain mean cloud top temperature       !
             798                     !                17      - total cloud fraction                         !
             799                     !                18      - boundary layer domain cloud fraction         !
             800                     !                19      - sfc total sky dnwd lw radiation flux         !
             801                     !                20      - sfc total sky upwd lw radiation flux         !
             802                     !                21      - sfc total sky dnwd sw uv-b radiation flux    !
             803                     !                22      - sfc clear sky dnwd sw uv-b radiation flux    !
             804                     !                23      - toa incoming solar radiation flux            !
             805                     !                24      - sfc vis beam dnwd sw radiation flux          !
             806                     !                25      - sfc vis diff dnwd sw radiation flux          !
             807                     !                26      - sfc nir beam dnwd sw radiation flux          !
             808                     !                27      - sfc nir diff dnwd sw radiation flux          !
             809                     !                28      - toa clear sky upwd lw radiation flux         !
             810                     !                29      - toa clear sky upwd sw radiation flux         !
             811                     !                30      - sfc clear sky dnwd lw radiation flux         !
             812                     !                31      - sfc clear sky upwd sw radiation flux         !
             813                     !                32      - sfc clear sky dnwd sw radiation flux         !
             814                     !                33      - sfc clear sky upwd lw radiation flux         !
             815                     !optional        34      - aeros opt depth at 550nm (all components)    !
             816                     !               ....     - optional for test and future use             !
             817                     !                                                                       !
             818                     !    optional output variables:                                         !
             819                     !      htrswb(ix,lm,nbdsw) : spectral band total sky sw heating rate    !
             820                     !      htrlwb(ix,lm,nbdlw) : spectral band total sky lw heating rate    !
             821                     !                                                                       !
             822                     !                                                                       !
             823                     !    definitions of internal variable arrays:                           !
             824                     !                                                                       !
             825                     !     1. fixed gases:         (defined in 'module_radiation_gases')     !
             826                     !          gasvmr(:,:,1)  -  co2 volume mixing ratio                    !
             827                     !          gasvmr(:,:,2)  -  n2o volume mixing ratio                    !
             828                     !          gasvmr(:,:,3)  -  ch4 volume mixing ratio                    !
             829                     !          gasvmr(:,:,4)  -  o2  volume mixing ratio                    !
             830                     !          gasvmr(:,:,5)  -  co  volume mixing ratio                    !
             831                     !          gasvmr(:,:,6)  -  cf11 volume mixing ratio                   !
             832                     !          gasvmr(:,:,7)  -  cf12 volume mixing ratio                   !
             833                     !          gasvmr(:,:,8)  -  cf22 volume mixing ratio                   !
             834                     !          gasvmr(:,:,9)  -  ccl4 volume mixing ratio                   !
             835                     !                                                                       !
             836                     !     2. cloud profiles:      (defined in 'module_radiation_clouds')    !
             837                     !                ---  for  prognostic cloud  ---                        !
             838                     !          clouds(:,:,1)  -  layer total cloud fraction                 !
             839                     !          clouds(:,:,2)  -  layer cloud liq water path                 !
             840                     !          clouds(:,:,3)  -  mean effective radius for liquid cloud     !
             841                     !          clouds(:,:,4)  -  layer cloud ice water path                 !
             842                     !          clouds(:,:,5)  -  mean effective radius for ice cloud        !
             843                     !          clouds(:,:,6)  -  layer rain drop water path                 !
             844                     !          clouds(:,:,7)  -  mean effective radius for rain drop        !
             845                     !          clouds(:,:,8)  -  layer snow flake water path                !
             846                     !          clouds(:,:,9)  -  mean effective radius for snow flake       !
             847                     !                ---  for  diagnostic cloud  ---                        !
             848                     !          clouds(:,:,1)  -  layer total cloud fraction                 !
             849                     !          clouds(:,:,2)  -  layer cloud optical depth                  !
             850                     !          clouds(:,:,3)  -  layer cloud single scattering albedo       !
             851                     !          clouds(:,:,4)  -  layer cloud asymmetry factor               !
             852                     !                                                                       !
             853                     !     3. surface albedo:      (defined in 'module_radiation_surface')   !
             854                     !          sfcalb( :,1 )  -  near ir direct beam albedo                 !
             855                     !          sfcalb( :,2 )  -  near ir diffused albedo                    !
             856                     !          sfcalb( :,3 )  -  uv+vis direct beam albedo                  !
             857                     !          sfcalb( :,4 )  -  uv+vis diffused albedo                     !
             858                     !                                                                       !
             859                     !     4. sw aerosol profiles: (defined in 'module_radiation_aerosols')  !
             860                     !          faersw(:,:,:,1)-  sw aerosols optical depth                  !
             861                     !          faersw(:,:,:,2)-  sw aerosols single scattering albedo       !
             862                     !          faersw(:,:,:,3)-  sw aerosols asymmetry parameter            !
             863                     !                                                                       !
             864                     !     5. lw aerosol profiles: (defined in 'module_radiation_aerosols')  !
             865                     !          faerlw(:,:,:,1)-  lw aerosols optical depth                  !
             866                     !          faerlw(:,:,:,2)-  lw aerosols single scattering albedo       !
             867                     !          faerlw(:,:,:,3)-  lw aerosols asymmetry parameter            !
             868                     !                                                                       !
             869                     !     6. sw fluxes at toa:    (defined in 'module_radsw_main')          !
             870                     !        (topfsw_type -- derived data type for toa rad fluxes)          !
             871                     !          topfsw(:)%upfxc  -  total sky upward flux at toa             !
             872                     !          topfsw(:)%dnfxc  -  total sky downward flux at toa           !
             873                     !          topfsw(:)%upfx0  -  clear sky upward flux at toa             !
             874                     !                                                                       !
             875                     !     7. lw fluxes at toa:    (defined in 'module_radlw_main')          !
             876                     !        (topflw_type -- derived data type for toa rad fluxes)          !
             877                     !          topflw(:)%upfxc  -  total sky upward flux at toa             !
             878                     !          topflw(:)%upfx0  -  clear sky upward flux at toa             !
             879                     !                                                                       !
             880                     !     8. sw fluxes at sfc:    (defined in 'module_radsw_main')          !
             881                     !        (sfcfsw_type -- derived data type for sfc rad fluxes)          !
             882                     !          sfcfsw(:)%upfxc  -  total sky upward flux at sfc             !
             883                     !          sfcfsw(:)%dnfxc  -  total sky downward flux at sfc           !
             884                     !          sfcfsw(:)%upfx0  -  clear sky upward flux at sfc             !
             885                     !          sfcfsw(:)%dnfx0  -  clear sky downward flux at sfc           !
             886                     !                                                                       !
             887                     !     9. lw fluxes at sfc:    (defined in 'module_radlw_main')          !
             888                     !        (sfcflw_type -- derived data type for sfc rad fluxes)          !
             889                     !          sfcflw(:)%upfxc  -  total sky upward flux at sfc             !
             890                     !          sfcflw(:)%dnfxc  -  total sky downward flux at sfc           !
             891                     !          sfcflw(:)%dnfx0  -  clear sky downward flux at sfc           !
             892                     !                                                                       !
             893                     !! optional radiation outputs:                                          !
             894                     !!   10. sw flux profiles:    (defined in 'module_radsw_main')          !
             895                     !!       (profsw_type -- derived data type for rad vertical profiles)   !
             896                     !!         fswprf(:,:)%upfxc - total sky upward flux                    !
             897                     !!         fswprf(:,:)%dnfxc - total sky downward flux                  !
             898                     !!         fswprf(:,:)%upfx0 - clear sky upward flux                    !
             899                     !!         fswprf(:,:)%dnfx0 - clear sky downward flux                  !
             900                     !!                                                                      !
             901                     !!   11. lw flux profiles:    (defined in 'module_radlw_main')          !
             902                     !!       (proflw_type -- derived data type for rad vertical profiles)   !
             903                     !!         flwprf(:,:)%upfxc - total sky upward flux                    !
             904                     !!         flwprf(:,:)%dnfxc - total sky downward flux                  !
             905                     !!         flwprf(:,:)%upfx0 - clear sky upward flux                    !
             906                     !!         flwprf(:,:)%dnfx0 - clear sky downward flux                  !
             907                     !!                                                                      !
             908                     !!   12. sw sfc components:   (defined in 'module_radsw_main')          !
             909                     !!       (cmpfsw_type -- derived data type for component sfc fluxes)    !
             910                     !!         scmpsw(:)%uvbfc  -  total sky downward uv-b flux at sfc      !
             911                     !!         scmpsw(:)%uvbf0  -  clear sky downward uv-b flux at sfc      !
             912                     !!         scmpsw(:)%nirbm  -  total sky sfc downward nir direct flux   !
             913                     !!         scmpsw(:)%nirdf  -  total sky sfc downward nir diffused flux !
             914                     !!         scmpsw(:)%visbm  -  total sky sfc downward uv+vis direct flx !
             915                     !!         scmpsw(:)%visdf  -  total sky sfc downward uv+vis diff flux  !
             916                     !                                                                       !
             917                     !    external module variables:                                         !
             918                     !     ivflip           : control flag for in/out vertical indexing      !
             919                     !                        =0 index from toa to surface                   !
             920                     !                        =1 index from surface to toa                   !
             921                     !     icmphys          : cloud microphysics scheme control flag         !
             922                     !                        =1 zhao/carr/sundqvist microphysics scheme     !
             923                     !                        =2 brad ferrier microphysics scheme            !
             924                     !                        =3 zhao/carr/sundqvist microphysics +pdf cloud !
             925                     !                                                                       !
             926                     !    module variables:                                                  !
             927                     !     itsfc            : =0 use same sfc skin-air/ground temp           !
             928                     !                        =1 use diff sfc skin-air/ground temp (not yet) !
             929                     !                                                                       !
             930                     !  ======================  end of definations  =======================  !

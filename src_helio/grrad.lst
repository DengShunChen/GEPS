            2370     1  pp    v                do i = 1, im
            2371     1               
            2372     1               !  ---  TOA total-sky SW DOWN fluxes
            2373     1               
            2374     1   p    v                  fluxr(i,1 ) = topfsw(i)%dnfxc   ! total sky top sw dn
            2375     1               
            2376     1               !  ---  TOA total-sky SW UP fluxes
            2377     1               
            2378     1   p    v                  fluxr(i,2 ) = topfsw(i)%upfxc   ! total sky top sw up
            2379     1               
            2380     1               !  ---  TOA total-sky LW(OLR) fluxes

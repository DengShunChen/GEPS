             424     2                                       **(1.0/(2.0*BB(I)+3.0))
             425     2   p    v                 REFSMC(I) = REFSMC1 + (MAXSMC(I)-REFSMC1) / SMHIGH
             426     2   p    v                 WLTSMC1   = MAXSMC(I) * (200.0/SATPSI(I))**(-1.0/BB(I))
             427     2   p    v                 WLTSMC(I) = WLTSMC1 - SMLOW * WLTSMC1
             428     2               

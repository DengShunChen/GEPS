 External subroutine subprogram "cudlfs"
  (inc)(line-no.)(nest)(optimize)
               1                     !+ calculates level of free sinking for cumulus downdrafts and specifies
               2                     !  t,q,u and v values
               3                     !+ $Id: cudlfs.f90,v 1.5 1998/11/03 14:32:02 m214003 Exp $
               4                     
               5                     !SUBROUTINE cudlfs(klon,klev,klevp1,ptenh,pqenh,puen,pven,&
               6                     SUBROUTINE cudlfs(nxj,klon,klev,klevp1,ptenh,pqenh,puen,pven,&
               7                     & pgeoh,paphp1,ptu,pqu,puu,pvu,ldcum,kcbot,kctop, &
               8                     &      pmfub,prfl,ptd,pqd,pud,pvd,pmfd,pmfds,pmfdq,pdmfdp,kdtop,lddraf)
               9                     
              10                       ! Description:
              11                       !
              12                       ! Calculates level of free sinking for cumulus downdrafts and specifies
              13                       ! t,q,u and v values
              14                       !
              15                       ! Method:
              16                       !
              17                       ! Produce lfs-values for cumulus downdrafts for massflux cumulus
              18                       ! parameterization
              19                       !
              20                       ! This routine is called from *cumastr*.
              21                       ! Input are environmental values of t,q,u,v,p,phi and updraft values
              22                       ! t,q,u and v and also cloud base massflux and cu-precipitation rate.
              23                       ! It returns t,q,u and v values and massflux at lfs.
              24                       !
              25                       ! Check for negative buoyancy of air of equal parts of moist environmental
              26                       ! air and cloud air.
              27                       !
              28                       ! *cuadjtq* for calculating wet bulb t and q at lfs
              29                       !
              30                       ! Authors:
              31                       !
              32                       ! M. Tiedtke, ECMWF, in December 1986 and December 1989, original source
              33                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              34                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              35                       !
              36                       ! for more details see file AUTHORS
              37                       !
              38                     
              39                       USE shr_kind_mod, only: r8 => shr_kind_r8
              40                       USE mo_constants,    ONLY: vtmpc1,  &! vtmpc1=rv/rd-1
              41                                                  cpd       ! specific heat at constant pressure
              42                       USE mo_cumulus_flux, ONLY: lmfdd,   &! true if cumulus downdr. is switched on
              43                                                  cmfdeps, &! fractional massflux for downdr. at lfs
              44                                                  lmfdudv   ! true if cumulus friction is switched on
              45                     
              46                       IMPLICIT NONE
              47                     
              48                       !  Scalar arguments with intent(In):
              49                     !  INTEGER, INTENT (IN) :: klon, klev, klevp1
              50                       INTEGER, INTENT (IN) :: klon, nxj, klev, klevp1
              51                     
              52                       !  Array arguments with intent(In):
              53                       REAL(r8), INTENT (IN) :: paphp1(klon,klevp1), pgeoh(klon,klev), pmfub(klon), &
              54                     &                      pqenh(klon,klev), pqu(klon,klev), ptenh(klon,klev), &
              55                     &                      ptu(klon,klev), puen(klon,klev), puu(klon,klev), &
              56                     &                      pven(klon,klev), pvu(klon,klev)
              57                       INTEGER, INTENT (IN) :: kcbot(klon), kctop(klon)
              58                       LOGICAL, INTENT (IN) :: ldcum(klon)
              59                     
              60                       !  Array arguments with intent(InOut):
              61                       REAL(r8), INTENT (INOUT) :: pdmfdp(klon,klev), pmfd(klon,klev), pmfdq(klon,klev), &
              62                     &                         pmfds(klon,klev), &
              63                     &                         pqd(klon,klev), prfl(klon), ptd(klon,klev), &
              64                     &                         pud(klon,klev), pvd(klon,klev)
              65                       INTEGER, INTENT (INOUT) :: kdtop(klon)
              66                       LOGICAL, INTENT (INOUT) :: lddraf(klon)
              67                     
              68                       !  Local scalars:
              69                       REAL(r8) :: zbuo, zmftop, zqtest, zttest
              70                       INTEGER :: icall, ik, is, jk, jl, jt, ke
              71                     
              72                       !  Local arrays:
              73                       REAL(r8) :: zcond(klon), zph(klon), zqenwb(klon,klev), ztenwb(klon,klev)
              74                       LOGICAL :: llo2(klon), llo3(klon)
              75                     
              76                       !  External subroutines
              77                       EXTERNAL cuadjtq
              78                     
              79                       !  Intrinsic functions
              80                       INTRINSIC MERGE
              81                     
              82                     
              83                       !  Executable statements
              84                     
              85                     !-- 1. Set default values for downdrafts
              86                     
              87                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kdtop, lddraf
                                   <<< Loop-information  End >>>
              88     1  pp   2v        DO jl = 1, nxj
              89     1   p   2v          lddraf(jl) = .FALSE.
              90     1   p   2v          kdtop(jl) = klevp1
              91     1   p   2v        END DO
              92                     
              93                       IF ( .NOT. lmfdd) RETURN
              94                     
              95                     !-- 2. Determine level of free sinking by doing a scan from top to base
              96                     !      of cumulus clouds for every point and proceed as follows:
              97                     !      (1) detemine wet bulb environmental t and q
              98                     !      (2) do mixing with cumulus cloud air
              99                     !      (3) check for negative buoyancy the assumption is that air of
             100                     !          downdrafts is mixture of 50% cloud air + 50% environmental air
             101                     !          at wet bulb temperature (i.e. which became saturated due to
             102                     !          evaporation of rain and cloud water)
             103                     
             104                       ke = klev - 3
             105                     
             106                     !-- 2.1  Calculate wet-bulb temperature and moisture
             107                     !        for environmental air in *cuadjtq*
             108                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmfd, puu, puen, pvu, pven, pud, pvd
                                   <<< Loop-information  End >>>
             109     1                 DO jk = 3, ke
             110     1                   is = 0
             111     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 250
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             112     2  pp    v          DO jl = 1, nxj
             113     2   p    v            ztenwb(jl,jk) = ptenh(jl,jk)
             114     2   p    v            zqenwb(jl,jk) = pqenh(jl,jk)
             115     2   p    v            zph(jl) = paphp1(jl,jk)
             116     2   p    v            llo2(jl) = ldcum(jl) .AND. prfl(jl) > 0. .AND. .NOT. lddraf(jl) .AND. &
             117     2               &          (jk<kcbot(jl) .AND. jk>kctop(jl))
             118     2   p    v            is = is + MERGE(1,0,llo2(jl))
             119     2   p    v          END DO
             120     1                   IF (is==0) CYCLE
             121     1               
             122     1                   ik = jk
             123     1                   icall = 2
             124     1               !    CALL cuadjtq(klon,klev,ik,zph,ztenwb,zqenwb,llo2,icall)
             125     1                   CALL cuadjtq(nxj,klon,klev,ik,zph,ztenwb,zqenwb,llo2,icall)
             126     1               
             127     1               !-- 2.2  Do mixing of cumulus and environmental air and check for negative
             128     1               !        buoyancy.Then set values for downdraft at lfs.
             129     1               
             130     1               !DIR$ IVDEP
             131     1               !OCL NOVREC
             132     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 164
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      llo2, zqenwb, pqenh, zcond, ptenh, pqu
                                   <<<      ztenwb, ptu, pmfub, prfl, kdtop, lddraf
                                   <<<      ptd, pqd, pmfd, pgeoh
                                   <<<    PREFETCH(SOFT) : 8
                                   <<<     SEQUENTIAL : 8
                                   <<<      pmfds: 2, pmfdq: 2, pdmfdp: 2, llo3: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             133     2  pp    v          DO jl = 1, nxj
             134     2   p    v            llo3(jl) = .FALSE.
             135     3   p    v            IF (llo2(jl)) THEN
             136     3   p    v              zttest = 0.5*(ptu(jl,jk)+ztenwb(jl,jk))
             137     3   p    v              zqtest = 0.5*(pqu(jl,jk)+zqenwb(jl,jk))
             138     3   p    v              zbuo = zttest*(1.+vtmpc1*zqtest) - ptenh(jl,jk)*(1.+vtmpc1*pqenh(jl, &
             139     3               &            jk))
             140     3   p    v              zcond(jl) = pqenh(jl,jk) - zqenwb(jl,jk)
             141     3   p    v              zmftop = -cmfdeps*pmfub(jl)
             142     4   p    v              IF (zbuo<0. .AND. prfl(jl)>10.*zmftop*zcond(jl)) THEN
             143     4   p    v                llo3(jl) = .TRUE.
             144     4   p    v                kdtop(jl) = jk
             145     4   p    v                lddraf(jl) = .TRUE.
             146     4   p    v                ptd(jl,jk) = zttest
             147     4   p    v                pqd(jl,jk) = zqtest
             148     4   p    v                pmfd(jl,jk) = zmftop
             149     4   p    v                pmfds(jl,jk) = pmfd(jl,jk)*(cpd*ptd(jl,jk)+pgeoh(jl,jk))
             150     4   p    v                pmfdq(jl,jk) = pmfd(jl,jk)*pqd(jl,jk)
             151     4   p    v                pdmfdp(jl,jk-1) = -0.5*pmfd(jl,jk)*zcond(jl)
             152     4   p    v                prfl(jl) = prfl(jl) + pdmfdp(jl,jk-1)
             153     4   p    v              END IF
             154     3   p    v            END IF
             155     2   p    v          END DO
             156     1               
             157     2                   IF (lmfdudv) THEN
             158     2               !      DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 96, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmfd, puu, puen, pud, pvu, pven, pvd
                                   <<< Loop-information  End >>>
             159     3  pp    v            DO jl = 1, nxj
             160     4   p    v              IF (pmfd(jl,jk)<0.) THEN
             161     4   p    v                pud(jl,jk) = 0.5*(puu(jl,jk)+puen(jl,jk-1))
             162     4   p    v                pvd(jl,jk) = 0.5*(pvu(jl,jk)+pven(jl,jk-1))
             163     4   p    v              END IF
             164     3   p    v            END DO
             165     2               
             166     2                   END IF
             167     1               
             168     1                 END DO
             169                     
             170                       RETURN
             171                     END SUBROUTINE cudlfs


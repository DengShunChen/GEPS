              13                     !     *  modified by:  s. moorthi       aug. 1999, 2000                *
              14                     !     *  modified by:  h. juang         jun. 2004                      *
              15                     !     *                                                                *
              16                     !     *  references:                                                   *
              17                     !     *                                                                *
              18                     !     ******************************************************************
              19                     !
              20                     !     ************ important note *************
              21                     !     in this code vertical indexing runs from surface to top of the
              22                     !     model
              23                     !
              24                     !----------------------------------------------------------------------
              25                     !----------------------------------------------------------------------
              26                     !
              27                           implicit none
              28                     
              29                           real  psat, hvap, grav, hfus, ttp, rd, rv, cp, eps, epsm1

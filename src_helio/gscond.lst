              79                               3.92489e-04,  4.63820e-04,  5.47177e-04,  6.44430e-04,        &
              80                               7.57710e-04,  8.89450e-04,  1.04242e-03,  1.21975e-03,        &
              81                               1.42503e-03,  1.66230e-03,  1.93614e-03,  2.25172e-03,        &
              82                               2.61488e-03,  3.03222e-03,  3.51113e-03,  4.05995e-03,        &
              83                               4.68804e-03,  5.40589e-03,  6.22523e-03,  7.15922e-03,        &
              84                               8.22253e-03,  9.43153e-03,  1.08045e-02,  1.23617e-02,        &
              85                               1.41258e-02,  1.61219e-02,  1.83779e-02,  2.09244e-02,        &
              86                               2.37959e-02,  2.70300e-02,  3.06684e-02,  3.47573e-02,        &
              87                               3.93475e-02,  4.44947e-02,  5.02607e-02,  5.67130e-02,        &
              88                               6.39258e-02,  7.19807e-02,  8.09670e-02,  9.09823e-02,        &
              89                               1.02134e-01,  1.14538e-01,  1.28323e-01,                      &
              90                     !
              91                                             1.45280e-01,  1.64189e-01,  1.85241e-01,        &
              92                               2.08643e-01,  2.34615e-01,  2.63398e-01,  2.95248e-01,        &
              93                               3.30441e-01,  3.69270e-01,  4.12053e-01,  4.59124e-01,        &
              94                               5.10843e-01,  5.67591e-01,  6.29773e-01,  6.97819e-01,        &
              95                               7.72185e-01,  8.53352e-01,  9.41827e-01,  1.03814e+00,        &
              96                               1.14287e+00,  1.25659e+00,  1.37992e+00,  1.51352e+00,        &
              97                               1.65806e+00,  1.81424e+00,  1.98279e+00,  2.16447e+00,        &
              98                               2.36006e+00,  2.57039e+00,  2.79628e+00,  3.03858e+00,        &
              99                               3.29819e+00,  3.57599e+00,  3.87289e+00,  4.18982e+00,        &
             100                               4.52773e+00,  4.88753e+00,  5.27019e+00,  5.67664e+00,        &
             101                     !
             102                               6.10780e+00,  6.56617e+00,  7.05475e+00,  7.57526e+00,        &
             103                               8.12946e+00,  8.71922e+00,  9.34647e+00,  1.00132e+01,        &
             104                               1.07216e+01,  1.14739e+01,  1.22723e+01,  1.31192e+01,        &
             105                               1.40172e+01,  1.49688e+01,  1.59767e+01,  1.70438e+01,        &
             106                               1.81729e+01,  1.93672e+01,  2.06298e+01,  2.19639e+01,        &
             107                               2.33729e+01,  2.48605e+01,  2.64302e+01,  2.80858e+01,        &
             108                               2.98314e+01,  3.16708e+01,  3.36085e+01,  3.56487e+01,        &
             109                               3.77959e+01,  4.00548e+01,  4.24303e+01,  4.49274e+01,        &
             110                               4.75511e+01,  5.03069e+01,  5.32001e+01,  5.62365e+01,        &
             111                               5.94220e+01,  6.27625e+01,  6.62643e+01,  6.99337e+01,        &
             112                     !
             113                               7.37774e+01,  7.78022e+01,  8.20150e+01,  8.64231e+01,        &
             114                               9.10338e+01,  9.58548e+01,  1.00894e+02,  1.06159e+02,        &
             115                               1.11659e+02,  1.17401e+02,  1.23395e+02,  1.29650e+02,        &
             116                               1.36174e+02,  1.42978e+02,  1.50070e+02,  1.57461e+02,        &
             117                               1.65161e+02,  1.73180e+02,  1.81529e+02,  1.90218e+02,        &
             118                               1.99260e+02,  2.08665e+02,  2.18446e+02,  2.28613e+02,        &
             119                               2.39180e+02,  2.50159e+02,  2.61562e+02,  2.73404e+02,        &
             120                               2.85696e+02,  2.98453e+02,  3.11689e+02,  3.25418e+02,        &
             121                               3.39655e+02,  3.54414e+02,  3.69711e+02,  3.85560e+02,        &
             122                               4.01979e+02,  4.18982e+02,  4.36586e+02,  4.54808e+02,        &
             123                     !
             124                               4.73665e+02,  4.93175e+02,  5.13354e+02,  5.34221e+02,        &
             125                               5.55795e+02,  5.78093e+02,  6.01135e+02,  6.24940e+02,        &
             126                               6.49527e+02,  6.74918e+02,  7.01131e+02,  7.28188e+02,        &
             127                               7.56110e+02,  7.84918e+02,  8.14633e+02,  8.45278e+02,        &
             128                               8.76876e+02,  9.09448e+02,  9.43018e+02,  9.77609e+02,        &
             129                               1.01325e+03/
             130                     !
             131                           tem = 1./1.622
             132                     !
             133                     
             134                     !
             135                     !-----------------prepare constants for later uses-----------------
             136                     !
             137                     
             138                           el2orc = hvap*hvap / (rv*cp)
             139                           albycp = hvap / cp
             140                     !
             141                     ! for 2 delta t
             142                           rdt     = h1/dt
             143                     !
             144                     ! for tendency caculation ,2-time level was used, just need 1 dt
             145                           rdt2    = h1/dt*2.
             146                     !
             147                           us      = h1
             148                           cclimit = 1.0e-3
             149                           climit  = 1.0e-20
             150                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      iw
                                   <<< Loop-information  End >>>
             151     1  pp   4             do  i = 1, im
             152     1   p   4               iw(i,km) = d00
             153     1   p   4             enddo
             154                     !
             155                     !  check for first time step
             156                     !
             157     1                     if (tp(1,1) .lt. 1.) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, tp, tp1, qp1, qp
                                   <<< Loop-information  End >>>
             158     2  pp                   do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, tp, qp, tp1, qp1
                                   <<< Loop-information  End >>>
             159     3   p   2                 do i = 1, im
             160     3   p   2                   tp(i,k) = t(i,k)
             161     3   p   2                   qp(i,k) = max(q(i,k),epsq)
             162     3   p   2                   tp1(i,k) = t(i,k)
             163     3   p   2                   qp1(i,k) = max(q(i,k),epsq)
             164     3   p   2                 enddo
             165     2   p                   enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, psp, psp1
                                   <<< Loop-information  End >>>
             166     2  pp   2               do i = 1, im
             167     2   p   2                 psp(i)  = ps(i)
             168     2   p   2                 psp1(i)  = ps(i)
             169     2   p   2               enddo
             170     1                     endif
             171                     
             172                     !-----------------------------------------
             173                     !
             174                     !*************************************************************
             175                     !*******begining of  grid-scale condensation/evap. loop*******
             176                     !*************************************************************
             177                     !
             178                     !     do k = km-1,2,-1
             179     1                     do k = km,1,-1
             180     1               !       vprs(:) = 0.001 * fpvs(t(:,k))       ! fpvs in pa
             181     1               !-----------------------------------------------------------------------
             182     1               !------------------qw, qi and qint--------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, q, cwm, iw, prsl, qi, qint
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             183     2   s                   do i = 1, im
             184     2   m                     tmt0  = t(i,k)-273.16
             185     2   p                     tmt15 = min(tmt0,-15.)
             186     2   p                     qik   = max(q(i,k),epsq)
             187     2   p                     cwmik = max(cwm(i,k),climit)
             188     2               !
             189     2               !  the global qsat computation is done in cb
             190     2   p                     pres    = prsl(i,k)
             191     2               !fpvs
             192     2   m                      qw      = min(pres, 0.001 * fpvs(t(i,k)))
             193     2   p                      qw      = eps * qw / (pres + epsm1 * qw)
             194     2               !qsatq
             195     2               !          call qsatq(1,t(i,k),pres*10.,qw)  !prsl in unit of cb
             196     2               !         t1 = max(1.00001, min(190.999, t(i,k)-182.16))
             197     2               !         ic = int(t1)
             198     2               !         pqs = pres*10.
             199     2               !         qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic))  &
             200     2               !                                    *(t1-float(ic)))
             201     2               !!         qw = 0.622*qqq/(pqs-qqq)
             202     2               !          qw = 0.622*qqq/(pqs+epsm1*qqq)
             203     2               !
             204     2   p                     qw      = max(qw,epsq)
             205     2   p                     qi(i)   = qw
             206     2   p                     qint(i) = qw
             207     2               !-------------------ice-water id number iw------------------------------
             208     2               !
             209     2   p                     iw(i,k) = 0
             210     2               !
             211     3   p                    if(tmt0.lt.-15.0) then
             212     3   p                      u00ik = u(i,k)
             213     3   p                      fi    = qik - u00ik*qi(i)
             214     4   p                      if(fi.gt.d00.or.cwmik.gt.climit) then
             215     4   p                         iw(i,k) = 1
             216     4   p                      else
             217     4   p                        iw(i,k) = 0
             218     4   p                      end if
             219     3   p                    end if
             220     2               
             221     3   p                    if(tmt0.ge.0.0) then
             222     3   p                      iw(i,k) = 0
             223     3   p                    end if
             224     2               
             225     3   p                    if (tmt0 .lt. 0.0 .and. tmt0 .ge. -15.0) then
             226     3   p                      iw(i,k) = 0
             227     4   p                      if (k .lt. km) then
             228     4   p                      if (iw(i,k+1) .eq. 1 .and. cwmik .gt. climit) iw(i,k) = 1
             229     4   p                      endif
             230     3   p                    end if
             231     2               !
             232     2   p                   enddo
             233     1               
             234     1               !--------------condensation and evaporation of cloud--------------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, cwm, prsl, u, t, psp1, ps, qp1, iw
                                   <<<      tp1, qint, qi
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 7
                                   <<<      SIMD&FP   : SPILL 12  FILL 19
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             235     2   s                   do i = 1, im
             236     2               !------------------------at, aq and dp/dt-------------------------------
             237     2   p                     qik   = max(q(i,k),epsq)
             238     2   p                     cwmik = max(cwm(i,k),climit)
             239     2   p                     iwik  = iw(i,k)
             240     2   p                     u00ik = u(i,k)
             241     2   p                     tik   = t(i,k)
             242     2   p                     pres  = prsl(i,k)   * h1000
             243     2   p                     pp0   = (pres / ps(i)) * psp1(i)
             244     2   p                     at    = (tik-tp1(i,k)) * rdt
             245     2   p                     aq    = (qik-qp1(i,k)) * rdt
             246     2   p                     ap    = (pres-pp0)    * rdt
             247     2               ! tik and tp just across 2-time level
             248     2               !         at    = (tik-tp(i,k)) * rdt2
             249     2               !         aq    = (qik-qp(i,k)) * rdt2
             250     2               !         ap    = (pres-pp0)    * rdt2
             251     2               !----------------the satuation specific humidity------------------------
             252     2   p                     fiw   = float(iwik)
             253     2   p                     elv   = (h1-fiw)*elwv    + fiw*eliv
             254     2   p                     qc    = (h1-fiw)*qint(i) + fiw*qi(i)
             255     2               !     if (lprnt) print *,' qc=',qc,' qint=',qint(i),' qi=',qi(i)
             256     2               !----------------the relative humidity----------------------------------
             257     3   p                     if(qc.le.1.0e-10) then
             258     3   p                       rqik=d00
             259     3   p                     else
             260     3   p                       rqik = qik/qc
             261     3   p                     endif
             262     2               !----------------cloud cover ratio ccrik--------------------------------
             263     3   p                     if (rqik .lt. u00ik) then
             264     3   p                        ccrik = d00
             265     3   p                     elseif(rqik.ge.us) then
             266     3   p                        ccrik = us
             267     3   p                     else
             268     3   p                        rqikk  = min(us,rqik)
             269     3   p                        ccrik = h1-sqrt((us-rqikk)/(us-u00ik))      ! (b) eq(11)
             270     3   p                     endif
             271     2               !-----------correct ccr if it is too small in large cwm regions--------
             272     2               !         if(ccrik.ge.0.01.and.ccrik.le.0.2.and
             273     2               !    &          .cwmik.ge.0.2e-3) then
             274     2               !          ccrik=min(1.0,cwmik*1.0e3)
             275     2               !         end if
             276     2               !----------------------------------------------------------------------
             277     2               !   if no cloud exists then evaporate any existing cloud condensate
             278     2               !----------------evaporation of cloud water-----------------------------
             279     2   p                     e0 = d00
             280     2               !
             281     3   p                     if (ccrik.le.cclimit.and.cwmik.gt.climit)  then
             282     3               !
             283     3               !!            if(iwik.eq.1 .and. t(i,k).le.248.16)then                         !begin test
             284     3               !!              tmt0  = t(i,k)-248.16
             285     3               !!              u00ik=u00ik*exp(0.0015*tmt0)
             286     3               !!            endif                                       !end test
             287     3               !
             288     3               !   first iteration - increment halved
             289     3               !
             290     3   s                       tx1 = tik
             291     3   s                       tx3 = qik
             292     3               !fpvs
             293     3               !pres in unit pa
             294     3   s                        es   = min(pres, fpvs(tx1))
             295     3   m                        qs   = u00ik * eps * es / (pres + epsm1*es)
             296     3               !qsatq
             297     3               !!           call qsatq(1,tx1,pres/100.,qs)     !pres in unit of pa
             298     3               !           t1 = max(1.00001, min(190.999, tx1-182.16))
             299     3               !           ic = int(t1)
             300     3               !           pqs = pres*0.01
             301     3               !           qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic))  &
             302     3               !                                    *(t1-float(ic)))
             303     3               !!            qs = 0.622*qqq/(pqs-qqq)
             304     3               !!            qs = 0.622*qqq/(pqs+epsm1*qqq)
             305     3               !            qs   = u00ik*qs
             306     3               !
             307     3   s                       tsq  = tx1 * tx1
             308     3   s                       delq = 0.5 * (qs - tx3) * tsq / (tsq + el2orc * qs)
             309     3               !
             310     3   s                       tx2   = delq
             311     3   s                       tx1   = tx1 - delq * albycp
             312     3   s                       tx3   = tx3 + delq
             313     3               !
             314     3               !   second iteration
             315     3               !
             316     3   s                        es   = min(pres, fpvs(tx1))
             317     3   s                        qs   = u00ik * eps * es / (pres + epsm1*es)
             318     3               !
             319     3               !!           call qsatq(1,tx1,pres/100.,qs)     !pres in unit of pa
             320     3               !           t1 = max(1.00001, min(190.999, tx1-182.16))
             321     3               !           ic = int(t1)
             322     3               !           pqs = pres*0.01
             323     3               !           qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic)) &
             324     3               !                                    *(t1-float(ic)))
             325     3               !           qs = 0.622*qqq/(pqs-qqq)
             326     3               !           qs = 0.622*qqq/(pqs+epsm1*qqq)
             327     3               !            qs   = u00ik*qs
             328     3               !
             329     3   s                       tsq  = tx1 * tx1
             330     3   s                       delq = (qs - tx3) * tsq / (tsq + el2orc * qs)
             331     3               !
             332     3   p                       tx2  = tx2 + delq
             333     3   s                       tx1  = tx1 - delq * albycp
             334     3   p                       tx3  = tx3 + delq
             335     3               !
             336     3               !   third iteration
             337     3               !fpvs
             338     3   m                        es   = min(pres, fpvs(tx1))
             339     3   p                        qs   = u00ik * eps * es / (pres + epsm1*es)
             340     3               !qsatq
             341     3               !!            call qsatq(1,tx1,pres/100.,qs)     !pres in unit of pa
             342     3               !           t1 = max(1.00001, min(190.999, tx1-182.16))
             343     3               !           ic = int(t1)
             344     3               !           pqs = pres*0.01
             345     3               !           qqq = min(tem*pqs, vpsat(ic)+(vpsat(1+ic)-vpsat(ic))  &
             346     3               !                                    *(t1-float(ic)))
             347     3               !!           qs = 0.622*qqq/(pqs-qqq)
             348     3               !!           qs = 0.622*qqq/(pqs+epsm1*qqq)
             349     3               !            qs   = u00ik*qs
             350     3               !
             351     3   s                       tsq  = tx1 * tx1
             352     3   p                       delq = (qs - tx3) * tsq / (tsq + el2orc * qs)
             353     3   p                       tx2  = tx2 + delq
             354     3               !
             355     3   p                       e0   = max(tx2*rdt, 0.0)
             356     3               
             357     3               !           e0 = max(qc*(u00ik-rqik)*rdt, 0.0)
             358     3   p                       e0 = min(cwmik*rdt,   e0)
             359     3   p                       e0 = max(0.0,e0)
             360     3   p                     end if
             361     2               !
             362     2               !   if cloud cover > 0.2 condense water vapor in to cloud condensate
             363     2               !-----------the eqs. for cond. has been reorganized to reduce cpu------
             364     2               !
             365     2   p                     cond = d00
             366     2               !         if (ccrik .gt. 0.20 .and. qc .gt. epsq) then
             367     3   p                     if (ccrik .gt. cclimit .and. qc .gt. epsq) then
             368     3   p                        us00   = us  - u00ik
             369     3   p                        ccrik1 = 1.0 - ccrik
             370     3   p                        aa     = eps*elv*pres*qik
             371     3   p                        ab     = ccrik*ccrik1*qc*us00
             372     3   p                        ac     = ab + 0.5*cwmik
             373     3   p                        ad     = ab * ccrik1
             374     3   p                        ae     = cpr*tik*tik
             375     3   p                        af     = ae * pres
             376     3   p                        ag     = aa * elv
             377     3   p                        ai     = cp * aa
             378     3   p                        cond   = (ac-ad)*(af*aq-ai*at+ae*qik*ap)/(ac*(af+ag))
             379     3               !-----------check & correct if over condensation occurs-----------------
             380     3   p                        condi  = (qik   -u00ik   *qc*1.0)*rdt
             381     3   p                        cond   = min(cond, condi)
             382     3               !----------check & correct if supersatuation is too high----------------
             383     3               !             qtemp=qik-max(0.,(cond-e0))*dt
             384     3               !             if(qc.le.1.0e-10) then
             385     3               !               rqtmp=0.0
             386     3               !             else
             387     3               !               rqtmp=qtemp/qc
             388     3               !             end if
             389     3               !             if(rqtmp.ge.1.10) then
             390     3               !               cond=(qik-1.10*qc)*rdt
             391     3               !             end if
             392     3               !-----------------------------------------------------------------------
             393     3   p                        cond = max(cond, d00)
             394     3               !-------------------update of t, q and cwm------------------------------
             395     3               !
             396     3   p                     end if
             397     2   p                     cone0    = (cond-e0) * dt
             398     2   p                     cwm(i,k) = cwm(i,k) + cone0
             399     2   p                     t(i,k)   = t(i,k)   + elv*rcp*cone0
             400     2   p                     q(i,k)   = q(i,k)   - cone0
             401     2   p                   enddo                                  ! end of i-loop!
             402     1               
             403     1                     enddo                                    ! end of k-loop!
             404                     
             405                     !
             406                     !*********************************************************************
             407                     !****************end of the condensation/evaporation loop*************
             408                     !*********************************************************************
             409                     !----------------store t, q, ps for next time step
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      q, tp1, qp1, t, qp, tp
                                   <<< Loop-information  End >>>
             410     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, qp1, t, qp, q, tp
                                   <<< Loop-information  End >>>
             411     2   p   2               do i = 1, im
             412     2   p   2                 tp(i,k) = tp1(i,k)
             413     2   p   2                 qp(i,k) = qp1(i,k)
             414     2               
             415     2   p   2                 tp1(i,k) = t(i,k)
             416     2   p   2                 qp1(i,k) = max(q(i,k),epsq)
             417     2   p   2               enddo
             418     1   p                 enddo
                                   <<< Loop-information Start >>>

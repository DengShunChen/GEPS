              56                           ,                     tp(ix,km),   qp(ix,km),   psp(im)           &
              57                           ,                     tp1(ix,km),  qp1(ix,km),   psp1(im)         &
              58                           ,                     u(ix,km)                                    &
              59                           ,                     t0(ix,km),   q0(ix,km),   ps0(im)
              60                     !
              61                           real                   qi(im), qint(im), ccrik, e0                &

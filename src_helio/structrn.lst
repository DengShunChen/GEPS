               1                           subroutine structrn(vorten,divten,phiten,mlmax,lev,   &
               2                                                mlsort,mnsort,jtrun,iflag)
               3                     !
               4                     !  purpose : change array structure between forecast model and
               5                     !  initialization
               6                     !            module
               7                     !----------------------------------------------------------------------------
               8                     !  **** input ****
               9                     !  vorten : vorticity tendency(correction) array of spectrum coefficients
              10                     !  divten : divergence tendency(correction) array of spectrum coefficients
              11                     !  phiten : geopotential tendency(correction)array of spectrum coefficients
              12                     !  mlmax  : total number of spectrum coefficient
              13                     !  lev    : total vertical levels
              14                     !  mlsort : array index of forecast model
              15                     !  jtrun  : horizontal wave number truncation limit
              16                     !  iflag  : +2  from forecast model to initialization module
              17                     !           -2  from initialization module to forecast model
              18                     !  **** output ****
              19                     !  vorten : vorticity tendency(correction) array of spectrum coefficients
              20                     !  divten : divergence tendency(correction) array of spectrum coefficients
              21                     !  phiten : geopotential tendency(correction)array of spectrum coefficients
              22                     !----------------------------------------------------------------------
              23                           use paramt
              24                     
              25                           implicit none
              26                     
              27                           integer  mlmax,lev,iflag,k,m,jtrun,l,ml,mn,mlmax2
              28                     
              29                           real vorten(mlmax,2,lev),divten(mlmax,2,lev),phiten(mlmax,2,lev)
              30                           integer mlsort(jtrun,jtrun),mnsort(jtrun,jtrun)
              31                           real      vor(mlm,2,lm),div(mlm,2,lm),phe(mlm,2,lm)
              32                     !
              33                     !  from forecast model to initialization
              34                     !
              35     1                     if(iflag.eq.2)then
              36     1               !mic$  do all
              37     1               !mic$1 private (k,m,l,ml,mn)
              38     1               !mic$2 shared  (lev,jtrun,mlsort,mnsort,vor,div,phe)
              39     1               !mic$3 shared  (vorten,divten,phiten)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              40     2  pp                 do 100 k=1,lev
              41     3   p                 do 100 m=1,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.05, ITR: 40, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
              42     4   p    v            do 100 l=m,jtrun
              43     4   p    v            ml=mlsort(m,l)
              44     4   p    v            mn=mnsort(m,l)
              45     4   p    v            vor(mn,1,k)=vorten(ml,1,k)
              46     4   p    v            vor(mn,2,k)=vorten(ml,2,k)
              47     4   p    v            div(mn,1,k)=divten(ml,1,k)
              48     4   p    v            div(mn,2,k)=divten(ml,2,k)
              49     4   p    v            phe(mn,1,k)=phiten(ml,1,k)
              50     4   p    v            phe(mn,2,k)=phiten(ml,2,k)
              51     2   p    v       100  continue
              52     1               !
              53     1               !  form initialization to forecsat model
              54     1               !
              55     1                     else
              56     1               !mic$  do all
              57     1               !mic$1 private (k,m,l,ml,mn)
              58     1               !mic$2 shared  (lev,jtrun,mlsort,mnsort,vor,div,phe)
              59     1               !mic$3 shared  (vorten,divten,phiten)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              60     2  pp                 do 110 k=1,lev
              61     3   p                 do 110 m=1,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.05, ITR: 32, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
              62     4   p    v            do 110 l=m,jtrun
              63     4   p    v            ml=mlsort(m,l)
              64     4   p    v            mn=mnsort(m,l)
              65     4   p    v            vor(ml,1,k)=vorten(mn,1,k)
              66     4   p    v            vor(ml,2,k)=vorten(mn,2,k)
              67     4   p    v            div(ml,1,k)=divten(mn,1,k)
              68     4   p    v            div(ml,2,k)=divten(mn,2,k)
              69     4   p    v            phe(ml,1,k)=phiten(mn,1,k)
              70     4   p    v            phe(ml,2,k)=phiten(mn,2,k)
              71     2   p    v       110  continue
              72     1                     endif
              73                     !
              74                           mlmax2=mlmax*2
              75                     !mic$  do all
              76                     !mic$1 private (k,ml)
              77                     !mic$2 shared  (lev,mlmax2,vor,div,phe,vorten,divten,phiten)
                                   <<< Loop-information Start >>>

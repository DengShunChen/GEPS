                                   <<< Loop-information  End >>>
              78     1  pp                 do 120 k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      divten, phe, vor, div, vorten, phiten
                                   <<< Loop-information  End >>>
              79     2   p   2v            do 120 ml=1,mlmax2
              80     2   p   2v            vorten(ml,1,k)=vor(ml,1,k)
              81     2   p   2v            divten(ml,1,k)=div(ml,1,k)
              82     2   p   2v            phiten(ml,1,k)=phe(ml,1,k)
              83     1   p   2v       120  continue

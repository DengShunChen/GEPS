 External subroutine subprogram "ndslfv_monoadvv_fgnl"
  (inc)(line-no.)(nest)(optimize)
             281                     !
             282                     ! -------------------------------
             283                           subroutine ndslfv_monoadvv_fgnl(vdzonl,vdmerd,ddtemp,pdot      &
             284                                                     , pt,lonsperlat,deltim,nvars)
             285                     !
             286                     ! a routine to do non-iteration semi-Lagrangain advection
             287                     ! considering advection  with monotonicity in interpolation
             288                     ! contact: hann-ming henry juang
             289                     ! program log:
             290                     ! 2011 02 20 : henry juang, initial implemented into nems as NDSL with mass_dp
             291                     ! 2013 09 30 : henry juang, add option of theta advection, (used later)
             292                     !
             293                     !
             294                           use param
             295                           use grid, only : latpart
             296                           use index
             297                           use rank
             298                           use const
             299                     
             300                           implicit none
             301                     
             302                           real(kind=RTYPE) pdot(nxp,    lev+1,latpart)
             303                           real(kind=RTYPE) plev(nxp,    lev+1)
             304                           real(kind=RTYPE) pt(nxp,latpart)
             305                           integer,intent(in):: lonsperlat(my)
             306                           real(kind=RTYPE),   intent(in):: deltim
             307                     
             308                           real(kind=RTYPE)      qqlon(nxp,    lev*nvars,latpart)
             309                           real(kind=RTYPE)      vdmerd(nxp,lev,my_max),vdzonl(nxp,lev,my_max)
             310                           real(kind=RTYPE)      ddtemp(nxp,lev,my_max)
             311                           real(kind=RTYPE)      rdt2,dt2
             312                     
             313                           integer mono,mass,nvars
             314                           integer ii,i,n,k,kk,lon,lan,lat,lons_lat
             315                           integer kuu, kvv, ktt
             316                           integer ku , kv, kt
             317                     !
             318                     !     lprint = .false.
             319                     
             320                     !     if( lprint ) then
             321                     !       print *,' enter ndslfv_advect  with monotonicity '
             322                     !     endif
             323                     !
             324                           mono  = 1
             325                           mass  = 0
             326                     !      cons0 = 0.0
             327                     !      cons1 = 1.0
             328                     !
             329                     !      levh = ncld * lev
             330                     !
             331                           kuu = 1
             332                           kvv = kuu + lev
             333                           ktt = kvv + lev
             334                     
             335                     !      nvars = 2
             336                     !
             337                           rdt2 = 0.5 / deltim
             338                           dt2 =  2. * deltim
             339                     !
             340                     !$omp parallel do                                                &
             341                     !$omp private(lan,lat,lons_lat,plev,i,k,n,kk,mass,ku,kv,kt)      &
             342                     !$omp schedule(dynamic)
             343                     
             344                     !      do lan=1,lats_node_a
             345     1   p                 do lan=1,jlistnum
             346     1               
             347     1               !        lat = global_lats_a(ipt_lats_node_a-1+lan)
             348     1   p                   lat = jlist1(lan)
             349     1   p                   lons_lat = lonsperlat(lat)
             350     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             351     1   p   4v              plev(:,lev+1) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, (unknown)
                                   <<< Loop-information  End >>>
             352     2   p                   do k=lev,1,-1
             353     2   p                     kk=lev-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.20, ITR: 144, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, (unknown)
                                   <<< Loop-information  End >>>
             354     3   p   2v                do i=1,lons_lat
             355     3   p   2v                  plev(i,k)=plev(i,k+1)+dsigma(kk,1)*pt(i,lan)+dsigma(kk,2)
             356     3   p   2v                enddo
             357     2   p                   enddo
             358     1               
             359     1               !       if( lprint ) then
             360     1               !       do k=1,lev
             361     1               !       print *,' k= ',k
             362     1               !       call mymaxmin(pdot(1,k,lan),lons_lat,lonfull,1,' pdot ')
             363     1               !       call mymaxmin(plev(1,k),lons_lat,lonfull,1,' plev ')
             364     1               !       enddo
             365     1               !       endif
             366     1               !
             367     1               ! d z t at n+1*
             368     1               !       kappa = con_rd / con_cp
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdzonl, vdmerd, ddtemp, qqlon
                                   <<< Loop-information  End >>>
             369     2   p                   do k=1,lev
             370     2   p                     kk=lev-k+1
             371     2   p                     ku=kuu+k-1
             372     2   p                     kv=kvv+k-1
             373     2   p                     kt=ktt+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, vdmerd, vdzonl, ddtemp
                                   <<< Loop-information  End >>>
             374     3   p    v                do i=1,lons_lat
             375     3   p    v                  qqlon(i,ku,lan) = vdzonl(i,kk,lan)
             376     3   p    v                  qqlon(i,kv,lan) = vdmerd(i,kk,lan)
             377     3   p    v                  if ( nvars .ge. 3 ) qqlon(i,kt,lan) = ddtemp(i,kk,lan)
             378     3   p    v                enddo
             379     2   p                   enddo
             380     1               !
             381     1               !
             382     1   p                   mass=0
             383     1               !
             384     1   p                   call vertical_cell_advect (lons_lat,nxp,    lev,nvars, &
             385     1                                 deltim,plev,pdot(1,1,lan),qqlon(1,1,lan),mass)
             386     1               !
             387     1               !
             388     1               ! u v t tendency at n
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qqlon, ddtemp, vdmerd, vdzonl
                                   <<< Loop-information  End >>>
             389     2   p                   do k=1,lev
             390     2   p                     kk=lev-k+1
             391     2   p                     ku=kuu+k-1
             392     2   p                     kv=kvv+k-1
             393     2   p                     kt=ktt+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ddtemp, qqlon, vdmerd, vdzonl
                                   <<< Loop-information  End >>>
             394     3   p    v                do i=1,lons_lat
             395     3   p    v                  vdzonl(i,kk,lan) = qqlon(i,ku,lan)
             396     3   p    v                  vdmerd(i,kk,lan) = qqlon(i,kv,lan)
             397     3   p    v                  if ( nvars .ge. 3 ) ddtemp(i,kk,lan) = qqlon(i,kt,lan)
             398     3   p    v                enddo
             399     2   p                   enddo
             400     1               !
             401     1               !       if( lprint ) then
             402     1               !       call mymaxmin(qqlon(1,kqq,lan),lons_lat,lonfull,1,' q vertadv')
             403     1               !       print *,' ------------------------------------------- '
             404     1               !       print *,' finish updating n+1* in grid_gr at lan=',lan
             405     1               !       endif
             406     1               !
             407     1   p                 enddo
             408                     !$omp end parallel do
             409                     
             410                     !
             411                     ! ===============================
             412                     !
             413                           return
             414                           end


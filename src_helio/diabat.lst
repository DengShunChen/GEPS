             600     1                        julian= julian + 1
             601     1                        if ( julian .gt. yrd ) julian = julian - yrd
             602     1                        doozon = .true.
             603     1                        doclxu = .true.
             604     1                     endif
             605                           leap = mod ( year , 4 )
             606                           yrd = 365

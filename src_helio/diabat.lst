             561                           tpi   = 4.0*atan(1.0)
             562                           d2r   = tpi / 180.0
             563                           tpr   = 2.*tpi*radus
             564                           ptrad = max(0.01,ptop)
             565                           xkapa = rgas/cp
             566                           xkapa1= 1.0 + xkapa
             567                           okapa = 1.0/xkapa
             568                           p0k   = 1000.0**xkapa
             569                           op0k  = 1.0/p0k
             570                           ptopk = ptop**xkapa

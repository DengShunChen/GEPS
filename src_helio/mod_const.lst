             188     1                           stop
             189     1                       end if
             190                     
             191                     
             192                             allocate (outdir(nout),stat= ierr)
             193     1                       if (ierr/= 0) then
             194     1                           write(6,*) 'mod_const : allocate fail 5 '
             195     1                           stop

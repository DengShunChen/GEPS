             154                           subroutine allocate_const_array
             155                             implicit none
             156                             integer  ierr
             157                     
             158                             allocate (poly(jtrun,my/2,jtmax),dpoly(jtrun,my/2,jtmax),          &
             159                                       eps4(jtrun,jtmax),wdfac(jtrun,jtmax),wcfac(jtrun,jtmax), &
             160                                       cim(jtmax), stat=ierr)
             161     1                       if (ierr/= 0) then
             162     1                           write(6,*) 'mod_const : allocate fail 1 '
             163     1                           stop
             164     1                       end if
             165                     
             166                             allocate (aki(lev+1),bki(lev+1),                         &
             167                                       sigma(lev+1,2),dsigma(lev,2), stat= ierr)
             168     1                       if (ierr/= 0) then

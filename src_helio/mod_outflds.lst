             507                     
             508                       subroutine surfout(nx,my,my_max,ifilout,itau,idtg,taudir,ntau,pdiff  &
             509                            ,pt,ptop,slp,ptend,glob,ggdef,lwrite)
             510                     !
             511                           use index
             512                           use mpe
             513                           use rank
             514                           use const, only: RTYPE,kflag
             515                     !
             516                           implicit  none
             517                           integer   nx,my,my_max,i,j,jj,kk,n,lev,nxj,itau,ntau,num,lenc,istat
             518                     
             519                           real      pdiff(nxp,my_max)
             520                           real(kind=RTYPE) ptend(nxp,my_max),pt(nxp,my_max),glob(nx,my),   &
             521                                            slp(nxp,my_max),tmp(nxp,my_max)
             522                           character*16 taudir(ntau)
             523                           character*4 ggdef
             524                     !
             525                           real      ptop,tnshun
             526                     !
             527                           integer*8 idtg
             528                           character*80 ifilout
             529                           character*26 lrec
             530                           character*6 label(ntau),labx
             531                     
             532                           logical :: lwrite
             533                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptend, pt, pdiff, slp
                                   <<< Loop-information  End >>>
             534     1  pp                 do jj = 1, jlistnum
             535     1   p                   j=jlist1(jj)
             536     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, ptend, pdiff, pt
                                   <<< Loop-information  End >>>
             537     2   p   2v              do i=1,nxj
             538     2               !byl          slp(i,j)= pt(i,jj)+pdiff(i,jj)
             539     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             540     2   p   2v                ptend(i,jj)= ptend(i,jj)*3600.0
             541     2   p   2v              enddo
             542     1   p                 enddo
             543                     !
             544                     !byl      call unify_reduceintp(nx,my,my_max,tmp,slp)
             545                     !byl      call mpe_unify(slp,nx,my,2,mpe_double)
             546                     !byl      if( lreduce.eq.1 ) call reduceintp (slp,nxdef,nx,my)
             547                     !byl      call smth9(nx,my,slp,glob,1)
             548                     !byl      slp=glob
             549                     !byl      call smth9(nx,my,slp,glob,2)
             550                     !byl      slp=glob

             243     2               !!            h500(i,1)=phips(i,k)
             244     2               !!          enddo
             245     2               !          if(itau.le.72 .and. lreduce.eq.1)then
             246     2               !byl            call smth9(nx,my,h500,glob,1)
             247     2               !byl            h500=glob
             248     2               !byl            call smth9(nx,my,h500,glob,2)
             249     2               !byl            h500=glob
             250     2               !          endif
             251     2                       endif
             252     1                     enddo
             253                     !
             254     1                     do 20 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             255     2                     do 10 k=1,lpout
             256     2               !
             257     3                     if(plev(k).eq.whtlev(n)) then
             258     3               !
             259     3                     ncnt=ncnt+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phips, tmp
                                   <<< Loop-information  End >>>
             260     4  pp                 do 11 jj=1, jlistnum
             261     4   p                 j=jlist1(jj)
             262     4   p                 nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phips, tmp
                                   <<< Loop-information  End >>>
             263     5   p   2v            do 11 i=1,nxj
             264     5   p   2v             tmp(i,jj)= phips(i,jj,k)+phistd(k)
             265     4   p   2v         11 continue
             266     3                     call unify_reduceintp(nx,my,my_max,tmp,glob)
             267     3               !
             268     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             269     3               !
             270     3               !      if(lreduce.eq.1 .and. itau.le.72)then
             271     3                       call smth9(nx,my,glob,slp,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, glob
                                   <<< Loop-information  End >>>
             272     3  pp   4v              glob=slp
             273     3                       call smth9(nx,my,glob,slp,2)
             274     3               !        glob=slp
             275     3               !      endif
             276     3               !
             277     3               !      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             278     3                     call qmaxn3(slp,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             279     4                     if ( myrank .eq. ncnt ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, pout
                                   <<< Loop-information  End >>>
             280     4  pp   4v              pout=slp
             281     4                       ihdg2=ihdg
             282     4                     endif
             283     3               !
             284     3                     go to 20
             285     3                     endif
             286     2                  10 continue
             287     1                  20 continue
             288                           if(lwrite .and. myrank .le. ncnt) call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             289                     !
             290                           return
             291                       end subroutine geopout
             292                     
             293                       subroutine shumout(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             294                           , plev,num,whtlev,pkout,pk,pklp,dpd,dpdb,dew,glob,ggdef,lwrite)
             295                     !
             296                           use index
             297                           use rank, only : myrank
             298                           use const, only : RTYPE,kflag
             299                     
             300                           implicit  none
             301                           integer   nx,my,my_max,lpout,lev,itau,num,ncnt
             302                     
             303                           real      pkout(lpout),pklp(nxp,my_max)                            &
             304                           , pk(nxp,lev,my_max),dpd(nxp,lev,my_max),dpdb(nxp,my_max)          &
             305                           , plev(lpout),whtlev(num),tens(lev+1)
             306                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)           &
             307                           ,                dew(nxp,my_max,lpout),ffx(nx,my_max)
             308                     
             309                     
             310                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             311                     !
             312                           integer*8 idtg
             313                           character*80 ifilout
             314                           character*26 ihdg,ihdg2
             315                           character*6 lrec(lpout)
             316                           character*4 ggdef
             317                     !
             318                           logical :: lwrite
             319                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             320     1  pp   4v            do k = 1, lev+1
             321     1   p   4v             tens(k) = 1.0
             322     1   p   4v            end do
             323                           tens(lev)= 0.0
             324                           tens(lev+1)= 0.0
             325                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             326     1   m   2v            do k = 1, lpout-1
             327     1   p   2v             lpl = int(plev(k)+0.001)
             328     1   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'510'
             329     1   p   2v            end do
             330                           lrec(lpout) = 'h00510'
             331                     !
             332                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,dpd,dpdb,pkout,dew,tens)
             333                     !
             334                           lenc= nx*my
             335                           ncnt= -1
             336                     !
             337     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             338     2                     do 10 k=1,lpout
             339     2               !
             340     3                     if(plev(k).eq.whtlev(n)) then
             341     3               !
             342     3               ! relative humidity must be smaller or equal 1.0
             343     3               !
             344     3                     ncnt=ncnt+1
             345     3               !!      do 20 jj=1, jlistnum
             346     3               !!      j=jlist1(jj)
             347     3               !!      nxj=nxdef_2d(j)
             348     3               !!      do 20 i=1,nxj
             349     3               !!       tmp(i,jj)= min(100.,max(dew(i,jj,k)*100.,0.0))
             350     3               !!   20 continue
             351     3                     call mpe2d_unify_nx(ffx,dew(1,1,k))
             352     4                     if( lreduce.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             353     5                       do jj =1, jlistnum
             354     5                         j=jlist1(jj)
             355     5                         call reduceintp(ffx(1,jj),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 304, MVE: 10, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             356     6  pp   2v                do i=1,nx
             357     6   p   2v                   ffx(i,jj)=min(100.,max(ffx(i,jj)*100.,0.0))
             358     6   p   2v                enddo
             359     5                       enddo
             360     4                     endif
             361     3                     call mpe2d_unify_my(glob,ffx)
             362     3               !      call unify_reduceintp(nx,my,my_max,dew(1,1,k),glob)
             363     3               !      do 20 i=1,lenc
             364     3               !      glob(i,1)= min(100.,max(glob(i,1)*100.,0.0))
             365     3               !   20 continue
             366     3               !
             367     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             368     3               !
             369     3               !  reduceintp has been done in voterp (2011/5)
             370     3               !
             371     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             372     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             373     4                     if ( myrank .eq. ncnt ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, pout
                                   <<< Loop-information  End >>>
             374     4  pp   4v              pout=glob
             375     4                       ihdg2=ihdg
             376     4                     endif
             377     3                     go to 30
             378     3                     endif
             379     2                  10 continue
             380     1                  30 continue
             381                           if(lwrite .and. myrank .le. ncnt) call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             382                     !
             383                           return
             384                       end subroutine shumout

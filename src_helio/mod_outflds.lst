             386                       subroutine shumout2(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             387                           , plev,num,whtlev,pkout,pk,pklp,dpd,dpdb,dew,glob,ggdef,ntrac,lwrite)
             388                     !
             389                           use index
             390                           use rank, only : myrank
             391                           use radn, only : ntoz
             392                           use param, only : ncld
             393                           use const, only : RTYPE,kflag,qmin
             394                     
             395                           implicit  none
             396                     
             397                           integer   nx,my,my_max,lpout,lev,itau,num,ntrac,ncnt,ntrchk
             398                     
             399                           real      pkout(lpout),pklp(nxp,my_max)                        &
             400                           , pk(nxp,lev,my_max),dpd(nxp,lev,my_max),dpdb(nxp,my_max)      &
             401                           , plev(lpout),whtlev(num),tens(lev+1)
             402                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)       &
             403                           , dew(nxp,my_max,lpout),ffx(nx,my_max)
             404                     !
             405                     
             406                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             407                     
             408                           integer*8 idtg
             409                           character*80 ifilout
             410                           character*26 ihdg,ihdg2
             411                           character*6 lrec(lpout)
             412                           character*4 ggdef
             413                           character*3 cspec(6)
             414                           logical :: lwrite
             415                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             416         s   f             cspec=(/'500','551','553','552','554','555'/)
             417                     !
             418                           ntrchk=ncld
             419                           if ( ntoz .gt. 0 ) ntrchk=ncld-1
             420                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             421     1  pp   4v            do k = 1, lev+1
             422     1   p   4v             tens(k) = 1.0
             423     1   p   4v            end do
             424                           tens(lev)= 0.0
             425                           tens(lev+1)= 0.0
             426                     !
             427     1                     if(ntrac.le.ntrchk)then ! all hydrometeors
             428     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             429     2   m   2v            do k = 1, lpout-1
             430     2   p   2v             lpl = int(plev(k)+0.001)
             431     2   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,cspec(ntrac)
             432     2   p   2v            end do
             433     1                     write( lrec(lpout), '(a3,a3)' ) 'h00',cspec(ntrac)
             434     1               !
             435     1                     else if(ntrac.eq.ntoz)then
             436     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             437     2   m   2v              do k = 1, lpout-1
             438     2   p   2v                lpl = int(plev(k)+0.001)
             439     2   s   2m                write( lrec(k), '(i3.3,a3)' ) lpl,'560'   ! ozone
             440     2   p   2v              end do
             441     1                       lrec(lpout) = 'h00560'
             442     1               !
             443     1                     else if(ntrac.eq.ncld+1)then
             444     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             445     2   m   2v              do k = 1, lpout-1
             446     2   p   2v                lpl = int(plev(k)+0.001)
             447     2   s   2m                write( lrec(k), '(i3.3,a3)' ) lpl,'550'   ! combine cloud water and cloud ice together
             448     2   p   2v              end do
             449     1                       lrec(lpout) = 'h00550'
             450     1                     else
             451     1                       goto 40
             452     1                     endif
             453                     !
             454                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,dpd,dpdb,pkout,dew,tens)
             455                     !
             456                           lenc= nx*my
             457                           ncnt= -1
             458                     !
             459     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             460     2                     do 10 k=1,lpout
             461     2               !
             462     3                     if(plev(k).eq.whtlev(n)) then
             463     3               !
             464     3               !
             465     3               ! relative humidity must be smaller or equal 1.0
             466     3               !
             467     3                     ncnt=ncnt+1
             468     3               !      do 20 jj=1, jlistnum
             469     3               !      j=jlist1(jj)
             470     3               !      nxj=nxdef_2d(j)
             471     3               !      do 20 i=1,nxj
             472     3               !       tmp(i,jj)= max(dew(i,jj,k),0.0)
             473     3               !   20 continue
             474     3                     call mpe2d_unify_nx(ffx,dew(1,1,k))
             475     4                     if( lreduce.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             476     5                       do jj =1, jlistnum
             477     5                         j=jlist1(jj)
             478     5                         call reduceintp(ffx(1,jj),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 208, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             479     6  pp   2v                do i=1,nx
             480     6   p   2v                   ffx(i,jj)=max(ffx(i,jj),qmin)
             481     6   p   2v                enddo
             482     5                       enddo
             483     4                     endif
             484     3                     call mpe2d_unify_my(glob,ffx)
             485     3               !      do 20 i=1,lenc
             486     3               !        glob(i,1)= max(glob(i,1),0.0)
             487     3               !   20 continue
             488     3               !
             489     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             490     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             491     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             492     4                     if ( myrank .eq. ncnt ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, pout
                                   <<< Loop-information  End >>>
             493     4  pp   4v              pout=glob
             494     4                       ihdg2=ihdg
             495     4                     endif
             496     3                     go to 30
             497     3                     endif
             498     2                  10 continue
             499     1                  30 continue
             500                           if(lwrite .and. myrank .le. ncnt) call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             501                     !
             502                        40 continue
             503                     
             504                           return
             505                       end subroutine shumout2

              18                            real      tem(lev,2,jtrun,jtmax),ctime,cool
              19                     
              20                            integer   k,j,i,jj,nxj,m,mf,n
              21                            real      wt,pk1,pk2,opk,fac,c1
              22                     !
              23                     !      data ctime/6./
              24                     !      data ctime/12./
              25                     !      data ctime/4./
              26                           data ctime/24./
              27                     !
              28                     !
              29                           real gsum(3,my)

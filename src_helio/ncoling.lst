               3                     !
               4                     ! modify to f90 by C-H Lee and sort by River Chen in 2015
               5                     !
               6                           use index
               7                           use mpe
               8                           use const, only: RTYPE
               9                     
              10                           implicit  none
              11                           integer   jtrun,jtmax,nx,my,my_max,lev
              12                     
              13                           real      temnow(lev,2,jtrun,jtmax),                       &

             164                     !-----------------------------------------------------------------
             165                     !CWB2021 for single precision test
             166                     
             167                           subroutine joinrs_sp(cc,r1,r2,r3,r4,nx,my_max,lev,jlistnum,num,ncld)
             168                     !
             169                           implicit  none
             170                           real*4      cc(*), r1(*), r2(*), r3(*), r4(*)
             171                           integer   nx,my_max,lev,jlistnum,num,ncld
             172                     !
             173                           if(num .eq. 1) call join1rs_sp(cc,r1,nx,my_max,lev,jlistnum,ncld)
             174                           if(num .eq. 2) call join2rs_sp(cc,r1,r2,nx,my_max,lev,jlistnum,ncld)
             175                           if(num .eq. 3) call join3rs_sp(cc,r1,r2,r3,nx,my_max,lev,jlistnum,ncld)
             176                     !
             177                           return
             178                           end


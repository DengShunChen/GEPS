  (inc)(line-no.)(nest)(optimize)
               1                           subroutine vterpj (nx,lmaxp,lev,yr,f,yout,dout,tensy)
               2                     !
               3                     !  a bicubic spline interpolator to interpolate from a grid
               4                     !  with constant i (first dimension) grid spacing and variable
               5                     !  j (second dimension) grid spacing t0 a grid with
               6                     !  variable grid spacing. all grids are assumed to have point
               7                     !  (i,1) in the lower left corner with i increasing to the right
               8                     !  and j increasing upward.
               9                     !
              10                     ! **** input ****
              11                     !
              12                     !  nx: no. of points in e-w direction of input arrays
              13                     !  lmaxp: no. of levels in input arrays
              14                     !  lev: no. of levels in output arrays
              15                     !  yr: independent interpolation variable for input grid
              16                     !  f: dependent variable for input grid
              17                     !  yout: independent interpolation variable for output grid
              18                     !  tensy: cubic spline tension factor.
              19                     !
              20                     ! **** output ****
              21                     !
              22                     !  dout: dependent variable on output grid
              23                     !
              24                           use const, only: RTYPE
              25                     !
              26                           implicit none
              27                     
              28                           integer   nx,lmaxp,lev
              29                     
              30                           real      f(nx,lmaxp),dout(nx*lev),yr(nx,lmaxp)  &
              31                                   , yout(nx*lev),tensy(lmaxp)
              32                     !
              33                           real(kind=RTYPE) fxx(nx,lmaxp),fyy(nx,lmaxp),pjy(nx*lev*4) &
              34                                   , tp1(nx*lev*4)
              35                     
              36                           integer   ipt(nx*lev)
              37                     
              38                           integer  jym2, nxjym2,ll,i,k,i1,i2,i3,mn
              39                     
              40                     !
              41                     !          compute ipt and pjy
              42                     !
              43                           jym2  = lmaxp-2
              44                           nxjym2= nx*jym2
              45                           mn    = nx*lev
              46                     !
              47                           call setupv (yr,yout,mn,nx,lmaxp,pjy,ipt,tp1)
              48                     !
              49                     !          compute fyy
              50                     !
              51                           ll= nxjym2+nx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      yr, fxx
                                   <<< Loop-information  End >>>
              52     1  pp   2v            do 110 i=1,ll
              53     1   p   2v            fxx(i,2)= yr(i,2)-yr(i,1)
              54     1   p   2v        110 continue
              55                     !
              56                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 471
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, fxx, fyy
                                   <<< Loop-information  End >>>
              57     1  pp    v            do 210 i=1,nxjym2
              58     1   p    v            fyy(i,2)= (fxx(i,3)*(f(i,1)-f(i,2))+fxx(i,2)*(f(i,3) &
              59     1                               -f(i,2)))/(fxx(i,3)*fxx(i,3)*fxx(i,2))
              60     1   p    v        210 continue
              61                     
              62                     !ocl serial
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fxx
                                   <<< Loop-information  End >>>
              63     1       2v            do i=1,nxjym2
              64     1       2v               fxx(i,2)= fxx(i,2)/fxx(i,3)
              65     1       2v            enddo
              66                     !
              67                           call trdivv (nx,jym2,fxx(1,2),fyy(1,2))
              68                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              69     1  pp   2v            do 100 i=1,nx
              70     1   p   2v            fyy(i,1)= 0.0
              71     1   p   2v            fyy(i,lmaxp)= 0.0
              72     1   p   2v        100 continue
              73                     !
              74                     !  apply tension
              75                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              76     1  pp                 do 5 k=1,lmaxp
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fyy
                                   <<< Loop-information  End >>>
              77     2   p   2v            do 5 i=1,nx
              78     2   p   2v            fyy(i,k)= fyy(i,k)*tensy(k)
              79     1   p   2v          5 continue
              80                     !
              81                           call gathv (mn,nx,lmaxp,ipt,fyy,f,tp1)
              82                     !
              83                           i1= mn
              84                           i2= mn*2
              85                           i3= mn*3
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, pjy, dout
                                   <<< Loop-information  End >>>
              86     1  pp    v            do 130 i=1,mn
              87     1   p    v            dout(i)= tp1(i)*pjy(i)+tp1(i+i1)*pjy(i+i1)+tp1(i+i2)*pjy(i+i2) &
              88     1                            + tp1(i+i3)*pjy(i+i3)
              89     1   p    v        130 continue
              90                           return
              91                           end


             764                     !---------------------------------------------------------------
             765                           subroutine split(nx,my,lev,lenc,ifilout,nc,glob,mout,ihdg,ihdg2)
             766                     !
             767                           use rank
             768                           use const, only: RTYPE,kflag
             769                     !
             770                           implicit none
             771                     !
             772                           integer   nx,my,nc,istat,lenc,lev
             773                           real(kind=RTYPE) glob(nx,my),mout(nx,my)
             774                           character*26 ihdg,ihdg2
             775                           character*80 ifilout
             776                     
             777     1                     if (myrank .eq. nc) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED

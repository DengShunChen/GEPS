                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, mout
                                   <<< Loop-information  End >>>
             778     1  pp   4v              mout  = glob
             779     1                       ihdg2 = ihdg
             780     1                     endif
             781                             nc    = nc + 1
             782                     !
             783     1                     if ( nc .eq. lev .and. myrank .lt. nc ) then
             784     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,mout,istat)
             785     1                       nc    = 0
             786     1                     endif
             787                     !
             788                           return

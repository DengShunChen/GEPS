                                   <<<      tens
                                   <<< Loop-information  End >>>
             382     1  pp   4v            do k = 1, lev+1
             383     1   p   4v              tens(k) = 1.0
             384     1   p   4v            end do
             385                           tens(lev+1)= 0.0
             386                           tens(lev)= 0.0
             387                           call voterp(nx,my,my_max,lev,lpout,plog,pllp,tmp,bt1 &
             388                                       ,pkout,pres3d,tens)
             389                     
             390     1                     do k=1,lpout
             391     1                       call unify_reduceintp(nx,my,my_max,pres3d(1,1,k),glob)
             392     2                       if(myrank.eq.0) then
             393     2               !          call qmax2d(glob,1,1,nx,my)
             394     2                         call xyintpo('gg',nx,my,'ga',nx2,my2,glob,rsmoutp,0 &
             395     2                                       ,xr,yr,.true.)
             396     2               !          print*,'x1,x2,nxs,mys,k=',x1,x2,nxs,mys,k
             397     2               !          call qmax2d(rsmoutp,1,1,nx2,my2)
             398     2                         jj=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

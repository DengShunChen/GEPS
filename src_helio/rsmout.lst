             181     2                         ntt = ntt + nxjp(j)*lev
             182     2                       enddo
             183     1                       call mpe_global_sum(ngq,1,mpe_integer)
             184     1                       call mpe_global_sum(ntt,1,mpe_integer)
             185     1                       if( n.eq.1 .and. myrank.eq.0 .and. ngq.ne.0 )  print 901, ngq
             186     1                       if( n.eq.2 .and. myrank.eq.0 .and. ngq.ne.0 )  print 902, ntt-ngq
             187     1                     enddo
             188                     
             189                       901 format ( 1x, " *** warning: in outflds, there are grid points"  &
             190                                  , " with q < 0. , total number = ",i8,// )
             191                       902 format ( 1x, " *** checking: in outflds, there are grid points" &
             192                                  , " with qc > 0. , total number = ",i8,// )
             193                     !
             194                     !                 compute interpolation coeffs
             195                     !
             196                           ograv= 1.0/grav
             197                     !
             198                     !  generate structure variables
             199                     !
             200                     !  first, the log(p) quantities
             201                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.89, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pout, pkout
                                   <<< Loop-information  End >>>
             202     1  pp    v            do k=1,lpout
             203     1   p    v              pkout(k)= log(pout(k))
             204     1   p    v            enddo
             205                     !
             206                     !  generate std height at p levels
             207                     !
             208                           call geostd(lpout,pout,phistd)
             209                     !
             210                           alaps = 0.0065
             211                           rdg = rgas/grav
             212                     !
             213                     !  hydrostatic equation
             214                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk2, pk, sgeo, phi
                                   <<< Loop-information  End >>>
             215     1  pp                 do jj =1,jlistnum
             216     1   p                   j=jlist1(jj)
             217     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, sgeo, tt, phi
                                   <<< Loop-information  End >>>
             218     2   p   2v              do i=1,nxj
             219     2   p   2v                phi(i,lev,jj)= cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj)) &
             220     2                                      + sgeo(i,jj)
             221     2   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, tt, phi
                                   <<< Loop-information  End >>>
             222     2   p                   do k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, phi, pk2
                                   <<< Loop-information  End >>>
             223     3   p    v                do i=1,nxj
             224     3   p    v                  phi(i,k,jj)= phi(i,k+1,jj)+cp*(tt(i,k,jj)*(pk2(i,k,jj)-pk(i,k,jj)) &
             225     3                                      + tt(i,k+1,jj)*(pk(i,k+1,jj)-pk2(i,k,jj)))
             226     3   p    v                enddo
             227     2   p                   enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             228     2   p                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.89, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plt, plog
                                   <<< Loop-information  End >>>
             229     3   p    v                do i=1,nxj
             230     3   p    v                  plog(i,k,jj)= log(plt(i,k,jj))
             231     3   p    v                enddo
             232     2   p                   enddo
             233     1   p                 enddo
             234                     !
             235                     !  compute sea level pressure and update pdiff
             236                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             237                     !
             238                     !  llts layer's temperature is used to derive an alternative
             239                     !  surface skin temperature
             240                     !
             241                     !      if( itau .gt. 0 )then
             242                     !
             243                           llts = lev-5
             244                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             245     1  pp                 do jj = 1, jlistnum
             246     1   p                   j=jlist1(jj)
             247     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, pt, plt, sgeo, phi, hld1
                                   <<<      hld2, pdiff, pllp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
             248     2   p    v              do i=1,nxj
             249     2   p    v                ttb  = tt(i,lev,jj)*pk(i,lev,jj)/(1.0+0.608*qt(i,lev,jj))
             250     2   p    v                ttp  = tt(i,llts,jj)*pk(i,llts,jj)/(1.0+0.608*qt(i,llts,jj))
             251     2   p    v                ttt1 = ttb + alaps*rdg*ttb*   &
             252     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             253     2   p    v                ttt2 = ttp + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             254     2   p    v                hld1(i,jj) = 0.25*ttt1 + 0.75*ttt2
             255     2   p    v                hld2(i,jj) = hld1(i,jj) + alaps*sgeo(i,jj)/grav
             256     3   p    v                if( sgeo(i,jj) .lt. 0.1 ) then
             257     3   p    v                  anlslp = pt(i,jj) + ptop
             258     3   p    v                else if( hld1(i,jj) .le. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             259     3   p    v                  apha = rgas*(290.5-hld1(i,jj))/sgeo(i,jj)
             260     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             261     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             262     3                                    apha*ttt*apha*ttt) )
             263     3   p    v                else if( hld1(i,jj) .gt. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             264     3   p    v                  hld1(i,jj) = (hld1(i,jj)+290.5)*0.5
             265     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             266     3   p    v                else if( hld1(i,jj) .lt. 255.0 .and. hld2(i,jj) .lt. 255.0 ) then
             267     3   p    v                  hld1(i,jj) = (hld1(i,jj)+255.0)*0.5
             268     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             269     3   p    v                else
             270     3   p    v                  apha = alaps * rdg
             271     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             272     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             273     3                                    apha*ttt*apha*ttt) )
             274     3   p    v                endif
             275     2   p    v                pllp(i,jj) = anlslp - pt(i,jj)
             276     2   p    v                pdiff(i,jj)=pllp(i,jj)
             277     2   p    v              enddo
             278     1   p                 enddo
             279                     !
             280                     !      else
             281                     !
             282                     !  pllp equal to pdiff at the initial time, tau=0
             283                     !
             284                     !      do jj = 1, jlistnum
             285                     !        j=jlist1(jj)
             286                     !        nxj=nxdef(j)
             287                     !        do i = 1, nxj
             288                     !          pllp(i,j) = pdiff(i,jj)
             289                     !        enddo
             290                     !      enddo
             291                     !
             292                     !      endif     ! end of ( itau .gt. 0 )
             293                     !
             294                     !      call mpe_unify(pllp,nx,my,2,mpe_double)
             295                     !      call mpe_unify(pt,nx,my,2,mpe_double)
             296                     !
             297                     !
             298                     !  obtain the the bottom pressure for the following interpolations
             299                     !  bt2 will be used in geoptential interpolations
             300                     !
             301                           pl1000= log(1000.1)
             302                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdiff, pt, pllp, slp
                                   <<< Loop-information  End >>>
             303     1                     do jj = 1, jlistnum
             304     1                       j=jlist1(jj)
             305     1                       nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 176, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pdiff, slp, pt, pllp
                                   <<< Loop-information  End >>>
             306     2  pp   2v              do i = 1, nxj
             307     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             308     3   p   2v                if( slp(i,jj) .le. 1000.1) then
             309     3   p   2v                  pllp(i,jj) = 1000.1
             310     3   p   2v                else
             311     3   p   2v                  pllp(i,jj) = slp(i,jj)
             312     3   p   2v                endif
             313     2   p   2v              enddo
             314     1               !
             315     1                       call geostd (nxjp(j),pllp(1,jj),bt2(1,jj))
             316     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.00, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pllp
                                   <<< Loop-information  End >>>
             317     2  pp    v              do i = 1, nxj
             318     2   p    v                pllp(i,jj) = log(pllp(i,jj))
             319     2   p    v              enddo
             320     1                     enddo
             321                     !
             322                     !      call mpe_unify(pllp,nx,my,2,mpe_double)
             323                     !      call mpe_unify(bt2,nx,my,2,mpe_double)
             324                     !
             325                     !  temperature output
             326                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             327     1  pp                 do jj =1,jlistnum
             328     1   p                   j=jlist1(jj)
             329     1   p                   nxj=nxdef_2d(j)
             330     1               !
             331     1               !  bottom boundary condition for temperature:
             332     1               !  limits for 1000 mb boundary condition are (1) standard lapse rate
             333     1               !  from bottom model level for terrain height and (2) layer mean temp
             334     1               !  of slp and 1000 mb.  Boundary condition is linear combination
             335     1               !  of these two cases weighted with subterrainean thickness.
             336     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, tmp
                                   <<< Loop-information  End >>>
             337     2   p                   do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, tmp
                                   <<< Loop-information  End >>>
             338     3   p   2v                do i = 1,nxj
             339     3   p   2v                  tmp(i,k,jj) = tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             340     3   p   2v                enddo
             341     2   p                   enddo
             342     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, slp, sgeo, plog, tmp, plt, bt1
                                   <<<      t1000
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             343     2   p    v              do i=1,nxj
             344     2   p    v                slp(i,jj) = max( slp(i,jj), pt(i,jj) )
             345     2   p    v                splog= log(slp(i,jj))
             346     2   p    v                dx= log(slp(i,jj)/(pt(i,jj)+ptop))
             347     2               !          bx= tmp(i,lev,jj)*(1.0/sig(lev+1))**0.19023 + sgeo(i,jj)*0.00065
             348     2   p    v                bx= tmp(i,lev,jj) + sgeo(i,jj)*0.00065
             349     3   p    v                if ( sgeo(i,jj) .ge. 1000.0 )  then
             350     3   p    v                  tmid = sgeo(i,jj)/(dx*rgas)
             351     3   p    v                  ax = tmp(i,lev,jj)+ (tmid-tmp(i,lev,jj))*(splog-plog(i,lev,jj)) &
             352     3                               / (log((slp(i,jj)+pt(i,jj)+ptop)*0.5)-plog(i,lev,jj))
             353     3   p    v                else
             354     3   p    v                  ax = bx
             355     3   p    v                endif
             356     2   p    v                cx = (sgeo(i,jj)-1000.0)/(10000.0-1000.0)
             357     2   p    v                cx = max (0.0, min (1.0, cx))
             358     2   p    v                dx = cx*cx
             359     2   p    v                tsf = dx*ax + (1.0-dx)*bx
             360     2   p    v                tadia= tmp(i,lev,jj)*(slp(i,jj)/plt(i,lev,jj))**0.25
             361     2   p    v                tsf  = max( tmp(i,lev,jj), min( tsf,tadia ) )
             362     3   p    v                if ( slp(i,jj) .gt. 1000.1 )  then
             363     3   p    v                  bt1(i,jj)= tsf
             364     3   p    v                  t1000(i,jj) = tsf
             365     3   p    v                else
             366     3   p    v                  bt1(i,jj)= tsf + (tsf-tmp(i,lev,jj))*(pl1000-splog)  &
             367     3                                    / (splog - plog(i,lev,jj))
             368     3   p    v                  t1000(i,jj) = bt1(i,jj)
             369     3   p    v                endif
             370     2   p    v              enddo
             371     1   p                 enddo
             372                     !
             373                     !!      call mpe_unify(bt1,nx,my,2,mpe_double)
             374                     !      if(myrank.eq.0) then
             375                     !        print*,'check bottom temperature'
             376                     !        call qmaxn3(bt1,cdum1,cdum2,1,1,1,nx,my,1)
             377                     !      endif
             378                     
             379                     !
             380                           if(myrank.eq.0)print*,' rsmout : start tempout'
             381                     ! yj replace tempout
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

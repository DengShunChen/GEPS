#!/bin/bash 
set -e

#MACHINE="a100"
MACHINE=${1:-"fx1000"}

. /usr/share/Modules/init/bash

# Loading fujitsu TCS library and cmake
module purge

# Loading gfs modules
module use modulefiles
module load modulefile.tcogfs.${MACHINE}
module unuse modulefiles

[[ -e build ]] && rm -rf build
if [[ ${MACHINE} == 'fx1000' ]] ; then
# Compilation
cmake -Bbuild -S. \
	-DCMAKE_BUILD_TYPE=Release \
	-DUSE_RSM=OFF
\time --verbose cmake --build build --verbose -j $((`nproc`/2))
elif [[ ${MACHINE} == 'a100' ]] ; then
# Compilation
cmake -Bbuild -S. \
  -DCMAKE_BUILD_TYPE=Release \
  -DUSE_RSM=OFF \
  -DUSE_CUDA=ON \
  -DUSE_ACC=ON
\time --verbose cmake --build build --verbose -j $((`nproc`/2))
else
  echo "[ERROR] Fatal error unknow MACHINE !" ; exit -1
fi




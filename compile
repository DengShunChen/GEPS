#!/bin/bash
set -e

#MACHINE="a100"
MACHINE=${1:-"fx1000"}

. /usr/share/Modules/init/bash

# Loading fujitsu TCS library and cmake
module purge

# Loading gfs modules
module use modulefiles
module load modulefile.tcogfs.${MACHINE}
module unuse modulefiles

BLD_DIR=build_${MACHINE}
[[ -e ${BLD_DIR} ]] && rm -rf ${BLD_DIR}
if [[ ${MACHINE} == 'fx1000' ]] ; then
# Compilation
cmake -B${BLD_DIR} -S. \
	-DCMAKE_BUILD_TYPE=Release \
	-DUSE_RSM=OFF
\time --verbose cmake --build ${BLD_DIR} --verbose -j $((`nproc`/2))
elif [[ ${MACHINE} == 'a100' ]] ; then
# Compilation
cmake -B${BLD_DIR} -S. \
  -DCMAKE_BUILD_TYPE=Release \
  -DUSE_RSM=OFF \
  -DUSE_CUDA=ON \
  -DUSE_ACC=ON \
  -DUSE_PAR=OFF
\time --verbose cmake --build ${BLD_DIR} --verbose -j $((`nproc`/2))
else
  echo "[ERROR] Fatal error unknow MACHINE !" ; exit -1
fi

 External subroutine subprogram "uzmean"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine uzmean (nx,my,my_max,lev,ut,uzm)
               2                     !
               3                     !  subroutine to compute mean zonal wind speed used in implicit
               4                     !  zonal advection of vorticity and moisture
               5                     !
               6                     !  *** input ***
               7                     !
               8                     !  nx: e-w (zonal) dimension
               9                     !  my: n-s dimension
              10                     !  lev: vertical dimension
              11                     !  ut: 3-dimensional u component array
              12                     !
              13                     !  *** output ***
              14                     !
              15                     !  uzm: zonal average wind for each latitude
              16                     !
              17                     !  ************************************
              18                     !
              19                           use index
              20                           use mpe
              21                     
              22                           implicit  none
              23                     
              24                           integer   nx,my,my_max,lev,jj,j,k,i,nxj,kk
              25                           real      umax,umin
              26                     
              27                     !     real      ut(nx,lev,my_max),uzm(my,lev)
              28                           real      ut(nxp,lev,my_max),uzm(my,lev),ut1(nx,levp,my_max)
              29                     
              30                           call mpe2d_transpose1_nxp_lev(ut,ut1,nx,nxp,lev,levp,my,my_max,jlistnum,jlen,nsizex,row_comm)
              31                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              32     1  pp                 do 10 jj =1, jlistnum
              33     1   p                 j=jlist1(jj)
              34     1   p                 nxj=nxdef(j)
              35     1               
              36     1               !     do 20 k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut1
                                   <<< Loop-information  End >>>
              37     2   p                 do 20 k=1,levp
              38     2   p                 umax= 1.0e-20
              39     2   p                 umin= 1.0e+20
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.93, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut1
                                   <<< Loop-information  End >>>
              40     3   p   4v            do 30 i=1,nxj
              41     3               !     umax= max(umax,ut(i,k,jj))
              42     3               !     umin= min(umin,ut(i,k,jj))
              43     3   p   4v            umax= max(umax,ut1(i,k,jj))
              44     3   p   4v            umin= min(umin,ut1(i,k,jj))
              45     3   p   4v         30 continue
              46     2               
              47     2               !     uzm(j,k)= 0.5*(umax+umin)
              48     2   p                 uzm(jj,k)= 0.5*(umax+umin)
              49     2               
              50     2   p              20 continue
              51     1   p              10 continue
              52                     
              53                     !     call mpe_unify(uzm,my,lev,1,mpe_double)
              54                     
              55                           call mpe2d_unify_uzmean(uzm,my,lev)
              56                     !
              57                           return
              58                           end


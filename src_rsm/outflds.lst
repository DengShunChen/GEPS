                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, pt, plt, sgeo, phi, hld1
                                   <<<      hld2, pdiff, pllp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 1  FILL 1
                                   <<< Loop-information  End >>>
             242     2   p    v              do i=1,nxj
             243     2   p    v                ttb  = tt(i,lev,jj)*pk(i,lev,jj)/(1.0+0.608*qt(i,lev,jj))
             244     2   p    v                ttp  = tt(i,llts,jj)*pk(i,llts,jj)/(1.0+0.608*qt(i,llts,jj))
             245     2   p    v                ttt1 = ttb + alaps*rdg*ttb*   &
             246     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             247     2   p    v                ttt2 = ttp + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             248     2   p    v                hld1(i,jj) = 0.25*ttt1 + 0.75*ttt2
             249     2   p    v                hld2(i,jj) = hld1(i,jj) + alaps*sgeo(i,jj)/grav
             250     3   p    v                if( sgeo(i,jj) .lt. 0.1 ) then
             251     3   p    v                  anlslp = pt(i,jj) + ptop
             252     3   p    v                else if( hld1(i,jj) .le. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             253     3   p    v                  apha = rgas*(290.5-hld1(i,jj))/sgeo(i,jj)
             254     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             255     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             256     3                                    apha*ttt*apha*ttt) )
             257     3   p    v                else if( hld1(i,jj) .gt. 290.5 .and. hld2(i,jj) .gt. 290.5 ) then
             258     3   p    v                  hld1(i,jj) = (hld1(i,jj)+290.5)*0.5
             259     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             260     3   p    v                else if( hld1(i,jj) .lt. 255.0 .and. hld2(i,jj) .lt. 255.0 ) then
             261     3   p    v                  hld1(i,jj) = (hld1(i,jj)+255.0)*0.5
             262     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,jj)) )
             263     3   p    v                else
             264     3   p    v                  apha = alaps * rdg
             265     3   p    v                  ttt = sgeo(i,jj)/(rgas*hld1(i,jj))
             266     3   p    v                  anlslp = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333*  &
             267     3                                    apha*ttt*apha*ttt) )
             268     3   p    v                endif
             269     2   p    v                pllp(i,jj) = anlslp - pt(i,jj)
             270     2   p    v                pdiff(i,jj)=pllp(i,jj)
             271     2   p    v              enddo
             272     1   p                 enddo
             273                     !
             274                     !      else
             275                     !
             276                     !  pllp equal to pdiff at the initial time, tau=0

             169     5   p   2v                      ngq = ngq + 1
             170     5   p   2v                      qt(i,kk,jj) = 0.0
             171     5   p   2v                    endif
             172     4   p   2v                  enddo
             173     3   p                     enddo
             174     2               !         ntt = ntt + nxj*lev
             175     2                         ntt = ntt + nxjp(j)*lev
             176     2                       enddo
             177     1                       call mpe_global_sum(ngq,1,mpe_integer)
             178     1                       call mpe_global_sum(ntt,1,mpe_integer)
             179     1                       if( n.eq.1 .and. myrank.eq.0 .and. ngq.ne.0 )  print 901, ngq
             180     1                       if( n.eq.2 .and. myrank.eq.0 .and. ngq.ne.0 )  print 902, ntt-ngq
             181     1                     enddo
             182                     

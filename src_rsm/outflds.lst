             225     3   p    v                enddo
             226     2   p                   enddo
             227     1   p                 enddo
             228                     !
             229                     !  compute sea level pressure and update pdiff
             230                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             231                     !
             232                     !  llts layer's temperature is used to derive an alternative

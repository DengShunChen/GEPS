             206                     !
             207                     !  hydrostatic equation
             208                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk2, pk, sgeo, phi
                                   <<< Loop-information  End >>>
             209     1  pp                 do jj =1,jlistnum
             210     1   p                   j=jlist1(jj)
             211     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, sgeo, tt, phi
                                   <<< Loop-information  End >>>
             212     2   p   2v              do i=1,nxj
             213     2   p   2v                phi(i,lev,jj)= cp*tt(i,lev,jj)*(pk2(i,lev,jj)-pk(i,lev,jj)) &
             214     2                                      + sgeo(i,jj)
             215     2   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, tt, phi
                                   <<< Loop-information  End >>>
             216     2   p                   do k=lev-1,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, phi, pk2
                                   <<< Loop-information  End >>>
             217     3   p    v                do i=1,nxj
             218     3   p    v                  phi(i,k,jj)= phi(i,k+1,jj)+cp*(tt(i,k,jj)*(pk2(i,k,jj)-pk(i,k,jj)) &
             219     3                                      + tt(i,k+1,jj)*(pk(i,k+1,jj)-pk2(i,k,jj)))
             220     3   p    v                enddo
             221     2   p                   enddo
                                   <<< Loop-information Start >>>

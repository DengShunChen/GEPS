             135                     !
             136                           if(myrank .eq. 0) print*,'   in outflds for tau= ',itau
             137                     !
             138                           call whttau (itau,numout,outdir,ntau,taudir)
             139                           if(ntau.eq.0) return
             140                     !
             141                     !  save qt into local arrays
             142                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             143     1  pp                 do jj = 1, jlistnum
             144     1   p                   j=jlist1(jj)
             145     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt, sht
                                   <<< Loop-information  End >>>
             146     2   p                   do k = 1, lev*ncld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

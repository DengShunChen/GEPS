             157     1                     endif
             158     1                     do n=1,ntrac
             159     1                       nk=(n-1)*lev
             160     1                       ngq = 0
             161     1                       ntt = 0
             162     2                       do jj =1,jlistnum
             163     2                         j=jlist1(jj)
             164     2                         nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt
                                   <<< Loop-information  End >>>
             165     3  pp                     do k = 1, lev

                                   <<< Loop-information  End >>>
             357     3   p    v              do i=1,nxj
             358     3   p    v                slp(i,jj) = max( slp(i,jj), pt(i,jj) )
             359     3   p    v                splog= log(slp(i,jj))
             360     3   p    v                dx= log(slp(i,jj)/(pt(i,jj)+ptop))
             361     3               !          bx= tmp(i,lev,jj)*(1.0/sig(lev+1))**0.19023 + sgeo(i,jj)*0.00065
             362     3   p    v                bx= tmp(i,lev,jj) + sgeo(i,jj)*0.00065
             363     4   p    v                if ( sgeo(i,jj) .ge. 1000.0 )  then
             364     4   p    v                  tmid = sgeo(i,jj)/(dx*rgas)
             365     4   p    v                  ax = tmp(i,lev,jj)+ (tmid-tmp(i,lev,jj))*(splog-plog(i,lev,jj)) &
             366     4                               / (log((slp(i,jj)+pt(i,jj)+ptop)*0.5)-plog(i,lev,jj))
             367     4   p    v                else
             368     4   p    v                  ax = bx
             369     4   p    v                endif
             370     3   p    v                cx = (sgeo(i,jj)-1000.0)/(10000.0-1000.0)
             371     3   p    v                cx = max (0.0, min (1.0, cx))
             372     3   p    v                dx = cx*cx
             373     3   p    v                tsf = dx*ax + (1.0-dx)*bx
             374     3   p    v                tadia= tmp(i,lev,jj)*(slp(i,jj)/plt(i,lev,jj))**0.25
             375     3   p    v                tsf  = max( tmp(i,lev,jj), min( tsf,tadia ) )
             376     4   p    v                if ( slp(i,jj) .gt. 1000.1 )  then
             377     4   p    v                  bt1(i,jj)= tsf
             378     4   p    v                  t1000(i,jj) = tsf
             379     4   p    v                else
             380     4   p    v                  bt1(i,jj)= tsf + (tsf-tmp(i,lev,jj))*(pl1000-splog)  &
             381     4                                    / (splog - plog(i,lev,jj))
             382     4   p    v                  t1000(i,jj) = bt1(i,jj)
             383     4   p    v                endif

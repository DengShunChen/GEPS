             186                                  , " with qc > 0. , total number = ",i8,// )
             187                     !
             188                     !                 compute interpolation coeffs
             189                     !
             190                           ograv= 1.0/grav
             191                     !
             192                     !  generate structure variables
             193                     !
             194                     !  first, the log(p) quantities
             195                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             196     1   s   fv            do k=1,lpout

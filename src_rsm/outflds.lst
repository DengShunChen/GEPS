             341     2  pp                 do jj =1,jlistnum
             342     2   p                   j=jlist1(jj)
             343     2   p                   nxj=nxdef_2d(j)
             344     2               !
             345     2               !  bottom boundary condition for temperature:
             346     2               !  limits for 1000 mb boundary condition are (1) standard lapse rate
             347     2               !  from bottom model level for terrain height and (2) layer mean temp
             348     2               !  of slp and 1000 mb.  Boundary condition is linear combination
             349     2               !  of these two cases weighted with subterrainean thickness.
             350     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, tmp

             351     3   p                   do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.51, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, tmp
                                   <<< Loop-information  End >>>
             352     4   p   2v                do i = 1,nxj
             353     4   p   2v                  tmp(i,k,jj) = tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             354     4   p   2v                enddo
             355     3   p                   enddo
             356     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]

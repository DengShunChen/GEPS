                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      work, stable
                                   <<< Loop-information  End >>>
              31     2  pp    v            do 220 i = 1, im
              32     2   p    v            work(i,l) = b(l)
              33     2   p    v            if ( stable(i,l) ) work(i,l) = big
              34     2   p    v            work(i,l) = 1.0 / (work(i,l) - work(i,nd-1))

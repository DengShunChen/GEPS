                                   <<< Loop-information  End >>>
              43     1  pp    v            do 400 i = 1, im
              44     1   p    v            y(i,lm) = y(i,lm) - y(i,lmm1)
              45     1   p    v            work(i,1) = b(lm)
              46     1   p    v            if( stable(i,lm) )  work(i,1) = big
              47     1   p    v            y(i,lm) = y(i,lm) / (work(i,1) - work(i,nd))
              48     1   p    v        400 continue
              49                     !

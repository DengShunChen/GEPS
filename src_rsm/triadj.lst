               1                           subroutine triadj ( y,b,c,im,lm,lm2,work,stable )
               2                     !
               3                     !     tri-diagonal gaussian elimination for dryadj subroutine
               4                     !
               5                           implicit  none
               6                     
               7                           integer   im,lm,lm2,lmm1,i,l,k,nd
               8                     
               9                           real      b(lm),c(lm),y(im,lm),work(im,lm2),big,eps
              10                     
              11                           logical   stable(im,lm)
              12                     
              13                           data eps/-1.0e-20/, big/ -1.0e+20/
              14                     !
              15                           lmm1 = lm-1
              16                     !
              17                     !   to ensure no adjustment for stable layers, put zero forcing
              18                     !   and large diagonal values for those layers
              19                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      work, y, stable
                                   <<< Loop-information  End >>>
              20     1  pp    v            do 100 i = 1, im
              21     1   p    v            work(i,1)= 1.0 / b(1)
              22     1   p    v            if( stable(i,1) ) work(i,1) = eps
              23     1   p    v            work(i,lm) = c(1) * work(i,1)
              24     1   p    v            y(i,1) = y(i,1) * work(i,1)
              25     1   p    v        100 continue
              26                     !
              27                     !     gaussian elimination
              28                     !
                                   <<< Loop-information Start >>>

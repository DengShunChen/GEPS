                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipt, rimin, bruni, pint, riloc, basicui
                                   <<<      ti, rhoi, taugwci
                                   <<< Loop-information  End >>>
             386     1  pp                 do k=1,km+1
             387     1               !byl        k1 = km - k + 2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 40, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rimin, riloc, basicui, ti, rhoi, bruni

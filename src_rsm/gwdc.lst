             882     3               !-----------------------------------------------------------------------
             883     3               
             884     3               !-----------------------------------------------------------------------
             885     3               !
             886     3               !  calculate gravity wave stress profile using the wave saturation
             887     3               !  hypothesis of lindzen (1981).
             888     3               !
             889     3               !  assuming kcldtop(i)=10 and kcldbot=16,
             890     3               !
             891     3               !                             taugwci  riloc  rimin   utgwc
             892     3               !
             893     3               !  interface 1 ========       - 0.001         -1.e20
             894     3               !            1 --------                               0.000
             895     3               !            2 ========       - 0.001         -1.e20
             896     3               !            2 --------                               0.000
             897     3               !            3 ========       - 0.001         -1.e20
             898     3               !            3 --------                               -.xxx
             899     3               !            4 ========       - 0.001  2.600  2.000
             900     3               !            4 --------                               0.000
             901     3               !            5 ========       - 0.001  2.500  2.000
             902     3               !            5 --------                               0.000
             903     3               !            6 ========       - 0.001  1.500  0.110
             904     3               !            6 --------                               +.xxx
             905     3               !            7 ========       - 0.005  2.000  3.000
             906     3               !            7 --------                               0.000
             907     3               !            8 ========       - 0.005  1.000  0.222
             908     3               !            8 --------                               +.xxx
             909     3               !            9 ========       - 0.010  1.000  2.000
             910     3               !            9 --------                               0.000
             911     3               ! kcldtopi  10 ========  $$$  - 0.010
             912     3               ! kcldtop   10 --------  $$$                          yyyyy
             913     3               !           11 ========  $$$  0
             914     3               !           11 --------  $$$
             915     3               !           12 ========  $$$  0
             916     3               !           12 --------  $$$
             917     3               !           13 ========  $$$  0
             918     3               !           13 --------  $$$
             919     3               !           14 ========  $$$  0
             920     3               !           14 --------  $$$
             921     3               !           15 ========  $$$  0
             922     3               !           15 --------  $$$
             923     3               !           16 ========  $$$  0
             924     3               ! kcldbot   16 --------  $$$
             925     3               !           17 ========       0
             926     3               !           17 --------
             927     3               !           18 ========       0
             928     3               !           18 --------
             929     3               !           19 ========       0
             930     3               !
             931     3               !-----------------------------------------------------------------------
             932     3               !
             933     3               !   even though the cloud top level obtained in deep convective para-
             934     3               !   meterization is defined in mid-level, the cloud top level for
             935     3               !   the gwdc calculation is assumed to be the interface level just
             936     3               !   above the mid-level cloud top vertical level index.
             937     3               !
             938     3               !-----------------------------------------------------------------------
             939     3               
             940     4   p    v                  if (k < kk .and. k > 1) then
             941     5   p    v                    if ( abs(taugwci(i,k+1)) > taumin ) then                  ! taugwci
             942     6   p    v                      if ( riloc(i,k) > ricrit ) then                         ! riloc
             943     7   p    v                        if ( rimin(i,k) > ricrit ) then                       ! rimin
             944     7   p    v                          taugwci(i,k) = taugwci(i,k+1)
             945     7   p    v                        elseif (rimin(i,k) > riminp) then
             946     7   p    v                          tem = 2.0 + 1.0 / sqrt(riloc(i,k))
             947     7   p    v                          nonlins = (1.0/abs(c2)) * (2.*sqrt(tem) - tem)
             948     7   p    v                          tem1 = basicui(i,k)
             949     7   p    v                          tem2 = c2*nonlins*tem1
             950     7   p    v                          taugwci(i,k) = - rhoi(i,k) * c1 * tem1 * tem2 * tem2   &
             951     7                                               /  (bruni(i,k)*dlen(i))
             952     7   p    v                        elseif (rimin(i,k) > riminm) then
             953     7   p    v                          taugwci(i,k) = zero
             954     7   p    v                        end if                                              ! rimin
             955     6   p    v                      else
             956     6               
             957     6               !!!!!!!!!! in the dynamically unstable environment, there is no gravity wave stress
             958     6               
             959     6   p    v                        taugwci(i,k) = zero
             960     6   p    v                      end if                                                ! riloc
             961     5   p    v                    else

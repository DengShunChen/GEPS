             556                     !         do ilev=1,km
             557                     !           print*,'ti bruni = ',ti(iii,kkk),bruni(iii,kkk)
             558                     !           print*,'u v t brunm =',u(iii,kkk),v(iii,kkk),t(iii,kkk),brunm(iii,kkk)
             559                     !           write(*,9112) ilev,ti(ipr,ilev),(100.*bruni(ipr,ilev))
             560                     !           write(*,9122) ilev,u(ipr,ilev),v(ipr,ilev),     &
             561                     !                         t(ipr,ilev),(100.*brunm(ipr,ilev))
             562                     !         enddo
             563                     !         ilev=km+1
             564                     !          print*,'k ti bruni =',ilev,ti(ipr,ilev),bruni(ipr,ilev)
             565                     !         write(*,9112) ilev,ti(ipr,ilev),(100.*bruni(ipr,ilev))

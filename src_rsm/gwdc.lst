             574                     !9111 format(i4,1x,f8.2,9x,f8.2,9x,f8.2)
             575                     !9121 format(i4,9x,f8.2,9x,f8.2,1x,f8.2)
             576                     !9102 format(//' ilev',5x,'u',7x,'v',5x,'ti',7x,'t',    &
             577                     !      5x,'bruni',3x,'brunm',//)
             578                     !9112 format(i4,16x,f8.2,8x,f8.3)
             579                     !9122 format(i4,2f8.2,8x,f8.2,8x,f8.3)
             580                     

             582                     !***********************************************************************
             583                     !
             584                     !        big loop over grid points                    only done if kcnv=1
             585                     !
             586                     !***********************************************************************
             587                     
             588                           kcldm = 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 272
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             589     1  pp    v            do i = 1, npt
             590     1   p    v              kk        = kcldtop(i)
             591     1   p    v              kb        = kcldbot(i)
             592     1   p    v              kcldm     = max(kcldm,kk)
             593     1               
             594     1               !-----------------------------------------------------------------------
             595     1               !
             596     1               !  determine cloud top wind component, direction, and speed.
             597     1               !  here, ucltop, vcltop, and windcltop are wind components and
             598     1               !  wind speed at mid-level cloud top index
             599     1               !
             600     1               !-----------------------------------------------------------------------
             601     1               
             602     1   p    v              ucltop(i) = u(i,kk)
             603     1   p    v              vcltop(i) = v(i,kk)
             604     1               !       windcltop = sqrt( ucltop(i)*ucltop(i) + vcltop(i)*vcltop(i) )
             605     1               !lzl tmp        windcltop = 1.0 / sqrt( ucltop(i)*ucltop(i)                    &
             606     1               !lzl tmp                             + vcltop(i)*vcltop(i) )
             607     1               !
             608     1               !lzl tmp        cosphi(i) = ucltop(i)*windcltop
             609     1               !lzl tmp        sinphi(i) = vcltop(i)*windcltop
             610     1               !
             611     1               !lzl tmp 2        windcltop(i) = 1.0 / sqrt( ucltop(i)*ucltop(i)                 &
             612     1               !lzl tmp 2                             + vcltop(i)*vcltop(i) )
             613     1               !
             614     1   p    v              windcltop(i) = 1.0 / sqrt( ucltop(i)*ucltop(i) + vcltop(i)*vcltop(i) )
             615     1               
             616     1   p    v              cosphi(i) = ucltop(i)*windcltop(i)
             617     1   p    v              sinphi(i) = vcltop(i)*windcltop(i)
             618     1               
             619     1               !       angle(i)  = acos(cosphi)*180./pi
             620     1               !
             621     1   p    v            enddo
             622                     !
             623                     !-----------------------------------------------------------------------
             624                     !
             625                     !  calculate basic state wind projected in the direction of the cloud
             626                     !  top wind.
             627                     !  input u(i,k) and v(i,k) is defined at mid level
             628                     !
             629                     !-----------------------------------------------------------------------
             630                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cosphi, u, v, sinphi, basicum
                                   <<< Loop-information  End >>>
             631     1  pp                 do k=1,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.57, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      v, sinphi, cosphi, u, basicum
                                   <<< Loop-information  End >>>
             632     2   p   2v              do i=1,npt
             633     2   p   2v                basicum(i,k) = u(i,k)*cosphi(i) + v(i,k)*sinphi(i)
             634     2   p   2v              enddo
             635     1   p                 enddo
             636                     
             637                     !-----------------------------------------------------------------------
             638                     !
             639                     !  basic state wind at interface level is also calculated
             640                     !  based on linear interpolation in ln(pressure)
             641                     !
             642                     !  in the top and bottom boundaries, basic-state wind at interface level
             643                     !  is assumed to be vertically uniform.
             644                     !
             645                     !-----------------------------------------------------------------------
             646                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      basicum, basicui
                                   <<< Loop-information  End >>>
             647     1  pp   2v            do i=1,npt
             648     1   p   2v              basicui(i,1)    = basicum(i,1)
             649     1   p   2v              basicui(i,km+1) = basicum(i,km)
             650     1   p   2v            enddo
             651                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2

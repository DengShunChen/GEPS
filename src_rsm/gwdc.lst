                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipt, kcldbot, dlen, kcldtop, gqmcldlen
                                   <<< Loop-information  End >>>
             406     1  pp    v            do i = 1, npt
             407     1   p    v              ii = ipt(i)

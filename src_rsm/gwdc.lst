             963     5   p    v                    end if                                                  ! taugwci
             964     4               
             965     5   p    v                    if ( (basicum(i,k+1)*basicum(i,k) ) < 0. ) then
             966     5   p    v                       taugwci(i,k+1) = zero
             967     5   p    v                       taugwci(i,k)   = zero
             968     5   p    v                    endif
             969     4               
             970     5   p    v                    if (abs(taugwci(i,k)) > abs(taugwci(i,k+1))) then
             971     5   p    v                      taugwci(i,k) = taugwci(i,k+1)
             972     5   p    v                    end if

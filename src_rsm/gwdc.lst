             546                     !         enddo
             547                     !         ilev=km+1
             548                     !         write(*,9111) ilev,(0.01*pint(ipr,ilev)),          &
             549                     !                            (0.01*dpint(ipr,ilev)),plnint(ipr,ilev)
             550                     

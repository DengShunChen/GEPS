                                   <<< Loop-information  End >>>
             400     1  pp                 do k=2,km+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.89, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pint, plnint
                                   <<< Loop-information  End >>>
             401     2   p    v              do i=1,npt
             402     2   p    v                plnint(i,k)   = log(pint(i,k))
             403     2   p    v              enddo

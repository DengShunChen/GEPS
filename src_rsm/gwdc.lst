 External subroutine subprogram "gwdc"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gwdc(im,ix,iy,km,u1,v1,t1,q1,           &
               2                                           pmid1,pint1,dpmid1,                &
               3                                           ktop,kbot,kcnv,cldf,qmax,          &
               4                                           grav,cp,rd,fv,deltim,dlength,             &
               5                                           utgwc,vtgwc,tauctx,taucty,j)
               6                     !***********************************************************************
               7                     !        original code for parameterization of convectively forced
               8                     !        gravity wave drag from yonsei university, korea
               9                     !        based on the theory given by chun and baik (jas, 1998)
              10                     !        modified for implementation into the gfs/cfs by
              11                     !        ake johansson  --- aug 2005
              12                     !***********************************************************************
              13                     !lzl +add === #
              14                           use rank
              15                           use index
              16                           use const, only: RTYPE
              17                     !lzl -end === #
              18                     
              19                     !lzl      use machine , only : kind_phys
              20                           implicit none
              21                     
              22                     !---------------------------- arguments --------------------------------
              23                     !
              24                     !  input variables
              25                     !
              26                     !  u        : midpoint zonal wind
              27                     !  v        : midpoint meridional wind
              28                     !  t        : midpoint temperatures
              29                     !  pmid     : midpoint pressures
              30                     !  pint     : interface pressures
              31                     !  dpmid    : midpoint delta p ( pi(k)-pi(k-1) )
              32                     !  lat      : latitude index
              33                     !  qmax     : deep convective heating
              34                     !  kcldtop  : vertical level index for cloud top    ( mid level )
              35                     !  kcldbot  : vertical level index for cloud bottom ( mid level )
              36                     !  kcnv     : (0,1) dependent on whether convection occur or not
              37                     !
              38                     !  output variables
              39                     !
              40                     !  utgwc    : zonal wind tendency
              41                     !  vtgwc    : meridional wind tendency
              42                     !
              43                     !-----------------------------------------------------------------------
              44                     
              45                           integer im, ix, iy, km, lat, ipr,j,iii,kkk,iinpt
              46                           integer ktop(im),kbot(im),kcnv(im)
              47                     
              48                     !lzl      real(kind=kind_phys) grav,cp,rd,fv,fhour,fhourpr
              49                     !lzl      real(kind=kind_phys), dimension(ix)      :: qmax
              50                     !lzl     &,                                           tauctx, taucty
              51                     !lzl      real(kind=kind_phys), dimension(im)      :: cldf,dlength
              52                     !lzl      real(kind=kind_phys), dimension(ix,km)   :: u1,v1,t1,q1,
              53                     !lzl     &                                            pmid1,dpmid1
              54                     !lzl!    &,                                           cumchr1
              55                     !lzl      real(kind=kind_phys), dimension(iy,km)   :: utgwc,vtgwc
              56                     !lzl      real(kind=kind_phys), dimension(ix,km+1) :: pint1
              57                     !lzl
              58                     !lzl      logical lprnt
              59                     !
              60                     !lzl add ---- ##
              61                           real  grav,cp,rd,fv,fhour,fhourpr,deltim
              62                           real, dimension(im)      :: qmax,tauctx, taucty
              63                           real, dimension(im)      :: cldf,dlength
              64                           real, dimension(ix,km)   :: u1,v1,t1,pmid1,dpmid1
              65                     !    &,                                           cumchr1
              66                           real, dimension(iy,km)   :: utgwc,vtgwc
              67                           real, dimension(ix,km+1) :: pint1
              68                           real(kind=RTYPE), dimension(ix,km) :: q1
              69                     
              70                           logical lprnt
              71                     !
              72                     !------------------------- local workspace -----------------------------
              73                     !
              74                     !  i, k     : loop index
              75                     !  kk       : loop index
              76                     !  cldf     : deep convective cloud fraction at the cloud top.
              77                     !  ugwdc    : zonal wind after gwdc paramterization
              78                     !  vgwdc    : meridional wind after gwdc parameterization
              79                     !  plnmid   : log(pmid) ( mid level )
              80                     !  plnint   : log(pint) ( interface level )
              81                     !  dpint    : delta pmid ( interface level )
              82                     !  tauct    : wave stress at the cloud top calculated using basic-wind
              83                     !             parallel to the wind vector at the cloud top ( mid level )
              84                     !  tauctx   : wave stress at the cloud top projected in the east
              85                     !  taucty   : wave stress at the cloud top projected in the north
              86                     !  qmax     : maximum deep convective heating rate ( k s-1 ) in a
              87                     !             horizontal grid point calculated from cumulus para-
              88                     !             meterization. ( mid level )
              89                     !  wtgwc    : wind tendency in direction to the wind vector at the cloud top level
              90                     !             due to convectively generated gravity waves ( mid level )
              91                     !  utgwcl   : zonal wind tendency due to convectively generated
              92                     !             gravity waves ( mid level )
              93                     !  vtgwcl   : meridional wind tendency due to convectively generated
              94                     !             gravity waves ( mid level )
              95                     !  taugwci  : profile of wave stress calculated using basic-wind
              96                     !             parallel to the wind vector at the cloud top
              97                     !  taugwcxi : profile of zonal component of gravity wave stress
              98                     !  taugwcyi : profile of meridional component of gravity wave stress
              99                     !
             100                     !  taugwci, taugwcxi, and taugwcyi are defined at the interface level
             101                     !
             102                     !  bruni    : brunt-vaisala frequency ( interface level )
             103                     !  brunm    : brunt-vaisala frequency ( mid level )
             104                     !  rhoi     : air density ( interface level )
             105                     !  rhom     : air density ( mid level )
             106                     !  ti       : temperature ( interface level )
             107                     !  basicum  : basic-wind profile. basic-wind is parallel to the wind
             108                     !             vector at the cloud top level. (mid level)
             109                     !  basicui  : basic-wind profile. basic-wind is parallel to the wind
             110                     !             vector at the cloud top level. ( interface level )
             111                     !  riloc    : local richardson number ( interface level )
             112                     !  rimin    : minimum richardson number including both the basic-state
             113                     !             and gravity wave effects ( interface level )
             114                     !  gwdcloc  : horizontal location where the gwdc scheme is activated.
             115                     !  break    : horizontal location where wave breaking is occurred.
             116                     !  critic   : horizontal location where critical level filtering is
             117                     !             occurred.
             118                     !  dogwdc   : logical flag whether the gwdc parameterization is
             119                     !             calculated at a grid point or not.
             120                     !
             121                     !  dogwdc is used in order to lessen cpu time for gwdc calculation.
             122                     !
             123                     !-----------------------------------------------------------------------
             124                     
             125                           integer i,ii,k,kk,kb,ilev,npt,kcb,kcldm,npr
             126                           integer, dimension(im) :: ipt
             127                     
             128                     !lzl      real(kind=kind_phys) tem, tem1,  tem2, qtem, wtgwc, tauct,
             129                     !lzl     &                     windcltop,  shear, nonlinct, nonlin, nonlins,
             130                     !lzl     &                     n2,   dtdp,  crit1, crit2, pi, p1, p2,
             131                     !lzl     &                     gsqr,  onebg
             132                     !lzl!    &                     taus, n2,   dtdp,  crit1, crit2, pi, p1, p2
             133                     
             134                     !lzl +add -------- ##
             135                           real tem, tem1,  tem2, qtem, wtgwc, tauct,                    &
             136                     !lzl c           windcltop,  shear, nonlinct, nonlin, nonlins,            &
             137                                shear, nonlinct, nonlin, nonlins,                        &
             138                                n2,   dtdp,  crit1, crit2, pi, p1, p2,                   &
             139                                gsqr,  onebg
             140                     !lzl -end -------- ##
             141                           integer,              allocatable :: kcldtop(:),kcldbot(:)
             142                           logical,              allocatable :: do_gwc(:)
             143                     !lzl      real(kind=kind_phys), allocatable :: tauctxl(:), tauctyl(:),
             144                     !lzl     &                                     gwdcloc(:), break(:),
             145                     !lzl     &                                     critic(:),
             146                     !lzl!    &                                     critic(:),  angle(:),
             147                     !lzl     &                                     cosphi(:),  sinphi(:),
             148                     !lzl     &                                     xstress(:), ystress(:),
             149                     !lzl     &                                     ucltop(:),  vcltop(:),
             150                     !lzl     &                                     wrk(:),
             151                     !lzl     &                                     dlen(:),       gqmcldlen(:)
             152                     !lzl!     real(kind=kind_phys), allocatable :: plnint(:,:),   dpint(:,:),
             153                     !lzl!    &                                     taugwci(:,:),  taugwcxi(:,:),
             154                     !lzl!    &                                     taugwcyi(:,:), bruni(:,:),
             155                     !lzl!    &                                     taugwcyi(:,:), bruni(:,:),
             156                     !lzl      real(kind=kind_phys), allocatable :: plnint(:,:),
             157                     !lzl     &                                     taugwci(:,:),  bruni(:,:),
             158                     !lzl     &                                     rhoi(:,:),     basicui(:,:),
             159                     !lzl     &                                     ti(:,:),       riloc(:,:),
             160                     !lzl     &                                     rimin(:,:),    pint(:,:)
             161                     !lzl!     real(kind=kind_phys), allocatable :: ugwdc(:,:),    vgwdc(:,:),
             162                     !lzl      real(kind=kind_phys), allocatable ::
             163                     !lzl!    &                                     plnmid(:,:),   wtgwc(:,:),
             164                     !lzl     &                                     plnmid(:,:),
             165                     !lzl     &                                     utgwcl(:,:),   vtgwcl(:,:),
             166                     !lzl     &                                     basicum(:,:),  u(:,:),v(:,:),
             167                     !lzl     &                                     t(:,:),        spfh(:,:),
             168                     !lzl     &                                     pmid(:,:),     dpmid(:,:),
             169                     !lzl!    &                                     pmid(:,:),     cumchr(:,:),
             170                     !lzl     &                                     brunm(:,:),    rhom(:,:)
             171                     !lzl!
             172                     !lzl +add -------- ##
             173                           real, allocatable :: tauctxl(:), tauctyl(:),                     &
             174                                  gwdcloc(:), break(:),                                     &
             175                                  critic(:),                                                &
             176                     !    &                                     critic(:),  angle(:),
             177                                  cosphi(:),  sinphi(:),                                    &
             178                                  xstress(:), ystress(:),                                   &
             179                                  ucltop(:),  vcltop(:),                                    &
             180                                  windcltop(:),tmpwindcltop(:),                             &
             181                                  wrk(:),     dtfac(:),                                     &
             182                                  dlen(:),       gqmcldlen(:)
             183                     !     real(kind=kind_phys), allocatable :: plnint(:,:),   dpint(:,:),
             184                     !    &                                     taugwci(:,:),  taugwcxi(:,:),
             185                     !    &                                     taugwcyi(:,:), bruni(:,:),
             186                     !    &                                     taugwcyi(:,:), bruni(:,:),
             187                           real, allocatable :: plnint(:,:), velco(:,:),                    &
             188                                 taugwci(:,:),  bruni(:,:),                                 &
             189                                 rhoi(:,:),     basicui(:,:),                               &
             190                                 ti(:,:),       riloc(:,:),                                 &
             191                                 rimin(:,:),    pint(:,:)
             192                     !     real(kind=kind_phys), allocatable :: ugwdc(:,:),    vgwdc(:,:),
             193                           real, allocatable ::                                             &
             194                     !    &                                     plnmid(:,:),   wtgwc(:,:),
             195                                 plnmid(:,:),   taugw(:,:),                                 &
             196                                 utgwcl(:,:),   vtgwcl(:,:),                                &
             197                                 basicum(:,:),  u(:,:),v(:,:),                              &
             198                                 t(:,:),        spfh(:,:),                                  &
             199                                 pmid(:,:),     dpmid(:,:),                                 &
             200                     !    &                                     pmid(:,:),     cumchr(:,:),
             201                                 brunm(:,:),    rhom(:,:)
             202                     
             203                     !lzl -end -------- ##
             204                     !-----------------------------------------------------------------------
             205                     !
             206                     !  ucltop    : zonal wind at the cloud top ( mid level )
             207                     !  vcltop    : meridional wind at the cloud top ( mid level )
             208                     !  windcltop : wind speed at the cloud top ( mid level )
             209                     !  shear     : vertical shear of basic wind
             210                     !  cosphi    : cosine of angle of wind vector at the cloud top
             211                     !  sinphi    : sine   of angle of wind vector at the cloud top
             212                     !  c1        : tunable parameter
             213                     !  c2        : tunable parameter
             214                     !  dlength   : grid spacing in the direction of basic wind at the cloud top
             215                     !  nonlinct  : nonlinear parameter at the cloud top
             216                     !  nonlin    : nonlinear parameter above the cloud top
             217                     !  nonlins   : saturation nonlinear parameter
             218                     !  taus      : saturation gravity wave drag == taugwci(i,k)
             219                     !  n2        : square of brunt-vaisala frequency
             220                     !  dtdp      : dt/dp
             221                     !  xstress   : vertically integrated zonal momentum change due to gwdc
             222                     !  ystress   : vertically integrated meridional momentum change due to gwdc
             223                     !  crit1     : variable 1 for checking critical level
             224                     !  crit2     : variable 2 for checking critical level
             225                     !
             226                     !-----------------------------------------------------------------------
             227                     
             228                     !lzl      real(kind=kind_phys), parameter ::
             229                     !lzl     &                      c1=1.41,          c2=-0.38,     ricrit=0.25
             230                     !lzl     &,                     n2min=1.e-32,     zero=0.0,     one=1.0
             231                     !lzl     &,                     taumin=1.0e-20,   tauctmax=-5.
             232                     !lzl     &,                     qmin=1.0e-10,     shmin=1.0e-20
             233                     !lzl     &,                     rimax=1.0e+20,    rimaxm=0.99e+20
             234                     !lzl     &,                     rimaxp=1.01e+20,  rilarge=0.9e+20
             235                     !lzl     &,                     riminx=-1.0e+20,  riminm=-1.01e+20
             236                     !lzl     &,                     riminp=-0.99e+20, rismall=-0.9e+20
             237                     !
             238                     !lzl +add -------- ##
             239                           real, parameter ::                                     &
             240                                c1=1.41,          c2=-0.38,     ricrit=0.25,      &
             241                                n2min=1.e-32,     zero=0.0,     one=1.0,          &
             242                     !           taumin=1.0e-20,   tauctmax=-5.,                   &
             243                                taumin=1.0e-20,   tauctmax=-20.,                   &
             244                                qmin=1.0e-10,     shmin=1.0e-20,                  &
             245                                rimax=1.0e+20,    rimaxm=0.99e+20,                &
             246                                rimaxp=1.01e+20,  rilarge=0.9e+20,                &
             247                                riminx=-1.0e+20,  riminm=-1.01e+20,               &
             248                               riminp=-0.99e+20, rismall=-0.9e+20
             249                     !
             250                            iii= 1132
             251                            kkk= 24
             252                     !
             253                     !       if(myrank.eq.0) print*,'inside gwdc '
             254                     
             255                           npt = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipt, kcnv
                                   <<< Loop-information  End >>>
             256     1       2s            do i = 1,im
             257     1       2s              ipt(i) = 0
             258     2       2v              if (kcnv(i) /= 0 .and. qmax(i) > zero) then
             259     2       2m                npt      = npt + 1
             260     2       2s                 ipt(npt) = i
             261     2               !              if(i.eq.iii)then
             262     2               !                print*,' npt = ',npt
             263     2               !                iinpt = npt
             264     2               !              endif
             265     2       2v              endif
             266     1       2v            enddo
             267                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             268     1  pp                 do k=1,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vtgwc, utgwc
                                   <<< Loop-information  End >>>
             269     2   p   2v              do i=1,im
             270     2   p   2v                utgwc(i,k) = 0.0
             271     2   p   2v                vtgwc(i,k) = 0.0
             272     2               !         brunm(i,k) = 0.0
             273     2               !         rhom(i,k)  = 0.0
             274     2   p   2v                enddo
             275     1   p                 enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taucty, tauctx
                                   <<< Loop-information  End >>>
             276     1  pp   2v            do i=1,im
             277     1   p   2v              tauctx(i) = 0.0
             278     1   p   2v              taucty(i) = 0.0
             279     1   p   2v            enddo
             280                     !
             281                     !      if (npt == 0) print *,' npt =0 no gwdc calculation done! '
             282                           if (npt == 0) return      ! no gwdc calculation done!
             283                     
             284                     !***********************************************************************
             285                     !
             286                     !  begin gwdc
             287                     !
             288                     !***********************************************************************
             289                     
             290                     !-----------------------------------------------------------------------
             291                     !        write out incoming variables
             292                     !-----------------------------------------------------------------------
             293                           fhourpr = zero
             294                     !     if (lprnt) then
             295                     !       if (fhour >= fhourpr) then
             296                     !         print *,' '
             297                     !         write(*,*) 'inside gwdc raw input start print at fhour = ',
             298                     !    &               fhour
             299                     !-------- u1 v1 t1 ----------
             300                     !         write(*,9130)
             301                     !         do ilev=km,1,-1
             302                     !           write(*,9140) ilev,u1(ipr,ilev),v1(ipr,ilev),t1(ipr,ilev)
             303                     !         enddo
             304                     !
             305                     !         print *,' '
             306                     !         print *,' inside gwdc raw input end print'
             307                     !       endif
             308                     !     endif
             309                     
             310                     !9100 format(//,14x,'pressure levels',//,
             311                     !    +' ilev',6x,'pint1',7x,'pmid1',6x,'dpmid1',/)
             312                     !9110 format(i4,2x,f10.3)
             313                     !9120 format(i4,12x,2(2x,f10.3))
             314                     !9130 format(//,' ilev',7x,'u1',10x,'v1',10x,'t1',/)
             315                     !9140 format(i4,3(2x,f10.3))
             316                     !
             317                     !     allocate local arrays
             318                     
             319                           allocate (kcldtop(npt), kcldbot(npt), do_gwc(npt))

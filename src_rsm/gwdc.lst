                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             388     2   p    v              do i=1,npt
             389     2   p    v                ii = ipt(i)
             390     2   p    v                pint(i,k)     = pint1(ii,k)
             391     2   p    v                taugwci(i,k)  = zero
             392     2   p    v                bruni(i,k)    = zero
             393     2   p    v                rhoi(i,k)     = zero
             394     2   p    v                ti(i,k)       = zero
             395     2   p    v                basicui(i,k)  = zero
             396     2   p    v                riloc(i,k)    = zero
             397     2   p    v                rimin(i,k)    = zero
             398     2   p    v              enddo
             399     1   p                 enddo
                                   <<< Loop-information Start >>>

             660                     !-----------------------------------------------------------------------
             661                     !
             662                     !  calculate local richardson number
             663                     !
             664                     !  basicum   : u at mid level
             665                     !  basicui   : ui at interface level
             666                     !
             667                     !  interface 1 ========       ui(1)            rhoi(1)  bruni(1)  riloc(1)
             668                     !  mid-level 1 -------- u(1)
             669                     !            2 ========       ui(2)  dpint(2)  rhoi(2)  bruni(2)  riloc(2)
             670                     !            2 -------- u(2)
             671                     !            3 ========       ui(3)  dpint(3)  rhoi(3)  bruni(3)  riloc(3)
             672                     !            3 -------- u(3)
             673                     !            4 ========       ui(4)  dpint(4)  rhoi(4)  bruni(4)  riloc(4)
             674                     !            4 -------- u(4)
             675                     !              ........
             676                     !           17 ========       ui(17) dpint(17) rhoi(17) bruni(17) riloc(17)
             677                     !           17 -------- u(17)
             678                     !           18 ========       ui(18) dpint(18) rhoi(18) bruni(18) riloc(18)
             679                     !           18 -------- u(18)
             680                     !           19 ========       ui(19)           rhoi(19) bruni(19) riloc(19)
             681                     !
             682                     !-----------------------------------------------------------------------
             683                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      basicum, pmid, rhoi, bruni, riloc
                                   <<< Loop-information  End >>>
             684     1  pp                 do k=2,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      basicum, pmid, bruni, rhoi, riloc
                                   <<< Loop-information  End >>>
             685     2   p    v              do i=1,npt
             686     2   p    v                shear = grav*rhoi(i,k) * (basicum(i,k) - basicum(i,k-1))    &
             687     2                                               / (pmid(i,k) - pmid(i,k-1))
             688     3   p    v                if ( abs(shear) < shmin ) then
             689     3   p    v                  riloc(i,k) = rimax
             690     3   p    v                else
             691     3   p    v                  tem = bruni(i,k) / shear
             692     3   p    v                  riloc(i,k)  = tem * tem
             693     3   p    v                  if (riloc(i,k) >= rimax ) riloc(i,k) = rilarge
             694     3   p    v                end if
             695     2   p    v              enddo
             696     1   p                 enddo
             697                     

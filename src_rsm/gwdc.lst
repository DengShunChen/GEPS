                                   <<<      plnmid, plnint, basicum, basicui
                                   <<< Loop-information  End >>>
             652     1  pp                 do k=2,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      basicum, plnmid, plnint, basicui
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             653     2   p    v              do i=1,npt
             654     2   p    v                tem1 = (plnmid(i,k)-plnint(i,k)) / (plnmid(i,k)-plnmid(i,k-1))
             655     2   p    v                tem2 = one - tem1
             656     2   p    v                basicui(i,k) = basicum(i,k)*tem2 + basicum(i,k-1)*tem1
             657     2   p    v              enddo
             658     1   p                 enddo

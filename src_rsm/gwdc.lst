             409     1   p    v              kcldbot(i)   = km - kbot(ii) + 1
             410     1   p    v              dlen(i)      = dlength(ii)
             411     1               !                                    (g*qmax(ii)*cldf(ii)*dlength(ii))
             412     1   p    v              gqmcldlen(i) = grav*qmax(ii)*cldf(ii)*dlen(i)

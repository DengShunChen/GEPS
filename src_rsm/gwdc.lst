             812                     !         endif
             813                     !       endif
             814                     
             815                     9210 format(/,5x,'stress vector = ( ',f8.3,' , ',f8.3,' ) = ',f8.3,   &
             816                           ' in direction ',f6.2,4x,'kk = ',i2,/)
             817                     !-----------------------------------------------------------------------
             818                     !
             819                     !  at this point, mean wind at the cloud top is larger than zero and
             820                     !  local ri at the cloud top is larger than ricrit (=0.25)
             821                     !
             822                     !  calculate minimum of richardson number including both basic-state
             823                     !  condition and wave effects.
             824                     !
             825                     !          g*q_0*alpha*dx                  ri_loc*(1 - mu*|c2|)
             826                     !  mu  =  ----------------  ri_min =  -----------------------------
             827                     !           c_p*n*t*u^2                (1 + mu*ri_loc^(0.5)*|c2|)^2
             828                     !
             829                     !  minimum ri is calculated for the following two cases
             830                     !
             831                     !  (1)   riloc < 1.e+20
             832                     !  (2)   riloc = 1.e+20  ----> vertically uniform basic-state wind
             833                     !
             834                     !  riloc cannot be smaller than zero because n^2 becomes 1.e-32 in the
             835                     !  case of n^2 < 0.. thus the sign of rinum is determined by
             836                     !  1 - nonlin*|c2|.
             837                     !
             838                     !-----------------------------------------------------------------------
             839                     
             840     1                     do k=kcldm,1,-1
             841     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 56
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      do_gwc, kcldtop, taugwci, v, u, vcltop
                                   <<<      cosphi, ucltop, sinphi, riloc, velco
                                   <<<    PREFETCH(SOFT) : 24
                                   <<<     SEQUENTIAL : 24
                                   <<<      u: 2, basicui: 2, ti: 2, bruni: 2
                                   <<<      gqmcldlen: 2, dlen: 2, rimin: 2
                                   <<<      taugwci: 2, rhoi: 2, basicum: 4
                                   <<<      velco: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 21
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 4  FILL 4
                                   <<< Loop-information  End >>>
             842     2  pp    v              do i=1,npt
             843     3   p    v                if (do_gwc(i)) then
             844     3   p    v                  kk = kcldtop(i)
             845     3   p    v                  if (k > kk) cycle
             846     4   p    v                  if ( k /= 1 ) then
             847     4   p    v                    tem1 = (u(i,k)+u(i,k-1))*0.5
             848     4   p    v                    tem2 = (v(i,k)+v(i,k-1))*0.5
             849     4   p    v                    crit1 = ucltop(i)*tem1
             850     4   p    v                    crit2 = vcltop(i)*tem2
             851     4   p    v                    velco(i,k) = tem1 * cosphi(i) + tem2 * sinphi(i)
             852     4   p    v                  else
             853     4   p    v                    crit1 = ucltop(i)*u(i,1)
             854     4   p    v                    crit2 = vcltop(i)*v(i,1)
             855     4   p    v                    velco(i,1) = u(i,1) * cosphi(i) + v(i,1) * sinphi(i)
             856     4   p    v                  end if
             857     3               
             858     4   p    v                  if ( abs(basicui(i,k)) > zero .and. crit1 > zero          &
             859     4                                                        .and. crit2 > zero ) then
             860     4   p    v                    tem = basicui(i,k) * basicui(i,k)
             861     4   p    v                    nonlin   = gqmcldlen(i) / (bruni(i,k)*ti(i,k)*tem)
             862     4   p    v                    tem  = nonlin*abs(c2)
             863     5   p    v                    if ( riloc(i,k)  <  rimaxm ) then
             864     5   p    v                      tem1 = 1 + tem*sqrt(riloc(i,k))
             865     5   p    v                      rimin(i,k) = riloc(i,k) * (1-tem) / (tem1*tem1)
             866     5   p    v                    else if((riloc(i,k) > rimaxm) .and.                     &
             867     5                                    (riloc(i,k) < rimaxp)) then
             868     5   p    v                      rimin(i,k) = ( 1 - tem) / (tem*tem)
             869     5   p    v                    end if
             870     5   p    v                    if ( rimin(i,k) <= riminx ) then
             871     5   p    v                      rimin(i,k) = rismall
             872     5   p    v                    end if
             873     4   p    v                  else
             874     4   p    v                    rimin(i,k) = riminx
             875     4   p    v                  end if
             876     3               

             359                     !lzl c          endif
             360                     !lzl c        enddo
             361                     !lzl c      endif
             362                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipt, basicum, brunm, vtgwcl, utgwcl
                                   <<<      spfh, dpmid, pmid, plnmid, rhom, t, v, u
                                   <<< Loop-information  End >>>
             363     1  pp                 do k=1,km
             364     1               !byl        k1 = km - k + 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.76, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipt, basicum, brunm, vtgwcl, utgwcl
                                   <<<      spfh, dpmid, pmid, plnmid, rhom, t, v, u
                                   <<< Loop-information  End >>>
             365     2   p    v              do i=1,npt
             366     2   p    v                ii = ipt(i)
             367     2   p    v                u(i,k)        = u1(ii,k)
             368     2   p    v                v(i,k)        = v1(ii,k)
             369     2   p    v                t(i,k)        = t1(ii,k)
             370     2   p    v                spfh(i,k)     = max(q1(ii,k),qmin)
             371     2   p    v                pmid(i,k)     = pmid1(ii,k)
             372     2   p    v                dpmid(i,k)    = dpmid1(ii,k) * onebg
             373     2               !         cumchr(i,k)   = cumchr1(ii,k)
             374     2               
             375     2   p    v                rhom(i,k)     = pmid(i,k) / (rd*t(i,k)*(1.0+fv*spfh(i,k)))
             376     2   p    v                plnmid(i,k)   = log(pmid(i,k))
             377     2   p    v                utgwcl(i,k)   = zero
             378     2   p    v                vtgwcl(i,k)   = zero
             379     2               !         ugwdc(i,k)    = zero
             380     2               !         vgwdc(i,k)    = zero
             381     2   p    v                brunm(i,k)    = zero
             382     2   p    v                basicum(i,k)  = zero
             383     2   p    v              enddo
             384     1   p                 enddo

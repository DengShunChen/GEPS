             722                     !      f6.2,' in direction ',f6.2,4x,'kk = ',i2,//,                    &
             723                     !      ' ilev',2x,'basicum',2x,'basicui',4x,'dpint',6x,'rhoi',5x,      &
             724                     !      'bruni',6x,'ri',/)
             725                     9114 format(i4,10x,f8.2,4(2x,f8.2))
             726                     9124 format(i4,1x,f8.2)
             727                     
             728                     !-----------------------------------------------------------------------
             729                     !
             730                     !  calculate gravity wave stress at the interface level cloud top
             731                     !
             732                     !  kcldtopi  : the interface level cloud top index
             733                     !  kcldtop   : the midlevel cloud top index
             734                     !  kcldbot   : the midlevel cloud bottom index
             735                     !
             736                     !  a : find deep convective heating rate maximum
             737                     !
             738                     !      if kcldtop(i) is less than kcldbot(i) in a horizontal grid point,
             739                     !      it can be thought that there is deep convective cloud. however,
             740                     !      deep convective heating between kcldbot and kcldtop is sometimes
             741                     !      zero in spite of kcldtop less than kcldbot. in this case,
             742                     !      maximum deep convective heating is assumed to be 1.e-30.
             743                     !
             744                     !  b : kk is the vertical index for interface level cloud top
             745                     !
             746                     !  c : total convective fractional cover (cldf) is used as the
             747                     !      convective cloud cover for gwdc calculation instead of
             748                     !      convective cloud cover in each layer (concld).
             749                     !                       a1 = cldf*dlength
             750                     !      you can see the difference between cldf(i) and concld(i)
             751                     !      in (4.a.2) in description of the ncar community climate
             752                     !      model (ccm3).
             753                     !      in ncar ccm3, cloud fractional cover in each layer in a deep
             754                     !      cumulus convection is determined assuming total convective
             755                     !      cloud cover is randomly overlapped in each layer in the
             756                     !      cumulus convection.
             757                     !
             758                     !  d : wave stress at cloud top is calculated when the atmosphere
             759                     !      is dynamically stable at the cloud top
             760                     !
             761                     !  e : cloud top wave stress and nonlinear parameter are calculated
             762                     !      using density, temperature, and wind that are defined at mid
             763                     !      level just below the interface level in which cloud top wave
             764                     !      stress is defined.
             765                     !      nonlinct is defined at the interface level.
             766                     !
             767                     !  f : if the atmosphere is dynamically unstable at the cloud top,
             768                     !      gwdc calculation in current horizontal grid is skipped.
             769                     !
             770                     !  g : if mean wind at the cloud top is less than zero, gwdc
             771                     !      calculation in current horizontal grid is skipped.
             772                     !
             773                     !  h : maximum cloud top stress, tauctmax =  -20 n m^(-2),
             774                     !  h : max stress -5 (*j*)5/2015 tauctmax =  - 5 n m^(-2),
             775                     !      in order to prevent numerical instability.
             776                     !
             777                     !-----------------------------------------------------------------------
             778                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 123
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kcldtop, do_gwc
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             779     1  pp    s            do i=1,npt
             780     1   p    v              kk = kcldtop(i)
             781     2   p    m              if ( abs(basicui(i,kk)) > zero .and. riloc(i,kk) > ricrit) then
             782     2               !
             783     2   p    s                tem       = basicum(i,kk)
             784     2   p    s                tem1      = tem * tem
             785     2   p    s                nonlinct  = gqmcldlen(i) / (bruni(i,kk)*t(i,kk)*tem1)    ! mu
             786     2   p    s                tem2      = c2*nonlinct
             787     2               !                                  rhou^3c1(c2mu)^2/ndx
             788     2   p    s                tauct     = - rhom(i,kk) * tem * tem1 * c1 * tem2 * tem2   &
             789     2                                  /  (bruni(i,kk)*dlen(i))
             790     2               
             791     2   p    s                tauct         = max(tauctmax, tauct)
             792     2   p    s                tauctxl(i)    = tauct * cosphi(i)           ! x stress at cloud top
             793     2   p    s                tauctyl(i)    = tauct * sinphi(i)           ! y stress at cloud top
             794     2   p    s                taugwci(i,kk) = tauct                                    !  *1
             795     2   p    s                do_gwc(i)     = .true.
             796     2               !
             797     2   p    s              else
             798     2               !
             799     2   p    s                tauctxl(i) = zero
             800     2   p    s                tauctyl(i) = zero
             801     2   p    s                do_gwc(i) = .false.
             802     2   p    v              end if
             803     1               !
             804     1   p    v            enddo
             805                     
             806                     !
             807                     
             808                     !       if (lprnt.and.(i.eq.ipr)) then
             809                     !         if (fhour.ge.fhourpr) then
             810                     !lzl write out-------------#

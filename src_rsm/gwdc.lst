             430                     !***********************************************************************
             431                     
             432                           pi     = 2.*asin(1.)
             433                     
             434                     !-----------------------------------------------------------------------
             435                     !
             436                     !                              pressure variables
             437                     !
             438                     !  interface 1 ======== pint(1)           *********
             439                     !  mid-level 1 --------          pmid(1)            dpmid(1)
             440                     !            2 ======== pint(2)           dpint(2)
             441                     !            2 --------          pmid(2)            dpmid(2)
             442                     !            3 ======== pint(3)           dpint(3)
             443                     !            3 --------          pmid(3)            dpmid(3)
             444                     !            4 ======== pint(4)           dpint(4)
             445                     !            4 --------          pmid(4)            dpmid(4)
             446                     !              ........
             447                     !           17 ======== pint(17)          dpint(17)
             448                     !           17 --------          pmid(17)           dpmid(17)
             449                     !           18 ======== pint(18)          dpint(18)
             450                     !           18 --------          pmid(18)           dpmid(18)
             451                     !           19 ======== pint(19)          *********
             452                     !
             453                     !-----------------------------------------------------------------------
             454                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 176
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, pint, tauctxl, ti, bruni, spfh, rhoi
                                   <<<      tauctyl
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             455     1  pp    v            do i = 1, npt
             456     1   p    v              tauctxl(i)    = zero
             457     1   p    v              tauctyl(i)    = zero
             458     1               
             459     1               !-----------------------------------------------------------------------
             460     1               !                              thermal variables
             461     1               !
             462     1               !  interface 1 ========       ti(1)           rhoi(1)            bruni(1)
             463     1               !            1 -------- t(1)         rhom(1)           brunm(1)
             464     1               !            2 ========       ti(2)           rhoi(2)            bruni(2)
             465     1               !            2 -------- t(2)         rhom(2)           brunm(2)
             466     1               !            3 ========       ti(3)           rhoi(3)            bruni(3)
             467     1               !            3 -------- t(3)         rhom(3)           brunm(3)
             468     1               !            4 ========       ti(4)           rhoi(4)            bruni(4)
             469     1               !            4 -------- t(4)         rhom(4)           brunm(4)
             470     1               !              ........
             471     1               !           17 ========
             472     1               !           17 -------- t(17)        rhom(17)          brunm(17)
             473     1               !           18 ========       ti(18)          rhoi(18)           bruni(18)
             474     1               !           18 -------- t(18)        rhom(18)          brunm(18)
             475     1               !           19 ========       ti(19)          rhoi(19)           bruni(19)
             476     1               !
             477     1               
             478     1               !
             479     1               !  top interface temperature is calculated assuming an isothermal
             480     1               !  atmosphere above the top mid level.
             481     1               
             482     1   p    v              ti(i,1)    = t(i,1)
             483     1   p    v              rhoi(i,1)  = pint(i,1)/(rd*ti(i,1))
             484     1   p    v              bruni(i,1) = sqrt ( gsqr / (cp*ti(i,1)) )
             485     1               !
             486     1               !  bottom interface temperature is calculated assuming an isothermal
             487     1               !  atmosphere below the bottom mid level
             488     1               
             489     1   p    v              ti(i,km+1)    = t(i,km)
             490     1   p    v              rhoi(i,km+1)  = pint(i,km+1)/(rd*ti(i,km+1)*(1.0+fv*spfh(i,km)))
             491     1   p    v              bruni(i,km+1) = sqrt ( gsqr / (cp*ti(i,km+1)) )
             492     1   p    v            enddo
             493                     
             494                     !-----------------------------------------------------------------------
             495                     !
             496                     !  calculate interface level temperature, density, and brunt-vaisala
             497                     !  frequencies based on linear interpolation of temp in ln(pressure)
             498                     !
             499                     !-----------------------------------------------------------------------
             500                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             501     1  pp                 do k = 2, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plnmid, plnint, t, spfh, pint, pmid
                                   <<<      bruni, rhoi, ti
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             502     2   p    v              do i = 1, npt
             503     2   p    v                tem1 = (plnmid(i,k)-plnint(i,k)) / (plnmid(i,k)-plnmid(i,k-1))
             504     2   p    v                tem2 = one - tem1
             505     2   p    v                ti(i,k)    = t(i,k-1)    * tem1 + t(i,k)    * tem2
             506     2   p    v                qtem       = spfh(i,k-1) * tem1 + spfh(i,k) * tem2
             507     2   p    v                rhoi(i,k)  = pint(i,k) / ( rd * ti(i,k)*(1.0+fv*qtem) )
             508     2   p    v                dtdp       = (t(i,k)-t(i,k-1)) / (pmid(i,k)-pmid(i,k-1))
             509     2   p    v                n2         = gsqr / ti(i,k) * ( 1./cp - rhoi(i,k)*dtdp )
             510     2   p    v                bruni(i,k) = sqrt (max (n2min, n2))
             511     2   p    v              enddo
             512     1   p                 enddo
             513                     
             514                           deallocate (spfh)
             515                     !-----------------------------------------------------------------------
             516                     !
             517                     !  determine the mid-level brunt-vaisala frequencies.
             518                     !             based on interpolated interface temperatures [ ti ]
             519                     !
             520                     !-----------------------------------------------------------------------
             521                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pint, rhom, t, ti, brunm
                                   <<< Loop-information  End >>>
             522     1  pp                 do k = 1, km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.29, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, pint, rhom, ti, brunm
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             523     2   p    v              do i = 1, npt
             524     2   p    v                dtdp       = (ti(i,k+1)-ti(i,k)) / (pint(i,k+1)-pint(i,k))
             525     2   p    v                n2         = gsqr / t(i,k) * ( 1./cp - rhom(i,k)*dtdp )
             526     2   p    v                brunm(i,k) = sqrt (max (n2min, n2))
             527     2   p    v              enddo
             528     1   p                 enddo
             529                     

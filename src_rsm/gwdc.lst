             346                     !-----------------------------------------------------------------------
             347                     !        create local arrays with reversed vertical indices
             348                     !        and initialize local variables
             349                     !-----------------------------------------------------------------------
             350                           gsqr  = grav * grav
             351                           onebg = one / grav
             352                     
             353                     !lzl c      if (lprnt) then

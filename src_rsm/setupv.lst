 External subroutine subprogram "setupv"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine setupv (yr,yin,mn,nx,lmaxp,pjy,ipt,tp1)
               2                     !
               3                     !  setup routine for bicubv parameters.  see bicubv prolog for
               4                     !  parameter descriptions
               5                     !
               6                           use const, only: RTYPE
               7                     !
               8                           implicit  none
               9                           integer   mn,nx,lmaxp,ipt(mn)
              10                           real(kind=RTYPE) pjy(mn,4)
              11                           real      tp1(mn,4),yin(mn),yr(nx,lmaxp)
              12                     
              13                           integer   n,i,j,k,ii,ix
              14                           real      eps
              15                     !
              16                           n= mn/nx
              17                     !
              18                     !  check out of bounds to ensure interpolation
              19                     !
              20                           eps = 1.0e-5
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.54, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      yin
                                   <<< Loop-information  End >>>
              21     1  pp    v            do 100 i = 1, mn
              22     1   p    v            ix = i - ((i-1)/nx)*nx
              23     1   p    v            if ( yin(i).le.yr(ix,1) )      yin(i) = yr(ix,1) + eps
              24     1   p    v            if ( yin(i).ge.yr(ix,lmaxp) )  yin(i) = yr(ix,lmaxp) - eps
              25     1   p    v        100 continue
              26                     !
              27     1                     do 10 i=1,nx
              28     1                     k=1
              29     2                     do 5 j=1,n
              30     2                     ii= nx*(j-1)
              31     2                   6 k= k+1
              32     2                     if(yin(i+ii).gt.yr(i,k)) go to 6
              33     2                     ipt(i+ii)= i+nx*(k-1)
              34     2                     tp1(i+ii,1)= yin(i+ii)-yr(i,k-1)
              35     2                     tp1(i+ii,2)= yr(i,k)-yr(i,k-1)
              36     2                     k= k-1
              37     2                   5 continue
              38     1                  10 continue
              39                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 400
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp1, pjy
                                   <<< Loop-information  End >>>
              40     1  pp    v            do 90 i=1,mn
              41     1   p    v            pjy(i,3)= tp1(i,1)/tp1(i,2)
              42     1   p    v            pjy(i,4)= 1.0-pjy(i,3)
              43     1   p    v            pjy(i,1)= pjy(i,3)*pjy(i,3)-1.0
              44     1   p    v            pjy(i,2)= pjy(i,4)*pjy(i,4)-1.0
              45     1   p    v            pjy(i,1)= pjy(i,1)*tp1(i,1)*tp1(i,2)
              46     1   p    v            tp1(i,1)= tp1(i,2)-tp1(i,1)
              47     1   p    v            pjy(i,2)= pjy(i,2)*tp1(i,1)*tp1(i,2)
              48     1   p    v         90 continue
              49                     !
              50                           return
              51                           end


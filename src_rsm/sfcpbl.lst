 External subroutine subprogram "sfcpbl"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine sfcpbl ( mn,kk,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt &
               2                                             , u,v,t,q,ut,vt,tt,qt,sfcw,ustar,tstar,qstar &
               3                                             , e,eps,hflux,qflux,qsfc,gwet,zl,itypbl      &
               4                                             , t2,u10,v10 )
               5                     !
               6                     !##################################################################
               7                     !                     subroutine description
               8                     !
               9                     ! 1. function description
              10                     !
              11                     !       this subroutine calculated surface fluxes of momentum,
              12                     !       heat and moisture.
              13                     !       the effects of surface fluxes are added to the bottom
              14                     !       levels.
              15                     !
              16                     ! 2. parameter specification
              17                     !
              18                     !     mn : dimension of horizontal-direction
              19                     !     kk : dimension of z-direction
              20                     !     dt : time step for ut, vt, tt, qt updates               (s)
              21                     !      g : gravity                                            (m/s2)
              22                     !      r : air gas constant                                   (j/kg)
              23                     !     cp : air specific heat constant                         (j/kg)
              24                     !   hltm : water vapor latent heat constant                   (j/kg)
              25                     !     tg : ground potential temp. (sea or land)    (mn)      (k)
              26                     !     z0 : surface roughness length                (mn)      (m)
              27                     !  ocean : logical array for ocean  (mn)      (true = open water)
              28                     !     ps : surface pressure     (mn)     at current time lvl (mb)
              29                     !     ts : surface air temp
              30                     !    hgt : height above ground  (mn,kk)  at current time lvl (m)
              31                     !      u : x-direction velocity (mn,kk) at current time lvl (m/s)
              32                     !      v : y-direction velocity (mn,kk) at current time lvl (m/s)
              33                     !      t : potent temp on odd lvl(mn,kk) at current time lvl (k)
              34                     !      q : moisture    on odd lvl(mn,kk) at current time lvl (kg/kg)
              35                     !     ut : x-direction velocity (mn,kk) at past/future  lvl (m/s)
              36                     !     vt : y-direction velocity (mn,kk) at past/future  lvl (m/s)
              37                     !     tt : potent temp on odd lvl(mn,kk) at past/future  lvl (k)
              38                     !     qt : moisture    on odd lvl(mn,kk) at past/future  lvl (kg/kg)
              39                     !   sfcw : surface wind speed                       (mn)     (m/s)
              40                     !   ustar: surface friction velocity                (mn)     (m/s)
              41                     !   tstar: surface potential temp scale             (mn)     (k)
              42                     !   qstar: surface moisture scale                   (mn)     (kg/kg)
              43                     !     e  : turbulence kinetic energy                (mn,kk)  (m2/s2)
              44                     !    eps : tke dissipation                          (mn)     (m2/s2)
              45                     !   hflux: upward surface heat flux, =-ro*cp*ustar*tstar   (mn)  (w/m2)
              46                     !   qflux: upward surface moist flux,=-ro*hltm*ustar*qstar (mn)  (w/m2)
              47                     !    qsfc: surface satuated specific humidity       (mn)     (kg/kg)
              48                     !    gwet: ground wetness                           (mn)
              49                     !     zl : height(kk) over monin-obukhov scale height.
              50                     !          a stability indicator.                   (mn)
              51                     ! itypbl : index for surface layer update, =0 stress b,c., =1 direct
              52                     !     t2 : surface air temperature at 2m             (mn)   (k)
              53                     !    u10 : surface wind in x-direction at 10m        (mn)   (m/s)
              54                     !    v10 : surface wind in y-direction at 10m        (mn)   (m/s)
              55                     !
              56                     ! 4. local work arrays
              57                     !
              58                     !    phim: non-dimensional vertically integrated wind shear function
              59                     !          (businger , 1973)                        (mn)
              60                     !    phih: non-dimensional vertically integrated temperature/moisture
              61                     !          gradient function (businger , 1973)      (mn)
              62                     !    sfcw: wind speed on mass point                 (mn)     (m/s)
              63                     !    zsz0: log(zs/z0)                               (mn)     (m/m)
              64                     !
              65                     ! 5. calling modules
              66                     !
              67                     !    pbltke
              68                     !
              69                     ! 6. usage
              70                     !
              71                     !     call sfcpbl ( mn,kk,dt,g,r,cp,hltm,tg,z0,ocean,ps,ts,hgt,u,v,t
              72                     !    1            , q,ut,vt,tt,qt,sfcw,ustar,tstar,qstar,e,eps,hflux
              73                     !    2            , qflux,qsfc,gwet,zl,itypbl )
              74                     !
              75                     ! 7. modules called
              76                     !
              77                     !
              78                     ! 8. limitation
              79                     !
              80                     !   ** 1.5e-5 <= z0 (sea) <= 0.01
              81                     !   **   -2.0 <=    zl    <= 2.0
              82                     !   **            ustar   >= 1.e-7,  <= 1.e+1
              83                     !   **            tatrt              <= 5.e+1
              84                     !   **            qatrt              <= 5.e+0
              85                     !   **              zs    >= 10.0
              86                     !   **             sfcw   >= 0.01
              87                     !
              88                     ! 9. date
              89                     !
              90                     !     created            10/1/1989
              91                     !     modified           7/23/1990
              92                     !     rewritten          nov. 1991
              93                     !
              94                     ! 10. author
              95                     !      c. liou / f. wang / s. chang
              96                     !      modify to f90 by C-H Lee and sort by River Chen in 2015
              97                     !
              98                     ! 11. reference
              99                     !       businger j.a.,1973: turbulent transfer in the atmospheric
             100                     !            surface layer.  workshop in meteorology, d. a. haugen,
             101                     !            ed., american meteorology socity, 67-98.
             102                     !#####################################################################
             103                           use paramt
             104                     
             105                           implicit  none
             106                     !
             107                     ! input & output variable
             108                     !
             109                           integer   mn,kk,itypbl
             110                     
             111                           real      tg(mn),z0(mn),ps(mn),hgt(mn,kk)                    &
             112                                   , u(mn,kk),v(mn,kk),t(mn,kk),q(mn,kk),ut(mn,kk)      &
             113                                   , vt(mn,kk),tt(mn,kk),qt(mn,kk),sfcw(mn),ustar(mn)   &
             114                                   , tstar(mn),qstar(mn),e(mn,kk),eps(mn,kk),hflux(mn)  &
             115                                   , qflux(mn),qsfc(mn),gwet(mn),zl(mn),ts(mn)
             116                     
             117                           logical ocean(mn)
             118                     !
             119                     !  local work arrays
             120                     !
             121                           real      phim(im),phih(im),zsz0(im),rosfc(im)               &
             122                                   , wu(im),wv(im),wt(im),wq(im)                        &
             123                     !cc for output of t2, u10 and v10 ( 2003/01/20 )
             124                                   , u10(mn),v10(mn),t2(mn)
             125                     !
             126                     !
             127                     !          cccccccccccccccccccccccccccccccccccccccccccccc
             128                     !          c                                            c
             129                     !          c         similarity surface layer           c
             130                     !          c         paulson 1970, businger 1973        c
             131                     !          c                                            c
             132                     !          cccccccccccccccccccccccccccccccccccccccccccccc
             133                     !
             134                           integer i,it1
             135                           real    xkapa,hltm,cp,r,g,dt,g04,pihalf,xx,yy
             136                           real    btest,bl,al,zl2,zl10,xx10,phim10,phih2,p2
             137                           real    hpbl,ghpbl,wstar,zlx
             138                     
             139                           xkapa = r/cp
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, ts, rosfc
                                   <<< Loop-information  End >>>
             140     1  pp   2v            do 10 i = 1, mn
             141     1   p   2v            rosfc(i) = 100.0*ps(i)/( r*ts(i))
             142     1   p   2v        10  continue
             143                     !
             144                     !           iterate 3 times to match u*, t*, q*, and z/l
             145                     !
             146     1                     do 900 it1 = 1, 3
             147     1               !
             148     1               !           charnock's relation for surface roughness over oceans
             149     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hgt, ut, qstar, tt, ustar, tstar, vt, zl
                                   <<<      wv, wu, ocean, sfcw, z0, qt, qsfc, wq
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      tg: 2, wt: 2, phih: 2, rosfc: 2
                                   <<<      qflux: 2, hflux: 2, phim: 2, zsz0: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 6
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 8
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             150     2  pp    v            do 100 i = 1, mn
             151     3   p    v            if ( ocean(i) )  then
             152     3   p    v               z0(i) = 0.032 *ustar(i)*ustar(i)/g
             153     3   p    v               z0(i)= max(1.5e-5,min(z0(i),0.01))
             154     3   p    v            endif
             155     2               ! 100 continue
             156     2               !     do 140 i=1,mn
             157     2               !
             158     2               !           compute surface wind
             159     2               !
             160     2   p    v            sfcw(i)= max( 1.0e-2,sqrt( ut(i,kk)*ut(i,kk)+vt(i,kk)*vt(i,kk)))
             161     2               ! 140 continue
             162     2               !
             163     2               !           compute z/l
             164     2               !
             165     2               !           limit minimum depth of surface layer
             166     2               !           (saved in zsz0) for surface flux calculation
             167     2               !
             168     2               !
             169     2   p    v            g04 = g*0.4
             170     2               !     do 200 i=1,mn
             171     2   p    v            zsz0(i) = max(10.0,hgt(i,kk))
             172     2   p    v            zl(i) = g04*zsz0(i)*tstar(i)*(1.+0.61*qstar(i)) /     &
             173     2                             (tt(i,kk)*ustar(i)*ustar(i))
             174     2   p    v            zl(i)= max(-2.0,min(zl(i),2.0))
             175     2               ! 200 continue
             176     2               !
             177     2               !           compute phi functions  (see businger 1973, or paulson 1970)
             178     2               !
             179     2   p    v            pihalf = 3.141592654 * 0.5
             180     2               !     do 240 i = 1, mn
             181     3   p    v            if(zl(i) .lt. 0.0) then
             182     3   p    v               xx = exp(0.25*log(1.0 - 15.0*zl(i)))
             183     3   p    v               phim(i) = 2.0*log(0.5*(1.0+xx)) + log(0.5*(1.0+xx*xx))  &
             184     3                                         - 2.0*atan(xx) + pihalf
             185     3   p    v               phih(i) = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl(i))))
             186     3   p    v            else
             187     3   p    v               phim(i) = -4.7  * zl(i)
             188     3   p    v               phih(i) = -6.35 * zl(i)
             189     3   p    v            endif
             190     2               ! 240 continue
             191     2               !
             192     2               !     do 300 i = 1, mn
             193     2   p    v            zsz0(i) = log(zsz0(i)/z0(i))
             194     2   p    v            phim(i) = zsz0(i) - phim(i)
             195     2   p    v            phih(i) = zsz0(i) - phih(i)
             196     2   p    v            phim(i)= max(phim(i),1.0e-3)
             197     2   p    v            phih(i)= max(phih(i),1.0e-3)
             198     2               ! 300 continue
             199     2               !
             200     2               !     compute new ut, vt, tt, and qt for ustar, tstar, qstar updates
             201     2               !     using crank-nicolson (bl=0.5) time scheme for weak forcing or
             202     2               !        or backward (bl=1.) time scheme for strong forcing
             203     2               !
             204     2               !     do 340 i = 1, mn
             205     2   p    v            yy    = dt*ustar(i) * ustar(i) / (2.0*hgt(i,kk)*sfcw(i))
             206     2   p    v            btest = 0.5 + (yy-1.0)*0.5
             207     2   p    v            bl    = max (0.5, min (1.0, btest) )
             208     2   p    v            al    = 1.0 - bl
             209     2   p    v            wu(i) = ut(i,kk) * (1.0-al*yy) / (1.0+bl*yy)
             210     2   p    v            wv(i) = vt(i,kk) * (1.0-al*yy) / (1.0+bl*yy)
             211     2   p    v            xx    = 0.4*dt*ustar(i) / (0.74*2.0*hgt(i,kk)*phih(i))
             212     2   p    v            wt(i) = ( tt(i,kk)*(1.0-al*xx) + xx*tg(i) )   / (1.0+bl*xx)
             213     2   p    v            wq(i) = ( qt(i,kk)*(1.0-al*xx) + xx*qsfc(i) ) / (1.0+bl*xx)
             214     2               ! 340 continue
             215     2               !
             216     2               !     update ustar, tstar and qstar
             217     2               !
             218     2               !     do 360 i = 1, mn
             219     2               ! phon-ju
             220     2               ! add blending for stability
             221     2               !
             222     2   p    v            wu(i)=0.5*(ut(i,kk)+wu(i))
             223     2   p    v            wv(i)=0.5*(vt(i,kk)+wv(i))
             224     2   p    v            wt(i)=0.5*(tt(i,kk)+wt(i))
             225     2   p    v            wq(i)=0.5*(qt(i,kk)+wq(i))
             226     2               ! add over
             227     2   p    v            sfcw(i) = max (1.0e-2, sqrt( wu(i)*wu(i) + wv(i)*wv(i) ))
             228     2   p    v            ustar(i) = 0.4*sfcw(i) / phim(i)
             229     2   p    v            tstar(i) = 0.4*        (wt(i)-tg(i))  /(0.74*phih(i))
             230     2   p    v            qstar(i) = 0.4*        (wq(i)-qsfc(i))/(0.74*phih(i))
             231     2   p    v            ustar(i)= max(ustar(i),1.0e-7)
             232     2   p    v            ustar(i)= min(ustar(i),10.000)
             233     2   p    v            tstar(i)= min(tstar(i),50.00)
             234     2   p    v            qstar(i)= min(qstar(i),5.000)
             235     2               ! 360 continue
             236     2               !
             237     2               !
             238     2               !     do 400 i = 1, mn
             239     2   p    v            hflux(i) = -rosfc(i)*cp*ustar(i)*tstar(i)
             240     2   p    v            qflux(i) = -rosfc(i)*hltm*ustar(i)*qstar(i)
             241     2               ! 400 continue
             242     2   p    v        100 continue
             243     1               !
             244     1                 900 continue
             245                     !
             246                     !ccc for output of t2, u10 and v10
             247                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hgt, zl, z0, wv, phim, v10, wu, u10, ps
                                   <<<      phih, tg, wt, rosfc, t2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             248     1  pp    v            do i=1,mn
             249     1   p    v            zl2=zl(i)*2./hgt(i,kk)
             250     1   p    v            zl10=zl(i)*10./hgt(i,kk)
             251     2   p    v            if(zl(i) .lt. 0.0) then
             252     2   p    v               xx10 = exp(0.25*log(1.0 - 15.0*zl10))
             253     2   p    v               phim10 = 2.0*log(0.5*(1.0+xx10)) + log(0.5*(1.0+xx10*xx10))  &
             254     2                                         - 2.0*atan(xx10) + pihalf
             255     2   p    v               phih2 = 2.0*log(0.5*(1.0 +sqrt(1.0 -9.0*zl2)))
             256     2   p    v            else
             257     2   p    v               phim10 = -4.7  * zl10
             258     2   p    v               phih2 = -6.35 * zl2
             259     2   p    v            endif
             260     1   p    v            phim10 =log( 10./z0(i)) - phim10
             261     1   p    v            phih2 =log( 2./z0(i)) - phih2
             262     1   p    v            phim10= max(phim10,1.0e-3)
             263     1   p    v            phih2= max(phih2,1.0e-3)
             264     1               !
             265     1   p    v            v10(i)=wv(i)*phim10/phim(i)
             266     1   p    v            u10(i)=wu(i)*phim10/phim(i)
             267     1               !
             268     1   p    v            t2(i)=tg(i)*(1.-phih2/phih(i)) + wt(i)*phih2/phih(i)
             269     1               !
             270     1               ! convert t2 from potential temp. to temp
             271     1   p    v            p2=(ps(i)*100.-rosfc(i)*g*2.)/100.
             272     1   p    v            t2(i)=t2(i)*(p2/1000.)**xkapa
             273     1   p    v            enddo
             274                     !cc
             275                     !
             276                     !     update ut, vt, tt, and qt, if itypbl=1
             277                     !
             278     1                     if ( itypbl .eq. 1 )  then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

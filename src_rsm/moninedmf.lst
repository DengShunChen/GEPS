                                   <<< Loop-information  End >>>
            1085     3   p    v                do i = 1,im
            1086     3   p    v                  diss(i,k) = dku(i,k)*shr2(i,k)-g*ti(i,k)*dkt(i,k)*bf(i,k)
            1087     3               !           diss(i,k) = dku(i,k)*shr2(i,k)
            1088     3   p    v                enddo
            1089     2   p                   enddo
            1090     1               !
            1091     1               !     add dissipative heating at the first model layer
            1092     1               !
            1093     1               !>  Next, the temperature tendency is updated following equation 14.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

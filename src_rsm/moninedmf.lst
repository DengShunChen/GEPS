 External subroutine subprogram "moninedmf"
  (inc)(line-no.)(nest)(optimize)
               1                     !> \file moninedmf.f
               2                     !!  Contains most of the hybrid eddy-diffusivity mass-flux scheme except for the
               3                     !!  subroutine that calculates the mass flux and updraft properties.
               4                     
               5                     !> \defgroup PBL Hybrid Eddy-diffusivity Mass-flux Scheme
               6                     !! @{
               7                     !!  \brief The Hybrid EDMF scheme is a first-order turbulent transport scheme used for subgrid-scale vertical turbulent mixing in the PBL and above. It blends the traditional first-order approach that has been used and improved over the last several years
               8                     !!
               9                     !!  The PBL scheme's main task is to calculate tendencies of temperature, moisture, and momentum due to vertical diffusion throughout the column (not just the PBL). The scheme is an amalgamation of decades of work, starting from the initial first-order PB
              10                     !!
              11                     !!  \section diagram Calling Hierarchy Diagram
              12                     !!  \image html Hybrid_EDMF_Flowchart.png "Diagram depicting how the Hybrid EDMF PBL scheme is called from the GSM physics time loop" height=2cm
              13                     !!  \section intraphysics Intraphysics Communication
              14                     !!  This space is reserved for a description of how this scheme uses information from other scheme types and/or how information calculated in this scheme is used in other scheme types.
              15                     
              16                     !>  \brief This subroutine contains all of logic for the Hybrid EDMF PBL scheme except for the calculation of the updraft properties and mass flux.
              17                     !!
              18                     !!  The scheme works on a basic level by calculating background diffusion coefficients and updating them according to which processes are occurring in the column. The most important difference in diffusion coefficients occurs between those levels in the P
              19                     !!
              20                     !!  \param[in] ix horizontal dimension
              21                     !!  \param[in] im number of used points
              22                     !!  \param[in] km vertical layer dimension
              23                     !!  \param[in] ntrac number of tracers
              24                     !!  \param[in] ntcw cloud condensate index in the tracer array
              25                     !!  \param[in,out] dv v-momentum tendency (\f$ m s^{-2} \f$)
              26                     !!  \param[in,out] du u-momentum tendency (\f$ m s^{-2} \f$)
              27                     !!  \param[in,out] tau temperature tendency (\f$ K s^{-1} \f$)
              28                     !!  \param[in,out] rtg moisture tendency (\f$ kg kg^{-1} s^{-1} \f$)
              29                     !!  \param[in] u1 u component of layer wind (\f$ m s^{-1} \f$)
              30                     !!  \param[in] v1 v component of layer wind (\f$ m s^{-1} \f$)
              31                     !!  \param[in] t1 layer mean temperature (\f$ K \f$)
              32                     !!  \param[in] q1 layer mean tracer concentration (units?)
              33                     !!  \param[in] swh total sky shortwave heating rate (\f$ K s^-1 \f$)
              34                     !!  \param[in] hlw total sky longwave heating rate (\f$ K s^-1 \f$)
              35                     !!  \param[in] xmu time step zenith angle adjust factor for shortwave
              36                     !!  \param[in] psk Exner function at surface interface?
              37                     !!  \param[in] rbsoil surface bulk Richardson number
              38                     !!  \param[in] zorl surface roughness (units?)
              39                     !!  \param[in] u10m 10-m u wind (\f$ m s^{-1} \f$)
              40                     !!  \param[in] v10m 10-m v wind (\f$ m s^{-1} \f$)
              41                     !!  \param[in] fm fm parameter from PBL scheme
              42                     !!  \param[in] fh fh parameter from PBL scheme
              43                     !!  \param[in] tsea ground surface temperature (K)
              44                     !!  \param[in] qss surface saturation humidity (units?)
              45                     !!  \param[in] heat surface sensible heat flux (units?)
              46                     !!  \param[in] evap evaporation from latent heat flux (units?)
              47                     !!  \param[in] stress surface wind stress? (\f$ cm*v^2\f$ in sfc_diff subroutine) (units?)
              48                     !!  \param[in] spd1 surface wind speed? (units?)
              49                     !!  \param[out] kpbl PBL top index
              50                     !!  \param[in] prsi pressure at layer interfaces (units?)
              51                     !!  \param[in] del pressure difference between level k and k+1 (units?)
              52                     !!  \param[in] prsl mean layer pressure (units?)
              53                     !!  \param[in] prslk Exner function at layer
              54                     !!  \param[in] phii interface geopotential height (units?)
              55                     !!  \param[in] phil layer geopotential height (units?)
              56                     !!  \param[in] delt physics time step (s)
              57                     !!  \param[in] dspheat flag for TKE dissipative heating
              58                     !!  \param[out] dusfc surface u-momentum tendency (units?)
              59                     !!  \param[out] dvsfc surface v-momentum tendency (units?)
              60                     !!  \param[out] dtsfc surface temperature tendency (units?)
              61                     !!  \param[out] dqsfc surface moisture tendency (units?)
              62                     !!  \param[out] hpbl PBL top height (m)
              63                     !!  \param[out] hgamt counter gradient mixing term for temperature (units?)
              64                     !!  \param[out] hgamq counter gradient mixing term for moisture (units?)
              65                     !!  \param[out] dkt diffusion coefficient for temperature (units?)
              66                     !!  \param[in] kinver index location of temperature inversion
              67                     !!  \param[in] xkzm_m background vertical diffusion coefficient for momentum (units?)
              68                     !!  \param[in] xkzm_h background vertical diffusion coefficeint for heat, moisture (units?)
              69                     !!  \param[in] xkzm_s sigma threshold for background momentum diffusion (units?)
              70                     !!  \param[in] lprnt flag to print some output
              71                     !!  \param[in] ipr index of point to print
              72                     !!
              73                     !!  \section general General Algorithm
              74                     !!  -# Compute preliminary variables from input arguments.
              75                     !!  -# Calculate the first estimate of the PBL height ("Predictor step").
              76                     !!  -# Calculate Monin-Obukhov similarity parameters.
              77                     !!  -# Update thermal properties of surface parcel and recompute PBL height ("Corrector step").
              78                     !!  -# Determine whether stratocumulus layers exist and compute quantities needed for enhanced diffusion.
              79                     !!  -# Calculate the inverse Prandtl number.
              80                     !!  -# Compute diffusion coefficients below the PBL top.
              81                     !!  -# Compute diffusion coefficients above the PBL top.
              82                     !!  -# If the PBL is convective, call the mass flux scheme to replace the countergradient terms.
              83                     !!  -# Compute enhanced diffusion coefficients related to stratocumulus-topped PBLs.
              84                     !!  -# Solve for the temperature and moisture tendencies due to vertical mixing.
              85                     !!  -# Calculate heating due to TKE dissipation and add to the tendency for temperature.
              86                     !!  -# Solve for the horizontal momentum tendencies and add them to output tendency terms.
              87                     !!  \section detailed Detailed Algorithm
              88                     !!  @{
              89                           subroutine moninedmf(ix,im,km,ntrac,ntcw,                         &
              90                              u1,v1,t1,q1,swh,hlw,xmu,                                       &
              91                              psk,rbsoil,zorl,u10m,v10m,fm,fh,                               &
              92                              tsea,heat,evap,stress,spd1,kpbl,                               &
              93                              prsi,del,prsl,prslk,phii,phil,delt,hpbl)
              94                     !
              95                           use machine  , only : kind_phys
              96                           use physcons, grav => con_g, rd => con_rd, cp => con_cp &
              97                           ,             hvap => con_hvap, fv => con_fvirt
              98                           use const    , only : RTYPE

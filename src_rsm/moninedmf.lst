                                   <<<      tau, sflux, stress, spd1, govrth, diss
                                   <<<      zl
                                   <<< Loop-information  End >>>
            1094     2  pp    v              do i = 1,im
            1095     2   p    v                 tem   = govrth(i)*sflux(i)
            1096     2   p    v                 tem1  = tem + stress(i)*spd1(i)/zl(i,1)
            1097     2   p    v                 tem2  = 0.5 * (tem1+diss(i,1))
            1098     2   p    v                 tem2  = max(tem2, 0.)
            1099     2   p    v                 ttend = tem2 / cp
            1100     2   p    v                 tau(i,1) = tau(i,1)+0.5*ttend
            1101     2   p    v              enddo
            1102     1               !
            1103     1               !     add dissipative heating above the first model layer

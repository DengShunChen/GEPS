             252                      610      format(1x,' k pr dkt dku ',i5,3f8.2,' l2 ri t2', &
             253                                    ' sr2  ',2f8.2,2e10.2)
             254                     ! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
             255                     !>  ## Compute preliminary variables from input arguments
             256                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rtg
                                   <<< Loop-information  End >>>
             257        pp   4v            rtg   = 0.
             258                     !
             259                     ! compute preliminary variables
             260                     !
             261                           if (ix .lt. im) stop
             262                     !
             263                     !     iprt = 0
             264                     !     if(iprt.eq.1) then
             265                     !cc   latd = 0
             266                     !     lond = 0
             267                     !     else
             268                     !cc   latd = 0
             269                     !     lond = 0
             270                     !     endif
             271                     !
             272                           dt2   = delt
             273                           rdt   = 1. / dt2
             274                           km1   = km - 1
             275                           kmpbl = km / 2
             276                     !>  - Compute physical height of the layer centers and interfaces from the geopotential height (zi and zl)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phii, phil, zi, zl
                                   <<< Loop-information  End >>>
             277     1  pp                 do k=1,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zi, phii, phil, zl
                                   <<< Loop-information  End >>>

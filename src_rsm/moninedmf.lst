             373     2   p    v              do i = 1,im
             374     2   p    v                theta(i,k) = t1(i,k) * psk(i) / prslk(i,k)
             375     2   p    v                qlx(i,k)   = max(q1(i,k,ntcw),qlmin)
             376     2   p    v                qtx(i,k)   = max(q1(i,k,1),qmin)+qlx(i,k)
             377     2   p    v                ptem       = qlx(i,k)
             378     2   p    v                ptem1      = hvap*max(q1(i,k,1),qmin)/(cp*t1(i,k))
             379     2   p    v                thetae(i,k)= theta(i,k)*(1.+ptem1)
             380     2   p    v                thvx(i,k)  = theta(i,k)*(1.+fv*max(q1(i,k,1),qmin)-ptem)
             381     2   p    v                ptem2      = theta(i,k)-(hvap/cp)*ptem
             382     2   p    v                thlvx(i,k) = ptem2*(1.+fv*qtx(i,k))
             383     2   p    v              enddo

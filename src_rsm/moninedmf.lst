                                   <<< Loop-information  End >>>
             300     2  pp    v              do i=1,im
             301     2   p    v                xkzo(i,k)  = 0.0
             302     2   p    v                xkzmo(i,k) = 0.0
             303     2               !byl          if (k < kinver(i)) then
             304     2               !                                  vertical background diffusivity
             305     2   p    v                  ptem      = prsi(i,k+1) * tx1(i)
             306     2   p    v                  tem1      = 1.0 - ptem
             307     2   p    v                  tem1      = tem1 * tem1 * 10.0
             308     2   p    v                  xkzo(i,k) = xkzm_h * min(1.0, exp(-tem1))
             309     2               
             310     2               !                                  vertical background diffusivity for momentum
             311     3   p    v                  if (ptem >= xkzm_s) then
             312     3   p    v                    xkzmo(i,k) = xkzm_m
             313     3   p    v                    kx1(i)     = k + 1
             314     3   p    v                  else
             315     3   p    v                    if (k == kx1(i) .and. k > 1) tx2(i) = 1.0 / prsi(i,k)
             316     3   p    v                    tem1 = 1.0 - prsi(i,k+1) * tx2(i)
             317     3   p    v                    tem1 = tem1 * tem1 * 5.0
             318     3   p    v                    xkzmo(i,k) = xkzm_m * min(1.0, exp(-tem1))
             319     3   p    v                  endif
             320     2               !byl          endif
             321     2   p    v              enddo

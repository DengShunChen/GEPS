             293     1  pp   2v            do i=1,im
             294     1   p   2v              kx1(i) = 1
             295     1   p   2v              tx1(i) = 1.0 / prsi(i,1)
             296     1   p   2v              tx2(i) = tx1(i)
             297     1   p   2v            enddo
             298                     !>  - Compute background vertical diffusivities for scalars and momentum (xkzo and xkzmo)
             299     1                     do k = 1,km1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 21

            1154     3   p    v                   a1(i,k+1) = u1(i,k+1) + ptem2 * ptem
            1155     3   p    v                   ptem      = vcko(i,k) + vcko(i,k+1)
            1156     3   p    v                   a2(i,k)   = a2(i,k) - ptem1 * ptem

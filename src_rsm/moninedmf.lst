                                   <<< Loop-information  End >>>
             435     1  pp    v            do i = 1,im
             436     1   p    v               sflux(i)  = heat(i) + evap(i)*fv*theta(i,1)
             437     1   p    v               if(.not.sfcflg(i) .or. sflux(i) <= 0.) pblflg(i)=.false.
             438     1   p    v            enddo
             439                     !>  ## Calculate the first estimate of the PBL height (``Predictor step")
             440                     !!  The calculation of the boundary layer height follows Troen and Mahrt (1986) \cite troen_and_mahrt_1986 section 3. The approach is to find the level in the column where a modified bulk Richardson number exceeds a critical value.
             441                     !!
             442                     !!  The temperature of the thermal is of primary importance. For the initial estimate of the PBL height, the thermal is assumed to have one of two temperatures. If the boundary layer is stable, the thermal is assumed to have a temperature equal to the sur
             443                     !  compute the pbl height
             444                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 36
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pblflg, flg, q1, tsea, z0, u10m, v10m
                                   <<<      thvx, rbsoil, rbup, thermal, crb
                                   <<< Loop-information  End >>>
             445     1  pp    v            do i=1,im
             446     1   p    v               flg(i) = .false.
             447     1   p    v               rbup(i) = rbsoil(i)
             448     1               !
             449     2   p    v               if(pblflg(i)) then
             450     2   p    v                 thermal(i) = thvx(i,1)
             451     2   p    v                 crb(i) = crbcon
             452     2   p    v               else
             453     2   p    v                 thermal(i) = tsea(i)*(1.+fv*max(q1(i,1,1),qmin))
             454     2   p    v                 tem = sqrt(u10m(i)**2+v10m(i)**2)
             455     2   p    v                 tem = max(tem, 1.)
             456     2   p    v                 robn = tem / (f0 * z0(i))
             457     2   p    v                 tem1 = 1.e-7 * robn
             458     2   p    v                 crb(i) = 0.16 * (tem1 ** (-0.18))
             459     2   p    v                 crb(i) = max(min(crb(i), crbmax), crbmin)
             460     2   p    v               endif
             461     1   p    v            enddo
             462                     !>  Given the thermal's properties and the critical Richardson number, a loop is executed to find the first level above the surface where the modified Richardson number is greater than the critical Richardson number, using equation 10a from Troen and Mahr
             463                     !!  \f[
             464                     !!  h = Ri\frac{T_0\left|\vec{v}(h)\right|^2}{g\left(\theta_v(h) - \theta_s\right)}
             465                     !!  \f]
             466                     !!  where \f$h\f$ is the PBL height, \f$Ri\f$ is the Richardson number, \f$T_0\f$ is the virtual potential temperature near the surface, \f$\left|\vec{v}\right|\f$ is the wind speed, and \f$\theta_s\f$ is for the thermal. Rearranging this equation to calc
             467                     !!  \f[
             468                     !!  Ri_k = gz(k)\frac{\left(\theta_v(k) - \theta_s\right)}{\theta_v(1)*\vec{v}(k)}
             469                     !!  \f]
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      flg, u1, v1, thermal, zl, thvx, kpbl
                                   <<<      crb, rbup, rbdn
                                   <<< Loop-information  End >>>
             470     1                     do k = 1, kmpbl
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 223
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      thermal, zl, thvx, flg, crb, rbup, u1
                                   <<<      kpbl, rbdn, v1
                                   <<< Loop-information  End >>>
             471     2  pp    v            do i = 1, im
             472     3   p    v              if(.not.flg(i)) then
             473     3   p    v                rbdn(i) = rbup(i)
             474     3   p    v                spdk2   = max((u1(i,k)**2+v1(i,k)**2),1.)
             475     3   p    v                rbup(i) = (thvx(i,k)-thermal(i))* &
             476     3                                   (g*zl(i,k)/thvx(i,1))/spdk2
             477     3   p    v                kpbl(i) = k
             478     3   p    v                flg(i)  = rbup(i) > crb(i)
             479     3   p    v              endif
             480     2   p    v            enddo
             481     1                     enddo
             482                     !>  Once the level is found, some linear interpolation is performed to find the exact height of the boundary layer top (where \f$Ri = Ri_{cr}\f$) and the PBL height and the PBL top index are saved (hpblx and kpblx, respectively)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

             144                     !
             145                           real(kind=kind_phys) theta(im,km),thvx(im,km),  thlvx(im,km),     &
             146                                                qlx(im,km),  thetae(im,km),                  &
             147                                                qtx(im,km),  bf(im,km-1),  diss(im,km),      &
             148                                                radx(im,km-1),                               &
             149                                                govrth(im),  hrad(im),                       &
             150                     !    &                     hradm(im),   radmin(im),   vrad(im),         &
             151                                                radmin(im),  vrad(im),                       &
             152                                                zd(im),      zdd(im),      thlvx1(im)
             153                     !
             154                           real(kind=kind_phys) rdzt(im,km-1),dktx(im,km-1),                 &
             155                                                zi(im,km+1),  zl(im,km),    xkzo(im,km-1),   &
             156                                                dku(im,km-1), dkt(im,km-1), xkzmo(im,km-1),  &
             157                                                cku(im,km-1), ckt(im,km-1),                  &
             158                                                ti(im,km-1),  shr2(im,km-1),                 &
             159                                                al(im,km-1),  ad(im,km),                     &
             160                                                au(im,km-1),  a1(im,km),                     &
             161                                                a2(im,km*ntrac)
             162                     !
             163                           real(kind=kind_phys) tcko(im,km),  qcko(im,km,ntrac),             &
             164                                                ucko(im,km),  vcko(im,km),  xmf(im,km)
             165                     !
             166                           real(kind=kind_phys) prinv(im), rent(im)
             167                     !
             168                           logical  pblflg(im), sfcflg(im), scuflg(im), flg(im)
             169                           logical  ublflg(im), pcnvflg(im)
             170                     !
             171                     !  pcnvflg: true for convective(strongly unstable) pbl
             172                     !  ublflg: true for unstable but not convective(strongly unstable) pbl
             173                     !
             174                           real(kind=kind_phys) aphi16,  aphi5,  bvf2,   wfac, &
             175                                                cfac,    conq,   cont,   conw, &
             176                                                dk,      dkmax,  dkmin, &
             177                                                dq1,     dsdz2,  dsdzq,  dsdzt, &
             178                                                dsdzu,   dsdzv, &
             179                                                dsig,    dt2,    dthe1,  dtodsd, &
             180                                                dtodsu,  dw2,    dw2min, g, &
             181                                                gamcrq,  gamcrt, gocp, &
             182                                                gravi,   f0, &
             183                                                prnum,   prmax,  prmin,  pfac,  crbcon, &
             184                                                qmin,    tdzmin, qtend,  crbmin,crbmax, &
             185                                                rbint,   rdt,    rdz,    qlmin, &
             186                                                ri,      rimin,  rl2,    rlam,  rlamun, &
             187                                                rone,    rzero,  sfcfrac, &
             188                                                spdk2,   sri,    zol1,   zolcr, zolcru, &
             189                                                robn,    ttend, &

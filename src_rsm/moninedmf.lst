             109                                                tau(im,km),    rtg(im,km,ntrac),             &
             110                                                u1(ix,km),     v1(ix,km),                    &
             111                                                t1(ix,km),     q1(ix,km,ntrac),              &
             112                                                swh(ix,km),    hlw(ix,km),                   &
             113                                                xmu(im),                                     &

                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      stress, ustar
                                   <<< Loop-information  End >>>
             431     1  pp   2v            do i=1,im
             432     1   p   2v               ustar(i) = sqrt(stress(i))
             433     1   p   2v            enddo
             434                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

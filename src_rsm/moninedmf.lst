            1176     2  pp    v               do i = 1,im
            1177     2   p    v                  utend = (a1(i,k)-u1(i,k))*rdt
            1178     2   p    v                  vtend = (a2(i,k)-v1(i,k))*rdt
            1179     2               !!            du(i,k)  = du(i,k)  + utend
            1180     2               !!            dv(i,k)  = dv(i,k)  + vtend

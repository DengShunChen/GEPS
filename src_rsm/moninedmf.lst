            1106     3   p   2v                do i = 1,im
            1107     3   p   2v                  tem = 0.5 * (diss(i,k-1)+diss(i,k))
            1108     3   p   2v                  tem  = max(tem, 0.)
            1109     3   p   2v                  ttend = tem / cp
            1110     3   p   2v                  tau(i,k) = tau(i,k) + 0.5*ttend
            1111     3   p   2v                enddo

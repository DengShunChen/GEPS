             814     3   p    v                     ri   = max(bvf2/shr2(i,k),rimin)
             815     3   p    v                     zk   = vk*zi(i,k+1)
             816     4   p    v                     if(ri < 0.) then ! unstable regime
             817     4   p    v                        rl2      = zk*rlamun/(rlamun+zk)
             818     4   p    v                        dk       = rl2*rl2*sqrt(shr2(i,k))
             819     4   p    v                        sri      = sqrt(-ri)
             820     4               !                 dku(i,k) = xkzmo(i,k) + dk*(1+8.*(-ri)/(1+1.746*sri))
             821     4               !                 dkt(i,k) = xkzo(i,k)  + dk*(1+8.*(-ri)/(1+1.286*sri))
             822     4   p    v                        dku(i,k) = dk*(1+8.*(-ri)/(1+1.746*sri))
             823     4   p    v                        dkt(i,k) = dk*(1+8.*(-ri)/(1+1.286*sri))
             824     4   p    v                     else             ! stable regime

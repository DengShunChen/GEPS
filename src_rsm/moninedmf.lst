             525     2   p    v               endif
             526     1   p    v               zol1 = zol(i)*sfcfrac*hpbl(i)/zl(i,1)
             527     2   p    v               if(sfcflg(i)) then
             528     2               !          phim(i) = (1.-aphi16*zol1)**(-1./4.)
             529     2               !          phih(i) = (1.-aphi16*zol1)**(-1./2.)
             530     2   p    v                 tem     = 1.0 / (1. - aphi16*zol1)
             531     2   p    v                 phih(i) = sqrt(tem)
             532     2   p    v                 phim(i) = sqrt(phih(i))
             533     2   p    v               else
             534     2   p    v                 phim(i) = 1. + aphi5*zol1
             535     2   p    v                 phih(i) = phim(i)
             536     2   p    v               endif
             537     1   p    v               wscale(i) = ustar(i)/phim(i)

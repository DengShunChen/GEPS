             211                           parameter(crbcon=0.25,crbmin=0.15,crbmax=0.35)
             212                           parameter(wfac=7.0,cfac=6.5,pfac=2.0,sfcfrac=0.1)
             213                     !     parameter(qmin=1.e-8,xkzm=1.0,zfmin=1.e-8,aphi5=5.,aphi16=16.)
             214                           parameter(qmin=1.e-8,         zfmin=1.e-8,aphi5=5.,aphi16=16.)
             215                           parameter(tdzmin=1.e-3,qlmin=1.e-12,f0=1.e-4)
             216                           parameter(h1=0.33333333,h2=0.66666667)
             217                     !     parameter(cldtime=500.,xkzminv=0.3)
             218                           parameter(cldtime=500.)
             219                     !     parameter(cldtime=500.,xkzmu=3.0,xkzminv=0.3)

             415     2   p    v               bf(i,k) = (thvx(i,k+1)-thvx(i,k))*rdz
             416     2   p    v               ti(i,k) = 2./(t1(i,k)+t1(i,k+1))
             417     2   p    v               dw2  = (u1(i,k)-u1(i,k+1))**2 &
             418     2                             + (v1(i,k)-v1(i,k+1))**2
             419     2   p    v               shr2(i,k) = max(dw2,dw2min)*rdz*rdz
             420     2   p    v            enddo
             421     1   p                 enddo
             422                     !>  - Calculate \f$\frac{g}{\theta}\f$ (govrth), \f$\beta = \frac{\Delta t}{\Delta z}\f$ (beta), \f$u_*\f$ (ustar), total surface flux (sflux), and set pblflag to false if the total surface energy flux is into the surface
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

 External subroutine subprogram "mpe_gather_io"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine mpe_gather_io(a,b,len,nsize)
               2                     !     include 'mpif.h'
               3                           use rank, only : MPI_COMM_gfs
               4                           use mpi
               5                           use const, only: RTYPE,MPI_RTYPE
               6                     !
               7                           implicit  none
               8                           real(kind=RTYPE) a(len*nsize)
               9                           real(kind=RTYPE) b(len)
              10                           integer   len,nsize,iroot,ierr
              11                     !
              12                           iroot=0
              13                     !
              14                           call MPI_BARRIER(MPI_COMM_gfs, IERR)
              15                     !
              16                           call MPI_GATHER( B,LEN,       MPI_RTYPE,                &
              17                                            A,LEN,       MPI_RTYPE,                &
              18                                            IROOT,       MPI_COMM_gfs, IERR )
              19                     !
              20                           return
              21                           end


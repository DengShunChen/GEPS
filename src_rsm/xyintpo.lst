 External subroutine subprogram "gathij"
  (inc)(line-no.)(nest)(optimize)
             478                           subroutine gathij(kp,mn,ix,jy,ijpt,fxx,f,tp2)
             479                     !c
             480                           dimension fxx(ix*jy),f(ix*jy),tp2(mn,4)
             481                           dimension ijpt(mn)
             482                     !c
             483     1                     if(kp.eq.0) then
             484     1               !c
             485     1               !c  lower left corner of interpolation square
             486     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 667
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.62, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tp2, ijpt
                                   <<< Loop-information  End >>>
             487     2  pp   2v            do 10 i=1,mn
             488     2   p   2v            inx= ijpt(i)-ix
             489     2   p   2v            tp2(i,2)= fxx(inx)
             490     2   p   2v            tp2(i,4)= f  (inx)
             491     2   p   2v         10 continue
             492     1               !c
             493     1                     else
             494     1               !c
             495     1               !c  upper left corner of interpolation square
             496     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.87, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ijpt, tp2
                                   <<< Loop-information  End >>>
             497     2  pp   2v            do 20 i=1,mn
             498     2   p   2v            tp2(i,2)= fxx(ijpt(i))
             499     2   p   2v            tp2(i,4)= f  (ijpt(i))
             500     2   p   2v         20 continue
             501     1                     endif
             502                     !c
             503     1                     if(kp.eq.0) then
             504     1               !c  lower right corner of interpolation square
             505     1                     i1= 1-ix
             506     1                     else
             507     1               !c  upper right corner of interpolation square
             508     1                     i1= 1
             509     1                     endif
             510                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.40, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ijpt, tp2
                                   <<< Loop-information  End >>>
             511     1  pp    v            do 30 i=1,mn
             512     1   p    v            inx= ijpt(i)+i1
             513     1   p    v            if(mod(inx,ix).eq.1) inx= inx-ix
             514     1   p    v            tp2(i,1)= fxx(inx)
             515     1   p    v            tp2(i,3)= f  (inx)
             516     1   p    v         30 continue
             517                     !c
             518                           return

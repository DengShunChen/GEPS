 External subroutine subprogram "phi2pt"
  (inc)(line-no.)(nest)(optimize)
             577                     
             578                           subroutine phi2pt(nx,my,lmax,zz,anlslp,t1000,puvphi,sgeo,pt)
             579                     !c
             580                           use const, only: RTYPE
             581                     !c
             582                           dimension sgeo(nx,my),pt(nx,my),zz(nx,my,lmax)
             583                           dimension fld1(nx,lmax+2,my),fld2(nx,lmax+2,my),t1000(nx,my) &
             584                                  , anlslp(nx,my)                                       &
             585                                  , hld1(nx,my),hld2(nx,my)                             &
             586                                  , tens(lmax+2)
             587                           dimension phistd(lmax),puvphi(lmax),pdiff(nx,my)
             588                           real(kind=RTYPE) presp(nx,lmax+2,my)
             589                     !c
             590                           data cp/1004.24/, grav/9.80616/
             591                     !c
             592                           capa= 1.0/3.5
             593                           rgas= capa*cp
             594                     !c
             595                           lmaxp1= lmax + 1
             596                           lmaxp2= lmax + 2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             597     1  pp   4v            do 20 k = 1, lmaxp2
             598     1   p   4v            tens(k) = 1.0
             599     1   p   4v        20  continue
             600                           tens(lmaxp2) = 0.0
             601                           tens(1) = 0.0
             602                     !c
             603                           call geostd ( lmax,puvphi,phistd )
             604                     !c
             605                     !c  read geopotential height
             606                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.02, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      puvphi, zz, fld1, presp, fld2, (unknown)
                                   <<< Loop-information  End >>>
             607     1  pp    v            do 60 k=1,lmax
             608     1   p    v            pstdt= log(puvphi(k))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             609     2  pp                 do 50 j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fld1, presp, zz, fld2
                                   <<< Loop-information  End >>>
             610     3   p   2v            do 50 i=1,nx
             611     3   p   2v            presp(i,k+1,j)= pstdt
             612     3   p   2v            fld2(i,k+1,j)= -grav*zz(i,j,k)
             613     3   p   2v            fld1(i,k+1,j)= -grav*phistd(k)-fld2(i,k+1,j)
             614     2   p   2v        50  continue
             615     1   p             60  continue
             616                     !c
             617                     !c  initialization of terrain pressure
             618                     !c
             619                     !c  define bottom & top boundary condition for pt interpolation
             620                     !c
             621                           l1= 1
             622                           alaps= 6.5e-4
             623                           eps = 0.001
             624                           call ttstd ( 1, 1.0, tp00 )
             625                           call ttstd ( 1, puvphi(1), tp01 )
             626                     !c
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fld2, anlslp, hld1, sgeo, pdiff, presp
                                   <<<      fld1, pt, hld2, t1000
                                   <<<    PREFETCH(SOFT) : 24
                                   <<<     SEQUENTIAL : 24
                                   <<<      fld2: 24
                                   <<< Loop-information  End >>>
             627     1                     do 130 j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 40
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.57, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, t1000, fld2, anlslp, presp, hld1
                                   <<<      pt
                                   <<< Loop-information  End >>>
             628     2  pp    v            do 132 i=1,nx
             629     2   p    v            hld1(i,j)= anlslp(i,j)
             630     2   p    v            pt(i,j)  = 0.1
             631     2               !c
             632     2               !c dealing with inconsistency between anlslp and 1000hPa height
             633     2               !c 2009/12/10
             634     3   p    v            if( fld2(i,lmaxp1,j).gt.0 .and. anlslp(i,j).ge.1000.)then
             635     3   p    v              pxx = log(hld1(i,j))
             636     3   p    v              pt(i,j) = fld2(i,lmaxp1,j)  &
             637     3                              +rgas*t1000(i,j)*(pxx-presp(i,lmaxp1,j))
             638     3   p    v            endif
             639     2               !c
             640     3   p    v            if(sgeo(i,j).le.-1.0) then
             641     3   p    v              px= sgeo(i,j)/(rgas*(t1000(i,j)-alaps*0.5*sgeo(i,j)))
             642     3   p    v              hld1(i,j)= hld1(i,j)*(1.0-px)
             643     3   p    v              pt(i,j)  =-sgeo(i,j) + 0.1
             644     3   p    v            endif
             645     2   p    v        132 continue
             646     1                     call geostd (nx,hld1(1,j),hld2(1,j))
             647     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 37
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hld1, fld1, presp, pt, hld2, fld2, pdiff
                                   <<<      sgeo
                                   <<<    PREFETCH(SOFT) : 18
                                   <<<     SEQUENTIAL : 18
                                   <<<      fld2: 18
                                   <<< Loop-information  End >>>
             648     2  pp    v            do 133 i=1,nx
             649     2   p    v            hld1(i,j) = log(hld1(i,j))
             650     2               !ccc   if ( hld1(i,j) .le. (presp(i,lmaxp1,j)+eps) )  then
             651     3   p    v            if ( hld1(i,j) .le. presp(i,lmaxp1,j) )  then
             652     3   p    v              presp(i,lmaxp2,j)= 2.0*presp(i,lmaxp1,j) - presp(i,lmax,j)
             653     3   p    v              fld2(i,lmaxp2,j) = 2.0*fld2(i,lmaxp1,j) - fld2(i,lmax,j)
             654     3   p    v              fld1(i,lmaxp2,j) = fld1(i,lmaxp1,j)
             655     3   p    v            else
             656     3   p    v              presp(i,lmaxp2,j)= hld1(i,j)
             657     3   p    v              fld2(i,lmaxp2,j) = pt(i,j)
             658     3   p    v              fld1(i,lmaxp2,j) =-fld2(i,lmaxp2,j)-grav*hld2(i,j)
             659     3   p    v            endif
             660     2   p    v            presp(i,1,j)= log(1.0)
             661     2   p    v            fld2(i,1,j) = fld2(i,2,j) - rgas*tp00*(presp(i,2,j)-presp(i,1,j))
             662     2   p    v            fld1(i,1,j) = fld1(i,2,j)
             663     2               !c
             664     2   p    v            pdiff(i,j)  = -sgeo(i,j)
             665     2   p    v            if ((sgeo(i,j).le.0.0).and.(sgeo(i,j).ge.(-1.0+eps)))  &
             666     2                      pdiff(i,j)= 0.0
             667     2               !c
             668     2   p    v        133 continue
             669     1               !c
             670     1               !c  interpolate to get terrain pressure
             671     1               !c  interpolation is of log p - cubic as function of geopotential
             672     1               !c  output is log p in array pt
             673     1               !c
             674     1                     call vterpj( nx,lmaxp2,l1,fld2(1,1,j),presp(1,1,j),pdiff(1,j) &
             675     1                               , pt(1,j),tens)
             676     1               !c
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt
                                   <<< Loop-information  End >>>
             677     2  pp    v            do 135 i=1,nx
             678     2   p    v            pt(i,j)= exp(pt(i,j))
             679     2   p    v        135 continue
             680     1                 130 continue
             681                     !c
             682                           return
             683                           end


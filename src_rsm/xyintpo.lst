             406                           subroutine trdiph (m,n,y)
             407                     !c
             408                     !c  vectorized periodic gaussian elimination solver
             409                     !c
             410                           dimension y(m,n),work(10000)
             411                     !c
             412                     !c gaussian elimination
             413                     !c
             414                           nt2= 2*n
             415                           work(n+1)= 0.25
             416                           v = 1.0
             417                           work(1) = work(n+1)
             418                           work(nt2+1) = work(n+1)
             419                           bn = -v*work(nt2+1)+4.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.23, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             420     1   s   8s            do 101 j=2,n-2
             421     1   p   8v              ne = j+n
             422     1   s   8s              work(ne) = 1.0/(4.0-work(j-1))
             423     1   s   8s              work(j) = work(ne)
             424     1   s   8s              nu = j+nt2
             425     1   s   8s              work(nu) = -work(nu-1)*work(ne)
             426     1   s   8s              v = -v*work(j-1)
             427     1   m   8m              bn = bn-v*work(nu)
             428     1   p   8v        101 continue
             429                     !c
             430                           v = 1.0-v*work(n-2)
             431                           ne = nt2
             432                           work(ne-1) = 1.0/(4.0-work(n-2))
             433                           nu = nt2+n
             434                           work(n-1) = (1.0-work(nu-2))*work(ne-1)
             435                           work(ne) = 1.0/(bn-v*work(n-1))
             436                     !c
             437                           v= 1.0
             438                     !DIR$ IVDEP
             439                     !ocl  novrec
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.22, ITR: 64, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      y, (unknown)
                                   <<< Loop-information  End >>>
             440     1   s   2v            do 201 i=1,m
             441     1   s   2v            y(i,1)= y(i,1)*work(n+1)
             442     1   s   2v            work(i+3*n)=y(i,n)-v*y(i,1)
             443     1   s   2v        201 continue
             444                     !c
                                   <<< Loop-information Start >>>

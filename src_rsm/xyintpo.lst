                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pix, tp2, tp1
                                   <<< Loop-information  End >>>
             372     1  pp    v            do 560 i=1,mn
             373     1   p    v            tp2(i,1)= pix(i,1)*tp2(i,1)
             374     1   p    v            tp2(i,2)= pix(i,2)*tp2(i,2)
             375     1   p    v            tp2(i,3)= pix(i,3)*tp2(i,3)
             376     1   p    v            tp2(i,4)= pix(i,4)*tp2(i,4)
             377     1   p    v            tp1(i,3)=tp2(i,1)+tp2(i,2)+tp2(i,3)+tp2(i,4)
             378     1   p    v        560 continue
             379                     !c

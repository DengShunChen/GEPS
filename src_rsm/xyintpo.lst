 External subroutine subprogram "prexp"
  (inc)(line-no.)(nest)(optimize)
             520                     
             521                     
             522                           subroutine prexp ( nx,lev,ptop,sig,pt,pk,pk2,plt )
             523                     !c
             524                     !c  subroutine to compute p to the kapa on odd and even levels
             525                     !c
             526                     !c *** input ****
             527                     !c
             528                     !c  nx: e-w dimension no.
             529                     !c  lev: number of vertical levels
             530                     !c  sig: sigma levels
             531                     !c  pt: terrain pressure
             532                     !c
             533                     !c *** output ***
             534                     !c
             535                     !c  pk: odd (full) level p**capa
             536                     !c  pk2: even( half) level p**capa
             537                     !c
             538                     !c **************************************************
             539                     !c
             540                     !c
             541                           dimension pt(nx),pk2(nx,lev),pk(nx,lev),sig(lev+1) &
             542                           ,         plt(nx,lev)
             543                     !c
             544                     !csun  include '../include/paramt.h'  .. change im to nx
             545                           dimension pl2(nx,2)
             546                     !c
             547                     !c  compute  pressure variables
             548                     !c
             549                           capa  = 1.0/3.5
             550                           capap1= 1.0+capa
             551                           opok  = 1.0/1000.0**capa
             552                     !c
             553                           kbot= 1
             554                           k= 1
             555                           ptopk= ptop*opok*ptop**capa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.12, ITR: 80, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pl2, pk2, plt, pt
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 52
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             556     1  pp    v            do 80 i=1, nx
             557     1   p    v            pl2(i,kbot)= sig(2)*pt(i)+ptop
             558     1   p    v            pk2(i,1)   = opok*pl2(i,kbot)**capa
             559     1   p    v            pk(i,k)    = (pl2(i,kbot)*pk2(i,k)-ptopk)  &
             560     1                               / (capap1*(pl2(i,kbot)-ptop))
             561     1   p    v            plt(i,k)   = 1000.0*pk(i,k)*pk(i,k)*pk(i,k)*sqrt(pk(i,k))
             562     1   p    v         80 continue
             563                     !c
             564     1                     do 90 k = 2, lev
             565     1                     ktop= kbot
             566     1                     kbot= 3 - ktop
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pl2, pk2, pk, plt
                                   <<< Loop-information  End >>>
             567     2  pp    v            do 90 i = 1, nx
             568     2   p    v            pl2(i,kbot)= sig(k+1)*pt(i)+ptop
             569     2   p    v            pk2(i,k)   = opok*pl2(i,kbot)**capa
             570     2   p    v            pk(i,k)    = (pl2(i,kbot)*pk2(i,k)-pl2(i,ktop)*pk2(i,k-1))  &
             571     2                               / (capap1*(pl2(i,kbot)-pl2(i,ktop)))
             572     2   p    v            plt(i,k)   = 1000.0*pk(i,k)*pk(i,k)*pk(i,k)*sqrt(pk(i,k))
             573     1   p    v         90 continue
             574                     !c
             575                           return
             576                           end


                                   <<<      work, y
                                   <<< Loop-information  End >>>
             450     2  pp    v            do 113 i=1,m
             451     2   p    v            y(i,j)= (y(i,j)-y(i,j-1))*work(ne)
             452     2   p    v            work(i+3*n)= work(i+3*n)-v*y(i,j)
             453     2   p    v        113 continue
             454     1                 103 continue
             455                           v = 1.0-v*work(n-2)
             456                           ne = nt2

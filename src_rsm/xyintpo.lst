             459     1   s    v            do 203 i=1,m
             460     1   m    v            y(i,n-1)=(y(i,n-1)-y(i,n-2))*work(ne-1)
             461     1   s    v            work(i+3*n)= work(i+3*n)-v*y(i,n-1)
             462     1               !c
             463     1               !c backwards substitution
             464     1               !c
             465     1   m    v            y(i,n)= work(i+3*n)*work(ne)

             275                       subroutine init_shum(dtau)
             276                         implicit none
             277                         real :: dtau
             278                         integer :: n, k
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             279     1       f             do n=1,size(shum)
             280     2       f               if (shum(n) > 0) then
             281     2       f                 nshum=nshum + 1
             282     2       f               else
             283     2       f                 exit
             284     2       f               endif
             285     1       f             enddo
             286                     
             287         s   2s            allocate(rpattern_shum(nshum))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      shum, shum_decort, shum_lscale
                                   <<<      shum_seed
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 5  FILL 14
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             288     1   m    s            do n=1,nshum
             289     1   p    v              rpattern_shum(n)%stdev = shum(n)
             290     1   p    v              rpattern_shum(n)%decortau = shum_decort(n)
             291     1   p    v              rpattern_shum(n)%lenscale = shum_lscale(n)
             292     1   p    v              rpattern_shum(n)%seed = int(shum_seed(n))
             293     2   s    s              if (myrank .eq. 0 ) then
             294     2   s    m                write(6,*)'mod_stochastic_physics : shum : stdev  ',shum(n)
             295     2   s    m                write(6,*)'mod_stochastic_physics : shum : decort ',shum_decort(n)
             296     2   s    m                write(6,*)'mod_stochastic_physics : shum : lscale ',shum_lscale(n)
             297     2   s    s                write(6,*)'mod_stochastic_physics : shum : seed   ',shum_seed(n)
             298     2   p    v              endif
             299     1   p    v            enddo
             300                     
             301                           allocate(shum3d(nxp,lev,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      shum3d
                                   <<< Loop-information  End >>>
             302        pp   4v            shum3d = 0.
             303                           call get_random_pattern_init(rpattern_shum,nshum,dtau,.false.)
             304                     
             305                           allocate(vfact_shum(lev))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.81, ITR: 48, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_shum, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             306     1   m    s            do k=1,lev
             307     1   p    v               vfact_shum(k) = exp((sl(k)-1.)/shum_sigefold)
             308     2   p    v               if (sl(k).LT. 2*shum_sigefold) then
             309     2   p    v                  vfact_shum(k)=0.0
             310     2   p    v               endif
             311     1   p    v              if (myrank == 0) print 301,'mod_stochastic_physics : k,sl,vfact_shum',k,sl(k),vfact_shum(k)
             312     1   p    v            enddo
             313                         301 format ( A , I4 , 2F20.12 )
             314                       end subroutine init_shum

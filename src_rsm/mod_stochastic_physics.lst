             451                     
             452                       subroutine get_random_pattern_init(rpattern,nscale,dt,skebrun)
             453                     !---- documentation block
             454                     !  purpose: To generate 2D SPPT strucutre
             455                     !
             456                     !  SPPT 2D 500km example
             457                     !       parameter (ncx=128,mcy=ncx/2)
             458                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             459                     !  SPPT 2D 1000km example
             460                     !       parameter (ncx=64,mcy=ncx/2)
             461                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             462                     !  SPPT 2D 2000km example
             463                     !       parameter (ncx=32,mcy=ncx/2)
             464                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             465                     !---- end of documentation block
             466                     
             467                         implicit none
             468                         integer :: timearray(3),iseed
             469                         integer :: n, k, nscale, ncx, ml, ms, ns, i, j
             470                         real :: rerth, pi, var, radsq, correLsq, rkT, rnn1
             471                         type(random_pattern), intent(inout) :: rpattern(nscale)
             472                         integer :: irand
             473                         real :: dt
             474                         real(kind=RTYPE), allocatable :: noise(:,:)
             475                         integer(8) count, count_rate, count_max, count_trunc
             476                         integer(8) :: iscale = 10000000000
             477                         integer :: count4
             478                         logical :: skebrun
             479                     
             480                         rerth = 6.3712e+6      ! radius of earth (m)
             481                         pi = 4.*atan(1.)
             482                         radsq = rerth*rerth
             483                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             484     1                   do n=1,nscale
             485     1                     ncx = 2.*pi*rerth/rpattern(n)%lenscale
             486     1                  !  rpattern(n)%jtrun = 2*((1+(ncx-1)/3)/2)
             487     1                     rpattern(n)%jtrun = 2*((1+(4*ncx-1)/4)/2)
             488     1                     rpattern(n)%mlmax = rpattern(n)%jtrun*(rpattern(n)%jtrun+1)/2
             489     1               
             490     1                     allocate(rpattern(n)%n2d(nxp,my_max))
             491     2                     if ( doskeb ) then
             492     2                       allocate(rpattern(n)%n2du(nxp,my_max,skeblevs))
             493     2                       allocate(rpattern(n)%n2dv(nxp,my_max,skeblevs))
             494     2                       allocate(rpattern(n)%kenorm(rpattern(n)%mlmax,2))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             495     2  pp   4v              rpattern(n)%n2du(:,:,:)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             496     2  pp   4v              rpattern(n)%n2dv(:,:,:)=0.0
             497     2                     endif
             498     1                     allocate(rpattern(n)%spec(rpattern(n)%mlmax,2))
             499     1                     allocate(rpattern(n)%varspec(rpattern(n)%mlmax))
             500     1                     allocate(rpattern(n)%msort(rpattern(n)%mlmax))
             501     1                     allocate(rpattern(n)%lsort(rpattern(n)%mlmax))
             502     1                     allocate(rpattern(n)%mlsort(rpattern(n)%jtrun,rpattern(n)%jtrun))
             503     1                     allocate(noise(rpattern(n)%mlmax,2))
             504     1               
             505     1                     ! Real random seeds
             506     2                     if (myrank.eq.0) then
             507     3                       if(.not. ncep_seeds) then
             508     3                         call itime(timearray)
             509     3                         iseed=irand(0)
             510     3                         count4=irand(timearray(1)+(i*11467-iseed)*timearray(2) &
             511     3                             +(iseed-i*23)*timearray(3))
             512     3                       else
             513     3                         call system_clock(count, count_rate, count_max)
             514     3                         count_trunc = iscale*(count/iscale)
             515     3                         count4 = count - count_trunc
             516     3                       endif

             673                       subroutine get_stochy_physics(rpattern,nscale,nlev,vfact,n3d)
             674                     !------------------------------------------------------------------------!
             675                     !  purpose: To generate 3D SPPT strucutre
             676                     !  output: n3d
             677                     !------------------------------------------------------------------------!
             678                         implicit none
             679                         integer :: n, ii, i, jj, j, k, nxj, nlev
             680                         integer, intent(in) :: nscale
             681                         real, intent(in) :: vfact(nlev)
             682                         type(random_pattern), intent(inout) :: rpattern(nscale)
             683                         real(kind=RTYPE), intent(  out) :: n3d(nxp,nlev,my_max)
             684                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d
                                   <<< Loop-information  End >>>
             685        pp   4v          n3d = 0.
             686     1                   do n=1,nscale
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             687     2  pp                 do jj=1,jlistnum
             688     2   p                   j=jlist1(jj)
             689     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             690     3   p                   do k=1,nlev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 208, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             691     4   p   2v                do i=1,nxj
             692     4   p   2v                  n3d(i,k,jj)=n3d(i,k,jj)+rpattern(n)%n2d(i,jj)*vfact(k)
             693     4   p   2v                enddo
             694     3   p                   enddo
             695     2   p                 enddo
             696     1                   enddo
             697                     
             698                       end subroutine get_stochy_physics
             699                     
             700                       subroutine get_stochy_physics_vect(rpattern,nscale,nlev,vfact,n3du,n3dv)
             701                     !------------------------------------------------------------------------!
             702                     !  purpose: To generate 3D SKEB strucutre
             703                     !  output: n3du n3dv
             704                     !------------------------------------------------------------------------!
             705                         implicit none
             706                         integer :: n, ii, i, jj, j, k, nxj, nlev
             707                         integer, intent(in) :: nscale
             708                         real, intent(in) :: vfact(nlev)
             709                         type(random_pattern), intent(inout) :: rpattern(nscale)
             710                         real(kind=RTYPE), intent(  out) :: n3du(nxp,nlev,my_max),n3dv(nxp,nlev,my_max)
             711                     
             712                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3dv, n3du
                                   <<< Loop-information  End >>>
             713        pp   2v          n3du = 0.
             714         p   2v          n3dv = 0.
             715     1                   do n=1,nscale
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             716     2  pp                 do jj=1,jlistnum
             717     2   p                   j=jlist1(jj)
             718     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3dv, n3du, (unknown)
                                   <<< Loop-information  End >>>
             719     3   p                   do k=1,nlev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 104, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3du, n3dv, (unknown)
                                   <<< Loop-information  End >>>
             720     4   p    v                do i=1,nxj
             721     4   p    v                  n3du(i,k,jj)=n3du(i,k,jj)+vfact(k)                         &
             722     4                              *(skeb_vwts(k,1)*rpattern(n)%n2du(i,jj,skeb_vpts(k,1))  &
             723     4                              +skeb_vwts(k,2)*rpattern(n)%n2du(i,jj,skeb_vpts(k,2)))
             724     4   p    v                  n3dv(i,k,jj)=n3dv(i,k,jj)+vfact(k)                         &
             725     4                              *(skeb_vwts(k,1)*rpattern(n)%n2dv(i,jj,skeb_vpts(k,1))  &
             726     4                              +skeb_vwts(k,2)*rpattern(n)%n2dv(i,jj,skeb_vpts(k,2)))
             727     4   p    v                enddo
             728     3   p                   enddo
             729     2   p                 enddo
             730     1                   enddo
             731                     
             732                       end subroutine get_stochy_physics_vect

             214                       subroutine init_sppt(dtau)
             215                         implicit none
             216                         real :: dtau
             217                         integer :: n, k
             218                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             219     1       f           do n=1,size(sppt)
             220     2       f             if (sppt(n) > 0) then
             221     2       f               nsppt=nsppt+1
             222     2       f             else
             223     2       f               exit
             224     2       f             endif
             225     1       f           enddo
             226                     

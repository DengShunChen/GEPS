            1307                       subroutine spectrun_inp2d(jcap1,jtr,jtm,mlsort,ns,speci,speco)
            1308                     !
            1309                     ! use spectral truncation to change resoltuion
            1310                     !
            1311                           implicit none
            1312                           integer lev,jtr,jcap1,jtm,ns,ml
            1313                           real(kind=RTYPE) speci(jcap1*(jcap1+1)/2,2)
            1314                           real(kind=RTYPE) speco(jtr,jtm*ns*2)
            1315                           integer i,j,k,jj,jp,jr,j1,j2
            1316                           integer mlsort(jcap1,jcap1)
            1317                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1318        pp   4v            speco(:,:) = 0.0
            1319     1                     if( jcap1.gt.jtr ) then
            1320     2                         do j=1,jcap1
            1321     3                           if( j.le.jtr ) then
            1322     3                             jj=nlist(j)
            1323     3                             jp=(jj-1)/jtm
            1324     3                             jr=mod(jj-1,jtm)+1
            1325     3                             j1=jp*jtm*2+jr
            1326     3                             j2=j1+jtm
            1327     3                           endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1328     3  pp   2s                  do i=j,jcap1
            1329     3   p   2v                    ml=mlsort(j,i)
            1330     4   p   2s                    if( i.le.jtr ) then
            1331     4   p   2s                      speco(i,j1) = speci(ml,1)
            1332     4   p   2s                      speco(i,j2) = speci(ml,2)
            1333     4   p   2v                    endif
            1334     3   p   2v                  enddo
            1335     2                         enddo
            1336     1                     else if( jcap1.lt.jtr ) then
            1337     2                         do j=1,jtr
            1338     2                           jj=nlist(j)
            1339     2                           jp=(jj-1)/jtm
            1340     2                           jr=mod(jj-1,jtm)+1
            1341     2                           j1=jp*jtm*2+jr
            1342     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1343     3  pp   2s                  do i=j,jtr
            1344     4   p   2m                    if( i.le.jcap1 ) then
            1345     4   p   2s                      ml=mlsort(j,i)
            1346     4   p   2s                      speco(i,j1) = speci(ml,1)
            1347     4   p   2s                      speco(i,j2) = speci(ml,2)
            1348     4   p   2v                    endif
            1349     3   p   2v                  enddo
            1350     2                         enddo
            1351     1                     else      ! jcap1=jtr
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1352     2                         do j=1,jtr
            1353     2                           jj=nlist(j)
            1354     2                           jp=(jj-1)/jtm
            1355     2                           jr=mod(jj-1,jtm)+1
            1356     2                           j1=jp*jtm*2+jr
            1357     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 256, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1358     3  pp   2v                  do i=j,jtr
            1359     3   p   2v                    ml=mlsort(j,i)
            1360     3   p   2v                    speco(i,j1) = speci(ml,1)
            1361     3   p   2v                    speco(i,j2) = speci(ml,2)
            1362     3   p   2v                  enddo
            1363     2                         enddo
            1364     1                     endif
            1365                     
            1366                           return
            1367                       end subroutine spectrun_inp2d

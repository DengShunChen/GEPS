             232     1   p    v            rpattern_sppt(n)%seed = int(sppt_seed(n))
             233     2   s    s            if (myrank .eq. 0 ) then
             234     2   s    m              write(6,*)'mod_stochastic_physics : sppt : stdev  ',sppt(n)
             235     2   s    m              write(6,*)'mod_stochastic_physics : sppt : decort ',sppt_decort(n)
             236     2   s    m              write(6,*)'mod_stochastic_physics : sppt : lscale ',sppt_lscale(n)

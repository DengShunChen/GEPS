                                   <<<      bki, aki, sl
                                   <<< Loop-information  End >>>
             117     1  pp    v          do k=1,lev
             118     1   p    v            sl(k)=0.5*(aki(k)/1013.0+bki(k)+aki(k+1)/1013.0+bki(k+1))

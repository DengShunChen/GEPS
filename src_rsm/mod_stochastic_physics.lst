             707                       subroutine lgndr_sppt(my2,jtrun,mlmax,mlsort,sinl,poly,dpoly)
             708                     !
             709                     !   generate legendre polynomials and their derivatives on the
             710                     !   gaussian latitudes
             711                     !
             712                     !  ***input***
             713                     !
             714                     !   my2:  number of gaussian latitudes from south pole and equator
             715                     !   jtrun:  zonal wavenumber truncation limit
             716                     !   mlmax: total number of triangular truncation spherical harmonics
             717                     !   mlsort: pointer array of 1-d indexs at functions of zonal and
             718                     !           total wavenumbers
             719                     !   sinl: sin of gaussian latitudes
             720                     !
             721                     !   ***output***
             722                     !
             723                     !   poly: associated legendre coefficients
             724                     !   dpoly: d(poly)/d(sinl)
             725                     !
             726                     !  ******************************************************************
             727                     !
             728                     !  ref= belousov, s. l., 1962= tables of normalized associated
             729                     !         legendre polynomials. pergamon press, new york
             730                     !
             731                           integer :: j, n, np, kp, k, mp, m, nps, l, ml, m1, mk
             732                           integer :: my2, jtrun, mlmax, jtrunp
             733                           real(kind=RTYPE) :: poly(mlmax,my2),dpoly(mlmax,my2),sinl(my2)
             734                           integer :: mlsort(jtrun,jtrun)
             735                     !
             736                     !       parameter (jtrunx= 100)
             737                           real :: pnm(jtrun+1,jtrun+1),dpnm(jtrun+1,jtrun+1)
             738                           real :: xx, sn, sn2i, rt2, c1, fn, fn2, fn2s, c3, s1, s2, c4, c5, c6, cf
             739                           real :: a, b, fk, fm, fm1, fm2, fm3, c7, c8, c, d, e, fms, fnp, fnp2
             740                           real :: theta, ang
             741                     !
             742                     !  sinl is sin(latitude) = cos(colatitude)
             743                     !  pnm(np,mp) is legendre polynomial p(n,m) with np=n+1, mp=m+1
             744                     !  pnm(mp,np+1) is x derivative of p(n,m) with np=n+1, mp=m+1
             745                     !
             746                           jtrunp= jtrun+1
             747     1                     do 1001 j=1,my2
             748     1                     xx= sinl(j)
             749     1                     sn= sqrt(1.0-xx*xx)
             750     1                 sn2i = 1.0/(1.0 - xx*xx)
             751     1                     rt2= sqrt(2.0)
             752     1                 c1 = rt2
             753     1               !
             754     1                 pnm(1,1) = 1.0/rt2
             755     1                     theta=-atan(xx/sqrt(1.0-xx*xx))+2.0*atan(1.0)
             756     1               !
             757     2                     do 20 n=1,jtrun
             758     2                 np = n + 1
             759     2                     fn=n
             760     2                 fn2 = fn + fn
             761     2                 fn2s = fn2*fn2
             762     2               !  eq 22
             763     2                     c1= c1*sqrt(1.0-1.0/fn2s)
             764     2                     c3= c1/sqrt(fn*(fn+1.0))
             765     2                 ang = fn*theta
             766     2                 s1 = 0.0
             767     2                 s2 = 0.0
             768     2                 c4 = 1.0
             769     2                 c5 = fn
             770     2                 a = -1.0
             771     2                 b = 0.0
             772     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             773     3   s    s            do 27 kp=1,np,2
             774     3   p    v        k = kp - 1
             775     3   m    m            s2= s2+c5*sin(ang)*c4
             776     3   p    v            if (k.eq.n) c4 = 0.5*c4
             777     3   m    m            s1= s1+c4*cos(ang)
             778     3   s    s        a = a + 2.0
             779     3   s    s        b = b + 1.0
             780     3   p    v            fk=k
             781     3   m    m        ang = theta*(fn - fk - 2.0)
             782     3   s    s        c4 = (a*(fn - b + 1.0)/(b*(fn2 - a)))*c4
             783     3   s    s        c5 = c5 - 2.0
             784     3   p    v         27 continue
             785     2               !  eq 19
             786     2                 pnm(np,1) = s1*c1
             787     2               !  eq 21
             788     2                 pnm(np,2) = s2*c3
             789     2                  20 continue
             790     1               !
             791     2                     do 4 mp=3,jtrunp
             792     2                 m = mp - 1
             793     2                     fm= m
             794     2                 fm1 = fm - 1.0
             795     2                 fm2 = fm - 2.0
             796     2                 fm3 = fm - 3.0
             797     2                     c6= sqrt(1.0+1.0/(fm+fm))
             798     2               !  eq 23
             799     2                 pnm(mp,mp) = c6*sn*pnm(m,m)
             800     2                     if (mp - jtrunp) 3,4,4
             801     2                   3 continue
             802     2                 nps = mp + 1
             803     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm
                                   <<< Loop-information  End >>>
             804     3   s    s            do 41 np=nps,jtrunp
             805     3   p    v        n = np - 1
             806     3   p    v            fn= n
             807     3   p    v        fn2 = fn + fn
             808     3   p    v        c7 = (fn2 + 1.0)/(fn2 - 1.0)
             809     3   p    v        c8 = (fm1 + fn)/((fm + fn)*(fm2 + fn))
             810     3   p    v            c= sqrt((fn2+1.0)*c8*(fm3+fn)/(fn2-3.0))
             811     3   p    v            d= -sqrt(c7*c8*(fn-fm1))
             812     3   p    v            e= sqrt(c7*(fn-fm)/(fn+fm))
             813     3               !  eq 17
             814     3   m    m        pnm(np,mp) = c*pnm(np-2,mp-2) &
             815     3                                + xx*(d*pnm(np-1,mp-2) + e*pnm(np - 1,mp))
             816     3   p    v         41 continue
             817     2                   4 continue
             818     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
             819     2  pp                 do 50 mp=1,jtrun
             820     2   p                 fm= mp-1.0
             821     2   p             fms = fm*fm
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.56, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pnm, dpnm
                                   <<< Loop-information  End >>>
             822     3   p    v            do 50 np=mp,jtrun
             823     3   p    v            fnp= np
             824     3   p    v        fnp2 = fnp + fnp
             825     3   p    v        cf = (fnp*fnp - fms)*(fnp2 - 1.0)/(fnp2 + 1.0)
             826     3   p    v            cf= sqrt(cf)
             827     3               !  der
             828     3   p    v            dpnm(np,mp)   = -sn2i*(cf*pnm(np+1,mp) - fnp*xx*pnm(np,mp))
             829     2   p    v         50 continue
             830     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpnm, pnm
                                   <<< Loop-information  End >>>
             831     2                     do 71 m=1,jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.20, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dpnm, pnm
                                   <<< Loop-information  End >>>
             832     3   s   2v            do 71 l=m,jtrun
             833     3   p   2v            ml= mlsort(m,l)
             834     3   m   2v            poly(ml,j)= pnm(l,m)
             835     3   s   2v            dpoly(ml,j)=dpnm(l,m)
             836     2   p   2v         71 continue
             837     1                     dpoly(1,j)= 0.0
             838     1                1001 continue
             839                     
             840                       end subroutine lgndr_sppt
             841                     
             842                       subroutine transr_sppt (jtrun,mlmax,nx,my,ll,poly,s,r)
             843                     !   subroutine to transform a spectral coefficient field to
             844                     !   grid point form
             845                     !
             846                     !  *** const ***
             847                     !
             848                     !   jtrun: zonal wavenumber resolution limit
             849                     !   mlmax: number of spectral coefficients (horizontal field)
             850                     !   nx: e-w dimension no.
             851                     !   my: n-s dimension no.
             852                     !   ll: number of levels to transform
             853                     !   poly: legendre polynomials
             854                     !
             855                     !  *** input variable ***
             856                     !
             857                     !   s: spectral coefficient array to transform
             858                     !
             859                     !  *** output variable ***
             860                     !
             861                     !   r: 3-d output grid point fields
             862                     !
             863                     !   **************************************
             864                     
             865                           use fftcom
             866                           real :: poly(mlmax,my/2),s(mlmax,2,ll),r(nx,ll,my)
             867                           real :: cc(nx+2,my),work(nx*my,2)
             868                           integer :: mlmax,my,nx,ll,jtrun
             869                           integer :: mlx,i,k,m,j,jj,ml,mm,mp
             870                           integer :: m1, l, mk, n
             871                     
             872                           mlx= (jtrun/2)*((jtrun+1)/2)
             873     1                     do k=1,ll
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc
                                   <<< Loop-information  End >>>
             874     2  pp   2v              do m=1,(nx+2)*my/2
             875     2   p   2v                cc(m,1)= 0.0
             876     2   p   2v                cc(m,my/2+1)= 0.0
             877     2   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      s, poly, cc
                                   <<< Loop-information  End >>>
             878     2                       do j=1,my/2
             879     2                         jj = my+1-j
             880     2                         ml = 2*mlx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cc, s, poly
                                   <<< Loop-information  End >>>
             881     3  pp    v                do m=2,jtrun,2
             882     3   p    v                  ml = ml+1
             883     3   p    v                  mm = 2*m-1
             884     3   p    v                  mp = mm+1
             885     3   p    v                  cc(mm,j ) = poly(ml,j)*s(ml,1,k)
             886     3   p    v                  cc(mp,j ) = poly(ml,j)*s(ml,2,k)
             887     3   p    v                  cc(mm,jj) = cc(mm,j)

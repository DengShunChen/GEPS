             247     2   p   2v            if (sl(k) .lt. sppt_sigtop1 .and. sl(k) .gt. sppt_sigtop2) then
             248     2   p   2v               vfact_sppt(k) = (sl(k)-sppt_sigtop2)/(sppt_sigtop1-sppt_sigtop2)
             249     2   p   2v            else if (sl(k) .lt. sppt_sigtop2) then
             250     2   p   2v                vfact_sppt(k) = 0.0
             251     2   p   2v            else
             252     2   p   2v                vfact_sppt(k) = 1.0
             253     2   p   2v            endif
             254     1   p   2v          enddo
             255                     
             256     1                   if (sppt_sfclimit) then
             257     1                   ! vfact_sppt(lev-1)=vfact_sppt(lev-2)*0.5
             258     1                   ! vfact_sppt(lev)=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_sppt
                                   <<< Loop-information  End >>>
             259     2  pp   2v            do k=1,lev
             260     3   p   2v              if (sl(k) .lt. sppt_sigbot1 .and. sl(k) .gt. sppt_sigbot2) then
             261     3   p   2v                 vfact_sppt(k) = 1. - (sl(k)-sppt_sigbot2)/(sppt_sigbot1-sppt_sigbot2)
             262     3   p   2v              else if (sl(k) .gt. sppt_sigbot1) then
             263     3   p   2v                  vfact_sppt(k) = 0.0
             264     3   p   2v              endif
             265     2   p   2v            enddo
             266     1                   endif
             267                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vfact_sppt, sl
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             268     1   s    s          do k=1,lev
             269     1   m    m            if (myrank == 0) print 301,'mod_stochastic_physics : k,sl,vfact_sppt',k,sl(k),vfact_sppt(k)
             270     1   p    v          enddo
             271                         301 format ( A , I4 , 2F20.12 )
             272                     
             273                       end subroutine init_sppt

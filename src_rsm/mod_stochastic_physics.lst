             760                       subroutine gen_random_pattern_2d(rpattern)
             761                     
             762                         implicit none
             763                         type(random_pattern), intent(inout) :: rpattern
             764                         !real(kind=RTYPE), intent(out) :: sppt2d(nxp,my_max)
             765                         integer :: ml, ns, ms
             766                         real(kind=RTYPE), allocatable :: noise(:,:)
             767                         real(kind=RTYPE), allocatable :: specp(:,:,:),bufr2d(:,:,:)
             768                     
             769                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             770                         allocate(specp(jtrun,jtmax,2))
             771                     
             772     1                   if ( col_rank .eq. 0 ) then
             773     1                     ! get noise
             774     1                     allocate(noise(rpattern%mlmax,2))
             775     1                     call get_noise(rpattern,noise)
             776     1               
             777     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.54, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             778     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             779     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.70, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             780     1  pp   2v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             781     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             782     1               
             783     1                     ! ready for mpi_scatter random pattern
             784     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             785     1                                        ,rpattern%mlsort,nsizey             &
             786     1                                        ,rpattern%spec,bufr2d)
             787     1               
             788     1                     deallocate(noise)
             789     1                   endif
             790                     
             791                         !  mpi_scatter random pattern from root
             792                         call mpe_scatter_sppt(bufr2d,specp,2*jtrun*jtmax,nsizey)
             793                     
             794                         ! transform spectral to physical space
             795                         call transr1(jtrun,jtmax,nx,my,my_max,poly,specp,rpattern%n2d,nsizey)
             796                     
             797                         deallocate(bufr2d)
             798                         deallocate(specp)
             799                     
             800                       end subroutine gen_random_pattern_2d
             801                     
             802                       subroutine gen_random_pattern_2d_vect(rpattern,k)
             803                     
             804                         implicit none
             805                         type(random_pattern), intent(inout) :: rpattern
             806                         integer :: ml, ns, ms, k
             807                         real(kind=RTYPE), allocatable :: specpv(:,:,:),specpd(:,:,:)
             808                         real(kind=RTYPE), allocatable :: bufr2d(:,:,:) ,noise(:,:) ,specf(:,:)
             809                     
             810                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             811                         allocate(specpd(jtrun,jtmax,2)) !divergence
             812                         allocate(specpv(jtrun,jtmax,2)) !vorticity
             813                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specpd
                                   <<< Loop-information  End >>>
             814        pp   4v          specpd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specpv
                                   <<< Loop-information  End >>>
             815        pp   4v          specpv = 0.0
             816                     
             817     1                   if ( col_rank .eq. 0 ) then
             818     1                     ! get noise
             819     1                     allocate(noise(rpattern%mlmax,2))
             820     1                     allocate(specf(rpattern%mlmax,2))
             821     1                     call get_noise(rpattern,noise)
             822     1               
             823     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.54, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             824     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             825     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.54, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             826     1  pp   4v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             827     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             828     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.80, ITR: 136, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      specf, (unknown)
                                   <<< Loop-information  End >>>
             829     1  pp    v            specf(:,1) = rpattern%kenorm(:,1) * rpattern%spec(:,1)
             830     1   p    v            specf(:,2) = rpattern%kenorm(:,2) * rpattern%spec(:,2)
             831     1               
             832     1                     ! ready for mpi_scatter random pattern
             833     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             834     1                                        ,rpattern%mlsort,nsizey             &
             835     1                                        ,specf,bufr2d)
             836     1               
             837     1                     deallocate(noise)
             838     1                     deallocate(specf)
             839     1                   endif
             840                     
             841                         !  mpi_scatter random pattern from root
             842                         call mpe_scatter_sppt(bufr2d,specpv,2*jtrun*jtmax,nsizey)
             843                     
             844                         !  spectral transform for velocity components
             845                         call tranuv1 (jtrun,jtmax,nx,my,my_max,1,onocos,wcfac,wdfac &
             846                                     , poly,dpoly,specpv,specpd,rpattern%n2du(1,1,k),rpattern%n2dv(1,1,k),nsizey)
             847                     
             848                         deallocate(bufr2d)
             849                         deallocate(specpd)
             850                         deallocate(specpv)
             851                     
             852                       end subroutine gen_random_pattern_2d_vect
             853                     
             854                       SUBROUTINE avevar_sppt(data,n,ave,var,std)
             855                           INTEGER n
             856                           REAL ave,var,data(n)
             857                           INTEGER j
             858                           REAL s,ep,std
             859                           ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             860     1  pp    v            do j=1,n
             861     1   p    v              ave=ave+data(j)
             862     1   p    v            enddo
             863                           ave=ave/n
             864                           var=0.0
             865                           ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             866     1  pp    v            do j=1,n
             867     1   p    v              s=data(j)-ave
             868     1   p    v              ep=ep+s
             869     1   p    v              var=var+s*s
             870     1   p    v            enddo
             871                           var=(var-ep**2/n)/n
             872                           std=sqrt(var)
             873                     
             874                       end SUBROUTINE avevar_sppt
             875                     !
             876                     !
             877                       SUBROUTINE avevar_sppt2d(data2d,n,m,ave,var,std)
             878                         INTEGER :: n,m,nmdim
             879                         REAL :: ave,var,data(n*m)
             880                         REAL(kind=RTYPE) :: data2d(n,m)
             881                         INTEGER :: i,j
             882                         REAL :: s,ep,std
             883                     
             884                         nmdim=0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             885     1                   do j=1,m
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             886     2  pp   2v            do i=1,n
             887     2   p   2v            nmdim=nmdim+1
             888     2   p   2v            data(nmdim)=data2d(i,j)
             889     2   p   2v            enddo
             890     1                   enddo
             891                     
             892                         ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             893     1  pp    v          do j=1,nmdim
             894     1   p    v            ave=ave+data(j)
             895     1   p    v          enddo
             896                         ave=ave/nmdim
             897                         var=0.0
             898                         ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             899     1  pp    v          do j=1,nmdim
             900     1   p    v            s=data(j)-ave
             901     1   p    v            ep=ep+s
             902     1   p    v            var=var+s*s
             903     1   p    v          enddo
             904                     !   var=(var-ep**2/n)/(n-1)    ! sample numners < 30
             905                         var=(var-ep**2/nmdim)/nmdim
             906                         std=sqrt(var)
             907                       end SUBROUTINE avevar_sppt2d
             908                     !
             909                       subroutine spptout(tau)
             910                         implicit none
             911                         integer      :: i, j, k, jj, nxj, ihead, n
             912                         integer      :: nxmy4
             913                         real         :: tau
             914                         real*4       :: glob4(nx,my)
             915                         real(kind=RTYPE) :: glob(nx,my),temp(nxp,my_max)
             916                     
             917                         ihead=15
             918                         nxmy4=nx*my*4
             919     1                   if ( myrank .eq. 0 ) then
             920     1                     open(ihead,file='sppt.dat',access='direct',form='unformatted',recl=nxmy4,status='unknown')
             921     1                   endif
             922                     
             923     1                   do n=1,nsppt
             924     1                     call unify_reduceintp(nx,my,my_max,rpattern_sppt(n)%n2d,glob)
             925     2                     if ( myrank .eq. 0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
             926     2  pp   4v              glob4=glob
             927     2                       write(ihead,rec=recnsppt) glob4
             928     2                       recnsppt=recnsppt+1
             929     2                     endif
             930     1                   enddo
             931     1                   do k=lev,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sppt3d, temp
                                   <<< Loop-information  End >>>
             932     2  pp                 do jj=1,jlistnum
             933     2   p                   j=jlist1(jj)
             934     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sppt3d, temp
                                   <<< Loop-information  End >>>
             935     3   p   2v              do i=1,nxj
             936     3   p   2v              temp(i,jj)=sppt3d(i,k,jj)
             937     3   p   2v              enddo
             938     2   p                 enddo
             939     1                     call unify_reduceintp(nx,my,my_max,temp,glob)
             940     2                     if ( myrank.eq.0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
             941     2  pp   4v              glob4=glob
             942     2                       write(ihead,rec=recnsppt) glob4
             943     2                       recnsppt=recnsppt+1
             944     2                     endif
             945     1                   enddo
             946                     
             947                         if ( myrank.eq.0 ) close(ihead)
             948                     
             949                         !creating ctl file
             950                         call spptctl(tau)
             951                     
             952                       end subroutine spptout
             953                     !----
             954                       subroutine skebest(um,vm)
             955                         use grid,  only : ut,vt
             956                         implicit none
             957                     
             958                         integer :: n, ii, i, jj, j, k, nxj
             959                         real    :: xx
             960                         real(kind=RTYPE) :: spectmp(levp,2,jtrun,jtmax),                 &
             961                                             cc(nx+2,levp,1,my_max),                      &
             962                                             um(nxp,lev,my_max),vm(nxp,lev,my_max),       &
             963                                             dummy
             964                     
             965                         ! estimate the dissipation of kinectic energy for SKEB
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             966     1  pp                   do jj =1,jlistnum
             967     1   p                     j=jlist1(jj)
             968     1   p                     nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      um, ut, vt, vm, diss_est
                                   <<< Loop-information  End >>>
             969     2   p                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vm, vt, um, ut, diss_est
                                   <<< Loop-information  End >>>
             970     3   p    v                  do i=1,nxj
             971     3   p    v                    diss_est(i,k,jj)=(um(i,k,jj)*ut(i,k,jj)                &
             972     3                                              +vm(i,k,jj)*vt(i,k,jj))               &
             973     3                                              +0.5*(um(i,k,jj)**2.+vm(i,k,jj)**2.)
             974     3   p    v                  enddo
             975     2   p                     enddo
             976     1   p                   enddo
             977                             call joinrs(cc,diss_est,dummy,dummy,dummy,nx,my_max,lev      &
             978                                        ,jlistnum,1,1)
             979                             call tranrs(jtrun,jtmax,nx,my,my_max,levp,poly,weight,cc     &
             980                                        ,spectmp,1,nsizey)
             981                             ! apply spectral filter of the dissipation of kinetic energy
             982                             call filter_skeb(jtrun,jtmax,levp,spectmp,skebfilt)
             983                             call transr(jtrun,jtmax,nx,my,my_max,levp,poly,spectmp,cc,1,nsizey)
             984                             call ujoinsr(cc,diss_est,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             985                     !
             986                     !        if ( myrank .eq. 0 ) print *,'intgrt: diss_est(1,72,1)=',diss_est(1,72,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             987     1  pp                   do jj = 1, jlistnum
             988     1   p                     j=jlist1(jj)
             989     1   p                     nxj=nxdef_2d(j)
             990     1   p                     xx=radsq*onocos(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      diss_est, skeb3du, ut, skeb3dv, vt, keb
                                   <<<      kea
                                   <<< Loop-information  End >>>
             991     2   p                     do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.11, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      diss_est, ut, skeb3du, skeb3dv, vt, kea
                                   <<<      keb
                                   <<< Loop-information  End >>>
             992     3   p    v                  do i = 1, nxj
             993     3   p    v                    keb(i,k,jj)=0.5*(ut(i,k,jj)**2.+vt(i,k,jj)**2.)*xx
             994     3   p    v                    ut(i,k,jj)=ut(i,k,jj)+skeb3du(i,k,jj)*diss_est(i,k,jj)
             995     3   p    v                    vt(i,k,jj)=vt(i,k,jj)+skeb3dv(i,k,jj)*diss_est(i,k,jj)
             996     3   p    v                    kea(i,k,jj)=0.5*(ut(i,k,jj)**2.+vt(i,k,jj)**2.)*xx
             997     3   p    v                  enddo
             998     2   p                     enddo
             999     1   p                   enddo
            1000                     !        if ( myrank .eq. 0 ) print *,'intgrt: keb(1,72,1)=',keb(1,72,1)
            1001                     !        if ( myrank .eq. 0 ) print *,'intgrt: kea(1,72,1)=',kea(1,72,1)
            1002                     
            1003                       end subroutine skebest
            1004                     !----
            1005                       subroutine skebout(tau)
            1006                         implicit none
            1007                         integer      :: i, j, k, jj, nxj, ihead, n
            1008                         integer      :: nxmy4
            1009                         real         :: tau,xx
            1010                         real(kind=RTYPE):: glob(nx,my),temp(nxp,my_max)
            1011                         real(kind=4) :: glob4(nx,my)
            1012                     
            1013                     
            1014                         ihead=15
            1015                         nxmy4=nx*my*4
            1016     1                   if ( myrank .eq. 0 ) then
            1017     1                     open(ihead,file='skeb.dat',access='direct',form='unformatted',recl=nxmy4,status='unknown')
            1018     1                   endif
            1019                     
            1020     1                   do k=lev,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb3du, temp
                                   <<< Loop-information  End >>>
            1021     2  pp                 do jj=1,jlistnum
            1022     2   p                   j=jlist1(jj)
            1023     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb3du, temp
                                   <<< Loop-information  End >>>
            1024     3   p   2v              do i=1,nxj
            1025     3   p   2v              temp(i,jj)=skeb3du(i,k,jj)
            1026     3   p   2v              enddo
            1027     2   p                 enddo
            1028     1                     call unify_reduceintp(nx,my,my_max,temp,glob)
            1029     2                     if ( myrank.eq.0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
            1030     2  pp   4v              glob4=glob
            1031     2                       write(ihead,rec=recnskeb) glob4
            1032     2                       recnskeb=recnskeb+1
            1033     2                     endif
            1034     1                   enddo
            1035                     
            1036     1                   do k=lev,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb3dv, temp
                                   <<< Loop-information  End >>>
            1037     2  pp                 do jj=1,jlistnum
            1038     2   p                   j=jlist1(jj)
            1039     2   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      skeb3dv, temp
                                   <<< Loop-information  End >>>
            1040     3   p   2v              do i=1,nxj
            1041     3   p   2v              temp(i,jj)=skeb3dv(i,k,jj)
            1042     3   p   2v              enddo
            1043     2   p                 enddo
            1044     1                     call unify_reduceintp(nx,my,my_max,temp,glob)
            1045     2                     if ( myrank.eq.0 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, glob4
                                   <<< Loop-information  End >>>
            1046     2  pp   4v              glob4=glob
            1047     2                       write(ihead,rec=recnskeb) glob4
            1048     2                       recnskeb=recnskeb+1
            1049     2                     endif
            1050     1                   enddo
            1051                     
            1052     1                   do k=lev,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      diss_est, temp
                                   <<< Loop-information  End >>>
            1053     2  pp                 do jj=1,jlistnum
            1054     2   p                   j=jlist1(jj)
            1055     2   p                   nxj=nxdef_2d(j)
            1056     2   p                   xx=radsq*onocos(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      diss_est, temp
                                   <<< Loop-information  End >>>
            1057     3   p   2v              do i=1,nxj
            1058     3   p   2v                temp(i,jj)=diss_est(i,k,jj)*xx
            1059     3   p   2v              enddo
            1060     2   p                 enddo

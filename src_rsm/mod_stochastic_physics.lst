             256                           call get_random_pattern_init(rpattern_shum,nshum,dtau)
             257                     
             258                           allocate(vfact_shum(lev))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.81, ITR: 48, MVE: 3, POL: S)
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sl, vfact_shum, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             259     1   m    s            do k=1,lev
             260     1   p    v               vfact_shum(k) = exp((sl(k)-1.)/shum_sigefold)
             261     2   p    v               if (sl(k).LT. 2*shum_sigefold) then
             262     2   p    v                  vfact_shum(k)=0.0
             263     2   p    v               endif
             264     1   p    v              if (myrank == 0) print *,'mod_stochastic_physics : k,sl,vfact_shum',k,sl(k),vfact_shum(k)
             265     1   p    v            enddo
             266                       end subroutine init_shum
             267                     
             268                       subroutine init_ssst(dtau)
             269                         implicit none
             270                         real :: dtau
             271                         integer :: n, k
             272                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             273     1       f           do n=1,size(ssst)
             274     2       f             if (ssst(n) > 0) then
             275     2       f               nssst=nssst+1
             276     2       f             else
             277     2       f               exit
             278     2       f             endif
             279     1       f           enddo
             280                     
             281         s   2s          allocate(rpattern_ssst(nssst))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ssst, ssst_decort, ssst_lscale
                                   <<<      ssst_seed
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 12
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             282     1   m    s          do n=1,nssst
             283     1   p    v            rpattern_ssst(n)%stdev    = ssst(n)
             284     1   p    v            rpattern_ssst(n)%decortau = ssst_decort(n)
             285     1   p    v            rpattern_ssst(n)%lenscale = ssst_lscale(n)
             286     1   p    v            rpattern_ssst(n)%seed = int(ssst_seed(n))
             287     2   s    s            if (myrank .eq. 0 ) then
             288     2   s    m              write(6,*)'mod_stochastic_physics : ssst : stdev  ',ssst(n)
             289     2   s    m              write(6,*)'mod_stochastic_physics : ssst : decort ',ssst_decort(n)
             290     2   s    m              write(6,*)'mod_stochastic_physics : ssst : lscale ',ssst_lscale(n)
             291     2   s    s              write(6,*)'mod_stochastic_physics : ssst : seed   ',ssst_seed(n)
             292     2   p    v            endif
             293     1   p    v          enddo
             294                     
             295                         allocate(ssst3d(nxp,1,my_max))
             296                         call get_random_pattern_init(rpattern_ssst,nssst,dtau)
             297                     
             298                         allocate(vfact_ssst(1))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             299             f           vfact_ssst = 1.
             300                     
             301                       end subroutine init_ssst
             302                     
             303                       subroutine get_random_pattern_init(rpattern,nscale,dt)
             304                     !---- documentation block
             305                     !  purpose: To generate 2D SPPT strucutre
             306                     !
             307                     !  SPPT 2D 500km example
             308                     !       parameter (ncx=128,mcy=ncx/2)
             309                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             310                     !  SPPT 2D 1000km example
             311                     !       parameter (ncx=64,mcy=ncx/2)
             312                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             313                     !  SPPT 2D 2000km example
             314                     !       parameter (ncx=32,mcy=ncx/2)
             315                     !       parameter (jtrun= 2*((1+(ncx-1)/3)/2), mlmax= jtrun*(jtrun+1)/2)
             316                     !---- end of documentation block
             317                     
             318                         implicit none
             319                         integer :: timearray(3),iseed
             320                         integer :: n, k, nscale, ncx, ml, ms, ns
             321                         real :: rerth, pi, var, radsq, correLsq, rkT
             322                         type(random_pattern), intent(inout) :: rpattern(nscale)
             323                         integer :: irand, i
             324                         real :: dt
             325                         real(kind=RTYPE), allocatable :: noise(:,:)
             326                         integer(8) count, count_rate, count_max, count_trunc
             327                         integer(8) :: iscale = 10000000000
             328                         integer :: count4
             329                     
             330                         rerth = 6.3712e+6      ! radius of earth (m)
             331                         pi = 4.*atan(1.)
             332                         radsq = rerth*rerth
             333                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             334     1                   do n=1,nscale
             335     1                     ncx = 2.*pi*rerth/rpattern(n)%lenscale
             336     1                  !  rpattern(n)%jtrun = 2*((1+(ncx-1)/3)/2)
             337     1                     rpattern(n)%jtrun = 2*((1+(4*ncx-1)/4)/2)
             338     1                     rpattern(n)%mlmax = rpattern(n)%jtrun*(rpattern(n)%jtrun+1)/2
             339     1               
             340     1                     allocate(rpattern(n)%n2d(nxp,my_max))
             341     1                     allocate(rpattern(n)%spec(rpattern(n)%mlmax,2))
             342     1                     allocate(rpattern(n)%varspec(rpattern(n)%mlmax))
             343     1                     allocate(rpattern(n)%msort(rpattern(n)%mlmax))
             344     1                     allocate(rpattern(n)%lsort(rpattern(n)%mlmax))
             345     1                     allocate(rpattern(n)%mlsort(rpattern(n)%jtrun,rpattern(n)%jtrun))
             346     1                     allocate(noise(rpattern(n)%mlmax,2))
             347     1               
             348     1                     ! Real random seeds
             349     2                     if (myrank.eq.0) then
             350     3                       if(.not. ncep_seeds) then
             351     3                         call itime(timearray)
             352     3                         iseed=irand(0)
             353     3                         count4=irand(timearray(1)+(i*11467-iseed)*timearray(2) &
             354     3                             +(iseed-i*23)*timearray(3))
             355     3                       else
             356     3                         call system_clock(count, count_rate, count_max)
             357     3                         count_trunc = iscale*(count/iscale)
             358     3                         count4 = count - count_trunc
             359     3                       endif
             360     2                     endif
             361     1                     call mpe_bcast(count4,1,0,mpe_double)
             362     2                     if (rpattern(n)%seed == -999 ) then
             363     2                       rpattern(n)%seed = count4
             364     2                     endif
             365     1                     if (myrank.eq.0) write(6,*)'scale',n,' : using seed :',rpattern(n)%seed
             366     1                     call random_setseed(rpattern(n)%seed,rpattern(n)%rstate)
             367     1               
             368     1                     ! horizontal decorrelation
             369     1                     correLsq = rpattern(n)%lenscale*rpattern(n)%lenscale
             370     1                     rkT = 0.25*correLsq/radsq
             371     1                     if (myrank.eq.0)  write(6,*)'mod_stochastic_physics : n,rkT = ',n,rkT
             372     1               
             373     1                     ! time decorrelation
             374     1                     rpattern(n)%phi = exp(-dt/rpattern(n)%decortau)
             375     1               
             376     1                     call sortml(rpattern(n)%jtrun,rpattern(n)%mlmax, &
             377     1                                 rpattern(n)%msort,rpattern(n)%lsort,rpattern(n)%mlsort)
             378     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise
                                   <<< Loop-information  End >>>
             379     1  pp   4v            noise = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 247
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.26, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             380     2  pp    v            do ml=1,rpattern(n)%mlmax
             381     2   p    v              noise(ml,1) = 1./sqrt(float(2*(rpattern(n)%lsort(ml)-1))+1)
             382     2   p    v              noise(ml,2) = 1./sqrt(float(2*(rpattern(n)%lsort(ml)-1))+1)
             383     3   p    v              if (rpattern(n)%msort(ml) .eq. 1) then
             384     3   p    v                noise(ml,1) = sqrt(2.)/sqrt(float(2*(rpattern(n)%lsort(ml)-1))+1)
             385     3   p    v                noise(ml,2) = 0.
             386     3   p    v              endif
             387     2   p    v            enddo
             388     1               
             389     1                     noise(1,1) = 0.
             390     1                     noise(1,2) = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise
                                   <<< Loop-information  End >>>
             391     1  pp   2v            noise = noise*sqrt(1./float(rpattern(n)%jtrun))
             392     1               
             393     1                     ! set up the amplitude of noise
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             394     2  pp    v            do ml=1,rpattern(n)%mlmax
             395     2   p    v              rpattern(n)%varspec(ml) = sqrt(float(rpattern(n)%jtrun) &
             396     2                           * exp(-rkT*float(rpattern(n)%lsort(ml))*(float(rpattern(n)%lsort(ml)-1))))
             397     2   p    v            enddo
             398     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             399     1  pp   2v            noise(:,1) = noise(:,1)*rpattern(n)%varspec
             400     1   p   2v            noise(:,2) = noise(:,2)*rpattern(n)%varspec
             401     1               
             402     1                     ! get specral variance
             403     1                     var=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             404     2  pp    v            do ml=1,rpattern(n)%mlmax
             405     3   p    v              if (rpattern(n)%msort(ml) .ne. 1) then
             406     3   p    v                var = var + (noise(ml,1)**2 + noise(ml,2)**2)
             407     3   p                   else
             408     3   p    v                var = var + 0.5*(noise(ml,1)**2 + noise(ml,2)**2)
             409     3   p    v              endif
             410     2   p    v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
             411     1  pp   4v            rpattern(n)%varspec = rpattern(n)%varspec / sqrt(var)
             412     1               
             413     1               #ifdef VERBOSE
             414     1                     if (myrank.eq.0) write(6,*)'total variance =',var
             415     1                     if (myrank.eq.0) write(6,*)'rpattern(n)%varspec =',rpattern(n)%varspec
             416     1               #endif
             417     1                     ! initialize spectrum coefficient
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise
                                   <<< Loop-information  End >>>
             418     1  pp   4v            noise = 0.
             419     1                     call get_noise(rpattern(n),noise)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             420     2  pp   2v            do ml=1,rpattern(n)%mlmax
             421     2   p   2v              rpattern(n)%spec(ml,1) = rpattern(n)%stdev*rpattern(n)%varspec(ml)*noise(ml,1)
             422     2   p   2v              rpattern(n)%spec(ml,2) = rpattern(n)%stdev*rpattern(n)%varspec(ml)*noise(ml,2)
             423     2   p   2v            enddo
             424     1                     rpattern(n)%spec(1,1) = 0.
             425     1                     rpattern(n)%spec(1,2) = 0.
             426     1               
             427     1                     deallocate(noise)
             428     1                   enddo
             429                     
             430     1                   if (myrank.eq.0) then
             431     1                     write(6,*)'mod_stochastic_physics : dt    = ',dt
             432     1                     write(6,*)'mod_stochastic_physics : stdev = ',rpattern%stdev
             433     1                     write(6,*)'mod_stochastic_physics : seed  = ',rpattern%seed
             434     1                     write(6,*)'mod_stochastic_physics : jtrun = ',rpattern%jtrun
             435     1                     write(6,*)'mod_stochastic_physics : mlmax = ',rpattern%mlmax
             436     1                     write(6,*)'mod_stochastic_physics : tau   = ',rpattern%decortau
             437     1                     write(6,*)'mod_stochastic_physics : phi   = ',rpattern%phi
             438     1                   endif
             439                     
             440                       end subroutine get_random_pattern_init
             441                     
             442                       subroutine get_random_pattern_destroy(rpattern,nscale)
             443                         implicit none
             444                         integer :: n, nscale
             445                         type(random_pattern), intent(inout) :: rpattern(nscale)
             446                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 10
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             447     1                   do n=1,nscale
             448     1                     deallocate(rpattern(n)%n2d)
             449     1                     deallocate(rpattern(n)%spec)
             450     1                     deallocate(rpattern(n)%varspec)
             451     1                     deallocate(rpattern(n)%msort)
             452     1                     deallocate(rpattern(n)%lsort)
             453     1                     deallocate(rpattern(n)%mlsort)
             454     1                   enddo
             455                     
             456                       end subroutine get_random_pattern_destroy
             457                     
             458                       subroutine get_random_pattern_run(rpattern,nscale)
             459                         implicit none
             460                         integer :: nscale
             461                         integer :: n, ii, i, jj, j, k, nxj
             462                         type(random_pattern), intent(inout) :: rpattern(nscale)
             463                     
             464     1                   do n=1,nscale
             465     1                     call gen_random_pattern_2d(rpattern(n)%n2d,rpattern(n))
             466     1                   enddo
             467                     
             468                       end subroutine get_random_pattern_run
             469                     
             470                       subroutine get_stochy_physics(rpattern,nscale,nlev,vfact,n3d)
             471                     !------------------------------------------------------------------------!
             472                     !  purpose: To generate 3D SPPT strucutre
             473                     !  output: n3d
             474                     !------------------------------------------------------------------------!
             475                         implicit none
             476                         integer :: n, ii, i, jj, j, k, nxj, nlev
             477                         integer, intent(in) :: nscale
             478                         real, intent(in) :: vfact(nlev)
             479                         type(random_pattern), intent(inout) :: rpattern(nscale)
             480                         real(kind=RTYPE), intent(  out) :: n3d(nxp,nlev,my_max)
             481                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d
                                   <<< Loop-information  End >>>
             482        pp   4v          n3d = 0.
             483     1                   do n=1,nscale
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             484     2  pp                 do jj=1,jlistnum
             485     2   p                   j=jlist1(jj)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             486     3   p                   do k=1,nlev
             487     3   p                     nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      n3d, (unknown)
                                   <<< Loop-information  End >>>
             488     4   p   2v                do i=1,nxj
             489     4   p   2v                  n3d(i,k,jj)=n3d(i,k,jj)+rpattern(n)%n2d(i,jj)*vfact(k)
             490     4   p   2v                enddo
             491     3   p                   enddo
             492     2   p                 enddo
             493     1                   enddo
             494                     
             495                       end subroutine get_stochy_physics
             496                     
             497                       subroutine get_noise(rpattern,noise)
             498                         implicit none
             499                         integer :: ml, ns, ms
             500                         type(random_pattern), intent(inout) :: rpattern
             501                         real(kind=RTYPE), intent(out) :: noise(rpattern%mlmax,2)
             502                         real :: noise_gauss(2*rpattern%mlmax)
             503                         real :: ave, var, std
             504                     
             505                         ! get white noise  with a gaussian (normal) distribution
             506                         call random_gauss(noise_gauss,rpattern%rstate)
             507                         noise_gauss(1) = 0.; noise_gauss(rpattern%mlmax+1) = 0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise_gauss
                                   <<< Loop-information  End >>>
             508        pp   2v          noise_gauss = noise_gauss*sqrt(1./float(rpattern%jtrun-1))
             509                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise
                                   <<< Loop-information  End >>>
             510        pp   4v          noise=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 276
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, noise_gauss, (unknown)
                                   <<< Loop-information  End >>>
             511     1  pp    v          do ml=1,rpattern%mlmax
             512     1                     ! set up to red noise
             513     1   p    v            noise(ml,1) = noise_gauss(ml)/sqrt(float(2*(rpattern%lsort(ml)-1)+1))
             514     1   p    v            noise(ml,2) = noise_gauss(rpattern%mlmax+ml)/sqrt(float(2*(rpattern%lsort(ml)-1)+1))
             515     1                     ! zero out the imagenary part when m(zonal wavenumber) equal to 1
             516     2   p    v            if (rpattern%msort(ml) .eq. 1) then
             517     2   p    v              noise(ml,1) = sqrt(2.)*noise(ml,1)
             518     2   p    v              noise(ml,2) = 0.
             519     2   p    v            endif
             520     1   p    v          enddo
             521                       end subroutine get_noise
             522                     
             523                       subroutine gen_random_pattern_2d(sppt2d,rpattern)
             524                         use const, only: RTYPE
             525                         implicit none
             526                         type(random_pattern), intent(inout) :: rpattern
             527                         real(kind=RTYPE), intent(out) :: sppt2d(nxp,my_max)
             528                         integer :: ml, ns, ms
             529                         real(kind=RTYPE), allocatable :: noise(:,:)
             530                         real(kind=RTYPE), allocatable :: specp(:,:,:),bufr2d(:,:,:)
             531                     
             532                         allocate(bufr2d(jtrun,jtmax*nsizey,2))
             533                         allocate(specp(jtrun,jtmax,2))
             534                     
             535     1                   if ( col_rank .eq. 0 ) then
             536     1                     ! get noise
             537     1                     allocate(noise(rpattern%mlmax,2))
             538     1                     call get_noise(rpattern,noise)
             539     1               
             540     1                     !  radom pattern advance with first order AR
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.85, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             541     1  pp   4v            rpattern%spec(:,1) = rpattern%phi*rpattern%spec(:,1) + &
             542     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      noise, (unknown)
                                   <<< Loop-information  End >>>
             543     1  pp   2v            rpattern%spec(:,2) = rpattern%phi*rpattern%spec(:,2) + &
             544     1                           sqrt(1.-rpattern%phi**2.)*rpattern%stdev*rpattern%varspec*noise(:,2)
             545     1               
             546     1                     ! ready for mpi_scatter random pattern
             547     1                     call spectrun_inp2d(rpattern%jtrun,jtrun,jtmax         &
             548     1                                        ,rpattern%mlsort,nsizey             &
             549     1                                        ,rpattern%spec,bufr2d)
             550     1               
             551     1                     deallocate(noise)
             552     1                   endif
             553                     
             554                         !  mpi_scatter random pattern from root
             555                         call mpe_scatter_sppt(bufr2d,specp,2*jtrun*jtmax,nsizey)
             556                     
             557                         ! transform spectral to physical space
             558                         call transr1(jtrun,jtmax,nx,my,my_max,poly,specp,sppt2d,nsizey)
             559                     
             560                         deallocate(bufr2d)
             561                         deallocate(specp)
             562                     
             563                       end subroutine gen_random_pattern_2d
             564                     
             565                       subroutine get_legendre_poly(mlmax,jtrun,poly)
             566                         implicit none
             567                         integer, intent(in) :: mlmax,jtrun
             568                         real(kind=RTYPE),intent(out)   ::  poly(mlmax,my/2)
             569                     
             570                         !   Spheric Harmonic Constants
             571                         integer ::  msort(mlmax),lsort(mlmax),mlsort(mlmax,jtrun)
             572                         real(kind=RTYPE) :: dpoly(mlmax,my/2),eps4(mlmax),cim(mlmax)
             573                         real(kind=RTYPE) :: cosl(my),onocos(my)
             574                         real(kind=RTYPE) :: weight(my),sinl(my)
             575                         real :: cp,capa,rgas,pi,radsq,rad,one,onem,irad
             576                         integer :: rl,rm,rlm,ml
             577                         integer :: j,my2
             578                     
             579                         !   prepare spheric harmonic coefficients
             580                         cp=1004.24
             581                         capa= 1.0/3.5
             582                         rgas= capa*cp
             583                         pi  = 4.0*atan(1.0)
             584                         rad = 6.371e6
             585                         radsq= rad*rad
             586                     !
             587                     !   build pointer arrays for locating zonal and total wavenumber
             588                     !   values in the one-dimensional spherical harmonic arrays.
             589                         call sortml (jtrun,mlmax,msort,lsort,mlsort)
             590                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 272
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.62, ITR: 112, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lsort, cim, msort, eps4
                                   <<< Loop-information  End >>>
             591     1  pp    v          do ml = 1, mlmax
             592     1   p    v            rl = lsort(ml)
             593     1   p    v            rm = msort(ml)-1
             594     1   p    v            rlm= rl-1.0
             595     1   p    v            if (msort(ml).eq.1)  rm= 0.0
             596     1   p    v            if (lsort(ml).eq.1)  rlm= 0.0
             597     1   p    v            eps4(ml)= rl*rlm/radsq
             598     1   p    v            cim(ml)= rm
             599     1   p    v          enddo
             600                     
             601                     !   gaussian quadrature weights and latitudes
             602                         one = 1.0
             603                         onem= -one
             604                         call gausl3 (my,onem,one,weight,sinl)
             605                     !
             606                         my2= my/2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.30, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, onocos, weight, cosl
                                   <<< Loop-information  End >>>
             607     1   s    s          do j = 1, my2
             608     1   s    s            sinl(my+1-j)  = -sinl(j)
             609     1   s    s            weight(my+1-j)= weight(j)
             610     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             611     1   s    s            onocos(my+1-j)= onocos(j)
             612     1   m    m            cosl(j)       = 1.0/sqrt(onocos(j))
             613     1   s    s            cosl(my+1-j)  = cosl(j)
             614     1   p    v          enddo
             615                     !
             616                     !   define associated legendre polynomials and their derivatives
             617                         call lgndr_sppt(my2,jtrun,mlmax,mlsort,sinl,poly,dpoly)
             618                     
             619                       end subroutine get_legendre_poly
             620                     
             621                       SUBROUTINE avevar_sppt(data,n,ave,var,std)
             622                           INTEGER n
             623                           REAL ave,var,data(n)
             624                           INTEGER j
             625                           REAL s,ep,std
             626                           ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             627     1  pp    v            do j=1,n
             628     1   p    v              ave=ave+data(j)
             629     1   p    v            enddo
             630                           ave=ave/n
             631                           var=0.0
             632                           ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             633     1  pp    v            do j=1,n
             634     1   p    v              s=data(j)-ave
             635     1   p    v              ep=ep+s
             636     1   p    v              var=var+s*s
             637     1   p    v            enddo
             638                           var=(var-ep**2/n)/n
             639                           std=sqrt(var)
             640                     
             641                       end SUBROUTINE avevar_sppt
             642                     !
             643                     !
             644                       SUBROUTINE avevar_sppt2d(data2d,n,m,ave,var,std)
             645                         INTEGER :: n,m,nmdim
             646                         REAL :: ave,var,data(n*m)
             647                         REAL(kind=RTYPE) :: data2d(n,m)
             648                         INTEGER :: i,j
             649                         REAL :: s,ep,std
             650                     
             651                         nmdim=0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             652     1                   do j=1,m
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      data2d, data
                                   <<< Loop-information  End >>>
             653     2  pp   2v            do i=1,n
             654     2   p   2v            nmdim=nmdim+1
             655     2   p   2v            data(nmdim)=data2d(i,j)
             656     2   p   2v            enddo
             657     1                   enddo
             658                     
             659                         ave=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             660     1  pp    v          do j=1,nmdim
             661     1   p    v            ave=ave+data(j)
             662     1   p    v          enddo
             663                         ave=ave/nmdim
             664                         var=0.0
             665                         ep=0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             666     1  pp    v          do j=1,nmdim
             667     1   p    v            s=data(j)-ave
             668     1   p    v            ep=ep+s
             669     1   p    v            var=var+s*s
             670     1   p    v          enddo
             671                     !   var=(var-ep**2/n)/(n-1)    ! sample numners < 30
             672                         var=(var-ep**2/nmdim)/nmdim
             673                         std=sqrt(var)
             674                       end SUBROUTINE avevar_sppt2d

             961                     !----
             962                       subroutine spptctl(tau)
             963                     !
             964                         use const, only : idtg,sinl,sigma
             965                         use rank, only : myrank
             966                     
             967                         integer :: nxj,j,k,itau,ch,iter,remd,js,je,kk,lev1, mn, n
             968                         real :: pi, r2d, dlon, tau
             969                         real, allocatable :: mlat(:),prsl(:)
             970                         character(len=30) ::  forydef,forzdef
             971                     
             972                         character yy*4,dd*2,hh*2,mm*2,dtg*12
             973                         character*3 mon(12)
             974                         logical jrem
             975                     
             976                         data mon/'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep' &
             977                                  ,'Oct','Nov','Dec'/
             978                     
             979                         allocate(mlat(my),prsl(lev))
             980                     
             981                         itau=tau
             982                         ch=10
             983                         lev1=1
             984                         pi=4.0*atan(1.0)
             985                         r2d=180./pi
             986                         dlon=360./float(nx)
             987                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    MULTI-OPERATION FUNCTION
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, mlat
                                   <<< Loop-information  End >>>
             988     1  pp   2v          do j=1,my
             989     1   p   2v            mlat(j)=asin(sinl(j))*r2d
             990     1   p   2v          enddo
             991                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.45, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, prsl
                                   <<< Loop-information  End >>>
             992     1  pp   2v          do k=1,lev
             993     1   p   2v            kk=lev-k+1
             994     1   p   2v            prsl(kk)=sigma(k,2)+sigma(k+1,2)
             995     1   p   2v            prsl(kk)=prsl(kk)+(sigma(k,1)+sigma(k+1,1))*1000.
             996     1   p   2v            prsl(kk)=0.5*prsl(kk)/1000.
             997     1   p   2v          enddo
             998                     
             999                           write(forydef,8) my
            1000                           write(forzdef,9) lev
            1001                     
            1002                           write(dtg,'(I12)') idtg
            1003                           read(dtg,'(A4,I2,A2,A2,A2)') yy,mn,dd,hh,mm
            1004                     
            1005     1                     if ( myrank .eq. 0 ) then
            1006     1                     OPEN(UNIT=ch, FILE='sppt.ctl', STATUS='UNKNOWN'             &
            1007     1                        , ACCESS='SEQUENTIAL')
            1008     1               
            1009     1                     write(ch,'(A23)') 'dset ^sppt.dat'
            1010     1                     write(ch,'(A18)') 'options big_endian'
            1011     1                     write(ch,'(A12)') 'undef -999.0'
            1012     1                     write(ch,12) 'ydef' ,my, 'levels'
            1013     1                     iter=my/8
            1014     1                     remd=mod(my,8)
            1015     1                     jrem=(remd .eq. 0)
            1016     1                     write(forydef,8) remd
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1017     2   s    s            do j=1,iter
            1018     2   p    v             js=1+8*(j-1)
            1019     2   p    v             je=js+7
            1020     2   m    s             write(10,10) mlat(js:je)
            1021     2   p    v            enddo
            1022     1                     if ( .not. jrem ) write(10,forydef) mlat(je+1:my)
            1023     1               
            1024     1                     write(ch,13) 'xdef'  ,nx, 'linear 0.0',dlon
            1025     1                     write(ch,14) 'tdef',itau, 'linear',hh,'Z',dd,mon(mn),yy,'1hr'
            1026     1                     write(ch,12) 'zdef' ,lev, 'levels '
            1027     1                     iter=lev/8
            1028     1                     remd=mod(lev,8)
            1029     1                     jrem=(remd .eq. 0)
            1030     1                     write(forzdef,9) remd
            1031     2   s    s            do j=1,iter
            1032     2   p    v             js=1+8*(j-1)
            1033     2   p    v             je=js+7
            1034     2   m    s             write(10,11) prsl(js:je)
            1035     2   p    v            enddo
            1036     1                     if ( .not. jrem ) write(10,forzdef) prsl(je+1:my)
            1037     1                     write(ch,'(A4,1X,I2)') 'vars',nsppt+1
            1038     2   s    s            do n=1,nsppt
            1039     2   m    m              write(ch,15) 'scale',n ,lev1,'99',rpattern_sppt(n)%lenscale/1000.,'km 2D Random Pattern'
            1040     2   p    v            enddo
            1041     1                     write(ch,16) 'sppt  '   , lev,'99','3D Random Pattern'
            1042     1                     write(ch,'(A7)') 'endvars'
            1043     1               
            1044     1                     close(ch)
            1045     1                     endif
            1046                     
            1047                     8     format("(",I4,"(2x,F11.7))")
            1048                     9     format("(",I4,"(2x,F7.5))")
            1049                     10    format(8(2x,F11.7))
            1050                     11    format(8(2x,F7.5))
            1051                     12    format(A4,1X,I4,1X,A6)
            1052                     13    format(A4,1X,I4,1X,A10,1X,F10.7)
            1053                     14    format(A4,1X,I4,1X,A6,1X,A2,A1,A2,A3,A4,1X,A3)
            1054                     15    format(A5,I1,3X,I3,1X,A2,1X,F7.1,A20)
            1055                     16    format(A6,3X,I3,1X,A2,1X,A20)
            1056                     
            1057                         deallocate(mlat,prsl)
            1058                       end subroutine spptctl

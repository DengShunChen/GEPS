            1108                     !----
            1109                       subroutine spptctl(tau)
            1110                     !
            1111                         use const, only : idtg,sinl,sigma
            1112                         use rank, only : myrank
            1113                     
            1114                         integer :: nxj,j,k,itau,ch,iter,remd,js,je,kk,lev1, mn, n
            1115                         real :: pi, r2d, dlon, tau
            1116                         real, allocatable :: mlat(:),prsl(:)
            1117                         character(len=30) ::  forydef,forzdef
            1118                     
            1119                         character yy*4,dd*2,hh*2,mm*2,dtg*12
            1120                         character*3 mon(12)
            1121                         logical jrem
            1122                     
            1123                         data mon/'Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep' &
            1124                                  ,'Oct','Nov','Dec'/
            1125                     
            1126                         allocate(mlat(my),prsl(lev))
            1127                     
            1128                         itau=tau
            1129                         ch=10
            1130                         lev1=1
            1131                         pi=4.0*atan(1.0)
            1132                         r2d=180./pi
            1133                         dlon=360./float(nx)
            1134                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    MULTI-OPERATION FUNCTION
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, mlat
                                   <<< Loop-information  End >>>
            1135     1  pp   2v          do j=1,my
            1136     1   p   2v            mlat(j)=asin(sinl(j))*r2d
            1137     1   p   2v          enddo
            1138                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.14, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, prsl
                                   <<< Loop-information  End >>>
            1139     1  pp    v          do k=1,lev
            1140     1   p    v            kk=lev-k+1
            1141     1   p    v            prsl(kk)=sigma(k,2)+sigma(k+1,2)
            1142     1   p    v            prsl(kk)=prsl(kk)+(sigma(k,1)+sigma(k+1,1))*1000.
            1143     1   p    v            prsl(kk)=0.5*prsl(kk)/1000.
            1144     1   p    v          enddo
            1145                     
            1146                           write(forydef,8) my
            1147                           write(forzdef,9) lev
            1148                     
            1149                           write(dtg,'(I12)') idtg
            1150                           read(dtg,'(A4,I2,A2,A2,A2)') yy,mn,dd,hh,mm
            1151                     
            1152     1                     if ( myrank .eq. 0 ) then
            1153     1                     OPEN(UNIT=ch, FILE='sppt.ctl', STATUS='UNKNOWN'             &
            1154     1                        , ACCESS='SEQUENTIAL')
            1155     1               
            1156     1                     write(ch,'(A23)') 'dset ^sppt.dat'
            1157     1                     write(ch,'(A18)') 'options big_endian'
            1158     1                     write(ch,'(A12)') 'undef -999.0'
            1159     1                     write(ch,12) 'ydef' ,my, 'levels'
            1160     1                     iter=my/8
            1161     1                     remd=mod(my,8)
            1162     1                     jrem=(remd .eq. 0)
            1163     1                     write(forydef,8) remd
            1164     2   s    s            do j=1,iter
            1165     2   p    v             js=1+8*(j-1)
            1166     2   p    v             je=js+7
            1167     2   m    s             write(10,10) mlat(js:je)
            1168     2   p    v            enddo
            1169     1                     if ( .not. jrem ) write(10,forydef) mlat(je+1:my)
            1170     1               
            1171     1                     write(ch,13) 'xdef'  ,nx, 'linear 0.0',dlon
            1172     1                     write(ch,14) 'tdef',itau, 'linear',hh,'Z',dd,mon(mn),yy,'1hr'
            1173     1                     write(ch,12) 'zdef' ,lev, 'levels '
            1174     1                     iter=lev/8
            1175     1                     remd=mod(lev,8)
            1176     1                     jrem=(remd .eq. 0)
            1177     1                     write(forzdef,9) remd
            1178     2   s    s            do j=1,iter
            1179     2   p    v             js=1+8*(j-1)
            1180     2   p    v             je=js+7
            1181     2   m    s             write(10,11) prsl(js:je)
            1182     2   p    v            enddo
            1183     1                     if ( .not. jrem ) write(10,forzdef) prsl(je+1:my)
            1184     1                     write(ch,'(A4,1X,I2)') 'vars',nsppt+1
            1185     2   s    s            do n=1,nsppt
            1186     2   m    m              write(ch,15) 'scale',n ,lev1,'99',rpattern_sppt(n)%lenscale/1000.,'km 2D Random Pattern'
            1187     2   p    v            enddo
            1188     1                     write(ch,16) 'sppt  '   , lev,'99','3D Random Pattern'
            1189     1                     write(ch,'(A7)') 'endvars'
            1190     1               
            1191     1                     close(ch)
            1192     1                     endif
            1193                     
            1194                     8     format("(",I4,"(2x,F11.7))")
            1195                     9     format("(",I4,"(2x,F7.5))")
            1196                     10    format(8(2x,F11.7))
            1197                     11    format(8(2x,F7.5))
            1198                     12    format(A4,1X,I4,1X,A6)
            1199                     13    format(A4,1X,I4,1X,A10,1X,F10.7)
            1200                     14    format(A4,1X,I4,1X,A6,1X,A2,A1,A2,A3,A4,1X,A3)
            1201                     15    format(A5,I1,3X,I3,1X,A2,1X,F7.1,A20)
            1202                     16    format(A6,3X,I3,1X,A2,1X,A20)
            1203                     
            1204                         deallocate(mlat,prsl)
            1205                       end subroutine spptctl

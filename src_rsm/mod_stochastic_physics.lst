                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 272, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      scaleval
                                   <<< Loop-information  End >>>
             683     1  pp   2v          do j=1,my
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             684     2   p   2           do i=1,nx
             685     2   p   2v            if ((scaleval(i,j)-aves).gt.vcheck2p) scaleval(i,j)=vcheck2p
             686     2   p   2v            if ((scaleval(i,j)-aves).lt.vcheck2n) scaleval(i,j)=vcheck2n
             687     2   p   2v          enddo
             688     1   p               enddo
             689                       end subroutine removegt2std

            1060                       subroutine spectrun_inp2d(jcap1,jtr,jtm,mlsort,ns,speci,speco)
            1061                     !
            1062                     ! use spectral truncation to change resoltuion
            1063                     !
            1064                           implicit none
            1065                           integer lev,jtr,jcap1,jtm,ns,ml
            1066                           real(kind=RTYPE) speci(jcap1*(jcap1+1)/2,2)
            1067                           real(kind=RTYPE) speco(jtr,jtm*ns*2)
            1068                           integer i,j,k,jj,jp,jr,j1,j2
            1069                           integer mlsort(jcap1,jcap1)
            1070                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1071        pp   4v            speco(:,:) = 0.0
            1072     1                     if( jcap1.gt.jtr ) then
            1073     2                         do j=1,jcap1
            1074     3                           if( j.le.jtr ) then
            1075     3                             jj=nlist(j)
            1076     3                             jp=(jj-1)/jtm
            1077     3                             jr=mod(jj-1,jtm)+1
            1078     3                             j1=jp*jtm*2+jr
            1079     3                             j2=j1+jtm
            1080     3                           endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1081     3  pp   2s                  do i=j,jcap1
            1082     3   p   2v                    ml=mlsort(j,i)
            1083     4   p   2s                    if( i.le.jtr ) then
            1084     4   p   2s                      speco(i,j1) = speci(ml,1)
            1085     4   p   2s                      speco(i,j2) = speci(ml,2)
            1086     4   p   2v                    endif
            1087     3   p   2v                  enddo
            1088     2                         enddo
            1089     1                     else if( jcap1.lt.jtr ) then
            1090     2                         do j=1,jtr
            1091     2                           jj=nlist(j)
            1092     2                           jp=(jj-1)/jtm
            1093     2                           jr=mod(jj-1,jtm)+1
            1094     2                           j1=jp*jtm*2+jr
            1095     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<< Loop-information  End >>>
            1096     3  pp   2s                  do i=j,jtr
            1097     4   p   2m                    if( i.le.jcap1 ) then
            1098     4   p   2s                      ml=mlsort(j,i)
            1099     4   p   2s                      speco(i,j1) = speci(ml,1)
            1100     4   p   2s                      speco(i,j2) = speci(ml,2)
            1101     4   p   2v                    endif
            1102     3   p   2v                  enddo
            1103     2                         enddo
            1104     1                     else      ! jcap1=jtr
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1105     2                         do j=1,jtr
            1106     2                           jj=nlist(j)
            1107     2                           jp=(jj-1)/jtm
            1108     2                           jr=mod(jj-1,jtm)+1
            1109     2                           j1=jp*jtm*2+jr
            1110     2                           j2=j1+jtm
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.10, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      speco
                                   <<< Loop-information  End >>>
            1111     3  pp   2v                  do i=j,jtr
            1112     3   p   2v                    ml=mlsort(j,i)
            1113     3   p   2v                    speco(i,j1) = speci(ml,1)
            1114     3   p   2v                    speco(i,j2) = speci(ml,2)
            1115     3   p   2v                  enddo
            1116     2                         enddo
            1117     1                     endif
            1118                     
            1119                           return
            1120                       end subroutine spectrun_inp2d

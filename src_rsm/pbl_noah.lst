               1                           subroutine pbl_noah (nxj,nx,lev,ktpbl,dt,g,r,cp,xkapa,hltm,ptop   &
               2                                             , tice,hice,tg,z0,land,topo,phi,pss,u,v,t,q,ut  &
               3                                             , vt,tt,qt,pk,pk2,ustar,tstar,qstar,e,eps,hflux &
               4                                             , qflux,itstp,gwclim,tgclim,ocean,ice,sheleg    &
               5                                             , totalp,ss,rs,alb,imx,xkmx,idg,xkmd,itype      &
               6                                             , t2,q2,rh2,rh10,u10,v10,fm,fh,fm10,fh2,srflag  &
               7                                             , rld,stbo                                      &
               8                                             , km,smc,stc,canopy,runoff,sigmaf,istyp,ivegtyp &
               9                                             , ncld,dsigma,islopetyp,slc,sncover,snwdph       &
              10                                             , shdmax,shdmin,snoalb,albedo2                  &
              11                                             , sld,zice,cice,xtice,hpbl,asl,atl,xmu,gfx      &
              12                                             , kpbl,nmpbl,nmmiph,jj,isot,ivegsrc,sfemis_g    &
              13                                             , dudt,dvdt,dtdt,dqdt,ustress,vstress,ssu, ssv)
              14                     !
              15                     !#######################################################################
              16                     !                     subroutine description
              17                     !
              18                     ! 1. function description
              19                     !
              20                     !    this version is based on the Troen and Mahrt (1986) to deal with
              21                     !    the vertical diffusion with account of non-local flux.
              22                     !    the code is origially from ncepgfs
              23                     !
              24                     !
              25                     ! 2. parameter specification
              26                     !
              27                     !     nx : dimension of horizontal-direction
              28                     !    lev : dimension of z-direction
              29                     !  ktpbl : starting level to consider vertical mixing by pbl
              30                     !     dt : time step for ut, vt, tt, qt updates                (s)
              31                     !      g : gravity                                             (m/s2)
              32                     !      r : air gas constant                                    (j/kg)
              33                     !     cp : air specific heat constant                          (j/kg)
              34                     !  xkapa : r/cp
              35                     !   hltm : water vapor latent heat constant                    (j/kg)
              36                     !   ptop : model top pressure                                  (mb)
              37                     !   tice : temperature of melting point                        (k)
              38                     !   hice : latent heat of snow melting                         (j/kg)
              39                     !     tg : ground real temp. (sea or land)  (nx)               (k)
              40                     !     z0 : surface roughness length    (nx)                    (m)
              41                     !   gwet : ground wetness              (nx)
              42                     !   land : logic for bare soil land    (nx)  (=true for bare land)
              43                     !   topo : terrain geopotential   (nx)                         (m2/s2)
              44                     !    phi : odd level geopotential (nx)                         (m2/s2)
              45                     !    pss : (terrain pres -ptop)   (nx)     at current time lvl (mb)
              46                     !      u : x-direction velocity   (nx,lev) at current time lvl (m/s)
              47                     !      v : y-direction velocity   (nx,lev) at current time lvl (m/s)
              48                     !      t : potent temp on odd lvl (nx,lev) at current time lvl (k)
              49                     !      q : moisture    on odd lvl (nx,lev) at current time lvl (kg/kg)
              50                     !     ut : x-direction velocity   (nx,lev) at past/future  lvl (m/s)
              51                     !     vt : y-direction velocity   (nx,lev) at past/future  lvl (m/s)
              52                     !     tt : real temp.  on odd lvl (nx,lev) at past/future  lvl (k)
              53                     !     qt : moisture    on odd lvl (nx,lev) at past/future  lvl (kg/kg)
              54                     !     pk : p**capa on odd levels  (exner func)
              55                     !    pk2 : p**capa on even levels (exner func)
              56                     !   ustar: friction velocity         (nx)                      (m/s)
              57                     !   tstar: potential temp scale      (nx)                      (k)
              58                     !   qstar: moisture scale            (nx)                      (kg/kg)
              59                     !     e  : turbulence kinetic energy (nx,lev) at even lvls     (m2/s2)
              60                     !    eps : tke dissipation           (nx,lev)                  (m2/s2)
              61                     !   hflux: upward surface heat flux         (nx)               (w/m2)
              62                     !   qflux: upward surface moisture flux     (nx)               (w/m2)
              63                     !   itstp: indicated which time step it is
              64                     !    gwr : soil water amount           (nx)                    (mm)
              65                     !  gwclim: soil water climate          (nx)                    (mm)
              66                     !  tgclim: climate ground temperature  (nx)                    (k)
              67                     !   ocean: logic for open water      (nx)  (=true for open water)
              68                     !     ice: logic for ice cover       (nx)  (=true for ice covered)
              69                     !     snr: snow depth in water state (nx)                      (mm)
              70                     !  totalp: total precipitation       (nx)                      (mm)
              71                     !      ss: net short wave radiat. flux down to ground (nx)     (wat/m2)
              72                     !      rs: net long  wave radiat. flux up from ground (nx)     (wat/m2)
              73                     !     alb: diffusion albedo           (nx)
              74                     !     imx: address of the two points with max xkm at the two lowest lvl
              75                     !    xkmx: max mixing coef xkm at two lowest levels            (m2/s)
              76                     !     idg: i-index address of selected point to print profile
              77                     !    xkmd: xkm profile at the selected idg point               (m2/s)
              78                     !   itype: surface layer update type, =0 use surface stress as b.c.
              79                     !                                     =1 directly update lowest levels
              80                     !      t2: 2m air temp derived by similarity theory (nx)     (K)
              81                     !     u10: 10m air x-direction wind derived by simil. theory(nx)  (m/s)
              82                     !     v10: 10m air y-direction wind derived by simil. theory(nx)  (m/s)
              83                     !
              84                     !soil io
              85                     !
              86                     !     smc: volumetric soil moisture content (nx,km_soil)
              87                     !     stc: soil temperature                 (nx,km_soil)
              88                     !  canopy: canopy moisture content(<0.5mm)          (nx)
              89                     !  sigmaf: green vegetation fraction        (nx)
              90                     !   istyp: soil type(1-9)                   (nx)
              91                     ! ivegtyp: vegetation type(1-13)            (nx)
              92                     !  runoff: accumulate run off water(runof+drain) (nx)             (mm)
              93                     !     rld: long wave radiat. flux down to ground (nx)         (wat/m2)
              94                     !   wlt  : wiltling point of 9 soil types  (9)
              95                     !   ref  : field capacity of 9 soil types  (9)
              96                     ! tsat   : satuation point of 9 soil types (9)
              97                     ! dfkt   : soil thermal diffusivity     (22,9)     m2/s
              98                     ! xktk   : soil hydraulic conductivity  (22,9)     m/s
              99                     !  dfk   : soil hydraulic diffusivity   (22,9)     m2/s
             100                     !
             101                     ! 4. local variable
             102                     !
             103                     !    phi : geopential on odd lvl  (nx,lev) at current time lvl (m2/s2)
             104                     !    xkm : eddy mixing coef. for u,v (nx,lev)                  (m2/s)
             105                     !    xkh : eddy mixing coef. for t,q (nx,lev)                  (m2/s)
             106                     !      ts: surface air temperature    (nx)                     (k)
             107                     !    qsfc: surface moisture (specific humidity)      (nx)      (kg/kg)
             108                     !     zl : height(lev) over monin-obukhov scale height.
             109                     !          a stability indicator.                    (nx)
             110                     !     czh: ground thermal capacity                   (nx)      (j/kg.m2)
             111                     !    snow: logic for snow cover                      (nx)
             112                     !
             113                     !soil
             114                     !
             115                     !  rhscnpy: righ hand side terms of canopy prediction(nx)
             116                     !    rhsmc: righ hand side terms of smc prediction(nx,km)
             117                     !      aim: working array smc prediction           (nx,km)
             118                     !      bim: working array smc prediction           (nx,km)
             119                     !      cim: working array smc prediction           (nx,km)
             120                     !   drain: drainage water from bottom soil layer   (nx)        (mm/s)
             121                     !     snomt: snow melt rate                        (nx)        (mm/s)
             122                     !     zsoil: soil depth of soil layer(-0.1,-2.)    (nx,km)        (m)
             123                     !     runof: run off water from surface and soil   (nx)        (mm/s)
             124                     !      gfx: ground heat flx                        (nx)        (wat/m2)
             125                     !     t850: 850mb air temp                         (nx)         (K)
             126                     !     gesh: control number,control precipitation   (nx)
             127                     !           conver to snow(0) or not(1)
             128                     !
             129                     !
             130                     ! 5. calling modules
             131                     !
             132                     !     main program
             133                     !
             134                     !     created       november 1991
             135                     !     modified      july     1992,  april   1993
             136                     !     modified      jan      2005  by f. wang
             137                     !     modified      may      2009  by f. wang
             138                     !
             139                     !            ed., american meteorology socity, 67-98.
             140                     !  mixpbl:
             141                     !       troen, i., and l. mahrt, 1986: a simple model of the atmospheric
             142                     !          boundary layer: sensitivity to surface evaporation. bound.
             143                     !          layer meteor., 37, 129-148.
             144                     !
             145                     !  land process:
             146                     !       Mahrt, L., and H. -L. Pan,1984: Atwo-layer model of soil hydrology.
             147                     !             Boundary Layer Meteorol., 29, 1-20.
             148                     !       Pan, H.-L., and L.Mahrt, 1987: Interaction between soil hydrology
             149                     !             and boundary-layer development. Boundary Layer Meteorol.,
             150                     !             38,185-202.
             151                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
             152                     !
             153                     !#####################################################################
             154                     !
             155                           use mpe
             156                           use rank
             157                           use index
             158                           use radn,   only:ntcw,ntiw,ntinc,ntoz,ntrw,ntsw,ntgl
             159                           use const,  only:RTYPE
             160                     !ch   use paramt
             161                     
             162                     !
             163                           implicit none
             164                     !
             165                     ! input & output variable
             166                     !
             167                           integer  nxj,nx,lev,ktpbl,jj,itype,idg,ncld,km,nmpbl,nmmiph,nc
             168                           real     dt,g,r,cp,xkapa,hltm,ptop,stbo,hice,tice
             169                     
             170                           integer  imx(2),itstp
             171                     
             172                           real     tg(nx),z0(nx),                                              &
             173                                    u(nx,lev),v(nx,lev),t(nx,lev),                              &
             174                                    ustar(nx),                                                  &
             175                                    tstar(nx),qstar(nx),e(nx,lev),eps(nx,lev),hflux(nx),        &
             176                                    qflux(nx),pkd(nx),pk2d(nx),gwclim(nx),                      &
             177                                    tgclim(nx),snr(nx),totalp(nx),                              &
             178                                    ss(nx),rs(nx),alb(nx),xkmx(2),xkmd(lev),                    &
             179                                    t2(nx),u10(nx),v10(nx),ustress(nx),vstress(nx),ssu(nx),ssv(nx)
             180                           real(kind=RTYPE) qt(nx,lev*ncld),q(nx,lev*ncld),phi(nx,lev),         &
             181                                            topo(nx),pss(nx),ut(nx,lev),vt(nx,lev),tt(nx,lev),  &
             182                                            pk(nx,lev),pk2(nx,lev)
             183                     !soil
             184                           real     smc(nx,km),stc(nx,km),canopy(nx),sigmaf(nx),                &
             185                                    rld(nx),runoff(nx)
             186                     
             187                           integer  istyp(nx),ivegtyp(nx)
             188                     !
             189                           logical  land(nx),ocean(nx),ice(nx)
             190                     !
             191                     !  local work arrays
             192                     !
             193                     !ch   real     hgt(im,lm),xkm(im,lm),xkh(im,lm),ts(im),                    &
             194                     !ch            qsfc(im),zl(im),czh(im),ps(im),sfcw(im),                    &
             195                     !ch            dhgt(im,lm),ro2(im,lm),dhgtz(im,lm)
             196                           real     hgt(nx),xkm(nx,lev),xkh(nx,lev),ts(nx),                     &
             197                                    qsfc(nx),zl(nx),czh(nx),ps(nx),sfcw(nx),                    &
             198                                    dhgt,ro2(nx),dhgtz(nx,lev)
             199                     !soil
             200                           real     rhscnpy(nx),rhsmc(nx,km),aim(nx,km),bim(nx,km),             &
             201                                    cim(nx,km),drain(nx),snomt(nx),zsoil(nx,km),                &
             202                                    runof(nx),gfx(nx),t850(nx),gesh(nx)
             203                     !
             204                     !ch   logical snow(im)
             205                           logical snow(nx)
             206                     !
             207                     ! ncep_pbl
             208                     !ch   integer   kpbl(im)
             209                     !ch   real      rb(im),fm(im),fh(im),hpbl(im),                          &
             210                     !ch             heat(im),evap(im),stress(im),                           &
             211                     !ch             prsl(im,lm),prslk(im,lm),phil(im,lm),del(im,lm),        &
             212                     !ch             prsi(im,lm+1),phi2(im,lm+1),phii(im,lm+1),              &
             213                     !ch             dsigma(lm,2),rcl(im),                                   &
             214                           integer   kpbl(nx)
             215                           real      rb(nx),fm(nx),fh(nx),hpbl(nx),                          &
             216                                     heat(nx),evap(nx),stress(nx),                           &
             217                                     prsl(nx,lev),prslk(nx,lev),phil(nx,lev),del(nx,lev),        &
             218                     !byl                prsi(nx,lev+1),phi2(nx,lev+1),phii(nx,lev+1),              &
             219                                     prsi(nx,lev+1),phii(nx,lev+1),                          &
             220                                     rcl(nx),                                                &
             221                                     u1(nx,lev),v1(nx,lev),t1(nx,lev)
             222                           real(kind=RTYPE) dsigma(lev,2)
             223                           real, dimension(:,:,:), allocatable :: q1
             224                     !
             225                           real      pk2x(nx,lev),pkx(nx,lev)
             226                     !
             227                     ! noah  ------------
             228                     ! input and output
             229                           integer islopetyp(nx),islmsk(nx),io,jo
             230                           real      sld(nx),                                                &
             231                                     slc(nx,km),                                             &
             232                                     sheleg(nx),snwdph(nx),sncover(nx),                      &
             233                                     zice(nx),cice(nx),xtice(nx),                            &
             234                                     rh2(nx),rh10(nx),                                       &
             235                                     shdmin(nx),shdmax(nx),snoalb(nx),albedo2(nx),sfemis_g(nx)
             236                     ! local
             237                           real      z0rl(nx),prslki(nx),cd(nx),cdq(nx),                     &
             238                                     tsurf(nx),psi(nx),prsl1(nx),                            &
             239                                     fm10(nx),fh2(nx),fh10(nx),                              &
             240                                     qsurf(nx),evapc(nx),cmm(nx),chh(nx),ep1d(nx),           &
             241                     !                radsl(nx) ,tprcp(nx),                                   &
             242                                     tprcp(nx),                                              &
             243                     !                phy_f2d(nx),q2(nx)
             244                                     ddvel(nx),q2(nx)
             245                     !
             246                           real      srflag(nx),sfemis(nx)
             247                     !orig logical   flag_guess(nx),flag_iter(nx),mom4ice(nx)
             248                           logical   flag_guess(nx),flag_iter(nx),mom4ice
             249                     !
             250                     !2018 new
             251                           logical   redrag
             252                           integer   ivegsrc,isot
             253                     !----------------------------------------------------
             254                     ! for new pbl: asl,atl,xmu
             255                           real      asl(nx,lev),atl(nx,lev),swh(nx,lev),hlw(nx,lev),xmu(nx)
             256                     
             257                     !----------------------------------------------------
             258                     ! for fractional step:
             259                           real      dudt(nx,lev),dvdt(nx,lev),dtdt(nx,lev),dqdt(nx,lev)
             260                     
             261                           integer  lsm,i,k,iter,kc,ntrac
             262                           real     ppd,ppp,ttt,ppu,dth,p850,ddd,cc,qqq
             263                     !
             264                     ! noah mode
             265                           lsm   =  1
             266                           mom4ice =.false.
             267                           redrag =.false.
             268                     !------------------------------------------------------------
             269                     !     io=67
             270                     !     jo=251
             271                     !     io=589
             272                     !     jo=148
             273                     !     io=705
             274                     !     jo=236
             275                           io=480
             276                           jo=240
             277                     !
             278                           ntrac=ncld
             279                           if ( nmmiph .eq. 6 ) ntrac=ncld-3
             280                           if ( nmmiph .eq. 8 ) ntrac=ncld-4
             281                           if ( nmmiph .eq.11 ) ntrac=7
             282                     
             283                           allocate(q1(nx,lev,ntrac))
             284                     !
             285                     ! --- ensure ktpbl selection is greater than 2
             286                     !
             287                           if ( ktpbl .lt. 2 )  ktpbl = 2
             288                     !
             289                     ! --- compute surface pres and surface air temp at current time level
             290                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.79, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, pk, tt, qt, pss, ps, ts
                                   <<< Loop-information  End >>>
             291     1  pp   2             do 50 i = 1, nxj
             292     1   p   2             ps(i) = pss(i) + ptop
             293     1   p   2             ttt = tt(i,lev)*(1.+0.608*qt(i,lev))
             294     1   p   2             ts(i) = ttt/pk(i,lev)*pk2(i,lev)
             295     1   p   2         50  continue
             296                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, pk2, pk2d, pkd, pk2x, pkx
                                   <<< Loop-information  End >>>
             297     1                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pkd, pk2d, pk, pk2
                                   <<< Loop-information  End >>>
             298     1  pp   2             pkd(:) =pk(:,k)
             299     1   p   2             pk2d(:)=pk2(:,k)
             300     1                     call vlog(pk2x(1,k),pk2d,nxj)
             301     1                     call vlog(pkx(1,k), pkd, nxj)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 14, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2x, pkx
                                   <<< Loop-information  End >>>
             302     2  pp   2             do i=1,nxj
             303     2   p   2               pk2x(i,k)=pk2x(i,k)*(cp/r)

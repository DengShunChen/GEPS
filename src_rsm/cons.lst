             253                           if(myrank .eq. 0) print typ
             254                           if(myrank .eq. 0) print stochy_physics
             255                     !
             256     1                     if (taui .ge. taue)  then
             257     1                       if(myrank .eq. 0)  &
             258     1                        print *,'******** aborting run, taui.ge.taue ******* '
             259     1                       stop
             260     1                     endif
             261                     
             262                     !
             263                     !  build pointer arrays for locating zonal and total wavenumber
             264                     !  values in the one-dimensional spherical harmonic arrays.
             265                     !
             266                     !  original allocation system only for spectral space
             267                     !
             268                           call sortml (jtrun,mlmax,msort,lsort,mlsort)
             269                     !
             270                     !  new allocation system in parallization for both spectral
             271                     !  and grid spaces
             272                     !
             273                     
             274                           call make_list
             275                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             276     1  pp                 do 150 m =1,mlistnum
             277     1   p                  mf=mlist(m)
             278     1               !
             279     1   p                  rm=mf-1
             280     1   p                  if (mf.eq.1)  rm= 0.0
             281     1   p                  cim(m) = rm
             282     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             283     2   p    s            do 150 l=mf,jtrun
             284     2   p    v             rl = l
             285     2   p    v             rlm= rl-1.0
             286     2   p    v             if (mf.eq.1)  rm= 0.0
             287     2   p    v             eps4(l,m)= rl*rlm/radsq
             288     3   p    s             if ( l.eq.1 ) then
             289     3   p    m              wdfac(1,m) = 0. ; wcfac(1,m) = 0.
             290     3   p    s             else
             291     3   p    s              wdfac(l,m) = 1.0/(radsq*eps4(l,m))
             292     3   p    s              wcfac(l,m) = cim(m)*wdfac(l,m)
             293     3   p    v             endif
             294     1   p    v        150 continue
             295                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aki, bki, sigma
                                   <<< Loop-information  End >>>
             296     1  pp   2v            do k=1,lev+1
             297     1   p   2v              sigma(k,1) = bki(k)
             298     1   p   2v              sigma(k,2) = aki(k)
             299     1   p   2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, dsigma
                                   <<< Loop-information  End >>>
             300     1  pp    v            do k=1,lev
             301     1   p    v              dsigma(k,1) = sigma(k+1,1) - sigma(k,1)
             302     1   p    v              dsigma(k,2) = sigma(k+1,2) - sigma(k,2)
             303     1   p    v            enddo
             304                     !--------------------------------------------------------------------------
             305                     !   for rrtmg
             306                     !--------------------------------------------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma, si
                                   <<< Loop-information  End >>>
             307     1  pp   2v            do k=1,lev+1
             308     1   p   2v               si(lev+2-k)=sigma(k,1)+sigma(k,2)/1000.
             309     1   p   2v            enddo
             310                     !--------------------------------------------------------------------------
             311                     !     build matrices for semi-implicit and normal mode initialization
             312                     !
             313                            call matrix_hybrid_cwb ( cp,sigma,dsigma,ptop,ptmean,tmean,spalm &
             314                                       , eigval,evecin,evectr,arrhyd,arsddt,pmcor,tmcor )
             315                     !
             316                     !  gaussian quadrature weights and latitudes
             317                     !
             318                           one = 1.0
             319                           onem= -one
             320                           call gausl3 (my,onem,one,weight,sinl)
             321                     !
             322                           my2= my/2
             323                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.33, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sinl, onocos, weight, cosl
                                   <<< Loop-information  End >>>
             324     1   s    s            do 180 j = 1, my2
             325     1   s    s            sinl(my+1-j)  = -sinl(j)
             326     1   s    s            weight(my+1-j)= weight(j)
             327     1   m    m            onocos(j)     = 1.0/(1.0-sinl(j)*sinl(j))
             328     1   s    s            onocos(my+1-j)= onocos(j)
             329     1   m    m            cosl(j)       = 1.0/sqrt(onocos(j))
             330     1   s    s            cosl(my+1-j)  = cosl(j)
             331     1   p    v        180 continue
             332                     !  define ndslfv
             333                     !
             334                           call ndslfv_init(nx,my,ncld,cosl,weight(1))
             335                     !
             336                     !  horizontal diffusion settings for sponge layer
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma
                                   <<< Loop-information  End >>>
             337     1   s    v            do k = 1, lev
             338     1   p    v              prslp=sigma(k,2)+sigma(k,1)*1000.+ptop
             339     1   p    v              if ( prslp .le. spl1  ) hdk1=k
             340     1   p    v              if ( prslp .le. spl2  ) hdk2(1)=k
             341     1   p    v              if ( prslp .le.  50.  ) hdk2(2)=k
             342     1   p    v              if ( prslp .le. 200.  ) hdk2(3)=k
             343     1   p    v            enddo
             344                     !
             345                     !
             346                     !  define coriolis parameter for each latitude
             347                     !
                                   <<< Loop-information Start >>>

             179     2                             ,',dailyClm_option=1, check ifilin_sst & ifilin_ClmANA'&
             180     2                             ,'is in filelist.'
             181     2                         ldailyFCTsst=.true.
             182     2                         dailyClm_option=1
             183     2                       endif
             184     1                 130 continue
             185     1                     endif
             186                           close(1)
             187                     
             188                     !
             189                           open (unit=2,file=trim(crdate),form='formatted')
             190                     !
             191                     ! read in idtg*12
             192                           read(2,'(i8.8)')idtg8
             193                           close(2)
             194                     ! transfer idtg8 to idtg*12
             195     1                     if(idtg8.gt.60000000)then
             196     1                       idtg = 190000000000 + idtg8*100
             197     1                     else
             198     1                       idtg = 200000000000 + idtg8*100
             199     1                     endif
             200                     !
             201                           write(cdtg,900)idtg
             202                      900  format(i12.12)
             203                     !
             204                           if(myrank .eq. 0) print*,' dtg=',cdtg
             205                     !-----------------------------------------------------------------------
             206                           read(cdtg,'(i4,i2,i2,i2,i2)') idate(1),idate(2),idate(3),idate(5)&
             207                                                        ,ii
             208                     !-----------------------------------------------------------------------
             209                     !
             210                           call days (cdtg,julian,hours)
             211                     !
             212                           flag =.false.
             213     1                     if(myrank .eq. 0)then
             214     1                       call recmsg('gfs',ifromtau,itotau,istat)
             215     1                       flag =.true.
             216     1                     endif
             217                     !ch   call mpe_broadcast(istat,1,flag,mpe_integer)
             218                           call mpe_bcast(istat,1,0,mpe_integer)
             219                     
             220     1                     if(istat.eq.-1)then
             221     1                       if(myrank.eq.0) print *,'RECMSG ERROR','RANK=',myrank
             222     1                       call mpe_finalize
             223     1                       call dmsexit(-1)
             224     1                     else if(istat.eq.1)then
             225     1                       call mpe_finalize
             226     1                       call dmsexit(0)
             227     1                     endif
             228                     !
             229                     !ch   call mpe_broadcast(ifromtau,1,flag,mpe_integer)
             230                     !ch   call mpe_broadcast(itotau,1,flag,mpe_integer)
             231                           call mpe_bcast(ifromtau,1,0,mpe_integer)
             232                           call mpe_bcast(itotau,1,0,mpe_integer)
             233                     !
             234                           taui=float(ifromtau)
             235                           taue=float(itotau)
             236                           tauo=float(itotau)+0.000001
             237                     !
             238                           tau   = 0.0
             239                           restrt=.false.
             240     1                     if (taui.gt.0.0)  then
             241     1                       itaui=ifromtau
             242     1                       itau= int(taui) + 0.001
             243     1                       itau= min(itau,itaui)
             244     1                       taui= float(itau)
             245     1                       restrt=.true.
             246     1                       if(myrank .eq. 0) print*,' restarting at tau=',itau
             247     1                       hours = hours+taui
             248     1                       julian= julian+hours/24.0+0.001
             249     1                       hours = mod(hours,24.)
             250     1                     endif
             251                     !

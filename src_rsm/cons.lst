             119                     
             120                     ! for ECHAM4 Tiedtke cumulus scheme
             121                           call cuparam
             122                           call inicon
             123                           call set_lookup_tables
             124                     
             125                           capa= 1.0/3.5
             126                           rgas= capa*cp
             127                           pi  = 4.0*atan(1.0)
             128                           radsq= rad*rad
             129                     !
             130                           call gpvs
             131                     !----------------------------------------------------------------!
             132                     !
             133                     !  read namlist of path/file name(operation)
             134                     !
             135                           call getfname(pathname,logicname,truefile,istat)
             136     1                     if(istat.ne.0)then
             137     1                       print *,'getfname : error','RANK=',myrank
             138     1                       call mpe_finalize
             139     1                       call dmsexit(-1)
             140     1                     else
             141     1                       if(myrank .eq. 0) print *,truefile
             142     1                     endif
             143                     !
             144                           open (unit=12,file=trim(truefile),form='formatted')
             145                     !!      open (unit=77,file='output.dat',form='formatted')
             146                     !
             147                           read (12,filst,end=110)
             148                     !
             149                       110 continue
             150                           close(12)
             151                     !
             152                           if(myrank .eq. 0) print filst
             153                     !
             154                     !  read namelist for model parameters
             155                     !
             156                           open (unit=1,file=trim(namlsts),form='formatted')
             157                     !
             158                           read (1,modlst,end=120)
             159                       120 continue
             160                           read (1,typ,end=121)
             161                       121 continue
             162                           ! read stochastic_physics
             163                           read (1,stochy_physics,end=122)
             164                       122 continue
             165                           read (1,grb_conf,end=123)
             166                       123 continue
             167                           close(1)
             168                     !
             169                           open (unit=1,file=trim(namlsts),form='formatted')
             170                     
             171     1                     if(do_sit) then
             172     1                       read (1,sit_nml,end=130)
             173     2                       if(myrank .eq. 0) then
             174     2                         print *, 'chlee debug...'
             175     2                         print sit_nml
             176     2                       endif
             177     2                       if(.NOT. ldailyFCTsst)then

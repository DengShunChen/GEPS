             331     2                       do i = 1, im
             332     3   p                     if (cnvflg(i) .and. k < kpbl(i)) then
             333     3   p                        xmf(i,k) = a1 * sqrt(wu2(i,k))
             334     3   p                        dz   = zl(i,k+1) - zl(i,k)
             335     3   p                        xmmx = dz / dt2
             336     3   p                        xmf(i,k) = min(xmf(i,k),xmmx)
             337     3   p                     endif

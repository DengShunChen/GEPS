               1                           subroutine evpcup ( nn,nx,lev,ktmin,prevap,ql,qls,pmassl &
               2                                             , pprod,dqo )
               3                     !
               4                     !  subroutine to partially evaporate cumlus precipitation as
               5                     !  it falls.  evaporation is proportional to layer mass and
               6                     !  inversely proportional to layer relative humidity.
               7                     !
               8                     !  parameters:
               9                     !
              10                     !  input:
              11                     !
              12                     !     nn    : number of convective points in latitude rung
              13                     !     nx    : horizontal dimension
              14                     !     lev   : number of levels
              15                     !     ktmin : deepest cloud top index
              16                     !     prevap: fraction of precip evaporated
              17                     !     ql    : specific humidity`
              18                     !     qls   : saturation specific humidity
              19                     !     pmassl:  layer mass
              20                     !     pprod : precip mass generated in each layer penetrated
              21                     !            by clouds
              22                     !     dqo   : water mass budget
              23                     !
              24                     !  output:
              25                     !
              26                     !     dqo   : adjusted water mass budget
              27                     !
              28                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              29                     !
              30                           use paramt
              31                     
              32                           implicit  none
              33                     
              34                           integer   nn,nx,lev,ktmin
              35                           real      prevap
              36                     
              37                           real      ql(nx,lev),qls(nx,lev),pmassl(nx,lev),  &
              38                                     pprod(nx,lev,lev),dqo(nx,lev,lev)
              39                     !
              40                           integer   k,i,l,ktype
              41                           real      rhmass(im,lm),xx(im,lm),dqcup(im,lm)
              42                     !
              43                     !  (layer mass)/relative humidity
              44                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qls, rhmass
                                   <<< Loop-information  End >>>
              45     1  pp                 do 20 k = ktmin, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.34, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ql, qls, rhmass
                                   <<< Loop-information  End >>>
              46     2   p   2v            do 20 i = 1, nn
              47     2   p   2v            rhmass(i,k)= qls(i,k)/ql(i,k)
              48     1   p   2v         20 continue
              49                     !
                                   <<< Loop-information Start >>>

             210                     !                                               ! 1: put afluxs(G0),awust2(ustr),awvst2(vstr),awfre(P-E) of echam to ocean, and all the T,u,v,s back to ECHAMS,
             211                     !                                               !    with sea ice correction (fluxiw rather than fluxs)
             212                     !                                               ! 2: Same as option 1, but also with sitwkh to ocean
             213                     !                                               ! 3: Same as option 2, but also with sitwkm to ocean
             214                     !                                               ! 4: Same as option 3, but without secruity number for diffusivity
             215                     !                                               ! 5: Same as option 1, but don't feedback anything back to sit.
             216                     !                                               ! 6: Same as option 5, but don't put awust2(ustr),awvst2(vstr) of echam to ocean.
             217                     !                                               ! 7: put wind stress, 1st layer sst and salinity of echam to ocean,
             218                     !                                               !    but don't feedback anything back to sit.
             219                     !                                               ! 8: put awust2,awvst2 of echam to ocean, but nothing back to sit.
             220                     !                                               ! 9: put wtb,wsb,awust2,awvst2,subfluxw,wsubsal of echam to ocean, and T,u,v,s back to SIT.
             221                     !                                               !10: Same as option 0, but skip TX,TY,TZ,SX,SY,SZ in ocn_stepon
             222                     !                                               !11: full-level (T,u,v,s) 2-way coupling with 3-D ocean, and T,u,v,s back to SIT.
             223                     !                                               !12: put nothing of echam to ocean, and nothing back to sit.
             224                     !                                               !13: Same as option 1, but T,S initialized by DIECAST
             225                     !                                               !14: Same as option 1, but without sea ice correction (fluxs rather than fluxiw)
             226                     !                                               !15: Same as option 10, + TX,SX
             227                     !                                               !16: Same as option 10, + TY,SY
             228                     !                                               !17: Same as option 10, + TZ,SZ
             229                           INTEGER :: high_current_killer = 4        ! 1: based on bottom vorticity: damp_high_vel(1:lnlon,1:lnlat,1:nh)=DAMP_high_current*MERGE( 1.,0.,ABS(vor_bottom(1:lnlon,1:lnlat,1:nh)).GT.VOR_cri )

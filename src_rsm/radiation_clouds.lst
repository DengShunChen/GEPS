            3495     3   p   2                   if (plvl(i,k) < ptop1(i,2))  klowt = min(klowt,k)
            3496     3   p   2                   taufac(i,k) = plvl(i,k) - plvl(i,k+1)       ! dp for later cal cldtau use
            3497     3   p   2                 enddo

            3514     2               
            3515     2               !  ---  put convective cloud into 'cldcnv', no merge at this point..
            3516     2               
            3517     3   p                     if (cv(i) >= climit .and. cvt(i) < cvb(i)) then
            3518     3   p                       id  = 1
            3519     3   p                       id1 = 1
            3520     3               
            3521     4   p                       lab_do_k_cvt : do k = nlay-1, 1, -1
            3522     5   p                         if (cvt(i) <= plyr(i,k)) then
            3523     5   p                           id = k + 1

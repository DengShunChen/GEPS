            1907                           subroutine progcld5                                               &
            1908                     !...................................
            1909                     !
            1910                     !  ---  inputs:
            1911                                ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,cnvw,cnvc,          &
            1912                                  xlat,xlon,slmsk,IX, NLAY, NLP1,                            &
            1913                                  cldcov,                                                    &
            1914                     !  ---  outputs:
            1915                          &       clouds,clds,mtop,mbot                                      &
            1916                          &      )
            1917                     
            1918                     ! =================   subprogram documentation block   ================ !
            1919                     !                                                                       !
            1920                     ! subprogram:    progcld5    computes cloud related quantities using    !
            1921                     !   GFDL Lin MP prognostic cloud microphysics scheme.                   !
            1922                     !                                                                       !
            1923                     ! abstract:  this program computes cloud fractions from cloud           !
            1924                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            1925                     !   and computes the low, mid, high, total and boundary layer cloud     !
            1926                     !   fractions and the vertical indices of low, mid, and high cloud      !
            1927                     !   top and base.  the three vertical cloud domains are set up in the   !
            1928                     !   initial subroutine "cld_init".                                      !
            1929                     !                                                                       !
            1930                     ! usage:         call progcld5                                          !
            1931                     !                                                                       !
            1932                     ! subprograms called:   gethml                                          !
            1933                     !                                                                       !
            1934                     ! attributes:                                                           !
            1935                     !   language:   fortran 90                                              !
            1936                     !   machine:    ibm-sp, sgi                                             !
            1937                     !                                                                       !
            1938                     !                                                                       !
            1939                     !  ====================  definition of variables  ====================  !
            1940                     !                                                                       !
            1941                     ! input variables:                                                      !
            1942                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            1943                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            1944                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            1945                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            1946                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            1947                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            1948                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            1949                     !   clw   (IX,NLAY) : layer cloud condensate amount                     !
            1950                     !   cnvw  (IX,NLAY) : layer convective cloud condensate                 !
            1951                     !   cnvc  (IX,NLAY) : layer convective cloud cover                      !
            1952                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            1953                     !                     range, otherwise see in-line comment              !
            1954                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            1955                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            1956                     !   IX              : horizontal dimention                              !
            1957                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            1958                     !   cldcov(IX,NLAY) : total cloud fraction                              !
            1959                     !                                                                       !
            1960                     ! output variables:                                                     !
            1961                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            1962                     !      clouds(:,:,1) - layer total cloud fraction, =cldcov(IX,NLAY)     !
            1963                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            1964                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            1965                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            1966                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            1967                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            1968                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            1969                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            1970                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            1971                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            1972                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            1973                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            1974                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            1975                     !                                                                       !
            1976                     ! module variables:                                                     !
            1977                     !   ivflip          : control flag of vertical index direction          !
            1978                     !                     =0: index from toa to surface                     !
            1979                     !                     =1: index from surface to toa                     !
            1980                     !   lsashal         : control flag for shallow convection               !
            1981                     !   lcrick          : control flag for eliminating CRICK                !
            1982                     !                     =t: apply layer smoothing to eliminate CRICK      !
            1983                     !                     =f: do not apply layer smoothing                  !
            1984                     !   lcnorm          : control flag for in-cld condensate                !
            1985                     !                     =t: normalize cloud condensate                    !
            1986                     !                     =f: not normalize cloud condensate                !
            1987                     !                                                                       !
            1988                     !  ====================    end of description    =====================  !
            1989                     !
            1990                           implicit none
            1991                     
            1992                     !  ---  inputs
            1993                           integer,  intent(in) :: IX, NLAY, NLP1
            1994                     
            1995                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            1996                          &       tlyr, tvly, qlyr, qstl, rhly, clw, cnvw, cnvc, cldcov!,     &
            1997                     !             re_cloud, re_ice, re_snow
            1998                     
            1999                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2000                          &       slmsk
            2001                     
            2002                     !  ---  outputs
            2003                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2004                     
            2005                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2006                     
            2007                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2008                     
            2009                     !  ---  local variables:
            2010                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv,              &
            2011                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf, &
            2012                          &       cldtot
            2013                     
            2014                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2015                     
            2016                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            2017                          &       tem1, tem2, tem3
            2018                     
            2019                           integer :: i, k, id, nf
            2020                     
            2021                     !
            2022                     !===> ... begin here
            2023                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2024        pp   4             cldtot = cldcov
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2025     1  pp                 do nf=1,nf_clds
            2026     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2027     3   p   4                 do i=1,ix
            2028     3   p   4                   clouds(i,k,nf) = 0.0
            2029     3   p   4                 enddo
            2030     2   p                   enddo
            2031     1   p                 enddo
            2032                     !     clouds(:,:,:) = 0.0
            2033                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      res, cwp, cip, crp, csp, tem2d, rew, rei
                                   <<<      cldcnv, rer, clwf
                                   <<< Loop-information  End >>>
            2034     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.41, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      res, cwp, cip, crp, csp, rew, rei, rer
                                   <<<      tem2d, clwf, cldcnv
                                   <<< Loop-information  End >>>
            2035     2   p                   do i = 1, IX
            2036     2   p                     cldcnv(i,k) = 0.0
            2037     2   p                     cwp   (i,k) = 0.0
            2038     2   p                     cip   (i,k) = 0.0
            2039     2   p                     crp   (i,k) = 0.0
            2040     2   p                     csp   (i,k) = 0.0
            2041     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
            2042     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
            2043     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            2044     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
            2045     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
            2046     2   p                     clwf(i,k)   = 0.0
            2047     2   p                   enddo
            2048     1   p                 enddo
            2049                     !
            2050     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2051     2  pp   2               do i = 1, IX
            2052     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
            2053     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
            2054     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2055     2  pp                   do k = 2, NLAY-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2056     3   p   2                 do i = 1, IX
            2057     3   p   2                   clwf(i,K) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
            2058     3   p   2                 enddo
            2059     2   p                   enddo
            2060     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2061     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            2062     3   p   4                 do i = 1, IX
            2063     3   p   4                   clwf(i,k) = clw(i,k)
            2064     3   p   4                 enddo
            2065     2   p                   enddo
            2066     1                     endif
            2067                     
            2068                     !  ---  find top pressure for each cloud domain for given latitude
            2069                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2070                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2071                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2072     1  pp                 do id = 1, 4
            2073     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2074     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2075     2   p   2               do i =1, IX
            2076     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2077     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2078     2               
            2079     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2080     2   p   2               enddo
            2081     1   p                 enddo
            2082                     
            2083                     !  ---  compute liquid/ice condensate path in g/m**2
            2084                     
            2085     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
            2086     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
            2087     3   p                     do i = 1, IX
            2088     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2089     3   p                       clwt     = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
            2090     3   p                       cip(i,k) = clwt * tem2d(i,k)
            2091     3   p                       cwp(i,k) = clwt - cip(i,k)
            2092     3   p                     enddo
            2093     2   p                   enddo
            2094     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
            2095     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
            2096     3   p                     do i = 1, IX
            2097     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2098     3   p                       clwt     = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
            2099     3   p                       cip(i,k) = clwt * tem2d(i,k)
            2100     3   p                       cwp(i,k) = clwt - cip(i,k)
            2101     3   p                     enddo
            2102     2   p                   enddo
            2103     1                     endif                            ! end_if_ivflip
            2104                     
            2105                     !  ---  effective liquid cloud droplet radius over land
            2106                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            2107     1  pp                 do i = 1, IX
            2108     2   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            2109     3   p   4                 do k = 1, NLAY
            2110     3   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            2111     3   p   4                 enddo
            2112     2   p                   endif
            2113     1   p                 enddo
            2114                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2115     1  pp   2             do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2116     2   p   2               do i = 1, IX
            2117     3   p   2                 if (cldtot(i,k) < climit) then
            2118     3   p   2                   cwp(i,k)    = 0.0
            2119     3   p   2                   cip(i,k)    = 0.0
            2120     3   p   2                   crp(i,k)    = 0.0
            2121     3   p   2                   csp(i,k)    = 0.0
            2122     3   p   2                 endif
            2123     2   p   2               enddo
            2124     1   p   2             enddo
            2125                     
            2126     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2127     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2128     3   p                     do i = 1, IX
            2129     4   p                       if (cldtot(i,k) >= climit) then
            2130     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            2131     4   p                         cwp(i,k) = cwp(i,k) * tem1
            2132     4   p                         cip(i,k) = cip(i,k) * tem1
            2133     4   p                         crp(i,k) = crp(i,k) * tem1
            2134     4   p                         csp(i,k) = csp(i,k) * tem1
            2135     4   p                       endif
            2136     3   p                     enddo
            2137     2   p                   enddo
            2138     1                     endif
            2139                     
            2140                     !  ---  effective ice cloud droplet radius
            2141                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2142,2167)
                                   <<< Loop-information  End >>>
            2142     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 2143,2168)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, cwp, rew, rei, rer, res
                                   <<< Loop-information  End >>>
            2143     2   p                   do i = 1, IX
            2144     2   p                     tem2 = tlyr(i,k) - con_ttp
            2145     2               
            2146     3   p                     if (cip(i,k) > 0.0) then
            2147     3   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            2148     3               
            2149     4   p                       if (tem2 < -50.0) then
            2150     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            2151     4   p                       elseif (tem2 < -40.0) then
            2152     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            2153     4   p                       elseif (tem2 < -30.0) then
            2154     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            2155     4   p                       else
            2156     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            2157     4   p                       endif
            2158     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            2159     3               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            2160     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            2161     3               !           rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            2162     3   p                     endif
            2163     2   p                   enddo
            2164     1   p                 enddo
            2165                     
            2166                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2167     1                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            2168     2                       do i = 1, IX
            2169     2   p                     clouds(i,k,1) = cldtot(i,k)
            2170     2   p                     clouds(i,k,2) = cwp(i,k)
            2171     2   p                     clouds(i,k,3) = rew(i,k)
            2172     2   p                     clouds(i,k,4) = cip(i,k)
            2173     2   p                     clouds(i,k,5) = rei(i,k)
            2174     2               !         clouds(i,k,6) = 0.0
            2175     2   p                     clouds(i,k,7) = rer(i,k)
            2176     2               !         clouds(i,k,8) = 0.0
            2177     2   p                     clouds(i,k,9) = res(i,k)
            2178     2                       enddo
            2179     1                     enddo
            2180                     
            2181                     
            2182                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            2183                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            2184                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            2185                     !       overlapping method is defined by control flag 'iovr', which may
            2186                     !       be different for lw and sw radiation programs.
            2187                     
            2188                           call gethml                                                       &
            2189                     !  ---  inputs:
            2190                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            2191                          &       IX,NLAY,                                                   &
            2192                     !  ---  outputs:
            2193                          &       clds, mtop, mbot                                           &
            2194                          &     )
            2195                     
            2196                     
            2197                     !
            2198                           return
            2199                     !...................................
            2200                           end subroutine progcld5
            2201                     !-----------------------------------
            2202                     
            2203                     
            2204                     
            2205                     !-----------------------------------
            2206                           subroutine progcld5o                                              &
            2207                     !...................................
            2208                     !
            2209                     !  ---  inputs:
            2210                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
            2211                          &       xlat,xlon,slmsk,                                           &
            2212                          &       ntrac,ntcw,ntiw,ntrw,ntsw,ntgl,cldcov,                     &
            2213                          &       effr_cw,effr_iw,effr_sw,effr_rw,effr_in,                   &
            2214                          &       IX, NLAY, NLP1,                                            &
            2215                     !  ---  outputs:
            2216                          &       clouds,clds,mtop,mbot                                      &
            2217                          &      )
            2218                     
            2219                     ! =================   subprogram documentation block   ================ !
            2220                     !                                                                       !
            2221                     ! subprogram:    progcld5o   computes cloud related quantities using    !
            2222                     !   GFDL Lin MP prognostic cloud microphysics scheme. Moist species     !
            2223                     !   from MP are fed into the corresponding arrays for calcuation of     !
            2224                     !                                                                       !
            2225                     ! abstract:  this program computes cloud fractions from cloud           !
            2226                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            2227                     !   and computes the low, mid, high, total and boundary layer cloud     !
            2228                     !   fractions and the vertical indices of low, mid, and high cloud      !
            2229                     !   top and base.  the three vertical cloud domains are set up in the   !
            2230                     !   initial subroutine "cld_init".                                      !
            2231                     !                                                                       !
            2232                     ! usage:         call progcld5o                                         !
            2233                     !                                                                       !
            2234                     ! subprograms called:   gethml                                          !
            2235                     !                                                                       !
            2236                     ! attributes:                                                           !
            2237                     !   language:   fortran 90                                              !
            2238                     !   machine:    ibm-sp, sgi                                             !
            2239                     !                                                                       !
            2240                     !                                                                       !
            2241                     !  ====================  definition of variables  ====================  !
            2242                     !                                                                       !
            2243                     ! input variables:                                                      !
            2244                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            2245                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            2246                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            2247                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            2248                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            2249                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            2250                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            2251                     !   clw   (IX,NLAY,NTRAC) : layer cloud condensate amount               !
            2252                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            2253                     !                     range, otherwise see in-line comment              !
            2254                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            2255                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            2256                     !   ntrac           : number of tracers
            2257                     !   ntcw            : index for liquid water
            2258                     !   ntiw            : index for ice water
            2259                     !   ntrw            : index for rain water
            2260                     !   ntsw            : index for snow water
            2261                     !   ntgl            : index for graupel
            2262                     !   cldcov(IX,NLAY) : total cloud fraction
            2263                     !   effr_cw(IX,NLAY): effective radius of liquid water (mm)             !
            2264                     !   effr_iw(IX,NLAY): effective radius of ice water (mm)                !
            2265                     !   effr_rw(IX,NLAY): effective radius of rain water (mm)               !
            2266                     !   effr_sw(IX,NLAY): effective radius of snow water (mm)               !
            2267                     !   IX              : horizontal dimention                              !
            2268                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            2269                     !                                                                       !
            2270                     ! output variables:                                                     !
            2271                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            2272                     !      clouds(:,:,1) - layer total cloud fraction                       !
            2273                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            2274                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            2275                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            2276                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            2277                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            2278                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            2279                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            2280                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            2281                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            2282                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            2283                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            2284                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            2285                     !                                                                       !
            2286                     ! module variables:                                                     !
            2287                     !   ivflip          : control flag of vertical index direction          !
            2288                     !                     =0: index from toa to surface                     !
            2289                     !                     =1: index from surface to toa                     !
            2290                     !   lsashal         : control flag for shallow convection               !
            2291                     !   lcrick          : control flag for eliminating CRICK                !
            2292                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2293                     !                     =f: do not apply layer smoothing                  !
            2294                     !   lcnorm          : control flag for in-cld condensate                !
            2295                     !                     =t: normalize cloud condensate                    !
            2296                     !                     =f: not normalize cloud condensate                !
            2297                     !                                                                       !
            2298                     !  ====================    end of description    =====================  !
            2299                     !
            2300                           implicit none
            2301                     
            2302                     !  ---  inputs
            2303                           integer,  intent(in) :: IX, NLAY, NLP1
            2304                           integer,  intent(in) :: ntrac, ntcw, ntiw, ntrw, ntsw, ntgl
            2305                     
            2306                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            2307                          &       tlyr, tvly, qlyr, qstl, rhly, cldcov
            2308                     
            2309                     
            2310                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: clw
            2311                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2312                          &       slmsk
            2313                     
            2314                           real (kind=kind_phys), dimension(:,:), intent(in) :: effr_cw,     &
            2315                          &       effr_iw, effr_rw, effr_sw
            2316                     
            2317                           logical, intent(in) :: effr_in
            2318                     
            2319                     !  ---  outputs
            2320                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2321                     
            2322                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2323                     
            2324                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2325                     
            2326                     !  ---  local variables:
            2327                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv,              &
            2328                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d
            2329                     
            2330                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2331                     
            2332                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            2333                          &       tem1, tem2, tem3
            2334                           real (kind=kind_phys), dimension(IX,NLAY) :: cldtot
            2335                     
            2336                           integer :: i, k, id, nf
            2337                     
            2338                     !
            2339                     !===> ... begin here
            2340                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2341     1  pp                 do nf=1,nf_clds
            2342     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2343     3   p   4                 do i=1,ix
            2344     3   p   4                   clouds(i,k,nf) = 0.0
            2345     3   p   4                 enddo
            2346     2   p                   enddo
            2347     1   p                 enddo
            2348                     !     clouds(:,:,:) = 0.0
            2349                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp, rew, tem2d, cldcnv, rei, cwp
                                   <<<      rer, res, cldtot, cip
                                   <<< Loop-information  End >>>
            2350     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.28, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, crp, csp, rew, rei
                                   <<<      rer, res, tem2d, cldtot
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2351     2   p                   do i = 1, IX
            2352     2   p                     cldcnv(i,k) = 0.0
            2353     2   p                     cwp   (i,k) = 0.0
            2354     2   p                     cip   (i,k) = 0.0
            2355     2   p                     crp   (i,k) = 0.0
            2356     2   p                     csp   (i,k) = 0.0
            2357     3   p                     if ( effr_in ) then
            2358     3   p                       rew (i,k) = effr_cw (i,k)
            2359     3   p                       rei (i,k) = effr_iw (i,k)
            2360     3   p                       rer (i,k) = effr_rw (i,k)
            2361     3   p                       res (i,k) = effr_sw (i,k)
            2362     3   p                     else
            2363     3   p                       rew (i,k) = reliq_def            ! default liq radius to 10 micron
            2364     3   p                       rei (i,k) = reice_def            ! default ice radius to 50 micron
            2365     3   p                       rer (i,k) = rrain_def            ! default rain radius to 1000 micron
            2366     3   p                       res (i,k) = rsnow_def            ! default snow radius to 250 micron
            2367     3   p                     endif
            2368     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
            2369     2   p                     cldtot(i,k) = cldcov(i,k)
            2370     2   p                   enddo
            2371     1   p                 enddo
            2372                     
            2373                     !  ---  find top pressure for each cloud domain for given latitude
            2374                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2375                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2376                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2377     1  pp                 do id = 1, 4
            2378     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2379     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2380     2   p   2               do i =1, IX
            2381     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2382     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2383     2               
            2384     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2385     2   p   2               enddo
            2386     1   p                 enddo
            2387                     
            2388                     !  ---  compute liquid/ice condensate path in g/m**2
            2389                     
            2390     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2391     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.10, ITR: 11, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2392     3   p                     do i = 1, IX
            2393     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2394     3   p                       cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            2395     3   p                       cip(i,k) = max(0.0, clw(i,k,ntiw) * gfac * delp(i,k))
            2396     3   p                       crp(i,k) = max(0.0, clw(i,k,ntrw) * gfac * delp(i,k))
            2397     3   p                       csp(i,k) = max(0.0, (clw(i,k,ntsw)+clw(i,k,ntgl)) *         &
            2398     3                    &                  gfac * delp(i,k))
            2399     3   p                     enddo
            2400     2   p                   enddo
            2401     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, crp, cip, csp
                                   <<< Loop-information  End >>>
            2402     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.10, ITR: 11, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2403     3   p                     do i = 1, IX
            2404     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2405     3   p                       cwp(i,k) = max(0.0, clw(i,k,ntcw) * gfac * delp(i,k))
            2406     3   p                       cip(i,k) = max(0.0, clw(i,k,ntiw) * gfac * delp(i,k))
            2407     3   p                       crp(i,k) = max(0.0, clw(i,k,ntrw) * gfac * delp(i,k))
            2408     3   p                       csp(i,k) = max(0.0, (clw(i,k,ntsw)+clw(i,k,ntgl)) *         &
            2409     3                    &                  gfac * delp(i,k))
            2410     3   p                     enddo
            2411     2   p                   enddo
            2412     1                     endif                            ! end_if_ivflip
            2413                     
            2414                     !  ---  effective liquid cloud droplet radius over land
            2415                     
            2416     1                     if ( .not. effr_in ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            2417     2  pp                 do i = 1, IX
            2418     3   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            2419     4   p   4                 do k = 1, NLAY
            2420     4   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            2421     4   p   4                 enddo
            2422     3   p                   endif
            2423     2   p                 enddo
            2424     1                     endif
            2425                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2426     1  pp   2             do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2427     2   p   2               do i = 1, IX
            2428     3   p   2                 if (cldtot(i,k) < climit) then
            2429     3   p   2                   cldtot(i,k) = 0.0
            2430     3   p   2                   cwp(i,k)    = 0.0
            2431     3   p   2                   cip(i,k)    = 0.0
            2432     3   p   2                   crp(i,k)    = 0.0
            2433     3   p   2                   csp(i,k)    = 0.0
            2434     3   p   2                 endif
            2435     2   p   2               enddo
            2436     1   p   2             enddo
            2437                     
            2438     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2439     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2440     3   p                     do i = 1, IX
            2441     4   p                       if (cldtot(i,k) >= climit) then
            2442     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            2443     4   p                         cwp(i,k) = cwp(i,k) * tem1
            2444     4   p                         cip(i,k) = cip(i,k) * tem1
            2445     4   p                         crp(i,k) = crp(i,k) * tem1
            2446     4   p                         csp(i,k) = csp(i,k) * tem1
            2447     4   p                       endif
            2448     3   p                     enddo
            2449     2   p                   enddo
            2450     1                     endif
            2451                     
            2452                     !  ---  effective ice cloud droplet radius
            2453                     
            2454     1                     if ( .not. effr_in ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2455     2  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip
                                   <<< Loop-information  End >>>
            2456     3   p                   do i = 1, IX
            2457     3   p                     tem2 = tlyr(i,k) - con_ttp
            2458     3               
            2459     4   p                     if (cip(i,k) > 0.0) then
            2460     4   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            2461     4               
            2462     5   p                       if (tem2 < -50.0) then
            2463     5   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            2464     5   p                       elseif (tem2 < -40.0) then
            2465     5   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            2466     5   p                       elseif (tem2 < -30.0) then
            2467     5   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            2468     5   p                       else
            2469     5   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            2470     5   p                       endif
            2471     4               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            2472     4               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            2473     4   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            2474     4               !           rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            2475     4   p                     endif
            2476     3   p                   enddo
            2477     2   p                 enddo
            2478     1                     endif
            2479                     
            2480                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cwp, rew, cip, rei, crp, rer
                                   <<<      csp, res
                                   <<< Loop-information  End >>>
            2481     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.76, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp
                                   <<<      cldtot, res
                                   <<< Loop-information  End >>>
            2482     2   p                   do i = 1, IX
            2483     2   p                     clouds(i,k,1) = cldtot(i,k)
            2484     2   p                     clouds(i,k,2) = cwp(i,k)
            2485     2   p                     clouds(i,k,3) = rew(i,k)
            2486     2   p                     clouds(i,k,4) = cip(i,k)
            2487     2   p                     clouds(i,k,5) = rei(i,k)
            2488     2   p                     clouds(i,k,6) = crp(i,k)
            2489     2   p                     clouds(i,k,7) = rer(i,k)
            2490     2   p                     clouds(i,k,8) = csp(i,k)
            2491     2   p                     clouds(i,k,9) = res(i,k)
            2492     2   p                   enddo
            2493     1   p                 enddo
            2494                     
            2495                     
            2496                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            2497                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            2498                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            2499                     !       overlapping method is defined by control flag 'iovr', which may
            2500                     !       be different for lw and sw radiation programs.
            2501                     
            2502                           call gethml                                                       &
            2503                     !  ---  inputs:
            2504                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            2505                          &       IX,NLAY,                                                   &
            2506                     !  ---  outputs:
            2507                          &       clds, mtop, mbot                                           &
            2508                          &     )
            2509                     
            2510                     
            2511                     !
            2512                           return
            2513                     !...................................
            2514                           end subroutine progcld5o
            2515                     !-----------------------------------
            2516                     
            2517                     !-----------------------------------
            2518                           subroutine progcld6                                               &
            2519                     !...................................
            2520                     
            2521                     !  ---  inputs:
            2522                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,cnvw,cnvc,              &
            2523                          &       qw,qr,qi,qs,qg,qa,                                         &
            2524                          &       cldtot,slmsk,snowd,                                        &
            2525                          &       xlat,xlon,IX,NLAY,NLP1,                                    &
            2526                     !  ---  outputs:
            2527                          &       clouds,clds,mtop,mbot                                      &
            2528                          &      )
            2529                     
            2530                     ! =================   subprogram documentation block   ================ !
            2531                     !                                                                       !
            2532                     ! subprogram:    progcld1    computes cloud related quantities using    !
            2533                     !   zhao/moorthi's prognostic cloud microphysics scheme.                !
            2534                     !                                                                       !
            2535                     ! abstract:  this program computes cloud fractions from cloud           !
            2536                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            2537                     !   and computes the low, mid, high, total and boundary layer cloud     !
            2538                     !   fractions and the vertical indices of low, mid, and high cloud      !
            2539                     !   top and base.  the three vertical cloud domains are set up in the   !
            2540                     !   initial subroutine "cld_init".                                      !
            2541                     !                                                                       !
            2542                     ! usage:         call progcld1                                          !
            2543                     !                                                                       !
            2544                     ! subprograms called:   gethml                                          !
            2545                     !                                                                       !
            2546                     ! attributes:                                                           !
            2547                     !   language:   fortran 90                                              !
            2548                     !   machine:    ibm-sp, sgi                                             !
            2549                     !                                                                       !
            2550                     !                                                                       !
            2551                     !  ====================  definition of variables  ====================  !
            2552                     !                                                                       !
            2553                     ! input variables:                                                      !
            2554                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            2555                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            2556                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            2557                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            2558                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            2559                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            2560                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            2561                     !   cnvw  (ix,nlay) : layer convective cloud condensate                 !
            2562                     !   cnvc  (ix,nlay) : layer convective cloud cover                      !
            2563                     !   qw    (ix,nlay) : cloud water mixing ratio (kg/kg)                  !
            2564                     !   qr    (ix,nlay) : rain water mixing ratio (kg/kg)                   !
            2565                     !   qi    (ix,nlay) : cloud ice mixing ratio (kg/kg)                    !
            2566                     !   qs    (ix,nlay) : snow water mixing ratio (kg/kg)                   !
            2567                     !   qg    (ix,nlay) : graupel mixing ratio (kg/kg)                      !
            2568                     !   qa    (ix,nlay) : aerosol mixing ratio (kg/kg)                      !
            2569                     !   cldtot(ix,nlay) : layer cloud fraction                              !
            2570                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            2571                     !   snowd (ix)      : snow depth                                        !
            2572                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            2573                     !                     range, otherwise see in-line comment              !
            2574                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            2575                     !   IX              : horizontal dimention                              !
            2576                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            2577                     !                                                                       !
            2578                     ! output variables:                                                     !
            2579                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            2580                     !      clouds(:,:,1) - layer total cloud fraction                       !
            2581                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            2582                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            2583                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            2584                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            2585                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            2586                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            2587                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            2588                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            2589                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            2590                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            2591                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            2592                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            2593                     !                                                                       !
            2594                     ! module variables:                                                     !
            2595                     !   ivflip          : control flag of vertical index direction          !
            2596                     !                     =0: index from toa to surface                     !
            2597                     !                     =1: index from surface to toa                     !
            2598                     !   lsashal         : control flag for shallow convection               !
            2599                     !   lcrick          : control flag for eliminating CRICK                !
            2600                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2601                     !                     =f: do not apply layer smoothing                  !
            2602                     !   lcnorm          : control flag for in-cld condensate                !
            2603                     !                     =t: normalize cloud condensate                    !
            2604                     !                     =f: not normalize cloud condensate                !
            2605                     !                                                                       !
            2606                     !  ====================    end of description    =====================  !
            2607                     
            2608                     #if defined (GFDLMP_v2)
            2609                           use cld_eff_rad_v2,     only : cld_eff_rad
            2610                     #endif
            2611                     !
            2612                           implicit none
            2613                     
            2614                     !  ---  inputs
            2615                           integer,  intent(in) :: IX, NLAY, NLP1
            2616                     
            2617                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            2618                          &       tlyr, tvly, qlyr, qstl, rhly,  cnvw, cnvc
            2619                     
            2620                           real (kind=kind_phys), dimension(:,:), intent(inout) ::           &
            2621                          &       qw, qr, qi, qs, qg, qa
            2622                           real (kind=kind_phys), dimension(:,:), intent(inout) :: cldtot
            2623                     
            2624                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2625                          &       slmsk, snowd
            2626                     
            2627                     !  ---  outputs
            2628                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2629                     
            2630                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2631                     
            2632                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2633                     
            2634                     !  ---  local variables:
            2635                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv,              &
            2636                          &       cwp, cip, crp, csp, cgp, rew, rei, res, rer, reg, delp,    &
            2637                          &       tem2d, clwf
            2638                     
            2639                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2640                     
            2641                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            2642                          &       tem1, tem2, tem3
            2643                     
            2644                           integer :: i, k, id, nf
            2645                     
            2646                     !
            2647                     !===> ... begin here
            2648                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2649     1  pp                 do nf=1,nf_clds
            2650     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2651     3   p   4                 do i=1,ix
            2652     3   p   4                   clouds(i,k,nf) = 0.0
            2653     3   p   4                 enddo
            2654     2   p                   enddo
            2655     1   p                 enddo
            2656                     !     clouds(:,:,:) = 0.0
            2657                     
            2658                     #if defined (GFDLMP_v2)
            2659                     !      call cld_eff_rad (1, IX, 1, NLAY, slmsk, plyr*100,                &
            2660                     !     &                  abs(plvl(:,1:NLAY)-plvl(:,2:NLAY+1))*100,       &
            2661                     !     &                  tlyr, qw, qi, qr, qs, qg, qa, cwp, cip, crp,    &
            2662                     !     &                  csp, cgp, rew, rei, rer, res, reg, cldtot,      &
            2663                     !     &                  cldtot, snowd, cnvw=cnvw)
            2664                     !      cldcnv = cnvc
            2665                           call cld_eff_rad (1, IX, 1, NLAY, slmsk, plyr*100,                &
            2666                          &                  abs(plvl(:,1:NLAY)-plvl(:,2:NLAY+1))*100,       &
            2667                          &                  tlyr, qw, qi, qr, qs, qg, qa, cwp, cip, crp,    &
            2668                          &                  csp, cgp, rew, rei, rer, res, reg, cldtot,      &
            2669                          &                  snowd, cnvw=cnvw, cnvc=cnvc)
            2670                           cldcnv = 0.0
            2671                     #endif
            2672                     
            2673                     !  ---  find top pressure for each cloud domain for given latitude
            2674                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2675                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2676                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2677     1  pp                 do id = 1, 4
            2678     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2679     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2680     2   p   2               do i =1, IX
            2681     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2682     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2683     2               
            2684     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2685     2   p   2               enddo
            2686     1   p                 enddo
            2687                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp, res
                                   <<< Loop-information  End >>>
            2688     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, rei, crp, rer, csp, cwp, res, rew
                                   <<< Loop-information  End >>>
            2689     2   p                   do i = 1, IX
            2690     2   p                     clouds(i,k,1) = cldtot(i,k)
            2691     2   p                     clouds(i,k,2) = cwp(i,k)
            2692     2   p                     clouds(i,k,3) = rew(i,k)
            2693     2   p                     clouds(i,k,4) = cip(i,k)
            2694     2   p                     clouds(i,k,5) = rei(i,k)
            2695     2   p                     clouds(i,k,6) = crp(i,k)
            2696     2   p                     clouds(i,k,7) = rer(i,k)
            2697     2   p                     clouds(i,k,8) = csp(i,k)
            2698     2   p                     clouds(i,k,9) = res(i,k)
            2699     2               !          clouds(i,k,10) = cgp(i,k)
            2700     2               !          clouds(i,k,11) = reg(i,k)
            2701     2   p                   enddo
            2702     1   p                 enddo
            2703                     
            2704                     
            2705                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            2706                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            2707                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            2708                     !       overlapping method is defined by control flag 'iovr', which may
            2709                     !       be different for lw and sw radiation programs.
            2710                     
            2711                           call gethml                                                       &
            2712                     !  ---  inputs:
            2713                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            2714                          &       IX,NLAY,                                                   &
            2715                     !  ---  outputs:
            2716                          &       clds, mtop, mbot                                           &
            2717                          &     )
            2718                     
            2719                     
            2720                     !
            2721                           return
            2722                     !...................................
            2723                           end subroutine progcld6
            2724                     !-----------------------------------
            2725                     
            2726                     !-----------------------------------
            2727                           subroutine progclduni                                             &
            2728                     !  ---  inputs:
            2729                          &     ( plyr,plvl,tlyr,tvly,ccnd,ncnd,                             &
            2730                          &       xlat,xlon,slmsk, IX, NLAY, NLP1, cldcov,                   &
            2731                          &       effrl,effri,effrs,effrr,effr_in,                           &
            2732                     !  ---  outputs:
            2733                          &       clouds,clds,mtop,mbot                                      &
            2734                          &      )
            2735                     
            2736                     ! =================   subprogram documentation block   ================ !
            2737                     !                                                                       !
            2738                     ! subprogram:    progclduni    computes cloud related quantities using    !
            2739                     !   for unified cloud microphysics scheme.                !
            2740                     !                                                                       !
            2741                     ! abstract:  this program computes cloud fractions from cloud           !
            2742                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            2743                     !   and computes the low, mid, high, total and boundary layer cloud     !
            2744                     !   fractions and the vertical indices of low, mid, and high cloud      !
            2745                     !   top and base.  the three vertical cloud domains are set up in the   !
            2746                     !   initial subroutine "cld_init".                                      !
            2747                     !                                                                       !
            2748                     ! usage:         call progclduni                                          !
            2749                     !                                                                       !
            2750                     ! subprograms called:   gethml                                          !
            2751                     !                                                                       !
            2752                     ! attributes:                                                           !
            2753                     !   language:   fortran 90                                              !
            2754                     !   machine:    ibm-sp, sgi                                             !
            2755                     !                                                                       !
            2756                     !                                                                       !
            2757                     !  ====================  definition of variables  ====================  !
            2758                     !                                                                       !
            2759                     ! input variables:                                                      !
            2760                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            2761                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            2762                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            2763                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            2764                     !   ccnd  (IX,NLAY,ncnd) : layer cloud condensate amount                     !
            2765                     !   ncnd            : number of layer cloud condensate types            !
            2766                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            2767                     !                     range, otherwise see in-line comment              !
            2768                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            2769                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            2770                     !   IX              : horizontal dimention                              !
            2771                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            2772                     !   cldcov          : unified cloud fracrion from moist physics         !
            2773                     !   effrl (ix,nlay) : effective radius for liquid water                 !
            2774                     !   effri (ix,nlay) : effective radius for ice water                    !
            2775                     !   effrr (ix,nlay) : effective radius for rain water                   !
            2776                     !   effrs (ix,nlay) : effective radius for snow water                   !
            2777                     !   effr_in         : logical - if .true. use input effective radii     !
            2778                     !                                                                       !
            2779                     ! output variables:                                                     !
            2780                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            2781                     !      clouds(:,:,1) - layer total cloud fraction                       !
            2782                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            2783                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            2784                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            2785                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            2786                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            2787                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            2788                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            2789                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            2790                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            2791                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            2792                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            2793                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            2794                     !                                                                       !
            2795                     ! module variables:                                                     !
            2796                     !   ivflip          : control flag of vertical index direction          !
            2797                     !                     =0: index from toa to surface                     !
            2798                     !                     =1: index from surface to toa                     !
            2799                     !   lmfshal         : mass-flux shallow conv scheme flag                !
            2800                     !   lmfdeep2        : scale-aware mass-flux deep conv scheme flag       !
            2801                     !   lcrick          : control flag for eliminating CRICK                !
            2802                     !                     =t: apply layer smoothing to eliminate CRICK      !
            2803                     !                     =f: do not apply layer smoothing                  !
            2804                     !   lcnorm          : control flag for in-cld condensate                !
            2805                     !                     =t: normalize cloud condensate                    !
            2806                     !                     =f: not normalize cloud condensate                !
            2807                     !                                                                       !
            2808                     !  ====================    end of description    =====================  !
            2809                     !
            2810                           implicit none
            2811                     
            2812                     !  ---  inputs
            2813                           integer,  intent(in) :: IX, NLAY, NLP1, ncnd
            2814                           logical,  intent(in) :: effr_in
            2815                     
            2816                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: ccnd
            2817                           real (kind=kind_phys), dimension(:,:),   intent(in) :: plvl, plyr,&
            2818                          &       tlyr, tvly, cldcov, effrl, effri, effrr, effrs
            2819                     
            2820                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            2821                          &       slmsk
            2822                     
            2823                     !  ---  outputs
            2824                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            2825                     
            2826                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            2827                     
            2828                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            2829                     
            2830                     !  ---  local variables:
            2831                           real (kind=kind_phys), dimension(IX,NLAY) :: cldcnv, cwp, cip,    &
            2832                          &       crp, csp, rew, rei, res, rer, delp, tem2d, cldtot
            2833                           real (kind=kind_phys), dimension(IX,NLAY,ncnd) :: cndf
            2834                     
            2835                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            2836                     
            2837                           real (kind=kind_phys) :: tem1, tem2, tem3
            2838                     
            2839                           integer :: i, k, id, nf, n
            2840                     
            2841                     !
            2842                     !===> ... begin here
            2843                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2844     1  pp                 do nf=1,nf_clds
            2845     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            2846     3   p   4                 do i=1,ix
            2847     3   p   4                   clouds(i,k,nf) = 0.0
            2848     3   p   4                 enddo
            2849     2   p                   enddo
            2850     1   p                 enddo
            2851                     !     clouds(:,:,:) = 0.0
            2852                     
            2853     1                     if (effr_in) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2854     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cldcnv, cwp, cip, crp, csp, rew
                                   <<<      rei, rer, res, tem2d
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2855     3   p                     do i = 1, IX
            2856     3   p                       cldtot(i,k) = cldcov(i,k)
            2857     3   p                       cldcnv(i,k) = 0.0
            2858     3   p                       cwp   (i,k) = 0.0
            2859     3   p                       cip   (i,k) = 0.0
            2860     3   p                       crp   (i,k) = 0.0
            2861     3   p                       csp   (i,k) = 0.0
            2862     3   p                       rew   (i,k) = effrl (i,k)
            2863     3   p                       rei   (i,k) = effri (i,k)
            2864     3   p                       rer   (i,k) = effrr (i,k)
            2865     3   p                       res   (i,k) = effrs (i,k)
            2866     3   p                       tem2d (i,k) = min( 1.0, max( 0.0,(con_ttp-tlyr(i,k))*0.05))
            2867     3   p                     enddo
            2868     2   p                   enddo
            2869     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp, cwp, rew, rei, tem2d, rer, cip
                                   <<<      cldcnv, res
                                   <<< Loop-information  End >>>
            2870     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.45, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp, cwp, rew, rei, rer, res, tem2d
                                   <<<      cip, cldcnv
                                   <<< Loop-information  End >>>
            2871     3   p                     do i = 1, IX
            2872     3   p                       cldcnv(i,k) = 0.0
            2873     3   p                       cwp   (i,k) = 0.0
            2874     3   p                       cip   (i,k) = 0.0
            2875     3   p                       crp   (i,k) = 0.0
            2876     3   p                       csp   (i,k) = 0.0
            2877     3   p                       rew   (i,k) = reliq_def            ! default liq radius to 10 micron
            2878     3   p                       rei   (i,k) = reice_def            ! default ice radius to 50 micron
            2879     3   p                       rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            2880     3   p                       res   (i,k) = rsnow_def            ! default snow radius to 250 micron
            2881     3   p                       tem2d (i,k) = min(1.0, max(0.0, (con_ttp-tlyr(i,k))*0.05))
            2882     3   p                     enddo
            2883     2   p                   enddo
            2884     1                     endif
            2885                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2886     1  pp                 do n=1,ncnd
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            2887     2   p                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            2888     3   p   4                 do i = 1, IX
            2889     3   p   4                   cndf(i,k,n) = ccnd(i,k,n)
            2890     3   p   4                 enddo
            2891     2   p                   enddo
            2892     1   p                 enddo
            2893     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            2894     2  pp                   do n=1,ncnd
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            2895     3   p   2                 do i = 1, IX
            2896     3   p   2                   cndf(i,1,n)    = 0.75*ccnd(i,1,n)    + 0.25*ccnd(i,2,n)
            2897     3   p   2                   cndf(i,nlay,n) = 0.75*ccnd(i,nlay,n) + 0.25*ccnd(i,nlay-1,n)
            2898     3   p   2                 enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            2899     3   p                     do k = 2, NLAY-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf
                                   <<< Loop-information  End >>>
            2900     4   p   2                   do i = 1, IX
            2901     4   p   2                     cndf(i,K,n) = 0.25 * (ccnd(i,k-1,n) + ccnd(i,k+1,n))      &
            2902     4                    &                    + 0.5  *  ccnd(i,k,n)
            2903     4   p   2                   enddo
            2904     3   p                     enddo
            2905     2   p                   enddo
            2906     1                     endif
            2907                     
            2908                     !> -# Find top pressure for each cloud domain for given latitude.
            2909                     !     ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,L,m,h;
            2910                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            2911                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2912     1  pp                 do id = 1, 4
            2913     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            2914     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            2915     2   p   2               do i =1, IX
            2916     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            2917     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            2918     2               
            2919     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            2920     2   p   2               enddo
            2921     1   p                 enddo
            2922                     
            2923                     !> -# Compute cloud liquid/ice condensate path in \f$ g/m^2 \f$ .
            2924                     
            2925     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
            2926     2                       if (ncnd == 2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            2927     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.81, ITR: 12, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            2928     4   p   2                   do i = 1, IX
            2929     4   p   2                     delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2930     4   p   2                     tem1      = gfac * delp(i,k)
            2931     4   p   2                     cwp(i,k)  = cndf(i,k,1) * tem1
            2932     4   p   2                     cip(i,k)  = cndf(i,k,2) * tem1
            2933     4   p   2                   enddo
            2934     3   p                     enddo
            2935     2                       elseif (ncnd == 4 .or. ncnd == 5) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2936     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.11, ITR: 8, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2937     4   p                       do i = 1, IX
            2938     4   p                         delp(i,k) = plvl(i,k+1) - plvl(i,k)
            2939     4   p                         tem1      = gfac * delp(i,k)
            2940     4   p                         cwp(i,k)  = cndf(i,k,1) * tem1
            2941     4   p                         cip(i,k)  = cndf(i,k,2) * tem1
            2942     4   p                         crp(i,k)  = cndf(i,k,3) * tem1
            2943     4   p                         csp(i,k)  = cndf(i,k,4) * tem1
            2944     4   p                       enddo
            2945     3   p                     enddo
            2946     2                       endif
            2947     1                     else                             ! input data from sfc to toa
            2948     2                       if (ncnd == 2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            2949     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.81, ITR: 12, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip
                                   <<< Loop-information  End >>>
            2950     4   p   2                   do i = 1, IX
            2951     4   p   2                     delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2952     4   p   2                     tem1      = gfac * delp(i,k)
            2953     4   p   2                     cwp(i,k)  = cndf(i,k,1) * tem1
            2954     4   p   2                     cip(i,k)  = cndf(i,k,2) * tem1
            2955     4   p   2                   enddo
            2956     3   p                     enddo
            2957     2                       elseif (ncnd == 4 .or. ncnd == 5) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cip, cwp, crp, csp
                                   <<< Loop-information  End >>>
            2958     3  pp                     do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.11, ITR: 8, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cndf, delp, cwp, cip, crp, csp
                                   <<< Loop-information  End >>>
            2959     4   p                       do i = 1, IX
            2960     4   p                         delp(i,k) = plvl(i,k) - plvl(i,k+1)
            2961     4   p                         tem1      = gfac * delp(i,k)
            2962     4   p                         cwp(i,k)  = cndf(i,k,1) * tem1
            2963     4   p                         cip(i,k)  = cndf(i,k,2) * tem1
            2964     4   p                         crp(i,k)  = cndf(i,k,3) * tem1
            2965     4   p                         csp(i,k)  = cndf(i,k,4) * tem1
            2966     4   p                       enddo
            2967     3   p                     enddo
            2968     2                       endif
            2969     1               
            2970     1                     endif                            ! end_if_ivflip
            2971                     
            2972                     !> -# Compute effective liquid cloud droplet radius over land.
            2973                     
            2974     1                     if(.not. effr_in) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            2975     2  pp                   do i = 1, IX
            2976     3   p                     if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
            2977     4   p   4                   do k = 1, NLAY
            2978     4   p   4                     rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
            2979     4   p   4                   enddo
            2980     3   p                     endif
            2981     2   p                   enddo
            2982     1                     endif
            2983                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2984     1  pp   2             do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2985     2   p   2               do i = 1, IX
            2986     3   p   2                 if (cldtot(i,k) < climit) then
            2987     3   p   2                   cwp(i,k)    = 0.0
            2988     3   p   2                   cip(i,k)    = 0.0
            2989     3   p   2                   crp(i,k)    = 0.0
            2990     3   p   2                   csp(i,k)    = 0.0
            2991     3   p   2                 endif
            2992     2   p   2               enddo
            2993     1   p   2             enddo
            2994                     
            2995     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            2996     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2997     3   p                     do i = 1, IX
            2998     4   p                       if (cldtot(i,k) >= climit) then
            2999     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            3000     4   p                         cwp(i,k) = cwp(i,k) * tem1
            3001     4   p                         cip(i,k) = cip(i,k) * tem1
            3002     4   p                         crp(i,k) = crp(i,k) * tem1
            3003     4   p                         csp(i,k) = csp(i,k) * tem1
            3004     4   p                       endif
            3005     3   p                     enddo
            3006     2   p                   enddo
            3007     1                     endif
            3008                     
            3009                     !> -# Compute effective ice cloud droplet radius following Heymsfield
            3010                     !!    and McFarquhar (1996) \cite heymsfield_and_mcfarquhar_1996.
            3011                     
            3012     1                     if(.not. effr_in) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3013     2  pp                   do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip
                                   <<< Loop-information  End >>>
            3014     3   p                     do i = 1, IX
            3015     3   p                       tem2 = tlyr(i,k) - con_ttp
            3016     3               
            3017     4   p                       if (cip(i,k) > 0.0) then
            3018     4   p                         tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            3019     4               
            3020     5   p                         if (tem2 < -50.0) then
            3021     5   p                           rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            3022     5   p                         elseif (tem2 < -40.0) then
            3023     5   p                           rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            3024     5   p                         elseif (tem2 < -30.0) then
            3025     5   p                           rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            3026     5   p                         else
            3027     5   p                           rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            3028     5   p                         endif
            3029     4               !             rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            3030     4               !             rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            3031     4   p                         rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            3032     4               !             rei(i,k)   = max(5.0,  min(rei(i,k), 130.0))
            3033     4   p                       endif
            3034     3   p                     enddo
            3035     2   p                   enddo
            3036     1                     endif
            3037                     
            3038                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cwp, rew, cip, rei, crp, rer
                                   <<<      csp, res
                                   <<< Loop-information  End >>>
            3039     1  pp                 do k = 1, NLAY
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.76, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, rew, cip, rei, crp, rer, csp
                                   <<<      cldtot, res
                                   <<< Loop-information  End >>>
            3040     2   p                   do i = 1, IX
            3041     2   p                     clouds(i,k,1) = cldtot(i,k)
            3042     2   p                     clouds(i,k,2) = cwp(i,k)
            3043     2   p                     clouds(i,k,3) = rew(i,k)
            3044     2   p                     clouds(i,k,4) = cip(i,k)
            3045     2   p                     clouds(i,k,5) = rei(i,k)
            3046     2   p                     clouds(i,k,6) = crp(i,k)
            3047     2   p                     clouds(i,k,7) = rer(i,k)
            3048     2   p                     clouds(i,k,8) = csp(i,k)
            3049     2   p                     clouds(i,k,9) = res(i,k)
            3050     2   p                   enddo
            3051     1   p                 enddo
            3052                     
            3053                     
            3054                     !> -# Call gethml() to compute low,mid,high,total, and boundary layer
            3055                     !!    cloud fractions and clouds top/bottom layer indices for low, mid,
            3056                     !!    and high clouds.
            3057                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            3058                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            3059                     !       The three cloud domain boundaries are defined by ptopc.  The cloud
            3060                     !       overlapping method is defined by control flag 'iovr', which may
            3061                     !       be different for lw and sw radiation programs.
            3062                     
            3063                           call gethml                                                       &
            3064                     !  ---  inputs:
            3065                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            3066                          &       IX,NLAY,                                                   &
            3067                     !  ---  outputs:
            3068                          &       clds, mtop, mbot                                           &
            3069                          &     )
            3070                     
            3071                     
            3072                     !
            3073                           return
            3074                     !...................................
            3075                           end subroutine progclduni
            3076                     !-----------------------------------
            3077                     
            3078                     
            3079                     !-----------------------------------
            3080                           subroutine diagcld1                                               &
            3081                     !...................................
            3082                     
            3083                     !  ---  inputs:
            3084                          &     ( plyr,plvl,tlyr,rhly,vvel,cv,cvt,cvb,                       &
            3085                          &       xlat,xlon,slmsk,                                           &
            3086                          &       ix, nlay, nlp1,                                            &
            3087                     !  ---  outputs:
            3088                          &       clouds,clds,mtop,mbot                                      &
            3089                          &      )
            3090                     
            3091                     ! =================   subprogram documentation block   ================ !
            3092                     !                                                                       !
            3093                     ! subprogram:    diagcld1    computes cloud fractions for radiation     !
            3094                     !   calculations.                                                       !
            3095                     !                                                                       !
            3096                     ! abstract:  clouds are diagnosed from layer relative humidity, and     !
            3097                     !   estimate cloud optical depth from temperature and layer thickness.  !
            3098                     !   then computes the low, mid, high, total and boundary layer cloud    !
            3099                     !   fractions and the vertical indices of low, mid, and high cloud top  !
            3100                     !   and base.  the three vertical cloud domains are set up in the       !
            3101                     !   initial subroutine "cld_init".                                      !
            3102                     !                                                                       !
            3103                     ! usage:         call diagcld1                                          !
            3104                     !                                                                       !
            3105                     ! subprograms called:   gethml                                          !
            3106                     !                                                                       !
            3107                     ! attributes:                                                           !
            3108                     !   language:   fortran 90                                              !
            3109                     !   machine:    ibm-sp, sgi                                             !
            3110                     !                                                                       !
            3111                     !                                                                       !
            3112                     !  ====================  defination of variables  ====================  !
            3113                     !                                                                       !
            3114                     ! input variables:                                                      !
            3115                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
            3116                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
            3117                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
            3118                     !   rhly  (ix,nlay) : layer relative humidity                           !
            3119                     !   vvel  (ix,nlay) : layer mean vertical velocity in mb/sec            !
            3120                     !   clw   (ix,nlay) : layer cloud condensate amount         (not used)  !
            3121                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
            3122                     !                     range, otherwise see in-line comment              !
            3123                     !   xlon  (ix)      : grid longitude in radians, ok for both 0->2pi or  !
            3124                     !                     -pi -> +pi ranges                                 !
            3125                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            3126                     !   cv    (ix)      : fraction of convective cloud                      !
            3127                     !   cvt, cvb (ix)   : conv cloud top/bottom pressure in mb              !
            3128                     !   ix              : horizontal dimention                              !
            3129                     !   nlay,nlp1       : vertical layer/level dimensions                   !
            3130                     !                                                                       !
            3131                     ! output variables:                                                     !
            3132                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
            3133                     !      clouds(:,:,1) - layer total cloud fraction                       !
            3134                     !      clouds(:,:,2) - layer cloud optical depth                        !
            3135                     !      clouds(:,:,3) - layer cloud single scattering albedo             !
            3136                     !      clouds(:,:,4) - layer cloud asymmetry factor                     !
            3137                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            3138                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
            3139                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
            3140                     !                                                                       !
            3141                     ! external module variables:                                            !
            3142                     !   ivflip          : control flag of vertical index direction          !
            3143                     !                     =0: index from toa to surface                     !
            3144                     !                     =1: index from surface to toa                     !
            3145                     !                                                                       !
            3146                     !  ====================    end of description    =====================  !
            3147                     !
            3148                           implicit none
            3149                     
            3150                     !  ---  inputs
            3151                           integer,  intent(in) :: ix, nlay, nlp1
            3152                     
            3153                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            3154                          &       tlyr, rhly, vvel
            3155                     
            3156                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            3157                          &       slmsk, cv, cvt, cvb
            3158                     
            3159                     !  ---  outputs
            3160                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            3161                     
            3162                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            3163                     
            3164                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            3165                     
            3166                     !  ---  local variables:
            3167                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
            3168                          &       cldtau, taufac, dthdp, tem2d
            3169                     

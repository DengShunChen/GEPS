                                   <<< Loop-information  End >>>
            3575     3  pp                     do i = 1, ix
            3576     3   p                       id = idom(i)
            3577     3   p                       nhalf = (nbin + 1) / 2
            3578     3               
            3579     4   p                       if (id <= 0 .or. k > kcut(i)) then
            3580     4   p                         cldtot(i,k) = 0.0
            3581     4   p                       elseif (rhly(i,k) <= rhcld(i,1,id)) then
            3582     4   p                         cldtot(i,k) = 0.0
            3583     4   p                       elseif (rhly(i,k) >= rhcld(i,nbin,id)) then
            3584     4   p                         cldtot(i,k) = 1.0
            3585     4   p                       else
            3586     4   p                         ib = nhalf
            3587     4   p                         crk = rhly(i,k)
            3588     4               
            3589     4   p                         notstop = .true.
            3590     5   p                         do while ( notstop )
            3591     5   p                           nhalf = (nhalf + 1) / 2
            3592     5   p                           cr1 = rhcld(i,ib,  id)
            3593     5   p                           cr2 = rhcld(i,ib+1,id)
            3594     5               
            3595     6   p                           if (crk <= cr1) then
            3596     6   p                             ib = max( ib-nhalf, 1 )
            3597     6   p                           elseif (crk > cr2) then
            3598     6   p                             ib = min( ib+nhalf, nbin-1 )
            3599     6   p                           else

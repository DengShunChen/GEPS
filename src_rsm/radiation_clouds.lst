            3680                     !-----------------------------------                                    !
            3681                           subroutine gethml                                                 &
            3682                     !...................................                                    !
            3683                     
            3684                     !  ---  inputs:
            3685                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            3686                          &       ix, nlay,                                                  &
            3687                     !  ---  outputs:
            3688                          &       clds, mtop, mbot                                           &
            3689                          &     )
            3690                     
            3691                     !  ===================================================================  !
            3692                     !                                                                       !
            3693                     ! abstract: compute high, mid, low, total, and boundary cloud fractions !
            3694                     !   and cloud top/bottom layer indices for model diagnostic output.     !
            3695                     !   the three cloud domain boundaries are defined by ptopc.  the cloud  !
            3696                     !   overlapping method is defined by control flag 'iovr', which is also !
            3697                     !   used by lw and sw radiation programs.                               !
            3698                     !                                                                       !
            3699                     ! usage:         call gethml                                            !
            3700                     !                                                                       !
            3701                     ! subprograms called:  none                                             !
            3702                     !                                                                       !
            3703                     ! attributes:                                                           !
            3704                     !   language:   fortran 90                                              !
            3705                     !   machine:    ibm-sp, sgi                                             !
            3706                     !                                                                       !
            3707                     !                                                                       !
            3708                     !  ====================  defination of variables  ====================  !
            3709                     !                                                                       !
            3710                     ! input variables:                                                      !
            3711                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
            3712                     !   ptop1 (ix,4)    : pressure limits of cloud domain interfaces        !
            3713                     !                     (sfc,low,mid,high) in mb (100pa)                  !
            3714                     !   cldtot(ix,nlay) : total or straiform cloud profile in fraction      !
            3715                     !   cldcnv(ix,nlay) : convective cloud (for diagnostic scheme only)     !
            3716                     !   ix              : horizontal dimention                              !
            3717                     !   nlay            : vertical layer dimensions                         !
            3718                     !                                                                       !
            3719                     ! output variables:                                                     !
            3720                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            3721                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
            3722                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
            3723                     !                                                                       !
            3724                     ! external module variables:  (in physpara)                             !
            3725                     !   ivflip          : control flag of vertical index direction          !
            3726                     !                     =0: index from toa to surface                     !
            3727                     !                     =1: index from surface to toa                     !
            3728                     !                                                                       !
            3729                     ! internal module variables:                                            !
            3730                     !   iovr            : control flag for cloud overlap                    !
            3731                     !                     =0 random overlapping clouds                      !
            3732                     !                     =1 max/ran overlapping clouds                     !
            3733                     !                                                                       !
            3734                     !                                                                       !
            3735                     !  ====================    end of description    =====================  !
            3736                     !
            3737                           implicit none!
            3738                     
            3739                     !  ---  inputs:
            3740                           integer, intent(in) :: ix, nlay
            3741                     
            3742                           real (kind=kind_phys), dimension(:,:), intent(in) :: plyr, ptop1, &
            3743                          &       cldtot, cldcnv
            3744                     
            3745                     !  ---  outputs
            3746                           real (kind=kind_phys), dimension(:,:), intent(out) :: clds
            3747                     
            3748                           integer,               dimension(:,:), intent(out) :: mtop, mbot
            3749                     
            3750                     !  ---  local variables:
            3751                           real (kind=kind_phys) :: cl1(ix), cl2(ix)
            3752                           real (kind=kind_phys) :: pcur, pnxt, ccur, cnxt
            3753                     
            3754                           integer, dimension(ix):: idom, kbt1, kth1, kbt2, kth2
            3755                           integer :: i, k, id, id1, kstr, kend, kinc
            3756                     
            3757                     !
            3758                     !===> ... begin here
            3759                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
            3760        pp   4             clds(:,:) = 0.0
            3761                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            3762     1  pp   4             do i = 1, ix
            3763     1   p   4               cl1(i) = 1.0
            3764     1   p   4               cl2(i) = 1.0
            3765     1   p   4             enddo
            3766                     
            3767                     !  ---  total and bl clouds, where cl1, cl2 are fractions of clear-sky view
            3768                     !       layer processed from surface and up
            3769                     
            3770     1                     if ( ivflip == 0 ) then                   ! input data from toa to sfc
            3771     1                       kstr = nlay
            3772     1                       kend = 1
            3773     1                       kinc = -1
            3774     1                     else                                      ! input data from sfc to toa
            3775     1                       kstr = 1
            3776     1                       kend = nlay
            3777     1                       kinc = 1
            3778     1                     endif                                     ! end_if_ivflip
            3779                     
            3780     1                     if ( iovr == 0 ) then                     ! random overlap
            3781     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl1
                                   <<< Loop-information  End >>>
            3782     2                       do k = kstr, kend, kinc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 411
                                   <<< Loop-information  End >>>
            3783     3  pp   2                 do i = 1, ix
            3784     3   p   2                   ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            3785     3   p   2                   if (ccur >= climit) cl1(i) = cl1(i) * (1.0 - ccur)
            3786     3   p   2                 enddo
            3787     2               
            3788     3                         if (k == llyr) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl1
                                   <<< Loop-information  End >>>
            3789     4  pp   4                   do i = 1, ix
            3790     4   p   4                     clds(i,5) = 1.0 - cl1(i)          ! save bl cloud
            3791     4   p   4                   enddo
            3792     3                         endif
            3793     2                       enddo
            3794     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl1
                                   <<< Loop-information  End >>>
            3795     2  pp   4               do i = 1, ix
            3796     2   p   4                 clds(i,4) = 1.0 - cl1(i)              ! save total cloud
            3797     2   p   4               enddo
            3798     1               
            3799     1                     else                                      ! max/ran overlap
            3800     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            3801     2                       do k = kstr, kend, kinc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 267
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2
                                   <<< Loop-information  End >>>
            3802     3  pp                     do i = 1, ix
            3803     3   p                       ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            3804     4   p                       if (ccur >= climit) then             ! cloudy layer
            3805     4   p                         cl2(i) = min( cl2(i), (1.0 - ccur) )
            3806     4   p                       else                                ! clear layer
            3807     4   p                         cl1(i) = cl1(i) * cl2(i)
            3808     4   p                         cl2(i) = 1.0
            3809     4   p                       endif
            3810     3   p                     enddo
            3811     2               
            3812     3                         if (k == llyr) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 14, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            3813     4  pp   2                   do i = 1, ix
            3814     4   p   2                     clds(i,5) = 1.0 - cl1(i) * cl2(i) ! save bl cloud
            3815     4   p   2                   enddo
            3816     3                         endif
            3817     2                       enddo
            3818     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 14, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cl2, cl1
                                   <<< Loop-information  End >>>
            3819     2  pp   2               do i = 1, ix
            3820     2   p   2                 clds(i,4) = 1.0 - cl1(i) * cl2(i)     ! save total cloud
            3821     2   p   2               enddo
            3822     1               
            3823     1                     endif                                     ! end_if_iovr
            3824                     
            3825                     !  ---  high, mid, low clouds, where cl1, cl2 are cloud fractions
            3826                     !       layer processed from one layer below llyr and up
            3827                     !  ---  change! layer processed from surface to top, so low clouds will
            3828                     !       contains both bl and low clouds.
            3829                     
            3830     1                     if ( ivflip == 0 ) then                   ! input data from toa to sfc
            3831     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom, kth2, kth1, cl1, kbt2, cl2, kbt1
                                   <<< Loop-information  End >>>
            3832     2  pp                   do i = 1, ix
            3833     2   p                     cl1 (i) = 0.0
            3834     2   p                     cl2 (i) = 0.0
            3835     2   p                     kbt1(i) = nlay
            3836     2   p                     kbt2(i) = nlay
            3837     2   p                     kth1(i) = 0
            3838     2   p                     kth2(i) = 0
            3839     2   p                     idom(i) = 1
            3840     2   p                     mbot(i,1) = nlay
            3841     2   p                     mtop(i,1) = nlay
            3842     2   p                     mbot(i,2) = nlay - 1
            3843     2   p                     mtop(i,2) = nlay - 1
            3844     2   p                     mbot(i,3) = nlay - 1
            3845     2   p                     mtop(i,3) = nlay - 1
            3846     2   p                   enddo
            3847     1               
            3848     1               !org    do k = llyr-1, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            3849     2                       do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 50
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 26
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3850     3  pp                     do i = 1, ix
            3851     3   p                       id = idom(i)
            3852     3   p                       id1= id + 1
            3853     3               
            3854     3   p                       pcur = plyr(i,k)
            3855     3   p                       ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            3856     3               
            3857     4   p                       if (k > 1) then
            3858     4   p                         pnxt = plyr(i,k-1)
            3859     4   p                         cnxt = min( ovcst, max( cldtot(i,k-1), cldcnv(i,k-1) ))
            3860     4   p                       else
            3861     4   p                         pnxt = -1.0
            3862     4   p                         cnxt = 0.0
            3863     4   p                       endif
            3864     3               
            3865     4   p                       if (pcur < ptop1(i,id1)) then
            3866     4   p                         id = id + 1
            3867     4   p                         id1= id1 + 1
            3868     4   p                         idom(i) = id
            3869     4   p                       endif
            3870     3               
            3871     4   p                       if (ccur >= climit) then
            3872     4   p                         if (kth2(i) == 0) kbt2(i) = k
            3873     4   p                         kth2(i) = kth2(i) + 1
            3874     4               
            3875     5   p                         if ( iovr == 0 ) then
            3876     5   p                           cl2(i) = cl2(i) + ccur - cl2(i)*ccur
            3877     5   p                         else
            3878     5   p                           cl2(i) = max( cl2(i), ccur )
            3879     5   p                         endif
            3880     4               
            3881     5   p                         if (cnxt < climit .or. pnxt < ptop1(i,id1)) then
            3882     5   p                           kbt1(i) = nint( (cl1(i)*kbt1(i) + cl2(i)*kbt2(i) )      &
            3883     5                    &                  / (cl1(i) + cl2(i)) )
            3884     5   p                           kth1(i) = nint( (cl1(i)*kth1(i) + cl2(i)*kth2(i) )      &
            3885     5                    &                  / (cl1(i) + cl2(i)) )
            3886     5   p                           cl1 (i) = cl1(i) + cl2(i) - cl1(i)*cl2(i)
            3887     5               
            3888     5   p                           kbt2(i) = k - 1
            3889     5   p                           kth2(i) = 0
            3890     5   p                           cl2 (i) = 0.0
            3891     5   p                         endif   ! end_if_cnxt_or_pnxt
            3892     4   p                       endif     ! end_if_ccur
            3893     3               
            3894     4   p                       if (pnxt < ptop1(i,id1)) then
            3895     4   p                         clds(i,id) = cl1(i)
            3896     4   p                         mtop(i,id) = min( kbt1(i), kbt1(i)-kth1(i)+1 )
            3897     4   p                         mbot(i,id) = kbt1(i)
            3898     4               
            3899     4   p                         cl1 (i) = 0.0
            3900     4   p                         kbt1(i) = k - 1
            3901     4   p                         kth1(i) = 0
            3902     4               
            3903     5   p                         if (id1 <= nk_clds) then
            3904     5   p                           mbot(i,id1) = kbt1(i)
            3905     5   p                           mtop(i,id1) = kbt1(i)
            3906     5   p                         endif
            3907     4   p                       endif     ! end_if_pnxt
            3908     3               
            3909     3   p                     enddo       ! end_do_i_loop
            3910     2                       enddo         ! end_do_k_loop
            3911     1               
            3912     1                     else                                      ! input data from sfc to toa
            3913     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom, kth2, kth1, kbt2, kbt1, cl2, cl1
                                   <<< Loop-information  End >>>
            3914     2  pp                   do i = 1, ix
            3915     2   p                     cl1 (i) = 0.0
            3916     2   p                     cl2 (i) = 0.0
            3917     2   p                     kbt1(i) = 1
            3918     2   p                     kbt2(i) = 1
            3919     2   p                     kth1(i) = 0
            3920     2   p                     kth2(i) = 0
            3921     2   p                     idom(i) = 1
            3922     2   p                     mbot(i,1) = 1
            3923     2   p                     mtop(i,1) = 1
            3924     2   p                     mbot(i,2) = 2
            3925     2   p                     mtop(i,2) = 2
            3926     2   p                     mbot(i,3) = 2
            3927     2   p                     mtop(i,3) = 2
            3928     2   p                   enddo
            3929     1               
            3930     1               !org    do k = llyr+1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            3931     2                       do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 50
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      idom
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 4  FILL 26
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3932     3  pp                     do i = 1, ix
            3933     3   p                       id = idom(i)
            3934     3   p                       id1= id + 1
            3935     3               
            3936     3   p                       pcur = plyr(i,k)
            3937     3   p                       ccur = min( ovcst, max( cldtot(i,k), cldcnv(i,k) ))
            3938     3               
            3939     4   p                       if (k < nlay) then
            3940     4   p                         pnxt = plyr(i,k+1)
            3941     4   p                         cnxt = min( ovcst, max( cldtot(i,k+1), cldcnv(i,k+1) ))
            3942     4   p                       else
            3943     4   p                         pnxt = -1.0
            3944     4   p                         cnxt = 0.0
            3945     4   p                       endif
            3946     3               
            3947     4   p                       if (pcur < ptop1(i,id1)) then
            3948     4   p                         id = id + 1
            3949     4   p                         id1= id1 + 1
            3950     4   p                         idom(i) = id
            3951     4   p                       endif
            3952     3               
            3953     4   p                       if (ccur >= climit) then
            3954     4   p                         if (kth2(i) == 0) kbt2(i) = k
            3955     4   p                         kth2(i) = kth2(i) + 1
            3956     4               
            3957     5   p                         if ( iovr == 0 ) then
            3958     5   p                           cl2(i) = cl2(i) + ccur - cl2(i)*ccur
            3959     5   p                         else
            3960     5   p                           cl2(i) = max( cl2(i), ccur )
            3961     5   p                         endif
            3962     4               
            3963     5   p                         if (cnxt < climit .or. pnxt < ptop1(i,id1)) then
            3964     5   p                           kbt1(i) = nint( (cl1(i)*kbt1(i) + cl2(i)*kbt2(i))       &
            3965     5                    &                  / (cl1(i) + cl2(i)) )
            3966     5   p                           kth1(i) = nint( (cl1(i)*kth1(i) + cl2(i)*kth2(i))       &
            3967     5                    &                  / (cl1(i) + cl2(i)) )
            3968     5   p                           cl1 (i) = cl1(i) + cl2(i) - cl1(i)*cl2(i)
            3969     5               
            3970     5   p                           kbt2(i) = k + 1
            3971     5   p                           kth2(i) = 0
            3972     5   p                           cl2 (i) = 0.0
            3973     5   p                         endif     ! end_if_cnxt_or_pnxt
            3974     4   p                       endif       ! end_if_ccur
            3975     3               
            3976     4   p                       if (pnxt < ptop1(i,id1)) then
            3977     4   p                         clds(i,id) = cl1(i)
            3978     4   p                         mtop(i,id) = max( kbt1(i), kbt1(i)+kth1(i)-1 )
            3979     4   p                         mbot(i,id) = kbt1(i)
            3980     4               
            3981     4   p                         cl1 (i) = 0.0
            3982     4   p                         kbt1(i) = k + 1
            3983     4   p                         kth1(i) = 0
            3984     4               
            3985     5   p                         if (id1 <= nk_clds) then
            3986     5   p                           mbot(i,id1) = kbt1(i)
            3987     5   p                           mtop(i,id1) = kbt1(i)
            3988     5   p                         endif
            3989     4   p                       endif     ! end_if_pnxt
            3990     3               
            3991     3   p                     enddo       ! end_do_i_loop
            3992     2                       enddo         ! end_do_k_loop
            3993     1               
            3994     1                     endif                                     ! end_if_ivflip
            3995                     
            3996                     !
            3997                           return
            3998                     !...................................
            3999                           end subroutine gethml
            4000                     !-----------------------------------
            4001                     
            4002                     
            4003                     !-----------------------------------                                    !
            4004                           subroutine rhtable                                                &
            4005                     !...................................                                    !
            4006                     
            4007                     !  ---  inputs:
            4008                          &     ( me                                                         &
            4009                     !  ---  outputs:
            4010                          &,      ier )
            4011                     
            4012                     !  ===================================================================  !
            4013                     !                                                                       !
            4014                     ! abstract: cld-rh relations obtained from mitchell-hahn procedure,     !
            4015                     !   here read cld/rh tuning tables for day 0,1,...,5 and merge into 1   !
            4016                     !   file.                                                               !
            4017                     !                                                                       !
            4018                     ! inputs:                                                               !
            4019                     !   me              : check print control flag                          !
            4020                     !                                                                       !
            4021                     ! outputs:                                                              !
            4022                     !   ier             : error flag                                        !
            4023                     !                                                                       !
            4024                     !  ===================================================================  !
            4025                     !
            4026                           implicit none!
            4027                     
            4028                     !  ---  inputs:
            4029                           integer, intent(in) :: me
            4030                     
            4031                     !  ---  output:
            4032                           integer, intent(out) :: ier
            4033                     
            4034                     !  ---  locals:
            4035                           real (kind=kind_phys), dimension(nbin,nlon,nlat,mcld,nseal) ::    &
            4036                          &      rhfd, rtnfd, rhcf, rtncf, rhcla
            4037                     
            4038                           real (kind=kind_io4), dimension(nbin,nlon,nlat,mcld,nseal) ::     &
            4039                          &      rhfd4, rtnfd4
            4040                     
            4041                           real(kind=kind_io4)  :: fhour
            4042                     
            4043                           real(kind=kind_phys) :: binscl, cfrac, clsat, rhsat, cstem
            4044                     
            4045                           integer, dimension(nlon,nlat,mcld,nseal) :: kpts, kkpts
            4046                     
            4047                           integer :: icdays(15), idate(4), nbdayi, isat
            4048                     
            4049                           integer :: i, i1, j, k, l, m, id, im, iy
            4050                     
            4051                     !
            4052                     !===> ...  begin here
            4053                     !
            4054                     
            4055                           ier = 1
            4056                     
            4057                           rewind nicltun
            4058                     
            4059                           binscl = 1.0 / nbin
            4060                     
            4061                     !  ---  array initializations
            4062                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhcla, rtncf, rhcf
                                   <<< Loop-information  End >>>
            4063     1  pp   2             do m=1,nseal
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4064     2   p   2              do l=1,mcld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4065     3   p   2               do k=1,nlat
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4066     4   p   2                do j=1,nlon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4067     5   p   2                 do i=1,nbin
            4068     5   p   2                   rhcf (i,j,k,l,m) = 0.0
            4069     5   p   2                   rtncf(i,j,k,l,m) = 0.0
            4070     5   p   2                   rhcla(i,j,k,l,m) = -0.1
            4071     5   p   2                 enddo
            4072     4   p   2                enddo
            4073     3   p   2               enddo
            4074     2   p   2              enddo
            4075     1   p   2             enddo
            4076                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 116
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4077         s   f             kkpts = 0
            4078                     
            4079                     !  ---  read the data off the rotating file
            4080                     
            4081                           read (nicltun,err=998,end=999) nbdayi, icdays
            4082                     
            4083                           if (me == 0) print 11, nbdayi
            4084                       11  format('   from rhtable days on file =',i5)
            4085                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      icdays
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4086     1   s                 do i = 1, nbdayi
            4087     1   p                  id = icdays(i) / 10000
            4088     1   p                  im = (icdays(i)-id*10000) / 100
            4089     1   p                  iy = icdays(i)-id*10000-im*100
            4090     1   m                  if (me == 0) print 51, id,im,iy
            4091     1                 51   format('   from rhtable archv data from da,mo,yr=',3i4)
            4092     1   p                 enddo
            4093                     
            4094                           read (nicltun,err=998,end=999) fhour,idate
            4095                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 62  FILL 62
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4096     1                     do i1 = 1, nbdayi
            4097     1                       read (nicltun) rhfd4
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 20, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhfd4, rhfd
                                   <<< Loop-information  End >>>
            4098     1  pp   2               rhfd = rhfd4
            4099     1               
            4100     1                       read (nicltun) rtnfd4
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 20, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rtnfd4, rtnfd
                                   <<< Loop-information  End >>>
            4101     1  pp   2               rtnfd = rtnfd4
            4102     1               
            4103     1                       read (nicltun) kpts
            4104     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 14, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhcf, rtncf, rtnfd, rhfd
                                   <<< Loop-information  End >>>
            4105     2  pp   2               do m=1,nseal
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4106     3   p   2                do l=1,mcld
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4107     4   p   2                 do k=1,nlat
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4108     5   p   2                  do j=1,nlon
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            4109     6   p   2                   do i=1,nbin
            4110     6   p   2                     rhcf (i,j,k,l,m) = rhcf (i,j,k,l,m) + rhfd (i,j,k,l,m)
            4111     6   p   2                     rtncf(i,j,k,l,m) = rtncf(i,j,k,l,m) + rtnfd(i,j,k,l,m)
            4112     6   p   2                   enddo
            4113     5   p   2                  enddo
            4114     4   p   2                 enddo
            4115     3   p   2                enddo
            4116     2   p   2               enddo
            4117     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4118     1   s  64               kkpts = kkpts + kpts
            4119     1               
            4120     1                     enddo     ! end_do_i1_loop
            4121                     
            4122     1                     do m = 1, nseal
            4123     2                      do l = 1, mcld
            4124     3                       do k = 1, nlat
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4125     4                        do j = 1, nlon
            4126     4               
            4127     4               !  ---  compute the cumulative frequency distribution
            4128     4               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4129     5   s   2                  do i = 2, nbin
            4130     5   s   2                    rhcf (i,j,k,l,m) = rhcf (i-1,j,k,l,m) + rhcf (i,j,k,l,m)
            4131     5   s   2                    rtncf(i,j,k,l,m) = rtncf(i-1,j,k,l,m) + rtncf(i,j,k,l,m)
            4132     5   s   2                  enddo   ! end_do_i_loop
            4133     4               
            4134     5                          if (kkpts(j,k,l,m) > 0) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 18, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
            4135     6   s   2                    do i = 1, nbin
            4136     6   p   2                      rhcf (i,j,k,l,m)= rhcf (i,j,k,l,m)/kkpts(j,k,l,m)
            4137     6   p   2                      rtncf(i,j,k,l,m)=min(1., rtncf(i,j,k,l,m)/kkpts(j,k,l,m))
            4138     6   p   2                    enddo
            4139     5               
            4140     5               !  ---  cause we mix calculations of rh retune with cray and ibm words
            4141     5               !       the last value of rhcf is close to but ne 1.0,
            4142     5               !  ---  so we reset it in order that the 360 loop gives complete tabl
            4143     5               
            4144     5                            rhcf(nbin,j,k,l,m) = 1.0

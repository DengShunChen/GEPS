             137                     !========================================!
             138                           module module_radiation_clouds     !
             139                     !........................................!
             140                     !
             141                           use physpara,            only : icldflg, icmphys, iovrsw, iovrlw, &
             142                          &                                lcrick, lcnorm, lnoprec,          &
             143                          &                                ivflip, kind_phys, kind_io4
             144                           use physcons,            only : con_fvirt, con_ttp, con_rocp,     &
             145                          &                                con_t0c, con_pi, con_g, con_rd,   &
             146                          &                                con_thgni
             147                           use module_microphysics, only : rsipath2
             148                           use module_iounitdef,    only : nicltun
             149                     !
             150                           implicit   none
             151                     !
             152                           private
             153                     
             154                     !  ---  version tag and last revision date
             155                           character(40), parameter ::                                       &
             156                          &   vtagcld='ncep-radiation_clouds    v5.1  nov 2012 '
             157                     !    &   vtagcld='ncep-radiation_clouds    v5.0  aug 2012 '
             158                     
             159                     !  ---  set constant parameters
             160                           real (kind=kind_phys), parameter :: gfac=1.0e5/con_g              &
             161                          &,                                   gord=con_g/con_rd
             162                     !#if defined (GFDLMP_v2)
             163                     !      integer, parameter, public :: nf_clds = 11  ! number of fields in cloud array
             164                     !#else
             165                           integer, parameter, public :: nf_clds = 9   ! number of fields in cloud array
             166                     !#endif
             167                           integer, parameter, public :: nk_clds = 3   ! number of cloud vertical domains
             168                     
             169                     !  ---  pressure limits of cloud domain interfaces (low,mid,high) in mb (0.1kpa)
             170                           real (kind=kind_phys), save :: ptopc(nk_clds+1,2)
             171                     
             172                     !org  data ptopc / 1050., 642., 350., 0.0,  1050., 750., 500., 0.0 /
             173                           data ptopc / 1050., 650., 400., 0.0,  1050., 750., 500., 0.0 /
             174                     
             175                     !     real (kind=kind_phys), parameter :: climit = 0.01
             176                           real (kind=kind_phys), parameter :: climit = 0.001, climit2=0.05
             177                           real (kind=kind_phys), parameter :: ovcst  = 1.0 - 1.0e-8
             178                     
             179                     !  ---  set default quantities as parameters (for prognostic cloud)
             180                           real (kind=kind_phys), parameter :: reliq_def = 10.0    ! default liq radius to 10 micron
             181                           real (kind=kind_phys), parameter :: reice_def = 50.0    ! default ice radius to 50 micron
             182                           real (kind=kind_phys), parameter :: rrain_def = 1000.0  ! default rain radius to 1000 micron
             183                           real (kind=kind_phys), parameter :: rsnow_def = 250.0   ! default snow radius to 250 micron
             184                     
             185                     !  ---  set look-up table dimensions and other parameters (for diagnostic cloud)
             186                           integer, parameter :: nbin=100     ! rh in one percent interval
             187                           integer, parameter :: nlon=2       ! =1,2 for eastern and western hemispheres
             188                           integer, parameter :: nlat=4       ! =1,4 for 60n-30n,30n-equ,equ-30s,30s-60s
             189                           integer, parameter :: mcld=4       ! =1,4 for bl,low,mid,hi cld type
             190                           integer, parameter :: nseal=2      ! =1,2 for land,sea
             191                     
             192                           real (kind=kind_phys), parameter :: cldssa_def = 0.99   ! default cld single scat albedo
             193                           real (kind=kind_phys), parameter :: cldasy_def = 0.84   ! default cld asymmetry factor
             194                     
             195                     !  ---  xlabdy: lat bndry between tuning regions, +/- xlim for transition
             196                     !       xlobdy: lon bndry between tuning regions
             197                           real (kind=kind_phys), parameter :: xlim=5.0
             198                           real (kind=kind_phys)            :: xlabdy(3), xlobdy(3)
             199                     
             200                           data xlabdy / 30.0,  0.0, -30.0 /,  xlobdy / 0.0, 180., 360. /
             201                     
             202                     !  ---  low cloud vertical velocity adjustment boundaries in mb/sec
             203                           real (kind=kind_phys), parameter :: vvcld1= 0.0003e0
             204                           real (kind=kind_phys), parameter :: vvcld2=-0.0005e0
             205                     
             206                     !  ---  those data will be set up by "cld_init"
             207                     !     rhcl : tuned rh relation table for diagnostic cloud scheme
             208                     
             209                           real (kind=kind_phys) :: rhcl(nbin,nlon,nlat,mcld,nseal)
             210                     
             211                           integer  :: llyr   = 2           ! upper limit of boundary layer clouds
             212                           integer  :: iovr   = 1           ! cloud over lapping method for diagnostic 3-domain
             213                                                            ! output calc (see iovrsw/iovrlw description)
             214                     
             215                           public progcld1, progcld2, progcld3, progcld4, diagcld1, cld_init,&
             216                                  progcld5, progcld5o, progclduni, progcld6
             217                     
             218                     
             219                     ! =================
             220                           contains
             221                     ! =================
             222                     
             223                     
             224                     !-----------------------------------
             225                           subroutine cld_init                                               &
             226                     !...................................
             227                     
             228                     !  ---  inputs:
             229                          &     ( si, nlay, me, myrank )
             230                     !  ---  outputs:
             231                     !          ( none )
             232                     
             233                     !  ===================================================================  !
             234                     !                                                                       !
             235                     ! abstract: cld_init is an initialization program for cloud-radiation   !
             236                     !   calculations. it sets up boundary layer cloud top.                  !
             237                     !                                                                       !
             238                     !                                                                       !
             239                     ! inputs:                                                               !
             240                     !   si (l+1)        : model vertical sigma layer interface              !
             241                     !   nlay            : vertical layer number                             !
             242                     !   me              : print control flag                                !
             243                     !                                                                       !
             244                     !  outputs: (none)                                                      !
             245                     !           to module variables                                         !
             246                     !                                                                       !
             247                     !  external module variables: (in physpara)                             !
             248                     !   icldflg         : cloud optical property scheme control flag        !
             249                     !                     =0: model use diagnostic cloud method             !
             250                     !                     =1: model use prognostic cloud method             !
             251                     !   icmphys         : cloud microphysics scheme control flag            !
             252                     !                     =1: zhao/carr/sundqvist microphysics cloud        !
             253                     !                     =2: ferrier microphysics cloud scheme             !
             254                     !		      =3: zhao/carr/sundqvist microphysics cloud +pdfcld!
             255                     !   iovrsw/iovrlw   : sw/lw control flag for cloud overlapping scheme   !
             256                     !                     =0: random overlapping clouds                     !
             257                     !                     =1: max/ran overlapping clouds                    !
             258                     !   ivflip          : control flag for direction of vertical index      !
             259                     !                     =0: index from toa to surface                     !
             260                     !                     =1: index from surface to toa                     !
             261                     !  usage:       call cld_init                                           !
             262                     !                                                                       !
             263                     !  subroutines called:    rhtable                                       !
             264                     !                                                                       !
             265                     !  ===================================================================  !
             266                     !
             267                           implicit none
             268                     
             269                     !  ---  inputs:
             270                           integer, intent(in) :: nlay, me, myrank
             271                     
             272                           real (kind=kind_phys), intent(in) :: si(:)
             273                     
             274                     !  ---  outputs: (none)
             275                     
             276                     !  ---  locals:
             277                           integer :: k, kl, ier
             278                     
             279                     !
             280                     !===> ...  begin here
             281                     !
             282                     !  ---  set up module variables
             283                     
             284                           iovr    = max( iovrsw, iovrlw )    !cld ovlp used for diag hml cld output
             285                     
             286                           if (me == 0 .and. myrank ==0) print *, vtagcld      !print out version tag
             287                     
             288     1                     if ( icldflg == 0 ) then
             289     1                       if (me == 0 .and. myrank ==0) print *,' - using diagnostic cloud method'
             290     1               
             291     1               !  ---  set up tuned rh table
             292     1               
             293     1                       call rhtable( me, ier )
             294     1               
             295     2                       if (ier < 0) then
             296     2                         write(6,99) ier
             297     2                 99      format(3x,' *** error in finding tuned rh table ***'          &
             298     2                    &,         /3x,'     stop at calling subroutine rhtable !!'/)
             299     2                         stop 99
             300     2                       endif
             301     1                     else
             302     2                       if (myrank ==0) then
             303     2                         print *,' - using prognostic cloud method'
             304     3                         if (icmphys == 1) then
             305     3                           print *,'   --- zhao/carr/sundqvist microphysics'
             306     3                         elseif (icmphys == 2) then
             307     3                           print *,'   --- ferrier cloud microphysics'
             308     3                         elseif (icmphys == 3) then
             309     3                           print *,'   --- zhao/carr/sundqvist + pdf cloud'
             310     3                         elseif (icmphys == 6) then
             311     3                           print *,'   --- WSM6 microphysics'
             312     3                         elseif (icmphys == 8) then
             313     3                           print *,'   --- Thompson microphysics'
             314     3                         elseif (icmphys == 11) then
             315     3                           print *,'   --- GFDL microphysics'
             316     3                         else
             317     3                           print *,'  !!! error in cloud microphysc specification!!!', &
             318     3                    &              '  icmphys (np3d) =',icmphys
             319     3                           stop
             320     3                         endif
             321     2                       endif
             322     1                     endif
             323                     
             324                     !  ---  compute llyr - the top of bl cld and is topmost non cld(low) layer
             325                     !       for stratiform (at or above lowest 0.1 of the atmosphere)
             326                     
             327     1                     if ( ivflip == 0 ) then    ! data from toa to sfc
             328     2                       lab_do_k0 : do k = nlay, 2, -1
             329     2                         kl = k
             330     2                         if (si(k) < 0.9e0) exit lab_do_k0
             331     2                       enddo  lab_do_k0
             332     1               
             333     1                       llyr = kl
             334     1                     else                      ! data from sfc to top
             335     2                       lab_do_k1 : do k = 2, nlay
             336     2                         kl = k
             337     2                         if (si(k) < 0.9e0) exit lab_do_k1
             338     2                       enddo  lab_do_k1
             339     1               
             340     1                       llyr = kl - 1
             341     1                     endif                     ! end_if_ivflip
             342                     
             343                     !
             344                           return
             345                     !...................................
             346                           end subroutine cld_init
             347                     !-----------------------------------
             348                     
             349                     
             350                     !-----------------------------------
             351                           subroutine progcld1                                               &
             352                     !...................................
             353                     
             354                     !  ---  inputs:
             355                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
             356                          &       xlat,xlon,slmsk,                                           &
             357                          &       ix, nlay, nlp1, myrank,                                    &
             358                     !  ---  outputs:
             359                          &       clouds,clds,mtop,mbot                                      &
             360                          &      )
             361                     
             362                     ! =================   subprogram documentation block   ================ !
             363                     !                                                                       !
             364                     ! subprogram:    progcld1    computes cloud related quantities using    !
             365                     !   zhao/moorthi's prognostic cloud microphysics scheme.                !
             366                     !                                                                       !
             367                     ! abstract:  this program computes cloud fractions from cloud           !
             368                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
             369                     !   and computes the low, mid, high, total and boundary layer cloud     !
             370                     !   fractions and the vertical indices of low, mid, and high cloud      !
             371                     !   top and base.  the three vertical cloud domains are set up in the   !
             372                     !   initial subroutine "cld_init".                                      !
             373                     !                                                                       !
             374                     ! usage:         call progcld1                                          !
             375                     !                                                                       !
             376                     ! subprograms called:   gethml                                          !
             377                     !                                                                       !
             378                     ! attributes:                                                           !
             379                     !   language:   fortran 90                                              !
             380                     !   machine:    ibm-sp, sgi                                             !
             381                     !                                                                       !
             382                     !                                                                       !
             383                     !  ====================  defination of variables  ====================  !
             384                     !                                                                       !
             385                     ! input variables:                                                      !
             386                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
             387                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
             388                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
             389                     !   tvly  (ix,nlay) : model layer virtual temperature in k              !
             390                     !   qlyr  (ix,nlay) : layer specific humidity in gm/gm                  !
             391                     !   qstl  (ix,nlay) : layer saturate humidity in gm/gm                  !
             392                     !   rhly  (ix,nlay) : layer relative humidity (=qlyr/qstl)              !
             393                     !   clw   (ix,nlay) : layer cloud condensate amount                     !
             394                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
             395                     !                     range, otherwise see in-line comment              !
             396                     !   xlon  (ix)      : grid longitude in radians  (not used)             !
             397                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
             398                     !   ix              : horizontal dimention                              !
             399                     !   nlay,nlp1       : vertical layer/level dimensions                   !
             400                     !                                                                       !
             401                     ! output variables:                                                     !
             402                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
             403                     !      clouds(:,:,1) - layer total cloud fraction                       !
             404                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
             405                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
             406                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
             407                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
             408                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
             409                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
             410                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
             411                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
             412                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
             413                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
             414                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
             415                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
             416                     !                                                                       !
             417                     ! module variables:                                                     !
             418                     !   ivflip          : control flag of vertical index direction          !
             419                     !                     =0: index from toa to surface                     !
             420                     !                     =1: index from surface to toa                     !
             421                     !   lcrick          : control flag for eliminating crick                !
             422                     !                     =t: apply layer smoothing to eliminate crick      !
             423                     !                     =f: do not apply layer smoothing                  !
             424                     !   lcnorm          : control flag for in-cld condensate                !
             425                     !                     =t: normalize cloud condensate                    !
             426                     !                     =f: not normalize cloud condensate                !
             427                     !                                                                       !
             428                     !  ====================    end of description    =====================  !
             429                     !
             430                           implicit none
             431                     
             432                     !  ---  inputs
             433                           integer,  intent(in) :: ix, nlay, nlp1, myrank
             434                     
             435                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
             436                          &       tlyr, tvly, qlyr, qstl, rhly, clw
             437                     
             438                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
             439                          &       slmsk
             440                     
             441                     !  ---  outputs
             442                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
             443                     
             444                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
             445                     
             446                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
             447                     
             448                     !  ---  local variables:
             449                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
             450                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf
             451                     
             452                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
             453                     
             454                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
             455                          &       tem1, tem2, tem3
             456                     
             457                           integer :: i, k, id, nf
             458                     !
             459                     !===> ... begin here
             460                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             461     1  pp                 do nf=1,nf_clds
             462     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             463     3   p   4                 do i=1,ix
             464     3   p   4                   clouds(i,k,nf) = 0.0
             465     3   p   4                 enddo
             466     2   p                   enddo
             467     1   p                 enddo
             468                     !     clouds(:,:,:) = 0.0
             469                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, cip, res, crp, csp, rew, cldcnv
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             470     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.46, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, res, crp, csp, rew
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             471     2   p                   do i = 1, ix
             472     2   p                     cldtot(i,k) = 0.0
             473     2   p                     cldcnv(i,k) = 0.0
             474     2   p                     cwp   (i,k) = 0.0
             475     2   p                     cip   (i,k) = 0.0
             476     2   p                     crp   (i,k) = 0.0
             477     2   p                     csp   (i,k) = 0.0
             478     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
             479     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
             480     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
             481     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
             482     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
             483     2   p                     clwf(i,k)   = 0.0
             484     2   p                   enddo
             485     1   p                 enddo
             486                     !
             487     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             488     2  pp   2               do i = 1, ix
             489     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
             490     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
             491     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             492     2  pp                   do k = 2, nlay-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             493     3   p   2                 do i = 1, ix
             494     3   p   2                   clwf(i,k) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
             495     3   p   2                 enddo
             496     2   p                   enddo
             497     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             498     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             499     3   p   4                 do i = 1, ix
             500     3   p   4                   clwf(i,k) = clw(i,k)
             501     3   p   4                 enddo
             502     2   p                   enddo
             503     1                     endif
             504                     
             505                     !  ---  find top pressure for each cloud domain for given latitude
             506                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,l,m,h;
             507                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
             508                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             509     1  pp                 do id = 1, 4
             510     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
             511     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             512     2   p   2               do i =1, ix
             513     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
             514     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
             515     2               
             516     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
             517     2   p   2               enddo
             518     1   p                 enddo
             519                     
             520                     !  ---  compute liquid/ice condensate path in g/m**2
             521                     
             522     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cwp, cip
                                   <<< Loop-information  End >>>
             523     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 17, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, clwf, tem2d, cip, cwp
                                   <<< Loop-information  End >>>
             524     3   p                     do i = 1, ix
             525     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
             526     3   p                       clwt     = max(0.0, clwf(i,k)) * gfac * delp(i,k)
             527     3   p                       cip(i,k) = clwt * tem2d(i,k)
             528     3   p                       cwp(i,k) = clwt - cip(i,k)
             529     3   p                     enddo
             530     2   p                   enddo
             531     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cwp, cip
                                   <<< Loop-information  End >>>
             532     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 17, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      delp, clwf, tem2d, cip, cwp
                                   <<< Loop-information  End >>>
             533     3   p                     do i = 1, ix
             534     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
             535     3   p                       clwt     = max(0.0, clwf(i,k)) * gfac * delp(i,k)
             536     3   p                       cip(i,k) = clwt * tem2d(i,k)
             537     3   p                       cwp(i,k) = clwt - cip(i,k)
             538     3   p                     enddo
             539     2   p                   enddo
             540     1                     endif                            ! end_if_ivflip
             541                     
             542                     !  ---  effective liquid cloud droplet radius over land
             543                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             544     1  pp                 do i = 1, ix
             545     2   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             546     3   p   4                 do k = 1, nlay
             547     3   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
             548     3   p   4                 enddo
             549     2   p                   endif
             550     1   p                 enddo
             551                     
             552                     !  ---  layer cloud fraction
             553                     
             554     1                     if ( ivflip == 0 ) then              ! input data from toa to sfc
             555     1               
             556     1                       clwmin = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             557     2  pp                   do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             558     3   p                   do i = 1, ix
             559     3   p                     clwt = 1.0e-6 * (plyr(i,k)*0.001)
             560     3               !         clwt = 2.0e-6 * (plyr(i,k)*0.001)
             561     3               
             562     4   p                     if (clwf(i,k) > clwt) then
             563     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
             564     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
             565     4               
             566     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
             567     4               !           tem1  = 2000.0 / tem1
             568     4               
             569     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)  !jhan
             570     4   p                       tem1  = 100.0 / tem1
             571     4               !
             572     4               !           tem1  = 2000.0 / tem1
             573     4               !           tem1  = 1000.0 / tem1
             574     4               !
             575     4               
             576     4   p                       value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
             577     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
             578     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
             579     4   p                     endif
             580     3   p                    enddo
             581     2   p                    enddo
             582     1               
             583     1                     else                                 ! input data from sfc to toa
             584     1               
             585     1                       clwmin = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             586     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             587     3   p                   do i = 1, ix
             588     3   p                     clwt = 1.0e-6 * (plyr(i,k)*0.001)
             589     3               !         clwt = 2.0e-6 * (plyr(i,k)*0.001)
             590     3               
             591     4   p                     if (clwf(i,k) > clwt) then
             592     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
             593     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
             594     4               
             595     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
             596     4               !           tem1  = 2000.0 / tem1
             597     4               
             598     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)  !jhan
             599     4   p                       tem1  = 100.0 / tem1
             600     4               !
             601     4               !           tem1  = 2000.0 / tem1
             602     4               !           tem1  = 1000.0 / tem1
             603     4               !
             604     4               
             605     4   p                       value = max( min( tem1*(clwf(i,k)-clwm), 50.0 ), 0.0 )
             606     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
             607     4               
             608     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
             609     4   p                     endif
             610     3   p                   enddo
             611     2   p                   enddo
             612     1               
             613     1                     endif                                ! end_if_flip
             614                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             615     1  pp   2             do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             616     2   p   2               do i = 1, ix
             617     3   p   2                 if (cldtot(i,k) < climit) then
             618     3   p   2                   cldtot(i,k) = 0.0
             619     3   p   2                   cwp(i,k)    = 0.0
             620     3   p   2                   cip(i,k)    = 0.0
             621     3   p   2                   crp(i,k)    = 0.0
             622     3   p   2                   csp(i,k)    = 0.0
             623     3   p   2                 endif
             624     2   p   2               enddo
             625     1   p   2             enddo
             626                     
             627     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             628     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
             629     3   p                     do i = 1, ix
             630     4   p                       if (cldtot(i,k) >= climit) then
             631     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
             632     4   p                         cwp(i,k) = cwp(i,k) * tem1
             633     4   p                         cip(i,k) = cip(i,k) * tem1
             634     4   p                         crp(i,k) = crp(i,k) * tem1
             635     4   p                         csp(i,k) = csp(i,k) * tem1
             636     4   p                       endif
             637     3   p                     enddo
             638     2   p                   enddo
             639     1                     endif
             640                     
             641                     !  ---  effective ice cloud droplet radius
             642                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 643,669)
                                   <<< Loop-information  End >>>
             643     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 644,670)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, cwp, rew, rei, rer, res
                                   <<< Loop-information  End >>>
             644     2   p                   do i = 1, ix
             645     2   p                     tem2 = tlyr(i,k) - con_ttp
             646     2               
             647     3   p                     if (cip(i,k) > 0.0) then
             648     3               !           tem3 = gord * cip(i,k) * (plyr(i,k)/delp(i,k)) / tvly(i,k)
             649     3   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
             650     3               
             651     4   p                       if (tem2 < -50.0) then
             652     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
             653     4   p                       elseif (tem2 < -40.0) then
             654     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
             655     4   p                       elseif (tem2 < -30.0) then
             656     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
             657     4   p                       else
             658     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
             659     4   p                       endif
             660     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
             661     3               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
             662     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
             663     3               !           rei(i,k)   = max(5.0, min(rei(i,k), 130.0))
             664     3   p                     endif
             665     2   p                   enddo
             666     1   p                 enddo
             667                     
             668                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             669     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             670     2                       do i = 1, ix
             671     2   p                     clouds(i,k,1) = cldtot(i,k)
             672     2   p                     clouds(i,k,2) = cwp(i,k)
             673     2   p                     clouds(i,k,3) = rew(i,k)
             674     2   p                     clouds(i,k,4) = cip(i,k)
             675     2   p                     clouds(i,k,5) = rei(i,k)
             676     2               !         clouds(i,k,6) = 0.0
             677     2   p                     clouds(i,k,7) = rer(i,k)
             678     2               !         clouds(i,k,8) = 0.0
             679     2               !          clouds(i,k,9) = rei(i,k)
             680     2   p                     clouds(i,k,9) = res(i,k)
             681     2                       enddo
             682     1                     enddo
             683                     
             684                     
             685                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
             686                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
             687                     !       the three cloud domain boundaries are defined by ptopc.  the cloud
             688                     !       overlapping method is defined by control flag 'iovr', which may
             689                     !       be different for lw and sw radiation programs.
             690                     
             691                           call gethml                                                       &
             692                     !  ---  inputs:
             693                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
             694                          &       ix,nlay,                                                   &
             695                     !  ---  outputs:
             696                          &       clds, mtop, mbot                                           &
             697                          &     )
             698                     
             699                     
             700                     !
             701                           return
             702                     !...................................
             703                           end subroutine progcld1
             704                     !-----------------------------------
             705                     
             706                     !-----------------------------------
             707                           subroutine progcld3                                               &
             708                     !...................................
             709                     
             710                     !  ---  inputs:
             711                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,cnvw,cnvc,          &
             712                          &       xlat,xlon,slmsk,                                           &
             713                          &       ix, nlay, nlp1,                                            &
             714                          &       deltaq,sup,kdt,me,                                         &
             715                     !  ---  outputs:
             716                          &       clouds,clds,mtop,mbot                                      &
             717                          &      )
             718                     
             719                     ! =================   subprogram documentation block   ================ !
             720                     !                                                                       !
             721                     ! subprogram:    progcld3    computes cloud related quantities using    !
             722                     !   zhao/moorthi's prognostic cloud microphysics scheme.                !
             723                     !                                                                       !
             724                     ! abstract:  this program computes cloud fractions from cloud           !
             725                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
             726                     !   and computes the low, mid, high, total and boundary layer cloud     !
             727                     !   fractions and the vertical indices of low, mid, and high cloud      !
             728                     !   top and base.  the three vertical cloud domains are set up in the   !
             729                     !   initial subroutine "cld_init".                                      !
             730                     !                                                                       !
             731                     ! usage:         call progcld3                                          !
             732                     !                                                                       !
             733                     ! subprograms called:   gethml                                          !
             734                     !                                                                       !
             735                     ! attributes:                                                           !
             736                     !   language:   fortran 90                                              !
             737                     !   machine:    ibm-sp, sgi                                             !
             738                     !                                                                       !
             739                     !                                                                       !
             740                     !  ====================  defination of variables  ====================  !
             741                     !                                                                       !
             742                     ! input variables:                                                      !
             743                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
             744                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
             745                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
             746                     !   tvly  (ix,nlay) : model layer virtual temperature in k              !
             747                     !   qlyr  (ix,nlay) : layer specific humidity in gm/gm                  !
             748                     !   qstl  (ix,nlay) : layer saturate humidity in gm/gm                  !
             749                     !   rhly  (ix,nlay) : layer relative humidity (=qlyr/qstl)              !
             750                     !   clw   (ix,nlay) : layer cloud condensate amount                     !
             751                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
             752                     !                     range, otherwise see in-line comment              !
             753                     !   xlon  (ix)      : grid longitude in radians  (not used)             !
             754                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
             755                     !   ix              : horizontal dimention                              !
             756                     !   nlay,nlp1       : vertical layer/level dimensions                   !
             757                     !   cnvw  (ix,nlay) : layer convective cloud condensate                 !
             758                     !   cnvc  (ix,nlay) : layer convective cloud cover                      !
             759                     !   deltaq(ix,nlay) : half total water distribution width               !
             760                     !   sup             : supersaturation                                   !
             761                     
             762                     !                                                                       !
             763                     ! output variables:                                                     !
             764                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
             765                     !      clouds(:,:,1) - layer total cloud fraction                       !
             766                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
             767                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
             768                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
             769                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
             770                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
             771                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
             772                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
             773                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
             774                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
             775                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
             776                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
             777                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
             778                     !                                                                       !
             779                     ! module variables:                                                     !
             780                     !   ivflip          : control flag of vertical index direction          !
             781                     !                     =0: index from toa to surface                     !
             782                     !                     =1: index from surface to toa                     !
             783                     !   lcrick          : control flag for eliminating crick                !
             784                     !                     =t: apply layer smoothing to eliminate crick      !
             785                     !                     =f: do not apply layer smoothing                  !
             786                     !   lcnorm          : control flag for in-cld condensate                !
             787                     !                     =t: normalize cloud condensate                    !
             788                     !                     =f: not normalize cloud condensate                !
             789                     !                                                                       !
             790                     !  ====================    end of description    =====================  !
             791                     !
             792                           implicit none
             793                     
             794                     !  ---  inputs
             795                           integer,  intent(in) :: ix, nlay, nlp1,kdt
             796                     
             797                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
             798                          &       tlyr, tvly, qlyr, qstl, rhly, clw
             799                     !     &       tlyr, tvly, qlyr, qstl, rhly, clw, cnvw, cnvc
             800                     !      real (kind=kind_phys), dimension(:,:), intent(in) :: deltaq
             801                           real (kind=kind_phys), dimension(:,:) :: deltaq, cnvw, cnvc
             802                           real (kind=kind_phys) qtmp,qsc,rhs
             803                           real (kind=kind_phys), intent(in) :: sup
             804                           real (kind=kind_phys), parameter :: epsq = 1.0e-12
             805                     
             806                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
             807                          &       slmsk
             808                           integer :: me
             809                     
             810                     !  ---  outputs
             811                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
             812                     
             813                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
             814                     
             815                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
             816                     
             817                     !  ---  local variables:
             818                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
             819                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf
             820                     
             821                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
             822                     
             823                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
             824                          &       tem1, tem2, tem3
             825                     
             826                           integer :: i, k, id, nf
             827                     
             828                     !
             829                     !===> ... begin here
             830                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             831     1  pp                 do nf=1,nf_clds
             832     2   p                   do k=1,nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.80, ITR: 12, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             833     3   p   4                 do i=1,ix
             834     3   p   4                   clouds(i,k,nf) = 0.0
             835     3   p   4                 enddo
             836     2   p                   enddo
             837     1   p                 enddo
             838                     !     clouds(:,:,:) = 0.0
             839                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cwp, cip, res, crp, csp, rew, cldcnv
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             840     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.46, ITR: 5, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldcnv, cwp, cip, res, crp, csp, rew
                                   <<<      rei, rer, tem2d, clwf, cldtot
                                   <<< Loop-information  End >>>
             841     2   p                   do i = 1, ix
             842     2   p                     cldtot(i,k) = 0.0
             843     2   p                     cldcnv(i,k) = 0.0
             844     2   p                     cwp   (i,k) = 0.0
             845     2   p                     cip   (i,k) = 0.0
             846     2   p                     crp   (i,k) = 0.0
             847     2   p                     csp   (i,k) = 0.0
             848     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
             849     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
             850     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
             851     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
             852     2   p                     tem2d (i,k) = min( 1.0, max( 0.0, (con_ttp-tlyr(i,k))*0.05 ) )
             853     2   p                     clwf(i,k)   = 0.0
             854     2   p                   enddo
             855     1   p                 enddo
             856                     !
             857     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             858     2  pp   2               do i = 1, ix
             859     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
             860     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
             861     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             862     2  pp                   do k = 2, nlay-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             863     3   p   2                 do i = 1, ix
             864     3   p   2                   clwf(i,k) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
             865     3   p   2                 enddo
             866     2   p                   enddo
             867     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             868     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
             869     3   p   4                 do i = 1, ix
             870     3   p   4                   clwf(i,k) = clw(i,k)
             871     3   p   4                 enddo
             872     2   p                   enddo
             873     1                     endif
             874                     
             875     1                     if(kdt==1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
             876     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 32, MVE: 3, POL: S)
                                   <<< Loop-information  End >>>
             877     3   p   4                 do i = 1, ix
             878     3   p   4                   deltaq(i,k) = (1.-0.95)*qstl(i,k)
             879     3   p   4                 enddo
             880     2   p                   enddo
             881     1                     endif
             882                     
             883                     !  ---  find top pressure for each cloud domain for given latitude
             884                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,l,m,h;
             885                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
             886                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             887     1  pp                 do id = 1, 4
             888     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
             889     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
             890     2   p   2               do i =1, ix
             891     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
             892     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
             893     2               
             894     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
             895     2   p   2               enddo
             896     1   p                 enddo
             897                     
             898                     !  ---  compute liquid/ice condensate path in g/m**2
             899                     
             900     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
             901     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
             902     3   p                     do i = 1, ix
             903     3   p                       delp(i,k) = plvl(i,k+1) - plvl(i,k)
             904     3   p                       clwt  = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
             905     3   p                       cip(i,k) = clwt * tem2d(i,k)
             906     3   p                       cwp(i,k) = clwt - cip(i,k)
             907     3   p                     enddo
             908     2   p                   enddo
             909     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, cwp, delp, cip
                                   <<< Loop-information  End >>>
             910     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 14, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf, tem2d, delp, cip, cwp
                                   <<< Loop-information  End >>>
             911     3   p                     do i = 1, ix
             912     3   p                       delp(i,k) = plvl(i,k) - plvl(i,k+1)
             913     3   p                       clwt = max(0.0,(clwf(i,k)+cnvw(i,k))) * gfac * delp(i,k)
             914     3   p                       cip(i,k) = clwt * tem2d(i,k)
             915     3   p                       cwp(i,k) = clwt - cip(i,k)
             916     3   p                     enddo
             917     2   p                   enddo
             918     1                     endif                            ! end_if_ivflip
             919                     
             920                     !  ---  effective liquid cloud droplet radius over land
             921                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             922     1  pp                 do i = 1, ix
             923     2   p                   if (nint(slmsk(i)) == 1) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 32, MVE: 4, POL: S)
                                   <<< Loop-information  End >>>
             924     3   p   4                 do k = 1, nlay
             925     3   p   4                   rew(i,k) = 5.0 + 5.0 * tem2d(i,k)
             926     3   p   4                 enddo
             927     2   p                   endif
             928     1   p                 enddo
             929                     
             930                     !  ---  layer cloud fraction
             931                     
             932     1                     if ( ivflip == 0 ) then              ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             933     2  pp                     do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             934     3   p                     do i = 1, ix
             935     3   p                       tem1 = tlyr(i,k) - 273.16
             936     4   p                       if(tem1 < con_thgni) then  ! for pure ice, has to be consistent with gscond
             937     4   p                         qsc = sup * qstl(i,k)
             938     4   p                         rhs = sup
             939     4   p                       else
             940     4   p                         qsc = qstl(i,k)
             941     4   p                         rhs = 1.0
             942     4   p                       endif
             943     4   p                      if(rhly(i,k) >= rhs) then
             944     4   p                        cldtot(i,k) = 1.0
             945     4   p                      else
             946     4   p                        qtmp = qlyr(i,k) + clwf(i,k) - qsc
             947     5   p                        if(deltaq(i,k) > epsq) then
             948     6   p                          if(qtmp < -deltaq(i,k) .or. clwf(i,k) < epsq) then
             949     6               !               if(qtmp < -deltaq(i,k)) then
             950     6   p                            cldtot(i,k) = 0.0
             951     6   p                          elseif(qtmp >= deltaq(i,k)) then
             952     6   p                            cldtot(i,k) = 1.0
             953     6   p                          else
             954     6   p                            cldtot(i,k) = 0.5*qtmp/deltaq(i,k) + 0.5
             955     6   p                            cldtot(i,k) = max(cldtot(i,k),0.0)
             956     6   p                            cldtot(i,k) = min(cldtot(i,k),1.0)
             957     6   p                          endif
             958     5   p                        else
             959     6   p                          if(qtmp.gt.0) then
             960     6   p                            cldtot(i,k) = 1.0
             961     6   p                          else
             962     6   p                            cldtot(i,k) = 0.0
             963     6   p                          endif
             964     5   p                        endif
             965     4   p                      endif
             966     3   p                      cldtot(i,k) = cnvc(i,k)+(1-cnvc(i,k))*cldtot(i,k)
             967     3   p                      cldtot(i,k) = max(cldtot(i,k),0.)
             968     3   p                      cldtot(i,k) = min(cldtot(i,k),1.)
             969     3   p                     enddo
             970     2   p                     enddo
             971     1                     else                                 ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             972     2  pp                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
             973     3   p                     do i = 1, ix
             974     3   p                       tem1 = tlyr(i,k) - 273.16
             975     4   p                       if(tem1 < con_thgni) then  ! for pure ice, has to be consistent with gscond
             976     4   p                         qsc = sup * qstl(i,k)
             977     4   p                         rhs = sup
             978     4   p                       else
             979     4   p                         qsc = qstl(i,k)
             980     4   p                         rhs = 1.0
             981     4   p                       endif
             982     4   p                      if(rhly(i,k) >= rhs) then
             983     4   p                        cldtot(i,k) = 1.0
             984     4   p                      else
             985     4   p                        qtmp = qlyr(i,k) + clwf(i,k) - qsc
             986     5   p                        if(deltaq(i,k) > epsq) then
             987     5               !              if(qtmp <= -deltaq(i,k) .or. cwmik < epsq) then
             988     6   p                          if(qtmp <= -deltaq(i,k)) then
             989     6   p                            cldtot(i,k) = 0.0
             990     6   p                          elseif(qtmp >= deltaq(i,k)) then
             991     6   p                            cldtot(i,k) = 1.0
             992     6   p                          else
             993     6   p                            cldtot(i,k) = 0.5*qtmp/deltaq(i,k) + 0.5
             994     6   p                            cldtot(i,k) = max(cldtot(i,k),0.0)
             995     6   p                            cldtot(i,k) = min(cldtot(i,k),1.0)
             996     6   p                          endif
             997     5   p                        else
             998     6   p                          if(qtmp > 0.) then
             999     6   p                            cldtot(i,k) = 1.0
            1000     6   p                          else
            1001     6   p                            cldtot(i,k) = 0.0
            1002     6   p                          endif
            1003     5   p                        endif
            1004     4   p                      endif
            1005     3   p                      cldtot(i,k) = cnvc(i,k) + (1-cnvc(i,k))*cldtot(i,k)
            1006     3   p                      cldtot(i,k) = max(cldtot(i,k),0.)
            1007     3   p                      cldtot(i,k) = min(cldtot(i,k),1.)
            1008     3               
            1009     3   p                     enddo
            1010     2   p                     enddo
            1011     1                     endif                                ! end_if_flip
            1012                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1013     1  pp   2             do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1014     2   p   2               do i = 1, ix
            1015     3   p   2                 if (cldtot(i,k) < climit) then
            1016     3   p   2                   cldtot(i,k) = 0.0
            1017     3   p   2                   cwp(i,k)    = 0.0
            1018     3   p   2                   cip(i,k)    = 0.0
            1019     3   p   2                   crp(i,k)    = 0.0
            1020     3   p   2                   csp(i,k)    = 0.0
            1021     3   p   2                 endif
            1022     2   p   2               enddo
            1023     1   p   2             enddo
            1024                     
            1025     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 314
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1026     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1027     3   p                     do i = 1, ix
            1028     4   p                       if (cldtot(i,k) >= climit) then
            1029     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            1030     4   p                         cwp(i,k) = cwp(i,k) * tem1
            1031     4   p                         cip(i,k) = cip(i,k) * tem1
            1032     4   p                         crp(i,k) = crp(i,k) * tem1
            1033     4   p                         csp(i,k) = csp(i,k) * tem1
            1034     4   p                       endif
            1035     3   p                     enddo
            1036     2   p                   enddo
            1037     1                     endif
            1038                     
            1039                     !  ---  effective ice cloud droplet radius
            1040                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1041,1067)
                                   <<< Loop-information  End >>>
            1041     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1042,1068)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, cwp, rew, rei, rer
                                   <<< Loop-information  End >>>
            1042     2   p                   do i = 1, ix
            1043     2   p                     tem2 = tlyr(i,k) - con_ttp
            1044     2               
            1045     3   p                     if (cip(i,k) > 0.0) then
            1046     3               !           tem3 = gord * cip(i,k) * (plyr(i,k)/delp(i,k)) / tvly(i,k)
            1047     3   p                       tem3 = gord * cip(i,k) * plyr(i,k) / (delp(i,k)*tvly(i,k))
            1048     3               
            1049     4   p                       if (tem2 < -50.0) then
            1050     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            1051     4   p                       elseif (tem2 < -40.0) then
            1052     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            1053     4   p                       elseif (tem2 < -30.0) then
            1054     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            1055     4   p                       else
            1056     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            1057     4   p                       endif
            1058     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            1059     3               !           rei(i,k)   = max(10.0, min(rei(i,k), 100.0))
            1060     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 150.0))
            1061     3               !           rei(i,k)   = max(5.0, min(rei(i,k), 130.0))
            1062     3   p                     endif
            1063     2   p                   enddo
            1064     1   p                 enddo
            1065                     
            1066                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1067     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1068     2                       do i = 1, ix
            1069     2   p                     clouds(i,k,1) = cldtot(i,k)
            1070     2   p                     clouds(i,k,2) = cwp(i,k)
            1071     2   p                     clouds(i,k,3) = rew(i,k)
            1072     2   p                     clouds(i,k,4) = cip(i,k)
            1073     2   p                     clouds(i,k,5) = rei(i,k)
            1074     2               !         clouds(i,k,6) = 0.0
            1075     2   p                     clouds(i,k,7) = rer(i,k)
            1076     2               !         clouds(i,k,8) = 0.0
            1077     2   p                     clouds(i,k,9) = rei(i,k)
            1078     2                       enddo
            1079     1                     enddo
            1080                     
            1081                     
            1082                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            1083                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            1084                     !       the three cloud domain boundaries are defined by ptopc.  the cloud
            1085                     !       overlapping method is defined by control flag 'iovr', which may
            1086                     !       be different for lw and sw radiation programs.
            1087                     
            1088                           call gethml                                                       &
            1089                     !  ---  inputs:
            1090                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            1091                          &       ix,nlay,                                                   &
            1092                     !  ---  outputs:
            1093                          &       clds, mtop, mbot                                           &
            1094                          &     )
            1095                     
            1096                     
            1097                     !
            1098                           return
            1099                     !...................................
            1100                           end subroutine progcld3
            1101                     !-----------------------------------
            1102                     
            1103                     !-----------------------------------
            1104                           subroutine progcld2                                               &
            1105                     !...................................
            1106                     
            1107                     !  ---  inputs:
            1108                          &     ( plyr,plvl,tlyr,tvly,qlyr,qstl,rhly,clw,                    &
            1109                          &       xlat,xlon,slmsk, f_ice,f_rain,r_rime,flgmin,               &
            1110                          &       ix, nlay, nlp1,                                            &
            1111                     !  ---  outputs:
            1112                          &       clouds,clds,mtop,mbot                                      &
            1113                          &      )
            1114                     
            1115                     ! =================   subprogram documentation block   ================ !
            1116                     !                                                                       !
            1117                     ! subprogram:    progcld2    computes cloud related quantities using    !
            1118                     !   ferrier's prognostic cloud microphysics scheme.                     !
            1119                     !                                                                       !
            1120                     ! abstract:  this program computes cloud fractions from cloud           !
            1121                     !   condensates, calculates liquid/ice cloud droplet effective radius,  !
            1122                     !   and computes the low, mid, high, total and boundary layer cloud     !
            1123                     !   fractions and the vertical indices of low, mid, and high cloud      !
            1124                     !   top and base.  the three vertical cloud domains are set up in the   !
            1125                     !   initial subroutine "cld_init".                                      !
            1126                     !                                                                       !
            1127                     ! usage:         call progcld2                                          !
            1128                     !                                                                       !
            1129                     ! subprograms called:   gethml                                          !
            1130                     !                                                                       !
            1131                     ! attributes:                                                           !
            1132                     !   language:   fortran 90                                              !
            1133                     !   machine:    ibm-sp, sgi                                             !
            1134                     !                                                                       !
            1135                     !                                                                       !
            1136                     !  ====================  defination of variables  ====================  !
            1137                     !                                                                       !
            1138                     ! input variables:                                                      !
            1139                     !   plyr  (ix,nlay) : model layer mean pressure in mb (100pa)           !
            1140                     !   plvl  (ix,nlp1) : model level pressure in mb (100pa)                !
            1141                     !   tlyr  (ix,nlay) : model layer mean temperature in k                 !
            1142                     !   tvly  (ix,nlay) : model layer virtual temperature in k              !
            1143                     !   qlyr  (ix,nlay) : layer specific humidity in gm/gm                  !
            1144                     !   qstl  (ix,nlay) : layer saturate humidity in gm/gm                  !
            1145                     !   rhly  (ix,nlay) : layer relative humidity (=qlyr/qstl)              !
            1146                     !   clw   (ix,nlay) : layer cloud condensate amount                     !
            1147                     !   f_ice (ix,nlay) : fraction of layer cloud ice  (ferrier micro-phys) !
            1148                     !   f_rain(ix,nlay) : fraction of layer rain water (ferrier micro-phys) !
            1149                     !   r_rime(ix,nlay) : mass ratio of total ice to unrimed ice (>=1)      !
            1150                     !   flgmin(ix)      : minimim large ice fraction                        !
            1151                     !   xlat  (ix)      : grid latitude in radians, default to pi/2 -> -pi/2!
            1152                     !                     range, otherwise see in-line comment              !
            1153                     !   xlon  (ix)      : grid longitude in radians  (not used)             !
            1154                     !   slmsk (ix)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            1155                     !   ix              : horizontal dimention                              !
            1156                     !   nlay,nlp1       : vertical layer/level dimensions                   !
            1157                     !                                                                       !
            1158                     ! output variables:                                                     !
            1159                     !   clouds(ix,nlay,nf_clds) : cloud profiles                            !
            1160                     !      clouds(:,:,1) - layer total cloud fraction                       !
            1161                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            1162                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            1163                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            1164                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            1165                     !      clouds(:,:,6) - layer rain drop water path         (g/m**2)      !
            1166                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            1167                     !  *** clouds(:,:,8) - layer snow flake water path        (g/m**2)      !
            1168                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            1169                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            1170                     !   clds  (ix,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            1171                     !   mtop  (ix,3)    : vertical indices for low, mid, hi cloud tops      !
            1172                     !   mbot  (ix,3)    : vertical indices for low, mid, hi cloud bases     !
            1173                     !                                                                       !
            1174                     ! external module variables:                                            !
            1175                     !   ivflip          : control flag of vertical index direction          !
            1176                     !                     =0: index from toa to surface                     !
            1177                     !                     =1: index from surface to toa                     !
            1178                     !   lcrick          : control flag for eliminating crick                !
            1179                     !                     =t: apply layer smoothing to eliminate crick      !
            1180                     !                     =f: do not apply layer smoothing                  !
            1181                     !   lcnorm          : control flag for in-cld condensate                !
            1182                     !                     =t: normalize cloud condensate                    !
            1183                     !                     =f: not normalize cloud condensate                !
            1184                     !   lnoprec         : precip effect in radiation flag (ferrier scheme)  !
            1185                     !                     =t: snow/rain has no impact on radiation          !
            1186                     !                     =f: snow/rain has impact on radiation             !
            1187                     !                                                                       !
            1188                     !  ====================    end of description    =====================  !
            1189                     !
            1190                           implicit none
            1191                     
            1192                     !  ---  constants
            1193                     
            1194                     !  ---  inputs
            1195                           integer,  intent(in) :: ix, nlay, nlp1
            1196                     
            1197                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            1198                          &       tlyr, tvly, qlyr, qstl, rhly, clw, f_ice, f_rain, r_rime
            1199                     
            1200                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            1201                          &       slmsk
            1202                           real (kind=kind_phys), dimension(:), intent(in) :: flgmin
            1203                     
            1204                     !  ---  outputs
            1205                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            1206                     
            1207                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            1208                     
            1209                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            1210                     
            1211                     !  ---  local variables:
            1212                           real (kind=kind_phys), dimension(ix,nlay) :: cldtot, cldcnv,      &
            1213                          &       cwp, cip, crp, csp, rew, rei, res, rer, tem2d, clw2,       &
            1214                          &       qcwat, qcice, qrain, fcice, frain, rrime, rsden, clwf
            1215                     
            1216                           real (kind=kind_phys) :: ptop1(ix,nk_clds+1)
            1217                     
            1218                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            1219                          &       tem1, tem2, tem3
            1220                     
            1221                           integer :: i, k, id
            1222                     
            1223                     !
            1224                     !===> ... begin here
            1225                     !
            1226                     !     clouds(:,:,:) = 0.0
            1227                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1228     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot, cldcnv, cwp, cip, crp, csp, rew
                                   <<<      rei, rer, res, fcice, frain, rrime
                                   <<<      tem2d
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1229     2   p                   do i = 1, ix
            1230     2   p                     cldtot(i,k) = 0.0
            1231     2   p                     cldcnv(i,k) = 0.0
            1232     2   p                     cwp   (i,k) = 0.0
            1233     2   p                     cip   (i,k) = 0.0
            1234     2   p                     crp   (i,k) = 0.0
            1235     2   p                     csp   (i,k) = 0.0
            1236     2   p                     rew   (i,k) = reliq_def            ! default liq radius to 10 micron
            1237     2   p                     rei   (i,k) = reice_def            ! default ice radius to 50 micron
            1238     2   p                     rer   (i,k) = rrain_def            ! default rain radius to 1000 micron
            1239     2   p                     res   (i,k) = rsnow_def            ! default snow radius to 250 micron
            1240     2   p                     fcice (i,k) = max(0.0, min(1.0, f_ice(i,k)))
            1241     2   p                     frain (i,k) = max(0.0, min(1.0, f_rain(i,k)))
            1242     2   p                     rrime (i,k) = max(1.0, r_rime(i,k))
            1243     2   p                     tem2d (i,k) = tlyr(i,k) - con_t0c
            1244     2   p                   enddo
            1245     1   p                 enddo
            1246                     !
            1247     1                     if ( lcrick ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 10, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1248     2  pp   2               do i = 1, ix
            1249     2   p   2                 clwf(i,1)    = 0.75*clw(i,1)    + 0.25*clw(i,2)
            1250     2   p   2                 clwf(i,nlay) = 0.75*clw(i,nlay) + 0.25*clw(i,nlay-1)
            1251     2   p   2               enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1252     2  pp                   do k = 2, nlay-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 12, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1253     3   p   2                 do i = 1, ix
            1254     3   p   2                   clwf(i,k) = 0.25*clw(i,k-1) + 0.5*clw(i,k) + 0.25*clw(i,k+1)
            1255     3   p   2                 enddo
            1256     2   p                   enddo
            1257     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1258     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 16, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clwf
                                   <<< Loop-information  End >>>
            1259     3   p   4                 do i = 1, ix
            1260     3   p   4                   clwf(i,k) = clw(i,k)
            1261     3   p   4                 enddo
            1262     2   p                   enddo
            1263     1                     endif
            1264                     
            1265                     !  ---  find top pressure for each cloud domain for given latitude
            1266                     !       ptopc(k,i): top presure of each cld domain (k=1-4 are sfc,l,m,h;
            1267                     !  ---  i=1,2 are low-lat (<45 degree) and pole regions)
            1268                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            1269     1  pp                 do id = 1, 4
            1270     1   p                   tem1 = ptopc(id,2) - ptopc(id,1)
            1271     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 18, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptop1
                                   <<< Loop-information  End >>>
            1272     2   p   2               do i =1, ix
            1273     2   p   2                 tem2 = xlat(i) / con_pi        ! if xlat in pi/2 -> -pi/2 range
            1274     2               !         tem2 = 0.5 - xlat(i)/con_pi    ! if xlat in 0 -> pi range
            1275     2               
            1276     2   p   2                 ptop1(i,id) = ptopc(id,1) + tem1*max( 0.0, 4.0*abs(tem2)-1.0 )
            1277     2   p   2               enddo
            1278     1   p                 enddo
            1279                     
            1280                     !  ---  separate cloud condensate into liquid, ice, and rain types, and
            1281                     !       save the liquid+ice condensate in array clw2 for later
            1282                     !       calculation of cloud fraction
            1283                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 291
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d, clwf, qcwat, clw2
                                   <<< Loop-information  End >>>
            1284     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1285     2   p                   do i = 1, ix
            1286     3   p                     if (tem2d(i,k) > -40.0) then
            1287     3   p                       qcice(i,k) = clwf(i,k) * fcice(i,k)
            1288     3   p                       tem1       = clwf(i,k) - qcice(i,k)
            1289     3   p                       qrain(i,k) = tem1 * frain(i,k)
            1290     3   p                       qcwat(i,k) = tem1 - qrain(i,k)
            1291     3   p                       clw2 (i,k) = qcwat(i,k) + qcice(i,k)
            1292     3   p                     else
            1293     3   p                       qcice(i,k) = clwf(i,k)
            1294     3   p                       qrain(i,k) = 0.0
            1295     3   p                       qcwat(i,k) = 0.0
            1296     3   p                       clw2 (i,k) = clwf(i,k)
            1297     3   p                     endif
            1298     2   p                   enddo
            1299     1   p                 enddo
            1300                     
            1301                           call  rsipath2                                                    &
            1302                     !  ---  inputs:
            1303                          &     ( plyr, plvl, tlyr, qlyr, qcwat, qcice, qrain, rrime,        &
            1304                          &       ix, nlay, ivflip, flgmin,                                  &
            1305                     !  ---  outputs:
            1306                          &       cwp, cip, crp, csp, rew, rer, res, rsden                   &
            1307                          &     )
            1308                     
            1309                     
            1310     1                     if ( ivflip == 0 ) then          ! input data from toa to sfc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1311     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1312     3   p   2                 do i = 1, ix
            1313     3   p   2                   tem2d(i,k) = (con_g * plyr(i,k))                            &
            1314     3                    &                 / (con_rd* (plvl(i,k+1) - plvl(i,k)))
            1315     3   p   2                 enddo
            1316     2   p                   enddo
            1317     1                     else                             ! input data from sfc to toa
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1318     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 6, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tem2d
                                   <<< Loop-information  End >>>
            1319     3   p   2                 do i = 1, ix
            1320     3   p   2                   tem2d(i,k) = (con_g * plyr(i,k))                            &
            1321     3                    &                 / (con_rd* (plvl(i,k) - plvl(i,k+1)))
            1322     3   p   2                 enddo
            1323     2   p                   enddo
            1324     1                     endif                            ! end_if_ivflip
            1325                     
            1326                     !  ---  layer cloud fraction
            1327                     
            1328     1                     if ( ivflip == 0 ) then              ! input data from toa to sfc
            1329     1               
            1330     1                       clwmin = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1331     2  pp                   do k = nlay, 1, -1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clw2
                                   <<< Loop-information  End >>>
            1332     3   p                   do i = 1, ix
            1333     3               !         clwt = 1.0e-6 * (plyr(i,k)*0.001)
            1334     3   p                     clwt = 2.0e-6 * (plyr(i,k)*0.001)
            1335     3               
            1336     4   p                     if (clw2(i,k) > clwt) then
            1337     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            1338     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            1339     4               
            1340     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)    !jhan
            1341     4   p                       tem1  = 100.0 / tem1
            1342     4               
            1343     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1344     4               !           tem1  = 2000.0 / tem1
            1345     4               !
            1346     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1347     4               !           tem1  = 2200.0 / tem1
            1348     4               !           tem1  = 2400.0 / tem1
            1349     4               !           tem1  = 2500.0 / tem1
            1350     4               !           tem1  = min(max(sqrt(onemrh*qstl(i,k)),0.0001),1.0)
            1351     4               !           tem1  = 2000.0 / tem1
            1352     4               !           tem1  = 1000.0 / tem1
            1353     4               !           tem1  = 100.0 / tem1
            1354     4               
            1355     4   p                       value = max( min( tem1*(clw2(i,k)-clwm), 50.0 ), 0.0 )
            1356     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
            1357     4               
            1358     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            1359     4   p                     endif
            1360     3   p                   enddo
            1361     2   p                   enddo
            1362     1               
            1363     1                     else                                 ! input data from sfc to toa
            1364     1               
            1365     1                       clwmin = 0.0e-6
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1366     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clw2
                                   <<< Loop-information  End >>>
            1367     3   p                   do i = 1, ix
            1368     3               !         clwt = 1.0e-6 * (plyr(i,k)*0.001)
            1369     3   p                     clwt = 2.0e-6 * (plyr(i,k)*0.001)
            1370     3               
            1371     4   p                     if (clw2(i,k) > clwt) then
            1372     4   p                       onemrh= max( 1.e-10, 1.0-rhly(i,k) )
            1373     4   p                       clwm  = clwmin / max( 0.01, plyr(i,k)*0.001 )
            1374     4               
            1375     4   p                       tem1  = min(max((onemrh*qstl(i,k))**0.49,0.0001),1.0)   !jhan
            1376     4   p                       tem1  = 100.0 / tem1
            1377     4               
            1378     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1379     4               !           tem1  = 2000.0 / tem1
            1380     4               !
            1381     4               !           tem1  = min(max(sqrt(sqrt(onemrh*qstl(i,k))),0.0001),1.0)
            1382     4               !           tem1  = 2200.0 / tem1
            1383     4               !           tem1  = 2400.0 / tem1
            1384     4               !           tem1  = 2500.0 / tem1
            1385     4               !           tem1  = min(max(sqrt(onemrh*qstl(i,k)),0.0001),1.0)
            1386     4               !           tem1  = 2000.0 / tem1
            1387     4               !           tem1  = 1000.0 / tem1
            1388     4               !           tem1  = 100.0 / tem1
            1389     4               
            1390     4   p                       value = max( min( tem1*(clw2(i,k)-clwm), 50.0 ), 0.0 )
            1391     4   p                       tem2  = sqrt( sqrt(rhly(i,k)) )
            1392     4               
            1393     4   p                       cldtot(i,k) = max( tem2*(1.0-exp(-value)), 0.0 )
            1394     4   p                     endif
            1395     3   p                   enddo
            1396     2   p                   enddo
            1397     1               
            1398     1                     endif                                ! end_if_flip
            1399                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
            1400     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1401     2   p   2               do i = 1, ix
            1402     3   p   2                 if (cldtot(i,k) < climit) then
            1403     3   p   2                   cldtot(i,k) = 0.0
            1404     3   p   2                   cwp(i,k)    = 0.0
            1405     3   p   2                   cip(i,k)    = 0.0
            1406     3   p   2                   crp(i,k)    = 0.0
            1407     3   p   2                   csp(i,k)    = 0.0
            1408     3   p   2                 endif
            1409     2   p   2               enddo
            1410     1   p                 enddo
            1411                     
            1412                     !     when lnoprec = .true. snow/rain has no impact on radiation
            1413     1                     if ( lnoprec ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
            1414     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      crp, csp
                                   <<< Loop-information  End >>>
            1415     3   p   4                 do i = 1, ix
            1416     3   p   4                   crp(i,k) = 0.0
            1417     3   p   4                   csp(i,k) = 0.0
            1418     3   p   4                 enddo
            1419     2   p                   enddo
            1420     1                     endif
            1421                     !
            1422     1                     if ( lcnorm ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1423     2  pp                   do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldtot
                                   <<< Loop-information  End >>>
            1424     3   p                     do i = 1, ix
            1425     4   p                       if (cldtot(i,k) >= climit) then
            1426     4   p                         tem1 = 1.0 / max(climit2, cldtot(i,k))
            1427     4   p                         cwp(i,k) = cwp(i,k) * tem1
            1428     4   p                         cip(i,k) = cip(i,k) * tem1
            1429     4   p                         crp(i,k) = crp(i,k) * tem1
            1430     4   p                         csp(i,k) = csp(i,k) * tem1
            1431     4   p                       endif
            1432     3   p                     enddo
            1433     2   p                   enddo
            1434     1                     endif
            1435                     
            1436                     !  ---  effective ice cloud droplet radius
            1437                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1438,1468)
                                   <<< Loop-information  End >>>
            1438     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1439,1469)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cip, cldtot, crp, rer, cwp, rew, rei
                                   <<<      csp, rsden
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 5
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1439     2   p                   do i = 1, ix
            1440     2   p                     tem1 = tlyr(i,k) - con_ttp
            1441     2   p                     tem2 = cip(i,k)
            1442     2               
            1443     3   p                     if (tem2 > 0.0) then
            1444     3   p                       tem3 = tem2d(i,k) * tem2 / tvly(i,k)
            1445     3               
            1446     4   p                       if (tem1 < -50.0) then
            1447     4   p                         rei(i,k) = (1250.0/9.917) * tem3 ** 0.109
            1448     4   p                       elseif (tem1 < -40.0) then
            1449     4   p                         rei(i,k) = (1250.0/9.337) * tem3 ** 0.08
            1450     4   p                       elseif (tem1 < -30.0) then
            1451     4   p                         rei(i,k) = (1250.0/9.208) * tem3 ** 0.055
            1452     4   p                       else
            1453     4   p                         rei(i,k) = (1250.0/9.387) * tem3 ** 0.031
            1454     4   p                       endif
            1455     3               
            1456     3               !           if (lprnt .and. k == l) print *,' reil=',rei(i,k),' icec=', &
            1457     3               !    &        icec,' cip=',cip(i,k),' tem=',tem,' delt=',delt
            1458     3               
            1459     3   p                       rei(i,k)   = max(10.0, min(rei(i,k), 300.0))
            1460     3               !           rei(i,k)   = max(20.0, min(rei(i,k), 300.0))
            1461     3               !!!!        rei(i,k)   = max(30.0, min(rei(i,k), 300.0))
            1462     3               !           rei(i,k)   = max(50.0, min(rei(i,k), 300.0))
            1463     3               !           rei(i,k)   = max(100.0, min(rei(i,k), 300.0))
            1464     3   p                     endif
            1465     2   p                   enddo
            1466     1   p                 enddo
            1467                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1468     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1469     2                       do i = 1, ix
            1470     2   p                     clouds(i,k,1) = cldtot(i,k)
            1471     2   p                     clouds(i,k,2) = cwp(i,k)
            1472     2   p                     clouds(i,k,3) = rew(i,k)
            1473     2   p                     clouds(i,k,4) = cip(i,k)
            1474     2   p                     clouds(i,k,5) = rei(i,k)
            1475     2   p                     clouds(i,k,6) = crp(i,k)
            1476     2   p                     clouds(i,k,7) = rer(i,k)
            1477     2               !         clouds(i,k,8) = csp(i,k)               !ncar scheme
            1478     2   p                     clouds(i,k,8) = csp(i,k) * rsden(i,k)  !fu's scheme
            1479     2   p                     clouds(i,k,9) = rei(i,k)
            1480     2                       enddo
            1481     1                     enddo
            1482                     
            1483                     
            1484                     !  ---  compute low, mid, high, total, and boundary layer cloud fractions
            1485                     !       and clouds top/bottom layer indices for low, mid, and high clouds.
            1486                     !       the three cloud domain boundaries are defined by ptopc.  the cloud
            1487                     !       overlapping method is defined by control flag 'iovr', which may
            1488                     !       be different for lw and sw radiation programs.
            1489                     
            1490                           call gethml                                                       &
            1491                     !  ---  inputs:
            1492                          &     ( plyr, ptop1, cldtot, cldcnv,                               &
            1493                          &       ix,nlay,                                                   &
            1494                     !  ---  outputs:
            1495                          &       clds, mtop, mbot                                           &
            1496                          &     )
            1497                     
            1498                     
            1499                     !
            1500                           return
            1501                     !...................................
            1502                           end subroutine progcld2
            1503                     !-----------------------------------
            1504                     
            1505                     
            1506                     !-----------------------------------
            1507                           subroutine progcld4                                               &
            1508                          &     ( plyr,plvl,tlyr,qlyr,qstl,rhly,clw,                         &    !  ---  inputs:
            1509                          &       xlat,xlon,slmsk,                                           &
            1510                          &       ntrac,ntcw,ntiw,ntrw,ntsw,ntgl,                            &
            1511                          &       ix, nlay, nlp1,                                            &
            1512                          &       uni_cld, lmfshal, lmfdeep2, cldcov,                        &
            1513                          &       re_cloud,re_ice,re_snow,                                   &
            1514                          &       clouds,clds,mtop,mbot                                      &    !  ---  outputs:
            1515                          &      )
            1516                     
            1517                     ! =================   subprogram documentation block   ================ !
            1518                     !                                                                       !
            1519                     ! subprogram:    progcld4    computes cloud related quantities using    !
            1520                     !   Thompson/WSM6 cloud microphysics scheme.                !
            1521                     !                                                                       !
            1522                     ! abstract:  this program computes cloud fractions from cloud           !
            1523                     !   condensates,                                                        !
            1524                     !   and computes the low, mid, high, total and boundary layer cloud     !
            1525                     !   fractions and the vertical indices of low, mid, and high cloud      !
            1526                     !   top and base.  the three vertical cloud domains are set up in the   !
            1527                     !   initial subroutine "cld_init".                                      !
            1528                     !                                                                       !
            1529                     ! usage:         call progcld4                                          !
            1530                     !                                                                       !
            1531                     ! subprograms called:   gethml                                          !
            1532                     !                                                                       !
            1533                     ! attributes:                                                           !
            1534                     !   language:   fortran 90                                              !
            1535                     !   machine:    ibm-sp, sgi                                             !
            1536                     !                                                                       !
            1537                     !                                                                       !
            1538                     !  ====================  definition of variables  ====================  !
            1539                     !                                                                       !
            1540                     ! input variables:                                                      !
            1541                     !   plyr  (IX,NLAY) : model layer mean pressure in mb (100Pa)           !
            1542                     !   plvl  (IX,NLP1) : model level pressure in mb (100Pa)                !
            1543                     !   tlyr  (IX,NLAY) : model layer mean temperature in k                 !
            1544                     !   tvly  (IX,NLAY) : model layer virtual temperature in k              !
            1545                     !   qlyr  (IX,NLAY) : layer specific humidity in gm/gm                  !
            1546                     !   qstl  (IX,NLAY) : layer saturate humidity in gm/gm                  !
            1547                     !   rhly  (IX,NLAY) : layer relative humidity (=qlyr/qstl)              !
            1548                     !   clw   (IX,NLAY,ntrac) : layer cloud condensate amount               !
            1549                     !   xlat  (IX)      : grid latitude in radians, default to pi/2 -> -pi/2!
            1550                     !                     range, otherwise see in-line comment              !
            1551                     !   xlon  (IX)      : grid longitude in radians  (not used)             !
            1552                     !   slmsk (IX)      : sea/land mask array (sea:0,land:1,sea-ice:2)      !
            1553                     !   IX              : horizontal dimention                              !
            1554                     !   NLAY,NLP1       : vertical layer/level dimensions                   !
            1555                     !   uni_cld         : logical - true for cloud fraction from shoc       !
            1556                     !   lmfshal         : logical - true for mass flux shallow convection   !
            1557                     !   lmfdeep2        : logical - true for mass flux deep convection      !
            1558                     !   cldcov          : layer cloud fraction (used when uni_cld=.true.    !
            1559                     !                                                                       !
            1560                     ! output variables:                                                     !
            1561                     !   clouds(IX,NLAY,NF_CLDS) : cloud profiles                            !
            1562                     !      clouds(:,:,1) - layer total cloud fraction                       !
            1563                     !      clouds(:,:,2) - layer cloud liq water path         (g/m**2)      !
            1564                     !      clouds(:,:,3) - mean eff radius for liq cloud      (micron)      !
            1565                     !      clouds(:,:,4) - layer cloud ice water path         (g/m**2)      !
            1566                     !      clouds(:,:,5) - mean eff radius for ice cloud      (micron)      !
            1567                     !      clouds(:,:,6) - layer rain drop water path         not assigned  !
            1568                     !      clouds(:,:,7) - mean eff radius for rain drop      (micron)      !
            1569                     !  *** clouds(:,:,8) - layer snow flake water path        not assigned  !
            1570                     !      clouds(:,:,9) - mean eff radius for snow flake     (micron)      !
            1571                     !  *** fu's scheme need to be normalized by snow density (g/m**3/1.0e6) !
            1572                     !   clds  (IX,5)    : fraction of clouds for low, mid, hi, tot, bl      !
            1573                     !   mtop  (IX,3)    : vertical indices for low, mid, hi cloud tops      !
            1574                     !   mbot  (IX,3)    : vertical indices for low, mid, hi cloud bases     !
            1575                     !                                                                       !
            1576                     ! module variables:                                                     !
            1577                     !   ivflip          : control flag of vertical index direction          !
            1578                     !                     =0: index from toa to surface                     !
            1579                     !                     =1: index from surface to toa                     !
            1580                     !   lmfshal         : mass-flux shallow conv scheme flag                !
            1581                     !   lmfdeep2        : scale-aware mass-flux deep conv scheme flag       !
            1582                     !   lcrick          : control flag for eliminating CRICK                !
            1583                     !                     =t: apply layer smoothing to eliminate CRICK      !
            1584                     !                     =f: do not apply layer smoothing                  !
            1585                     !   lcnorm          : control flag for in-cld condensate                !
            1586                     !                     =t: normalize cloud condensate                    !
            1587                     !                     =f: not normalize cloud condensate                !
            1588                     !                                                                       !
            1589                     !  ====================    end of description    =====================  !
            1590                     !
            1591                           implicit none
            1592                     
            1593                     !  ---  inputs
            1594                           integer,  intent(in) :: IX, NLAY, NLP1
            1595                           integer,  intent(in) :: ntrac, ntcw, ntiw, ntrw, ntsw, ntgl
            1596                     
            1597                           logical, intent(in)  :: uni_cld, lmfshal, lmfdeep2
            1598                     
            1599                           real (kind=kind_phys), dimension(:,:), intent(in) :: plvl, plyr,  &
            1600                          &       tlyr, qlyr, qstl, rhly, cldcov,                            &
            1601                          &       re_cloud, re_ice, re_snow
            1602                     
            1603                           real (kind=kind_phys), dimension(:,:,:), intent(in) :: clw
            1604                     
            1605                           real (kind=kind_phys), dimension(:),   intent(in) :: xlat, xlon,  &
            1606                          &       slmsk
            1607                     
            1608                     !  ---  outputs
            1609                           real (kind=kind_phys), dimension(:,:,:), intent(out) :: clouds
            1610                     
            1611                           real (kind=kind_phys), dimension(:,:),   intent(out) :: clds
            1612                     
            1613                           integer,               dimension(:,:),   intent(out) :: mtop,mbot
            1614                     
            1615                     !  ---  local variables:
            1616                           real (kind=kind_phys), dimension(IX,NLAY) :: cldtot, cldcnv,      &
            1617                          &       cwp, cip, crp, csp, rew, rei, res, rer, delp, tem2d, clwf
            1618                     
            1619                           real (kind=kind_phys) :: ptop1(IX,NK_CLDS+1)
            1620                     
            1621                           real (kind=kind_phys) :: clwmin, clwm, clwt, onemrh, value,       &
            1622                          &       tem1, tem2, tem3
            1623                     
            1624                           integer :: i, k, id, nf
            1625                     
            1626                     !  ---  constant values
            1627                     !     real (kind=kind_phys), parameter :: xrc3 = 200.
            1628                           real (kind=kind_phys), parameter :: xrc3 = 100.
            1629                     
            1630                     !
            1631                     !===> ... begin here
            1632                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            1633     1  pp                 do nf=1,nf_clds
            1634     2   p                   do k=1,nlay

            3622     5   p   2                     if (omeg >= vvcld1) then
            3623     5   p   2                       cldtot(i,k) = 0.0
            3624     5   p   2                     elseif (omeg > vvcld2) then
            3625     5   p   2                       tem1 = (vvcld1 - omeg) / value
            3626     5   p   2                       cldtot(i,k) = cldtot(i,k) * sqrt(tem1)
            3627     5   p   2                     endif

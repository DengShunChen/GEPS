 External subroutine subprogram "chlen"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine chlen (char,n,lench)
               2                     !
               3                           character*1 char(n)
               4                     !
               5                     !  search for first blank in character string
               6                     !
               7     1                     do 10 k=1,n
               8     2                     if (char(k).eq.' ') then
               9     2                       lench=k-1
              10     2                       return
              11     2                     endif
              12     1                  10 continue
              13                     !
              14                     !  no blank found, string must be full
              15                     !
              16                           lench= n
              17                     !
              18                           return
              19                           end


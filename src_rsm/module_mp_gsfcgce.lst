             360     1                                          its,ite,jts,jte,kts,kte)
             361     1               !   else if (mod(itimestep,i24h).eq.1) then
             362     1               !      print *,'no neg correction in mp at timestep=',itimestep
             363     1                  endif ! iskip
             364                     
             365                     !c microphysics in GCE
             366                     
             367                        call SATICEL_S( dt_in, IHAIL, itaobraun, ICE2, istatmin,     &
             368                                        new_ice_sat, id,                             &
             369                     !                   th, th_old, qv, ql, qr,                      &
             370                                        th, qv, ql, qr,                      &
             371                                        qi, qs, qg,                                  &
             372                     !                   qvold, qlold, qrold,                         &
             373                     !                   qiold, qsold, qgold,                         &
             374                                        rho, pii, p, itimestep,                      &
             375                                        refl_10cm, diagflag, do_radar_ref,           & ! GT added for reflectivity calcs
             376                     !                   ids,ide, jds,jde, kds,kde,                   & ! domain dims
             377                                        ims,ime, jms,jme, kms,kme,                   & ! memory dims
             378                                        its,ite, jts,jte, kts,kte                    & ! tile   dims
             379                     #ifdef EffectRad_GCE3
             380                                       ,xland,                                       &
             381                                        re_cloud_gsfc, re_rain_gsfc, re_ice_gsfc,    & ! cloud effective radius
             382                                        re_snow_gsfc, re_graupel_gsfc                & ! cloud effective radius
             383                     #endif
             384                                                                                     )
             385                     
             386                     
             387                        END SUBROUTINE gsfcgce
             388                     
             389                     !-----------------------------------------------------------------------
             390                        SUBROUTINE fall_flux ( dt, qr, qi, qs, qg, p,              &
             391                     #ifdef vti_DM08
             392                                           tt,                                     &
             393                     #endif
             394                                           rho, z, dz8w, topo, rainnc,             &
             395                                           rainncv, grav, itimestep,               &
             396                                           rhowater, rhosnow,                      &
             397                                           snownc, snowncv, sr,                    &
             398                                           graupelnc, graupelncv,                  &
             399                                           ihail, ice2,                            &
             400                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             401                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             402                     !-----------------------------------------------------------------------
             403                     ! adopted from Jiun-Dar Chern's codes for Purdue Regional Model
             404                     ! adopted by Jainn J. Shi, 6/10/2005
             405                     !-----------------------------------------------------------------------
             406                     
             407                       IMPLICIT NONE
             408                       INTEGER, INTENT(IN   )               :: ihail, ice2,                &
             409                                                               ims,ime, jms,jme, kms,kme,  &
             410                                                               its,ite, jts,jte, kts,kte
             411                       INTEGER, INTENT(IN   )               :: itimestep
             412                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             413                                INTENT(INOUT)               :: qr, qi, qs, qg
             414                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             415                                INTENT(INOUT)               :: rainnc, rainncv,            &
             416                                                               snownc, snowncv, sr,        &
             417                                                               graupelnc, graupelncv
             418                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             419                                INTENT(IN   )               :: rho, z, dz8w, p
             420                     #ifdef vti_DM08
             421                       REAL,    DIMENSION( ims:ime , kms:kme , jms:jme ),                  &
             422                                INTENT(IN   )               :: tt
             423                     #endif
             424                     
             425                       REAL,    INTENT(IN   )               :: dt, grav, rhowater, rhosnow
             426                     
             427                     
             428                       REAL,    DIMENSION( ims:ime , jms:jme ),                            &
             429                                INTENT(IN   )               :: topo
             430                     
             431                     ! temperary vars
             432                     
             433                       REAL,    DIMENSION( kts:kte )           :: sqrhoz
             434                       REAL                                    :: tmp1, term0
             435                       REAL                                :: pptrain, pptsnow,        &
             436                                                              pptgraul, pptice
             437                       REAL,    DIMENSION( kts:kte )       :: qrz, qiz, qsz, qgz,      &
             438                                                              zz, dzw, prez, rhoz,     &
             439                                                              orhoz
             440                     
             441                     
             442                        INTEGER                    :: k, i, j
             443                     !
             444                     
             445                       REAL, DIMENSION( kts:kte )    :: vtr, vts, vtg, vti
             446                     
             447                       REAL                          :: dtb, pi, consta, constc, gambp4,    &
             448                                                        gamdp4, gam4pt5, gam4bbar
             449                     
             450                     !  Lin
             451                     !-GT  REAL    , PARAMETER ::     xnor = 8.0e6
             452                     !   REAL    , PARAMETER ::     xnos = 3.0e6
             453                     !-GT   REAL    , PARAMETER ::     xnos = 1.6e7   ! Tao's value
             454                        REAL    , PARAMETER ::                              &
             455                     !             constb = 0.8, constd = 0.25, o6 = 1./6.,           &
             456                                  constb = 0.8, constd = 0.11, o6 = 1./6.,           &
             457                                  cdrag = 0.6
             458                     !  Lin
             459                     !  REAL    , PARAMETER ::     xnoh = 4.0e4
             460                     !-GT  REAL    , PARAMETER ::     xnoh = 2.0e5    ! Tao's value
             461                     !-GT  REAL    , PARAMETER ::     rhohail = 917.
             462                     
             463                     ! Hobbs
             464                     !-GT  REAL    , PARAMETER ::     xnog = 4.0e6
             465                     !-GT  REAL    , PARAMETER ::     rhograul = 400.
             466                       REAL    , PARAMETER ::     abar = 19.3, bbar = 0.37,      &
             467                                                           p0 = 1.0e5
             468                     
             469                       REAL    , PARAMETER ::     rhoe_s = 1.29
             470                     
             471                     ! for terminal velocity flux
             472                       INTEGER                       :: min_q, max_q
             473                       REAL                          :: t_del_tv, del_tv, flux, fluxin, fluxout ,tmpqrz
             474                       LOGICAL                       :: notlast
             475                     
             476                     #ifdef vti_DM08
             477                     ! for velocity constants :
             478                         real, parameter :: aa = - 4.14122e-5
             479                         real, parameter :: bb = - 0.00538922
             480                         real, parameter :: cc = - 0.0516344
             481                         real, parameter :: dd = 0.00216078
             482                         real, parameter :: ee = 1.9714
             483                         real            :: tc
             484                     #endif
             485                     
             486                     !  if (itimestep.eq.1) then
             487                     !     write(6, *) 'in fall_flux'
             488                     !     write(6, *) 'ims=', ims, '  ime=', ime
             489                     !     write(6, *) 'jms=', jms, '  jme=', jme
             490                     !     write(6, *) 'kms=', kms, '  kme=', kme
             491                     !     write(6, *) 'its=', its, '  ite=', ite
             492                     !     write(6, *) 'jts=', jts, '  jte=', jte
             493                     !     write(6, *) 'kts=', kts, '  kte=', kte
             494                     !     write(6, *) 'dt=', dt
             495                     !     write(6, *) 'ihail=', ihail
             496                     !     write(6, *) 'ICE2=', ICE2
             497                     !     write(6, *) 'dt=', dt
             498                     !   endif
             499                     
             500                     !-----------------------------------------------------------------------
             501                     !  This program calculates precipitation fluxes due to terminal velocities.
             502                     !-----------------------------------------------------------------------
             503                     
             504                        dtb=dt
             505                        pi=acos(-1.)
             506                        consta=2115.0*0.01**(1-constb)
             507                     !   constc=152.93*0.01**(1-constd)
             508                        constc=78.63*0.01**(1-constd)
             509                     
             510                     !  Gamma function
             511                        gambp4=ggamma(constb+4.)
             512                        gamdp4=ggamma(constd+4.)
             513                        gam4pt5=ggamma(4.5)
             514                        gam4bbar=ggamma(4.+bbar)
             515                     
             516                     !***********************************************************************
             517                     ! Calculate precipitation fluxes due to terminal velocities.
             518                     !***********************************************************************
             519                     !
             520                     !- Calculate termianl velocity (vt?)  of precipitation q?z
             521                     !- Find maximum vt? to determine the small delta t
             522                     
             523     1                j_loop:  do j = jts, jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, sqrhoz, orhoz, qsz, qiz, dzw, zz
                                   <<<      prez, qrz, qgz
                                   <<< Loop-information  End >>>
             524     2                i_loop:  do i = its, ite
             525     2               
             526     2                  pptrain = 0.
             527     2                  pptsnow = 0.
             528     2                  pptgraul = 0.
             529     2                  pptice  = 0.
             530     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 254
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 531,541,545)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.70, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsz, qiz, dzw, zz, prez, sqrhoz, orhoz
                                   <<<      rhoz, qrz
                                   <<< Loop-information  End >>>
             531     3  pp    v         do k = kts, kte
             532     3   p    v            qrz(k)=qr(i,k,j)
             533     3   p    v            rhoz(k)=rho(i,k,j)
             534     3   p    v            orhoz(k)=1./rhoz(k)
             535     3   p    v            prez(k)=p(i,k,j)
             536     3   p    v            sqrhoz(k)=sqrt(rhoe_s/rhoz(k))
             537     3   p    v            zz(k)=z(i,k,j)
             538     3   p    v            dzw(k)=dz8w(i,k,j)
             539     3   p    v         enddo !k
             540     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             541     3                     DO k = kts, kte
             542     3                        qiz(k)=qi(i,k,j)
             543     3                     ENDDO
             544     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             545     3                     DO k = kts, kte
             546     3                        qsz(k)=qs(i,k,j)
             547     3                     ENDDO
             548     2               
             549     3                  IF (ice2 .eq. 0) THEN
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<< Loop-information  End >>>
             550     4  pp   4v            DO k = kts, kte
             551     4   p   4v               qgz(k)=qg(i,k,j)
             552     4   p   4v            ENDDO
             553     3                  ELSE
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<< Loop-information  End >>>
             554     4  pp   4v            DO k = kts, kte
             555     4   p   4v               qgz(k)=0.
             556     4   p   4v            ENDDO
             557     3                  ENDIF
             558     2               
             559     2               
             560     2               !
             561     2               !-- rain
             562     2               !
             563     2                   t_del_tv=0.
             564     2                   del_tv=dtb
             565     2                   notlast=.true.
             566     3                   DO while (notlast)
             567     3               !
             568     3                     min_q=kte
             569     3                     max_q=kts-1
             570     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qrz
                                   <<< Loop-information  End >>>
             571     4   s   2s            do k=kts,kte-1
             572     5   p   2v               if (qrz(k) .gt. 1.0e-8) then
             573     5   p   2v                  min_q=min0(min_q,k)
             574     5   p   2v                  max_q=max0(max_q,k)
             575     5   p   2v                  tmp1=sqrt(pi*rhowater*xnor/rhoz(k)/qrz(k))
             576     5   p   2v                  tmp1=sqrt(tmp1)
             577     5   p   2v                  vtr(k)=consta*gambp4*sqrhoz(k)/tmp1**constb
             578     5   m   2m                  vtr(k)=vtr(k)/6.
             579     6   p   2v                  if (k .eq. 1) then
             580     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtr(k))
             581     6   m   2m                     del_tv=dmin1(del_tv,0.9*(zz(k)-topo(i,j))/vtr(k))
             582     6   p   2v                  else
             583     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtr(k))
             584     6   m   2m                     del_tv=dmin1(del_tv,0.9*(zz(k)-zz(k-1))/vtr(k))
             585     6   p   2v                  endif
             586     5   p   2v               else
             587     5   s   2m                  vtr(k)=0.
             588     5   p   2v               endif
             589     4   p   2v            enddo
             590     3               
             591     4                     if (max_q .ge. min_q) then
             592     4               !
             593     4               !- Check if the summation of the small delta t >=  big delta t
             594     4               !             (t_del_tv)          (del_tv)             (dtb)
             595     4               
             596     4                        t_del_tv=t_del_tv+del_tv
             597     4               !
             598     5                        if ( t_del_tv .ge. dtb ) then
             599     5                             notlast=.false.
             600     5                             del_tv=dtb+del_tv-t_del_tv
             601     5                        endif
             602     4               
             603     4               ! use small delta t to calculate the qrz flux
             604     4               ! termi is the qrz flux pass in the grid box through the upper boundary
             605     4               ! termo is the qrz flux pass out the grid box through the lower boundary
             606     4               !
             607     4                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qrz, vtr, dzw
                                   <<< Loop-information  End >>>
             608     5   s    s               do k=max_q,min_q,-1
             609     5   p    v                  fluxout=rhoz(k)*vtr(k)*qrz(k)
             610     5   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             611     5               !            tmpqrz=qrz(k)
             612     5   p    v                  qrz(k)=qrz(k)+del_tv*flux
             613     5               !            qrz(k)=amax1(0.,qrz(k))
             614     5   p    v                  qrz(k)=dmax1(0.,qrz(k))
             615     5   p    v                  qr(i,k,j)=qrz(k)
             616     5   s    s                  fluxin=fluxout
             617     5   p    v               enddo
             618     5                        if (min_q .eq. 1) then
             619     5                           pptrain=pptrain+fluxin*del_tv
             620     5                        else
             621     5                           qrz(min_q-1)=qrz(min_q-1)+del_tv*  &
             622     5                                         fluxin/rhoz(min_q-1)/dzw(min_q-1)
             623     5                           qr(i,min_q-1,j)=qrz(min_q-1)
             624     5                        endif
             625     4               !
             626     4                     else
             627     4                        notlast=.false.
             628     4                     endif
             629     3                   ENDDO
             630     2               
             631     2               !
             632     2               !-- snow
             633     2               !
             634     2                   t_del_tv=0.
             635     2                   del_tv=dtb
             636     2                   notlast=.true.
             637     2               
             638     3                   DO while (notlast)
             639     3               !
             640     3                     min_q=kte
             641     3                     max_q=kts-1
             642     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qsz
                                   <<< Loop-information  End >>>
             643     4   s   2s            do k=kts,kte-1
             644     5   p   2v               if (qsz(k) .gt. 1.0e-8) then
             645     5   p   2v                  min_q=min0(min_q,k)
             646     5   p   2v                  max_q=max0(max_q,k)
             647     5   p   2v                  tmp1=sqrt(pi*rhosnow*xnos/rhoz(k)/qsz(k))
             648     5   p   2v                  tmp1=sqrt(tmp1)
             649     5   p   2v                  vts(k)=constc*gamdp4*sqrhoz(k)/tmp1**constd
             650     5   m   2m                  vts(k)=vts(k)/6.
             651     6   p   2v                  if (k .eq. 1) then
             652     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vts(k))
             653     6   m   2m                     del_tv=dmin1(del_tv,0.9*(zz(k)-topo(i,j))/vts(k))
             654     6   p   2v                  else
             655     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vts(k))
             656     6   m   2m                     del_tv=dmin1(del_tv,0.9*(zz(k)-zz(k-1))/vts(k))
             657     6   p   2v                  endif
             658     5   p   2v               else
             659     5   s   2m                  vts(k)=0.
             660     5   p   2v               endif
             661     4   p   2v            enddo
             662     3               
             663     4                     if (max_q .ge. min_q) then
             664     4               !
             665     4               !
             666     4               !- Check if the summation of the small delta t >=  big delta t
             667     4               !             (t_del_tv)          (del_tv)             (dtb)
             668     4               
             669     4                        t_del_tv=t_del_tv+del_tv
             670     4               
             671     5                        if ( t_del_tv .ge. dtb ) then
             672     5                             notlast=.false.
             673     5                             del_tv=dtb+del_tv-t_del_tv
             674     5                        endif
             675     4               
             676     4               ! use small delta t to calculate the qsz flux
             677     4               ! termi is the qsz flux pass in the grid box through the upper boundary
             678     4               ! termo is the qsz flux pass out the grid box through the lower boundary
             679     4               !
             680     4                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qsz, vts, dzw
                                   <<< Loop-information  End >>>
             681     5   s    s               do k=max_q,min_q,-1
             682     5   p    v                  fluxout=rhoz(k)*vts(k)*qsz(k)
             683     5   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             684     5   p    v                  qsz(k)=qsz(k)+del_tv*flux
             685     5               !            qsz(k)=amax1(0.,qsz(k))
             686     5   p    v                  qsz(k)=dmax1(0.,qsz(k))
             687     5   p    v                  qs(i,k,j)=qsz(k)
             688     5   s    s                  fluxin=fluxout
             689     5   p    v               enddo
             690     5                        if (min_q .eq. 1) then
             691     5                           pptsnow=pptsnow+fluxin*del_tv
             692     5                        else
             693     5                           qsz(min_q-1)=qsz(min_q-1)+del_tv*  &
             694     5                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
             695     5                           qs(i,min_q-1,j)=qsz(min_q-1)
             696     5                        endif
             697     4               !
             698     4                     else
             699     4                        notlast=.false.
             700     4                     endif
             701     3               
             702     3                   ENDDO
             703     2               
             704     2               !
             705     2               !   ice2=0 --- with hail/graupel
             706     2               !   ice2=1 --- without hail/graupel
             707     2               !
             708     3                 if (ice2.eq.0) then
             709     3               !
             710     3               !-- If IHAIL=1, use hail.
             711     3               !-- If IHAIL=0, use graupel.
             712     3               !
             713     3               !    if (ihail .eq. 1) then
             714     3               !       xnog = xnoh
             715     3               !       rhograul = rhohail
             716     3               !    endif
             717     3               
             718     3                   t_del_tv=0.
             719     3                   del_tv=dtb
             720     3                   notlast=.true.
             721     3               !
             722     4                   DO while (notlast)
             723     4               !
             724     4                     min_q=kte
             725     4                     max_q=kts-1
             726     4               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qgz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             727     5   s   2s            do k=kts,kte-1
             728     6   p   2v               if (qgz(k) .gt. 1.0e-8) then
             729     7   p   2v                  if (ihail .eq. 1) then
             730     7               !  for hail, based on Lin et al (1983)
             731     7       2                     min_q=min0(min_q,k)
             732     7       2                     max_q=max0(max_q,k)
             733     7       2                     tmp1=sqrt(pi*rhohail*xnoh/rhoz(k)/qgz(k))
             734     7       2                     tmp1=sqrt(tmp1)
             735     7       2                     term0=sqrt(4.*grav*rhohail/3./rhoz(k)/cdrag)
             736     7       2                     vtg(k)=gam4pt5*term0*sqrt(1./tmp1)
             737     7       2                     vtg(k)=vtg(k)/6.
             738     8       2                     if (k .eq. 1) then
             739     8               !                 del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtg(k))
             740     8       2                        del_tv=dmin1(del_tv,0.9*(zz(k)-topo(i,j))/vtg(k))
             741     8       2                     else
             742     8               !                 del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtg(k))
             743     8       2                        del_tv=dmin1(del_tv,0.9*(zz(k)-zz(k-1))/vtg(k))
             744     8       2                     endif !k
             745     7   p   2v                  else
             746     7               ! added by JJS
             747     7               ! for graupel, based on RH (1984)
             748     7   p   2v                    min_q=min0(min_q,k)
             749     7   p   2v                    max_q=max0(max_q,k)
             750     7   p   2v                    tmp1=sqrt(pi*rhograul*xnog/rhoz(k)/qgz(k))
             751     7   p   2v                    tmp1=sqrt(tmp1)
             752     7   p   2v                    tmp1=tmp1**bbar
             753     7   p   2v                    tmp1=1./tmp1
             754     7   p   2v                    term0=abar*gam4bbar/6.
             755     7   m   2m                    vtg(k)=term0*tmp1*(p0/prez(k))**0.4
             756     8   p   2v                    if (k .eq. 1) then
             757     8               !                 del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vtg(k))
             758     8   m   2m                       del_tv=dmin1(del_tv,0.9*(zz(k)-topo(i,j))/vtg(k))
             759     8   p   2v                    else
             760     8               !                 del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vtg(k))
             761     8   m   2m                       del_tv=dmin1(del_tv,0.9*(zz(k)-zz(k-1))/vtg(k))
             762     8   p   2v                    endif !k
             763     7   p   2v                  endif !ihail
             764     6   p   2v               else
             765     6   s   2m                  vtg(k)=0.
             766     6   p   2v               endif !qgz
             767     5   p   2v            enddo !k
             768     4               
             769     5                     if (max_q .ge. min_q) then
             770     5               !
             771     5               !
             772     5               !- Check if the summation of the small delta t >=  big delta t
             773     5               !             (t_del_tv)          (del_tv)             (dtb)
             774     5               
             775     5                        t_del_tv=t_del_tv+del_tv
             776     5               
             777     6                        if ( t_del_tv .ge. dtb ) then
             778     6                             notlast=.false.
             779     6                             del_tv=dtb+del_tv-t_del_tv
             780     6                        endif
             781     5               
             782     5               ! use small delta t to calculate the qgz flux
             783     5               ! termi is the qgz flux pass in the grid box through the upper boundary
             784     5               ! termo is the qgz flux pass out the grid box through the lower boundary
             785     5               !
             786     5                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qgz, vtg, dzw
                                   <<< Loop-information  End >>>
             787     6   s    s               do k=max_q,min_q,-1
             788     6   p    v                  fluxout=rhoz(k)*vtg(k)*qgz(k)
             789     6   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             790     6   p    v                  qgz(k)=qgz(k)+del_tv*flux
             791     6               !            qgz(k)=amax1(0.,qgz(k))
             792     6   p    v                  qgz(k)=dmax1(0.,qgz(k))
             793     6   p    v                  qg(i,k,j)=qgz(k)
             794     6   s    s                  fluxin=fluxout
             795     6   p    v               enddo
             796     6                        if (min_q .eq. 1) then
             797     6                           pptgraul=pptgraul+fluxin*del_tv
             798     6                        else
             799     6                           qgz(min_q-1)=qgz(min_q-1)+del_tv*  &
             800     6                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
             801     6                           qg(i,min_q-1,j)=qgz(min_q-1)
             802     6                        endif
             803     5               !
             804     5                     else
             805     5                        notlast=.false.
             806     5                     endif
             807     4               !
             808     4                   ENDDO
             809     3                ENDIF !ice2
             810     2               !
             811     2               !-- cloud ice  (03/21/02) follow Vaughan T.J. Phillips at GFDL
             812     2               !
             813     2               
             814     2                   t_del_tv=0.
             815     2                   del_tv=dtb
             816     2                   notlast=.true.
             817     2               !
             818     3                   DO while (notlast)
             819     3               !
             820     3                     min_q=kte
             821     3                     max_q=kts-1
             822     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qiz
                                   <<< Loop-information  End >>>
             823     4   s   2s            do k=kts,kte-1
             824     5   p   2v               if (qiz(k) .gt. 1.0e-8) then
             825     5   p   2v                  min_q=min0(min_q,k)
             826     5   p   2v                  max_q=max0(max_q,k)
             827     5               #ifdef vti_DM08
             828     5               !xb141 >>> Deng and Mace (2008, grl), which gives smaller fall speed than HD90 formula
             829     5                           tc = tt(i,k,j) - 273.16
             830     5                           vti(k) = (3. + log10(rhoz(k)*qiz(k))) * (tc*(aa*tc + bb)+cc) + dd*tc + ee
             831     5                           vti(k) = 0.01 * 0.9 * exp(log(10.)*vti(k))
             832     5               !xb141 <<<
             833     5               #else
             834     5   m   2m                  vti(k)= 3.29 * (rhoz(k)* qiz(k))** 0.16  ! Heymsfield and Donner
             835     5               #endif
             836     6   p   2v                  if (k .eq. 1) then
             837     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-topo(i,j))/vti(k))
             838     6   m   2m                     del_tv=dmin1(del_tv,0.9*(zz(k)-topo(i,j))/vti(k))
             839     6   p   2v                  else
             840     6               !               del_tv=amin1(del_tv,0.9*(zz(k)-zz(k-1))/vti(k))
             841     6   m   2m                     del_tv=dmin1(del_tv,0.9*(zz(k)-zz(k-1))/vti(k))
             842     6   p   2v                  endif
             843     5   p   2v               else
             844     5   s   2m                  vti(k)=0.
             845     5   p   2v               endif
             846     4   p   2v            enddo
             847     3               
             848     4                     if (max_q .ge. min_q) then
             849     4               !
             850     4               !
             851     4               !- Check if the summation of the small delta t >=  big delta t
             852     4               !             (t_del_tv)          (del_tv)             (dtb)
             853     4               
             854     4                        t_del_tv=t_del_tv+del_tv
             855     4               
             856     5                        if ( t_del_tv .ge. dtb ) then
             857     5                             notlast=.false.
             858     5                             del_tv=dtb+del_tv-t_del_tv
             859     5                        endif
             860     4               
             861     4               ! use small delta t to calculate the qiz flux
             862     4               ! termi is the qiz flux pass in the grid box through the upper boundary
             863     4               ! termo is the qiz flux pass out the grid box through the lower boundary
             864     4               !
             865     4               
             866     4                        fluxin=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 5, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rhoz, qiz, vti, dzw
                                   <<< Loop-information  End >>>
             867     5   s    s               do k=max_q,min_q,-1
             868     5   p    v                  fluxout=rhoz(k)*vti(k)*qiz(k)
             869     5   m    m                  flux=(fluxin-fluxout)/rhoz(k)/dzw(k)
             870     5   p    v                  qiz(k)=qiz(k)+del_tv*flux
             871     5               !            qiz(k)=amax1(0.,qiz(k))
             872     5   p    v                  qiz(k)=dmax1(0.,qiz(k))
             873     5   p    v                  qi(i,k,j)=qiz(k)
             874     5   s    s                  fluxin=fluxout
             875     5   p    v               enddo
             876     5                        if (min_q .eq. 1) then
             877     5                           pptice=pptice+fluxin*del_tv
             878     5                        else
             879     5                           qiz(min_q-1)=qiz(min_q-1)+del_tv*  &
             880     5                                        fluxin/rhoz(min_q-1)/dzw(min_q-1)
             881     5                           qi(i,min_q-1,j)=qiz(min_q-1)
             882     5                        endif
             883     4               !
             884     4                     else
             885     4                        notlast=.false.
             886     4                     endif
             887     3               !
             888     3                  ENDDO !notlast
             889     2               
             890     2               !   prnc(i,j)=prnc(i,j)+pptrain
             891     2               !   psnowc(i,j)=psnowc(i,j)+pptsnow
             892     2               !   pgrauc(i,j)=pgrauc(i,j)+pptgraul
             893     2               !   picec(i,j)=picec(i,j)+pptice
             894     2               !
             895     2               
             896     2               !   write(6,*) 'i=',i,' j=',j,'   ', pptrain, pptsnow, pptgraul, pptice
             897     2               !   flush(6)
             898     2               
             899     2                  snowncv(i,j) = pptsnow
             900     2                  snownc(i,j) = snownc(i,j) + pptsnow
             901     2                  graupelncv(i,j) = pptgraul
             902     2                  graupelnc(i,j) = graupelnc(i,j) + pptgraul
             903     2                  RAINNCV(i,j) = pptrain + pptsnow + pptgraul + pptice
             904     2                  RAINNC(i,j)  = RAINNC(i,j) + pptrain + pptsnow + pptgraul + pptice
             905     2                  sr(i,j) = 0.
             906     2                  if (RAINNCV(i,j) .gt. 0.) sr(i,j) = (pptsnow + pptgraul + pptice) / RAINNCV(i,j)
             907     2               
             908     2                 ENDDO i_loop
             909     1                 ENDDO j_loop
             910                     
             911                     !  if (itimestep.eq.6480) then
             912                     !     write(51,*) 'in the end of fallflux, itimestep=',itimestep
             913                     !     do j=jts,jte
             914                     !        do i=its,ite
             915                     !           if (rainnc(i,j).gt.400.) then
             916                     !              write(50,*) 'i=',i,' j=',j,' rainnc=',rainnc
             917                     !           endif
             918                     !        enddo
             919                     !     enddo
             920                     !  endif
             921                     
             922                       END SUBROUTINE fall_flux
             923                     
             924                     !----------------------------------------------------------------
             925                        REAL FUNCTION ggamma(X)
             926                     !----------------------------------------------------------------
             927                        IMPLICIT NONE
             928                     !----------------------------------------------------------------
             929                           REAL, INTENT(IN   ) :: x
             930                           REAL, DIMENSION(8)  :: B
             931                           INTEGER             ::j, K1
             932                           REAL                ::PF, G1TO2 ,TEMP
             933                     
             934                           DATA B/-.577191652,.988205891,-.897056937,.918206857,  &
             935                                  -.756704078,.482199394,-.193527818,.035868343/
             936                     
             937                           PF=1.
             938                           TEMP=X
             939     1                     DO 10 J=1,200
             940     1                     IF (TEMP .LE. 2) GO TO 20
             941     1                     TEMP=TEMP-1.
             942     1                  10 PF=PF*TEMP
             943                       100 FORMAT(//,5X,'module_gsfcgce: INPUT TO GAMMA FUNCTION TOO LARGE, X=',E12.5)
             944                     !      WRITE(wrf_err_message,100)X
             945                     !      CALL wrf_error_fatal(wrf_err_message)
             946                        20 G1TO2=1.
             947                           TEMP=TEMP - 1.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             948     1   s    v            DO 30 K1=1,8
             949     1   p    v         30 G1TO2=G1TO2 + B(K1)*TEMP**K1
             950                           ggamma=PF*G1TO2
             951                     
             952                           END FUNCTION ggamma
             953                     
             954                     !-----------------------------------------------------------------------
             955                     !c Correction of negative values
             956                        SUBROUTINE negcor ( X, rho, dz8w,                         &
             957                                           ims,ime, jms,jme, kms,kme,              & ! memory dims
             958                                           itimestep, ics,                         &
             959                                           its,ite, jts,jte, kts,kte               ) ! tile   dims
             960                     !-----------------------------------------------------------------------
             961                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
             962                             INTENT(INOUT) ::                                     X
             963                       REAL, DIMENSION( ims:ime , kms:kme , jms:jme ),                 &
             964                             INTENT(IN   ) ::                              rho, dz8w
             965                       integer, INTENT(IN   ) ::                           itimestep, ics
             966                     
             967                     !c Local variables
             968                     !  REAL, DIMENSION( kts:kte ) ::  Y1, Y2
             969                       REAL   ::   A0, A1, A2
             970                     
             971                       A1=0.
             972                       A2=0.
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<< Loop-information  End >>>
             973     1                 do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             974     2                    do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             975     3  pp    v              do i=its,ite
             976     3   p    v              A1=A1+max(X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
             977     3   p    v              A2=A2+max(-X(i,k,j), 0.)*rho(i,k,j)*dz8w(i,k,j)
             978     3   p    v              enddo
             979     2                    enddo
             980     1                 enddo
             981                     
             982                     !  A1=0.0
             983                     !  A2=0.0
             984                     !  do k=kts,kte
             985                     !     A1=A1+Y1(k)
             986                     !     A2=A2+Y2(k)
             987                     !  enddo
             988                     
             989                       A0=0.0
             990                     
             991     1                 if (A1.NE.0.0.and.A1.GT.A2) then
             992     1                    A0=(A1-A2)/A1
             993     1               
             994     2                 if (mod(itimestep,540).eq.0) then
             995     3                    if (ics.eq.1) then
             996     3                       write(61,*) 'kms=',kms,'  kme=',kme,'  kts=',kts,'  kte=',kte
             997     3                       write(61,*) 'jms=',jms,'  jme=',jme,'  jts=',jts,'  jte=',jte
             998     3                       write(61,*) 'ims=',ims,'  ime=',ime,'  its=',its,'  ite=',ite
             999     3                    endif
            1000     3                    if (ics.eq.1) then
            1001     3                        write(61,*) 'qv timestep=',itimestep
            1002     3                        write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1003     3                    else if (ics.eq.2) then
            1004     3                            write(61,*) 'ql timestep=',itimestep
            1005     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1006     3                    else if (ics.eq.3) then
            1007     3                            write(61,*) 'qr timestep=',itimestep
            1008     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1009     3                    else if (ics.eq.4) then
            1010     3                            write(61,*) 'qi timestep=',itimestep
            1011     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1012     3                    else if (ics.eq.5) then
            1013     3                            write(61,*) 'qs timestep=',itimestep
            1014     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1015     3                    else if (ics.eq.6) then
            1016     3                            write(61,*) 'qg timestep=',itimestep
            1017     3                            write(61,*) '  A1=',A1,'   A2=',A2,'   A0=',A0
            1018     3                    else
            1019     3                            write(61,*) 'wrong cloud specieis number'
            1020     3                    endif
            1021     2                 endif
            1022     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
            1023     2   p                do k=kts,kte
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
            1024     3  pp                   do j=jts,jte
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 224, MVE: 8, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      X
                                   <<< Loop-information  End >>>
            1025     4   p   2v                 do i=its,ite
            1026     4               !           X(i,k,j)=A0*AMAX1(X(i,k,j), 0.0)
            1027     4   p   2v                 X(i,k,j)=A0*DMAX1(X(i,k,j), 0.0)
            1028     4   p   2v                 enddo
            1029     3   p                   enddo
            1030     2   p                enddo
            1031     1                 endif
            1032                     
            1033                       END SUBROUTINE negcor
            1034                     
            1035                      SUBROUTINE consat_s (ihail,itaobraun)
            1036                     
            1037                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1038                     !                                                                      c
            1039                     !   Tao, W.-K., and J. Simpson, 1989: Modeling study of a tropical     c
            1040                     !   squall-type convective line. J. Atmos. Sci., 46, 177-202.          c
            1041                     !                                                                      c
            1042                     !   Tao, W.-K., J. Simpson and M. McCumber, 1989: An ice-water         c
            1043                     !   saturation adjustment. Mon. Wea. Rev., 117, 231-235.               c
            1044                     !                                                                      c
            1045                     !   Tao, W.-K., and J. Simpson, 1993: The Goddard Cumulus Ensemble     c
            1046                     !   Model. Part I: Model description. Terrestrial, Atmospheric and     c
            1047                     !   Oceanic Sciences, 4, 35-72.                                        c
            1048                     !                                                                      c
            1049                     !   Tao, W.-K., J. Simpson, D. Baker, S. Braun, M.-D. Chou, B.         c
            1050                     !   Ferrier,D. Johnson, A. Khain, S. Lang,  B. Lynn, C.-L. Shie,       c
            1051                     !   D. Starr, C.-H. Sui, Y. Wang and P. Wetzel, 2003: Microphysics,    c
            1052                     !   radiation and surface processes in the Goddard Cumulus Ensemble    c
            1053                     !   (GCE) model, A Special Issue on Non-hydrostatic Mesoscale          c
            1054                     !   Modeling, Meteorology and Atmospheric Physics, 82, 97-137.         c
            1055                     !                                                                      c
            1056                     !   Lang, S., W.-K. Tao, R. Cifelli, W. Olson, J. Halverson, S.        c
            1057                     !   Rutledge, and J. Simpson, 2007: Improving simulations of           c
            1058                     !   convective system from TRMM LBA: Easterly and Westerly regimes.    c
            1059                     !   J. Atmos. Sci., 64, 1141-1164.                                     c
            1060                     !                                                                      c
            1061                     !   Coded by Tao (1989-2003), modified by S. Lang (2006/07)            c
            1062                     !                                                                      c
            1063                     !   Implemented into WRF  by Roger Shi 2006/2007                       c
            1064                     !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1065                     
            1066                     !        itaobraun=0   ! see Tao and Simpson (1993)
            1067                     !        itaobraun=1   ! see Tao et al. (2003)
            1068                     
            1069                      integer :: itaobraun
            1070                      real    :: cn0
            1071                     
            1072                     !JJS 1/3/2008  vvvvv
            1073                     !JJS   the following common blocks have been moved to the top of
            1074                     !JJS   module_mp_gsfcgce_driver_instat.F
            1075                     !
            1076                     ! real,   dimension (1:31) ::  a1, a2
            1077                     ! data a1/.7939e-7,.7841e-6,.3369e-5,.4336e-5,.5285e-5,.3728e-5, &
            1078                     !         .1852e-5,.2991e-6,.4248e-6,.7434e-6,.1812e-5,.4394e-5,.9145e-5, &
            1079                     !         .1725e-4,.3348e-4,.1725e-4,.9175e-5,.4412e-5,.2252e-5,.9115e-6, &
            1080                     !         .4876e-6,.3473e-6,.4758e-6,.6306e-6,.8573e-6,.7868e-6,.7192e-6, &
            1081                     !         .6513e-6,.5956e-6,.5333e-6,.4834e-6/
            1082                     ! data a2/.4006,.4831,.5320,.5307,.5319,.5249,.4888,.3894,.4047, &
            1083                     !         .4318,.4771,.5183,.5463,.5651,.5813,.5655,.5478,.5203,.4906, &
            1084                     !         .4447,.4126,.3960,.4149,.4320,.4506,.4483,.4460,.4433,.4413, &
            1085                     !         .4382,.4361/
            1086                     !JJS 1/3/2008  ^^^^^
            1087                     
            1088                     
            1089                     !     ******************************************************************
            1090                     !JJS
            1091                           al = 2.5e10
            1092                           cp = 1.004e7
            1093                           rd1 = 1.e-3
            1094                           rd2 = 2.2
            1095                     !JJS
            1096                           cpi=4.*atan(1.)
            1097                           cpi2=cpi*cpi
            1098                           grvt=980.
            1099                           cd1=6.e-1
            1100                           cd2=4.*grvt/(3.*cd1)
            1101                           tca=2.43e3
            1102                           dwv=.226
            1103                           dva=1.718e-4
            1104                           amw=18.016
            1105                           ars=8.314e7
            1106                           scv=2.2904487
            1107                           t0=273.16
            1108                           t00=238.16
            1109                           alv=2.5e10
            1110                           alf=3.336e9
            1111                           als=2.8336e10
            1112                           avc=alv/cp
            1113                           afc=alf/cp
            1114                           asc=als/cp
            1115                           rw=4.615e6
            1116                           cw=4.187e7
            1117                           ci=2.093e7
            1118                           c76=7.66
            1119                           c358=35.86
            1120                           c172=17.26939
            1121                           c409=4098.026
            1122                           c218=21.87456
            1123                           c580=5807.695
            1124                           c610=6.1078e3
            1125                           c149=1.496286e-5
            1126                           c879=8.794142
            1127                           c141=1.4144354e7
            1128                     !***   DEFINE THE COEFFICIENTS USED IN TERMINAL VELOCITY
            1129                     !***   DEFINE THE DENSITY AND SIZE DISTRIBUTION OF PRECIPITATION
            1130                     !**********   HAIL OR GRAUPEL PARAMETERS   **********
            1131     1                     if(ihail .eq. 1) then
            1132     1                        roqg=.9
            1133     1                        ag=sqrt(cd2*roqg)
            1134     1                        bg=.5
            1135     1                        tng=.002
            1136     1                     else
            1137     1                        roqg=.4
            1138     1                        ag=351.2
            1139     1               !        AG=372.3 ! if ice913=1 6/15/02 tao's
            1140     1                        bg=.37
            1141     1                        tng=.04
            1142     1                     endif
            1143                     !**********         SNOW PARAMETERS        **********
            1144                     !ccshie 6/15/02 tao's
            1145                     !      TNS=1.
            1146                     !      TNS=.08 ! if ice913=1, tao's
            1147                           tns=.16 ! if ice913=0, tao's
            1148                           roqs=.1
            1149                     !      AS=152.93
            1150                           as=78.63
            1151                     !      BS=.25
            1152                           bs=.11
            1153                     !**********         RAIN PARAMETERS        **********
            1154                           aw=2115.
            1155                           bw=.8
            1156                           roqr=1.
            1157                           tnw=.08
            1158                     !*****************************************************************
            1159                           bgh=.5*bg
            1160                           bsh=.5*bs
            1161                           bwh=.5*bw
            1162                           bgq=.25*bg
            1163                           bsq=.25*bs
            1164                           bwq=.25*bw
            1165                     !**********GAMMA FUNCTION CALCULATIONS*************
            1166                           ga3b  = gammagce(3.+bw)
            1167                           ga4b  = gammagce(4.+bw)
            1168                           ga6b  = gammagce(6.+bw)
            1169                           ga5bh = gammagce((5.+bw)/2.)
            1170                           ga3g  = gammagce(3.+bg)
            1171                           ga4g  = gammagce(4.+bg)
            1172                           ga5gh = gammagce((5.+bg)/2.)
            1173                           ga3d  = gammagce(3.+bs)
            1174                           ga4d  = gammagce(4.+bs)
            1175                           ga5dh = gammagce((5.+bs)/2.)
            1176                     !CCCCC        LIN ET AL., 1983 OR LORD ET AL., 1984   CCCCCCCCCCCCCCCCC
            1177                           ac1=aw
            1178                     !JJS
            1179                           ac2=ag
            1180                           ac3=as
            1181                     !JJS
            1182                           bc1=bw
            1183                           cc1=as
            1184                           dc1=bs
            1185                           zrc=(cpi*roqr*tnw)**0.25
            1186                           zsc=(cpi*roqs*tns)**0.25
            1187                           zgc=(cpi*roqg*tng)**0.25
            1188                           vrc=aw*ga4b/(6.*zrc**bw)
            1189                           vsc=as*ga4d/(6.*zsc**bs)
            1190                           vgc=ag*ga4g/(6.*zgc**bg)
            1191                     !     ****************************
            1192                     !     RN1=1.E-3
            1193                           rn1=9.4e-15 ! 6/15/02 tao's
            1194                           bnd1=6.e-4
            1195                           rn2=1.e-3
            1196                     !     BND2=1.25E-3
            1197                     !     BND2=1.5E-3 ! if ice913=1 6/15/02 tao's
            1198                           bnd2=2.0e-3 ! if ice913=0 6/15/02 tao's
            1199                           rn3=.25*cpi*tns*cc1*ga3d
            1200                           esw=1.
            1201                           rn4=.25*cpi*esw*tns*cc1*ga3d
            1202                     !     ERI=1.
            1203                           eri=.1  ! 6/17/02 tao's ice913=0 (not 1)
            1204                           rn5=.25*cpi*eri*tnw*ac1*ga3b
            1205                     !     AMI=1./(24.*4.19E-10)
            1206                           ami=1./(24.*6.e-9) ! 6/15/02 tao's
            1207                           rn6=cpi2*eri*tnw*ac1*roqr*ga6b*ami
            1208                     !     ESR=1. ! also if ice913=1 for tao's
            1209                           esr=.5 ! 6/15/02 for ice913=0 tao's
            1210                           rn7=cpi2*esr*tnw*tns*roqs
            1211                           esr=1.
            1212                           rn8=cpi2*esr*tnw*tns*roqr
            1213                           rn9=cpi2*tns*tng*roqs
            1214                           rn10=2.*cpi*tns
            1215                           rn101=.31*ga5dh*sqrt(cc1)
            1216                           rn10a=als*als/rw
            1217                     !JJS
            1218                            rn10b=alv/tca
            1219                            rn10c=ars/(dwv*amw)
            1220                     !JJS
            1221                           rn11=2.*cpi*tns/alf
            1222                           rn11a=cw/alf
            1223                     !     AMI50=1.51e-7
            1224                           ami50=3.84e-6 ! 6/15/02 tao's
            1225                     !     AMI40=2.41e-8
            1226                           ami40=3.08e-8 ! 6/15/02 tao's
            1227                           eiw=1.
            1228                     !     UI50=20.
            1229                           ui50=100. ! 6/15/02 tao's
            1230                           ri50=2.*5.e-3
            1231                           cmn=1.05e-15
            1232                           rn12=cpi*eiw*ui50*ri50**2
            1233                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 12
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      aa2, aa1, rn25a, rn12b, rn13, rn12a
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 4  FILL 12
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1234     1  pp    v            do 10 k=1,31
            1235     1   p    v               y1=1.-aa2(k)
            1236     1   p    v               rn13(k)=aa1(k)*y1/(ami50**y1-ami40**y1)
            1237     1   p    v               rn12a(k)=rn13(k)/ami50
            1238     1   p    v               rn12b(k)=aa1(k)*ami50**aa2(k)
            1239     1   p    v               rn25a(k)=aa1(k)*cmn**aa2(k)
            1240     1   p    v         10 continue
            1241                     
            1242                           egw=1.
            1243                           rn14=.25*cpi*egw*tng*ga3g*ag
            1244                           egi=.1
            1245                           rn15=.25*cpi*egi*tng*ga3g*ag
            1246                           egi=1.
            1247                           rn15a=.25*cpi*egi*tng*ga3g*ag
            1248                           egr=1.
            1249                           rn16=cpi2*egr*tng*tnw*roqr
            1250                           rn17=2.*cpi*tng
            1251                           rn17a=.31*ga5gh*sqrt(ag)
            1252                           rn17b=cw-ci
            1253                           rn17c=cw
            1254                           apri=.66
            1255                           bpri=1.e-4
            1256                           bpri=0.5*bpri ! 6/17/02 tao's
            1257                           rn18=20.*cpi2*bpri*tnw*roqr
            1258                           rn18a=apri
            1259                           rn19=2.*cpi*tng/alf
            1260                           rn19a=.31*ga5gh*sqrt(ag)
            1261                           rn19b=cw/alf
            1262                     !
            1263                            rnn191=.78
            1264                            rnn192=.31*ga5gh*sqrt(ac2/dva)
            1265                     !
            1266                           rn20=2.*cpi*tng
            1267                           rn20a=als*als/rw
            1268                           rn20b=.31*ga5gh*sqrt(ag)
            1269                           bnd3=2.e-3
            1270                           rn21=1.e3*1.569e-12/0.15
            1271                           erw=1.
            1272                           rn22=.25*cpi*erw*ac1*tnw*ga3b
            1273                           rn23=2.*cpi*tnw
            1274                           rn23a=.31*ga5bh*sqrt(ac1)
            1275                           rn23b=alv*alv/rw
            1276                     
            1277                     
            1278                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1279                     !cc
            1280                     !cc        "c0" in routine      "consat" (2d), "consatrh" (3d)
            1281                     !cc        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
            1282                     !cc        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
            1283                     
            1284     1                      if (itaobraun .eq. 0) then
            1285     1                        cn0=1.e-8
            1286     1                        beta=-.6
            1287     1                      elseif (itaobraun .eq. 1) then
            1288     1                        cn0=1.e-6
            1289     1                        beta=-.46
            1290     1                      endif
            1291                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            1292                     !      CN0=1.E-6
            1293                     !      CN0=1.E-8 ! 6/15/02 tao's
            1294                     !      BETA=-.46
            1295                     !      BETA=-.6  ! 6/15/02 tao's
            1296                     
            1297                           rn25=cn0
            1298                           rn30a=alv*als*amw/(tca*ars)
            1299                           rn30b=alv/tca
            1300                           rn30c=ars/(dwv*amw)
            1301                           rn31=1.e-17
            1302                     
            1303                           rn32=4.*51.545e-4
            1304                     !
            1305                           rn30=2.*cpi*tng
            1306                           rnn30a=alv*alv*amw/(tca*ars)
            1307                     !
            1308                           rn33=4.*tns
            1309                            rn331=.65
            1310                            rn332=.44*sqrt(ac3/dva)*ga5dh
            1311                     !
            1312                     
            1313                         return
            1314                      END SUBROUTINE consat_s

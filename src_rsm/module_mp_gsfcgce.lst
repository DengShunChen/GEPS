            3268     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            3269     4                                   inclusionstring_g, hoststring_g,                    &
            3270     4                                   hostmatrixstring_g, hostinclusionstring_g)
            3271     4                             f_d = N0_g(k)*xxDg(n)**xmu_g * DEXP(-lamg*xxDg(n))
            3272     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)

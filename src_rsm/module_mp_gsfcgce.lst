            3355                     !JJS 20140225
            3356                     ! Calculate cloud droplet effective radius
            3357                        real function eff_rad(lambda)
            3358                     
            3359                     !#ifndef NO_IEEE_MODULE
            3360                     !      use, intrinsic :: ieee_arithmetic
            3361                     !#endif
            3362                           implicit none
            3363                     
            3364                     !---------------------------------------------------------------------------------------------------
            3365                     ! Comments:
            3366                     ! Compute drop effective radius from slope parameters (lambda) of expoential size distribution.
            3367                     !
            3368                     ! History:
            3369                     ! 02/2014  Toshi Matsui@NASA GSFC ; Initial
            3370                     !
            3371                     ! References:
            3372                     !----------------------------------------------------------------------------------------------------
            3373                           real,intent(in)  :: lambda   ! intercept parameter [1/cm]
            3374                     
            3375                     !
            3376                     ! for no particles.
            3377                     !
            3378                     !#ifndef NO_IEEE_MODULE
            3379                     !       if ( lambda <= 0.e0  .or. ieee_is_nan(lambda) ) then
            3380                     !#else
            3381     1                      if ( lambda <= 0.e0                           ) then
            3382     1               !#endif
            3383     1                         eff_rad = 0.e0
            3384     1                         return
            3385     1                      endif
            3386                     
            3387                     !
            3388                     ! compute drop effective radius for exponential distribution N(D) = N0*exp(-lam*D)
            3389                     !
            3390                            eff_rad = 1.5e0 / (lambda*100.) * 1.0e+6  ! [micron]
            3391                     
            3392                        end function eff_rad
            3393                     !+---+-----------------------------------------------------------------+
            3394                     #endif

            3080                     !JJS      REAL FUNCTION GAMMA(X)
            3081                     !JJS        Y=GAMMLN(X)
            3082                     !JJS        GAMMA=EXP(Y)
            3083                     !JJS      RETURN
            3084                     !JJS      END
            3085                     !cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            3086                     !JJS      real function GAMMLN (xx)
            3087                       real function gammagce (xx)
            3088                     !**********************************************************************
            3089                       real*8 cof(6),stp,half,one,fpf,x,tmp,ser
            3090                       data cof,stp /  76.18009173,-86.50532033,24.01409822, &
            3091                          -1.231739516,.120858003e-2,-.536382e-5, 2.50662827465 /
            3092                       data half,one,fpf / .5, 1., 5.5 /
            3093                     !
            3094                           x=xx-one
            3095                           tmp=x+fpf
            3096                           tmp=(x+half)*log(tmp)-tmp
            3097                           ser=one
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3098     1   s   fs            do  j=1,6
            3099     1   s   fs               x=x+one
            3100     1   m   fm              ser=ser+cof(j)/x
            3101     1   p   fv            enddo !j
            3102                           gammln=tmp+log(stp*ser)
            3103                     !JJS
            3104                           gammagce=exp(gammln)
            3105                     !JJS
            3106                           return
            3107                      END FUNCTION gammagce

            1876     4   p    s          IF (IWARM .EQ. 1) THEN
            1877     4               !JJS   for calculating processes related to warm rain only
            1878     4   p    s                      qi(i,j)=0.0
            1879     4   p    s                      qs(i,j)=0.0
            1880     4   p    s                      qg(i,j)=0.0
            1881     4   p    s                      dep(i,j)=0.
            1882     4   p    s                      pint(i,j)=0.
            1883     4   p    s                      psdep(i,j)=0.
            1884     4   p    s                      pgdep(i,j)=0.
            1885     4   p    s                      dd1(i,j)=0.
            1886     4   p    s                      pgsub(i,j)=0.
            1887     4   p    s                      psmlt(i,j)=0.
            1888     4   p    s                      pgmlt(i,j)=0.
            1889     4   p    s                      pimlt(i,j)=0.
            1890     4   p    s                      psacw(i,j)=0.
            1891     4   p    s                      piacr(i,j)=0.
            1892     4   p    s                      psfw(i,j)=0.
            1893     4   p    s                      pgfr(i,j)=0.
            1894     4   p    s                      dgacw(i,j)=0.
            1895     4   p    s                      dgacr(i,j)=0.
            1896     4   p    s                      psacr(i,j)=0.
            1897     4   p    s                      wgacr(i,j)=0.
            1898     4   p    s                      pihom(i,j)=0.
            1899     4   p    s                      pidw(i,j)=0.
            1900     4               
            1901     5   p    s                      if (qr(i,j) .gt. cmin1) then
            1902     5   p    s                         dd(i,j)=r00*qr(i,j)
            1903     5   p    s                         y1(i,j)=dd(i,j)**.25
            1904     5   s    s                         zr(i,j)=zrc/y1(i,j)
            1905     5   m    s                         vr(i,j)=max(vrcf*dd(i,j)**bwq, 0.)
            1906     5   p    s                      endif
            1907     4               
            1908     4               !* 21 * PRAUT   AUTOCONVERSION OF QC TO QR                        **21**
            1909     4               !* 22 * PRACW : ACCRETION OF QC BY QR                             **22**
            1910     4   p    s                      pracw(i,j)=0.
            1911     4   p    s                      praut(i,j)=0.0
            1912     4   m    s                      pracw(i,j)=r22f*qc(i,j)/zr(i,j)**bw3
            1913     4   s    s                      y1(i,j)=qc(i,j)-bnd3
            1914     5   s    s                      if (y1(i,j).gt.0.0) then
            1915     5   s    s                          praut(i,j)=r00*y1(i,j)*y1(i,j)/(1.2e-4+rn21/y1(i,j))
            1916     5   p    s                       endif
            1917     4               
            1918     4               !C********   HANDLING THE NEGATIVE CLOUD WATER (QC)    ******************
            1919     4   p    s                       Y1(I,J)=QC(I,J)/D2T
            1920     4   s    s                       PRAUT(I,J)=MIN(Y1(I,J), PRAUT(I,J))
            1921     4   s    s                       PRACW(I,J)=MIN(Y1(I,J), PRACW(I,J))
            1922     4   s    s                       Y1(I,J)=(PRAUT(I,J)+PRACW(I,J))*D2T
            1923     4               
            1924     5   s    s                     if (qc(i,j) .lt. y1(i,j) .and. y1(i,j) .ge. cmin2) then
            1925     5   s    s                         y2(i,j)=qc(i,j)/(y1(i,j)+cmin2)
            1926     5   s    s                         praut(i,j)=praut(i,j)*y2(i,j)
            1927     5   s    s                         pracw(i,j)=pracw(i,j)*y2(i,j)
            1928     5   m    s                         qc(i,j)=0.0
            1929     5   s    s                     else
            1930     5   m    s                        qc(i,j)=qc(i,j)-y1(i,j)
            1931     5   p    s                     endif
            1932     4               
            1933     4   s    s                     PR(I,J)=(PRAUT(I,J)+PRACW(I,J))*D2T
            1934     4   s    s                     QR(I,J)=QR(I,J)+PR(I,J)
            1935     4               
            1936     4               !*****   TAO ET AL (1989) SATURATION TECHNIQUE  ***********************
            1937     4               
            1938     4   p    s                 cnd(i,j)=0.0
            1939     4   p    s                 tair(i,j)=(pt(i,j)+tb0)*pi0
            1940     4   s    s                    y1(i,j)=1./(tair(i,j)-c358)
            1941     4   s    s                    qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            1942     4   s    s                    dd(i,j)=cp409*y1(i,j)*y1(i,j)
            1943     4   s    s                    dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            1944     4   s    s                    cnd(i,j)=dm(i,j)/(1.+avcp*dd(i,j)*qsw(i,j))
            1945     4               !c    ******   condensation or evaporation of qc  ******
            1946     4   s    s                    cnd(i,j)=max(-qc(i,j), cnd(i,j))
            1947     4   s    s                               pt(i,j)=pt(i,j)+avcp*cnd(i,j)
            1948     4   s    s                   qv(i,j)=qv(i,j)-cnd(i,j)
            1949     4   s    s                               qc(i,j)=qc(i,j)+cnd(i,j)
            1950     4               
            1951     4               !C     ******   EVAPORATION   ******
            1952     4               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            1953     4   p    s                  ern(i,j)=0.0
            1954     4               
            1955     5   s    s                  if(qr(i,j).gt.0.0) then
            1956     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            1957     5   s    s                     rtair(i,j)=1./(tair(i,j)-c358)
            1958     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*rtair(i,j))
            1959     5   s    s                     ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.0
            1960     5   s    s                     dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            1961     5   s    s                     rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            1962     5   s    s                     dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)), 0.0)
            1963     5   s    s                     y1(i,j)=.78/zr(i,j)**2+r23af*scv(i,j)/zr(i,j)**bwh5
            1964     5   s    s                     y2(i,j)=r23br/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            1965     5                                      *qsw(i,j))
            1966     5               !cccc
            1967     5   s    s                     ern(i,j)=r23t*ssw(i,j)*y1(i,j)/y2(i,j)
            1968     5   s    s                     ern(i,j)=min(dd1(i,j),qr(i,j),max(ern(i,j),0.))
            1969     5   p    s                     pt(i,j)=pt(i,j)-avcp*ern(i,j)
            1970     5   p    s                     qv(i,j)=qv(i,j)+ern(i,j)
            1971     5   s    s                     qr(i,j)=qr(i,j)-ern(i,j)
            1972     5   p    s                  endif
            1973     4               
            1974     4   p    s             ELSE       ! part of if (iwarm.eq.1) then
            1975     4               !JJS 10/7/2008     ^^^^^
            1976     4               
            1977     4               !JJS   for calculating processes related to both ice and warm rain
            1978     4               
            1979     4               !     ***   COMPUTE ZR,ZS,ZG,VR,VS,VG      *****************************
            1980     4               
            1981     5   p    s                  if (qr(i,j) .gt. cmin1) then
            1982     5   p    s                     dd(i,j)=r00*qr(i,j)
            1983     5   p    s                     y1(i,j)=dd(i,j)**.25
            1984     5   s    s                     zr(i,j)=zrc/y1(i,j)
            1985     5   s    s                     vr(i,j)=max(vrcf*dd(i,j)**bwq, 0.)
            1986     5   p    s                  endif
            1987     4               
            1988     5   p    s                  if (qs(i,j) .gt. cmin1) then
            1989     5   p    s                     dd(i,j)=r00*qs(i,j)
            1990     5   p    s                     y1(i,j)=dd(i,j)**.25
            1991     5   s    s                     zs(i,j)=zsc/y1(i,j)
            1992     5   s    s                     vs(i,j)=max(vscf*dd(i,j)**bsq, 0.)
            1993     5   p    s                  endif
            1994     4               
            1995     5   p    s                  if (qg(i,j) .gt. cmin1) then
            1996     5   p    s                     dd(i,j)=r00*qg(i,j)
            1997     5   p    s                     y1(i,j)=dd(i,j)**.25
            1998     5   s    s                     zg(i,j)=zgc/y1(i,j)
            1999     6   p    s                     if(ihail .eq. 1) then
            2000     6   m    m                        vg(i,j)=max(vgcr*dd(i,j)**bgq, 0.)
            2001     6   p    s                     else
            2002     6   m    s                        vg(i,j)=max(vgcf*dd(i,j)**bgq, 0.)
            2003     6   p    s                     endif
            2004     5   p    s                  endif
            2005     4               
            2006     4   p    s                  if (qr(i,j) .le. cmin2) vr(i,j)=0.0
            2007     4   p    s                  if (qs(i,j) .le. cmin2) vs(i,j)=0.0
            2008     4   p    s                  if (qg(i,j) .le. cmin2) vg(i,j)=0.0
            2009     4               
            2010     4               !     ******************************************************************
            2011     4               !     ***   Y1 : DYNAMIC VISCOSITY OF AIR (U)
            2012     4               !     ***   DWV : DIFFUSIVITY OF WATER VAPOR IN AIR (PI)
            2013     4               !     ***   TCA : THERMAL CONDUCTIVITY OF AIR (KA)
            2014     4               !     ***   Y2 : KINETIC VISCOSITY (V)
            2015     4               
            2016     4   m    s                  y1(i,j)=c149*tair(i,j)**1.5/(tair(i,j)+120.)
            2017     4   m    s                  dwv(i,j)=dwvp*tair(i,j)**1.81
            2018     4   s    s                  tca(i,j)=c141*y1(i,j)
            2019     4   s    s                  scv(i,j)=1./((rr0*y1(i,j))**.1666667*dwv(i,j)**.3333333)
            2020     4               !JJS  100    CONTINUE
            2021     4               
            2022     4               !*  1 * PSAUT : AUTOCONVERSION OF QI TO QS                        ***1**
            2023     4               !*  3 * PSACI : ACCRETION OF QI TO QS                             ***3**
            2024     4               !*  4 * PSACW : ACCRETION OF QC BY QS (RIMING) (QSACW FOR PSMLT)  ***4**
            2025     4               !*  5 * PRACI : ACCRETION OF QI BY QR                             ***5**
            2026     4               !*  6 * PIACR : ACCRETION OF QR OR QG BY QI                       ***6**
            2027     4               
            2028     4               !JJS         DO 125 J=3,JLES
            2029     4               !JJS         DO 125 I=3,ILES
            2030     4   p    s                  psaut(i,j)=0.0
            2031     4   p    s                  psaci(i,j)=0.0
            2032     4   p    s                  praci(i,j)=0.0
            2033     4   p    s                  piacr(i,j)=0.0
            2034     4   p    s                  psacw(i,j)=0.0
            2035     4   p    s                  qsacw(i,j)=0.0
            2036     4   s    s                  dd(i,j)=1./zs(i,j)**bs3
            2037     4               
            2038     5   m    s                  if (tair(i,j).lt.t0) then
            2039     5   s    s                     esi(i,j)=exp(.025*tairc(i,j))
            2040     5   s    s                     psaut(i,j)=r2is*max(rn1*esi(i,j)*(qi(i,j)-bnd1) ,0.0)
            2041     5   s    s                     psaci(i,j)=r2is*r3f*esi(i,j)*qi(i,j)*dd(i,j)
            2042     5               !JJS 3/30/06
            2043     5               !    to cut water to snow accretion by half
            2044     5               !               PSACW(I,J)=R4F*QC(I,J)*DD(I,J)
            2045     5   s    s                     psacw(i,j)=r2is*0.5*r4f*qc(i,j)*dd(i,j)
            2046     5               !JJS 3/30/06
            2047     5   s    s                     praci(i,j)=r2is*r5f*qi(i,j)/zr(i,j)**bw3
            2048     5   m    m                     piacr(i,j)=r2is*r6f*qi(i,j)*(zr(i,j)**(-bw6))
            2049     5               !JJS               PIACR(I,J)=R6F*QI(I,J)/ZR(I,J)**BW6
            2050     5   s    s                  else
            2051     5   m    s                     qsacw(i,j)=r2is*r4f*qc(i,j)*dd(i,j)
            2052     5   p    s                  endif
            2053     4               
            2054     4               !* 21 * PRAUT   AUTOCONVERSION OF QC TO QR                        **21**
            2055     4               !* 22 * PRACW : ACCRETION OF QC BY QR                             **22**
            2056     4               
            2057     4   m    s                  pracw(i,j)=r22f*qc(i,j)/zr(i,j)**bw3
            2058     4   p    s                  praut(i,j)=0.0
            2059     4   s    s                  y1(i,j)=qc(i,j)-bnd3
            2060     5   s    s                  if (y1(i,j).gt.0.0) then
            2061     5   s    s                     praut(i,j)=r00*y1(i,j)*y1(i,j)/(1.2e-4+rn21/y1(i,j))
            2062     5   p    s                  endif
            2063     4               
            2064     4               !* 12 * PSFW : BERGERON PROCESSES FOR QS (KOENING, 1971)          **12**
            2065     4               !* 13 * PSFI : BERGERON PROCESSES FOR QS                          **13**
            2066     4               
            2067     4   p    s                  psfw(i,j)=0.0
            2068     4   p    s                  psfi(i,j)=0.0
            2069     4   p    s                  pidep(i,j)=0.0
            2070     4               
            2071     5   s    s                  if(tair(i,j).lt.t0.and.qi(i,j).gt.cmin) then
            2072     5   s    s                     y1(i,j)=max( min(tairc(i,j), -1.), -31.)
            2073     5   s    s                     it(i,j)=int(abs(y1(i,j)))
            2074     5   s    s                     y1(i,j)=rn12a(it(i,j))
            2075     5   s    s                     y2(i,j)=rn12b(it(i,j))
            2076     5               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2077     5   s    s                psfw(i,j)=r2is* &
            2078     5                                   max(d2t*y1(i,j)*(y2(i,j)+r12r*qc(i,j))*qi(i,j),0.0)
            2079     5   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2080     5   s    s                     y2(i,j)=exp(c218-c580*rtair(i,j))
            2081     5   s    s                     qsi(i,j)=rp0*y2(i,j)
            2082     5   s    s                     esi(i,j)=c610*y2(i,j)
            2083     5   s    s                     ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2084     5   s    s                     r_nci=min(1.e-6*exp(-.46*tairc(i,j)),1.)
            2085     5               !              R_NCI=min(1.e-8*EXP(-.6*TAIRC(I,J)),1.) ! use Tao's
            2086     5   s    s                     dm(i,j)=max( (qv(i,j)+qb0-qsi(i,j)), 0.)
            2087     5   s    s                     rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2088     5   s    s                     y3(i,j)=1./tair(i,j)
            2089     5   s    s                dd(i,j)=y3(i,j)*(rn30a*y3(i,j)-rn30b)+rn30c*tair(i,j)/esi(i,j)
            2090     5   s    s                     y1(i,j)=206.18*ssi(i,j)/dd(i,j)
            2091     5   s    s                     pidep(i,j)=y1(i,j)*sqrt(r_nci*qi(i,j)/r00)
            2092     5   s    s                     dep(i,j)=dm(i,j)/(1.+rsub1(i,j))/d2t
            2093     6   m    s                     if(dm(i,j).gt.cmin2) then
            2094     6   s    s                        a2=1.
            2095     7   s    s                      if(pidep(i,j).gt.dep(i,j).and.pidep(i,j).gt.cmin2) then
            2096     7   s    s                           a2=dep(i,j)/pidep(i,j)
            2097     7   s    s                           pidep(i,j)=dep(i,j)
            2098     7   s    s                      endif
            2099     6   m    m                        psfi(i,j)=r2is*a2*.5*qi(i,j)*y1(i,j)/(sqrt(ami100) &
            2100     6                                         -sqrt(ami40))
            2101     6   m    s                        elseif(dm(i,j).lt.-cmin2) then
            2102     6               !
            2103     6               !        SUBLIMATION TERMS USED ONLY WHEN SATURATION ADJUSTMENT FOR ICE
            2104     6               !        IS TURNED OFF
            2105     6               !
            2106     6   s    s                        pidep(i,j)=0.
            2107     6   m    s                        psfi(i,j)=0.
            2108     6   s    s                     else
            2109     6   s    s                        pidep(i,j)=0.
            2110     6   m    s                        psfi(i,j)=0.
            2111     6   p    s                     endif
            2112     5   p    s                  endif
            2113     4               
            2114     4               !TTT***** QG=QG+MIN(PGDRY,PGWET)
            2115     4               !*  9 * PGACS : ACCRETION OF QS BY QG (DGACS,WGACS: DRY AND WET)  ***9**
            2116     4               !* 14 * DGACW : ACCRETION OF QC BY QG (QGACW FOR PGMLT)           **14**
            2117     4               !* 16 * DGACR : ACCRETION OF QR TO QG (QGACR FOR PGMLT)           **16**
            2118     4               
            2119     5   p    s                  if(qc(i,j)+qr(i,j).lt.1.e-4) then
            2120     5   p    m                     ee1=.01
            2121     5   p    s                    else
            2122     5   p    s                       ee1=1.
            2123     5   p    s                    endif
            2124     4   s    s                  ee2=0.09
            2125     4   s    s                  egs(i,j)=ee1*exp(ee2*tairc(i,j))
            2126     4               !            EGS(I,J)=0.1 ! 6/15/02 tao's
            2127     4   s    s                  if (tair(i,j).ge.t0) egs(i,j)=1.0
            2128     4   m    s                  y1(i,j)=abs(vg(i,j)-vs(i,j))
            2129     4   s    s                  y2(i,j)=zs(i,j)*zg(i,j)
            2130     4   s    s                  y3(i,j)=5./y2(i,j)
            2131     4   s    s                  y4(i,j)=.08*y3(i,j)*y3(i,j)
            2132     4   s    s                  y5(i,j)=.05*y3(i,j)*y4(i,j)
            2133     4   s    s                  dd(i,j)=y1(i,j)*(y3(i,j)/zs(i,j)**5+y4(i,j)/zs(i,j)**3 &
            2134     4                                   +y5(i,j)/zs(i,j))
            2135     4   s    s                  pgacs(i,j)=r2ig*r2is*r9r*egs(i,j)*dd(i,j)
            2136     4               !JJS 1/3/06 from Steve and Chunglin
            2137     5   p    s                  if (ihail.eq.1) then
            2138     5   m    m                     dgacs(i,j)=pgacs(i,j)
            2139     5   p    s                  else
            2140     5   p    s                     dgacs(i,j)=0.
            2141     5   p    s                  endif
            2142     4               !JJS 1/3/06 from Steve and Chunglin
            2143     4   s    s                  wgacs(i,j)=r2ig*r2is*r9r*dd(i,j)
            2144     4               !            WGACS(I,J)=0.  ! 6/15/02 tao's
            2145     4   s    s                  y1(i,j)=1./zg(i,j)**bg3
            2146     4               
            2147     5   p    s                  if(ihail .eq. 1) then
            2148     5   m    m                     dgacw(i,j)=r2ig*max(r14r*qc(i,j)*y1(i,j), 0.0)
            2149     5   p    s                  else
            2150     5   m    s                     dgacw(i,j)=r2ig*max(r14f*qc(i,j)*y1(i,j), 0.0)
            2151     5   p    s                  endif
            2152     4               
            2153     4   s    s                  qgacw(i,j)=dgacw(i,j)
            2154     4   s    s                  y1(i,j)=abs(vg(i,j)-vr(i,j))
            2155     4   s    s                  y2(i,j)=zr(i,j)*zg(i,j)
            2156     4   s    s                  y3(i,j)=5./y2(i,j)
            2157     4   s    s                  y4(i,j)=.08*y3(i,j)*y3(i,j)
            2158     4   s    s                  y5(i,j)=.05*y3(i,j)*y4(i,j)
            2159     4   s    s                  dd(i,j)=r16r*y1(i,j)*(y3(i,j)/zr(i,j)**5+y4(i,j)/zr(i,j)**3 &
            2160     4                                   +y5(i,j)/zr(i,j))
            2161     4   s    s                  dgacr(i,j)=r2ig*max(dd(i,j), 0.0)
            2162     4   s    s                  qgacr(i,j)=dgacr(i,j)
            2163     4               
            2164     5   m    s                  if (tair(i,j).ge.t0) then
            2165     5   s    s                     dgacs(i,j)=0.0
            2166     5   s    s                     wgacs(i,j)=0.0
            2167     5   s    s                     dgacw(i,j)=0.0
            2168     5   m    m                     dgacr(i,j)=0.0
            2169     5   s    s                  else
            2170     5   s    s                     pgacs(i,j)=0.0
            2171     5   s    s                     qgacw(i,j)=0.0
            2172     5   m    s                     qgacr(i,j)=0.0
            2173     5   p    s                  endif
            2174     4               
            2175     4               !*******PGDRY : DGACW+DGACI+DGACR+DGACS                           ******
            2176     4               !* 15 * DGACI : ACCRETION OF QI BY QG (WGACI FOR WET GROWTH)      **15**
            2177     4               !* 17 * PGWET : WET GROWTH OF QG                                  **17**
            2178     4               
            2179     4   p    s                  dgaci(i,j)=0.0
            2180     4   p    s                  wgaci(i,j)=0.0
            2181     4   p    s                  pgwet(i,j)=0.0
            2182     4               
            2183     5   s    s                  if (tair(i,j).lt.t0) then
            2184     5   s    s                     y1(i,j)=qi(i,j)/zg(i,j)**bg3
            2185     6   m    s                     if (ihail.eq.1) then
            2186     6   s    s                        dgaci(i,j)=r2ig*r15r*y1(i,j)
            2187     6   m    m                        wgaci(i,j)=r2ig*r15ar*y1(i,j)
            2188     6               !                  WGACI(I,J)=0.  ! 6/15/02 tao's
            2189     6   s    s                     else
            2190     6               
            2191     6               !JJS                  DGACI(I,J)=r2ig*R15F*Y1(I,J)
            2192     6   s    s                         dgaci(i,j)=0.
            2193     6   m    s                        wgaci(i,j)=r2ig*r15af*y1(i,j)
            2194     6               !                  WGACI(I,J)=0.  ! 6/15/02 tao's
            2195     6   s    s                     endif
            2196     5               !
            2197     6   s    s                     if (tairc(i,j).ge.-50.) then
            2198     7   s    s                      if (alf+rn17c*tairc(i,j) .eq. 0.) then
            2199     7   s    s                         write(91,*) itimestep, i,j,k, alf, rn17c, tairc(i,j)
            2200     7   s    s                      endif
            2201     6   s    s                      y1(i,j)=1./(alf+rn17c*tairc(i,j))
            2202     7   m    s                      if (ihail.eq.1) then
            2203     7   m    m                         y3(i,j)=.78/zg(i,j)**2+r17aq*scv(i,j)/zg(i,j)**bgh5
            2204     7   s    s                      else
            2205     7   m    s                         y3(i,j)=.78/zg(i,j)**2+r17as*scv(i,j)/zg(i,j)**bgh5
            2206     7   s    s                      endif
            2207     6   s    s                      y4(i,j)=alvr*dwv(i,j)*(rp0-(qv(i,j)+qb0)) &
            2208     6                                       -tca(i,j)*tairc(i,j)
            2209     6   s    s                      dd(i,j)=y1(i,j)*(r17r*y4(i,j)*y3(i,j) &
            2210     6                                      +(wgaci(i,j)+wgacs(i,j))*(alf+rn17b*tairc(i,j)))
            2211     6   s    s                      pgwet(i,j)=r2ig*max(dd(i,j), 0.0)
            2212     6   p    s                     endif
            2213     5   p    s                  endif
            2214     4               !JJS  125    CONTINUE
            2215     4               
            2216     4               !********   HANDLING THE NEGATIVE CLOUD WATER (QC)    ******************
            2217     4               !********   HANDLING THE NEGATIVE CLOUD ICE (QI)      ******************
            2218     4               
            2219     4               !JJS         DO 150 J=3,JLES
            2220     4               !JJS         DO 150 I=3,ILES
            2221     4               
            2222     4   p    s                  y1(i,j)=qc(i,j)/d2t
            2223     4   s    s                  psacw(i,j)=min(y1(i,j), psacw(i,j))
            2224     4   s    s                  praut(i,j)=min(y1(i,j), praut(i,j))
            2225     4   s    s                  pracw(i,j)=min(y1(i,j), pracw(i,j))
            2226     4   s    s                  psfw(i,j)= min(y1(i,j), psfw(i,j))
            2227     4   s    s                  dgacw(i,j)=min(y1(i,j), dgacw(i,j))
            2228     4   s    s                  qsacw(i,j)=min(y1(i,j), qsacw(i,j))
            2229     4   s    s                  qgacw(i,j)=min(y1(i,j), qgacw(i,j))
            2230     4               
            2231     4   s    s                  y1(i,j)=(psacw(i,j)+praut(i,j)+pracw(i,j)+psfw(i,j) &
            2232     4                                   +dgacw(i,j)+qsacw(i,j)+qgacw(i,j))*d2t
            2233     4   s    s                  qc(i,j)=qc(i,j)-y1(i,j)
            2234     4               
            2235     5   s    s                  if (qc(i,j) .lt. 0.0) then
            2236     5   s    s                     a1=1.
            2237     5   s    s                     if (y1(i,j) .ne. 0.0) a1=qc(i,j)/y1(i,j)+1.
            2238     5   s    s                     psacw(i,j)=psacw(i,j)*a1
            2239     5   s    s                     praut(i,j)=praut(i,j)*a1
            2240     5   s    s                     pracw(i,j)=pracw(i,j)*a1
            2241     5   s    s                     psfw(i,j)=psfw(i,j)*a1
            2242     5   s    s                     dgacw(i,j)=dgacw(i,j)*a1
            2243     5   s    s                     qsacw(i,j)=qsacw(i,j)*a1
            2244     5   s    s                     qgacw(i,j)=qgacw(i,j)*a1
            2245     5   s    s                     qc(i,j)=0.0
            2246     5   p    s                  endif
            2247     4               !c
            2248     4               !
            2249     4               !******** SHED PROCESS (WGACR=PGWET-DGACW-WGACI-WGACS)
            2250     4               !c
            2251     4   s    s                  wgacr(i,j)=pgwet(i,j)-dgacw(i,j)-wgaci(i,j)-wgacs(i,j)
            2252     4   s    s                  y2(i,j)=dgacw(i,j)+dgaci(i,j)+dgacr(i,j)+dgacs(i,j)
            2253     5   m    s                  if (pgwet(i,j).ge.y2(i,j)) then
            2254     5   s    s                     wgacr(i,j)=0.0
            2255     5   s    s                     wgaci(i,j)=0.0
            2256     5   m    m                     wgacs(i,j)=0.0
            2257     5   s    s                  else
            2258     5   s    s                     dgacr(i,j)=0.0
            2259     5   s    s                     dgaci(i,j)=0.0
            2260     5   m    s                     dgacs(i,j)=0.0
            2261     5   p    s                  endif
            2262     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2263     4               !c
            2264     4   m    s                  y1(i,j)=qi(i,j)/d2t
            2265     4   s    s                  psaut(i,j)=min(y1(i,j), psaut(i,j))
            2266     4   s    s                  psaci(i,j)=min(y1(i,j), psaci(i,j))
            2267     4   s    s                  praci(i,j)=min(y1(i,j), praci(i,j))
            2268     4   s    s                  psfi(i,j)= min(y1(i,j), psfi(i,j))
            2269     4   s    s                  dgaci(i,j)=min(y1(i,j), dgaci(i,j))
            2270     4   s    s                  wgaci(i,j)=min(y1(i,j), wgaci(i,j))
            2271     4               !
            2272     4   s    s                  y2(i,j)=(psaut(i,j)+psaci(i,j)+praci(i,j)+psfi(i,j) &
            2273     4                                  +dgaci(i,j)+wgaci(i,j))*d2t
            2274     4   s    s                  qi(i,j)=qi(i,j)-y2(i,j)+pidep(i,j)*d2t
            2275     4               
            2276     5   s    s                  if (qi(i,j).lt.0.0) then
            2277     5   s    s                     a2=1.
            2278     5   s    s                     if (y2(i,j) .ne. 0.0) a2=qi(i,j)/y2(i,j)+1.
            2279     5   s    s                     psaut(i,j)=psaut(i,j)*a2
            2280     5   s    s                     psaci(i,j)=psaci(i,j)*a2
            2281     5   s    s                     praci(i,j)=praci(i,j)*a2
            2282     5   s    s                     psfi(i,j)=psfi(i,j)*a2
            2283     5   s    s                     dgaci(i,j)=dgaci(i,j)*a2
            2284     5   s    s                     wgaci(i,j)=wgaci(i,j)*a2
            2285     5   s    s                     qi(i,j)=0.0
            2286     5   p    s                  endif
            2287     4               !
            2288     4   p    s                  dlt3(i,j)=0.0
            2289     4   p    s                  dlt2(i,j)=0.0
            2290     4               !
            2291     4               
            2292     4               !            DLT4(I,J)=1.0
            2293     4               !            if(qc(i,j) .gt. 5.e-4) dlt4(i,j)=0.0
            2294     4               !            if(qs(i,j) .le. 1.e-4) dlt4(i,j)=1.0
            2295     4               !
            2296     4               !            IF (TAIR(I,J).ge.T0) THEN
            2297     4               !               DLT4(I,J)=0.0
            2298     4               !            ENDIF
            2299     4               
            2300     5   s    s                  if (tair(i,j).lt.t0) then
            2301     6   s    s                     if (qr(i,j).lt.1.e-4) then
            2302     6   s    s                        dlt3(i,j)=1.0
            2303     6   s    s                        dlt2(i,j)=1.0
            2304     6   s    s                     endif
            2305     6   s    s                     if (qs(i,j).ge.1.e-4) then
            2306     6   s    s                        dlt2(i,j)=0.0
            2307     6   p    s                     endif
            2308     5   p    s                  endif
            2309     4               
            2310     5   p    s                  if (ice2 .eq. 1) then
            2311     5   s    s                        dlt3(i,j)=1.0
            2312     5   s    s                        dlt2(i,j)=1.0
            2313     5   p    s                  endif
            2314     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2315     4   m    s                  pr(i,j)=(qsacw(i,j)+praut(i,j)+pracw(i,j)+qgacw(i,j))*d2t
            2316     4   s    s                  ps(i,j)=(psaut(i,j)+psaci(i,j)+psacw(i,j)+psfw(i,j) &
            2317     4                                   +psfi(i,j)+dlt3(i,j)*praci(i,j))*d2t
            2318     4               !           PS(I,J)=(PSAUT(I,J)+PSACI(I,J)+dlt4(i,j)*PSACW(I,J)
            2319     4               !    1              +PSFW(I,J)+PSFI(I,J)+DLT3(I,J)*PRACI(I,J))*D2T
            2320     4   s    s                  pg(i,j)=((1.-dlt3(i,j))*praci(i,j)+dgaci(i,j)+wgaci(i,j) &
            2321     4                                   +dgacw(i,j))*d2t
            2322     4               !           PG(I,J)=((1.-DLT3(I,J))*PRACI(I,J)+DGACI(I,J)+WGACI(I,J)
            2323     4               !    1              +DGACW(I,J)+(1.-dlt4(i,j))*PSACW(I,J))*D2T
            2324     4               
            2325     4               !JJS  150    CONTINUE
            2326     4               
            2327     4               !*  7 * PRACS : ACCRETION OF QS BY QR                             ***7**
            2328     4               !*  8 * PSACR : ACCRETION OF QR BY QS (QSACR FOR PSMLT)           ***8**
            2329     4               
            2330     4               !JJS         DO 175 J=3,JLES
            2331     4               !JJS         DO 175 I=3,ILES
            2332     4               
            2333     4   s    s                  y1(i,j)=abs(vr(i,j)-vs(i,j))
            2334     4   s    s                  y2(i,j)=zr(i,j)*zs(i,j)
            2335     4   s    s                  y3(i,j)=5./y2(i,j)
            2336     4   s    s                  y4(i,j)=.08*y3(i,j)*y3(i,j)
            2337     4   s    s                  y5(i,j)=.05*y3(i,j)*y4(i,j)
            2338     4   s    s                  pracs(i,j)=r2ig*r2is*r7r*y1(i,j)*(y3(i,j)/zs(i,j)**5 &
            2339     4                                     +y4(i,j)/zs(i,j)**3+y5(i,j)/zs(i,j))
            2340     4   s    s                  psacr(i,j)=r2is*r8r*y1(i,j)*(y3(i,j)/zr(i,j)**5 &
            2341     4                                     +y4(i,j)/zr(i,j)**3+y5(i,j)/zr(i,j))
            2342     4   s    s                  qsacr(i,j)=psacr(i,j)
            2343     4               
            2344     5   m    s                  if (tair(i,j).ge.t0) then
            2345     5   s    s                     pracs(i,j)=0.0
            2346     5   m    m                     psacr(i,j)=0.0
            2347     5   s    s                  else
            2348     5   m    s                     qsacr(i,j)=0.0
            2349     5   p    s                  endif
            2350     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2351     4               !*  2 * PGAUT : AUTOCONVERSION OF QS TO QG                        ***2**
            2352     4               !* 18 * PGFR : FREEZING OF QR TO QG                               **18**
            2353     4               
            2354     4   p    s                  pgaut(i,j)=0.0
            2355     4   p    s                  pgfr(i,j)=0.0
            2356     4               
            2357     5   s    s                  if (tair(i,j) .lt. t0) then
            2358     5               !               Y1(I,J)=EXP(.09*TAIRC(I,J))
            2359     5               !               PGAUT(I,J)=r2is*max(RN2*Y1(I,J)*(QS(I,J)-BND2), 0.0)
            2360     5               !         IF(IHAIL.EQ.1) PGAUT(I,J)=max(RN2*Y1(I,J)*(QS(I,J)-BND2),0.0)
            2361     5   s    s                     y2(i,j)=exp(rn18a*(t0-tair(i,j)))
            2362     5               !JJS              PGFR(I,J)=r2ig*max(R18R*(Y2(I,J)-1.)/ZR(I,J)**7., 0.0)
            2363     5               !              pgfr(i,j)=r2ice*max(r18r*(y2(i,j)-1.)* &
            2364     5               !                                    (zr(i,j)**(-7.)), 0.0)
            2365     5               !        modify to prevent underflow on some computers (JD)
            2366     5   s    s                     temp = 1./zr(i,j)
            2367     5   s    s                     temp = temp*temp*temp*temp*temp*temp*temp
            2368     5   s    s                     pgfr(i,j)=r2ig*max(r18r*(y2(i,j)-1.)* &
            2369     5                                                   temp, 0.0)
            2370     5   p    s                  endif
            2371     4               
            2372     4               !JJS  175    CONTINUE
            2373     4               
            2374     4               !********   HANDLING THE NEGATIVE RAIN WATER (QR)    *******************
            2375     4               !********   HANDLING THE NEGATIVE SNOW (QS)          *******************
            2376     4               
            2377     4               !JJS         DO 200 J=3,JLES
            2378     4               !JJS         DO 200 I=3,ILES
            2379     4               
            2380     4   m    s                  y1(i,j)=qr(i,j)/d2t
            2381     4   m    s                  y2(i,j)=-qg(i,j)/d2t
            2382     4   s    s                  piacr(i,j)=min(y1(i,j), piacr(i,j))
            2383     4   s    s                  dgacr(i,j)=min(y1(i,j), dgacr(i,j))
            2384     4   s    s                  wgacr(i,j)=min(y1(i,j), wgacr(i,j))
            2385     4   s    s                  wgacr(i,j)=max(y2(i,j), wgacr(i,j))
            2386     4   s    s                  psacr(i,j)=min(y1(i,j), psacr(i,j))
            2387     4   s    s                  pgfr(i,j)= min(y1(i,j), pgfr(i,j))
            2388     4   p    s                  del=0.
            2389     4   s    s                  if(wgacr(i,j) .lt. 0.) del=1.
            2390     4   m    s                  y1(i,j)=(piacr(i,j)+dgacr(i,j)+(1.-del)*wgacr(i,j) &
            2391     4                                   +psacr(i,j)+pgfr(i,j))*d2t
            2392     4   s    s                  qr(i,j)=qr(i,j)+pr(i,j)-y1(i,j)-del*wgacr(i,j)*d2t
            2393     5   s    s                  if (qr(i,j) .lt. 0.0) then
            2394     5   s    s                     a1=1.
            2395     5   s    s                     if(y1(i,j) .ne. 0.) a1=qr(i,j)/y1(i,j)+1.
            2396     5   s    s                     piacr(i,j)=piacr(i,j)*a1
            2397     5   s    s                     dgacr(i,j)=dgacr(i,j)*a1
            2398     5   s    s                     if (wgacr(i,j).gt.0.) wgacr(i,j)=wgacr(i,j)*a1
            2399     5   s    s                     pgfr(i,j)=pgfr(i,j)*a1
            2400     5   s    s                     psacr(i,j)=psacr(i,j)*a1
            2401     5   s    s                     qr(i,j)=0.0
            2402     5   p    s                  endif
            2403     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2404     4   s    s                  prn(i,j)=d2t*((1.-dlt3(i,j))*piacr(i,j)+dgacr(i,j) &
            2405     4                                    +wgacr(i,j)+(1.-dlt2(i,j))*psacr(i,j)+pgfr(i,j))
            2406     4   s    s                  ps(i,j)=ps(i,j)+d2t*(dlt3(i,j)*piacr(i,j) &
            2407     4                                   +dlt2(i,j)*psacr(i,j))
            2408     4   s    s                  pracs(i,j)=(1.-dlt2(i,j))*pracs(i,j)
            2409     4   m    s                  y1(i,j)=qs(i,j)/d2t
            2410     4   s    s                  pgacs(i,j)=min(y1(i,j), pgacs(i,j))
            2411     4   s    s                  dgacs(i,j)=min(y1(i,j), dgacs(i,j))
            2412     4   s    s                  wgacs(i,j)=min(y1(i,j), wgacs(i,j))
            2413     4   p    s                  pgaut(i,j)=min(y1(i,j), pgaut(i,j))
            2414     4   s    s                  pracs(i,j)=min(y1(i,j), pracs(i,j))
            2415     4   s    s                  psn(i,j)=d2t*(pgacs(i,j)+dgacs(i,j)+wgacs(i,j) &
            2416     4                                    +pgaut(i,j)+pracs(i,j))
            2417     4   s    s                  qs(i,j)=qs(i,j)+ps(i,j)-psn(i,j)
            2418     4               
            2419     5   s    s                  if (qs(i,j).lt.0.0) then
            2420     5   s    s                     a2=1.
            2421     5   s    s                     if (psn(i,j) .ne. 0.0) a2=qs(i,j)/psn(i,j)+1.
            2422     5   m    s                     pgacs(i,j)=pgacs(i,j)*a2
            2423     5   p    s                     dgacs(i,j)=dgacs(i,j)*a2
            2424     5   p    s                     wgacs(i,j)=wgacs(i,j)*a2
            2425     5   p    s                     pgaut(i,j)=pgaut(i,j)*a2
            2426     5   p    s                     pracs(i,j)=pracs(i,j)*a2
            2427     5   s    s                     psn(i,j)=psn(i,j)*a2
            2428     5   s    s                     qs(i,j)=0.0
            2429     5   p    s                  endif
            2430     4               !
            2431     4               !C           PSN(I,J)=D2T*(PGACS(I,J)+DGACS(I,J)+WGACS(I,J)
            2432     4               !c                    +PGAUT(I,J)+PRACS(I,J))
            2433     4   s    s                  y2(i,j)=d2t*(psacw(i,j)+psfw(i,j)+dgacw(i,j)+piacr(i,j) &
            2434     4                                   +dgacr(i,j)+wgacr(i,j)+psacr(i,j)+pgfr(i,j))
            2435     4   s    s                  pt(i,j)=pt(i,j)+afcp*y2(i,j)
            2436     4   s    s                  qg(i,j)=qg(i,j)+pg(i,j)+prn(i,j)+psn(i,j)
            2437     4               
            2438     4               !JJS  200    CONTINUE
            2439     4               
            2440     4               !* 11 * PSMLT : MELTING OF QS                                     **11**
            2441     4               !* 19 * PGMLT : MELTING OF QG TO QR                               **19**
            2442     4               
            2443     4               !JJS         DO 225 J=3,JLES
            2444     4               !JJS         DO 225 I=3,ILES
            2445     4               
            2446     4   p    s                  psmlt(i,j)=0.0
            2447     4   p    s                  pgmlt(i,j)=0.0
            2448     4   s    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2449     4               
            2450     5   s    s                  if (tair(i,j).ge.t0) then
            2451     5   s    s                     tairc(i,j)=tair(i,j)-t0
            2452     5   s    s                     y1(i,j)=tca(i,j)*tairc(i,j)-alvr*dwv(i,j) &
            2453     5                                              *(rp0-(qv(i,j)+qb0))
            2454     5   s    s                     y2(i,j)=.78/zs(i,j)**2+r101f*scv(i,j)/zs(i,j)**bsh5
            2455     5   s    s                     dd(i,j)=r11rt*y1(i,j)*y2(i,j)+r11at*tairc(i,j) &
            2456     5                                      *(qsacw(i,j)+qsacr(i,j))
            2457     5   s    s                     psmlt(i,j)=r2is*max(0.0, min(dd(i,j), qs(i,j)))
            2458     5               
            2459     6   m    s                     if(ihail.eq.1) then
            2460     6   m    m                        y3(i,j)=.78/zg(i,j)**2+r19aq*scv(i,j)/zg(i,j)**bgh5
            2461     6   s    s                     else
            2462     6   m    s                        y3(i,j)=.78/zg(i,j)**2+r19as*scv(i,j)/zg(i,j)**bgh5
            2463     6   s    s                     endif
            2464     5               
            2465     5   s    s                     dd1(i,j)=r19rt*y1(i,j)*y3(i,j)+r19bt*tairc(i,j) &
            2466     5                                       *(qgacw(i,j)+qgacr(i,j))
            2467     5   s    s                     pgmlt(i,j)=r2ig*max(0.0, min(dd1(i,j), qg(i,j)))
            2468     5   s    s                     pt(i,j)=pt(i,j)-afcp*(psmlt(i,j)+pgmlt(i,j))
            2469     5   s    s                     qr(i,j)=qr(i,j)+psmlt(i,j)+pgmlt(i,j)
            2470     5   s    s                     qs(i,j)=qs(i,j)-psmlt(i,j)
            2471     5   s    s                     qg(i,j)=qg(i,j)-pgmlt(i,j)
            2472     5   p    s                  endif
            2473     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2474     4               !* 24 * PIHOM : HOMOGENEOUS FREEZING OF QC TO QI (T < T00)        **24**
            2475     4               !* 25 * PIDW : DEPOSITION GROWTH OF QC TO QI ( T0 < T <= T00)     **25**
            2476     4               !* 26 * PIMLT : MELTING OF QI TO QC (T >= T0)                     **26**
            2477     4               
            2478     4   s    s                  if (qc(i,j).le.cmin1) qc(i,j)=0.0
            2479     4   m    s                  if (qi(i,j).le.cmin1) qi(i,j)=0.0
            2480     4   m    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2481     4               
            2482     5   m    s                  if(tair(i,j).le.t00) then
            2483     5   m    m                     pihom(i,j)=qc(i,j)
            2484     5   s    s                  else
            2485     5   m    s                     pihom(i,j)=0.0
            2486     5   p    s                  endif
            2487     5   m    s                  if(tair(i,j).ge.t0) then
            2488     5   m    m                     pimlt(i,j)=qi(i,j)
            2489     5   s    s                  else
            2490     5   m    s                     pimlt(i,j)=0.0
            2491     5   p    s                  endif
            2492     4   p    s                  pidw(i,j)=0.0
            2493     4               
            2494     5   s    s                  if (tair(i,j).lt.t0 .and. tair(i,j).gt.t00) then
            2495     5   s    s                     tairc(i,j)=tair(i,j)-t0
            2496     5   s    s                     y1(i,j)=max( min(tairc(i,j), -1.), -31.)
            2497     5   m    s                     it(i,j)=int(abs(y1(i,j)))
            2498     5   s    s                     y2(i,j)=aa1(it(i,j))
            2499     5   s    s                     y3(i,j)=aa2(it(i,j))
            2500     5   s    s                     y4(i,j)=exp(abs(beta*tairc(i,j)))
            2501     5   s    s                     y5(i,j)=(r00*qi(i,j)/(r25a*y4(i,j)))**y3(i,j)
            2502     5   s    s                     pidw(i,j)=min(r25rt*y2(i,j)*y4(i,j)*y5(i,j), qc(i,j))
            2503     5   p    s                  endif
            2504     4               
            2505     4   s    s                  y1(i,j)=pihom(i,j)-pimlt(i,j)+pidw(i,j)
            2506     4   s    s                  pt(i,j)=pt(i,j)+afcp*y1(i,j)+ascp*(pidep(i,j))*d2t
            2507     4   s    s                  qv(i,j)=qv(i,j)-(pidep(i,j))*d2t
            2508     4   s    s                  qc(i,j)=qc(i,j)-y1(i,j)
            2509     4   s    s                  qi(i,j)=qi(i,j)+y1(i,j)
            2510     4               
            2511     4               !* 31 * PINT  : INITIATION OF QI                                  **31**
            2512     4               !* 32 * PIDEP : DEPOSITION OF QI                                  **32**
            2513     4               !
            2514     4               !     CALCULATION OF PINT USES DIFFERENT VALUES OF THE INTERCEPT AND SLOPE FOR
            2515     4               !     THE FLETCHER EQUATION. ALSO, ONLY INITIATE MORE ICE IF THE NEW NUMBER
            2516     4               !     CONCENTRATION EXCEEDS THAT ALREADY PRESENT.
            2517     4               !* 31 * pint  : initiation of qi                                  **31**
            2518     4               !* 32 * pidep : deposition of qi                                  **32**
            2519     4   p    s                 pint(i,j)=0.0
            2520     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2521     5   p    s              if ( itaobraun.eq.1 ) then
            2522     5   s    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2523     6   s    s                  if (tair(i,j) .lt. t0) then
            2524     6               !             if (qi(i,j) .le. cmin) qi(i,j)=0.
            2525     6   s    s                    if (qi(i,j) .le. cmin2) qi(i,j)=0.
            2526     6   s    s                     tairc(i,j)=tair(i,j)-t0
            2527     6   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2528     6   s    s                     y2(i,j)=exp(c218-c580*rtair(i,j))
            2529     6   s    s                    qsi(i,j)=rp0*y2(i,j)
            2530     6   s    s                     esi(i,j)=c610*y2(i,j)
            2531     6   s    s                    ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2532     6   s    s                              ami50=3.76e-8
            2533     6               
            2534     6               !ccif ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
            2535     6               !ccif ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
            2536     6               
            2537     6   s    s                   y1(i,j)=1./tair(i,j)
            2538     6               
            2539     6               !cc insert a restriction on ice collection that ice collection
            2540     6               !cc should be stopped at -30 c (with cn0=1.e-6, beta=-.46)
            2541     6               
            2542     6   s    s                   tairccri=tairc(i,j)          ! in degree c
            2543     6   s    s                   if(tairccri.le.-30.) tairccri=-30.
            2544     6               
            2545     6               !            y2(i,j)=exp(betah*tairc(i,j))
            2546     6   s    s                   y2(i,j)=exp(betah*tairccri)
            2547     6   s    s                   y3(i,j)=sqrt(qi(i,j))
            2548     6   s    s                   dd(i,j)=y1(i,j)*(rn10a*y1(i,j)-rn10b)+rn10c*tair(i,j) &
            2549     6                                                               /esi(i,j)
            2550     6   s    s                pidep(i,j)=max(r32rt*ssi(i,j)*y2(i,j)*y3(i,j)/dd(i,j), 0.e0)
            2551     6               
            2552     6   s    s                 r_nci=min(cn0*exp(beta*tairc(i,j)),1.)
            2553     6               !          r_nci=min(1.e-6*exp(-.46*tairc(i,j)),1.)
            2554     6               
            2555     6   s    s                 dd(i,j)=max(1.e-9*r_nci/r00-qi(i,j)*1.e-9/ami50, 0.)
            2556     6   s    s                      dm(i,j)=max( (qv(i,j)+qb0-qsi(i,j)), 0.0)
            2557     6   s    s                      rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2558     6   s    s                    dep(i,j)=dm(i,j)/(1.+rsub1(i,j))
            2559     6   s    s                    pint(i,j)=max(min(dd(i,j), dm(i,j)), 0.)
            2560     6               
            2561     6               !             pint(i,j)=min(pint(i,j), dep(i,j))
            2562     6   s    s                    pint(i,j)=min(pint(i,j)+pidep(i,j), dep(i,j))
            2563     6               
            2564     6               !              if (pint(i,j) .le. cmin) pint(i,j)=0.
            2565     6   s    s                     if (pint(i,j) .le. cmin2) pint(i,j)=0.
            2566     6   s    s                    pt(i,j)=pt(i,j)+ascp*pint(i,j)
            2567     6   s    s                    qv(i,j)=qv(i,j)-pint(i,j)
            2568     6   s    s                    qi(i,j)=qi(i,j)+pint(i,j)
            2569     6   p    s                 endif
            2570     5   p    s              endif  ! if ( itaobraun.eq.1 )
            2571     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2572     4               !
            2573     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2574     5   p    s              if ( itaobraun.eq.0 ) then
            2575     5   s    s                   tair(i,j)=(pt(i,j)+tb0)*pi0
            2576     6   s    s                   if (tair(i,j) .lt. t0) then
            2577     6   s    s                     if (qi(i,j) .le. cmin1) qi(i,j)=0.
            2578     6   s    s                     tairc(i,j)=tair(i,j)-t0
            2579     6   s    s                     dd(i,j)=r31r*exp(beta*tairc(i,j))
            2580     6   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2581     6   s    s                     y2(i,j)=exp(c218-c580*rtair(i,j))
            2582     6   s    s                     qsi(i,j)=rp0*y2(i,j)
            2583     6   s    s                     esi(i,j)=c610*y2(i,j)
            2584     6   s    s                     ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2585     6   s    s                     dm(i,j)=max( (qv(i,j)+qb0-qsi(i,j)), 0.)
            2586     6   s    s                     rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2587     6   s    s                     dep(i,j)=dm(i,j)/(1.+rsub1(i,j))
            2588     6   s    s                    pint(i,j)=max(min(dd(i,j), dm(i,j)), 0.)
            2589     6   s    s                     y1(i,j)=1./tair(i,j)
            2590     6   s    s                     y2(i,j)=exp(betah*tairc(i,j))
            2591     6   s    s                     y3(i,j)=sqrt(qi(i,j))
            2592     6   s    s                     dd(i,j)=y1(i,j)*(rn10a*y1(i,j)-rn10b) &
            2593     6                                    +rn10c*tair(i,j)/esi(i,j)
            2594     6   s    s                   pidep(i,j)=max(r32rt*ssi(i,j)*y2(i,j)*y3(i,j)/dd(i,j), 0.)
            2595     6   s    s                    pint(i,j)=pint(i,j)+pidep(i,j)
            2596     6   s    s                    pint(i,j)=min(pint(i,j),dep(i,j))
            2597     6               !c          if (pint(i,j) .le. cmin2) pint(i,j)=0.
            2598     6   s    s                   pt(i,j)=pt(i,j)+ascp*pint(i,j)
            2599     6   s    s                   qv(i,j)=qv(i,j)-pint(i,j)
            2600     6   s    s                   qi(i,j)=qi(i,j)+pint(i,j)
            2601     6   p    s                  endif
            2602     5   p    s              endif  ! if ( itaobraun.eq.0 )
            2603     4               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2604     4               
            2605     4               !JJS  225    CONTINUE
            2606     4               
            2607     4               !*****   TAO ET AL (1989) SATURATION TECHNIQUE  ***********************
            2608     4               
            2609     5   p    s               if (new_ice_sat .eq. 0) then
            2610     5               
            2611     5               !JJS            DO 250 J=3,JLES
            2612     5               !JJS            DO 250 I=3,ILES
            2613     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            2614     5   s    s                     cnd(i,j)=rt0*(tair(i,j)-t00)
            2615     5   s    s                     dep(i,j)=rt0*(t0-tair(i,j))
            2616     5   s    s                     y1(i,j)=1./(tair(i,j)-c358)
            2617     5   s    s                     y2(i,j)=1./(tair(i,j)-c76)
            2618     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2619     5   s    s                     qsi(i,j)=rp0*exp(c218-c580*y2(i,j))
            2620     5   s    s                     dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2621     5   s    s                     dd1(i,j)=cp580*y2(i,j)*y2(i,j)
            2622     5   s    s                     if (qc(i,j).le.cmin) qc(i,j)=cmin
            2623     5   m    s                     if (qi(i,j).le.cmin) qi(i,j)=cmin
            2624     6   m    s                     if (tair(i,j).ge.t0) then
            2625     6   s    s                        dep(i,j)=0.0
            2626     6   s    s                        cnd(i,j)=1.
            2627     6   s    s                        qi(i,j)=0.0
            2628     6   p    s                     endif
            2629     5               
            2630     6   s    s                     if (tair(i,j).lt.t00) then
            2631     6   s    s                        cnd(i,j)=0.0
            2632     6   s    s                        dep(i,j)=1.
            2633     6   s    s                        qc(i,j)=0.0
            2634     6   p    s                     endif
            2635     5               
            2636     5   s    s                     y5(i,j)=avcp*cnd(i,j)+ascp*dep(i,j)
            2637     5               !               if (qc(i,j) .ge. cmin .or. qi(i,j) .ge. cmin) then
            2638     5   s    s                     y1(i,j)=qc(i,j)*qsw(i,j)/(qc(i,j)+qi(i,j))
            2639     5   s    s                     y2(i,j)=qi(i,j)*qsi(i,j)/(qc(i,j)+qi(i,j))
            2640     5   s    s                     y4(i,j)=dd(i,j)*y1(i,j)+dd1(i,j)*y2(i,j)
            2641     5   s    s                     qvs(i,j)=y1(i,j)+y2(i,j)
            2642     5   s    s                     rsub1(i,j)=(qv(i,j)+qb0-qvs(i,j))/(1.+y4(i,j)*y5(i,j))
            2643     5   s    s                     cnd(i,j)=cnd(i,j)*rsub1(i,j)
            2644     5   s    s                     dep(i,j)=dep(i,j)*rsub1(i,j)
            2645     5   s    s                     if (qc(i,j).le.cmin) qc(i,j)=0.
            2646     5   m    s                     if (qi(i,j).le.cmin) qi(i,j)=0.
            2647     5               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2648     5               !c    ******   condensation or evaporation of qc  ******
            2649     5               
            2650     5   m    s                     cnd(i,j)=max(-qc(i,j),cnd(i,j))
            2651     5               
            2652     5               !c    ******   deposition or sublimation of qi    ******
            2653     5               
            2654     5   s    s                     dep(i,j)=max(-qi(i,j),dep(i,j))
            2655     5               
            2656     5   s    s                     pt(i,j)=pt(i,j)+avcp*cnd(i,j)+ascp*dep(i,j)
            2657     5   s    s                     qv(i,j)=qv(i,j)-cnd(i,j)-dep(i,j)
            2658     5   s    s                     qc(i,j)=qc(i,j)+cnd(i,j)
            2659     5   s    s                     qi(i,j)=qi(i,j)+dep(i,j)
            2660     5               !JJS  250       continue
            2661     5   p    s               endif
            2662     4               
            2663     5   p    s               if (new_ice_sat .eq. 1) then
            2664     5               
            2665     5               !JJS            DO J=3,JLES
            2666     5               !JJS            DO I=3,ILES
            2667     5               
            2668     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            2669     5   s    s                     cnd(i,j)=rt0*(tair(i,j)-t00)
            2670     5   s    s                     dep(i,j)=rt0*(t0-tair(i,j))
            2671     5   s    s                     y1(i,j)=1./(tair(i,j)-c358)
            2672     5   s    s                     y2(i,j)=1./(tair(i,j)-c76)
            2673     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2674     5   s    s                     qsi(i,j)=rp0*exp(c218-c580*y2(i,j))
            2675     5   s    s                     dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2676     5   s    s                     dd1(i,j)=cp580*y2(i,j)*y2(i,j)
            2677     5   s    s                     y5(i,j)=avcp*cnd(i,j)+ascp*dep(i,j)
            2678     5   s    s                     y1(i,j)=rt0*(tair(i,j)-t00)*qsw(i,j)
            2679     5   s    s                     y2(i,j)=rt0*(t0-tair(i,j))*qsi(i,j)
            2680     5               !               IF (QC(I,J).LE.CMIN) QC(I,J)=CMIN
            2681     5               !               IF (QI(I,J).LE.CMIN) QI(I,J)=CMIN
            2682     5               
            2683     6   s    s                     if (tair(i,j).ge.t0) then
            2684     6               !                 QI(I,J)=0.0
            2685     6   s    s                        dep(i,j)=0.0
            2686     6   s    s                        cnd(i,j)=1.
            2687     6   s    s                        y2(i,j)=0.
            2688     6   s    s                        y1(i,j)=qsw(i,j)
            2689     6   p    s                     endif
            2690     6   s    s                     if (tair(i,j).lt.t00) then
            2691     6   s    s                        cnd(i,j)=0.0
            2692     6   s    s                        dep(i,j)=1.
            2693     6   s    s                        y2(i,j)=qsi(i,j)
            2694     6   s    s                        y1(i,j)=0.
            2695     6               !                 QC(I,J)=0.0
            2696     6   p    s                     endif
            2697     5               
            2698     5               !            Y1(I,J)=QC(I,J)*QSW(I,J)/(QC(I,J)+QI(I,J))
            2699     5               !            Y2(I,J)=QI(I,J)*QSI(I,J)/(QC(I,J)+QI(I,J))
            2700     5               
            2701     5   s    s                     y4(i,j)=dd(i,j)*y1(i,j)+dd1(i,j)*y2(i,j)
            2702     5   s    s                     qvs(i,j)=y1(i,j)+y2(i,j)
            2703     5   s    s                     rsub1(i,j)=(qv(i,j)+qb0-qvs(i,j))/(1.+y4(i,j)*y5(i,j))
            2704     5   s    s                     cnd(i,j)=cnd(i,j)*rsub1(i,j)
            2705     5   s    s                     dep(i,j)=dep(i,j)*rsub1(i,j)
            2706     5               !               IF (QC(I,J).LE.CMIN) QC(I,J)=0.
            2707     5               !               IF (QI(I,J).LE.CMIN) QI(I,J)=0.
            2708     5               
            2709     5               !C    ******   CONDENSATION OR EVAPORATION OF QC  ******
            2710     5               
            2711     5   s    s                     cnd(i,j)=max(-qc(i,j),cnd(i,j))
            2712     5               
            2713     5               !C    ******   DEPOSITION OR SUBLIMATION OF QI    ******
            2714     5               
            2715     5   s    s                     dep(i,j)=max(-qi(i,j),dep(i,j))
            2716     5               
            2717     5   s    s                     pt(i,j)=pt(i,j)+avcp*cnd(i,j)+ascp*dep(i,j)
            2718     5   s    s                     qv(i,j)=qv(i,j)-cnd(i,j)-dep(i,j)
            2719     5   s    s                     qc(i,j)=qc(i,j)+cnd(i,j)
            2720     5   s    s                     qi(i,j)=qi(i,j)+dep(i,j)
            2721     5               !JJS            ENDDO
            2722     5               !JJS            ENDDO
            2723     5   p    s               endif
            2724     4               
            2725     4               !c
            2726     4               !
            2727     5   p    s                if (new_ice_sat .eq. 2) then
            2728     5               !JJS          do j=3,jles
            2729     5               !JJS             do i=3,iles
            2730     5   p    s                dep(i,j)=0.0
            2731     5   p    s                cnd(i,j)=0.0
            2732     5   s    s                tair(i,j)=(pt(i,j)+tb0)*pi0
            2733     6   s    s                if (tair(i,j) .ge. 253.16) then
            2734     6   s    s                    y1(i,j)=1./(tair(i,j)-c358)
            2735     6   s    s                    qsw(i,j)=rp0*exp(c172-c409*y1(i,j))
            2736     6   s    s                    dd(i,j)=cp409*y1(i,j)*y1(i,j)
            2737     6   s    s                    dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            2738     6   s    s                    cnd(i,j)=dm(i,j)/(1.+avcp*dd(i,j)*qsw(i,j))
            2739     6               !c    ******   condensation or evaporation of qc  ******
            2740     6   m    s                    cnd(i,j)=max(-qc(i,j), cnd(i,j))
            2741     6   s    s                   pt(i,j)=pt(i,j)+avcp*cnd(i,j)
            2742     6   s    s                   qv(i,j)=qv(i,j)-cnd(i,j)
            2743     6   s    s                   qc(i,j)=qc(i,j)+cnd(i,j)
            2744     6   p    s               endif
            2745     6   s    s                if (tair(i,j) .le. 258.16) then
            2746     6               !c             cnd(i,j)=0.0
            2747     6   s    s                 y2(i,j)=1./(tair(i,j)-c76)
            2748     6   s    s                 qsi(i,j)=rp0*exp(c218-c580*y2(i,j))
            2749     6   s    s                dd1(i,j)=cp580*y2(i,j)*y2(i,j)
            2750     6   s    s               dep(i,j)=(qv(i,j)+qb0-qsi(i,j))/(1.+ascp*dd1(i,j)*qsi(i,j))
            2751     6               !c    ******   deposition or sublimation of qi    ******
            2752     6   m    s                   dep(i,j)=max(-qi(i,j),dep(i,j))
            2753     6   s    s                   pt(i,j)=pt(i,j)+ascp*dep(i,j)
            2754     6   s    s                   qv(i,j)=qv(i,j)-dep(i,j)
            2755     6   s    s                   qi(i,j)=qi(i,j)+dep(i,j)
            2756     6   p    s               endif
            2757     5               !JJS       enddo
            2758     5               !JJS       enddo
            2759     5   p    s            endif
            2760     4               
            2761     4               !c
            2762     4               !
            2763     4               !* 10 * PSDEP : DEPOSITION OR SUBLIMATION OF QS                   **10**
            2764     4               !* 20 * PGSUB : SUBLIMATION OF QG                                 **20**
            2765     4               
            2766     4               !JJS         DO 275 J=3,JLES
            2767     4               !JJS         DO 275 I=3,ILES
            2768     4               
            2769     4   p    s                  psdep(i,j)=0.0
            2770     4   p    s                  pgdep(i,j)=0.0
            2771     4   p    s                  pssub(i,j)=0.0
            2772     4   p    s                  pgsub(i,j)=0.0
            2773     4   s    s                  tair(i,j)=(pt(i,j)+tb0)*pi0
            2774     4               
            2775     5   s    s                  if(tair(i,j).lt.t0) then
            2776     5   s    s                     if(qs(i,j).lt.cmin1) qs(i,j)=0.0
            2777     5   s    s                     if(qg(i,j).lt.cmin1) qg(i,j)=0.0
            2778     5   s    s                     rtair(i,j)=1./(tair(i,j)-c76)
            2779     5   s    s                     qsi(i,j)=rp0*exp(c218-c580*rtair(i,j))
            2780     5   s    s                     ssi(i,j)=(qv(i,j)+qb0)/qsi(i,j)-1.
            2781     5               !ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
            2782     5   s    s                     y1(i,j)=r10ar/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            2783     5                                     *qsi(i,j))
            2784     5   s    s                     y2(i,j)=.78/zs(i,j)**2+r101f*scv(i,j)/zs(i,j)**bsh5
            2785     5   s    s                     psdep(i,j)=r10t*ssi(i,j)*y2(i,j)/y1(i,j)
            2786     5   s    s                     pssub(i,j)=psdep(i,j)
            2787     5   s    s                     psdep(i,j)=r2is*max(psdep(i,j), 0.)
            2788     5   s    s                     pssub(i,j)=r2is*max(-qs(i,j), min(pssub(i,j), 0.))
            2789     5               
            2790     6   m    s                     if(ihail.eq.1) then
            2791     6   m    m                        y2(i,j)=.78/zg(i,j)**2+r20bq*scv(i,j)/zg(i,j)**bgh5
            2792     6   s    s                     else
            2793     6   m    s                        y2(i,j)=.78/zg(i,j)**2+r20bs*scv(i,j)/zg(i,j)**bgh5
            2794     6   s    s                     endif
            2795     5               
            2796     5   s    s                     pgsub(i,j)=r2ig*r20t*ssi(i,j)*y2(i,j)/y1(i,j)
            2797     5   s    s                     dm(i,j)=qv(i,j)+qb0-qsi(i,j)
            2798     5   s    s                     rsub1(i,j)=cs580*qsi(i,j)*rtair(i,j)*rtair(i,j)
            2799     5               
            2800     5               !     ********   DEPOSITION OR SUBLIMATION OF QS  **********************
            2801     5               
            2802     5   s    s                     y1(i,j)=dm(i,j)/(1.+rsub1(i,j))
            2803     5   s    s                     psdep(i,j)=r2is*min(psdep(i,j),max(y1(i,j),0.))
            2804     5   s    s                     y2(i,j)=min(y1(i,j),0.)
            2805     5   s    s                     pssub(i,j)=r2is*max(pssub(i,j),y2(i,j))
            2806     5               
            2807     5               !     ********   SUBLIMATION OF QG   ***********************************
            2808     5               
            2809     5   s    s                     dd(i,j)=max((-y2(i,j)-qs(i,j)), 0.)
            2810     5   s    s                    pgsub(i,j)=r2ig*min(dd(i,j), qg(i,j), max(pgsub(i,j),0.))
            2811     5               
            2812     6   m    s                     if(qc(i,j)+qi(i,j).gt.1.e-5) then
            2813     6   m    m                        dlt1(i,j)=1.
            2814     6   s    s                     else
            2815     6   m    s                        dlt1(i,j)=0.
            2816     6   s    s                     endif
            2817     5               
            2818     5   s    s                     psdep(i,j)=dlt1(i,j)*psdep(i,j)
            2819     5   s    s                     pssub(i,j)=(1.-dlt1(i,j))*pssub(i,j)
            2820     5   s    s                     pgsub(i,j)=(1.-dlt1(i,j))*pgsub(i,j)
            2821     5               
            2822     5   s    s                     pt(i,j)=pt(i,j)+ascp*(psdep(i,j)+pssub(i,j)-pgsub(i,j))
            2823     5   s    s                     qv(i,j)=qv(i,j)+pgsub(i,j)-pssub(i,j)-psdep(i,j)
            2824     5   s    s                     qs(i,j)=qs(i,j)+psdep(i,j)+pssub(i,j)
            2825     5   s    s                     qg(i,j)=qg(i,j)-pgsub(i,j)
            2826     5   p    s                  endif
            2827     4               
            2828     4               !* 23 * ERN : EVAPORATION OF QR (SUBSATURATION)                   **23**
            2829     4               
            2830     4   p    s                  ern(i,j)=0.0
            2831     4               
            2832     5   s    s                  if(qr(i,j).gt.0.0) then
            2833     5   s    s                     tair(i,j)=(pt(i,j)+tb0)*pi0
            2834     5   s    s                     rtair(i,j)=1./(tair(i,j)-c358)
            2835     5   s    s                     qsw(i,j)=rp0*exp(c172-c409*rtair(i,j))
            2836     5   s    s                     ssw(i,j)=(qv(i,j)+qb0)/qsw(i,j)-1.0
            2837     5   s    s                     dm(i,j)=qv(i,j)+qb0-qsw(i,j)
            2838     5   s    s                     rsub1(i,j)=cv409*qsw(i,j)*rtair(i,j)*rtair(i,j)
            2839     5   s    s                     dd1(i,j)=max(-dm(i,j)/(1.+rsub1(i,j)), 0.0)
            2840     5   s    s                     y1(i,j)=.78/zr(i,j)**2+r23af*scv(i,j)/zr(i,j)**bwh5
            2841     5   s    s                     y2(i,j)=r23br/(tca(i,j)*tair(i,j)**2)+1./(dwv(i,j) &
            2842     5                                      *qsw(i,j))
            2843     5               !cccc
            2844     5   s    s                     ern(i,j)=r23t*ssw(i,j)*y1(i,j)/y2(i,j)
            2845     5   s    s                     ern(i,j)=min(dd1(i,j),qr(i,j),max(ern(i,j),0.))
            2846     5   p    s                     pt(i,j)=pt(i,j)-avcp*ern(i,j)
            2847     5   p    s                     qv(i,j)=qv(i,j)+ern(i,j)
            2848     5   s    s                     qr(i,j)=qr(i,j)-ern(i,j)
            2849     5   p    s                  endif
            2850     4               
            2851     4               !JJS 10/7/2008     vvvvv
            2852     4   p    v          ENDIF    ! part of if (iwarm.eq.1) then
            2853     3               !JJS 10/7/2008     ^^^^^
            2854     3               
            2855     3               !            IF (QV(I,J)+QB0 .LE. 0.) QV(I,J)=-QB0
            2856     3   s    s                  if (qc(i,j) .le. cmin1) qc(i,j)=0.
            2857     3   m    m                  if (qr(i,j) .le. cmin1) qr(i,j)=0.
            2858     3   p    m                  if (qi(i,j) .le. cmin1) qi(i,j)=0.
            2859     3   m    m                  if (qs(i,j) .le. cmin1) qs(i,j)=0.
            2860     3   m    m                  if (qg(i,j) .le. cmin1) qg(i,j)=0.
            2861     3   p    v                  dpt(i,j,k)=pt(i,j)
            2862     3   p    v                  dqv(i,j,k)=qv(i,j)
            2863     3   s    s                  qcl(i,j,k)=qc(i,j)
            2864     3   s    s                  qrn(i,j,k)=qr(i,j)
            2865     3   p    v                  qci(i,j,k)=qi(i,j)
            2866     3   s    s                  qcs(i,j,k)=qs(i,j)
            2867     3   s    s                  qcg(i,j,k)=qg(i,j)
            2868     3               
            2869     3               !JJS  275    CONTINUE
            2870     3               
            2871     3   p    v               scc=0.
            2872     3   p    v               see=0.
            2873     3               
            2874     3               !         DO 110 J=3,JLES
            2875     3               !         DO 110 I=3,ILES
            2876     3               !            DD(I,J)=MAX(-CND(I,J), 0.)
            2877     3               !            CND(I,J)=MAX(CND(I,J), 0.)
            2878     3               !            DD1(I,J)=MAX(-DEP(I,J), 0.)
            2879     3               
            2880     3               !ccshie 2/21/02 shie follow tao
            2881     3               !CC for reference    QI(I,J)=QI(I,J)-Y2(I,J)+PIDEP(I,J)*D2T
            2882     3               !CC for reference    QV(I,J)=QV(I,J)-(PIDEP(I,J))*D2T
            2883     3               
            2884     3               !c            DEP(I,J)=MAX(DEP(I,J), 0.)
            2885     3               !            DEP(I,J)=MAX(DEP(I,J), 0.)+PIDEP(I,J)*D2T

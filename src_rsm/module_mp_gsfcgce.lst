            3289                     real function gamma_toshi(x)
            3290                     !---------------------------------------------------------------------------------------------------
            3291                     ! Comments:
            3292                     !   compute the gamma function T(x) for single precision floating point.
            3293                     !       input :  x  --- argument of a(x)
            3294                     !                       ( x is not equal to 0,-1,-2,... )
            3295                     !
            3296                     ! History:
            3297                     ! 09/2009  Toshi Matsui@NASA GSFC ; Adapted to SDSU
            3298                     !
            3299                     ! References:
            3300                     !----------------------------------------------------------------------------------------------------
            3301                      implicit double precision (a-h,o-z)
            3302                      dimension g(26)
            3303                      data g/1.0d0,0.5772156649015329d0, &
            3304                            -0.6558780715202538d0, -0.420026350340952d-1, &
            3305                             0.1665386113822915d0,-.421977345555443d-1, &
            3306                             -.96219715278770d-2, .72189432466630d-2, &
            3307                             -.11651675918591d-2, -.2152416741149d-3, &
            3308                             .1280502823882d-3, -.201348547807d-4, &
            3309                             -.12504934821d-5, .11330272320d-5, &
            3310                             -.2056338417d-6, .61160950d-8, &
            3311                              .50020075d-8, -.11812746d-8, &
            3312                             .1043427d-9, .77823d-11, &
            3313                             -.36968d-11, .51d-12, &
            3314                             -.206d-13, -.54d-14, .14d-14, .1d-15/
            3315                      real :: x
            3316                     
            3317                      pi=3.141592653589793d0
            3318     1                if (x.eq.int(x)) then
            3319     2                    if (x.gt.0.0d0) then
            3320     2                        ga=1.0d0
            3321     2                        m1=int(x)-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3322     3  pp    v              do k=2,m1
            3323     3   p    v                 ga=ga*k
            3324     3   p    v              enddo
            3325     2                    else
            3326     2                       ga=1.0d+300
            3327     2                    endif
            3328     1                 else
            3329     2                    if (dabs(dble(x)).gt.1.0d0) then
            3330     2                        z=dabs(dble(x))
            3331     2                        m=int(z)
            3332     2                        r=1.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3333     3  pp    v              do k=1,m
            3334     3   p    v                 r=r*(z-k)
            3335     3   p    v              enddo
            3336     2                       z=z-m
            3337     2                    else
            3338     2                       z=dble(x)
            3339     2                    endif
            3340     1                    gr=g(26)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      g
                                   <<< Loop-information  End >>>
            3341     2   s   4s           do k=25,1,-1
            3342     2   s   4s              gr=gr*z+g(k)
            3343     2   s   4s           enddo
            3344     1                    ga=1.0d0/(gr*z)
            3345     2                    if (dabs(dble(x)).gt.1.0d0) then
            3346     2                        ga=ga*r
            3347     2                        if (x.lt.0.0d0) ga=-pi/(x*ga*dsin(pi*x))
            3348     2                    endif
            3349     1                 endif
            3350                     
            3351                       gamma_toshi = real(ga)
            3352                     
            3353                       end function gamma_toshi

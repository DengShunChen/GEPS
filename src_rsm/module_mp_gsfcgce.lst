            2941     3               !           physs(i,k,j) = physs(i,k,j) + ascp * ssss
            2942     3               !           physf(i,k,j) = physf(i,k,j) + afcp * sfff
            2943     3               !           physm(i,k,j) = physm(i,k,j) + afcp * smmm
            2944     3               
            2945     3               !JJS modified by JJS on 5/1/2007  ^^^^^
            2946     3               
            2947     3               #ifdef EffectRad_GCE3
            2948     3               !xb141 20230525 : code from GCE 4ICE
            2949     3               !JJS 20140305 vvvvv  Calculate effective radius for all cloud species
            2950     3               !   eff_rad is a function of the slope parameter (Lambda)
            2951     3               
            2952     3                     ! rain
            2953     4   m    s            if (qrn(i,j,k) .lt. cmin) then
            2954     4   p    s               re_rain_gsfc(i,k,j) = 0.
            2955     4   s    s            else
            2956     4   mi   s               re_rain_gsfc(i,k,j) = eff_rad(zr(i,j))
            2957     4   p    v            endif
            2958     3               
            2959     3                     ! snow
            2960     4   m    s            if (qcs(i,j,k) .lt. cmin) then
            2961     4   p    s               re_snow_gsfc(i,k,j) = 0.e0
            2962     4   s    s            else
            2963     4   mi   s               re_snow_gsfc(i,k,j) = eff_rad(zs(i,j))
            2964     4   p    v            endif
            2965     3               
            2966     3                     ! graupel
            2967     4   m    s            if (qcg(i,j,k) .lt. cmin) then
            2968     4   p    s               re_graupel_gsfc(i,k,j) = 0.e0
            2969     4   s    s            else
            2970     4   mi   s               re_graupel_gsfc(i,k,j) = eff_rad(zg(i,j))
            2971     4   p    v            endif
            2972     3               
            2973     3                     ! cloud water
            2974     4   m    s            if (qcl(i,j,k) .lt. cmin) then
            2975     4   p    s               re_cloud_gsfc(i,k,j) = 0.e0
            2976     4   s    s            else
            2977     4   p    s               L_cloud = qcl(i,j,k) * rho(i,j,k)             ! cloud water [g/cm3]
            2978     4                        ! Not running with WRF_Chem
            2979     4                           ! ccn_over_land = 1500  ! [#/cm3] climatological value
            2980     4                           ! ccn_over_water = 150  ! [#/cm3] climatological value
            2981     5   m    s                  if (xland(i,j) .eq. 1.0) then
            2982     5   s    s                     ccn_ref = ccn_over_land
            2983     5   m    s                  else if (xland(i,j) .eq. 2.0) then
            2984     5   m    s                     ccn_ref = ccn_over_water
            2985     5   s    s                  else
            2986     5   m    s                     print *,' xland is not 1. or 2., run stopped'
            2987     5                              ! EMK NUWRF
            2988     5               !               call wrf_error_fatal(' xland is not 1. or 2., run stopped')
            2989     5               !               stop
            2990     5   s    s                  endif
            2991     4                          ! for cloud water, estimate lambda (slope of gamma distribution)
            2992     4   s    s                         mu = min(15.e0, (1000.E0/ccn_ref + 2.e0))
            2993     4   m    s                         gamfac3 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+3.e0) )
            2994     4   m    s                         gamfac1 = ( gamma_toshi(mu+4.e0) / gamma_toshi(mu+1.e0) )
            2995     4   m    s                         lambda = (4.e0/3.e0*cpi*roqr*ccn_ref/L_cloud*   &
            2996     4                                           gamfac1)**(1.e0/3.e0)  ! [1/cm]
            2997     4   p    s                         re_cloud_gsfc(i,k,j) = 1.e0/lambda * gamfac3 * 1.e4  !effective radius [micron]
            2998     4   p    v            endif ! qcl(i,k) < cmin test
            2999     3               
            3000     3                     ! cloud ice
            3001     4   p    s            if (qci(i,j,k) .lt. cmin) then
            3002     4   p    s               re_ice_gsfc(i,k,j) = 0.e0
            3003     4   p    s            else
            3004     4                       ! Not running with WRF_Chem
            3005     4                       ! for cloud ice effective radius depends on temperature profile, formula from GCE
            3006     4   p    s               re_ice_gsfc(i,k,j) = 125.e0 +(tair(i,j)-243.16)*5.e0     ! [micron]
            3007     4   p    s               if (tair(i,j) .gt. 243.16) re_ice_gsfc(i,k,j) = 125.e0
            3008     4   p    s               if (tair(i,j) .lt. 223.16) re_ice_gsfc(i,k,j) = 25.e0
            3009     4   p    v            endif ! qci(i,k) < cmin test
            3010     3               #endif
            3011     3               
            3012     2   p    v       2000 continue
            3013     1               
            3014     1                1000 continue

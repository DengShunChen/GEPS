             218                     
             219     1                     IF (NCALL .EQ. 0) THEN
             220     1               !..Set these variables needed for computing radar reflectivity.  These
             221     1               !.. get used within radar_init to create other variables used in the
             222     1               !.. radar module.
             223     1                        xam_r = 3.14159*rhowater/6.
             224     1                        xbm_r = 3.
             225     1                        xmu_r = 0.
             226     1                        xam_s = 3.14159*rhosnow/6.
             227     1                        xbm_s = 3.
             228     1                        xmu_s = 0.
             229     2                        if (ihail .eq. 1) then
             230     2                           xam_g = 3.14159*rhohail/6.
             231     2                        else
             232     2                           xam_g = 3.14159*rhograul/6.
             233     2                        endif
             234     1                        xbm_g = 3.
             235     1                        xmu_g = 0.
             236     1               
             237     1                        call radar_init
             238     1                        NCALL = 1
             239     1                     ENDIF
             240                     !+---+-----------------------------------------------------------------+
             241                     
             242                     !
             243                     !c  ihail = 0    for graupel, for tropical region
             244                     !c  ihail = 1    for hail, for mid-lat region
             245                     
             246                     ! itaobraun: 0 for Tao's constantis, 1 for Braun's constants
             247                     !c        if ( itaobraun.eq.1 ) --> betah=0.5*beta=-.46*0.5=-0.23;   cn0=1.e-6
             248                     !c        if ( itaobraun.eq.0 ) --> betah=0.5*beta=-.6*0.5=-0.30;    cn0=1.e-8
             249                        itaobraun = 1
             250                     
             251                     !c  ice2 = 0    for 3 ice --- ice, snow and graupel/hail

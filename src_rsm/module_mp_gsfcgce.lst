            2895     3               !c     henry:  please take a look  (start)
            2896     3               !JJS modified by JJS on 5/1/2007  vvvvv
            2897     3               
            2898     3               !JJS       do 305 j=3,jles
            2899     3               !JJS       do 305 i=3,iles
            2900     3   p    v                  dd(i,j)=max(-cnd(i,j), 0.)
            2901     3   p    v                  cnd(i,j)=max(cnd(i,j), 0.)
            2902     3   p    v                  dd1(i,j)=max(-dep(i,j), 0.)+pidep(i,j)*d2t
            2903     3   p    v                  dep(i,j)=max(dep(i,j), 0.)
            2904     3               !JJS  305  continue
            2905     3               
            2906     3               !JJS       do 306 j=3,jles
            2907     3               !JJS       do 306 i=3,iles
            2908     3               !JJS              scc=scc+cnd(i,j)
            2909     3               !JJS              see=see+(dd(i,j)+ern(i,j))
            2910     3               !
            2911     3               !JJS            sddd=sddd+(dep(i,j)+pint(i,j)+psdep(i,j)+pgdep(i,j))
            2912     3               !JJS          ssss=ssss+dd1(i,j)
            2913     3               !JJS
            2914     3               !            shhh=shhh+rsw(i,j,k)*d2t
            2915     3               !            sccc=sccc+rlw(i,j,k)*d2t
            2916     3               !jjs
            2917     3               !JJS              smmm=smmm+(psmlt(i,j)+pgmlt(i,j)+pimlt(i,j))
            2918     3               !JJS              sfff=sfff+d2t*(psacw(i,j)+piacr(i,j)+psfw(i,j)
            2919     3               !JJS     1         +pgfr(i,j)+dgacw(i,j)+dgacr(i,j)+psacr(i,j))
            2920     3               !JJS     2        -qracs(i,j)+pihom(i,j)+pidw(i,j)
            2921     3               
            2922     3               
            2923     3   s    s                    sccc=cnd(i,j)
            2924     3   s    s                    seee=dd(i,j)+ern(i,j)
            2925     3   s    s                    sddd=dep(i,j)+pint(i,j)+psdep(i,j)+pgdep(i,j)
            2926     3   s    s                    ssss=dd1(i,j) + pgsub(i,j)
            2927     3   s    s                    smmm=psmlt(i,j)+pgmlt(i,j)+pimlt(i,j)
            2928     3   s    s                    sfff=d2t*(psacw(i,j)+piacr(i,j)+psfw(i,j) &
            2929     3                              +pgfr(i,j)+dgacw(i,j)+dgacr(i,j)+psacr(i,j) &
            2930     3                              +wgacr(i,j))+pihom(i,j)+pidw(i,j)
            2931     3               

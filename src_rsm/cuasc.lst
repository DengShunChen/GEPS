             184     2   p    v            zbuoy(jl) = g*(ptu(jl,ikb)-ptenh(jl,ikb))/ptenh(jl,ikb) + &
             185     2                                 g*0.608*(pqu(jl,ikb)-pqenh(jl,ikb))
             186     3   p    v            IF (zbuoy(jl)>0.) THEN
             187     3   p    v              zdz = (pgeo(jl,ikb-1)-pgeo(jl,ikb))/g
             188     3   p    v              zdrodz = -LOG(pten(jl,ikb-1)/pten(jl,ikb))/zdz - g/(rd*ptenh(jl,ikb))
             189     3                       ! nb zoentr is here a fractional value
             190     3   p    v              zoentr(jl,ikb-1) = zbuoy(jl)*0.5/(1.+zbuoy(jl)*zdz) + zdrodz
             191     3   p    v              zoentr(jl,ikb-1) = MIN(zoentr(jl,ikb-1),3.d-4)

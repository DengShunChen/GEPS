                                   <<<      pdmfup, plude, pmful, pmfuq, klab, pmfus
                                   <<<      plu, pmfu, kctop0
                                   <<< Loop-information  End >>>
             131     1                 DO jk = 1, klev
             132     1               !    DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 133,148)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.32, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      paphp1, ktype, zodetr, zoentr, ldcum
                                   <<<      klab, kctop0, pdmfup, plude, pmful
                                   <<<      pmfuq, pmfus, pmfu, plu
                                   <<< Loop-information  End >>>
             133     2  pp    v          DO jl = 1, nxj
             134     2   p    v            plu(jl,jk) = 0.
             135     2   p    v            pmfu(jl,jk) = 0.
             136     2   p    v            pmfus(jl,jk) = 0.
             137     2   p    v            pmfuq(jl,jk) = 0.

             141     2   p    v            IF ( .NOT. ldcum(jl) .OR. ktype(jl)==3) klab(jl,jk) = 0
             142     2   p    v            IF ( .NOT. ldcum(jl) .AND. paphp1(jl,jk)<4.E4) kctop0(jl) = jk

             115                     
             116                     !-- 1. Specify parameters
             117                     
             118                       prec  = EPSILON(0.0d0)
             119                       ztmst = ztodt*0.5
             120                     ! IF (is_first_step()) ztmst = 0.5*ztodt
             121                       zcons2 = 1./(g*ztmst)
             122                     
             123                     !-- 2. Set default values
             124                     
             125                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

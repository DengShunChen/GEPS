             227     4   p    v                pmfu(jl,jk+1) = pmfu(jl,jk+1)*zfac
             228     4   p    v                pmfus(jl,jk+1) = pmfus(jl,jk+1)*zfac
             229     4   p    v                pmfuq(jl,jk+1) = pmfuq(jl,jk+1)*zfac

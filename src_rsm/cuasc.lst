                                   <<<      pmfuq, kctop
                                   <<< Loop-information  End >>>
             157     1  pp    v        DO jl = 1, nxj
             158     1   p    v          kctop(jl) = klevm1
             159     2   p    v          IF ( .NOT. ldcum(jl)) THEN
             160     2   p    v            kcbot(jl) = klevm1
             161     2   p    v            pmfub(jl) = 0.
             162     2   p    v            pqu(jl,klev) = 0.
             163     2   p    v          END IF
             164     1   p    v          pmfu(jl,klev) = pmfub(jl)
             165     1   p    v          pmfus(jl,klev) = pmfub(jl)*(cpd*ptu(jl,klev)+pgeoh(jl,klev))
             166     1   p    v          pmfuq(jl,klev) = pmfub(jl)*pqu(jl,klev)
             167     2   p    v          IF (lmfdudv) THEN

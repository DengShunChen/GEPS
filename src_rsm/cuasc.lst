               3                     !SUBROUTINE cuasc(klon,klev,klevp1,klevm1,ptenh,pqenh,pxenh,puen,                  &
               4                     SUBROUTINE cuasc(nxj,klon,klev,klevp1,klevm1,ptenh,pqenh,pxenh,puen,                  &
               5                                      pven,pten,pqen,pqsen,pgeo,pgeoh,papp1,       &
               6                                      paphp1,pverv,klwmin,ldcum,ldland,ktype,klab,ptu,pqu,plu,puu,pvu,pmfu,pmfub, &
               7                                      pentr,pmfus,pmfuq,pmful,plude,pdmfup,khmin,phhatt,phcbase,pqsenh,kcbot,     &
               8                                      kctop,kctop0,kcum,ztodt,eu,du)
               9                     
              10                       ! ---------------> ldland included for AMIP2 !!
              11                     
              12                       ! Description:
              13                       !
              14                       ! Does the calculations for cloud ascents for cumulus parameterization.
              15                       !
              16                       ! Method:
              17                       !
              18                       ! Produce cloud ascents for cu-parametrization
              19                       ! (vertical profiles of t,q,l,u and v and corresponding
              20                       ! fluxes as well as precipitation rates)
              21                       !
              22                       ! This routine is called from *cumastr*.
              23                       !
              24                       ! Lift surface air dry-adiabatically to cloud base and then calculate
              25                       ! moist ascent for entraining/detraining plume.
              26                       ! Entrainment and detrainment rates differ for shallow and deep cumulus
              27                       ! convection.
              28                       ! In case there is no penetrative or shallow convection check for
              29                       ! possibility of mid level convection (cloud base values calculated in
              30                       ! *cubasmc*)
              31                       !
              32                       ! Externals:
              33                       !    *cuadjtq*  adjust t and q due to condensation in ascent
              34                       !    *cuentr*   calculate entrainment/detrainment rates
              35                       !    *cubasmc*  calculate cloud base values for midlevel convection
              36                       !
              37                       ! Authors:
              38                       !
              39                       ! M. Tiedtke, ECMWF, in July 1986 and December 1989, original source
              40                       ! L. Kornblueh, MPI, May 1998, f90 rewrite
              41                       ! U. Schulzweida, MPI, May 1998, f90 rewrite
              42                       !
              43                       ! for more details see file AUTHORS
              44                       !
              45                       USE shr_kind_mod, only: r8 => shr_kind_r8
              46                     ! USE time_manager,     ONLY: is_first_step,         &! initial run
              47                     !                             is_first_restart_step, &! restart run
              48                     !                             get_step_size           ! step size
              49                       USE mo_constants,     ONLY: g,       & ! gravity acceleration
              50                                                   cpd,     & ! specific heat at constant pressure

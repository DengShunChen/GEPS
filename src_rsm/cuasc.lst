             178                     !-- 3.1 Find organized entrainment at cloud base
             179                     
             180                     !  DO jl = 1, klon
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 36

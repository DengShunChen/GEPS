             126     1  pp   2v        DO jl = 1, nxj
             127     1   p   2v          zmfuu(jl) = 0.
             128     1   p   2v          zmfuv(jl) = 0.
             129     1   p   2v          IF ( .NOT. ldcum(jl)) ktype(jl) = 0

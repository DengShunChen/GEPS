              52                                                   rv,      & !   idem      for water vapour
              53                                                   alv,     & ! latent heat for vaporisation
              54                                                   vtmpc1,  & ! vtmpc1=rv/rd-1
              55                                                   rcpd       ! rcpd=1./cpd
              56                       USE mo_cumulus_flux,  ONLY: lmfdudv, & !
              57                                                   lmfmid,  & !
              58                                                   cmfcmin, & !
              59                                                   cprcon,  & !
              60                                                   cmfctop
              61                     ! USE mo_machine,       ONLY: prec
              62                     
              63                       IMPLICIT NONE
              64                     

             808                     
             809                     !
             810                     !  the gaussian quadrature loop for spectral tendencies.  subroutine
             811                     !  'gridnl' is called for companion mirror image gaussian latitudes
             812                     !  these non-linear contributions are then combined in 'rstran' using
             813                     !  the symmetry properties of the spherical harmonics
             814                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 26  FILL 43
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             815     1                     do jj = 1, jlistnum
             816     1               
             817     1                       j=jlist1(jj)
             818     1                       nxj=nxdef_2d(j)
             819     1               !
             820     1               !   new p**capa quantities were computed in previous diabat call
             821     1               !
             822     1                       if (.not.yesdia) call prexp_hybrid_cwb ( nxjp(j),nxp,lev,ptop,sigma,pt(1,jj), &
             823     1                                              pk(1,1,jj),pk2(1,1,jj),plt(1,1,jj) )
             824     1               !
             825     1               !
             826     1               !       Calculate Vertical velocity & Stream Functions
             827     1               !
             828     1                       call gridnl_hybrid_ndsl (nxjp(j),nxp,lev,ncld                  &
             829     1                       , cp,radsq,ut(1,1,jj),vt(1,1,jj),rdiv(1,1,jj),tt(1,1,jj)       &
             830     1                       , qt(1,1,jj),phi(1,1,jj),pt(1,jj),dtpl(1,jj),dlpl(1,jj),sinl(j)&
             831     1                       , pk(1,1,jj),pk2(1,1,jj),dsigma,sigma,onocos(j),cor(j)         &
             832     1                       , diveng(1,1,jj),vdmerdr(1,1,jj),vdzonlr(1,1,jj),pten(1,1,jj)  &
             833     1                       , deldm(1,jj),sdpbl(1,jj),sd(1,1,jj),pdot(1,1,jj),vvel(1,1,jj) &
             834     1                       , sgeo(1,jj) )
             835     1               !
             836     1                     enddo !jj = 1,jlistnum
             837                     
             838                             call joinrs(cc,diveng,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             839                             call tranrs(jtrun,jtmax,nx,my,my_max,levp,poly,weight,cc       &
             840                                        ,hldten,1,nsizey)

                                   <<<      vdzonl, ddtempr, vdmerdr, vdzonlr
                                   <<< Loop-information  End >>>
             865     3   p    v                do i = 1,nxj
             866     3   p    v                  vdzonlr(i,k,jj) = up(i,k,jj)
             867     3   p    v                  vdmerdr(i,k,jj) = vp(i,k,jj)
             868     3   p    v                  ddtempr(i,k,jj) = ttp(i,k,jj)
             869     3   p    v                  up(i,k,jj) = ut(i,k,jj)
             870     3   p    v                  vp(i,k,jj) = vt(i,k,jj)
             871     3   p    v                  ttp(i,k,jj)= tt(i,k,jj)
             872     3   p    v                  ut(i,k,jj) = vdzonl(i,k,jj)
             873     3   p    v                  vt(i,k,jj) = vdmerd(i,k,jj)
             874     3   p    v                  tt(i,k,jj) = ddtemp(i,k,jj)
             875     3               !!            uum(i,k,jj)= ut(i,k,jj)

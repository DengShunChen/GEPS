                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, ptp
                                   <<< Loop-information  End >>>
             861     1                     do jj = 1, jlistnum
             862     1                       j=jlist1(jj)
             863     1                       nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vdmerd, ddtemp, vdzonl, tt, ttp, vt, ut
                                   <<<      vp, up, ddtempr, vdmerdr, vdzonlr
                                   <<< Loop-information  End >>>
             864     2  pp                   do k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.17, ITR: 48, MVE: 2, POL: S)

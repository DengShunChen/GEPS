             852                     
             853                     
             854                             call mpe2d_unify_nx(ww1,deldm)
             855                             call tranrs1(jtrun,jtmax,nx,my,my_max,poly,weight,ww1         &
             856                                      ,plten,nsizey)
             857                     !
             858                     !  before a time step,save previous time u,v,t,q as

                                   <<<      plten, plold, pltemp
                                   <<< Loop-information  End >>>
             893     1  pp                 do m = 1, mlistnum
             894     1   p                   mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 56, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plten, plold, pltemp
                                   <<< Loop-information  End >>>
             895     2   p    v              do n = mf, jtrun
             896     2   p    v                pltemp(n,m,1)= dta*plten(n,m,1)+plold(n,m,1)
             897     2   p    v                pltemp(n,m,2)= dta*plten(n,m,2)+plold(n,m,2)
             898     2   p    v              enddo
             899     1   p                 enddo
             900                     !
             901                     !
             902                     !  for physical parameterization,output spectrum u,v,t,q to grid point
             903                     !
             904                             call transr1(jtrun,jtmax,nx,my,my_max,poly,pltemp,pt,nsizey)
             905                     !
             906                                 sumtot=0.
             907                           sumwat=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sumwatt, sumtott
                                   <<< Loop-information  End >>>
             908        pp   2v            sumtott=0.
             909         p   2v            sumwatt=0.
             910     1                     do jj = 1, jlistnum
             911     1                       j=jlist1(jj)
             912     1                       nxj=nxdef_2d(j)
             913     1                       nxjf=nxdef(j)
             914     2                       do i = 1,nxj
             915     3                         do k = 1, lev
             916     3                           dsigp = dsigma(k,1)*pt(i,jj)+dsigma(k,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qtot
                                   <<< Loop-information  End >>>
             917     3  pp   4v                  qtot=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<< Loop-information  End >>>
             918     4  pp    v                  do n = 1, ncld-1
             919     4   p    v                     kk=k+(n-1)*lev
             920     4   p    v                     qtot(i,jj)=qtot(i,jj)+qt(i,kk,jj)
             921     4   p    v                  enddo
             922     3                           sumtott(i,jj) = sumtott(i,jj)+dsigp
             923     3                           sumwatt(i,jj) = sumwatt(i,jj)+dsigp*qtot(i,jj)

               1                           subroutine sfc_diag(imj,im,ps,u1,v1,t1,q1,                   &
               2                     !    &                    tskin,qsurf,f10m,u10m,v10m,t2m,q2m,      &
               3                                               tskin,qsurf,u10m,v10m,t2m,q2m, &
               4                                               prslki,evap,fm,fh,fm10,fh2,fh10,rh2,rh10)
               5                     !
               6                           use machine , only : kind_phys
               7                     !     use funcphys, only : fpvs
               8                           use physcons, grav => con_g,  cp => con_cp, &
               9                                         eps => con_eps, epsm1 => con_epsm1
              10                           use const,    only : RTYPE
              11                           implicit none
              12                     !
              13                           integer              im,imj
              14                           real(kind=RTYPE), dimension(im) :: u1,  v1,  t1,  q1
              15                           real, dimension(im) :: ps,   tskin,  qsurf,                       &
              16                                                  f10m, u10m, v10m, t2m, t10m, q2m, q10m,    &
              17                                                  prslki,evap,fm,fh,fh10,fm10,fh2,rh2,rh10
              18                     !
              19                     !     locals
              20                     !
              21                           real (kind=kind_phys), parameter :: qmin=1.0e-8
              22                           integer              k,i
              23                     !
              24                           real(kind=kind_phys)        fhi, qss, wrk,fpvs
              25                     !     real(kind=kind_phys) sig2k, fhi, qss
              26                     !
              27                     !     real, parameter :: g=grav
              28                     !
              29                     !     estimate sigma ** k at 2 m
              30                     !
              31                     !     sig2k = 1. - 4. * g * 2. / (cp * 280.)
              32                     !
              33                     !  initialize variables. all units are supposedly m.k.s. unless specified
              34                     !  ps is in pascals
              35                     !
              36                     !!
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fm10, fm, f10m, u1, u10m, v1, fh, v10m
                                   <<<      fh2, t1, prslki, tskin, t2m, evap, q1
                                   <<<      ps
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      fh10: 2, q2m: 2, rh2: 2, t10m: 2
                                   <<<      q10m: 2, rh10: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 20
                                   <<<      SIMD&FP   : SPILL 4  FILL 4
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              37     1   s    s            do i = 1, imj
              38     1   p    v              f10m(i) = fm10(i) / fm(i)
              39     1               !       f10m(i) = min(f10m(i),1.)
              40     1   p    v              u10m(i) = f10m(i) * u1(i)
              41     1   p    v              v10m(i) = f10m(i) * v1(i)
              42     1   p    v              fhi     = min( fh2(i) / fh(i) , 0.99 )
              43     1               !       t2m(i)  = tskin(i)*(1. - fhi) + t1(i) * prslki(i) * fhi
              44     1               !       sig2k   = 1. - (grav+grav) / (cp * t2m(i))
              45     1               !       t2m(i)  = t2m(i) * sig2k
              46     1   p    v              wrk     = 1.0 - fhi
              47     1               
              48     1   m    m              t2m(i)  = tskin(i)*wrk + t1(i)*prslki(i)*fhi - (grav+grav)/cp
              49     1               
              50     2   p    v              if(evap(i) >= 0.) then !  for evaporation>0, use inferred qsurf to deduce q2m
              51     2   p    v                q2m(i) = qsurf(i)*wrk + max(qmin,q1(i))*fhi
              52     2   p    v              else                   !  for dew formation, use saturated q at tskin
              53     2   s    s                qss    = fpvs(tskin(i))
              54     2   s    s                qss    = eps * qss / (ps(i) + epsm1 * qss)
              55     2   m    m                q2m(i) = qss*wrk + max(qmin,q1(i))*fhi
              56     2   p    v              endif
              57     1   s    s              qss    = fpvs(t2m(i))
              58     1   p    v              qss    = eps * qss / (ps(i) + epsm1 * qss)
              59     1   p    v              q2m(i) = min(q2m(i),qss)
              60     1               !
              61     1   p    v              rh2(i) = max( q2m(i)/qss , 0.)
              62     1               
              63     1   p    v              fhi     = min( fh10(i) / fh(i) , 0.99 )
              64     1   s    s              wrk     = 1.0 - fhi
              65     1   m    m              t10m(i)  = tskin(i)*wrk + t1(i)*prslki(i)*fhi - (grav+grav)/cp
              66     2   p    v              if(evap(i) >= 0.) then !  for evaporation>0, use inferred qsurf to deduce q2m
              67     2   p    v                q10m(i) = qsurf(i)*wrk + max(qmin,q1(i))*fhi
              68     2   p    v              else                   !  for dew formation, use saturated q at tskin
              69     2   s    s                qss    = fpvs(tskin(i))
              70     2   p    v                qss    = eps * qss / (ps(i) + epsm1 * qss)
              71     2   p    v                q10m(i) = qss*wrk + max(qmin,q1(i))*fhi
              72     2   p    v              endif
              73     1   s    s              qss    = fpvs(t10m(i))
              74     1   p    v              qss    = eps * qss / (ps(i) + epsm1 * qss)
              75     1   p    v              q10m(i) = min(q10m(i),qss)
              76     1               !
              77     1   p    v              rh10(i) = max( q10m(i)/qss , 0.)
              78     1               
              79     1   p    v            enddo
              80                     
              81                           return
              82                           end


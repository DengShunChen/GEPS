 External subroutine subprogram "qprint"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine qprint ( a,t1,t2,ic,jc,m,n )
               2                     !
               3                     !  qprint prints an array a(m,n) starting at address a(ic,jc).
               4                     !  values are automatically scaled to allow integer format printing.
               5                     !
               6                     !     a     = input of m x n array
               7                     !     t1,t2 = title 1 and 2  (1 word ascii, or 8 characters for each)
               8                     
               9                     !     ic,jc = lower left corner coords to be printed
              10                     !             ( up to 43 x n points printed )
              11                     !
              12                           implicit  none
              13                           integer   ic,jc,m,n
              14                           real      a(m,n)
              15                           character*8 t1, t2
              16                     
              17                           integer   ix(43),ie,jl,i,j,kp,kpm,ii,jli
              18                           real      xm,af,fk
              19                     !
              20                     !     determine grid limits
              21                     !
              22                           ie = min( ic+42, m )
              23                           jl = n
              24                     !
              25                     !     index backwards checking for max
              26                     !
              27                           xm = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a
                                   <<< Loop-information  End >>>
              28     1  pp                 do 100 j = jc, jl
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.93, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a
                                   <<< Loop-information  End >>>
              29     2   p   4v            do 100 i = ic, ie
              30     2   p   4v            af = a(i,j)
              31     2   p   4v            xm = max( xm, abs(af) )
              32     1   p   4v        100 continue
              33                     !
              34                     !     determine scaling factor limits
              35                     !
              36                           if ( xm .lt. 1.e-200 ) xm=99.0
              37                     !     xm = alog10( 99./xm )
              38                           xm = dlog10( 99./xm ) ! CWB 2015
              39                           kp = xm
              40                           if( xm .lt. 0.0 ) kp = kp-1
              41                     !
              42                     !     print scaling constants
              43                     !
              44                           kpm = - kp
              45              s            print 900, t1, t2, kpm, (i,i=ic,ie,2)
              46                       900 format(1h0,a8,a8,'   k=',i3,2x,'( true=print*10**k )', /1x,22i6)
              47                           fk=10.**kp
              48                     !
              49                     !     quick print field
              50                     !
              51                           ii = ie - ic + 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, (unknown)
                                   <<< Loop-information  End >>>
              52     1                     do 200 j = jc,jl
              53     1                     jli = jl - j + jc
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 224, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, ix
                                   <<< Loop-information  End >>>
              54     2  pp   2v               do 400 i = ic, ie
              55     2   p   2v               af = a(i,jli)
              56     2   p   2v               ix(i-ic+1) = af*fk + sign(.5,af)
              57     2   p   2v        400    continue
              58     1                     print 950, jli, (ix(i),i=1,ii), jli
              59     1                 950 format(i4,44i3)
              60     1                 200 continue
              61                           return
              62                           end


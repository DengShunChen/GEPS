               1                     MODULE mo_constants
               2                     
               3                       use shr_kind_mod, only: r8 => shr_kind_r8
               4                     
               5                       IMPLICIT NONE
               6                     
               7                       ! ----------------------------------------------------------------
               8                       !
               9                       ! module *mo_constants* basic universal constants  and derived constants.
              10                       !
              11                       ! ----------------------------------------------------------------
              12                     
              13                       REAL(r8), PARAMETER :: dayl = 86400.  ! length of the day (in seconds).
              14                     
              15                       REAL(r8) :: api     ! 2.*arcsin(1.).
              16                       REAL(r8) :: a       ! radius of the earth.
              17                       REAL(r8) :: omega   ! solid rotation velocity of the earth.
              18                       REAL(r8) :: g       ! gravity acceleration.
              19                       REAL(r8) :: cpd     ! specific heat at constant pressure (dry air).
              20                       REAL(r8) :: cpv     !            idem               (water vapour).
              21                       REAL(r8) :: rd      ! gas constant for dry air.
              22                       REAL(r8) :: rv      !    idem      for water vapour.
              23                       REAL(r8) :: rcpd    ! rcpd=1./cpd.
              24                       REAL(r8) :: vtmpc1  ! vtmpc1=rv/rd-1.
              25                       REAL(r8) :: vtmpc2  ! vtmpc2=cpv/cpd-1.
              26                       REAL(r8) :: rhoh2o  ! density of liquid water.
              27                       REAL(r8) :: alv     ! latent heat for vaporisation.
              28                       REAL(r8) :: als     ! latent heat for sublimation.
              29                       REAL(r8) :: alf     ! latent heat for fusion.
              30                       REAL(r8) :: clw     ! specific heat for liquid water.
              31                       REAL(r8) :: tmelt   ! temperature of fusion of ice.
              32                       REAL(r8) :: solc    ! solar constant.
              33                       REAL(r8) :: stbo    ! stephan boltzmann constant.
              34                       REAL(r8) :: yearl   ! length of the year (in days).
              35                     
              36                       ! constants used for computation of saturation mixing ratio
              37                       !   over liquid water(*c_les*) or ice(*c_ies*).
              38                     
              39                       REAL(r8) :: c1es    ! 610.78
              40                       REAL(r8) :: c2es    ! 1es*rd/rv
              41                       REAL(r8) :: c3les   ! 17.269
              42                       REAL(r8) :: c3ies   ! 21.875
              43                       REAL(r8) :: c4les   ! 35.86
              44                       REAL(r8) :: c4ies   !  7.66
              45                       REAL(r8) :: c5les   ! c3les*(tmelt-c4les)
              46                       REAL(r8) :: c5ies   ! c3ies*(tmelt-c4ies)
              47                       REAL(r8) :: c5alvcp ! c5les*alv/cpd
              48                       REAL(r8) :: c5alscp ! c5ies*als/cpd
              49                       REAL(r8) :: alvdcp  ! alv/cpd
              50                       REAL(r8) :: alsdcp  ! als/cpd
              51                       REAL(r8) :: zrg
              52                       REAL(r8) :: r5alvcp
              53                       REAL(r8) :: r5alscp
              54                       REAL(r8) :: ralvdcp
              55                       REAL(r8) :: ralsdcp
              56                       REAL(r8) :: ralfdcp
              57                       REAL(r8) :: rtwat
              58                       REAL(r8) :: rtber
              59                       REAL(r8) :: rtice
              60                     
              61                     CONTAINS
              62                     
              63                       SUBROUTINE inicon
              64                     
              65                         ! Description:
              66                         ! Preset constants in mo_constants.
              67                         !
              68                         ! Method:
              69                         !
              70                         ! *inicon* is called from *setdyn*.
              71                         !
              72                         ! Authors:
              73                         !
              74                         ! M. Jarraud, ECMWF, December 1982, original source
              75                         ! L. Kornblueh, MPI, May 1998, f90 rewrite
              76                         ! U. Schulzweida, MPI, May 1998, f90 rewrite
              77                         ! H.-S. Bauer, MPI, Jul 1998, changed
              78                         ! A. Rhodin, MPI, Jan 1999, subroutine inicon put into module mo_constants
              79                         !
              80                         ! for more details see file AUTHORS
              81                         !
              82                     
              83                         IMPLICIT NONE
              84                     
              85                         !  Intrinsic functions
              86                         INTRINSIC ASIN
              87                     
              88                         !  Executable statements
              89                     
              90                         !-- 1. Preset constants
              91                     
              92                         api    = 2.*ASIN(1.)
              93                         a      = 6371000.
              94                         omega  = .7292E-4
              95                         g      = 9.80665
              96                         cpd    = 1005.46
              97                         cpv    = 1869.46
              98                         rd     = 287.05
              99                         rv     = 461.51
             100                     
             101                         rcpd   = 1./cpd
             102                         vtmpc1 = rv/rd - 1.
             103                         vtmpc2 = cpv/cpd - 1.
             104                     
             105                         rhoh2o = 1000.
             106                         alv    = 2.5008E6
             107                         als    = 2.8345E6
             108                         alf    = als - alv
             109                     !    alf    = 3.50E5          !new Tiedtke (MPAS)
             110                     
             111                         clw    = 4186.84
             112                         tmelt  = 273.16
             113                     
             114                         solc   = 1365.
             115                         stbo   = 5.67E-8
             116                     
             117                         c1es    = 610.78
             118                         c2es    = c1es*rd/rv
             119                         c3les   = 17.269
             120                         c3ies   = 21.875
             121                         c4les   = 35.86
             122                         c4ies   =  7.66
             123                         c5les   = c3les*(tmelt-c4les)
             124                         c5ies   = c3ies*(tmelt-c4ies)
             125                         c5alvcp = c5les*alv/cpd
             126                         c5alscp = c5ies*als/cpd
             127                         alvdcp  = alv/cpd
             128                         alsdcp  = als/cpd
             129                     !> xb110
             130                         zrg = 1.0/g
             131                         r5alvcp = c5les*alv*rcpd
             132                         r5alscp = c5ies*als*rcpd
             133                         ralvdcp=alv*rcpd
             134                         ralsdcp=als*rcpd
             135                         ralfdcp=alf*rcpd
             136                         rtwat=tmelt
             137                         rtber=tmelt-5.
             138                         rtice=tmelt-23.
             139                     !< xb110
             140                     
             141                       END SUBROUTINE inicon
             142                     
             143                     END MODULE mo_constants


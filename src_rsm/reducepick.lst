             121                           subroutine reducepickr(a,lonfd,lonf,latg)
             122                     !
             123                     ! pick the reduce-grid value from the nearest regular grid
             124                     ! then fill the tailing points to be the same as the last
             125                     ! reduce-grid point.
             126                     !
             127                           real a(lonf,latg)
             128                           dimension lonfd(latg)
             129                           real,allocatable:: tmp(:)
             130                           allocate(tmp(lonf))
             131                           dg=360./float(lonf)

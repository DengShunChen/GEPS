 External subroutine subprogram "reducepicki"
  (inc)(line-no.)(nest)(optimize)
              62                     !
              63                           subroutine reducepicki(a,lonfd,lonf,latg)
              64                     !
              65                     ! pick the reduce-grid value from the nearest regular grid
              66                     ! then fill the tailing points to be the same as the last
              67                     ! reduce-grid point.
              68                     !
              69                           integer a(lonf,latg)
              70                           dimension lonfd(latg)
              71                           integer,allocatable:: tmp(:)
              72                           allocate(tmp(lonf))
              73                           dg=360./float(lonf)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, a
                                   <<< Loop-information  End >>>
              74     1                     do j=1,latg
              75     1                       dr=360./float(lonfd(j))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 281
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.23, ITR: 208, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp
                                   <<< Loop-information  End >>>
              76     2  pp   2v              do i=1,lonfd(j)
              77     2   p   2v                ii=nint((i-1.)*dr/dg + 1.0)
              78     2   p   2v                tmp(i)=a(ii,j)
              79     2   p   2v              enddo
              80     1                       ii=lonfd(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tmp, a
                                   <<< Loop-information  End >>>
              81     2  pp   2v              do i=1,ii
              82     2   p   2v                a(i,j)=tmp(i)
              83     2   p   2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a
                                   <<< Loop-information  End >>>
              84     2  pp   4v              do i=ii+1,lonf
              85     2   p   4v                a(i,j)=tmp(ii)
              86     2   p   4v              enddo
              87     1                     enddo
              88                           deallocate(tmp)

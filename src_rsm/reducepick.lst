               1                           subroutine reducepick(a,lonfd,lonf,latg)
               2                     !
               3                     ! do  mass conserving interpolation from different grid at given
               4                     ! latitude
               5                     !
               6                     ! author: hann-ming henry juang 2008
               7                     !
               8                           use const, only: RTYPE
               9                     !
              10                           implicit none
              11                     
              12                     !
              13                           integer    lonf,latg,j,i,imp,lonfd(latg)
              14                           real       a(lonf,latg)
              15                     !
              16                           real(kind=RTYPE) old(lonf),new(lonf)
              17                           real(kind=RTYPE) xpast(lonf+1),xnext(lonf+1)
              18                           real      two_pi,dxp,dxf,hfdxp,hfdxf,sc,pi
              19                     !
              20                     
              21                     ! ..................................
              22                     ! ..................................
              23                            pi  = 4.0 * atan(1.0)
              24                            two_pi = 2.0 * pi
              25                            dxf = two_pi / lonf
              26                            hfdxf = 0.5 * dxf
              27                     !$omp parallel do                                       &
              28                     !$omp private(j,i,imp,dxp,hfdxp,xpast,xnext,sc,old,new) &
              29                     !$omp schedule(dynamic)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, (unknown)
                                   <<< Loop-information  End >>>
              30     1   p                 do j=1,latg
              31     1   p                  imp=lonfd(j)
              32     2   p                  if( imp.ne.lonf ) then
              33     2   p                   dxp = two_pi / imp
              34     2   p                   hfdxp = 0.5 * dxp
              35     2               
              36     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
              37     3   p   2v              do i=1,lonf+1
              38     3   p   2v                xpast(i) = (i-1) * dxf - hfdxf
              39     3   p   2v              enddo
              40     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<< Loop-information  End >>>
              41     3   p   2v              do i=1,imp+1
              42     3   p   2v                xnext(i) = (i-1) * dxp - hfdxp
              43     3   p   2v              enddo
              44     2               
              45     2   p                   sc=two_pi
              46     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, (unknown)
                                   <<< Loop-information  End >>>
              47     2   p   2v              old(1:lonf)=a(1:lonf,j)
              48     2               !CWB2021 for ndsl single precision test
              49     2   p                   call cyclic_cell_ppm_intp(xpast,old,xnext,new,lonf,1,lonf,imp,sc)
              50     2               !        call cyclic_cell_ppm_intp_dp(xpast,old,xnext,new,lonf,1,lonf,imp,sc)
              51     2               
              52     2               !        call cyclic_cell_plm_intp(xpast,old,xnext,new,lonf,1,lonf,imp,sc)
              53     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, (unknown)
                                   <<< Loop-information  End >>>
              54     2   p   2v              a(1:imp,j)=new(1:imp)
              55     2   p                  endif
              56     1   p                 enddo
              57                     !$omp end parallel do
              58                     ! .................
              59                     
              60                           return
              61                           end subroutine reducepick


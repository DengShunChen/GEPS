                                   <<< Loop-information  End >>>
            2246     4  pp    v                do ii = 1,nxj
            2247     4   p    v                  i=nxjstart(j)+ii-1
            2248     4   p    v                  dtseadt(ii,jj)=0.
            2249     4   p    v                  dFCTsstdt(ii,jj)=0.
            2250     4   p    v                  obswtbnow(ii,jj)=dta*dFCTsstdt(ii,jj)+obswtbold(ii,jj)
            2251     5   p    v                  if(ocean(ii,jj))then
            2252     5   p    v                    tseadiffFCT(ii,jj)=dta*dFCTsstdt(ii,jj)
            2253     5   p    v                    tseanow(ii,jj)=dta*dFCTsstdt(ii,jj)+ tseaold(ii,jj)
            2254     5   p    v                  endif

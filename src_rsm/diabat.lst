            2300     2                     endif !end if(ldailyFCTsst....)
            2301     1               
            2302     1               
            2303     1               !=======================================================================
            2304     1               ! Add SPPT pertubation
            2305     1               !=======================================================================
            2306     1               #ifdef VERBOSE
            2307     1                     ! Save u, v, t, and q for SPPT
            2308     1                     ut_update(1:nxj,1:lev,jj)      = ut(1:nxj,1:lev,jj)
            2309     1                     vt_update(1:nxj,1:lev,jj)      = vt(1:nxj,1:lev,jj)
            2310     1                     tt_update(1:nxj,1:lev,jj)      = tt(1:nxj,1:lev,jj)
            2311     1                     qt_update(1:nxj,1:lev*ncld,jj) = qt(1:nxj,1:lev*ncld,jj)
            2312     1               #endif
            2313     1                     ! sppt tendencies
            2314     2                     if (dosppt) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            2315     3  pp                   do k=1,lev
            2316     3   p                     kc=lev-k+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtradc, tt, sppt3d, tt_save_sppt, qt
                                   <<<      qt_save_sppt, ut, ut_save_sppt, vt
                                   <<<      vt_save_sppt, zmtnblck
                                   <<< Loop-information  End >>>
            2317     4   p    v                do i=1,nxj
            2318     4   p    v                  vru=1.
            2319     5   p    v                  if (kc.gt.zmtnblck(i)+2) then
            2320     5   p    v                     vru=1.0
            2321     5   p    v                  endif
            2322     5   p    v                  if (kc.le.zmtnblck(i)) then
            2323     5   p    v                     vru=0.0
            2324     5   p    v                  endif
            2325     5   p    v                  if (kc.eq.zmtnblck(i)+1) then
            2326     5   p    v                     vru=0.333333
            2327     5   p    v                  endif
            2328     5   p    v                  if (kc.eq.zmtnblck(i)+2) then
            2329     5   p    v                     vru=0.666667
            2330     5   p    v                  endif
            2331     4               
            2332     4   p    v                  ru = sppt3d(i,k,jj) + 1.
            2333     4   p    v                  if (use_zmtnblck) ru = (ru - 1.) * vru + 1.
            2334     4               
            2335     4   p    v                  dtdtr = dtradc(i,k,jj) * dta / 86400.
            2336     4   p    v                  upert = ( ut(i,k,jj) - ut_save_sppt(i,k,jj) ) * ru
            2337     4   p    v                  vpert = ( vt(i,k,jj) - vt_save_sppt(i,k,jj) ) * ru
            2338     4   p    v                  tpert = ( tt(i,k,jj) - tt_save_sppt(i,k,jj) - dtdtr ) * ru
            2339     4   p    v                  qpert = ( qt(i,k,jj) - qt_save_sppt(i,k,jj) ) * ru
            2340     4               
            2341     4   p    v                  ut(i,k,jj) = ut_save_sppt(i,k,jj) + upert
            2342     4   p    v                  vt(i,k,jj) = vt_save_sppt(i,k,jj) + vpert
            2343     4               
            2344     4                           !negative humidity check
            2345     4   p    v                  qnew = qt_save_sppt(i,k,jj) + qpert
            2346     5   p    v                  if ( qnew .ge. qmin ) then
            2347     5   p    v                     qt(i,k,jj) = qnew
            2348     5   p    v                     tt(i,k,jj) = tt_save_sppt(i,k,jj) + tpert + dtdtr
            2349     5   p    v                  endif
            2350     4   p    v                enddo
            2351     3   p                   enddo
            2352     2                     endif
            2353     1               
            2354     1                     ! SHUM process
            2355     2                     if (doshum) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      shum3d, qt
                                   <<< Loop-information  End >>>
            2356     3  pp                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 240, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt, shum3d
                                   <<< Loop-information  End >>>
            2357     4   p   2v                  do i=1,nxj
            2358     4   p   2v                    ru=shum3d(i,k,jj)
            2359     4   p   2v                    qt(i,k,jj) = qt(i,k,jj)*(1.+ru)
            2360     4   p   2v                  enddo
            2361     3   p                     enddo
            2362     2                     endif
            2363     1               
            2364     1               #ifdef VERBOSE
            2365     1                     ! Save u, v, t, and q for SPPT
            2366     1                     ut_sppt(1:nxj,1:lev     ,jj) = ut(1:nxj,1:lev     ,jj)
            2367     1                     vt_sppt(1:nxj,1:lev     ,jj) = vt(1:nxj,1:lev     ,jj)
            2368     1                     tt_sppt(1:nxj,1:lev     ,jj) = tt(1:nxj,1:lev     ,jj)
            2369     1                     qt_sppt(1:nxj,1:lev*ncld,jj) = qt(1:nxj,1:lev*ncld,jj)
            2370     1               #endif
            2371     1               
            2372     1                   !--------------------------------------------------------------------------------
            2373     1                   !     weight back u and v by cosl/radus and
            2374     1                   !     change real temp back to virtual potential temperature
            2375     1                   !--------------------------------------------------------------------------------
            2376     1                     yy = cosl(j) / radus
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            2377     2  pp                 do  k = 1, lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qt, pk, tt, vt, ut
                                   <<< Loop-information  End >>>
            2378     3   p    v              do  i = 1, nxj
            2379     3   p    v                ut(i,k,jj) = ut(i,k,jj)*yy
            2380     3   p    v                vt(i,k,jj) = vt(i,k,jj)*yy
            2381     3   p    v                tt(i,k,jj) = tt(i,k,jj)*(1.0+0.608*qt(i,k,jj))/pk(i,k,jj)
            2382     3   p    v              enddo
            2383     2   p                 enddo
            2384     1               
            2385     1                 290 continue  ! end of big j-loop for diabatic calculation
            2386                     
            2387                     #ifdef VERBOSE
            2388                           if (myrank == 0) write(6,'(a18,a3,3(1x,a15))')'u wind','k','mean','variance','std. dev.'
            2389                           do k=1,lev
            2390                             call check_global_values(ut_save_sppt(:,k,:),k,'diabat before phys')
            2391                             call check_global_values(ut_pbl      (:,k,:),k,'diabat after   pbl')
            2392                             call check_global_values(ut_cmls     (:,k,:),k,'diabat after  cmls')
            2393                             call check_global_values(ut_update   (:,k,:),k,'diabat after  phys')
            2394                             call check_global_values(ut_sppt     (:,k,:),k,'diabat after  sppt')
            2395                           enddo
            2396                           if (myrank == 0) write(6,'(a18,a3,3(1x,a15))')'v wind','k','mean','variance','std. dev.'
            2397                           do k=1,lev
            2398                             call check_global_values(vt_save_sppt(:,k,:),k,'diabat before phys')
            2399                             call check_global_values(vt_pbl      (:,k,:),k,'diabat after   pbl')
            2400                             call check_global_values(vt_cmls     (:,k,:),k,'diabat after  cmls')
            2401                             call check_global_values(vt_update   (:,k,:),k,'diabat after  phys')
            2402                             call check_global_values(vt_sppt     (:,k,:),k,'diabat after  sppt')
            2403                           enddo
            2404                           if (myrank == 0) write(6,'(a18,a3,3(1x,a15))')'temperature','k','mean','variance','std. dev.'
            2405                           do k=1,lev
            2406                             call check_global_values(tt_save_sppt(:,k,:),k,'diabat before phys')
            2407                             call check_global_values(tt_pbl      (:,k,:),k,'diabat after   pbl')
            2408                             call check_global_values(tt_cmls     (:,k,:),k,'diabat after  cmls')
            2409                             call check_global_values(tt_update   (:,k,:),k,'diabat after  phys')
            2410                             call check_global_values(tt_sppt     (:,k,:),k,'diabat after  sppt')

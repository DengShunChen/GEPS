            2295     6   p    v                    endif
            2296     5   p    v                    tseadiffFCT24(ii,jj)=tseadiffFCT24(ii,jj)+tseadiffFCT(ii,jj)/dta*dt
            2297     5   p    v                  endif !end if(ocean)

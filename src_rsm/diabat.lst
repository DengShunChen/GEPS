              35                     !#######################################################################
              36                     !
              37                     !     driver for all physical parametrization of diabatic processes
              38                     !
              39                     !
              40                     !     parameters
              41                     !
              42                     !     docup  : logical variable for including cumulus parameterization
              43                     !     dodry  : logical variable for including dry convection
              44                     !     dolsp  : logical variable for including large scale precipitation
              45                     !     dopbl  : logical variable for including pbl parameterization
              46                     !     dorad  : logical variable for including radiation parameterization
              47                     !     doshl  : logical variable for including shallow convection calcul
              48                     !     dograv : logical variable for including gravity wave drag
              49                     !     dograv : logical variable for including convective gravity wave drag
              50                     !     nx     : x-dimension of model grid
              51                     !     my     : y-dimension of model grid
              52                     !     lev     : total vertical levels of model
              53                     !     idg    : i-index of select point for diagnostic prints
              54                     !     jdg    : j-index of selcet point for diagnostic prints
              55                     !     ldiag  : index to control the level of runtime diagnostic
              56                     !            = 1, basic (normal) diagnostics
              57                     !            = 2, advanced disgnostics (cupcwb and radtn diag)
              58                     !            = 3, extensive diagnostics
              59                     !     dt     : time step (for forward time step, in seconds)
              60                     !     tau    : current forecast time (in hours)
              61                     !     hours  : current zulu hours
              62                     !     julian : current julian day
              63                     !     frad   : frequency to call radiation package (in hours)
              64                     !     ozon   : logical variable for including ozone in radiative calcul
              65                     !     njump  : grid interval for long wave radiative calculation
              66                     !     itypbl : index for surface layer update, =0 stress b,c., =1 direct
              67                     !     ktcup  : highest model level allowed for cup top
              68                     !     ktpbl  : highest model level allowed for vertical mixing calcul
              69                     !     ktshl  : highest model level aloowed for shallow convection cal
              70                     !     grav   : gravity constant (=9.806)
              71                     !     rgas   : dry gas constant (=287.)
              72                     !     cp     : specific heat coef. for dry air (=1004.)
              73                     !     stbo   : stefan-boltzman constant (=5.669e-8)
              74                     !     s0     : solar constant (=1368.3)
              75                     !     evaprh : relative humidity where lsp condensation begins
              76                     !     hltm   : latent heat constant for water vapor (=2.52e+6)
              77                     !     ptop   : model top pressure for radiation calculation (=0.01)
              78                     !     sigma  : sigma layer
              79                     !     dsigma : sigma layer thickness
              80                     !     il     : output point address for 1-d spline interp in lw rad
              81                     !     ib     : input  point address for 1-d spline interp in lw rad
              82                     !     cof    : coeff. array for 1-d spline interpolation in lw rad
              83                     !     xlat   : latitude at each model grid in y-direction
              84                     !     xlon   : longtitude at each model grid in x-direction
              85                     !     sgeo   : surface terrain geopotential  (m2/s2)
              86                     !     z0     : surface rougness (m)
              87                     !     alb    : surface ground albedo
              88                     !     land   : logical variable for bare soil land grid points
              89                     !     ocean  : logical variable for open water grid points
              90                     !     ice    : logical variables for ice covered grid points
              91                     !     snr    : accumulated surface snow depth (m)
              92                     !     tg     : ground surface temperature (k)
              93                     !     tgclim : climate value for deep soil temperature (k)
              94                     !     curate : cumulus precipitation rate for cloud diagnost (mm/s)
              95                     !     plcl   : sigma level values at lcl level (cumulus cloud base)
              96                     !     cumtop : sigma level values at cumulus cloud top
              97                     !     totalp : total precipitation rate for snow accumulation (mm/s)
              98                     !     raincu : accumulated cumulus rain in each output period (mm)
              99                     !     rainlp : accumulated large-scale rain in each output period (mm)
             100                     !     hflux  : upward surface sensible heat flux (w/m2)
             101                     !     qflux  : upward surface latent heat flux (w/m2)
             102                     !     ustar  : surface friction velocity  (m/s)
             103                     !     tstar  : surface friction temperature (k, <0 for upward flux)
             104                     !     qstar  : surface friction mixing ratio ( <0 for upward flux)
             105                     !     e      : turbulence k.e. at present/future time step (m2/s2)
             106                     !     eps    : turbulence k.e. dissipation rate at present/future time
             107                     !     o3l    : ozone concentration for radiative transfer calculation
             108                     !     dtrad  : temperature change rate due to radiative transfer (k/day)
             109                     !     ss     : net downward solar radiation at ground surface (w/m2)
             110                     !     rs     : net upward long wave radiation at ground surface (w/m2)
             111                     !     ps     : (terrain pressure-ptop) at present time step (mb)
             112                     !     plt    : odd-lvl pressure at present time step (mb)
             113                     !     pk     : odd-levl p**kcapa at present time step
             114                     !     pk2    : even level p**kapa at present time step
             115                     !     up     : u-component at present time step (m/s)
             116                     !     vp     : v-component at present time step (m/s)
             117                     !     ttp    : virtual potential temperature at present time step (k)
             118                     !     qp     : specific humidity at present time step (kg/kg)
             119                     !     pst    : (terrain pressure-ptop) at future time step (mb)
             120                     !     ut     : u-component at past/future time step (m/s)
             121                     !     vt     : v-component at past/future time step (m/s)
             122                     !     tt     : virtual potential temp at past/future time step (k)
             123                     !     qt     : specific humidity at time/future time step (kg/kg)
             124                     !     gwclim : soil water climate value (= gwet-clim * 20.0)
             125                     !     tice   : critical temp to separate rain and snow (=273.15)
             126                     !     hice   : specific heat constant to melt snow     (=3.336e+5)
             127                     !     qgini  : initial global moisture amount
             128                     !     acld   :
             129                     !     std    : standard deviation of terrain
             130                     !     asol   : asorbed solar radiative flux by earth
             131                     !     olr    : outgoing longwave radiation
             132                     !     drag   : gravity wave drag force
             133                     !     ugws   : zonal component of surface gravity wave stress
             134                     !     vgws   : meridional component of surface gravity wave stress
             135                     !     sdpbl  : vertical velocity within pbl
             136                     !     t2     : 2-meter temperature
             137                     !     rh2    : 2-meter rh
             138                     !     u10/v10: 10-meter wind speed
             139                     !     gfx    : ground heat flx                        (nx)        (wat/m2)
             140                     !soil
             141                     !     rld    : long wave radiat. flux down to ground (nx)    (wat/m2)
             142                     !     smc    : volumetric soil moisture content (nx,km_soil)
             143                     !     stc    : soil temperature                 (nx,km_soil)
             144                     !  canopy    : canopy moisture content(<0.5mm)          (nx)
             145                     !  runoff    : accumulate run off water(runof+drain) (nx)    (mm)
             146                     !  sigmaf    : green vegetation fraction        (nx)
             147                     !   istyp    : soil type(1-9)                   (nx)
             148                     ! ivegtyp    : vegetation type(1-13)            (nx)
             149                     !   wlt      : wiltling point of 9 soil types  (9)
             150                     !   ref      : field capacity of 9 soil types  (9)
             151                     !   tsat     : satuation point of 9 soil types (9)
             152                     !   dfkt     : soil thermal diffusivity    (22,9)     m2/s
             153                     !   xktk     : soil hydraulic conductivity (22,9)  m/s
             154                     !micro
             155                     !     ftp, fqp, fpsp : for temperature, specific humidity and surface
             156                     !              pressure for past time step for micro cloud scheme
             157                     !
             158                     !   lrun_sitvdiff: logical variable for run sit_vdiff
             159                     !   ic_sit   : the 'ic_sit'th times run sit_vdiff
             160                     !

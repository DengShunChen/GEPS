            2258     4  pp    v                do ii = 1,nxj
            2259     4   p    v                  i=nxjstart(j)+ii-1
            2260     4   p    v                  dtseadt(ii,jj)=0.
            2261     4   p    v                  tseadiffFCT(ii,jj)=0.
            2262     5   p    v                  if(ocean(ii,jj))then
            2263     5   p    v                    obswtbnew(ii,jj)=dta*dFCTsstdt(ii,jj)+obswtbold(ii,jj)
            2264     5   p    v                    obswtbold(ii,jj)=obswtbnew(ii,jj)
            2265     5   p    v                    obswtbnow(ii,jj)=obswtbnew(ii,jj)
            2266     5                             ! sea surface temperature tendency
            2267     5   p    v                    dtseadt(ii,jj)=dFCTsstdt(ii,jj)
            2268     5   p    v                    tseadiffFCT(ii,jj)=dta*dFCTsstdt(ii,jj)
            2269     6   p    v                    if(do_sit) then
            2270     7   p    v                      if(sitmask(ii,jj) .EQ. 1.) then
            2271     8   p    v                        if(lrun_sitvdiff .AND. ltrigsit )then
            2272     8   p    v                          tseadiffSIT(ii,jj)=0.
            2273     8   p    v                          sumdSITdt(ii,jj)=sumdSITdt(ii,jj)+dtswdt(ii,jj)
            2274     8   p    v                          countdSITdt(ii,jj)=countdSITdt(ii,jj)+1.
            2275     8   p    v                        endif
            2276     7               
            2277     7   p    v                        dtaup = mod(tau+0.001, dSITdt_intv)
            2278     8   p    v                        if( (dSITdt_intv .lt. 0.) .OR. (dtaup .lt. dtx_tau) )then
            2279     9   p    v                          if(countdSITdt(ii,jj) .ge. 1.) then
            2280     9   p    v                            tseadiffFCT(ii,jj)=dta * (1.-weightSIT*ratioSIT(ii,jj)) * dFCTsstdt(ii,jj)
            2281     9   p    v                            tseadiffSIT(ii,jj)=dta * weightSIT*ratioSIT(ii,jj) * (sumdSITdt(ii,jj)/countdSITdt(ii,jj))
            2282     9   p    v                            tseadiffSIT24(ii,jj)=tseadiffSIT24(ii,jj)+tseadiffSIT(ii,jj)/dta*dt
            2283     9                                     ! sea surface temperature tendency
            2284     9   p    v                            dtseadt(ii,jj)=(1.-weightSIT*ratioSIT(ii,jj)) * dFCTsstdt(ii,jj) &
            2285     9                                                 + weightSIT * ratioSIT(ii,jj) * (sumdSITdt(ii,jj)/countdSITdt(ii,jj))
            2286     9   p    v                            sumdSITdt(ii,jj)=0.
            2287     9   p    v                            countdSITdt(ii,jj)=0.
            2288     9   p    v                          endif
            2289     8   p    v                        endif
            2290     7   p    v                      endif ! end if sitmask(ii,jj) .EQ. 1
            2291     6   p    v                    endif ! end if do_sit
            2292     5               

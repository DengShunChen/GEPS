            4246     1   p                   fac001 = fk0*fac01(k)
            4247     1   p                   fac011 = fk0*fac11(k)
            4248     1   p                   fac101 = fk1*fac01(k)
            4249     1   p                   fac111 = fk1*fac11(k)

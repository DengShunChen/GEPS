            4110     2   p                     fk0 = p4
            4111     2   p                     fk1 = f_one - p - 2.0*p4
            4112     2   p                     fk2 = p + p4
            4113     2   p                     id000 = ind0 + 1
            4114     2   p                     id010 = ind0 +10
            4115     2   p                     id100 = ind0
            4116     2   p                     id110 = ind0 + 9
            4117     2   p                     id200 = ind0 - 1
            4118     2   p                     id210 = ind0 + 8
            4119     2   p                   else
            4120     2   p                     fk0 = f_one - fs

            5147     2   p                     id011 = ind1 +10
            5148     2   p                     id101 = ind1
            5149     2   p                     id111 = ind1 + 9
            5150     2   p                     id201 = ind1 - 1
            5151     2   p                     id211 = ind1 + 8
            5152     2   p                   else

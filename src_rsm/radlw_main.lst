            4410     2   p                     id211 = ind1 + 8
            4411     2   p                   else
            4412     2   p                     fk00 = f_one - fs
            4413     2   p                     fk10 = fs
            4414     2   p                     fk20 = f_zero
            4415     2               
            4416     2   p                     fk01 = f_one - fs1
            4417     2   p                     fk11 = fs1
            4418     2   p                     fk21 = f_zero
            4419     2               
            4420     2   p                     id000 = ind0
            4421     2   p                     id010 = ind0 + 9
            4422     2   p                     id100 = ind0 + 1
            4423     2   p                     id110 = ind0 +10
            4424     2   p                     id200 = ind0
            4425     2   p                     id210 = ind0
            4426     2               
            4427     2   p                     id001 = ind1
            4428     2   p                     id011 = ind1 + 9
            4429     2   p                     id101 = ind1 + 1
            4430     2   p                     id111 = ind1 +10
            4431     2   p                     id201 = ind1
            4432     2   p                     id211 = ind1
            4433     2   p                   endif
            4434     1               
            4435     1   p                   fac000 = fk00 * fac00(k)
            4436     1   p                   fac100 = fk10 * fac00(k)
            4437     1   p                   fac200 = fk20 * fac00(k)
            4438     1   p                   fac010 = fk00 * fac10(k)
            4439     1   p                   fac110 = fk10 * fac10(k)
            4440     1   p                   fac210 = fk20 * fac10(k)
            4441     1               
            4442     1   p                   fac001 = fk01 * fac01(k)
            4443     1   p                   fac101 = fk11 * fac01(k)
            4444     1   p                   fac201 = fk21 * fac01(k)
            4445     1   p                   fac011 = fk01 * fac11(k)
            4446     1   p                   fac111 = fk11 * fac11(k)
            4447     1   p                   fac211 = fk21 * fac11(k)
            4448     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4449     2   p   fv              do ig = 1, ng05
            4450     2   p   fv                tauself = selffac(k) * (selfref(ig,inds) + selffrac(k)        &
            4451     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            4452     2   p   fv                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            4453     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            4454     2   p   fv                o3m1    = ka_mo3(ig,jmo3,indm) + fmo3                         &
            4455     2                    &            * (ka_mo3(ig,jmo3p,indm) -  ka_mo3(ig,jmo3,indm))
            4456     2   p   fv                o3m2    = ka_mo3(ig,jmo3,indmp) + fmo3                        &
            4457     2                    &            * (ka_mo3(ig,jmo3p,indmp) - ka_mo3(ig,jmo3,indmp))
            4458     2   p   fv                abso3   = o3m1 + minorfrac(k)*(o3m2 - o3m1)
            4459     2               
            4460     2   p   fv                taug(ns05+ig,k) = speccomb                                    &
            4461     2                    &            * (fac000*absa(ig,id000) + fac010*absa(ig,id010)      &
            4462     2                    &            +  fac100*absa(ig,id100) + fac110*absa(ig,id110)      &
            4463     2                    &            +  fac200*absa(ig,id200) + fac210*absa(ig,id210))     &
            4464     2                    &            +     speccomb1                                       &
            4465     2                    &            * (fac001*absa(ig,id001) + fac011*absa(ig,id011)      &
            4466     2                    &            +  fac101*absa(ig,id101) + fac111*absa(ig,id111)      &
            4467     2                    &            +  fac201*absa(ig,id201) + fac211*absa(ig,id211))     &
            4468     2                    &            + tauself + taufor+abso3*colamt(k,3)+wx(k,1)*ccl4(ig)
            4469     2               
            4470     2   p   fv                fracs(ns05+ig,k) = fracrefa(ig,jpl) + fpl                     &
            4471     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            4472     2   p   fv              enddo
            4473     1   p                 enddo
            4474                     
            4475                     !  --- ...  upper atmosphere loop
            4476                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, rfrate, fac01, fac00, fac11
                                   <<<      fac10, wx, jp, jt1, jt
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 2
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4477     1  pp                 do k = laytrop+1, nlay
            4478     1   p                   speccomb = colamt(k,3) + rfrate(k,6,1)*colamt(k,2)
            4479     1   p                   specparm = colamt(k,3) / speccomb
            4480     1   p                   specmult = 4.0 * min(specparm, oneminus)
            4481     1   p                   js = 1 + int(specmult)
            4482     1   p                   fs = mod(specmult, f_one)
            4483     1   p                   ind0 = ((jp(k)-13)*5 + (jt(k)-1)) * nspb(5) + js
            4484     1               
            4485     1   p                   speccomb1 = colamt(k,3) + rfrate(k,6,2)*colamt(k,2)
            4486     1   p                   specparm1 = colamt(k,3) / speccomb1
            4487     1   p                   specmult1 = 4.0 * min(specparm1, oneminus)
            4488     1   p                   js1 = 1 + int(specmult1)
            4489     1   p                   fs1 = mod(specmult1, f_one)
            4490     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(5) + js1
            4491     1               
            4492     1   p                   speccomb_planck = colamt(k,3) + refrat_planck_b*colamt(k,2)
            4493     1   p                   specparm_planck = colamt(k,3) / speccomb_planck
            4494     1   p                   specmult_planck = 4.0 * min(specparm_planck, oneminus)
            4495     1   p                   jpl = 1 + int(specmult_planck)
            4496     1   p                   fpl = mod(specmult_planck, f_one)
            4497     1   p                   jplp= jpl + 1
            4498     1               
            4499     1   p                   id000 = ind0
            4500     1   p                   id010 = ind0 + 5
            4501     1   p                   id100 = ind0 + 1
            4502     1   p                   id110 = ind0 + 6
            4503     1   p                   id001 = ind1
            4504     1   p                   id011 = ind1 + 5
            4505     1   p                   id101 = ind1 + 1
            4506     1   p                   id111 = ind1 + 6
            4507     1               
            4508     1   p                   fk00 = f_one - fs
            4509     1   p                   fk10 = fs
            4510     1               
            4511     1   p                   fk01 = f_one - fs1
            4512     1   p                   fk11 = fs1
            4513     1               
            4514     1   p                   fac000 = fk00 * fac00(k)
            4515     1   p                   fac010 = fk00 * fac10(k)
            4516     1   p                   fac100 = fk10 * fac00(k)
            4517     1   p                   fac110 = fk10 * fac10(k)
            4518     1               
            4519     1   p                   fac001 = fk01 * fac01(k)
            4520     1   p                   fac011 = fk01 * fac11(k)
            4521     1   p                   fac101 = fk11 * fac01(k)
            4522     1   p                   fac111 = fk11 * fac11(k)
            4523     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4524     2   p   fv              do ig = 1, ng05
            4525     2   p   fv                taug(ns05+ig,k) = speccomb                                    &
            4526     2                    &                * (fac000*absb(ig,id000) + fac010*absb(ig,id010)  &
            4527     2                    &                +  fac100*absb(ig,id100) + fac110*absb(ig,id110)) &
            4528     2                    &                +     speccomb1                                   &
            4529     2                    &                * (fac001*absb(ig,id001) + fac011*absb(ig,id011)  &
            4530     2                    &                +  fac101*absb(ig,id101) + fac111*absb(ig,id111)) &
            4531     2                    &                + wx(k,1) * ccl4(ig)
            4532     2               
            4533     2   p   fv                fracs(ns05+ig,k) = fracrefb(ig,jpl) + fpl                     &
            4534     2                    &                     * (fracrefb(ig,jplp) - fracrefb(ig,jpl))
            4535     2   p   fv              enddo
            4536     1   p                 enddo
            4537                     
            4538                     ! ..................................
            4539                           end subroutine taugb05
            4540                     ! ----------------------------------
            4541                     
            4542                     ! ----------------------------------
            4543                           subroutine taugb06
            4544                     ! ..................................
            4545                     
            4546                     !  ------------------------------------------------------------------  !
            4547                     !     band 6:  820-980 cm-1 (low key - h2o; low minor - co2)           !
            4548                     !                           (high key - none; high minor - cfc11, cfc12)
            4549                     !  ------------------------------------------------------------------  !
            4550                     
            4551                           use module_radlw_kgb06
            4552                     
            4553                     !  ---  locals:
            4554                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            4555                          &       indm, indmp, ig
            4556                     
            4557                           real (kind=kind_phys) :: ratco2, adjfac, adjcolco2, tauself,      &
            4558                          &      taufor, absco2, temp
            4559                     !
            4560                     !===> ...  begin here
            4561                     !
            4562                     !  --- ...  minor gas mapping level:
            4563                     !     lower - co2, p = 706.2720 mb, t = 294.2 k
            4564                     !     upper - cfc11, cfc12
            4565                     
            4566                     !  --- ...  lower atmosphere loop
            4567                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp, jt, coldry, colamt, jt1, indself
                                   <<<      indfor, indminor, fac00, fac10
                                   <<<      minorfrac, fac01, forfac, forfrac
                                   <<<      selffrac, selffac
                                   <<<    PREFETCH(SOFT) : 8
                                   <<<     SEQUENTIAL : 8
                                   <<<      wx: 4, fac11: 2, colamt: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 12
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4568     1  pp                 do k = 1, laytrop
            4569     1   p                   ind0 = ((jp(k)-1)*5 + (jt (k)-1)) * nspa(6) + 1
            4570     1   p                   ind1 = ( jp(k)   *5 + (jt1(k)-1)) * nspa(6) + 1
            4571     1               
            4572     1   p                   inds = indself(k)
            4573     1   p                   indf = indfor(k)
            4574     1   p                   indm = indminor(k)
            4575     1   p                   indsp = inds + 1
            4576     1   p                   indfp = indf + 1
            4577     1   p                   indmp = indm + 1
            4578     1   p                   ind0p = ind0 + 1
            4579     1   p                   ind1p = ind1 + 1
            4580     1               
            4581     1               !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            4582     1               !           a minor species, adjust the column amount of co2 by an empirical factor
            4583     1               !           to obtain the proper contribution.
            4584     1               
            4585     1   p                   temp   = coldry(k) * chi_mls(2,jp(k)+1)
            4586     1   p                   ratco2 = colamt(k,2) / temp
            4587     2   p                   if (ratco2 > 3.0) then
            4588     2   p                     adjfac = 2.0 + (ratco2-2.0)**0.77
            4589     2   p                     adjcolco2 = adjfac * temp
            4590     2   p                   else
            4591     2   p                     adjcolco2 = colamt(k,2)
            4592     2   p                   endif
            4593     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4594     2   p    v              do ig = 1, ng06
            4595     2   p    v                tauself = selffac(k) * (selfref(ig,inds) + selffrac(k)        &
            4596     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            4597     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            4598     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            4599     2   p    v                absco2  = ka_mco2(ig,indm) + minorfrac(k)                     &
            4600     2                    &            * (ka_mco2(ig,indmp) - ka_mco2(ig,indm))
            4601     2               
            4602     2   p    v                taug(ns06+ig,k) = colamt(k,1)                                 &
            4603     2                    &            * (fac00(k)*absa(ig,ind0) + fac10(k)*absa(ig,ind0p)   &
            4604     2                    &            +  fac01(k)*absa(ig,ind1) + fac11(k)*absa(ig,ind1p))  &
            4605     2                    &            +  tauself + taufor + adjcolco2*absco2                &
            4606     2                    &            +  wx(k,2)*cfc11adj(ig) + wx(k,3)*cfc12(ig)
            4607     2               
            4608     2   p    v                fracs(ns06+ig,k) = fracrefa(ig)
            4609     2   p    v              enddo
            4610     1   p                 enddo
            4611                     
            4612                     !  --- ...  upper atmosphere loop
            4613                     !           nothing important goes on above laytrop in this band.
            4614                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 51
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wx
                                   <<< Loop-information  End >>>
            4615     1  pp   2             do k = laytrop+1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4616     2   p   2v              do ig = 1, ng06
            4617     2   p   2v                taug(ns06+ig,k) = wx(k,2)*cfc11adj(ig) + wx(k,3)*cfc12(ig)
            4618     2               
            4619     2   p   2v                fracs(ns06+ig,k) = fracrefa(ig)
            4620     2   p   2v              enddo
            4621     1   p   2             enddo
            4622                     
            4623                     ! ..................................
            4624                           end subroutine taugb06
            4625                     ! ----------------------------------
            4626                     
            4627                     ! ----------------------------------
            4628                           subroutine taugb07
            4629                     ! ..................................
            4630                     
            4631                     !  ------------------------------------------------------------------  !
            4632                     !     band 7:  980-1080 cm-1 (low key - h2o,o3; low minor - co2)       !
            4633                     !                            (high key - o3; high minor - co2)         !
            4634                     !  ------------------------------------------------------------------  !
            4635                     
            4636                           use module_radlw_kgb07
            4637                     
            4638                     !  ---  locals:
            4639                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            4640                          &       id000, id010, id100, id110, id200, id210, indm, indmp,     &
            4641                          &       id001, id011, id101, id111, id201, id211, jmco2, jmco2p,   &
            4642                          &       jpl, jplp, ig, js, js1
            4643                     
            4644                           real (kind=kind_phys) :: tauself, taufor, co2m1, co2m2, absco2,   &
            4645                          &      speccomb,       specparm,       specmult,       fs,         &
            4646                          &      speccomb1,      specparm1,      specmult1,      fs1,        &
            4647                          &      speccomb_mco2,  specparm_mco2,  specmult_mco2,  fmco2,      &
            4648                          &      speccomb_planck,specparm_planck,specmult_planck,fpl,        &
            4649                          &      refrat_planck_a, refrat_m_a, ratco2, adjfac, adjcolco2,     &
            4650                          &      fac000, fac100, fac200, fac010, fac110, fac210,             &
            4651                          &      fac001, fac101, fac201, fac011, fac111, fac211,             &
            4652                          &      p0, p40, fk00, fk10, fk20, p1, p41, fk01, fk11, fk21, temp
            4653                     !
            4654                     !===> ...  begin here
            4655                     !
            4656                     !  --- ...  minor gas mapping level :
            4657                     !     lower - co2, p = 706.2620 mbar, t= 278.94 k
            4658                     !     upper - co2, p = 12.9350 mbar, t = 234.01 k
            4659                     
            4660                     !  --- ...  calculate reference ratio to be used in calculation of planck
            4661                     !           fraction in lower atmosphere.
            4662                     
            4663                           refrat_planck_a = chi_mls(1,3)/chi_mls(3,3)     ! p = 706.2620 mb
            4664                           refrat_m_a = chi_mls(1,3)/chi_mls(3,3)          ! p = 706.2720 mb
            4665                     
            4666                     !  --- ...  lower atmosphere loop
            4667                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, rfrate, jp, jt, coldry, jt1
                                   <<<      indself, indfor, indminor, fac00, fac10
                                   <<<      fac01, fac11
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      selffrac: 2, selffac: 2, forfrac: 2
                                   <<<      forfac: 2, minorfrac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 18  FILL 49
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 15  FILL 18
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4668     1  pp                 do k = 1, laytrop
            4669     1   p                   speccomb = colamt(k,1) + rfrate(k,2,1)*colamt(k,3)
            4670     1   p                   specparm = colamt(k,1) / speccomb
            4671     1   p                   specmult = 8.0 * min(specparm, oneminus)
            4672     1   p                   js = 1 + int(specmult)
            4673     1   p                   fs = mod(specmult, f_one)
            4674     1   p                   ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(7) + js
            4675     1               
            4676     1   p                   speccomb1 = colamt(k,1) + rfrate(k,2,2)*colamt(k,3)
            4677     1   p                   specparm1 = colamt(k,1) / speccomb1
            4678     1   p                   specmult1 = 8.0 * min(specparm1, oneminus)
            4679     1   p                   js1 = 1 + int(specmult1)
            4680     1   p                   fs1 = mod(specmult1, f_one)
            4681     1   p                   ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(7) + js1
            4682     1               
            4683     1   p                   speccomb_mco2 = colamt(k,1) + refrat_m_a*colamt(k,3)
            4684     1   p                   specparm_mco2 = colamt(k,1) / speccomb_mco2
            4685     1   p                   specmult_mco2 = 8.0 * min(specparm_mco2, oneminus)
            4686     1   p                   jmco2 = 1 + int(specmult_mco2)
            4687     1   p                   fmco2 = mod(specmult_mco2, f_one)
            4688     1               
            4689     1   p                   speccomb_planck = colamt(k,1) + refrat_planck_a*colamt(k,3)
            4690     1   p                   specparm_planck = colamt(k,1) / speccomb_planck
            4691     1   p                   specmult_planck = 8.0 * min(specparm_planck, oneminus)
            4692     1   p                   jpl = 1 + int(specmult_planck)
            4693     1   p                   fpl = mod(specmult_planck, f_one)
            4694     1               
            4695     1   p                   inds = indself(k)
            4696     1   p                   indf = indfor(k)
            4697     1   p                   indm = indminor(k)
            4698     1   p                   indsp = inds + 1
            4699     1   p                   indfp = indf + 1
            4700     1   p                   indmp = indm + 1
            4701     1   p                   jplp  = jpl  + 1
            4702     1   p                   jmco2p= jmco2+ 1
            4703     1   p                   ind0p = ind0 + 1
            4704     1   p                   ind1p = ind1 + 1
            4705     1               
            4706     1               !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            4707     1               !           a minor species, adjust the column amount of co2 by an empirical factor
            4708     1               !           to obtain the proper contribution.
            4709     1               
            4710     1   p                   temp   = coldry(k) * chi_mls(2,jp(k)+1)
            4711     1   p                   ratco2 = colamt(k,2) / temp
            4712     2   p                   if (ratco2 > 3.0) then
            4713     2   p                     adjfac = 3.0 + (ratco2-3.0)**0.79
            4714     2   p                     adjcolco2 = adjfac * temp
            4715     2   p                   else
            4716     2   p                     adjcolco2 = colamt(k,2)
            4717     2   p                   endif
            4718     1               
            4719     2   p                   if (specparm < 0.125 .and. specparm1 < 0.125) then
            4720     2   p                     p0 = fs - f_one
            4721     2   p                     p40 = p0**4
            4722     2   p                     fk00 = p40
            4723     2   p                     fk10 = f_one - p0 - 2.0*p40
            4724     2   p                     fk20 = p0 + p40
            4725     2               
            4726     2   p                     p1 = fs1 - f_one
            4727     2   p                     p41 = p1**4
            4728     2   p                     fk01 = p41
            4729     2   p                     fk11 = f_one - p1 - 2.0*p41
            4730     2   p                     fk21 = p1 + p41
            4731     2               
            4732     2   p                     id000 = ind0
            4733     2   p                     id010 = ind0 + 9
            4734     2   p                     id100 = ind0 + 1
            4735     2   p                     id110 = ind0 +10
            4736     2   p                     id200 = ind0 + 2
            4737     2   p                     id210 = ind0 +11
            4738     2               
            4739     2   p                     id001 = ind1
            4740     2   p                     id011 = ind1 + 9
            4741     2   p                     id101 = ind1 + 1
            4742     2   p                     id111 = ind1 +10
            4743     2   p                     id201 = ind1 + 2
            4744     2   p                     id211 = ind1 +11
            4745     2   p                   elseif (specparm > 0.875 .and. specparm1 > 0.875) then
            4746     2   p                     p0 = -fs
            4747     2   p                     p40 = p0**4
            4748     2   p                     fk00 = p40
            4749     2   p                     fk10 = f_one - p0 - 2.0*p40
            4750     2   p                     fk20 = p0 + p40
            4751     2               
            4752     2   p                     p1 = -fs1
            4753     2   p                     p41 = p1**4
            4754     2   p                     fk01 = p41
            4755     2   p                     fk11 = f_one - p1 - 2.0*p41
            4756     2   p                     fk21 = p1 + p41
            4757     2               
            4758     2   p                     id000 = ind0 + 1
            4759     2   p                     id010 = ind0 +10
            4760     2   p                     id100 = ind0
            4761     2   p                     id110 = ind0 + 9
            4762     2   p                     id200 = ind0 - 1
            4763     2   p                     id210 = ind0 + 8
            4764     2               
            4765     2   p                     id001 = ind1 + 1
            4766     2   p                     id011 = ind1 +10
            4767     2   p                     id101 = ind1
            4768     2   p                     id111 = ind1 + 9
            4769     2   p                     id201 = ind1 - 1
            4770     2   p                     id211 = ind1 + 8
            4771     2   p                   else
            4772     2   p                     fk00 = f_one - fs
            4773     2   p                     fk10 = fs
            4774     2   p                     fk20 = f_zero
            4775     2               
            4776     2   p                     fk01 = f_one - fs1
            4777     2   p                     fk11 = fs1
            4778     2   p                     fk21 = f_zero
            4779     2               
            4780     2   p                     id000 = ind0
            4781     2   p                     id010 = ind0 + 9
            4782     2   p                     id100 = ind0 + 1
            4783     2   p                     id110 = ind0 +10
            4784     2   p                     id200 = ind0
            4785     2   p                     id210 = ind0
            4786     2               
            4787     2   p                     id001 = ind1
            4788     2   p                     id011 = ind1 + 9
            4789     2   p                     id101 = ind1 + 1
            4790     2   p                     id111 = ind1 +10
            4791     2   p                     id201 = ind1
            4792     2   p                     id211 = ind1
            4793     2   p                   endif
            4794     1               
            4795     1   p                   fac000 = fk00 * fac00(k)
            4796     1   p                   fac100 = fk10 * fac00(k)
            4797     1   p                   fac200 = fk20 * fac00(k)
            4798     1   p                   fac010 = fk00 * fac10(k)
            4799     1   p                   fac110 = fk10 * fac10(k)
            4800     1   p                   fac210 = fk20 * fac10(k)
            4801     1               
            4802     1   p                   fac001 = fk01 * fac01(k)
            4803     1   p                   fac101 = fk11 * fac01(k)
            4804     1   p                   fac201 = fk21 * fac01(k)
            4805     1   p                   fac011 = fk01 * fac11(k)
            4806     1   p                   fac111 = fk11 * fac11(k)
            4807     1   p                   fac211 = fk21 * fac11(k)
            4808     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4809     2   p    v              do ig = 1, ng07
            4810     2   p    v                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            4811     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            4812     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            4813     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            4814     2   p    v                co2m1   = ka_mco2(ig,jmco2,indm) + fmco2                      &
            4815     2                    &            * (ka_mco2(ig,jmco2p,indm) - ka_mco2(ig,jmco2,indm))
            4816     2   p    v                co2m2   = ka_mco2(ig,jmco2,indmp) + fmco2                     &
            4817     2                    &            * (ka_mco2(ig,jmco2p,indmp) - ka_mco2(ig,jmco2,indmp))
            4818     2   p    v                absco2  = co2m1 + minorfrac(k) * (co2m2 - co2m1)
            4819     2               
            4820     2   p    v                taug(ns07+ig,k) = speccomb                                    &
            4821     2                    &                * (fac000*absa(ig,id000) + fac010*absa(ig,id010)  &
            4822     2                    &                +  fac100*absa(ig,id100) + fac110*absa(ig,id110)  &
            4823     2                    &                +  fac200*absa(ig,id200) + fac210*absa(ig,id210)) &
            4824     2                    &                +     speccomb1                                   &
            4825     2                    &                * (fac001*absa(ig,id001) + fac011*absa(ig,id011)  &
            4826     2                    &                +  fac101*absa(ig,id101) + fac111*absa(ig,id111)  &
            4827     2                    &                +  fac201*absa(ig,id201) + fac211*absa(ig,id211)) &
            4828     2                    &                + tauself + taufor + adjcolco2*absco2
            4829     2               
            4830     2   p    v                fracs(ns07+ig,k) = fracrefa(ig,jpl) + fpl                     &
            4831     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            4832     2   p    v              enddo
            4833     1   p                 enddo
            4834                     
            4835                     !  --- ...  upper atmosphere loop
            4836                     
            4837                     !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            4838                     !           a minor species, adjust the column amount of co2 by an empirical factor
            4839                     !           to obtain the proper contribution.
            4840                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      coldry, jp, colamt, jt1, jt, minorfrac
                                   <<<      fac00, indminor, fac10, fac11, fac01
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4841     1  pp                 do k = laytrop+1, nlay
            4842     1   p                   temp   = coldry(k) * chi_mls(2,jp(k)+1)
            4843     1   p                   ratco2 = colamt(k,2) / temp
            4844     2   p                   if (ratco2 > 3.0) then
            4845     2   p                     adjfac = 2.0 + (ratco2-2.0)**0.79
            4846     2   p                     adjcolco2 = adjfac * temp
            4847     2   p                   else
            4848     2   p                     adjcolco2 = colamt(k,2)
            4849     2   p                   endif
            4850     1               
            4851     1   p                   ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(7) + 1
            4852     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(7) + 1
            4853     1               
            4854     1   p                   indm = indminor(k)
            4855     1   p                   indmp = indm + 1
            4856     1   p                   ind0p = ind0 + 1
            4857     1   p                   ind1p = ind1 + 1
            4858     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4859     2   p    v              do ig = 1, ng07
            4860     2   p    v                absco2 = kb_mco2(ig,indm) + minorfrac(k)                      &
            4861     2                    &           * (kb_mco2(ig,indmp) - kb_mco2(ig,indm))
            4862     2               
            4863     2   p    v                taug(ns07+ig,k) = colamt(k,3)                                 &
            4864     2                    &            * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)   &
            4865     2                    &            +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))  &
            4866     2                    &            + adjcolco2 * absco2
            4867     2               
            4868     2   p    v                fracs(ns07+ig,k) = fracrefb(ig)
            4869     2   p    v              enddo
            4870     1               
            4871     1               !  --- ...  empirical modification to code to improve stratospheric cooling rates
            4872     1               !           for o3.  revised to apply weighting for g-point reduction in this band.
            4873     1               
            4874     1   p                   taug(ns07+ 6,k) = taug(ns07+ 6,k) * 0.92
            4875     1   p                   taug(ns07+ 7,k) = taug(ns07+ 7,k) * 0.88
            4876     1   p                   taug(ns07+ 8,k) = taug(ns07+ 8,k) * 1.07
            4877     1   p                   taug(ns07+ 9,k) = taug(ns07+ 9,k) * 1.1
            4878     1   p                   taug(ns07+10,k) = taug(ns07+10,k) * 0.99
            4879     1   p                   taug(ns07+11,k) = taug(ns07+11,k) * 0.855
            4880     1   p                 enddo
            4881                     
            4882                     ! ..................................
            4883                           end subroutine taugb07
            4884                     ! ----------------------------------
            4885                     
            4886                     ! ----------------------------------
            4887                           subroutine taugb08
            4888                     ! ..................................
            4889                     
            4890                     !  ------------------------------------------------------------------  !
            4891                     !     band 8:  1080-1180 cm-1 (low key - h2o; low minor - co2,o3,n2o)  !
            4892                     !                             (high key - o3; high minor - co2, n2o)   !
            4893                     !  ------------------------------------------------------------------  !
            4894                     
            4895                           use module_radlw_kgb08
            4896                     
            4897                     !  ---  locals:
            4898                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            4899                          &       indm, indmp, ig
            4900                     
            4901                           real (kind=kind_phys) :: tauself, taufor, absco2, abso3, absn2o,  &
            4902                          &      ratco2, adjfac, adjcolco2, temp
            4903                     !
            4904                     !===> ...  begin here
            4905                     !
            4906                     !  --- ...  minor gas mapping level:
            4907                     !     lower - co2, p = 1053.63 mb, t = 294.2 k
            4908                     !     lower - o3,  p = 317.348 mb, t = 240.77 k
            4909                     !     lower - n2o, p = 706.2720 mb, t= 278.94 k
            4910                     !     lower - cfc12,cfc11
            4911                     !     upper - co2, p = 35.1632 mb, t = 223.28 k
            4912                     !     upper - n2o, p = 8.716e-2 mb, t = 226.03 k
            4913                     
            4914                     !  --- ...  lower atmosphere loop
            4915                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp, coldry, colamt, jt, indfor, jt1
                                   <<<      indminor, indself, minorfrac, selffrac
                                   <<<      selffac, forfrac, forfac, fac00, fac10
                                   <<<      fac01
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      colamt: 6, fac11: 2, wx: 4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 16
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4916     1  pp                 do k = 1, laytrop
            4917     1   p                   ind0 = ((jp(k)-1)*5 + (jt (k)-1)) * nspa(8) + 1
            4918     1   p                   ind1 = ( jp(k)   *5 + (jt1(k)-1)) * nspa(8) + 1
            4919     1               
            4920     1   p                   inds = indself(k)
            4921     1   p                   indf = indfor(k)
            4922     1   p                   indm = indminor(k)
            4923     1   p                   ind0p = ind0 + 1
            4924     1   p                   ind1p = ind1 + 1
            4925     1   p                   indsp = inds + 1
            4926     1   p                   indfp = indf + 1
            4927     1   p                   indmp = indm + 1
            4928     1               
            4929     1               !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            4930     1               !           a minor species, adjust the column amount of co2 by an empirical factor
            4931     1               !           to obtain the proper contribution.
            4932     1               
            4933     1   p                   temp   = coldry(k) * chi_mls(2,jp(k)+1)
            4934     1   p                   ratco2 = colamt(k,2) / temp
            4935     2   p                   if (ratco2 > 3.0) then
            4936     2   p                     adjfac = 2.0 + (ratco2-2.0)**0.65
            4937     2   p                     adjcolco2 = adjfac * temp
            4938     2   p                   else
            4939     2   p                     adjcolco2 = colamt(k,2)
            4940     2   p                   endif
            4941     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4942     2   p    v              do ig = 1, ng08
            4943     2   p    v                tauself = selffac(k) * (selfref(ig,inds) + selffrac(k)        &
            4944     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            4945     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            4946     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            4947     2   p    v                absco2  = (ka_mco2(ig,indm) + minorfrac(k)                    &
            4948     2                    &            * (ka_mco2(ig,indmp) - ka_mco2(ig,indm)))
            4949     2   p    v                abso3   = (ka_mo3(ig,indm) + minorfrac(k)                     &
            4950     2                    &            * (ka_mo3(ig,indmp) - ka_mo3(ig,indm)))
            4951     2   p    v                absn2o  = (ka_mn2o(ig,indm) + minorfrac(k)                    &
            4952     2                    &            * (ka_mn2o(ig,indmp) - ka_mn2o(ig,indm)))
            4953     2               
            4954     2   p    v                taug(ns08+ig,k) = colamt(k,1)                                 &
            4955     2                    &            * (fac00(k)*absa(ig,ind0) + fac10(k)*absa(ig,ind0p)   &
            4956     2                    &            +  fac01(k)*absa(ig,ind1) + fac11(k)*absa(ig,ind1p))  &
            4957     2                    &            + tauself+taufor + adjcolco2*absco2                   &
            4958     2                    &            + colamt(k,3)*abso3 + colamt(k,4)*absn2o              &
            4959     2                    &            + wx(k,3)*cfc12(ig) + wx(k,4)*cfc22adj(ig)
            4960     2               
            4961     2   p    v                fracs(ns08+ig,k) = fracrefa(ig)
            4962     2   p    v              enddo
            4963     1   p                 enddo
            4964                     
            4965                     !  --- ...  upper atmosphere loop
            4966                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jt1, jp, jt, indminor, coldry, colamt
                                   <<<      fac00, fac10, fac11, fac01, wx
                                   <<<      minorfrac
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            4967     1  pp                 do k = laytrop+1, nlay
            4968     1   p                   ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(8) + 1
            4969     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(8) + 1
            4970     1               
            4971     1   p                   indm = indminor(k)
            4972     1   p                   ind0p = ind0 + 1
            4973     1   p                   ind1p = ind1 + 1
            4974     1   p                   indmp = indm + 1
            4975     1               
            4976     1               !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            4977     1               !           a minor species, adjust the column amount of co2 by an empirical factor
            4978     1               !           to obtain the proper contribution.
            4979     1               
            4980     1   p                   temp   = coldry(k) * chi_mls(2,jp(k)+1)
            4981     1   p                   ratco2 = colamt(k,2) / temp
            4982     2   p                   if (ratco2 > 3.0) then
            4983     2   p                     adjfac = 2.0 + (ratco2-2.0)**0.65
            4984     2   p                     adjcolco2 = adjfac * temp
            4985     2   p                   else
            4986     2   p                     adjcolco2 = colamt(k,2)
            4987     2   p                   endif
            4988     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4989     2   p    v              do ig = 1, ng08
            4990     2   p    v                absco2 = (kb_mco2(ig,indm) + minorfrac(k)                     &
            4991     2                    &           * (kb_mco2(ig,indmp) - kb_mco2(ig,indm)))
            4992     2   p    v                absn2o = (kb_mn2o(ig,indm) + minorfrac(k)                     &
            4993     2                    &           * (kb_mn2o(ig,indmp) - kb_mn2o(ig,indm)))
            4994     2               
            4995     2   p    v                taug(ns08+ig,k) = colamt(k,3)                                 &
            4996     2                    &           * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)    &
            4997     2                    &           +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))   &
            4998     2                    &           + adjcolco2*absco2 + colamt(k,4)*absn2o                &
            4999     2                    &           + wx(k,3)*cfc12(ig) + wx(k,4)*cfc22adj(ig)
            5000     2               
            5001     2   p    v                fracs(ns08+ig,k) = fracrefb(ig)
            5002     2   p    v              enddo
            5003     1   p                 enddo
            5004                     
            5005                     ! ..................................
            5006                           end subroutine taugb08
            5007                     ! ----------------------------------
            5008                     
            5009                     ! ----------------------------------
            5010                           subroutine taugb09
            5011                     ! ..................................
            5012                     
            5013                     !  ------------------------------------------------------------------  !
            5014                     !     band 9:  1180-1390 cm-1 (low key - h2o,ch4; low minor - n2o)     !
            5015                     !                             (high key - ch4; high minor - n2o)       !
            5016                     !  ------------------------------------------------------------------  !
            5017                     
            5018                           use module_radlw_kgb09
            5019                     
            5020                     !  ---  locals:
            5021                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            5022                          &       id000, id010, id100, id110, id200, id210, indm, indmp,     &
            5023                          &       id001, id011, id101, id111, id201, id211, jmn2o, jmn2op,   &
            5024                          &       jpl, jplp, ig, js, js1
            5025                     
            5026                           real (kind=kind_phys) :: tauself, taufor, n2om1, n2om2, absn2o,   &
            5027                          &       speccomb,       specparm,       specmult,       fs,        &
            5028                          &       speccomb1,      specparm1,      specmult1,      fs1,       &
            5029                          &       speccomb_mn2o,  specparm_mn2o,  specmult_mn2o,  fmn2o,     &
            5030                          &       speccomb_planck,specparm_planck,specmult_planck,fpl,       &
            5031                          &       refrat_planck_a, refrat_m_a, ratn2o, adjfac, adjcoln2o,    &
            5032                          &       fac000, fac100, fac200, fac010, fac110, fac210,            &
            5033                          &       fac001, fac101, fac201, fac011, fac111, fac211,            &
            5034                          &       p0, p40, fk00, fk10, fk20, p1, p41, fk01, fk11, fk21, temp
            5035                     !
            5036                     !===> ...  begin here
            5037                     !
            5038                     !  --- ...  minor gas mapping level :
            5039                     !     lower - n2o, p = 706.272 mbar, t = 278.94 k
            5040                     !     upper - n2o, p = 95.58 mbar, t = 215.7 k
            5041                     
            5042                     !  --- ...  calculate reference ratio to be used in calculation of planck
            5043                     !           fraction in lower/upper atmosphere.
            5044                     
            5045                           refrat_planck_a = chi_mls(1,9)/chi_mls(6,9)       ! p = 212 mb
            5046                           refrat_m_a = chi_mls(1,3)/chi_mls(6,3)            ! p = 706.272 mb
            5047                     
            5048                     !  --- ...  lower atmosphere loop
            5049                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, rfrate, coldry, jp, jt, indself
                                   <<<      jt1, indfor, indminor, fac00, fac10
                                   <<<      fac01, fac11
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      selffrac: 2, selffac: 2, forfrac: 2
                                   <<<      forfac: 2, minorfrac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 18  FILL 50
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 13  FILL 16
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5050     1  pp                 do k = 1, laytrop
            5051     1   p                   speccomb = colamt(k,1) + rfrate(k,4,1)*colamt(k,5)
            5052     1   p                   specparm = colamt(k,1) / speccomb
            5053     1   p                   specmult = 8.0 * min(specparm, oneminus)
            5054     1   p                   js = 1 + int(specmult)
            5055     1   p                   fs = mod(specmult, f_one)
            5056     1   p                   ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(9) + js
            5057     1               
            5058     1   p                   speccomb1 = colamt(k,1) + rfrate(k,4,2)*colamt(k,5)
            5059     1   p                   specparm1 = colamt(k,1) / speccomb1
            5060     1   p                   specmult1 = 8.0 * min(specparm1, oneminus)
            5061     1   p                   js1 = 1 + int(specmult1)
            5062     1   p                   fs1 = mod(specmult1, f_one)
            5063     1   p                   ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(9) + js1
            5064     1               
            5065     1   p                   speccomb_mn2o = colamt(k,1) + refrat_m_a*colamt(k,5)
            5066     1   p                   specparm_mn2o = colamt(k,1) / speccomb_mn2o
            5067     1   p                   specmult_mn2o = 8.0 * min(specparm_mn2o, oneminus)
            5068     1   p                   jmn2o = 1 + int(specmult_mn2o)
            5069     1   p                   fmn2o = mod(specmult_mn2o, f_one)
            5070     1               
            5071     1   p                   speccomb_planck = colamt(k,1) + refrat_planck_a*colamt(k,5)
            5072     1   p                   specparm_planck = colamt(k,1) / speccomb_planck
            5073     1   p                   specmult_planck = 8.0 * min(specparm_planck, oneminus)
            5074     1   p                   jpl = 1 + int(specmult_planck)
            5075     1   p                   fpl = mod(specmult_planck, f_one)
            5076     1               

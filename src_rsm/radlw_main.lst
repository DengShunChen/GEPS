                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            4251     2   p    v              do ig = 1, ng04
            4252     2   p    v                tau_major =  speccomb                                         &
            4253     2                    &              * (fac000*absb(ig,id000) + fac010*absb(ig,id010)    &
            4254     2                    &              +  fac100*absb(ig,id100) + fac110*absb(ig,id110))
            4255     2   p    v                tau_major1 = speccomb1                                        &

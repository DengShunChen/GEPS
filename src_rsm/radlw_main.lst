            4124     2   p                     id010 = ind0 + 9
            4125     2   p                     id100 = ind0 + 1
            4126     2   p                     id110 = ind0 +10
            4127     2   p                     id200 = ind0
            4128     2   p                     id210 = ind0
            4129     2   p                   endif
            4130     1               
            4131     1   p                   fac000 = fk0*fac00(k)
            4132     1   p                   fac100 = fk1*fac00(k)
            4133     1   p                   fac200 = fk2*fac00(k)
            4134     1   p                   fac010 = fk0*fac10(k)
            4135     1   p                   fac110 = fk1*fac10(k)
            4136     1   p                   fac210 = fk2*fac10(k)
            4137     1               
            4138     2   p                   if (specparm1 < 0.125) then
            4139     2   p                     p = fs1 - f_one
            4140     2   p                     p4 = p**4
            4141     2   p                     fk0 = p4
            4142     2   p                     fk1 = f_one - p - 2.0*p4
            4143     2   p                     fk2 = p + p4
            4144     2   p                     id001 = ind1
            4145     2   p                     id011 = ind1 + 9
            4146     2   p                     id101 = ind1 + 1
            4147     2   p                     id111 = ind1 +10

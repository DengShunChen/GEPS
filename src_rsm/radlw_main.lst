            5208     2                    &                +  fac201*absa(ig,id201) + fac211*absa(ig,id211)) &
            5209     2                    &                + tauself + taufor + adjcoln2o*absn2o
            5210     2               
            5211     2   p    v                fracs(ns09+ig,k) = fracrefa(ig,jpl) + fpl                     &
            5212     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            5213     2   p    v              enddo
            5214     1   p                 enddo
            5215                     
            5216                     !  --- ...  upper atmosphere loop
            5217                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

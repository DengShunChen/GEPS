            4238     1   p                   fk1 = fs
            4239     1   p                   fac000 = fk0*fac00(k)
            4240     1   p                   fac010 = fk0*fac10(k)
            4241     1   p                   fac100 = fk1*fac00(k)
            4242     1   p                   fac110 = fk1*fac10(k)
            4243     1               
            4244     1   p                   fk0 = f_one - fs1

            5169     2   p                     id011 = ind1 + 9
            5170     2   p                     id101 = ind1 + 1
            5171     2   p                     id111 = ind1 +10
            5172     2   p                     id201 = ind1
            5173     2   p                     id211 = ind1
            5174     2   p                   endif
            5175     1               
            5176     1   p                   fac000 = fk00 * fac00(k)
            5177     1   p                   fac100 = fk10 * fac00(k)
            5178     1   p                   fac200 = fk20 * fac00(k)
            5179     1   p                   fac010 = fk00 * fac10(k)
            5180     1   p                   fac110 = fk10 * fac10(k)
            5181     1   p                   fac210 = fk20 * fac10(k)
            5182     1               

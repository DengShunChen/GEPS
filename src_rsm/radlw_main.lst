                                   <<< Loop-information  End >>>
            4206     1  pp                 do k = laytrop+1, nlay
            4207     1   p                   speccomb = colamt(k,3) + rfrate(k,6,1)*colamt(k,2)
            4208     1   p                   specparm = colamt(k,3) / speccomb

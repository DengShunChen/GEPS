                                   <<< Loop-information  End >>>
            5218     1  pp                 do k = laytrop+1, nlay
            5219     1   p                   ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(9) + 1
            5220     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(9) + 1

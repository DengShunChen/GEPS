            4088     1               
            4089     1   p                   inds = indself(k)
            4090     1   p                   indf = indfor(k)
            4091     1   p                   indsp = inds + 1
            4092     1   p                   indfp = indf + 1
            4093     1   p                   jplp  = jpl  + 1
            4094     1               
            4095     2   p                   if (specparm < 0.125) then
            4096     2   p                     p = fs - f_one
            4097     2   p                     p4 = p**4
            4098     2   p                     fk0 = p4
            4099     2   p                     fk1 = f_one - p - 2.0*p4
            4100     2   p                     fk2 = p + p4

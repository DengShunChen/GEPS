            4382     2   p                     id111 = ind1 +10
            4383     2   p                     id201 = ind1 + 2
            4384     2   p                     id211 = ind1 +11
            4385     2   p                   elseif (specparm > 0.875 .and. specparm1 > 0.875) then
            4386     2   p                     p0 = -fs

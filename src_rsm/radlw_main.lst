            5107     2   p                     p41 = p1**4
            5108     2   p                     fk01 = p41
            5109     2   p                     fk11 = f_one - p1 - 2.0*p41
            5110     2   p                     fk21 = p1 + p41
            5111     2               
            5112     2   p                     id000 = ind0
            5113     2   p                     id010 = ind0 + 9
            5114     2   p                     id100 = ind0 + 1
            5115     2   p                     id110 = ind0 +10
            5116     2   p                     id200 = ind0 + 2
            5117     2   p                     id210 = ind0 +11
            5118     2               
            5119     2   p                     id001 = ind1
            5120     2   p                     id011 = ind1 + 9
            5121     2   p                     id101 = ind1 + 1

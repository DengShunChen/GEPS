            5408     2               
            5409     2   p    v                taug(ns11+ig,k) = colamt(k,1)                                 &
            5410     2                    &            * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)   &
            5411     2                    &            +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))  &
            5412     2                    &            + taufor + tauo2
            5413     2               
            5414     2   p    v                fracs(ns11+ig,k) = fracrefb(ig)
            5415     2   p    v              enddo
            5416     1   p                 enddo
            5417                     
            5418                     ! ..................................
            5419                           end subroutine taugb11
            5420                     ! ----------------------------------
            5421                     
            5422                     ! ----------------------------------
            5423                           subroutine taugb12
            5424                     ! ..................................
            5425                     
            5426                     !  ------------------------------------------------------------------  !
            5427                     !     band 12:  1800-2080 cm-1 (low - h2o,co2; high - nothing)         !
            5428                     !  ------------------------------------------------------------------  !
            5429                     
            5430                           use module_radlw_kgb12
            5431                     
            5432                     !  ---  locals:
            5433                           integer :: k, ind0, ind1, inds, indsp, indf, indfp, jpl, jplp,    &
            5434                          &       id000, id010, id100, id110, id200, id210, ig, js, js1,     &
            5435                          &       id001, id011, id101, id111, id201, id211
            5436                     
            5437                           real (kind=kind_phys) :: tauself, taufor, refrat_planck_a,        &
            5438                          &       speccomb,       specparm,       specmult,       fs,        &
            5439                          &       speccomb1,      specparm1,      specmult1,      fs1,       &
            5440                          &       speccomb_planck,specparm_planck,specmult_planck,fpl,       &
            5441                          &       fac000, fac100, fac200, fac010, fac110, fac210,            &
            5442                          &       fac001, fac101, fac201, fac011, fac111, fac211,            &
            5443                          &       p0, p40, fk00, fk10, fk20, p1, p41, fk01, fk11, fk21
            5444                     !
            5445                     !===> ...  begin here
            5446                     !
            5447                     !  --- ...  calculate reference ratio to be used in calculation of planck
            5448                     !           fraction in lower/upper atmosphere.
            5449                     
            5450                           refrat_planck_a = chi_mls(1,10)/chi_mls(2,10)      ! p =   174.164 mb
            5451                     
            5452                     !  --- ...  lower atmosphere loop
            5453                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 8
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, rfrate, indself, jp, jt, jt1
                                   <<<      indfor, fac00, fac10, fac01, fac11
                                   <<<      selffrac, selffac, forfrac
                                   <<<    PREFETCH(SOFT) : 2
                                   <<<     SEQUENTIAL : 2
                                   <<<      forfac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 15
                                   <<<      SIMD&FP   : SPILL 5  FILL 6
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5454     1  pp                 do k = 1, laytrop
            5455     1   p                   speccomb = colamt(k,1) + rfrate(k,1,1)*colamt(k,2)
            5456     1   p                   specparm = colamt(k,1) / speccomb
            5457     1   p                   specmult = 8.0 * min(specparm, oneminus)
            5458     1   p                   js = 1 + int(specmult)
            5459     1   p                   fs = mod(specmult, f_one)
            5460     1   p                   ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(12) + js
            5461     1               
            5462     1   p                   speccomb1 = colamt(k,1) + rfrate(k,1,2)*colamt(k,2)
            5463     1   p                   specparm1 = colamt(k,1) / speccomb1
            5464     1   p                   specmult1 = 8.0 * min(specparm1, oneminus)
            5465     1   p                   js1 = 1 + int(specmult1)
            5466     1   p                   fs1 = mod(specmult1, f_one)
            5467     1   p                   ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(12) + js1
            5468     1               
            5469     1   p                   speccomb_planck = colamt(k,1) + refrat_planck_a*colamt(k,2)
            5470     1   p                   specparm_planck = colamt(k,1) / speccomb_planck
            5471     1   p                   if (specparm_planck >= oneminus) specparm_planck=oneminus
            5472     1   p                   specmult_planck = 8.0 * specparm_planck
            5473     1   p                   jpl = 1 + int(specmult_planck)
            5474     1   p                   fpl = mod(specmult_planck, f_one)
            5475     1               
            5476     1   p                   inds = indself(k)
            5477     1   p                   indf = indfor(k)
            5478     1   p                   indsp = inds + 1
            5479     1   p                   indfp = indf + 1
            5480     1   p                   jplp  = jpl  + 1
            5481     1               
            5482     2   p                   if (specparm < 0.125 .and. specparm1 < 0.125) then
            5483     2   p                     p0 = fs - f_one
            5484     2   p                     p40 = p0**4
            5485     2   p                     fk00 = p40
            5486     2   p                     fk10 = f_one - p0 - 2.0*p40
            5487     2   p                     fk20 = p0 + p40
            5488     2               
            5489     2   p                     p1 = fs1 - f_one
            5490     2   p                     p41 = p1**4
            5491     2   p                     fk01 = p41
            5492     2   p                     fk11 = f_one - p1 - 2.0*p41
            5493     2   p                     fk21 = p1 + p41
            5494     2               
            5495     2   p                     id000 = ind0
            5496     2   p                     id010 = ind0 + 9
            5497     2   p                     id100 = ind0 + 1
            5498     2   p                     id110 = ind0 +10
            5499     2   p                     id200 = ind0 + 2
            5500     2   p                     id210 = ind0 +11
            5501     2               
            5502     2   p                     id001 = ind1
            5503     2   p                     id011 = ind1 + 9
            5504     2   p                     id101 = ind1 + 1
            5505     2   p                     id111 = ind1 +10
            5506     2   p                     id201 = ind1 + 2
            5507     2   p                     id211 = ind1 +11
            5508     2   p                   elseif (specparm > 0.875 .and. specparm1 > 0.875) then
            5509     2   p                     p0 = -fs
            5510     2   p                     p40 = p0**4
            5511     2   p                     fk00 = p40
            5512     2   p                     fk10 = f_one - p0 - 2.0*p40
            5513     2   p                     fk20 = p0 + p40
            5514     2               
            5515     2   p                     p1 = -fs1
            5516     2   p                     p41 = p1**4
            5517     2   p                     fk01 = p41
            5518     2   p                     fk11 = f_one - p1 - 2.0*p41
            5519     2   p                     fk21 = p1 + p41
            5520     2               
            5521     2   p                     id000 = ind0 + 1
            5522     2   p                     id010 = ind0 +10
            5523     2   p                     id100 = ind0
            5524     2   p                     id110 = ind0 + 9
            5525     2   p                     id200 = ind0 - 1
            5526     2   p                     id210 = ind0 + 8
            5527     2               
            5528     2   p                     id001 = ind1 + 1
            5529     2   p                     id011 = ind1 +10
            5530     2   p                     id101 = ind1
            5531     2   p                     id111 = ind1 + 9
            5532     2   p                     id201 = ind1 - 1
            5533     2   p                     id211 = ind1 + 8
            5534     2   p                   else
            5535     2   p                     fk00 = f_one - fs
            5536     2   p                     fk10 = fs
            5537     2   p                     fk20 = f_zero
            5538     2               
            5539     2   p                     fk01 = f_one - fs1
            5540     2   p                     fk11 = fs1
            5541     2   p                     fk21 = f_zero
            5542     2               
            5543     2   p                     id000 = ind0
            5544     2   p                     id010 = ind0 + 9
            5545     2   p                     id100 = ind0 + 1
            5546     2   p                     id110 = ind0 +10
            5547     2   p                     id200 = ind0
            5548     2   p                     id210 = ind0
            5549     2               
            5550     2   p                     id001 = ind1
            5551     2   p                     id011 = ind1 + 9
            5552     2   p                     id101 = ind1 + 1
            5553     2   p                     id111 = ind1 +10
            5554     2   p                     id201 = ind1
            5555     2   p                     id211 = ind1
            5556     2   p                   endif
            5557     1               
            5558     1   p                   fac000 = fk00 * fac00(k)
            5559     1   p                   fac100 = fk10 * fac00(k)
            5560     1   p                   fac200 = fk20 * fac00(k)
            5561     1   p                   fac010 = fk00 * fac10(k)
            5562     1   p                   fac110 = fk10 * fac10(k)
            5563     1   p                   fac210 = fk20 * fac10(k)
            5564     1               
            5565     1   p                   fac001 = fk01 * fac01(k)
            5566     1   p                   fac101 = fk11 * fac01(k)
            5567     1   p                   fac201 = fk21 * fac01(k)
            5568     1   p                   fac011 = fk01 * fac11(k)
            5569     1   p                   fac111 = fk11 * fac11(k)
            5570     1   p                   fac211 = fk21 * fac11(k)
            5571     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5572     2   p    v              do ig = 1, ng12
            5573     2   p    v                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            5574     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            5575     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            5576     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            5577     2               
            5578     2   p    v                taug(ns12+ig,k) = speccomb                                    &
            5579     2                    &                * (fac000*absa(ig,id000) + fac010*absa(ig,id010)  &
            5580     2                    &                +  fac100*absa(ig,id100) + fac110*absa(ig,id110)  &
            5581     2                    &                +  fac200*absa(ig,id200) + fac210*absa(ig,id210)) &
            5582     2                    &                +     speccomb1                                   &
            5583     2                    &                * (fac001*absa(ig,id001) + fac011*absa(ig,id011)  &
            5584     2                    &                +  fac101*absa(ig,id101) + fac111*absa(ig,id111)  &
            5585     2                    &                +  fac201*absa(ig,id201) + fac211*absa(ig,id211)) &
            5586     2                    &                + tauself + taufor
            5587     2               
            5588     2   p    v                fracs(ns12+ig,k) = fracrefa(ig,jpl) + fpl                     &
            5589     2                    &                     *(fracrefa(ig,jplp) - fracrefa(ig,jpl))
            5590     2   p    v              enddo
            5591     1   p                 enddo
            5592                     
            5593                     !  --- ...  upper atmosphere loop
            5594                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 107
                                   <<< Loop-information  End >>>
            5595     1  pp   2             do k = laytrop+1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            5596     2   p   2v              do ig = 1, ng12
            5597     2   p   2v                taug(ns12+ig,k) = f_zero
            5598     2   p   2v                fracs(ns12+ig,k) = f_zero
            5599     2   p   2v              enddo
            5600     1   p   2             enddo
            5601                     
            5602                     ! ..................................
            5603                           end subroutine taugb12
            5604                     ! ----------------------------------
            5605                     
            5606                     ! ----------------------------------
            5607                           subroutine taugb13
            5608                     ! ..................................
            5609                     
            5610                     !  ------------------------------------------------------------------  !
            5611                     !     band 13:  2080-2250 cm-1 (low key-h2o,n2o; high minor-o3 minor)  !
            5612                     !  ------------------------------------------------------------------  !
            5613                     
            5614                           use module_radlw_kgb13
            5615                     
            5616                     !  ---  locals:
            5617                           integer :: k, ind0, ind1, inds, indsp, indf, indfp, indm, indmp,  &
            5618                          &       id000, id010, id100, id110, id200, id210, jmco2, jpl,      &
            5619                          &       id001, id011, id101, id111, id201, id211, jmco2p, jplp,    &
            5620                          &       jmco, jmcop, ig, js, js1
            5621                     
            5622                           real (kind=kind_phys) :: tauself, taufor, co2m1, co2m2, absco2,   &
            5623                          &       speccomb,       specparm,       specmult,       fs,        &
            5624                          &       speccomb1,      specparm1,      specmult1,      fs1,       &
            5625                          &       speccomb_mco2,  specparm_mco2,  specmult_mco2,  fmco2,     &
            5626                          &       speccomb_mco,   specparm_mco,   specmult_mco,   fmco,      &
            5627                          &       speccomb_planck,specparm_planck,specmult_planck,fpl,       &
            5628                          &       refrat_planck_a, refrat_m_a, refrat_m_a3, ratco2,          &
            5629                          &       adjfac, adjcolco2, com1, com2, absco, abso3,               &
            5630                          &       fac000, fac100, fac200, fac010, fac110, fac210,            &
            5631                          &       fac001, fac101, fac201, fac011, fac111, fac211,            &
            5632                          &       p0, p40, fk00, fk10, fk20, p1, p41, fk01, fk11, fk21, temp
            5633                     !
            5634                     !===> ...  begin here
            5635                     !
            5636                     !  --- ...  minor gas mapping levels :
            5637                     !     lower - co2, p = 1053.63 mb, t = 294.2 k
            5638                     !     lower - co, p = 706 mb, t = 278.94 k
            5639                     !     upper - o3, p = 95.5835 mb, t = 215.7 k
            5640                     
            5641                     !  --- ...  calculate reference ratio to be used in calculation of planck
            5642                     !           fraction in lower/upper atmosphere.
            5643                     
            5644                           refrat_planck_a = chi_mls(1,5)/chi_mls(4,5)        ! p = 473.420 mb (level 5)
            5645                           refrat_m_a = chi_mls(1,1)/chi_mls(4,1)             ! p = 1053. (level 1)
            5646                           refrat_m_a3 = chi_mls(1,3)/chi_mls(4,3)            ! p = 706. (level 3)
            5647                     
            5648                     !  --- ...  lower atmosphere loop
            5649                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      coldry, colamt, rfrate, jp, jt, fac10
                                   <<<      fac00, jt1, fac11, fac01, indminor
                                   <<<      minorfrac
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      indself: 1, selffrac: 1, selffac: 1
                                   <<<      indfor: 1, forfrac: 1, forfac: 1
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 58
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 40  FILL 103
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5650     1  pp    v            do k = 1, laytrop
            5651     1   p    v              speccomb = colamt(k,1) + rfrate(k,3,1)*colamt(k,4)
            5652     1   p    v              specparm = colamt(k,1) / speccomb
            5653     1   p    v              specmult = 8.0 * min(specparm, oneminus)
            5654     1   p    v              js = 1 + int(specmult)
            5655     1   p    v              fs = mod(specmult, f_one)
            5656     1   p    v              ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(13) + js
            5657     1               
            5658     1   p    v              speccomb1 = colamt(k,1) + rfrate(k,3,2)*colamt(k,4)
            5659     1   p    v              specparm1 = colamt(k,1) / speccomb1
            5660     1   p    v              specmult1 = 8.0 * min(specparm1, oneminus)
            5661     1   p    v              js1 = 1 + int(specmult1)
            5662     1   p    v              fs1 = mod(specmult1, f_one)
            5663     1   p    v              ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(13) + js1
            5664     1               
            5665     1   p    v              speccomb_mco2 = colamt(k,1) + refrat_m_a*colamt(k,4)
            5666     1   p    v              specparm_mco2 = colamt(k,1) / speccomb_mco2
            5667     1   p    v              specmult_mco2 = 8.0 * min(specparm_mco2, oneminus)
            5668     1   p    v              jmco2 = 1 + int(specmult_mco2)
            5669     1   p    v              fmco2 = mod(specmult_mco2, f_one)
            5670     1               
            5671     1               !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            5672     1               !           a minor species, adjust the column amount of co2 by an empirical factor
            5673     1               !           to obtain the proper contribution.
            5674     1               
            5675     1   p    v              speccomb_mco = colamt(k,1) + refrat_m_a3*colamt(k,4)
            5676     1   p    v              specparm_mco = colamt(k,1) / speccomb_mco
            5677     1   p    v              specmult_mco = 8.0 * min(specparm_mco, oneminus)
            5678     1   p    v              jmco = 1 + int(specmult_mco)
            5679     1   p    v              fmco = mod(specmult_mco, f_one)
            5680     1               
            5681     1   p    v              speccomb_planck = colamt(k,1) + refrat_planck_a*colamt(k,4)
            5682     1   p    v              specparm_planck = colamt(k,1) / speccomb_planck
            5683     1   p    v              specmult_planck = 8.0 * min(specparm_planck, oneminus)
            5684     1   p    v              jpl = 1 + int(specmult_planck)
            5685     1   p    v              fpl = mod(specmult_planck, f_one)
            5686     1               
            5687     1   p    v              inds = indself(k)
            5688     1   p    v              indf = indfor(k)
            5689     1   p    v              indm = indminor(k)
            5690     1   p    v              indsp = inds + 1
            5691     1   p    v              indfp = indf + 1
            5692     1   p    v              indmp = indm + 1
            5693     1   p    v              jplp  = jpl  + 1
            5694     1   p    v              jmco2p= jmco2+ 1
            5695     1   p    v              jmcop = jmco + 1
            5696     1               
            5697     1               !  --- ...  in atmospheres where the amount of co2 is too great to be considered
            5698     1               !           a minor species, adjust the column amount of co2 by an empirical factor
            5699     1               !           to obtain the proper contribution.
            5700     1               
            5701     1   p    v              temp   = coldry(k) * 3.55e-4
            5702     1   p    v              ratco2 = colamt(k,2) / temp
            5703     2   p    v              if (ratco2 > 3.0) then
            5704     2   p    v                adjfac = 2.0 + (ratco2-2.0)**0.68
            5705     2   p    v                adjcolco2 = adjfac * temp
            5706     2   p    v              else
            5707     2   p    v                adjcolco2 = colamt(k,2)
            5708     2   p    v              endif
            5709     1               
            5710     2   p    v              if (specparm < 0.125 .and. specparm1 < 0.125) then
            5711     2   p    v                p0 = fs - f_one
            5712     2   p    v                p40 = p0**4
            5713     2   p    v                fk00 = p40
            5714     2   p    v                fk10 = f_one - p0 - 2.0*p40
            5715     2   p    v                fk20 = p0 + p40
            5716     2               
            5717     2   p    v                p1 = fs1 - f_one
            5718     2   p    v                p41 = p1**4
            5719     2   p    v                fk01 = p41
            5720     2   p    v                fk11 = f_one - p1 - 2.0*p41
            5721     2   p    v                fk21 = p1 + p41
            5722     2               
            5723     2   p    v                id000 = ind0
            5724     2   p    v                id010 = ind0 + 9
            5725     2   p    v                id100 = ind0 + 1
            5726     2   p    v                id110 = ind0 +10
            5727     2   p    v                id200 = ind0 + 2
            5728     2   p    v                id210 = ind0 +11
            5729     2               
            5730     2   p    v                id001 = ind1
            5731     2   p    v                id011 = ind1 + 9
            5732     2   p    v                id101 = ind1 + 1
            5733     2   p    v                id111 = ind1 +10
            5734     2   p    v                id201 = ind1 + 2
            5735     2   p    v                id211 = ind1 +11
            5736     2   p    v              elseif (specparm > 0.875 .and. specparm1 > 0.875) then
            5737     2   p    v                p0 = -fs
            5738     2   p    v                p40 = p0**4
            5739     2   p    v                fk00 = p40
            5740     2   p    v                fk10 = f_one - p0 - 2.0*p40
            5741     2   p    v                fk20 = p0 + p40
            5742     2               
            5743     2   p    v                p1 = -fs1
            5744     2   p    v                p41 = p1**4
            5745     2   p    v                fk01 = p41
            5746     2   p    v                fk11 = f_one - p1 - 2.0*p41
            5747     2   p    v                fk21 = p1 + p41
            5748     2               
            5749     2   p    v                id000 = ind0 + 1
            5750     2   p    v                id010 = ind0 +10
            5751     2   p    v                id100 = ind0
            5752     2   p    v                id110 = ind0 + 9
            5753     2   p    v                id200 = ind0 - 1
            5754     2   p    v                id210 = ind0 + 8
            5755     2               
            5756     2   p    v                id001 = ind1 + 1
            5757     2   p    v                id011 = ind1 +10
            5758     2   p    v                id101 = ind1
            5759     2   p    v                id111 = ind1 + 9
            5760     2   p    v                id201 = ind1 - 1
            5761     2   p    v                id211 = ind1 + 8
            5762     2   p    v              else
            5763     2   p    v                fk00 = f_one - fs
            5764     2   p    v                fk10 = fs
            5765     2   p    v                fk20 = f_zero
            5766     2               
            5767     2   p    v                fk01 = f_one - fs1
            5768     2   p    v                fk11 = fs1
            5769     2   p    v                fk21 = f_zero
            5770     2               
            5771     2   p    v                id000 = ind0
            5772     2   p    v                id010 = ind0 + 9
            5773     2   p    v                id100 = ind0 + 1
            5774     2   p    v                id110 = ind0 +10
            5775     2   p    v                id200 = ind0
            5776     2   p    v                id210 = ind0
            5777     2               
            5778     2   p    v                id001 = ind1
            5779     2   p    v                id011 = ind1 + 9
            5780     2   p    v                id101 = ind1 + 1
            5781     2   p    v                id111 = ind1 +10
            5782     2   p    v                id201 = ind1
            5783     2   p    v                id211 = ind1
            5784     2   p    v              endif
            5785     1               
            5786     1   p    v              fac000 = fk00 * fac00(k)
            5787     1   p    v              fac100 = fk10 * fac00(k)
            5788     1   p    v              fac200 = fk20 * fac00(k)
            5789     1   p    v              fac010 = fk00 * fac10(k)
            5790     1   p    v              fac110 = fk10 * fac10(k)
            5791     1   p    v              fac210 = fk20 * fac10(k)
            5792     1               
            5793     1   p    v              fac001 = fk01 * fac01(k)
            5794     1   p    v              fac101 = fk11 * fac01(k)
            5795     1   p    v              fac201 = fk21 * fac01(k)
            5796     1   p    v              fac011 = fk01 * fac11(k)
            5797     1   p    v              fac111 = fk11 * fac11(k)
            5798     1   p    v              fac211 = fk21 * fac11(k)
            5799     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5800     2   p   f               do ig = 1, ng13
            5801     2   p   fv                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            5802     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            5803     2   p   fv                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            5804     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            5805     2   p   fv                co2m1   = ka_mco2(ig,jmco2,indm) + fmco2                      &
            5806     2                    &            * (ka_mco2(ig,jmco2p,indm) - ka_mco2(ig,jmco2,indm))
            5807     2   p   fv                co2m2   = ka_mco2(ig,jmco2,indmp) + fmco2                     &
            5808     2                    &            * (ka_mco2(ig,jmco2p,indmp) - ka_mco2(ig,jmco2,indmp))
            5809     2   p   fv                absco2  = co2m1 + minorfrac(k) * (co2m2 - co2m1)
            5810     2   p   fv                com1    = ka_mco(ig,jmco,indm) + fmco                         &
            5811     2                    &            * (ka_mco(ig,jmcop,indm) - ka_mco(ig,jmco,indm))
            5812     2   p   fv                com2    = ka_mco(ig,jmco,indmp) + fmco                        &
            5813     2                    &            * (ka_mco(ig,jmcop,indmp) - ka_mco(ig,jmco,indmp))
            5814     2   p   fv                absco   = com1 + minorfrac(k) * (com2 - com1)
            5815     2               
            5816     2   p   fv                taug(ns13+ig,k) = speccomb                                    &
            5817     2                    &                * (fac000*absa(ig,id000) + fac010*absa(ig,id010)  &
            5818     2                    &                +  fac100*absa(ig,id100) + fac110*absa(ig,id110)  &
            5819     2                    &                +  fac200*absa(ig,id200) + fac210*absa(ig,id210)) &
            5820     2                    &                +     speccomb1                                   &
            5821     2                    &                * (fac001*absa(ig,id001) + fac011*absa(ig,id011)  &
            5822     2                    &                +  fac101*absa(ig,id101) + fac111*absa(ig,id111)  &
            5823     2                    &                +  fac201*absa(ig,id201) + fac211*absa(ig,id211)) &
            5824     2                    &                + tauself + taufor + adjcolco2*absco2             &
            5825     2                    &                + colamt(k,7)*absco
            5826     2               
            5827     2   p   fv                fracs(ns13+ig,k) = fracrefa(ig,jpl) + fpl                     &
            5828     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            5829     2   p   fv              enddo
            5830     1   p    v            enddo
            5831                     
            5832                     !  --- ...  upper atmosphere loop
            5833                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 160
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.16, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      minorfrac, colamt, indminor
                                   <<< Loop-information  End >>>
            5834     1  pp    v            do k = laytrop+1, nlay
            5835     1   p    v              indm = indminor(k)
            5836     1   p    v              indmp = indm + 1
            5837     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5838     2   p   f               do ig = 1, ng13
            5839     2   p   fv                abso3 = kb_mo3(ig,indm) + minorfrac(k)                        &
            5840     2                    &          * (kb_mo3(ig,indmp) - kb_mo3(ig,indm))
            5841     2               
            5842     2   p   fv                taug(ns13+ig,k) = colamt(k,3)*abso3
            5843     2               
            5844     2   p   fv                fracs(ns13+ig,k) =  fracrefb(ig)
            5845     2   p   fv              enddo
            5846     1   p    v            enddo
            5847                     
            5848                     ! ..................................
            5849                           end subroutine taugb13
            5850                     ! ----------------------------------
            5851                     
            5852                     ! ----------------------------------
            5853                           subroutine taugb14
            5854                     ! ..................................
            5855                     
            5856                     !  ------------------------------------------------------------------  !
            5857                     !     band 14:  2250-2380 cm-1 (low - co2; high - co2)                 !
            5858                     !  ------------------------------------------------------------------  !
            5859                     
            5860                           use module_radlw_kgb14
            5861                     
            5862                     !  ---  locals:
            5863                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            5864                          &       ig
            5865                     
            5866                           real (kind=kind_phys) :: tauself, taufor
            5867                     !
            5868                     !===> ...  begin here
            5869                     !
            5870                     !  --- ...  lower atmosphere loop
            5871                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 77
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jp, jt, jt1, indself, fac00, indfor
                                   <<<      fac01, fac10, colamt, selffac, forfac
                                   <<<      fac11, selffrac, forfrac
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5872     1  pp    v            do k = 1, laytrop
            5873     1   p    v              ind0 = ((jp(k)-1)*5 + (jt (k)-1)) * nspa(14) + 1
            5874     1   p    v              ind1 = ( jp(k)   *5 + (jt1(k)-1)) * nspa(14) + 1
            5875     1               
            5876     1   p    v              inds = indself(k)
            5877     1   p    v              indf = indfor(k)
            5878     1   p    v              ind0p = ind0 + 1
            5879     1   p    v              ind1p = ind1 + 1
            5880     1   p    v              indsp = inds + 1
            5881     1   p    v              indfp = indf + 1
            5882     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5883     2   p   f               do ig = 1, ng14
            5884     2   p   fv                tauself = selffac(k) * (selfref(ig,inds) + selffrac(k)        &
            5885     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            5886     2   p   fv                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            5887     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            5888     2               
            5889     2   p   fv                taug(ns14+ig,k) = colamt(k,2)                                 &
            5890     2                    &            * (fac00(k)*absa(ig,ind0) + fac10(k)*absa(ig,ind0p)   &
            5891     2                    &            +  fac01(k)*absa(ig,ind1) + fac11(k)*absa(ig,ind1p))  &
            5892     2                    &            + tauself + taufor
            5893     2               
            5894     2   p   fv                fracs(ns14+ig,k) = fracrefa(ig)
            5895     2   p   fv              enddo
            5896     1   p    v            enddo
            5897                     
            5898                     !  --- ...  upper atmosphere loop
            5899                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 132
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jt, fac10, colamt, jp, fac01, fac00, jt1
                                   <<<      fac11
                                   <<< Loop-information  End >>>
            5900     1  pp    v            do k = laytrop+1, nlay
            5901     1   p    v              ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(14) + 1
            5902     1   p    v              ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(14) + 1
            5903     1               
            5904     1   p    v              ind0p = ind0 + 1
            5905     1   p    v              ind1p = ind1 + 1
            5906     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            5907     2   p   f               do ig = 1, ng14
            5908     2   p   fv                taug(ns14+ig,k) = colamt(k,2)                                 &
            5909     2                    &             * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)  &
            5910     2                    &             +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))
            5911     2               
            5912     2   p   fv                fracs(ns14+ig,k) = fracrefb(ig)
            5913     2   p   fv              enddo
            5914     1   p    v            enddo
            5915                     
            5916                     ! ..................................
            5917                           end subroutine taugb14
            5918                     ! ----------------------------------
            5919                     
            5920                     ! ----------------------------------
            5921                           subroutine taugb15
            5922                     ! ..................................
            5923                     
            5924                     !  ------------------------------------------------------------------  !
            5925                     !     band 15:  2380-2600 cm-1 (low - n2o,co2; low minor - n2)         !
            5926                     !                              (high - nothing)                        !
            5927                     !  ------------------------------------------------------------------  !
            5928                     
            5929                           use module_radlw_kgb15
            5930                     
            5931                     !  ---  locals:
            5932                           integer :: k, ind0, ind1, inds, indsp, indf, indfp, indm, indmp,  &
            5933                          &       id000, id010, id100, id110, id200, id210, jpl, jplp,       &
            5934                          &       id001, id011, id101, id111, id201, id211, jmn2, jmn2p,     &
            5935                          &       ig, js, js1
            5936                     
            5937                           real (kind=kind_phys) :: scalen2, tauself, taufor,                &
            5938                          &       speccomb,       specparm,       specmult,       fs,        &
            5939                          &       speccomb1,      specparm1,      specmult1,      fs1,       &
            5940                          &       speccomb_mn2,   specparm_mn2,   specmult_mn2,   fmn2,      &
            5941                          &       speccomb_planck,specparm_planck,specmult_planck,fpl,       &
            5942                          &       refrat_planck_a, refrat_m_a, n2m1, n2m2, taun2,            &
            5943                          &       fac000, fac100, fac200, fac010, fac110, fac210,            &
            5944                          &       fac001, fac101, fac201, fac011, fac111, fac211,            &
            5945                          &       p0, p40, fk00, fk10, fk20, p1, p41, fk01, fk11, fk21
            5946                     !
            5947                     !===> ...  begin here
            5948                     !
            5949                     !  --- ...  minor gas mapping level :
            5950                     !     lower - nitrogen continuum, p = 1053., t = 294.
            5951                     
            5952                     !  --- ...  calculate reference ratio to be used in calculation of planck
            5953                     !           fraction in lower atmosphere.
            5954                     
            5955                           refrat_planck_a = chi_mls(4,1)/chi_mls(2,1)      ! p = 1053. mb (level 1)
            5956                           refrat_m_a = chi_mls(4,1)/chi_mls(2,1)           ! p = 1053. mb
            5957                     
            5958                     !  --- ...  lower atmosphere loop
            5959                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 21
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, rfrate, jp, jt, fac10, fac00
                                   <<<      jt1, fac11, fac01, indminor, minorfrac
                                   <<<      scaleminor, colbrd, indfor
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      forfrac: 2, forfac: 2, indself: 2
                                   <<<      selffac: 2, selffrac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 14
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 20  FILL 26
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            5960     1  pp    v            do k = 1, laytrop
            5961     1   p    v              speccomb = colamt(k,4) + rfrate(k,5,1)*colamt(k,2)
            5962     1   p    v              specparm = colamt(k,4) / speccomb
            5963     1   p    v              specmult = 8.0 * min(specparm, oneminus)
            5964     1   p    v              js = 1 + int(specmult)
            5965     1   p    v              fs = mod(specmult, f_one)
            5966     1   p    v              ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(15) + js
            5967     1               
            5968     1   p    v              speccomb1 = colamt(k,4) + rfrate(k,5,2)*colamt(k,2)
            5969     1   p    v              specparm1 = colamt(k,4) / speccomb1
            5970     1   p    v              specmult1 = 8.0 * min(specparm1, oneminus)
            5971     1   p    v              js1 = 1 + int(specmult1)
            5972     1   p    v              fs1 = mod(specmult1, f_one)
            5973     1   p    v              ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(15) + js1
            5974     1               
            5975     1   p    v              speccomb_mn2 = colamt(k,4) + refrat_m_a*colamt(k,2)
            5976     1   p    v              specparm_mn2 = colamt(k,4) / speccomb_mn2
            5977     1   p    v              specmult_mn2 = 8.0 * min(specparm_mn2, oneminus)
            5978     1   p    v              jmn2 = 1 + int(specmult_mn2)
            5979     1   p    v              fmn2 = mod(specmult_mn2, f_one)
            5980     1               
            5981     1   p    v              speccomb_planck = colamt(k,4) + refrat_planck_a*colamt(k,2)
            5982     1   p    v              specparm_planck = colamt(k,4) / speccomb_planck
            5983     1   p    v              specmult_planck = 8.0 * min(specparm_planck, oneminus)
            5984     1   p    v              jpl = 1 + int(specmult_planck)
            5985     1   p    v              fpl = mod(specmult_planck, f_one)
            5986     1               
            5987     1   p    v              scalen2 = colbrd(k) * scaleminor(k)
            5988     1               
            5989     1   p    v              inds = indself(k)
            5990     1   p    v              indf = indfor(k)
            5991     1   p    v              indm = indminor(k)
            5992     1   p    v              indsp = inds + 1
            5993     1   p    v              indfp = indf + 1
            5994     1   p    v              indmp = indm + 1
            5995     1   p    v              jplp  = jpl  + 1
            5996     1   p    v              jmn2p = jmn2 + 1
            5997     1               
            5998     2   p    v              if (specparm < 0.125 .and. specparm1 < 0.125) then
            5999     2   p    v                p0 = fs - f_one
            6000     2   p    v                p40 = p0**4
            6001     2   p    v                fk00 = p40
            6002     2   p    v                fk10 = f_one - p0 - 2.0*p40
            6003     2   p    v                fk20 = p0 + p40
            6004     2               
            6005     2   p    v                p1 = fs1 - f_one
            6006     2   p    v                p41 = p1**4
            6007     2   p    v                fk01 = p41
            6008     2   p    v                fk11 = f_one - p1 - 2.0*p41
            6009     2   p    v                fk21 = p1 + p41
            6010     2               
            6011     2   p    v                id000 = ind0
            6012     2   p    v                id010 = ind0 + 9
            6013     2   p    v                id100 = ind0 + 1
            6014     2   p    v                id110 = ind0 +10
            6015     2   p    v                id200 = ind0 + 2
            6016     2   p    v                id210 = ind0 +11
            6017     2               
            6018     2   p    v                id001 = ind1
            6019     2   p    v                id011 = ind1 + 9
            6020     2   p    v                id101 = ind1 + 1
            6021     2   p    v                id111 = ind1 +10
            6022     2   p    v                id201 = ind1 + 2
            6023     2   p    v                id211 = ind1 +11
            6024     2   p    v              elseif (specparm > 0.875 .and. specparm1 > 0.875) then
            6025     2   p    v                p0 = -fs
            6026     2   p    v                p40 = p0**4
            6027     2   p    v                fk00 = p40
            6028     2   p    v                fk10 = f_one - p0 - 2.0*p40
            6029     2   p    v                fk20 = p0 + p40
            6030     2               
            6031     2   p    v                p1 = -fs1
            6032     2   p    v                p41 = p1**4
            6033     2   p    v                fk01 = p41
            6034     2   p    v                fk11 = f_one - p1 - 2.0*p41
            6035     2   p    v                fk21 = p1 + p41
            6036     2               
            6037     2   p    v                id000 = ind0 + 1
            6038     2   p    v                id010 = ind0 +10
            6039     2   p    v                id100 = ind0
            6040     2   p    v                id110 = ind0 + 9
            6041     2   p    v                id200 = ind0 - 1
            6042     2   p    v                id210 = ind0 + 8
            6043     2               
            6044     2   p    v                id001 = ind1 + 1
            6045     2   p    v                id011 = ind1 +10
            6046     2   p    v                id101 = ind1
            6047     2   p    v                id111 = ind1 + 9
            6048     2   p    v                id201 = ind1 - 1
            6049     2   p    v                id211 = ind1 + 8
            6050     2   p    v              else
            6051     2   p    v                fk00 = f_one - fs
            6052     2   p    v                fk10 = fs
            6053     2   p    v                fk20 = f_zero
            6054     2               
            6055     2   p    v                fk01 = f_one - fs1
            6056     2   p    v                fk11 = fs1
            6057     2   p    v                fk21 = f_zero
            6058     2               
            6059     2   p    v                id000 = ind0
            6060     2   p    v                id010 = ind0 + 9
            6061     2   p    v                id100 = ind0 + 1
            6062     2   p    v                id110 = ind0 +10
            6063     2   p    v                id200 = ind0
            6064     2   p    v                id210 = ind0
            6065     2               
            6066     2   p    v                id001 = ind1
            6067     2   p    v                id011 = ind1 + 9
            6068     2   p    v                id101 = ind1 + 1
            6069     2   p    v                id111 = ind1 +10
            6070     2   p    v                id201 = ind1
            6071     2   p    v                id211 = ind1
            6072     2   p    v              endif
            6073     1               
            6074     1   p    v              fac000 = fk00 * fac00(k)
            6075     1   p    v              fac100 = fk10 * fac00(k)
            6076     1   p    v              fac200 = fk20 * fac00(k)
            6077     1   p    v              fac010 = fk00 * fac10(k)
            6078     1   p    v              fac110 = fk10 * fac10(k)
            6079     1   p    v              fac210 = fk20 * fac10(k)
            6080     1               
            6081     1   p    v              fac001 = fk01 * fac01(k)
            6082     1   p    v              fac101 = fk11 * fac01(k)
            6083     1   p    v              fac201 = fk21 * fac01(k)
            6084     1   p    v              fac011 = fk01 * fac11(k)
            6085     1   p    v              fac111 = fk11 * fac11(k)
            6086     1   p    v              fac211 = fk21 * fac11(k)
            6087     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            6088     2   p   f               do ig = 1, ng15
            6089     2   p   fv                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            6090     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            6091     2   p   fv                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            6092     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            6093     2   p   fv                n2m1    = ka_mn2(ig,jmn2,indm) + fmn2                         &
            6094     2                    &            * (ka_mn2(ig,jmn2p,indm) - ka_mn2(ig,jmn2,indm))
            6095     2   p   fv                n2m2    = ka_mn2(ig,jmn2,indmp) + fmn2                        &
            6096     2                    &            * (ka_mn2(ig,jmn2p,indmp) - ka_mn2(ig,jmn2,indmp))
            6097     2   p   fv                taun2   = scalen2 * (n2m1 + minorfrac(k) * (n2m2 - n2m1))
            6098     2               
            6099     2   p   fv                taug(ns15+ig,k) = speccomb                                    &
            6100     2                    &                * (fac000*absa(ig,id000) + fac010*absa(ig,id010)  &
            6101     2                    &                +  fac100*absa(ig,id100) + fac110*absa(ig,id110)  &
            6102     2                    &                +  fac200*absa(ig,id200) + fac210*absa(ig,id210)) &
            6103     2                    &                +     speccomb1                                   &
            6104     2                    &                * (fac001*absa(ig,id001) + fac011*absa(ig,id011)  &
            6105     2                    &                +  fac101*absa(ig,id101) + fac111*absa(ig,id111)  &
            6106     2                    &                +  fac201*absa(ig,id201) + fac211*absa(ig,id211)) &
            6107     2                    &                + tauself + taufor + taun2
            6108     2               
            6109     2   p   fv                fracs(ns15+ig,k) = fracrefa(ig,jpl) + fpl                     &
            6110     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            6111     2   p   fv              enddo
            6112     1   p    v            enddo
            6113                     
            6114                     !  --- ...  upper atmosphere loop
            6115                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            6116     1  pp   2v            do k = laytrop+1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            6117     2   p   f               do ig = 1, ng15
            6118     2   p   fv                taug(ns15+ig,k) = f_zero
            6119     2               
            6120     2   p   fv                fracs(ns15+ig,k) = f_zero
            6121     2   p   fv              enddo
            6122     1   p   2v            enddo
            6123                     
            6124                     ! ..................................
            6125                           end subroutine taugb15
            6126                     ! ----------------------------------
            6127                     
            6128                     ! ----------------------------------
            6129                           subroutine taugb16
            6130                     ! ..................................
            6131                     
            6132                     !  ------------------------------------------------------------------  !
            6133                     !     band 16:  2600-3250 cm-1 (low key- h2o,ch4; high key - ch4)      !
            6134                     !  ------------------------------------------------------------------  !
            6135                     
            6136                           use module_radlw_kgb16
            6137                     
            6138                     !  ---  locals:
            6139                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            6140                          &       id000, id010, id100, id110, id200, id210, jpl, jplp,       &
            6141                          &       id001, id011, id101, id111, id201, id211, ig, js, js1
            6142                     
            6143                           real (kind=kind_phys) :: tauself, taufor, refrat_planck_a,        &
            6144                          &       speccomb,       specparm,       specmult,       fs,        &
            6145                          &       speccomb1,      specparm1,      specmult1,      fs1,       &
            6146                          &       speccomb_planck,specparm_planck,specmult_planck,fpl,       &
            6147                          &       fac000, fac100, fac200, fac010, fac110, fac210,            &
            6148                          &       fac001, fac101, fac201, fac011, fac111, fac211,            &
            6149                          &       p0, p40, fk00, fk10, fk20, p1, p41, fk01, fk11, fk21
            6150                     !
            6151                     !===> ...  begin here
            6152                     !
            6153                     !  --- ...  calculate reference ratio to be used in calculation of planck
            6154                     !           fraction in lower atmosphere.
            6155                     
            6156                           refrat_planck_a = chi_mls(1,6)/chi_mls(6,6)        ! p = 387. mb (level 6)
            6157                     
            6158                     !  --- ...  lower atmosphere loop
            6159                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 25
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colamt, rfrate, jp, jt, fac10, fac00
                                   <<<      jt1, fac11, fac01, indfor, forfrac
                                   <<<      indself, selffrac, selffac
                                   <<<    PREFETCH(SOFT) : 2
                                   <<<     SEQUENTIAL : 2
                                   <<<      forfac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 7
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 8  FILL 14
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            6160     1  pp    v            do k = 1, laytrop
            6161     1   p    v              speccomb = colamt(k,1) + rfrate(k,4,1)*colamt(k,5)
            6162     1   p    v              specparm = colamt(k,1) / speccomb
            6163     1   p    v              specmult = 8.0 * min(specparm, oneminus)
            6164     1   p    v              js = 1 + int(specmult)
            6165     1   p    v              fs = mod(specmult, f_one)
            6166     1   p    v              ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(16) + js
            6167     1               
            6168     1   p    v              speccomb1 = colamt(k,1) + rfrate(k,4,2)*colamt(k,5)
            6169     1   p    v              specparm1 = colamt(k,1) / speccomb1
            6170     1   p    v              specmult1 = 8.0 * min(specparm1, oneminus)
            6171     1   p    v              js1 = 1 + int(specmult1)
            6172     1   p    v              fs1 = mod(specmult1, f_one)
            6173     1   p    v              ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(16) + js1
            6174     1               
            6175     1   p    v              speccomb_planck = colamt(k,1) + refrat_planck_a*colamt(k,5)
            6176     1   p    v              specparm_planck = colamt(k,1) / speccomb_planck
            6177     1   p    v              specmult_planck = 8.0 * min(specparm_planck, oneminus)
            6178     1   p    v              jpl = 1 + int(specmult_planck)
            6179     1   p    v              fpl = mod(specmult_planck, f_one)
            6180     1               
            6181     1   p    v              inds = indself(k)
            6182     1   p    v              indf = indfor(k)
            6183     1   p    v              indsp = inds + 1
            6184     1   p    v              indfp = indf + 1
            6185     1   p    v              jplp  = jpl  + 1
            6186     1               
            6187     2   p    v              if (specparm < 0.125 .and. specparm1 < 0.125) then
            6188     2   p    v                p0 = fs - f_one
            6189     2   p    v                p40 = p0**4
            6190     2   p    v                fk00 = p40
            6191     2   p    v                fk10 = f_one - p0 - 2.0*p40
            6192     2   p    v                fk20 = p0 + p40
            6193     2               
            6194     2   p    v                p1 = fs1 - f_one
            6195     2   p    v                p41 = p1**4
            6196     2   p    v                fk01 = p41
            6197     2   p    v                fk11 = f_one - p1 - 2.0*p41
            6198     2   p    v                fk21 = p1 + p41
            6199     2               
            6200     2   p    v                id000 = ind0
            6201     2   p    v                id010 = ind0 + 9
            6202     2   p    v                id100 = ind0 + 1
            6203     2   p    v                id110 = ind0 +10
            6204     2   p    v                id200 = ind0 + 2
            6205     2   p    v                id210 = ind0 +11
            6206     2               
            6207     2   p    v                id001 = ind1
            6208     2   p    v                id011 = ind1 + 9
            6209     2   p    v                id101 = ind1 + 1
            6210     2   p    v                id111 = ind1 +10
            6211     2   p    v                id201 = ind1 + 2
            6212     2   p    v                id211 = ind1 +11
            6213     2   p    v              elseif (specparm > 0.875 .and. specparm1 > 0.875) then
            6214     2   p    v                p0 = -fs
            6215     2   p    v                p40 = p0**4
            6216     2   p    v                fk00 = p40
            6217     2   p    v                fk10 = f_one - p0 - 2.0*p40
            6218     2   p    v                fk20 = p0 + p40
            6219     2               
            6220     2   p    v                p1 = -fs1
            6221     2   p    v                p41 = p1**4
            6222     2   p    v                fk01 = p41
            6223     2   p    v                fk11 = f_one - p1 - 2.0*p41
            6224     2   p    v                fk21 = p1 + p41
            6225     2               
            6226     2   p    v                id000 = ind0 + 1
            6227     2   p    v                id010 = ind0 +10
            6228     2   p    v                id100 = ind0
            6229     2   p    v                id110 = ind0 + 9
            6230     2   p    v                id200 = ind0 - 1
            6231     2   p    v                id210 = ind0 + 8
            6232     2               
            6233     2   p    v                id001 = ind1 + 1
            6234     2   p    v                id011 = ind1 +10
            6235     2   p    v                id101 = ind1
            6236     2   p    v                id111 = ind1 + 9
            6237     2   p    v                id201 = ind1 - 1
            6238     2   p    v                id211 = ind1 + 8
            6239     2   p    v              else
            6240     2   p    v                fk00 = f_one - fs
            6241     2   p    v                fk10 = fs
            6242     2   p    v                fk20 = f_zero
            6243     2               
            6244     2   p    v                fk01 = f_one - fs1
            6245     2   p    v                fk11 = fs1
            6246     2   p    v                fk21 = f_zero
            6247     2               
            6248     2   p    v                id000 = ind0
            6249     2   p    v                id010 = ind0 + 9
            6250     2   p    v                id100 = ind0 + 1
            6251     2   p    v                id110 = ind0 +10
            6252     2   p    v                id200 = ind0
            6253     2   p    v                id210 = ind0
            6254     2               
            6255     2   p    v                id001 = ind1
            6256     2   p    v                id011 = ind1 + 9
            6257     2   p    v                id101 = ind1 + 1
            6258     2   p    v                id111 = ind1 +10
            6259     2   p    v                id201 = ind1
            6260     2   p    v                id211 = ind1
            6261     2   p    v              endif
            6262     1               
            6263     1   p    v              fac000 = fk00 * fac00(k)
            6264     1   p    v              fac100 = fk10 * fac00(k)
            6265     1   p    v              fac200 = fk20 * fac00(k)
            6266     1   p    v              fac010 = fk00 * fac10(k)
            6267     1   p    v              fac110 = fk10 * fac10(k)
            6268     1   p    v              fac210 = fk20 * fac10(k)
            6269     1               
            6270     1   p    v              fac001 = fk01 * fac01(k)
            6271     1   p    v              fac101 = fk11 * fac01(k)
            6272     1   p    v              fac201 = fk21 * fac01(k)
            6273     1   p    v              fac011 = fk01 * fac11(k)
            6274     1   p    v              fac111 = fk11 * fac11(k)
            6275     1   p    v              fac211 = fk21 * fac11(k)
            6276     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            6277     2   p   f               do ig = 1, ng16
            6278     2   p   fv                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            6279     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            6280     2   p   fv                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            6281     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            6282     2               
            6283     2   p   fv                taug(ns16+ig,k) = speccomb                                    &
            6284     2                    &                * (fac000*absa(ig,id000) + fac010*absa(ig,id010)  &
            6285     2                    &                +  fac100*absa(ig,id100) + fac110*absa(ig,id110)  &
            6286     2                    &                +  fac200*absa(ig,id200) + fac210*absa(ig,id210)) &
            6287     2                    &                +     speccomb1                                   &
            6288     2                    &                * (fac001*absa(ig,id001) + fac011*absa(ig,id011)  &
            6289     2                    &                +  fac101*absa(ig,id101) + fac111*absa(ig,id111)  &
            6290     2                    &                +  fac201*absa(ig,id201) + fac211*absa(ig,id211)) &
            6291     2                    &                + tauself + taufor
            6292     2               
            6293     2   p   fv                fracs(ns16+ig,k) = fracrefa(ig,jpl) + fpl                     &
            6294     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            6295     2   p   fv              enddo
            6296     1   p    v            enddo
            6297                     
            6298                     !  --- ...  upper atmosphere loop
            6299                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 132
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jt, fac10, colamt, jp, fac01, fac00, jt1
                                   <<<      fac11
                                   <<< Loop-information  End >>>
            6300     1  pp    v            do k = laytrop+1, nlay
            6301     1   p    v              ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(16) + 1
            6302     1   p    v              ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(16) + 1
            6303     1               
            6304     1   p    v              ind0p = ind0 + 1
            6305     1   p    v              ind1p = ind1 + 1
            6306     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            6307     2   p   f               do ig = 1, ng16
            6308     2   p   fv                taug(ns16+ig,k) = colamt(k,5)                                 &
            6309     2                    &           * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)    &
            6310     2                    &           +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))
            6311     2               
            6312     2   p   fv                fracs(ns16+ig,k) = fracrefb(ig)
            6313     2   p   fv              enddo
            6314     1   p    v            enddo
            6315                     
            6316                     ! ..................................
            6317                           end subroutine taugb16

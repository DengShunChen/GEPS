            1099     5   p   2v                  enddo
            1100     4   p                       enddo
            1101     3                         endif
            1102     2               
            1103     2                       else                        ! output from sfc to toa
            1104     2               
            1105     2               !! --- ...  optional fluxes
            1106     3                         if ( lflxprf ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

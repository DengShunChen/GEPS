            4194     2                    &              +  fac101*absa(ig,id101) + fac111*absa(ig,id111)    &
            4195     2                    &              +  fac201*absa(ig,id201) + fac211*absa(ig,id211))
            4196     2               
            4197     2   p    v                taug(ns04+ig,k) = tau_major + tau_major1 + tauself + taufor
            4198     2               
            4199     2   p    v                fracs(ns04+ig,k) = fracrefa(ig,jpl) + fpl                     &
            4200     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            4201     2   p    v              enddo     ! end do_k_loop
            4202     1   p                 enddo   ! end do_ig_loop
            4203                     
            4204                     !  --- ...  upper atmosphere loop
            4205                     

            4263     2   p    v              enddo
            4264     1               
            4265     1               !  --- ...  empirical modification to code to improve stratospheric cooling rates
            4266     1               !           for co2. revised to apply weighting for g-point reduction in this band.
            4267     1               
            4268     1   p                   taug(ns04+ 8,k) = taug(ns04+ 8,k) * 0.92
            4269     1   p                   taug(ns04+ 9,k) = taug(ns04+ 9,k) * 0.88
            4270     1   p                   taug(ns04+10,k) = taug(ns04+10,k) * 1.07

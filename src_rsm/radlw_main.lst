            1146                           subroutine rlwinit                                                &
            1147                     !...................................
            1148                     !  ---  inputs:
            1149                          &     ( me , myrank)
            1150                     !  ---  outputs: (none)
            1151                     
            1152                     !  ===================  program usage description  ===================  !
            1153                     !                                                                       !
            1154                     ! purpose:  initialize non-varying module variables, conversion factors,!
            1155                     ! and look-up tables.                                                   !
            1156                     !                                                                       !
            1157                     ! subprograms called:  none                                             !
            1158                     !                                                                       !
            1159                     !  ====================  defination of variables  ====================  !
            1160                     !                                                                       !
            1161                     !  inputs:                                                              !
            1162                     !    me       - print control for parallel process                      !
            1163                     !                                                                       !
            1164                     !  outputs: (none)                                                      !
            1165                     !                                                                       !
            1166                     !  external module variables:  (in physpara)                            !
            1167                     !   ilwrate - heating rate unit selections                              !
            1168                     !           =1: output in k/day                                         !
            1169                     !           =2: output in k/second                                      !
            1170                     !   ilwrgas - control flag for rare gases (ch4,n2o,o2,cfcs, etc.)       !
            1171                     !           =0: do not include rare gases                               !
            1172                     !           >0: include all rare gases                                  !
            1173                     !   ilwcliq - liquid cloud optical properties contrl flag               !
            1174                     !           =0: input cloud opt depth from diagnostic scheme            !
            1175                     !           >0: input cwp,rew, and other cloud content parameters       !
            1176                     !   isubclw - sub-column cloud approximation control flag               !
            1177                     !           =0: no sub-col cld treatment, use grid-mean cld quantities  !
            1178                     !           =1: mcica sub-col, prescribed seeds to get random numbers   !
            1179                     !           =2: mcica sub-col, providing array icseed for random numbers!
            1180                     !   icldflg - cloud scheme control flag                                 !
            1181                     !           =0: diagnostic scheme gives cloud tau, omiga, and g.        !
            1182                     !           =1: prognostic scheme gives cloud liq/ice path, etc.        !
            1183                     !   iovrlw  - clouds vertical overlapping control flag                  !
            1184                     !           =0: random overlapping clouds                               !
            1185                     !           =1: maximum/random overlapping clouds                       !
            1186                     !           =2: maximum overlap cloud (isubcol>0 only)                  !
            1187                     !                                                                       !
            1188                     !  *******************************************************************  !
            1189                     !  original code description                                            !
            1190                     !                                                                       !
            1191                     !  original version:       michael j. iacono; july, 1998                !
            1192                     !  first revision for ncar ccm:               september, 1998           !
            1193                     !  second revision for rrtm_v3.0:             september, 2002           !
            1194                     !                                                                       !
            1195                     !  this subroutine performs calculations necessary for the initialization
            1196                     !  of the longwave model.  lookup tables are computed for use in the lw !
            1197                     !  radiative transfer, and input absorption coefficient data for each   !
            1198                     !  spectral band are reduced from 256 g-point intervals to 140.         !
            1199                     !                                                                       !
            1200                     !  *******************************************************************  !
            1201                     !                                                                       !
            1202                     ! definitions:                                                          !
            1203                     !   arrays for 10000-point look-up tables:                              !
            1204                     !   tau_tbl - clear-sky optical depth (used in cloudy radiative transfer!
            1205                     !   exp_tbl - exponential lookup table for tansmittance                 !
            1206                     !   tfn_tbl - tau transition function; i.e. the transition of the planck!
            1207                     !             function from that for the mean layer temperature to that !
            1208                     !             for the layer boundary temperature as a function of optical
            1209                     !             depth. the "linear in tau" method is used to make the table
            1210                     !                                                                       !
            1211                     !  *******************************************************************  !
            1212                     !                                                                       !
            1213                     !  ======================  end of description block  =================  !
            1214                     
            1215                     !  ---  inputs:
            1216                           integer, intent(in) :: me, myrank
            1217                     
            1218                     !  ---  outputs: none
            1219                     
            1220                     !  ---  locals:
            1221                           real (kind=kind_phys), parameter :: expeps = 1.e-20
            1222                     
            1223                           real (kind=kind_phys) :: tfn, pival, explimit
            1224                     
            1225                           integer               :: i
            1226                     
            1227                     !
            1228                     !===> ... begin here
            1229                     !
            1230     1                     if ( iovrlw<0 .or. iovrlw>2 ) then
            1231     1                       print *,'  *** error in specification of cloud overlap flag',   &
            1232     1                    &          ' iovrlw=',iovrlw,' in rlwinit !!'
            1233     1                       stop
            1234     1                     elseif ( iovrlw==2 .and. isubclw==0 ) then
            1235     2                       if (me == 0 .and. myrank == 0 ) then
            1236     2                         print *,'  *** iovrlw=2 - maximum cloud overlap, is not yet', &
            1237     2                    &          ' available for isubclw=0 setting!!'
            1238     2                         print *,'      the program uses maximum/random overlap',      &
            1239     2                    &          ' instead.'
            1240     2                       endif
            1241     1               
            1242     1                       iovrlw = 1
            1243     1                     endif
            1244                     
            1245     1                     if (me == 0 .and. myrank == 0 ) then
            1246     1                       print *,' - using aer longwave radiation, version: ', vtaglw
            1247     1               
            1248     2                       if (ilwrgas > 0) then
            1249     2                         print *,'   --- include rare gases n2o, ch4, o2, cfcs ',      &
            1250     2                    &            'absorptions in lw'
            1251     2                       else
            1252     2                         print *,'   --- rare gases effect is not included in lw'
            1253     2                       endif
            1254     1               
            1255     2                       if ( isubclw == 0 ) then
            1256     2                         print *,'   --- using standard grid average clouds, no ',     &
            1257     2                    &            'sub-column clouds approximation applied'
            1258     2                       elseif ( isubclw == 1 ) then
            1259     2                         print *,'   --- using mcica sub-colum clouds approximation ', &
            1260     2                    &            'with a prescribed sequence of permutaion seeds'
            1261     2                       elseif ( isubclw == 2 ) then
            1262     2                         print *,'   --- using mcica sub-colum clouds approximation ', &
            1263     2                    &            'with provided input array of permutation seeds'
            1264     2                       else
            1265     2                         print *,'  *** error in specification of sub-column cloud ',  &
            1266     2                    &            ' control flag isubclw =',isubclw,' !!'
            1267     2                         stop
            1268     2                       endif
            1269     1                     endif
            1270                     
            1271                     !  --- ...  check cloud flags for consistency
            1272                     
            1273     1                     if ((icldflg == 0 .and. ilwcliq /= 0) .or.                        &
            1274     1                    &    (icldflg == 1 .and. ilwcliq == 0)) then
            1275     1                       print *,'  *** model cloud scheme inconsistent with lw',        &
            1276     1                    &          ' radiation cloud radiative property setup !!'
            1277     1                       stop
            1278     1                     endif
            1279                     
            1280                     !  --- ...  setup default surface emissivity for each band here
            1281                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1282         s   fv            semiss0(:) = f_one
            1283                     
            1284                     !  --- ...  setup constant factors for flux and heating rate
            1285                     !           the 1.0e-2 is to convert pressure from mb to n/m**2
            1286                     
            1287                           pival = 2.0 * asin(f_one)
            1288                           fluxfac = pival * 2.0d4
            1289                     !     fluxfac = 62831.85307179586                   ! = 2 * pi * 1.0e4
            1290                     
            1291     1                     if (ilwrate == 1) then
            1292     1               !       heatfac = 8.4391
            1293     1               !       heatfac = con_g * 86400. * 1.0e-2 / con_cp  !   (in k/day)
            1294     1                       heatfac = con_g * 864.0 / con_cp            !   (in k/day)
            1295     1                     else
            1296     1                       heatfac = con_g * 1.0e-2 / con_cp           !   (in k/second)
            1297     1                     endif
            1298                     
            1299                     !  --- ...  compute lookup tables for transmittance, tau transition
            1300                     !           function, and clear sky tau (for the cloudy sky radiative
            1301                     !           transfer).  tau is computed as a function of the tau
            1302                     !           transition function, transmittance is calculated as a
            1303                     !           function of tau, and the tau transition function is
            1304                     !           calculated using the linear in tau formulation at values of
            1305                     !           tau above 0.01.  tf is approximated as tau/6 for tau < 0.01.
            1306                     !           all tables are computed at intervals of 0.001.  the inverse
            1307                     !           of the constant used in the pade approximation to the tau
            1308                     !           transition function is set to b.
            1309                     
            1310                           tau_tbl(0) = f_zero
            1311                           exp_tbl(0) = f_one
            1312                           tfn_tbl(0) = f_zero
            1313                     
            1314                           tau_tbl(ntbl) = 1.e10
            1315                           exp_tbl(ntbl) = expeps
            1316                           tfn_tbl(ntbl) = f_one
            1317                     
            1318                           explimit = aint( -log(tiny(exp_tbl(0))) )
            1319                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 39
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.45, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      exp_tbl, tau_tbl, tfn_tbl
                                   <<< Loop-information  End >>>
            1320     1  pp    v            do i = 1, ntbl-1
            1321     1               !org    tfn = float(i) / float(ntbl)
            1322     1               !org    tau_tbl(i) = bpade * tfn / (f_one - tfn)
            1323     1   p    v              tfn = real(i, kind_phys) / real(ntbl-i, kind_phys)
            1324     1   p    v              tau_tbl(i) = bpade * tfn
            1325     2   p    v              if (tau_tbl(i) >= explimit) then
            1326     2   p    v                exp_tbl(i) = expeps
            1327     2   p    v              else
            1328     2   p    v                exp_tbl(i) = exp( -tau_tbl(i) )
            1329     2   p    v              endif
            1330     1               
            1331     2   p    v              if (tau_tbl(i) < 0.06) then
            1332     2   p    v                tfn_tbl(i) = tau_tbl(i) / 6.0
            1333     2   p    v              else
            1334     2   p    v                tfn_tbl(i) = f_one - 2.0*( (f_one / tau_tbl(i))               &
            1335     2                    &               - ( exp_tbl(i) / (f_one - exp_tbl(i)) ) )
            1336     2   p    v              endif
            1337     1   p    v            enddo
            1338                     
            1339                     !...................................
            1340                           end subroutine rlwinit
            1341                     !-----------------------------------
            1342                     
            1343                     
            1344                     ! ----------------------------
            1345                           subroutine cldprop                                                &
            1346                     ! ............................
            1347                     !  ---  inputs:
            1348                          &     ( cfrac,cliqp,reliq,cicep,reice,cdat1,cdat2,cdat3,cdat4,     &
            1349                          &       nlay, nlp1, ipseed,                                        &
            1350                     !  ---  outputs:
            1351                          &       cldfmc, taucld                                             &
            1352                          &     )
            1353                     
            1354                     !  ===================  program usage description  ===================  !
            1355                     !                                                                       !
            1356                     ! purpose:  compute the cloud optical depth(s) for each cloudy layer    !
            1357                     ! and g-point interval.                                                 !
            1358                     !                                                                       !
            1359                     ! subprograms called:  none                                             !
            1360                     !                                                                       !
            1361                     !  ====================  defination of variables  ====================  !
            1362                     !                                                                       !
            1363                     !  inputs:                                                       -size- !
            1364                     !    cfrac - real, layer cloud fraction                          0:nlp1 !
            1365                     !        .....  for ilwcliq > 0  (prognostic cloud sckeme)  - - -       !
            1366                     !    cliqp - real, layer in-cloud liq water path (g/m**2)          nlay !
            1367                     !    reliq - real, mean eff radius for liq cloud (micron)          nlay !
            1368                     !    cicep - real, layer in-cloud ice water path (g/m**2)          nlay !
            1369                     !    reice - real, mean eff radius for ice cloud (micron)          nlay !
            1370                     !    cdat1 - real, layer rain drop water path  (g/m**2)            nlay !
            1371                     !    cdat2 - real, effective radius for rain drop (microm)         nlay !
            1372                     !    cdat3 - real, layer snow flake water path (g/m**2)            nlay !
            1373                     !    cdat4 - real, effective radius for snow flakes (micron)       nlay !
            1374                     !        .....  for ilwcliq = 0  (diagnostic cloud sckeme)  - - -       !
            1375                     !    cdat1 - real, input cloud optical depth                       nlay !
            1376                     !    cdat2 - real, layer cloud single scattering albedo            nlay !
            1377                     !    cdat3 - real, layer cloud asymmetry factor                    nlay !
            1378                     !    cdat4 - real, optional use                                    nlay !
            1379                     !    cliqp - not used                                              nlay !
            1380                     !    reliq - not used                                              nlay !
            1381                     !    cicep - not used                                              nlay !
            1382                     !    reice - not used                                              nlay !
            1383                     !                                                                       !
            1384                     !    nlay  - integer, number of vertical layers                      1  !
            1385                     !    nlp1  - integer, number of vertical levels                      1  !
            1386                     !    ipseed- permutation seed for generating random numbers (isubclw>0) !
            1387                     !                                                                       !
            1388                     !  outputs:                                                             !
            1389                     !    cldfmc - real, cloud fraction for each sub-column       ngptlw*nlay!
            1390                     !    taucld - real, cld opt depth for bands (non-mcica)      nbands*nlay!
            1391                     !                                                                       !
            1392                     !  explanation of the method for each value of ilwcliq, and ilwcice.    !
            1393                     !    set up in module "module_radlw_cntr_para"                          !
            1394                     !                                                                       !
            1395                     !     ilwcliq=0  : input cloud optical property (tau, ssa, asy).        !
            1396                     !                  (used for diagnostic cloud method)                   !
            1397                     !     ilwcliq>0  : input cloud liq/ice path and effective radius, also  !
            1398                     !                  require the user of 'ilwcice' to specify the method  !
            1399                     !                  used to compute aborption due to water/ice parts.    !
            1400                     !  ...................................................................  !
            1401                     !                                                                       !
            1402                     !     ilwcliq=1:   the water droplet effective radius (microns) is input!
            1403                     !                  and the opt depths due to water clouds are computed  !
            1404                     !                  as in hu and stamnes, j., clim., 6, 728-742, (1993). !
            1405                     !                  the values for absorption coefficients appropriate for
            1406                     !                  the spectral bands in rrtm have been obtained for a  !
            1407                     !                  range of effective radii by an averaging procedure   !
            1408                     !                  based on the work of j. pinto (private communication).
            1409                     !                  linear interpolation is used to get the absorption   !
            1410                     !                  coefficients for the input effective radius.         !
            1411                     !                                                                       !
            1412                     !     ilwcice=1:   the cloud ice path (g/m2) and ice effective radius   !
            1413                     !                  (microns) are input and the optical depths due to ice!
            1414                     !                  clouds are computed as in ebert and curry, jgr, 97,  !
            1415                     !                  3831-3836 (1992).  the spectral regions in this work !
            1416                     !                  have been matched with the spectral bands in rrtm to !
            1417                     !                  as great an extent as possible:                      !
            1418                     !                     e&c 1      ib = 5      rrtm bands 9-16            !
            1419                     !                     e&c 2      ib = 4      rrtm bands 6-8             !
            1420                     !                     e&c 3      ib = 3      rrtm bands 3-5             !
            1421                     !                     e&c 4      ib = 2      rrtm band 2                !
            1422                     !                     e&c 5      ib = 1      rrtm band 1                !
            1423                     !     ilwcice=2:   the cloud ice path (g/m2) and ice effective radius   !
            1424                     !                  (microns) are input and the optical depths due to ice!
            1425                     !                  clouds are computed as in rt code, streamer v3.0     !
            1426                     !                  (ref: key j., streamer user's guide, cooperative     !
            1427                     !                  institute for meteorological satellite studies, 2001,!
            1428                     !                  96 pp.) valid range of values for re are between 5.0 !
            1429                     !                  and 131.0 micron.                                    !
            1430                     !     ilwcice=3:   the ice generalized effective size (dge) is input and!
            1431                     !                  the optical properties, are calculated as in q. fu,  !
            1432                     !                  j. climate, (1998). q. fu provided high resolution   !
            1433                     !                  tales which were appropriately averaged for the bands!
            1434                     !                  in rrtm_lw. linear interpolation is used to get the  !
            1435                     !                  coeff from the stored tables. valid range of values  !
            1436                     !                  for deg are between 5.0 and 140.0 micron.            !
            1437                     !                                                                       !
            1438                     !  other cloud control module variables:                                !
            1439                     !     isubclw =0: standard cloud scheme, no sub-col cloud approximation !
            1440                     !             >0: mcica sub-col cloud scheme using ipseed as permutation!
            1441                     !                 seed for generating rundom numbers                    !
            1442                     !                                                                       !
            1443                     !  ======================  end of description block  =================  !
            1444                     !
            1445                           use module_radlw_cldprlw
            1446                     
            1447                     !  ---  inputs:
            1448                           integer, intent(in) :: nlay, nlp1, ipseed
            1449                     
            1450                           real (kind=kind_phys), dimension(0:nlp1), intent(in) :: cfrac
            1451                           real (kind=kind_phys), dimension(nlay),   intent(in) :: cliqp,    &
            1452                          &       reliq, cicep, reice, cdat1, cdat2, cdat3, cdat4
            1453                     
            1454                     !  ---  outputs:
            1455                           real (kind=kind_phys), dimension(ngptlw,nlay),intent(out):: cldfmc
            1456                           real (kind=kind_phys), dimension(nbands,nlay),intent(out):: taucld
            1457                     
            1458                     !  ---  locals:
            1459                           real (kind=kind_phys), dimension(nbands) :: tauliq, tauice
            1460                           real (kind=kind_phys), dimension(nlay)   :: cldf
            1461                     
            1462                           real (kind=kind_phys) :: dgeice, factor, fint, tauran, tausnw,    &
            1463                          &       cldliq, refliq, cldice, refice
            1464                     
            1465                           logical :: lcloudy(ngptlw,nlay)
            1466                           integer :: ia, ib, ig, k, index
            1467                     
            1468                     !
            1469                     !===> ...  begin here
            1470                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1471,1477)
                                   <<< Loop-information  End >>>
            1471     1  pp                 do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1472     2   p   fv              do ib = 1, nbands
            1473     2   p   fv                taucld(ib,k) = f_zero
            1474     2   p   fv              enddo
            1475     1   p                 enddo
            1476                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1477     1                     do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfmc
                                   <<< Loop-information  End >>>
            1478     2   p   4v              do ig = 1, ngptlw
            1479     2   p   4v                cldfmc(ig,k) = f_zero
            1480     2   p   4v              enddo
            1481     1                     enddo
            1482                     
            1483                     !  --- ...  compute cloud radiative properties for a cloudy column
            1484                     
            1485     1                     lab_if_ilwcliq : if (ilwcliq > 0) then
            1486     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac
                                   <<< Loop-information  End >>>
            1487     2                       lab_do_k : do k = 1, nlay
            1488     3                         lab_if_cld : if (cfrac(k) > cldmin) then
            1489     3               
            1490     3                           tauran = absrain * cdat1(k)                      ! ncar formula
            1491     3               !!          tausnw = abssnow1 * cdat3(k)                     ! ncar formula
            1492     3               !  ---  if use fu's formula it needs to be normalized by snow density
            1493     3               !       !not use snow density = 0.1 g/cm**3 = 0.1 g/(mu * m**2)
            1494     3               !       use ice density = 0.9167 g/cm**3 = 0.9167 g/(mu * m**2)
            1495     3               !       factor 1.5396=8/(3*sqrt(3)) converts reff to generalized ice particle size
            1496     3               !       use newer factor value 1.0315
            1497     3               !       1/(0.9167*1.0315) = 1.05756
            1498     4                           if (cdat3(k)>f_zero .and. cdat4(k)>10.0_kind_phys) then
            1499     4                             tausnw = abssnow0*1.05756*cdat3(k)/cdat4(k)      ! fu's formula
            1500     4                           else
            1501     4                             tausnw = f_zero
            1502     4                           endif
            1503     3               
            1504     3                           cldliq = cliqp(k)
            1505     3                           cldice = cicep(k)
            1506     3               !           refliq = max(2.5e0, min(60.0e0, reliq(k) ))
            1507     3               !           refice = max(5.0e0, reice(k) )
            1508     3                           refliq = reliq(k)
            1509     3                           refice = reice(k)
            1510     3               
            1511     3               !  --- ...  calculation of absorption coefficients due to water clouds.
            1512     3               
            1513     4                           if ( cldliq <= f_zero ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1514     5   s   fv                    do ib = 1, nbands
            1515     5   p   fv                      tauliq(ib) = f_zero
            1516     5   p   fv                    enddo
            1517     4                           else
            1518     5                             if ( ilwcliq == 1 ) then
            1519     5               
            1520     5                               factor = refliq - 1.5
            1521     5                               index  = max( 1, min( 57, int( factor ) ))
            1522     5                               fint   = factor - float(index)
            1523     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1524     6   s   fv                      do ib = 1, nbands
            1525     6   p   fv                        tauliq(ib) = max(f_zero, cldliq*(absliq1(index,ib)    &
            1526     6                    &              + fint*(absliq1(index+1,ib)-absliq1(index,ib)) ))
            1527     6   p   fv                      enddo
            1528     5                             endif   ! end if_ilwcliq_block
            1529     4                           endif   ! end if_cldliq_block
            1530     3               
            1531     3               !  --- ...  calculation of absorption coefficients due to ice clouds.
            1532     3               
            1533     4                           if ( cldice <= f_zero ) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1534     5   s   fv                    do ib = 1, nbands
            1535     5   p   fv                      tauice(ib) = f_zero
            1536     5   p   fv                    enddo
            1537     4                           else
            1538     4               
            1539     4               !  --- ...  ebert and curry approach for all particle sizes though somewhat
            1540     4               !           unjustified for large ice particles
            1541     4               
            1542     5                             if ( ilwcice == 1 ) then
            1543     5                               refice = min(130.0, max(13.0, real(refice) ))
            1544     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 500
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1545     6   s   fv                      do ib = 1, nbands
            1546     6   p   fv                        ia = ipat(ib)             ! eb_&_c band index for ice cloud coeff
            1547     6   p   fv                        tauice(ib) = max(f_zero, cldice*(absice1(1,ia)        &
            1548     6                    &                         + absice1(2,ia)/refice) )
            1549     6   p   fv                      enddo
            1550     5               
            1551     5               !  --- ...  streamer approach for ice effective radius between 5.0 and 131.0 microns
            1552     5               !           and ebert and curry approach for ice eff radius greater than 131.0 microns.
            1553     5               !           no smoothing between the transition of the two methods.
            1554     5               
            1555     5                             elseif ( ilwcice == 2 ) then
            1556     5               
            1557     5                               factor = (refice - 2.0) / 3.0
            1558     5                               index  = max( 1, min( 42, int( factor ) ))
            1559     5                               fint   = factor - float(index)
            1560     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1561     6   s   fv                      do ib = 1, nbands
            1562     6   p   fv                        tauice(ib) = max(f_zero, cldice*(absice2(index,ib)    &
            1563     6                    &              + fint*(absice2(index+1,ib) - absice2(index,ib)) ))
            1564     6   p   fv                      enddo
            1565     5               
            1566     5               !  --- ...  fu's approach for ice effective radius between 4.8 and 135 microns
            1567     5               !           (generalized effective size from 5 to 140 microns)
            1568     5               
            1569     5                             elseif ( ilwcice == 3 ) then
            1570     5               
            1571     5               !               dgeice = max(5.0, 1.5396*refice)              ! v4.4 value
            1572     5                               dgeice = max(5.0, 1.0315*refice)              ! v4.71 value
            1573     5                               factor = (dgeice - 2.0) / 3.0
            1574     5                               index  = max( 1, min( 45, int( factor ) ))
            1575     5                               fint   = factor - float(index)
            1576     5               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1577     6   s   fv                      do ib = 1, nbands
            1578     6   p   fv                        tauice(ib) = max(f_zero, cldice*(absice3(index,ib)    &
            1579     6                    &              + fint*(absice3(index+1,ib) - absice3(index,ib)) ))
            1580     6   p   fv                      enddo
            1581     5               
            1582     5                             endif   ! end if_ilwcice_block
            1583     4                           endif   ! end if_cldice_block
            1584     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1585     4   s   fv                  do ib = 1, nbands
            1586     4   p   fv                    taucld(ib,k) = tauice(ib) + tauliq(ib) + tauran + tausnw
            1587     4   p   fv                  enddo
            1588     3               
            1589     3                         endif  lab_if_cld
            1590     2                       enddo  lab_do_k
            1591     1               
            1592     1                     else  lab_if_ilwcliq
            1593     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 54
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac
                                   <<< Loop-information  End >>>
            1594     2  pp                   do k = 1, nlay
            1595     3   p                     if (cfrac(k) > cldmin) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1596     4   p   fv                  do ib = 1, nbands
            1597     4   p   fv                    taucld(ib,k) = cdat1(k)
            1598     4   p   fv                  enddo
            1599     3   p                     endif
            1600     2   p                   enddo
            1601     1               
            1602     1                     endif  lab_if_ilwcliq
            1603                     
            1604                     !  ---  distribute cloud properties to each g-point
            1605                     
            1606     1                     if ( isubclw > 0 ) then      ! mcica sub-col clouds approx
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cfrac, cldf
                                   <<< Loop-information  End >>>
            1607     2  pp   2v              do k = 1, nlay
            1608     3   p   2v                if ( cfrac(k) < cldmin ) then
            1609     3   p   2v                  cldf(k) = f_zero
            1610     3   p   2v                else
            1611     3   p   2v                  cldf(k) = cfrac(k)
            1612     3   p   2v                endif
            1613     2   p   2v              enddo
            1614     1               
            1615     1               !  --- ...  call sub-column cloud generator
            1616     1               
            1617     1                       call mcica_subcol                                               &
            1618     1               !  ---  inputs:
            1619     1                    &     ( cldf, nlay, ipseed,                                        &
            1620     1               !  ---  output:
            1621     1                    &       lcloudy                                                    &
            1622     1                    &     )
            1623     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfmc, lcloudy
                                   <<< Loop-information  End >>>
            1624     2  pp   2v              do k = 1, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            1625     3   p   2                 do ig = 1, ngptlw
            1626     4   p   2v                  if ( lcloudy(ig,k) ) then
            1627     4   p   2v                    cldfmc(ig,k) = f_one
            1628     4   p   2v                  else
            1629     4   p   2v                    cldfmc(ig,k) = f_zero
            1630     4   p   2v                  endif
            1631     3   p   2v                enddo
            1632     2   p                   enddo
            1633     1               
            1634     1                     endif   ! end if_isubclw_block
            1635                     
            1636                           return
            1637                     ! ..................................
            1638                           end subroutine cldprop
            1639                     ! ----------------------------------
            1640                     
            1641                     
            1642                     ! ----------------------------------
            1643                           subroutine mcica_subcol                                           &
            1644                     ! ..................................
            1645                     !  ---  inputs:
            1646                          &    ( cldf, nlay, ipseed,                                         &
            1647                     !  ---  outputs:
            1648                          &      lcloudy                                                     &
            1649                          &    )
            1650                     
            1651                     !  ====================  defination of variables  ====================  !
            1652                     !                                                                       !
            1653                     !  input variables:                                                size !
            1654                     !   cldf    - real, layer cloud fraction                           nlay !
            1655                     !   nlay    - integer, number of model vertical layers               1  !
            1656                     !   ipseed  - integer, permute seed for random num generator         1  !
            1657                     !    ** note : if the cloud generator is called multiple times, need    !
            1658                     !              to permute the seed between each call; if between calls  !
            1659                     !              for lw and sw, use values differ by the number of g-pts. !
            1660                     !                                                                       !
            1661                     !  output variables:                                                    !
            1662                     !   lcloudy - logical, sub-colum cloud profile flag array    ngptlw*nlay!
            1663                     !                                                                       !
            1664                     !  other control flags from module variables:                           !
            1665                     !     iovrlw    : control flag for cloud overlapping method             !
            1666                     !                 =0:random; =1:maximum/random: =2:maximum              !
            1667                     !                                                                       !
            1668                     !  =====================    end of definitions    ====================  !
            1669                     
            1670                           implicit none
            1671                     
            1672                     !  ---  inputs:
            1673                           integer, intent(in) :: nlay, ipseed
            1674                     
            1675                           real (kind=kind_phys), dimension(nlay), intent(in) :: cldf
            1676                     
            1677                     !  ---  outputs:
            1678                           logical, dimension(ngptlw,nlay), intent(out) :: lcloudy
            1679                     
            1680                     !  ---  locals:
            1681                           real (kind=kind_phys) :: cdfunc(ngptlw,nlay), rand1d(ngptlw),     &
            1682                          &       rand2d(nlay*ngptlw), tem1
            1683                     
            1684                           type (random_stat) :: stat          ! for thread safe random generator
            1685                     
            1686                           integer :: k, n, k1
            1687                     !
            1688                     !===> ...  begin here
            1689                     !
            1690                     !  --- ...  advance randum number generator by ipseed values
            1691                     
            1692                           call random_setseed                                               &
            1693                     !  ---  inputs:
            1694                          &    ( ipseed,                                                     &
            1695                     !  ---  outputs:
            1696                          &      stat                                                        &
            1697                          &    )
            1698                     
            1699                     !  --- ...  sub-column set up according to overlapping assumption
            1700                     
            1701     1                     select case ( iovrlw )
            1702     1               
            1703     1                       case( 0 )        ! random overlap, pick a random value at every level
            1704     1               
            1705     1                         call random_number                                            &
            1706     1               !  ---  inputs: ( none )
            1707     1               !  ---  outputs:
            1708     1                    &     ( rand2d, stat )
            1709     1               
            1710     1                         k1 = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d
                                   <<< Loop-information  End >>>
            1711     2   s                     do n = 1, ngptlw
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d
                                   <<< Loop-information  End >>>
            1712     3  pp   4v                  do k = 1, nlay
            1713     3   p   4v                    k1 = k1 + 1
            1714     3   p   4v                    cdfunc(n,k) = rand2d(k1)
            1715     3   p   4v                  enddo
            1716     2   p                     enddo
            1717     1               
            1718     1                       case( 1 )        ! max-ran overlap
            1719     1               
            1720     1                         call random_number                                            &
            1721     1               !  ---  inputs: ( none )
            1722     1               !  ---  outputs:
            1723     1                    &     ( rand2d, stat )
            1724     1               
            1725     1                         k1 = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d
                                   <<< Loop-information  End >>>
            1726     2   s                     do n = 1, ngptlw
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rand2d
                                   <<< Loop-information  End >>>
            1727     3  pp   4v                  do k = 1, nlay
            1728     3   p   4v                    k1 = k1 + 1
            1729     3   p   4v                    cdfunc(n,k) = rand2d(k1)
            1730     3   p   4v                  enddo
            1731     2   p                     enddo
            1732     1               
            1733     1               !  ---  first pick a random number for bottom (or top) layer.
            1734     1               !       then walk up the column: (aer's code)
            1735     1               !       if layer below is cloudy, use the same rand num in the layer below
            1736     1               !       if layer below is clear,  use a new random number
            1737     1               
            1738     1               !  ---  from bottom up
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cdfunc
                                   <<< Loop-information  End >>>
            1739     2                         do k = 2, nlay
            1740     2                           k1 = k - 1
            1741     2                           tem1 = f_one - cldf(k1)
            1742     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.46, ITR: 96, MVE: 3, POL: S)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1743     3   s   2v                  do n = 1, ngptlw
            1744     4   p   2v                    if ( cdfunc(n,k1) > tem1 ) then
            1745     4   p   2v                      cdfunc(n,k) = cdfunc(n,k1)
            1746     4   p   2v                    else
            1747     4   p   2v                      cdfunc(n,k) = cdfunc(n,k) * tem1
            1748     4   p   2v                    endif
            1749     3   p   2v                  enddo
            1750     2                         enddo
            1751     1               
            1752     1               !  ---  or walk down the column: (if use original author's method)
            1753     1               !       if layer above is cloudy, use the same rand num in the layer above
            1754     1               !       if layer above is clear,  use a new random number
            1755     1               
            1756     1               !  ---  from top down
            1757     1               !         do k = nlay-1, 1, -1
            1758     1               !           k1 = k + 1
            1759     1               !           tem1 = f_one - cldf(k1)
            1760     1               
            1761     1               !           do n = 1, ngptlw
            1762     1               !             if ( cdfunc(n,k1) > tem1 ) then
            1763     1               !               cdfunc(n,k) = cdfunc(n,k1)
            1764     1               !             else
            1765     1               !               cdfunc(n,k) = cdfunc(n,k) * tem1
            1766     1               !             endif
            1767     1               !           enddo
            1768     1               !         enddo
            1769     1               
            1770     1                       case( 2 )        ! maximum overlap, pick same random numebr at every level
            1771     1               
            1772     1                         call random_number                                            &
            1773     1               !  ---  inputs: ( none )
            1774     1               !  ---  outputs:
            1775     1                    &     ( rand1d, stat )
            1776     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 112, MVE: 5, POL: S)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1777     2   p   2v                do n = 1, ngptlw
            1778     2   p   2v                  tem1 = rand1d(n)
            1779     2               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cdfunc, (unknown)
                                   <<< Loop-information  End >>>
            1780     3  pp   2                   do k = 1, nlay
            1781     3   p   2v                    cdfunc(n,k) = tem1
            1782     3   p   2                   enddo
            1783     2   p   2v                enddo
            1784     1               
            1785     1                     end select
            1786                     
            1787                     !  --- ...  generate subcolumns for homogeneous clouds
            1788                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cdfunc, lcloudy
                                   <<< Loop-information  End >>>
            1789     1  pp                 do k = 1, nlay
            1790     1   p                   tem1 = f_one - cldf(k)
            1791     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cdfunc, lcloudy
                                   <<< Loop-information  End >>>
            1792     2   p   2v              do n = 1, ngptlw
            1793     2   p   2v                lcloudy(n,k) = cdfunc(n,k) >= tem1
            1794     2   p   2v              enddo
            1795     1   p                 enddo
            1796                     
            1797                           return
            1798                     ! ..................................
            1799                           end subroutine mcica_subcol
            1800                     ! ----------------------------------
            1801                     
            1802                     
            1803                     ! ----------------------------------
            1804                           subroutine setcoef                                                &
            1805                     ! ..................................
            1806                     !  ---  inputs:
            1807                          &     ( pavel,tavel,tz,stemp,h2ovmr,colamt,coldry,colbrd,          &
            1808                          &       nlay, nlp1,                                                &
            1809                     !  ---  outputs:
            1810                          &       laytrop,pklay,pklev,jp,jt,jt1,                             &
            1811                          &       rfrate,fac00,fac01,fac10,fac11,                            &
            1812                          &       selffac,selffrac,indself,forfac,forfrac,indfor,            &
            1813                          &       minorfrac,scaleminor,scaleminorn2,indminor                 &
            1814                          &     )
            1815                     
            1816                     !  ===================  program usage description  ===================  !
            1817                     !                                                                       !
            1818                     ! purpose:  compute various coefficients needed in radiative transfer   !
            1819                     !    calculations.                                                      !
            1820                     !                                                                       !
            1821                     ! subprograms called:  none                                             !
            1822                     !                                                                       !
            1823                     !  ====================  defination of variables  ====================  !
            1824                     !                                                                       !
            1825                     !  inputs:                                                       -size- !
            1826                     !   pavel     - real, layer pressures (mb)                         nlay !
            1827                     !   tavel     - real, layer temperatures (k)                       nlay !
            1828                     !   tz        - real, level (interface) temperatures (k)         0:nlay !
            1829                     !   stemp     - real, surface ground temperature (k)                1   !
            1830                     !   h2ovmr    - real, layer w.v. volum mixing ratio (kg/kg)        nlay !
            1831                     !   colamt    - real, column amounts of absorbing gases      nlay*maxgas!
            1832                     !                 2nd indices range: 1-maxgas, for watervapor,          !
            1833                     !                 carbon dioxide, ozone, nitrous oxide, methane,        !
            1834                     !                 oxigen, carbon monoxide,etc. (molecules/cm**2)        !
            1835                     !   coldry    - real, dry air column amount                        nlay !
            1836                     !   colbrd    - real, column amount of broadening gases            nlay !
            1837                     !   nlay/nlp1 - integer, total number of vertical layers, levels    1   !
            1838                     !                                                                       !
            1839                     !  outputs:                                                             !
            1840                     !   laytrop   - integer, tropopause layer index (unitless)          1   !
            1841                     !   pklay     - real, integrated planck func at lay temp   nbands*0:nlay!
            1842                     !   pklev     - real, integrated planck func at lev temp   nbands*0:nlay!
            1843                     !   jp        - real, indices of lower reference pressure          nlay !
            1844                     !   jt, jt1   - real, indices of lower reference temperatures      nlay !
            1845                     !   rfrate    - real, ref ratios of binary species param   nlay*nrates*2!
            1846                     !     (:,m,:)m=1-h2o/co2,2-h2o/o3,3-h2o/n2o,4-h2o/ch4,5-n2o/co2,6-o3/co2!
            1847                     !     (:,:,n)n=1,2: the rates of ref press at the 2 sides of the layer  !
            1848                     !   facij     - real, factors multiply the reference ks,           nlay !
            1849                     !                 i,j=0/1 for lower/higher of the 2 appropriate         !
            1850                     !                 temperatures and altitudes.                           !
            1851                     !   selffac   - real, scale factor for w. v. self-continuum        nlay !
            1852                     !                 equals (w. v. density)/(atmospheric density           !
            1853                     !                 at 296k and 1013 mb)                                  !
            1854                     !   selffrac  - real, factor for temperature interpolation of      nlay !
            1855                     !                 reference w. v. self-continuum data                   !
            1856                     !   indself   - integer, index of lower ref temp for selffac       nlay !
            1857                     !   forfac    - real, scale factor for w. v. foreign-continuum     nlay !
            1858                     !   forfrac   - real, factor for temperature interpolation of      nlay !
            1859                     !                 reference w.v. foreign-continuum data                 !
            1860                     !   indfor    - integer, index of lower ref temp for forfac        nlay !
            1861                     !   minorfrac - real, factor for minor gases                       nlay !
            1862                     !   scaleminor,scaleminorn2                                             !
            1863                     !             - real, scale factors for minor gases                nlay !
            1864                     !   indminor  - integer, index of lower ref temp for minor gases   nlay !
            1865                     !                                                                       !
            1866                     !  ======================    end of definitions    ===================  !
            1867                     
            1868                     !  ---  inputs:
            1869                           integer, intent(in) :: nlay, nlp1
            1870                     
            1871                           real (kind=kind_phys), dimension(nlay,maxgas),intent(in):: colamt
            1872                           real (kind=kind_phys), dimension(0:nlay),     intent(in):: tz
            1873                     
            1874                           real (kind=kind_phys), dimension(nlay), intent(in) :: pavel,      &
            1875                          &       tavel, h2ovmr, coldry, colbrd
            1876                     
            1877                           real (kind=kind_phys), intent(in) :: stemp
            1878                     
            1879                     !  ---  outputs:
            1880                           integer, dimension(nlay), intent(out) :: jp, jt, jt1, indself,    &
            1881                          &       indfor, indminor
            1882                     
            1883                           integer, intent(out) :: laytrop
            1884                     
            1885                           real (kind=kind_phys), dimension(nlay,nrates,2), intent(out) ::   &
            1886                          &       rfrate
            1887                           real (kind=kind_phys), dimension(nbands,0:nlay), intent(out) ::   &
            1888                          &       pklev, pklay
            1889                     
            1890                           real (kind=kind_phys), dimension(nlay),          intent(out) ::   &
            1891                          &       fac00, fac01, fac10, fac11, selffac, selffrac, forfac,     &
            1892                          &       forfrac, minorfrac, scaleminor, scaleminorn2
            1893                     
            1894                     !  ---  locals:
            1895                           real (kind=kind_phys) :: tlvlfr, tlyrfr, plog, fp, ft, ft1,       &
            1896                          &       tem1, tem2
            1897                     
            1898                           integer :: i, k, jp1, indlev, indlay
            1899                     !
            1900                     !===> ... begin here
            1901                     !
            1902                     !  --- ...  calculate information needed by the radiative transfer routine
            1903                     !           that is specific to this atmosphere, especially some of the
            1904                     !           coefficients and indices needed to compute the optical depths
            1905                     !           by interpolating data from stored reference atmospheres.
            1906                     
            1907                           indlay = min(180, max(1, int(stemp-159.0) ))
            1908                           indlev = min(180, max(1, int(tz(0)-159.0) ))
            1909                           tlyrfr = stemp - int(stemp)
            1910                           tlvlfr = tz(0) - int(tz(0))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1911     1   s   fv            do i = 1, nbands
            1912     1   p   fv              tem1 = totplnk(indlay+1,i) - totplnk(indlay,i)
            1913     1   p   fv              tem2 = totplnk(indlev+1,i) - totplnk(indlev,i)
            1914     1   p   fv              pklay(i,0) = delwave(i) * (totplnk(indlay,i) + tlyrfr*tem1)
            1915     1   p   fv              pklev(i,0) = delwave(i) * (totplnk(indlev,i) + tlvlfr*tem2)
            1916     1   p   fv            enddo
            1917                     
            1918                     !  --- ...  begin layer loop
            1919                     !           calculate the integrated planck functions for each band at the
            1920                     !           surface, level, and layer temperatures.
            1921                     
            1922                           laytrop = 0
            1923                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tavel, tz, pklev, pklay, jp, jt, jt1
                                   <<<      fac10, fac00, fac11, pavel, fac01
                                   <<<      h2ovmr, scaleminor, colamt, coldry
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      colbrd: 2, scaleminorn2: 2, indminor: 2
                                   <<<      minorfrac: 2, selffac: 2, forfac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 30
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1924     1                     do k = 1, nlay
            1925     1               
            1926     1                       indlay = min(180, max(1, int(tavel(k)-159.0) ))
            1927     1                       tlyrfr = tavel(k) - int(tavel(k))
            1928     1               
            1929     1                       indlev = min(180, max(1, int(tz(k)-159.0) ))
            1930     1                       tlvlfr = tz(k) - int(tz(k))
            1931     1               
            1932     1               !  --- ...  begin spectral band loop
            1933     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 422
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            1934     2   s   fv              do i = 1, nbands
            1935     2   p   fv                pklay(i,k) = delwave(i) * (totplnk(indlay,i) + tlyrfr         &
            1936     2                    &               * (totplnk(indlay+1,i) - totplnk(indlay,i)) )
            1937     2   p   fv                pklev(i,k) = delwave(i) * (totplnk(indlev,i) + tlvlfr         &
            1938     2                    &               * (totplnk(indlev+1,i) - totplnk(indlev,i)) )
            1939     2   p   fv              enddo
            1940     1               
            1941     1               !  --- ...  find the two reference pressures on either side of the
            1942     1               !           layer pressure. store them in jp and jp1. store in fp the
            1943     1               !           fraction of the difference (in ln(pressure)) between these
            1944     1               !           two values that the layer pressure lies.
            1945     1               
            1946     1                       plog = log(pavel(k))
            1947     1                       jp(k)= max(1, min(58, int(36.0 - 5.0*(plog+0.04)) ))
            1948     1                       jp1  = jp(k) + 1
            1949     1               !  --- ...  limit pressure extrapolation at the top
            1950     1                       fp   = max(f_zero, min(f_one, 5.0*(preflog(jp(k))-plog) ))
            1951     1               !org    fp   = 5.0 * (preflog(jp(k)) - plog)
            1952     1               
            1953     1               !  --- ...  determine, for each reference pressure (jp and jp1), which
            1954     1               !           reference temperature (these are different for each
            1955     1               !           reference pressure) is nearest the layer temperature but does
            1956     1               !           not exceed it. store these indices in jt and jt1, resp.
            1957     1               !           store in ft (resp. ft1) the fraction of the way between jt
            1958     1               !           (jt1) and the next highest reference temperature that the
            1959     1               !           layer temperature falls.
            1960     1               
            1961     1                       tem1 = (tavel(k)-tref(jp(k))) / 15.0
            1962     1                       tem2 = (tavel(k)-tref(jp1  )) / 15.0
            1963     1                       jt (k) = max(1, min(4, int(3.0 + tem1) ))
            1964     1                       jt1(k) = max(1, min(4, int(3.0 + tem2) ))
            1965     1               !  --- ...  restrict extrapolation ranges by limiting abs(det t) < 37.5 deg
            1966     1                       ft  = max(-0.5, min(1.5, tem1 - float(jt (k) - 3) ))
            1967     1                       ft1 = max(-0.5, min(1.5, tem2 - float(jt1(k) - 3) ))
            1968     1               !org    ft  = tem1 - float(jt (k) - 3)
            1969     1               !org    ft1 = tem2 - float(jt1(k) - 3)
            1970     1               
            1971     1               !  --- ...  we have now isolated the layer ln pressure and temperature,
            1972     1               !           between two reference pressures and two reference temperatures
            1973     1               !           (for each reference pressure).  we multiply the pressure
            1974     1               !           fraction fp with the appropriate temperature fractions to get
            1975     1               !           the factors that will be needed for the interpolation that yields
            1976     1               !           the optical depths (performed in routines taugbn for band n)
            1977     1               
            1978     1                       tem1 = f_one - fp
            1979     1                       fac10(k) = tem1 * ft
            1980     1                       fac00(k) = tem1 * (f_one - ft)
            1981     1                       fac11(k) = fp * ft1
            1982     1                       fac01(k) = fp * (f_one - ft1)
            1983     1               
            1984     1                       forfac(k) = pavel(k)*stpfac / (tavel(k)*(1.0 + h2ovmr(k)))
            1985     1                       selffac(k) = h2ovmr(k) * forfac(k)
            1986     1               
            1987     1               !  --- ...  set up factors needed to separately include the minor gases
            1988     1               !           in the calculation of absorption coefficient
            1989     1               
            1990     1                       scaleminor(k) = pavel(k) / tavel(k)
            1991     1                       scaleminorn2(k) = (pavel(k) / tavel(k))                         &
            1992     1                    &                  * (colbrd(k)/(coldry(k) + colamt(k,1)))
            1993     1                       tem1 = (tavel(k) - 180.8) / 7.2
            1994     1                       indminor(k) = min(18, max(1, int(tem1)))
            1995     1                       minorfrac(k) = tem1 - float(indminor(k))
            1996     1               
            1997     1               !  --- ...  if the pressure is less than ~100mb, perform a different
            1998     1               !           set of species interpolations.
            1999     1               
            2000     2                       if (plog > 4.56) then
            2001     2               
            2002     2                         laytrop =  laytrop + 1
            2003     2               
            2004     2                         tem1 = (332.0 - tavel(k)) / 36.0
            2005     2                         indfor(k) = min(2, max(1, int(tem1)))
            2006     2                         forfrac(k) = tem1 - float(indfor(k))
            2007     2               
            2008     2               !  --- ...  set up factors needed to separately include the water vapor
            2009     2               !           self-continuum in the calculation of absorption coefficient.
            2010     2               
            2011     2                         tem1 = (tavel(k) - 188.0) / 7.2
            2012     2                         indself(k) = min(9, max(1, int(tem1)-7))
            2013     2                         selffrac(k) = tem1 - float(indself(k) + 7)
            2014     2               
            2015     2               !  --- ...  setup reference ratio to be used in calculation of binary
            2016     2               !           species parameter in lower atmosphere.
            2017     2               
            2018     2                         rfrate(k,1,1) = chi_mls(1,jp(k)) / chi_mls(2,jp(k))
            2019     2                         rfrate(k,1,2) = chi_mls(1,jp(k)+1) / chi_mls(2,jp(k)+1)
            2020     2               
            2021     2                         rfrate(k,2,1) = chi_mls(1,jp(k)) / chi_mls(3,jp(k))
            2022     2                         rfrate(k,2,2) = chi_mls(1,jp(k)+1) / chi_mls(3,jp(k)+1)
            2023     2               
            2024     2                         rfrate(k,3,1) = chi_mls(1,jp(k)) / chi_mls(4,jp(k))
            2025     2                         rfrate(k,3,2) = chi_mls(1,jp(k)+1) / chi_mls(4,jp(k)+1)
            2026     2               
            2027     2                         rfrate(k,4,1) = chi_mls(1,jp(k)) / chi_mls(6,jp(k))
            2028     2                         rfrate(k,4,2) = chi_mls(1,jp(k)+1) / chi_mls(6,jp(k)+1)
            2029     2               
            2030     2                         rfrate(k,5,1) = chi_mls(4,jp(k)) / chi_mls(2,jp(k))
            2031     2                         rfrate(k,5,2) = chi_mls(4,jp(k)+1) / chi_mls(2,jp(k)+1)
            2032     2               
            2033     2                       else
            2034     2               
            2035     2                         tem1 = (tavel(k) - 188.0) / 36.0
            2036     2                         indfor(k) = 3
            2037     2                         forfrac(k) = tem1 - f_one
            2038     2               
            2039     2                         indself(k) = 0
            2040     2                         selffrac(k) = f_zero
            2041     2               
            2042     2               !  --- ...  setup reference ratio to be used in calculation of binary
            2043     2               !           species parameter in upper atmosphere.
            2044     2               
            2045     2                         rfrate(k,1,1) = chi_mls(1,jp(k)) / chi_mls(2,jp(k))
            2046     2                         rfrate(k,1,2) = chi_mls(1,jp(k)+1) / chi_mls(2,jp(k)+1)
            2047     2               
            2048     2                         rfrate(k,6,1) = chi_mls(3,jp(k)) / chi_mls(2,jp(k))
            2049     2                         rfrate(k,6,2) = chi_mls(3,jp(k)+1) / chi_mls(2,jp(k)+1)
            2050     2               
            2051     2                       endif
            2052     1               
            2053     1               !  --- ...  rescale selffac and forfac for use in taumol
            2054     1               
            2055     1                       selffac(k) = colamt(k,1) * selffac(k)
            2056     1                       forfac(k)  = colamt(k,1) * forfac(k)
            2057     1               
            2058     1                     enddo   ! end do_k layer loop
            2059                     
            2060                           return
            2061                     ! ..................................
            2062                           end subroutine setcoef
            2063                     ! ----------------------------------
            2064                     
            2065                     
            2066                     
            2067                     ! ----------------------------------
            2068                           subroutine rtrn                                                   &
            2069                     ! ..................................
            2070                     !  ---  inputs:
            2071                          &     ( semiss,delp,cldfrc,taucld,tautot,pklay,pklev,              &
            2072                          &       fracs,secdif, nlay,nlp1,                                   &
            2073                     !  ---  outputs:
            2074                          &       totuflux,totdflux,htr, totuclfl,totdclfl,htrcl, htrb       &
            2075                          &     )
            2076                     
            2077                     !  ===================  program usage description  ===================  !
            2078                     !                                                                       !
            2079                     ! purpose:  compute the upward/downward radiative fluxes, and heating   !
            2080                     ! rates for both clear or cloudy atmosphere.  clouds are assumed as     !
            2081                     ! randomly overlaping in a vertical colum.                              !
            2082                     !                                                                       !
            2083                     ! subprograms called:  none                                             !
            2084                     !                                                                       !
            2085                     !  ====================  defination of variables  ====================  !
            2086                     !                                                                       !
            2087                     !  inputs:                                                     -size-   !
            2088                     !   semiss  - real, lw surface emissivity                         nbands!
            2089                     !   delp    - real, layer pressure thickness (mb)                  nlay !
            2090                     !   cldfrc  - real, layer cloud fraction                         0:nlp1 !
            2091                     !   taucld  - real, layer cloud opt depth                    nbands,nlay!
            2092                     !   tautot  - real, total optical depth (gas+aerosols)       ngptlw,nlay!
            2093                     !   pklay   - real, integrated planck func at lay temp     nbands*0:nlay!
            2094                     !   pklev   - real, integrated planck func at lev temp     nbands*0:nlay!
            2095                     !   fracs   - real, planck fractions                         ngptlw,nlay!
            2096                     !   secdif  - real, secant of diffusivity angle                   nbands!
            2097                     !   nlay    - integer, number of vertical layers                    1   !
            2098                     !   nlp1    - integer, number of vertical levels (interfaces)       1   !
            2099                     !                                                                       !
            2100                     !  outputs:                                                             !
            2101                     !   totuflux- real, total sky upward flux (w/m2)                 0:nlay !
            2102                     !   totdflux- real, total sky downward flux (w/m2)               0:nlay !
            2103                     !   htr     - real, total sky heating rate (k/sec or k/day)        nlay !
            2104                     !   totuclfl- real, clear sky upward flux (w/m2)                 0:nlay !
            2105                     !   totdclfl- real, clear sky downward flux (w/m2)               0:nlay !
            2106                     !   htrcl   - real, clear sky heating rate (k/sec or k/day)        nlay !
            2107                     !   htrb    - real, spectral band lw heating rate (k/day)    nlay*nbands!
            2108                     !                                                                       !
            2109                     !  module veriables:                                                    !
            2110                     !   ngb     - integer, band index for each g-value                ngptlw!
            2111                     !   fluxfac - real, conversion factor for fluxes (pi*2.e4)           1  !
            2112                     !   heatfac - real, conversion factor for heating rates (g/cp*1e-2)  1  !
            2113                     !   tblint  - real, conversion factor for look-up tbl (float(ntbl)   1  !
            2114                     !   bpade   - real, pade approx constant (1/0.278)                   1  !
            2115                     !   wtdiff  - real, weight for radiance to flux conversion           1  !
            2116                     !   ntbl    - integer, dimension of look-up tables                   1  !
            2117                     !   tau_tbl - real, clr-sky opt dep lookup table                 0:ntbl !
            2118                     !   exp_tbl - real, transmittance lookup table                   0:ntbl !
            2119                     !   tfn_tbl - real, tau transition function                      0:ntbl !
            2120                     !                                                                       !
            2121                     !  local variables:                                                     !
            2122                     !    itgas  - integer, index for gases contribution look-up table    1  !
            2123                     !    ittot  - integer, index for gases plus clouds  look-up table    1  !
            2124                     !    reflct - real, surface reflectance                              1  !
            2125                     !    atrgas - real, gaseous absorptivity                             1  !
            2126                     !    atrtot - real, gaseous and cloud absorptivity                   1  !
            2127                     !    odcld  - real, cloud optical depth                              1  !
            2128                     !    efclrfr- real, effective clear sky fraction (1-efcldfr)       nlay !
            2129                     !    odepth - real, optical depth of gaseous only                    1  !
            2130                     !    odtot  - real, optical depth of gas and cloud                   1  !
            2131                     !    gasfac - real, gas-only pade factor, used for planck fn         1  !
            2132                     !    totfac - real, gas+cld pade factor, used for planck fn          1  !
            2133                     !    bbdgas - real, gas-only planck function for downward rt         1  !
            2134                     !    bbugas - real, gas-only planck function for upward rt           1  !
            2135                     !    bbdtot - real, gas and cloud planck function for downward rt    1  !
            2136                     !    bbutot - real, gas and cloud planck function for upward rt      1  !
            2137                     !    gassrcu- real, upwd source radiance due to gas only            nlay!
            2138                     !    totsrcu- real, upwd source radiance due to gas+cld             nlay!
            2139                     !    gassrcd- real, dnwd source radiance due to gas only             1  !
            2140                     !    totsrcd- real, dnwd source radiance due to gas+cld              1  !
            2141                     !    radtotu- real, spectrally summed total sky upwd radiance        1  !
            2142                     !    radclru- real, spectrally summed clear sky upwd radiance        1  !
            2143                     !    radtotd- real, spectrally summed total sky dnwd radiance        1  !
            2144                     !    radclrd- real, spectrally summed clear sky dnwd radiance        1  !
            2145                     !    toturad- real, total sky upward radiance by layer     0:nlay*nbands!
            2146                     !    clrurad- real, clear sky upward radiance by layer     0:nlay*nbands!
            2147                     !    totdrad- real, total sky downward radiance by layer   0:nlay*nbands!
            2148                     !    clrdrad- real, clear sky downward radiance by layer   0:nlay*nbands!
            2149                     !    fnet   - real, net longwave flux (w/m2)                     0:nlay !
            2150                     !    fnetc  - real, clear sky net longwave flux (w/m2)           0:nlay !
            2151                     !                                                                       !
            2152                     !                                                                       !
            2153                     !  *******************************************************************  !
            2154                     !  original code description                                            !
            2155                     !                                                                       !
            2156                     !  original version:   e. j. mlawer, et al. rrtm_v3.0                   !
            2157                     !  revision for gcms:  michael j. iacono; october, 2002                 !
            2158                     !  revision for f90:   michael j. iacono; june, 2006                    !
            2159                     !                                                                       !
            2160                     !  this program calculates the upward fluxes, downward fluxes, and      !
            2161                     !  heating rates for an arbitrary clear or cloudy atmosphere. the input !
            2162                     !  to this program is the atmospheric profile, all planck function      !
            2163                     !  information, and the cloud fraction by layer.  a variable diffusivity!
            2164                     !  angle (secdif) is used for the angle integration. bands 2-3 and 5-9  !
            2165                     !  use a value for secdif that varies from 1.50 to 1.80 as a function   !
            2166                     !  of the column water vapor, and other bands use a value of 1.66.  the !
            2167                     !  gaussian weight appropriate to this angle (wtdiff=0.5) is applied    !
            2168                     !  here.  note that use of the emissivity angle for the flux integration!
            2169                     !  can cause errors of 1 to 4 w/m2 within cloudy layers.                !
            2170                     !  clouds are treated with a random cloud overlap method.               !
            2171                     !                                                                       !
            2172                     !  *******************************************************************  !
            2173                     !  ======================  end of description block  =================  !
            2174                     
            2175                     !  ---  inputs:
            2176                           integer, intent(in) :: nlay, nlp1
            2177                     
            2178                           real (kind=kind_phys), dimension(0:nlp1), intent(in) :: cldfrc
            2179                           real (kind=kind_phys), dimension(nbands), intent(in) :: semiss,   &
            2180                          &       secdif
            2181                           real (kind=kind_phys), dimension(nlay),   intent(in) :: delp
            2182                     
            2183                           real (kind=kind_phys), dimension(nbands,nlay),intent(in):: taucld
            2184                           real (kind=kind_phys), dimension(ngptlw,nlay),intent(in):: fracs, &
            2185                          &       tautot
            2186                     
            2187                           real (kind=kind_phys), dimension(nbands,0:nlay), intent(in) ::    &
            2188                          &       pklev, pklay
            2189                     
            2190                     !  ---  outputs:
            2191                           real (kind=kind_phys), dimension(nlay), intent(out) :: htr, htrcl
            2192                     
            2193                           real (kind=kind_phys), dimension(nlay,nbands),intent(out) :: htrb
            2194                     
            2195                           real (kind=kind_phys), dimension(0:nlay), intent(out) ::          &
            2196                          &       totuflux, totdflux, totuclfl, totdclfl
            2197                     
            2198                     !  ---  locals:
            2199                           real (kind=kind_phys), parameter :: rec_6 = 0.166667
            2200                     
            2201                           real (kind=kind_phys), dimension(0:nlay,nbands) :: clrurad,       &
            2202                          &       clrdrad, toturad, totdrad
            2203                     
            2204                           real (kind=kind_phys), dimension(nlay)   :: gassrcu, totsrcu,     &
            2205                          &       trngas, efclrfr, rfdelp
            2206                           real (kind=kind_phys), dimension(0:nlay) :: fnet, fnetc
            2207                     
            2208                           real (kind=kind_phys) :: totsrcd, gassrcd, tblind, odepth, odtot, &
            2209                          &       odcld, atrtot, atrgas, reflct, totfac, gasfac, flxfac,     &
            2210                          &       plfrac, blay, bbdgas, bbdtot, bbugas, bbutot, dplnku,      &
            2211                          &       dplnkd, radtotu, radclru, radtotd, radclrd, rad0,          &
            2212                          &       clfr, trng, gasu
            2213                     
            2214                           integer :: ittot, itgas, ib, ig, k
            2215                     !
            2216                     !===> ...  begin here
            2217                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrdrad, clrurad, totdrad, toturad
                                   <<< Loop-information  End >>>
            2218     1  pp   2v            do ib = 1, nbands
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2219     2   p   2               do k = 0, nlay
            2220     2   p   2v                toturad(k,ib) = f_zero
            2221     2   p   2v                totdrad(k,ib) = f_zero
            2222     2   p   2v                clrurad(k,ib) = f_zero
            2223     2   p   2v                clrdrad(k,ib) = f_zero
            2224     2   p   2v              enddo
            2225     1   p                 enddo
            2226                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      totdclfl, totuclfl, totdflux, totuflux
                                   <<< Loop-information  End >>>
            2227     1  pp   2v            do k = 0, nlay
            2228     1   p   2v              totuflux(k) = f_zero
            2229     1   p   2v              totdflux(k) = f_zero
            2230     1   p   2v              totuclfl(k) = f_zero
            2231     1   p   2v              totdclfl(k) = f_zero
            2232     1   p   2v            enddo
            2233                     
            2234                     !  --- ...  loop over all g-points
            2235                     
            2236     1                     do ig = 1, ngptlw
            2237     1                       ib = ngb(ig)
            2238     1               
            2239     1                       radtotd = f_zero
            2240     1                       radclrd = f_zero
            2241     1               
            2242     1               !  --- ...  downward radiative transfer loop.
            2243     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pklay, pklev, cldfrc, gassrcu, trngas
                                   <<<      clrdrad
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2244     2   s    s              do k = nlay, 1, -1
            2245     2               
            2246     2               !  --- ...  clear sky, gases contribution
            2247     2               
            2248     2   p    v                odepth = max( f_zero, secdif(ib)*tautot(ig,k) )
            2249     3   p    s                if (odepth <= 0.06) then
            2250     3   p    s                  atrgas = odepth - 0.5*odepth*odepth
            2251     3   p    s                  trng   = f_one - atrgas
            2252     3   p    s                  gasfac = rec_6 * odepth
            2253     3   p    s                else
            2254     3   p    s                  tblind = odepth / (bpade + odepth)
            2255     3   p    s                  itgas = tblint*tblind + 0.5
            2256     3   p    s                  trng  = exp_tbl(itgas)
            2257     3   p    s                  atrgas = f_one - trng
            2258     3   p    s                  gasfac = tfn_tbl(itgas)
            2259     3   p    s                  odepth = tau_tbl(itgas)
            2260     3   p    v                endif
            2261     2               
            2262     2   p    v                plfrac = fracs(ig,k)
            2263     2   p    v                blay = pklay(ib,k)
            2264     2               
            2265     2   p    v                dplnku = pklev(ib,k  ) - blay
            2266     2   p    v                dplnkd = pklev(ib,k-1) - blay
            2267     2   p    v                bbdgas = plfrac * (blay + dplnkd*gasfac)
            2268     2   p    v                bbugas = plfrac * (blay + dplnku*gasfac)
            2269     2   p    v                gassrcd= bbdgas * atrgas
            2270     2   p    v                gassrcu(k)= bbugas * atrgas
            2271     2   p    v                trngas(k) = trng
            2272     2               
            2273     2               !  --- ...  total sky, gases+clouds contribution
            2274     2               
            2275     2   p    v                clfr = cldfrc(k)
            2276     3   p    s                if (clfr >= eps) then
            2277     3               !  --- ...  cloudy layer
            2278     3               
            2279     3   p    s                  odcld = secdif(ib) * taucld(ib,k)
            2280     3   p    s                  efclrfr(k) = f_one-(f_one - exp(-odcld))*clfr
            2281     3   p    s                  odtot = odepth + odcld
            2282     4   p    s                  if (odtot < 0.06) then
            2283     4   p    s                    totfac = rec_6 * odtot
            2284     4   p    s                    atrtot = odtot - 0.5*odtot*odtot
            2285     4   p    s                  else
            2286     4   p    s                    tblind = odtot / (bpade + odtot)
            2287     4   p    s                    ittot  = tblint*tblind + 0.5
            2288     4   p    s                    totfac = tfn_tbl(ittot)
            2289     4   p    s                    atrtot = f_one - exp_tbl(ittot)
            2290     4   p    s                  endif
            2291     3               
            2292     3   p    s                  bbdtot = plfrac * (blay + dplnkd*totfac)
            2293     3   p    s                  bbutot = plfrac * (blay + dplnku*totfac)
            2294     3   p    s                  totsrcd= bbdtot * atrtot
            2295     3   p    s                  totsrcu(k)= bbutot * atrtot
            2296     3               
            2297     3               !  --- ...  total sky radiance
            2298     3   m    s                  radtotd = radtotd*trng*efclrfr(k) + gassrcd                 &
            2299     3                    &              + clfr*(totsrcd - gassrcd)
            2300     3   s    s                  totdrad(k-1,ib) = totdrad(k-1,ib) + radtotd
            2301     3               
            2302     3               !  --- ...  clear sky radiance
            2303     3   s    s                  radclrd = radclrd*trng + gassrcd
            2304     3   m    s                  clrdrad(k-1,ib) = clrdrad(k-1,ib) + radclrd
            2305     3               
            2306     3   p    s                else
            2307     3               !  --- ...  clear layer
            2308     3               
            2309     3               !  --- ...  total sky radiance
            2310     3   s    s                  radtotd = radtotd*trng + gassrcd
            2311     3   s    s                  totdrad(k-1,ib) = totdrad(k-1,ib) + radtotd
            2312     3               
            2313     3               !  --- ...  clear sky radiance
            2314     3   s    s                  radclrd = radclrd*trng + gassrcd
            2315     3   m    s                  clrdrad(k-1,ib) = clrdrad(k-1,ib) + radclrd
            2316     3               
            2317     3   p    v                endif   ! end if_clfr_block
            2318     2               
            2319     2   p    v              enddo   ! end do_k_loop
            2320     1               
            2321     1               !  --- ...  spectral emissivity & reflectance
            2322     1               !           include the contribution of spectrally varying longwave emissivity
            2323     1               !           and reflection from the surface to the upward radiative transfer.
            2324     1               !     note: spectral and lambertian reflection are identical for the
            2325     1               !           diffusivity angle flux integration used here.
            2326     1               
            2327     1                       reflct = f_one - semiss(ib)
            2328     1                       rad0 = semiss(ib) * fracs(ig,1) * pklay(ib,0)
            2329     1               
            2330     1               !  --- ...  total sky radiance
            2331     1                       radtotu = rad0 + reflct*radtotd
            2332     1                       toturad(0,ib) = toturad(0,ib) + radtotu
            2333     1               
            2334     1               !  --- ...  clear sky radiance
            2335     1                       radclru = rad0 + reflct*radclrd
            2336     1                       clrurad(0,ib) = clrurad(0,ib) + radclru
            2337     1               
            2338     1               !  --- ...  upward radiative transfer
            2339     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfrc, trngas, gassrcu, toturad
                                   <<<      clrurad
                                   <<< Loop-information  End >>>
            2340     2   s    s              do k = 1, nlay
            2341     2   p    v                clfr = cldfrc(k)
            2342     2   s    s                trng = trngas(k)
            2343     2   p    v                gasu = gassrcu(k)
            2344     2               
            2345     3   p    v                if (clfr >= eps) then
            2346     3               !  --- ...  cloudy layer
            2347     3               
            2348     3               !  --- ... total sky radiance
            2349     3   m    m                  radtotu = radtotu*trng*efclrfr(k) + gasu                    &
            2350     3                    &            + clfr*(totsrcu(k) - gasu)
            2351     3   s    s                  toturad(k,ib) = toturad(k,ib) + radtotu
            2352     3               
            2353     3               !  --- ... clear sky radiance
            2354     3   s    s                  radclru = radclru*trng + gasu
            2355     3   m    m                  clrurad(k,ib) = clrurad(k,ib) + radclru
            2356     3               
            2357     3   p    v                else
            2358     3               !  --- ...  clear layer
            2359     3               
            2360     3               !  --- ... total sky radiance
            2361     3   s    s                  radtotu = radtotu*trng + gasu
            2362     3   s    s                  toturad(k,ib) = toturad(k,ib) + radtotu
            2363     3               
            2364     3               !  --- ... clear sky radiance
            2365     3   s    s                  radclru = radclru*trng + gasu
            2366     3   m    s                  clrurad(k,ib) = clrurad(k,ib) + radclru
            2367     3               
            2368     3   p    v                endif   ! end if_clfr_block
            2369     2               
            2370     2   p    v              enddo   ! end do_k_loop
            2371     1               
            2372     1                     enddo   ! end do_ig_loop
            2373                     
            2374                     !  --- ...  process longwave output from band for total and clear streams.
            2375                     !           calculate upward, downward, and net flux.
            2376                     
            2377                           flxfac = wtdiff * fluxfac
            2378                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrurad, totuclfl, totdclfl, totdrad
                                   <<<      totdflux, toturad, totuflux, clrdrad
                                   <<< Loop-information  End >>>
            2379     1  pp    v            do k = 0, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrdrad, totdclfl, clrurad, totuclfl
                                   <<<      totdrad, totdflux, toturad, totuflux
                                   <<< Loop-information  End >>>
            2380     2                       do ib = 1, nbands
            2381     2   p    v                totuflux(k) = totuflux(k) + toturad(k,ib)
            2382     2   p    v                totdflux(k) = totdflux(k) + totdrad(k,ib)
            2383     2   p    v                totuclfl(k) = totuclfl(k) + clrurad(k,ib)
            2384     2   p    v                totdclfl(k) = totdclfl(k) + clrdrad(k,ib)
            2385     2   p    v              enddo
            2386     1               
            2387     1   p    v              totuflux(k) = totuflux(k) * flxfac
            2388     1   p    v              totdflux(k) = totdflux(k) * flxfac
            2389     1   p    v              totuclfl(k) = totuclfl(k) * flxfac
            2390     1   p    v              totdclfl(k) = totdclfl(k) * flxfac
            2391     1   p    v            enddo
            2392                     
            2393                     !  --- ...  calculate net fluxes and heating rates
            2394                           fnet(0) = totuflux(0) - totdflux(0)
            2395                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fnet, delp, totuflux, totdflux, htr
                                   <<<      rfdelp
                                   <<< Loop-information  End >>>
            2396     1   s    v            do k = 1, nlay
            2397     1   p    v              rfdelp(k) = heatfac / delp(k)
            2398     1   m    v              fnet(k) = totuflux(k) - totdflux(k)
            2399     1   m    v              htr (k) = (fnet(k-1) - fnet(k)) * rfdelp(k)
            2400     1   p    v            enddo
            2401                     
            2402                     !! --- ...  optional clear sky heating rates
            2403     1                     if ( lhlw0 ) then
            2404     1                       fnetc(0) = totuclfl(0) - totdclfl(0)
            2405     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 104, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rfdelp, fnetc, totdclfl, totuclfl, htrcl
                                   <<< Loop-information  End >>>
            2406     2   s    v              do k = 1, nlay
            2407     2   m    v                fnetc(k) = totuclfl(k) - totdclfl(k)
            2408     2   m    v                htrcl(k) = (fnetc(k-1) - fnetc(k)) * rfdelp(k)
            2409     2   p    v              enddo
            2410     1                     endif
            2411                     
            2412                     !! --- ...  optional spectral band heating rates
            2413     1                     if ( lhlwb ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      totdrad, toturad, fnet, rfdelp, htrb
                                   <<< Loop-information  End >>>
            2414     2                       do ib = 1, nbands
            2415     2                         fnet(0) = (toturad(0,ib) - totdrad(0,ib)) * flxfac
            2416     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 136, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fnet, rfdelp, totdrad, toturad, htrb
                                   <<< Loop-information  End >>>
            2417     3   s    v                do k = 1, nlay
            2418     3   m    v                  fnet(k) = (toturad(k,ib) - totdrad(k,ib)) * flxfac
            2419     3   m    v                  htrb(k,ib) = (fnet(k-1) - fnet(k)) * rfdelp(k)
            2420     3   p    v                enddo
            2421     2                       enddo
            2422     1                     endif
            2423                     
            2424                     ! ..................................
            2425                           end subroutine rtrn
            2426                     ! ----------------------------------
            2427                     
            2428                     
            2429                     ! ----------------------------------
            2430                           subroutine rtrnmr                                                 &
            2431                     ! ..................................
            2432                     !  ---  inputs:
            2433                          &     ( semiss,delp,cldfrc,taucld,tautot,pklay,pklev,              &
            2434                          &       fracs,secdif, nlay,nlp1,                                   &
            2435                     !  ---  outputs:
            2436                          &       totuflux,totdflux,htr, totuclfl,totdclfl,htrcl, htrb       &
            2437                          &     )
            2438                     
            2439                     !  ===================  program usage description  ===================  !
            2440                     !                                                                       !
            2441                     ! purpose:  compute the upward/downward radiative fluxes, and heating   !
            2442                     ! rates for both clear or cloudy atmosphere.  clouds are assumed as in  !
            2443                     ! maximum-randomly overlaping in a vertical colum.                      !
            2444                     !                                                                       !
            2445                     ! subprograms called:  none                                             !
            2446                     !                                                                       !
            2447                     !  ====================  defination of variables  ====================  !
            2448                     !                                                                       !
            2449                     !  inputs:                                                     -size-   !
            2450                     !   semiss  - real, lw surface emissivity                         nbands!
            2451                     !   delp    - real, layer pressure thickness (mb)                  nlay !
            2452                     !   cldfrc  - real, layer cloud fraction                         0:nlp1 !
            2453                     !   taucld  - real, layer cloud opt depth                    nbands,nlay!
            2454                     !   tautot  - real, total optical depth (gas+aerosols)       ngptlw,nlay!
            2455                     !   pklay   - real, integrated planck func at lay temp     nbands*0:nlay!
            2456                     !   pklev   - real, integrated planck func at lev temp     nbands*0:nlay!
            2457                     !   fracs   - real, planck fractions                         ngptlw,nlay!
            2458                     !   secdif  - real, secant of diffusivity angle                   nbands!
            2459                     !   nlay    - integer, number of vertical layers                    1   !
            2460                     !   nlp1    - integer, number of vertical levels (interfaces)       1   !
            2461                     !                                                                       !
            2462                     !  outputs:                                                             !
            2463                     !   totuflux- real, total sky upward flux (w/m2)                 0:nlay !
            2464                     !   totdflux- real, total sky downward flux (w/m2)               0:nlay !
            2465                     !   htr     - real, total sky heating rate (k/sec or k/day)        nlay !
            2466                     !   totuclfl- real, clear sky upward flux (w/m2)                 0:nlay !
            2467                     !   totdclfl- real, clear sky downward flux (w/m2)               0:nlay !
            2468                     !   htrcl   - real, clear sky heating rate (k/sec or k/day)        nlay !
            2469                     !   htrb    - real, spectral band lw heating rate (k/day)    nlay*nbands!
            2470                     !                                                                       !
            2471                     !  module veriables:                                                    !
            2472                     !   ngb     - integer, band index for each g-value                ngptlw!
            2473                     !   fluxfac - real, conversion factor for fluxes (pi*2.e4)           1  !
            2474                     !   heatfac - real, conversion factor for heating rates (g/cp*1e-2)  1  !
            2475                     !   tblint  - real, conversion factor for look-up tbl (float(ntbl)   1  !
            2476                     !   bpade   - real, pade approx constant (1/0.278)                   1  !
            2477                     !   wtdiff  - real, weight for radiance to flux conversion           1  !
            2478                     !   ntbl    - integer, dimension of look-up tables                   1  !
            2479                     !   tau_tbl - real, clr-sky opt dep lookup table                 0:ntbl !
            2480                     !   exp_tbl - real, transmittance lookup table                   0:ntbl !
            2481                     !   tfn_tbl - real, tau transition function                      0:ntbl !
            2482                     !                                                                       !
            2483                     !  local variables:                                                     !
            2484                     !    itgas  - integer, index for gases contribution look-up table    1  !
            2485                     !    ittot  - integer, index for gases plus clouds  look-up table    1  !
            2486                     !    reflct - real, surface reflectance                              1  !
            2487                     !    atrgas - real, gaseous absorptivity                             1  !
            2488                     !    atrtot - real, gaseous and cloud absorptivity                   1  !
            2489                     !    odcld  - real, cloud optical depth                              1  !
            2490                     !    odepth - real, optical depth of gaseous only                    1  !
            2491                     !    odtot  - real, optical depth of gas and cloud                   1  !
            2492                     !    gasfac - real, gas-only pade factor, used for planck fn         1  !
            2493                     !    totfac - real, gas+cld pade factor, used for planck fn          1  !
            2494                     !    bbdgas - real, gas-only planck function for downward rt         1  !
            2495                     !    bbugas - real, gas-only planck function for upward rt           1  !
            2496                     !    bbdtot - real, gas and cloud planck function for downward rt    1  !
            2497                     !    bbutot - real, gas and cloud planck function for upward rt      1  !
            2498                     !    gassrcu- real, upwd source radiance due to gas only            nlay!
            2499                     !    totsrcu- real, upwd source radiance due to gas + cld           nlay!
            2500                     !    gassrcd- real, dnwd source radiance due to gas only             1  !
            2501                     !    totsrcd- real, dnwd source radiance due to gas + cld            1  !
            2502                     !    radtotu- real, spectrally summed total sky upwd radiance        1  !
            2503                     !    radclru- real, spectrally summed clear sky upwd radiance        1  !
            2504                     !    radtotd- real, spectrally summed total sky dnwd radiance        1  !
            2505                     !    radclrd- real, spectrally summed clear sky dnwd radiance        1  !
            2506                     !    toturad- real, total sky upward radiance by layer     0:nlay*nbands!
            2507                     !    clrurad- real, clear sky upward radiance by layer     0:nlay*nbands!
            2508                     !    totdrad- real, total sky downward radiance by layer   0:nlay*nbands!
            2509                     !    clrdrad- real, clear sky downward radiance by layer   0:nlay*nbands!
            2510                     !    fnet   - real, net longwave flux (w/m2)                     0:nlay !
            2511                     !    fnetc  - real, clear sky net longwave flux (w/m2)           0:nlay !
            2512                     !                                                                       !
            2513                     !                                                                       !
            2514                     !  *******************************************************************  !
            2515                     !  original code description                                            !
            2516                     !                                                                       !
            2517                     !  original version:   e. j. mlawer, et al. rrtm_v3.0                   !
            2518                     !  revision for gcms:  michael j. iacono; october, 2002                 !
            2519                     !  revision for f90:   michael j. iacono; june, 2006                    !
            2520                     !                                                                       !
            2521                     !  this program calculates the upward fluxes, downward fluxes, and      !
            2522                     !  heating rates for an arbitrary clear or cloudy atmosphere. the input !
            2523                     !  to this program is the atmospheric profile, all planck function      !
            2524                     !  information, and the cloud fraction by layer.  a variable diffusivity!
            2525                     !  angle (secdif) is used for the angle integration. bands 2-3 and 5-9  !
            2526                     !  use a value for secdif that varies from 1.50 to 1.80 as a function   !
            2527                     !  of the column water vapor, and other bands use a value of 1.66.  the !
            2528                     !  gaussian weight appropriate to this angle (wtdiff=0.5) is applied    !
            2529                     !  here.  note that use of the emissivity angle for the flux integration!
            2530                     !  can cause errors of 1 to 4 w/m2 within cloudy layers.                !
            2531                     !  clouds are treated with a maximum-random cloud overlap method.       !
            2532                     !                                                                       !
            2533                     !  *******************************************************************  !
            2534                     !  ======================  end of description block  =================  !
            2535                     
            2536                     !  ---  inputs:
            2537                           integer, intent(in) :: nlay, nlp1
            2538                     
            2539                           real (kind=kind_phys), dimension(0:nlp1), intent(in) :: cldfrc
            2540                           real (kind=kind_phys), dimension(nbands), intent(in) :: semiss,   &
            2541                          &       secdif
            2542                           real (kind=kind_phys), dimension(nlay),   intent(in) :: delp
            2543                     
            2544                           real (kind=kind_phys), dimension(nbands,nlay),intent(in):: taucld
            2545                           real (kind=kind_phys), dimension(ngptlw,nlay),intent(in):: fracs, &
            2546                          &       tautot
            2547                     
            2548                           real (kind=kind_phys), dimension(nbands,0:nlay), intent(in) ::    &
            2549                          &       pklev, pklay
            2550                     
            2551                     !  ---  outputs:
            2552                           real (kind=kind_phys), dimension(nlay), intent(out) :: htr, htrcl
            2553                     
            2554                           real (kind=kind_phys), dimension(nlay,nbands),intent(out) :: htrb
            2555                     
            2556                           real (kind=kind_phys), dimension(0:nlay), intent(out) ::          &
            2557                          &       totuflux, totdflux, totuclfl, totdclfl
            2558                     
            2559                     !  ---  locals:
            2560                           real (kind=kind_phys), parameter :: rec_6 = 0.166667
            2561                     
            2562                           real (kind=kind_phys), dimension(0:nlay,nbands) :: clrurad,       &
            2563                          &       clrdrad, toturad, totdrad
            2564                     
            2565                           real (kind=kind_phys), dimension(nlay)   :: gassrcu, totsrcu,     &
            2566                          &       trngas, trntot, rfdelp
            2567                           real (kind=kind_phys), dimension(0:nlay) :: fnet, fnetc
            2568                     
            2569                           real (kind=kind_phys) :: totsrcd, gassrcd, tblind, odepth, odtot, &
            2570                          &       odcld, atrtot, atrgas, reflct, totfac, gasfac, flxfac,     &
            2571                          &       plfrac, blay, bbdgas, bbdtot, bbugas, bbutot, dplnku,      &
            2572                          &       dplnkd, radtotu, radclru, radtotd, radclrd, rad0, rad,     &
            2573                          &       totradd, clrradd, totradu, clrradu, fmax, fmin, rat1, rat2,&
            2574                          &       radmod, clfr, trng, trnt, gasu, totu
            2575                     
            2576                           integer :: ittot, itgas, ib, ig, k
            2577                     
            2578                     !  dimensions for cloud overlap adjustment
            2579                           real (kind=kind_phys), dimension(nlp1) :: faccld1u, faccld2u,     &
            2580                          &        facclr1u, facclr2u, faccmb1u, faccmb2u
            2581                           real (kind=kind_phys), dimension(0:nlay) :: faccld1d, faccld2d,   &
            2582                          &        facclr1d, facclr2d, faccmb1d, faccmb2d
            2583                     
            2584                           logical :: lstcldu(nlay), lstcldd(nlay)
            2585                     !
            2586                     !===> ...  begin here
            2587                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      faccmb2u, faccmb1u, facclr2u, facclr1u
                                   <<<      faccld2u, faccld1u
                                   <<< Loop-information  End >>>
            2588     1  pp   2v            do k = 1, nlp1
            2589     1   p   2v              faccld1u(k) = f_zero
            2590     1   p   2v              faccld2u(k) = f_zero
            2591     1   p   2v              facclr1u(k) = f_zero
            2592     1   p   2v              facclr2u(k) = f_zero
            2593     1   p   2v              faccmb1u(k) = f_zero
            2594     1   p   2v              faccmb2u(k) = f_zero
            2595     1   p   2v            enddo
            2596                     
            2597                           lstcldu(1) = cldfrc(1) > eps
            2598                           rat1 = f_zero
            2599                           rat2 = f_zero
            2600                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfrc, lstcldu
                                   <<< Loop-information  End >>>
            2601     1   s   2s            do k = 1, nlay-1
            2602     1               
            2603     1   m   2v              lstcldu(k+1) = cldfrc(k+1)>eps .and. cldfrc(k)<=eps
            2604     1               
            2605     2   p   2v              if (cldfrc(k) > eps) then
            2606     2               !  --- ...  maximum/random cloud overlap
            2607     2               
            2608     3   p   2v                if (cldfrc(k+1) >= cldfrc(k)) then
            2609     4   m   2v                  if (lstcldu(k)) then
            2610     5   p   2v                    if (cldfrc(k) < f_one) then
            2611     5   m   2v                      facclr2u(k+1) = (cldfrc(k+1) - cldfrc(k))               &
            2612     5                    &                        / (f_one - cldfrc(k))
            2613     5   p   2v                    endif
            2614     4   s   2v                    facclr2u(k) = f_zero
            2615     4   m   2v                    faccld2u(k) = f_zero
            2616     4   p   2v                  else
            2617     4   p   2v                    fmax = max(cldfrc(k), cldfrc(k-1))
            2618     5   p   2v                    if (cldfrc(k+1) > fmax) then
            2619     5   s   2s                      facclr1u(k+1) = rat2
            2620     5   m   2v                      facclr2u(k+1) = (cldfrc(k+1) - fmax)/(f_one - fmax)
            2621     5   p   2v                    elseif (cldfrc(k+1) < fmax) then
            2622     5   p   2v                      facclr1u(k+1) = (cldfrc(k+1) - cldfrc(k))               &
            2623     5                    &                        / (cldfrc(k-1) - cldfrc(k))
            2624     5   p   2v                    else
            2625     5   m   2m                      facclr1u(k+1) = rat2
            2626     5   p   2v                    endif
            2627     4   p   2v                  endif
            2628     3               
            2629     4   s   2m                  if (facclr1u(k+1)>f_zero .or. facclr2u(k+1)>f_zero) then
            2630     4   s   2s                    rat1 = f_one
            2631     4   m   2m                    rat2 = f_zero
            2632     4   s   2s                  else
            2633     4   s   2s                    rat1 = f_zero
            2634     4   s   2s                    rat2 = f_zero
            2635     4   p   2v                  endif
            2636     3   p   2v                else
            2637     4   m   2v                  if (lstcldu(k)) then
            2638     4   m   2v                    faccld2u(k+1) = (cldfrc(k) - cldfrc(k+1)) / cldfrc(k)
            2639     4   s   2v                    facclr2u(k) = f_zero
            2640     4   m   2v                    faccld2u(k) = f_zero
            2641     4   p   2v                  else
            2642     4   p   2v                    fmin = min(cldfrc(k), cldfrc(k-1))
            2643     5   p   2v                    if (cldfrc(k+1) <= fmin) then
            2644     5   s   2s                      faccld1u(k+1) = rat1
            2645     5   m   2v                      faccld2u(k+1) = (fmin - cldfrc(k+1)) / fmin
            2646     5   p   2v                    else
            2647     5   p   2v                      faccld1u(k+1) = (cldfrc(k) - cldfrc(k+1))               &
            2648     5                    &                        / (cldfrc(k) - fmin)
            2649     5   p   2v                    endif
            2650     4   p   2v                  endif
            2651     3               
            2652     4   m   2m                  if (faccld1u(k+1)>f_zero .or. faccld2u(k+1)>f_zero) then
            2653     4   s   2s                    rat1 = f_zero
            2654     4   m   2m                    rat2 = f_one
            2655     4   s   2s                  else
            2656     4   s   2s                    rat1 = f_zero
            2657     4   m   2m                    rat2 = f_zero
            2658     4   p   2v                  endif
            2659     3   p   2v                endif
            2660     2               
            2661     2   m   2v                faccmb1u(k+1) = facclr1u(k+1) * faccld2u(k) * cldfrc(k-1)
            2662     2   m   2v                faccmb2u(k+1) = faccld1u(k+1) * facclr2u(k)                   &
            2663     2                    &                  * (f_one - cldfrc(k-1))
            2664     2   p   2v              endif
            2665     1               
            2666     1   p   2v            enddo
            2667                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 696
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      faccmb2d, faccmb1d, facclr2d, facclr1d
                                   <<<      faccld2d, faccld1d
                                   <<< Loop-information  End >>>
            2668     1  pp   2v            do k = 0, nlay
            2669     1   p   2v              faccld1d(k) = f_zero
            2670     1   p   2v              faccld2d(k) = f_zero
            2671     1   p   2v              facclr1d(k) = f_zero
            2672     1   p   2v              facclr2d(k) = f_zero
            2673     1   p   2v              faccmb1d(k) = f_zero
            2674     1   p   2v              faccmb2d(k) = f_zero
            2675     1   p   2v            enddo
            2676                     
            2677                           lstcldd(nlay) = cldfrc(nlay) > eps
            2678                           rat1 = f_zero
            2679                           rat2 = f_zero
            2680                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfrc, lstcldd
                                   <<< Loop-information  End >>>
            2681     1   s   2s            do k = nlay, 2, -1
            2682     1               
            2683     1   m   2v              lstcldd(k-1) = cldfrc(k-1) > eps .and. cldfrc(k)<=eps
            2684     1               
            2685     2   p   2v              if (cldfrc(k) > eps) then
            2686     2               
            2687     3   p   2v                if (cldfrc(k-1) >= cldfrc(k)) then
            2688     4   m   2v                  if (lstcldd(k)) then
            2689     5   p   2v                    if (cldfrc(k) < f_one) then
            2690     5   m   2v                      facclr2d(k-1) = (cldfrc(k-1) - cldfrc(k))               &
            2691     5                    &                        / (f_one - cldfrc(k))
            2692     5   p   2v                    endif
            2693     4               
            2694     4   s   2v                    facclr2d(k) = f_zero
            2695     4   m   2v                    faccld2d(k) = f_zero
            2696     4   p   2v                  else
            2697     4   p   2v                    fmax = max(cldfrc(k), cldfrc(k+1))
            2698     4               
            2699     5   p   2v                    if (cldfrc(k-1) > fmax) then
            2700     5   s   2s                      facclr1d(k-1) = rat2
            2701     5   m   2v                      facclr2d(k-1) = (cldfrc(k-1) - fmax) / (f_one - fmax)
            2702     5   p   2v                    elseif (cldfrc(k-1) < fmax) then
            2703     5   p   2v                      facclr1d(k-1) = (cldfrc(k-1) - cldfrc(k))               &
            2704     5                    &                        / (cldfrc(k+1) - cldfrc(k))
            2705     5   p   2v                    else
            2706     5   m   2m                      facclr1d(k-1) = rat2
            2707     5   p   2v                    endif
            2708     4   p   2v                  endif
            2709     3               
            2710     4   s   2m                  if (facclr1d(k-1)>f_zero .or. facclr2d(k-1)>f_zero) then
            2711     4   s   2s                    rat1 = f_one
            2712     4   m   2m                    rat2 = f_zero
            2713     4   s   2s                  else
            2714     4   s   2s                    rat1 = f_zero
            2715     4   s   2s                    rat2 = f_zero
            2716     4   p   2v                  endif
            2717     3   p   2v                else
            2718     4   m   2v                  if (lstcldd(k)) then
            2719     4   m   2v                    faccld2d(k-1) = (cldfrc(k) - cldfrc(k-1)) / cldfrc(k)
            2720     4   s   2v                    facclr2d(k) = f_zero
            2721     4   m   2v                    faccld2d(k) = f_zero
            2722     4   p   2v                  else
            2723     4   p   2v                    fmin = min(cldfrc(k), cldfrc(k+1))
            2724     4               
            2725     5   p   2v                    if (cldfrc(k-1) <= fmin) then
            2726     5   s   2s                      faccld1d(k-1) = rat1
            2727     5   m   2v                      faccld2d(k-1) = (fmin - cldfrc(k-1)) / fmin
            2728     5   p   2v                    else
            2729     5   p   2v                      faccld1d(k-1) = (cldfrc(k) - cldfrc(k-1))               &
            2730     5                    &                        / (cldfrc(k) - fmin)
            2731     5   p   2v                    endif
            2732     4   p   2v                  endif
            2733     3               
            2734     4   m   2m                  if (faccld1d(k-1)>f_zero .or. faccld2d(k-1)>f_zero) then
            2735     4   s   2s                    rat1 = f_zero
            2736     4   m   2m                    rat2 = f_one
            2737     4   s   2s                  else
            2738     4   s   2s                    rat1 = f_zero
            2739     4   m   2m                    rat2 = f_zero
            2740     4   p   2v                  endif
            2741     3   p   2v                endif
            2742     2               
            2743     2   m   2v                faccmb1d(k-1) = facclr1d(k-1) * faccld2d(k) * cldfrc(k+1)
            2744     2   m   2v                faccmb2d(k-1) = faccld1d(k-1) * facclr2d(k)                   &
            2745     2                    &                  * (f_one - cldfrc(k+1))
            2746     2   p   2v              endif
            2747     1               
            2748     1   p   2v            enddo
            2749                     
            2750                     !  --- ...  initialize for radiative transfer.
            2751                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrdrad, clrurad, totdrad, toturad
                                   <<< Loop-information  End >>>
            2752     1  pp   2v            do ib = 1, nbands
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            2753     2   p   2               do k = 0, nlay
            2754     2   p   2v                toturad(k,ib) = f_zero
            2755     2   p   2v                totdrad(k,ib) = f_zero
            2756     2   p   2v                clrurad(k,ib) = f_zero
            2757     2   p   2v                clrdrad(k,ib) = f_zero
            2758     2   p   2v              enddo
            2759     1   p                 enddo
            2760                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      totdclfl, totuclfl, totdflux, totuflux
                                   <<< Loop-information  End >>>
            2761     1  pp   2v            do k = 0, nlay
            2762     1   p   2v              totuflux(k) = f_zero
            2763     1   p   2v              totdflux(k) = f_zero
            2764     1   p   2v              totuclfl(k) = f_zero
            2765     1   p   2v              totdclfl(k) = f_zero
            2766     1   p   2v            enddo
            2767                     
            2768                     !  --- ...  loop over all g-points
            2769                     
            2770     1                     do ig = 1, ngptlw
            2771     1                       ib = ngb(ig)
            2772     1               
            2773     1                       radtotd = f_zero
            2774     1                       radclrd = f_zero
            2775     1               
            2776     1               !  --- ...  downward radiative transfer loop.
            2777     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pklay, pklev, cldfrc, gassrcu, trngas
                                   <<<      lstcldd
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2778     2   s    s              do k = nlay, 1, -1
            2779     2               
            2780     2               !  --- ...  clear sky, gases contribution
            2781     2               
            2782     2   p    v                odepth = max( f_zero, secdif(ib)*tautot(ig,k) )
            2783     3   p    s                if (odepth <= 0.06) then
            2784     3   p    s                  atrgas = odepth - 0.5*odepth*odepth
            2785     3   p    s                  trng   = f_one - atrgas
            2786     3   p    s                  gasfac = rec_6 * odepth
            2787     3   p    s                else
            2788     3   p    s                  tblind = odepth / (bpade + odepth)
            2789     3   p    s                  itgas = tblint*tblind + 0.5
            2790     3   p    s                  trng  = exp_tbl(itgas)
            2791     3   p    s                  atrgas = f_one - trng
            2792     3   p    s                  gasfac = tfn_tbl(itgas)
            2793     3   p    s                  odepth = tau_tbl(itgas)
            2794     3   p    v                endif
            2795     2               
            2796     2   p    v                plfrac = fracs(ig,k)
            2797     2   p    v                blay = pklay(ib,k)
            2798     2               
            2799     2   p    v                dplnku = pklev(ib,k  ) - blay
            2800     2   p    v                dplnkd = pklev(ib,k-1) - blay
            2801     2   p    v                bbdgas = plfrac * (blay + dplnkd*gasfac)
            2802     2   p    v                bbugas = plfrac * (blay + dplnku*gasfac)
            2803     2   p    v                gassrcd   = bbdgas * atrgas
            2804     2   p    v                gassrcu(k)= bbugas * atrgas
            2805     2   p    v                trngas(k) = trng
            2806     2               
            2807     2               !  --- ...  total sky, gases+clouds contribution
            2808     2               
            2809     2   p    v                clfr = cldfrc(k)
            2810     3   p    m                if (lstcldd(k)) then
            2811     3   m    s                  totradd = clfr * radtotd
            2812     3   s    s                  clrradd = radtotd - totradd
            2813     3   s    s                  rad = f_zero
            2814     3   p    v                endif
            2815     2               
            2816     3   p    s                if (clfr >= eps) then
            2817     3               !  --- ...  cloudy layer
            2818     3               
            2819     3   p    s                  odcld = secdif(ib) * taucld(ib,k)
            2820     3   p    s                  odtot = odepth + odcld
            2821     4   p    s                  if (odtot < 0.06) then
            2822     4   p    s                    totfac = rec_6 * odtot
            2823     4   p    s                    atrtot = odtot - 0.5*odtot*odtot
            2824     4   p    s                    trnt   = f_one - atrtot
            2825     4   p    s                  else
            2826     4   p    s                    tblind = odtot / (bpade + odtot)
            2827     4   p    s                    ittot  = tblint*tblind + 0.5
            2828     4   p    s                    totfac = tfn_tbl(ittot)
            2829     4   p    s                    trnt   = exp_tbl(ittot)
            2830     4   p    s                    atrtot = f_one - trnt
            2831     4   p    s                  endif
            2832     3               
            2833     3   p    s                  bbdtot = plfrac * (blay + dplnkd*totfac)
            2834     3   p    s                  bbutot = plfrac * (blay + dplnku*totfac)
            2835     3   p    s                  totsrcd   = bbdtot * atrtot
            2836     3   p    s                  totsrcu(k)= bbutot * atrtot
            2837     3   p    s                  trntot(k) = trnt
            2838     3               
            2839     3   m    s                  totradd = totradd*trnt + clfr*totsrcd
            2840     3   m    s                  clrradd = clrradd*trng + (f_one - clfr)*gassrcd
            2841     3               
            2842     3               !  --- ...  total sky radiance
            2843     3   s    s                  radtotd = totradd + clrradd
            2844     3   s    s                  totdrad(k-1,ib) = totdrad(k-1,ib) + radtotd
            2845     3               
            2846     3               !  --- ...  clear sky radiance
            2847     3   s    s                  radclrd = radclrd*trng + gassrcd
            2848     3   s    s                  clrdrad(k-1,ib) = clrdrad(k-1,ib) + radclrd
            2849     3               
            2850     3   m    s                  radmod = rad*(facclr1d(k-1)*trng + faccld1d(k-1)*trnt)      &
            2851     3                    &             - faccmb1d(k-1)*gassrcd + faccmb2d(k-1)*totsrcd
            2852     3               
            2853     3   s    s                  rad = -radmod + facclr2d(k-1)*(clrradd + radmod)            &
            2854     3                    &                    - faccld2d(k-1)*(totradd - radmod)
            2855     3   s    s                  totradd = totradd + rad
            2856     3   m    s                  clrradd = clrradd - rad
            2857     3               
            2858     3   p    s                else
            2859     3               !  --- ...  clear layer
            2860     3               
            2861     3               !  --- ...  total sky radiance
            2862     3   s    s                  radtotd = radtotd*trng + gassrcd
            2863     3   s    s                  totdrad(k-1,ib) = totdrad(k-1,ib) + radtotd
            2864     3               
            2865     3               !  --- ...  clear sky radiance
            2866     3   s    s                  radclrd = radclrd*trng + gassrcd
            2867     3   m    s                  clrdrad(k-1,ib) = clrdrad(k-1,ib) + radclrd
            2868     3               
            2869     3   p    v                endif   ! end if_clfr_block
            2870     2               
            2871     2   p    v              enddo   ! end do_k_loop
            2872     1               
            2873     1               !  --- ...  spectral emissivity & reflectance
            2874     1               !           include the contribution of spectrally varying longwave emissivity
            2875     1               !           and reflection from the surface to the upward radiative transfer.
            2876     1               !     note: spectral and lambertian reflection are identical for the
            2877     1               !           diffusivity angle flux integration used here.
            2878     1               
            2879     1                       reflct = f_one - semiss(ib)
            2880     1                       rad0 = semiss(ib) * fracs(ig,1) * pklay(ib,0)
            2881     1               
            2882     1               !  --- ...  total sky radiance
            2883     1                       radtotu = rad0 + reflct*radtotd
            2884     1                       toturad(0,ib) = toturad(0,ib) + radtotu
            2885     1               
            2886     1               !  --- ...  clear sky radiance
            2887     1                       radclru = rad0 + reflct*radclrd
            2888     1                       clrurad(0,ib) = clrurad(0,ib) + radclru
            2889     1               
            2890     1               !  --- ...  upward radiative transfer loop.
            2891     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfrc, trngas, gassrcu, lstcldu
                                   <<< Loop-information  End >>>
            2892     2   s    s              do k = 1, nlay
            2893     2               
            2894     2   p    v                clfr = cldfrc(k)
            2895     2   p    s                trng = trngas(k)
            2896     2   p    s                gasu = gassrcu(k)
            2897     2               
            2898     3   p    v                if (lstcldu(k)) then
            2899     3   m    m                  totradu = clfr * radtotu
            2900     3   s    s                  clrradu = radtotu - totradu
            2901     3   s    s                  rad = f_zero
            2902     3   p    v                endif
            2903     2               
            2904     3   p    v                if (clfr >= eps) then
            2905     3               !  --- ...  cloudy layer
            2906     3               
            2907     3   p    v                  trnt = trntot(k)
            2908     3   p    v                  totu = totsrcu(k)
            2909     3   m    m                  totradu = totradu*trnt + clfr*totu
            2910     3   m    m                  clrradu = clrradu*trng + (f_one - clfr)*gasu
            2911     3               
            2912     3               !  --- ...  total sky radiance
            2913     3   s    s                  radtotu = totradu + clrradu
            2914     3   s    s                  toturad(k,ib) = toturad(k,ib) + radtotu
            2915     3               
            2916     3               !  --- ...  clear sky radiance
            2917     3   s    s                  radclru = radclru*trng + gasu
            2918     3   s    s                  clrurad(k,ib) = clrurad(k,ib) + radclru
            2919     3               
            2920     3   m    m                  radmod = rad*(facclr1u(k+1)*trng + faccld1u(k+1)*trnt)      &
            2921     3                    &             - faccmb1u(k+1)*gasu + faccmb2u(k+1)*totu
            2922     3   s    s                  rad = -radmod + facclr2u(k+1)*(clrradu + radmod)            &
            2923     3                    &                    - faccld2u(k+1)*(totradu - radmod)
            2924     3   s    s                  totradu = totradu + rad
            2925     3   m    m                  clrradu = clrradu - rad
            2926     3               
            2927     3   p    v                else
            2928     3               !  --- ...  clear layer
            2929     3               
            2930     3               !  --- ...  total sky radiance
            2931     3   s    s                  radtotu = radtotu*trng + gasu
            2932     3   s    s                  toturad(k,ib) = toturad(k,ib) + radtotu
            2933     3               
            2934     3               !  --- ...  clear sky radiance
            2935     3   s    s                  radclru = radclru*trng + gasu
            2936     3   m    s                  clrurad(k,ib) = clrurad(k,ib) + radclru
            2937     3               
            2938     3   p    v                endif   ! end if_clfr_block
            2939     2               
            2940     2   p    v              enddo   ! end do_k_loop
            2941     1               
            2942     1                     enddo   ! end do_ig_loop
            2943                     
            2944                     !  --- ...  process longwave output from band for total and clear streams.
            2945                     !           calculate upward, downward, and net flux.
            2946                     
            2947                           flxfac = wtdiff * fluxfac
            2948                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrurad, totuclfl, totdclfl, totdrad
                                   <<<      totdflux, toturad, totuflux, clrdrad
                                   <<< Loop-information  End >>>
            2949     1  pp    v            do k = 0, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrdrad, totdclfl, clrurad, totuclfl
                                   <<<      totdrad, totdflux, toturad, totuflux
                                   <<< Loop-information  End >>>
            2950     2                       do ib = 1, nbands
            2951     2   p    v                totuflux(k) = totuflux(k) + toturad(k,ib)
            2952     2   p    v                totdflux(k) = totdflux(k) + totdrad(k,ib)
            2953     2   p    v                totuclfl(k) = totuclfl(k) + clrurad(k,ib)
            2954     2   p    v                totdclfl(k) = totdclfl(k) + clrdrad(k,ib)
            2955     2   p    v              enddo
            2956     1               
            2957     1   p    v              totuflux(k) = totuflux(k) * flxfac
            2958     1   p    v              totdflux(k) = totdflux(k) * flxfac
            2959     1   p    v              totuclfl(k) = totuclfl(k) * flxfac
            2960     1   p    v              totdclfl(k) = totdclfl(k) * flxfac
            2961     1   p    v            enddo
            2962                     
            2963                     !  --- ...  calculate net fluxes and heating rates
            2964                           fnet(0) = totuflux(0) - totdflux(0)
            2965                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fnet, delp, totuflux, totdflux, htr
                                   <<<      rfdelp
                                   <<< Loop-information  End >>>
            2966     1   s    v            do k = 1, nlay
            2967     1   p    v              rfdelp(k) = heatfac / delp(k)
            2968     1   m    v              fnet(k) = totuflux(k) - totdflux(k)
            2969     1   m    v              htr (k) = (fnet(k-1) - fnet(k)) * rfdelp(k)
            2970     1   p    v            enddo
            2971                     
            2972                     !! --- ...  optional clear sky heating rates
            2973     1                     if ( lhlw0 ) then
            2974     1                       fnetc(0) = totuclfl(0) - totdclfl(0)
            2975     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 104, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rfdelp, fnetc, totdclfl, totuclfl, htrcl
                                   <<< Loop-information  End >>>
            2976     2   s    v              do k = 1, nlay
            2977     2   m    v                fnetc(k) = totuclfl(k) - totdclfl(k)
            2978     2   m    v                htrcl(k) = (fnetc(k-1) - fnetc(k)) * rfdelp(k)
            2979     2   p    v              enddo
            2980     1                     endif
            2981                     
            2982                     !! --- ...  optional spectral band heating rates
            2983     1                     if ( lhlwb ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rfdelp, totdrad, toturad, fnet, htrb
                                   <<< Loop-information  End >>>
            2984     2                       do ib = 1, nbands
            2985     2                         fnet(0) = (toturad(0,ib) - totdrad(0,ib)) * flxfac
            2986     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 136, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fnet, rfdelp, totdrad, toturad, htrb
                                   <<< Loop-information  End >>>
            2987     3   s    v                do k = 1, nlay
            2988     3   m    v                  fnet(k) = (toturad(k,ib) - totdrad(k,ib)) * flxfac
            2989     3   m    v                  htrb(k,ib) = (fnet(k-1) - fnet(k)) * rfdelp(k)
            2990     3   p    v                enddo
            2991     2                       enddo
            2992     1                     endif
            2993                     
            2994                     ! .................................
            2995                           end subroutine rtrnmr
            2996                     ! ---------------------------------
            2997                     
            2998                     
            2999                     ! ---------------------------------
            3000                           subroutine rtrnmc                                                 &
            3001                     ! .................................
            3002                     !  ---  inputs:
            3003                          &     ( semiss,delp,cldfmc,taucld,tautot,pklay,pklev,              &
            3004                          &       fracs,secdif, nlay,nlp1,                                   &
            3005                     !  ---  outputs:
            3006                          &       totuflux,totdflux,htr, totuclfl,totdclfl,htrcl, htrb       &
            3007                          &     )
            3008                     
            3009                     !  ===================  program usage description  ===================  !
            3010                     !                                                                       !
            3011                     ! purpose:  compute the upward/downward radiative fluxes, and heating   !
            3012                     ! rates for both clear or cloudy atmosphere.  clouds are treated with   !
            3013                     ! the mcica stochastic approach.                                        !
            3014                     !                                                                       !
            3015                     ! subprograms called:  none                                             !
            3016                     !                                                                       !
            3017                     !  ====================  defination of variables  ====================  !
            3018                     !                                                                       !
            3019                     !  inputs:                                                     -size-   !
            3020                     !   semiss  - real, lw surface emissivity                         nbands!
            3021                     !   delp    - real, layer pressure thickness (mb)                  nlay !
            3022                     !   cldfmc  - real, layer cloud fraction (sub-column)        ngptlw*nlay!
            3023                     !   taucld  - real, layer cloud opt depth                    nbands*nlay!
            3024                     !   tautot  - real, total optical depth (gas+aerosols)       ngptlw*nlay!
            3025                     !   pklay   - real, integrated planck func at lay temp     nbands*0:nlay!
            3026                     !   pklev   - real, integrated planck func at lev temp     nbands*0:nlay!
            3027                     !   fracs   - real, planck fractions                         ngptlw*nlay!
            3028                     !   secdif  - real, secant of diffusivity angle                   nbands!
            3029                     !   nlay    - integer, number of vertical layers                    1   !
            3030                     !   nlp1    - integer, number of vertical levels (interfaces)       1   !
            3031                     !                                                                       !
            3032                     !  outputs:                                                             !
            3033                     !   totuflux- real, total sky upward flux (w/m2)                 0:nlay !
            3034                     !   totdflux- real, total sky downward flux (w/m2)               0:nlay !
            3035                     !   htr     - real, total sky heating rate (k/sec or k/day)        nlay !
            3036                     !   totuclfl- real, clear sky upward flux (w/m2)                 0:nlay !
            3037                     !   totdclfl- real, clear sky downward flux (w/m2)               0:nlay !
            3038                     !   htrcl   - real, clear sky heating rate (k/sec or k/day)        nlay !
            3039                     !   htrb    - real, spectral band lw heating rate (k/day)    nlay*nbands!
            3040                     !                                                                       !
            3041                     !  module veriables:                                                    !
            3042                     !   ngb     - integer, band index for each g-value                ngptlw!
            3043                     !   fluxfac - real, conversion factor for fluxes (pi*2.e4)           1  !
            3044                     !   heatfac - real, conversion factor for heating rates (g/cp*1e-2)  1  !
            3045                     !   tblint  - real, conversion factor for look-up tbl (float(ntbl)   1  !
            3046                     !   bpade   - real, pade approx constant (1/0.278)                   1  !
            3047                     !   wtdiff  - real, weight for radiance to flux conversion           1  !
            3048                     !   ntbl    - integer, dimension of look-up tables                   1  !
            3049                     !   tau_tbl - real, clr-sky opt dep lookup table                 0:ntbl !
            3050                     !   exp_tbl - real, transmittance lookup table                   0:ntbl !
            3051                     !   tfn_tbl - real, tau transition function                      0:ntbl !
            3052                     !                                                                       !
            3053                     !  local variables:                                                     !
            3054                     !    itgas  - integer, index for gases contribution look-up table    1  !
            3055                     !    ittot  - integer, index for gases plus clouds  look-up table    1  !
            3056                     !    reflct - real, surface reflectance                              1  !
            3057                     !    atrgas - real, gaseous absorptivity                             1  !
            3058                     !    atrtot - real, gaseous and cloud absorptivity                   1  !
            3059                     !    odcld  - real, cloud optical depth                              1  !
            3060                     !    efclrfr- real, effective clear sky fraction (1-efcldfr)        nlay!
            3061                     !    odepth - real, optical depth of gaseous only                    1  !
            3062                     !    odtot  - real, optical depth of gas and cloud                   1  !
            3063                     !    gasfac - real, gas-only pade factor, used for planck function   1  !
            3064                     !    totfac - real, gas and cloud pade factor, used for planck fn    1  !
            3065                     !    bbdgas - real, gas-only planck function for downward rt         1  !
            3066                     !    bbugas - real, gas-only planck function for upward rt           1  !
            3067                     !    bbdtot - real, gas and cloud planck function for downward rt    1  !
            3068                     !    bbutot - real, gas and cloud planck function for upward rt      1  !
            3069                     !    gassrcu- real, upwd source radiance due to gas                 nlay!
            3070                     !    totsrcu- real, upwd source radiance due to gas+cld             nlay!
            3071                     !    gassrcd- real, dnwd source radiance due to gas                  1  !
            3072                     !    totsrcd- real, dnwd source radiance due to gas+cld              1  !
            3073                     !    radtotu- real, spectrally summed total sky upwd radiance        1  !
            3074                     !    radclru- real, spectrally summed clear sky upwd radiance        1  !
            3075                     !    radtotd- real, spectrally summed total sky dnwd radiance        1  !
            3076                     !    radclrd- real, spectrally summed clear sky dnwd radiance        1  !
            3077                     !    toturad- real, total sky upward radiance by layer     0:nlay*nbands!
            3078                     !    clrurad- real, clear sky upward radiance by layer     0:nlay*nbands!
            3079                     !    totdrad- real, total sky downward radiance by layer   0:nlay*nbands!
            3080                     !    clrdrad- real, clear sky downward radiance by layer   0:nlay*nbands!
            3081                     !    fnet   - real, net longwave flux (w/m2)                     0:nlay !
            3082                     !    fnetc  - real, clear sky net longwave flux (w/m2)           0:nlay !
            3083                     !                                                                       !
            3084                     !                                                                       !
            3085                     !  *******************************************************************  !
            3086                     !  original code description                                            !
            3087                     !                                                                       !
            3088                     !  original version:   e. j. mlawer, et al. rrtm_v3.0                   !
            3089                     !  revision for gcms:  michael j. iacono; october, 2002                 !
            3090                     !  revision for f90:   michael j. iacono; june, 2006                    !
            3091                     !                                                                       !
            3092                     !  this program calculates the upward fluxes, downward fluxes, and      !
            3093                     !  heating rates for an arbitrary clear or cloudy atmosphere. the input !
            3094                     !  to this program is the atmospheric profile, all planck function      !
            3095                     !  information, and the cloud fraction by layer.  a variable diffusivity!
            3096                     !  angle (secdif) is used for the angle integration. bands 2-3 and 5-9  !
            3097                     !  use a value for secdif that varies from 1.50 to 1.80 as a function   !
            3098                     !  of the column water vapor, and other bands use a value of 1.66.  the !
            3099                     !  gaussian weight appropriate to this angle (wtdiff=0.5) is applied    !
            3100                     !  here.  note that use of the emissivity angle for the flux integration!
            3101                     !  can cause errors of 1 to 4 w/m2 within cloudy layers.                !
            3102                     !  clouds are treated with the mcica stochastic approach and            !
            3103                     !  maximum-random cloud overlap.                                        !
            3104                     !                                                                       !
            3105                     !  *******************************************************************  !
            3106                     !  ======================  end of description block  =================  !
            3107                     
            3108                     !  ---  inputs:
            3109                           integer, intent(in) :: nlay, nlp1
            3110                     
            3111                           real (kind=kind_phys), dimension(nbands), intent(in) :: semiss,   &
            3112                          &       secdif
            3113                           real (kind=kind_phys), dimension(nlay),   intent(in) :: delp
            3114                     
            3115                           real (kind=kind_phys), dimension(nbands,nlay),intent(in):: taucld
            3116                           real (kind=kind_phys), dimension(ngptlw,nlay),intent(in):: fracs, &
            3117                          &       tautot, cldfmc
            3118                     
            3119                           real (kind=kind_phys), dimension(nbands,0:nlay), intent(in) ::    &
            3120                          &       pklev, pklay
            3121                     
            3122                     !  ---  outputs:
            3123                           real (kind=kind_phys), dimension(nlay), intent(out) :: htr, htrcl
            3124                     
            3125                           real (kind=kind_phys), dimension(nlay,nbands),intent(out) :: htrb
            3126                     
            3127                           real (kind=kind_phys), dimension(0:nlay), intent(out) ::          &
            3128                          &       totuflux, totdflux, totuclfl, totdclfl
            3129                     
            3130                     !  ---  locals:
            3131                           real (kind=kind_phys), parameter :: rec_6 = 0.166667
            3132                     
            3133                           real (kind=kind_phys), dimension(0:nlay,nbands) :: clrurad,       &
            3134                          &       clrdrad, toturad, totdrad
            3135                     
            3136                           real (kind=kind_phys), dimension(nlay)   :: gassrcu, totsrcu,     &
            3137                          &       trngas, efclrfr, rfdelp
            3138                           real (kind=kind_phys), dimension(0:nlay) :: fnet, fnetc
            3139                     
            3140                           real (kind=kind_phys) :: totsrcd, gassrcd, tblind, odepth, odtot, &
            3141                          &       odcld, atrtot, atrgas, reflct, totfac, gasfac, flxfac,     &
            3142                          &       plfrac, blay, bbdgas, bbdtot, bbugas, bbutot, dplnku,      &
            3143                          &       dplnkd, radtotu, radclru, radtotd, radclrd, rad0,          &
            3144                          &       clfm, trng, gasu
            3145                     
            3146                           integer :: ittot, itgas, ib, ig, k
            3147                     !
            3148                     !===> ...  begin here
            3149                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrdrad, clrurad, totdrad, toturad
                                   <<< Loop-information  End >>>
            3150     1  pp   2v            do ib = 1, nbands
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<< Loop-information  End >>>
            3151     2   p   2               do k = 0, nlay
            3152     2   p   2v                toturad(k,ib) = f_zero
            3153     2   p   2v                totdrad(k,ib) = f_zero
            3154     2   p   2v                clrurad(k,ib) = f_zero
            3155     2   p   2v                clrdrad(k,ib) = f_zero
            3156     2   p   2v              enddo
            3157     1   p                 enddo
            3158                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      totdclfl, totuclfl, totdflux, totuflux
                                   <<< Loop-information  End >>>
            3159     1  pp   2v            do k = 0, nlay
            3160     1   p   2v              totuflux(k) = f_zero
            3161     1   p   2v              totdflux(k) = f_zero
            3162     1   p   2v              totuclfl(k) = f_zero
            3163     1   p   2v              totdclfl(k) = f_zero
            3164     1   p   2v            enddo
            3165                     
            3166                     !  --- ...  loop over all g-points
            3167                     
            3168     1                     do ig = 1, ngptlw
            3169     1                       ib = ngb(ig)
            3170     1               
            3171     1                       radtotd = f_zero
            3172     1                       radclrd = f_zero
            3173     1               
            3174     1               !  --- ...  downward radiative transfer loop.
            3175     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pklay, pklev, gassrcu, trngas, clrdrad
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3176     2   s    s              do k = nlay, 1, -1
            3177     2               
            3178     2               !  --- ...  clear sky, gases contribution
            3179     2               
            3180     2   p    v                odepth = max( f_zero, secdif(ib)*tautot(ig,k) )
            3181     3   p    s                if (odepth <= 0.06) then
            3182     3   p    s                  atrgas = odepth - 0.5*odepth*odepth
            3183     3   p    s                  trng   = f_one - atrgas
            3184     3   p    s                  gasfac = rec_6 * odepth
            3185     3   p    s                else
            3186     3   p    s                  tblind = odepth / (bpade + odepth)
            3187     3   p    s                  itgas = tblint*tblind + 0.5
            3188     3   p    s                  trng  = exp_tbl(itgas)
            3189     3   p    s                  atrgas = f_one - trng
            3190     3   p    s                  gasfac = tfn_tbl(itgas)
            3191     3   p    s                  odepth = tau_tbl(itgas)
            3192     3   p    v                endif
            3193     2               
            3194     2   p    v                plfrac = fracs(ig,k)
            3195     2   p    v                blay = pklay(ib,k)
            3196     2               
            3197     2   p    v                dplnku = pklev(ib,k  ) - blay
            3198     2   p    v                dplnkd = pklev(ib,k-1) - blay
            3199     2   p    v                bbdgas = plfrac * (blay + dplnkd*gasfac)
            3200     2   p    v                bbugas = plfrac * (blay + dplnku*gasfac)
            3201     2   p    v                gassrcd= bbdgas * atrgas
            3202     2   p    v                gassrcu(k)= bbugas * atrgas
            3203     2   p    v                trngas(k) = trng
            3204     2               
            3205     2               !  --- ...  total sky, gases+clouds contribution
            3206     2               
            3207     2   p    v                clfm = cldfmc(ig,k)
            3208     3   p    s                if (clfm >= eps) then
            3209     3               !  --- ...  cloudy layer
            3210     3               
            3211     3   p    s                  odcld = secdif(ib) * taucld(ib,k)
            3212     3   p    s                  efclrfr(k) = f_one - (f_one - exp(-odcld))*clfm
            3213     3   p    s                  odtot = odepth + odcld
            3214     4   p    s                  if (odtot < 0.06) then
            3215     4   p    s                    totfac = rec_6 * odtot
            3216     4   p    s                    atrtot = odtot - 0.5*odtot*odtot
            3217     4   p    s                  else
            3218     4   p    s                    tblind = odtot / (bpade + odtot)
            3219     4   p    s                    ittot  = tblint*tblind + 0.5
            3220     4   p    s                    totfac = tfn_tbl(ittot)
            3221     4   p    s                    atrtot = f_one - exp_tbl(ittot)
            3222     4   p    s                  endif
            3223     3               
            3224     3   p    s                  bbdtot = plfrac * (blay + dplnkd*totfac)
            3225     3   p    s                  bbutot = plfrac * (blay + dplnku*totfac)
            3226     3   p    s                  totsrcd= bbdtot * atrtot
            3227     3   p    s                  totsrcu(k)= bbutot * atrtot
            3228     3               
            3229     3               !  --- ...  total sky radiance
            3230     3   m    s                  radtotd = radtotd*trng*efclrfr(k) + gassrcd                 &
            3231     3                    &              + clfm*(totsrcd - gassrcd)
            3232     3   s    s                  totdrad(k-1,ib) = totdrad(k-1,ib) + radtotd
            3233     3               
            3234     3               !  --- ...  clear sky radiance
            3235     3   s    s                  radclrd = radclrd*trng + gassrcd
            3236     3   m    s                  clrdrad(k-1,ib) = clrdrad(k-1,ib) + radclrd
            3237     3               
            3238     3   p    s                else
            3239     3               !  --- ...  clear layer
            3240     3               
            3241     3               !  --- ...  total sky radiance
            3242     3   s    s                  radtotd = radtotd*trng + gassrcd
            3243     3   s    s                  totdrad(k-1,ib) = totdrad(k-1,ib) + radtotd
            3244     3               
            3245     3               !  --- ...  clear sky radiance
            3246     3   s    s                  radclrd = radclrd*trng + gassrcd
            3247     3   m    s                  clrdrad(k-1,ib) = clrdrad(k-1,ib) + radclrd
            3248     3               
            3249     3   p    v                endif   ! end if_clfm_block
            3250     2               
            3251     2   p    v              enddo   ! end do_k_loop
            3252     1               
            3253     1               !  --- ...  spectral emissivity & reflectance
            3254     1               !           include the contribution of spectrally varying longwave emissivity
            3255     1               !           and reflection from the surface to the upward radiative transfer.
            3256     1               !     note: spectral and lambertian reflection are identical for the
            3257     1               !           diffusivity angle flux integration used here.
            3258     1               
            3259     1                       reflct = f_one - semiss(ib)
            3260     1                       rad0 = semiss(ib) * fracs(ig,1) * pklay(ib,0)
            3261     1               
            3262     1               !  --- ... total sky radiance
            3263     1                       radtotu = rad0 + reflct*radtotd
            3264     1                       toturad(0,ib) = toturad(0,ib) + radtotu
            3265     1               
            3266     1               !  --- ... clear sky radiance
            3267     1                       radclru = rad0 + reflct*radclrd
            3268     1                       clrurad(0,ib) = clrurad(0,ib) + radclru
            3269     1               
            3270     1               !  --- ...  upward radiative transfer
            3271     1               !          toturad holds summed radiance for total sky stream
            3272     1               !          clrurad holds summed radiance for clear sky stream
            3273     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      trngas, gassrcu, toturad, clrurad
                                   <<< Loop-information  End >>>
            3274     2   s    s              do k = 1, nlay
            3275     2   p    v                clfm = cldfmc(ig,k)
            3276     2   s    s                trng = trngas(k)
            3277     2   p    v                gasu = gassrcu(k)
            3278     2               
            3279     3   p    v                if (clfm > eps) then
            3280     3               !  --- ...  cloudy layer
            3281     3               
            3282     3               !  --- ... total sky radiance
            3283     3   m    m                  radtotu = radtotu*trng*efclrfr(k) + gasu                    &
            3284     3                    &              + clfm*(totsrcu(k) - gasu)
            3285     3   s    s                  toturad(k,ib) = toturad(k,ib) + radtotu
            3286     3               
            3287     3               !  --- ... clear sky radiance
            3288     3   s    s                  radclru = radclru*trng + gasu
            3289     3   m    m                  clrurad(k,ib) = clrurad(k,ib) + radclru
            3290     3               
            3291     3   p    v                else
            3292     3               !  --- ...  clear layer
            3293     3               
            3294     3               !  --- ... total sky radiance
            3295     3   s    s                  radtotu = radtotu*trng + gasu
            3296     3   s    s                  toturad(k,ib) = toturad(k,ib) + radtotu
            3297     3               
            3298     3               !  --- ... clear sky radiance
            3299     3   s    s                  radclru = radclru*trng + gasu
            3300     3   m    s                  clrurad(k,ib) = clrurad(k,ib) + radclru
            3301     3               
            3302     3   p    v                endif   ! end if_clfm_block
            3303     2               
            3304     2   p    v              enddo   ! end do_k_loop
            3305     1               
            3306     1                     enddo   ! end do_ig_loop
            3307                     
            3308                     !  --- ...  process longwave output from band for total and clear streams.
            3309                     !           calculate upward, downward, and net flux.
            3310                     
            3311                           flxfac = wtdiff * fluxfac
            3312                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 485
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 72, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrurad, totuclfl, totdclfl, totdrad
                                   <<<      totdflux, toturad, totuflux, clrdrad
                                   <<< Loop-information  End >>>
            3313     1  pp    v            do k = 0, nlay
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      clrdrad, totdclfl, clrurad, totuclfl
                                   <<<      totdrad, totdflux, toturad, totuflux
                                   <<< Loop-information  End >>>
            3314     2                       do ib = 1, nbands
            3315     2   p    v                totuflux(k) = totuflux(k) + toturad(k,ib)
            3316     2   p    v                totdflux(k) = totdflux(k) + totdrad(k,ib)
            3317     2   p    v                totuclfl(k) = totuclfl(k) + clrurad(k,ib)
            3318     2   p    v                totdclfl(k) = totdclfl(k) + clrdrad(k,ib)
            3319     2   p    v              enddo
            3320     1               
            3321     1   p    v              totuflux(k) = totuflux(k) * flxfac
            3322     1   p    v              totdflux(k) = totdflux(k) * flxfac
            3323     1   p    v              totuclfl(k) = totuclfl(k) * flxfac
            3324     1   p    v              totdclfl(k) = totdclfl(k) * flxfac
            3325     1   p    v            enddo
            3326                     
            3327                     !  --- ...  calculate net fluxes and heating rates
            3328                           fnet(0) = totuflux(0) - totdflux(0)
            3329                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.39, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fnet, delp, totuflux, totdflux, htr
                                   <<<      rfdelp
                                   <<< Loop-information  End >>>
            3330     1   s    v            do k = 1, nlay
            3331     1   p    v              rfdelp(k) = heatfac / delp(k)
            3332     1   m    v              fnet(k) = totuflux(k) - totdflux(k)
            3333     1   m    v              htr (k) = (fnet(k-1) - fnet(k)) * rfdelp(k)
            3334     1   p    v            enddo
            3335                     
            3336                     !! --- ...  optional clear sky heating rates
            3337     1                     if ( lhlw0 ) then
            3338     1                       fnetc(0) = totuclfl(0) - totdclfl(0)
            3339     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.85, ITR: 104, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rfdelp, fnetc, totdclfl, totuclfl, htrcl
                                   <<< Loop-information  End >>>
            3340     2   s    v              do k = 1, nlay
            3341     2   m    v                fnetc(k) = totuclfl(k) - totdclfl(k)
            3342     2   m    v                htrcl(k) = (fnetc(k-1) - fnetc(k)) * rfdelp(k)
            3343     2   p    v              enddo
            3344     1                     endif
            3345                     
            3346                     !! --- ...  optional spectral band heating rates
            3347     1                     if ( lhlwb ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      totdrad, toturad, fnet, rfdelp, htrb
                                   <<< Loop-information  End >>>
            3348     2                       do ib = 1, nbands
            3349     2                         fnet(0) = (toturad(0,ib) - totdrad(0,ib)) * flxfac
            3350     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 136, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fnet, rfdelp, totdrad, toturad, htrb
                                   <<< Loop-information  End >>>
            3351     3   s    v                do k = 1, nlay
            3352     3   m    v                  fnet(k) = (toturad(k,ib) - totdrad(k,ib)) * flxfac
            3353     3   m    v                  htrb(k,ib) = (fnet(k-1) - fnet(k)) * rfdelp(k)
            3354     3   p    v                enddo
            3355     2                       enddo
            3356     1                     endif
            3357                     
            3358                     ! ..................................
            3359                           end subroutine rtrnmc
            3360                     ! ----------------------------------
            3361                     
            3362                     
            3363                     ! ----------------------------------
            3364                           subroutine taumol                                                 &
            3365                     ! ..................................
            3366                     !  ---  inputs:
            3367                          &     ( laytrop,pavel,coldry,colamt,colbrd,wx,tauaer,              &
            3368                          &       rfrate,fac00,fac01,fac10,fac11,jp,jt,jt1,                  &
            3369                          &       selffac,selffrac,indself,forfac,forfrac,indfor,            &
            3370                          &       minorfrac,scaleminor,scaleminorn2,indminor,                &
            3371                          &       nlay,                                                      &
            3372                     !  ---  outputs:
            3373                          &       fracs, tautot                                              &
            3374                          &     )
            3375                     
            3376                     !  ************    original subprogram description    ***************   !
            3377                     !                                                                       !
            3378                     !                  optical depths developed for the                     !
            3379                     !                                                                       !
            3380                     !                rapid radiative transfer model (rrtm)                  !
            3381                     !                                                                       !
            3382                     !            atmospheric and environmental research, inc.               !
            3383                     !                        131 hartwell avenue                            !
            3384                     !                        lexington, ma 02421                            !
            3385                     !                                                                       !
            3386                     !                           eli j. mlawer                               !
            3387                     !                         jennifer delamere                             !
            3388                     !                         steven j. taubman                             !
            3389                     !                         shepard a. clough                             !
            3390                     !                                                                       !
            3391                     !                       email:  mlawer@aer.com                          !
            3392                     !                       email:  jdelamer@aer.com                        !
            3393                     !                                                                       !
            3394                     !        the authors wish to acknowledge the contributions of the       !
            3395                     !        following people:  karen cady-pereira, patrick d. brown,       !
            3396                     !        michael j. iacono, ronald e. farren, luke chen,                !
            3397                     !        robert bergstrom.                                              !
            3398                     !                                                                       !
            3399                     !  revision for g-point reduction: michael j. iacono; aer, inc.         !
            3400                     !                                                                       !
            3401                     !     taumol                                                            !
            3402                     !                                                                       !
            3403                     !     this file contains the subroutines taugbn (where n goes from      !
            3404                     !     1 to 16).  taugbn calculates the optical depths and planck        !
            3405                     !     fractions per g-value and layer for band n.                       !
            3406                     !                                                                       !
            3407                     !  *******************************************************************  !
            3408                     !  ==================   program usage description   ==================  !
            3409                     !                                                                       !
            3410                     !    call  taumol                                                       !
            3411                     !       inputs:                                                         !
            3412                     !          ( laytrop,pavel,coldry,colamt,colbrd,wx,tauaer,              !
            3413                     !            rfrate,fac00,fac01,fac10,fac11,jp,jt,jt1,                  !
            3414                     !            selffac,selffrac,indself,forfac,forfrac,indfor,            !
            3415                     !            minorfrac,scaleminor,scaleminorn2,indminor,                !
            3416                     !            nlay,                                                      !
            3417                     !       outputs:                                                        !
            3418                     !            fracs, tautot )                                            !
            3419                     !                                                                       !
            3420                     !  subprograms called:  taugb## (## = 01 -16)                           !
            3421                     !                                                                       !
            3422                     !                                                                       !
            3423                     !  ====================  defination of variables  ====================  !
            3424                     !                                                                       !
            3425                     !  inputs:                                                        size  !
            3426                     !     laytrop   - integer, tropopause layer index (unitless)        1   !
            3427                     !                   layer at which switch is made for key species       !
            3428                     !     pavel     - real, layer pressures (mb)                       nlay !
            3429                     !     coldry    - real, column amount for dry air (mol/cm2)        nlay !
            3430                     !     colamt    - real, column amounts of h2o, co2, o3, n2o, ch4,       !
            3431                     !                   o2, co (mol/cm**2)                       nlay*maxgas!
            3432                     !     colbrd    - real, column amount of broadening gases          nlay !
            3433                     !     wx        - real, cross-section amounts(mol/cm2)      nlay*maxxsec!
            3434                     !     tauaer    - real, aerosol optical depth               nbands*nlay !
            3435                     !     rfrate    - real, reference ratios of binary species parameter    !
            3436                     !     (:,m,:)m=1-h2o/co2,2-h2o/o3,3-h2o/n2o,4-h2o/ch4,5-n2o/co2,6-o3/co2!
            3437                     !     (:,:,n)n=1,2: the rates of ref press at the 2 sides of the layer  !
            3438                     !                                                          nlay*nrates*2!
            3439                     !     facij     - real, factors multiply the reference ks, i,j of 0/1   !
            3440                     !                   for lower/higher of the 2 appropriate temperatures  !
            3441                     !                   and altitudes                                  nlay !
            3442                     !     jp        - real, index of lower reference pressure          nlay !
            3443                     !     jt, jt1   - real, indices of lower reference temperatures    nlay !
            3444                     !                   for pressure levels jp and jp+1, respectively       !
            3445                     !     selffac   - real, scale factor for water vapor self-continuum     !
            3446                     !                   equals (water vapor density)/(atmospheric density   !
            3447                     !                   at 296k and 1013 mb)                           nlay !
            3448                     !     selffrac  - real, factor for temperature interpolation of         !
            3449                     !                   reference water vapor self-continuum data      nlay !
            3450                     !     indself   - integer, index of lower reference temperature for     !
            3451                     !                   the self-continuum interpolation               nlay !
            3452                     !     forfac    - real, scale factor for w. v. foreign-continuum   nlay !
            3453                     !     forfrac   - real, factor for temperature interpolation of         !
            3454                     !                   reference w.v. foreign-continuum data          nlay !
            3455                     !     indfor    - integer, index of lower reference temperature for     !
            3456                     !                   the foreign-continuum interpolation            nlay !
            3457                     !     minorfrac - real, factor for minor gases                     nlay !
            3458                     !     scaleminor,scaleminorn2                                           !
            3459                     !               - real, scale factors for minor gases              nlay !
            3460                     !     indminor  - integer, index of lower reference temperature for     !
            3461                     !                   minor gases                                    nlay !
            3462                     !     nlay      - integer, total number of layers                   1   !
            3463                     !                                                                       !
            3464                     !  outputs:                                                             !
            3465                     !     fracs     - real, planck fractions                     ngptlw,nlay!
            3466                     !     tautot    - real, total optical depth (gas+aerosols)   ngptlw,nlay!
            3467                     !                                                                       !
            3468                     !  internal variables:                                                  !
            3469                     !     ng##      - integer, number of g-values in band ## (##=01-16) 1   !
            3470                     !     nspa      - integer, for lower atmosphere, the number of ref      !
            3471                     !                   atmos, each has different relative amounts of the   !
            3472                     !                   key species for the band                      nbands!
            3473                     !     nspb      - integer, same but for upper atmosphere          nbands!
            3474                     !     absa      - real, k-values for lower ref atmospheres (no w.v.     !
            3475                     !                   self-continuum) (cm**2/molecule)  nspa(##)*5*13*ng##!
            3476                     !     absb      - real, k-values for high ref atmospheres (all sources) !
            3477                     !                   (cm**2/molecule)               nspb(##)*5*13:59*ng##!
            3478                     !     ka_m'mgas'- real, k-values for low ref atmospheres minor species  !
            3479                     !                   (cm**2/molecule)                          mmn##*ng##!
            3480                     !     kb_m'mgas'- real, k-values for high ref atmospheres minor species !
            3481                     !                   (cm**2/molecule)                          mmn##*ng##!
            3482                     !     selfref   - real, k-values for w.v. self-continuum for ref atmos  !
            3483                     !                   used below laytrop (cm**2/mol)               10*ng##!
            3484                     !     forref    - real, k-values for w.v. foreign-continuum for ref atmos
            3485                     !                   used below/above laytrop (cm**2/mol)          4*ng##!
            3486                     !                                                                       !
            3487                     !  ******************************************************************   !
            3488                     
            3489                     !  ---  inputs:
            3490                           integer, intent(in) :: nlay, laytrop
            3491                     
            3492                           integer, dimension(nlay), intent(in) :: jp, jt, jt1, indself,     &
            3493                          &       indfor, indminor
            3494                     
            3495                           real (kind=kind_phys), dimension(nlay), intent(in) :: pavel,      &
            3496                          &       coldry, colbrd, fac00, fac01, fac10, fac11, selffac,       &
            3497                          &       selffrac, forfac, forfrac, minorfrac, scaleminor,          &
            3498                          &       scaleminorn2
            3499                     
            3500                           real (kind=kind_phys), dimension(nlay,maxgas), intent(in):: colamt
            3501                           real (kind=kind_phys), dimension(nlay,maxxsec),intent(in):: wx
            3502                     
            3503                           real (kind=kind_phys), dimension(nbands,nlay), intent(in):: tauaer
            3504                     
            3505                           real (kind=kind_phys), dimension(nlay,nrates,2), intent(in) ::    &
            3506                          &       rfrate
            3507                     
            3508                     !  ---  outputs:
            3509                           real (kind=kind_phys), dimension(ngptlw,nlay), intent(out) ::     &
            3510                          &       fracs, tautot
            3511                     
            3512                     !  ---  locals
            3513                           real (kind=kind_phys), dimension(ngptlw,nlay) :: taug
            3514                     
            3515                           integer :: ib, ig, k
            3516                     !
            3517                     !===> ...  begin here
            3518                     !
            3519                           call taugb01
            3520                           call taugb02
            3521                           call taugb03
            3522                           call taugb04
            3523                           call taugb05
            3524                           call taugb06
            3525                           call taugb07
            3526                           call taugb08
            3527                           call taugb09
            3528                           call taugb10
            3529                           call taugb11
            3530                           call taugb12
            3531                           call taugb13
            3532                           call taugb14
            3533                           call taugb15
            3534                           call taugb16
            3535                     
            3536                     !  ---  combine gaseous and aerosol optical depths
            3537                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    SIMD(VL: 8,16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.12, ITR: 128, MVE: 3, POL: S)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3538     1   p   fv            do ig = 1, ngptlw
            3539     1   p   fv              ib = ngb(ig)
            3540     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      taug, tautot, (unknown)
                                   <<< Loop-information  End >>>
            3541     2  pp   f               do k = 1, nlay
            3542     2   p   fv                tautot(ig,k) = taug(ig,k) + tauaer(ib,k)
            3543     2   p   f               enddo
            3544     1   p   fv            enddo
            3545                     
            3546                     ! =================
            3547                           contains
            3548                     ! =================
            3549                     
            3550                     ! ----------------------------------
            3551                           subroutine taugb01
            3552                     ! ..................................
            3553                     
            3554                     !  ------------------------------------------------------------------  !
            3555                     !  written by eli j. mlawer, atmospheric & environmental research.     !
            3556                     !  revised by michael j. iacono, atmospheric & environmental research. !
            3557                     !                                                                      !
            3558                     !     band 1:  10-350 cm-1 (low key - h2o; low minor - n2)             !
            3559                     !                          (high key - h2o; high minor - n2)           !
            3560                     !                                                                      !
            3561                     !  compute the optical depth by interpolating in ln(pressure) and      !
            3562                     !  temperature.  below laytrop, the water vapor self-continuum and     !
            3563                     !  foreign continuum is interpolated (in temperature) separately.      !
            3564                     !  ------------------------------------------------------------------  !
            3565                     
            3566                           use module_radlw_kgb01
            3567                     
            3568                     !  ---  locals:
            3569                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            3570                          &           indm, indmp, ig
            3571                     
            3572                           real (kind=kind_phys) :: pp, corradj, scalen2, tauself, taufor,   &
            3573                          &       taun2
            3574                     !
            3575                     !===> ...  begin here
            3576                     !
            3577                     !  ---  minor gas mapping levels:
            3578                     !     lower - n2, p = 142.5490 mbar, t = 215.70 k
            3579                     !     upper - n2, p = 142.5490 mbar, t = 215.70 k
            3580                     
            3581                     !  --- ...  lower atmosphere loop
            3582                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      colbrd, scaleminorn2, jt1, jp, pavel
                                   <<<      indself, jt, indfor, indminor, fac00
                                   <<<      fac10, selffrac, forfrac, selffac
                                   <<<      forfac, minorfrac
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      colamt: 2, fac11: 2, fac01: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 14
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3583     1  pp                 do k = 1, laytrop
            3584     1   p                   ind0 = ((jp(k)-1)*5 + (jt (k)-1)) * nspa(1) + 1
            3585     1   p                   ind1 = ( jp(k)   *5 + (jt1(k)-1)) * nspa(1) + 1
            3586     1   p                   inds = indself(k)
            3587     1   p                   indf = indfor(k)
            3588     1   p                   indm = indminor(k)
            3589     1               
            3590     1   p                   ind0p = ind0 + 1
            3591     1   p                   ind1p = ind1 + 1
            3592     1   p                   indsp = inds + 1
            3593     1   p                   indfp = indf + 1
            3594     1   p                   indmp = indm + 1
            3595     1               
            3596     1   p                   pp = pavel(k)
            3597     1   p                   scalen2 = colbrd(k) * scaleminorn2(k)
            3598     2   p                   if (pp < 250.0) then
            3599     2   p                     corradj = f_one - 0.15 * (250.0-pp) / 154.4
            3600     2   p                   else
            3601     2   p                     corradj = f_one
            3602     2   p                   endif
            3603     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3604     2   p    v              do ig = 1, ng01
            3605     2   p    v                tauself = selffac(k) * (selfref(ig,inds) + selffrac(k)        &
            3606     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            3607     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            3608     2                    &            * (forref(ig,indfp) -  forref(ig,indf)))
            3609     2   p    v                taun2   = scalen2 * (ka_mn2(ig,indm) + minorfrac(k)           &
            3610     2                    &            * (ka_mn2(ig,indmp) - ka_mn2(ig,indm)))
            3611     2               
            3612     2   p    v                taug(ig,k) = corradj * (colamt(k,1)                           &
            3613     2                    &            * (fac00(k)*absa(ig,ind0) + fac10(k)*absa(ig,ind0p)   &
            3614     2                    &            +  fac01(k)*absa(ig,ind1) + fac11(k)*absa(ig,ind1p))  &
            3615     2                    &            + tauself + taufor + taun2)
            3616     2               
            3617     2   p    v                fracs(ig,k) = fracrefa(ig)
            3618     2   p    v              enddo
            3619     1   p                 enddo
            3620                     
            3621                     !  --- ...  upper atmosphere loop
            3622                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 12
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      jt, colbrd, jp, forfrac, jt1, pavel
                                   <<<      fac01, indfor, fac00, scaleminorn2
                                   <<<      forfac, indminor, colamt, fac11, fac10
                                   <<<      minorfrac
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 11
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3623     1  pp                 do k = laytrop+1, nlay
            3624     1   p                   ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(1) + 1
            3625     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(1) + 1
            3626     1   p                   indf = indfor(k)
            3627     1   p                   indm = indminor(k)
            3628     1               
            3629     1   p                   ind0p = ind0 + 1
            3630     1   p                   ind1p = ind1 + 1
            3631     1   p                   indfp = indf + 1
            3632     1   p                   indmp = indm + 1
            3633     1               
            3634     1   p                   scalen2 = colbrd(k) * scaleminorn2(k)
            3635     1   p                   corradj = f_one - 0.15 * (pavel(k) / 95.6)
            3636     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3637     2   p    v              do ig = 1, ng01
            3638     2   p    v                taufor = forfac(k) * (forref(ig,indf) + forfrac(k)            &
            3639     2                    &           * (forref(ig,indfp) - forref(ig,indf)))
            3640     2   p    v                taun2  = scalen2 * (kb_mn2(ig,indm) + minorfrac(k)            &
            3641     2                    &           * (kb_mn2(ig,indmp) - kb_mn2(ig,indm)))
            3642     2               
            3643     2   p    v                taug(ig,k) = corradj * (colamt(k,1)                           &
            3644     2                    &           * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)    &
            3645     2                    &           +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))   &
            3646     2                    &           + taufor + taun2)
            3647     2               
            3648     2   p    v                fracs(ig,k) = fracrefb(ig)
            3649     2   p    v              enddo
            3650     1   p                 enddo
            3651                     
            3652                     ! ..................................
            3653                           end subroutine taugb01
            3654                     ! ----------------------------------
            3655                     
            3656                     ! ----------------------------------
            3657                           subroutine taugb02
            3658                     ! ..................................
            3659                     
            3660                     !  ------------------------------------------------------------------  !
            3661                     !     band 2:  350-500 cm-1 (low key - h2o; high key - h2o)            !
            3662                     !  ------------------------------------------------------------------  !
            3663                     
            3664                           use module_radlw_kgb02
            3665                     
            3666                     !  ---  locals:
            3667                           integer :: k, ind0, ind0p, ind1, ind1p, inds, indsp, indf, indfp, &
            3668                          &           ig
            3669                     
            3670                           real (kind=kind_phys) :: corradj, tauself, taufor
            3671                     !
            3672                     !===> ...  begin here
            3673                     !
            3674                     !  --- ...  lower atmosphere loop
            3675                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      selffrac, selffac, indself, jt1, pavel
                                   <<<      jp, fac00, colamt, fac01, jt, indfor
                                   <<<      forfrac, forfac, fac10, fac11
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 9
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3676     1  pp                 do k = 1, laytrop
            3677     1   p                   ind0 = ((jp(k)-1)*5 + (jt (k)-1)) * nspa(2) + 1
            3678     1   p                   ind1 = ( jp(k)   *5 + (jt1(k)-1)) * nspa(2) + 1
            3679     1   p                   inds = indself(k)
            3680     1   p                   indf = indfor(k)
            3681     1               
            3682     1   p                   ind0p = ind0 + 1
            3683     1   p                   ind1p = ind1 + 1
            3684     1   p                   indsp = inds + 1
            3685     1   p                   indfp = indf + 1
            3686     1               
            3687     1   p                   corradj = f_one - 0.05 * (pavel(k) - 100.0) / 900.0
            3688     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3689     2   p    v              do ig = 1, ng02
            3690     2   p    v                tauself = selffac(k) * (selfref(ig,inds) + selffrac(k)        &
            3691     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            3692     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            3693     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            3694     2               
            3695     2   p    v                taug(ns02+ig,k) = corradj * (colamt(k,1)                      &
            3696     2                    &            * (fac00(k)*absa(ig,ind0) + fac10(k)*absa(ig,ind0p)   &
            3697     2                    &            +  fac01(k)*absa(ig,ind1) + fac11(k)*absa(ig,ind1p))  &
            3698     2                    &            + tauself + taufor)
            3699     2               
            3700     2   p    v                fracs(ns02+ig,k) = fracrefa(ig)
            3701     2   p    v              enddo
            3702     1   p                 enddo
            3703                     
            3704                     !  --- ...  upper atmosphere loop
            3705                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 13
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 1.72, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      fac00, fac01, indfor, fac10, fac11
                                   <<<      forfrac, colamt, forfac, jp, jt, jt1
                                   <<< Loop-information  End >>>
            3706     1  pp                 do k = laytrop+1, nlay
            3707     1   p                   ind0 = ((jp(k)-13)*5 + (jt (k)-1)) * nspb(2) + 1
            3708     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(2) + 1
            3709     1   p                   indf = indfor(k)
            3710     1               
            3711     1   p                   ind0p = ind0 + 1
            3712     1   p                   ind1p = ind1 + 1
            3713     1   p                   indfp = indf + 1
            3714     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3715     2   p    v              do ig = 1, ng02
            3716     2   p    v                taufor = forfac(k) * (forref(ig,indf) + forfrac(k)            &
            3717     2                    &           * (forref(ig,indfp) - forref(ig,indf)))
            3718     2               
            3719     2   p    v                taug(ns02+ig,k) = colamt(k,1)                                 &
            3720     2                    &           * (fac00(k)*absb(ig,ind0) + fac10(k)*absb(ig,ind0p)    &
            3721     2                    &           +  fac01(k)*absb(ig,ind1) + fac11(k)*absb(ig,ind1p))   &
            3722     2                    &           + taufor
            3723     2               
            3724     2   p    v                fracs(ns02+ig,k) = fracrefb(ig)
            3725     2   p    v              enddo
            3726     1   p                 enddo
            3727                     
            3728                     ! ..................................
            3729                           end subroutine taugb02
            3730                     ! ----------------------------------
            3731                     
            3732                     ! ----------------------------------
            3733                           subroutine taugb03
            3734                     ! ..................................
            3735                     
            3736                     !  ------------------------------------------------------------------  !
            3737                     !     band 3:  500-630 cm-1 (low key - h2o,co2; low minor - n2o)       !
            3738                     !                           (high key - h2o,co2; high minor - n2o)     !
            3739                     !  ------------------------------------------------------------------  !
            3740                     
            3741                           use module_radlw_kgb03
            3742                     
            3743                     !  ---  locals:
            3744                           integer :: k, ind0, ind1, inds, indsp, indf, indfp, indm, indmp,  &
            3745                          &       id000, id010, id100, id110, id200, id210, jmn2o, jmn2op,   &
            3746                          &       id001, id011, id101, id111, id201, id211, jpl, jplp,       &
            3747                          &       ig, js, js1
            3748                     
            3749                           real (kind=kind_phys) ::  absn2o, ratn2o, adjfac, adjcoln2o,      &
            3750                          &      speccomb,       specparm,       specmult,       fs,         &
            3751                          &      speccomb1,      specparm1,      specmult1,      fs1,        &
            3752                          &      speccomb_mn2o,  specparm_mn2o,  specmult_mn2o,  fmn2o,      &
            3753                          &      speccomb_planck,specparm_planck,specmult_planck,fpl,        &
            3754                          &      refrat_planck_a, refrat_planck_b, refrat_m_a, refrat_m_b,   &
            3755                          &      fac000, fac100, fac200, fac010, fac110, fac210,             &
            3756                          &      fac001, fac101, fac201, fac011, fac111, fac211,             &
            3757                          &      tau_major, tau_major1, tauself, taufor, n2om1, n2om2,       &
            3758                          &      p, p4, fk0, fk1, fk2
            3759                     !
            3760                     !===> ...  begin here
            3761                     !
            3762                     !  --- ...  minor gas mapping levels:
            3763                     !     lower - n2o, p = 706.272 mbar, t = 278.94 k
            3764                     !     upper - n2o, p = 95.58 mbar, t = 215.7 k
            3765                     
            3766                           refrat_planck_a = chi_mls(1,9)/chi_mls(2,9)    ! p = 212.725 mb
            3767                           refrat_planck_b = chi_mls(1,13)/chi_mls(2,13)  ! p = 95.58   mb
            3768                           refrat_m_a      = chi_mls(1,3)/chi_mls(2,3)    ! p = 706.270 mb
            3769                           refrat_m_b      = chi_mls(1,13)/chi_mls(2,13)  ! p = 95.58   mb
            3770                     
            3771                     !  --- ...  lower atmosphere loop
            3772                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rfrate, colamt, jt, jp, coldry, jt1
                                   <<<      indself, indfor, indminor, fac00, fac10
                                   <<<      fac01, fac11
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      selffrac: 2, selffac: 2, forfrac: 2
                                   <<<      forfac: 2, minorfrac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 15  FILL 41
                                   <<<      SIMD&FP   : SPILL 2  FILL 5
                                   <<<      SCALABLE  : SPILL 3  FILL 3
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3773     1  pp                 do k = 1, laytrop
            3774     1   p                   speccomb = colamt(k,1) + rfrate(k,1,1)*colamt(k,2)
            3775     1   p                   specparm = colamt(k,1) / speccomb
            3776     1   p                   specmult = 8.0 * min(specparm, oneminus)
            3777     1   p                   js = 1 + int(specmult)
            3778     1   p                   fs = mod(specmult, f_one)
            3779     1   p                   ind0 = ((jp(k)-1)*5 + (jt(k)-1)) * nspa(3) + js
            3780     1               
            3781     1   p                   speccomb1 = colamt(k,1) + rfrate(k,1,2)*colamt(k,2)
            3782     1   p                   specparm1 = colamt(k,1) / speccomb1
            3783     1   p                   specmult1 = 8.0 * min(specparm1, oneminus)
            3784     1   p                   js1 = 1 + int(specmult1)
            3785     1   p                   fs1 = mod(specmult1, f_one)
            3786     1   p                   ind1 = (jp(k)*5 + (jt1(k)-1)) * nspa(3) + js1
            3787     1               
            3788     1   p                   speccomb_mn2o = colamt(k,1) + refrat_m_a*colamt(k,2)
            3789     1   p                   specparm_mn2o = colamt(k,1) / speccomb_mn2o
            3790     1   p                   specmult_mn2o = 8.0 * min(specparm_mn2o, oneminus)
            3791     1   p                   jmn2o = 1 + int(specmult_mn2o)
            3792     1   p                   fmn2o = mod(specmult_mn2o, f_one)
            3793     1               
            3794     1   p                   speccomb_planck = colamt(k,1) + refrat_planck_a*colamt(k,2)
            3795     1   p                   specparm_planck = colamt(k,1) / speccomb_planck
            3796     1   p                   specmult_planck = 8.0 * min(specparm_planck, oneminus)
            3797     1   p                   jpl = 1 + int(specmult_planck)
            3798     1   p                   fpl = mod(specmult_planck, f_one)
            3799     1               
            3800     1   p                   inds = indself(k)
            3801     1   p                   indf = indfor(k)
            3802     1   p                   indm = indminor(k)
            3803     1   p                   indsp = inds + 1
            3804     1   p                   indfp = indf + 1
            3805     1   p                   indmp = indm + 1
            3806     1   p                   jmn2op= jmn2o+ 1
            3807     1   p                   jplp  = jpl  + 1
            3808     1               
            3809     1               !  --- ...  in atmospheres where the amount of n2o is too great to be considered
            3810     1               !           a minor species, adjust the column amount of n2o by an empirical factor
            3811     1               !           to obtain the proper contribution.
            3812     1               
            3813     1   p                   p = coldry(k) * chi_mls(4,jp(k)+1)
            3814     1   p                   ratn2o = colamt(k,4) / p
            3815     2   p                   if (ratn2o > 1.5) then
            3816     2   p                     adjfac = 0.5 + (ratn2o - 0.5)**0.65
            3817     2   p                     adjcoln2o = adjfac * p
            3818     2   p                   else
            3819     2   p                     adjcoln2o = colamt(k,4)
            3820     2   p                   endif
            3821     1               
            3822     2   p                   if (specparm < 0.125) then
            3823     2   p                     p = fs - f_one
            3824     2   p                     p4 = p**4
            3825     2   p                     fk0 = p4
            3826     2   p                     fk1 = f_one - p - 2.0*p4
            3827     2   p                     fk2 = p + p4
            3828     2   p                     id000 = ind0
            3829     2   p                     id010 = ind0 + 9
            3830     2   p                     id100 = ind0 + 1
            3831     2   p                     id110 = ind0 +10
            3832     2   p                     id200 = ind0 + 2
            3833     2   p                     id210 = ind0 +11
            3834     2   p                   else if (specparm > 0.875) then
            3835     2   p                     p = -fs
            3836     2   p                     p4 = p**4
            3837     2   p                     fk0 = p4
            3838     2   p                     fk1 = f_one - p - 2.0*p4
            3839     2   p                     fk2 = p + p4
            3840     2   p                     id000 = ind0 + 1
            3841     2   p                     id010 = ind0 +10
            3842     2   p                     id100 = ind0
            3843     2   p                     id110 = ind0 + 9
            3844     2   p                     id200 = ind0 - 1
            3845     2   p                     id210 = ind0 + 8
            3846     2   p                   else
            3847     2   p                     fk0 = f_one - fs
            3848     2   p                     fk1 = fs
            3849     2   p                     fk2 = f_zero
            3850     2   p                     id000 = ind0
            3851     2   p                     id010 = ind0 + 9
            3852     2   p                     id100 = ind0 + 1
            3853     2   p                     id110 = ind0 +10
            3854     2   p                     id200 = ind0
            3855     2   p                     id210 = ind0
            3856     2   p                   endif
            3857     1               
            3858     1   p                   fac000 = fk0*fac00(k)
            3859     1   p                   fac100 = fk1*fac00(k)
            3860     1   p                   fac200 = fk2*fac00(k)
            3861     1   p                   fac010 = fk0*fac10(k)
            3862     1   p                   fac110 = fk1*fac10(k)
            3863     1   p                   fac210 = fk2*fac10(k)
            3864     1               
            3865     2   p                   if (specparm1 < 0.125) then
            3866     2   p                     p = fs1 - f_one
            3867     2   p                     p4 = p**4
            3868     2   p                     fk0 = p4
            3869     2   p                     fk1 = f_one - p - 2.0*p4
            3870     2   p                     fk2 = p + p4
            3871     2   p                     id001 = ind1
            3872     2   p                     id011 = ind1 + 9
            3873     2   p                     id101 = ind1 + 1
            3874     2   p                     id111 = ind1 +10
            3875     2   p                     id201 = ind1 + 2
            3876     2   p                     id211 = ind1 +11
            3877     2   p                   elseif (specparm1 > 0.875) then
            3878     2   p                     p = -fs1
            3879     2   p                     p4 = p**4
            3880     2   p                     fk0 = p4
            3881     2   p                     fk1 = f_one - p - 2.0*p4
            3882     2   p                     fk2 = p + p4
            3883     2   p                     id001 = ind1 + 1
            3884     2   p                     id011 = ind1 +10
            3885     2   p                     id101 = ind1
            3886     2   p                     id111 = ind1 + 9
            3887     2   p                     id201 = ind1 - 1
            3888     2   p                     id211 = ind1 + 8
            3889     2   p                   else
            3890     2   p                     fk0 = f_one - fs1
            3891     2   p                     fk1 = fs1
            3892     2   p                     fk2 = f_zero
            3893     2   p                     id001 = ind1
            3894     2   p                     id011 = ind1 + 9
            3895     2   p                     id101 = ind1 + 1
            3896     2   p                     id111 = ind1 +10
            3897     2   p                     id201 = ind1
            3898     2   p                     id211 = ind1
            3899     2   p                   endif
            3900     1               
            3901     1   p                   fac001 = fk0*fac01(k)
            3902     1   p                   fac101 = fk1*fac01(k)
            3903     1   p                   fac201 = fk2*fac01(k)
            3904     1   p                   fac011 = fk0*fac11(k)
            3905     1   p                   fac111 = fk1*fac11(k)
            3906     1   p                   fac211 = fk2*fac11(k)
            3907     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3908     2   p   fv              do ig = 1, ng03
            3909     2   p   fv                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            3910     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            3911     2   p   fv                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &
            3912     2                    &            * (forref(ig,indfp) - forref(ig,indf)))
            3913     2   p   fv                n2om1   = ka_mn2o(ig,jmn2o,indm) + fmn2o                      &
            3914     2                    &            * (ka_mn2o(ig,jmn2op,indm) - ka_mn2o(ig,jmn2o,indm))
            3915     2   p   fv                n2om2   = ka_mn2o(ig,jmn2o,indmp) + fmn2o                     &
            3916     2                    &            * (ka_mn2o(ig,jmn2op,indmp) - ka_mn2o(ig,jmn2o,indmp))
            3917     2   p   fv                absn2o  = n2om1 + minorfrac(k) * (n2om2 - n2om1)
            3918     2               
            3919     2   p   fv                tau_major = speccomb                                          &
            3920     2                    &              * (fac000*absa(ig,id000) + fac010*absa(ig,id010)    &
            3921     2                    &              +  fac100*absa(ig,id100) + fac110*absa(ig,id110)    &
            3922     2                    &              +  fac200*absa(ig,id200) + fac210*absa(ig,id210))
            3923     2               
            3924     2   p   fv                tau_major1 = speccomb1                                        &
            3925     2                    &              * (fac001*absa(ig,id001) + fac011*absa(ig,id011)    &
            3926     2                    &              +  fac101*absa(ig,id101) + fac111*absa(ig,id111)    &
            3927     2                    &              +  fac201*absa(ig,id201) + fac211*absa(ig,id211))
            3928     2               
            3929     2   p   fv                taug(ns03+ig,k) = tau_major + tau_major1                      &
            3930     2                    &                    + tauself + taufor + adjcoln2o*absn2o
            3931     2               
            3932     2   p   fv                fracs(ns03+ig,k) = fracrefa(ig,jpl) + fpl                     &
            3933     2                    &                     * (fracrefa(ig,jplp) - fracrefa(ig,jpl))
            3934     2   p   fv              enddo     ! end do_k_loop
            3935     1   p                 enddo   ! end do_ig_loop
            3936                     
            3937                     !  --- ...  upper atmosphere loop
            3938                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rfrate, colamt, coldry, jp, jt1, jt
                                   <<<      indfor, indminor, fac00, fac10, fac01
                                   <<<      fac11, forfrac
                                   <<<    PREFETCH(SOFT) : 4
                                   <<<     SEQUENTIAL : 4
                                   <<<      forfac: 2, minorfrac: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 11  FILL 32
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 12  FILL 12
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3939     1  pp                 do k = laytrop+1, nlay
            3940     1   p                   speccomb = colamt(k,1) + rfrate(k,1,1)*colamt(k,2)
            3941     1   p                   specparm = colamt(k,1) / speccomb
            3942     1   p                   specmult = 4.0 * min(specparm, oneminus)
            3943     1   p                   js = 1 + int(specmult)
            3944     1   p                   fs = mod(specmult, f_one)
            3945     1   p                   ind0 = ((jp(k)-13)*5 + (jt(k)-1)) * nspb(3) + js
            3946     1               
            3947     1   p                   speccomb1 = colamt(k,1) + rfrate(k,1,2)*colamt(k,2)
            3948     1   p                   specparm1 = colamt(k,1) / speccomb1
            3949     1   p                   specmult1 = 4.0 * min(specparm1, oneminus)
            3950     1   p                   js1 = 1 + int(specmult1)
            3951     1   p                   fs1 = mod(specmult1, f_one)
            3952     1   p                   ind1 = ((jp(k)-12)*5 + (jt1(k)-1)) * nspb(3) + js1
            3953     1               
            3954     1   p                   speccomb_mn2o = colamt(k,1) + refrat_m_b*colamt(k,2)
            3955     1   p                   specparm_mn2o = colamt(k,1) / speccomb_mn2o
            3956     1   p                   specmult_mn2o = 4.0 * min(specparm_mn2o, oneminus)
            3957     1   p                   jmn2o = 1 + int(specmult_mn2o)
            3958     1   p                   fmn2o = mod(specmult_mn2o, f_one)
            3959     1               
            3960     1   p                   speccomb_planck = colamt(k,1) + refrat_planck_b*colamt(k,2)
            3961     1   p                   specparm_planck = colamt(k,1) / speccomb_planck
            3962     1   p                   specmult_planck = 4.0 * min(specparm_planck, oneminus)
            3963     1   p                   jpl = 1 + int(specmult_planck)
            3964     1   p                   fpl = mod(specmult_planck, f_one)
            3965     1               
            3966     1   p                   indf = indfor(k)
            3967     1   p                   indm = indminor(k)
            3968     1   p                   indfp = indf + 1
            3969     1   p                   indmp = indm + 1
            3970     1   p                   jmn2op= jmn2o+ 1
            3971     1   p                   jplp  = jpl  + 1
            3972     1               
            3973     1   p                   id000 = ind0
            3974     1   p                   id010 = ind0 + 5
            3975     1   p                   id100 = ind0 + 1
            3976     1   p                   id110 = ind0 + 6
            3977     1   p                   id001 = ind1
            3978     1   p                   id011 = ind1 + 5
            3979     1   p                   id101 = ind1 + 1
            3980     1   p                   id111 = ind1 + 6
            3981     1               
            3982     1               !  --- ...  in atmospheres where the amount of n2o is too great to be considered
            3983     1               !           a minor species, adjust the column amount of n2o by an empirical factor
            3984     1               !           to obtain the proper contribution.
            3985     1               
            3986     1   p                   p = coldry(k) * chi_mls(4,jp(k)+1)
            3987     1   p                   ratn2o = colamt(k,4) / p
            3988     2   p                   if (ratn2o > 1.5) then
            3989     2   p                     adjfac = 0.5 + (ratn2o - 0.5)**0.65
            3990     2   p                     adjcoln2o = adjfac * p
            3991     2   p                   else
            3992     2   p                     adjcoln2o = colamt(k,4)
            3993     2   p                   endif
            3994     1               
            3995     1   p                   fk0 = f_one - fs
            3996     1   p                   fk1 = fs
            3997     1   p                   fac000 = fk0*fac00(k)
            3998     1   p                   fac010 = fk0*fac10(k)
            3999     1   p                   fac100 = fk1*fac00(k)
            4000     1   p                   fac110 = fk1*fac10(k)
            4001     1               
            4002     1   p                   fk0 = f_one - fs1
            4003     1   p                   fk1 = fs1
            4004     1   p                   fac001 = fk0*fac01(k)
            4005     1   p                   fac011 = fk0*fac11(k)
            4006     1   p                   fac101 = fk1*fac01(k)
            4007     1   p                   fac111 = fk1*fac11(k)
            4008     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            4009     2   p   fv              do ig = 1, ng03
            4010     2   p   fv                taufor = forfac(k) * (forref(ig,indf) + forfrac(k)            &
            4011     2                    &           * (forref(ig,indfp) - forref(ig,indf)))
            4012     2   p   fv                n2om1  = kb_mn2o(ig,jmn2o,indm) + fmn2o                       &
            4013     2                    &           * (kb_mn2o(ig,jmn2op,indm) - kb_mn2o(ig,jmn2o,indm))
            4014     2   p   fv                n2om2  = kb_mn2o(ig,jmn2o,indmp) + fmn2o                      &
            4015     2                    &           * (kb_mn2o(ig,jmn2op,indmp) - kb_mn2o(ig,jmn2o,indmp))
            4016     2   p   fv                absn2o = n2om1 + minorfrac(k) * (n2om2 - n2om1)
            4017     2               
            4018     2   p   fv                tau_major = speccomb                                          &
            4019     2                    &              * (fac000*absb(ig,id000) + fac010*absb(ig,id010)    &
            4020     2                    &              +  fac100*absb(ig,id100) + fac110*absb(ig,id110))
            4021     2               
            4022     2   p   fv                tau_major1 = speccomb1                                        &
            4023     2                    &              * (fac001*absb(ig,id001) + fac011*absb(ig,id011)    &
            4024     2                    &              +  fac101*absb(ig,id101) + fac111*absb(ig,id111))
            4025     2               
            4026     2   p   fv                taug(ns03+ig,k) = tau_major + tau_major1                      &
            4027     2                    &                    + taufor + adjcoln2o*absn2o
            4028     2               
            4029     2   p   fv                fracs(ns03+ig,k) = fracrefb(ig,jpl) + fpl                     &
            4030     2                    &                     * (fracrefb(ig,jplp) - fracrefb(ig,jpl))
            4031     2   p   fv              enddo
            4032     1   p                 enddo
            4033                     
            4034                     ! ..................................
            4035                           end subroutine taugb03
            4036                     ! ----------------------------------
            4037                     
            4038                     ! ----------------------------------
            4039                           subroutine taugb04
            4040                     ! ..................................
            4041                     
            4042                     !  ------------------------------------------------------------------  !
            4043                     !     band 4:  630-700 cm-1 (low key - h2o,co2; high key - o3,co2)     !
            4044                     !  ------------------------------------------------------------------  !
            4045                     
            4046                           use module_radlw_kgb04
            4047                     
            4048                     !  ---  locals:
            4049                           integer :: k, ind0, ind1, inds, indsp, indf, indfp, jpl, jplp,    &
            4050                          &       id000, id010, id100, id110, id200, id210, ig, js, js1,     &
            4051                          &       id001, id011, id101, id111, id201, id211
            4052                     
            4053                           real (kind=kind_phys) :: tauself, taufor, p, p4, fk0, fk1, fk2,   &
            4054                          &      speccomb,       specparm,       specmult,       fs,         &
            4055                          &      speccomb1,      specparm1,      specmult1,      fs1,        &
            4056                          &      speccomb_planck,specparm_planck,specmult_planck,fpl,        &
            4057                          &      fac000, fac100, fac200, fac010, fac110, fac210,             &
            4058                          &      fac001, fac101, fac201, fac011, fac111, fac211,             &
            4059                          &      refrat_planck_a, refrat_planck_b, tau_major, tau_major1
            4060                     !
            4061                     !===> ...  begin here

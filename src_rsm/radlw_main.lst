            4181     2   p    v              do ig = 1, ng04
            4182     2   p    v                tauself = selffac(k)* (selfref(ig,inds) + selffrac(k)         &
            4183     2                    &            * (selfref(ig,indsp) - selfref(ig,inds)))
            4184     2   p    v                taufor  = forfac(k) * (forref(ig,indf) + forfrac(k)           &

 External subroutine subprogram "grdtpw"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine grdtpw ( mn,dt,hltm,tice,hice,czh,land,ocean,snow,ts &
               2                                             , tgclim,tg,gwclim,gwr,gwet,ss,rs,hflux,qflux &
               3                                             , snr,totalp )
               4                     !
               5                     !#######################################################################
               6                     !           subroutine description
               7                     !
               8                     ! 1. function description
               9                     !
              10                     !    this subroutine predicts ground temperature for land points with
              11                     !    energy budget concept including newton cooling term, and ground
              12                     !    water for land and snow points with water mass budget concept.
              13                     !
              14                     ! 2. parameter specification
              15                     !
              16                     !    mn : dimension of horizontal-direction
              17                     !    dt : time step for tg updates                         (s)     i
              18                     !  hltm : water vapor latent heat constant                 (j/kg)  i
              19                     !  tice : temperature of melting point               (mn)  (k)     i
              20                     !  hice : latent heat of snow melting                      (j/kg)  i
              21                     !   czh : ground thermal capacity                          (j/k m2)i
              22                     ! land  : logic for bare soil land                   (mn)          i
              23                     ! ocean : logic for open water (=ture for open water)(mn)          i
              24                     ! snow  : logic for snow covered area                (mn)          i
              25                     !   ts  : surface air temperature                    (mn)   (k)    i
              26                     ! tgclim: ground real temp. climatolagy              (mn)  (k)     i
              27                     !    tg : ground real temp. (sea or land)            (mn)  (k)     i/o
              28                     ! gwclim: soil water climatology                     (mn)  (mm)    i
              29                     !   gwr : soil water for land and ice points         (mn)  (mm)    i/o
              30                     !  gwet : ground wetness ( = gwr/20.0 )              (mn)          i/o
              31                     !    ss : net short wave flux down to ground surface (mn)  (wat/m2)i
              32                     !    rs : net long  wave flux up from ground surface (mn)  (wat/m2)i
              33                     ! hflux : upward surface heat flux                   (mn)  (wat/m2)i
              34                     ! qflux : upward surface moisture flux               (mn)  (wat/m2)i
              35                     !  snr  : snow depth in water state                  (mn)   (mm)   i/o
              36                     ! totalp: total precipitation during dt              (mn)   (mm)   i
              37                     !
              38                     ! 4. local veriable
              39                     !
              40                     !  betatg : newton cooling restorine rate (=1/(100 hr))     (1/s)
              41                     !     fhs : net budget of total flux                        (wat/m2)
              42                     !
              43                     ! 5. calling modules
              44                     !
              45                     !     pbltke
              46                     !
              47                     ! 6. usage
              48                     !
              49                     !     call grdtpw ( mn,dt,hltm,tice,hice,czh,land,ocean,snow,ts
              50                     !    1            , tgclim,tg,gwclim,gwr,gwet,ss,rs,hflux,qflux
              51                     !    2            , snr,totalp )
              52                     !
              53                     ! 7. modules called
              54                     !
              55                     ! 8. limitation
              56                     !
              57                     ! 9. date
              58                     !
              59                     !    created       jan. 1992
              60                     !    modified      may  1993
              61                     !
              62                     ! 10. author
              63                     !
              64                     !     f. wang,  c.s. liou
              65                     !     modify to f90 by C-H Lee and sort by River Chen in 2015
              66                     !
              67                     !#######################################################################
              68                           implicit  none
              69                     !
              70                     ! input & output variable
              71                           integer   mn
              72                           real      dt,hltm,tice,hice
              73                           real      czh(mn),ts(mn),tgclim(mn),                            &
              74                                     tg(mn),gwclim(mn),gwr(mn),gwet(mn),ss(mn),rs(mn),     &
              75                                     hflux(mn),qflux(mn),snr(mn),totalp(mn)
              76                     
              77                           logical   land(mn),ocean(mn),snow(mn)
              78                     !-----------------------------------------------------------------------
              79                     !
              80                           integer   ij
              81                           real      belnd,beice,alp,deltg,betg,fhs,tmp,fgtg
              82                           real      dtywtr,gwrcc,rainr,water,cbhice,snomlt
              83                     
              84                     
              85                           belnd= 6.2832/(3600.*100.)
              86                           beice= 6.2832/(3600.*360.)
              87                           alp  = 0.5
              88                           deltg= 5.0
              89                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 78
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ocean, rs, ss, hflux, qflux, czh, land
                                   <<<      snow, ts, tgclim, tg, totalp, snr
                                   <<<      gwclim, gwr, gwet
                                   <<< Loop-information  End >>>
              90     1  pp    v            do 100 ij = 1, mn
              91     2   p    v              if ( .not. ocean(ij))  then
              92     3   p    v                if ( land(ij) ) then
              93     3   p    v                   betg = belnd
              94     3   p    v                else
              95     3   p    v                   betg = beice
              96     3   p    v                endif
              97     2   p    v                fhs = ss(ij) - rs(ij) - qflux(ij) - hflux(ij)
              98     2   p    v                tmp = (tg(ij)+ dt*(fhs/czh(ij)+betg*tgclim(ij)))/(1.+betg*dt)
              99     2               !
             100     2               !         apply time filter when fhs is large (kalnay & kanamitsu,1988)
             101     2               !         criterion: alpha*(p-1) >= 1.,  p=3.5
             102     2               !
             103     2   p    v                fgtg = dt*fhs/(czh(ij)*deltg)
             104     3   p    v                if ( abs(fgtg) .ge. 0.4 )  then
             105     3   p    v                  tg(ij) = (1.0-alp)*tmp + alp*tg(ij)
             106     3   p    v                else
             107     3   p    v                  tg(ij) = tmp
             108     3   p    v                endif
             109     2               !
             110     2               ! snr: mm
             111     2               ! totalp: mm
             112     2               ! dtywtr: kg/m3
             113     2               ! snomlt: mm
             114     2               ! cbhice: (j/m2k)/(j/kg)=kg/m2k
             115     2               !
             116     2   p    v                 dtywtr = 1000.0
             117     2   p    v                 gwrcc  = 20.0
             118     2               !
             119     3   p    v                 if (land(ij).or.snow(ij))  then
             120     4   p    v                   if (ts(ij).lt.tice)  then
             121     4   p    v                     snr(ij) = snr(ij) + totalp(ij)
             122     4   p    v                     rainr   = 0.0
             123     4   p    v                   else
             124     4   p    v                     rainr   = totalp(ij)
             125     4   p    v                   endif
             126     4   p    v                   if (tg(ij).lt.tice)  then
             127     4   p    v                     water = rainr
             128     4   p    v                   else
             129     4   p    v                     cbhice  = czh(ij)/hice
             130     4   p    v                     snomlt  = min(cbhice*(tg(ij)-tice)/dtywtr*1000.,snr(ij))
             131     4   p    v                     tg(ij)  = tg(ij) - snomlt/1000.*dtywtr/cbhice
             132     4   p    v                     snr(ij) = snr(ij) - snomlt
             133     4   p    v                     water   = rainr + snomlt
             134     4   p    v                   endif
             135     3   p    v                   gwr(ij) = (gwr(ij) + dt*(water/dt- qflux(ij)/hltm + betg  &
             136     3                                   * gwclim(ij))) / (1.0 + dt*(water/dt/gwrcc+betg))
             137     3   p    v                   gwr(ij) = max( 0.01, min( gwrcc, gwr(ij) ) )
             138     3   p    v                   gwet(ij)= gwr(ij)/gwrcc
             139     3   p    v                 else
             140     3   p    v                   tg(ij) = min( tg(ij),tice )
             141     3   p    v                 endif
             142     2   p    v              endif
             143     1   p    v       100  continue
             144                     !
             145                           return
             146                           end


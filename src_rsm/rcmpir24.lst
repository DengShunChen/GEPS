 External subroutine subprogram "rcmpir24"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine rcmpir24( nr,nx,lev,bf,ee,ww1,ww2,ww,ttau,ffu,ffd )
               2                     !
               3                     ! **********************************************************************
               4                     ! In this subroutine, the two- and four- stream combination  scheme  or
               5                     ! the source function technique (Toon et al. 1989) is used to calculate
               6                     ! the IR radiative fluxes. The exponential approximation for the Planck
               7                     ! function in optical depth is used ( Fu, 1991).
               8                     ! At IR wavelengths, the two-stream results are not exact in the limit
               9                     ! of no scattering. It also introduces large error in the case of sca-
              10                     ! ttering. Since the no-scattering limit is of considerable significance
              11                     ! at IR wavelengths, we have used  the source function technique  that
              12                     ! would be exact in the limit of the pure absorption and would also en-
              13                     ! hance the accuracy of the two-stream approach when scattering occurs
              14                     ! in the IR wavelengths.
              15                     ! Here, we use nq Gauss points to obtain the fluxes: when nq=2, we use
              16                     ! double Gaussian quadrature as in Fu and Liou (1993) for  four-stream
              17                     ! approximation; when nq = 3, we use the regular Gauss quadrature  but
              18                     ! u1*w1+u2*w2+u3*w3=1.0.
              19                     !
              20                     ! ++ input/output variables:
              21                     !    (1) input variables :
              22                     !        nr    : number of grid points to calculate ir flux
              23                     !        nx    : horizontal dimension of input array
              24                     !        lev   : number of vertical layers
              25                     !        bf    : blockbody intensity function integrated over
              26                     !                the band "ib"
              27                     !                bf(1~lev+1) : atmospheric levels
              28                     !                bf(lev+2)   : surface level
              29                     !        ee    : ground surface emissivity
              30                     !        ww1~2 : first two coeff. of legendre polynomials for
              31                     !                the scattering phase function
              32                     !        ww    : single scattering albedo
              33                     !        ttau(lev+1) : total optical depth from top to reference level
              34                     !
              35                     !    (2) output variables :
              36                     !        ffu
              37                     !        ffd
              38                     !
              39                     ! ++ auther :
              40                     !    original : fu and liou (1992)
              41                     !    modified : c. t. fong (1996)
              42                     !    modify to f90 by C-H Lee in 2015
              43                     !
              44                     ! **********************************************************************
              45                           use paramt
              46                     
              47                           implicit  none
              48                     !
              49                     !fong parameter ( nq = 1 )  ! souce function techn. for two streams
              50                           integer, parameter :: nq = 2 ! .............. for four streams
              51                     !fong parameter ( nq = 3 )  ! ..................... for six streams
              52                     !
              53                           integer   nr,nx,lev
              54                     
              55                           real      bf(nx*(lev+2)),ee(nx),ww1(nx*lev),ww2(nx*lev),ww(nx*lev), &
              56                                     ttau(nx*(lev+1))
              57                           real      ffu(nx*(lev+1)),ffd(nx*(lev+1))
              58                     !
              59                     !   local working arrays
              60                     !
              61                     !     include '../include/paramt.h'
              62                     !
              63                           real      w1(ilm),w(ilm),qu0(ilm),f0(ilm),tau(im*(lm+1))
              64                           real      lamdan(ilm)
              65                           real      ug(nq),wg(nq),ugwg(nq)
              66                           real      gamman(ilm),caddn(ilm),                &
              67                                     cminn(ilm),caddn0(ilm),cminn0(ilm),    &
              68                                     aa(ilm),bb(ilm),expn(ilm)
              69                           real      f(ilm),xn(ilm),yn(ilm),zn(ilm)
              70                           real      etri(im,lm*2,4),alfa(im*(lm+1)),beta(ilm)
              71                           real      fg(ilm),fh(ilm),fj(ilm),fk(ilm)
              72                           real      fiu(im*(lm+1),nq),fid(im*(lm+1),nq),fx(ilm,nq),&
              73                                     fz1(ilm,nq),fz2(ilm,nq),fuq1(ilm),fuq2(ilm)
              74                           real      wk1(im),wk2(im)
              75                     !
              76                     !6st  data ug / 0.238619, 0.661209, 0.932469 /
              77                     !6st  data wg / 0.467914, 0.360762, 0.171324 /
              78                     !6st  data ugwg / 0.109475, 0.233886, 0.156639 /
              79                           data ug / 0.2113248, 0.7886752 /
              80                           data wg / 0.5, 0.5 /
              81                           data ugwg / 0.105662, 0.394338 /
              82                     !2st  data ug / 0.5 /
              83                     !2st  data wg / 1.0 /
              84                     !2st  data ugwg / 0.5 /
              85                     !
              86                           integer   nrn,nrn1,lev2,i,j,jk,jj,j2n,j2n1,jkes,jke,jje,j2m1,j2m,nst
              87                           real      sqrt3,rsqrt3,pi,ugts1,fw,q1,dtau,q2,x,gamma1,gamma2,z,rsfc
              88                           real      ssfc,wm1,wm2,y1,y,rugts1,xx,xxm1
              89                     
              90                           nrn  = nr*lev
              91                           nrn1 = nr*(lev+1)
              92                           lev2 = lev*2
              93                           sqrt3= sqrt(3.)
              94                           rsqrt3= 1./sqrt3
              95                           pi   = 4.*atan(1.)
              96                           ugts1 = 0.5
              97                     !
              98                     !fong01
              99                     ! incorporate a delta-function adjustment to account for the forward
             100                     ! diffraction  peak in the context of the two stream approximations.
             101                     ! w1(n),  w(n), and tau(n+1) are the adjusted parameters.
             102                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ww2, f
                                   <<< Loop-information  End >>>
             103     1  pp   2v            do 6 i =1, nrn
             104     1   p   2v            f(i) = ww2(i) / 5.0
             105     1   p   2v          6 continue
             106                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tau
                                   <<< Loop-information  End >>>
             107     1  pp   4v            do 7 i = 1, nr
             108     1   p   4v            tau(i) = 0.
             109     1   p   4v          7 continue
             110                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 341
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.63, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f, ww, ttau, ww1, w1, f0, w
                                   <<< Loop-information  End >>>
             111     1  pp    v            do 10 i = 1, nrn
             112     1   p    v            fw = 1.0 - f(i) * ww(i)
             113     1   p    v            w1(i) = ( ww1(i) - 3.0 * f(i) ) / ( 1.0 - f(i) )
             114     1   p    v            w(i)  = ( 1.0 - f(i) ) * ww(i) / fw
             115     1   p    v            f0(i) = (ttau(i+nr) - ttau(i)) * fw
             116     1   p    v         10 continue
             117                     !
             118     1                     do 12 j = 1, lev
             119     1                     jk = j*nr
             120     1                     jj = jk-nr
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      f0, tau
                                   <<< Loop-information  End >>>
             121     2  pp   2v            do 12 i = 1, nr
             122     2   p   2v            tau(i+jk) = tau(i+jj) + f0(i+jj)
             123     1   p   2v         12 continue
             124                     !fong01
             125                     !
             126                     !fong01.1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 39
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.72, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      w, bf, qu0, f0, tau, beta
                                   <<< Loop-information  End >>>
             127     1  pp    v            do 15 i = 1, nrn
             128     1   p    v            q1 = log( bf(i+nr)/bf(i) )
             129     1   p    v            if( abs(q1) .lt. 1.0e-10 ) q1 = 1.0e-10
             130     1   p    v            dtau = tau(i+nr) - tau(i)
             131     1   p    v            dtau = max(0.000001, dtau)
             132     1               !cc   q2 = 1.0 / ( tau(i+nr) - tau(i) )
             133     1   p    v            q2 = 1.0 / dtau
             134     1   p    v            f0(i)  = 2.0 * ( 1.0 - w(i) ) * bf(i)
             135     1   p    v            qu0(i) = - 1.0 / ( q1 * q2 )
             136     1   p    v            beta(i)= -1.0 / qu0(i)
             137     1   p    v         15 continue
             138                     !fong01.1
             139                     !
             140                     !fong02
             141                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 208, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      w
                                   <<< Loop-information  End >>>
             142     1  pp   2v            do 20 i = 1, nrn
             143     1   p   2v            w(i) = min ( w(i), 0.999999 )
             144     1   p   2v         20 continue
             145                     !
             146                     !
             147                     ! The following is used to calculate the coefficients for hemispheric
             148                     ! mean two streams.
             149                     ! The  hemispheric  mean scheme is derived by assuming that the phase
             150                     ! function is equal to 1 + g in  the forward scattering hemisphere
             151                     ! and 1 - g  in  the  backward scattering hemisphere where g is the
             152                     ! asymmetry factor.   The hemispheric mean is only used for infrared
             153                     ! wavelengths (Toon et al. 1989).
             154                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 37
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.86, ITR: 48, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      lamdan, cminn0, caddn0, cminn, caddn, f0
                                   <<<      tau, gamman, beta, w1, w
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 2  FILL 9
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             155     1  pp    v            do 40 i = 1, nrn
             156     1   p    v            x = w(i) * w1(i) / 3.0
             157     1   p    v            gamma1 = 2.0 - w(i) - x
             158     1   p    v            gamma2 = w(i) - x
             159     1               !vpp  lamdan(i) = exp( 0.5*log((gamma1 + gamma2)*(gamma1 - gamma2)) )
             160     1   p    v            lamdan(i) = sqrt((gamma1 + gamma2)*(gamma1 - gamma2))
             161     1   p    v            gamman(i) = gamma2 / ( gamma1 + lamdan(i) )
             162     1   p    v            fw = pi * f0(i)
             163     1   p    v            x = exp ( beta(i) * ( tau(i+nr) - tau(i) ) )
             164     1   p    v            z = lamdan(i) * lamdan(i) - beta(i) * beta(i)
             165     2   p    v            if(abs(z) .lt. 1.0e-6)then
             166     2   p    v             beta(i) = beta(i)+beta(i)*0.01
             167     2   p    v             z = lamdan(i) * lamdan(i) - beta(i) * beta(i)
             168     2   p    v            end if
             169     1   p    v            caddn0(i) = fw * ( ( gamma1 + beta(i) ) + gamma2 ) / z
             170     1   p    v            cminn0(i) = fw * ( ( gamma1 - beta(i) ) + gamma2 ) / z
             171     1   p    v            caddn(i) = caddn0(i) * x
             172     1   p    v            cminn(i) = cminn0(i) * x
             173     1   p    v         40 continue
             174                     !fong02
             175                     !
             176                     !fong03
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.07, ITR: 64, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gamman, xn, lamdan, expn, yn, zn, tau
                                   <<< Loop-information  End >>>
             177     1  pp    v            do 50 i = 1, nrn
             178     1   p    v            dtau = tau(i+nr) - tau(i)
             179     1   p    v            expn(i) = exp ( - lamdan(i) * dtau )
             180     1   p    v            xn(i) = gamman(i) * expn(i)
             181     1   p    v            yn(i) = ( expn(i) - gamman(i) ) / ( xn(i) - 1.0 )
             182     1   p    v            zn(i) = ( expn(i) + gamman(i) ) / ( xn(i) + 1.0 )
             183     1   p    v         50 continue
             184                     !fong03
             185                     !
             186                     !fong04
             187                     !
             188                     !  etri : tridiagonal matrix for eq(39) in toon et al. (1989)
             189                     !  etri(i,k,m) : i=1,nr (horizontal grids), k=1,2*lev (vertical levels)
             190                     !                mm=1,4 (1:a, 2:b, 3:d, 4:e, a,b,d,e refer to eq(39))
             191                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.66, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cminn0, xn, etri
                                   <<< Loop-information  End >>>
             192     1  pp    v            do 110 i = 1, nr
             193     1   p    v            etri(i,1,1) = 0.0
             194     1   p    v            etri(i,1,2) = xn(i) + 1.0
             195     1   p    v            etri(i,1,3) = xn(i) - 1.0
             196     1   p    v            etri(i,1,4) = - cminn0(i)
             197     1   p    v        110 continue
             198                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      caddn, cminn, zn, caddn0, expn, gamman
                                   <<<      xn, cminn0, yn, etri
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      gamman: 4, etri: 12
                                   <<< Loop-information  End >>>
             199     1  pp                 do 150 j = 1, lev-1
             200     1   p                 jk = j*nr
             201     1   p                 jj = jk-nr
             202     1   p                 j2n = j+j
             203     1   p                 j2n1= j2n+1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.79, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      caddn, caddn0, gamman, expn, cminn
                                   <<<      cminn0, xn, zn, etri, yn
                                   <<<    PREFETCH(SOFT) : 14
                                   <<<     SEQUENTIAL : 14
                                   <<<      etri: 12, gamman: 2
                                   <<< Loop-information  End >>>
             204     2   p    v            do 150 i = 1, nr
             205     2   p    v            etri(i,j2n,1) = 1.0+xn(i+jj)-yn(i+jk)*(gamman(i+jj)+expn(i+jj))
             206     2   p    v            etri(i,j2n,2) = 1.0-xn(i+jj)-yn(i+jk)*(gamman(i+jj)-expn(i+jj))
             207     2   p    v            etri(i,j2n,3) = yn(i+jk)*(1.0+xn(i+jk))-expn(i+jk)-gamman(i+jk)
             208     2   p    v            etri(i,j2n,4) = caddn0(i+jk)-caddn(i+jj)-yn(i+jk) *             &
             209     2                               ( cminn0(i+jk)-cminn(i+jj) )
             210     2   p    v            etri(i,j2n1,1) = gamman(i+jj)-expn(i+jj)-zn(i+jj)*(1.0-xn(i+jj))
             211     2   p    v            etri(i,j2n1,2) = -1.0-xn(i+jk)+zn(i+jj)*(expn(i+jk)+gamman(i+jk))
             212     2   p    v            etri(i,j2n1,3) = zn(i+jj)*(expn(i+jk)-gamman(i+jk))-xn(i+jk)+1.0
             213     2   p    v            etri(i,j2n1,4) = cminn0(i+jk)-cminn(i+jj)-zn(i+jj) *            &
             214     2                                ( caddn0(i+jk)-caddn(i+jj) )
             215     1   p    v        150 continue
             216                     !fong04
             217                     !
             218                     !fong05
             219                           jkes= (lev+1)*nr
             220                           jke = lev*nr
             221                           jje = jke-nr
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.90, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      bf, expn, xn, etri, ee, cminn, caddn
                                   <<<      gamman
                                   <<< Loop-information  End >>>
             222     1  pp    v            do 170 i = 1, nr
             223     1   p    v            rsfc = 1.0 - ee(i)
             224     1   p    v            ssfc = pi * ( bf(i+jkes) * ee(i) )
             225     1   p    v            wm1 = 1.0 - rsfc * gamman(i+jje)

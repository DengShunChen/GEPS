 Module "mo_convect_tables"
  (inc)(line-no.)(nest)(optimize)
               1                     MODULE mo_convect_tables
               2                     
               3                       !-----------------------------------------------------------------------
               4                       ! *mo_convect_tables* - tables for convective adjustment code
               5                       !
               6                       !           d.salmond  cray (uk)   12/8/91
               7                       !
               8                       !
               9                       ! table lookups replaced
              10                       !
              11                       !           A. Rhodin mpi 12/98
              12                       !
              13                       ! When replacing the table lookups the following code has been used:
              14                       !
              15                       !   tlucua :  c2es*EXP(MERGE(c3les,c3ies,lo)*(tt-tmelt) &
              16                       !           /      (tt-MERGE(c4les,c4ies,lo)))
              17                       !
              18                       !   tlucub :  MERGE(c5alvcp,c5alscp,lo) / (tt-MERGE(c4les,c4ies,lo))**2
              19                       !
              20                       !   tlucuc :  MERGE(alvdcp, alsdcp, lo)
              21                       !
              22                       !   tlucuaw:  c2es*EXP(c3les*(tt-tmelt)*(1./(tt-c4les)))
              23                       !
              24                       !   with:     lo = tt > tmelt
              25                       !
              26                       ! compile with option -DNOLOOKUP in order to replace lookup tables
              27                       !-----------------------------------------------------------------------
              28                     
              29                       use shr_kind_mod, only: r8 => shr_kind_r8
              30                     
              31                       IMPLICIT NONE
              32                     
              33                       SAVE
              34                     
              35                       !----------------
              36                       ! Public entities
              37                       !----------------
              38                       PRIVATE
              39                       !-----------------------------
              40                       ! lookup tables -- obsolescent
              41                       !-----------------------------
              42                       PUBLIC :: jptlucu1          ! lookup table lower bound
              43                       PUBLIC :: jptlucu2          ! lookup table upper bound
              44                       PUBLIC :: tlucua            ! table -- e_s*Rd/Rv
              45                       PUBLIC :: tlucub            ! table -- for derivative calculation: d es/ d t
              46                       PUBLIC :: tlucuc            ! table -- l/cp
              47                       PUBLIC :: tlucuaw           ! table
              48                       PUBLIC :: set_lookup_tables ! initialization routine
              49                       PUBLIC :: lookupoverflow    ! lookup table overflow flag
              50                       PUBLIC :: lookuperror       ! error handling routine
              51                       !-----------------
              52                       ! Module variables
              53                       !-----------------
              54                     
              55                       INTEGER, PARAMETER :: jptlucu1 =  50000  ! lookup table lower bound
              56                       INTEGER, PARAMETER :: jptlucu2 = 370000  ! lookup table upper bound
              57                     
              58                       LOGICAL :: lookupoverflow
              59                     
              60                       REAL(r8) :: tlucua(jptlucu1:jptlucu2)        ! table - e_s*Rd/Rv
              61                       REAL(r8) :: tlucub(jptlucu1:jptlucu2)        ! table - for derivative calculation
              62                       REAL(r8) :: tlucuc(jptlucu1:jptlucu2)        ! table - l/cp
              63                       REAL(r8) :: tlucuaw(jptlucu1:jptlucu2)       ! table
              64                     
              65                     CONTAINS
              66                     
              67                       SUBROUTINE set_lookup_tables
              68                         !----------------------------
              69                         ! -- Initialise lookup tables
              70                         !      called from 'setphys'
              71                         !----------------------------
              72                         USE mo_constants, ONLY: alsdcp, alvdcp, c2es, c3ies, c3les, c4ies, c4les, &
              73                                                 c5alscp, c5alvcp, tmelt, rd, rv
              74                     
              75                         REAL(r8), PARAMETER :: clavm1 = -6096.9385
              76                         REAL(r8), PARAMETER :: clavm2 =    21.2409642
              77                         REAL(r8), PARAMETER :: clavm3 =    -2.711193
              78                         REAL(r8), PARAMETER :: clavm4 =     1.673952
              79                         REAL(r8), PARAMETER :: clavm5 =     2.433502
              80                     
              81                         REAL(r8), PARAMETER :: ciavm1 = -6024.5282
              82                         REAL(r8), PARAMETER :: ciavm2 =    29.32707
              83                         REAL(r8), PARAMETER :: ciavm3 =     1.0613868
              84                         REAL(r8), PARAMETER :: ciavm4 =    -1.3198825
              85                         REAL(r8), PARAMETER :: ciavm5 =    -0.49382577
              86                     
              87                         REAL(r8)    :: tt
              88                         INTEGER :: it
              89                         LOGICAL :: lo
              90                         LOGICAL :: lamip2
              91                     
              92                     !    lamip2 = .true.
              93                         lamip2 = .false.
              94                         tt = jptlucu1 * 0.001
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tlucuc, tlucub, tlucuaw, tlucua
                                   <<< Loop-information  End >>>
              95     1   s    s          DO it = jptlucu1, jptlucu2
              96     1   m    m            lo = tt > tmelt
              97     1               
              98     2   s    s            IF (lamip2) THEN
              99     2                       tlucua(it) = EXP((MERGE(clavm1, ciavm1, lo)/tt           &
             100     2                                       + MERGE(clavm2, ciavm2, lo)              &
             101     2                                       + MERGE(clavm3, ciavm3, lo)*tt/100.      &
             102     2                                       + MERGE(clavm4, ciavm4, lo)*tt*tt/1.e5   &
             103     2                                       + MERGE(clavm5, ciavm5, lo)*LOG(tt)))*rd/rv
             104     2   s    s            ELSE
             105     2   m    m              tlucua(it) = c2es*EXP(MERGE(c3les,  c3ies,  lo)*(tt-tmelt) &
             106     2                                  *  (1./(tt-MERGE(c4les,  c4ies,  lo))))
             107     2   p    v            END IF
             108     1   p    v            tlucub(it)  =          MERGE(c5alvcp,c5alscp,lo) &
             109     1                                 *  (1./(tt-MERGE(c4les,  c4ies,  lo)))**2
             110     1   p    v            tlucuc(it)  =          MERGE(alvdcp, alsdcp, lo)
             111     1               
             112     1   m    m            tlucuaw(it) = c2es*EXP(c3les*(tt-tmelt)*(1./(tt-c4les)))
             113     1               
             114     1   s    s            tt = tt + 0.001
             115     1   p    v          END DO
             116                     
             117                       END SUBROUTINE set_lookup_tables
             118                     

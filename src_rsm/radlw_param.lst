 Module "module_radlw_parameters"
  (inc)(line-no.)(nest)(optimize)
               1                     !!!!!  ==============================================================  !!!!!
               2                     !!!!!             lw-rrtm3 radiation package description               !!!!!
               3                     !!!!!  ==============================================================  !!!!!
               4                     !                                                                          !
               5                     !   this package includes ncep's modifications of the rrtm-lw radiation    !
               6                     !   code from aer inc.                                                     !
               7                     !                                                                          !
               8                     !    the rrtm3 package includes these parts:                               !
               9                     !                                                                          !
              10                     !       'radlw_rrtm3_param.f'                                              !
              11                     !       'radlw_rrtm3_datatb.f'                                             !
              12                     !       'radlw_rrtm3_main.f'                                               !
              13                     !                                                                          !
              14                     !    the 'radlw_rrtm3_param.f' contains:                                   !
              15                     !                                                                          !
              16                     !       'module_radlw_parameters'  -- band parameters set up               !
              17                     !                                                                          !
              18                     !    the 'radlw_rrtm3_datatb.f' contains:                                  !
              19                     !                                                                          !
              20                     !       'module_radlw_avplank'     -- plank flux data                      !
              21                     !       'module_radlw_ref'         -- reference temperature and pressure   !
              22                     !       'module_radlw_cldprlw'     -- cloud property coefficients          !
              23                     !       'module_radlw_kgbnn'       -- absorption coeffients for 16         !
              24                     !                                     bands, where nn = 01-16              !
              25                     !                                                                          !
              26                     !    the 'radlw_rrtm3_main.f' contains:                                    !
              27                     !                                                                          !
              28                     !       'module_radlw_main'        -- main lw radiation transfer           !
              29                     !                                                                          !
              30                     !    in the main module 'module_radlw_main' there are only two             !
              31                     !    externally callable subroutines:                                      !
              32                     !                                                                          !
              33                     !       'lwrad'     -- main rrtm3 lw radiation routine                     !
              34                     !       'rlwinit'   -- to initialize rrtm3 lw radiation                    !
              35                     !                                                                          !
              36                     !    all the lw radiation subprograms become contained subprograms         !
              37                     !    in module 'module_radlw_rrtm' and many of them are not directly       !
              38                     !    accessable from places outside the module.                            !
              39                     !                                                                          !
              40                     !    compilation sequence is:                                              !
              41                     !                                                                          !
              42                     !       'radlw_rrtm3_param.f'                                              !
              43                     !       'radlw_rrtm3_datatb.f'                                             !
              44                     !       'radlw_rrtm3_main.f'                                               !
              45                     !                                                                          !
              46                     !    and all should be put in front of routines that use lw modules        !
              47                     !                                                                          !
              48                     !    ncep modifications history log:                                       !
              49                     !                                                                          !
              50                     !       see list in program "radlw_rrtm3_main.f"                           !
              51                     !                                                                          !
              52                     !!!!!  ==============================================================  !!!!!
              53                     !!!!!                         end descriptions                         !!!!!
              54                     !!!!!  ==============================================================  !!!!!
              55                     
              56                     
              57                     !========================================!
              58                           module module_radlw_parameters     !
              59                     !........................................!
              60                     
              61                           use physpara,                only : kind_phys
              62                     
              63                           implicit none
              64                     !
              65                           public
              66                     !
              67                     !  ---  define type construct for radiation fluxes at toa
              68                     !
              69                           type :: topflw_type
              70                             real (kind=kind_phys) :: upfxc         ! total sky upward flux at toa
              71                             real (kind=kind_phys) :: upfx0         ! clear sky upward flux at toa
              72                           end type
              73                     !
              74                     !  ---  define type construct for radiation fluxes at surface
              75                     !
              76                           type :: sfcflw_type
              77                             real (kind=kind_phys) :: upfxc         ! total sky upward flux at sfc
              78                             real (kind=kind_phys) :: upfx0         ! clear sky upward flux at sfc
              79                             real (kind=kind_phys) :: dnfxc         ! total sky downward flux at sfc
              80                             real (kind=kind_phys) :: dnfx0         ! clear sky downward flux at sfc
              81                           end type
              82                     !
              83                     !  ---  define type construct for optional radiation flux profiles
              84                     !
              85                           type :: proflw_type
              86                             real (kind=kind_phys) :: upfxc         ! level up flux for total sky
              87                             real (kind=kind_phys) :: dnfxc         ! level dn flux for total sky
              88                             real (kind=kind_phys) :: upfx0         ! level up flux for clear sky
              89                             real (kind=kind_phys) :: dnfx0         ! level dn flux for clear sky
              90                           end type
              91                     !
              92                     !  ---  parameter constants for lw band structures
              93                     !
              94                           integer, parameter :: nbands = 16         ! num of total spectral bands
              95                           integer, parameter :: ngptlw = 140        ! num of total g-points
              96                           integer, parameter :: ntbl   = 10000      ! lookup table dimension
              97                           integer, parameter :: maxgas = 7          ! max num of absorbing gases
              98                           integer, parameter :: maxxsec= 4          ! num of halocarbon gases
              99                           integer, parameter :: nrates = 6          ! num of ref rates of binary species
             100                           integer, parameter :: nplnk  = 181        ! dim for plank function table
             101                     
             102                           integer, parameter :: nbdlw  = nbands
             103                     
             104                     !  ---  number of g-point in each band
             105                           integer  :: ng01, ng02, ng03, ng04, ng05, ng06, ng07, ng08,       &
             106                          &            ng09, ng10, ng11, ng12, ng13, ng14, ng15, ng16
             107                           parameter (ng01=10, ng02=12, ng03=16, ng04=14, ng05=16, ng06=08,  &
             108                          &           ng07=12, ng08=08, ng09=12, ng10=06, ng11=08, ng12=08,  &
             109                          &           ng13=04, ng14=02, ng15=02, ng16=02)
             110                     
             111                     !  ---  begining index of each band
             112                           integer  :: ns01, ns02, ns03, ns04, ns05, ns06, ns07, ns08,       &
             113                          &            ns09, ns10, ns11, ns12, ns13, ns14, ns15, ns16
             114                           parameter (ns01=00, ns02=10, ns03=22, ns04=38, ns05=52, ns06=68,  &
             115                          &           ns07=76, ns08=88, ns09=96, ns10=108, ns11=114,         &
             116                          &           ns12=122, ns13=130, ns14=134, ns15=136, ns16=138)
             117                     
             118                     !  ---  band indices for each g-point
             119                           integer, dimension(ngptlw) :: ngb
             120                           data ngb(:) / 10*1, 12*2, 16*3, 14*4, 16*5,  8*6, 12*7,  8*8,     & ! band  1- 8
             121                          &              12*9, 6*10, 8*11, 8*12, 4*13, 2*14, 2*15, 2*16 /      ! band  9-16
             122                     
             123                     !  ---  band spectrum structures (wavenumber in cm**-1)
             124                           real (kind=kind_phys) :: wvnlw1(nbands), wvnlw2(nbands)
             125                           data wvnlw1  /                                                    &
             126                          &         10.,  351.,  501.,  631.,  701.,  821.,  981., 1081.,    &
             127                          &       1181., 1391., 1481., 1801., 2081., 2251., 2381., 2601. /
             128                           data wvnlw2  /                                                    &
             129                          &        350.,  500.,  630.,  700.,  820.,  980., 1080., 1180.,    &
             130                          &       1390., 1480., 1800., 2080., 2250., 2380., 2600., 3250. /
             131                     
             132                           real (kind=kind_phys) :: delwave(nbands)
             133                           data delwave / 340., 150., 130.,  70., 120., 160., 100., 100.,    &
             134                          &               210.,  90., 320., 280., 170., 130., 220., 650. /
             135                     
             136                     !........................................!
             137                           end module module_radlw_parameters !

                                   <<<      pmassl, cqct, grain
                                   <<< Loop-information  End >>>
             572     2   p   2v            do 535 i = 1, nn
             573     2   p   2v            grain(i,itype)= -cqct(i,lev,itype)*pmassl(i,lev)
             574     2   p   2v        535 continue
             575     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pmassl, cqct, grain
                                   <<< Loop-information  End >>>

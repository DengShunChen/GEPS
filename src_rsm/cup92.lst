             518     2                       do 225 l = lt+1, lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.12, ITR: 72, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e, buof2, hc, buof1, awp, hswo
                                   <<< Loop-information  End >>>
             519     3  pp    v              do 225 i = 1, nn
             520     3   p    v              awp(i,lt) = awp(i,lt)+e(i,l-1)*buof1(i,l)*(hc(i,l-1) &
             521     3                                 - hswo(i,l))+e(i,l)*buof2(i,l)*(hc(i,l)-hswo(i,l))
             522     2   p    v        225   continue
             523     1               !
             524     1                     nflxlim = 0
             525     1                     otest= 1.0/ftest
                                   <<< Loop-information Start >>>

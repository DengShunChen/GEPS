             589     2  pp    v            do 810 i = 1,nn
             590     2   p    v              xmb(i) = xmb(i)  + flxmas(i,itype)
             591     2   p    v              rcup(i)= rcup(i) + flxmas(i,itype)* grain(i,itype)
             592     1   p    v        810 continue

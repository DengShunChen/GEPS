             526     2  pp    v            do 590 i = 1, nn
             527     3   p    v            if (exist(i,itype)) then
             528     3   p    v              akernl(i,itype) = (awp(i,itype) - cwork(i,itype))*otest
             529     3               !
             530     3               ! --- checking the diagnal component of the mass flux kernel
             531     3               !       (the criterion is arbitory)
             532     3               !
             533     4   p    v            if (akernl(i,itype) .gt. rkmin)  then
             534     4   p    v              akernl(i,itype) = rkmin
             535     4   p    v              negak           = negak + 1
             536     4   p                 endif
             537     3               !
             538     3   p    v            flxmas(i,itype) = -relaxas*aforce(i,itype)/akernl(i,itype)
             539     3               !
             540     4   p    v            if (flxmas(i,itype) .gt. rmfmax)  then
             541     4   p    v              flxmas(i,itype)= rmfmax
             542     4   p    v              nflxlim        = nflxlim + 1
             543     4   p                 endif
             544     3   p    v            endif
             545     2   p    v        590 continue
             546     1               !
             547     1                     ntcup(itype)= ilsum( nn,exist(1,itype),1 )
             548     1                     nflx(itype) =  nflxlim
             549     1               !
             550     1                 510 continue
             551                     !
             552                     !  how many convective grid points?
             553                     !
             554     1                     do 520 k = ktmin+1, lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 889

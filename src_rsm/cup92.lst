                                   <<< Loop-information  End >>>
             514     2  pp   2v            do 502 i = 1, nn
             515     2   p   2v            awp(i,lt)= e(i,lt)*buof2(i,lt)*(hc(i,lt)-hswo(i,lt))
             516     2   p   2v       502  continue
             517     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :

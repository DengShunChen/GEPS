             555     2  pp   2v            do 520 i = 1, nn
             556     2   p   2v            exist(i,ktmin)= exist(i,ktmin).or.exist(i,k)
             557     1   p   2v        520 continue
             558                           ncup= ilsum( nn,exist(1,ktmin),1 )
             559                           if (ncup.eq.0)  return
             560                     !
             561                     !  evaporation of cumulus precipitation
             562                     !
             563     1                     if (prevap.gt.0.0)  then
             564     1               !
             565     1                     call evpcup (nn,nx,lev,ktmin,prevap,ql,qls,pmassl,rain,cqct)
             566     1               !
             567     1                     endif
             568                     !
             569                     !  compute rain as equal to integrated column drying
             570                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cqct, pmassl, grain
                                   <<< Loop-information  End >>>
             571     1  pp                 do 525 itype = ktmin, lev-1
                                   <<< Loop-information Start >>>

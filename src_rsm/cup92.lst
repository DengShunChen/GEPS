                                   <<<      grain, pmassl, cqct
                                   <<< Loop-information  End >>>
             577     3   p   2v            do 525 i = 1, nn
             578     3   p   2v            grain(i,itype)= grain(i,itype)-cqct(i,k,itype)*pmassl(i,k)
             579     1   p   2v        525 continue

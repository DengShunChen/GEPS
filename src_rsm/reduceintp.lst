               1                           subroutine reduceintp(a,lonfd,lonf,latg)
               2                     !
               3                     ! do  mass conserving interpolation from different grid at given latitude
               4                     !
               5                     ! author: hann-ming henry juang 2008
               6                     !
               7                           use const, only: RTYPE
               8                     !
               9                           implicit none
              10                     
              11                     !
              12                           integer    lonf,latg,j,i,imp,lonfd(latg)
              13                           real(kind=RTYPE) a(lonf,latg)
              14                     !
              15                           real(kind=RTYPE) old(lonf),new(lonf)
              16                           real(kind=RTYPE) xpast(lonf+1),xnext(lonf+1)
              17                           real      two_pi,dxp,dxf,hfdxp,hfdxf,sc,pi
              18                     !
              19                     
              20                     ! ..................................
              21                     ! ..................................
              22                            pi  = 4.0 * atan(1.0)
              23                            two_pi = 2.0 * pi
              24                            dxf = two_pi / lonf
              25                            hfdxf = 0.5 * dxf
              26                     !$omp parallel do                                       &

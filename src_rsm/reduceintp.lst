              29     1   p                 do j=1,latg
              30     1   p                  imp=lonfd(j)
              31     2   p                  if( imp.ne.lonf ) then
              32     2   p                   dxp = two_pi / imp
              33     2   p                   hfdxp = 0.5 * dxp
              34     2               
              35     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

             881                     !---------------------------------------------------------------
             882                           subroutine split(nx,my,lenc,ifilout,nc,glob,mout,ihdg,ihdg2)
             883                     !
             884                           use rank
             885                           use const, only: RTYPE,kflag
             886                     !
             887                           implicit none
             888                     !
             889                           integer   nx,my,nc,istat,lenc,lev
             890                           real(kind=RTYPE) glob(nx,my),mout(nx,my)
             891                           character*26 ihdg,ihdg2
             892                           character*80 ifilout
             893                     
             894     1                     if (myrank .eq. nc) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      glob, mout
                                   <<< Loop-information  End >>>
             895     1  pp   4v              mout  = glob
             896     1                       ihdg2 = ihdg
             897     1                     endif
             898                             nc    = nc + 1
             899                     !
             900     1                     if ( nc .eq. nsize .and. myrank .lt. nc ) then
             901     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,mout,istat)
             902     1                       nc    = 0
             903     1                     endif
             904                     !
             905                           return
             906                           end


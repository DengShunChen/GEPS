             103                     !
             104                     !     local work arrays
             105                     !
             106                           logical cexist(im)
             107                           real      pl2(im,lm),tl2(im,lm),ql2(im,lm),pkc(im*lm)     &
             108                            , pkc2(im*lm),qls(im,lm),zl(im,lm),ssl(im,lm),hhl(im,lm) &
             109                            , qls2(im,lm),zl2(im,lm),phil2(im,lm),ssl2(im,lm)        &
             110                            , hhl2(im,lm),hhls(im,lm),hhls2(im,lm),pmassl(im,lm)     &
             111                            , gamwe(im,lm),plc(im*lm),tlc(im*lm),qlc(im,lm)          &
             112                            , hc(im,lm),qc(im,lm),cu(im,lm),e(im,lm),flxmas(im,lm)   &

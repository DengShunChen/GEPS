                                   <<<      kctop
                                   <<< Loop-information  End >>>
             182        pp   4v            kctop= 1
             183                     !
             184                           ktmin = lev
             185     1                     do 1012 l = lev-1, ktcup, -1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 348
                                   <<< Loop-information  End >>>
             186     2  pp    s            do 1012 i = 1,nxj

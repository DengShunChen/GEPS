                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, ql, qls, qlc, pmassl, pl2
                                   <<< Loop-information  End >>>
             151     2  pp    v            do 20 i = 1, nxj
             152     2   p    v              pl2(i,l) = ps(i)*sige +sigd + ptop
             153     2   p    v              pmassl(i,l) = (ps(i)*dsigma(l,1)+dsigma(l,2))*100.0/g
             154     2   p    v              qlc(i,l)= max(qmin, min(ql(i,l),qls(i,l)*0.999))
             155     1   p    v        20  continue
             156                     !
             157                           call creeve ( nxj,nx,lev,g,r,cp,hltm,pl,pl2,tl,qlc,topo,pk,pk2 &
             158                                       , qls,ssl,hhl,hhls,zl,phi,tl2,ql2,qls2,ssl2,hhl2   &

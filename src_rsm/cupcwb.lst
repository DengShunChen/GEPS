             189     2               !        .and.( kctop(i) .eq. 0 )) then
             190     3   p    v            if ((hbase(i).gt.hhls2(i,l)).and.(hbase(i).le.hhls2(i,l-1)) &
             191     3                        .and.( kctop(i) .eq. 1 )) then
             192     3   p    v            kctop(i) = l

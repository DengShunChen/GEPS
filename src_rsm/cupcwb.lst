             128                           xkapa = 1.0/3.5
             129                           xnx   = 1.0/float(nxj)
             130                           fac   = 86400.0 / dt
             131                           qmin  = 1.0e-10
             132                           const1= cp*0.608/hltm
             133                           gamfac= hltm*5417.9827*ocp
             134                     
             135                     !CWB2015
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

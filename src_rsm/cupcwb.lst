               1                           subroutine cupcwb ( jcup,nxj,nx,my,lev,ktcup,dt,g,r,cp,hltm,etop &
               2                                             , prevap,topo,ps,pl,pk,pk2,tl,ql,phi,plcl      &
               3                                             , cumtop,rcup,ncup,ptop,dsigma,nxx,dtcupx      &
               4                                             , dtcupz,dqcupz,idg,dtcupd,dqcupd              &
               5                                             , nlcl,nnegl,nosat,nwork,ntcup,nflx )
               6                     !
               7                     !***********************************************************************
               8                     !
               9                     !  1.   function description
              10                     !         perform cumulus parameterization
              11                     !
              12                     !  2.   common block specification
              13                     !          none
              14                     !
              15                     !  3.   parameter specification
              16                     !   input :
              17                     !     jcup      :   latitude index
              18                     !     nx        :   no of points in logitude direction
              19                     !     my        :   no of latitude rings
              20                     !     lev       :   vertical levels
              21                     !     ktcup     :   highest sigma level allowed for the top of
              22                     !                   highest cloud type
              23                     !     dt        :   time step used in this cup call
              24                     !     g         :   gravity (9.806)
              25                     !     r         :   gas constant (287.0)
              26                     !     cp        :   heat specific constant of the air (=1004.)
              27                     !     hltm      :   latent heat constant of water vapor (2.52e+6)
              28                     !     etop      :   coeff for cloud top enhanced entrain
              29                     !     prevap    :   fraction of falling precip evaporated
              30                     !     ptop      :   pressure at model top           (mb)
              31                     !     dsigma    :   sigma layer thickness (between even levels)
              32                     !     topo(nx)  :   terrain geopotential (m2/s2)
              33                     !     ps(nx)    :   terrain pressure - ptop (mb)
              34                     !     pl(nx,lev) :   pressure on model level
              35                     !     pk(nx,lev) :   p**capa on model levels
              36                     !     pk2(nx,lev):   p**capa on even levels
              37                     !     tl(nx,lev) :   temperature on model level
              38                     !     ql(nx,lev) :   water vapor mixing ratio on model level
              39                     !     phi(nx,lev):   odd level geopotential
              40                     !     idg       :   i-index address of selected point to print profile
              41                     !   output:
              42                     !     plcl(nx)  :   pressure value on cloud base (mb)
              43                     !     cumtop(nx):   pressure value on cloud top  (mb)
              44                     !     rcup(nx)  :   precipitation  due to cumulus convection (mm/call)
              45                     !     ncup      :   no of convective points in this call
              46                     !     nxx       :   2-d address index of the max heating point
              47                     !     dtcupx    :   max cup heating rate occurred in this call (k/day)
              48                     !     dtcupz(lev):   horiz. average of cup heating rate         (k/day)
              49                     !     dqcupz(lev):   horiz. average of cup moistening rate      (1/day)
              50                     !     dtcupd(lev):   cup heating    rate at selected point idg  (k/day)
              51                     !     dqcupd(lev):   cup moistening rate at selected point idg  (1/day)
              52                     !     nlcl(lev)  : no of clouds at level k with tops above lcl
              53                     !     nnegl(lev) : no of clouds at level k with positive lamda
              54                     !     nosat(lev) : no of clouds at level k with liquid water at top
              55                     !     nwork(lev) : no of clouds at level k with work func above ref
              56                     !     ntcup(lev) : no of clouds at level k with non-zero cbase masflx
              57                     !     nflx(lev)  : no of clouds exceeding mass flux limit
              58                     !
              59                     !   local work arrays
              60                     !
              61                     !     qls(im,lm):   saturation mixing ratio on model level
              62                     !     pl2(im,lm):   pressure on even level
              63                     !     pmassl(im,lm): mass in between model even sigma levels  (kg)
              64                     !                  = ps(i)*dsig(l)*100.0/g
              65                     !     dtcup(im,lm): temp. change due to cumulus convection    (k/call)
              66                     !     dqcup(im,lm): moisture change due to cumulus convection (1/call)
              67                     !
              68                     !  4.  calling modules
              69                     !          diabat
              70                     !
              71                     !  5.  usage
              72                     !
              73                     !        call cupcwb (jcup,nx,lev,ktcup,dt,g,r,cp,hltm,etop,prevap,ptop
              74                     !       1            ,dsigma,topo,ps,pl,pk,pk2,tl,ql,plcl,cumtop,rcup
              75                     !       2            ,ncup,imx,dtcupx,dtcupz,dqcupz,idg,dtcupd,dqcupd
              76                     !       3            ,nlcl,nnegl,nosat,nwork,ntcup,nflx )
              77                     !
              78                     !  6.  modules called
              79                     !          creeve , cup92
              80                     !
              81                     !  7.  date
              82                     !        created    by   c-s chen    ( cwb )    1992
              83                     !        modified   by   c-s liou and t rosmond 1993
              84                     !        modify to f90 by C-H Lee and sort by River Chen in 2015
              85                     !
              86                     !***********************************************************************
              87                     !
              88                           use paramt
              89                           use const, only : RTYPE
              90                     
              91                           implicit  none
              92                     
              93                           integer   jcup,nxj,nx,my,lev,ktcup,idg,nxx,ncup
              94                     

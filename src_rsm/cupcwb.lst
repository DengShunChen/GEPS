                                   <<<      tl2, qls2, cu, hc, qc, gamwe
                                   <<< Loop-information  End >>>
             162     2   p    v            do 12 i = 1,nxj
             163     2   p    v              gamwe(i,k) = gamfac*qls2(i,k)/(tl2(i,k)*tl2(i,k))
             164     2   p    v              qc(i,k)= 0.0
             165     2   p    v              hc(i,k)= 0.0
             166     2   p    v              cu(i,k)= 0.0
             167     1   p    v         12 continue
             168                     !
             169                     !     call dcbase to determine cloud base level and cloud base condition
             170                     !
             171                           call dcbase ( nxj,nx,lev,hltm,kcbase,zl2,qlc,qls2,hhl,hhls2,gamwe &

 External subroutine subprogram "adjptq"
  (inc)(line-no.)(nest)(optimize)
             328                     !
             329                           subroutine adjptq(dta,pltemp,pltend)
             330                     
             331                           use index
             332                           use mpe
             333                           use rank
             334                           use const
             335                           use param
             336                           use grid
             337                     
             338                           implicit none
             339                     
             340                           integer i,j,k,n,jj,kk,nxj,nxjf,kn
             341                           real    dsigp    ,qtot      ,qtota                    &
             342                                  ,sumtott  ,sumwatt   ,sumwatta                 &
             343                                  ,odpondp  ,dta
             344                           real(kind=RTYPE) pnew(nxp,my_max),pten(nxp,my_max)    &
             345                                           ,ww1(nx,my_max),pltemp(jtrun,jtmax,2) &
             346                                           ,pltend(jtrun,jtmax,2)
             347                     
             348                           ! adjustment of surface pressure
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             349     1  pp                 do jj = 1, jlistnum
             350     1   p                   j=jlist1(jj)
             351     1   p                   nxj=nxdef_2d(j)
             352     1   p                   nxjf=nxdef(j)
             353     2   p                   do i = 1,nxj
             354     2   p                     sumtott=0.
             355     2   p                     sumwatt=0.
             356     2   p                     sumwatta=0.
             357     3   p                     do k = 1, lev
             358     3   p                       dsigp = dsigma(k,1)*pt(i,jj)+dsigma(k,2)
             359     3   p                       qtot=0.
             360     3   p                       qtota=0.
             361     4   p   8                   do n = 1, ncld
             362     4   p   8                      kk=k+(n-1)*lev
             363     4   p   8                      qtot = qtot  + qp(i,kk,jj)
             364     4   p   8                      qtota= qtota + qt(i,kk,jj)
             365     4   p   8                   enddo
             366     3   p                       sumtott = sumtott  + dsigp
             367     3   p                       sumwatt = sumwatt  + dsigp * qtot
             368     3   p                       sumwatta= sumwatta + dsigp * qtota
             369     3   p                       tt(i,k,jj)  = tt(i,k,jj)*pk(i,k,jj) / (1.0+0.608*qt(i,k,jj))
             370     3   p                     enddo
             371     2   p                     pnew(i,jj) = sumtott - sumwatt + sumwatta
             372     2               
             373     2   p                   enddo
             374     1   p                 enddo
             375                     
             376                           call mpe2d_unify_nx(ww1,pnew)
             377                           call tranrs1(jtrun,jtmax,nx,my,my_max,poly,weight,ww1            &
             378                                       ,pltemp,nsizey)
             379                           call transr1(jtrun,jtmax,nx,my,my_max,poly,pltemp,pnew,nsizey)
             380                     
             381                           ! mass adjustment of all tracers and virtual potential temperature
             382                     
             383     1                     do jj = 1, jlistnum
             384     1                       j=jlist1(jj)
             385     1                       nxj=nxdef_2d(j)
             386     1                       call prexp_hybrid_cwb ( nxjp(j),nxp,lev,ptop,sigma,pnew(1,jj), &
             387     1                                               pk(1,1,jj),pk2(1,1,jj),plt(1,1,jj) )
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             388     2  pp                   do i = 1,nxj
             389     3   p                     do k = 1, lev
             390     3   p                       odpondp =  (dsigma(k,1)*pt(i,jj)+dsigma(k,2))              &
             391     3                                    / (dsigma(k,1)*pnew(i,jj)+dsigma(k,2))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 40, MVE: 11, POL: S)
                                   <<< Loop-information  End >>>
             392     4   p   2                   do n = 1, ncld
             393     4   p   2                     kk=k+(n-1)*lev
             394     4   p   2                     qt(i,kk,jj) = qt(i,kk,jj) * odpondp
             395     4   p   2                   enddo
             396     3   p                       tt(i,k,jj) = tt(i,k,jj)*(1.0+0.608*qt(i,k,jj))/pk(i,k,jj)
             397     3   p                     enddo
             398     2   p                     pten(i,jj) = ( pnew(i,jj) - ptp(i,jj) ) / dta
             399     2   p                   enddo
             400     1                     enddo
             401                     
             402                           call mpe2d_unify_nx(ww1,pten)
             403                           call tranrs1(jtrun,jtmax,nx,my,my_max,poly,weight,ww1            &
             404                                       ,pltend,nsizey)
             405                     
             406                           return
             407                           end


 External subroutine subprogram "GETFNAME"
  (inc)(line-no.)(nest)(optimize)
             204                     
             205                     
             206                           subroutine GETFNAME(pathname,logicfile,truefile,istat)
             207                           character pathname*80,logicfile*80,truefile*80,value*80,blank*80
             208                     !     integer getenv
             209                     
             210                           truefile(1:80)=' '
             211                           value(1:80)=' '
             212                           blank(1:80)=' '
             213                     !     i = getenv(pathname,value)
             214                     !     if (i .eq. 0) then
             215                           ix=index(pathname,' ')
             216                           call getenv(pathname(1:ix-1),value)
             217     1                     if (value(1:80) .eq. blank(1:80)) then
             218     1                	istat=-1
             219     1                     else
             220     1               	j=index(value,' ')
             221     1               	k=index(logicfile,' ')
             222     1               	truefile(1:j-1)=value(1:j-1)
             223     1               	truefile(j:j)='/'
             224     1               	truefile(j+1:j+k-1)=logicfile(1:k-1)
             225     1               	istat=0
             226     1                     endif
             227                           return
             228                           end


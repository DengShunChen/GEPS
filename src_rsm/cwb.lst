 External subroutine subprogram "ptot"
  (inc)(line-no.)(nest)(optimize)
             263                     
             264                           subroutine ptot(pdrym,lprint)
             265                     
             266                           use index
             267                           use mpe
             268                           use rank
             269                           use const
             270                           use param
             271                           use grid
             272                     
             273                           implicit none
             274                     
             275                           integer i,j,k,n,jj,kk,nxj,nxjf,kn
             276                           logical lprint
             277                           real    sumtot   ,sumwat    ,dsigp                    &
             278                                  ,sumtotm  ,sumwatm   ,pdrym                    &
             279                                  ,sumtott  ,sumwatt   ,qtot
             280                     
             281                     
             282                           ! dry air mass conservation
             283                           sumtot=0.
             284                           sumwat=0.
             285     1                     do jj = 1, jlistnum
             286     1                       j=jlist1(jj)
             287     1                       nxj=nxdef_2d(j)
             288     1                       nxjf=nxdef(j)
             289     2                       do i = 1,nxj
             290     2                         sumtott=0.
             291     2                         sumwatt=0.
             292     3                         do k = 1, lev
             293     3                           dsigp = dsigma(k,1)*pt(i,jj)+dsigma(k,2)
             294     3                           qtot=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<< Loop-information  End >>>
             295     4  pp                       do n = 1, ncld
             296     4   p                          kk=k+(n-1)*lev
             297     4   p                          qtot = qtot + qt(i,kk,jj)
             298     4   p                       enddo
             299     3                           sumtott = sumtott  + dsigp
             300     3                           sumwatt = sumwatt  + dsigp * qtot
             301     3                         enddo
             302     2                         sumtot = sumtot + sumtott * cosl(j) * nx / nxjf
             303     2                         sumwat = sumwat + sumwatt * cosl(j) * nx / nxjf
             304     2                       enddo
             305     1                     enddo
             306                     
             307                     !          call mpe_global_sum(kn,1,mpe_integer)
             308                           call mpe_global_sum(sumtot,1,mpe_double)
             309                           call mpe_global_sum(sumwat,1,mpe_double)
             310                     
             311                           kn      = nx * my
             312                           sumtotm = sumtot / float(kn)
             313                           sumwatm = sumwat / float(kn)
             314                           pdrym   = sumtotm - sumwatm
             315                     
             316     1                     if( myrank .eq. 0 .and. lprint ) then
             317     1                       open(35,file='pdry.txt',form='formatted',status='unknown', &
             318     1                            position='append')
             319     1                       write(35,*)pdrym,sumwatm,sumtotm
             320     1                       close(35)
             321     1                       print*,'dry air mass = ',pdrym,' hPa'
             322     1                       print*,'water mass = ',sumwatm,' hPa'
             323     1                       print*,'total air mass = ',sumtotm,' hPa'
             324     1                     endif
             325                     
             326                           return
             327                           end


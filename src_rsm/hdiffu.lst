 External subroutine subprogram "whdiffu"
  (inc)(line-no.)(nest)(optimize)
             283                     !
             284                     !--------------------------------------------------------------------
             285                           subroutine whdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             286                                             , rad,cosl,ut,vt,vornow,divnow,eps4,trefs)
             287                           use index
             288                           use mpe
             289                           use rank
             290                           use const, only : hdk1,hdk2,radsq,vd,RTYPE
             291                           use param, only : octahedral,af,mwhd
             292                     
             293                           implicit  none
             294                     
             295                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             296                           real      dta,rad
             297                     
             298                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             299                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             300                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             301                                            eps4(jtrun,jtmax),cosl(my)
             302                     !
             303                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             304                     !
             305                           real      wmax(lev)
             306                           real      windmax1,windmax2,windmax3
             307                     
             308                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             309                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             310                           real      hfilt2,hfilt4,hfilt6,nf,kfac,finc,fl
             311                           real      c1,c2,c3,c4
             312                           logical   windchk
             313                     
             314                           data      windmax1/80./, windmax2/100./, windmax3/130./
             315                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             316                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temnow
                                   <<< Loop-information  End >>>
             317        pp   4v            temnow = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             318        pp   4v            wmax(1:lev)= 0.0
             319                     !
             320     1                     do jj =1,jlistnum
             321     1                       j=jlist1(jj)
             322     1                       nxj=nxdef_2d(j)
             323     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             324     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             325     3   p   2v                do i=1,nxj
             326     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             327     3   p   2v                enddo
             328     2   p                   enddo
             329     1                     enddo
             330                     !
             331                           call mpe_global_max(wmax,lev,mpe_double)
             332                     !
             333                           nf=jtrun-1
             334                     !
             335                           finc = 10.*max(af,0.001)
             336                           fl   = 150./hdk2(2)-1.
             337                           hfilt6 = (radsq/(nf*(nf+1)))**3.
             338                           hfilt4 = (radsq/(nf*(nf+1)))**2.
             339                           hfilt2 = radsq/(nf*(nf+1))
             340     1                     if ( octahedral ) then
             341     1                       hfilt6 = hfilt6/(6.*dta)
             342     1                       hfilt4 = hfilt4/(6.*dta)
             343     1                       hfilt2 = hfilt2/(6.*dta)
             344     1                     else
             345     1                       hfilt6 = hfilt6/dta
             346     1                       hfilt4 = hfilt4/dta
             347     1                       hfilt2 = hfilt2/dta
             348     1                     endif
             349                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             350     1  pp                 do 100 k=1,levp  ! levp -> lev
             351     1               !
             352     1               !  compute diffusion coefficients
             353     1               !
             354     1               
             355     1   p                   KL=Llist(k)
             356     1               !
             357     1   p                   kfac = (fl+finc)*max(float(hdk2(2)-KL),0.)
             358     1   p                   facd = mwhd * max(amp,kfac)
             359     1   p                   facv = max(min(amp,1.),kfac)
             360     1               !!        fact = amp * kfacv
             361     1               !          endif
             362     1               
             363     1               !
             364     1               !  difuse vorticity and divergence fields
             365     1               !  diffuse moisture and temperature fields
             366     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             367     2   p                   do m=1,mlistnum
             368     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.18, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             369     3   p    v                do n=mf,jtrun
             370     3               
             371     3               !!            c1=1.+dta*facv*hfilt6*eps4(n,m)**3.
             372     3   p    v                  c1=1.+dta*facv*hfilt4*eps4(n,m)**2.
             373     3               !!            c2=1.+dta*facd*hfilt6*eps4(n,m)**3.
             374     3               !!            c2=1.+dta*facd*hfilt2*eps4(n,m)
             375     3               
             376     4   p    v                  if ( KL .le. hdk1 ) then
             377     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)+vd*exp(-0.5*(k-1))
             378     4   p    v                  else
             379     4   p    v                    c2=1.+dta*facd*hfilt4*eps4(n,m)**2.
             380     4   p    v                  endif
             381     3               
             382     3               !!            c3=1.+dta*fact*hfilt6*eps4(n,m)**3.
             383     3               !!            c3=1.+dta*fact*hfilt4*eps4(n,m)**2.
             384     3               
             385     3               
             386     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             387     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             388     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             389     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             390     3               !!            temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             391     3               !!            temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             392     3   p    v                enddo
             393     2   p                   enddo
             394     1   p            100  continue
             395                     !!
             396                     !
             397                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             398     1   s    v            do k=1,8
             399     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             400     1   p    v            enddo
             401                           if ( windchk ) &
             402                            call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             403                     !
             404                     !--------------------------------------------------------------------
             405                           return
             406                           end


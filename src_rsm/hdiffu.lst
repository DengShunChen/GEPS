 External subroutine subprogram "hdiffu"
  (inc)(line-no.)(nest)(optimize)
             157                     !
             158                           subroutine hdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             159                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
             160                                             , trefs)
             161                           use index
             162                           use mpe
             163                           use rank
             164                           use const, only : hdk1,hdk2,radsq,doskeb,onocos,wcfac,wdfac      &
             165                                           , poly,dpoly,hord,vd,factop,RTYPE
             166                           use param, only : octahedral
             167                     
             168                           implicit  none
             169                     
             170                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             171                           real      rad
             172                     
             173                           real(kind=RTYPE) dta
             174                           real(kind=RTYPE) vordiss(levp,2,jtrun,jtmax),divdiss(levp,2,jtrun,jtmax)
             175                     
             176                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             177                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             178                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),eps4(jtrun,jtmax),&
             179                                            cosl(my)
             180                     !
             181                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             182                     !
             183                           real      wmax(lev)
             184                           real      windmax1,windmax2,windmax3
             185                     
             186                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             187                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             188                           real      hfilt,nf,dec,coefu,powd,kfac,dect
             189                           real      c1,c2,c3
             190                           logical   windchk
             191                     
             192                           data      windmax1/80./, windmax2/100./, windmax3/130./
             193                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             194                     !
             195                     
             196                     !
             197                           nf=jtrun-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             198        pp   4v            wmax(1:lev)= 0.0
             199                     !
             200     1                     do jj =1,jlistnum
             201     1                       j=jlist1(jj)
             202     1                       nxj=nxdef_2d(j)
             203     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             204     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, ut
                                   <<< Loop-information  End >>>
             205     3   p   2v                do i=1,nxj
             206     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             207     3   p   2v                enddo
             208     2   p                   enddo
             209     1                     enddo
             210                     !
             211                           call mpe_global_max(wmax,lev,mpe_double)
             212                     !
             213                     !!      do k=1,lev
             214                     !!        if( wmax(k) .gt. windmax3 ) then
             215                     !!          if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
             216                     !!                                 ' windmax=',wmax(k)
             217                     !!        endif
             218                     !!      enddo
             219                     !
             220                     !
             221                           powd = float(hord) / 2.
             222                           hfilt  = (radsq/(nf*(nf+1)))**powd
             223                           coefu = factop/float(hdk2(1)-hdk1)
             224     1                     if ( octahedral ) then
             225     1                       hfilt  = hfilt/(6.*dta)
             226     1                     else
             227     1                       hfilt  = hfilt/dta
             228     1                     endif
             229                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             230     1  pp                 do 100 k=1,levp  ! levp -> lev
             231     1               !
             232     1               !  compute diffusion coefficients
             233     1               !
             234     1   p                   KL=Llist(k)
             235     1               !
             236     1   p                   kfac = min(coefu*max(float(hdk2(1)-KL),0.),factop)!  &
             237     1               !             + min(1.*max(float(hdk2(3)-KL),0.),4.)
             238     1               !        if ( KL .le. hdk1 ) kfac = kfac*(1.+vd*exp(-0.5*KL))
             239     1               !        kfac = kfac*(1.+vd*exp(-0.2*max(float(KL-hdk1),0.)))
             240     1   p                   dect = float(min(max(hdk1-KL,1-hdk1),hdk1-1))/float((hdk1-1))
             241     2   p                   if ( dect .ge. 0. ) then
             242     2   p                     dec  = 0.5*(1.+dect**(1./3.))
             243     2   p                   else
             244     2   p                     dect = -1.*dect
             245     2   p                     dec  = 0.5*(1.-dect**(1./3.))
             246     2   p                   endif
             247     1   p                   kfac = kfac*(1.+vd*dec)
             248     1   p                   facd = max(1.,kfac)*amp
             249     1   p                   facv = max(1.,kfac)*amp
             250     1   p                   fact = max(1.,kfac)*amp
             251     1               !!        facd = 1. * amp * (kfac + 2.*max(float(hdk1-KL),0.))
             252     1               !!        facv = 1. * (kfac + 1.*max(float(hdk1-KL),0.))
             253     1               !!        fact = 1. * (kfac + 1.*max(float(hdk1-KL),0.))
             254     1               !
             255     1               
             256     1               
             257     1               !
             258     1               !  difuse vorticity, divergence and temperature fields
             259     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             260     2   p                   do m=1,mlistnum
             261     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.20, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 6
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             262     3   p    v                do n=mf,jtrun
             263     3               
             264     3               !            if ( KL .le. hdk1 ) then
             265     3               !              c1=1.+dta*facv*hfilt*eps4(n,m)**powd+vd*exp(-0.7*k)
             266     3               !              c2=1.+dta*facd*hfilt*eps4(n,m)**powd+vd*exp(-0.7*k)
             267     3               !              c3=1.+dta*fact*hfilt*eps4(n,m)**powd+vd*exp(-0.7*k)
             268     3               !            else
             269     3   p    v                    c1=1.+dta*facv*hfilt*eps4(n,m)**powd
             270     3   p    v                    c2=1.+dta*facd*hfilt*eps4(n,m)**powd
             271     3   p    v                    c3=1.+dta*fact*hfilt*eps4(n,m)**powd
             272     3               !            endif
             273     3               
             274     3               !  if doskeb = .true. estimate the dissipation of kinectic energy for SKEB
             275     3   p    v                  vordiss(k,1,n,m)=(1.-1./c1)*vornow(k,1,n,m)
             276     3   p    v                  vordiss(k,2,n,m)=(1.-1./c1)*vornow(k,2,n,m)
             277     3   p    v                  divdiss(k,1,n,m)=(1.-1./c2)*divnow(k,1,n,m)
             278     3   p    v                  divdiss(k,2,n,m)=(1.-1./c2)*divnow(k,2,n,m)
             279     3               !
             280     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             281     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             282     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             283     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             284     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             285     3   p    v                  temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             286     3               !            temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             287     3               !            temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             288     3   p    v                enddo
             289     2   p                   enddo
             290     1   p            100  continue
             291                     !
             292                     !       estimate the dissipation of kinetic energy
             293     1                     if ( doskeb ) then
             294     1                        ! transfer the dissipation to grid point from spectrum
             295     1                        call tranuv (jtrun,jtmax,nx,my,my_max,levp,onocos,wcfac,wdfac &
             296     1                                   , poly,dpoly,vordiss,divdiss,ut,vt,nsizey)
             297     1                     endif
             298                     
             299                     !
             300                     !-------------------------------------------------------------------
             301                     !
             302                     !  filter layers near the upper bound if too strong wind speed
             303                     !  happens at the top layer
             304                     !
             305                     !  2003/10/7 :
             306                     !  sometimes wind speed greater than 100m/s happens at k=2
             307                     !
             308                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             309     1  pp    v            do k=1,hdk1
             310     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             311     1   p    v            enddo
             312     1                     if ( windchk ) then
             313     1                      call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             314     1                     end if
             315                     !--------------------------------------------------------------------
             316                           return
             317                           end


 External subroutine subprogram "filter_top"
  (inc)(line-no.)(nest)(optimize)
             602                     !
             603                     !--------------------------------------------------------------------
             604                           subroutine filter_top(jtrun,jtmax,lev,ktop,ncld,temnow     &
             605                                            ,vornow,divnow)
             606                     !
             607                     !  apply Lanczos filter to top "ktop" layers
             608                     !
             609                           use index
             610                           use mpe
             611                           use const, only: RTYPE
             612                     !
             613                           implicit  none
             614                     
             615                           integer   ktop,ktopm1
             616                     !      parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             617                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             618                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             619                     !
             620                           integer   jtrun,jtmax,lev,ncld
             621                     
             622                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax),  &
             623                                            vornow(lev,2,jtrun,jtmax),  &
             624                                            divnow(lev,2,jtrun,jtmax)
             625                     !
             626                           real      wvn_top(ktop+1),djt
             627                     
             628                           integer   k,mode,m,mf,n,nflt,IERR,KL
             629                           real      pi,flt,fac
             630                     !
             631                     
             632                     !2dMPI >
             633                     !     if(ktop.gt.levp)then
             634                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             635                     !        call MPI_FINALIZE(IERR)
             636                     !        stop
             637                     !     endif
             638                     !2dMPI <
             639                     
             640                     !      wvn_top(1) = jtrun*2./3.
             641                           wvn_top(1) = max(min(jtrun/3.,155.),55.)
             642                           wvn_top(ktop+1) = jtrun
             643                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             644                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.78, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wvn_top
                                   <<< Loop-information  End >>>
             645     1  pp    v            do k = 2, ktop
             646     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.5*(k-1))
             647     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             648     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             649     1   p    v            enddo
             650                     !
             651                           pi = 3.141596
             652                     !
             653                     !  mode = 0 : just truncate into assigned wavenumbers without
             654                     !             extra filtering
             655                     !  mode = 1 or other : add fitering along with truncating
             656                     !
             657                           mode = 1
             658                     !
             659     1                     if( mode .eq. 0 ) then
             660     2                       do k = 1, lev
             661     2               !2dMPI >
             662     2                       KL=Llist(k)
             663     3                       if( KL .le. ktop ) then
             664     3               !2dMPI <
             665     4                         do m = 1, mlistnum
             666     4                           mf=max(2,mlist(m))
             667     5                           do n = mf, jtrun
             668     5                             nflt = int ( wvn_top(k) / float(n) )
             669     5                             flt = min( 1.0, float(nflt) )
             670     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             671     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             672     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             673     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             674     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             675     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             676     5                           enddo
             677     4                         enddo
             678     3               !          do m = 1, mlistnum
             679     3               !            mf=max(2,mlist(m))
             680     3               !            do n = mf, jtrun
             681     3               !              nflt = int ( wvn_top(k) / float(n) )
             682     3               !              flt = min( 1.0, float(nflt) )
             683     3               !              do nc=1,ncld
             684     3               !                kk=(nc-1)*lev+k
             685     3               !                qnow(kk,1,n,m)  = qnow(kk,1,n,m)*flt
             686     3               !                qnow(kk,2,n,m)  = qnow(kk,2,n,m)*flt
             687     3               !              enddo
             688     3               !            enddo
             689     3               !          enddo
             690     3               !2dMPI >
             691     3                       endif
             692     2               !2dMPI <
             693     2                       enddo
             694     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             695     2  pp                   do k = 1, lev
             696     2               !2dMPI >
             697     2   p                   KL=Llist(k)
             698     3   p                   if( KL .le. ktop ) then
             699     3               !2dMPI <
             700     4   p                     do m = 1, mlistnum
             701     4   p                       mf=max(2,mlist(m))

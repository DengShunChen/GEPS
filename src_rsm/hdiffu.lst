 External subroutine subprogram "filter_top"
  (inc)(line-no.)(nest)(optimize)
             407                     !
             408                     !--------------------------------------------------------------------
             409                           subroutine filter_top(jtrun,jtmax,lev,ktop,ncld,temnow     &
             410                                            ,vornow,divnow)
             411                     !
             412                     !  apply Lanczos filter to top "ktop" layers
             413                     !
             414                           use index
             415                           use mpe
             416                           use const, only: RTYPE
             417                     !
             418                           implicit  none
             419                     
             420                           integer   ktop,ktopm1
             421                     !      parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             422                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             423                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             424                     !
             425                           integer   jtrun,jtmax,lev,ncld
             426                     
             427                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax),  &
             428                                            vornow(lev,2,jtrun,jtmax),  &
             429                                            divnow(lev,2,jtrun,jtmax)
             430                     !
             431                           real      wvn_top(ktop+1),djt
             432                     
             433                           integer   k,mode,m,mf,n,nflt,IERR,KL
             434                           real      pi,flt,fac
             435                     !
             436                     
             437                     !2dMPI >
             438                     !     if(ktop.gt.levp)then
             439                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             440                     !        call MPI_FINALIZE(IERR)
             441                     !        stop
             442                     !     endif
             443                     !2dMPI <
             444                     
             445                     !      wvn_top(1) = jtrun*2./3.
             446                           wvn_top(1) = max(min(jtrun/3.,155.),55.)
             447                           wvn_top(ktop+1) = jtrun
             448                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             449                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 56, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wvn_top
                                   <<< Loop-information  End >>>
             450     1  pp    v            do k = 2, ktop
             451     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.7*(k-1))
             452     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             453     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             454     1   p    v            enddo
             455                     !
             456                           pi = 3.141596
             457                     !
             458                     !  mode = 0 : just truncate into assigned wavenumbers without
             459                     !             extra filtering
             460                     !  mode = 1 or other : add fitering along with truncating
             461                     !
             462                           mode = 1
             463                     !
             464     1                     if( mode .eq. 0 ) then
             465     2                       do k = 1, lev
             466     2               !2dMPI >
             467     2                       KL=Llist(k)
             468     3                       if( KL .le. ktop ) then
             469     3               !2dMPI <
             470     4                         do m = 1, mlistnum
             471     4                           mf=max(2,mlist(m))
             472     5                           do n = mf, jtrun
             473     5                             nflt = int ( wvn_top(k) / float(n) )
             474     5                             flt = min( 1.0, float(nflt) )
             475     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             476     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             477     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             478     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             479     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             480     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             481     5                           enddo
             482     4                         enddo
             483     3               !          do m = 1, mlistnum
             484     3               !            mf=max(2,mlist(m))
             485     3               !            do n = mf, jtrun
             486     3               !              nflt = int ( wvn_top(k) / float(n) )
             487     3               !              flt = min( 1.0, float(nflt) )
             488     3               !              do nc=1,ncld
             489     3               !                kk=(nc-1)*lev+k
             490     3               !                qnow(kk,1,n,m)  = qnow(kk,1,n,m)*flt
             491     3               !                qnow(kk,2,n,m)  = qnow(kk,2,n,m)*flt
             492     3               !              enddo
             493     3               !            enddo
             494     3               !          enddo
             495     3               !2dMPI >
             496     3                       endif
             497     2               !2dMPI <
             498     2                       enddo
             499     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             500     2  pp                   do k = 1, lev
             501     2               !2dMPI >
             502     2   p                   KL=Llist(k)
             503     3   p                   if( KL .le. ktop ) then
             504     3               !2dMPI <
             505     4   p                     do m = 1, mlistnum
             506     4   p                       mf=max(2,mlist(m))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.75, ITR: 48, MVE: 3, POL: S)
                                   <<< Loop-information  End >>>
             507     5   p    v                  do n = mf, jtrun
             508     5   p    v                    fac = min(wvn_top(k),float(n-1)) * pi / wvn_top(k)
             509     5   p    v                    flt = sin(fac)/fac
             510     5   p    v                    vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             511     5   p    v                    divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             512     5   p    v                    temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             513     5   p    v                    vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             514     5   p    v                    divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             515     5   p    v                    temnow(k,2,n,m)= temnow(k,2,n,m)*flt
             516     5   p    v                  enddo
             517     4   p                     enddo
             518     3               !          do m = 1, mlistnum
             519     3               !            mf=max(2,mlist(m))
             520     3               !            do n = mf, jtrun
             521     3               !              fac = min(wvn_top(k),float(n-1)) * pi / wvn_top(k)
             522     3               !              flt = sin(fac)/fac
             523     3               !              do nc=1,ncld
             524     3               !                kk=(nc-1)*lev+k
             525     3               !                qnow(kk,1,n,m)  = qnow(kk,1,n,m)*flt
             526     3               !                qnow(kk,2,n,m)  = qnow(kk,2,n,m)*flt
             527     3               !              enddo
             528     3               !            enddo
             529     3               !          enddo
             530     3               !2dMPI >
             531     3   p                   endif
             532     2               !2dMPI <
             533     2   p                   enddo
             534     1                     endif
             535                     !
             536                           return
             537                           end


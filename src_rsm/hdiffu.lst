 External subroutine subprogram "filter_top_3tl"
  (inc)(line-no.)(nest)(optimize)
             808                     !
             809                     !--------------------------------------------------------------------
             810                           subroutine filter_top_3tl(jtrun,jtmax,lev,ncld,temnow     &
             811                                            ,vornow,divnow)
             812                     !
             813                     !  apply Lanczos filter to top "ktop" layers
             814                     !
             815                           use index
             816                           use mpe
             817                           use const, only : RTYPE
             818                     !
             819                           implicit  none
             820                     
             821                           integer   ktop,ktopm1
             822                           parameter ( ktop=10, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             823                     !     parameter ( ktop=4, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             824                     !     parameter ( ktop=6, ktopm1=ktop-1 ) ! top "ktop" levels are filtered
             825                     !
             826                           integer   jtrun,jtmax,lev,ncld
             827                     
             828                           real(kind=RTYPE) temnow(lev,2,jtrun,jtmax), &
             829                                            vornow(lev,2,jtrun,jtmax), &
             830                                            divnow(lev,2,jtrun,jtmax)
             831                     !
             832                           real      wvn_top(ktop+1),djt
             833                     
             834                           integer   k,mode,m,mf,n,nflt,IERR,KL
             835                           real      pi,flt,fac
             836                     !
             837                     
             838                     !2dMPI >
             839                     !     if(ktop.gt.levp)then
             840                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             841                     !        call MPI_FINALIZE(IERR)
             842                     !        stop
             843                     !     endif
             844                     !2dMPI <
             845                     
             846                     !      wvn_top(1) = jtrun*1./3.
             847                           wvn_top(1) = 155
             848                           wvn_top(ktop+1) = jtrun
             849                     !!      djt = ( wvn_top(ktop) - wvn_top(1) ) / ktopm1
             850                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             851     1   s    v            do k = 2, ktop
             852     1   p    v              djt = ( wvn_top(ktop+1) - wvn_top(1) ) * exp(-0.7*(k-1))
             853     1               !        wvn_top(k) = (jtrun + wvn_top(k-1))*0.5
             854     1   p    v              wvn_top(k) = min( wvn_top(ktop+1) - djt , float(jtrun) )
             855     1   p    v            enddo
             856                     !
             857                           pi = 3.141596
             858                     !
             859                     !  mode = 0 : just truncate into assigned wavenumbers without
             860                     !             extra filtering
             861                     !  mode = 1 or other : add fitering along with truncating
             862                     !
             863                           mode = 1
             864                     !
             865     1                     if( mode .eq. 0 ) then
             866     2                       do k = 1, lev
             867     2               !2dMPI >
             868     2                       KL=Llist(k)
             869     3                       if( KL .le. ktop ) then
             870     3               !2dMPI <
             871     4                         do m = 1, mlistnum
             872     4                           mf=max(2,mlist(m))
             873     5                           do n = mf, jtrun
             874     5                             nflt = int ( wvn_top(k) / float(n) )
             875     5                             flt = min( 1.0, float(nflt) )
             876     5                             vornow(k,1,n,m)= vornow(k,1,n,m)*flt
             877     5                             divnow(k,1,n,m)= divnow(k,1,n,m)*flt
             878     5                             temnow(k,1,n,m)= temnow(k,1,n,m)*flt
             879     5                             vornow(k,2,n,m)= vornow(k,2,n,m)*flt
             880     5                             divnow(k,2,n,m)= divnow(k,2,n,m)*flt
             881     5                             temnow(k,2,n,m)= temnow(k,2,n,m)*flt

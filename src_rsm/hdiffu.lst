 External subroutine subprogram "ohdiffu"
  (inc)(line-no.)(nest)(optimize)
             318                     !
             319                     !--------------------------------------------------------------------
             320                           subroutine ohdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             321                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
             322                                             , trefs)
             323                     !     horizontal diffusion for Cubic Truncation Octahedral Reduced
             324                     !     Gaussain grid (under testing for now) -- 03/03/2020 Pang-Yang Liu
             325                           use index
             326                           use mpe
             327                           use rank
             328                           use const, only : hdk1,hdk2,radsq,RTYPE
             329                           use param, only : octahedral
             330                     
             331                           implicit  none
             332                     
             333                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             334                           real      rad
             335                     
             336                           real(kind=RTYPE) dta
             337                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             338                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             339                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             340                                            eps4(jtrun,jtmax),cosl(my)
             341                     !
             342                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             343                     !
             344                           real      wmax(lev)
             345                           real      windmax1,windmax2,windmax3
             346                     
             347                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             348                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             349                           real      hfilt,hfilt2,nf,ncut,ncor,kfac
             350                           real      c1,c2,c3
             351                           logical   windchk
             352                     
             353                           data      windmax1/80./, windmax2/100./, windmax3/130./
             354                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             355                     !
             356                     
             357                     !
             358                           nf=jtrun-1
             359                           ncut=0.5*jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             360        pp   4v            wmax(1:lev)= 0.0
             361                     !
             362     1                     do jj =1,jlistnum
             363     1                       j=jlist1(jj)
             364     1                       nxj=nxdef_2d(j)
             365     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             366     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, ut
                                   <<< Loop-information  End >>>
             367     3   p   2v                do i=1,nxj
             368     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             369     3   p   2v                enddo
             370     2   p                   enddo
             371     1                     enddo
             372                     !
             373                           call mpe_global_max(wmax,lev,mpe_double)
             374                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3200
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             375     1  pp    s            do k=1,lev
             376     2   p    s              if( wmax(k) .gt. windmax3 ) then
             377     2   p    v                if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
             378     2                                                ' windmax=',wmax(k)
             379     2   p    s              endif
             380     1   p    s            enddo
             381                     !
             382                     !
             383                           hfilt = (radsq/(nf*(nf+1)))**2.
             384                           hfilt = hfilt/(6.*dta)
             385                           hfilt2 = radsq/(nf*(nf+1))
             386                           hfilt2 = hfilt2/(6.*dta)
             387                     
             388                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             389     1  pp                 do 100 k=1,levp  ! levp -> lev
             390     1               !
             391     1               !  compute diffusion coefficients
             392     1               !
             393     1               
             394     1   p                    KL=Llist(k)
             395     1               !
             396     1   p                    kfac  = min(5.*max(float(hdk2(1)-KL),0.),60.)
             397     1   p                    facd = amp + kfac
             398     1   p                    facv = amp + kfac
             399     1   p                    fact = amp + kfac
             400     1               !         facd= 1.0 + max(float(hdk2(1)-KL),0.)
             401     1               !         facv= 1.0 + max(float(hdk2(1)-KL),0.)
             402     1               !         fact= 1.0 + max(float(hdk2(1)-KL),0.)
             403     1               
             404     1               !         if ( KL .le. hdk1 ) facd=facd*(1.+float(hdk1-KL))
             405     1               !
             406     1               !          facd = amp * facd
             407     1               !          facv = amp * facv
             408     1               !          fact = amp * fact
             409     1               !
             410     1               
             411     1               !
             412     1               !  difuse vorticity and divergence fields
             413     1               !  diffuse moisture and temperature fields
             414     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             415     2   p                   do m=1,mlistnum
             416     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             417     3   p    v                do n=mf,jtrun
             418     3   p    v                  ncor=1.
             419     4   p    v                  if ( n .gt. ncut ) then
             420     4   p    v                    ncor=exp(-0.5*( (n-jtrun)**2. / (n-ncut)**2. ))
             421     4   p    v                  else
             422     4   p    v                    ncor=0.
             423     4   p    v                  endif
             424     3   p    v                  c3=1.+dta*fact*hfilt*ncor*eps4(n,m)**2
             425     3               
             426     3   p    v                  ncor=min(ncor+0.2*max(float(hdk2(1)-KL),0.),1.)
             427     3   p    v                  c1=1.+dta*facv*hfilt*ncor*eps4(n,m)**2
             428     4   p    v                  if ( KL .le. hdk1 ) then
             429     4               !              c2=1.+dta*facd*hfilt2*ncor*eps4(n,m)
             430     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)
             431     4   p    v                  else
             432     4   p    v                    c2=1.+dta*facd*hfilt*ncor*eps4(n,m)**2
             433     4   p    v                  endif
             434     3               
             435     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             436     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             437     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             438     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             439     3   p    v                  temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             440     3   p    v                  temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             441     3               !            temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             442     3               !            temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             443     3   p    v                enddo
             444     2   p                   enddo
             445     1   p            100  continue
             446                     !
             447                     !-------------------------------------------------------------------
             448                     !
             449                     !  filter layers near the upper bound if too strong wind speed
             450                     !  happens at the top layer
             451                     !
             452                     !  2003/10/7 :
             453                     !  sometimes wind speed greater than 100m/s happens at k=2
             454                     !
             455                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             456     1  pp    v            do k=1,hdk1
             457     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             458     1   p    v            enddo
             459                     !

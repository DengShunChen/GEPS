 External subroutine subprogram "whdiffu"
  (inc)(line-no.)(nest)(optimize)
             466                     !
             467                     !--------------------------------------------------------------------
             468                           subroutine whdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             469                                             , rad,cosl,ut,vt,vornow,divnow,temnow          &
             470                                             , eps4,trefs)
             471                           use index
             472                           use mpe
             473                           use rank
             474                           use const, only : hdk1,hdk2,radsq,vd,factop,RTYPE,hord
             475                           use param, only : octahedral
             476                     
             477                           implicit  none
             478                     
             479                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             480                           real      rad
             481                     
             482                           real(kind=RTYPE) dta
             483                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             484                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             485                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             486                                            eps4(jtrun,jtmax),cosl(my)
             487                     !
             488                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             489                     !
             490                           real      wmax(lev)
             491                           real      windmax1,windmax2,windmax3
             492                     
             493                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             494                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu,dec,dect
             495                           real      hfilt,nf,kfac,fl,powd
             496                           real      c1,c2,c3,c4
             497                           logical   windchk
             498                     
             499                           data      windmax1/80./, windmax2/100./, windmax3/130./
             500                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             501                     !
             502                     !      temnow = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             503        pp   4v            wmax(1:lev)= 0.0
             504                     !
             505     1                     do jj =1,jlistnum
             506     1                       j=jlist1(jj)
             507     1                       nxj=nxdef_2d(j)
             508     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             509     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.48, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, ut
                                   <<< Loop-information  End >>>
             510     3   p   2v                do i=1,nxj
             511     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             512     3   p   2v                enddo
             513     2   p                   enddo
             514     1                     enddo
             515                     !
             516                           call mpe_global_max(wmax,lev,mpe_double)
             517                     !
             518                           nf=jtrun-1
             519                     !
             520                           powd = float(hord) / 2.
             521                           fl   = factop/float(hdk2(1)-hdk1)
             522                           hfilt = (radsq/(nf*(nf+1)))**powd
             523     1                     if ( octahedral ) then
             524     1                       hfilt = hfilt/(6.*dta)
             525     1                     else
             526     1                       hfilt = hfilt/dta
             527     1                     endif
             528                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             529     1  pp                 do 100 k=1,levp  ! levp -> lev
             530     1               !
             531     1               !  compute diffusion coefficients
             532     1               !
             533     1               
             534     1   p                   KL=Llist(k)
             535     1               !
             536     1   p                   kfac = min(fl*max(float(hdk2(1)-KL),0.),factop)!    &
             537     1               !              + min(1.*max(float(hdk2(3)-KL),0.),4.)
             538     1               !        if ( KL .le. hdk1 ) kfac = kfac*(1.+vd*exp(-0.5*KL))
             539     1               !        kfac = kfac*(1.+vd*exp(-0.5*max(float(KL-hdk1),0.)))
             540     1   p                   dect = float(min(max(hdk1-KL,1-hdk1),hdk1-1))/float((hdk1-1))
             541     2   p                   if ( dect .ge. 0. ) then
             542     2   p                     dec  = 0.5*(1.+dect**(1./3.))
             543     2   p                   else
             544     2   p                     dect = -1.*dect
             545     2   p                     dec  = 0.5*(1.-dect**(1./3.))
             546     2   p                   endif
             547     1   p                   kfac = kfac*(1.+vd*dec)
             548     1               
             549     1               !        facd = mwhd * max(amp,kfac)
             550     1               !        facv = max(min(amp,1.),kfac)
             551     1   p                   facd = max(1.,kfac)*amp
             552     1   p                   facv = max(1.,kfac)*amp
             553     1   p                   fact = max(1.,kfac)*amp
             554     1               !!        fact = amp * kfacv
             555     1               !          endif
             556     1               
             557     1               !
             558     1               !  difuse vorticity and divergence fields
             559     1               !  diffuse moisture and temperature fields
             560     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<< Loop-information  End >>>
             561     2   p                   do m=1,mlistnum
             562     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 21
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             563     3   p    v                do n=mf,jtrun
             564     3               
             565     3               !            if ( KL .le. hdk1 ) then
             566     3               !              c1=1.+dta*facv*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             567     3               !              c2=1.+dta*facd*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             568     3               !              c3=1.+dta*fact*hfilt4*eps4(n,m)**2.+vd*exp(-0.7*k)
             569     3               !            else
             570     3   p    v                    c1=1.+dta*facv*hfilt*eps4(n,m)**powd
             571     3   p    v                    c2=1.+dta*facd*hfilt*eps4(n,m)**powd
             572     3   p    v                    c3=1.+dta*fact*hfilt*eps4(n,m)**powd
             573     3               !            endif
             574     3               
             575     3               
             576     3               

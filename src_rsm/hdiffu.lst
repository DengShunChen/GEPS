               1                           subroutine hdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
               2                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
               3                                             , trefs)
               4                           use index
               5                           use mpe
               6                           use rank
               7                           use const, only : hdk1,hdk2,radsq,hord,vd,RTYPE
               8                           use param, only : octahedral,af
               9                     
              10                           implicit  none
              11                     
              12                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
              13                           real      rad
              14                           real      dta
              15                     
              16                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
              17                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
              18                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),eps4(jtrun,jtmax),&
              19                                            cosl(my)
              20                     !
              21                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
              22                     !
              23                           real      wmax(lev)
              24                           real      windmax1,windmax2,windmax3
              25                     
              26                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
              27                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu,finc
              28                           real      hfilt,hfilt2,nf,dec,coefu,factop,powd,kfac
              29                           real      c1,c2,c3
              30                           logical   windchk
              31                     
              32                           data      windmax1/80./, windmax2/100./, windmax3/130./
              33                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
              34                     !
              35                     
              36                     !
              37                           nf=jtrun-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
              38        pp   4v            wmax(1:lev)= 0.0
              39                     !
              40     1                     do jj =1,jlistnum
              41     1                       j=jlist1(jj)
              42     1                       nxj=nxdef_2d(j)
              43     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
              44     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
              45     3   p   2v                do i=1,nxj
              46     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
              47     3   p   2v                enddo
              48     2   p                   enddo
              49     1                     enddo
              50                     !
              51                           call mpe_global_max(wmax,lev,mpe_double)
              52                     !
              53                     !!      do k=1,lev
              54                     !!        if( wmax(k) .gt. windmax3 ) then
              55                     !!          if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
              56                     !!                                 ' windmax=',wmax(k)
              57                     !!        endif
              58                     !!      enddo
              59                     !
              60                     !
              61                           finc = 10.*max(af,0.001)
              62                           powd = float(hord) / 2.
              63                           hfilt  = (radsq/(nf*(nf+1)))**powd
              64                           hfilt2 = radsq/(nf*(nf+1))
              65                           factop = 1.5
              66                           coefu = factop/float(hdk2(3)-hdk2(2))
              67     1                     if ( octahedral ) then
              68     1                       hfilt  = hfilt/(6.*dta)
              69     1                       hfilt2 = hfilt2/(6.*dta)
              70     1                     else
              71     1                       hfilt  = hfilt/dta
              72     1                       hfilt2 = hfilt2/dta
              73     1                     endif
              74                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
              75     1  pp                 do 100 k=1,levp  ! levp -> lev
              76     1               !
              77     1               !  compute diffusion coefficients
              78     1               !
              79     1   p                   KL=Llist(k)
              80     1               !
              81     1   p                   kfac  = (1.+finc)*max(float(hdk2(1)-KL),0.)
              82     1   p                   facd = max(amp,kfac)
              83     1   p                   facv = max(min(amp,1.),kfac)
              84     1   p                   fact = max(min(amp,1.),kfac)
              85     1               !!        facd = 1. * amp * (kfac + 2.*max(float(hdk1-KL),0.))
              86     1               !!        facv = 1. * (kfac + 1.*max(float(hdk1-KL),0.))
              87     1               !!        fact = 1. * (kfac + 1.*max(float(hdk1-KL),0.))
              88     1               !
              89     1               !  difuse vorticity and divergence fields
              90     1               !  diffuse moisture and temperature fields
              91     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
              92     2   p                   do m=1,mlistnum
              93     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              94     3   p    v                do n=mf,jtrun
              95     3               
              96     3   p    v                  c1=1.+dta*facv*hfilt*eps4(n,m)**powd
              97     3   p    v                  c3=1.+dta*fact*hfilt*eps4(n,m)**powd
              98     3               
              99     4   p    v                  if ( KL .le. hdk1 ) then
             100     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)+vd*exp(-0.5*(k-1))
             101     4   p    v                  else
             102     4   p    v                    c2=1.+dta*facd*hfilt*eps4(n,m)**powd
             103     4   p    v                  endif
             104     3               
             105     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             106     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             107     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             108     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             109     3               !!            temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             110     3               !!            temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             111     3   p    v                  temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             112     3   p    v                  temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             113     3   p    v                enddo
             114     2   p                   enddo
             115     1   p            100  continue
             116                     !
             117                     !-------------------------------------------------------------------
             118                     !
             119                     !  filter layers near the upper bound if too strong wind speed
             120                     !  happens at the top layer
             121                     !
             122                     !  2003/10/7 :
             123                     !  sometimes wind speed greater than 100m/s happens at k=2
             124                     !
             125                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             126     1   s    v            do k=1,8
             127     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             128     1   p    v            enddo
             129     1                     if ( windchk ) then
             130     1                      call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             131     1                     end if
             132                     !--------------------------------------------------------------------
             133                           return
             134                           end


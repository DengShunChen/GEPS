              38        pp   4v            wmax(1:lev)= 0.0
              39                     !
              40     1                     do jj =1,jlistnum
              41     1                       j=jlist1(jj)
              42     1                       nxj=nxdef_2d(j)
              43     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
              44     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>

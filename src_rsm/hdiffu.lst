             734                     !
             735                     !--------------------------------------------------------------------
             736                           subroutine filter_skeb(jtrun,jtmax,lev,dissest,wvn_top)
             737                     !
             738                     !  apply Lanczos filter to estimation of kinetic energy dissipation.
             739                     !
             740                           use index
             741                           use mpe
             742                           use const, only : RTYPE
             743                     !
             744                           implicit  none
             745                     
             746                     !
             747                           integer   jtrun,jtmax,lev,ncld
             748                     
             749                           real(kind=RTYPE) dissest(lev,2,jtrun,jtmax)
             750                     !
             751                           real      wvn_top
             752                     
             753                           integer   k,mode,m,mf,n,nflt,IERR,KL
             754                           real      pi,flt,fac
             755                     !
             756                     
             757                     !2dMPI >
             758                     !     if(ktop.gt.levp)then
             759                     !        print *,'filter_top fatal: ktop greater than lev partial !'
             760                     !        call MPI_FINALIZE(IERR)
             761                     !        stop
             762                     !     endif
             763                     !2dMPI <
             764                     
             765                     !
             766                           pi = 3.141596
             767                     !
             768                     !  mode = 0 : just truncate into assigned wavenumbers without
             769                     !             extra filtering
             770                     !  mode = 1 or other : add fitering along with truncating
             771                     !
             772                           mode = 1
             773                     !
             774     1                     if( mode .eq. 0 ) then
             775     2                       do k = 1, lev
             776     2               !2dMPI >
             777     2                       KL=Llist(k)
             778     3                         do m = 1, mlistnum
             779     3                           mf=max(2,mlist(m))
             780     4                           do n = mf, jtrun
             781     4                             nflt = int ( wvn_top / float(n) )
             782     4                             flt = min( 1.0, float(nflt) )
             783     4                             dissest(k,1,n,m)= dissest(k,1,n,m)*flt
             784     4                             dissest(k,2,n,m)= dissest(k,2,n,m)*flt
             785     4                           enddo
             786     3                         enddo
             787     2               !2dMPI <
             788     2                       enddo
             789     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             790     2  pp                   do k = 1, lev
             791     2               !2dMPI >
             792     2   p                   KL=Llist(k)
             793     3   p                     do m = 1, mlistnum
             794     3   p                       mf=max(2,mlist(m))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.37, ITR: 48, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             795     4   p    v                  do n = mf, jtrun
             796     4   p    v                    fac = min(wvn_top,float(n-1)) * pi / wvn_top
             797     4   p    v                    flt = sin(fac)/fac
             798     4   p    v                    dissest(k,1,n,m)= dissest(k,1,n,m)*flt
             799     4   p    v                    dissest(k,2,n,m)= dissest(k,2,n,m)*flt
             800     4   p    v                  enddo
             801     3   p                     enddo
             802     2               !2dMPI <
             803     2   p                   enddo
             804     1                     endif
             805                     !
             806                           return
             807                           end


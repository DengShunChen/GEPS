 External subroutine subprogram "ohdiffu"
  (inc)(line-no.)(nest)(optimize)
             135                     !
             136                     !--------------------------------------------------------------------
             137                           subroutine ohdiffu ( dta,my,my_max,nx,jtrun,jtmax,lev,ncld,amp   &
             138                                             , rad,cosl,ut,vt,vornow,divnow,temnow,eps4     &
             139                                             , trefs)
             140                     !     horizontal diffusion for Cubic Truncation Octahedral Reduced
             141                     !     Gaussain grid (under testing for now) -- 03/03/2020 Pang-Yang Liu
             142                           use index
             143                           use mpe
             144                           use rank
             145                           use const, only : hdk1,hdk2,radsq,RTYPE
             146                           use param, only : octahedral,af
             147                     
             148                           implicit  none
             149                     
             150                           integer   my,my_max,nx,jtrun,jtmax,lev,ncld
             151                           real      dta,rad
             152                     
             153                           real(kind=RTYPE) vornow(levp,2,jtrun,jtmax),divnow(levp,2,jtrun,jtmax),  &
             154                                            temnow(levp,2,jtrun,jtmax),trefs(levp,2,jtrun,jtmax),   &
             155                                            ut(nxp,lev,my_max),vt(nxp,lev,my_max),                  &
             156                                            eps4(jtrun,jtmax),cosl(my)
             157                     !
             158                     !     parameter ( ktop=4, ktop2=ktop/2 ) ! top "ktop" levels are inhenced
             159                     !
             160                           real      wmax(lev)
             161                           real      windmax1,windmax2,windmax3
             162                     
             163                           integer   jj,j,nxj,k,i,m,n,mf,nc,kk,KL
             164                           real      xx,facd,facv,fact,amp,ddiffu,vdiffu,tdiffu
             165                           real      hfilt,hfilt2,nf,ncut,ncor,kfac,finc
             166                           real      c1,c2,c3
             167                           logical   windchk
             168                     
             169                           data      windmax1/80./, windmax2/100./, windmax3/130./
             170                     !!      data      windmax1/70./, windmax2/100./, windmax3/130./
             171                     !
             172                     
             173                     !
             174                           finc = 10.*max(af,0.001)
             175                           nf=jtrun-1
             176                           ncut=0.5*jtrun
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             177        pp   4v            wmax(1:lev)= 0.0
             178                     !
             179     1                     do jj =1,jlistnum
             180     1                       j=jlist1(jj)
             181     1                       nxj=nxdef_2d(j)
             182     1                       xx=rad/cosl(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             183     2  pp                   do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.43, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, vt
                                   <<< Loop-information  End >>>
             184     3   p   2v                do i=1,nxj
             185     3   p   2v                  wmax(k)= max(wmax(k),xx*sqrt(ut(i,k,jj)**2+vt(i,k,jj)**2))
             186     3   p   2v                enddo
             187     2   p                   enddo
             188     1                     enddo
             189                     !
             190                           call mpe_global_max(wmax,lev,mpe_double)
             191                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3200
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmax
                                   <<< Loop-information  End >>>
             192     1  pp    s            do k=1,lev
             193     2   p    m              if( wmax(k) .gt. windmax3 ) then
             194     2   p    s                if(myrank.eq.0)print *,'wmax gt windmax at','k= ',k,         &
             195     2                                                ' windmax=',wmax(k)
             196     2   p    v              endif
             197     1   p    v            enddo
             198                     !
             199                     !
             200                           hfilt = (radsq/(nf*(nf+1)))**2.
             201                           hfilt = hfilt/(6.*dta)
             202                           hfilt2 = radsq/(nf*(nf+1))
             203                           hfilt2 = hfilt2/(6.*dta)
             204                     
             205                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
             206     1  pp                 do 100 k=1,levp  ! levp -> lev
             207     1               !
             208     1               !  compute diffusion coefficients
             209     1               !
             210     1               
             211     1   p                    KL=Llist(k)
             212     1               !
             213     1   p                    kfac  = min((5.+finc)*max(float(hdk2(1)-KL),0.),60.+5.*finc)
             214     1   p                    facd = amp + kfac
             215     1   p                    facv = amp + kfac
             216     1   p                    fact = amp + kfac
             217     1               !         facd= 1.0 + max(float(hdk2(1)-KL),0.)
             218     1               !         facv= 1.0 + max(float(hdk2(1)-KL),0.)
             219     1               !         fact= 1.0 + max(float(hdk2(1)-KL),0.)
             220     1               
             221     1               !         if ( KL .le. hdk1 ) facd=facd*(1.+float(hdk1-KL))
             222     1               !
             223     1               !          facd = amp * facd
             224     1               !          facv = amp * facv
             225     1               !          fact = amp * fact
             226     1               !
             227     1               
             228     1               !
             229     1               !  difuse vorticity and divergence fields
             230     1               !  diffuse moisture and temperature fields
             231     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             232     2   p                   do m=1,mlistnum
             233     2   p                     mf=mlist(m)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      eps4
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             234     3   p    v                do n=mf,jtrun
             235     3   p    v                  ncor=1.
             236     4   p    v                  if ( n .gt. ncut ) then
             237     4   p    v                    ncor=exp(-0.5*( (n-jtrun)**2. / (n-ncut)**2. ))
             238     4   p    v                  else
             239     4   p    v                    ncor=0.
             240     4   p    v                  endif
             241     3   p    v                  c3=1.+dta*fact*hfilt*ncor*eps4(n,m)**2
             242     3               
             243     3   p    v                  ncor=min(ncor+0.2*max(float(hdk2(1)-KL),0.),1.)
             244     3   p    v                  c1=1.+dta*facv*hfilt*ncor*eps4(n,m)**2
             245     4   p    v                  if ( KL .le. hdk1 ) then
             246     4               !              c2=1.+dta*facd*hfilt2*ncor*eps4(n,m)
             247     4   p    v                    c2=1.+dta*facd*hfilt2*eps4(n,m)
             248     4   p    v                  else
             249     4   p    v                    c2=1.+dta*facd*hfilt*ncor*eps4(n,m)**2
             250     4   p    v                  endif
             251     3               
             252     3   p    v                  vornow(k,1,n,m)=vornow(k,1,n,m)/c1
             253     3   p    v                  vornow(k,2,n,m)=vornow(k,2,n,m)/c1
             254     3   p    v                  divnow(k,1,n,m)=divnow(k,1,n,m)/c2
             255     3   p    v                  divnow(k,2,n,m)=divnow(k,2,n,m)/c2
             256     3               !            temnow(k,1,n,m)=(temnow(k,1,n,m)+(c3-1.)*trefs(k,1,n,m))/c3
             257     3               !            temnow(k,2,n,m)=(temnow(k,2,n,m)+(c3-1.)*trefs(k,2,n,m))/c3
             258     3   p    v                  temnow(k,1,n,m)=temnow(k,1,n,m)/c3
             259     3   p    v                  temnow(k,2,n,m)=temnow(k,2,n,m)/c3
             260     3   p    v                enddo
             261     2   p                   enddo
             262     1   p            100  continue
             263                     !
             264                     !-------------------------------------------------------------------
             265                     !
             266                     !  filter layers near the upper bound if too strong wind speed
             267                     !  happens at the top layer
             268                     !
             269                     !  2003/10/7 :
             270                     !  sometimes wind speed greater than 100m/s happens at k=2
             271                     !
             272                           windchk=.false.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             273     1   s    v            do k=1,8
             274     1   p                   if ( wmax(k) .gt. windmax3 ) windchk=.true.
             275     1   p    v            enddo
             276                     !
             277     1                     if ( windchk ) then
             278     1                      call filter_top(jtrun,jtmax,levp,hdk1,ncld,temnow,vornow,divnow)
             279     1                     end if
             280                     !--------------------------------------------------------------------
             281                           return
             282                           end


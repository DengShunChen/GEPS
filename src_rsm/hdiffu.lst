                                   <<<      eps4
                                   <<< Loop-information  End >>>
             114     3   p    v                do n=mf,jtrun
             115     3               
             116     3   p    v                  c1=1.+dta*facv*hfilt*eps4(n,m)**2
             117     3   p    v                  c3=1.+dta*fact*hfilt*eps4(n,m)**2
             118     3               
             119     4   p    v                  if ( KL .le. hdk1 ) then

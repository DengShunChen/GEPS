              32                           REAL(kind=RTYPE) wrk(lev,2,3,jtrun,jtmax)
              33                           CALL mpe2d_unify_spec_lev_zx(wrk,vorten,divten,phiten,lev,levp,jtrun,jtmax,mlistnum,nsizex,row_comm)
              34                     
              35                     !

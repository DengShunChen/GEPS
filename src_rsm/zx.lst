               2                           subroutine zx(evec,vorten,divten,phiten,jtrun,jtmax,lev)
               3                     !
               4                     !  purpose : do vertical transform and inverse transform
               5                     !------------------------------------------------------------------------
               6                     !  **** input ****
               7                     !  evec   : matrix array for transform
               8                     !  vorten : vorticity tendency(correction) array of spectrum coefficients
               9                     !  divten : divergence tendency(correction) array of spectrum coefficients
              10                     !  phiten : geopotential tendency(correction)array of spectrum coefficients

 External subroutine subprogram "qmaxn3p"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine qmaxn3p(fld,t1,t2,i1,j1,k1,im,jm,lm)
               2                     !
               3                     !  subroutine to print max and min in 2-d layer (or a subarray)
               4                     !  within a 3-d field stored with n-s index slowest varying
               5                     !
               6                     !  ***input***
               7                     !
               8                     !  fld: input array
               9                     !  t1,t2: 2* 8 character caption
              10                     !  i1: starting index of first dimension (e-w)
              11                     !  j1: starting index of third dimension (n-s)
              12                     !  k1: starting index of second dimension (vertical)
              13                     !  im: first dimension
              14                     !  jm: third dimension
              15                     !  lm: second dimension
              16                     !
              17                     ! *****************************************************************
              18                     !
              19                           use mpe
              20                           use rank
              21                           use index
              22                     !
              23                           implicit   none
              24                           integer    i1,j1,k1,im,jm,lm
              25                           real       fld(im,lm,jm)
              26                     !
              27                           character*8 t1, t2
              28                     
              29                           real       xmin,xmax
              30                           integer    imin,jmin,imax,jmax,jj,j,i,idummy
              31                     !
              32                           xmin= 1.0e25
              33                           xmax= -1.0e25
              34                           imin=1
              35                           jmin=1
              36                           imax=1
              37                           jmax=1
              38                     !
              39     1                     do 20 jj =1,jlistnum
              40     1                     j=jlist1(jj)
              41     2                     if(j .ge. j1) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 616
                                   <<< Loop-information  End >>>
              42     3  pp    s            do 10 i=i1,im
              43     4   p    s            if (fld(i,k1,jj).le.xmin) then
              44     4   p    s            xmin= fld(i,k1,jj)
              45     4   p    m            jmin= j
              46     4   p    v            imin= i
              47     4   p    v            endif
              48     4   p    s            if (fld(i,k1,jj).gt.xmax) then
              49     4   p    s            xmax= fld(i,k1,jj)
              50     4   p    m            jmax= j
              51     4   p    v            imax= i
              52     4   p    m            endif
              53     3   p    s         10 continue
              54     2                     endif
              55     1                  20 continue
              56                     !
              57                           call mpe_global_maxloc(xmax,2,jmax,imax,idummy,idummy,mpe_double)
              58                           call mpe_global_minloc(xmin,2,jmin,imin,idummy,idummy,mpe_double)
              59                     !
              60                           if(myrank .eq. 0) print 9000, t1, t2
              61                      9000 format (1h0,2a8)
              62                           if(myrank .eq. 0) print 8995, imax,jmax,xmax,imin,jmin,xmin
              63                      8995 format(' imax=',i4,' jmax=',i4,' xlarg=',g20.12   &
              64                           ,' imin=',i4,' jmin=',i4,' xsmal=',g20.12)
              65                     !
              66                           return
              67                           end


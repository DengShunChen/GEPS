 External subroutine subprogram "ccoszen"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine ccoszen ( nx,my,my_max,julian,time,alat,alon,cosz)
               2                     !
               3                     !     compute cos(zenith angle) from day, zulu-time, alat and alon
               4                     !     for global model only ( alat(my),  alon(nx,my) )
               5                     !
               6                     !  modify to f90 in 2015 by C-H Lee and sort by River Chen in 2015
               7                     !
               8                           use index
               9                     
              10                           implicit  none
              11                     
              12                           integer   nx,my,my_max,julian
              13                           real      time
              14                           real      alat(my),alon(nx,my_max),cosz(nxp,my_max)
              15                     !
              16                           integer   i,jj,j,nxj,ii
              17                           real      pi,d2r,beta,xlat,sinxl,cosxl,hdif,dtzu
              18                           real      timeg,hourg,plon,sinz0,cosz0,dlon
              19                     !
              20                           pi = 4.0*atan(1.0)
              21                           d2r = pi/180.0
              22                           beta = 2.*pi*julian/365.
              23                           xlat = 0.006918 - 0.399912*cos(beta) + 0.070257*sin(beta) &
              24                                - 0.006758*cos(2.*beta) + 0.000907*sin(2.*beta)      &
              25                                - 0.002697*cos(3.*beta) + 0.001480*sin(3.*beta)
              26                           sinxl = sin(xlat)
              27                           cosxl = cos(xlat)
              28                     !
              29                           hdif = 0.000075 + 0.001868*cos(beta) - 0.032077*sin(beta) &
              30                                - 0.014615*cos(2.*beta) - 0.040849*sin(2.*beta)
              31                           dtzu = time - 12.0
              32                           if(dtzu .lt. 0.) dtzu=dtzu+24.
              33                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      map2to1, cosz
                                   <<< Loop-information  End >>>
              34     1  pp                 do 200 jj = 1, jlistnum
              35     1   p                  j=jlist1(jj)
              36     1   p                  nxj=nxdef(j)
              37     1   p                  dlon = 360./float(nxj)
              38     1   p                  sinz0  = sinxl*sin(alat(j)*d2r)
              39     1   p                  cosz0  = cosxl*cos(alat(j)*d2r)
              40     1               !ch      do 100 i = 1, nxj
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.30, ITR: 128, MVE: 7, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      map2to1, cosz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 84
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              41     2   p    v               do 100 i = 1, nxdef_2d(j)
              42     2               !ch      plon = (i-1)*dlon
              43     2   p    v               ii=map2to1(i,j)
              44     2   p    v               plon = (ii-1)*dlon
              45     2   p    v               timeg = (dtzu*15.0 + plon) * d2r
              46     2   p    v               hourg = timeg + hdif
              47     2   p    v               cosz(i,jj) = cosz0*cos(hourg) + sinz0
              48     2   p    v        100    continue
              49     1   p             200 continue
              50                     !
              51                           return
              52                           end


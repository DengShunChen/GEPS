              40                           real      ff(nxp,lev,my_max),pkout(lpout)                        &
              41                           , pk(nxp,lev,my_max),tensy(lev+1),pklp(nxp,my_max)               &
              42                           , flp(nxp,my_max)
              43                     !
              44                           real(kind=RTYPE) fxx(nxp,lev+1),fyy(nxp,lev+1),pjy(nxp,lpout,4)  &
              45                           , tp1(nxp,lpout,4),pkk(nxp,lev+1),f(nxp,lev+1)                   &
              46                           , pout(nxp,lpout),t(nxp,my_max,lpout)
              47                     
              48                           integer   ipt(nxp,lpout)
              49                     !
              50                     !      real      wk1(nx,my)
              51                     !
              52                     !          compute ipt and pjy
              53                     !
              54                           levp1= lev+1
              55                           jym2=levp1-2

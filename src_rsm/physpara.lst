 Module "physpara"
  (inc)(line-no.)(nest)(optimize)
               1                     !!!!!  ==========================================================  !!!!!
               2                     !!!!!                    module physparam description              !!!!!
               3                     !!!!!  ==========================================================  !!!!!
               4                     !                                                                      !
               5                     !     This module defines commonly used control variables/parameters   !
               6                     !     in physics related programs.                                     !
               7                     !                                                                      !
               8                     !     Section 1 contains control variables defined in the form of      !
               9                     !     parameter. They are pre-determined choices and not adjustable    !
              10                     !     during model's run-time.                                         !
              11                     !                                                                      !
              12                     !     Section 2 contains control variables defined as module variables.!
              13                     !     They are more flexible to be changed during run-time by either   !
              14                     !     through input namelist, or through model environment condition.  !
              15                     !     They are preassigned here as the default values.                 !
              16                     !                                                                      !
              17                     !                                                                      !
              18                     !   program history:                                                   !
              19                     !     nov 2012 - y-t hou     created to place many physics related     !
              20                     !              model control variables in a easy to access/adjust      !
              21                     !              place.  run time determined control variables are marked!
              22                     !              by save atribute and assigned by their default values.  !
              23                     !              while for those less changed control variables are given!
              24                     !              a parameter atribute.                                   !
              25                     !     may 2014 - h-m lin/y-t hou  changed lw and sw control flags for  !
              26                     !              cloud liquid/ice property schemes 'ilwliq, ilwice,      !
              27                     !              iswliq, iswice' from the fixed 'parameter' atribute to  !
              28                     !              adjustable 'save' atribute.                             !
              29                     !                                                                      !
              30                     !!!!!  ==========================================================  !!!!!
              31                     
              32                     !========================================!
              33                           module physpara                   !
              34                     !........................................!
              35                     !
              36                     !     implicit   none
              37                     
              38                     !  --- ...  define kind parameters here
              39                     
              40                     !   ** if already exist, use the module containing kind definitions
              41                           use machine
              42                     
              43                     !   ** otherwise, define kind parameter here
              44                     !     implicit   none
              45                     !     integer, public, parameter :: kind_io4 = 4
              46                     !     integer, public, parameter :: kind_io8 = 8
              47                     !     integer, public, parameter :: kind_phys= selected_real_kind(13,60) ! the '60' maps to 64-bit real
              48                     !      .....
              49                     
              50                     !     implicit   none
              51                     !
              52                           public
              53                     
              54                     !==================================================================================
              55                     !  Section - 1 -
              56                     !     for main radiation modules
              57                     !     control flags with parameter atribute are pre-set as run-time non-adjuztable.
              58                     !     control flags with save atribute are run-time adjustable
              59                     !==================================================================================
              60                     
              61                     ! ............................................. !
              62                     !  -1.1- control flags for sw radiation         !
              63                     ! ............................................. !
              64                           integer,parameter :: iswrate = 2  ! sw heating rate unit control flag
              65                                                             ! =1:k/day; =2:k/second.
              66                           integer, save     :: iswrgas = 1  ! sw rare gases effect control flag (ch4,n2o,o2,...)
              67                                                             ! =0:no; =1:yes.
              68                           integer, save     :: iswmode = 2  ! sw control flag for 2-stream transfer scheme
              69                                                             ! =1:delta-eddington    (joseph et al., 1976)
              70                                                             ! =2:pifm               (zdunkowski et al., 1980)
              71                                                             ! =3:discrete ordinates (liou, 1973)
              72                           integer, save     :: iswcliq = 1  ! sw optical property for liquid clouds
              73                                                             ! =0:input cld opt depth, ignoring iswcice setting
              74                                                             ! =1:input cwp,rew, use hu and stamnes(1993) method
              75                                                             ! =2:not defined yet
              76                           integer, save     :: iswcice = 3  ! sw optical property for ice clouds (only iswcliq>0)
              77                                                             ! =0:not defined yet
              78                                                             ! =1:input cip,rei, use ebert and curry (1992) method
              79                                                             ! =2:input cip,rei, use streamer v3.0 (2001) method
              80                                                             ! =3:input cip,rei, use fu's method (1996) method
              81                     
              82                     
              83                     ! ............................................. !
              84                     !  -1.2- control flags for lw radiation         !
              85                     ! ............................................. !
              86                           integer,parameter :: ilwrate = 2  ! lw heating rate unit (1:k/day; 2:k/second)
              87                                                             ! =1:k/day; =2:k/second.
              88                           integer, save     :: ilwrgas = 1  ! lw rare gases effect control flag (ch4,n2o,o2,cfcs...)
              89                                                             ! =0:no; =1:yes.
              90                           integer, save     :: ilwcliq = 1  ! lw optical property for liquid clouds
              91                                                             ! =0:input cld opt depth, ignoring ilwcice setting
              92                                                             ! =1:input cwp,rew, use hu and stamnes(1993) method
              93                                                             ! =2:not defined yet
              94                           integer, save     :: ilwcice = 3  ! lw optical property for ice clouds (only ilwcliq>0)
              95                                                             ! =0:not defined yet
              96                                                             ! =1:input cip,rei, use ebert and curry (1992) method
              97                                                             ! =2:input cip,rei, use streamer (1996) method
              98                                                             ! =3:input cip,rei, use fu's method (1998) method
              99                     
             100                     ! ............................................. !
             101                     !  -1.3- control flag for lw aerosol property   !
             102                           logical, save     :: lalw1bd =.false. ! =t: use 1 broad-band lw aeros properties
             103                                                                 ! =f: use multi bands aeros properites
             104                     
             105                     
             106                     
             107                     
             108                     !==================================================================================
             109                     !  Section - 2 -
             110                     !     values of control flags might be re-set in initialization subroutines
             111                     !       (may be adjusted at run time based on namelist input or run condition)
             112                     !==================================================================================
             113                     
             114                     ! ............................................. !
             115                     !  -2.1- for module radiation_astronomy         !
             116                     ! ............................................. !
             117                           integer, save :: isolar  = 0      ! solar constant scheme control flag
             118                     
             119                           character, save :: solar_file*26  ! external solar constant data table
             120                     !     data solar_file   / 'solarconstantdata.txt     ' /
             121                           data solar_file   / 'solarconstant_noaa_a0.txt ' /
             122                     
             123                     ! ............................................. !
             124                     !  -2.2- for module radiation_aerosols          !
             125                     ! ............................................. !
             126                           integer, save :: iaermdl = 0      ! aerosol model scheme control flag
             127                           integer, save :: iaerflg = 0      ! aerosol effect control flag
             128                     
             129                           logical, save :: lalwflg = .true. ! lw aerosols effect control flag
             130                           logical, save :: laswflg = .true. ! sw aerosols effect control flag
             131                           logical, save :: lavoflg = .true. ! stratospheric volcanic effect flag
             132                     
             133                           character, save :: aeros_file*26  ! external aerosols data file
             134                     !     data aeros_file   / 'climaeropac_global.txt    ' /
             135                           data aeros_file   / 'aerosol.dat               ' /
             136                     
             137                     ! ............................................. !
             138                     !  -2.3- for module radiation_gases             !
             139                     ! ............................................. !
             140                           integer, save :: ico2flg = 0      ! co2 data source control flag
             141                           integer, save :: ictmflg = 0      ! external data time/date control flag
             142                           integer, save :: ioznflg = 1      ! ozone data source control flag
             143                     
             144                           character, save :: co2dat_file*26 ! external co2 2d monthly obsv data table
             145                           character, save :: co2gbl_file*26 ! external co2 global annual mean data tb
             146                           character, save :: co2usr_file*26 ! external co2 user defined data table
             147                           character, save :: co2cyc_file*26 ! external co2 clim monthly cycle data tb
             148                           data co2dat_file   / 'co2historicaldata_2004.txt' /   !year is run-time selected
             149                           data co2gbl_file   / 'co2historicaldata_glob.txt' /
             150                           data co2usr_file   / 'co2userdata.txt           ' /
             151                           data co2cyc_file   / 'co2monthlycyc.txt         ' /
             152                     
             153                     ! ............................................. !
             154                     !  -2.4- for module radiation_clouds            !
             155                     ! ............................................. !
             156                           integer, save :: icldflg = 1      ! cloud optical property scheme control flag
             157                           integer, save :: icmphys = 1      ! cloud microphysics scheme control flag
             158                           integer, save :: iovrsw  = 1      ! cloud overlapping control flag for sw
             159                           integer, save :: iovrlw  = 1      ! cloud overlapping control flag for lw
             160                     
             161                           logical, save :: lcrick  =.false. ! eliminating CRICK control flag
             162                           logical, save :: lcnorm  =.false. ! in-cld condensate control flag
             163                           logical, save :: lnoprec =.false. ! precip effect on radiation flag (ferrier microphysics)
             164                           logical, save :: lsashal =.false. ! shallow convection flag
             165                     
             166                           logical, save :: lgfdlmprad =.true.  ! GFDL MP and radiation consistency flag
             167                           logical, save :: effr_in =.true. ! flag for using effective radii of hydrometeors in radiation process (GFDLMP)
             168                           logical, save :: is_aerosol_aware =.false. ! flag for aerosol-aware Thompson MP
             169                           logical, save :: merra2_aerosol_aware =.false. ! flag for MERRA2 aerosol-aware Thompson MP
             170                     
             171                     ! ............................................. !
             172                     !  -2.5- for module radiation_surface           !
             173                     ! ............................................. !
             174                           integer, save :: ialbflg = 0      ! surface albedo scheme control flag
             175                           integer, save :: iemsflg = 0      ! surface emissivity scheme control flag
             176                     
             177                           character, save :: semis_file*26  ! external sfc emissivity data table
             178                           data semis_file   / 'sfc_emissivity_idx.txt    ' /
             179                     
             180                     ! ............................................. !
             181                     !  -2.6- general purpose                        !
             182                     ! ............................................. !
             183                     
             184                     !cmy  integer, save :: ivflip  = 1      ! vertical profile indexing flag
             185                           integer, save :: ivflip  = 0      ! vertical profile indexing flag
             186                           integer, save :: isubcsw = 0      ! sub-column cloud approx flag in sw radiation
             187                           integer, save :: isubclw = 0      ! sub-column cloud approx flag in lw radiation
             188                           integer, save :: ipsd0   = 0      ! initial permutation seed for mcica radiation
             189                     !
             190                     !...................................!
             191                           end module physpara           !

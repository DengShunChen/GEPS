             153     1                                   *(tt(i,k)-that(i,k+1))*odpsig(i,k)
             154     1   p    v          6 continue
             155                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, that, sd, rdiv, odpsig, ddtemp
                                   <<< Loop-information  End >>>
             156     1  pp                 do 61 k=2,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 64, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, that, sd, rdiv, odpsig, ddtemp
                                   <<< Loop-information  End >>>
             157     2   p    v            do 61 i=1,nxj
             158     2   p    v              ddtemp(i,k)= rdiv(i,k)*(tt(i,k)-tbar(k))+(sd(i,k+1)*(tt(i,k)      &
             159     2                                   -that(i,k+1))+sd(i,k)*(that(i,k)-tt(i,k)))*odpsig(i,k)
             160     1   p    v         61 continue
             161                     !
             162                           k=lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 80, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd, odpsig, tt, that, rdiv, ddtemp
                                   <<< Loop-information  End >>>
             163     1  pp    v            do 62 i=1,nxj
             164     1   p    v              ddtemp(i,k)= rdiv(i,k)*(tt(i,k)-tbar(k))+sd(i,k)                  &
             165     1                                   *(that(i,k)-tt(i,k))*odpsig(i,k)
             166     1   p    v         62 continue
             167                     !
             168                     !  horizontal advection of temperature
             169                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, ut, vt, tadvu, tadvv
                                   <<< Loop-information  End >>>
             170     1  pp                 do 8 k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, tt, ut, tadvu, tadvv
                                   <<< Loop-information  End >>>
             171     2   p   2v            do 8 i=1,nxj
             172     2   p   2v              tadvv(i,k)= (tt(i,k)-tbar(k))*vt(i,k)
             173     2   p   2v              tadvu(i,k)= (tt(i,k)-tbar(k))*ut(i,k)
             174     1   p   2v          8 continue
             175                     !
             176                     !  'vdmerd': meridional contribution to vorticity and divergence tendenc
             177                     !  'vdzonl': zonal contribution to vorticity and divergence tendencies
             178                     !
             179                           k=1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 267
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.71, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ut, odpsig, rvor, spal, vt, dtpl, dlpl
                                   <<<      sd, vdzonl, vdmerd
                                   <<< Loop-information  End >>>
             180     1  pp    v            do 12 i=1,nxj
             181     1   p    v              vdmerd(i,k)= spal(i,k)*dtpl(i)/onocos+0.5*sd(i,k+1)               &
             182     1                                 *(vt(i,k+1)-vt(i,k))*odpsig(i,k)+ut(i,k)*(rvor(i,k)+cor)

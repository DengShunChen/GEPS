               1                           subroutine gridnl_hybrid ( nxj,nx,lev,ncld                        &
               2                                             , cp,radsq,ut,vt,rdiv,rvor,tt,qt,phi            &
               3                                             , pt,dtpl,dlpl,pk,pk2,dsigma,sigma,tbar,qbar    &
               4                                             , onocos,cor,deldm,ddtemp,tadvu,qvadv           &
               5                                             , qadvu,diveng,tadvv,qadvv,vdmerd,vdzonl        &
               6                                             , sdpbl,sd,ptop )
               7                     !
               8                     !  real to spectral transformation, compute non-linear contributions
               9                     !  to spectral tendencies
              10                     !
              11                     !  **** input variables ****
              12                     !
              13                     !  nx:  e-w dimension
              14                     !  lev: no. of vertical levels
              15                     !  cp: specific heat of air
              16                     !  radsq: radius of earth squared
              17                     !  ut: gridpt e-w velocity (scaled)
              18                     !  vt: gridpt n-s velocity (scaled)
              19                     !  rdiv: gridpt divergence
              20                     !  rvor: gridpt vorticity
              21                     !  tt: gridpt virtual potential temp
              22                     !  qt: gridpt specific humidity
              23                     !  phi: geopotential
              24                     !  pt: gridpt terrain pressure
              25                     !  dtpl: d(pt)/dy
              26                     !  dlpl: d(pt)/dx
              27                     !  pk: exner function on full(odd) levels
              28                     !  pk2: exner function on half(even) levels
              29                     !  dsigma: thickness of sigma layers
              30                     !  sigma: sigma level values
              31                     !  tbar: global mean temperature on each odd model level
              32                     !  qbar: global mean spec humid on each odd model level
              33                     !  onocos: 1.0/(cos(lat)**2)
              34                     !  cor: coriolis on each gaussian latitude
              35                     !
              36                     ! *** output variables ***
              37                     !
              38                     !  deldm: terrain pressure tendency
              39                     !  ddtemp: vertical advection of temp tendency
              40                     !  tadvu: zonal advection part of temp tendency
              41                     !  qvadv: vertical advection of moisture tendency
              42                     !  qadvu: zonal advection part of moisture tendency
              43                     !  diveng: energy term of divergence equation
              44                     !  tadvv: meridianal advection part of temp tendency
              45                     !  qadvv: meridional advection part of moisture tendency
              46                     !  vdmerd: meridional advection term of divergence/vorticity tends
              47                     !  vdzonl: zonal advection term of divergence/vorticity tends
              48                     !
              49                     !  modify to f90 by C-H Lee and sort by River Chen in 2015
              50                     !
              51                     ! ******************************************************************
              52                     !
              53                           implicit  none
              54                     
              55                           integer   nxj,nx,lev,ncld
              56                           real      cp,radsq,onocos,cor,ptop
              57                     
              58                           real      ut(nx,lev),vt(nx,lev),rdiv(nx,lev),rvor(nx,lev)         &
              59                           , tt(nx,lev),qt(nx,lev*ncld),pt(nx),dlpl(nx),dtpl(nx),pk(nx,lev)  &
              60                           , phi(nx,lev),pk2(nx,lev),dsigma(lev,2),sigma(lev+1,2),tbar(lev)  &
              61                           , qbar(lev*ncld)
              62                     !
              63                           real      deldm(nx),ddtemp(nx  ,lev),tadvu(nx  ,lev)              &
              64                           , qvadv(nx  ,lev*ncld),qadvu(nx  ,lev*ncld),diveng(nx  ,lev)      &
              65                           , tadvv(nx  ,lev),qadvv(nx  ,lev*ncld),vdmerd(nx  ,lev)           &
              66                           , vdzonl(nx  ,lev)
              67                     !
              68                           real      sdpbl(nx)
              69                           logical   flag(nx)
              70                     !
              71                           real      sd(nx,lev),that(nx,lev),odpsig(nx,lev),                 &
              72                                     qhat(nx,lev*ncld),spal(nx,lev)
              73                     
              74                           integer   k,i,kbgn,n,nk,kk
              75                           real      px,px_pbl
              76                     
              77                     !
              78                     !CWB2014 fixed undefined value problem in rstrantq and rstrandz loop 23
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tadvu, tadvv
                                   <<< Loop-information  End >>>
              79        pp   2v            tadvv=0.
              80         p   2v            tadvu=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qadvu, qadvv
                                   <<< Loop-information  End >>>
              81        pp   2v            qadvv=0.
              82         p   2v            qadvu=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd, vdzonl, vdmerd
                                   <<< Loop-information  End >>>
              83        pp   2v            vdmerd=0.
              84         p   2v            vdzonl=0.
              85                     
              86                     !CWB2014 fixed undefined value problem in diabat line 665
              87         p   2v            sd=0.
              88                     !
              89                     !  surface pressure tendency
              90                     !
              91                           k= 1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 72, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vt, dtpl, pt, rdiv, dlpl, ut, deldm, sd
                                   <<< Loop-information  End >>>
              92     1  pp    v            do 22 i=1,nxj
              93     1   p    v              deldm(i)= -dsigma(k,1)*(ut(i,k)*dlpl(i)*onocos+vt(i,k)*dtpl(i))   &
              94     1                                 -rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
              95     1               !        deldm(i)= -dsig(k)*(ut(i,k)*dlpl(i)*onocos+vt(i,k)*dtpl(i)
              96     1               !     *            +rdiv(i,k)*pt(i))
              97     1   p    v              sd(i,k+1)= deldm(i)
              98     1   p    v         22 continue
              99                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dlpl, ut, pt, vt, rdiv, deldm, dtpl, sd
                                   <<< Loop-information  End >>>
             100     1                     do 2 k=2,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.57, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, vt, dtpl, rdiv, dlpl, ut, deldm, sd
                                   <<< Loop-information  End >>>
             101     2  pp    v            do 2 i=1,nxj
             102     2   p    v              deldm(i)= deldm(i)-dsigma(k,1)*(ut(i,k)*dlpl(i)*onocos            &
             103     2                                +vt(i,k)*dtpl(i))-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             104     2               !        deldm(i)= deldm(i)-dsig(k)*(ut(i,k)*dlpl(i)*onocos
             105     2               !     *           +vt(i,k)*dtpl(i)+rdiv(i,k)*pt(i))
             106     2   p    v              sd(i,k+1)= deldm(i)
             107     1   p    v          2 continue
             108                     !
             109                           k= lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 391
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.28, ITR: 96, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      deldm, pt, vt, dtpl, rdiv, dlpl, ut
                                   <<< Loop-information  End >>>
             110     1  pp    v            do 24 i=1,nxj
             111     1   p    v              deldm(i)= deldm(i)-dsigma(k,1)*(ut(i,k)*dlpl(i)*onocos            &
             112     1                                +vt(i,k)*dtpl(i))-rdiv(i,k)*(dsigma(k,2)+dsigma(k,1)*pt(i))
             113     1               !        deldm(i)= deldm(i)-dsig(k)*(ut(i,k)*dlpl(i)*onocos
             114     1               !     *           +vt(i,k)*dtpl(i)+rdiv(i,k)*pt(i))
             115     1   p    v         24 continue
             116                     !
             117                     !  vertical velocity
             118                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd
                                   <<< Loop-information  End >>>
             119        pp   4v            sd(:,    1) = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      deldm, sd
                                   <<< Loop-information  End >>>
             120     1  pp                 do 3 k=2,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      deldm, sd
                                   <<< Loop-information  End >>>
             121     2   p   2v            do 3 i=1,nxj
             122     2   p   2v              sd(i,k)= sd(i,k)-sigma(k,1)*deldm(i)
             123     2               !        sd(i,k)= sd(i,k)-sig(k)*deldm(i)
             124     1   p   2v          3 continue
             125                     !
             126                     !  obtain vertical velocity within low layers
             127                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.40, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sdpbl, flag, sd
                                   <<< Loop-information  End >>>
             128     1  pp   2v            do i = 1, nxj
             129     1   p   2v              flag(i) = .true.
             130     1   p   2v              sdpbl(i) = sd(i,lev-1)
             131     1   p   2v            enddo
             132                     !
             133                           px_pbl = 850.
             134                           kbgn = (lev*2)/3 - 1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 2)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sigma
                                   <<< Loop-information  End >>>
             135     1   p    s            do 4 k = kbgn, lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    INTERCHANGED(nest: 1)
                                   <<< Loop-information  End >>>
             136     2  pp   2             do 4 i = 1, nxj
             137     2   p   2v              px = sigma(k,1) * pt(i) + sigma(k,2)
             138     2               !        px = sig(k) * pt(i)
             139     3   p   2s              if( px .ge. px_pbl .and. flag(i) ) then
             140     3   p   2s                sdpbl(i) = sd(i,k)
             141     3   p   2v                flag(i) = .false.
             142     3   p   2v              endif
             143     1   p   2v          4 continue
             144                     !
             145                           call vstruc_hybrid_cwb(nxj,nx,lev,cp,radsq,sigma,dsigma,pt,tt,qt  &
             146                                        ,ptop,pk,pk2,spal,odpsig,that,qhat,phi,ncld)
             147                     !
             148                     !  temperature tendency
             149                     !
             150                           k=1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 80, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sd, odpsig, tt, that, rdiv, ddtemp
                                   <<< Loop-information  End >>>
             151     1  pp    v            do 6 i=1,nxj

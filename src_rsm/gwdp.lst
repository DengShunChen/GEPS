 External subroutine subprogram "gwdp"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine gwdp(j,nxj,nx,lev,u,v,t,q,p,pk,pk2,hi,var,dt,g,r,cp,drag, &
               2                                           ugws,vgws,cgw)
               3                     !=======================================================================
               4                     !
               5                     !  1. function description
               6                     !
               7                     !     perform the gravity wave drag parameterization
               8                     !     following the method of palmer et al. 1986
               9                     !
              10                     !
              11                     !  2. common block specification
              12                     !     none
              13                     !
              14                     !
              15                     !  3. parameter specification
              16                     !
              17                     !  3-1. input and output variable
              18                     !
              19                     !     j     : latitude index
              20                     !     nx    : x-dimension of model grid
              21                     !     lev   : total vertical level of model
              22                     !     u,v   : wind in e-w & n-s direction (m/s)
              23                     !     t     : temperature  (k)
              24                     !     q     : specific humidity (kg/kg)
              25                     !     p     : pressure at odd-level (mb)
              26                     !     pk    : p**kcapa at odd-level ((=p/1000.)**0.286)
              27                     !     pk2   : p**kcapa at even-level ((=p/1000.)**0.286)
              28                     !     hi    : geopotential height (m2/s2)
              29                     !     var   : variance of the terrain field (m2)
              30                     !     dt    : time interval (=2.*dt)
              31                     !     g     : gravitational constant (=9.806)
              32                     !     r     : dry gas constant (=287.)
              33                     !     cp    : specific heat constant of the dry air (=1004.)
              34                     !     drag  : gravity wave drag force
              35                     !     ugws  : zonal component of surface gravity wave stress
              36                     !     vgws  : meridional component of surface gravity wave stress
              37                     !
              38                     !  3-2. local variable
              39                     !
              40                     !     p2    : pressure at even-level (mb)
              41                     !     pt    : potential temperature (k)
              42                     !     den   : density (kg/m3)
              43                     !     sn2   : brunt-vaisala frequency (/s2)
              44                     !     ri    : bulk richardson number
              45                     !     stress: magnitude of the gravity wave stress (kg/s2*m)
              46                     !     wss   : reference level wind speed (m/s)
              47                     !     wsu   : reference level wind vector in e-w direction
              48                     !     wsv   : reference level wind vector in n-s direction
              49                     !     wsd   : reference level wind direction
              50                     !     snm   : mean brunt-vaisala frequency of reference level
              51                     !     rim   : mean richardson number of reference level
              52                     !     denm  : mean density of reference level
              53                     !
              54                     !
              55                     !  4. vertical structure description
              56                     !
              57                     !           ------------------------------------------
              58                     !              .......p,u,v,hi,t,q......drag............ pk.1 (odd-level)
              59                     !   pk2.1   --p2,sn,ri,stress-------------------------
              60                     !              .......p,u,v,hi,t,q......drag............ pk.2
              61                     !   pk2.2   --p2,sn,ri,stress-------------------------
              62                     !              .......p,u,v,hi,t,q......drag............ pk.3
              63                     !                               .
              64                     !                               .
              65                     !                               .
              66                     !              .......p,u,v,hi,t,q......drag............ pk.k-1
              67                     !   pk2.k-1 --p2,sn,ri,stress-------------------------
              68                     !              .......p,u,v,hi,t,q......drag............ pk.k
              69                     !   pk2.k   --p2,sn,ri,stress-------------------------
              70                     !              .......p,u,v,hi,t,q......drag............ pk.k+1
              71                     !                               .
              72                     !                               .
              73                     !                               .
              74                     !              .......p,u,v,hi,t,q......drag............ pk.LEV-1
              75                     ! pk2.LEV-1 --p2,sn,ri,stress-------------------------
              76                     !              .......p,u,v,hi,t,q......drag............ pk.LEV
              77                     ! pk2.LEV   --p2,sn,ri,stress-------------------------
              78                     !  (even-level)
              79                     !
              80                     !
              81                     !  5. calling modules
              82                     !     diabat
              83                     !
              84                     !
              85                     !  6. usage
              86                     !     call gwdp(j,nx,lev,u,v,t,q,p,pk,pk2,hi,var,dt,g,r,cp)
              87                     !
              88                     !
              89                     !  7. modules called
              90                     !     none
              91                     !
              92                     !
              93                     !  8. date
              94                     !     created  sep. 1994
              95                     !
              96                     !
              97                     !  9. author
              98                     !     c.-h. shiao
              99                     !
             100                     !
             101                     ! 10. reference
             102                     !     palmer, t. n., g. j. shutts and r. swinbank, 1986:  alleviation
             103                     !          of a systematic westerly bias in circulation and numberical
             104                     !          weather prediction models through an orographic gravity-
             105                     !          wave drag parameterization.  quart. j. roy. meteor. soc.,
             106                     !          112, 1001-1039.
             107                     !
             108                     !=======================================================================
             109                     !
             110                           use paramt
             111                           use const, only : RTYPE
             112                     
             113                           implicit  none
             114                     
             115                     ! ... input and output variable
             116                     !
             117                           integer   j,nxj,nx,lev
             118                     
             119                           real      dt,g,r,cp
             120                     
             121                           real      p(nx,lev)
             122                           real      drag(nx,lev)
             123                           real      ugws(nx),vgws(nx)
             124                           real(kind=RTYPE) u(nx,lev),v(nx,lev),t(nx,lev),q(nx,lev),   &
             125                                            hi(nx,lev)
             126                           real(kind=RTYPE) pk(nx,lev),pk2(nx,lev),var(nx)
             127                     !
             128                     ! ... local variable
             129                     !
             130                           real      p2(im,lm)
             131                           real      pt(im,lm),den(im,lm),sn2(im,lm),ri(im,lm)
             132                           real      stress(im,lm),wri(im,lm)
             133                           real      wss(im),wsu(im),wsv(im),wsd(im)
             134                           real      snm(im),rim(im),denm(im)
             135                     
             136                           integer   k,i,levm,levref,levt
             137                     
             138                           real     cgw,varmax,dz1,s1,s2,u1,v1,su2,pp,wsp,sn,rr,aa,bb, &
             139                                    delth,delth2,um,vm,umnew,denx,alp,stmin,dpk,wsold, &
             140                                    wsnew
             141                     
             142                     
             143                     !
             144                     ! ***** preprocess for gwdp
             145                     !
             146                     ! for L18
             147                     !cc   cgw=2.5e-5
             148                     ! for L30 (2003/01/20)
             149                     !cc   cgw=1.25e-4
             150                     !
             151                     ! tuned by phon-lu for better performance (2011/5)
             152                     !
             153                     !      cgw=7.0e-5
             154                     ! for L60
             155                     !      cgw=2.5e-5
             156                     !      cgw=1.0e-4
             157                     !      cgw=1.25e-4
             158                     !
             159                     !for T511      varmax=400.*400.
             160                           varmax=1200.*1200.    !TCo639L72
             161                     !byl add
             162                           levt=10 !TCo639L72
             163                     !
             164                     ! ... variance of the terrain field
             165                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<< Loop-information  End >>>
             166     1  pp                 do 70 k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wri, drag, stress
                                   <<< Loop-information  End >>>
             167     2   p   2v            do 70 i=1,nxj
             168     2   p   2v            stress(i,k)=0.
             169     2   p   2v            drag(i,k)=0.
             170     2   p   2v            wri(i,k)=9999.
             171     1   p   2v         70 continue
             172                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.25, ITR: 320, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      var
                                   <<< Loop-information  End >>>
             173     1  pp   2v            do 80 i=1,nxj
             174     1   p   2v            if(var(i).ge.varmax) var(i)=varmax
             175     1   p   2v         80 continue
             176                     !
             177                     ! ... pressure at even-level (p2)
             178                     ! ... potential temperature (pt)
             179                     ! ... density (den)
             180                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk2, t, pk, p, q, den, pt, p2
                                   <<< Loop-information  End >>>
             181     1  pp                 do 100 k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.40, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, pk, p, q, pk2, den, pt, p2
                                   <<< Loop-information  End >>>
             182     2   p    v            do 100 i=1,nxj
             183     2   p    v            p2(i,k)=1000.0*pk2(i,k)*pk2(i,k)*pk2(i,k)*sqrt(pk2(i,k))
             184     2   p    v            pt(i,k)=t(i,k)*(1.0+0.608*q(i,k))/pk(i,k)
             185     2   p    v            den(i,k)=p(i,k)*100./(r*t(i,k))
             186     1   p    v        100 continue
             187                     !
             188                     ! ... ri and sn
             189                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hi, u, pt, v, sn2, ri
                                   <<< Loop-information  End >>>
             190     1  pp                 do 130 k=1,lev-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.07, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hi, u, pt, v, sn2, ri
                                   <<< Loop-information  End >>>
             191     2   p    v            do 130 i=1,nxj
             192     2               !
             193     2   p    v            dz1=(hi(i,k)-hi(i,k+1))/g
             194     2               !
             195     2               ! ... brunt-vaisala frequency
             196     2               !
             197     2   p    v               s1=pt(i,k)-pt(i,k+1)
             198     2   p    v               s2=(pt(i,k)+pt(i,k+1))/2.
             199     2   p    v            sn2(i,k)=g*s1/(s2*dz1)
             200     2               !
             201     2               ! ... richardson number
             202     2               !
             203     2   p    v               u1=u(i,k)-u(i,k+1)
             204     2   p    v               v1=v(i,k)-v(i,k+1)
             205     2   p    v            su2=u1*u1+v1*v1
             206     2   p    v               if(su2.le.1.e-6) su2=1.e-6
             207     2               !
             208     2   p    v            ri(i,k)=sn2(i,k)*dz1*dz1/su2
             209     2               !
             210     3   p    v            if(sn2(i,k).le.0.) then
             211     3   p    v            sn2(i,k)=0.
             212     3   p    v            ri(i,k)=0.
             213     3   p    v            endif
             214     2               !
             215     1   p    v        130 continue
             216                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.33, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ri, sn2
                                   <<< Loop-information  End >>>
             217     1  pp   2v            do 140 i=1,nxj
             218     1   p   2v            sn2(i,lev)=sn2(i,lev-1)
             219     1   p   2v            ri(i,lev)=ri(i,lev-1)
             220     1   p   2v        140 continue
             221                     !
             222                     !======================================================================
             223                     !
             224                     ! L18 ... reference level = lowest 3-level mean
             225                     ! L30 ... reference level = lowest 5-level mean
             226                     ! reference level is about at sig=0.9
             227                     !
             228                     !L18  levref=lev-3    ! L18
             229                     !L30  levref=lev-5    ! L30
             230                     !L40      levref=lev-7    ! L40
             231                           levref=lev-10    ! L72
             232                     !
             233                     ! fix an error (2011/5)
             234                     !err  levm=levref*3/4   ! supposed to be at sig=0.45
             235                     !cc   levm=int((levref*0.45)+0.51)
             236                     ! tuned by phon-lu (2011/5)
             237                     !      levm=int((levref*0.4)+0.51)
             238                     ! for L60(op7)
             239                           levm=int((levref*0.4)+0.51)
             240                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1455
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wsv, wsu
                                   <<< Loop-information  End >>>
             241     1  pp   2v            do 200 i=1,nxj
             242     1   p   2v            wsu(i)=0.
             243     1   p   2v            wsv(i)=0.
             244     1   p   2v        200 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p2, v, u, wsv, wsu
                                   <<< Loop-information  End >>>
             245     1                     do 210 k=lev-1,levref,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 364
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 72, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u, p2, wsv, v, wsu
                                   <<< Loop-information  End >>>
             246     2  pp    v            do 210 i=1,nxj
             247     2   p    v            pp=p2(i,k)-p2(i,k-1)
             248     2   p    v            wsu(i)=wsu(i)+u(i,k)*pp
             249     2   p    v            wsv(i)=wsv(i)+v(i,k)*pp
             250     1   p    v        210 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 239
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 251,267)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.37, ITR: 48, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p2, wsu, wsv, rim, snm, wss
                                   <<< Loop-information  End >>>
             251     1  pp    v            do 220 i=1,nxj
             252     1   p    v            wsp=p2(i,lev-1)-p2(i,levref-1)
             253     1   p    v            wsu(i)=wsu(i)/wsp
             254     1   p    v            wsv(i)=wsv(i)/wsp
             255     1   p    v            wss(i)=sqrt(wsu(i)*wsu(i)+wsv(i)*wsv(i))
             256     2   p    v            if(wss(i).le.1.e-3) then
             257     2   p    v            wss(i)=0.
             258     2   p    v            wsu(i)=0.
             259     2   p    v            wsv(i)=0.
             260     2   p    v            else
             261     2   p    v            wsu(i)=wsu(i)/wss(i)
             262     2   p    v            wsv(i)=wsv(i)/wss(i)
             263     2   p    v            endif
             264     1               
             265     1   p    v        220 continue
             266                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             267     1                     do 230 i=1,nxj
             268     1                     snm(i)=0.
             269     1                     rim(i)=0.
             270     1                 230 continue
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p, rim, ri, sn2, snm
                                   <<< Loop-information  End >>>
             271     1                     do 238 k=lev-1,levref-1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.60, ITR: 104, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      p, ri, rim, sn2, snm
                                   <<< Loop-information  End >>>
             272     2  pp    v            do 235 i=1,nxj
             273     2   p    v            pp=p(i,k+1)-p(i,k)
             274     2   p    v            snm(i)=snm(i)+sn2(i,k)*pp
             275     2   p    v            rim(i)=rim(i)+ri(i,k)*pp

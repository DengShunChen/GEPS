             468                     !
             469                     !  compute sea level pressure and write out pdiff
             470                     !  The method is based on one used by ecmwf, reseach manual 2 (1988)
             471                     !
             472                           alaps = 0.0065
             473                           rdg = rgas/grav
             474                     !
             475                     !  llts layer's temperature is used to derive an alternative
             476                     !  surface skin temperature
             477                     !
             478                           llts = lev-5
             479                     !
             480     1                     do 190 jj = 1, jlistnum
             481     1                      j=jlist1(jj)

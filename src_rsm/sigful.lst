                                   <<<      sgeo, hld1, pt, anlslp, hld2
                                   <<< Loop-information  End >>>
             492     2  pp    v            do 185 i = 1, nxj
             493     3   p    v            if( sgeo(i,jj) .lt. 0.1 ) then
             494     3   p    v             anlslp(i,jj) = pt(i,jj) + ptop
             495     3               
             496     3   p    v            elseif( hld1(i,j) .le. 290.5 .and. hld2(i,j) .gt. 290.5 ) then
             497     3   p    v             apha = rgas*(290.5-hld1(i,j))/sgeo(i,jj)
             498     3   p    v             ttt = sgeo(i,jj)/(rgas*hld1(i,j))
             499     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333* &
             500     3                                    apha*ttt*apha*ttt) )
             501     3               
             502     3   p    v            elseif( hld1(i,j) .gt. 290.5 .and. hld2(i,j) .gt. 290.5 ) then
             503     3   p    v             hld1(i,j) = (hld1(i,j)+290.5)*0.5
             504     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,j)) )
             505     3               
             506     3   p    v            elseif( hld1(i,j) .lt. 255.0 .and. hld2(i,j) .lt. 255.0 ) then
             507     3   p    v             hld1(i,j) = (hld1(i,j)+255.0)*0.5
             508     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( sgeo(i,jj)/(rgas*hld1(i,j)) )
             509     3               
             510     3   p    v            else
             511     3   p    v             apha = alaps * rdg
             512     3   p    v             ttt = sgeo(i,jj)/(rgas*hld1(i,j))
             513     3   p    v             anlslp(i,jj) = (pt(i,jj)+ptop)*exp( ttt*(1.0-0.5*apha*ttt+0.333333* &
             514     3                                    apha*ttt*apha*ttt) )

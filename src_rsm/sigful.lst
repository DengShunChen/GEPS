                                   <<< Loop-information  End >>>
             483     2  pp    v            do 180 i = 1, nxj
             484     2   p    v             ttt1 = tt(i,lev,jj) + alaps*rdg*tt(i,lev,jj)*       &
             485     2                             ((pt(i,jj)+ptop)/plt(i,lev,jj)-1.0)
             486     2   p    v             ttt2 = tt(i,llts,jj) + alaps*(phi(i,llts,jj)-sgeo(i,jj))/grav
             487     2   p    v             hld1(i,j) = 0.25*ttt1 + 0.75*ttt2
             488     2   p    v             hld2(i,j) = hld1(i,j) + alaps*sgeo(i,jj)/grav
             489     2   p    v        180 continue

 External subroutine subprogram "get_model_param"
  (inc)(line-no.)(nest)(optimize)
               1                     
               2                           subroutine get_model_param
               3                     !
               4                           use param
               5                     
               6                           use const, only : ifilin,cwbout,bckfile,namlsts,   &
               7                                             ifilout,crdate,ocards,phyout,cntrl, &
               8                                             ifilin_ncep,ifilin_sst,ifilin_nc,&
               9                                             ifilin_ClmANA,ifilin_ClmFCT
              10                     
              11                           use paramt
              12                     
              13                           use rank
              14                     !
              15                           implicit  none
              16                     
              17                     !
              18                           namelist /model_param/nco,lev,ncld,octahedral,nout &
              19                                                ,io_quilting,npex,npey !2dMPI
              20                     !
              21                           integer istat
              22                           character*80 filist
              23                           character*80 pathname,logicname,truefile
              24                           namelist /filst/ ifilin,cwbout,bckfile,namlsts &
              25                                          , ifilout,crdate,ocards,phyout,cntrl &
              26                                          , ifilin_ncep,ifilin_sst,ifilin_nc &
              27                                          , ifilin_ClmANA,ifilin_ClmFCT
              28                           data pathname/'NWPETCGLB'/
              29                           data logicname/'filist'/
              30                     !
              31                     !  read namlist of path/file name(operation)
              32                     !
              33                           call getfname(pathname,logicname,truefile,istat)
              34     1                     if(istat.ne.0)then
              35     1                       print *,'getfname : error','RANK=',myrank
              36     1                       call mpe_finalize
              37     1                       call dmsexit(-1)
              38     1               !     else
              39     1               !       if(myrank .eq. 0) print *,truefile
              40     1                     endif
              41                     !
              42                           open (unit=12,file=trim(truefile),form='formatted')
              43                     !
              44                           read (12,filst,end=110)
              45                     !
              46                       110 continue
              47                           close(12)
              48                     !
              49                     !  read namelist for model parameters
              50                     !
              51                           open (unit=1,file=trim(namlsts),form='formatted')
              52                     !
              53                           read (1,model_param,end=120)
              54                     !
              55                       120 continue
              56                           close(1)
              57                     
              58                     !     if(myrank .eq. 0) print model_param
              59                           if(myrank_all .eq. 0) print model_param
              60                     
              61     1                     if ( octahedral ) then
              62     1                       my=2*nco
              63     1                       nx=16+4*nco
              64     1                       jtrun= 2*((1+(4*nco-1)/4)/2)
              65     1               
              66     1                       im=16+4*nco
              67     1                       jm=2*nco
              68     1                       jtr= 2*((1+(4*nco-1)/4)/2)
              69     1                     else
              70     1                       nx=4*nco
              71     1                       my=nx/2
              72     1                       jtrun= 2*((1+(nx-1)/2)/2)
              73     1               
              74     1                       im=nx
              75     1                       jm=im/2
              76     1                       jtr= 2*((1+(im-1)/2)/2)
              77     1                     endif
              78                           mlmax= jtrun*(jtrun+1)/2
              79                     
              80                           lm=lev
              81                           mlm=jtr*(jtr+1)/2
              82                     
              83                           imax=nx
              84                           jmax=imax/2
              85                           lpx=26
              86                           kvkw=im/2
              87                     
              88                           ilm=im*lm
              89                           im2=kvkw*(lm+1)
              90                     
              91                           jmhalf=jm/2
              92                           lmX2=lm*2
              93                           lmX4=lm*4
              94                           lmX10=lm*10
              95                     
              96                           return
              97                           end


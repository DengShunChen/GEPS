             223                           subroutine qsatq_cwb (imjm,tqs,pqs,qqq)
             224                     !
             225                     !  vectorized saturation specific humidity subroutine
             226                     !  algorithm is table-lookup.
             227                     !
             228                     !  formal parameters:
             229                     !
             230                     ! **** input ****
             231                     !
             232                     !  tqs:  input temperatures
             233                     !  pqs:  input pressures
             234                     !  imjm:  number of elements in input arrays
             235                     !
             236                     ! **** output ****
             237                     !
             238                     !  qss:  output saturation specific humidity
             239                     !
             240                           implicit  none
             241                     
             242                           integer   imjm,i,ic
             243                     
             244                           real      tqs(imjm),pqs(imjm),qss(imjm)
             245                           real      vpsat(191)
             246                           real      tem,epsm1,t1,qqq(imjm),fpvs
             247                     !
             248                     !
             249                     ! est1 are the saturated vapor pressure over ice for the temperatures
             250                     !      -90.0 to -40.0 degrees c in one degree increments.
             251                     ! est3 are the saturated vapor pressures over water for the temperatures
             252                     !      0 to 100 degrees c in one degree increments.
             253                     ! est2 are the saturated vapor pressures over water and ice for the
             254                     !      temperatures -39 to -1 degeegs c linearly interpolated assuming
             255                     !      total ice at -40.0 degrees and total water at 0 degrees.
             256                     !
             257                     ! the saturated values are obtained from the smithsonian meteorological

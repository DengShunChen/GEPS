             869                           call ujoinsr(cc,rvor,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             870                           call transr(jtrun,jtmax,nx,my,my_max,levp,poly,divnow,cc,1,nsizey)
             871                           call ujoinsr(cc,rdiv,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             872                           call transr(jtrun,jtmax,nx,my,my_max,levp,poly,temnow,cc,1,nsizey)
             873                           call ujoinsr(cc,tt,dummy,dummy,dummy,nx,my_max,lev,jlistnum,1,1)
             874                           call transr1(jtrun,jtmax,nx,my,my_max,poly,plnow,pt,nsizey)
             875                     !
             876     1                     do 160 jj = 1, jlistnum
             877     1                       j=jlist1(jj)

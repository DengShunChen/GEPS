             879     1                       call prexp_hybrid_cwb ( nxjp(j),nxp,lev,ptop,sigma,pt(1,jj) &
             880     1                                         ,pk(1,1,jj),pk2(1,1,jj),plt(1,1,jj) )
             881     1                160  continue
             882                     !
             883                     !  compute globel moisture budget and p-coordinate variables
             884                     !
             885                           qgini = 0.
             886                     !
             887     1                     do 420 jj = 1, jlistnum
             888     1                       j=jlist1(jj)
             889     1                       nxj=nxdef_2d(j)
             890     1                       q1 = 0.0
                                   <<< Loop-information Start >>>

             910                                         dlpl,dtpl,nsizey)
             911                     !
             912                     !  compute spline coefficients for long wave radiation calculation
             913                     !  compute lontitude and latitude of grid points for zenth angle
             914                     !  calculation in by radiation parameterization. those array are
             915                     !  passed to subroutine diabat by common block /radcon/
             916                     !
             917                           njump1 = njump + 1
             918                           if ( mod( nxp,njump1) .ne. 0 )  njump1 = njump
             919                           njump2 = njump + 2
             920                           if ( mod( nxp,njump2) .ne. 0 )  njump2 = njump1
             921                           njump3 = njump + 3
             922                           if ( mod( nxp,njump3) .ne. 0 )  njump3 = njump2
             923                     !
             924     1                     if ( lreduce .eq. 1 ) then
             925     1                       njump1=njump
             926     1                       njump2=njump
             927     1                       njump3=njump
             928     1                     endif
             929                     !
             930                           lvlw = nxp/njump
             931                           lvlw1= nxp/njump1
             932                           lvlw2= nxp/njump2
             933                           lvlw3= nxp/njump3
             934                           call splinc (lvlw ,nxp,il(1,1),ib(1,1),cof(1,1))
             935                           call splinc (lvlw1,nxp,il(1,2),ib(1,2),cof(1,2))

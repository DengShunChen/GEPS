                                   <<< Loop-information  End >>>
             892     3   p   8v              do 400 i = 1, nxj
             893     3   p   8v                dsigp = dsigma(k,1)*pt(i,jj)+dsigma(k,2)
             894     3   p   8v                q1        = q1 + qt(i,k,jj)*dsigp
             895     2   p   8v       400    continue
             896     1                       qgini = qgini + q1*cosl(j)*100./grav

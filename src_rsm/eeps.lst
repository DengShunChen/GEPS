 External subroutine subprogram "eeps"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine eeps ( nxj,mn,kk,ktpbl,g,dt,ec1,ec2,ec3,ec4,ec5,u,v,t &
               2                                           , hgt,zl,e,eps,xkm,xkh,shr,wkk2,wktri,dhgt )
               3                     !##################################################################
               4                     !                     subroutine description
               5                     !
               6                     ! 1. function description
               7                     !
               8                     !       this subroutine predicts e and eps in the future time level
               9                     !       for vertical levels from kk-1 to ktpbl.
              10                     !       ( e and eps at kk levels are diagnosed in sfcpbl )
              11                     !
              12                     ! 2. common block specification
              13                     !
              14                     !
              15                     ! 3. parameter specification
              16                     !
              17                     !     mn : dimension of horizontal direction
              18                     !     kk : dimension of vertical direction
              19                     !  ktpbl : starting level to consider vertical mixing effects
              20                     !     dt : time step for e and eps updates
              21                     !      g : gravity                                               (m/s2)
              22                     !     ec1: coef for   e-prediction equation, eq. (15) of gerber (1989)
              23                     !     ec2: constant to compute xkm from e**2/eps
              24                     ! ec3,4,5: coef for eps-prediction equation, eq. (16) of gerber (1989)
              25                     !      u : x-direction velocity (m,n,kk) at the current time lvl (m/s)
              26                     !      v : y-direction velocity (m,n,kk) at the current time lvl (m/s)
              27                     !      t : temp.     on odd lvl (m,n,kk) at the current time lvl (k)
              28                     !    hgt : heigh above ground   (m,n,kk) at the current time lvl (m)
              29                     !     zl : lowest sigma level height over mixing length  (mn)
              30                     !     e  : turbulence kinetic energy (mn,kk) at current/future   (m2/s2)
              31                     !    eps : tke dissipation           (mn,kk) at current/future   (m2/s2)
              32                     !    xkm : momentum transport coef   (mn,kk) at current time lvl (m2/s2)
              33                     !    xkh : heat/moist transpt coef   (mn,kk) at current time lvl (m2/s2)
              34                     !
              35                     ! 4. work arrays
              36                     !    shr : working array for coef. calculation            (mn,kk)
              37                     !   wkk2 : working array for coef. calculation            (mn,kk)
              38                     !  wktri : working array for tri-diagonal system solver   (mn,kk,4)
              39                     !
              40                     ! 4.1 local work array
              41                     !     eo : working array to save e at previous time lvl   (mn,kk)
              42                     !
              43                     ! 5. calling modules
              44                     !
              45                     !      mixpbl
              46                     !
              47                     ! 6. usage
              48                     !
              49                     !     call eeps ( mn,kk,ktpbl,g,dt,ec1,ec2,ec3,ec4,ec5,u,v,t
              50                     !    1          , hgt,zl,e,eps,xkm,xkh,wkk1,wkk2,wktri )
              51                     !
              52                     ! 7. modules called
              53                     !
              54                     !     trigau
              55                     !
              56                     ! 8. limitation
              57                     !
              58                     !         e   >= 1.0e-04, e   <= 250.0
              59                     !         eps >= 1.0e-07, eps <= 1.0
              60                     !
              61                     ! 9. date
              62                     !
              63                     !     created              10/01/1989
              64                     !     rewritten            nov.  1991
              65                     !
              66                     !
              67                     ! 10. author
              68                     !
              69                     !      c. liou / f. wang / c. chang
              70                     !      modify to f90 by C-H Lee and sort by River Chen in 2015
              71                     !
              72                     ! 11. reference
              73                     !       detering h.,w., and d. etling, 1984: application of the
              74                     !            e-eps turbulence model to the atmospheric boundary
              75                     !            layer. boundary-layer meteorol., 33, 113-133.
              76                     !
              77                     !#####################################################################
              78                     !
              79                           use paramt
              80                     
              81                           implicit  none
              82                           integer   nxj,mn,kk,ktpbl
              83                           real      g,dt,ec1,ec2,ec3,ec4,ec5
              84                     
              85                     !  input & output variable (including work arrays)
              86                           real      u(mn,kk),v(mn,kk),t(mn,kk),hgt(mn,kk),zl(mn), &
              87                                     e(mn,kk),eps(mn,kk),xkm(mn,kk),xkh(mn,kk),    &
              88                                     shr(mn,kk),wkk2(mn,kk),wktri(mn,kk,4)
              89                           real      dhgt(mn,kk)
              90                     !
              91                     !  local work array
              92                     !
              93                           real      eo(im,lm)
              94                           real      vdiff,tflt
              95                           data      vdiff /0.1/, tflt /0.2/
              96                     
              97                           integer   kk1,kt1,kt2,mnkt1,kpp1,kpm1,ik,iksp,iks,iksm, &
              98                                     k,i,ktpbx,kppx,kpmx
              99                           real      duu,dvv,dzz,dzzu,dzzup,buoy,eee,xkmnew,factor
             100                     
             101                     !
             102                     ! *note: e, eps prediction are only from ktpbl to kk-1 levels
             103                     !
             104                           kk1   = kk - 1
             105                           kt1   = kk1 - ktpbl + 1
             106                           kt2   = kt1 - 1
             107                           mnkt1 = mn*kt1
             108                           kpp1  = ktpbl + 1
             109                           kpm1  = ktpbl - 1
             110                     !
             111                     !-----------------------------------------------------------------
             112                     ! (1) prepare tri-diagonal system coef for e-prediction equation -
             113                     !-----------------------------------------------------------------
             114                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 136
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.07, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u, xkm, xkh, t, v, dhgt, hgt, wktri
                                   <<<    PREFETCH(SOFT) : 18
                                   <<<     SEQUENTIAL : 18
                                   <<<      eps: 4, e: 4, wktri: 4, shr: 4, t: 2
                                   <<< Loop-information  End >>>
             115     1  pp    v            do ik = 1, nxj
             116     1   p    v            iksp=(ktpbl  )*mn+ik
             117     1   p    v            iks =(ktpbl-1)*mn+ik
             118     1   p    v            iksm=(ktpbl-2)*mn+ik
             119     1   p    v            duu = u(iks,1) - u(iksp,1)
             120     1   p    v            dvv = v(iks,1) - v(iksp,1)
             121     1   p    v            dzz = hgt(iks,1) - hgt(iksp,1)
             122     1               !cc   dzzu = 0.5*( hgt(iksm,1) - hgt(iksp,1) )
             123     1   p    v            dzzu = dhgt(iks,1)
             124     1   p    v            dzzup= dhgt(iksp,1)
             125     1   p    v            shr(ik,1) = (duu*duu+dvv*dvv)*xkm(iks,1)/dzz
             126     1   p    v            buoy= -g*xkh(iks,1)*(t(iks,1)-t(iksp,1))/(0.5*(t(iks,1) &
             127     1                           +t(iksp,1)))
             128     1   p    v            wktri(ik,1,1) = - dt*ec1*0.5*(xkm(iks,1)+xkm(iksm,1))/dzzu
             129     1   p    v            wktri(ik,1,3) = - dt*ec1*0.5*(xkm(iks,1)+xkm(iksp,1)) &
             130     1                                     /dzzup
             131     1   p    v            wktri(ik,1,2) = dzz - wktri(ik,1,1) - wktri(ik,1,3)
             132     1   p    v            wktri(ik,1,4) = dzz*(e(iks,1)-dt*eps(iks,1)) &
             133     1                           + dt*(shr(ik,1)+buoy)
             134     1   p    v            enddo
             135                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hgt, xkm, xkh, t, dhgt, u, v, wktri, shr
                                   <<<    PREFETCH(SOFT) : 8
                                   <<<     SEQUENTIAL : 8
                                   <<<      e: 2, eps: 2, wktri: 4
                                   <<< Loop-information  End >>>
             136     1                     do 120 k = 2, kt1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.86, ITR: 3, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      u, v, xkm, hgt, wktri, shr, t, xkh, dhgt
                                   <<<    PREFETCH(SOFT) : 12
                                   <<<     SEQUENTIAL : 12
                                   <<<      wktri: 8, e: 2, eps: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 3  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             137     2   s    s            do 120 i = 1, nxj
             138     2   p    v            ik = (k-1)*mn + i
             139     2   p    v            iksp=(ktpbl  )*mn+ik
             140     2   p    v            iks =(ktpbl-1)*mn+ik
             141     2   p    v            iksm=(ktpbl-2)*mn+ik
             142     2   p    v            duu = u(iks,1) - u(iksp,1)
             143     2   p    v            dvv = v(iks,1) - v(iksp,1)
             144     2   p    v            dzz = hgt(iks,1) - hgt(iksp,1)
             145     2               !cc   dzzu = 0.5*( hgt(iksm,1) - hgt(iksp,1) )
             146     2   p    v            dzzu = dhgt(iks,1)
             147     2   p    v            dzzup= dhgt(iksp,1)
             148     2   p    v            shr(ik,1) = (duu*duu+dvv*dvv)*xkm(iks,1)/dzz
             149     2   p    v            buoy= -g*xkh(iks,1)*(t(iks,1)-t(iksp,1))/(0.5*(t(iks,1) &
             150     2                           +t(iksp,1)))
             151     2   s    s            wktri(ik,1,1) = wktri(ik-mn,1,3)
             152     2   m    m            wktri(ik,1,3) = - dt*ec1*0.5*(xkm(iks,1)+xkm(iksp,1)) &
             153     2                                     /dzzup
             154     2   p    v            wktri(ik,1,2) = dzz - wktri(ik,1,1) - wktri(ik,1,3)
             155     2   p    v            wktri(ik,1,4) = dzz*(e(iks,1)-dt*eps(iks,1)) &
             156     2                           + dt*(shr(ik,1)+buoy)
             157     1   p    v        120 continue
             158                     !
             159                     !     -- do not allow   dt*(total damping) < e(t)   --
             160                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri
                                   <<< Loop-information  End >>>
             161     1  pp                 do 140 k = 1, kt1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.25, ITR: 160, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri
                                   <<< Loop-information  End >>>
             162     2   p   2v            do 140 i = 1, nxj
             163     2   p   2v            if ( wktri(i,k,4) .lt. 0.0 )  wktri(i,k,4) = 0.0
             164     1   p   2v        140 continue
             165                     !
             166                     !
             167                     !     fix upper b.c (move -e(ktpbl-1)*wktri(1,1) to forcing term)
             168                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 433
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 169,175)
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, e
                                   <<< Loop-information  End >>>
             169     1  pp    v            do 150 i = 1, nxj
             170     1   p    v            wktri(i,1,4) = wktri(i,1,4) - e(i,ktpbl-1)*wktri(i,1,1)
             171     1   p    v        150 continue
             172                     !
             173                     !     put surface forcing to kk level
             174                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
             175     1                     do 160 i = 1, nxj
             176     1                     wktri(i,kt1,4) = wktri(i,kt1,4) - e(i,kk)*wktri(i,kt1,3)
             177     1                 160 continue
             178                     !
             179                     !     update e to future time level by backward time scheme
             180                     !
             181                           call trigau ( wktri, mn, nxj, kk, kt1, 0 )
             182                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, e, eo
                                   <<< Loop-information  End >>>
             183     1  pp                 do 180 k = 1, kt1
             184     1   p                 ktpbx=ktpbl+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.50, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, e, eo
                                   <<< Loop-information  End >>>
             185     2   p   2v            do 180 i = 1, nxj
             186     2   p   2v            eo(i,ktpbx) = e(i,ktpbx)
             187     2   p   2v            e(i,ktpbx)  = wktri(i,k,4)
             188     1   p   2v        180 continue
             189                     !
             190                     !     apply vertical diffusion to e
             191                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e, wktri
                                   <<< Loop-information  End >>>
             192     1  pp                 do 185 k = 1, kt1
             193     1   p                 kppx=kpp1+k-1
             194     1   p                 kpmx=kpm1+k-1
             195     1   p                 ktpbx=ktpbl+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 112, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e, wktri
                                   <<< Loop-information  End >>>
             196     2   p   2v            do 185 i = 1, nxj
             197     2   p   2v            wktri(i,k,4) = 0.5*vdiff*(e(i,kppx)-2.0*e(i,ktpbx)+e(i,kpmx))
             198     1   p   2v        185 continue
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, e
                                   <<< Loop-information  End >>>
             199     1  pp                 do 187 k = 1, kt1
             200     1   p                 ktpbx=ktpbl+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 192, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wktri, e
                                   <<< Loop-information  End >>>
             201     2   p   2v            do 187 i = 1, nxj
             202     2   p   2v            e(i,ktpbx) = e(i,ktpbx) + wktri(i,k,4)
             203     1   p   2v        187 continue
             204                     !
             205                     !     limit e to 1.0e-04 and 250.0
             206                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e
                                   <<< Loop-information  End >>>
             207     1  pp                 do 190 k = 1, kt1
             208     1   p                 ktpbx=ktpbl+k-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.87, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      e
                                   <<< Loop-information  End >>>
             209     2   p   2v            do 190 i = 1, nxj
             210     2   p   2v            if ( e(i,ktpbx) .lt. 1.0e-04 )  e(i,ktpbx)  = 1.0e-04
             211     2   p   2v            if ( e(i,ktpbx) .gt. 250.0   )  e(i,ktpbx)  = 250.0
             212     1   p   2v        190 continue
             213                     !
             214                     !---------------------------------------------------------------------
             215                     ! (2) prepare tri-diagonal system coef for eps-prediction equation   -
             216                     !---------------------------------------------------------------------
             217                     !
             218                     !     enhance shear effects, if buoyance > 0
             219                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      t, xkh, shr
                                   <<< Loop-information  End >>>
             220     1                     do 220 k = 1, kt1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.41, ITR: 32, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xkh, shr, t
                                   <<< Loop-information  End >>>
             221     2  pp    v            do 220 i = 1, nxj
             222     2   p    v            ik = (k-1)*mn + i
             223     2   p    v            iks =(ktpbl-1)*mn+ik
             224     2   p    v            iksp=(ktpbl  )*mn+ik
             225     2   p    v            if( t(iks,1).lt.t(iksp,1) )  shr(ik,1) = shr(ik,1) +  &
             226     2                       (-g)*xkh(iks,1)*(t(iks,1)-t(iksp,1))                &
             227     2                       /(0.5*(t(iks,1)+t(iksp,1)))
             228     1   p    v        220 continue
             229                     !

               1                           subroutine qprnt3 (a,t1,t2,ic,jc,kc,m,n,my_max,l,amul,add)
               2                     !
               3                     !  quick print a 3-d array a(m,l,n) at kc level starting at address
               4                     !  a(ic,kc,jc).  values are recomputed with add and amul, and then
               5                     !  are automatically scaled to allow 2 digit integer format printing.
               6                     !
               7                     !  ***input***
               8                     !
               9                     ! a    : fwa of m x n array
              10                     ! t1,t2: title (2*8 character)
              11                     ! ic,jc: lower left corner coords to be printed
              12                     ! kc   : level to be printed
              13                     ! m,n,l: first,third,second dimension respectively
              14                     ! amul : scaling multiplier for output
              15                     ! add  : additive constant added before output
              16                     !
              17                     !  ***************************************************************
              18                     !
              19                           use mpe
              20                           use rank
              21                           use index
              22                     
              23                           implicit  none
              24                     !
              25                           real      a(m,l,my_max),amul,add
              26                           character*8 t1, t2
              27                           integer   ic,jc,kc,m,n,l,my_max
              28                     
              29                           integer   ix(41),jj,j,i,ie,jl,kp,kscale,j2,ii,jli
              30                           real      haf,xm,af,x99,fk
              31                     !
              32                           haf= 0.5
              33                           ie = min0(ic+40,m)
              34                           jl = n
              35                     !
              36                           xm=0.
              37     1                     do 110 jj =1,jlistnum
              38     1                     j=jlist1(jj)
              39     2                     if(j.ge.jc .and. j.le.jl) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              40     3  pp    v            do 100 i=ic,ie
              41     3   p    v            af= a(i,kc,jj)*amul + add
              42     3   p    v        100 xm= max(xm,abs(af))
              43     2                     endif
              44     1                 110 continue
              45                     !
              46                           call mpe_global_max(xm,1,mpe_double)
              47                     !
              48                           if(xm.lt.1.e-35) xm=99.
              49                           x99= 99.
              50                           xm = log10(x99/xm)
              51                           kp = xm
              52                           if (xm.lt.0.) kp = kp - 1
              53                     !
              54                           kscale = - kp
              55              s            if(myrank .eq. 0) print 190, t1,t2,kscale,amul,add,(i,i=ic,ie,2)
              56                       190 format(1h0,2a8,'  scale=',i3,' mult=',g12.5,' add=',g12.5, /1x,22i6)
              57                     !
              58                           fk = 10.**kp
              59                     !
              60                     !     quickprint field
              61                     !
              62     1                     do 200 j=jl,jc,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, (unknown)
                                   <<< Loop-information  End >>>
              63     2                     do 205 jj =1,jlistnum
              64     2                     j2=jlist1(jj)
              65     3                     if(j2 .eq. j) then
              66     3                       jli= jj
              67     3                       ii = 0
              68     4                       if (kp.eq.0) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 208, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, ix
                                   <<< Loop-information  End >>>
              69     5  pp   2v                do 300 i=ic,ie
              70     5   p   2v                ii= ii+1
              71     5   p   2v                af= a(i,kc,jli)*amul+add
              72     5   p   2v                ix(ii) = af + sign(haf,af)
              73     5   p   2v        300     continue
              74     4                       else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 208, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a, ix
                                   <<< Loop-information  End >>>
              75     5  pp   2v                do 400 i=ic,ie
              76     5   p   2v                ii= ii+1
              77     5   p   2v                af= a(i,kc,jli)*amul+add
              78     5   p   2v          7     ix(ii) = af*fk + sign(haf,af)
              79     5   p   2v        400     continue
              80     4                       endif
              81     3                       call mpe_send_print(ix, 41, j, mpe_integer)
              82     3                     endif
              83     2                 205 continue
              84     1               !
              85     1                 200 continue
              86                     
              87     1                     if(myrank .eq. 0) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
              88     2                     do j=jl,jc,-1
              89     2                       call mpe_recv_print(ix, 41, j, mpe_integer)
              90     2                       print 500, j, (ix(i),i=1,ii), j
              91     2                 500   format (i4,42i3)
              92     2                     enddo
              93     1                     endif
              94                     
              95                           return
              96                           end


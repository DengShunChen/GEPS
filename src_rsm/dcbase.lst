               3                     !
               4                     !***********************************************************************
               5                     !
               6                     !    1.   function description
               7                     !           perform calculation of cloud base index and cloud base
               8                     !                   condition for a-s cumulus parameterization
               9                     !
              10                     !    2.   common block specification
              11                     !            none
              12                     !
              13                     !    3.   parameter specification
              14                     !     input :
              15                     !       im        :   dimension of horizontal direction
              16                     !       nx        :   no of points in horizontal direction to process
              17                     !       lm        :   position index in the latitudinal direction
              18                     !       hltm      :   latent heat constant of water vapor (2.52e+6)
              19                     !       zl2(im,lm):   height above surface (meters)
              20                     !       ql (im,lm):   water vapor mixing ratio on model level(g/g)
              21                     !       qls2(im,lm):   saturation water vapor mixing ratio on evenl leve
              22                     !       hl (im,lm):   moist static energy on model level
              23                     !       hls2(im,lm):  saturation moist static energy on model level
              24                     !       game(im,lm)
              25                     !     output:
              26                     !       kcbase(im):   cloud base index
              27                     !       e(im,lm)  :   normalized mass flux
              28                     !       qcl(im,lm):   water vapor mixing ratio of cloud (kg/kg)
              29                     !       hcl(im,lm):   moist static energy of cloud
              30                     !       cu (im,lm):   saturation water vapor mixing ratio of cloud
              31                     !
              32                     !    4.  calling modules
              33                     !            cup92
              34                     !
              35                     !    5.  usage
              36                     !           call dcbase ( nx,im,lm,hltm,kcbase,zl2,ql,qls2,hl,hls2
              37                     !          1            , game,e,qcl,hcl,cu,hbase,qbase,cubase )
              38                     !

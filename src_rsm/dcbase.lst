              45                     !
              46                     !***********************************************************************
              47                     !
              48                           implicit  none
              49                     
              50                           integer   nx,im,lm
              51                           real      hltm
              52                     
              53                     !     input arrays
              54                     !
              55                           real      zl2(im,lm),ql(im,lm),hl(im,lm),hls2(im,lm),game(im,lm)
              56                           real      qls2(im,lm)
              57                     !

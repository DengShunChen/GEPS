              68     1  pp   2v            do 10 i = 1, nx
              69     1   p   2v            kcbase(i)= 1
              70     1   p   2v            hbase(i) = 0.0
              71     1   p   2v            qcl(i,lm)= ql(i,lm)
              72     1   p   2v            hcl(i,lm)= hl(i,lm)
              73     1   p   2v         10 continue
              74                     !
              75                     ! --  assume cloud base can not be higher than lm/2

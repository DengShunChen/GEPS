 External subroutine subprogram "cudlfs_n"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine cudlfs_n   &
               2                          &    (nxj,      klon,     klev,  &
               3                          &     kcbot,    kctop,    lndj,   ldcum,   &
               4                          &     ptenh,    pqenh,    puen,     pven,     &
               5                          &     pten,     pqsen,    pgeo,                &
               6                          &     pgeoh,    paph,     ptu,      pqu,      plu,&
               7                          &     puu,      pvu,      pmfub,    prfl,          &
               8                          &     ptd,      pqd,      pud,      pvd,            &
               9                          &     pmfd,     pmfds,    pmfdq,    pdmfdp,          &
              10                          &     kdtop,    lddraf)
              11                     
              12                     !          this routine calculates level of free sinking for
              13                     !          cumulus downdrafts and specifies t,q,u and v values
              14                     
              15                     !          m.tiedtke         e.c.m.w.f.    12/86 modif. 12/89
              16                     
              17                     !          purpose.
              18                     !          --------
              19                     !          to produce lfs-values for cumulus downdrafts
              20                     !          for massflux cumulus parameterization
              21                     
              22                     !          interface
              23                     !          ---------
              24                     !          this routine is called from *cumastr*.
              25                     !          input are environmental values of t,q,u,v,p,phi
              26                     !          and updraft values t,q,u and v and also
              27                     !          cloud base massflux and cu-precipitation rate.
              28                     !          it returns t,q,u and v values and massflux at lfs.
              29                     !          method.
              30                     !          check for negative buoyancy of air of equal parts of
              31                     !          moist environmental air and cloud air.
              32                     !     parameter     description                                   units
              33                     !     ---------     -----------                                   -----
              34                     !     input parameters (integer):
              35                     !    *klon*         number of grid points per packet
              36                     !    *klev*         number of levels
              37                     !    *kcbot*        cloud base level
              38                     !    *kctop*        cloud top level
              39                     !    input parameters (logical):
              40                     !    *lndj*       land sea mask (1 for land)
              41                     !    *ldcum*        flag: .true. for convective points
              42                     !    input parameters (real):
              43                     !    *ptenh*        env. temperature (t+1) on half levels          k
              44                     !    *pqenh*        env. spec. humidity (t+1) on half levels     kg/kg
              45                     !    *puen*         provisional environment u-velocity (t+1)      m/s
              46                     !    *pven*         provisional environment v-velocity (t+1)      m/s
              47                     !    *pten*         provisional environment temperature (t+1)       k
              48                     !    *pqsen*        environment spec. saturation humidity (t+1)   kg/kg
              49                     !    *pgeo*         geopotential                                  m2/s2
              50                     !    *pgeoh*        geopotential on half levels                  m2/s2
              51                     !    *paph*         provisional pressure on half levels           pa
              52                     !    *ptu*          temperature in updrafts                        k
              53                     !    *pqu*          spec. humidity in updrafts                   kg/kg
              54                     !    *plu*          liquid water content in updrafts             kg/kg
              55                     !    *puu*          u-velocity in updrafts                        m/s
              56                     !    *pvu*          v-velocity in updrafts                        m/s
              57                     !    *pmfub*        massflux in updrafts at cloud base           kg/(m2*s)
              58                     !    updated parameters (real):
              59                     !    *prfl*         precipitation rate                           kg/(m2*s)
              60                     !    output parameters (real):
              61                     !    *ptd*          temperature in downdrafts                      k
              62                     !    *pqd*          spec. humidity in downdrafts                 kg/kg
              63                     !    *pud*          u-velocity in downdrafts                      m/s
              64                     !    *pvd*          v-velocity in downdrafts                      m/s
              65                     !    *pmfd*         massflux in downdrafts                       kg/(m2*s)
              66                     !    *pmfds*        flux of dry static energy in downdrafts       j/(m2*s)
              67                     !    *pmfdq*        flux of spec. humidity in downdrafts         kg/(m2*s)
              68                     !    *pdmfdp*       flux difference of precip. in downdrafts     kg/(m2*s)
              69                     !    output parameters (integer):
              70                     !    *kdtop*        top level of downdrafts
              71                     !    output parameters (logical):
              72                     !    *lddraf*       .true. if downdrafts exist
              73                     !          externals
              74                     !          ---------
              75                     !          *cuadjtq* for calculating wet bulb t and q at lfs
              76                     !----------------------------------------------------------------------
              77                       USE shr_kind_mod, only: r8 => shr_kind_r8
              78                       USE mo_constants,    ONLY: vtmpc1,  &! vtmpc1=rv/rd-1
              79                                                  cpd       ! specific heat at constant pressure
              80                       USE mo_cumulus_flux, ONLY: lmfdd,   &! true if cumulus downdr. is switched on
              81                                                  cmfdeps, &! fractional massflux for downdr. at lfs
              82                                                  lmfdudv   ! true if cumulus friction is switched on
              83                     
              84                     !----------------------------------------------------------------------
              85                           implicit none
              86                     
              87                           integer  klev,klon,nxj
              88                           real     ptenh(klon,klev),       pqenh(klon,klev), &
              89                          &         puen(klon,klev),        pven(klon,klev),  &
              90                          &         pten(klon,klev),        pqsen(klon,klev),  &
              91                          &         pgeo(klon,klev),                       &
              92                          &         pgeoh(klon,klev+1),     paph(klon,klev+1),&
              93                          &         ptu(klon,klev),         pqu(klon,klev),   &
              94                          &         puu(klon,klev),         pvu(klon,klev),   &
              95                          &         plu(klon,klev),                          &
              96                          &         pmfub(klon),            prfl(klon)
              97                     
              98                           real     ptd(klon,klev),         pqd(klon,klev),   &
              99                          &         pud(klon,klev),         pvd(klon,klev),    &
             100                          &         pmfd(klon,klev),        pmfds(klon,klev),  &
             101                          &         pmfdq(klon,klev),       pdmfdp(klon,klev)
             102                           integer  kcbot(klon),            kctop(klon),       &
             103                          &         kdtop(klon),            ikhsmin(klon)
             104                           logical  ldcum(klon),                              &
             105                          &         lddraf(klon)
             106                           integer  lndj(klon)
             107                     
             108                           real     ztenwb(klon,klev),      zqenwb(klon,klev), &
             109                          &         zcond(klon),            zph(klon),         &
             110                          &         zhsmin(klon)
             111                           logical  llo2(klon)
             112                     ! local variables
             113                           integer  jl,jk
             114                           integer  is,ik,icall,ike
             115                           real     zhsk,zttest,zqtest,zbuo,zmftop,foelhm
             116                     !----------------------------------------------------------------------
             117                     !     1.           set default values for downdrafts
             118                     !                  ---------------------------------
             119                     !xb110>
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2286
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zcond
                                   <<< Loop-information  End >>>
             120        pp   4v            zcond = 0.
             121                     !xb110<
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 942
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      kdtop, ikhsmin, lddraf, zhsmin
                                   <<< Loop-information  End >>>
             122     1  pp   2v             do jl = 1, nxj
             123     1   p   2v              lddraf(jl)=.false.
             124     1   p   2v              kdtop(jl)=klev+1
             125     1   p   2v              ikhsmin(jl)=klev+1
             126     1   p   2v              zhsmin(jl)=1.e8
             127     1   p   2v            enddo
             128                     !----------------------------------------------------------------------
             129                     
             130                     !     2.           determine level of free sinking:
             131                     !                  downdrafts shall start at model level of minimum
             132                     !                  of saturation moist static energy or below
             133                     !                  respectively
             134                     
             135                     !                  for every point and proceed as follows:
             136                     
             137                     !                    (1) determine level of minimum of hs
             138                     !                    (2) determine wet bulb environmental t and q
             139                     !                    (3) do mixing with cumulus cloud air
             140                     !                    (4) check for negative buoyancy
             141                     !                    (5) if buoyancy>0 repeat (2) to (4) for next
             142                     !                        level below
             143                     
             144                     !                  the assumption is that air of downdrafts is mixture
             145                     !                  of 50% cloud air + 50% environmental air at wet bulb
             146                     !                  temperature (i.e. which became saturated due to
             147                     !                  evaporation of rain and cloud water)
             148                     !                  ----------------------------------------------------
             149     1                     do jk=3,klev-2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pten, pgeo, pqsen, zhsmin
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 2  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             150     2   s   2s             do jl = 1, nxj
             151     2   m   2m                 zhsk=cpd*pten(jl,jk)+pgeo(jl,jk) +  &
             152     2                    &         foelhm(pten(jl,jk))*pqsen(jl,jk)
             153     3   p   2v                 if(zhsk .lt. zhsmin(jl)) then
             154     3   p   2v                    zhsmin(jl) = zhsk
             155     3   p   2v                    ikhsmin(jl)= jk
             156     3   p   2v                 end if
             157     2   p   2v               end do
             158     1                     end do
             159                     
             160                     
             161                           ike=klev-3
             162     1                     do jk=3,ike
             163     1               
             164     1               !     2.1          calculate wet-bulb temperature and moisture
             165     1               !                  for environmental air in *cuadjtq*
             166     1               !                  -------------------------------------------
             167     1                       is=0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 217
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             168     2  pp    v             do jl = 1, nxj
             169     2   p    v                ztenwb(jl,jk)=ptenh(jl,jk)
             170     2   p    v                zqenwb(jl,jk)=pqenh(jl,jk)
             171     2   p    v                zph(jl)=paph(jl,jk)
             172     2   p    v                llo2(jl)=ldcum(jl).and.prfl(jl).gt.0..and..not.lddraf(jl).and. &
             173     2                    &     (jk.lt.kcbot(jl).and.jk.gt.kctop(jl)).and. jk.ge.ikhsmin(jl)
             174     3   p    v                if(llo2(jl))then
             175     3   p                      is=is+1
             176     3   p    v                endif
             177     2   p    v              enddo
             178     1                       if(is.eq.0) cycle
             179     1               
             180     1                       ik=jk
             181     1                       icall=2
             182     1                       call cuadjtq_n                                           &
             183     1                    &   ( nxj, klon, klev, ik, zph, ztenwb, zqenwb, llo2, icall)
             184     1               
             185     1               !     2.2          do mixing of cumulus and environmental air
             186     1               !                  and check for negative buoyancy.
             187     1               !                  then set values for downdraft at lfs.
             188     1               !                  ----------------------------------------
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 173
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      llo2, zqenwb, pqenh, zcond, ptenh, pqu
                                   <<<      ztenwb, ptu, pmfub, prfl, kdtop, ptd
                                   <<<      pqd, pmfd, pgeoh, lddraf
                                   <<<    PREFETCH(SOFT) : 6
                                   <<<     SEQUENTIAL : 6
                                   <<<      pmfds: 2, pmfdq: 2, pdmfdp: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             189     2  pp    v             do jl = 1, nxj
             190     3   p    v                if(llo2(jl)) then
             191     3   p    v                  zttest=0.5*(ptu(jl,jk)+ztenwb(jl,jk))
             192     3   p    v                  zqtest=0.5*(pqu(jl,jk)+zqenwb(jl,jk))
             193     3   p    v                  zbuo=zttest*(1.+vtmpc1  *zqtest)-                    &
             194     3                    &       ptenh(jl,jk)*(1.+vtmpc1  *pqenh(jl,jk))
             195     3   p    v                  zcond(jl)=pqenh(jl,jk)-zqenwb(jl,jk)
             196     3   p    v                  zmftop=-cmfdeps*pmfub(jl)
             197     4   p    v                  if(zbuo.lt.0..and.prfl(jl).gt.10.*zmftop*zcond(jl)) then
             198     4   p    v                    kdtop(jl)=jk
             199     4   p    v                    lddraf(jl)=.true.
             200     4   p    v                    ptd(jl,jk)=zttest
             201     4   p    v                    pqd(jl,jk)=zqtest
             202     4   p    v                    pmfd(jl,jk)=zmftop
             203     4   p    v                    pmfds(jl,jk)=pmfd(jl,jk)*(cpd*ptd(jl,jk)+pgeoh(jl,jk))
             204     4   p    v                    pmfdq(jl,jk)=pmfd(jl,jk)*pqd(jl,jk)
             205     4   p    v                    pdmfdp(jl,jk-1)=-0.5*pmfd(jl,jk)*zcond(jl)
             206     4   p    v                    prfl(jl)=prfl(jl)+pdmfdp(jl,jk-1)
             207     4   p    v                  endif
             208     3   p    v                endif
             209     2   p    v              enddo
             210     1               
             211     1                     enddo
             212                     
             213                           return
             214                           end subroutine cudlfs_n


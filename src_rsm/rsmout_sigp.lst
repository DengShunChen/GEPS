 External subroutine subprogram "rsmout_sigp"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine rsmout_sigp ( itau,nx,my,my_max,lev,ncld            &
               2                                              , idtg,ptop,rad,grav,cosl                   &
               3                                              , pt,sgeo,snr,gwr,tg,pk                     &
               4                                              , ut,vt,tt,qt,km,smc,stc                    &
               5                                              , ice,land,ocean,xlon,xlat)
               6                     #ifdef RSM
               7                     
               8                     #if defined(CWB_MPMD)  || defined(CWBSUM)
               9                     #define send_RSM
              10                     #else
              11                     #define write_RSM
              12                     #endif
              13                     
              14                           use index
              15                           use mpe
              16                           use radn, only : ntoz,ntcw,ntrw,ntiw,ntsw,ntgl
              17                     
              18                     #if defined(CWB_MPMD) || defined(CWBSUM)
              19                           use rank, only : root_rsm,myrank,itag
              20                     #else
              21                           use rank, only : myrank
              22                     #endif
              23                           use const, only: rlon1, rlon2, rlat1, rlat2, rgrdsz, rsmsfcmgrhr &
              24                                     ,RTYPE
              25                     
              26                           implicit  none
              27                     
              28                           logical   ldosfc
              29                     
              30                           integer   itau,nx,my,my_max,lev,ncld,km
              31                     
              32                           real      ptop,rad,grav
              33                     
              34                           real(kind=RTYPE)::ut(nxp,lev,my_max),vt(nxp,lev,my_max) &
              35                               ,tt(nxp,lev,my_max),qt(nxp,lev*ncld,my_max)         &
              36                               ,pt(nxp,my_max),pk(nxp,lev,my_max),sgeo(nxp,my_max)
              37                     
              38                           real(kind=RTYPE)::wrk1(nxp,my_max),work(nx,my)
              39                     
              40                           real(kind=RTYPE)      cosl(my)
              41                           real      snr(nxp,my_max),gwr(nxp,my_max),                &
              42                                     tg(nxp,my_max),                                 &
              43                                     smc(nxp,km,my_max),stc(nxp,km,my_max),          &
              44                                     workr8(nx,my)
              45                     
              46                           logical   land(nxp,my_max),ocean(nxp,my_max),ice(nxp,my_max)
              47                     
              48                           real      xlon(nx,my_max),xlat(my)
              49                           real      dx,dy
              50                     
              51                           integer*8 idtg
              52                     !
              53                     ! local array
              54                           integer   i,k,ii,jj,j,nxj,kk,ntrac,nclds
              55                           real      xx
              56                     !
              57                           integer   nxmy, nxmyl, nxmys
              58                           integer   nxs, mys, len2
              59                           integer   x1, x2, y1, y2
              60                     #ifdef send_RSM
              61                           real,allocatable ::  g3send(:,:,:),g2send(:,:)
              62                     #endif
              63                           integer   ierr
              64                     
              65                           integer   nsig, ndig, recsize
              66                           character cfhour*16,cform*40,cidtg*12
              67                     
              68                           integer   itag0
              69                     
              70                     ! output record
              71                           integer   kfh,knt,ktt,ksgeo,ksfcp,kuu,kvv
              72                           integer   kqt,kcw,krw,kiw,ksw,kgl,koz
              73                           integer   ktg,ksmc,ksnr,kstc,ksimk,kslmk
              74                           integer   ktrace,kend,krec
              75                           integer   klon,klat
              76                           integer   ntindex(7)
              77                     
              78                           ldosfc=mod(float(itau)+0.00001, float(rsmsfcmgrhr) ).lt.0.01
              79                     
              80                     ! local variable initization
              81                           nxmy=nx*my
              82                           nxmyl=nx*my*lev
              83                           nxmys=nx*my*km
              84                           do i = 1, nxmy
              85                            work(i,1) = 0.
              86                           enddo
              87                     !
              88                           if(myrank .eq. 0) print *,' rsmout_sigp : ntoz=',ntoz
              89                           if ( ntoz .gt. 0 ) then
              90                             nclds=ntoz-1
              91                           else
              92                             nclds=ncld
              93                           endif
              94                           if(myrank .eq. 0) print *,' rsmout_sigp : nclds=',nclds
              95                     
              96                           if(myrank .eq. 0) print *,' rsmout_sigp : ',                     &
              97                                                     'ntoz,ntcw,ntrw,ntiw,ntsw,ntgl=',      &
              98                                                      ntoz,ntcw,ntrw,ntiw,ntsw,ntgl
              99                     ! list tracer index
             100                             ntindex(1)=nclds
             101                             ntindex(2)=ntoz
             102                             ntindex(3)=ntcw
             103                             ntindex(4)=ntrw
             104                             ntindex(5)=ntiw
             105                             ntindex(6)=ntsw
             106                             ntindex(7)=ntgl
             107                     
             108                     #ifdef write_RSM
             109                     ! output file name
             110                           nsig=21
             111                     #endif
             112                           ndig=max(log10(itau+0.5)+1.,3.)
             113                           write(cform,'("(i",i1,".",i1,")")') ndig,ndig
             114                           write(cfhour,cform) itau
             115                           write(cidtg,'(I12.12)') idtg
             116                     
             117                     ! output record sequence
             118                           ktrace=-999
             119                     !lat/lon
             120                           klon=2
             121                           klat=3
             122                           kfh=1
             123                           knt=kfh+1
             124                           ksgeo=knt+1
             125                           ksfcp=ksgeo+1
             126                           ktt=ksfcp+1
             127                           kuu=ktt+lev
             128                           kvv=kuu+lev
             129                           kqt=kvv+lev
             130                           kcw=kqt+lev
             131                           koz=kcw+lev
             132                           kslmk=koz+lev
             133                           ksnr=kslmk+1
             134                           ksimk=ksnr+1
             135                           ktg=ksimk+1
             136                           ksmc=ktg+1
             137                           kstc=ksmc+4
             138                           krw=kstc+4
             139                           kiw=krw+lev
             140                           ksw=kiw+lev
             141                           kgl=ksw+lev
             142                           kend=kgl+lev
             143                     
             144                           if(myrank.eq.0) then
             145                             print*,'klon,klat='
             146                             print*,klon,klat
             147                             print*,'ktrace,kfh,knt,ktt,ksgeo,ksfcp,kuu,kvv,kqt,kcw,koz='
             148                             print*,ktrace,kfh,knt,ktt,ksgeo,ksfcp,kuu,kvv,kqt,kcw,koz
             149                             print*,'ktg,ksmc,ksnr,kstc,ksimk,kslmk,krw,kiw,ksw,kgl,kend='
             150                             print*,ktg,ksmc,ksnr,kstc,ksimk,kslmk,krw,kiw,ksw,kgl,kend
             151                           endif
             152                     !
             153                     ! output record, regional domain
             154                           dx=xlon(2,1)-xlon(1,1)
             155                           dy=xlat(2)-xlat(1)
             156                           rgrdsz=min(dx,dy)
             157                           if (myrank.eq.0) print*,'rgrdsz=',rgrdsz
             158                           nxs=nint((rlon2-rlon1)/rgrdsz+1.)
             159                           mys=nint((rlat2-rlat1)/rgrdsz+1.)
             160                           x1=nint(  (rlon1-0.)     /rgrdsz+1.)
             161                           x2=nxs-1+x1
             162                           y1=nint(  (rlat1-(-90.)) /rgrdsz+1.)
             163                           y2=mys-1+y1
             164                           len2=nxs*mys
             165                     !
             166                     ! print/output information of regional domain at itau=0
             167                     !
             168                           if(itau.eq.0) then
             169                             do jj = 1, jlistnum
             170                              j=jlist1(jj)
             171                              nxj=nxdef_2d(j)
             172                              ii=nxjstart(j)
             173                             do i = 1, nxj
             174                                wrk1(i,jj)=xlon(ii,jj)
             175                                if (xlon(ii,jj).lt. 0) wrk1(i,jj)=(xlon(ii,jj)+360.)
             176                                ii=ii+1
             177                             enddo
             178                             enddo
             179                             call unify_reduceintp(nx,my,my_max,wrk1,work)
             180                     
             181                             if(myrank.eq.0) then
             182                               open(99,file='rsm_xlon_'//cidtg//'.txt',status='unknown', &
             183                                   form='formatted',iostat=ierr)
             184                               if (ierr/=0) stop "rsmout_sigp: open file xlon fail"
             185                               write(99,*) work(x1:x2,1)
             186                     #ifdef send_RSM
             187                             workr8=work
             188                             itag=klon
             189                             call mpmd_send(workr8(x1:x2,1),nxs,root_rsm,itag,'R')
             190                     #endif
             191                               close(99)
             192                               open(98,file='rsm_xlat_'//cidtg//'.txt',status='unknown', &
             193                                   form='formatted',iostat=ierr)
             194                               if (ierr/=0) stop "rsmout_sigp: open file xlat fail"
             195                               write(98,*) xlat(y1:y2)
             196                     #ifdef send_RSM
             197                             itag=klat
             198                             call mpmd_send(xlat(y1:y2),mys,root_rsm,itag,'R')
             199                     #endif
             200                               close(98)
             201                               print*,'-----output data for rsm-----'
             202                               print*,'--nxs, mys, x1, x2, y1, y2=--'
             203                               print*,'-',nxs, mys, x1, x2, y1, y2,'-'
             204                             endif
             205                           endif  !endif (itau=0)
             206                     
             207                     #ifdef send_RSM
             208                           if(myrank.eq.0) then
             209                     ! mpmd send tag
             210                           itag0=itag
             211                           endif
             212                     #endif
             213                     
             214                     
             215                     ! allocate temporary
             216                     #ifdef send_RSM
             217                           allocate(g3send(nxs,mys,lev),g2send(nxs,mys), &
             218                                    stat=ierr)
             219                           if (ierr/=0) stop "rsmout_sigp: allocate fail"
             220                           if (ierr/=0) call mpe_finalize
             221                     #endif
             222                     
             223                     
             224                     #ifdef write_RSM
             225                           if(myrank.eq.0) then
             226                             inquire(iolength=recsize) workr8(x1:x2,y1:y2)
             227                             open(nsig,file='rsm_data_'//cidtg//'.f'//cfhour,status='unknown', &
             228                                 form='unformatted',access='direct',recl=recsize,iostat=ierr)
             229                             if (ierr/=0) stop "rsmout_sigp: open file fail"
             230                           endif
             231                     #endif
             232                     
             233                     #ifdef write_RSM
             234                           if(myrank.eq.0) then
             235                             krec=kfh
             236                             write(nsig,rec=krec) float(itau)
             237                           endif
             238                     #endif
             239                     #ifdef send_RSM
             240                           if(myrank.eq.0) then
             241                             itag=itag0+kfh
             242                             call mpmd_send(float(itau),1,root_rsm,itag,'R')
             243                             print*,'gfs kfh itag=',itag
             244                           endif
             245                     #endif
             246                     
             247                     ! gfs tracer index
             248                     #ifdef write_RSM
             249                           if(myrank.eq.0) then
             250                             krec=knt
             251                             write(nsig,rec=krec) ntindex
             252                           endif
             253                     #endif
             254                     #ifdef send_RSM
             255                           if(myrank.eq.0) then
             256                             itag=itag0+knt
             257                             call mpmd_send(ntindex,7,root_rsm,itag,'I')
             258                             print*,'gfs knt itag=',itag
             259                           endif
             260                     #endif
             261                     !
             262                     !  convert terrain geopotential to terrain geopotential hight
             263                     !
             264                           do 28 jj = 1, jlistnum
             265                            j=jlist1(jj)
             266                            nxj=nxdef_2d(j)
             267                           do 28 i=1,nxj
             268                             wrk1(i,jj)=sgeo(i,jj)/grav
             269                      28   continue
             270                           call unify_reduceintp(nx,my,my_max,wrk1,work)
             271                     !
             272                     #ifdef write_RSM
             273                           if(myrank.eq.0) then
             274                             workr8=work
             275                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             276                           endif
             277                     #endif
             278                     #ifdef send_RSM
             279                           if(myrank.eq.0) then
             280                             g2send(:,:)=work(x1:x2,y1:y2)
             281                           endif
             282                     #endif
             283                     #ifdef send_RSM
             284                           if(myrank.eq.0) then
             285                             itag=itag0+ksgeo
             286                             call mpmd_send(g2send,len2,root_rsm,itag,'R')
             287                             print*,'gfs ksgeo itag=',itag
             288                           endif
             289                     #endif
             290                     !
             291                     ! surface pressure
             292                     !
             293                           do 31 jj = 1, jlistnum
             294                            j=jlist1(jj)
             295                            nxj=nxdef_2d(j)
             296                           do 31 i = 1,nxj
             297                            wrk1(i,jj)=pt(i,jj)+ptop
             298                      31   continue
             299                           call unify_reduceintp(nx,my,my_max,wrk1,work)
             300                     !
             301                     #ifdef write_RSM
             302                           if(myrank.eq.0) then
             303                             workr8=work
             304                             krec=ksfcp
             305                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             306                           endif
             307                     #endif
             308                     #ifdef send_RSM
             309                           if(myrank.eq.0) then
             310                             g2send(:,:)=work(x1:x2,y1:y2)
             311                           endif
             312                     #endif
             313                     #ifdef send_RSM
             314                           if(myrank.eq.0) then
             315                             itag=itag0+ksfcp
             316                             call mpmd_send(g2send,len2,root_rsm,itag,'R')
             317                             print*,'gfs ksfcp itag=',itag
             318                           endif
             319                     #endif
             320                     !
             321                     !  convert virture potential temperature to temperature
             322                     !
             323                           do k=1,lev
             324                             do 20 jj = 1, jlistnum
             325                               j=jlist1(jj)
             326                               nxj=nxdef_2d(j)
             327                             do 20 i = 1,nxj
             328                               wrk1(i,jj)=tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             329                      20     continue
             330                             call unify_reduceintp(nx,my,my_max,wrk1,work)
             331                     !
             332                     #ifdef write_RSM
             333                           if(myrank.eq.0) then
             334                             workr8=work
             335                             krec=ktt-1+(lev-k+1)
             336                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             337                           endif
             338                     #endif
             339                     #ifdef send_RSM
             340                           if(myrank.eq.0) then
             341                             g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             342                           endif
             343                     #endif
             344                           enddo
             345                     #ifdef send_RSM
             346                           if(myrank.eq.0) then
             347                           do k=1,lev
             348                             itag=itag0+ktt-1+k
             349                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             350                           enddo
             351                           endif
             352                     #endif
             353                     
             354                     !
             355                     !  convert gaussain u,v component to normal u,v component
             356                     !
             357                     !
             358                     ! u
             359                     !
             360                           do k=1,lev
             361                             do 21 jj = 1, jlistnum
             362                               j=jlist1(jj)
             363                               nxj=nxdef_2d(j)
             364                               xx = rad/cosl(j)
             365                             do 21 i = 1,nxj
             366                               wrk1(i,jj)=ut(i,k,jj)*xx
             367                      21     continue
             368                             call unify_reduceintp(nx,my,my_max,wrk1,work)
             369                     !
             370                     #ifdef write_RSM
             371                           if(myrank.eq.0) then
             372                             workr8=work
             373                             krec=kuu-1+(lev-k+1)
             374                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             375                           endif
             376                     #endif
             377                     #ifdef send_RSM
             378                           if(myrank.eq.0) then
             379                             g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             380                           endif
             381                     #endif
             382                           enddo
             383                     #ifdef send_RSM
             384                           if(myrank.eq.0) then
             385                           do k=1,lev
             386                             itag=itag0+kuu-1+k
             387                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             388                           enddo
             389                           endif
             390                     #endif
             391                     !
             392                     ! v
             393                     !
             394                           do k=1,lev
             395                             do 22 jj = 1, jlistnum
             396                               j=jlist1(jj)
             397                               nxj=nxdef_2d(j)
             398                               xx = rad/cosl(j)
             399                             do 22 i = 1,nxj
             400                               wrk1(i,jj)=vt(i,k,jj)*xx
             401                      22     continue
             402                             call unify_reduceintp(nx,my,my_max,wrk1,work)
             403                     !
             404                     #ifdef write_RSM
             405                           if(myrank.eq.0) then
             406                             workr8=work
             407                             krec=kvv-1+(lev-k+1)
             408                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             409                           endif
             410                     #endif
             411                     #ifdef send_RSM
             412                           if(myrank.eq.0) then
             413                             g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             414                           endif
             415                     #endif
             416                           enddo
             417                     #ifdef send_RSM
             418                           if(myrank.eq.0) then
             419                           do k=1,lev
             420                             itag=itag0+kvv-1+k
             421                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             422                           enddo
             423                           endif
             424                     #endif
             425                     !
             426                     ! specific humidity
             427                     !
             428                           do k=1,lev
             429                             do 23 jj = 1, jlistnum
             430                               j=jlist1(jj)
             431                               nxj=nxdef_2d(j)
             432                             do 23 i = 1,nxj
             433                               wrk1(i,jj)=qt(i,k,jj)
             434                      23     continue
             435                             call unify_reduceintp(nx,my,my_max,wrk1,work)
             436                     !
             437                     #ifdef write_RSM
             438                           if(myrank.eq.0) then
             439                             workr8=work
             440                             krec=kqt-1+(lev-k+1)
             441                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             442                           endif
             443                     #endif
             444                     #ifdef send_RSM
             445                           if(myrank.eq.0) then
             446                             g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             447                           endif
             448                     #endif
             449                           enddo
             450                     #ifdef send_RSM
             451                           if(myrank.eq.0) then
             452                           do k=1,lev

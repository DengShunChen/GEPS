             535                             g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             536                           endif
             537                     #endif
             538                           enddo
             539                     #ifdef send_RSM
             540                           if(myrank.eq.0) then
             541                           do k=1,lev
             542                             itag=itag0+koz-1+k
             543                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             544                           enddo
             545                           endif
             546                     #endif
             547                     !
             548                           endif
             549                     !
             550                     !----- start to output surface data ------
             551                           if (ldosfc) then
             552                     
             553                           if(myrank .eq. 0) print *,' rsmout_sigp : output surface file'
             554                     ! ***land and sea mask***(land=1,sea=0)***
             555                           wrk1(:,:)=0.0
             556                           do jj=1,jlistnum
             557                             j=jlist1(jj)
             558                             nxj=nxdef_2d(j)
             559                           do i=1,nxj
             560                             if(land(i,jj))wrk1(i,jj)=1.0
             561                             if(ocean(i,jj))wrk1(i,jj)=0.0
             562                           enddo
             563                           enddo
             564                           call unify_reduceintp(nx,my,my_max,wrk1,work)
             565                     !

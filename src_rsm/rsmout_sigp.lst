             454                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             455                           enddo
             456                           endif
             457                     #endif
             458                     !
             459                     ! output all hydrometeors and ozone one by one
             460                     !
             461                           if( nclds .ge. 2 ) then
             462                             do ntrac=2,nclds
             463                               if(myrank .eq. 0) print *,' rsmout_sigp : ntrac=',ntrac
             464                               do k=1,lev
             465                                 kk = (ntrac-1)*lev+k
             466                                 do 26 jj = 1, jlistnum
             467                                   j=jlist1(jj)
             468                                   nxj=nxdef_2d(j)
             469                                 do 26 i = 1,nxj
             470                                   wrk1(i,jj)=qt(i,kk,jj)
             471                      26         continue
             472                                 call unify_reduceintp(nx,my,my_max,wrk1,work)
             473                     !
             474                                 if(ntrac.eq.ntcw)then
             475                                   ktrace=kcw                                ! cloud liquid water content
             476                                 else if(ntrac.eq.ntiw)then
             477                                   ktrace=kiw                                ! cloud ice content
             478                                 else if(ntrac.eq.ntrw)then
             479                                   ktrace=krw                                ! rain
             480                                 else if(ntrac.eq.ntsw)then
             481                                   ktrace=ksw                                ! snow
             482                                 else if(ntrac.eq.ntgl)then
             483                                   ktrace=kgl                                ! graupel
             484                                 else
             485                                   stop "ERROR: rsmout_sigp: wrong tracer index found !"
             486                                   call mpe_finalize
             487                                 endif
             488                     #ifdef write_RSM
             489                                 if(myrank.eq.0) then
             490                                   workr8=work
             491                                   krec=ktrace-1+(lev-k+1)
             492                                   write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             493                                 endif
             494                     #endif
             495                     #ifdef send_RSM
             496                                 if(myrank.eq.0) then
             497                                   g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             498                                 endif
             499                     #endif
             500                                 enddo   !enddo k=1,lev
             501                     #ifdef send_RSM

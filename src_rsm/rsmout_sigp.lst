             505                                   call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             506                                 enddo
             507                                 endif
             508                     #endif
             509                     !
             510                             enddo   !enddo ntrac=2,nclds
             511                           end if    !endif (nclds.gt.2)
             512                     !
             513                     ! output ozone
             514                     !
             515                           if ( ntoz .eq. ncld ) then
             516                             do k=1,lev
             517                               do jj = 1, jlistnum
             518                                 j=jlist1(jj)
             519                                 nxj=nxdef_2d(j)
             520                                 do i = 1,nxj
             521                                   wrk1(i,jj)=qt(i,k+(ntoz-1)*lev,jj)
             522                                 enddo
             523                               enddo
             524                               call unify_reduceintp(nx,my,my_max,wrk1,work)

             581                             call mpmd_send(g2send,len2,root_rsm,itag,'R')
             582                           endif
             583                     #endif
             584                     ! ***snr***
             585                           wrk1=snr
             586                           call unify_reduceintp(nx,my,my_max,wrk1,work)
             587                     !
             588                     #ifdef write_RSM
             589                           if(myrank.eq.0) then
             590                             workr8=work
             591                             krec=ksnr
             592                             write(nsig,rec=krec) ((workr8(i,j),i=x1,x2),j=y1,y2)
             593                           endif
             594                     #endif
             595                     #ifdef send_RSM

                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, wrk1
                                   <<< Loop-information  End >>>
             292     2   p   2v            do 31 i = 1,nxj
             293     2   p   2v             wrk1(i,jj)=pt(i,jj)+ptop
             294     1   p   2v       31   continue
             295                           call unify_reduceintp(nx,my,my_max,wrk1,work)
             296                     !
             297                     #ifdef write_RSM
             298     1                     if(myrank.eq.0) then
             299     1                       krec=ksfcp
             300     1                       write(nsig,rec=krec) ((work(i,j),i=x1,x2),j=y1,y2)
             301     1                     endif
             302                     #endif
             303                     #ifdef send_RSM
             304                           if(myrank.eq.0) then
             305                             g2send(:,:)=work(x1:x2,y1:y2)
             306                           endif
             307                     #endif
             308                     #ifdef send_RSM
             309                           if(myrank.eq.0) then
             310                             itag=itag0+ksfcp
             311                             call mpmd_send(g2send,len2,root_rsm,itag,'R')
             312                             print*,'gfs ksfcp itag=',itag
             313                           endif
             314                     #endif
             315                     !
             316                     !  convert virture potential temperature to temperature
             317                     !
             318     1                     do k=1,lev
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tt, pk, qt, wrk1
                                   <<< Loop-information  End >>>
             319     2  pp                   do 20 jj = 1, jlistnum
             320     2   p                     j=jlist1(jj)
             321     2   p                     nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pk, tt, qt, wrk1
                                   <<< Loop-information  End >>>
             322     3   p   2v              do 20 i = 1,nxj
             323     3   p   2v                wrk1(i,jj)=tt(i,k,jj)*pk(i,k,jj)/(1.0+0.608*qt(i,k,jj))
             324     2   p   2v       20     continue
             325     1                       call unify_reduceintp(nx,my,my_max,wrk1,work)
             326     1               !
             327     1               #ifdef write_RSM
             328     2                     if(myrank.eq.0) then
             329     2                       krec=ktt-1+(lev-k+1)
             330     2                       write(nsig,rec=krec) ((work(i,j),i=x1,x2),j=y1,y2)
             331     2                     endif
             332     1               #endif
             333     1               #ifdef send_RSM
             334     1                     if(myrank.eq.0) then
             335     1                       g3send(:,:,lev-k+1)=work(x1:x2,y1:y2)
             336     1                     endif
             337     1               #endif
             338     1                     enddo
             339                     #ifdef send_RSM
             340                           if(myrank.eq.0) then
             341                           do k=1,lev
             342                             itag=itag0+ktt-1+k
             343                             call mpmd_send(g3send(:,:,k),len2,root_rsm,itag,'R')
             344                           enddo
             345                           endif
             346                     #endif

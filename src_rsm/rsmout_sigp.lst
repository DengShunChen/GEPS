                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sgeo, wrk1
                                   <<< Loop-information  End >>>
             263     2   p   2v            do 28 i=1,nxj
             264     2   p   2v              wrk1(i,jj)=sgeo(i,jj)/grav

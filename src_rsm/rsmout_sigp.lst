             657                     !
             658                     ! ***0-0.1m soil moisture content [fraction]***
             659                     ! ***0.1-0.4m soil moisture content [fraction]***
             660                     ! ***0.4-1m soil moisture content [fraction]***
             661                     ! ***below 1m soil moisture content [fraction]***
             662                           if (km/=4) stop "wrong soil layers, should be 4 layers NOAHLSM"
             663                           do k=1,km
             664                           do jj = 1, jlistnum
             665                            j=jlist1(jj)
             666                            nxj=nxdef_2d(j)
             667                           do i = 1,nxj

 External subroutine subprogram "splinc"
  (inc)(line-no.)(nest)(optimize)
               1                           subroutine splinc ( n,im,il,ib,cof )
               2                     !
               3                     !     prepare constant coefficients for 1-d cubic spline interpolation
               4                     !     ( warning: for spherical grids only )
               5                     !
               6                     !     n       : dimension of input array to be interpolated from
               7                     !     im      : dimension of output array to be interpolated to
               8                     !     il(im)  : address index of output points by input grid units
               9                     !     ib(n)   : address index of input points by output grid units
              10                     !     cof(n*3): cubic interpolation coef. for each grid interval
              11                     !
              12                           implicit  none
              13                           integer   n,im,i,j,nm2,nt2,ne,nu
              14                           real      fac,facx,v,bn
              15                     
              16                           integer   il(im),ib(n)
              17                           real      cof(n*3)
              18                     !
              19                           fac = float(n) / float(im)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      il
                                   <<< Loop-information  End >>>
              20     1  pp   2v            do 100 i = 1, im
              21     1   p   2v              il(i) = 1.0 + (float(i-1)*fac + 0.00001)
              22     1   p   2v        100 continue
              23                           facx = float(im) / float(n)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 593
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ib
                                   <<< Loop-information  End >>>
              24     1  pp   2v            do 110 i = 1, n
              25     1   p   2v              ib(i) = 1.0 + (float(i-1)*facx + 0.00001)
              26     1   p   2v        110 continue
              27                     !
              28                           nm2 = n - 2
              29                           nt2 = n*2
              30                     !
              31                     !     prepare grid-related constant coef. used in gaussian elimination
              32                     !
              33                           cof(n+1) = 0.25
              34                           v = 1.0
              35                           cof(1) = cof(n+1)
              36                           cof(nt2+1) = cof(n+1)
              37                           bn = - v*cof(nt2+1) + 4.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.23, ITR: 32, MVE: 2, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cof
                                   <<< Loop-information  End >>>
              38     1   s   8s            do 200 j = 2, nm2
              39     1   p   8v               ne = j + n
              40     1   s   8s               cof(ne) = 1.0/(4.0-cof(j-1))
              41     1   s   8s               cof(j) = cof(ne)
              42     1   s   8s               nu = j + nt2
              43     1   s   8s               cof(nu) = - cof(nu-1)*cof(ne)
              44     1   s   8s               v = - v*cof(j-1)
              45     1   m   8m               bn = bn - v*cof(nu)
              46     1   p   8v        200 continue
              47                           v = 1.0 - v*cof(nm2)
              48                           ne = nt2
              49                           cof(ne-1) = 1.0/(4.0-cof(nm2))
              50                           nu = nt2 + n
              51                           cof(n-1) = (1.0-cof(nu-2)) * cof(ne-1)
              52                           cof(ne) = 1.0/(bn - v*cof(n-1))
              53                     !
              54                           return
              55                           end


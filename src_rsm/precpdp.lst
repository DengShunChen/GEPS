               1                            subroutine precpdp (im,ix,km,dt,del,prsl,ps,q,cwm,t,rn  &
               2                           ,                   u00k,deltaq,psautco,lprnt)
               3                     !
               4                     !
               5                     !     ******************************************************************
               6                     !     *                                                                *
               7                     !     *           subroutine for precipitation processes               *
               8                     !     *           from suspended cloud water/ice                       *
               9                     !     *                                                                *
              10                     !     ******************************************************************
              11                     !     *                                                                *
              12                     !     *  originally created by  q. zhao                jan. 1995       *
              13                     !     *                         -------                                *
              14                     !     *  modified and rewritten by shrinivas moorthi   oct. 1998       *
              15                     !     *                            -----------------                   *
              16                     !     *  and                       hua-lu pan                          *
              17                     !     *                            ----------                          *
              18                     !     *                                                                *
              19                     !     *  references:                                                   *
              20                     !     *                                                                *
              21                     !     *  zhao and carr (1997), monthly weather review (august)         *
              22                     !     *  sundqvist et al., (1989) monthly weather review. (august)     *
              23                     !     *  chuang 2013, modify sr to define frozen precipitation fraction*
              24                     !     *                                                                *
              25                     !     ******************************************************************
              26                     !
              27                     !     in this code vertical indexing runs from surface to top of the
              28                     !     model
              29                     !
              30                     !     argument list:
              31                     !     --------------
              32                     !       im         : inner dimension over which calculation is made
              33                     !       ix         : maximum inner dimension
              34                     !       km         : number of vertical levels
              35                     !       dt         : time step in seconds
              36                     !       del(km)    : pressure layer thickness (bottom to top)
              37                     !       prsl(km)   : pressure values for model layers (bottom to top)
              38                     !       ps(im)     : surface pressure (centibars)
              39                     !       q(ix,km)   : specific humidity (updated in the code)
              40                     !       cwm(ix,km) : condensate mixing ratio (updated in the code)
              41                     !       t(ix,km)   : temperature       (updated in the code)
              42                     !       rn(im)     : precipitation over one time-step dt (m/dt)
              43                     !old    sr(im)     : index (=-1 snow, =0 rain/snow, =1 rain)
              44                     !new    sr(im)     : "snow ratio", ratio of snow to total precipitation
              45                     !       tcw(im)    : vertically integrated liquid water (kg/m**2)
              46                     !       cll(ix,km) : cloud cover
              47                     !hchuang rn(im) unit in m per time step
              48                     !        precipitation rate conversion 1 mm/s = 1 kg/m2/s
              49                     !
              50                           implicit none
              51                     
              52                           real hvap,grav,hfus,ttp,rd,rv,cp,eps,epsm1
              53                     
              54                           parameter(  hvap = 2.5000e+6 )
              55                           parameter(  grav = 9.80665e+0 )
              56                           parameter(  hfus = 3.3358e+5 )
              57                           parameter(   ttp = 2.7316e+2 )
              58                           parameter(    rd = 2.8705e+2 )
              59                           parameter(    rv = 4.6150e+2 )
              60                           parameter(    cp = 1.0046e+3 )
              61                           parameter(   eps = rd/rv )
              62                           parameter( epsm1 = eps-1 )
              63                     
              64                           real fpvs
              65                     !
              66                           real                  g,      h1,    h2,   h1000                 &
              67                           ,                     h1000g, d00,   d125, d5                    &
              68                           ,                     elwv,   eliv,  row                         &
              69                           ,                     epsq,   dldt,  tm10, eliw                  &
              70                           ,                     rcp,    rrow
              71                            parameter (g=grav,         h1=1.e0,     h2=2.e0,     h1000=1000.0 &
              72                           ,           h1000g=h1000/g, d00=0.e0,    d125=.125e0, d5=0.5e0   &
              73                           ,           elwv=hvap,      eliv=hvap+hfus,   row=1.e3           &
              74                           ,           epsq=2.e-12,    dldt=2274.e0,tm10=ttp-10.0           &
              75                           ,           eliw=eliv-elwv, rcp=h1/cp,   rrow=h1/row)
              76                     !
              77                           real, parameter ::                 cons_0=0.0,     cons_p01=0.01 &
              78                           ,                                  cons_20=20.0                  &
              79                           ,                                  cons_m30=-30.0, cons_50=50.0
              80                     !
              81                           integer im, ix, km, lat
              82                           real                  q(ix,km),   t(ix,km),    cwm(ix,km)        &
              83                           ,                                 del(ix,km),  prsl(ix,km)       &
              84                     !    &,                     cll(im,km), del(ix,km),  prsl(ix,km)      &
              85                           ,                     ps(im),     rn(im),      sr(im)            &
              86                           ,                     tcw(im),    dt                             &
              87                     !hchuang code change [+1l] : add record to record information in vertical in
              88                     !                       addition to total column precrl &
              89                           ,                     rainp(im,km), rnp(im),                     &
              90                                                 deltaq(ix,km),deltaqik,qtmp,qsmqr,         &
              91                                                 cwmik,qik,prestmp
              92                     !
              93                     !
              94                           real                  err(im),      ers(im),     precrl(im)      &
              95                           ,                     precsl(im),   precrl1(im), precsl1(im)     &
              96                           ,                     rq(im),       condt(im)                    &
              97                           ,                     conde(im),    rconde(im),  tmt0(im)        &
              98                           ,                     wmin(im,km),  wmink(im),   pres(im)        &
              99                           ,                     wmini(im,km), ccr(im),     cclim(km)       &
             100                           ,                     tt(im),       qq(im),      ww(im)          &
             101                           ,                     wfix(km),     u00k(ix,km), es(im)          &
             102                           ,                     zaodt,        psautco(im)
             103                     !
             104                           integer iw(im,km), ipr(im), iwl(im),     iwl1(im)
             105                     !
             106                            logical comput(im)
             107                            logical lprnt
             108                     !
             109                           real                  ke,   rdt,  us, cclimit, climit, cws, csm1 &
             110                           ,                     crs1, crs2, cr, aa2,     dtcp,   c00, cmr  &
             111                           ,                     tem,  c1,   c2, wwn,     aa1               &
             112                     !    &,                     tem,  c1,   c2, u00b,    u00t,   wwn &
             113                           ,                     precrk, precsk, pres1,   qk,     qw,  qi   &
             114                           ,                     ai,     bi, qint, fiw, wws, cwmk, expf     &
             115                           ,                     psaut, psaci, amaxcm, tem1, tem2           &
             116                           ,                     tmt0k, tmt15, psm1, psm2, ppr              &
             117                           ,                     rprs,  erk,   pps, sid, rid, amaxps        &
             118                           ,                     praut, pracw, fi, qc, amaxrq, rqkll
             119                           integer i, k, ihpr, n
             120                     
             121                     !      print*, 'psautco,prautco,evpco,wminco:',
             122                     !     &         psautco,prautco,evpco,wminco
             123                     !
             124                     !-----------------------preliminaries ---------------------------------
             125                     !
             126                     !     do k=1,km
             127                     !       do i=1,im
             128                     !         cll(i,k) = 0.0
             129                     !       enddo
             130                     !     enddo
             131                     !
             132                           rdt     = h1 / dt
             133                           ke      = 2.0e-5  ! commented on 09/10/99  -- opr value
             134                     !     ke      = 2.0e-6
             135                     !     ke      = 1.0e-5
             136                     !!!   ke      = 5.0e-5
             137                     !!    ke      = 7.0e-5
             138                     !      ke      = evpco
             139                     !     ke      = 7.0e-5
             140                           us      = h1
             141                           cclimit = 1.0e-3
             142                           climit  = 1.0e-20
             143                           cws     = 0.025
             144                     !
             145                           zaodt   = 800.0 * rdt
             146                     !
             147                           csm1    = 5.0000e-8   * zaodt
             148                           crs1    = 5.00000e-6  * zaodt
             149                           crs2    = 6.66600e-10 * zaodt
             150                           cr      = 5.0e-4      * zaodt
             151                           aa2     = 1.25e-3     * zaodt
             152                     !      aa1     = 4.0e-4
             153                     !
             154                           ke      = ke * sqrt(rdt)
             155                     !     ke      = ke * sqrt(zaodt)
             156                     !
             157                           dtcp    = dt * rcp
             158                     !
             159                     !     c00 = 1.5e-1 * dt
             160                     !     c00 = 10.0e-1 * dt
             161                     !     c00 = 3.0e-1 * dt          !05/09/2000
             162                     !     c00 = 1.0e-4 * dt          !05/09/2000
             163                           c00 = 1.0e-4 * dt         !05/09/2000
             164                     !     c00 = 5.0e-5 * dt          !06/28/2012
             165                           cmr = 1.0 / 3.0e-4
             166                     !     cmr = 1.0 / 5.0e-4
             167                     !     c1  = 100.0
             168                           c1  = 300.0
             169                           c2  = 0.5
             170                     !
             171                     !
             172                     !--------calculate c0 and cmr using lc at previous step-----------------
             173                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prsl, iw, wmini, wmin, rainp
                                   <<< Loop-information  End >>>
             174     1  pp                 do k=1,km
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.55, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      iw, prsl, wmini, wmin, rainp
                                   <<< Loop-information  End >>>
             175     2   p   2v              do i=1,im
             176     2   p   2v                tem   = (prsl(i,k)*0.01)
             177     2               !         tem   = sqrt(tem)
             178     2   p   2v                iw(i,k)    = 0.0
             179     2               !         wmin(i,k)  = 1.0e-5 * tem
             180     2               !         wmini(i,k) = 1.0e-5 * tem       ! testing for ras
             181     2               !
             182     2               
             183     2               !          wmin(i,k)  = 0.5e-5 * tem
             184     2               !          wmini(i,k) = 0.5e-5 * tem
             185     2   p   2v                wmin(i,k)  = 1.0e-5 * tem
             186     2   p   2v                wmini(i,k) = 1.0e-5 * tem
             187     2               
             188     2               
             189     2   p   2v                rainp(i,k) = 0.0
             190     2               
             191     2   p   2v              enddo
             192     1   p                 enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 552
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rnp, ccr, sr, rn, comput, precsl1
                                   <<<      precrl1, iwl1
                                   <<< Loop-information  End >>>
             193     1  pp    v            do i=1,im
             194     1               !       c0(i)  = 1.5e-1
             195     1               !       cmr(i) = 3.0e-4
             196     1               !
             197     1   p    v              iwl1(i)    = 0
             198     1   p    v              precrl1(i) = d00
             199     1   p    v              precsl1(i) = d00
             200     1   p    v              comput(i)  = .false.
             201     1   p    v              rn(i)      = d00
             202     1   p    v              sr(i)      = d00
             203     1   p    v              ccr(i)     = d00
             204     1               !
             205     1   p    v              rnp(i)     = d00
             206     1   p    v            enddo
             207                     !------------select columns where rain can be produced--------------
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wmin, wmini, cwm, comput
                                   <<< Loop-information  End >>>
             208     1                     do k=1, km-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 572
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 112, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      comput, wmin, cwm, wmini
                                   <<< Loop-information  End >>>
             209     2  pp   2v              do i=1,im
             210     2   p   2v                tem = min(wmin(i,k), wmini(i,k))
             211     2   p   2v                if (cwm(i,k) .gt. tem) comput(i) = .true.
             212     2   p   2v              enddo
             213     1                     enddo
             214                           ihpr = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      comput
                                   <<< Loop-information  End >>>
             215     1       2s            do i=1,im
             216     2       2v              if (comput(i)) then
             217     2       2m                 ihpr      = ihpr + 1
             218     2       2s                 ipr(ihpr) = i
             219     2       2v              endif
             220     1       2v            enddo
             221                     !***********************************************************************
             222                     !-----------------begining of precipitation calculation-----------------
             223                     !***********************************************************************
             224                     !     do k=km-1,2,-1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ipr, precrl1, precsl1, wmink, pres, ww
                                   <<<      qq, tt, iwl, ers, err, precsl, comput
                                   <<<      precrl, cwm, q, t
                                   <<< Loop-information  End >>>
             225     1                     do k=km,1,-1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 157
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.40, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      precrl1, precsl1, ipr, wmink, pres, ww
                                   <<<      qq, tt, iwl, ers, err, precsl, comput
                                   <<<      precrl
                                   <<< Loop-information  End >>>
             226     2  pp    v              do n=1,ihpr
             227     2   p    v                precrl(n) = precrl1(n)
             228     2   p    v                precsl(n) = precsl1(n)
             229     2   p    v                err  (n)  = d00
             230     2   p    v                ers  (n)  = d00
             231     2   p    v                iwl  (n)  = 0
             232     2               !
             233     2   p    v                i         = ipr(n)
             234     2   p    v                tt(n)     = t(i,k)
             235     2   p    v                qq(n)     = q(i,k)
             236     2   p    v                ww(n)     = cwm(i,k)
             237     2   p    v                wmink(n)  = wmin(i,k)
             238     2   p    v                pres(n)   = h1000 * prsl(i,k)
             239     2               !
             240     2   p    v                precrk = max(cons_0,    precrl1(n))
             241     2   p    v                precsk = max(cons_0,    precsl1(n))
             242     2   p    v                wwn    = max(ww(n), climit)
             243     2               !         if (wwn > wmink(n) .or. (precrk+precsk) > d00) then
             244     3   p    v                if (wwn > climit .or. (precrk+precsk) > d00) then
             245     3   p    v                  comput(n) = .true.
             246     3   p    v                else
             247     3   p    v                  comput(n) = .false.
             248     3   p    v                endif
             249     2   p    v              enddo
             250     1               !
             251     1               !       es(1:ihpr) = fpvs(tt(1:ihpr))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      comput
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 1  FILL 3
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             252     2   s    s              do n=1,ihpr
             253     3   p    v                if (comput(n)) then
             254     3   p    v                  i = ipr(n)
             255     3   p    v                  conde(n)  = (h1000*dt/g) * del(i,k)
             256     3   p    v                  condt(n)  = conde(n) * rdt
             257     3   p    v                  rconde(n) = h1 / conde(n)
             258     3   p    v                  qk        = max(epsq,  qq(n))
             259     3   m    m                  tmt0(n)   = tt(n) - 273.16
             260     3   p    v                  wwn       = max(ww(n), climit)
             261     3               !
             262     3               !           pl = pres(n) * 0.01
             263     3               !           call qsatd(tt(n), pl, qc)
             264     3               !           rq(n) = max(qq(n), epsq) / max(qc, 1.0e-10)
             265     3               !           rq(n) = max(1.0e-10, rq(n))           ! -- relative humidity---
             266     3               !
             267     3               !  the global qsat computation is done in pa
             268     3   p    v                  pres1   = pres(n)
             269     3               !           qw      = es(n)
             270     3   m    m                  qw      = min(pres1, fpvs(tt(n)))
             271     3   p    v                  qw      = eps * qw / (pres1 + epsm1 * qw)
             272     3   p    v                  qw      = max(qw,epsq)
             273     3               !
             274     3               !           tmt15 = min(tmt0(n), cons_m15)
             275     3               !           ai    = 0.008855
             276     3               !           bi    = 1.0
             277     3               !           if (tmt0(n) .lt. -20.0) then
             278     3               !             ai = 0.007225
             279     3               !             bi = 0.9674
             280     3               !           endif
             281     3               !           qi   = qw * (bi + ai*min(tmt0(n),cons_0))
             282     3               !           qint = qw * (1.-0.00032*tmt15*(tmt15+15.))
             283     3               !
             284     3   p    v                  qi   = qw
             285     3   p    v                  qint = qw
             286     3               !           if (tmt0(n).le.-40.) qint = qi
             287     3               !
             288     3               !-------------------ice-water id number iw------------------------------
             289     4   p    v                  if(tmt0(n) < -15.) then

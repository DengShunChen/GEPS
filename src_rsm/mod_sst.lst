            1046                     
            1047                             SUBROUTINE read_godas(idtg1)
            1048                     ! Ben-Jei Tsuang, NCHU, June 2009, Read GODAS data
            1049                     ! (http://http://cfs.ncep.noaa.gov/cfs/godas/)
            1050                     ! An initial ocean dataset is generated by combining
            1051                     ! script:  irish3::/tcrg/u40bjt00/get/get_godas.sh
            1052                     !
            1053                     ! history:
            1054                     !   2008/8/19: modified the code from mo_so4.f90
            1055                     !   2009/10/23: modified the code from read_woa0
            1056                     
            1057                     !          USE mo_control,       ONLY: ngl, nlon, ngodas, lamip, lmlo
            1058                     !          USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            1059                     !          USE mo_exception,     ONLY: finish, message, message_text
            1060                     
            1061                     !          USE mo_io,            ONLY: io_open_unit, io_close, io_read, &
            1062                     !                                      io_var_id, io_file_id, io_open, &
            1063                     !                                      woanc0, woanc1, woanc2
            1064                               USE mo_netCDF,        ONLY: io_inq_dimid, io_inq_dimlen,     &
            1065                                                           io_inq_varid, io_get_var_double, &
            1066                                                           io_get_vara_double, io_get_att_double
            1067                     !          USE mo_decomposition, ONLY: lc => local_decomposition, &
            1068                     !                                      gl_dc => global_decomposition
            1069                     !          USE mo_transpose,     ONLY: scatter_gp
            1070                     !          USE mo_filename,      ONLY: NETCDF
            1071                     
            1072                     
            1073                               !  Local scalars:
            1074                     
            1075                               ! number of codes read from godas file
            1076                               INTEGER, PARAMETER :: nrec = 5
            1077                               CHARACTER (12) :: cname, cwoa(nrec)
            1078                     
            1079                               REAL, ALLOCATABLE, TARGET :: zin(:,:)
            1080                               REAL, ALLOCATABLE, TARGET :: zintemp(:,:)
            1081                     !          REAL, POINTER :: gl_woa(:,:,:,:)
            1082                               REAL      :: missing_value
            1083                     
            1084                               INTEGER               :: io_nlon  ! number of longitudes in NetCDF file
            1085                               INTEGER               :: io_ngl   ! number of latitudes in NetCDF file
            1086                               INTEGER               :: io_ndepth  ! number of odepths in NetCDF file
            1087                               INTEGER               :: io_ntime  ! number of timesteps in NetCDF file
            1088                               INTEGER, DIMENSION(4) :: io_start ! start index for NetCDF-read
            1089                               INTEGER, DIMENSION(4) :: io_count ! number of iterations for NetCDF-read
            1090                     
            1091                               INTEGER               :: jk ,i     ! loop index
            1092                               INTEGER               :: irec      ! variable index
            1093                               ! Read GODAS data file
            1094                               ! ===============
            1095                               INTEGER :: IO_file_id0, IO_file_id1, IO_file_id2
            1096                     !ps          CHARACTER (12) :: fn0, fn1, fn2
            1097                               CHARACTER (80) :: fn0, fn1, fn2
            1098                               INTEGER*4       :: ihy0, ihy1, ihy2
            1099                               LOGICAL       :: lex0, lex1, lex2
            1100                               INTEGER       :: status
            1101                     !ps
            1102                               INTEGER*8:: idtg1
            1103                               INTEGER, PARAMETER :: nerr = 6     ! error output stream
            1104                               TYPE (FILE_INFO), save :: woanc0, woanc1, woanc2
            1105                               INTEGER, PARAMETER:: IO_READ=1
            1106                               LOGICAL :: lmlo=.FALSE.
            1107                               INTEGER ::  io_var_id     ! IO_file_id, IO_dim_id
            1108                               LOGICAL flag
            1109                               INTEGER :: j,jj,nxj,im,ii
            1110                               INTEGER :: lnc,zindepth
            1111                     !ps
            1112                               ! Read world ocean atlas data file
            1113                               ! ===============
            1114                     
            1115                               flag=.false.
            1116     1                         IF (myrank .eq. 0) THEN
            1117     1                           WRITE(nerr,'(/,A,I2)') 'Read GODAS 1.0 '
            1118     2                           IF(lamip .AND. .NOT. lmlo) THEN
            1119     2                             WRITE(nerr,*) 'This is an AMIP run with lgodas enable (lamip = .true. & lgodas = .true. ).'
            1120     2                             WRITE(nerr,*) 'Read data from NCEP Global Ocean Data Assimilation System (GODAS)'
            1121     2                             WRITE(nerr,*) '(http://www.cpc.ncep.noaa.gov/products/GODAS/)'
            1122     2                             WRITE(nerr,*) 'or from Ishii dataset'
            1123     2                             WRITE(nerr,*) '(http://dss.ucar.edu/datasets/ds285.3/docs/) '
            1124     2               
            1125     2               !ps              CALL set_years(ihy0, ihy1, ihy2)
            1126     2                             ihy1=idtg1/100000000
            1127     2                             ihy0=ihy1-1
            1128     2                             ihy2=ihy1+1
            1129     2                             call chlen (ifilin_nc,80,lnc)
            1130     2                             WRITE (fn0, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy0
            1131     2                             WRITE (fn1, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy1
            1132     2                             WRITE (fn2, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy2
            1133     2               !ps              WRITE (fn0, '("godas",i4)') ihy0
            1134     2               !ps              WRITE (fn1, '("godas",i4)') ihy1
            1135     2               !ps              WRITE (fn2, '("godas",i4)') ihy2
            1136     2               
            1137     2                             WRITE (nerr, '(/)')
            1138     2               
            1139     2                             WRITE(message_text,*) 'fn0: ', TRIM(fn0),' fn1: ',TRIM(fn1), ' fn2: ',TRIM(fn2)
            1140     2                             WRITE(nerr,*) 'read_godas',message_text
            1141     2               
            1142     2                             INQUIRE (file=trim(fn0), exist=lex0)
            1143     2                             INQUIRE (file=trim(fn1), exist=lex1)
            1144     2                             INQUIRE (file=trim(fn2), exist=lex2)
            1145     2               

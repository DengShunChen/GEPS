             876                             SUBROUTINE read_ocaf(nx,my,lkvl,ggdef)
             877                     
             878                               use index
             879                               use rank
             880                     
             881                     
             882                               integer nx,my,lkvl
             883                               character*4 ggdef
             884                     !          integer*8 idtg1
             885                     !          character*12 cdtg
             886                     !          integer   iyyyy,mmddhhmn,iyy,imm,istat
             887                               integer istat,k,mm,lncrec
             888                               integer j,jj,nxj,i,ii
             889                               character lrec*26
             890                               REAL, ALLOCATABLE, TARGET :: temp1(:,:),temp2(:,:)
             891                               logical flag
             892                     !
             893                               if(.not. ALLOCATED(temp1)) allocate (temp1(nx,my))
             894                               if(.not. ALLOCATED(temp2)) allocate (temp2(nx,my))
             895                     
             896                               if(.not. ALLOCATED(wdepths)) ALLOCATE(wdepths(1:lkvl+2))
             897                               if(.not. ALLOCATED(wtfn12)) ALLOCATE(wtfn12(nxp,1:lkvl+2,my_max,0:13))
             898                               if(.not. ALLOCATED(wsfn12)) ALLOCATE(wsfn12(nxp,1:lkvl+2,my_max,0:13))
             899                     
             900                               nwdepth=lkvl+2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wdepths
                                   <<< Loop-information  End >>>
             901        pp   4v                wdepths(1:lkvl+2)=sit_zdepth(0:lkvl+1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtfn12
                                   <<< Loop-information  End >>>
             902        pp   4v                wtfn12=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wsfn12
                                   <<< Loop-information  End >>>
             903        pp   4v                wsfn12=0.
             904                     
             905                     
             906                       11     format(i3.3,'TFM','gbck',a4,4x,i2.2,6x)  ! ???TFM
             907                       12     format(i3.3,'SFM','gbck',a4,4x,i2.2,6x)  ! ???SFM
             908                     
             909                               flag=.false.
             910     1                         if(myrank.eq.0) then
             911     1                           call dmsmsg("ALL",istat)
             912     1                           print *,'ready to open ifilin_ocaf'
             913     1                           call dmsopn(ifilin_ocaf,"r",istat)
             914     1                           flag=.true.
             915     1                         endif
             916                     !          call mpe_broadcast(istat,1,flag,mpe_integer)
             917                               call mpe_bcast(istat,1,0,mpe_integer)
             918     1                         if(istat.ne.0)then
             919     1                           if(myrank.eq.0) print *,'dmsopn ocaf error'
             920     1                           stop
             921     1                           call mpe_finalize
             922     1                           call dmsexit(-1)
             923     1                         endif
             924                     
             925                     
             926                               lncrec=nx*my
             927     1                         do k=1,lkvl+2
             928     2                           do mm=1,12
             929     2                             write(lrec,11) k-1,ggdef,mm
             930     2                             if(myrank .eq. 0) print *, 'lrec11=',lrec
             931     2                             call dmsread(nx,my,lrec,lncrec,'H',ifilin_ocaf,temp1(:,:),istat)
             932     2                             write(lrec,12) k-1,ggdef,mm
             933     2                             if(myrank .eq. 0) print *, 'lrec12=',lrec
             934     2                             call dmsread(nx,my,lrec,lncrec,'H',ifilin_ocaf,temp2(:,:),istat)
             935     3                             if( myrank .eq. 72) then
             936     3                               print *,"ocaf: mm=",mm,",wtfn(914,265)=",temp1(914,265)
             937     3                               print *,"ocaf: mm=",mm,",wsfn(914,265)=",temp2(914,265)
             938     3                             endif
             939     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, temp1, wsfn12, wtfn12
                                   <<< Loop-information  End >>>
             940     3                             do jj=1,jlistnum
             941     3                               j=jlist1(jj)
             942     3                               nxj=nxdef_2d(j)
             943     4                               if( lreduce.eq.1 )then
             944     4                                 call reducepickr (temp1(1,j),nxdef(j),nx,1)
             945     4                                 call reducepickr (temp2(1,j),nxdef(j),nx,1)
             946     4                               endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, wsfn12, temp1, wtfn12
                                   <<< Loop-information  End >>>
             947     4  pp   2v                      do ii = 1, nxj
             948     4   p   2v                        i=nxjstart(j)+ii-1
             949     4   p   2v                        wtfn12(ii,k,jj,mm)=temp1(i,j)
             950     4   p   2v                        wsfn12(ii,k,jj,mm)=temp2(i,j)
             951     4               
             952     5   p   2v                        if(mm .eq. 1) then
             953     5   p   2v                          wtfn12(ii,k,jj,13)=temp1(i,j)
             954     5   p   2v                          wsfn12(ii,k,jj,13)=temp2(i,j)
             955     5   p   2v                        endif
             956     5   p   2v                        if(mm .eq. 12) then
             957     5       2v                          wtfn12(ii,k,jj,0)=temp1(i,j)
             958     5   p   2v                          wsfn12(ii,k,jj,0)=temp2(i,j)
             959     5   p   2v                        endif
             960     4   p   2v                      enddo  !end do ii
             961     3                             enddo    !end do jj
             962     2                           enddo    !end do mm
             963     1                         enddo !end of k
             964                     
             965                              deallocate(temp1,temp2)
             966                              call dmscls(ifilin_ocaf,istat)
             967                     
             968                             END SUBROUTINE read_ocaf
             969                     
             970                     !------------------------------------------------------------------------------
             971                             SUBROUTINE read_ocaf0(nx,my,lkvl,ggdef,idtg1)
             972                     
             973                               use index
             974                               use rank
             975                     
             976                     
             977                               integer nx,my,lkvl
             978                               character*4 ggdef
             979                               integer*8 idtg1
             980                               character*12 cdtg
             981                     !          integer   iyyyy,mm,ddhhmn,iyy,imm,istat
             982                               integer istat,k,lncrec
             983                               integer j,jj,nxj,i,ii
             984                               character lrec*26
             985                               REAL, ALLOCATABLE, TARGET :: temp1(:,:),temp2(:,:)
             986                               logical flag
             987                     !
             988                               if(.not. ALLOCATED(temp1)) allocate (temp1(nx,my))
             989                               if(.not. ALLOCATED(temp2)) allocate (temp2(nx,my))
             990                     
             991                               if(.not. ALLOCATED(wdepths)) ALLOCATE(wdepths(1:lkvl+2))
             992                               if(.not. ALLOCATED(wtfn1st)) ALLOCATE(wtfn1st(nxp,1:lkvl+2,my_max))
             993                               if(.not. ALLOCATED(mask1st)) ALLOCATE(mask1st(nxp,my_max))
             994                     
             995                               nwdepth=lkvl+2
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1334
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.37, ITR: 256, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wdepths
                                   <<< Loop-information  End >>>
             996        pp   4v                wdepths(1:lkvl+2)=sit_zdepth(0:lkvl+1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      wtfn1st
                                   <<< Loop-information  End >>>
             997        pp   4v                wtfn1st=0.
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mask1st
                                   <<< Loop-information  End >>>
             998        pp   4v                mask1st=0.
             999                     
            1000                               write(cdtg,'(i12)') idtg1
            1001                     !          read(cdtg,'(i4,i2,i8)')iyyyy,mm,ddhhmn
            1002                     
            1003                     
            1004                       11     format(i3.3,'TFN','0000',a4,a12)  ! ???TFM
            1005                       12     format(i3.3,'MSK','0000',a4,a12)  ! ???SFM
            1006                     
            1007                     !          do k=1,lkvl+2
            1008     1                         do k=1,1
            1009     1               
            1010     1                          lncrec=nx*my
            1011     1                          write(lrec,11) k-1,ggdef,cdtg
            1012     1                          if(myrank .eq. 0) print *, 'lrec11=',lrec
            1013     1                          call dmsread(nx,my,lrec,lncrec,'H',ifilin,temp1(:,:),istat)
            1014     1                          write(lrec,12) k-1,ggdef,cdtg
            1015     1                          if(myrank .eq. 0) print *, 'lrec12=',lrec
            1016     1                          call dmsread(nx,my,lrec,lncrec,'H',ifilin,temp2(:,:),istat)
            1017     1               
            1018     1               !           if( lreduce.eq.1 ) call reducepickr(temp1(1,1),nxdef,nx,my)
            1019     1               !           if( lreduce.eq.1 ) call reducepickr(temp2(1,1),nxdef,nx,my)
            1020     1               
            1021     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, temp1, mask1st, wtfn1st
                                   <<< Loop-information  End >>>
            1022     2                          do jj=1,jlistnum
            1023     2                             j=jlist1(jj)
            1024     2                             nxj=nxdef_2d(j)
            1025     3                             if( lreduce.eq.1 )then
            1026     3                               call reducepickr (temp1(1,j),nxdef(j),nx,1)
            1027     3                               call reducepickr (temp2(1,j),nxdef(j),nx,1)
            1028     3                             endif
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 517
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 80, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp2, temp1, mask1st, wtfn1st
                                   <<< Loop-information  End >>>
            1029     3  pp   2v                    do ii = 1, nxj
            1030     3   p   2v                       i=nxjstart(j)+ii-1
            1031     3   p   2v                       wtfn1st(ii,k,jj)=temp1(i,j)
            1032     3   p   2v                       mask1st(ii,jj)=temp2(i,j)
            1033     3   p   2v                    enddo   !end of ii
            1034     2                           enddo    !end of jj
            1035     1               
            1036     1                         enddo !end of k
            1037                     
            1038                               deallocate(temp1,temp2)
            1039                     
            1040                     !         call dmscls(ifilin_ocaf,istat)
            1041                     
            1042                             END SUBROUTINE read_ocaf0
            1043                     

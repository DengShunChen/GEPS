            2461     1                         ydate=real(yr*10000.+mo*100.+dy)+real(hr/24.)+tauleft/3600./24.
            2462     1                         ydate1=timevals_dailyFCT(1)
            2463     1                         ydate2=timevals_dailyFCT(2)
            2464     1    i                    call date2JulianDay(ydate,ydate_jd)
            2465     1    i                    call date2JulianDay(ydate1,ydate1_jd)
            2466     1    i                    call date2JulianDay(ydate2,ydate2_jd)
            2467     1               
            2468     1                         obswtbwgt1 = (ydate2_jd-ydate_jd)/(ydate2_jd-ydate1_jd)
            2469     1                         obswtbwgt2 = 1.-obswtbwgt1
            2470     1                         obswtbnmw1 = 1

            2494                               SUBROUTINE date2JulianDay(zdate,jd)
            2495                                 real, INTENT(IN):: zdate
            2496                                 real, INTENT(OUT):: jd
            2497                                 integer:: yr,mo,dy
            2498                                 real:: zsec
            2499                     
            2500          i                      call get_date_component(zdate, yr, mo, dy, zsec)
            2501                                 jd=Set_JulianDay(yr, mo, dy, zsec)
            2502                     
            2503                               END SUBROUTINE date2JulianDay
            2504                     
            2505                               SUBROUTINE get_date_component(zdate, kyr, kmo, kdy, zsec)
            2506                     
            2507                               real, INTENT(IN):: zdate
            2508                               integer:: kyr,kmo,kdy
            2509                               integer:: tmp,yyyy,mm,dd
            2510                               character*8 :: cdtg
            2511                               real:: zsec        !second [real] input (seconds of the day)
            2512                     
            2513                     
            2514                               tmp=int(zdate)
            2515                               write(cdtg,'(i8)')tmp
            2516                               read(cdtg,'(i4,i2,i2)')yyyy,mm,dd
            2517                               kyr=int(yyyy)
            2518                               kmo=int(mm)
            2519                               kdy=int(dd)
            2520                               zsec=zdate-real(tmp)
            2521                     
            2522                               END SUBROUTINE get_date_component

            1131     2                             WRITE (fn1, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy1
            1132     2                             WRITE (fn2, '(A,A6,i4)') ifilin_nc(1:lnc),'/godas',ihy2

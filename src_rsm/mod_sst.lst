            2522                               FUNCTION Get_JulianMonLen(ky, km) RESULT(idmax)
            2523                             !+
            2524                             !
            2525                             ! Get_JulianMonLen [function, integer]
            2526                             !    get the length of a months in a Julian year
            2527                             !    (
            2528                             !    year  [integer] input (Calendar year)
            2529                             !    month [integer] input (month of the year)
            2530                             !    )
            2531                             !
            2532                             !-
            2533                                INTEGER, INTENT(in) :: km, ky
            2534                                INTEGER :: idmax
            2535                     
            2536     1                          SELECT CASE(km)
            2537     1                          CASE(1,3,5,7,8,10,12);  idmax = 31
            2538     1                          CASE(4,6,9,11);         idmax = 30
            2539     1                          CASE(2)
            2540     2                            IF ( (MOD(ky,4)==0 .AND. MOD(ky,100)/=0) .OR. MOD(ky,400)==0 ) THEN
            2541     2                              ! leap year found
            2542     2                              idmax = 29
            2543     2                            ELSE
            2544     2                              idmax = 28
            2545     2                            END IF
            2546     1               
            2547     1                          CASE default
            2548     1                            print*,'mo_time_weight:Get_JulianMonLen, month invalid'
            2549     1               
            2550     1                          END SELECT
            2551                     !           Get_JulianMonLen = idmax
            2552                     
            2553                               END FUNCTION Get_JulianMonLen
            2554                     
            2555                     
            2556                               FUNCTION Set_JulianDay(ky, km, kd, zsec) RESULT(zd)
            2557                          !+
            2558                          !
            2559                          ! Set_JulianDay  [subroutine]
            2560                          !    convert year, month, day, seconds into Julian calendar day
            2561                          !    (
            2562                          !    year   [integer] input (calendar year)
            2563                          !    month  [integer] input (month of the year)
            2564                          !    day    [integer] input (day of the month)
            2565                          !    second [integer] input (seconds of the day)
            2566                          !    date   [julian_date] output (Julian day)
            2567                          !    )
            2568                          !
            2569                          !-
            2570                          !
            2571                               INTEGER, INTENT(IN) :: ky
            2572                               INTEGER, INTENT(IN) :: km
            2573                               INTEGER, INTENT(IN) :: kd
            2574                               REAL,    INTENT(IN) :: zsec
            2575                          !
            2576                          ! for reference: 1. January 1998 00 UTC === Julian Day 2450814.5
            2577                          !
            2578                               INTEGER :: ib, iy, im, idmax
            2579                               REAL :: zd
            2580                     
            2581     1                         IF ( zsec > 1. ) THEN
            2582     1                           print*,'Set_JulianDay: invalid number of seconds'
            2583     1                         ENDIF
            2584                     
            2585                     
            2586     1                         IF (km <= 2) THEN
            2587     1                           iy = ky-1
            2588     1                           im = km+12
            2589     1                         ELSE
            2590     1                           iy = ky
            2591     1                           im = km
            2592     1                         ENDIF
            2593                     
            2594                              ib = INT(iy/400)-INT(iy/100)
            2595                             ! check the length of the month
            2596                              idmax = Get_JulianMonLen (ky, km)
            2597                     
            2598                              IF (kd < 1 .OR. idmax < kd) &
            2599                                print *,'Set_JulianDay: day in months invalid'
            2600                     
            2601                              zd = real(365.25*iy)+INT(30.6001*(im+1)) &
            2602                                  +REAL(ib)+1720996.5+REAL(kd)+zsec
            2603                     
            2604                              END FUNCTION Set_JulianDay

     1      1189                     !
     1      1190                     ! netcdf data types:
     1      1191                     !
     1      1192                           integer ncbyte
     1      1193                           integer ncchar
     1      1194                           integer ncshort
     1      1195                           integer nclong
     1      1196                           integer ncfloat

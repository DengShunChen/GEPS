            2490                               SUBROUTINE date2JulianDay(zdate,jd)
            2491                                 real, INTENT(IN):: zdate
            2492                                 real, INTENT(OUT):: jd
            2493                                 integer:: yr,mo,dy
            2494                                 real:: zsec
            2495                     
            2496          i                      call get_date_component(zdate, yr, mo, dy, zsec)
            2497                                 jd=Set_JulianDay(yr, mo, dy, zsec)
            2498                     
            2499                               END SUBROUTINE date2JulianDay

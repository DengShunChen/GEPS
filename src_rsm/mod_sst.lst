            1398     6   p   2v                            ot12(ii,jk,jj,0) = zin(i,j)
            1399     6       2v                          ELSE IF(irec .eq. 2) THEN
            1400     6   p   2v                            os12(ii,jk,jj,0) = zin(i,j)
            1401     6   p   2v                          ELSE IF(irec .eq. 3) THEN
            1402     6   p   2v                            ou12(ii,jk,jj,0) = zin(i,j)
            1403     6   p   2v                          ELSE IF(irec .eq. 4) THEN

            1455     3               
            1456     3                             ENDIF  !end if(lamip .AND. .NOT. lmlo)
            1457     2                             !WRITE(nerr,'(/,A,I2)') ' Read GODAS 8.0 '
            1458     2                           END DO !end do jk=1,zindepth
            1459     1                         END DO  !end do irec=1, nrec
            1460                     
            1461     1                         IF (lwarning_msg.GE.3) THEN
            1462     1                           WRITE(nerr,*) 'pe=',p_pe,   &
            1463     1                            ', read GODAS 9.1, os12(212,0,3,0:13)= ',os12(212,0,3,0:13)
            1464     1                         END IF
            1465                     
            1466     1                         IF (myrank .eq. 0) THEN
            1467     1                           IF (lex1) CALL io_close (woanc1)
            1468     2                           IF(lamip .AND. .NOT. lmlo) THEN
            1469     2                             IF (lex0) CALL io_close (woanc0)
            1470     2                             IF (lex2) CALL io_close (woanc2)
            1471     2                           END IF

            1443     6   p   2v                            ot12(ii,jk,jj,13) = zin(i,j)
            1444     6       2v                          ELSE IF(irec .eq. 2) THEN
            1445     6   p   2v                            os12(ii,jk,jj,13) = zin(i,j)
            1446     6   p   2v                          ELSE IF(irec .eq. 3) THEN
            1447     6   p   2v                            ou12(ii,jk,jj,13) = zin(i,j)
            1448     6   p   2v                          ELSE IF(irec .eq. 4) THEN

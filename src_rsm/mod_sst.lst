            1405     6   p   2v                          ELSE IF(irec .eq. 5) THEN
            1406     6   p   2v                            mixedlayer12(ii,jj,0) = zin(i,j)
            1407     6   p   2v                          ENDIF
            1408     5   p   2v                        ENDDO
            1409     4                               ENDDO
            1410     3               
            1411     3               
            1412     3                               flag=.false.
            1413     4                               IF (myrank .eq.0 ) THEN
            1414     5                                 IF (lex2) THEN
            1415     5                                   status = NF_INQ_VARID (woanc2%file_id, cname, io_var_id)
            1416     6                                   IF (status /= NF_NOERR) THEN
            1417     6                                     WRITE(nerr,*) 'IO_INQ_VARID :', woanc2%file_id, cname
            1418     6                                     WRITE(nerr,*) 'IO_INQ_VARID', NF_STRERROR(status)
            1419     6                                   ELSE
            1420     6                                     ! read world ocean atlas data january of next year
            1421     6                                     CALL io_inq_varid (woanc2%file_id, cname, io_var_id)
            1422     6                                     io_start(:) = (/       1,   1, jk,  1 /)
            1423     6                                     io_count(:) = (/ io_nlon, ngl,  1,  1 /)
            1424     6                                     ! for depth jk: read io_nlon longitudes, ngl latitudes and 1 months
            1425     6                                     CALL io_get_vara_double(woanc2%file_id,io_var_id,io_start,io_count, &
            1426     6                                                          zintemp(1:io_nlon,1:io_ngl))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]

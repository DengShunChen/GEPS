            1478                     
            1479                     
            1480                     !------------------------------------------------------------------------------
            1481                     !  woa0
            1482                     ! ----------------------------------------------------------------------
            1483                     !
            1484                     ! Ben-Jei Tsuang, NCHU, AUG 2008, Read WORLD OCEAN ATLAS 2005 data
            1485                     ! (woa05)
            1486                     ! (http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)
            1487                     ! Change woa ocean temperature variable from "t0112an1" to "ot".
            1488                     ! Change woa ocean salinity variable from "s0112an1" to "os"
            1489                     ! Change the unit of ocean temperature of woa05 from degree C to
            1490                     ! Kelvin
            1491                     ! ######### script >>
            1492                     ! cdo -f nc chname,t0112an1,ot t0112an1.nc xx
            1493                     ! cdo -f nc addc,273.15 xx ot.nc
            1494                     ! cdo -f nc chname,s0112an1,os s0112an1.nc os.nc
            1495                     ! cdo -f nc merge ot.nc os.nc woa05_clim.nc
            1496                     ! cdo -f nc interpolate,t21grid woa05_clim.nc T21_woa05_clim.nc
            1497                     ! cdo -f nc interpolate,t31grid woa05_clim.nc T31_woa05_clim.nc
            1498                     ! cdo -f nc interpolate,t42grid woa05_clim.nc T42_woa05_clim.nc
            1499                     ! cdo -f nc interpolate,t63grid woa05_clim.nc T63_woa05_clim.nc
            1500                     ! cdo -f nc interpolate,t85grid woa05_clim.nc T85_woa05_clim.nc
            1501                     ! cdo -f nc interpolate,t106grid woa05_clim.nc T106_woa05_clim.nc
            1502                     !
            1503                     ! cp -pr T21_woa05_clim.nc /u1/u40bjt00/MPI/T21/amip2/
            1504                     ! cp -pr T31_woa05_clim.nc /u1/u40bjt00/MPI/T31/amip2/
            1505                     ! cp -pr T42_woa05_clim.nc /u1/u40bjt00/MPI/T42/amip2/
            1506                     ! cp -pr T63_woa05_clim.nc /u1/u40bjt00/MPI/T63/amip2/
            1507                     ! cp -pr T85_woa05_clim.nc /u1/u40bjt00/MPI/T85/amip2/
            1508                     ! cp -pr T106_woa05_clim.nc /u1/u40bjt00/MPI/T106/amip2/
            1509                     ! ######### << script
            1510                     !
            1511                           SUBROUTINE read_woa0
            1512                     ! ----------------------------------------------------------------------
            1513                     ! Ben-Jei Tsuang, NCHU, June 2009, Read background initial WORLD OCEAN
            1514                     ! ATLAS 2005 data (woa05)
            1515                     ! (http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)
            1516                     ! An initial ocean dataset is generated by combining
            1517                     !   ishii (from surface to 700 m depth), woa monthy data (form > 700
            1518                     !   to
            1519                     !   1500 m depth), and woa annual data (form > 1500 to 5500 m depth).
            1520                     ! Ishii data: http://dss.ucar.edu/datasets/ds285.3/docs/
            1521                     ! script:  irish3::/tcrg/u40bjt00/data/woa05/interp_echam.sh
            1522                     !
            1523                     ! history:
            1524                     !   2009/6/10: modified the code from read_woa0
            1525                     !
            1526                     ! ----------------------------------------------------------------------
            1527                     !    USE mo_control,       ONLY: ngl, nlon, nwoa0, lamip, lmlo
            1528                     !    USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe,p_parallel,p_all_comm,p_barrier
            1529                     !    USE mo_exception,     ONLY: finish, message, message_text
            1530                     
            1531                     !    USE mo_io,            ONLY: io_open_unit, io_close, io_read, &
            1532                     !                                io_var_id, io_file_id, io_open, &
            1533                     !                                woa0nc1
            1534                          USE mo_netCDF,        ONLY: io_inq_dimid, io_inq_dimlen,     &
            1535                                                     io_inq_varid, io_get_var_double, &
            1536                                                     io_get_vara_double, io_get_att_double
            1537                     !    USE mo_decomposition, ONLY: lc => local_decomposition, &
            1538                     !                                gl_dc => global_decomposition
            1539                     !    USE mo_transpose,     ONLY: scatter_gp
            1540                     !    USE mo_filename,      ONLY: NETCDF
            1541                     
            1542                     
            1543                     !  Local scalars:
            1544                     
            1545                     ! number of codes read from WOA file
            1546                           INTEGER, PARAMETER :: nrec = 5
            1547                           CHARACTER (12) :: cname, cwoa0(nrec)
            1548                     
            1549                           REAL, ALLOCATABLE, TARGET :: zin(:,:)
            1550                           REAL, ALLOCATABLE, TARGET :: zintemp(:,:)
            1551                           REAL      :: missing_value
            1552                     
            1553                           INTEGER               :: io_nlon  ! number of longitudes in NetCDF file
            1554                           INTEGER               :: io_ngl   ! number of latitudes in NetCDF file
            1555                           INTEGER               :: io_ndepth  ! number of odepth0 in NetCDF file
            1556                           INTEGER, DIMENSION(4) :: io_start ! start index for NetCDF-read
            1557                           INTEGER, DIMENSION(4) :: io_count ! number of iterations for NetCDF-read
            1558                     
            1559                           INTEGER               :: jk ,i     ! loop index
            1560                           INTEGER               :: irec      ! variable index
            1561                          ! Read world ocean atlas data file
            1562                          ! ===============
            1563                           INTEGER :: IO_file_id0, IO_file_id1, IO_file_id2
            1564                     !      CHARACTER (12) :: fn0, fn1, fn2
            1565                           CHARACTER (80) :: fn0, fn1, fn2
            1566                           LOGICAL       :: lex1
            1567                           INTEGER       :: status, ncid, ndims, nvars, ngatts, unlimdimid
            1568                     
            1569                     !ps
            1570                           INTEGER, PARAMETER :: nerr = 6     ! error output stream
            1571                           TYPE (FILE_INFO), save :: woa0nc1
            1572                           INTEGER, PARAMETER:: IO_READ=1
            1573                           INTEGER :: io_var_id         !,IO_file_id,  IO_dim_id
            1574                           LOGICAL flag
            1575                           INTEGER :: j,jj,nxj,im,ii
            1576                           INTEGER :: lnc,istat
            1577                           INTEGER :: zindepth
            1578                     !ps
            1579                          ! Read world ocean atlas data file
            1580                          ! ===============
            1581                           flag=.false.
            1582     1                     IF (myrank .eq. 0) THEN
            1583     1                       WRITE(nerr,'(/,A,I2)') ' Read WOA0 from unit ', nwoa0
            1584     1                       WRITE(nerr,'(A,I2)') ' Read initial ocean temp. and sal. profiles from'
            1585     1                       WRITE(nerr,'(A,I2)') ' WORLD OCEAN ATLAS 2005 data (http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)'
            1586     1               
            1587     1                       INQUIRE (nwoa0, exist=lex1)
            1588     1                       ! unit nwoa0=97
            1589     2                       IF (lex1) THEN
            1590     2                         woa0nc1%format = NETCDF
            1591     2                         CALL IO_open_unit (nwoa0, woa0nc1, IO_READ)
            1592     2                       ! has to be fixed...
            1593     2                       !          CALL IO_read_header(sstnc1)
            1594     2                       !          CALL IO_info_print(sstnc1)
            1595     2                         WRITE(nerr,'(/,A,I2)') ' Read WOA0 2.0: open successfully!',woa0nc1%file_id
            1596     2                       ELSE
            1597     2                         WRITE (message_text,*) 'Could not open unit<',nwoa0,'>'
            1598     2                         WRITE(nerr,*) '',message_text
            1599     2                         WRITE(nerr,*) 'read_woa0', 'Could not open woa0 file'
            1600     2                         stop
            1601     2                       ENDIF
            1602     1                       WRITE(nerr,'(/,A,I2)') ' Read WOA0 3.0 '
            1603     1               
            1604     1                     ! Check resolution
            1605     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'lat', io_var_id)
            1606     1                       CALL io_inq_dimlen (woa0nc1%file_id, io_var_id, io_ngl)
            1607     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'lon', io_var_id)
            1608     1                       CALL io_inq_dimlen (woa0nc1%file_id, io_var_id, io_nlon)
            1609     1               !        print *,"read W0A0 4.0"
            1610     2                       IF (io_ngl/=ngl) THEN
            1611     2                         WRITE(nerr,*) 'read_WOA0: unexpected resolution',io_nlon,io_ngl
            1612     2                         WRITE(nerr,*) 'expected number of latitudes = ',ngl
            1613     2                        WRITE(nerr,*) 'number of latitudes of world ocean atlas data =',io_ngl
            1614     2                         WRITE(nerr,*) 'read_WOA0','unexpected resolution'
            1615     2                         stop
            1616     2                       END IF
            1617     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'depth', io_var_id)
            1618     1                       CALL io_inq_dimlen (woa0nc1%file_id, io_var_id, nodepth0)
            1619     1               
            1620     1                       print *,"read W0A0 4.0"
            1621     2                       IF ( lwarning_msg.GE.3 ) THEN
            1622     2                         WRITE (nerr,*) 'read_WOA0:: pe=',p_pe,',odepth0=',odepth0(1:nodepth0)
            1623     2                       ENDIF
            1624     1                       flag=.true.
            1625     1                     END IF  !end if(myrank .eq. 0)
            1626                          ! RETURN
            1627                           CALL mpe_bcast(nodepth0,1,0,mpe_integer)
            1628                          ! Allocate memory for ot0, os0, ou0, ov0 per PE
            1629                           IF (.NOT. ALLOCATED(odepth0)) ALLOCATE (odepth0(nodepth0))
            1630                           IF (.NOT. ALLOCATED(ot0)) ALLOCATE (ot0(nxp, nodepth0, my_max))
            1631                           IF (.NOT. ALLOCATED(os0)) ALLOCATE (os0(nxp, nodepth0, my_max))
            1632                           IF (.NOT. ALLOCATED(ou0)) ALLOCATE (ou0(nxp, nodepth0, my_max))
            1633                           IF (.NOT. ALLOCATED(ov0)) ALLOCATE (ov0(nxp, nodepth0, my_max))
            1634                           IF (.NOT. ALLOCATED(mixedlayer0)) ALLOCATE (mixedlayer0(nxp, my_max))
            1635                           if(myrank.eq.0) print *,"W0A0, end allocate"
            1636                     
            1637                           flag=.false.
            1638     1                     IF (myrank .eq. 0) THEN
            1639     1                       CALL io_inq_dimid  (woa0nc1%file_id, 'depth', io_var_id)
            1640     1                       CALL io_get_var_double (woa0nc1%file_id, io_var_id, odepth0)
            1641     1               !!      WRITE(nerr,'(/,A,I2)') ' Read WOA0 6.0 '
            1642     1                       flag=.true.
            1643     1                     ENDIF
            1644                           CALL mpe_bcast(odepth0,nodepth0,0,mpe_double)
            1645                     
            1646                     
            1647                          ! Codes read from WORLD OCEAN ATLAS 2005
            1648                           cwoa0( 1) = 'ot'    ! ocean temperature profile (K)
            1649                           cwoa0( 2) = 'os'    ! ocean salinity profile (0/00)
            1650                           cwoa0( 3) = 'ou'    ! ocean u-component current (m/s)
            1651                           cwoa0( 4) = 'ov'    ! ocean v-component current (m/s)
            1652                           cwoa0( 5) = 'mixedlayer'    ! ocean mixed layer (m)
            1653                           IF (.NOT. ALLOCATED(zin)) ALLOCATE (zin(nlon,ngl))
            1654                     
            1655     1                     DO irec = 1, nrec
            1656     1                       cname = cwoa0(irec)
            1657     1                       zindepth=nodepth0
            1658     1                       if(irec .eq. 5) zindepth=1
            1659     2                       DO jk = 1, zindepth
            1660     2                         flag=.false.
            1661     3                         IF (myrank .eq. 0) THEN
            1662     3                           IF (.NOT. ALLOCATED(zintemp)) ALLOCATE (zintemp(nlon,ngl))
            1663     3                           ! read world ocean atlas data
            1664     3                           status = NF_INQ_VARID (woa0nc1%file_id, cname, io_var_id)
            1665     4                           IF (status /= NF_NOERR) THEN
            1666     4                             WRITE(nerr,*) 'IO_INQ_VARID :', woa0nc1%file_id, cname
            1667     4                             WRITE(nerr,*) 'IO_INQ_VARID', NF_STRERROR(status)
            1668     4                           ELSE
            1669     4                             CALL io_get_att_double (woa0nc1%file_id, io_var_id, &
            1670     4                                                 '_FillValue', missing_value)
            1671     4               
            1672     4                             io_start(:) = (/       1,  1, jk, 1 /)
            1673     4                             io_count(:) = (/ io_nlon, io_ngl ,  1, 1 /)
            1674     4                             ! for depth jk: read io_nlon longitudes, ngl latitudes and
            1675     4                             ! 12 months
            1676     4                             CALL io_get_vara_double(woa0nc1%file_id,io_var_id,io_start,io_count,&
            1677     4                                                     zintemp(1:io_nlon,1:io_ngl))
            1678     4                             print *,"woa0: irec=",irec,",jk=",jk,"zintemp:(768,277)=",zintemp(768,ngl+1-277)
            1679     4                           ENDIF
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp
                                   <<< Loop-information  End >>>
            1680     3  pp   2v                  zintemp(1:io_nlon,:)=MERGE(zintemp(1:io_nlon,:),xmissing,zintemp(1:io_nlon,:).NE.missing_value)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            1681     4  pp                       Do j=1,ngl
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            1682     4   p   2v                    zin(:,j)=zintemp(:,ngl-j+1)
            1683     4   p                       ENDDO
            1684     3                           flag=.true.
            1685     3                         ENDIF
            1686     2               
            1687     2                         call mpe_bcast(zin(:,:),nx*my,0,mpe_double)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, os0
                                   <<< Loop-information  End >>>
            1688     3                         DO jj = 1, jlistnum
            1689     3                           j=jlist1(jj)
            1690     3                           nxj=nxdef_2d(j)
            1691     3                           if( lreduce.eq.1 )call reducepickr (zin(1,j),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, ot0, mixedlayer0, ov0, ou0, os0
                                   <<< Loop-information  End >>>
            1692     4  pp   2v                  DO ii=1,nxj
            1693     4   p   2v                    i=nxjstart(j)+ii-1
            1694     5   p   2v                    IF (irec .eq. 1) THEN
            1695     5   p   2v                      ot0(ii,jk,jj)=zin(i,j)
            1696     5       2v                    ELSE IF(irec .eq. 2) THEN
            1697     5   p   2v                      os0(ii,jk,jj)=zin(i,j)
            1698     5   p   2v                    ELSE IF(irec .eq. 3) THEN
            1699     5   p   2v                      ou0(ii,jk,jj)=zin(i,j)
            1700     5   p   2v                    ELSE IF(irec .eq. 4) THEN
            1701     5   p   2v                      ov0(ii,jk,jj)=zin(i,j)
            1702     5   p   2v                    ELSE IF(irec .eq. 5) THEN
            1703     5   p   2v                      mixedlayer0(ii,jj)=zin(i,j)
            1704     5   p   2v                    ENDIF
            1705     4   p   2v                  ENDDO
            1706     3                         ENDDO
            1707     2               
            1708     2                       ENDDO  !end do jk
            1709     1                     END DO  !end do irec=1, nrec
            1710                     
            1711     1                     IF (myrank .eq. 0) THEN
            1712     1                       CALL io_close (woa0nc1)
            1713     1                       WRITE(nerr,*) 'end read WOA0'
            1714     1                       DEALLOCATE (zintemp)
            1715     1                     END IF
            1716                           DEALLOCATE (zin)
            1717                     
            1718                           END SUBROUTINE read_woa0
            1719                     
            1720                     
            1721                     
            1722                     !----------------------------------------------------------------------
            1723                     ! ----------------------------------------------------------------------
            1724                           SUBROUTINE read_dailygodas(idtg1,tau,dtx)
            1725                     
            1726                         ! U. Schulzweida, MPI, March 2007
            1727                         ! Ben-Jei Tsuang, NCHU, Sep 2015
            1728                     
            1729                     !ps       USE mo_doctor,        ONLY: nout
            1730                     !ps       USE mo_control,       ONLY: nist
            1731                     !ps       USE mo_exception,     ONLY: finish, message, message_text
            1732                     !ps       USE mo_io,           ONLY: io_open_unit, io_close, io_open, &
            1733                     !ps                                io_var_id, io_file_id, io_read, &
            1734                     !ps                                gpnc0, gpnc1, gpnc2
            1735                     !ps       USE mo_mpi,           ONLY: p_parallel_io, p_bcast, p_io, p_pe
            1736                     !ps       USE mo_transpose,     ONLY: scatter_gp
            1737                            USE mo_netcdf,        ONLY: io_open_unit, io_close, io_open, &
            1738                                                     io_inq_dimid, io_inq_dimlen,     &
            1739                                                     io_inq_varid, io_get_var_double, &
            1740                                                     io_get_vara_double, io_get_att_double
            1741                     
            1742                     
            1743                            REAL      :: ydate
            1744                            INTEGER, PARAMETER:: LAST_RECORD=-999
            1745                            INTEGER, PARAMETER:: DAY_MINUS1=1
            1746                            INTEGER, PARAMETER:: THE_DATE=2
            1747                            INTEGER, PARAMETER:: DAY_PLUS1=3
            1748                     
            1749                            CHARACTER (90) :: fn(3)
            1750                            INTEGER       :: ihy0, ihy1, ihy2
            1751                            INTEGER       :: yrori, modyhrmn
            1752                            INTEGER       :: yr, mo, dy, hr, mn
            1753                     !ps
            1754                            INTEGER*8 :: idtg1,idtg_temp
            1755                            REAL      :: tau,dtx,tauleft,hrleft
            1756                            INTEGER   :: icurrenttau
            1757                            INTEGER :: lnc
            1758                            TYPE (FILE_INFO), save :: gpnc0, gpnc1, gpnc2
            1759                            INTEGER :: io_var_id         !,IO_file_id,  IO_dim_id
            1760                            INTEGER, PARAMETER:: IO_READ=1
            1761                            LOGICAL :: flag=.false.
            1762                            character*12 cdtg
            1763                     !ps
            1764                     
            1765                     !ps       CALL get_date_components(next_date, yr, mo, dy, hr, mn, se)
            1766                     !ps       ydate = yr*10000.+mo*100.+dy+(hr+mn/60.+se/3600.)/24.
            1767                            icurrenttau=int(tau)
            1768                            tauleft=float(int((tau-int(tau)+0.001)*3600./dtx))*dtx   !(sec)
            1769     1                      if(tauleft .eq. 3600.) then
            1770     1                       icurrenttau=icurrenttau+1
            1771     1                       tauleft=0.
            1772     1                      endif
            1773                            call dtgfix12(idtg1,idtg_temp,icurrenttau)
            1774                            write(cdtg,'(i12)')idtg1
            1775                            read(cdtg,'(i4,i8)')yrori,modyhrmn
            1776                            write(cdtg,'(i12)')idtg_temp
            1777                            read(cdtg,'(i4,i2,i2,i2,i2)')yr,mo,dy,hr,mn
            1778                            ydate=float(yr*10000+mo*100+dy)+float(hr)/24.+tauleft/3600./24.
            1779                            if(myrank .eq. 0) print *,"read_dailygodas,ydate=",ydate
            1780                     
            1781     1                      IF (myrank .eq. 0) THEN
            1782     1               !ps         CALL set_years(ihy0, ihy1, ihy2)
            1783     1                        ihy1=idtg_temp/100000000
            1784     1                        ihy0=ihy1-1
            1785     1                        ihy2=ihy1+1
            1786     1                        CALL chlen (ifilin_nc,80,lnc)
            1787     1                        WRITE (fn(1), '(A,A11,i4)') ifilin_nc(1:lnc),'/dailygodas',ihy0
            1788     1                        WRITE (fn(2), '(A,A11,i4)') ifilin_nc(1:lnc),'/dailygodas',ihy1
            1789     1                        WRITE (fn(3), '(A,A11,i4)') ifilin_nc(1:lnc),'/dailygodas',ihy2
            1790     1               !ps         WRITE (fn(1), '("dailygodas",i4)') ihy0
            1791     1               !ps         WRITE (fn(2), '("dailygodas",i4)') ihy1
            1792     1               !ps         WRITE (fn(3), '("dailygodas",i4)') ihy2
            1793     1               !ps         WRITE (nerr, '(/)')
            1794     1               !ps         WRITE(nerr,*) 'dailygodas ydate: ', ydate
            1795     1               !ps         WRITE(nerr,*) 'dailygodas ydate: fn(1): ' &
            1796     1               !ps           , TRIM(fn(1)),' fn(2): ', TRIM(fn(2)),' fn(3): ', TRIM(fn(3))
            1797     1                      ENDIF
            1798                     
            1799                     !       IF (lresume .OR. lstart) THEN
            1800     1                      IF ((tau .eq. 0.) .OR. lsitstart) THEN
            1801     1                   !!! warm/cold start
            1802     1                        CALL read_godas_3days
            1803     1                      ELSEIF (ydate.LE.timevals_godas(2)) THEN
            1804     1                   ! data were read. Note that initial value of  timevals_godas=0.
            1805     1                        RETURN
            1806     1                      ELSEIF (ydate.LE.timevals_godas(3)) THEN
            1807     1                   ! note that initial value of  timevals_godas=0.
            1808     1                   ! Shift left
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ot12
                                   <<< Loop-information  End >>>
            1809     1  pp   2v              ot12(:,:,:,1)=ot12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      os12
                                   <<< Loop-information  End >>>
            1810     1  pp   2v              os12(:,:,:,1)=os12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ou12
                                   <<< Loop-information  End >>>
            1811     1  pp   2v              ou12(:,:,:,1)=ou12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ov12
                                   <<< Loop-information  End >>>
            1812     1  pp   2v              ov12(:,:,:,1)=ov12(:,:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mixedlayer12
                                   <<< Loop-information  End >>>
            1813     1  pp   2v              mixedlayer12(:,:,1)=mixedlayer12(:,:,2)
            1814     1                       timevals_godas(1)=timevals_godas(2)
            1815     1                       files_godas(1)=files_godas(2)
            1816     1                       nts_godas(1)=nts_godas(2)
            1817     1                       tsID_godas(1)=tsID_godas(2)
            1818     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ot12
                                   <<< Loop-information  End >>>
            1819     1  pp   2v              ot12(:,:,:,2)=ot12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      os12
                                   <<< Loop-information  End >>>
            1820     1  pp   2v              os12(:,:,:,2)=os12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ou12
                                   <<< Loop-information  End >>>
            1821     1  pp   2v              ou12(:,:,:,2)=ou12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ov12
                                   <<< Loop-information  End >>>
            1822     1  pp   2v              ov12(:,:,:,2)=ov12(:,:,:,3)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      mixedlayer12
                                   <<< Loop-information  End >>>
            1823     1  pp   2v              mixedlayer12(:,:,2)=mixedlayer12(:,:,3)
            1824     1                       timevals_godas(2)=timevals_godas(3)
            1825     1                       files_godas(2)=files_godas(3)
            1826     1                       nts_godas(2)=nts_godas(3)
            1827     1                       tsID_godas(2)=tsID_godas(3)
            1828     2                       if( (files_godas(3).eq.3) .AND. (yrori.lt.yr)) then
            1829     2                          files_godas(2)=2
            1830     2                       endif
            1831     1               
            1832     1               
            1833     1                       CALL read_godas_dayp1(DAY_PLUS1)    ! read day+1 data
            1834     1                     ELSE
            1835     1                       CALL read_godas_3days
            1836     1                     ENDIF
            1837                     
            1838                           CONTAINS
            1839                         !-----------------------------------
            1840                            SUBROUTINE read_godas_3days
            1841                     
            1842                            INTEGER               :: io_nlon  ! number of longitudes in NetCDF file
            1843                            INTEGER               :: io_ngl   ! number of latitudes in NetCDF file
            1844                            INTEGER               :: io_ndepth  ! number of odepths in NetCDF file
            1845                            REAL, ALLOCATABLE :: timevals1(:), timevals2(:)
            1846                     
            1847                            INTEGER       :: i, jk, k, j, m
            1848                            LOGICAL       :: lex1, lex2
            1849                            INTEGER       :: istat
            1850                            INTEGER       :: ndimid, nts1, tsID
            1851                            INTEGER       :: ndimid2, nts2
            1852                     
            1853                            REAL :: timevals_godas(3) = 0.  ! absoulte time (e.g., 19971003.25) GODAS PENTAD Data
            1854                     
            1855                            istat=0
            1856                            flag=.false.
            1857     1                      IF (myrank .eq. 0) THEN
            1858     1                        INQUIRE (file=fn(2), exist=lex1)
            1859     2                        IF ( .NOT. lex1 ) THEN
            1860     2                          WRITE (message_text,*) 'Could not open file <',fn(2),'>'
            1861     2               !ps           CALL message('',message_text)
            1862     2                          WRITE (nerr,*) message_text
            1863     2               !ps           CALL finish ('read_dailygodas', 'run terminated.')
            1864     2                          istat=-1
            1865     2                          nodepth=40               ! number of depths of daily fodas pentad data (=40)
            1866     2                        ELSE
            1867     2                          CALL IO_open (fn(2), gpnc1, IO_READ)
            1868     2                        !! WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 3.0 '
            1869     2                          ! Check resolution
            1870     2                          CALL io_inq_dimid  (gpnc1%file_id, 'lat', io_var_id)
            1871     2                          CALL io_inq_dimlen (gpnc1%file_id, io_var_id, io_ngl)
            1872     2                          CALL io_inq_dimid  (gpnc1%file_id, 'lon', io_var_id)
            1873     2                          CALL io_inq_dimlen (gpnc1%file_id, io_var_id, io_nlon)
            1874     2                          CALL io_inq_dimid  (gpnc1%file_id, 'time', io_var_id)
            1875     2                          !!! CALL io_inq_dimlen (gpnc1%file_id, io_var_id, io_ntime)
            1876     2                          !!      WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 4.0 '
            1877     2                          !!      WRITE(nerr,'(/,A,I2)') 'number of latitudes of world ocean atlas data = ',io_ngl
            1878     2               
            1879     2               !ps           IF ( (io_ngl/=lc%nlat).OR.(io_nlon/=lc%nlon) ) THEN
            1880     3                          IF ( (io_ngl/=nlat).OR.(io_nlon/=nlon) ) THEN
            1881     3                             WRITE(nerr,*) 'read_godas_3days: unexpected resolution ',io_nlon,io_ngl
            1882     3                             WRITE(nerr,*) 'expected number of latitudes = ',nlat
            1883     3                             WRITE(nerr,*) 'number of latitudes of pentad GODAS data data = ',io_ngl
            1884     3                             WRITE(nerr,*) 'expected number of longitude = ',nlon
            1885     3                             WRITE(nerr,*) 'number of latitudes of pentad GODAS data = ',io_nlon
            1886     3               !ps              CALL finish ('read_dailygodas','unexpected resolution')
            1887     3                             WRITE(nerr,*) 'read_godas_3days','unexpected resolution'
            1888     3                             istat=-1
            1889     3                          ELSE
            1890     3                            CALL io_inq_dimid  (gpnc1%file_id, 'depth', io_var_id)
            1891     3                            CALL io_inq_dimlen (gpnc1%file_id, io_var_id, nodepth)
            1892     3                          !!      WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 4.1 '
            1893     3                          !!      WRITE(nerr,'(/,A,I2)') 'number of odepths = ',nodepth
            1894     3                          ENDIF
            1895     2                        ENDIF
            1896     1                        flag=.true.
            1897     1                      ENDIF  !end if (myrank .eq. 0)
            1898                     
            1899                     !       CALL mpe_broadcast (istat, 1, flag, mpe_integer)
            1900                            CALL mpe_bcast (istat, 1, 0, mpe_integer)
            1901                            if (myrank.eq.3) print *,'myrank3 istat=',istat
            1902     1                      if(istat .ne. 0)then
            1903     1                       if(myrank.eq.0) print *,'read_godas_3days fn2',' terminated.'
            1904     1                       stop
            1905     1                       call mpe_finalize
            1906     1                       call dmsexit(-1)
            1907     1                      endif
            1908                     
            1909                     !       CALL p_bcast (nodepth, p_io)
            1910                     !       CALL mpe_broadcast (nodepth, 1, flag, mpe_integer)
            1911                            CALL mpe_bcast (nodepth, 1, 0, mpe_integer)
            1912                            if(myrank .eq. 0) print *,"broadcast nodepth"
            1913                     
            1914                            IF (.NOT. ALLOCATED(odepths)) ALLOCATE (odepths(nodepth))
            1915                            IF (.NOT. ALLOCATED(ot12)) ALLOCATE (ot12(nxp, nodepth, my_max,3))
            1916                            IF (.NOT. ALLOCATED(os12)) ALLOCATE (os12(nxp, nodepth, my_max,3))
            1917                            IF (.NOT. ALLOCATED(ou12)) ALLOCATE (ou12(nxp, nodepth, my_max,3))
            1918                            IF (.NOT. ALLOCATED(ov12)) ALLOCATE (ov12(nxp, nodepth, my_max,3))
            1919                            IF (.NOT. ALLOCATED(mixedlayer12)) ALLOCATE (mixedlayer12(nxp, my_max,3))
            1920                     
            1921                            ! Read odepths
            1922                            flag=.false.
            1923     1                      IF (myrank .eq. 0) THEN
            1924     2                        IF (lex1) THEN
            1925     2                          !!      WRITE(nerr,'(/,A,I2)') ' Read Pentad GODAS 6.0 '
            1926     2                          CALL io_inq_dimid  (gpnc1%file_id, 'depth', io_var_id)
            1927     2                          CALL io_get_var_double (gpnc1%file_id, io_var_id, odepths)
            1928     2                        else
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      odepth0, odepths
                                   <<< Loop-information  End >>>
            1929     2  pp   4v                 odepths=odepth0
            1930     2                        endif
            1931     1                        flag=.true.
            1932     1                      ENDIF
            1933                     !       CALL p_bcast (odepths(1:nodepth), p_io)
            1934                     !       CALL mpe_broadcast (odepths,nodepth, flag, mpe_double)
            1935                            CALL mpe_bcast (odepths,nodepth, 0, mpe_double)
            1936                            if(myrank .eq. 0) print *,"broadcast odepths",odepths(:)
            1937     1                      IF ( lwarning_msg.GE.3 ) THEN
            1938     1                          WRITE (nerr,*) 'read_godas:: pe=',p_pe,',  odepths=',odepths(1:nodepth)
            1939     1               !!       print *,'pe=',p_pe,',  odepths=',odepths(1:nodepth)
            1940     1                      ENDIF
            1941                     
            1942                            !     Read dailygodas-file
            1943                            istat=0
            1944                            flag=.false.
            1945     1                      IF (myrank .eq. 0) THEN
            1946     1                        CALL IO_INQ_DIMID (gpnc1%file_id, 'time', ndimid)
            1947     1                        CALL IO_INQ_DIMLEN (gpnc1%file_id, ndimid, nts1)
            1948     1                        CALL IO_INQ_VARID (gpnc1%file_id, 'time', io_var_id)
            1949     1               
            1950     2                        IF ( nts1 .lt. 1 ) then
            1951     2                          WRITE(nerr,*) 'read_godas_3days', 'To few time steps < 1'
            1952     2                          istat=-1
            1953     2                        ELSE
            1954     2                          ALLOCATE (timevals1(nts1))
            1955     2                          CALL IO_GET_VAR_DOUBLE(gpnc1%file_id, io_var_id, timevals1)
            1956     2                          tsID=1
            1957     3                          DO WHILE ( (ydate.GT.INT(timevals1(tsID))).AND.(tsID.LE.nts1) )
            1958     3                            tsID=tsID+1
            1959     3                          ENDDO
            1960     2                          if(myrank .eq. 0) print*,"tsID=",tsID,",nts1=",nts1
            1961     3                          IF ( tsID .gt. nts1 ) THEN
            1962     3                            INQUIRE (file=fn(3), exist=lex2)
            1963     4                            IF ( .NOT. lex2 ) THEN
            1964     4                              WRITE (message_text,*) 'Could not open file <',fn(3),'>'
            1965     4                              WRITE(nerr,*) message_text
            1966     4                              WRITE(nerr,*) 'read_godas_3days fn3 ', 'run terminated.'
            1967     4                              istat=-1
            1968     4                            ELSE
            1969     4                              CALL IO_open (fn(3), gpnc2, IO_READ)
            1970     4                              CALL IO_INQ_DIMID (gpnc2%file_id, 'time', ndimid2)
            1971     4                              CALL IO_INQ_DIMLEN (gpnc2%file_id, ndimid2, nts2)
            1972     5                              IF ( nts2 .lt. 1 ) THEN
            1973     5                                WRITE (message_text,*) 'File <',fn(3),'>'
            1974     5                                WRITE (nerr,*) message_text
            1975     5                                WRITE (nerr,*) 'read_dailygodas:','To few time steps<1'
            1976     5                                istat=-1
            1977     5                              ELSE
            1978     5                                ALLOCATE (timevals2(nts2))
            1979     5                                CALL IO_INQ_VARID (gpnc2%file_id, 'time', io_var_id)
            1980     5                                CALL IO_GET_VAR_DOUBLE(gpnc2%file_id, io_var_id, timevals2)
            1981     5                                tsID=1
            1982     6                                DO WHILE ( (ydate.GT.INT(timevals2(tsID))).AND.(tsID.LE.nts2) )
            1983     6                                  tsID=tsID+1
            1984     6                                ENDDO
            1985     6                                IF ( tsID .gt. nts2 ) THEN
            1986     6                                  WRITE(nerr,*) 'read_dailygodas', 'Date not found'
            1987     6                                  istat=-1
            1988     6                                ELSE
            1989     7                                  IF ( lwarning_msg.GE.1 ) THEN
            1990     7                                    WRITE (nerr,*) 'read_godas_3days: timevals2_date=',timevals2(tsID)
            1991     7                                  ENDIF
            1992     6                                  tsID_godas(2)=tsID
            1993     6                                  files_godas(2)=3
            1994     6                                  nts_godas(2)=nts2
            1995     6                                ENDIF
            1996     5                              ENDIF
            1997     4                              CALL IO_close(gpnc2)
            1998     4                              IF (ALLOCATED(timevals2)) DEALLOCATE(timevals2)
            1999     4                            ENDIF
            2000     3                          ELSE
            2001     3                            tsID_godas(2)=tsID
            2002     3                            files_godas(2)=2
            2003     3                            nts_godas(2)=nts1
            2004     4                            IF ( lwarning_msg.GE.1 ) THEN
            2005     4                              WRITE (nerr,*) 'read_godas_3days: timevals1_date=',timevals1(tsID)
            2006     4                            ENDIF
            2007     3                          ENDIF
            2008     2                        ENDIF
            2009     1                        CALL IO_close(gpnc1)
            2010     1                        IF (ALLOCATED(timevals1)) DEALLOCATE(timevals1)
            2011     1                        flag=.true.
            2012     1                      ENDIF
            2013                     
            2014                     !       CALL mpe_broadcast (istat, 1, flag, mpe_integer)
            2015                            CALL mpe_bcast (istat, 1, 0, mpe_integer)
            2016     1                      if(istat .ne. 0)then
            2017     1                       if(myrank.eq.0) print *,'read_godas_3days.2', 'run terminated.'
            2018     1                       stop
            2019     1                       call mpe_finalize
            2020     1                       call dmsexit(-1)
            2021     1                      endif
            2022                     
            2023                            if(myrank .eq. 0) print*,'read to read_goads_dayp1'
            2024                            !!! read day-1, day and day+1 data
            2025                            CALL read_godas_dayp1(THE_DATE)     ! day+0
            2026                            CALL read_godas_dayp1(DAY_MINUS1)   ! day-1
            2027                            CALL read_godas_dayp1(DAY_PLUS1)    ! day+1
            2028                            END SUBROUTINE read_godas_3days
            2029                     
            2030                         !-----------------------------------
            2031                     
            2032                            SUBROUTINE read_godas_dayp1(dayID)
            2033                     
            2034                            ! number of codes read from godas file
            2035                            INTEGER, PARAMETER :: nrec = 5
            2036                     
            2037                            INTEGER, INTENT(in):: dayID               ! dayID = DAY_MINUS1, THE_DAY_MINUS1, or DAY_PLUS1
            2038                            REAL, ALLOCATABLE, TARGET :: zin(:,:)
            2039                            REAL, ALLOCATABLE, TARGET :: zintemp(:,:)
            2040                     
            2041                            INTEGER jk,jj,j,nxj,i,ii
            2042                            INTEGER istat
            2043                     
            2044                            LOGICAL lex2
            2045                            INTEGER irec
            2046                            CHARACTER(12) :: cname, cgodas(nrec)
            2047                            INTEGER ndimid2,varid2
            2048                            REAL, ALLOCATABLE:: timevals2(:)
            2049                            REAL:: missing_value
            2050                            INTEGER zindepth
            2051                            INTEGER, DIMENSION(4) :: io_start ! start index for NetCDF-read
            2052                            INTEGER, DIMENSION(4) :: io_count ! number of iterations for NetCDF-read
            2053                     
            2054                     
            2055     1                      IF (dayID .EQ. DAY_PLUS1) THEN
            2056     1                      ! read Day+1 data
            2057     2                        IF (tsID_godas(2).EQ.nts_godas(2)) THEN
            2058     2                          files_godas(3)=files_godas(2)+1
            2059     2                          tsID_godas(3)=1                   !first record of file 3
            2060     2                        ELSE
            2061     2                          files_godas(3)=files_godas(2)
            2062     2                          tsID_godas(3)=tsID_godas(2)+1
            2063     2                        ENDIF
            2064     1                      ELSEIF (dayID .EQ. DAY_MINUS1) THEN
            2065     1                      ! read Day-1 data
            2066     2                        IF (tsID_godas(2).EQ.1) THEN
            2067     2                          files_godas(1)=files_godas(2)-1
            2068     2                          tsID_godas(1)=LAST_RECORD                !last record of file 1 !!!????? NEED to CODE
            2069     2                        ELSE
            2070     2                          files_godas(1)=files_godas(2)
            2071     2                          tsID_godas(1)=tsID_godas(2)-1
            2072     2                        ENDIF
            2073     1                      ENDIF
            2074                     
            2075                            flag=.false.
            2076                            istat=-1
            2077     1                      IF (myrank .eq. 0) THEN
            2078     1                      INQUIRE (file=fn(files_godas(dayID)), exist=lex2)
            2079     2                      IF ( .NOT. lex2 ) THEN
            2080     2                        WRITE (message_text,*) 'Could not open file<',files_godas(dayID),'>'
            2081     2                        WRITE (nerr,*) message_text
            2082     2                        WRITE (nerr,*) 'read_dailygodas', 'run terminated.'
            2083     2                        istat=-1
            2084     2                      ELSE
            2085     2                        CALL IO_open (fn(files_godas(dayID)), gpnc2, IO_READ)
            2086     2                        CALL IO_INQ_DIMID (gpnc2%file_id, 'time', ndimid2)
            2087     2                        CALL IO_INQ_DIMLEN (gpnc2%file_id, ndimid2, nts_godas(dayID))
            2088     3                        IF ( nts_godas(dayID) .lt. 1 ) THEN
            2089     3                          WRITE (message_text,*) 'File <',fn(files_godas(dayID)),'>'
            2090     3                          WRITE(nerr,*) message_text
            2091     3                          WRITE(nerr,*) 'read_godas_dayp1:', 'To few time steps < 1'
            2092     3                          istat=-1
            2093     3                        ELSE
            2094     3                          IF(.NOT. ALLOCATED(timevals2)) ALLOCATE(timevals2(nts_godas(dayID)))
            2095     3                          CALL IO_INQ_VARID (gpnc2%file_id, 'time', io_var_id)
            2096     3                          CALL IO_GET_VAR_DOUBLE(gpnc2%file_id, io_var_id, timevals2)
            2097     3                          !!! modify tsID for LAST_RECORD
            2098     3                          IF (tsID_godas(dayID).EQ.LAST_RECORD) tsID_godas(dayID)=nts_godas(dayID)
            2099     3                          timevals_godas(dayID)=timevals2(tsID_godas(dayID))
            2100     3                          !!! data out range, set to be missing value
            2101     4                          IF (tsID_godas(dayID) .gt. nts_godas(dayID)) THEN
            2102     4                            WRITE (nerr,*) 'read_dailygodas,date=',timevals_godas(dayID) &
            2103     4                                          ,'DATA out of range!!! Set to MISSING DATA!'
            2104     4                            istat=-1
            2105     4                          ELSE
            2106     4                            istat=0
            2107     4                          ENDIF
            2108     3                          DEALLOCATE (timevals2)
            2109     3                        ENDIF
            2110     2                      ENDIF
            2111     1                      flag=.true.
            2112     1                      ENDIF   !!endif (myrank.eq.0)
            2113                     
            2114                     !       CALL mpe_broadcast (istat, 1, flag, mpe_integer)
            2115                            CALL mpe_bcast (istat, 1, 0, mpe_integer)
            2116     1                      if(istat .ne. 0)then
            2117     1                        if(myrank.eq.0) print *,'read_dailygodas', 'run terminated.'
            2118     1                        stop
            2119     1                        call mpe_finalize
            2120     1                        call dmsexit(-1)
            2121     1                      endif
            2122                     
            2123                            CALL mpe_bcast(timevals_godas,3,0,mpe_double)
            2124                            CALL mpe_bcast(tsID_godas,3,0,mpe_integer)
            2125                            CALL mpe_bcast(files_godas,3,0,mpe_integer)
            2126                            CALL mpe_bcast(nts_godas,3,0,mpe_integer)
            2127                     
            2128                            IF(.NOT. ALLOCATED(zin)) ALLOCATE (zin(nx,my))
            2129                            ! Codes read from GODAS
            2130                            cgodas(1) = 'ot'    ! ocean temperature profile (K)
            2131                            cgodas(2) = 'os'    ! ocean salinity profile (0/00)
            2132                            cgodas(3) = 'ou'    ! ocean u-component current (m/s)
            2133                            cgodas(4) = 'ov'    ! ocean v-component current (m/s)
            2134                            cgodas(5) = 'mixedlayer'    ! ocean mixed layer (m)
            2135     1                      DO irec= 1, nrec
            2136     1                        cname=cgodas(irec)
            2137     1                        zindepth=nodepth
            2138     1                        if(irec.eq.5) zindepth=1
            2139     2                        DO jk=1, zindepth
            2140     2                          flag=.false.
            2141     3                          IF(myrank .eq. 0) then
            2142     3                            IF(.NOT. ALLOCATED(zintemp)) ALLOCATE (zintemp(nx,my))
            2143     3                            CALL IO_INQ_VARID (gpnc2%file_id, cname, varid2)
            2144     3                            CALL io_get_att_double (gpnc2%file_id,varid2,'_FillValue', missing_value)
            2145     3                            io_start(:) = (/ 1, 1, jk, tsID_godas(dayID) /)
            2146     3                            io_count(:) = (/ nlon, nlat, 1, 1 /)
            2147     3                            CALL IO_GET_VARA_DOUBLE(gpnc2%file_id,varid2,io_start,io_count,zintemp(1:nlon,1:nlat))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp
                                   <<< Loop-information  End >>>
            2148     3  pp   2v                   zintemp(1:nlon,:)=MERGE(zintemp(1:nlon,:),xmissing,zintemp(1:nlon,:).NE.missing_value)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            2149     4  pp                        Do j=1,nlat
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zintemp, zin
                                   <<< Loop-information  End >>>
            2150     4   p   2v                     zin(:,j)=zintemp(:,nlat-j+1)
            2151     4   p                        ENDDO
            2152     3                            flag=.true.
            2153     3                          ENDIF   !end if (myrank .eq. 0)
            2154     2                          call mpe_bcast(zin(:,:),nx*my,0,mpe_double)
            2155     2               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, os12
                                   <<< Loop-information  End >>>
            2156     3                          DO jj = 1, jlistnum
            2157     3                            j=jlist1(jj)
            2158     3                            nxj=nxdef_2d(j)
            2159     3                            if( lreduce.eq.1 ) call reducepickr(zin(1,j),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 843
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      zin, ot12, mixedlayer12, ov12, ou12
                                   <<<      os12
                                   <<< Loop-information  End >>>
            2160     4  pp   2v                   DO ii=1,nxj
            2161     4   p   2v                     i=nxjstart(j)+ii-1
            2162     5   p   2v                     if(irec .eq. 1) then
            2163     5   p   2v                       ot12(ii,jk,jj,dayID) = zin(i,j)
            2164     5       2v                     else if(irec .eq. 2) then
            2165     5   p   2v                       os12(ii,jk,jj,dayID) = zin(i,j)
            2166     5   p   2v                     else if(irec .eq. 3) then
            2167     5   p   2v                       ou12(ii,jk,jj,dayID) = zin(i,j)
            2168     5   p   2v                     else if(irec .eq. 4) then
            2169     5   p   2v                       ov12(ii,jk,jj,dayID) = zin(i,j)
            2170     5   p   2v                     else if(irec .eq. 5) then
            2171     5   p   2v                       mixedlayer12(ii,jj,dayID) = zin(i,j)
            2172     5   p   2v                     endif
            2173     4   p   2v                   ENDDO
            2174     3                          ENDDO  !!end jj
            2175     2                        ENDDO  !!end jk
            2176     1                      ENDDO   !!end irec
            2177                     
            2178     1                      IF(myrank .eq. 0) THEN
            2179     1                        CALL IO_close(gpnc2)
            2180     1                        DEALLOCATE (zintemp)
            2181     1                      ENDIF
            2182                     
            2183                            DEALLOCATE (zin)
            2184                     
            2185                            END SUBROUTINE read_godas_dayp1
            2186                     
            2187                           END SUBROUTINE read_dailygodas
            2188                     ! ----------------------------------------------------------------------
            2189                     
            2190                     !------------------------------------------------------------------------------
            2191                           SUBROUTINE fill_missing2(finout,io_nlon,io_ngl,ndepth,ldeep)
            2192                     !
            2193                     !   fill missing value using nearest data points
            2194                     !   Method: Inverse Distance Weighting Interpolation
            2195                     !   finout: input/output field
            2196                     !
            2197                           IMPLICIT NONE
            2198                           INTEGER, PARAMETER :: nerr = 6     ! error output stream
            2199                           INTEGER,INTENT(in):: io_nlon  ! number of longitudes in NetCDF file
            2200                           INTEGER,INTENT(in):: io_ngl   ! number of latitudes in NetCDF file
            2201                           INTEGER,INTENT(in):: ndepth   ! number of depths in NetCDF file
            2202                           LOGICAL,INTENT(in):: ldeep    ! fill missig for deeper levels
            2203                           REAL,INTENT(in out)::finout(io_nlon,ndepth,io_ngl)
            2204                           INTEGER::i,j,k,irad(io_nlon,io_ngl),jrad,nmissing,nfilled,nmax_lon_radius,nmax_lat_radius
            2205                           REAL::sumw,aspect,dlon,dlat
            2206                           REAL, DIMENSION(-io_nlon/2:(3*io_nlon)/2+1,-io_ngl/2:(3*io_ngl)/2+1):: finm
            2207                           INTEGER,  DIMENSION(-io_nlon/2:(3*io_nlon)/2+1,-io_ngl/2:(3*io_ngl)/2+1):: inm
            2208                           REAL, PARAMETER:: MAX_LAT_RADIUS=2.   !! maximum radius in lat dir. 2 deg
            2209                           REAL, PARAMETER:: MAX_LON_RADIUS=10.  !! maximum radius in lon dir. 10 deg
            2210                     !
            2211                           !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 0.0'
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finm
                                   <<< Loop-information  End >>>
            2212        pp   4v            finm=xmissing
            2213                           dlon=360./DBLE(io_nlon)
            2214                           dlat=180./DBLE(io_ngl)
            2215                           nmax_lon_radius=MAX_LON_RADIUS/dlon
            2216                           nmax_lat_radius=MAX_LAT_RADIUS/dlat
            2217                           aspect=(MAX_LAT_RADIUS/dlat)/(MAX_LON_RADIUS/dlon)
            2218                          !!! WRITE(nerr,'(/,A,I7,A,I7,A,F9.2)') ' fill_missing 1.0: nmax_lon_radius=',nmax_lon_radius, &
            2219                          !!!  ' nmax_lat_radius=',nmax_lat_radius,' aspect=',aspect
            2220                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    COLLAPSED
                                   <<<    SIMD(VL: 16)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      irad
                                   <<< Loop-information  End >>>
            2221        pp   4v            irad=0
            2222     1                     DO k = 1,ndepth
            2223     1                     nmissing=0
            2224     1                     nfilled=0
            2225     1                     !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 1.1: k=', k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finout, finm
                                   <<< Loop-information  End >>>
            2226     1  pp   2v            finm(1:io_nlon,1:io_ngl)=finout(:,k,:)
            2227     1                     !!! cylinic for longitude (-180 - 0)
            2228     1                     !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 1.2: k=', k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finout, finm
                                   <<< Loop-information  End >>>
            2229     1  pp   2v            finm(-io_nlon/2:0,1:io_ngl)=finout(io_nlon/2:io_nlon,k,:)
            2230     1                     !!! cylinic for longitude (360 - 720)
            2231     1                     !!! WRITE(nerr,'(/,A,I2)') ' fill_missing 1.3: k=', k
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finout, finm
                                   <<< Loop-information  End >>>
            2232     1  pp   2v            finm(io_nlon+1:(3*io_nlon)/2+1,1:io_ngl)=finout(1:io_nlon/2+1,k,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.70, ITR: 80, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finm, inm
                                   <<< Loop-information  End >>>
            2233     1  pp   2v            inm=MERGE(1,0,finm.NE.xmissing) ! unit mask
            2234     2                     DO j = 1,io_ngl
            2235     3                       DO i = 1,io_nlon
            2236     4                         IF (finout(i,k,j).EQ.xmissing) THEN
            2237     4                           nmissing=nmissing+1
            2238     5                           IF (k.EQ.1) THEN
            2239     5                           ! Determine Radius
            2240     5                             sumw=0.
            2241     5               !!!              WRITE(nerr,'(/,A,6I7)') ' fill_missing 5.1:',i,j,k
            2242     5               !!!              DO WHILE ( (sumw.LE.0._dp).AND.(irad(i,j).LT.io_nlon/2-1) )
            2243     6                             DO WHILE ( (sumw.LE.0.).AND.(irad(i,j).LT.nmax_lon_radius) )
            2244     6                               irad(i,j)=irad(i,j)+1
            2245     6                               jrad=irad(i,j)*aspect
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      inm
                                   <<< Loop-information  End >>>
            2246     6  pp   8                       sumw=DBLE(SUM(inm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad)))
            2247     6                             ENDDO
            2248     5                           ELSE
            2249     5                             ! Using the same radius as surface grid, it assumes the depth of the missing value grid is the same as the maximun depth within the radius
            2250     5                             jrad=irad(i,j)*aspect
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      inm
                                   <<< Loop-information  End >>>
            2251     5  pp   8                     sumw=DBLE(SUM(inm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad)))
            2252     6                             IF (ldeep) THEN
            2253     7                               DO WHILE ( (sumw.LE.0.).AND.(irad(i,j).LT.nmax_lon_radius) )
            2254     7                                 irad(i,j)=irad(i,j)+1
            2255     7                                 jrad=irad(i,j)*aspect
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 10
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      inm
                                   <<< Loop-information  End >>>
            2256     7  pp   8                         sumw=DBLE(SUM(inm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad)))
            2257     7                               ENDDO
            2258     6                             ENDIF
            2259     5                           ENDIF
            2260     5                           IF (sumw.GT.0.) THEN
            2261     5                             nfilled=nfilled+1
            2262     5               !!!              WRITE(nerr,'(/,A,6I7)') ' fill_missing 5.2:',i,j,k,irad(i,j),jrad,INT(sumw)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      finm
                                   <<< Loop-information  End >>>
            2263     5  pp   4                     finout(i,k,j)=SUM(finm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad),mask=finm(i-irad(i,j):i+irad(i,j),j-jrad:j+jrad).NE.xmissing)/sumw
            2264     5                           ELSE
            2265     5                             ! value of deeper layers are missing (not fill) as well.
            2266     5                             ! EXIT
            2267     5                           ENDIF
            2268     4               !!!            WRITE(nerr,'(/,A,6I7)') ' fill_missing 5.3:',i,j,k,irad(i,j),jrad,INT(sumw)
            2269     4                         ENDIF
            2270     3                       ENDDO
            2271     2                     ENDDO
            2272     1               !      IF ( lwarning_msg.GE.2 ) then
            2273     1               !        WRITE(nerr,'(/,A,I5,A,I9,A,I9,A)') ' fill_missing: k=',k,&
            2274     1               !             ',   ',nmissing,' missing value grids, where ',nfilled,&
            2275     1               !             ' grids filled.'
            2276     1               !      ENDIF
            2277     1                   ENDDO
            2278                       END SUBROUTINE fill_missing2
            2279                     !
            2280                     !--------------------------------------------------------------
            2281                     
            2282                     !-----
            2283                     !-----------------------------------------------------------------------------
            2284                             SUBROUTINE time_weights(idtg1,tauleft)
            2285                     !*****  *********************************************
            2286                     
            2287                             ! calculates weighting factores for clsst2 and ozone
            2288                             !-
            2289                     
            2290                     !            USE mo_interpo, ONLY : wgt1, wgt2, nmw1, nmw2, nmw1cl,
            2291                     !            nmw2cl, &
            2292                     !                               wgtasd1, wgtd2, ndw1, ndw2
            2293                     !         IMPLICIT NONE
            2294                     
            2295                     !        TYPE (time_native) :: date_monm1, date_mon, date_monp1
            2296                     !          INTEGER*8 :: idtg1
            2297                     !          REAL      :: tauleft
            2298                     !          REAL      :: wgt1,wgt2
            2299                     !          INTEGER   :: nmw1,nmw2
            2300                                use rank
            2301                     
            2302                               integer*8 idtg1
            2303                               real tauleft
            2304                               character*12 cdtg
            2305                               INTEGER   yyyy, mm, dd, hh, mn
            2306                               INTEGER   yr,mo,dy,hr
            2307                               INTEGER   seconds, isec
            2308                               INTEGER   imp1, imm1, imp1cl, imm1cl, imlenm1, imlen, imlenp1
            2309                               REAL      zdayl, zsec
            2310                               REAL      zmohlf, zmohlfp1, zmohlfm1
            2311                     !          REAL     zdh, zdhp1, zdhm1
            2312                               INTEGER, PARAMETER :: NDAYLEN=86400
            2313                               REAL      ydate,ydate1,ydate2,ydate3
            2314                               REAL      ydate_jd,ydate1_jd,ydate2_jd,ydate3_jd
            2315                     
            2316                               ! ***  set calendar related parameters
            2317                               ! -----------------------------------
            2318                     
            2319                               write(cdtg,'(i12)')idtg1
            2320                               read(cdtg,'(i4,i2,i2,i2,i2)')yyyy,mm,dd,hh,mn
            2321                               yr=int(yyyy)
            2322                               mo=int(mm)
            2323                               dy=int(dd)
            2324                               hr=int(hh)
            2325                               seconds=int(tauleft)
            2326                     
            2327                     !        CALL TC_get (date_mon, yr, mo, dy, hr, mn, se)
            2328                     
            2329                               ! month index for AMIP data  (0..13)
            2330                               imp1 = mo+1
            2331                               imm1 = mo-1
            2332                     
            2333                               ! month index for cyclic climatological data (1..12)
            2334                               imp1cl = mo+1
            2335                               imm1cl = mo-1
            2336                               IF (imp1cl > 12) imp1cl= 1
            2337                               IF (imm1cl <  1) imm1cl=12
            2338                     
            2339                               ! *** determine length of months and position within current
            2340                               ! month -------
            2341                     
            2342                     !        CALL TC_set(yr, imm1cl, 1, 0, 0, 0, date_monm1)
            2343                     !        CALL TC_set(yr, imp1cl, 1, 0, 0, 0, date_monp1)
            2344                               imlenm1 = Get_JulianMonLen(yr,imm1cl)
            2345                               imlen   = Get_JulianMonLen(yr,mo)
            2346                               imlenp1 = Get_JulianMonLen(yr,imp1cl)
            2347                     
            2348                               zdayl    = REAL(NDAYLEN)
            2349                               zmohlfm1 = REAL(imlenm1*zdayl*0.5)
            2350                               zmohlf   = REAL(imlen  *zdayl*0.5)
            2351                               zmohlfp1 = REAL(imlenp1*zdayl*0.5)
            2352                     
            2353                     
            2354                               ! *** weighting factors for first/second half of month
            2355                               ! -------------------
            2356                     
            2357                               nmw1   = mo
            2358                     !          nmw1cl = mo
            2359                     
            2360                               ! seconds in the present month
            2361                     !        CALL TC_get (next_date, days, seconds)
            2362                               isec = (dy-1)*NDAYLEN + hr*3600+ seconds
            2363                               zsec = REAL(isec)
            2364                     
            2365     1                         IF(zsec <= zmohlf) THEN                     ! first part of month
            2366     1                           wgt1   = (zmohlfm1+zsec)/(zmohlfm1+zmohlf)
            2367     1                           wgt2   = 1.-wgt1
            2368     1                           nmw2   = imm1
            2369     1               !            nmw2cl = imm1cl
            2370     1                         ELSE                                        ! second part of month
            2371     1                           wgt2   = (zsec-zmohlf)/(zmohlf+zmohlfp1)
            2372     1                           wgt1   = 1.-wgt2
            2373     1                           nmw2   = imp1
            2374     1               !            nmw2cl = imp1cl
            2375     1                         ENDIF
            2376                     
            2377                     !          ! *** weighting factors for first/second half of day
            2378                     !          -------------------
            2379                     !
            2380                     !          ndw1   = 2
            2381                     !
            2382                     !          zsec = REAL(seconds,dp)
            2383                     !          zdh   = 12._dp*3600._dp
            2384                     !          zdhm1 = zdh
            2385                     !          zdhp1 = zdh
            2386                     !          IF( zsec <= zdh ) THEN                     ! first part of day
            2387                     !            wgtd1  = (zdhm1+zsec)/(zdhm1+zdh)
            2388                     !            wgtd2  = 1._dp-wgtd1
            2389                     !            ndw2   = 1
            2390                     !          ELSE                                       ! second part of day
            2391                     !            wgtd2  = (zsec-zdh)/(zdh+zdhp1)
            2392                     !            wgtd1  = 1._dp-wgtd2
            2393                     !            ndw2   = 3
            2394                     !          ENDIF
            2395                     
            2396                     
            2397                           ! *** weighting factors for GODAS PENTAD data -------------------
            2398     1                        IF (lgodas) THEN
            2399     2                          IF (ldailysst) THEN
            2400     2               !ps          CALL get_date_components(next_date, yr, mo, dy, hr, mn, se)
            2401     2               !ps          ydate =yr*10000._dp+mo*100._dp+dy+(hr+mn/60._dp+se/3600._dp)/24._dp
            2402     2                            ydate=real(yr*10000.+mo*100.+dy)+real(hr/24.)+tauleft/3600./24.
            2403     2                            ydate1=timevals_godas(1)
            2404     2                            ydate2=timevals_godas(2)
            2405     2                            ydate3=timevals_godas(3)
            2406     2    i                       call date2JulianDay(ydate,ydate_jd)
            2407     2    i                       call date2JulianDay(ydate1,ydate1_jd)
            2408     2    i                       call date2JulianDay(ydate2,ydate2_jd)
            2409     2    i                       call date2JulianDay(ydate3,ydate3_jd)
            2410     2               
            2411     3                            IF (ydate_jd .LE. ydate2_jd) THEN
            2412     4                              IF (ydate_jd .EQ. ydate2_jd) THEN
            2413     4                                wgto2=1
            2414     4                              else
            2415     4                                wgto2=(ydate_jd-ydate1_jd)/(ydate2_jd-ydate1_jd)
            2416     4                              endif
            2417     3                              wgto1=1.-wgto2
            2418     3                              now1=1
            2419     3                              now2=2
            2420     3                            ELSEIF (ydate_jd .LE. ydate3_jd) THEN
            2421     3                              wgto2=(ydate_jd-ydate2_jd)/(ydate3_jd-ydate2_jd)
            2422     3                              wgto1=1.-wgto2
            2423     3                              now1=2
            2424     3                              now2=3
            2425     3                            ELSE
            2426     3               !ps               CALL finish('time_weights', 'GODAS PENTAD Date not found')
            2427     3                              print *,'ydate=',ydate,'timevals_godas(2)=',timevals_godas(2) &
            2428     3                                     ,'timevals_godas(3)=',timevals_godas(3)
            2429     3                              print *,'time_weights', 'GODAS PENTAD Date not found'
            2430     3                              stop
            2431     3                              CALL mpe_finalize
            2432     3                              CALL dmsexit(-1)
            2433     3                            ENDIF
            2434     2                         !!! IF(wgtd(1).GT.1._dp .OR. wgtd(2).GT.1._dp )THEN
            2435     2                         !!!   WRITE(nerr,*) 'get_5dwgtd yr, mo, dy, hr, mn, se=',yr,
            2436     2                         !mo, dy, hr, mn, se,' ydate=',ydate,' ID=',ID,'
            2437     2                         !timevals_godas=',INT(timevals_godas(0:2)),&
            2438     2                         !!!               ' JD(0:2)=',JD(0:2),' wgtd(1:2)=',wgtd(1:2)
            2439     2                         !!! ENDIF
            2440     2               !             if(myrank .eq. 49) then
            2441     2               !               print *,'time weight dailysst'    &
            2442     2               !                   ,',timevals_godas(1)=',timevals_godas(1)   &
            2443     2               !                   ,',timevals_godas(2)=',timevals_godas(2)   &
            2444     2               !                   ,',timevals_godas(3)=',timevals_godas(3)   &
            2445     2               !                   ,',now1=',now1,',now2=',now2        &
            2446     2               !                   ,',wgto1=',wgto1,',wgto2=',wgto2
            2447     2               !             endif
            2448     2               
            2449     2                          ELSE
            2450     2                         ! monthly godas data
            2451     2                            wgto2=wgt2
            2452     2                            wgto1=wgt1
            2453     2                            now1=nmw1
            2454     2                            now2=nmw2
            2455     2                          ENDIF
            2456     1                        ENDIF
            2457                     
            2458                              obswtbwgt1=wgto1
            2459                              obswtbwgt2=wgto2
            2460                              obswtbnmw1=now1
            2461                              obswtbnmw2=now2
            2462                     
            2463                           ! *** weighting factors for first/second half of day
            2464     1                        IF (ldailyFCTsst .OR. ldailyFCTicesndpt .OR. (dailyClm_option.ge. 1)) THEN
            2465     1                         ydate=real(yr*10000.+mo*100.+dy)+real(hr/24.)+tauleft/3600./24.
            2466     1                         ydate1=timevals_dailyFCT(1)
            2467     1                         ydate2=timevals_dailyFCT(2)
            2468     1    i                    call date2JulianDay(ydate,ydate_jd)
            2469     1    i                    call date2JulianDay(ydate1,ydate1_jd)
            2470     1    i                    call date2JulianDay(ydate2,ydate2_jd)
            2471     1               
            2472     1                         obswtbwgt1 = (ydate2_jd-ydate_jd)/(ydate2_jd-ydate1_jd)
            2473     1                         obswtbwgt2 = 1.-obswtbwgt1
            2474     1                         obswtbnmw1 = 1
            2475     1                         obswtbnmw2 = 2
            2476     1               
            2477     1               !          if(myrank .eq. 49) then
            2478     1               !            print *,'time weight, idtg1=',idtg1,',yr=',yr,',mo=',mo &
            2479     1               !                   ,',dy=',dy,',hr=',hr,',tauleft=',tauleft  &
            2480     1               !                   ,',ydate=',ydate,',ydate1=',ydate1        &
            2481     1               !                   ,',ydate2=',ydate2,',ydatejd=',ydate_jd   &
            2482     1               !                  ,',ydate1jd=',ydate1_jd,',ydate2jd=',ydate2_jd &
            2483     1               !                  ,',obswtbwgt1=',obswtbwgt1   &
            2484     1               !                  ,',obswtbwgt2=',obswtbwgt2
            2485     1               !          endif
            2486     1               
            2487     1                        ENDIF

            1450     6   p   2v                          ELSE IF(irec .eq. 5) THEN
            1451     6   p   2v                            mixedlayer12(ii,jj,13) = zin(i,j)
            1452     6   p   2v                          ENDIF
            1453     5   p   2v                        ENDDO

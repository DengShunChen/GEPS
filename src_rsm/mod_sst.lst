            2501                               SUBROUTINE get_date_component(zdate, kyr, kmo, kdy, zsec)
            2502                     
            2503                               real, INTENT(IN):: zdate
            2504                               integer:: kyr,kmo,kdy
            2505                               integer:: tmp,yyyy,mm,dd
            2506                               character*8 :: cdtg
            2507                               real:: zsec        !second [real] input (seconds of the day)
            2508                     
            2509                     
            2510                               tmp=int(zdate)
            2511                               write(cdtg,'(i8)')tmp
            2512                               read(cdtg,'(i4,i2,i2)')yyyy,mm,dd
            2513                               kyr=int(yyyy)
            2514                               kmo=int(mm)
            2515                               kdy=int(dd)
            2516                               zsec=zdate-real(tmp)
            2517                     
            2518                               END SUBROUTINE get_date_component

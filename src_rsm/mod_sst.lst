            2526                               FUNCTION Get_JulianMonLen(ky, km) RESULT(idmax)
            2527                             !+
            2528                             !
            2529                             ! Get_JulianMonLen [function, integer]
            2530                             !    get the length of a months in a Julian year
            2531                             !    (
            2532                             !    year  [integer] input (Calendar year)
            2533                             !    month [integer] input (month of the year)
            2534                             !    )
            2535                             !
            2536                             !-
            2537                                INTEGER, INTENT(in) :: km, ky
            2538                                INTEGER :: idmax
            2539                     
            2540     1                          SELECT CASE(km)
            2541     1                          CASE(1,3,5,7,8,10,12);  idmax = 31
            2542     1                          CASE(4,6,9,11);         idmax = 30
            2543     1                          CASE(2)
            2544     2                            IF ( (MOD(ky,4)==0 .AND. MOD(ky,100)/=0) .OR. MOD(ky,400)==0 ) THEN
            2545     2                              ! leap year found
            2546     2                              idmax = 29
            2547     2                            ELSE
            2548     2                              idmax = 28
            2549     2                            END IF
            2550     1               
            2551     1                          CASE default
            2552     1                            print*,'mo_time_weight:Get_JulianMonLen, month invalid'
            2553     1               
            2554     1                          END SELECT
            2555                     !           Get_JulianMonLen = idmax
            2556                     
            2557                               END FUNCTION Get_JulianMonLen
            2558                     
            2559                     
            2560                               FUNCTION Set_JulianDay(ky, km, kd, zsec) RESULT(zd)
            2561                          !+
            2562                          !
            2563                          ! Set_JulianDay  [subroutine]
            2564                          !    convert year, month, day, seconds into Julian calendar day
            2565                          !    (
            2566                          !    year   [integer] input (calendar year)
            2567                          !    month  [integer] input (month of the year)
            2568                          !    day    [integer] input (day of the month)
            2569                          !    second [integer] input (seconds of the day)
            2570                          !    date   [julian_date] output (Julian day)
            2571                          !    )
            2572                          !
            2573                          !-
            2574                          !
            2575                               INTEGER, INTENT(IN) :: ky
            2576                               INTEGER, INTENT(IN) :: km
            2577                               INTEGER, INTENT(IN) :: kd
            2578                               REAL,    INTENT(IN) :: zsec
            2579                          !
            2580                          ! for reference: 1. January 1998 00 UTC === Julian Day 2450814.5
            2581                          !
            2582                               INTEGER :: ib, iy, im, idmax
            2583                               REAL :: zd
            2584                     
            2585     1                         IF ( zsec > 1. ) THEN
            2586     1                           print*,'Set_JulianDay: invalid number of seconds'
            2587     1                         ENDIF
            2588                     
            2589                     
            2590     1                         IF (km <= 2) THEN
            2591     1                           iy = ky-1
            2592     1                           im = km+12
            2593     1                         ELSE
            2594     1                           iy = ky
            2595     1                           im = km
            2596     1                         ENDIF
            2597                     
            2598                              ib = INT(iy/400)-INT(iy/100)
            2599                             ! check the length of the month
            2600                              idmax = Get_JulianMonLen (ky, km)
            2601                     
            2602     1                        if(myrank==0)then
            2603     1                        IF (kd < 1 .OR. idmax < kd) &
            2604     1                          print *,'Set_JulianDay: day in months invalid' &
            2605     1                                 ,' kd=', kd,'idmax= ',idmax
            2606     1                        endif
            2607                     
            2608                              zd = real(365.25*iy)+INT(30.6001*(im+1)) &
            2609                                  +REAL(ib)+1720996.5+REAL(kd)+zsec
            2610                     
            2611                              END FUNCTION Set_JulianDay

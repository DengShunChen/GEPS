              61                             !! memory pointer for GODAS+Ishii WORLD OCEAN data (lgodas) (GODAS+Ishii)
              62                             INTEGER               :: nodepth        ! number of depths of the godas data (=24)
              63                             REAL, ALLOCATABLE :: odepths(:)     ! depths of the godas data (m)
              64                     !!!  INTEGER               :: gpdepth        ! number of depths of daily fodas pentad data (=40)
              65                     !!!  REAL(dp), ALLOCATABLE :: odepths(:)    ! depths of the godas pentad data (m)
              66                             REAL, ALLOCATABLE :: ot12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              67                                                                ! observed water tempeature profile (K): "ot"
              68                             REAL, ALLOCATABLE :: os12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              69                                                                ! observed salinity (0/00): "os"
              70                             REAL, ALLOCATABLE :: ou12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              71                                                                ! observed u current (m/s): "ou"
              72                             REAL, ALLOCATABLE :: ov12(:,:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              73                                                                ! observed v current (m/s): "ou"
              74                             REAL, ALLOCATABLE :: mixedlayer12(:,:,:) ! (nlon,nodepth,ngl,0:13) in global coordinates,
              75                                                                ! observed v current (m/s): "ou"
              76                     
              77                             !! memory pointer for Initial WORLD OCEAN ATLAS 2005 data (lwoa0)(http://www.nodc.noaa.gov/OC5/WOA05/pr_woa05.html)
              78                             INTEGER               :: nodepth0         ! number of depths of the woa data (=24)
              79                             REAL, ALLOCATABLE :: odepth0(:)       ! depths of the woa data (m)
              80                             REAL, ALLOCATABLE :: ot0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              81                                                                ! observed water tempeature profile (K): "ot"
              82                             REAL, ALLOCATABLE :: os0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              83                                                                ! observed salinity (0/00): "os"
              84                             REAL, ALLOCATABLE :: ou0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              85                                                                ! observed u-componet current (m/s): "ou"
              86                             REAL, ALLOCATABLE :: ov0(:,:,:)    ! (nlon,nodepth0,ngl,0:13) in global coordinates,
              87                                                                ! observed v-componet current (m/s): "ov"
              88                             REAL, ALLOCATABLE :: mixedlayer0(:,:) ! (nlon,ngl) in global coordinates,
              89                                                                ! observed mixedlayer (m): "ou"
              90                     
              91                             LOGICAL :: lou=.FALSE.                    ! u- current available ?
              92                             LOGICAL :: lov=.FALSE.                    ! v- current available ?
              93                     
              94                       !! memory pointer for sit flux correction term
              95                             INTEGER           :: nwdepth         ! number of depths of the woa data
              96                             REAL, ALLOCATABLE :: wdepths(:)      ! depths of the woa data (m)
              97                             REAL, ALLOCATABLE :: wtfn12(:,:,:,:) ! (nlon,nwdepth,ngl,0:13) in global coordinates,
              98                                                                  ! observed water tempeature profile (K): "ot"
              99                             REAL, ALLOCATABLE :: wsfn12(:,:,:,:) ! (nlon,nwdepth,ngl,0:13) in global coordinates,
             100                             REAL, ALLOCATABLE :: wtfn1st(:,:,:) ! (nlon,nwdepth,ngl) in global coordinates,
             101                                                                  ! observed water tempeature profile (K): "ot"
             102                             REAL, ALLOCATABLE :: mask1st(:,:) ! (nlon,nwdepth,ngl) in global coordinates,
             103                     
             104                       !! memory pointer for pentad GODAS OCEAN data (lgodas & ldailysst)
             105                             REAL      :: timevals_godas(3) = 0.  ! absoulte time (e.g., 19971003.25) GODAS PENTAD Data
             106                             INTEGER   :: files_godas(3)          ! fileid for pentad data at day-1, day+0 and day+1, respectively
             107                             INTEGER   :: tsID_godas(3)           ! record id for pentad data at day-1, day+0 and day+1, in its repective file, respectively
             108                             INTEGER   :: nts_godas(3)            ! # of timestamps for pentad data at day-1, day+0 and day+1, in its repective file, respectively
             109                     
             110                       !! memory pointer for daily FCTsst data (ldailyFCTsst)
             111                             REAL      :: timevals_dailyFCT(2)= 0.       ! absoulte time (e.g.,19971003.25) daily forecast sst Data
             112                             REAL, ALLOCATABLE :: dailyFCTsst(:,:,:)     ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             113                                                                         ! forecast daily water tempeature (K)
             114                             REAL, ALLOCATABLE :: dailyFCTcice(:,:,:)    ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             115                                                                         ! forecast sea ice fration
             116                             REAL, ALLOCATABLE :: dailyFCTsndepth(:,:,:) ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             117                                                                         ! forecast daily snow depth (mm)
             118                             REAL, ALLOCATABLE :: ANAsstT0(:,:)          ! (nlon,ngl), analysis SST at tau=0
             119                             REAL, ALLOCATABLE :: dailyClmANAsst(:,:,:)  ! (nlon,ngl,2) at tau=0, ydate, ydate+1 day in global coordinates,
             120                             REAL, ALLOCATABLE :: dailyClmFCTsst(:,:,:)  ! (nlon,ngl,2) at ydate, ydate+1 day in global coordinates,
             121                                                                         ! forecast climatology daily water tempeature (K)
             122                             REAL, ALLOCATABLE :: dFCTsstdt(:,:)         ! d(dailyFCTsst)/dt (K/s)
             123                             REAL, ALLOCATABLE :: dFCTcicedt(:,:)        ! d(dailyFCTcice)/dt (K/s)
             124                             REAL, ALLOCATABLE :: dFCTsndepthdt(:,:)     ! d(dailyFCTsndepth)/dt (K/s)
             125                             REAL, ALLOCATABLE :: obswtbold(:,:)           ! calculated obs. sst per (n-1) timestep
             126                             REAL, ALLOCATABLE :: obswtbnow(:,:)           ! calculated obs. sst now (n) timestep
             127                             REAL, ALLOCATABLE :: obswtbnew(:,:)           ! calculated obs. sst next (n+1) timestep
             128                             REAL, ALLOCATABLE :: tseadiffFCT(:,:)       ! the change of tg from dta*dFCTsstdt
             129                             REAL, ALLOCATABLE :: tseadiffFCT24(:,:)     ! the average change of tg from dta*dFCTsstdt
             130                             REAL, ALLOCATABLE :: dtseadt(:,:)           ! the change rate of tg from FCTsst and SIT
             131                             REAL, ALLOCATABLE :: tseaold(:,:)             ! sst at pre. timestep (n-1)
             132                             REAL, ALLOCATABLE :: tseanow(:,:)             ! sst at now timestep (n)
             133                             REAL, ALLOCATABLE :: tseanew(:,:)             ! sst at next timestep (n+1)
             134                     
             135                     
             136                     !for opgsst
             137                           REAL, dimension(:,:,:),allocatable,save :: opgsst
             138                     !for time_interpolation
             139                           REAL wgt1,wgt2,obswtbwgt1,obswtbwgt2,wgto1,wgto2
             140                           INTEGER nmw1,nmw2,obswtbnmw1,obswtbnmw2,now1,now2
             141                     
             142                     
             143                       !*    1.0 COEFFICIENTS IN sit_ocean MODEL
             144                     
             145                             REAL :: albice = 0.2,             & ! albedo of glacier ice (0.2 - 0.4) (Pielke, 1984). Lake ice is the smallest.
             146                                     albsn  = 0.7,             & ! albedo of snow decreases with age (0.4 - 0.95) (Pielke, 1984)
             147                                     albw   = 0.06,            & !	  (Brutsaert, 1982; Tsuang, 1990; Gaspar et al., 1990)
             148                                     csn    = 2116.,           &
             149                                     cice   = 2116.,           & ! Cw = 4217.7-2.55*(Tw-tmelt) (4178.4 is used)
             150                                                           ! csn = cice=104.369+7.369*TSN (Marks, 1988)
             151                                                           ! csn = 2116 j kg k-1 at 0 ! is used for simplicity.
             152                                     rhosn  = 300.,            & !	rhosn = dry snow density. Although snow density changes with age,
             153                                                           !	it is not sensitive to snowmelt runoff. A constant value is assumed.
             154                                     rhoice = 917.,            & !	rhoice = density of ice (917 kg/m3)
             155                                     omegas = 2.*API/IDAYLEN,  & ! ANGULAR VELOCITY OF EARTH in respect to sun
             156                                     xkice = 1.2E-6,           & ! Dickinson et al. (1986)
             157                                     xksn = 2.0E-7,            & !	  Effect heat diffusivity of snow
             158                                                           !       (conduction heat diffusivity + vapor transfer)
             159                                                           ! xksn=kcon+De*Lv/cp*dqsat/dT
             160                                                           !	kcon (conduction) = (3.2238E-8)*rhosn/csn (Yeh, 1965)
             161                                                           ! This value increases with age of snow, and is an
             162                                                           ! important tunning parameter for snow melting rate.
             163                                                           !   =(1E-7 ~ 4E-7) (Dickinson et al., 1986)
             164                                     xkw = 1.50E-4,            & !  (Kondo, 1979, Tsuang, 1990)
             165                                     wcri = 0.1                    !     minimum thickness of a water layer. Thickness less than
             166                                                           !     this thickness is treated as thin layer. That is T,s,U,V,
             167                                                           !     TKE is the same as the layer underneath.
             168                     
             169                           INTEGER, PARAMETER :: nerr = 6     ! error output stream
             170                     
             171                     
             172                     
             173                     
             174                           CONTAINS
             175                     
             176                     
             177                     !---------------------------------------------------------
             178                             subroutine allocate_opgsst_array
             179                     
             180                               integer  ierr
             181                               allocate ( opgsst(nxp,my_max,0:13), stat=ierr)
             182     1                            if (ierr/= 0) then
             183     1                                write(6,*) 'mod_opgsst : allocate fail 1 '
             184     1                                stop
             185     1                            end if
             186                     
             187                                  return
             188                     
             189                             end subroutine
             190                     
             191                     
             192                             subroutine deallocate_opgsst_array
             193                     
             194                                deallocate (opgsst)
             195                                return
             196                     
             197                             end subroutine
             198                     
             199                             SUBROUTINE read_opgsst(idtg1,ggdef,ocean,ice)
             200                     
             201                               use index
             202                               use rank
             203                     
             204                               character*4 ggdef
             205                               integer*8 idtg1
             206                               character*12 cdtg
             207                               integer   iyyyy,mm,ddhhmn,iyy,imm,istat
             208                               integer lncrec
             209                               character lrec*26
             210                               integer i,j,ii,jj,nxj,kmm
             211                               real,dimension(:,:), allocatable:: temp1
             212                               logical ocean(nxp,my_max),ice(nxp,my_max)
             213                     
             214                     
             215                               allocate(temp1(nx,my))
             216                     !
             217                       11     format('W00100','0000',a4,i4.4,i2.2,'010000')  ! W10
             218                     
             219                     !           if(myrank.eq.0) call dmsopn(ifilin_sst,"r",istat)
             220                     !           call mpe_broadcast(istat,1,flag,mpe_integer)
             221                     !           if(istat.ne.0)then
             222                     !             if(myrank.eq.0) print *,'dmsopn sst error'
             223                     !               call mpe_finalize
             224                     !               call dmsexit(-1)
             225                     !           endif
             226                     
             227                     
             228                                 write(cdtg,'(i12)') idtg1
             229                                 read(cdtg,'(i4,i2,i8)')iyyyy,mm,ddhhmn
             230                     
             231                     !              iy=idtg_sst/1000000
             232                     
             233                                lncrec=nx*my
             234                     
             235     1                          do kmm=0,13
             236     2                            if( kmm.eq.0 ) then
             237     2                              imm=12
             238     2                              iyy=iyyyy-1
             239     2                            elseif (kmm.gt.12) then
             240     2                              imm=1
             241     2                              iyy=iyyyy+1
             242     2                            else
             243     2                              imm=i
             244     2                              iyy=iyyyy
             245     2                            endif
             246     1               
             247     1                            write(lrec,11) ggdef,iyy,imm
             248     1                            call dmsread(nx,my,lrec,lncrec,'H',ifilin_sst,temp1(:,:),istat)
             249     1               !             if( lreduce.eq.1 ) call reducepickr(temp1(1,imm,1),nxdef,nx,my)
             250     2                            do jj = 1, jlistnum
             251     2                              j=jlist1(jj)
             252     2                              i=nxjstart(j)
             253     2                              nxj=nxdef_2d(j)
             254     2                              if( lreduce.eq.1 )call reducepickr (temp1(1,j),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ocean
                                   <<< Loop-information  End >>>
             255     3  pp   2s                     do ii = 1, nxj
             256     3   p   2v                       i=nxjstart(j)+ii-1
             257     4   p   2m                       if(ocean(ii,jj) .or. ice(ii,jj))then
             258     4   p   2s                        opgsst(ii,jj,kmm)=temp1(i,j)+273.16
             259     4   p   2v                       endif
             260     3   p   2v                     end do
             261     2                            end do
             262     1               
             263     1                          enddo
             264                     
             265                                deallocate(temp1)
             266                     
             267                             END SUBROUTINE read_opgsst
             268                     
             269                     !----------------------------------------------------------
             270                     
             271                             subroutine deallocate_dailyFCT_array
             272                     
             273                                deallocate (obswtbold,obswtbnow,obswtbnew)
             274                                deallocate (tseaold,tseanow,tseanew,dtseadt)
             275                                deallocate (tseadiffFCT,tseadiffFCT24)
             276                                deallocate (dailyFCTsst,dFCTsstdt)
             277     1                          if(ldailyFCTicesndpt) then
             278     1                            deallocate (dailyFCTcice,dailyFCTsndepth)
             279     1                            deallocate (dFCTcicedt,dFCTsndepthdt)
             280     1                          endif
             281     1                          if(dailyClm_option .ge. 1) then
             282     1                            deallocate (ANAsstT0)
             283     1                            deallocate (dailyClmANAsst)
             284     2                            if(dailyClm_option .eq. 2) then
             285     2                              deallocate (dailyClmFCTsst)
             286     2                            endif
             287     1                          endif
             288                                return
             289                     
             290                             end subroutine deallocate_dailyFCT_array
             291                     
             292                     
             293                             SUBROUTINE read_dailyFCT(idtg1,tau,dtx,tg1,cice1,sndepth1  &
             294                                                     ,plon,plat,locean)
             295                     
             296                               USE index
             297                               USE rank
             298                     
             299                               INTEGER*8 :: idtg1,idtg_temp,idtg_FCT
             300                               REAL      :: tau,dtx,tauleft
             301                               REAL      :: tautemp
             302                               INTEGER   :: icurrenttau
             303                               REAL      :: ydate,ydate2
             304                               INTEGER       :: yr, mo, dy, hr, mn
             305                               character*12 cdtg
             306                               real tg1(nxp,my_max),cice1(nxp,my_max),sndepth1(nxp,my_max)
             307                               real plon(nx,my_max),plat(my)
             308                               logical  locean(nxp,my_max)
             309                     
             310                               icurrenttau=int(tau)
             311                               tauleft=float(int((tau-int(tau)+0.001)*3600./dtx))*dtx   !(sec)
             312     1                         if(tauleft .eq. 3600.) then
             313     1                         icurrenttau=icurrenttau+1
             314     1                         tauleft=0.
             315     1                         endif
             316                               call dtgfix12(idtg1,idtg_temp,icurrenttau)
             317                               write(cdtg,'(i12)')idtg_temp
             318                               read(cdtg,'(i4,i2,i2,i2,i2)')yr,mo,dy,hr,mn
             319                               ydate=float(yr*10000+mo*100+dy)+float(hr)/24.+tauleft/3600./24.
             320                               if(myrank .eq. 0) print *,"read_dailyFCT,ydate=",ydate
             321                     
             322                     
             323                               tautemp=tau+24.     !tau +24 hr
             324                               icurrenttau=int(tautemp)
             325                               tauleft=float(int((tautemp-int(tautemp)+0.001)*3600./dtx))*dtx !(sec)
             326     1                         if(tauleft .eq. 3600.) then
             327     1                         icurrenttau=icurrenttau+1
             328     1                         tauleft=0.
             329     1                         endif
             330                               call dtgfix12(idtg1,idtg_FCT,icurrenttau)
             331                               write(cdtg,'(i12)')idtg_FCT
             332                               read(cdtg,'(i4,i2,i2,i2,i2)')yr,mo,dy,hr,mn
             333                     !          ydate2=float(yr*10000+mo*100+dy)+float(hr/24)
             334                               ydate2=float(yr*10000+mo*100+dy)
             335                               write(cdtg,'(i4,i2.2,i2.2,i2.2,i2.2)')yr,mo,dy,00,00
             336                               read(cdtg,'(i12)')idtg_FCT
             337                               if(myrank .eq. 0) print *,"read_dailyFCT,ydate2=",ydate2
             338                     
             339                     
             340                               IF (.NOT. ALLOCATED(dailyFCTsst)) ALLOCATE (dailyFCTsst(nxp,my_max,2))
             341                               IF (.NOT. ALLOCATED(dFCTsstdt)) ALLOCATE (dFCTsstdt(nxp,my_max))
             342                               IF (.NOT. ALLOCATED(obswtbold)) ALLOCATE (obswtbold(nxp,my_max))
             343                               IF (.NOT. ALLOCATED(obswtbnow)) ALLOCATE (obswtbnow(nxp,my_max))
             344                               IF (.NOT. ALLOCATED(obswtbnew)) ALLOCATE (obswtbnew(nxp,my_max))
             345                               IF (.NOT. ALLOCATED(tseaold)) ALLOCATE (tseaold(nxp,my_max))
             346                               IF (.NOT. ALLOCATED(tseanow)) ALLOCATE (tseanow(nxp,my_max))
             347                               IF (.NOT. ALLOCATED(tseanew)) ALLOCATE (tseanew(nxp,my_max))
             348     1                         IF (.NOT. ALLOCATED(dtseadt)) then
             349     1                           ALLOCATE (dtseadt(nxp,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtseadt
                                   <<< Loop-information  End >>>
             350     1  pp   4v                  dtseadt=0.
             351     1                         ENDIF
             352     1                         IF (.NOT. ALLOCATED(tseadiffFCT)) then
             353     1                           ALLOCATE (tseadiffFCT(nxp,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT
                                   <<< Loop-information  End >>>
             354     1  pp   4v                  tseadiffFCT=0.
             355     1                         ENDIF
             356     1                         IF (.NOT. ALLOCATED(tseadiffFCT24)) then
             357     1                           ALLOCATE (tseadiffFCT24(nxp,my_max))
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24
                                   <<< Loop-information  End >>>
             358     1  pp   4v                  tseadiffFCT24=0.
             359     1                         ENDIF
             360                     
             361     1                         IF(ldailyFCTicesndpt) THEN
             362     1                           IF (.NOT. ALLOCATED(dailyFCTcice)) ALLOCATE (dailyFCTcice(nxp,my_max,2))
             363     1                           IF (.NOT. ALLOCATED(dailyFCTsndepth)) ALLOCATE (dailyFCTsndepth(nxp,my_max,2))
             364     1                           IF (.NOT. ALLOCATED(dFCTcicedt)) ALLOCATE (dFCTcicedt(nxp,my_max))
             365     1                           IF (.NOT. ALLOCATED(dFCTsndepthdt)) ALLOCATE (dFCTsndepthdt(nxp,my_max))
             366     1                         ENDIF
             367     1                         IF(dailyClm_option .ge. 1) THEN
             368     1                           IF (.NOT. ALLOCATED(ANAsstT0)) ALLOCATE (ANAsstT0(nxp,my_max))
             369     1                           IF (.NOT. ALLOCATED(dailyClmANAsst)) ALLOCATE (dailyClmANAsst(nxp,my_max,0:2))
             370     2                           if(dailyClm_option .eq. 2) then
             371     2                             IF (.NOT. ALLOCATED(dailyClmFCTsst)) ALLOCATE (dailyClmFCTsst(nxp,my_max,0:2))
             372     2                           endif
             373     1                         ENDIF
             374                     
             375                     
             376     1                         IF ( (tau .eq. 0.) .OR. lsitstart) THEN
             377     1                    !!! warm/cold start
             378     1                           timevals_dailyFCT(1)=ydate
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, dailyFCTsst
                                   <<< Loop-information  End >>>
             379     1  pp   2v                  dailyFCTsst(:,:,1)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, obswtbold
                                   <<< Loop-information  End >>>
             380     1  pp   2v                  obswtbold(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, obswtbnow
                                   <<< Loop-information  End >>>
             381     1  pp   2v                  obswtbnow(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, tseaold
                                   <<< Loop-information  End >>>
             382     1  pp   2v                  tseaold(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, tseanow
                                   <<< Loop-information  End >>>
             383     1  pp   2v                  tseanow(:,:)=tg1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tg1, ANAsstT0
                                   <<< Loop-information  End >>>
             384     1  pp   2v                  if(dailyClm_option .ge. 1) ANAsstT0(:,:)=tg1(:,:)
             385     2                           if(ldailyFCTicesndpt) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cice1, dailyFCTcice
                                   <<< Loop-information  End >>>
             386     2  pp   2v                    dailyFCTcice(:,:,1)=cice1(:,:)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sndepth1, dailyFCTsndepth
                                   <<< Loop-information  End >>>
             387     2  pp   2v                    dailyFCTsndepth(:,:,1)=sndepth1(:,:)
             388     2                           endif
             389     2                           if(ldailyFCTsst .or. ldailyFCTicesndpt)then
             390     2                             CALL read_dailyFCT_dayp1(idtg_FCT,locean)
             391     2                           endif
             392     2                           if(dailyClm_option .ge. 1)then
             393     2                             CALL read_dailyClm_2days(idtg1,idtg_FCT,icurrenttau,plon,plat,locean)
             394     2                           endif
             395     1               
             396     1                           timevals_dailyFCT(2)=ydate2
             397     1                         ELSEIF (ydate.LT.timevals_dailyFCT(2)) THEN
             398     1                    ! data were read. Note that initial value of  timevals_godas=0.
             399     1                           RETURN
             400     1                         ELSE
             401     1                    ! note that initial value of  timevals_godas=0.
             402     1                    ! Shift left
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTsst
                                   <<< Loop-information  End >>>
             403     1  pp   2v                  dailyFCTsst(:,:,1)=dailyFCTsst(:,:,2)
             404     2                           if(ldailyFCTicesndpt) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTcice
                                   <<< Loop-information  End >>>
             405     2  pp   2v                    dailyFCTcice(:,:,1)=dailyFCTcice(:,:,2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyFCTsndepth
                                   <<< Loop-information  End >>>
             406     2  pp   2v                    dailyFCTsndepth(:,:,1)=dailyFCTsndepth(:,:,2)
             407     2                           endif
             408     1                           timevals_dailyFCT(1)=timevals_dailyFCT(2)
             409     2                           if(ldailyFCTsst .or. ldailyFCTicesndpt) then
             410     2                             CALL read_dailyFCT_dayp1(idtg_FCT,locean)    ! read next FCST data
             411     2                           endif
             412     2                           if(dailyClm_option .ge. 1)then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyClmANAsst
                                   <<< Loop-information  End >>>
             413     2  pp   2v                    dailyClmANAsst(:,:,1)=dailyClmANAsst(:,:,2)
             414     3                             if(dailyClm_option .eq. 2) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dailyClmFCTsst
                                   <<< Loop-information  End >>>
             415     3  pp   2v                      dailyClmFCTsst(:,:,1)=dailyClmFCTsst(:,:,2)
             416     3                             endif
             417     2                             CALL read_dailyClm_dayp1(idtg1,idtg_FCT,icurrenttau,plon,plat,locean)
             418     2                           endif
             419     1               
             420     1                           timevals_dailyFCT(2)=ydate2
             421     1               
             422     1                         ENDIF
             423                     
             424                     
             425                     
             426                     
             427                           CONTAINS
             428                          !-----------------------------------
             429                             SUBROUTINE read_dailyFCT_dayp1(idtg1,locean)
             430                     
             431                               INTEGER*8 idtg1
             432                               INTEGER iyyyy,imm,idd,ihh,imn
             433                               INTEGER lncrec
             434                               character lrec*26
             435                               REAL ssttemp(nx,my),cicetemp(nx,my),sndpttemp(nx,my)
             436                               INTEGER ii,jj,nxj,i,j,istat,nxjtot
             437                               INTEGER itemp,jtemp
             438                               INTEGER iitemp,jjtemp
             439                               REAL sst_suntemp,sst_counttemp
             440                               REAL cice_suntemp,cice_counttemp,sndpt_suntemp,sndpt_counttemp
             441                               LOGICAL locean(nxp,my_max)
             442                     
             443                               write(cdtg,'(i12)') idtg1
             444                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy,imm,idd,ihh,imn
             445                     
             446                               lncrec=nx*my
             447                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 6
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sndpttemp, cicetemp, ssttemp
                                   <<< Loop-information  End >>>
             448        pp   2v                ssttemp=0.
             449         p   2v                cicetemp=0.
             450         p   2v                sndpttemp=0.
             451                     
             452                        11     format('W00100','0000',a4,i4.4,i2.2,i2.2,i2.2,'00')  ! sea surface temperature
             453                               write(lrec,11) ggdef,iyyyy,imm,idd,ihh
             454                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_sst,ssttemp(:,:),istat)
             455     1                         if(ldailyFCTicesndpt)then
             456     1                  12       format('W00091','0000',a4,i4.4,i2.2,i2.2,i2.2,'00')  ! sea ice fration
             457     1                           write(lrec,12) ggdef,iyyyy,imm,idd,ihh
             458     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ncep,cicetemp(:,:),istat)
             459     1                  13       format('B00650','0000',a4,i4.4,i2.2,i2.2,i2.2,'00')  ! water equivlent snow depth
             460     1                           write(lrec,13) ggdef,iyyyy,imm,idd,ihh
             461     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ncep,sndpttemp(:,:),istat)
             462     1                         endif
             463                     
             464                     !          if( lreduce.eq.1 ) then
             465                     !            call reducepick(ssttemp(1,1),nxdef,nx,my)
             466                     !            if(ldailyFCTicesndpt)then
             467                     !              call reducepick(cicetemp(1,1),nxdef,nx,my)
             468                     !              call reducepick(sndpttemp(1,1),nxdef,nx,my)
             469                     !            endif
             470                     !          endif
             471                     
             472     1                         DO jj = 1, jlistnum
             473     1                           j=jlist1(jj)
             474     1                           i=nxjstart(j)
             475     1                           nxj=nxdef_2d(j)
             476     2                           if( lreduce.eq.1 ) then
             477     2                             call reducepickr (ssttemp(1,j),nxdef(j),nx,1)
             478     3                             if(ldailyFCTicesndpt)then
             479     3                               call reducepickr (cicetemp(1,j),nxdef(j),nx,1)
             480     3                               call reducepickr (sndpttemp(1,j),nxdef(j),nx,1)
             481     3                             endif
             482     2                           endif
             483     1               
             484     2                           DO ii=1,nxj
             485     2                             i=nxjstart(j)+ii-1
             486     2                             dailyFCTsst(ii,jj,2)=MERGE(ssttemp(i,j),xmissing,  &
             487     2                                  (ssttemp(i,j).GE.sstmin .AND. ssttemp(i,j) .LE. 400.))
             488     3                             if(ldailyFCTicesndpt)then
             489     3                               dailyFCTcice(ii,jj,2)=MERGE(cicetemp(i,j),xmissing,  &
             490     3                                                        (cicetemp(i,j) .GE. 0))
             491     3                               dailyFCTsndepth(ii,jj,2)=MERGE(sndpttemp(i,j),xmissing, &
             492     3                                                        (sndpttemp(i,j) .GE. 0))
             493     3                             endif
             494     2               
             495     3                             if( (ssttemp(i,j).EQ.xmissing) .OR. (ldailyFCTicesndpt .AND. &
             496     3                               ((cicetemp(i,j).EQ.xmissing).OR.(sndpttemp(i,j).EQ.xmissing))) ) then
             497     3                               sst_suntemp=0.
             498     3                               sst_counttemp=0.
             499     3                               cice_suntemp=0.
             500     3                               cice_counttemp=0.
             501     3                               sndpt_suntemp=0.
             502     3                               sndpt_counttemp=0.
             503     3                               nxjtot=nxdef(j)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             504     4  pp                           do itemp=i-1, i+1
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 180
                                   <<< Loop-information  End >>>
             505     5  pp    s                        do jtemp=j-1, j+1
             506     6   p    v                          if (itemp .eq. 0) then
             507     6   p    m                            iitemp=nxjtot
             508     6   p    v                          elseif (itemp .gt. nxjtot) then
             509     6   p    m                            iitemp= 1
             510     6   p                               else
             511     6   p    m                            iitemp=itemp
             512     6   p    v                          endif
             513     6   p    v                          if (jtemp .eq. 0) then
             514     6   p    m                            jjtemp=my
             515     6   p    v                          elseif (jtemp .gt. my) then
             516     6   p    m                            jjtemp=1
             517     6   p                               else
             518     6   p    m                            jjtemp=jtemp
             519     6   p    m                          endif
             520     6   p    m                          if (ssttemp(iitemp,jjtemp).GE.sstmin .AND. ssttemp(iitemp,jjtemp) .LE. 400.)then
             521     6   p    v                            sst_suntemp=sst_suntemp+ssttemp(iitemp,jjtemp)
             522     6   p    v                            sst_counttemp=sst_counttemp+1.
             523     6   p    v                          endif
             524     6   p    v                          if(ldailyFCTicesndpt)then
             525     7   p    v                            if (cicetemp(iitemp,jjtemp).GE.0.)then
             526     7   p    v                              cice_suntemp=cice_suntemp+cicetemp(iitemp,jjtemp)
             527     7   p    v                              cice_counttemp=cice_counttemp+1.
             528     7   p    v                            endif
             529     7   p    v                            if (sndpttemp(iitemp,jjtemp).GE.0.)then
             530     7   p    v                              sndpt_suntemp=sndpt_suntemp+sndpttemp(iitemp,jjtemp)
             531     7   p    v                              sndpt_counttemp=sndpt_counttemp+1.
             532     7   p    v                            endif
             533     6   p    v                          endif
             534     5   p    v                        enddo
             535     4   p                           enddo
             536     4                               if(ssttemp(i,j).LT.sstmin .OR. ssttemp(i,j) .GT. 400.)then
             537     4                                 ssttemp(i,j)=sst_suntemp/sst_counttemp
             538     5                                 if (ssttemp(i,j).GE.sstmin .AND. ssttemp(i,j) .LE. 400.)then
             539     5                                   dailyFCTsst(ii,jj,2)=ssttemp(i,j)
             540     5                                 else
             541     5                                   dailyFCTsst(ii,jj,2)=dailyFCTsst(ii,jj,1)
             542     5                                 endif
             543     4                               endif
             544     4                               if(ldailyFCTicesndpt)then
             545     5                                 if(cicetemp(i,j).LT. 0.)then
             546     5                                   cicetemp(i,j)=cice_suntemp/cice_counttemp
             547     6                                   if(cicetemp(i,j).GE. 0.)then
             548     6                                     dailyFCTcice(ii,jj,2)=cicetemp(i,j)
             549     6                                   endif
             550     5                                 endif
             551     5                                 if(sndpttemp(i,j).LT. 0.)then
             552     5                                   sndpttemp(i,j)=sndpt_suntemp/sndpt_counttemp
             553     6                                   if(sndpttemp(i,j).GE. 0.)then
             554     6                                     dailyFCTsndepth(ii,jj,2)=sndpttemp(i,j)
             555     6                                   endif
             556     5                                 endif
             557     4                               endif
             558     3                             endif
             559     3                             if(locean(ii,jj) .AND. dailyFCTsst(ii,jj,1).ge.sstmin &
             560     3                                .AND. dailyFCTsst(ii,jj,2).ge.sstmin)then
             561     3                               dFCTsstdt(ii,jj)=(dailyFCTsst(ii,jj,2)-dailyFCTsst(ii,jj,1))/(24.*3600.)
             562     3                             else
             563     3                               dFCTsstdt(ii,jj)=0.
             564     3                             endif
             565     3                             if(ldailyFCTicesndpt)then
             566     3                               dFCTcicedt(ii,jj)=(dailyFCTcice(ii,jj,2)-dailyFCTcice(ii,jj,1))/(24.*3600.)
             567     3                               dFCTsndepthdt(ii,jj)=(dailyFCTsndepth(ii,jj,2)-dailyFCTsndepth(ii,jj,1))/(24.*3600.)
             568     3                             endif
             569     2               
             570     2                           ENDDO  !end do ii
             571     1                         ENDDO    !end do jj
             572                     
             573                     
             574                             END SUBROUTINE read_dailyFCT_dayp1
             575                     
             576                     
             577                             SUBROUTINE read_dailyClm_2days(idtg1,idtg_2,itau,plon,plat,locean)
             578                     
             579                               INTEGER*8 idtg1,idtg_2
             580                               INTEGER itau
             581                               INTEGER iyyyy,imm,idd,ihh,imn
             582                               INTEGER iyyyy2,imm2,idd2,ihh2,imn2
             583                               INTEGER lncrec
             584                               CHARACTER lrec*26
             585                               REAL sstANA0(nx,my),sstANA1(nx,my)
             586                               REAL sstFCT0(nx,my),sstFCT1(nx,my)
             587                               INTEGER i,j,ii,jj,nxj,istat
             588                               REAL wweight
             589                               REAL plon(nx,my_max),plat(my)
             590                               LOGICAL locean(nxp,my_max)
             591                     
             592                               write(cdtg,'(i12)') idtg1
             593                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy,imm,idd,ihh,imn
             594                               write(cdtg,'(i12)') idtg_2
             595                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy2,imm2,idd2,ihh2,imn2
             596                     
             597                               lncrec=nx*my
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT1, sstFCT0, sstANA1, sstANA0
                                   <<< Loop-information  End >>>
             598        pp   2v                sstANA0=0.
             599         p   2v                sstANA1=0.
             600         p   2v                sstFCT0=0.
             601         p   2v                sstFCT1=0.
             602                     
             603                               !dailyClm_option>=1, read climatology ana. sst
             604                        11     format('W00100',4x,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             605                               write(lrec,11) ggdef,imm,idd
             606                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmANA,sstANA0(:,:),istat)
             607                     
             608                        12     format('W00100',4x,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             609                               write(lrec,12) ggdef,imm2,idd2
             610                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmANA,sstANA1(:,:),istat)
             611                     
             612                     !          if( lreduce.eq.1 ) then
             613                     !            call reducepickr(sstANA0(1,1),nxdef,nx,my)
             614                     !            call reducepickr(sstANA1(1,1),nxdef,nx,my)
             615                     !          endif
             616                     
             617                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA1, sstANA0
                                   <<< Loop-information  End >>>
             618        pp    v                sstANA0=MERGE(sstANA0,xmissing,(sstANA0.GE.sstmin .AND. sstANA0.LE.400.))
             619         p    v                sstANA1=MERGE(sstANA1,xmissing,(sstANA1.GE.sstmin .AND. sstANA1.LE.400.))
             620                     
             621                     !ps          CALL fill_missing2(sstANA0(:,:),nx,my,1,.FALSE.)
             622                     !ps          CALL fill_missing2(sstANA1(:,:),nx,my,1,.FALSE.)
             623                     
             624                     
             625     1                         if(dailyClm_option .eq. 2) then     !dailyClm_option=2, read forcast climatology sst
             626     1                  13       format('W00100',i4.4,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             627     1                           write(lrec,13) itau,ggdef,imm,idd
             628     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmFCT,sstFCT0(:,:),istat)
             629     1               
             630     1                  14       format('W00100',i4.4,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             631     1                           write(lrec,14) itau+24,ggdef,imm,idd
             632     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmFCT,sstFCT1(:,:),istat)
             633     1               
             634     1               
             635     1               !            if( lreduce.eq.1 ) then
             636     1               !              call reducepickr(sstFCT0(1,1),nxdef,nx,my)
             637     1               !              call reducepickr(sstFCT1(1,1),nxdef,nx,my)
             638     1               !            endif
             639     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.53, ITR: 40, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT1, sstFCT0
                                   <<< Loop-information  End >>>
             640     1  pp    v                  sstFCT0=MERGE(sstFCT0,xmissing,(sstFCT0.GE.sstmin .AND. sstFCT0.LE.400.))
             641     1   p    v                  sstFCT1=MERGE(sstFCT1,xmissing,(sstFCT1.GE.sstmin .AND. sstFCT1.LE.400.))
             642     1               
             643     1               !ps            CALL fill_missing2(sstFCT0(:,:),nx,my,1,.FALSE.)
             644     1               !ps            CALL fill_missing2(sstFCT1(:,:),nx,my,1,.FALSE.)
             645     1                         endif
             646                     
             647                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locean, dailyFCTsst, sstANA1, sstANA0
                                   <<<      dFCTsstdt, dailyClmANAsst
                                   <<< Loop-information  End >>>
             648     1                         DO jj = 1, jlistnum
             649     1                           j=jlist1(jj)
             650     1                           nxj=nxdef_2d(j)
             651     1                           i=nxjstart(j)
             652     2                           if( lreduce.eq.1 ) then
             653     2                             call reducepickr(sstANA0(1,j),nxdef(j),nx,1)
             654     2                             call reducepickr(sstANA1(1,j),nxdef(j),nx,1)
             655     2                             call reducepickr(sstFCT0(1,j),nxdef(j),nx,1)
             656     2                             call reducepickr(sstFCT1(1,j),nxdef(j),nx,1)
             657     2                           end if
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 145
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA0, sstANA1, locean, dailyClmANAsst
                                   <<<      dFCTsstdt
                                   <<< Loop-information  End >>>
             658     2  pp    s                  DO ii=1,nxj
             659     2   p    v                    wweight=0.
             660     2   p    v                    i=nxjstart(j)+ii-1
             661     2   p    v                    dailyClmANAsst(ii,jj,0)=sstANA0(i,j)
             662     2   p    v                    dailyClmANAsst(ii,jj,1)=sstANA0(i,j)
             663     2   p    v                    dailyClmANAsst(ii,jj,2)=sstANA1(i,j)
             664     3   p    m                    if(locean(ii,jj) .AND. dailyClm_option .eq. 1) then   !dailyClm_option=1
             665     4   p    s                      if(ldailyFCTsst)then
             666     4                               !similar to (Yuejian Zhu, operational)
             667     4                               !  wweight=min(float(itau)/24./35.,1.)
             668     4                               !do weigting when (tau>=14.*24. & abs(plat)>=40.)
             669     5   p    s                        if((itau .gt. 14*24) .AND. (abs(plat(j)) .gt. 40.)) then
             670     5   p    s                          wweight=min(max((float(itau)-14.*24.)/(24.*30.),0.),1.)
             671     5   p    s                        endif
             672     4   p    s                        dailyFCTsst(ii,jj,2)=(1.-wweight)*dailyFCTsst(ii,jj,2)    &
             673     4                                                     +wweight*dailyClmANAsst(ii,jj,2)
             674     4                               else
             675     4                               !persistent anomaly sst
             676     4                               !SSTf_t=[SSTa_t0-SSTc_t0]*exp(-(t-t0)/90)+SSTc_t
             677     4                               !(Yuejian Zhu, operational)
             678     4                                 wweight=min(max(exp(-float(itau)/(90.*24.)),0.),1.)
             679     4                                 dailyFCTsst(ii,jj,2)=wweight*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0))  &
             680     4                                                     +dailyClmANAsst(ii,jj,2)
             681     4   p    s                      endif
             682     3   p    v                    endif
             683     3   p    s                    if(ldailyFCTsst .AND. locean(ii,jj) .AND. dailyClm_option .eq. 2) then   !dailyClm_option=2
             684     3                               dailyClmFCTsst(ii,jj,0)=sstFCT0(i,j)
             685     3                               dailyClmFCTsst(ii,jj,1)=sstFCT0(i,j)
             686     3                               dailyClmFCTsst(ii,jj,2)=sstFCT1(i,j)
             687     3                               !idea from Yuejian Zhu(2018 JGR)
             688     3                                wweight=min(max(float(itau)/24./35.,1.),0.)
             689     3                                dailyFCTsst(ii,jj,2)=(1.-wweight)*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0)    &
             690     3                                    +dailyClmANAsst(ii,jj,2) )+wweight*(dailyFCTsst(ii,jj,2)    &
             691     3                                    -(dailyClmFCTsst(ii,jj,2)-dailyClmANAsst(ii,jj,2)))
             692     3   p    v                    endif
             693     3   p    s                    if(locean(ii,jj) .AND. dailyFCTsst(ii,jj,1).ge.sstmin &
             694     3                                .AND.dailyFCTsst(ii,jj,2).ge.sstmin)then
             695     3   p    s                      dFCTsstdt(ii,jj)=(dailyFCTsst(ii,jj,2)-dailyFCTsst(ii,jj,1))/(24.*3600.)
             696     3   p    s                    else
             697     3   p    s                      dFCTsstdt(ii,jj)=0.
             698     3   p    v                    endif
             699     2               
             700     2   p    v                  ENDDO  !end do ii
             701     1                         ENDDO    !end do jj
             702                     
             703                             END SUBROUTINE read_dailyClm_2days
             704                     
             705                     
             706                             SUBROUTINE read_dailyClm_dayp1(idtg1,idtg_2,itau,plon,plat,locean)
             707                     
             708                               INTEGER*8 idtg1,idtg_2
             709                               INTEGER itau
             710                               INTEGER iyyyy,imm,idd,ihh,imn
             711                               INTEGER iyyyy2,imm2,idd2,ihh2,imn2
             712                               INTEGER lncrec
             713                               CHARACTER lrec*26
             714                               REAL sstANA(nx,my),sstFCT(nx,my)
             715                               INTEGER i,j,ii,jj,nxj,istat
             716                               REAL wweight
             717                               REAL plon(nx,my_max),plat(my)
             718                               LOGICAL locean(nxp,my_max)
             719                     
             720                               write(cdtg,'(i12)') idtg1
             721                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy,imm,idd,ihh,imn
             722                               write(cdtg,'(i12)') idtg_2
             723                               read(cdtg,'(i4.4,i2.2,i2.2,i2.2,i2.2)') iyyyy2,imm2,idd2,ihh2,imn2
             724                     
             725                               lncrec=nx*my
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT, sstANA
                                   <<< Loop-information  End >>>
             726        pp   2v                sstANA=0.
             727         p   2v                sstFCT=0.
             728                     
             729                     
             730                        11     format('W00100',4x,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             731                               write(lrec,11) ggdef,imm2,idd2
             732                               call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmANA,sstANA(:,:),istat)
             733                     
             734                     !          if( lreduce.eq.1 ) then
             735                     !            call reducepickr(sstANA(1,1),nxdef,nx,my)
             736                     !          endif
             737                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.72, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA
                                   <<< Loop-information  End >>>
             738        pp   2v                sstANA=MERGE(sstANA,xmissing,(sstANA.GE.sstmin .AND. sstANA.LE.400.))
             739                     !ps          CALL fill_missing2(sstANA(:,:),nx,my,1,.FALSE.)
             740                     
             741                     
             742                     
             743     1                         if(dailyClm_option .eq. 2) then
             744     1                  13       format('W00100',i4.4,a4,4x,i2.2,i2.2,4x)  ! sea surface temperature
             745     1                           write(lrec,13) itau,ggdef,imm,idd
             746     1                           call dmsread(nx,my,lrec,lncrec,'H',ifilin_ClmFCT,sstFCT(:,:),istat)
             747     1               
             748     1               !            if( lreduce.eq.1 ) then
             749     1               !              call reducepickr(sstFCT(1,1),nxdef,nx,my)
             750     1               !            endif
             751     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.72, ITR: 112, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstFCT
                                   <<< Loop-information  End >>>
             752     1  pp   2v                  sstFCT=MERGE(sstFCT,xmissing,(sstFCT.GE.sstmin .AND. sstFCT.LE.400.))
             753     1               !ps            CALL fill_missing2(sstFCT(:,:),nx,my,1,.FALSE.)
             754     1                         endif
             755                     
             756                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locean, dailyFCTsst, sstANA, dFCTsstdt
                                   <<<      dailyClmANAsst
                                   <<< Loop-information  End >>>
             757     1                         DO jj = 1, jlistnum
             758     1                           j=jlist1(jj)
             759     1                           nxj=nxdef_2d(j)
             760     2                           if( lreduce.eq.1 ) then
             761     2                             call reducepickr(sstANA(1,j),nxdef(j),nx,1)
             762     2                             call reducepickr(sstFCT(1,j),nxdef(j),nx,1)
             763     2                           end if
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 162
                                   <<<  [OPTIMIZATION]
                                   <<<    UNSWITCHING
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      sstANA, locean, dailyClmANAsst
                                   <<<      dFCTsstdt
                                   <<< Loop-information  End >>>
             764     2  pp    s                  DO ii=1,nxj
             765     2   p    v                    wweight=0.
             766     2   p    v                    i=nxjstart(j)+ii-1
             767     2   p    v                    dailyClmANAsst(ii,jj,2)=sstANA(i,j)
             768     3   p    m                    if(locean(ii,jj) .AND. dailyClm_option .eq. 1) then   !dailyClm_option=1
             769     4   p    s                      if(ldailyFCTsst)then
             770     4                               !similar to (Yuejian Zhu, operational)
             771     4                               !  wweight=min(float(itau)/24./35.,1.)
             772     4                               !do weigting when (tau>=14.*24. & abs(plat)>=40.)
             773     5   p    s                        if((itau .gt. 14*24) .AND. (abs(plat(j)) .gt. 40.)) then
             774     5   p    s                          wweight=min(max((float(itau)-14.*24.)/(24.*30.),0.),1.)
             775     5   p    s                        endif
             776     4   p    s                        dailyFCTsst(ii,jj,2)=(1.-wweight)*dailyFCTsst(ii,jj,2) &
             777     4                                                     +wweight*dailyClmANAsst(ii,jj,2)
             778     4                               else
             779     4                               !persistent anomaly sst
             780     4                               !SSTf_t=[SSTa_t0-SSTc_t0]*exp(-(t-t0)/90)+SSTc_t
             781     4                               !(Yuejian Zhu, operational)
             782     4                                 wweight=min(max(exp(-float(itau)/(90.*24.)),0.),1.)
             783     4                                 dailyFCTsst(ii,jj,2)=wweight*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0))  &
             784     4                                                      +dailyClmANAsst(ii,jj,2)
             785     4   p    s                      endif
             786     3   p    v                    endif
             787     3   p    s                    if(ldailyFCTsst .AND. locean(ii,jj) .AND. dailyClm_option .eq. 2) then   !dailyClm_option=2
             788     3                               dailyClmFCTsst(ii,jj,2)=sstFCT(i,j)
             789     3                               !idea from Yuejian Zhu(2018 JGR)
             790     3                                wweight=min(max(float(itau)/24./35.,0.),1.)
             791     3                                dailyFCTsst(ii,jj,2)=(1.-wweight)*(ANAsstT0(ii,jj)-dailyClmANAsst(ii,jj,0)   &
             792     3                                    +dailyClmANAsst(ii,jj,2))+wweight*(dailyFCTsst(ii,jj,2)    &
             793     3                                    -(dailyClmFCTsst(ii,jj,2)-dailyClmANAsst(ii,jj,2)))
             794     3   p    v                    endif
             795     3   p    s                    if(locean(ii,jj) .AND. dailyFCTsst(ii,jj,1).ge.sstmin &
             796     3                               .AND. dailyFCTsst(ii,jj,2).ge.sstmin)then
             797     3   p    s                      dFCTsstdt(ii,jj)=(dailyFCTsst(ii,jj,2)-dailyFCTsst(ii,jj,1))/(24.*3600.)
             798     3   p    s                    else
             799     3   p    s                      dFCTsstdt(ii,jj)=0.
             800     3   p    v                    endif
             801     2               
             802     2   p    v                  ENDDO
             803     1                         ENDDO
             804                     
             805                     
             806                             END SUBROUTINE read_dailyClm_dayp1
             807                     
             808                     
             809                           END SUBROUTINE read_dailyFCT
             810                     
             811                     !---------------------------------------------------------------
             812                           SUBROUTINE outtseadiffFCT24(nx,my,my_max,dt24,ifilout,itau,idtg,ggdef)
             813                     
             814                           use index
             815                           use mpe
             816                           use const, only: kflag,RTYPE
             817                     
             818                           implicit none
             819                     
             820                           integer   nx,my,my_max,itau
             821                           real      dt24
             822                           real(kind=RTYPE) glob(nx,my),wrk(nxp,my_max)
             823                           integer*8 idtg
             824                           character*80 ifilout
             825                           character*26 ihdg
             826                           character*4  ggdef
             827                           integer   imax,jmax,lenc,j,nxj,i,istat,jj
             828                     
             829                           imax=nx
             830                           jmax=my
             831                           lenc= imax*jmax
             832                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24, wrk
                                   <<< Loop-information  End >>>
             833     1  pp                 do jj = 1,jlistnum
             834     1   p                   j=jlist1(jj)
             835     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24, wrk
                                   <<< Loop-information  End >>>
             836     2   p   2v              do i=1,nxj
             837     2   p   2v               wrk(i,jj)=tseadiffFCT24(i,jj)/dt24
             838     2   p   2v              enddo
             839     1   p                 enddo
             840                           call unify_reduceintp(nx,my,my_max,wrk,glob)
             841                           call syslbl ('w0001f',idtg,itau,ggdef,ihdg)
             842                           call dmswrit(imax,jmax,ihdg,lenc,kflag,ifilout,glob,istat)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 9
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tseadiffFCT24
                                   <<< Loop-information  End >>>
             843        pp   4v            tseadiffFCT24=0.
             844                     
             845                           END SUBROUTINE

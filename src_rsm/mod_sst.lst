            1428     7   p   2v                              zin(:,j)=zintemp(:,ngl-j+1)
            1429     7   p                                 ENDDO
            1430     6                                   ENDIF
            1431     5                                 ENDIF  !end lex2
            1432     4                                 flag=.true.
            1433     4                               ENDIF
            1434     3                               call mpe_bcast(zin(:,:),nx*my,0,mpe_double)
            1435     3               

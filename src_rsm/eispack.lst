             414     2  pp    v              DO 230 I=L,J
             415     2   p    v                P=X*H(I,K)+Y*H(I,K+1)
             416     2   p    v                IF (.NOT.NOLATS) GO TO 220
             417     2   p    v                P=P+ZZ*H(I,K+2)
             418     2   p    v                H(I,K+2)=H(I,K+2)-P*R
             419     2   p    v        220     H(I,K+1)=H(I,K+1)-P*Q
             420     2   p    v                H(I,K)=H(I,K)-P
             421     2   p    v        230   CONTINUE
             422     1               !
             423     1                 260 CONTINUE
             424                     !
             425                           GO TO 70
             426                     ! ******************** ONE ROOT FOUND ******************************
             427                       270 WR(EN)=X+T
             428                           WI(EN)=0.
             429                           EN=NA
             430                           GO TO 60
             431                     ! ******************** TWO ROOTS FOUND *****************************
             432                       280 P=(Y-X)/2.0
             433                           Q=P*P+W
             434                           ZZ=SQRT(ABS(Q))
             435                           X=X+T
             436                           IF (Q.LT.0.) GO TO 320
             437                     ! ******************** REAL PAIR ***********************************
             438                           ZZ=P+SIGN(ZZ,P)
             439                           WR(NA)=X+ZZ
             440                           WR(EN)=WR(NA)
             441                           IF (ZZ.NE.0.) WR(EN)=X-W/ZZ
             442                           WI(NA)=0.
             443                           WI(EN)=0.
             444                           GO TO 330
             445                     ! ******************** COMPLEX PAIR *******************************
             446                       320 WR(NA)=X+P
             447                           WR(EN)=X+P
             448                           WI(NA)=ZZ
             449                           WI(EN)=-ZZ
             450                       330 EN=ENM2
             451                           GO TO 60
             452                     ! ******************** SET ERROR -- NO CONVERGENCE TO AN
             453                     !                      EIGENVALUE AFTER 30 ITERATIONS *************
             454                      1000 IERR=EN
             455                      1001 RETURN
             456                           END


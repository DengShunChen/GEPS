             467                           LOGICAL NOLATS
             468                           COMPLEX Z3
             469                     !      COMPLEX CMPLX
             470                     !      REAL REAL,AIMAG
             471                     !
             472                     ! ********************** MACHEP IS A MACHINE DEPENDENT PARAMETER SPACIFYING
             473                     !                        THE RELATIVE PRECISION OF FLOATING POINT ARITHEMETIC
             474                           MACHEP=2.**(-47)
             475                     !
             476                           IERR=0
             477                           NORM=0.
             478                           K=1
             479                     ! ********************* STORE ROOTS ISOLATED BY BALANC
             480                     !                       AND COMPUTE MATRIX NORM **********************
             481     1                     DO 50 I=1,N

               1                           SUBROUTINE RG(NM,N,A,WR,WI,MATZ,Z,IV1,FV1,IERR)
               2                     !!
               3                     !
               4                           INTEGER N,NM,IS1,IS2,IERR,MATZ
               5                           REAL A(NM,N),WR(N),WI(N),Z(NM,N),FV1(N)
               6                           INTEGER IV1(N)
               7                     !
               8                     !
               9                           IF (N.LE.NM) GO TO 10
              10                           IERR=10*N
              11                           GO TO 50
              12                     !
              13                        10 CALL BALANC(NM,N,A,IS1,IS2,FV1)
              14                           CALL ELMHES(NM,N,IS1,IS2,A,IV1)
              15                           IF (MATZ.NE.0) GO TO 20
              16                     ! ************* FIND EIGEN VALUES ONLY *********************
              17                           CALL HQR(NM,N,IS1,IS2,A,WR,WI,IERR)
              18                           GO TO 50
              19                     ! ************* FIND BOTH EIGENVALUES AND EIGENVECTORS *****
              20                        20 CALL ELTRAN(NM,N,IS1,IS2,A,IV1,Z)
              21                           CALL HQR2(NM,N,IS1,IS2,A,WR,WI,Z,IERR)
              22                           IF (IERR.NE.0) GO TO 50
              23                           CALL BALBAK(NM,N,IS1,IS2,FV1,N,Z)
              24                        50 RETURN
              25                           END


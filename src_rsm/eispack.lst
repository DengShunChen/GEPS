             144                     !
             145                     !
             146                           SUBROUTINE BALBAK(NM,N,LOW,IGH,SCALE,M,Z)
             147                     !
             148                           INTEGER I,J,K,M,N,II,NM,IGH,LOW
             149                           REAL SCALE(N),Z(NM,M)
             150                           REAL S
             151                     !
             152                           IF(M.EQ.0) GO TO 200
             153                           IF(IGH.EQ.LOW) GO TO 120
             154                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<< Loop-information  End >>>
             155     1  pp                 DO 110 I=LOW,IGH
             156     1   p                   S=SCALE(I)
             157     1               ! **************** LEFT HAND EIGENVECTORS ARE BACK TRANSFORMED
             158     1               !                  IF THE FOREGOING STATEMENT IS REPLACED BY
             159     1               !                  S=1.0/SCALE(i). *******************************
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.18, ITR: 96, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             160     2   p   4v            DO 100 J=1,M
             161     2   p   4v        100 Z(I,J)=Z(I,J)*S
             162     1               !
             163     1   p             110 CONTINUE
             164                     ! *****************_ FOR I=LOW-1 UNTIL 1,
             165                     !                    IGH+1 STEP 1 until N DO __ ********************
             166     1                 120 DO 140 II=1,N
             167     1                       I=II
             168     1                       IF(I.GE.LOW.AND.I.LE.IGH) GO TO 140
             169     1                       IF(I.LT.LOW) I=LOW-II
             170     1                       K=SCALE(I)
             171     1                       IF(K.EQ.I) GO TO 140
             172     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             173     2  pp   2v              DO 130 J=1,M
             174     2   p   2v                S=Z(I,J)
             175     2   p   2v                Z(I,J)=Z(K,J)
             176     2   p   2v                Z(K,J)=S
             177     2   p   2v        130   CONTINUE
             178     1               !
             179     1                 140 CONTINUE
             180                     !
             181                       200 RETURN
             182                           END


             459                           SUBROUTINE HQR2(NM,N,LOW,IGH,H,WR,WI,Z,IERR)
             460                     !
             461                           INTEGER I,J,K,L,M,N,EN,II,JJ,LL,MM,NA,NM,NN, &
             462                                   IGH,ITS,LOW,MP2,ENM2,IERR
             463                           REAL H(NM,N),WR(N),WI(N),Z(NM,N)
             464                           REAL P,Q,R,S,T,W,X,Y,RA,SA,VI,VR,ZZ,NORM,MACHEP
             465                     !      REAL SQRT,ABS,SIGN

             283                     !
             284                     !
             285                           SUBROUTINE HQR(NM,N,LOW,IGH,H,WR,WI,IERR)
             286                     !
             287                           INTEGER I,J,K,L,M,N,EN,LL,MM,NA,NM,IGH,ITS,LOW,MP2,ENM2,IERR
             288                           REAL H(NM,N),WR(N),WI(N)
             289                           REAL P,Q,R,S,T,W,X,Y,ZZ,NORM,MACHEP
             290                     !      REAL SQRT,ABS,SIGN
             291                     !      INTEGER MIN0
             292                           LOGICAL NOLATS
             293                     !
             294                     ! **************** MACHEP IS A MACHINE DEPENDENT PARAMETER SPACIFYING
             295                     !                  THE RELATIVE PRECISION OF FLOATING POINT ARITHEMETIC
             296                     ! ************************************************************************
             297                           MACHEP=2.**(-47)
             298                     !
             299                           IERR=0
             300                           NORM=0.
             301                           K=1
             302                     ! **************** STORE ROOTS OSOLATED BY BALANC
             303                     !                  AND COMPUTE MATRIX NORM ***********************
             304     1                     DO 50 I=1,N
             305     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1600
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             306     2  pp    v              DO 40 J=K,N
             307     2   p    v         40   NORM=NORM+ABS(H(I,J))
             308     1               !
             309     1                       K=I
             310     1                       IF (I.GE.LOW.AND.I.LE.IGH) GO TO 50
             311     1                       WR(I)=H(I,J)
             312     1                       WI(I)=0.
             313     1                  50 CONTINUE
             314                     !
             315                           EN=IGH
             316                           T=0.
             317                     ! ***************** SEARCH FOR NEXT EIGENVALUES *******************
             318                        60 IF (EN.LT.LOW) GO TO 1001
             319                           ITS=0
             320                           NA=EN-1
             321                           ENM2=NA-1
             322                     ! ***************** LOOK FOR SINGLE SMALL SUB-DIAGONAL ELEMENT
             323                     !                   FOR L=en STEP -1 UNTIL LOW DO __ ***************
             324     1        s         70 DO 80 LL=LOW,EN
             325     1        s              L=EN+LOW-LL
             326     1        s              IF (L.EQ.LOW) GO TO 100
             327     1        s              S=ABS(H(L-1,L-1))+ABS(H(L,L))
             328     1        s              IF (S.EQ.0.) S=NORM
             329     1        s              IF (ABS(H(L,L-1)).LE.MACHEP*S) GO TO 100
             330     1        s         80 CONTINUE
             331                     ! ***************** FORM SHIFT **************************************
             332                       100 X=H(EN,EN)
             333                           IF(L.EQ.EN) GO TO 270
             334                           Y=H(NA,NA)
             335                           W=H(EN,NA)*H(NA,EN)
             336                           IF (L.EQ.NA) GO TO 280
             337                           IF (ITS.EQ.30) GO TO 1000
             338                           IF (ITS.NE.10.AND.ITS.NE.20) GO TO 130
             339                     ! ***************** FORM EXCEPTIONAL SHIFT *************************
             340                           T=T+X
             341                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1231
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.18, ITR: 96, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             342     1  pp   4v            DO 120 I=LOW,EN
             343     1   p   4v        120 H(I,I)=H(I,I)-X
             344                     !
             345                           S=ABS(H(EN,NA))+ABS(H(NA,ENM2))
             346                           X=0.75*S
             347                           Y=X
             348                           W=-0.4375*S*S
             349                       130 ITS=ITS+1
             350                     ! ***************** LOOK FOR TWO CONSECUTIVE SMALL
             351                     !                   SUB-DIAGONAL ELEMENTS.
             352                     !                   FOR m=EN-2 STEP-1 UNTIL L DO__ ******************
             353     1        s            DO 140 MM=L,ENM2
             354     1        s              M=ENM2+L-MM
             355     1        s              ZZ=H(M,M)
             356     1        s              R=X-ZZ
             357     1        s              S=Y-ZZ
             358     1        s              P=(R*S-W)/H(M+1,M)+H(M,M+1)
             359     1        s              Q=H(M+1,M+1)-ZZ-R-S
             360     1        s              R=H(M+2,M+1)
             361     1        s              S=ABS(P)+ABS(Q)+ABS(R)
             362     1        s              P=P/S
             363     1        s              Q=Q/S
             364     1        s              R=R/S
             365     1        s              IF (M.EQ.L) GO TO 150
             366     1        s              IF (ABS(H(M,M-1))*(ABS(Q)+ABS(R)).LE.MACHEP*ABS(P)       &
             367     1                        * (ABS(H(M-1,M-1))+ABS(ZZ)+ABS(H(M+1,M+1)))) GO TO 150
             368     1        s        140 CONTINUE
             369                     !
             370                       150 MP2=M+2
             371                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.62, ITR: 80, MVE: 2, POL: S)
                                   <<< Loop-information  End >>>
             372     1  pp   2v            DO 160 I=MP2,EN
             373     1   p   2v              H(I,I-2)=0.
             374     1   p   2v              IF (I.EQ.MP2) GO TO 160
             375     1   p   2v              H(I,I-3)=0.
             376     1   p   2v        160 CONTINUE
             377                     ! ******************** DOUBLE QR STEP INVOLVING ROWS L TO EN AND
             378                     !                      COLUMNS M TO EN **************************
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      H
                                   <<< Loop-information  End >>>
             379     1                     DO 260 K=M,NA
             380     1                       NOLATS=K.NE.NA
             381     1                       IF (K.EQ.M) GO TO 170
             382     1                       P=H(K,K-1)
             383     1                       Q=H(K+1,K-1)
             384     1                       R=0.
             385     1                       IF (NOLATS) R=H(K+2,K-1)
             386     1                       X=ABS(P)+ABS(Q)+ABS(R)
             387     1                       IF (X.EQ.0.) GO TO 260
             388     1                       P=P/X
             389     1                       Q=Q/X
             390     1                       R=R/X
             391     1                 170   S=SIGN(SQRT(P*P+Q*Q+R*R),P)
             392     1                       IF (K.EQ.M) GO TO 180
             393     1                       H(K,K-1)=-S*X
             394     1                       GO TO 190
             395     1                 180   IF(L.NE.M) H(K,K-1)=-H(K,K-1)
             396     1                 190   P=P+S
             397     1                       X=P/S
             398     1                       Y=Q/S
             399     1                       ZZ=R/S
             400     1                       Q=Q/P
             401     1                       R=R/P
             402     1               ! ******************** ROW MODIFICATION ***************************
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
             403     2  pp   2v              DO 210 J=K,EN
             404     2   p   2v                P=H(K,J)+Q*H(K+1,J)
             405     2   p   2v                IF (.NOT.NOLATS) GO TO 200
             406     2   p   2v                P=P+R*H(K+2,J)
             407     2   p   2v                H(K+2,J)=H(K+2,J)-P*ZZ
             408     2   p   2v        200     H(K+1,J)=H(K+1,J)-P*Y
             409     2   p   2v                H(K,J)=H(K,J)-P*X
             410     2   p   2v        210   CONTINUE
             411     1               !
             412     1                       J=MIN0(EN,K+3)
             413     1               ! ******************** COLUMN MODIFICATION *************************
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 458
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

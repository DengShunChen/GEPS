 External subroutine subprogram "BALANC"
  (inc)(line-no.)(nest)(optimize)
              26                     !
              27                     !
              28                           SUBROUTINE BALANC(NM,N,A,LOW,IGH,SCALE)
              29                     !
              30                           INTEGER I,J,K,L,M,N,JJ,NM,IGH,LOW,IEXC
              31                           REAL A(NM,N),SCALE(N)
              32                           REAL C,F,G,R,S,B2,RADIX
              33                           REAL ABS
              34                           LOGICAL NOCONV
              35                     !
              36                     ! ***************** RADIX is a MACHINE DEPENDENT PARAMETER SPACIFYING
              37                     !                   THE BASE OF THE MACHINE FLOATING POINT REPRESENTATION
              38                     ! *************************************************************************
              39                     !
              40                           RADIX=2.
              41                     !
              42                           B2=RADIX*RADIX
              43                           K=1
              44                           L=N
              45                           GO TO 100
              46                     ! ***************IN-LINE PROCEDURE FOR ROW AND COLUMN EXCHANG *******
              47                        20 SCALE(M)=J
              48                           IF (J.EQ.M) GO TO 50
              49                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      A
                                   <<< Loop-information  End >>>
              50     1  pp   2v            DO 30 I=1,L
              51     1   p   2v            F=A(I,J)
              52     1   p   2v            A(I,J)=A(I,M)
              53     1   p   2v            A(I,M)=F
              54     1   p   2v         30 CONTINUE
              55                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 800
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
              56     1  pp   2v            DO 40 I=K,N
              57     1   p   2v            F=A(J,I)
              58     1   p   2v            A(J,I)=A(M,I)
              59     1   p   2v            A(M,I)=F
              60     1   p   2v         40 CONTINUE
              61                     !
              62                        50 GO TO (80,130), IEXC
              63                     ! *************** SEARCH FOR ROWS ISOLATING AN EIGENVALUE AND PUSH THEM DOWN
              64                        80 IF (L.EQ.1) GO TO 280
              65                           L=L-1
              66                     ! *************** FOR J+L STEP -1 UNTIL 1 do -- ********************
              67     1                 100 DO 120 JJ=1, L
              68     1                     J=L+1-JJ
              69     1               !
              70     2                     DO 110 I=1,L
              71     2                       IF (I.EQ.J) GO TO 110
              72     2                       IF (A(J,I).NE.0.) GO TO 120
              73     2                 110 CONTINUE
              74     1               !
              75     1                     M=L
              76     1                     IEXC=1
              77     1                     GO TO 20
              78     1                 120 CONTINUE
              79                           GO TO 140
              80                     ! *************** SEARCH FOR COLUMNS ISOLATING AN EIGENVALUE AND
              81                     !                 PUSH THEM LEFT **********************
              82                       130 K=K+1
              83                     !
              84     1                 140 DO 170 J=K,L
              85     1               !
              86     2                       DO 150 I=K,L
              87     2                         IF(I.EQ.J) GO TO 150
              88     2                         IF(A(I,J).NE.0.) GO TO 170
              89     2                 150   CONTINUE
              90     1               !
              91     1                       M=K
              92     1                       IEXC=2
              93     1                       GO TO 20
              94     1                 170 CONTINUE
              95                     ! ***************** NOW BALANCE THE SUBMATRIX IN ROWS K TO L *************
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      SCALE
                                   <<< Loop-information  End >>>
              96     1  pp   4v            DO 180 I=K,L
              97     1   p   4v        180 SCALE(I)=1.0
              98                     ! ***************** ITERATIVE LOOP FOR NORM REDUCTION **************
              99                       190 NOCONV=.FALSE.
             100                     !
             101     1                     DO 270 I=K,L
             102     1                       C=0.
             103     1                       R=0.
             104     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
             105     2  pp    v            DO 200 J=K,L
             106     2   p    v              IF (J.EQ.I) GO TO 200
             107     2   p    v              C=C+ABS(A(J,I))
             108     2   p    v              R=R+ABS(A(I,J))
             109     2   p    v        200 CONTINUE
             110     1               ! ***************** GUARD AGAINST ZERO C OR R DUE TO UNDERFLOW *********
             111     1                     IF (C.EQ.0.OR.R.EQ.0.) GO TO 270
             112     1                     G=R/RADIX
             113     1                     F=1.
             114     1                     S=C+R
             115     1                 210 IF(C.GE.G) GO TO 220
             116     1                     F=F*RADIX
             117     1                     C=C*B2
             118     1                     GO TO 210
             119     1                 220 G=R*RADIX
             120     1                 230 IF (C.LT.G) GO TO 240
             121     1                     F=F/RADIX
             122     1                     C=C/B2
             123     1                     GO TO 230
             124     1               ! *********************** NOW BALANCE *******************************
             125     1                 240 IF ((C+R)/F.GE.0.95*S) GO TO 270
             126     1                     G=1./F
             127     1                     SCALE(I)=SCALE(I)*F
             128     1                     NOCONV=.TRUE.
             129     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.18, ITR: 96, MVE: 2, POL: L)
                                   <<< Loop-information  End >>>
             130     2  pp   4v            do 250 J=K,N
             131     2   p   4v        250 A(I,J)=A(I,J)*G
             132     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      A
                                   <<< Loop-information  End >>>
             133     2  pp   2v            DO 260 J=1,L
             134     2   p   2v        260 A(J,I)=A(J,I)*F
             135     1               !
             136     1                 270 CONTINUE
             137                     !
             138                           IF(NOCONV) GO TO 190
             139                     !
             140                       280 LOW=K
             141                           IGH=L
             142                           RETURN
             143                           END


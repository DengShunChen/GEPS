                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             503     2   m   2v              do k = 1, lpout-1
             504     2   p   2v                lpl = int(plev(k)+0.001)
             505     2   s   2m                write( lrec(k), '(i3.3,a3)' ) lpl,'560'   ! ozone
             506     2   p   2v              end do
             507     1                       lrec(lpout) = 'h00560'
             508     1                       Ptp0=0 ;Ptp1=14 ;Ptp2=1 ;Ptp3=8 !grib code
             509     1               !
             510     1                     else if(ntrac.eq.ncld+1)then
             511     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             512     2   m   2v              do k = 1, lpout-1
             513     2   p   2v                lpl = int(plev(k)+0.001)
             514     2   s   2m                write( lrec(k), '(i3.3,a3)' ) lpl,'550'   ! combine all condensates together
             515     2   p   2v              end do
             516     1                       lrec(lpout) = 'h00550'
             517     1                       Ptp0=0 ;Ptp1=1 ;Ptp2=235 ;Ptp3=9 !grib code
             518     1                     else
             519     1                       goto 40
             520     1                     endif
             521                     !
             522                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,dpd,dpdb,pkout,dew,tens)
             523                     !
             524                           lenc= nx*my
             525                           ncnt= 0
             526                     !
             527     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             528     2                     do 10 k=1,lpout
             529     2               !
             530     3                     if(plev(k).eq.whtlev(n)) then

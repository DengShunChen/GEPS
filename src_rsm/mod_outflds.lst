                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             608     1                     do 20 n=1,ntau
             609     1                       read(taudir(n),'(a6,1x,i4)') labx,lev
             610     2                       if(lev.eq.0) then
             611     2                         num= num+1
             612     2                         label(num)= labx
             613     2                       endif
             614     1                  20 continue
             615                           if(num.eq.0) return
             616                     !

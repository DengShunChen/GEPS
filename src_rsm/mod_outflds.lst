             413                       subroutine shumout2(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             414                           , plev,num,whtlev,pkout,pk,pklp,dpd,dpdb,dew,glob,ggdef,ntrac,lwrite)
             415                     !
             416                           use index
             417                           use rank, only : myrank
             418                           use radn, only : ntoz
             419                           use param, only : ncld

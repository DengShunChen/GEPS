             645     4   p   2v                  tmp(i,jj) = pt(i,jj) + ptop
             646     4   p   2v                enddo
             647     3   p                   enddo
             648     2                       call unify_reduceintp(nx,my,my_max,tmp,glob)
             649     2               !byl        call mpe_unify(glob,nx,my,2,mpe_double)
             650     2                       call syslbl('b00010',idtg,itau,ggdef,lrec)

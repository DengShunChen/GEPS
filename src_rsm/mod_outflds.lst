             257     2               !byl          call unify_reduceintp(nx,my,my_max,phips(1,1,k),h500)
             258     2               !!          do i=1,lenc
             259     2               !!            h500(i,1)=phips(i,k)
             260     2               !!          enddo
             261     2               !          if(itau.le.72 .and. lreduce.eq.1)then
             262     2               !byl            call smth9(nx,my,h500,glob,1)
             263     2               !byl            h500=glob
             264     2               !byl            call smth9(nx,my,h500,glob,2)
             265     2               !byl            h500=glob
             266     2               !          endif
             267     2                       endif
             268     1                     enddo
             269                     !
             270     1                     do 20 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             271     2                     do 10 k=1,lpout
             272     2               !
             273     3                     if(plev(k).eq.whtlev(n)) then
             274     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phips, tmp
                                   <<< Loop-information  End >>>
             275     4  pp                 do 11 jj=1, jlistnum
             276     4   p                 j=jlist1(jj)
             277     4   p                 nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

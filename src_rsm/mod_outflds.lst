                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             493     2   m   2v            do k = 1, lpout-1
             494     2   p   2v             lpl = int(plev(k)+0.001)
             495     2   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,cspec(ntrac)
             496     2   p   2v            end do
             497     1                     write( lrec(lpout), '(a3,a3)' ) 'h00',cspec(ntrac)
             498     1                     Ptp0=cspe0(ntrac) ;Ptp1=cspe1(ntrac)
             499     1                     Ptp2=cspe2(ntrac) ;Ptp3=cspe3(ntrac)
             500     1               !
             501     1                     else if(ntrac.eq.ntoz)then
             502     1               !
                                   <<< Loop-information Start >>>

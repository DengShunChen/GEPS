             266     3                     if(plev(k).eq.whtlev(n)) then
             267     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phips, tmp
                                   <<< Loop-information  End >>>
             268     4  pp                 do 11 jj=1, jlistnum
             269     4   p                 j=jlist1(jj)
             270     4   p                 nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phips, tmp
                                   <<< Loop-information  End >>>
             271     5   p   2v            do 11 i=1,nxj
             272     5   p   2v             tmp(i,jj)= phips(i,jj,k)+phistd(k)
             273     4   p   2v         11 continue
             274     3                     call unify_reduceintp(nx,my,my_max,tmp,glob)
             275     3               !
             276     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             277     3               !
             278     3               !      if(lreduce.eq.1 .and. itau.le.72)then
             279     3                       call smth9(nx,my,glob,slp,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, glob
                                   <<< Loop-information  End >>>
             280     3  pp   4v              glob=slp
             281     3                       call smth9(nx,my,glob,slp,2)
             282     3               !        glob=slp
             283     3               !      endif
             284     3               !
             285     3               !      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,slp,istat)
             286     4                     if(outgrb2==1.and.myrank==0)then
             287     4                       call wrt_grb2(itau,0,3,5,0,100,-2,plev(k),slp)
             288     4                     endif
             289     3                     call qmaxn3(slp,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             290     3                     call split(nx,my,lenc,ifilout,ncnt,slp,pout,ihdg,ihdg2)
             291     3               !
             292     3                     go to 20
             293     3                     endif
             294     2                  10 continue
             295     1                  20 continue
             296                     
             297     1                     if(outdms.gt.0)then
             298     1                     if(lwrite .and. myrank .lt. ncnt ) &
             299     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             300     1                     endif
             301                     !
             302                           return
             303                       end subroutine geopout

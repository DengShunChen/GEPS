             401                       subroutine shumout2(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             402                           , plev,num,whtlev,pkout,pk,pklp,dpd,dpdb,dew,glob,ggdef,ntrac,lwrite)
             403                     !
             404                           use index
             405                           use rank, only : myrank
             406                           use radn, only : ntoz
             407                           use param, only : ncld
             408                           use mod_grb2_param
             409                           use const ,only:outdms,outgrb2 , RTYPE,kflag,qmin,nmmiph
             410                     
             411                           implicit  none
             412                     
             413                           integer   nx,my,my_max,lpout,lev,itau,num,ntrac,ncnt,ntrchk
             414                     
             415                           real      pkout(lpout),pklp(nxp,my_max)                        &
             416                           , pk(nxp,lev,my_max),dpd(nxp,lev,my_max),dpdb(nxp,my_max)      &
             417                           , plev(lpout),whtlev(num),tens(lev+1)
             418                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)       &
             419                           , dew(nxp,my_max,lpout),ffx(nx,my_max)
             420                     !
             421                     
             422                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             423                     
             424                           integer*8 idtg
             425                           character*80 ifilout
             426                           character*26 ihdg,ihdg2
             427                           character*6 lrec(lpout)
             428                           character*4 ggdef
             429                     !      character*3 cspec(8)
             430                           character*3,dimension(:),allocatable :: cspec
             431                           logical :: lwrite
             432                           integer::Ptp0,Ptp1,Ptp2,Ptp3
             433                     !      integer,dimension(6)::cspe0,cspe1,cspe2,cspe3
             434                           integer,dimension(:),allocatable ::cspe0,cspe1,cspe2,cspe3
             435                     !
             436                     !key=556 for mixing ratio of hail
             437                     !key=571~575 for number concentration of cloud droplet, ice, rain, snow, and graupel
             438                     !key=572 : inc (ntinc=7)
             439                     !key=573 : rnc (ntrnc=8)
             440     1                     if ( nmmiph .eq. 18 ) then
             441     1                       allocate ( cspec(8),cspe0(8),cspe1(8),cspe2(8),cspe3(8) )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             442     1       f               cspec=(/'500','551','553','552','554','555','572','573'/)
             443     1       f               cspe0=(/  0  ,  0  ,  0  ,  0  ,  0  ,  0  ,  0  ,  0  /)
             444     1       f               cspe1=(/  1  ,  1  ,  1  ,  1  ,  1  ,  1  ,  1  ,  1  /)
             445     1       f               cspe2=(/  0  , 22  , 24  , 82  , 25  , 32  , 207 , 104 /)  !not sure of inc
             446     1       f               cspe3=(/  6  ,  8  ,  8  ,  8  ,  8  ,  8  ,  8  ,  8  /)
             447     1                     elseif ( nmmiph .eq. 16 ) then
             448     1                       allocate ( cspec(7),cspe0(7),cspe1(7),cspe2(7),cspe3(7) )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             449     1       f               cspec=(/'500','551','553','552','554','555','556'/)
             450     1       f               cspe0=(/  0  ,  0  ,  0  ,  0  ,  0  ,  0  ,  0  /)
             451     1       f               cspe1=(/  1  ,  1  ,  1  ,  1  ,  1  ,  1  ,  1  /)
             452     1       f               cspe2=(/  0  , 22  , 24  , 82  , 25  , 32  , 71  /)
             453     1       f               cspe3=(/  6  ,  8  ,  8  ,  8  ,  8  ,  8  ,  8  /)
             454     1                     else
             455     1                       allocate ( cspec(6),cspe0(6),cspe1(6),cspe2(6),cspe3(6) )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             456     1       f               cspec=(/'500','551','553','552','554','555'/)
             457     1       f               cspe0=(/  0  ,  0  ,  0  ,  0  ,  0  ,  0  /)
             458     1       f               cspe1=(/  1  ,  1  ,  1  ,  1  ,  1  ,  1  /)
             459     1       f               cspe2=(/  0  , 22  , 24  , 82  , 25  , 32  /)
             460     1       f               cspe3=(/  6  ,  8  ,  8  ,  8  ,  8  ,  8  /)
             461     1                     endif
             462                     !
             463     1                     if ( ntoz .gt. 0 ) then
             464     1                       ntrchk = ntoz - 1
             465     1                     else
             466     1                       ntrchk = ncld
             467     1                     endif
             468                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             469     1  pp   4v            do k = 1, lev+1
             470     1   p   4v             tens(k) = 1.0
             471     1   p   4v            end do
             472                           tens(lev)= 0.0
             473                           tens(lev+1)= 0.0
             474                     !
             475     1                     if(ntrac.le.ntrchk)then ! all hydrometeors
             476     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             477     2   m   2v            do k = 1, lpout-1
             478     2   p   2v             lpl = int(plev(k)+0.001)
             479     2   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,cspec(ntrac)
             480     2   p   2v            end do
             481     1                     write( lrec(lpout), '(a3,a3)' ) 'h00',cspec(ntrac)
             482     1                     Ptp0=cspe0(ntrac) ;Ptp1=cspe1(ntrac)
             483     1                     Ptp2=cspe2(ntrac) ;Ptp3=cspe3(ntrac)
             484     1               !
             485     1                     else if(ntrac.eq.ntoz)then
             486     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             487     2   m   2v              do k = 1, lpout-1
             488     2   p   2v                lpl = int(plev(k)+0.001)
             489     2   s   2m                write( lrec(k), '(i3.3,a3)' ) lpl,'560'   ! ozone
             490     2   p   2v              end do
             491     1                       lrec(lpout) = 'h00560'
             492     1                       Ptp0=0 ;Ptp1=14 ;Ptp2=1 ;Ptp3=8 !grib code
             493     1               !
             494     1                     else if(ntrac.eq.ncld+1)then
             495     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             496     2   m   2v              do k = 1, lpout-1
             497     2   p   2v                lpl = int(plev(k)+0.001)
             498     2   s   2m                write( lrec(k), '(i3.3,a3)' ) lpl,'550'   ! combine all condensates together
             499     2   p   2v              end do
             500     1                       lrec(lpout) = 'h00550'
             501     1                       Ptp0=0 ;Ptp1=1 ;Ptp2=235 ;Ptp3=9 !grib code
             502     1                     else
             503     1                       goto 40
             504     1                     endif
             505                     !
             506                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,dpd,dpdb,pkout,dew,tens)
             507                     !
             508                           lenc= nx*my
             509                           ncnt= 0
             510                     !
             511     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             512     2                     do 10 k=1,lpout
             513     2               !
             514     3                     if(plev(k).eq.whtlev(n)) then
             515     3               !
             516     3               !
             517     3               ! relative humidity must be smaller or equal 1.0
             518     3               !
             519     3               !      do 20 jj=1, jlistnum
             520     3               !      j=jlist1(jj)
             521     3               !      nxj=nxdef_2d(j)
             522     3               !      do 20 i=1,nxj
             523     3               !       tmp(i,jj)= max(dew(i,jj,k),0.0)
             524     3               !   20 continue
             525     3                     call mpe2d_unify_nx(ffx,dew(1,1,k))
             526     4                     if( lreduce.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             527     5                       do jj =1, jlistnum
             528     5                         j=jlist1(jj)
             529     5                         call reduceintp(ffx(1,jj),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 208, MVE: 7, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             530     6  pp   2v                do i=1,nx
             531     6   p   2v                   ffx(i,jj)=max(ffx(i,jj),qmin)
             532     6   p   2v                enddo
             533     5                       enddo
             534     4                     endif
             535     3                     call mpe2d_unify_my(glob,ffx)
             536     4                     if(outgrb2==1.and.myrank==0)then
             537     4                         call wrt_grb2(itau,Ptp0,Ptp1,Ptp2,Ptp3,100,-2,plev(k),glob)   !Specit Humility
             538     4                     endif
             539     3               !      do 20 i=1,lenc
             540     3               !        glob(i,1)= max(glob(i,1),0.0)
             541     3               !   20 continue
             542     3               !
             543     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             544     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             545     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             546     3                     call split(nx,my,lenc,ifilout,ncnt,glob,pout,ihdg,ihdg2)
             547     3                     go to 30
             548     3                     endif
             549     2                  10 continue
             550     1                  30 continue
             551     1                     if(outdms.gt.0)then
             552     1                     if(lwrite .and. myrank .lt. ncnt ) &
             553     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             554     1                     endif
             555                     !
             556                        40 continue
             557                     
             558                           return
             559                       end subroutine shumout2

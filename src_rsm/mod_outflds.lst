             305                       subroutine shumout(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             306                           , plev,num,whtlev,pkout,pk,pklp,dpd,dpdb,dew,glob,ggdef,lwrite)
             307                     !
             308                           use index
             309                           use rank, only : myrank
             310                           use mod_grb2_param
             311                           use const ,only:outdms,outgrb2 ,RTYPE,kflag
             312                     
             313                           implicit  none
             314                           integer   nx,my,my_max,lpout,lev,itau,num,ncnt
             315                     
             316                           real      pkout(lpout),pklp(nxp,my_max)                            &
             317                           , pk(nxp,lev,my_max),dpd(nxp,lev,my_max),dpdb(nxp,my_max)          &
             318                           , plev(lpout),whtlev(num),tens(lev+1)
             319                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)           &
             320                           ,                dew(nxp,my_max,lpout),ffx(nx,my_max)
             321                     
             322                     
             323                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             324                     !
             325                           integer*8 idtg
             326                           character*80 ifilout
             327                           character*26 ihdg,ihdg2
             328                           character*6 lrec(lpout)
             329                           character*4 ggdef
             330                     !
             331                           logical :: lwrite
             332                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             333     1  pp   4v            do k = 1, lev+1
             334     1   p   4v             tens(k) = 1.0
             335     1   p   4v            end do
             336                           tens(lev)= 0.0
             337                           tens(lev+1)= 0.0
             338                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             339     1   m   2v            do k = 1, lpout-1
             340     1   p   2v             lpl = int(plev(k)+0.001)
             341     1   m   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'510'
             342     1   p   2v            end do
             343                           lrec(lpout) = 'h00510'
             344                     !
             345                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,dpd,dpdb,pkout,dew,tens)
             346                     !
             347                           lenc= nx*my
             348                           ncnt= 0
             349                     !
             350     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             351     2                     do 10 k=1,lpout
             352     2               !
             353     3                     if(plev(k).eq.whtlev(n)) then
             354     3               !
             355     3               ! relative humidity must be smaller or equal 1.0
             356     3               !
             357     3               !!      do 20 jj=1, jlistnum
             358     3               !!      j=jlist1(jj)
             359     3               !!      nxj=nxdef_2d(j)
             360     3               !!      do 20 i=1,nxj
             361     3               !!       tmp(i,jj)= min(100.,max(dew(i,jj,k)*100.,0.0))
             362     3               !!   20 continue
             363     3                     call mpe2d_unify_nx(ffx,dew(1,1,k))
             364     4                     if( lreduce.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             365     5                       do jj =1, jlistnum
             366     5                         j=jlist1(jj)
             367     5                         call reduceintp(ffx(1,jj),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 534
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 304, MVE: 10, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             368     6  pp   2v                do i=1,nx
             369     6   p   2v                   ffx(i,jj)=min(100.,max(ffx(i,jj)*100.,0.0))
             370     6   p   2v                enddo
             371     5                       enddo
             372     4                     endif
             373     3                     call mpe2d_unify_my(glob,ffx)
             374     3               !      call unify_reduceintp(nx,my,my_max,dew(1,1,k),glob)
             375     3               !      do 20 i=1,lenc
             376     3               !      glob(i,1)= min(100.,max(glob(i,1)*100.,0.0))
             377     3               !   20 continue
             378     3               !
             379     4                     if(outgrb2==1.and.myrank==0)then
             380     4                       call wrt_grb2(itau,0,1,1,2,100,-2,plev(k),glob)
             381     4                     endif
             382     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             383     3               !
             384     3               !  reduceintp has been done in voterp (2011/5)
             385     3               !
             386     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             387     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             388     3                     call split(nx,my,lenc,ifilout,ncnt,glob,pout,ihdg,ihdg2)
             389     3                     go to 30
             390     3                     endif
             391     2                  10 continue
             392     1                  30 continue
             393     1                     if(outdms.gt.0)then
             394     1                     if(lwrite .and. myrank .lt. ncnt ) &
             395     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             396     1                     endif
             397                     !
             398                           return
             399                       end subroutine shumout

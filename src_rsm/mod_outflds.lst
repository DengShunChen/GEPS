             459     1       f               cspe2=(/  0  , 22  , 24  , 82  , 25  , 32  , 207 , 104 /)  !not sure of inc
             460     1       f               cspe3=(/  6  ,  8  ,  8  ,  8  ,  8  ,  8  ,  8  ,  8  /)
             461     1                     elseif ( nmmiph .eq. 16 ) then
             462     1                       IF (.NOT. ALLOCATED( cspec )) &
             463     1                       allocate ( cspec(7),cspe0(7),cspe1(7),cspe2(7),cspe3(7) )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             464     1       f               cspec=(/'500','551','553','552','554','555','556'/)
             465     1       f               cspe0=(/  0  ,  0  ,  0  ,  0  ,  0  ,  0  ,  0  /)
             466     1       f               cspe1=(/  1  ,  1  ,  1  ,  1  ,  1  ,  1  ,  1  /)
             467     1       f               cspe2=(/  0  , 22  , 24  , 82  , 25  , 32  , 71  /)
             468     1       f               cspe3=(/  6  ,  8  ,  8  ,  8  ,  8  ,  8  ,  8  /)
             469     1                     else
             470     1                       IF (.NOT. ALLOCATED( cspec )) &
             471     1                       allocate ( cspec(6),cspe0(6),cspe1(6),cspe2(6),cspe3(6) )
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             472     1       f               cspec=(/'500','551','553','552','554','555'/)
             473     1       f               cspe0=(/  0  ,  0  ,  0  ,  0  ,  0  ,  0  /)
             474     1       f               cspe1=(/  1  ,  1  ,  1  ,  1  ,  1  ,  1  /)
             475     1       f               cspe2=(/  0  , 22  , 24  , 82  , 25  , 32  /)
             476     1       f               cspe3=(/  6  ,  8  ,  8  ,  8  ,  8  ,  8  /)
             477     1                     endif

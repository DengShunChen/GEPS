                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      phips, tmp
                                   <<< Loop-information  End >>>
             278     5   p   2v            do 11 i=1,nxj
             279     5   p   2v             tmp(i,jj)= phips(i,jj,k)+phistd(k)
             280     4   p   2v         11 continue
             281     3                     call unify_reduceintp(nx,my,my_max,tmp,glob)
             282     3               !
             283     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             284     3               !
             285     3               !      if(lreduce.eq.1 .and. itau.le.72)then
             286     3                       call smth9(nx,my,glob,slp,1)
                                   <<< Loop-information Start >>>

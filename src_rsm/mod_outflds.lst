             624     1               
             625     2                     if(label(kk).eq.'SSL010' .or. label(kk).eq.'ssl010') then
             626     2                       call unify_reduceintp(nx,my,my_max,slp,glob)
             627     2                       call syslbl('ssl010',idtg,itau,ggdef,lrec)

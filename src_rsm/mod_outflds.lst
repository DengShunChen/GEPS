             592     2   p   2v              do i=1,nxj
             593     2               !byl          slp(i,j)= pt(i,jj)+pdiff(i,jj)
             594     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             595     2   p   2v                ptend(i,jj)= ptend(i,jj)*3600.0
             596     2   p   2v              enddo
             597     1   p                 enddo

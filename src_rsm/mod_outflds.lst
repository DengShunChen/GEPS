             562                       subroutine surfout(nx,my,my_max,ifilout,itau,idtg,taudir,ntau,pdiff  &
             563                            ,pt,ptop,slp,ptend,glob,ggdef,lwrite)
             564                     !
             565                           use index
             566                           use mpe
             567                           use rank
             568                           use mod_grb2_param
             569                           use const ,only:outdms,outgrb2 ,RTYPE,kflag
             570                     !
             571                           implicit  none
             572                           integer   nx,my,my_max,i,j,jj,kk,n,lev,nxj,itau,ntau,num,lenc,istat
             573                     
             574                           real      pdiff(nxp,my_max)
             575                           real(kind=RTYPE) ptend(nxp,my_max),pt(nxp,my_max),glob(nx,my),   &
             576                                            slp(nxp,my_max),tmp(nxp,my_max)
             577                           character*16 taudir(ntau)
             578                           character*4 ggdef
             579                     !
             580                           real      ptop,tnshun
             581                     !
             582                           integer*8 idtg
             583                           character*80 ifilout
             584                           character*26 lrec
             585                           character*6 label(ntau),labx
             586                     
             587                           logical :: lwrite
             588                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptend, pt, pdiff, slp
                                   <<< Loop-information  End >>>
             589     1  pp                 do jj = 1, jlistnum
             590     1   p                   j=jlist1(jj)
             591     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

             314                       subroutine shumout(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             315                           , plev,num,whtlev,pkout,pk,pklp,dpd,dpdb,dew,glob,ggdef,lwrite)
             316                     !
             317                           use index
             318                           use rank, only : myrank
             319                           use mod_grb2_param
             320                           use const ,only:outdms,outgrb2 ,RTYPE,kflag
             321                     
             322                           implicit  none
             323                           integer   nx,my,my_max,lpout,lev,itau,num,ncnt
             324                     
             325                           real      pkout(lpout),pklp(nxp,my_max)                            &
             326                           , pk(nxp,lev,my_max),dpd(nxp,lev,my_max),dpdb(nxp,my_max)          &
             327                           , plev(lpout),whtlev(num),tens(lev+1)
             328                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)           &
             329                           ,                dew(nxp,my_max,lpout),ffx(nx,my_max)
             330                     
             331                     
             332                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             333                           integer:: ptp0(9),ptp1(9)
             334                     !
             335                           integer*8 idtg
             336                           character*80 ifilout
             337                           character*26 ihdg,ihdg2
             338                           character*6 lrec(lpout)
             339                           character*4 ggdef
             340                     !
             341                           logical :: lwrite
             342                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             343     1  pp   4v            do k = 1, lev+1
             344     1   p   4v             tens(k) = 1.0
             345     1   p   4v            end do
             346                           tens(lev)= 0.0
             347                           tens(lev+1)= 0.0
             348                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             349     1   m   2v            do k = 1, lpout-1
             350     1   p   2v             lpl = int(plev(k)+0.001)
             351     1   m   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'510'
             352     1   p   2v            end do
             353                           lrec(lpout) = 'h00510'
             354                     !
             355                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,dpd,dpdb,pkout,dew,tens)
             356                     !
             357                           lenc= nx*my
             358                           ncnt= 0
             359                     !
             360     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             361     2                     do 10 k=1,lpout
             362     2               !
             363     3                     if(plev(k).eq.whtlev(n)) then
             364     3               !
             365     3               ! relative humidity must be smaller or equal 1.0
             366     3               !
             367     3               !!      do 20 jj=1, jlistnum
             368     3               !!      j=jlist1(jj)
             369     3               !!      nxj=nxdef_2d(j)
             370     3               !!      do 20 i=1,nxj
             371     3               !!       tmp(i,jj)= min(100.,max(dew(i,jj,k)*100.,0.0))
             372     3               !!   20 continue
             373     3                     call mpe2d_unify_nx(ffx,dew(1,1,k))
             374     4                     if( lreduce.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             375     5                       do jj =1, jlistnum
             376     5                         j=jlist1(jj)
             377     5                         call reduceintp(ffx(1,jj),nxdef(j),nx,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 445
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.83, ITR: 288, MVE: 10, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ffx
                                   <<< Loop-information  End >>>
             378     6  pp   2v                do i=1,nx
             379     6   p   2v                   ffx(i,jj)=min(100.,max(ffx(i,jj)*100.,0.0))
             380     6   p   2v                enddo
             381     5                       enddo
             382     4                     endif
             383     3                     call mpe2d_unify_my(glob,ffx)
             384     3               !      call unify_reduceintp(nx,my,my_max,dew(1,1,k),glob)
             385     3               !      do 20 i=1,lenc
             386     3               !      glob(i,1)= min(100.,max(glob(i,1)*100.,0.0))
             387     3               !   20 continue
             388     3               !
             389     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             390     3               !
             391     3               !  reduceintp has been done in voterp (2011/5)
             392     3               !
             393     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             394     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             395     3                     ptp0(7)=nint(plev(k))
             396     3                     call split2(nx,my,lenc,ifilout,ncnt,glob,pout,ihdg,ihdg2,ptp0,ptp1)
             397     3                     go to 30
             398     3                     endif
             399     2                  10 continue
             400     1                  30 continue
             401     1                     if(outdms.gt.0)then
             402     1                     if(lwrite .and. myrank .lt. ncnt ) &
             403     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             404     1                     endif
             405     1                     if(outgrb2 == 1 )then
             406     1                     if(lwrite .and. myrank .lt. ncnt ) &
             407     1                       call wrt_grb2_v2(itau,0,1,1,2,100,-2,ptp1(7),pout,ihdg2)
             408     1                     endif
             409                     !
             410                           return
             411                       end subroutine shumout

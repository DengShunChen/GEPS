             558     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             559     3                     gtp0(7)=nint(plev(k))
             560     3                     call split2(nx,my,lenc,ifilout,ncnt,glob,pout,ihdg,ihdg2,gtp0,gtp1)
             561     3                     go to 30
             562     3                     endif
             563     2                  10 continue
             564     1                  30 continue
             565     1                     if(outdms.gt.0)then
             566     1                     if(lwrite .and. myrank .lt. ncnt ) &
             567     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             568     1                     endif
             569     1                     if(outgrb2 == 1 )then
             570     1                     if(lwrite .and. myrank .lt. ncnt ) &
             571     1                       call wrt_grb2_v2(itau,Ptp0,Ptp1,Ptp2,Ptp3,100,-2,gtp1(7),pout,ihdg2)
             572     1                     endif
             573                     !
             574                        40 continue
             575                           deallocate ( cspec,cspe0,cspe1,cspe2,cspe3 )
             576                           return
             577                       end subroutine shumout2
             578                     
             579                     ! cloud fraction output
             580                       subroutine cloudout(nx,my,my_max,lpout,lev,itau,ifilout,idtg   &
             581                           , plev,num,whtlev,pkout,pk,pklp,clds,cldb,cldfc,glob,ggdef,lwrite)
             582                     !
             583                           use index
             584                           use rank, only : myrank
             585                           use param, only : ncld
             586                           use mod_grb2_param
             587                           use const ,only:outdms,outgrb2 , RTYPE,kflag
             588                     
             589                           implicit  none
             590                     
             591                           integer   nx,my,my_max,lpout,lev,itau,num,ntrac,ncnt,ntrchk
             592                     
             593                           real      pkout(lpout),pklp(nxp,my_max)                        &
             594                           , pk(nxp,lev,my_max),clds(nxp,lev,my_max),cldb(nxp,my_max)      &
             595                           , plev(lpout),whtlev(num),tens(lev+1)
             596                           real(kind=RTYPE) pout(nx,my),glob(nx,my),tmp(nxp,my_max)       &
             597                           , cldfc(nxp,my_max,lpout),ffx(nx,my_max)
             598                     !
             599                           integer   i,k,lpl,n,lenc,istat,jj,j,nxj
             600                     
             601                           integer*8 idtg
             602                           character*80 ifilout
             603                           character*26 ihdg,ihdg2
             604                           character*6 lrec(lpout)
             605                           character*4 ggdef
             606                           logical :: lwrite
             607                           integer:: ptp0(9),ptp1(9)
             608                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             609     1  pp   4v            do k = 1, lev+1
             610     1   p   4v             tens(k) = 1.0
             611     1   p   4v            end do
             612                           tens(lev)= 0.0
             613                           tens(lev+1)= 0.0
             614                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             615     1   m   2v            do k = 1, lpout-1
             616     1   p   2v             lpl = int(plev(k)+0.001)
             617     1   m   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'770'
             618     1   p   2v            end do
             619                           lrec(lpout) = 'h00770'
             620                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,clds,cldb,pkout,cldfc,tens)
             621                     !
             622                           lenc= nx*my
             623                           ncnt= 0
             624                     !
             625                           !for debug
             626                           !num=12
             627                           !whtlev(1:12)=(/100.,150.,200.,250.,300.,400.,500.,600.,700.,850.,925.,1000./)
             628     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             629     2                     do 10 k=1,lpout
             630     2               !
             631     3                     if(plev(k).eq.whtlev(n)) then
             632     3               !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfc, tmp
                                   <<< Loop-information  End >>>
             633     4  pp                 do 11 jj=1, jlistnum
             634     4   p                 j=jlist1(jj)
             635     4   p                 nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 288, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      cldfc, tmp
                                   <<< Loop-information  End >>>
             636     5   p   2v            do 11 i=1,nxj
             637     5   p   2v             tmp(i,jj)= cldfc(i,jj,k)
             638     4   p   2v         11 continue
             639     3                     call unify_reduceintp(nx,my,my_max,tmp,glob)
             640     3               !
             641     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             642     3                     call qmaxn3(glob,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             643     3                     ptp0(7)=nint(plev(k))
             644     3                     call split2(nx,my,lenc,ifilout,ncnt,glob,pout,ihdg,ihdg2,ptp0,ptp1)
             645     3                     go to 30
             646     3                     endif
             647     2                  10 continue
             648     1                  30 continue
             649     1                     if(outdms.gt.0)then
             650     1                     if(lwrite .and. myrank .lt. ncnt ) &
             651     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             652     1                     endif
             653     1                     if(outgrb2 == 1 )then
             654     1                     if(lwrite .and. myrank .lt. ncnt ) &
             655     1                       call wrt_grb2_v2(itau,0,6,32,3,100,-2,ptp1(7),pout,ihdg2)
             656     1                     endif
             657                     !
             658                        40 continue
             659                     
             660                           return
             661                       end subroutine cloudout
             662                     
             663                     
             664                       subroutine surfout(nx,my,my_max,ifilout,itau,idtg,taudir,ntau,pdiff  &
             665                            ,pt,ptop,slp,ptend,glob,ggdef,lwrite)
             666                     !
             667                           use index
             668                           use mpe
             669                           use rank
             670                           use mod_grb2_param
             671                           use const ,only:outdms,outgrb2 ,RTYPE,kflag ,domfc
             672                     !
             673                           implicit  none
             674                           integer   nx,my,my_max,i,j,jj,kk,n,lev,nxj,itau,ntau,num,lenc,istat
             675                     
             676                           real      pdiff(nxp,my_max)
             677                           real(kind=RTYPE) ptend(nxp,my_max),pt(nxp,my_max),glob(nx,my),   &
             678                                            slp(nxp,my_max),tmp(nxp,my_max)
             679                           character*16 taudir(ntau)
             680                           character*4 ggdef
             681                     !
             682                           real      ptop,tnshun
             683                     !
             684                           integer*8 idtg
             685                           character*80 ifilout
             686                           character*26 lrec
             687                           character*6 label(ntau),labx
             688                     
             689                           logical :: lwrite
             690                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, pdiff, ptend, slp
                                   <<< Loop-information  End >>>
             691     1  pp                 do jj = 1, jlistnum
             692     1   p                   j=jlist1(jj)
             693     1   p                   nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.57, ITR: 208, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ptend, pdiff, slp, pt
                                   <<< Loop-information  End >>>
             694     2   p   2v              do i=1,nxj
             695     2               !byl          slp(i,j)= pt(i,jj)+pdiff(i,jj)
             696     2   p   2v                slp(i,jj)= pt(i,jj)+pdiff(i,jj)
             697     2   p   2v                ptend(i,jj)= ptend(i,jj)*3600.0
             698     2   p   2v              enddo
             699     1   p                 enddo
             700                     !
             701                     !byl      call unify_reduceintp(nx,my,my_max,tmp,slp)
             702                     !byl      call mpe_unify(slp,nx,my,2,mpe_double)
             703                     !byl      if( lreduce.eq.1 ) call reduceintp (slp,nxdef,nx,my)
             704                     !byl      call smth9(nx,my,slp,glob,1)
             705                     !byl      slp=glob
             706                     !byl      call smth9(nx,my,slp,glob,2)
             707                     !byl      slp=glob
             708                     !
             709                           num= 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 4
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             710     1                     do 20 n=1,ntau
             711     1                       read(taudir(n),'(a6,1x,i4)') labx,lev
             712     2                       if(lev.eq.0) then
             713     2                         num= num+1
             714     2                         label(num)= labx
             715     2                       endif
             716     1                  20 continue
             717                           if(num.eq.0) return
             718                     !
             719                           tnshun= 1.0
             720                           lenc= nx*my
             721                     !
             722     1                     do 100 kk=1,num
             723     1               !
             724     1               !  sea surface level pressure
             725     1               !
             726     1               
             727     2                     if(label(kk).eq.'SSL010' .or. label(kk).eq.'ssl010') then
             728     2                       call unify_reduceintp(nx,my,my_max,slp,glob)
             729     2                       call syslbl('ssl010',idtg,itau,ggdef,lrec)
             730     3                       if( itau==0 .or. itau .gt. nint(domfc) )then
             731     4                       if(outdms.gt.0)then
             732     4                         if(lwrite) call dmswrit(nx,my,lrec,lenc,kflag,ifilout,glob,istat)
             733     4                       endif
             734     4                       if(outgrb2==1.and.myrank==0)then
             735     4                         call wrt_grb2_v2(itau,0,3,1,2,101,0,0,glob,lrec)
             736     4                       endif
             737     3                       call qmaxn3(glob,lrec(1:14),lrec(15:26),1,1,1,nx,my,1)
             738     3                       endif !itau .gt. domfc
             739     2               !
             740     2               !  terrain pressure
             741     2               !
             742     2                     else if(label(kk).eq.'B00010' .or. label(kk).eq.'b00010') then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 3
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, tmp
                                   <<< Loop-information  End >>>
             743     3  pp                   do jj = 1, jlistnum
             744     3   p                     j=jlist1(jj)
             745     3   p                     nxj=nxdef_2d(j)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pt, tmp
                                   <<< Loop-information  End >>>
             746     4   p   2v                do i=1,nxj
             747     4               !byl            glob(i,j) = pt(i,jj) + ptop
             748     4   p   2v                  tmp(i,jj) = pt(i,jj) + ptop
             749     4   p   2v                enddo
             750     3   p                   enddo
             751     2                       call unify_reduceintp(nx,my,my_max,tmp,glob)
             752     2               !     if(myrank.eq.0) then
             753     2               !       open(30,file='sfc_pres.bin',status='unknown', &
             754     2               !           form='unformatted',access='direct',recl=262656)
             755     2               !       write(30,rec=1) ((glob(i,j),i=432,647),j=410,561)
             756     2               !       close(30)
             757     2               !     endif
             758     2               !byl        call mpe_unify(glob,nx,my,2,mpe_double)
             759     2                       call syslbl('b00010',idtg,itau,ggdef,lrec)
             760     2               !byl        if( lreduce.eq.1 ) call reduceintp (glob,nxdef,nx,my)
             761     2                       if(lwrite) call dmswrit(nx,my,lrec,lenc,kflag,ifilout,glob,istat)
             762     3                       if(outgrb2==1.and.myrank==0)then
             763     3                         call wrt_grb2_v2(itau,0,3,0,2,103,0,0,glob,lrec)
             764     3                       endif
             765     2                       call qmaxn3(glob,lrec(1:14),lrec(15:26),1,1,1,nx,my,1)
             766     2               
             767     2               !
             768     2               !  terrain pressure tendency
             769     2               !
             770     2               !      else if(label(kk).eq.'B00011' .or. label(kk).eq.'b00011') then
             771     2               !        do i = 1, lenc
             772     2               !          glob(i,1) = ptend(i,1)
             773     2               !        end do
             774     2               !        call syslbl('b00011',idtg,itau,ggdef,lrec)
             775     2               !        if( lreduce.eq.1 ) call reduceintp (glob,nxdef,nx,my)
             776     2               !        if(lwrite) call dmswrit(nx,my,lrec,lenc,kflag,ifilout,glob,istat)
             777     2               !        call qmaxn3(glob,lrec(1:14),lrec(15:26),1,1,1,nx,my,1)
             778     2               !
             779     2                     endif
             780     1               !
             781     1                 100 continue
             782                           return
             783                       end subroutine surfout
             784                     
             785                       subroutine tempout(nx,my,my_max,lpout,lev,itau,ifilout,idtg  &
             786                           , plev,num,whtlev,pkout,pk,pklp,tt,ttbot,temp,ggdef,lwrite)
             787                     !
             788                           use index
             789                           use rank,   only : myrank
             790                           use mod_grb2_param
             791                           use const ,only:outdms,outgrb2 ,RTYPE,kflag
             792                     
             793                           implicit  none
             794                     
             795                           integer   nx,my,my_max,lpout,lev,itau,k,i,n,istat
             796                           integer   num,lpl,lenc,ncnt
             797                           integer:: ptp0(9),ptp1(9)
             798                           real      tnshun
             799                     
             800                           real      pkout(lpout),pklp(nxp,my_max),pk(nxp,lev,my_max)        &
             801                           , tt(nxp,lev,my_max),ttbot(nxp,my_max),plev(lpout),whtlev(num)
             802                           real      tens(lev+1)
             803                           real(kind=RTYPE) pout(nx,my),glob(nx,my),slp(nx,my),temp(nxp,my_max,lpout)
             804                     
             805                     !
             806                           integer*8 idtg
             807                           character*80 ifilout
             808                           character*26 ihdg
             809                           character*26 ihdg2
             810                           character*6 lrec(lpout)
             811                           character*4 ggdef
             812                     !
             813                          logical :: lwrite
             814                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             815     1  pp   4v            do k = 1, lev+1
             816     1   p   4v             tens(k) = 1.0
             817     1   p   4v            end do
             818                           tens(lev+1)= 0.0
             819                           tens(lev)= 0.0
             820                     !
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 762
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 3
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             821     1   m   2v            do k = 1, lpout-1
             822     1   p   2v             lpl = int(plev(k)+0.001)
             823     1   s   2m             write( lrec(k), '(i3.3,a3)' ) lpl,'100'
             824     1   p   2v            end do
             825                           lrec(lpout) = 'h00100'
             826                     !
             827                           call voterp(nx,my,my_max,lev,lpout,pk,pklp,tt,ttbot,pkout,temp,tens)
             828                     !
             829                           lenc= nx*my
             830                     !
             831                           tnshun= 1.0
             832                     !
             833                           ncnt=0
             834                     !
             835     1                     do 30 n=1,num
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      plev
                                   <<< Loop-information  End >>>
             836     2                     do 10 k=1,lpout
             837     2               !
             838     3                     if(plev(k).eq.whtlev(n)) then
             839     3               !
             840     3               !
             841     3                     call unify_reduceintp(nx,my,my_max,temp(1,1,k),glob)
             842     3               !!      do 11 i=1,lenc
             843     3               !!      glob(i,1)= temp(i,k)
             844     3               !!   11 continue
             845     3               !
             846     3                     call syslbl(lrec(k),idtg,itau,ggdef,ihdg)
             847     3               !
             848     3               !  reduceintp has been done in voterp (2011/5)
             849     3               !
             850     3                       call smth9(nx,my,glob,slp,1)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 7
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 320, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      slp, glob
                                   <<< Loop-information  End >>>
             851     3  pp   4v              glob=slp
             852     3                       call smth9(nx,my,glob,slp,2)
             853     3               !!        glob=slp
             854     3               !
             855     3               !!      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,glob,istat)
             856     3                     call qmaxn3(slp,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             857     3                     ptp0(7)=nint(plev(k))
             858     3                     call split2(nx,my,lenc,ifilout,ncnt,slp,pout,ihdg,ihdg2,ptp0,ptp1)
             859     3                     go to 30
             860     3                     endif
             861     2                  10 continue
             862     1                  30 continue
             863     1                     if(outdms.gt.0)then
             864     1                     if(lwrite .and. myrank .lt. ncnt ) &
             865     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             866     1                     endif
             867     1                     if(outgrb2 == 1 )then
             868     1                     if(lwrite .and. myrank .lt. ncnt ) &
             869     1                       call wrt_grb2_v2(itau,0,0,0,2,100,-2,ptp1(7),pout,ihdg2)
             870     1                     endif
             871                     !
             872                           return
             873                       end subroutine tempout
             874                     
             875                       subroutine vortout(nx,my,my_max,lpout,lev,itau,ifilout,idtg     &
             876                           , plev,num,whtlev,pkout,pk,pklp,rvor,rvorb,vor,ggdef,v850,v700,lwrite)
             877                     !
             878                           use index
             879                           use rank, only : myrank
             880                           use mod_grb2_param
             881                           use const ,only:outdms,outgrb2 , RTYPE,kflag
             882                     
             883                           implicit  none
             884                     
             885                           integer   nx,my,my_max,lpout,lev,itau,num,ncnt
             886                     
             887                           real      pkout(lpout),pklp(nxp,my_max)                        &
             888                           , pk(nxp,lev,my_max),work3d(nxp,lev,my_max),rvorb(nxp,my_max)  &
             889                           , plev(lpout),whtlev(num)
             890                           real(kind=RTYPE) rvor(nxp,lev,my_max),vor(nxp,my_max,lpout)
             891                           real      tens(lev+1)
             892                           real(kind=RTYPE) v850(nxp,my_max),v700(nxp,my_max)
             893                           real(kind=RTYPE) wk1(nx,my),pout(nx,my)
             894                     
             895                     !
             896                           integer*8 idtg
             897                           character*80 ifilout
             898                           character*26 ihdg,ihdg2
             899                           character*6 lrec(lpout)
             900                           character*4 ggdef
             901                     
             902                           integer   k,lpl,lenc,i,n,istat,jj,j,nxj
             903                           integer:: ptp0(9),ptp1(9)
             904                     !
             905                           logical :: lwrite
             906                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2000
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      tens
                                   <<< Loop-information  End >>>
             907     1  pp   4v            do k = 1, lev+1
             908     1   p   4v             tens(k) = 1.0
             909     1   p   4v            end do
             910                           tens(lev)= 0.0
             911                           tens(lev+1)= 0.0

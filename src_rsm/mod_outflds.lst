             602                     !byl      call smth9(nx,my,slp,glob,1)
             603                     !byl      slp=glob
             604                     !byl      call smth9(nx,my,slp,glob,2)
             605                     !byl      slp=glob
             606                     !
             607                           num= 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :

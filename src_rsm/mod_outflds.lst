             291     3               !
             292     3               !      if(lwrite) call dmswrit(nx,my,ihdg,lenc,kflag,ifilout,slp,istat)
             293     3                     call qmaxn3(slp,ihdg(1:14),ihdg(15:26),1,1,1,nx,my,1)
             294     3                     ptp0(7)=nint(plev(k))
             295     3                     call split2(nx,my,lenc,ifilout,ncnt,slp,pout,ihdg,ihdg2,ptp0,ptp1)
             296     3               !
             297     3                     go to 20
             298     3                     endif
             299     2                  10 continue
             300     1                  20 continue
             301                     
             302     1                     if(outdms.gt.0)then
             303     1                     if(lwrite .and. myrank .lt. ncnt ) &
             304     1                       call dmswrit_split(nx,my,ihdg2,lenc,kflag,ifilout,pout,istat)
             305     1                     endif
             306     1                     if(outgrb2 == 1 )then
             307     1                     if(lwrite .and. myrank .lt. ncnt ) &
             308     1                       call wrt_grb2_v2(itau,0,3,5,1,100,-2,ptp1(7),pout,ihdg2)
             309     1                     endif
             310                     !
             311                           return
             312                       end subroutine geopout

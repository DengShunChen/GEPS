             215                           REAL, DIMENSION(ntb_r), PARAMETER, PRIVATE:: &
             216                           r_r = (/1.e-6,2.e-6,3.e-6,4.e-6,5.e-6,6.e-6,7.e-6,8.e-6,9.e-6, &

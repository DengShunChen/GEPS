                                   <<<      SCALABLE  : SPILL 18  FILL 47
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3832     1  pp    v            do k = kts, kte
            3833     1   p    v               tc0 = MIN(-0.1, temp(k)-273.15)
            3834     1   p    v               smob(k) = rs(k)*oams
            3835     1               
            3836     1               !..All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            3837     1               !.. then we must compute actual 2nd moment and use as reference.
            3838     2   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            3839     2   p    v                  smo2(k) = smob(k)
            3840     2                        else
            3841     2                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            3842     2                              + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            3843     2                              + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            3844     2                              + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            3845     2                              + sa(10)*bm_s*bm_s*bm_s
            3846     2                           a_ = 10.0**loga_
            3847     2                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            3848     2                              + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            3849     2                              + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            3850     2                              + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            3851     2                              + sb(10)*bm_s*bm_s*bm_s
            3852     2                           smo2(k) = (smob(k)/a_)**(1./b_)
            3853     2   p    v               endif
            3854     1               
            3855     1               !..Calculate bm_s+1 (th) moment.  Useful for diameter calcs.
            3856     1   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(1) &
            3857     1                              + sa(4)*tc0*cse(1) + sa(5)*tc0*tc0 &
            3858     1                              + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            3859     1                              + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            3860     1                              + sa(10)*cse(1)*cse(1)*cse(1)
            3861     1   p    v               a_ = 10.0**loga_
            3862     1   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(1) + sb(4)*tc0*cse(1) &
            3863     1                             + sb(5)*tc0*tc0 + sb(6)*cse(1)*cse(1) &
            3864     1                             + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            3865     1                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            3866     1   p    v               smoc(k) = a_ * smo2(k)**b_
            3867     1               
            3868     1               !..Calculate bm_s*2 (th) moment.  Useful for reflectivity.
            3869     1   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(3) &
            3870     1                              + sa(4)*tc0*cse(3) + sa(5)*tc0*tc0 &
            3871     1                              + sa(6)*cse(3)*cse(3) + sa(7)*tc0*tc0*cse(3) &
            3872     1                              + sa(8)*tc0*cse(3)*cse(3) + sa(9)*tc0*tc0*tc0 &
            3873     1                              + sa(10)*cse(3)*cse(3)*cse(3)
            3874     1   p    v               a_ = 10.0**loga_
            3875     1   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(3) + sb(4)*tc0*cse(3) &
            3876     1                             + sb(5)*tc0*tc0 + sb(6)*cse(3)*cse(3) &
            3877     1                             + sb(7)*tc0*tc0*cse(3) + sb(8)*tc0*cse(3)*cse(3) &
            3878     1                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(3)*cse(3)*cse(3)
            3879     1   p    v               smoz(k) = a_ * smo2(k)**b_
            3880     1   p    v            enddo
            3881                     
            3882                     !+---+-----------------------------------------------------------------+
            3883                     !..Calculate y-intercept, slope values for graupel.
            3884                     !+---+-----------------------------------------------------------------+
            3885                     
            3886                           N0_min = gonv_max
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 43
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.94, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp, rg, N0_g, ilamg, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 19
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3887     1   m    m            do k = kte, kts, -1
            3888     2   p    v               if (temp(k).lt.270.65 .and. L_qr(k) .and. mvd_r(k).gt.100.E-6) then
            3889     2   p    m                  xslw1 = 4.01 + dlog10(mvd_r(k))
            3890     2   p    v               else
            3891     2   p    s                  xslw1 = 0.01
            3892     2   p    m               endif
            3893     1   p    m               ygra1 = 4.31 + dlog10(max(5.E-5, rg(k)))
            3894     1   p    v               zans1 = 3.1 + (100./(300.*xslw1*ygra1/(10./xslw1+1.+0.25*ygra1)+30.+10.*ygra1))
            3895     1   p    v               N0_exp = 10.**(zans1)
            3896     1   p    v               N0_exp = MAX(DBLE(gonv_min), MIN(N0_exp, DBLE(gonv_max)))
            3897     1   s    s               N0_min = MIN(N0_exp, N0_min)
            3898     1   p    v               N0_exp = N0_min
            3899     1   m    v               lam_exp = (N0_exp*am_g*cgg(1)/rg(k))**oge1
            3900     1   p    v               lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg
            3901     1   p    v               ilamg(k) = 1./lamg
            3902     1   m    s               N0_g(k) = N0_exp/(cgg(2)*lam_exp) * lamg**cge(2)
            3903     1   p    v            enddo
            3904                     
            3905                     !+---+-----------------------------------------------------------------+
            3906                     !..Locate K-level of start of melting (k_0 is level above).
            3907                     !+---+-----------------------------------------------------------------+
            3908                           melti = .false.
            3909                           k_0 = kts
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3910     1                     do k = kte-1, kts, -1
            3911     2                        if ( (temp(k).gt.273.15) .and. L_qr(k)                         &
            3912     2                                                 .and. (L_qs(k+1).or.L_qg(k+1)) ) then
            3913     2                           k_0 = MAX(k+1, k_0)
            3914     2                           melti=.true.
            3915     2                           goto 195
            3916     2                        endif
            3917     1                     enddo
            3918                      195  continue
            3919                     
            3920                     !+---+-----------------------------------------------------------------+
            3921                     !..Assume Rayleigh approximation at 10 cm wavelength. Rain (all temps)
            3922                     !.. and non-water-coated snow and graupel when below freezing are
            3923                     !.. simple. Integrations of m(D)*m(D)*N(D)*dD.
            3924                     !+---+-----------------------------------------------------------------+
            3925                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qg, ze_graupel, ze_snow, ze_rain
                                   <<<      ilamg, N0_g, L_qs, smoz, L_qr, ilamr
                                   <<<      N0_r
                                   <<< Loop-information  End >>>
            3926     1  pp    v            do k = kts, kte
            3927     1   p    v               ze_rain(k) = 1.e-22
            3928     1   p    v               ze_snow(k) = 1.e-22
            3929     1   p    v               ze_graupel(k) = 1.e-22
            3930     1   p    v               if (L_qr(k)) ze_rain(k) = N0_r(k)*crg(4)*ilamr(k)**cre(4)
            3931     1   p    v               if (L_qs(k)) ze_snow(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)     &
            3932     1                                                * (am_s/900.0)*(am_s/900.0)*smoz(k)
            3933     1   p    v               if (L_qg(k)) ze_graupel(k) = (0.176/0.93) * (6.0/PI)*(6.0/PI)  &
            3934     1                                                   * (am_g/900.0)*(am_g/900.0)         &
            3935     1                                                   * N0_g(k)*cgg(4)*ilamg(k)**cge(4)
            3936     1   p    v            enddo
            3937                     
            3938                     !+---+-----------------------------------------------------------------+
            3939                     !..Special case of melting ice (snow/graupel) particles.  Assume the
            3940                     !.. ice is surrounded by the liquid water.  Fraction of meltwater is
            3941                     !.. extremely simple based on amount found above the melting level.
            3942                     !.. Uses code from Uli Blahak (rayleigh_soak_wetgraupel and supporting
            3943                     !.. routines).
            3944                     !+---+-----------------------------------------------------------------+
            3945                     
            3946     1                     if (.not. iiwarm .and. melti .and. k_0.ge.2) then
            3947     2                      do k = k_0-1, kts, -1
            3948     2               
            3949     2               !..Reflectivity contributed by melting snow
            3950     3                         if (L_qs(k) .and. L_qs(k_0) ) then
            3951     3                          fmelt_s = MAX(0.05d0, MIN(1.0d0-rs(k)/rs(k_0), 0.99d0))
            3952     3                          eta = 0.d0
            3953     3                          oM3 = 1./smoc(k)
            3954     3                          M0 = (smob(k)*oM3)
            3955     3                          Mrat = smob(k)*M0*M0*M0
            3956     3                          slam1 = M0 * Lam0
            3957     3                          slam2 = M0 * Lam1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDs, xdts, simpson
                                   <<< Loop-information  End >>>
            3958     4                          do n = 1, nrbins
            3959     4                             x = am_s * xxDs(n)**bm_s
            3960     4                             call rayleigh_soak_wetgraupel (x, DBLE(ocms), DBLE(obms), &
            3961     4                                   fmelt_s, melt_outside_s, m_w_0, m_i_0, lamda_radar, &
            3962     4                                   CBACK, mixingrulestring_s, matrixstring_s,          &
            3963     4                                   inclusionstring_s, hoststring_s,                    &
            3964     4                                   hostmatrixstring_s, hostinclusionstring_s)
            3965     4                             f_d = Mrat*(Kap0*DEXP(-slam1*xxDs(n))                     &
            3966     4                                   + Kap1*(M0*xxDs(n))**mu_s * DEXP(-slam2*xxDs(n)))
            3967     4                             eta = eta + f_d * CBACK * simpson(n) * xdts(n)
            3968     4                          enddo
            3969     3                          ze_snow(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            3970     3                         endif
            3971     2               
            3972     2               !..Reflectivity contributed by melting graupel
            3973     2               
            3974     3                         if (L_qg(k) .and. L_qg(k_0) ) then
            3975     3                          fmelt_g = MAX(0.05d0, MIN(1.0d0-rg(k)/rg(k_0), 0.99d0))
            3976     3                          eta = 0.d0
            3977     3                          lamg = 1./ilamg(k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xxDg, xdtg, simpson
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3978     4                          do n = 1, nrbins
            3979     4                             x = am_g * xxDg(n)**bm_g
            3980     4                             call rayleigh_soak_wetgraupel (x, DBLE(ocmg), DBLE(obmg), &
            3981     4                                   fmelt_g, melt_outside_g, m_w_0, m_i_0, lamda_radar, &
            3982     4                                   CBACK, mixingrulestring_g, matrixstring_g,          &
            3983     4                                   inclusionstring_g, hoststring_g,                    &
            3984     4                                   hostmatrixstring_g, hostinclusionstring_g)
            3985     4                             f_d = N0_g(k)*xxDg(n)**mu_g * DEXP(-lamg*xxDg(n))
            3986     4                             eta = eta + f_d * CBACK * simpson(n) * xdtg(n)
            3987     4                          enddo
            3988     3                          ze_graupel(k) = SNGL(lamda4 / (pi5 * K_w) * eta)
            3989     3                         endif
            3990     2               
            3991     2                      enddo
            3992     1                     endif
            3993                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.08, ITR: 56, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ze_snow, ze_rain, ze_graupel, dBZ
                                   <<< Loop-information  End >>>
            3994     1  pp    v            do k = kte, kts, -1
            3995     1   p    v               dBZ(k) = 10.*log10((ze_rain(k)+ze_snow(k)+ze_graupel(k))*1.d18)
            3996     1   p    v            enddo
            3997                     
            3998                     
            3999                     !..Reflectivity-weighted terminal velocity (snow, rain, graupel, mix).
            4000                     !     do k = kte, kts, -1
            4001                     !        vt_dBZ(k) = 1.E-3
            4002                     !        if (rs(k).gt.R2) then
            4003                     !         Mrat = smob(k) / smoc(k)
            4004                     !         ils1 = 1./(Mrat*Lam0 + fv_s)
            4005                     !         ils2 = 1./(Mrat*Lam1 + fv_s)
            4006                     !         t1_vts = Kap0*csg(5)*ils1**cse(5)
            4007                     !         t2_vts = Kap1*Mrat**mu_s*csg(11)*ils2**cse(11)
            4008                     !         ils1 = 1./(Mrat*Lam0)
            4009                     !         ils2 = 1./(Mrat*Lam1)
            4010                     !         t3_vts = Kap0*csg(6)*ils1**cse(6)
            4011                     !         t4_vts = Kap1*Mrat**mu_s*csg(12)*ils2**cse(12)
            4012                     !         vts_dbz_wt = rhof(k)*av_s * (t1_vts+t2_vts)/(t3_vts+t4_vts)
            4013                     !         if (temp(k).ge.273.15 .and. temp(k).lt.275.15) then
            4014                     !            vts_dbz_wt = vts_dbz_wt*1.5
            4015                     !         elseif (temp(k).ge.275.15) then
            4016                     !            vts_dbz_wt = vts_dbz_wt*2.0
            4017                     !         endif
            4018                     !        else
            4019                     !         vts_dbz_wt = 1.E-3
            4020                     !        endif
            4021                     
            4022                     !        if (rr(k).gt.R1) then
            4023                     !         lamr = 1./ilamr(k)
            4024                     !         vtr_dbz_wt = rhof(k)*av_r*crg(13)*(lamr+fv_r)**(-cre(13))      &
            4025                     !                    / (crg(4)*lamr**(-cre(4)))
            4026                     !        else
            4027                     !         vtr_dbz_wt = 1.E-3
            4028                     !        endif
            4029                     
            4030                     !        if (rg(k).gt.R2) then
            4031                     !         lamg = 1./ilamg(k)
            4032                     !         vtg_dbz_wt = rhof(k)*av_g*cgg(5)*lamg**(-cge(5))               &
            4033                     !                    / (cgg(4)*lamg**(-cge(4)))
            4034                     !        else
            4035                     !         vtg_dbz_wt = 1.E-3
            4036                     !        endif
            4037                     
            4038                     !        vt_dBZ(k) = (vts_dbz_wt*ze_snow(k) + vtr_dbz_wt*ze_rain(k)      &
            4039                     !                     + vtg_dbz_wt*ze_graupel(k))                        &
            4040                     !                     / (ze_rain(k)+ze_snow(k)+ze_graupel(k))
            4041                     !     enddo
            4042                     
            4043                           end subroutine calc_refl10cm
            4044                     
            4045                     !+---+-----------------------------------------------------------------+
            4046                     !+---+-----------------------------------------------------------------+
            4047                     !ctrlL
            4048                     
            4049                     !+---+-----------------------------------------------------------------+
            4050                     !..Compute _radiation_ effective radii of cloud water, ice, and snow.
            4051                     !.. These are entirely consistent with microphysics assumptions, not
            4052                     !.. constant or otherwise ad hoc as is internal to most radiation
            4053                     !.. schemes.  Since only the smallest snowflakes should impact
            4054                     !.. radiation, compute from first portion of complicated Field number
            4055                     !.. distribution, not the second part, which is the larger sizes.
            4056                     !+---+-----------------------------------------------------------------+
            4057                     
            4058                           subroutine calc_effectRad (t1d, p1d, qv1d, qc1d, nc1d, qi1d, ni1d, qs1d,   &
            4059                          &                islmski,re_qc1d, re_qi1d, re_qs1d, kts, kte)
            4060                     
            4061                           IMPLICIT NONE
            4062                     
            4063                     !..Sub arguments
            4064                           INTEGER, INTENT(IN):: kts, kte
            4065                           INTEGER, INTENT(IN):: islmski
            4066                           REAL, DIMENSION(kts:kte), INTENT(IN)::                                     &
            4067                          &                    t1d, p1d, qv1d, qc1d, nc1d, qi1d, ni1d, qs1d
            4068                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: re_qc1d, re_qi1d, re_qs1d
            4069                     !..Local variables
            4070                           INTEGER:: k
            4071                           REAL, DIMENSION(kts:kte):: rho, rc, nc, ri, ni, rs
            4072                           REAL:: smo2, smob, smoc
            4073                           REAL:: tc0, loga_, a_, b_
            4074                           DOUBLE PRECISION:: lamc, lami
            4075                           LOGICAL:: has_qc, has_qi, has_qs
            4076                           INTEGER:: inu_c
            4077                           real, dimension(15), parameter:: g_ratio = (/24,60,120,210,336,            &
            4078                          &                504,720,990,1320,1716,2184,2730,3360,4080,4896/)
            4079                     
            4080                           has_qc = .false.
            4081                           has_qi = .false.
            4082                           has_qs = .false.
            4083                     
            4084                     !     print*,'cal_eff:',islmski,Nt_c, Nt_cl,Nt_co
            4085                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 134
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    UNSWITCHING
                                   <<< Loop-information  End >>>
            4086     1  pp    v            do k = kts, kte
            4087     1   p    v               rho(k) = 0.622*p1d(k)/(R*t1d(k)*(qv1d(k)+0.622))
            4088     1   p    v               rc(k) = MAX(R1, qc1d(k)*rho(k))
            4089     2   p    v               if(islmski == 1) then
            4090     2        v                 nc(k) = Nt_cl
            4091     2   p    v               else
            4092     2   p    v                 nc(k) = Nt_co
            4093     2   p    v               endif
            4094     1   p                    if (rc(k).gt.R1 .and. nc(k).gt.R2) has_qc = .true.
            4095     1   p    v               ri(k) = MAX(R1, qi1d(k)*rho(k))
            4096     1   p    v               ni(k) = MAX(R2, ni1d(k)*rho(k))
            4097     1   p                    if (ri(k).gt.R1 .and. ni(k).gt.R2) has_qi = .true.
            4098     1   p    v               rs(k) = MAX(R1, qs1d(k)*rho(k))
            4099     1   p                    if (rs(k).gt.R1) has_qs = .true.
            4100     1   p    v            enddo
            4101                     
            4102     1                     if (has_qc) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 35
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rc
                                   <<< Loop-information  End >>>
            4103     2  pp    s            do k = kts, kte
            4104     2   p    m               if (rc(k).le.R1 .or. nc(k).le.R2) CYCLE
            4105     3   p    s               if (nc(k).lt.100) then
            4106     3   p    s                  inu_c = 15
            4107     3   p    s               elseif (nc(k).gt.1.E10) then
            4108     3   p    s                  inu_c = 2
            4109     3   p    s               else
            4110     3   p    s                  inu_c = MIN(15, NINT(1000.E6/nc(k)) + 2)
            4111     3   p    s               endif
            4112     2   p    s               lamc = (nc(k)*am_r*g_ratio(inu_c)/rc(k))**obmr
            4113     2   p    s               re_qc1d(k) = MAX(2.51E-6, MIN(SNGL(0.5D0 * DBLE(3.+inu_c)/lamc), 50.E-6))
            4114     2   p    v            enddo
            4115     1                     endif
            4116                     
            4117     1                     if (has_qi) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 41
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ri, ni, re_qi1d
                                   <<< Loop-information  End >>>
            4118     2  pp    v            do k = kts, kte
            4119     2   p    v               if (ri(k).le.R1 .or. ni(k).le.R2) CYCLE
            4120     2   p    v               lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            4121     2   p    v               re_qi1d(k) = MAX(10.01E-6, MIN(SNGL(0.5D0 * DBLE(3.+mu_i)/lami), 125.E-6))
            4122     2   p    v            enddo
            4123     1                     endif
            4124                     
            4125     1                     if (has_qs) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 21
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rs, t1d, re_qs1d
                                   <<< Loop-information  End >>>
            4126     2  pp    v            do k = kts, kte
            4127     2   p    v               if (rs(k).le.R1) CYCLE
            4128     2   p    v               tc0 = MIN(-0.1, t1d(k)-273.15)
            4129     2   p    v               smob = rs(k)*oams
            4130     2               
            4131     2               !..All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            4132     2               !.. then we must compute actual 2nd moment and use as reference.
            4133     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            4134     3   p    v                  smo2 = smob
            4135     3                        else
            4136     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            4137     3                    &         + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            4138     3                    &         + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            4139     3                    &         + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            4140     3                    &         + sa(10)*bm_s*bm_s*bm_s
            4141     3                           a_ = 10.0**loga_
            4142     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            4143     3                    &         + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            4144     3                    &         + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            4145     3                    &         + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            4146     3                    &         + sb(10)*bm_s*bm_s*bm_s
            4147     3                           smo2 = (smob/a_)**(1./b_)
            4148     3   p    v               endif
            4149     2               !..Calculate bm_s+1 (th) moment.  Useful for diameter calcs.
            4150     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(1) &
            4151     2                    &         + sa(4)*tc0*cse(1) + sa(5)*tc0*tc0 &
            4152     2                    &         + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            4153     2                    &         + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            4154     2                    &         + sa(10)*cse(1)*cse(1)*cse(1)
            4155     2   p    v               a_ = 10.0**loga_
            4156     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(1) + sb(4)*tc0*cse(1) &
            4157     2                    &        + sb(5)*tc0*tc0 + sb(6)*cse(1)*cse(1) &
            4158     2                    &        + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            4159     2                    &        + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            4160     2   p    v               smoc = a_ * smo2**b_
            4161     2   p    v               re_qs1d(k) = MAX(10.E-6, MIN(0.5*(smoc/smob), 999.E-6))
            4162     2   p    v            enddo
            4163     1                     endif
            4164                     
            4165                           end subroutine calc_effectRad

            1042                     !.. This subroutine computes the moisture tendencies of water vapor,
            1043                     !.. cloud droplets, rain, cloud ice (pristine), snow, and graupel.
            1044                     !.. Previously this code was based on Reisner et al (1998), but few of
            1045                     !.. those pieces remain.  A complete description is now found in
            1046                     !.. Thompson et al. (2004, 2008).
            1047                     !+---+-----------------------------------------------------------------+
            1048                     !
            1049                           subroutine mp_thompson (qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
            1050                                               nr1d, t1d, p1d, dzq, 				&
            1051                                               pptrain, pptsnow, pptgraul, pptice, 		&
            1052                                               islmski,					&
            1053                                               kts, kte, dt, ii)
            1054                     
            1055                           implicit none
            1056                     
            1057                     !..Sub arguments
            1058                           INTEGER, INTENT(IN):: kts, kte, ii
            1059                           INTEGER, INTENT(IN):: islmski
            1060                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: &
            1061                                               qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
            1062                                               nr1d, t1d, p1d
            1063                     !#ifdef WRF_CHEM
            1064                     !      REAL, DIMENSION(kts:kte), INTENT(INOUT):: &
            1065                     !                          rainprod, evapprod
            1066                     !#endif
            1067                           REAL, DIMENSION(kts:kte), INTENT(IN):: dzq
            1068                           REAL, INTENT(INOUT):: pptrain, pptsnow, pptgraul, pptice
            1069                           REAL, INTENT(IN):: dt
            1070                     
            1071                     !..Local variables
            1072                           REAL, DIMENSION(kts:kte):: tten, qvten, qcten, qiten, &
            1073                                qrten, qsten, qgten, niten, nrten
            1074                     
            1075                           DOUBLE PRECISION, DIMENSION(kts:kte):: prw_vcd
            1076                     
            1077                           DOUBLE PRECISION, DIMENSION(kts:kte):: prr_wau, prr_rcw, prr_rcs, &
            1078                                prr_rcg, prr_sml, prr_gml, &
            1079                                prr_rci, prv_rev,          &
            1080                                pnr_wau, pnr_rcs, pnr_rcg, &
            1081                                pnr_rci, pnr_sml, pnr_gml, &
            1082                                pnr_rev, pnr_rcr, pnr_rfz
            1083                     
            1084                           DOUBLE PRECISION, DIMENSION(kts:kte):: pri_inu, pni_inu, pri_ihm, &
            1085                                pni_ihm, pri_wfz, pni_wfz, &
            1086                                pri_rfz, pni_rfz, pri_ide, &
            1087                                pni_ide, pri_rci, pni_rci, &
            1088                                pni_sci, pni_iau
            1089                     
            1090                           DOUBLE PRECISION, DIMENSION(kts:kte):: prs_iau, prs_sci, prs_rcs, &
            1091                                prs_scw, prs_sde, prs_ihm, &
            1092                                prs_ide
            1093                     
            1094                           DOUBLE PRECISION, DIMENSION(kts:kte):: prg_scw, prg_rfz, prg_gde, &
            1095                                prg_gcw, prg_rci, prg_rcs, &
            1096                                prg_rcg, prg_ihm
            1097                     
            1098                           DOUBLE PRECISION, PARAMETER:: zeroD0 = 0.0d0
            1099                     
            1100                           REAL, DIMENSION(kts:kte):: temp, pres, qv
            1101                           REAL, DIMENSION(kts:kte):: rc, ri, rr, rs, rg, ni, nr
            1102                           REAL, DIMENSION(kts:kte):: rho, rhof, rhof2
            1103                           REAL, DIMENSION(kts:kte):: qvs, qvsi, delQvs
            1104                           REAL, DIMENSION(kts:kte):: satw, sati, ssatw, ssati
            1105                           REAL, DIMENSION(kts:kte):: diffu, visco, vsc2, &
            1106                                tcond, lvap, ocp, lvt2
            1107                     
            1108                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilamg, N0_r, N0_g
            1109                           REAL, DIMENSION(kts:kte):: mvd_r, mvd_c
            1110                           REAL, DIMENSION(kts:kte):: smob, smo2, smo1, smo0, &
            1111                                smoc, smod, smoe, smof
            1112                     
            1113                           REAL, DIMENSION(kts:kte):: sed_r, sed_s, sed_g, sed_i, sed_n
            1114                     
            1115                           REAL:: rgvm, delta_tp, orho, lfus2
            1116                           REAL, DIMENSION(4):: onstep
            1117                           DOUBLE PRECISION:: N0_exp, N0_min, lam_exp, lamc, lamr, lamg
            1118                           DOUBLE PRECISION:: lami, ilami
            1119                           REAL:: xDc, Dc_b, Dc_g, xDi, xDr, xDs, xDg, Ds_m, Dg_m
            1120                           DOUBLE PRECISION:: Dr_star
            1121                           REAL:: zeta1, zeta, taud, tau
            1122                           REAL:: stoke_r, stoke_s, stoke_g, stoke_i
            1123                           REAL:: vti, vtr, vts, vtg
            1124                           REAL, DIMENSION(kts:kte+1):: vtik, vtnik, vtrk, vtnrk, vtsk, vtgk
            1125                           REAL, DIMENSION(kts:kte):: vts_boost
            1126                           REAL:: Mrat, ils1, ils2, t1_vts, t2_vts, t3_vts, t4_vts, C_snow
            1127                           REAL:: a_, b_, loga_, A1, A2, tf
            1128                           REAL:: tempc, tc0, r_mvd1, r_mvd2, xkrat
            1129                           REAL:: xnc, xri, xni, xmi, oxmi, xrc, xrr, xnr
            1130                           REAL:: xsat, rate_max, sump, ratio
            1131                           REAL:: clap, fcd, dfcd
            1132                           REAL:: otemp, rvs, rvs_p, rvs_pp, gamsc, alphsc, t1_evap, t1_subl
            1133                           REAL:: r_frac, g_frac
            1134                           REAL:: Ef_rw, Ef_sw, Ef_gw, Ef_rr
            1135                           REAL:: dtsave, odts, odt, odzq
            1136                           REAL:: xslw1, ygra1, zans1
            1137                           INTEGER:: i, k, k2, n, nn, nstep, k_0, kbot, IT, iexfrq
            1138                           INTEGER, DIMENSION(4):: ksed1
            1139                           INTEGER:: nir, nis, nig, nii, nic
            1140                           INTEGER:: idx_tc, idx_t, idx_s, idx_g1, idx_g, idx_r1, idx_r,     &
            1141                                     idx_i1, idx_i, idx_c, idx, idx_d
            1142                           LOGICAL:: melti, no_micro
            1143                           LOGICAL, DIMENSION(kts:kte):: L_qc, L_qi, L_qr, L_qs, L_qg
            1144                           LOGICAL:: debug_flag
            1145                           INTEGER:: idx_lo ! land and ocean
            1146                     
            1147                     !+---+
            1148                     
            1149                           debug_flag = .false.
            1150                     !     if (ii.eq.315 ) debug_flag = .true.
            1151                     
            1152                           no_micro = .true.
            1153                           dtsave = dt
            1154                           odt = 1./dt
            1155                           odts = 1./dtsave
            1156                           iexfrq = 1
            1157                     
            1158     1                     if(islmski == 1) then
            1159     1                       idx_lo = 1
            1160     1                     else
            1161     1                       idx_lo = 2
            1162     1                     endif
            1163                     
            1164                     !+---+-----------------------------------------------------------------+
            1165                     !.. Source/sink terms.  First 2 chars: "pr" represents source/sink of
            1166                     !.. mass while "pn" represents source/sink of number.  Next char is one
            1167                     !.. of "v" for water vapor, "r" for rain, "i" for cloud ice, "w" for
            1168                     !.. cloud water, "s" for snow, and "g" for graupel.  Next chars
            1169                     !.. represent processes: "de" for sublimation/deposition, "ev" for
            1170                     !.. evaporation, "fz" for freezing, "ml" for melting, "au" for
            1171                     !.. autoconversion, "nu" for ice nucleation, "hm" for Hallet/Mossop
            1172                     !.. secondary ice production, and "c" for collection followed by the
            1173                     !.. character for the species being collected.  ALL of these terms are
            1174                     !.. positive (except for deposition/sublimation terms which can switch
            1175                     !.. signs based on super/subsaturation) and are treated as negatives
            1176                     !.. where necessary in the tendency equations.
            1177                     !+---+-----------------------------------------------------------------+
            1178                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 92
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prg_rci, qvten, qcten, qrten, prg_rcs
                                   <<<      prg_rcg, prg_ihm, tten, qiten, qsten
                                   <<<      qgten, niten, nrten, prw_vcd, prv_rev
                                   <<<      prr_wau
                                   <<<    PREFETCH(SOFT) : 80
                                   <<<     SEQUENTIAL : 80
                                   <<<      prr_rcw: 2, prr_rcs: 2, prr_rcg: 2
                                   <<<      prr_sml: 2, prr_gml: 2, prr_rci: 2
                                   <<<      pnr_wau: 2, pnr_rcs: 2, pnr_rcg: 2
                                   <<<      pnr_rci: 2, pnr_sml: 2, pnr_gml: 2
                                   <<<      pnr_rev: 2, pnr_rcr: 2, pnr_rfz: 2
                                   <<<      pri_inu: 2, pni_inu: 2, pri_ihm: 2
                                   <<<      pni_ihm: 2, pri_wfz: 2, pni_wfz: 2
                                   <<<      pri_rfz: 2, pni_rfz: 2, pri_ide: 2
                                   <<<      pni_ide: 2, pri_rci: 2, pni_rci: 2
                                   <<<      pni_sci: 2, pni_iau: 2, prs_iau: 2
                                   <<<      prs_sci: 2, prs_rcs: 2, prs_scw: 2
                                   <<<      prs_sde: 2, prs_ihm: 2, prs_ide: 2
                                   <<<      prg_scw: 2, prg_rfz: 2, prg_gde: 2
                                   <<<      prg_gcw: 2

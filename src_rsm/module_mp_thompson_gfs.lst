                                   <<< Loop-information  End >>>
            2294     1   m    m            do k = kts, kte
            2295     1   m    s               temp(k) = t1d(k) + DT*tten(k)
            2296     1   p    v               otemp = 1./temp(k)
            2297     1   p    v               tempc = temp(k) - 273.15
            2298     1   p    v               qv(k) = MAX(1.E-10, qv1d(k) + DT*qvten(k))
            2299     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            2300     1   p    v               rhof(k) = SQRT(RHO_NOT/rho(k))
            2301     1   p    v               rhof2(k) = SQRT(rhof(k))
            2302     1   pi   v               qvs(k) = rslf(pres(k), temp(k))
            2303     1   p                    ssatw(k) = qv(k)/qvs(k) - 1.
            2304     1   p                    if (abs(ssatw(k)).lt. eps) ssatw(k) = 0.0
            2305     1   p                    diffu(k) = 2.11E-5*(temp(k)/273.15)**1.94 * (101325./pres(k))
            2306     2   p                    if (tempc .ge. 0.0) then
            2307     2   p                       visco(k) = (1.718+0.0049*tempc)*1.0E-5
            2308     2   p                    else
            2309     2   p                       visco(k) = (1.718+0.0049*tempc-1.2E-5*tempc*tempc)*1.0E-5
            2310     2   p                    endif
            2311     1   p                    vsc2(k) = SQRT(rho(k)/visco(k))
            2312     1   p                    lvap(k) = lvap0 + (2106.0 - 4218.0)*tempc
            2313     1   p                    tcond(k) = (5.69 + 0.0168*tempc)*1.0E-5 * 418.936
            2314     1   p                    ocp(k) = 1./(Cp*(1.+0.887*qv(k)))
            2315     1   p                    lvt2(k)=lvap(k)*lvap(k)*ocp(k)*oRv*otemp*otemp
            2316     1               
            2317     2   p                    if ((qc1d(k) + qcten(k)*DT) .gt. R1) then
            2318     2   p                       rc(k) = (qc1d(k) + qcten(k)*DT)*rho(k)
            2319     2   p                       L_qc(k) = .true.
            2320     2   p                    else
            2321     2   p                       rc(k) = R1
            2322     2   p                       L_qc(k) = .false.
            2323     2   p                    endif
            2324     1               
            2325     2   p                    if ((qi1d(k) + qiten(k)*DT) .gt. R1) then
            2326     2   p                       ri(k) = (qi1d(k) + qiten(k)*DT)*rho(k)
            2327     2   p                       ni(k) = MAX(R2, (ni1d(k) + niten(k)*DT)*rho(k))
            2328     2   p                       L_qi(k) = .true.
            2329     2   p                    else
            2330     2   p                       ri(k) = R1
            2331     2   p                       ni(k) = R2
            2332     2   p                       L_qi(k) = .false.
            2333     2   p                    endif
            2334     1               
            2335     2   p                    if ((qr1d(k) + qrten(k)*DT) .gt. R1) then
            2336     2   p                       rr(k) = (qr1d(k) + qrten(k)*DT)*rho(k)
            2337     2   p                       nr(k) = MAX(R2, (nr1d(k) + nrten(k)*DT)*rho(k))
            2338     2   p                       L_qr(k) = .true.
            2339     2   p                       lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            2340     2   p                       mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            2341     3   p                       if (mvd_r(k) .gt. 2.5E-3) then
            2342     3   p                          mvd_r(k) = 2.5E-3
            2343     3   p                          lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2344     3   p                          nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2345     3   p                       elseif (mvd_r(k) .lt. D0r*0.75) then
            2346     3   p                          mvd_r(k) = D0r*0.75
            2347     3   p                          lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2348     3   p                          nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            2349     3   p                       endif
            2350     2   p                    else
            2351     2   p                       rr(k) = R1
            2352     2   p                       nr(k) = R2
            2353     2   p                       L_qr(k) = .false.
            2354     2   p                    endif
            2355     1               
            2356     2   p                    if ((qs1d(k) + qsten(k)*DT) .gt. R1) then
            2357     2   p                       rs(k) = (qs1d(k) + qsten(k)*DT)*rho(k)
            2358     2   p                       L_qs(k) = .true.
            2359     2   p                    else
            2360     2   p                       rs(k) = R1
            2361     2   p                       L_qs(k) = .false.
            2362     2   p                    endif
            2363     1               
            2364     2   p                    if ((qg1d(k) + qgten(k)*DT) .gt. R1) then
            2365     2   p                       rg(k) = (qg1d(k) + qgten(k)*DT)*rho(k)
            2366     2   p                       L_qg(k) = .true.
            2367     2   p                    else

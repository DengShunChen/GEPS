            3550                           SUBROUTINE GCF(GAMMCF,A,X,GLN)
            3551                     !     --- RETURNS THE INCOMPLETE GAMMA FUNCTION Q(A,X) EVALUATED BY ITS
            3552                     !     --- CONTINUED FRACTION REPRESENTATION AS GAMMCF.  ALSO RETURNS
            3553                     !     --- LN(GAMMA(A)) AS GLN.  THE CONTINUED FRACTION IS EVALUATED BY
            3554                     !     --- A MODIFIED LENTZ METHOD.
            3555                     !     --- USES GAMMLN
            3556                           IMPLICIT NONE
            3557                           INTEGER, PARAMETER:: ITMAX=100
            3558                           REAL, PARAMETER:: gEPS=3.E-7
            3559                           REAL, PARAMETER:: FPMIN=1.E-30
            3560                           REAL, INTENT(IN):: A, X
            3561                           REAL:: GAMMCF,GLN
            3562                           INTEGER:: I
            3563                           REAL:: AN,B,C,D,DEL,H
            3564                           GLN=GAMMLN(A)
            3565                           B=X+1.-A
            3566                           C=1./FPMIN
            3567                           D=1./B
            3568                           H=D
            3569     1                     DO 11 I=1,ITMAX
            3570     1                       AN=-I*(I-A)
            3571     1                       B=B+2.
            3572     1                       D=AN*D+B
            3573     1                       IF(ABS(D).LT.FPMIN)D=FPMIN
            3574     1                       C=B+AN/C
            3575     1                       IF(ABS(C).LT.FPMIN)C=FPMIN
            3576     1                       D=1./D
            3577     1                       DEL=D*C
            3578     1                       H=H*DEL
            3579     1                       IF(ABS(DEL-1.).LT.gEPS)GOTO 1
            3580     1                11   CONTINUE
            3581                           PRINT *, 'A TOO LARGE, ITMAX TOO SMALL IN GCF'
            3582                      1    GAMMCF=EXP(-X+A*LOG(X)-GLN)*H
            3583                           END SUBROUTINE GCF
            3584                     !  (C) Copr. 1986-92 Numerical Recipes Software 2.02
            3585                     !+---+-----------------------------------------------------------------+
            3586                           SUBROUTINE GSER(GAMSER,A,X,GLN)
            3587                     !     --- RETURNS THE INCOMPLETE GAMMA FUNCTION P(A,X) EVALUATED BY ITS
            3588                     !     --- ITS SERIES REPRESENTATION AS GAMSER.  ALSO RETURNS LN(GAMMA(A))
            3589                     !     --- AS GLN.
            3590                     !     --- USES GAMMLN
            3591                           IMPLICIT NONE
            3592                           INTEGER, PARAMETER:: ITMAX=100
            3593                           REAL, PARAMETER:: gEPS=3.E-7
            3594                           REAL, INTENT(IN):: A, X
            3595                           REAL:: GAMSER,GLN
            3596                           INTEGER:: N
            3597                           REAL:: AP,DEL,SUM
            3598                           GLN=GAMMLN(A)
            3599     1                     IF(X.LE.0.)THEN
            3600     1                       IF(X.LT.0.) PRINT *, 'X < 0 IN GSER'
            3601     1                       GAMSER=0.
            3602     1                       RETURN
            3603     1                     ENDIF
            3604                           AP=A
            3605                           SUM=1./A
            3606                           DEL=SUM
            3607     1                     DO 11 N=1,ITMAX
            3608     1                       AP=AP+1.
            3609     1                       DEL=DEL*X/AP
            3610     1                       SUM=SUM+DEL
            3611     1                       IF(ABS(DEL).LT.ABS(SUM)*gEPS)GOTO 1
            3612     1                11   CONTINUE
            3613                           PRINT *,'A TOO LARGE, ITMAX TOO SMALL IN GSER'
            3614                      1    GAMSER=SUM*EXP(-X+A*LOG(X)-GLN)
            3615                           END SUBROUTINE GSER
            3616                     !  (C) Copr. 1986-92 Numerical Recipes Software 2.02
            3617                     !+---+-----------------------------------------------------------------+
            3618                           REAL FUNCTION GAMMLN(XX)
            3619                     !     --- RETURNS THE VALUE LN(GAMMA(XX)) FOR XX > 0.
            3620                           IMPLICIT NONE
            3621                           REAL, INTENT(IN):: XX
            3622                           DOUBLE PRECISION, PARAMETER:: STP = 2.5066282746310005D0
            3623                           DOUBLE PRECISION, DIMENSION(6), PARAMETER:: &
            3624                                    COF = (/76.18009172947146D0, -86.50532032941677D0, &
            3625                                            24.01409824083091D0, -1.231739572450155D0, &
            3626                                           .1208650973866179D-2, -.5395239384953D-5/)
            3627                           DOUBLE PRECISION:: SER,TMP,X,Y
            3628                           INTEGER:: J
            3629                     
            3630                           X=XX
            3631                           Y=X
            3632                           TMP=X+5.5D0
            3633                           TMP=(X+0.5D0)*LOG(TMP)-TMP
            3634                           SER=1.000000000190015D0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3635     1   s   fs            DO 11 J=1,6
            3636     1   s   fs              Y=Y+1.D0
            3637     1   m   fm              SER=SER+COF(J)/Y
            3638     1   p   fv      11    CONTINUE
            3639                           GAMMLN=TMP+LOG(STP*SER/X)
            3640                           END FUNCTION GAMMLN
            3641                     !  (C) Copr. 1986-92 Numerical Recipes Software 2.02
            3642                     !+---+-----------------------------------------------------------------+
            3643                           REAL FUNCTION GAMMP(A,X)
            3644                     !     --- COMPUTES THE INCOMPLETE GAMMA FUNCTION P(A,X)
            3645                     !     --- SEE ABRAMOWITZ AND STEGUN 6.5.1
            3646                     !     --- USES GCF,GSER
            3647                           IMPLICIT NONE
            3648                           REAL, INTENT(IN):: A,X
            3649                           REAL:: GAMMCF,GAMSER,GLN
            3650                           GAMMP = 0.
            3651     1                     IF((X.LT.0.) .OR. (A.LE.0.)) THEN
            3652     1                       PRINT *, 'BAD ARGUMENTS IN GAMMP'
            3653     1                       RETURN
            3654     1                     ELSEIF(X.LT.A+1.)THEN
            3655     1                       CALL GSER(GAMSER,A,X,GLN)
            3656     1                       GAMMP=GAMSER
            3657     1                     ELSE
            3658     1                       CALL GCF(GAMMCF,A,X,GLN)
            3659     1                       GAMMP=1.-GAMMCF
            3660     1                     ENDIF
            3661                           END FUNCTION GAMMP
            3662                     !  (C) Copr. 1986-92 Numerical Recipes Software 2.02
            3663                     !+---+-----------------------------------------------------------------+
            3664                           REAL FUNCTION WGAMMA(y)
            3665                     
            3666                           IMPLICIT NONE
            3667                           REAL, INTENT(IN):: y
            3668                     
            3669                           WGAMMA = EXP(GAMMLN(y))
            3670                     
            3671                           END FUNCTION WGAMMA
            3672                     !+---+-----------------------------------------------------------------+
            3673                     ! THIS FUNCTION CALCULATES THE LIQUID SATURATION VAPOR MIXING RATIO AS
            3674                     ! A FUNCTION OF TEMPERATURE AND PRESSURE
            3675                     !
            3676                           REAL FUNCTION RSLF(P,T)
            3677                     
            3678                           IMPLICIT NONE
            3679                           REAL, INTENT(IN):: P, T
            3680                           REAL:: ESL,X
            3681                           REAL, PARAMETER:: C0= .611583699E03
            3682                           REAL, PARAMETER:: C1= .444606896E02
            3683                           REAL, PARAMETER:: C2= .143177157E01
            3684                           REAL, PARAMETER:: C3= .264224321E-1
            3685                           REAL, PARAMETER:: C4= .299291081E-3
            3686                           REAL, PARAMETER:: C5= .203154182E-5
            3687                           REAL, PARAMETER:: C6= .702620698E-8
            3688                           REAL, PARAMETER:: C7= .379534310E-11
            3689                           REAL, PARAMETER:: C8=-.321582393E-13
            3690                     
            3691                           X=MAX(-80.,T-273.16)
            3692                     
            3693                     !      ESL=612.2*EXP(17.67*X/(T-29.65))
            3694                           ESL=C0+X*(C1+X*(C2+X*(C3+X*(C4+X*(C5+X*(C6+X*(C7+X*C8)))))))
            3695                           RSLF=.622*ESL/(P-ESL)
            3696                     
            3697                     !    ALTERNATIVE
            3698                     !  ; Source: Murphy and Koop, Review of the vapour pressure of ice and
            3699                     !             supercooled water for atmospheric applications, Q. J. R.
            3700                     !             Meteorol. Soc (2005), 131, pp. 1539-1565.
            3701                     !    ESL = EXP(54.842763 - 6763.22 / T - 4.210 * ALOG(T) + 0.000367 * T
            3702                     !        + TANH(0.0415 * (T - 218.8)) * (53.878 - 1331.22
            3703                     !        / T - 9.44523 * ALOG(T) + 0.014025 * T))
            3704                     
            3705                           END FUNCTION RSLF
            3706                     !+---+-----------------------------------------------------------------+
            3707                     ! THIS FUNCTION CALCULATES THE ICE SATURATION VAPOR MIXING RATIO AS A
            3708                     ! FUNCTION OF TEMPERATURE AND PRESSURE
            3709                     !
            3710                           REAL FUNCTION RSIF(P,T)
            3711                     
            3712                           IMPLICIT NONE
            3713                           REAL, INTENT(IN):: P, T
            3714                           REAL:: ESI,X
            3715                           REAL, PARAMETER:: C0= .609868993E03
            3716                           REAL, PARAMETER:: C1= .499320233E02
            3717                           REAL, PARAMETER:: C2= .184672631E01
            3718                           REAL, PARAMETER:: C3= .402737184E-1
            3719                           REAL, PARAMETER:: C4= .565392987E-3
            3720                           REAL, PARAMETER:: C5= .521693933E-5
            3721                           REAL, PARAMETER:: C6= .307839583E-7
            3722                           REAL, PARAMETER:: C7= .105785160E-9
            3723                           REAL, PARAMETER:: C8= .161444444E-12
            3724                     
            3725                           X=MAX(-80.,T-273.16)
            3726                           ESI=C0+X*(C1+X*(C2+X*(C3+X*(C4+X*(C5+X*(C6+X*(C7+X*C8)))))))
            3727                           RSIF=.622*ESI/(P-ESI)
            3728                     
            3729                     !    ALTERNATIVE
            3730                     !  ; Source: Murphy and Koop, Review of the vapour pressure of ice and
            3731                     !             supercooled water for atmospheric applications, Q. J. R.
            3732                     !             Meteorol. Soc (2005), 131, pp. 1539-1565.
            3733                     !     ESI = EXP(9.550426 - 5723.265/T + 3.53068*ALOG(T) - 0.00728332*T)
            3734                     
            3735                           END FUNCTION RSIF

            1817     5                           prg_rcg(k) = MIN(DBLE(rr(k)*odts), prg_rcg(k))
            1818     5                           prr_rcg(k) = -prg_rcg(k)
            1819     5                           pnr_rcg(k) = tnr_racg(idx_g1,idx_g,idx_r1,idx_r)            &   ! RAIN2M
            1820     5                                        + tnr_gacr(idx_g1,idx_g,idx_r1,idx_r)
            1821     5                           pnr_rcg(k) = MIN(DBLE(nr(k)*odts), pnr_rcg(k))
            1822     5                          else
            1823     5                           prr_rcg(k) = tcg_racg(idx_g1,idx_g,idx_r1,idx_r)
            1824     5                           prr_rcg(k) = MIN(DBLE(rg(k)*odts), prr_rcg(k))
            1825     5                           prg_rcg(k) = -prr_rcg(k)
            1826     5                          endif
            1827     4                         endif
            1828     3                        endif
            1829     2               
            1830     2               !+---+-----------------------------------------------------------------+
            1831     2               !..Next IF block handles only those processes below 0C.
            1832     2               !+---+-----------------------------------------------------------------+
            1833     2               
            1834     3                        if (temp(k).lt.T_0) then
            1835     3               
            1836     3                         vts_boost(k) = 1.0
            1837     3                         rate_max = (qv(k)-qvsi(k))*rho(k)*odts*0.999
            1838     3               
            1839     3               !..Freezing of water drops into graupel/cloud ice (Bigg 1953).
            1840     4                         if (rr(k).gt. r_r(1)) then
            1841     4                          prg_rfz(k) = tpg_qrfz(idx_r,idx_r1,idx_tc)*odts
            1842     4                          pri_rfz(k) = tpi_qrfz(idx_r,idx_r1,idx_tc)*odts
            1843     4                          pni_rfz(k) = tni_qrfz(idx_r,idx_r1,idx_tc)*odts
            1844     4                          pnr_rfz(k) = tnr_qrfz(idx_r,idx_r1,idx_tc)*odts                 ! RAIN2M
            1845     4                          pnr_rfz(k) = MIN(DBLE(nr(k)*odts), pnr_rfz(k))
            1846     4                         elseif (rr(k).gt. R1 .and. temp(k).lt.HGFR) then
            1847     4                          pri_rfz(k) = rr(k)*odts
            1848     4                          pnr_rfz(k) = nr(k)*odts                                         ! RAIN2M
            1849     4                          pni_rfz(k) = pnr_rfz(k)
            1850     4                         endif
            1851     4                         if (rc(k).gt. r_c(1)) then
            1852     4               !          pri_wfz(k) = tpi_qcfz(idx_c,idx_tc)*odts
            1853     4                          pri_wfz(k) = tpi_qcfz(idx_c,idx_tc,idx_lo)*odts
            1854     4                          pri_wfz(k) = MIN(DBLE(rc(k)*odts), pri_wfz(k))
            1855     4               !          pni_wfz(k) = tni_qcfz(idx_c,idx_tc)*odts
            1856     4                          pni_wfz(k) = tni_qcfz(idx_c,idx_tc,idx_lo)*odts
            1857     4               !          pni_wfz(k) = MIN(DBLE(Nt_c*odts), pri_wfz(k)/(2.*xm0i), &
            1858     4               !                               pni_wfz(k))
            1859     5                          if(islmski==1) then
            1860     5                            pni_wfz(k) = MIN(DBLE(Nt_cl*odts), pri_wfz(k)/(2.*xm0i), &
            1861     5                                               pni_wfz(k))
            1862     5                          else
            1863     5                            pni_wfz(k) = MIN(DBLE(Nt_co*odts), pri_wfz(k)/(2.*xm0i), &
            1864     5                                               pni_wfz(k))
            1865     5                          endif
            1866     4                         elseif (rc(k).gt. R1 .and. temp(k).lt.HGFR) then
            1867     4                          pri_wfz(k) = rc(k)*odts
            1868     4               !          pni_wfz(k) = MIN(DBLE(Nt_c*odts), pri_wfz(k)/(2.*xm0i), &
            1869     4               !                               pni_wfz(k))
            1870     5                          if(islmski == 1) then
            1871     5                            pni_wfz(k) = MIN(DBLE(Nt_cl*odts), pri_wfz(k)/(2.*xm0i), &
            1872     5                                               pni_wfz(k))
            1873     5                          else
            1874     5                            pni_wfz(k) = MIN(DBLE(Nt_co*odts), pri_wfz(k)/(2.*xm0i), &
            1875     5                                               pni_wfz(k))
            1876     5                          endif
            1877     4                         endif
            1878     3               
            1879     3               !..Nucleate ice from deposition & condensation freezing (Cooper 1986)
            1880     3               !.. but only if water sat and T<-12C or 25%+ ice supersaturated.
            1881     4                        if ( (ssati(k).ge. 0.25) .or. (ssatw(k).gt. eps &
            1882     4                                               .and. temp(k).lt.261.15) ) then
            1883     4                          xnc = MIN(250.E3, TNO*EXP(ATO*(T_0-temp(k))))
            1884     4                          xni = ni(k) + (pni_rfz(k)+pni_wfz(k))*dtsave
            1885     4                          pni_inu(k) = 0.5*(xnc-xni + abs(xnc-xni))*odts
            1886     4                          pri_inu(k) = MIN(DBLE(rate_max), xm0i*pni_inu(k))
            1887     4                          pni_inu(k) = pri_inu(k)/xm0i
            1888     4                         endif
            1889     3               
            1890     3               !..Deposition/sublimation of cloud ice (Srivastava & Coen 1992).
            1891     4                         if (L_qi(k)) then
            1892     4                          lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            1893     4                          ilami = 1./lami
            1894     4                          xDi = MAX(DBLE(D0i), (bm_i + mu_i + 1.) * ilami)
            1895     4                          xmi = am_i*xDi**bm_i
            1896     4                          oxmi = 1./xmi
            1897     4                          pri_ide(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            1898     4                                 *oig1*cig(5)*ni(k)*ilami
            1899     4               
            1900     5                          if (pri_ide(k) .lt. 0.0) then
            1901     5                           pri_ide(k) = MAX(DBLE(-ri(k)*odts), pri_ide(k), DBLE(rate_max))
            1902     5                           pni_ide(k) = pri_ide(k)*oxmi
            1903     5                           pni_ide(k) = MAX(DBLE(-ni(k)*odts), pni_ide(k))
            1904     5                          else
            1905     5                           pri_ide(k) = MIN(pri_ide(k), DBLE(rate_max))
            1906     5                           prs_ide(k) = (1.0D0-tpi_ide(idx_i,idx_i1))*pri_ide(k)
            1907     5                           pri_ide(k) = tpi_ide(idx_i,idx_i1)*pri_ide(k)
            1908     5                          endif
            1909     4               
            1910     4               
            1911     4               !..Some cloud ice needs to move into the snow category.  Use lookup
            1912     4               !.. table that resulted from explicit bin representation of distrib.
            1913     5                          if ( (idx_i.eq. ntb_i) .or. (xDi.gt. 5.0*D0s) ) then
            1914     5                           prs_iau(k) = ri(k)*.99*odts
            1915     5                           pni_iau(k) = ni(k)*.95*odts
            1916     5                          elseif (xDi.lt. 0.1*D0s) then
            1917     5                           prs_iau(k) = 0.
            1918     5                           pni_iau(k) = 0.
            1919     5                          else
            1920     5                           prs_iau(k) = tps_iaus(idx_i,idx_i1)*odts
            1921     5                           prs_iau(k) = MIN(DBLE(ri(k)*.99*odts), prs_iau(k))
            1922     5                           pni_iau(k) = tni_iaus(idx_i,idx_i1)*odts
            1923     5                           pni_iau(k) = MIN(DBLE(ni(k)*.95*odts), pni_iau(k))
            1924     5                          endif
            1925     4                         endif
            1926     3               
            1927     3               !..Deposition/sublimation of snow/graupel follows Srivastava & Coen
            1928     3               !.. (1992).
            1929     4                         if (L_qs(k)) then
            1930     4                          C_snow = C_sqrd + (tempc+15.)*(C_cube-C_sqrd)/(-30.+15.)
            1931     4                          C_snow = MAX(C_sqrd, MIN(C_snow, C_cube))
            1932     4                          prs_sde(k) = C_snow*t1_subl*diffu(k)*ssati(k)*rvs &
            1933     4                                       * (t1_qs_sd*smo1(k) &
            1934     4                                        + t2_qs_sd*rhof2(k)*vsc2(k)*smof(k))
            1935     5                          if (prs_sde(k).lt. 0.) then
            1936     5                           prs_sde(k) = MAX(DBLE(-rs(k)*odts), prs_sde(k), DBLE(rate_max))
            1937     5                          else
            1938     5                           prs_sde(k) = MIN(prs_sde(k), DBLE(rate_max))
            1939     5                          endif
            1940     4                         endif
            1941     3               
            1942     4                         if (L_qg(k) .and. ssati(k).lt. -eps) then
            1943     4                          prg_gde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            1944     4                              * N0_g(k) * (t1_qg_sd*ilamg(k)**cge(10) &
            1945     4                              + t2_qg_sd*vsc2(k)*rhof2(k)*ilamg(k)**cge(11))
            1946     5                          if (prg_gde(k).lt. 0.) then
            1947     5                           prg_gde(k) = MAX(DBLE(-rg(k)*odts), prg_gde(k), DBLE(rate_max))
            1948     5                          else
            1949     5                           prg_gde(k) = MIN(prg_gde(k), DBLE(rate_max))
            1950     5                          endif
            1951     4                         endif
            1952     3               
            1953     3               !..Snow collecting cloud ice.  In CE, assume Di<<Ds and vti=~0.
            1954     4                         if (L_qi(k)) then
            1955     4                          lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            1956     4                          ilami = 1./lami
            1957     4                          xDi = MAX(DBLE(D0i), (bm_i + mu_i + 1.) * ilami)
            1958     4                          xmi = am_i*xDi**bm_i
            1959     4                          oxmi = 1./xmi
            1960     5                          if (rs(k).ge. r_s(1)) then
            1961     5                           prs_sci(k) = t1_qs_qi*rhof(k)*Ef_si*ri(k)*smoe(k)
            1962     5                           pni_sci(k) = prs_sci(k) * oxmi
            1963     5                          endif
            1964     4               
            1965     4               !..Rain collecting cloud ice.  In CE, assume Di<<Dr and vti=~0.
            1966     5                          if (rr(k).ge. r_r(1) .and. mvd_r(k).gt. 4.*xDi) then
            1967     5                           lamr = 1./ilamr(k)
            1968     5                           pri_rci(k) = rhof(k)*t1_qr_qi*Ef_ri*ri(k)*N0_r(k) &
            1969     5                                          *((lamr+fv_r)**(-cre(9)))
            1970     5                           pnr_rci(k) = rhof(k)*t1_qr_qi*Ef_ri*ni(k)*N0_r(k)           &   ! RAIN2M
            1971     5                                          *((lamr+fv_r)**(-cre(9)))
            1972     5                           pni_rci(k) = pri_rci(k) * oxmi
            1973     5                           prr_rci(k) = rhof(k)*t2_qr_qi*Ef_ri*ni(k)*N0_r(k) &
            1974     5                                          *((lamr+fv_r)**(-cre(8)))
            1975     5                           prr_rci(k) = MIN(DBLE(rr(k)*odts), prr_rci(k))
            1976     5                           prg_rci(k) = pri_rci(k) + prr_rci(k)
            1977     5                          endif
            1978     4                         endif
            1979     3               
            1980     3               !..Ice multiplication from rime-splinters (Hallet & Mossop 1974).
            1981     4                         if (prg_gcw(k).gt. eps .and. tempc.gt.-8.0) then
            1982     4                          tf = 0.
            1983     5                          if (tempc.ge.-5.0 .and. tempc.lt.-3.0) then
            1984     5                           tf = 0.5*(-3.0 - tempc)
            1985     5                          elseif (tempc.gt.-8.0 .and. tempc.lt.-5.0) then
            1986     5                           tf = 0.33333333*(8.0 + tempc)
            1987     5                          endif
            1988     4                          pni_ihm(k) = 3.5E8*tf*prg_gcw(k)
            1989     4                          pri_ihm(k) = xm0i*pni_ihm(k)
            1990     4                          prs_ihm(k) = prs_scw(k)/(prs_scw(k)+prg_gcw(k)) &
            1991     4                                         * pri_ihm(k)
            1992     4                          prg_ihm(k) = prg_gcw(k)/(prs_scw(k)+prg_gcw(k)) &
            1993     4                                         * pri_ihm(k)
            1994     4                         endif
            1995     3               
            1996     3               !..A portion of rimed snow converts to graupel but some remains snow.
            1997     3               !.. Interp from 5 to 75% as riming factor increases from 5.0 to 30.0
            1998     3               !.. 0.028 came from (.75-.05)/(30.-5.).  This remains ad-hoc and should
            1999     3               !.. be revisited.
            2000     4                         if (prs_scw(k).gt.5.0*prs_sde(k) .and. &
            2001     4                                        prs_sde(k).gt.eps) then
            2002     4                          r_frac = MIN(30.0D0, prs_scw(k)/prs_sde(k))
            2003     4                          g_frac = MIN(0.75, 0.05 + (r_frac-5.)*.028)
            2004     4                          vts_boost(k) = MIN(1.5, 1.1 + (r_frac-5.)*.016)
            2005     4                          prg_scw(k) = g_frac*prs_scw(k)
            2006     4                          prs_scw(k) = (1. - g_frac)*prs_scw(k)
            2007     4                         endif
            2008     3               
            2009     3                        else
            2010     3               
            2011     3               !..Melt snow and graupel and enhance from collisions with liquid.
            2012     3               !.. We also need to sublimate snow and graupel if subsaturated.
            2013     4                         if (L_qs(k)) then
            2014     4                          prr_sml(k) = (tempc*tcond(k)-lvap0*diffu(k)*delQvs(k))       &
            2015     4                                     * (t1_qs_me*smo1(k) + t2_qs_me*rhof2(k)*vsc2(k)*smof(k))
            2016     4                          prr_sml(k) = prr_sml(k) + 4218.*olfus*tempc &
            2017     4                                                  * (prr_rcs(k)+prs_scw(k))
            2018     4                          prr_sml(k) = MIN(DBLE(rs(k)*odts), MAX(0.D0, prr_sml(k)))
            2019     4                          pnr_sml(k) = smo0(k)/rs(k)*prr_sml(k) * 10.0**(-0.75*tempc)      ! RAIN2M
            2020     4                          pnr_sml(k) = MIN(DBLE(smo0(k)*odts), pnr_sml(k))
            2021     4                          if (tempc.gt.3.5 .or. rs(k).lt.0.005E-3) pnr_sml(k)=0.0
            2022     4               
            2023     5                          if (ssati(k).lt. 0.) then
            2024     5                           prs_sde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            2025     5                                        * (t1_qs_sd*smo1(k) &
            2026     5                                         + t2_qs_sd*rhof2(k)*vsc2(k)*smof(k))
            2027     5                           prs_sde(k) = MAX(DBLE(-rs(k)*odts), prs_sde(k))
            2028     5                          endif
            2029     4                         endif
            2030     3               
            2031     4                         if (L_qg(k)) then
            2032     4                          prr_gml(k) = (tempc*tcond(k)-lvap0*diffu(k)*delQvs(k))       &
            2033     4                                     * N0_g(k)*(t1_qg_me*ilamg(k)**cge(10)             &
            2034     4                                     + t2_qg_me*rhof2(k)*vsc2(k)*ilamg(k)**cge(11))
            2035     4               !-GT       prr_gml(k) = prr_gml(k) + 4218.*olfus*tempc &
            2036     4               !-GT                               * (prr_rcg(k)+prg_gcw(k))
            2037     4                          prr_gml(k) = MIN(DBLE(rg(k)*odts), MAX(0.D0, prr_gml(k)))
            2038     4                          pnr_gml(k) = N0_g(k)*cgg(2)*ilamg(k)**cge(2) / rg(k)         &   ! RAIN2M
            2039     4                                     * prr_gml(k) * 10.0**(-1.5*tempc)
            2040     4                          if (tempc.gt.7.5 .or. rg(k).lt.0.005E-3) pnr_gml(k)=0.0
            2041     4               
            2042     5                          if (ssati(k).lt. 0.) then
            2043     5                           prg_gde(k) = C_cube*t1_subl*diffu(k)*ssati(k)*rvs &
            2044     5                               * N0_g(k) * (t1_qg_sd*ilamg(k)**cge(10) &
            2045     5                               + t2_qg_sd*vsc2(k)*rhof2(k)*ilamg(k)**cge(11))
            2046     5                           prg_gde(k) = MAX(DBLE(-rg(k)*odts), prg_gde(k))
            2047     5                          endif
            2048     4                         endif
            2049     3               
            2050     3               !.. This change will be required if users run adaptive time step that
            2051     3               !.. results in delta-t that is generally too long to allow cloud water
            2052     3               !.. collection by snow/graupel above melting temperature.
            2053     3               !.. Credit to Bjorn-Egil Nygaard for discovering.
            2054     4                         if (dt .gt. 120.) then
            2055     4                            prr_rcw(k)=prr_rcw(k)+prs_scw(k)+prg_gcw(k)
            2056     4                            prs_scw(k)=0.
            2057     4                            prg_gcw(k)=0.
            2058     4                         endif
            2059     3               
            2060     3                        endif
            2061     2               
            2062     2                     enddo
            2063     1                     endif
            2064                     
            2065                     !+---+-----------------------------------------------------------------+
            2066                     !..Ensure we do not deplete more hydrometeor species than exists.
            2067                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 42
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prr_rcw, prs_scw, prg_scw, prr_wau
                                   <<<      prg_gcw, pri_wfz, pri_ide, pri_inu
                                   <<<      prs_ide, prs_sde, prg_gde, rc, qv, qvsi
                                   <<<      L_qc, pni_ide
                                   <<<    PREFETCH(SOFT) : 48
                                   <<<     SEQUENTIAL : 48
                                   <<<      prs_iau: 2, pri_rci: 2, prs_sci: 2
                                   <<<      prr_rcs: 2, ri: 2, L_qi: 2, pri_rfz: 2
                                   <<<      prr_rcg: 2, prr_rci: 2, prg_rfz: 2
                                   <<<      rr: 2, L_qr: 2, rs: 2, prr_sml: 2
                                   <<<      prs_ihm: 2, prs_rcs: 2, L_qs: 2, temp: 2
                                   <<<      rg: 2, L_qg: 2, prg_ihm: 2, prr_gml: 2
                                   <<<      prg_rcg: 2, pri_ihm: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 19
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2068     1  pp    v            do k = kts, kte
            2069     1               
            2070     1               !..If ice supersaturated, ensure sum of depos growth terms does not
            2071     1               !.. deplete more vapor than possibly exists.  If subsaturated, limit
            2072     1               !.. sum of sublimation terms such that vapor does not reproduce ice
            2073     1               !.. supersat again.
            2074     1   p    v               sump = pri_inu(k) + pri_ide(k) + prs_ide(k) &
            2075     1                             + prs_sde(k) + prg_gde(k)
            2076     1   p    v               rate_max = (qv(k)-qvsi(k))*odts*0.999
            2077     2   p    v               if ( (sump.gt. eps .and. sump.gt. rate_max) .or. &
            2078     2                             (sump.lt. -eps .and. sump.lt. rate_max) ) then
            2079     2   p    v                ratio = rate_max/sump
            2080     2   p    v                pri_inu(k) = pri_inu(k) * ratio
            2081     2   p    v                pri_ide(k) = pri_ide(k) * ratio
            2082     2   p    v                pni_ide(k) = pni_ide(k) * ratio
            2083     2   p    v                prs_ide(k) = prs_ide(k) * ratio
            2084     2   p    v                prs_sde(k) = prs_sde(k) * ratio
            2085     2   p    v                prg_gde(k) = prg_gde(k) * ratio
            2086     2   p    v               endif
            2087     1               
            2088     1               !..Cloud water conservation.
            2089     1   p    v               sump = -prr_wau(k) - pri_wfz(k) - prr_rcw(k) &
            2090     1                               - prs_scw(k) - prg_scw(k) - prg_gcw(k)
            2091     1   p    v               rate_max = -rc(k)*odts
            2092     2   p    v               if (sump.lt. rate_max .and. L_qc(k)) then
            2093     2   p    v                ratio = rate_max/sump
            2094     2   p    v                prr_wau(k) = prr_wau(k) * ratio
            2095     2   p    v                pri_wfz(k) = pri_wfz(k) * ratio
            2096     2   p    v                prr_rcw(k) = prr_rcw(k) * ratio
            2097     2   p    v                prs_scw(k) = prs_scw(k) * ratio
            2098     2   p    v                prg_scw(k) = prg_scw(k) * ratio
            2099     2   p    v                prg_gcw(k) = prg_gcw(k) * ratio
            2100     2   p    v               endif
            2101     1               
            2102     1               !..Cloud ice conservation.
            2103     1   p    v               sump = pri_ide(k) - prs_iau(k) - prs_sci(k) &
            2104     1                               - pri_rci(k)
            2105     1   p    v               rate_max = -ri(k)*odts
            2106     2   p    v               if (sump.lt. rate_max .and. L_qi(k)) then
            2107     2   p    v                ratio = rate_max/sump
            2108     2   p    v                pri_ide(k) = pri_ide(k) * ratio
            2109     2   p    v                prs_iau(k) = prs_iau(k) * ratio
            2110     2   p    v                prs_sci(k) = prs_sci(k) * ratio
            2111     2   p    v                pri_rci(k) = pri_rci(k) * ratio
            2112     2   p    v               endif
            2113     1               
            2114     1               !..Rain conservation.
            2115     1   p    v               sump = -prg_rfz(k) - pri_rfz(k) - prr_rci(k) &
            2116     1                               + prr_rcs(k) + prr_rcg(k)
            2117     1   p    v               rate_max = -rr(k)*odts
            2118     2   p    v               if (sump.lt. rate_max .and. L_qr(k)) then
            2119     2   p    v                ratio = rate_max/sump
            2120     2   p    v                prg_rfz(k) = prg_rfz(k) * ratio
            2121     2   p    v                pri_rfz(k) = pri_rfz(k) * ratio
            2122     2   p    v                prr_rci(k) = prr_rci(k) * ratio
            2123     2   p    v                prr_rcs(k) = prr_rcs(k) * ratio
            2124     2   p    v                prr_rcg(k) = prr_rcg(k) * ratio
            2125     2   p    v               endif
            2126     1               
            2127     1               !..Snow conservation.
            2128     1   p    v               sump = prs_sde(k) - prs_ihm(k) - prr_sml(k) &
            2129     1                               + prs_rcs(k)
            2130     1   p    v               rate_max = -rs(k)*odts
            2131     2   p    v               if (sump.lt. rate_max .and. L_qs(k)) then
            2132     2   p    v                ratio = rate_max/sump
            2133     2   p    v                prs_sde(k) = prs_sde(k) * ratio
            2134     2   p    v                prs_ihm(k) = prs_ihm(k) * ratio
            2135     2   p    v                prr_sml(k) = prr_sml(k) * ratio
            2136     2   p    v                prs_rcs(k) = prs_rcs(k) * ratio
            2137     2   p    v               endif
            2138     1               
            2139     1               !..Graupel conservation.
            2140     1   p    v               sump = prg_gde(k) - prg_ihm(k) - prr_gml(k) &
            2141     1                             + prg_rcg(k)
            2142     1   p    v               rate_max = -rg(k)*odts
            2143     2   p    v               if (sump.lt. rate_max .and. L_qg(k)) then
            2144     2   p    v                ratio = rate_max/sump
            2145     2   p    v                prg_gde(k) = prg_gde(k) * ratio
            2146     2   p    v                prg_ihm(k) = prg_ihm(k) * ratio
            2147     2   p    v                prr_gml(k) = prr_gml(k) * ratio
            2148     2   p    v                prg_rcg(k) = prg_rcg(k) * ratio
            2149     2   p    v               endif
            2150     1               
            2151     1               !..Re-enforce proper mass conservation for subsequent elements in case
            2152     1               !.. any of the above terms were altered.  Thanks P. Blossey. 2009Sep28
            2153     1   p    v               pri_ihm(k) = prs_ihm(k) + prg_ihm(k)
            2154     1   p    v               ratio = MIN( ABS(prr_rcg(k)), ABS(prg_rcg(k)) )
            2155     1   p    v               prr_rcg(k) = ratio * SIGN(1.0, SNGL(prr_rcg(k)))
            2156     1   p    v               prg_rcg(k) = -prr_rcg(k)
            2157     2   p    v               if (temp(k).gt.T_0) then
            2158     2   p    v                  ratio = MIN( ABS(prr_rcs(k)), ABS(prs_rcs(k)) )
            2159     2   p    v                  prr_rcs(k) = ratio * SIGN(1.0, SNGL(prr_rcs(k)))
            2160     2   p    v                  prs_rcs(k) = -prr_rcs(k)
            2161     2   p    v               endif
            2162     1               
            2163     1   p    v            enddo
            2164                     
            2165                     !+---+-----------------------------------------------------------------+
            2166                     !..Calculate tendencies of all species but constrain the number of ice
            2167                     !.. to reasonable values.
            2168                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 14
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      prg_scw, prs_sci, temp, rho, pri_inu
                                   <<<      pri_ide, prs_ide, prs_sde, prg_gde
                                   <<<      qvten, prr_wau, pri_wfz, prr_rcw
                                   <<<      prs_scw, prg_gcw, qcten
                                   <<<    PREFETCH(SOFT) : 92
                                   <<<     SEQUENTIAL : 92
                                   <<<      pri_ihm: 2, pri_rfz: 2, pri_rci: 2
                                   <<<      prs_iau: 2, prg_rci: 2, qiten: 2
                                   <<<      prg_ihm: 2, prs_rcs: 2, prr_sml: 2
                                   <<<      prs_ihm: 2, qsten: 2, prg_rcg: 2
                                   <<<      prg_rfz: 2, prr_gml: 2, prg_rcs: 2
                                   <<<      qgten: 2, lvap: 2, ocp: 2, prr_rci: 2
                                   <<<      prr_rcs: 2, tten: 2, prr_rcg: 2
                                   <<<      pni_ide: 2, pni_inu: 2, pni_ihm: 2
                                   <<<      pni_wfz: 2, pni_rfz: 2, pni_iau: 2
                                   <<<      ni1d: 2, pni_sci: 2, qi1d: 2, pni_rci: 2
                                   <<<      niten: 2, qr1d: 2, nr1d: 2, qrten: 2
                                   <<<      pnr_wau: 2, pnr_sml: 2, pnr_gml: 2
                                   <<<      pnr_rci: 2, pnr_rfz: 2, pnr_rcr: 2
                                   <<<      pnr_rcg: 2, pnr_rcs: 2, nrten: 2
                                   <<<      mvd_r: 2

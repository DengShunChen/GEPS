            2511     3   p    v                endif
            2512     2   p    v                vsc2(k) = SQRT(rho(k)/visco(k))
            2513     2   p    v                lvap(k) = lvap0 + (2106.0 - 4218.0)*tempc
            2514     2   p    v                tcond(k) = (5.69 + 0.0168*tempc)*1.0E-5 * 418.936
            2515     2   p    v                ocp(k) = 1./(Cp*(1.+0.887*qv(k)))
            2516     2               
            2517     2   p    v                rvs = rho(k)*qvs(k)
            2518     2   p    v                rvs_p = rvs*otemp*(lvap(k)*otemp*oRv - 1.)
            2519     2   p    v                rvs_pp = rvs * ( otemp*(lvap(k)*otemp*oRv - 1.) &
            2520     2                                         *otemp*(lvap(k)*otemp*oRv - 1.) &
            2521     2                                         + (-2.*lvap(k)*otemp*otemp*otemp*oRv) &
            2522     2                                         + otemp*otemp)
            2523     2   p    v                gamsc = lvap(k)*diffu(k)/tcond(k) * rvs_p
            2524     2   p    v                alphsc = 0.5*(gamsc/(1.+gamsc))*(gamsc/(1.+gamsc)) &
            2525     2                                    * rvs_pp/rvs_p * rvs/rvs_p
            2526     2   p    v                alphsc = MAX(1.E-9, alphsc)
            2527     2   p    v                xsat   = MIN(-1.E-9, ssatw(k))
            2528     2   p    v                t1_evap = 2.*PI*( 1.0 - alphsc*xsat  &
            2529     2                                + 2.*alphsc*alphsc*xsat*xsat  &
            2530     2                                - 5.*alphsc*alphsc*alphsc*xsat*xsat*xsat ) &
            2531     2                                / (1.+gamsc)
            2532     2               
            2533     2   p    v                lamr = 1./ilamr(k)
            2534     2               !..Rapidly eliminate near zero values when low humidity (<95%)
            2535     3   p    v                if (qv(k)/qvs(k) .lt. 0.95 .AND. rr(k)/rho(k).le.1.E-8) then
            2536     3   p    v                prv_rev(k) = rr(k)/rho(k)*odts
            2537     3   p    v                else
            2538     3   p    v                prv_rev(k) = t1_evap*diffu(k)*(-ssatw(k))*N0_r(k)*rvs &
            2539     3                             * (t1_qr_ev*ilamr(k)**cre(10) &
            2540     3                             + t2_qr_ev*vsc2(k)*rhof2(k)*((lamr+0.5*fv_r)**(-cre(11))))
            2541     3   p    v                rate_max = MIN((rr(k)/rho(k)*odts), (qvs(k)-qv(k))*odts)

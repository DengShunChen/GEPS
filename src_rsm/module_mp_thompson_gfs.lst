            2467     1                     do k = kts, kte
            2468     2                        if ( (ssatw(k).gt. eps) .or. (ssatw(k).lt. -eps .and. &
            2469     2                                  L_qc(k)) ) then
            2470     2                         clap = (qv(k)-qvs(k))/(1. + lvt2(k)*qvs(k))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            2471     3   s   fs                do n = 1, 3
            2472     3   s   fs                   fcd = qvs(k)* EXP(lvt2(k)*clap) - qv(k) + clap
            2473     3   s   fs                   dfcd = qvs(k)*lvt2(k)* EXP(lvt2(k)*clap) + 1.
            2474     3   s   fs                   clap = clap - fcd/dfcd
            2475     3   s   fs                enddo
            2476     2                         xrc = rc(k) + clap * rho(k)
            2477     3                         if (xrc.gt. 0.0) then
            2478     3                            prw_vcd(k) = clap*odt
            2479     3                         else
            2480     3                            prw_vcd(k) = -rc(k)/rho(k)*odts
            2481     3                         endif
            2482     2               
            2483     2                         qcten(k) = qcten(k) + prw_vcd(k)
            2484     2                         qvten(k) = qvten(k) - prw_vcd(k)
            2485     2                         tten(k) = tten(k) + lvap(k)*ocp(k)*prw_vcd(k)*(1-IFDRY)
            2486     2                         rc(k) = MAX(R1, (qc1d(k) + DT*qcten(k))*rho(k))
            2487     2                         qv(k) = MAX(1.E-10, qv1d(k) + DT*qvten(k))
            2488     2                         temp(k) = t1d(k) + DT*tten(k)
            2489     2                         rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            2490     2    i                    qvs(k) = rslf(pres(k), temp(k))
            2491     2                         ssatw(k) = qv(k)/qvs(k) - 1.
            2492     2                        endif
            2493     1                     enddo

             421     1    i                ccg(3,1) = WGAMMA(cce(3,1))
             422     1    i                ccg(3,2) = WGAMMA(cce(3,2))
             423     1                     ocg1(1) = 1./ccg(1,1)
             424     1                     ocg1(2) = 1./ccg(1,2)
             425     1                     ocg2(1) = 1./ccg(2,1)
             426     1                     ocg2(2) = 1./ccg(2,2)
             427     1               
             428     1                     cie(1) = mu_i + 1.
             429     1                     cie(2) = bm_i + mu_i + 1.
             430     1                     cie(3) = bm_i + mu_i + bv_i + 1.
             431     1                     cie(4) = mu_i + bv_i + 1.
             432     1                     cie(5) = mu_i + 2.
             433     1                     cie(6) = bm_i*0.5 + mu_i + bv_i + 1.
             434     1                     cie(7) = bm_i*0.5 + mu_i + 1.
             435     1    i                cig(1) = WGAMMA(cie(1))
             436     1    i                cig(2) = WGAMMA(cie(2))
             437     1    i                cig(3) = WGAMMA(cie(3))
             438     1    i                cig(4) = WGAMMA(cie(4))
             439     1    i                cig(5) = WGAMMA(cie(5))
             440     1    i                cig(6) = WGAMMA(cie(6))
             441     1    i                cig(7) = WGAMMA(cie(7))
             442     1                     oig1 = 1./cig(1)
             443     1                     oig2 = 1./cig(2)
             444     1                     obmi = 1./bm_i
             445     1               
             446     1                     cre(1) = bm_r + 1.
             447     1                     cre(2) = mu_r + 1.
             448     1                     cre(3) = bm_r + mu_r + 1.
             449     1                     cre(4) = bm_r*2. + mu_r + 1.
             450     1                     cre(5) = mu_r + bv_r + 1.
             451     1                     cre(6) = bm_r + mu_r + bv_r + 1.
             452     1                     cre(7) = bm_r*0.5 + mu_r + bv_r + 1.
             453     1                     cre(8) = bm_r + mu_r + bv_r + 3.
             454     1                     cre(9) = mu_r + bv_r + 3.
             455     1                     cre(10) = mu_r + 2.
             456     1                     cre(11) = 0.5*(bv_r + 5. + 2.*mu_r)
             457     1                     cre(12) = bm_r*0.5 + mu_r + 1.
             458     1                     cre(13) = bm_r*2. + mu_r + bv_r + 1.

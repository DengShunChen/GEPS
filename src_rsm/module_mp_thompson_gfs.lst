 Module "module_mp_thompson"
  (inc)(line-no.)(nest)(optimize)
               1                     !+---+-----------------------------------------------------------------+
               2                     !.. This subroutine computes the moisture tendencies of water vapor,
               3                     !.. cloud droplets, rain, cloud ice (pristine), snow, and graupel.
               4                     !.. Prior to WRFv2.2 this code was based on Reisner et al (1998), but
               5                     !.. few of those pieces remain.  A complete description is now found in
               6                     !.. Thompson, G., P. R. Field, R. M. Rasmussen, and W. D. Hall, 2008:
               7                     !.. Explicit Forecasts of winter precipitation using an improved bulk
               8                     !.. microphysics scheme. Part II: Implementation of a new snow
               9                     !.. parameterization.  Mon. Wea. Rev., 136, 5095-5115.
              10                     !.. Prior to WRFv3.1, this code was single-moment rain prediction as
              11                     !.. described in the reference above, but in v3.1 and higher, the
              12                     !.. scheme is two-moment rain (predicted rain number concentration).
              13                     !..
              14                     !.. Most importantly, users may wish to modify the prescribed number of
              15                     !.. cloud droplets (Nt_c; see guidelines mentioned below).  Otherwise,
              16                     !.. users may alter the rain and graupel size distribution parameters
              17                     !.. to use exponential (Marshal-Palmer) or generalized gamma shape.
              18                     !.. The snow field assumes a combination of two gamma functions (from
              19                     !.. Field et al. 2005) and would require significant modifications
              20                     !.. throughout the entire code to alter its shape as well as accretion
              21                     !.. rates.  Users may also alter the constants used for density of rain,
              22                     !.. graupel, ice, and snow, but the latter is not constant when using
              23                     !.. Paul Field's snow distribution and moments methods.  Other values
              24                     !.. users can modify include the constants for mass and/or velocity
              25                     !.. power law relations and assumed capacitances used in deposition/
              26                     !.. sublimation/evaporation/melting.
              27                     !.. Remaining values should probably be left alone.
              28                     !..
              29                     !..Author: Greg Thompson, NCAR-RAL, gthompsn@ucar.edu, 303-497-2805
              30                     !..Last modified: 27 Jul 2012
              31                     !+---+-----------------------------------------------------------------+
              32                     !wrft:model_layer:physics
              33                     !+---+-----------------------------------------------------------------+
              34                     !
              35                           MODULE module_mp_thompson
              36                     
              37                           USE physcons,   ONLY : g => con_g
              38                           USE module_mp_radar
              39                     
              40                           IMPLICIT NONE
              41                     
              42                           LOGICAL, PARAMETER, PRIVATE:: iiwarm = .false.
              43                           INTEGER, PARAMETER, PRIVATE:: IFDRY = 0
              44                           REAL, PARAMETER, PRIVATE:: T_0 = 273.15
              45                           REAL, PARAMETER, PRIVATE:: PI = 3.1415926536
              46                     
              47                     !..Densities of rain, snow, graupel, and cloud ice.
              48                           REAL, PARAMETER, PRIVATE:: rho_w = 1000.0
              49                           REAL, PARAMETER, PRIVATE:: rho_s = 100.0
              50                           REAL, PARAMETER, PRIVATE:: rho_g = 500.0
              51                           REAL, PARAMETER, PRIVATE:: rho_i = 890.0
              52                     
              53                     !..Prescribed number of cloud droplets.  Set according to known data or
              54                     !.. roughly 100 per cc (100.E6 m^-3) for Maritime cases and
              55                     !.. 300 per cc (300.E6 m^-3) for Continental.  Gamma shape parameter,
              56                     !.. mu_c, calculated based on Nt_c is important in autoconversion
              57                     !.. scheme.
              58                     !     REAL, PARAMETER, PRIVATE:: Nt_c = 100.E6
              59                           REAL, PARAMETER, PRIVATE:: Nt_co = 100.E6
              60                           REAL, PARAMETER, PRIVATE:: Nt_cl = 300.E6
              61                     
              62                     !..Generalized gamma distributions for rain, graupel and cloud ice.
              63                     !.. N(D) = N_0 * D**mu * exp(-lamda*D);  mu=0 is exponential.
              64                           REAL, PARAMETER, PRIVATE:: mu_r = 0.0
              65                           REAL, PARAMETER, PRIVATE:: mu_g = 0.0
              66                           REAL, PARAMETER, PRIVATE:: mu_i = 0.0
              67                     !     REAL, PRIVATE:: mu_c
              68                           REAL, PRIVATE:: mu_co, mu_cl
              69                     
              70                     !..Sum of two gamma distrib for snow (Field et al. 2005).
              71                     !.. N(D) = M2**4/M3**3 * [Kap0*exp(-M2*Lam0*D/M3)
              72                     !..    + Kap1*(M2/M3)**mu_s * D**mu_s * exp(-M2*Lam1*D/M3)]
              73                     !.. M2 and M3 are the (bm_s)th and (bm_s+1)th moments respectively
              74                     !.. calculated as function of ice water content and temperature.
              75                           REAL, PARAMETER, PRIVATE:: mu_s = 0.6357
              76                           REAL, PARAMETER, PRIVATE:: Kap0 = 490.6
              77                           REAL, PARAMETER, PRIVATE:: Kap1 = 17.46
              78                           REAL, PARAMETER, PRIVATE:: Lam0 = 20.78
              79                           REAL, PARAMETER, PRIVATE:: Lam1 = 3.29
              80                     
              81                     !..Y-intercept parameter for graupel is not constant and depends on
              82                     !.. mixing ratio.  Also, when mu_g is non-zero, these become equiv
              83                     !.. y-intercept for an exponential distrib and proper values are
              84                     !.. computed based on same mixing ratio and total number concentration.
              85                           REAL, PARAMETER, PRIVATE:: gonv_min = 1.E4
              86                           REAL, PARAMETER, PRIVATE:: gonv_max = 3.E6
              87                     
              88                     !..Mass power law relations:  mass = am*D**bm
              89                     !.. Snow from Field et al. (2005), others assume spherical form.
              90                           REAL, PARAMETER, PRIVATE:: am_r = PI*rho_w/6.0
              91                           REAL, PARAMETER, PRIVATE:: bm_r = 3.0
              92                           REAL, PARAMETER, PRIVATE:: am_s = 0.069
              93                           REAL, PARAMETER, PRIVATE:: bm_s = 2.0
              94                           REAL, PARAMETER, PRIVATE:: am_g = PI*rho_g/6.0
              95                           REAL, PARAMETER, PRIVATE:: bm_g = 3.0
              96                           REAL, PARAMETER, PRIVATE:: am_i = PI*rho_i/6.0
              97                           REAL, PARAMETER, PRIVATE:: bm_i = 3.0
              98                     
              99                     !..Fallspeed power laws relations:  v = (av*D**bv)*exp(-fv*D)
             100                     !.. Rain from Ferrier (1994), ice, snow, and graupel from
             101                     !.. Thompson et al (2008). Coefficient fv is zero for graupel/ice.
             102                           REAL, PARAMETER, PRIVATE:: av_r = 4854.0
             103                           REAL, PARAMETER, PRIVATE:: bv_r = 1.0
             104                           REAL, PARAMETER, PRIVATE:: fv_r = 195.0
             105                           REAL, PARAMETER, PRIVATE:: av_s = 40.0
             106                           REAL, PARAMETER, PRIVATE:: bv_s = 0.55
             107                           REAL, PARAMETER, PRIVATE:: fv_s = 100.0
             108                           REAL, PARAMETER, PRIVATE:: av_g = 442.0
             109                           REAL, PARAMETER, PRIVATE:: bv_g = 0.89
             110                           REAL, PARAMETER, PRIVATE:: av_i = 1847.5
             111                           REAL, PARAMETER, PRIVATE:: bv_i = 1.0
             112                     
             113                     !..Capacitance of sphere and plates/aggregates: D**3, D**2
             114                           REAL, PARAMETER, PRIVATE:: C_cube = 0.5
             115                           REAL, PARAMETER, PRIVATE:: C_sqrd = 0.3
             116                     
             117                     !..Collection efficiencies.  Rain/snow/graupel collection of cloud
             118                     !.. droplets use variables (Ef_rw, Ef_sw, Ef_gw respectively) and
             119                     !.. get computed elsewhere because they are dependent on stokes
             120                     !.. number.
             121                           REAL, PARAMETER, PRIVATE:: Ef_si = 0.05
             122                           REAL, PARAMETER, PRIVATE:: Ef_rs = 0.95
             123                           REAL, PARAMETER, PRIVATE:: Ef_rg = 0.75
             124                           REAL, PARAMETER, PRIVATE:: Ef_ri = 0.95
             125                     
             126                     !..Minimum microphys values
             127                     !.. R1 value, 1.E-12, cannot be set lower because of numerical
             128                     !.. problems with Paul Field's moments and should not be set larger
             129                     !.. because of truncation problems in snow/ice growth.
             130                           REAL, PARAMETER, PRIVATE:: R1 = 1.E-12
             131                           REAL, PARAMETER, PRIVATE:: R2 = 1.E-6
             132                           REAL, PARAMETER, PRIVATE:: eps = 1.E-15
             133                     
             134                     !..Constants in Cooper curve relation for cloud ice number.
             135                           REAL, PARAMETER, PRIVATE:: TNO = 5.0
             136                           REAL, PARAMETER, PRIVATE:: ATO = 0.304
             137                     
             138                     !..Rho_not used in fallspeed relations (rho_not/rho)**.5 adjustment.
             139                           REAL, PARAMETER, PRIVATE:: rho_not = 101325.0/(287.05*298.0)
             140                     
             141                     !..Schmidt number
             142                           REAL, PARAMETER, PRIVATE:: Sc = 0.632
             143                           REAL, PRIVATE:: Sc3
             144                     
             145                     !..Homogeneous freezing temperature
             146                           REAL, PARAMETER, PRIVATE:: HGFR = 235.16
             147                     
             148                     !..Water vapor and air gas constants at constant pressure
             149                           REAL, PARAMETER, PRIVATE:: Rv = 461.5
             150                           REAL, PARAMETER, PRIVATE:: oRv = 1./Rv
             151                           REAL, PARAMETER, PRIVATE:: R = 287.04
             152                           REAL, PARAMETER, PRIVATE:: Cp = 1004.0
             153                     
             154                     !..Enthalpy of sublimation, vaporization, and fusion at 0C.
             155                           REAL, PARAMETER, PRIVATE:: lsub = 2.834E6
             156                           REAL, PARAMETER, PRIVATE:: lvap0 = 2.5E6
             157                           REAL, PARAMETER, PRIVATE:: lfus = lsub - lvap0
             158                           REAL, PARAMETER, PRIVATE:: olfus = 1./lfus
             159                     
             160                     !..Ice initiates with this mass (kg), corresponding diameter calc.
             161                     !..Min diameters and mass of cloud, rain, snow, and graupel (m, kg).
             162                           REAL, PARAMETER, PRIVATE:: xm0i = 1.E-12
             163                           REAL, PARAMETER, PRIVATE:: D0c = 1.E-6
             164                           REAL, PARAMETER, PRIVATE:: D0r = 50.E-6
             165                           REAL, PARAMETER, PRIVATE:: D0s = 200.E-6
             166                           REAL, PARAMETER, PRIVATE:: D0g = 250.E-6
             167                           REAL, PRIVATE:: D0i, xm0s, xm0g
             168                     
             169                     !..Lookup table dimensions
             170                           INTEGER, PARAMETER, PRIVATE:: nbins = 100
             171                           INTEGER, PARAMETER, PRIVATE:: nbc = nbins
             172                           INTEGER, PARAMETER, PRIVATE:: nbi = nbins
             173                           INTEGER, PARAMETER, PRIVATE:: nbr = nbins
             174                           INTEGER, PARAMETER, PRIVATE:: nbs = nbins
             175                           INTEGER, PARAMETER, PRIVATE:: nbg = nbins
             176                           INTEGER, PARAMETER, PRIVATE:: ntb_c = 37
             177                           INTEGER, PARAMETER, PRIVATE:: ntb_i = 64
             178                           INTEGER, PARAMETER, PRIVATE:: ntb_r = 37
             179                           INTEGER, PARAMETER, PRIVATE:: ntb_s = 28
             180                           INTEGER, PARAMETER, PRIVATE:: ntb_g = 28
             181                           INTEGER, PARAMETER, PRIVATE:: ntb_g1 = 28
             182                           INTEGER, PARAMETER, PRIVATE:: ntb_r1 = 37
             183                           INTEGER, PARAMETER, PRIVATE:: ntb_i1 = 55
             184                           INTEGER, PARAMETER, PRIVATE:: ntb_t = 9
             185                           INTEGER, PRIVATE:: nic2, nii2, nii3, nir2, nir3, nis2, nig2, nig3
             186                     
             187                           DOUBLE PRECISION, DIMENSION(nbins+1):: xDx
             188                           DOUBLE PRECISION, DIMENSION(nbc):: Dc, dtc
             189                           DOUBLE PRECISION, DIMENSION(nbi):: Di, dti
             190                           DOUBLE PRECISION, DIMENSION(nbr):: Dr, dtr
             191                           DOUBLE PRECISION, DIMENSION(nbs):: Ds, dts
             192                           DOUBLE PRECISION, DIMENSION(nbg):: Dg, dtg
             193                     

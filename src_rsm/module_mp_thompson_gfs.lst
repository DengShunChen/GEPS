            2433     2   m    m            do k = kte, kts, -1
            2434     3   p    v               if (temp(k).lt.270.65 .and. L_qr(k) .and. mvd_r(k).gt.100.E-6) then
            2435     3   p    m                  xslw1 = 4.01 + dlog10(mvd_r(k))
            2436     3   p    v               else
            2437     3   p    s                  xslw1 = 0.01
            2438     3   p    m               endif
            2439     2   p    m               ygra1 = 4.31 + dlog10(max(5.E-5, rg(k)))
            2440     2   p    v               zans1 = 3.1 + (100./(300.*xslw1*ygra1/(10./xslw1+1.+0.25*ygra1)+30.+10.*ygra1))
            2441     2   p    v               N0_exp = 10.**(zans1)
            2442     2   p    v               N0_exp = MAX(DBLE(gonv_min), MIN(N0_exp, DBLE(gonv_max)))
            2443     2   s    s               N0_min = MIN(N0_exp, N0_min)

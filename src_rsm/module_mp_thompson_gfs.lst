             880     2   p    v                  ni1d(k) = ni(i,k)
             881     2   p    v                  nr1d(k) = nr(i,k)
             882     2   p    v                  nc1d(k) = Nt_c
             883     2   p    v               enddo
             884     1               
             885     1                        call mp_thompson(qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, 	&
             886     1                                     nr1d, t1d, p1d, dz1d, 				&
             887     1                                     pptrain, pptsnow, pptgraul, pptice, 		&
             888     1                                     islmsk(i),                             		&
             889     1                                     kts, kte, dt, i)
             890     1               
             891     1                        pcp_ra(i) = pptrain
             892     1                        pcp_sn(i) = pptsnow
             893     1                        pcp_gr(i) = pptgraul
             894     1                        pcp_ic(i) = pptice
             895     1                        RAINNCV(i) = (pptrain + pptsnow + pptgraul + pptice)/1000.
             896     1               !         RAINNC(i) = RAINNC(i) + pptrain + pptsnow + pptgraul + pptice
             897     1               !         IF ( PRESENT(snowncv) .AND. PRESENT(snownc) ) THEN
             898     1               !            SNOWNCV(i) = pptsnow + pptice
             899     1               !            SNOWNC(i) = SNOWNC(i) + pptsnow + pptice
             900     1               !         ENDIF
             901     1               !         IF ( PRESENT(graupelncv) .AND. PRESENT(graupelnc) ) THEN
             902     1               !            GRAUPELNCV(i) = pptgraul
             903     1               !            GRAUPELNC(i) = GRAUPELNC(i) + pptgraul
             904     1               !         ENDIF
             905     1                        SR(i) = (pptsnow + pptgraul + pptice)/(RAINNCV(i)*1000.+1.e-12)
             906     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qv1d, qi1d, qc1d, qr1d, qs1d, qg1d, ni1d
                                   <<<      nr1d, t1d
                                   <<< Loop-information  End >>>
             907     2   s    s               do k = kts, kte
             908     2               !           qv(i,k) = qv1d(k)
             909     2   m    v                  qv(i,k) = qv1d(k)/(1.+qv1d(k))
             910     2   p    v                  qc(i,k) = qc1d(k)
             911     2   p    v                  qi(i,k) = qi1d(k)
             912     2   p    v                  qr(i,k) = qr1d(k)
             913     2   p    v                  qs(i,k) = qs1d(k)
             914     2   p    v                  qg(i,k) = qg1d(k)
             915     2   p    v                  ni(i,k) = ni1d(k)
             916     2   p    v                  nr(i,k) = nr1d(k)
             917     2               !#ifdef WRF_CHEM
             918     2               !            rainprod(i,k,j) = rainprod1d(k)
             919     2               !            evapprod(i,k,j) = evapprod1d(k)
             920     2               !#endif
             921     2               !            th(i,k) = t1d(k)/pii(i,k)
             922     2   p    v                  tt(i,k) = t1d(k)
             923     3   s    s                  if (qc1d(k) .gt. qc_max) then
             924     3   s    s                   imax_qc = i
             925     3   s    s                   kmax_qc = k
             926     3   m    m                   qc_max = qc1d(k)
             927     3   p    v                  elseif (qc1d(k) .lt. 0.0) then
             928     3               !             write(*,*) 'WARNING, negative qc ', qc1d(k),               &
             929     3               !                        ' at i,k=', i,k
             930     3   p    v                  endif
             931     3   s    s                  if (qr1d(k) .gt. qr_max) then
             932     3   s    s                   imax_qr = i
             933     3   s    s                   kmax_qr = k
             934     3   m    m                   qr_max = qr1d(k)
             935     3   p    v                  elseif (qr1d(k) .lt. 0.0) then
             936     3               !             write(*,*) 'WARNING, negative qr ', qr1d(k),               &
             937     3               !                        ' at i,k=', i,k
             938     3   p    v                  endif
             939     3   s    s                  if (nr1d(k) .gt. nr_max) then
             940     3   s    s                   imax_nr = i
             941     3   s    s                   kmax_nr = k
             942     3   m    m                   nr_max = nr1d(k)
             943     3   p    v                  elseif (nr1d(k) .lt. 0.0) then
             944     3               !             write(*,*) 'WARNING, negative nr ', nr1d(k),         &
             945     3               !                        ' at i,k=', i,k
             946     3   p    v                  endif
             947     3   s    s                  if (qs1d(k) .gt. qs_max) then
             948     3   s    s                   imax_qs = i
             949     3   s    s                   kmax_qs = k
             950     3   m    m                   qs_max = qs1d(k)
             951     3   p    v                  elseif (qs1d(k) .lt. 0.0) then
             952     3               !             write(*,*) 'WARNING, negative qs ', qs1d(k),                &
             953     3               !                        ' at i,k=', i,k
             954     3   p    v                  endif
             955     3   s    s                  if (qi1d(k) .gt. qi_max) then
             956     3   s    s                   imax_qi = i
             957     3   s    s                   kmax_qi = k
             958     3   m    m                   qi_max = qi1d(k)
             959     3   p    v                  elseif (qi1d(k) .lt. 0.0) then
             960     3               !             write(*,*) 'WARNING, negative qi ', qi1d(k),                &
             961     3               !                        ' at i,k=', i,k
             962     3   p    v                  endif
             963     3   s    s                  if (qg1d(k) .gt. qg_max) then
             964     3   s    s                   imax_qg = i
             965     3   s    s                   kmax_qg = k
             966     3   m    m                   qg_max = qg1d(k)
             967     3   p    v                  elseif (qg1d(k) .lt. 0.0) then
             968     3               !             write(*,*) 'WARNING, negative qg ', qg1d(k),                &
             969     3               !                        ' at i,k=', i,k
             970     3   p    v                  endif
             971     3   s    s                  if (ni1d(k) .gt. ni_max) then
             972     3   s    s                   imax_ni = i
             973     3   s    s                   kmax_ni = k
             974     3   m    m                   ni_max = ni1d(k)
             975     3   p    v                  elseif (ni1d(k) .lt. 0.0) then
             976     3               !             write(*,*) 'WARNING, negative ni ', ni1d(k),                &
             977     3               !                        ' at i,k=', i,k
             978     3   p    v                  endif
             979     3   p    v                  if (qv1d(k) .lt. 0.0) then
             980     4   p    v                   if (k.lt.kte-2 .and. k.gt.kts+1) then
             981     4   m    m                      qv(i,k) = 0.5*(qv(i,k-1) + qv(i,k+1))
             982     4   p    v                   else
             983     4   m    v                      qv(i,k) = 1.E-7
             984     4   p    v                   endif
             985     3               !             write(*,*) 'WARNING, negative qv ', qv1d(k),                &
             986     3               !                        ' at i,k=', i,k
             987     3   p    v                  endif
             988     2   p    v               enddo
             989     1               
             990     2                        if (lradar) then
             991     2                         call calc_refl10cm (qv1d, qc1d, qr1d, nr1d, qs1d, qg1d,       &
             992     2                                     t1d, p1d, dBZ, kts, kte, i)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
             993     3  pp   2v                do k = kts, kte
             994     3   p   2v                   refl_10cm(i,k) = MAX(-35., dBZ(k))
             995     3   p   2v                enddo
             996     2                        endif
             997     1               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1067
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      re_qs1d, re_qi1d, re_qc1d
                                   <<< Loop-information  End >>>
             998     2  pp   2v                do k = kts, kte
             999     2   p   2v                   re_qc1d(k) = 2.51E-6
            1000     2   p   2v                   re_qi1d(k) = 10.01E-6
            1001     2   p   2v                   re_qs1d(k) = 10.01E-6
            1002     2   p   2v                enddo
            1003     1                         call calc_effectRad (t1d, p1d, qv1d, qc1d, nc1d, qi1d, ni1d, qs1d, &
            1004     1                                     islmsk(i), re_qc1d, re_qi1d, re_qs1d, kts, kte)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 208
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 56, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      re_qi1d, re_qc1d, re_qs1d
                                   <<< Loop-information  End >>>
            1005     2  pp    v                do k = kts, kte
            1006     2   p    v                   re_cloud(i,k)=MAX( 2.51E-6, MIN(re_qc1d(k), 50.E-6))*1.e6
            1007     2   p    v                   re_ice(i,k)  =MAX(10.01E-6, MIN(re_qi1d(k), 125.E-6))*1.e6
            1008     2   p    v                   re_snow(i,k) =MAX(10.01E-6, MIN(re_qs1d(k), 999.E-6))*1.e6
            1009     2   p    v                enddo
            1010     1                     enddo i_loop

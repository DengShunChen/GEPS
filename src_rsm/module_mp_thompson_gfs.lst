            2840     2  pp    v            do k = kts, kte
            2841     2   p    v               xri = MAX(0.0, qi1d(k) + qiten(k)*DT)
            2842     3   p    v               if ( (temp(k).gt. T_0) .and. (xri.gt. 0.0) ) then
            2843     3   p    v                qcten(k) = qcten(k) + xri*odt
            2844     3   p    v                qiten(k) = qiten(k) - xri*odt
            2845     3   p    v                niten(k) = -ni1d(k)*odt
            2846     3   p    v                tten(k) = tten(k) - lfus*ocp(k)*xri*odt*(1-IFDRY)
            2847     3   p    v               endif
            2848     2               
            2849     2   p    v               xrc = MAX(0.0, qc1d(k) + qcten(k)*DT)
            2850     3   p    v               if ( (temp(k).lt. HGFR) .and. (xrc.gt. 0.0) ) then
            2851     3   p    v                lfus2 = lsub - lvap(k)
            2852     3   p    v                qiten(k) = qiten(k) + xrc*odt
            2853     3   p    v                niten(k) = niten(k) + xrc/xm0i * odt
            2854     3   p    v                qcten(k) = qcten(k) - xrc*odt
            2855     3   p    v                tten(k) = tten(k) + lfus2*ocp(k)*xrc*odt*(1-IFDRY)
            2856     3   p    v               endif
            2857     2   p    v            enddo
            2858     1                     endif

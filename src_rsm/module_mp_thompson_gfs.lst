                                   <<< Loop-information  End >>>
            1179     1  pp    v            do k = kts, kte
            1180     1   p    v               tten(k) = 0.
            1181     1   p    v               qvten(k) = 0.
            1182     1   p    v               qcten(k) = 0.
            1183     1   p    v               qiten(k) = 0.
            1184     1   p    v               qrten(k) = 0.
            1185     1   p    v               qsten(k) = 0.
            1186     1   p    v               qgten(k) = 0.
            1187     1   p    v               niten(k) = 0.
            1188     1   p    v               nrten(k) = 0.
            1189     1               
            1190     1   p    v               prw_vcd(k) = 0.
            1191     1               
            1192     1   p    v               prv_rev(k) = 0.
            1193     1   p    v               prr_wau(k) = 0.
            1194     1   p    v               prr_rcw(k) = 0.
            1195     1   p    v               prr_rcs(k) = 0.
            1196     1   p    v               prr_rcg(k) = 0.
            1197     1   p    v               prr_sml(k) = 0.
            1198     1   p    v               prr_gml(k) = 0.
            1199     1   p    v               prr_rci(k) = 0.
            1200     1   p    v               pnr_wau(k) = 0.
            1201     1   p    v               pnr_rcs(k) = 0.
            1202     1   p    v               pnr_rcg(k) = 0.
            1203     1   p    v               pnr_rci(k) = 0.
            1204     1   p    v               pnr_sml(k) = 0.
            1205     1   p    v               pnr_gml(k) = 0.
            1206     1   p    v               pnr_rev(k) = 0.
            1207     1   p    v               pnr_rcr(k) = 0.
            1208     1   p    v               pnr_rfz(k) = 0.
            1209     1               
            1210     1   p    v               pri_inu(k) = 0.
            1211     1   p    v               pni_inu(k) = 0.
            1212     1   p    v               pri_ihm(k) = 0.
            1213     1   p    v               pni_ihm(k) = 0.
            1214     1   p    v               pri_wfz(k) = 0.
            1215     1   p    v               pni_wfz(k) = 0.
            1216     1   p    v               pri_rfz(k) = 0.
            1217     1   p    v               pni_rfz(k) = 0.
            1218     1   p    v               pri_ide(k) = 0.
            1219     1   p    v               pni_ide(k) = 0.
            1220     1   p    v               pri_rci(k) = 0.
            1221     1   p    v               pni_rci(k) = 0.
            1222     1   p    v               pni_sci(k) = 0.
            1223     1   p    v               pni_iau(k) = 0.
            1224     1               
            1225     1   p    v               prs_iau(k) = 0.
            1226     1   p    v               prs_sci(k) = 0.
            1227     1   p    v               prs_rcs(k) = 0.
            1228     1   p    v               prs_scw(k) = 0.
            1229     1   p    v               prs_sde(k) = 0.
            1230     1   p    v               prs_ihm(k) = 0.
            1231     1   p    v               prs_ide(k) = 0.
            1232     1               
            1233     1   p    v               prg_scw(k) = 0.
            1234     1   p    v               prg_rfz(k) = 0.
            1235     1   p    v               prg_gde(k) = 0.
            1236     1   p    v               prg_gcw(k) = 0.
            1237     1   p    v               prg_rci(k) = 0.
            1238     1   p    v               prg_rcs(k) = 0.
            1239     1   p    v               prg_rcg(k) = 0.
            1240     1   p    v               prg_ihm(k) = 0.
            1241     1   p    v            enddo
            1242                     !#ifdef WRF_CHEM
            1243                     !      do k = kts, kte
            1244                     !         rainprod(k) = 0.
            1245                     !         evapprod(k) = 0.
            1246                     !      enddo
            1247                     !#endif
            1248                     
            1249                     !+---+-----------------------------------------------------------------+
            1250                     !..Put column of data into local arrays.
            1251                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 16
                                   <<< Loop-information  End >>>
            1252     1  pp    s            do k = kts, kte
            1253     1   p    v               temp(k) = t1d(k)
            1254     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            1255     1   p    v               pres(k) = p1d(k)
            1256     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            1257     2   p    v               if (qc1d(k) .gt. R1) then
            1258     2   p    v                  no_micro = .false.
            1259     2   p    v                  rc(k) = qc1d(k)*rho(k)
            1260     2   p    v                  L_qc(k) = .true.
            1261     2   p                    else
            1262     2   p    v                  qc1d(k) = 0.0
            1263     2   p                       rc(k) = R1
            1264     2   p                       L_qc(k) = .false.
            1265     2   p    v               endif
            1266     2   p    v               if (qi1d(k) .gt. R1) then
            1267     2   p    m                  no_micro = .false.
            1268     2   p    v                  ri(k) = qi1d(k)*rho(k)
            1269     2   p    v                  ni(k) = MAX(R2, ni1d(k)*rho(k))
            1270     2   p    v                  L_qi(k) = .true.
            1271     2   p    m                  lami = (am_i*cig(2)*oig1*ni(k)/ri(k))**obmi
            1272     2   p    s                  ilami = 1./lami
            1273     2   p    s                  xDi = (bm_i + mu_i + 1.) * ilami
            1274     3   p    m                  if (xDi.lt. 20.E-6) then
            1275     3   p    s                   lami = cie(2)/20.E-6
            1276     3   p    m                   ni(k) = MIN(250.D3, cig(1)*oig2*ri(k)/am_i*lami**bm_i)
            1277     3   p                       elseif (xDi.gt. 300.E-6) then
            1278     3   p    m                   lami = cie(2)/300.E-6
            1279     3   p    m                   ni(k) = cig(1)*oig2*ri(k)/am_i*lami**bm_i
            1280     3   p                       endif
            1281     2   p                    else
            1282     2   p    v                  qi1d(k) = 0.0
            1283     2   p                       ni1d(k) = 0.0
            1284     2   p                       ri(k) = R1
            1285     2   p                       ni(k) = R2
            1286     2   p                       L_qi(k) = .false.
            1287     2   p    v               endif
            1288     1               
            1289     2   p    v               if (qr1d(k) .gt. R1) then
            1290     2   p    m                  no_micro = .false.
            1291     2   p    v                  rr(k) = qr1d(k)*rho(k)
            1292     2   p    v                  nr(k) = MAX(R2, nr1d(k)*rho(k))
            1293     2   p    v                  L_qr(k) = .true.
            1294     2   p    m                  lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            1295     2   p    s                  mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            1296     3   p    m                  if (mvd_r(k) .gt. 2.5E-3) then
            1297     3   p    v                     mvd_r(k) = 2.5E-3
            1298     3   p                          lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            1299     3   p    s                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            1300     3   p                       elseif (mvd_r(k) .lt. D0r*0.75) then
            1301     3   p    m                     mvd_r(k) = D0r*0.75
            1302     3   p    s                     lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            1303     3   p    m                     nr(k) = crg(2)*org3*rr(k)*lamr**bm_r / am_r
            1304     3   p                       endif
            1305     2   p                    else
            1306     2   p    v                  qr1d(k) = 0.0
            1307     2   p                       nr1d(k) = 0.0
            1308     2   p                       rr(k) = R1
            1309     2   p                       nr(k) = R2
            1310     2   p                       L_qr(k) = .false.
            1311     2   p    v               endif
            1312     2   p    v               if (qs1d(k) .gt. R1) then
            1313     2   p    v                  no_micro = .false.
            1314     2   p    v                  rs(k) = qs1d(k)*rho(k)
            1315     2   p    v                  L_qs(k) = .true.
            1316     2   p                    else
            1317     2   p    v                  qs1d(k) = 0.0
            1318     2   p                       rs(k) = R1
            1319     2   p                       L_qs(k) = .false.
            1320     2   p    v               endif
            1321     2   p    v               if (qg1d(k) .gt. R1) then
            1322     2   p    v                  no_micro = .false.
            1323     2   p    v                  rg(k) = qg1d(k)*rho(k)
            1324     2   p    v                  L_qg(k) = .true.
            1325     2   p                    else
            1326     2   p    v                  qg1d(k) = 0.0
            1327     2   p                       rg(k) = R1
            1328     2   p                       L_qg(k) = .false.
            1329     2   p    v               endif
            1330     1   p    v            enddo
            1331                     
            1332                     !+---+-----------------------------------------------------------------+
            1333                     !..Derive various thermodynamic variables frequently used.
            1334                     !.. Saturation vapor pressure (mixing ratio) over liquid/ice comes from
            1335                     !.. Flatau et al. 1992; enthalpy (latent heat) of vaporization from
            1336                     !.. Bohren & Albrecht 1998; others from Pruppacher & Klett 1978.
            1337                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp, rho, pres, qv, rhof, rhof2, qvs
                                   <<<      delQvs, qvsi, satw, sati, ssatw, ssati
                                   <<<      diffu
                                   <<<    PREFETCH(SOFT) : 10
                                   <<<     SEQUENTIAL : 10
                                   <<<      visco: 2, ocp: 2, vsc2: 2, lvap: 2
                                   <<<      tcond: 2
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 1  FILL 7
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1338     1   s    s            do k = kts, kte
            1339     1   p    v               tempc = temp(k) - 273.15
            1340     1   p    v               rhof(k) = SQRT(RHO_NOT/rho(k))
            1341     1   p    v               rhof2(k) = SQRT(rhof(k))
            1342     1   pi   v               qvs(k) = rslf(pres(k), temp(k))
            1343     1   pi   v               delQvs(k) = MAX(0.0, rslf(pres(k), 273.15)-qv(k))
            1344     2   p    v               if (tempc .le. 0.0) then
            1345     2   pi   v                qvsi(k) = rsif(pres(k), temp(k))
            1346     2   p    v               else
            1347     2   p    v                qvsi(k) = qvs(k)
            1348     2   p    v               endif
            1349     1   p    v               satw(k) = qv(k)/qvs(k)
            1350     1   p    v               sati(k) = qv(k)/qvsi(k)
            1351     1   p    v               ssatw(k) = satw(k) - 1.
            1352     1   p    v               ssati(k) = sati(k) - 1.
            1353     1   p    v               if (abs(ssatw(k)).lt. eps) ssatw(k) = 0.0
            1354     1   p    v               if (abs(ssati(k)).lt. eps) ssati(k) = 0.0
            1355     1   m    m               if (no_micro .and. ssati(k).gt. 0.0) no_micro = .false.
            1356     1   p    v               diffu(k) = 2.11E-5*(temp(k)/273.15)**1.94 * (101325./pres(k))
            1357     2   p    v               if (tempc .ge. 0.0) then
            1358     2   p    v                  visco(k) = (1.718+0.0049*tempc)*1.0E-5
            1359     2   p    v               else
            1360     2   p    v                  visco(k) = (1.718+0.0049*tempc-1.2E-5*tempc*tempc)*1.0E-5
            1361     2   p    v               endif
            1362     1   p    v               ocp(k) = 1./(Cp*(1.+0.887*qv(k)))
            1363     1   p    v               vsc2(k) = SQRT(rho(k)/visco(k))
            1364     1   p    v               lvap(k) = lvap0 + (2106.0 - 4218.0)*tempc
            1365     1   p    v               tcond(k) = (5.69 + 0.0168*tempc)*1.0E-5 * 418.936
            1366     1   p    v            enddo
            1367                     
            1368                     !+---+-----------------------------------------------------------------+
            1369                     !..If no existing hydrometeor species and no chance to initiate ice or
            1370                     !.. condense cloud water, just exit quickly!
            1371                     !+---+-----------------------------------------------------------------+
            1372                     
            1373                           if (no_micro) return
            1374                     
            1375                     !+---+-----------------------------------------------------------------+
            1376                     !..Calculate y-intercept, slope, and useful moments for snow.
            1377                     !+---+-----------------------------------------------------------------+
            1378     1                     if (.not. iiwarm) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 5
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      L_qs, rs, temp, smob, smo2, smo0, smo1
                                   <<<      smoc, smoe, smof
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 64  FILL 169
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1379     2  pp    v            do k = kts, kte
            1380     2   p    v               if (.not. L_qs(k)) CYCLE
            1381     2   p    v               tc0 = MIN(-0.1, temp(k)-273.15)
            1382     2   p    v               smob(k) = rs(k)*oams
            1383     2               
            1384     2               !..All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            1385     2               !.. then we must compute actual 2nd moment and use as reference.
            1386     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            1387     3   p    v                  smo2(k) = smob(k)
            1388     3                        else
            1389     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            1390     3                              + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            1391     3                              + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            1392     3                              + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            1393     3                              + sa(10)*bm_s*bm_s*bm_s
            1394     3                           a_ = 10.0**loga_
            1395     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            1396     3                              + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            1397     3                              + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            1398     3                              + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            1399     3                              + sb(10)*bm_s*bm_s*bm_s
            1400     3                           smo2(k) = (smob(k)/a_)**(1./b_)
            1401     3   p    v               endif
            1402     2               
            1403     2               !..Calculate 0th moment.  Represents snow number concentration.
            1404     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(5)*tc0*tc0 + sa(9)*tc0*tc0*tc0
            1405     2   p    v               a_ = 10.0**loga_
            1406     2   p    v               b_ = sb(1) + sb(2)*tc0 + sb(5)*tc0*tc0 + sb(9)*tc0*tc0*tc0
            1407     2   p    v               smo0(k) = a_ * smo2(k)**b_
            1408     2               
            1409     2               !..Calculate 1st moment.  Useful for depositional growth and melting.
            1410     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3) &
            1411     2                              + sa(4)*tc0 + sa(5)*tc0*tc0 &
            1412     2                              + sa(6) + sa(7)*tc0*tc0 &
            1413     2                              + sa(8)*tc0 + sa(9)*tc0*tc0*tc0 &
            1414     2                              + sa(10)
            1415     2   p    v               a_ = 10.0**loga_
            1416     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3) + sb(4)*tc0 &
            1417     2                             + sb(5)*tc0*tc0 + sb(6) &
            1418     2                             + sb(7)*tc0*tc0 + sb(8)*tc0 &
            1419     2                             + sb(9)*tc0*tc0*tc0 + sb(10)
            1420     2   p    v               smo1(k) = a_ * smo2(k)**b_
            1421     2               
            1422     2               !..Calculate bm_s+1 (th) moment.  Useful for diameter calcs.
            1423     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(1) &
            1424     2                              + sa(4)*tc0*cse(1) + sa(5)*tc0*tc0 &
            1425     2                              + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            1426     2                              + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            1427     2                              + sa(10)*cse(1)*cse(1)*cse(1)
            1428     2   p    v               a_ = 10.0**loga_
            1429     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(1) + sb(4)*tc0*cse(1) &
            1430     2                             + sb(5)*tc0*tc0 + sb(6)*cse(1)*cse(1) &
            1431     2                             + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            1432     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            1433     2   p    v               smoc(k) = a_ * smo2(k)**b_
            1434     2               
            1435     2               !..Calculate bv_s+2 (th) moment.  Useful for riming.
            1436     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(13) &
            1437     2                              + sa(4)*tc0*cse(13) + sa(5)*tc0*tc0 &
            1438     2                              + sa(6)*cse(13)*cse(13) + sa(7)*tc0*tc0*cse(13) &
            1439     2                              + sa(8)*tc0*cse(13)*cse(13) + sa(9)*tc0*tc0*tc0 &
            1440     2                              + sa(10)*cse(13)*cse(13)*cse(13)
            1441     2   p    v               a_ = 10.0**loga_
            1442     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(13) + sb(4)*tc0*cse(13) &
            1443     2                             + sb(5)*tc0*tc0 + sb(6)*cse(13)*cse(13) &
            1444     2                             + sb(7)*tc0*tc0*cse(13) + sb(8)*tc0*cse(13)*cse(13) &
            1445     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(13)*cse(13)*cse(13)
            1446     2   p    v               smoe(k) = a_ * smo2(k)**b_
            1447     2               
            1448     2               !..Calculate 1+(bv_s+1)/2 (th) moment.  Useful for depositional growth.
            1449     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(16) &
            1450     2                              + sa(4)*tc0*cse(16) + sa(5)*tc0*tc0 &
            1451     2                              + sa(6)*cse(16)*cse(16) + sa(7)*tc0*tc0*cse(16) &
            1452     2                              + sa(8)*tc0*cse(16)*cse(16) + sa(9)*tc0*tc0*tc0 &
            1453     2                              + sa(10)*cse(16)*cse(16)*cse(16)
            1454     2   p    v               a_ = 10.0**loga_
            1455     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(16) + sb(4)*tc0*cse(16) &
            1456     2                             + sb(5)*tc0*tc0 + sb(6)*cse(16)*cse(16) &
            1457     2                             + sb(7)*tc0*tc0*cse(16) + sb(8)*tc0*cse(16)*cse(16) &
            1458     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(16)*cse(16)*cse(16)
            1459     2   p    v               smof(k) = a_ * smo2(k)**b_
            1460     2               
            1461     2   p    v            enddo
            1462     1               
            1463     1               !+---+-----------------------------------------------------------------+
            1464     1               !..Calculate y-intercept, slope values for graupel.
            1465     1               !+---+-----------------------------------------------------------------+
            1466     1                     N0_min = gonv_max
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 22
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.25, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp, rg, ilamg, N0_g, (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 1
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1467     2   m    m            do k = kte, kts, -1
            1468     3   p    v               if (temp(k).lt.270.65 .and. L_qr(k) .and. mvd_r(k).gt.100.E-6) then
            1469     3   p    m                  xslw1 = 4.01 + dlog10(mvd_r(k))
            1470     3   p    v               else
            1471     3   p    s                  xslw1 = 0.01
            1472     3   p    m               endif
            1473     2   p    m               ygra1 = 4.31 + dlog10(max(5.E-5, rg(k)))
            1474     2   p    v               zans1 = 3.1 + (100./(300.*xslw1*ygra1/(10./xslw1+1.+0.25*ygra1)+30.+10.*ygra1))
            1475     2   p    v               N0_exp = 10.**(zans1)
            1476     2   p    v               N0_exp = MAX(DBLE(gonv_min), MIN(N0_exp, DBLE(gonv_max)))
            1477     2   s    s               N0_min = MIN(N0_exp, N0_min)
            1478     2   p    v               N0_exp = N0_min
            1479     2   p    v               lam_exp = (N0_exp*am_g*cgg(1)/rg(k))**oge1
            1480     2   p    v               lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg
            1481     2   p    v               ilamg(k) = 1./lamg
            1482     2   p    v               N0_g(k) = N0_exp/(cgg(2)*lam_exp) * lamg**cge(2)
            1483     2               !+---+-----------------------------------------------------------------+
            1484     2               !     if( debug_flag .and. k.lt.42) then
            1485     2               !        if (k.eq.41) write(mp_debug,*) 'DEBUG-GT:   K,   zans1,      rc,        rr,         rg,        N0_g'
            1486     2               !        if (k.eq.41) CALL wrf_debug(0, mp_debug)
            1487     2               !        write(mp_debug, 'a, i2, 1x, f6.3, 1x, 4(1x,e13.6,1x)')         &
            1488     2               !                   '  GT ', k, zans1, rc(k), rr(k), rg(k), N0_g(k)
            1489     2               !        CALL wrf_debug(0, mp_debug)
            1490     2               !     endif
            1491     2               !+---+-----------------------------------------------------------------+

                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            2930     1   s   fv            do n2 = 1, nbr
            2931     1               !        vr(n2) = av_r*Dr(n2)**bv_r * DEXP(-fv_r*Dr(n2))
            2932     1   p   fv               vr(n2) = -0.1021 + 4.932E3*Dr(n2) - 0.9551E6*Dr(n2)*Dr(n2)     &
            2933     1                             + 0.07934E9*Dr(n2)*Dr(n2)*Dr(n2)                          &
            2934     1                             - 0.002362E12*Dr(n2)*Dr(n2)*Dr(n2)*Dr(n2)
            2935     1   p   fv            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 45
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.10, ITR: 72, MVE: 4, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vg, Dg
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 40
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2936     1  pp    v            do n = 1, nbg
            2937     1   p    v               vg(n) = av_g*Dg(n)**bv_g
            2938     1   p    v            enddo
            2939                     
            2940                     !..Note values returned from wrf_dm_decomp1d are zero-based, add 1 for
            2941                     !.. fortran indices.  J. Michalakes, 2009Oct30.
            2942                     
            2943                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            2944                           CALL wrf_dm_decomp1d ( ntb_r*ntb_r1, km_s, km_e )
            2945                     #else
            2946                           km_s = 0
            2947                           km_e = ntb_r*ntb_r1 - 1
            2948                     #endif
            2949                     
            2950     1                     do km = km_s, km_e
            2951     1                        m = km / ntb_r1 + 1
            2952     1                        k = mod( km , ntb_r1 ) + 1
            2953     1               
            2954     1                        lam_exp = (N0r_exp(k)*am_r*crg(1)/r_r(m))**ore1
            2955     1                        lamr = lam_exp * (crg(3)*org2*org1)**obmr
            2956     1                        N0_r = N0r_exp(k)/(crg(2)*lam_exp) * lamr**cre(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtr, Dr, N_r
                                   <<< Loop-information  End >>>
            2957     2  pp    v               do n2 = 1, nbr
            2958     2   p    v                  N_r(n2) = N0_r*Dr(n2)**mu_r *DEXP(-lamr*Dr(n2))*dtr(n2)
            2959     2   p    v               enddo
            2960     1               
            2961     2                        do j = 1, ntb_g
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 1
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2962     3                        do i = 1, ntb_g1
            2963     3                           lam_exp = (N0g_exp(i)*am_g*cgg(1)/r_g(j))**oge1
            2964     3                           lamg = lam_exp * (cgg(3)*ogg2*ogg1)**obmg
            2965     3                           N0_g = N0g_exp(i)/(cgg(2)*lam_exp) * lamg**cge(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtg, Dg, N_g
                                   <<< Loop-information  End >>>
            2966     4  pp    v                  do n = 1, nbg
            2967     4   p    v                     N_g(n) = N0_g*Dg(n)**mu_g * DEXP(-lamg*Dg(n))*dtg(n)
            2968     4   p    v                  enddo
            2969     3               
            2970     3                           t1 = 0.0d0
            2971     3                           t2 = 0.0d0
            2972     3                           z1 = 0.0d0
            2973     3                           z2 = 0.0d0
            2974     3                           y1 = 0.0d0
            2975     3                           y2 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 4
                                   <<<  [OPTIMIZATION]
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 6  FILL 6
                                   <<<      SCALABLE  : SPILL 0  FILL 17
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            2976     4  pp                       do n2 = 1, nbr
            2977     4   p                          massr = am_r * Dr(n2)**bm_r
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 356
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            2978     5   p   fv                     do n = 1, nbg
            2979     5   p   fv                        massg = am_g * Dg(n)**bm_g
            2980     5               
            2981     5   p   fv                        dvg = 0.5d0*((vr(n2) - vg(n)) + DABS(vr(n2)-vg(n)))
            2982     5   p   fv                        dvr = 0.5d0*((vg(n) - vr(n2)) + DABS(vg(n)-vr(n2)))
            2983     5               
            2984     5   p   fv                        t1 = t1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            2985     5                                     *dvg*massg * N_g(n)* N_r(n2)
            2986     5   p   fv                        z1 = z1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            2987     5                                     *dvg*massr * N_g(n)* N_r(n2)
            2988     5   p   fv                        y1 = y1+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            2989     5                                     *dvg       * N_g(n)* N_r(n2)
            2990     5               
            2991     5   p   fv                        t2 = t2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            2992     5                                     *dvr*massr * N_g(n)* N_r(n2)
            2993     5   p   fv                        y2 = y2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            2994     5                                     *dvr       * N_g(n)* N_r(n2)
            2995     5   p   fv                        z2 = z2+ PI*.25*Ef_rg*(Dg(n)+Dr(n2))*(Dg(n)+Dr(n2)) &
            2996     5                                     *dvr*massg * N_g(n)* N_r(n2)
            2997     5   p   fv                     enddo
            2998     4   p            97            continue
            2999     4   p                       enddo
            3000     3                           tcg_racg(i,j,k,m) = t1
            3001     3                           tmr_racg(i,j,k,m) = DMIN1(z1, r_r(m)*1.0d0)
            3002     3                           tcr_gacr(i,j,k,m) = t2
            3003     3                           tmg_gacr(i,j,k,m) = z2
            3004     3                           tnr_racg(i,j,k,m) = y1
            3005     3                           tnr_gacr(i,j,k,m) = y2
            3006     3                        enddo
            3007     2                        enddo
            3008     1                     enddo
            3009                     
            3010                     !..Note wrf_dm_gatherv expects zero-based km_s, km_e (J. Michalakes, 2009Oct30).
            3011                     
            3012                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            3013                           CALL wrf_dm_gatherv(tcg_racg, ntb_g*ntb_g1, km_s, km_e, R8SIZE)
            3014                           CALL wrf_dm_gatherv(tmr_racg, ntb_g*ntb_g1, km_s, km_e, R8SIZE)
            3015                           CALL wrf_dm_gatherv(tcr_gacr, ntb_g*ntb_g1, km_s, km_e, R8SIZE)
            3016                           CALL wrf_dm_gatherv(tmg_gacr, ntb_g*ntb_g1, km_s, km_e, R8SIZE)
            3017                           CALL wrf_dm_gatherv(tnr_racg, ntb_g*ntb_g1, km_s, km_e, R8SIZE)
            3018                           CALL wrf_dm_gatherv(tnr_gacr, ntb_g*ntb_g1, km_s, km_e, R8SIZE)
            3019                     #endif
            3020                     
            3021                           end subroutine qr_acr_qg
            3022                     !+---+-----------------------------------------------------------------+
            3023                     !
            3024                     !+---+-----------------------------------------------------------------+
            3025                     !..Rain collecting snow (and inverse).  Explicit CE integration.
            3026                     !+---+-----------------------------------------------------------------+
            3027                     
            3028                           subroutine qr_acr_qs
            3029                     
            3030                           implicit none
            3031                     
            3032                     !..Local variables
            3033                           INTEGER:: i, j, k, m, n, n2
            3034                           INTEGER:: km, km_s, km_e
            3035                           DOUBLE PRECISION, DIMENSION(nbr):: vr, D1, N_r
            3036                           DOUBLE PRECISION, DIMENSION(nbs):: vs, N_s
            3037                           DOUBLE PRECISION:: loga_, a_, b_, second, M0, M2, M3, Mrat, oM3
            3038                           DOUBLE PRECISION:: N0_r, lam_exp, lamr, slam1, slam2
            3039                           DOUBLE PRECISION:: dvs, dvr, masss, massr
            3040                           DOUBLE PRECISION:: t1, t2, t3, t4, z1, z2, z3, z4
            3041                           DOUBLE PRECISION:: y1, y2, y3, y4
            3042                     
            3043                     !+---+
            3044                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 728
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3045     1   s   fv            do n2 = 1, nbr
            3046     1               !        vr(n2) = av_r*Dr(n2)**bv_r * DEXP(-fv_r*Dr(n2))
            3047     1   p   fv               vr(n2) = -0.1021 + 4.932E3*Dr(n2) - 0.9551E6*Dr(n2)*Dr(n2)     &
            3048     1                             + 0.07934E9*Dr(n2)*Dr(n2)*Dr(n2)                          &
            3049     1                             - 0.002362E12*Dr(n2)*Dr(n2)*Dr(n2)*Dr(n2)
            3050     1   p   fv               D1(n2) = (vr(n2)/av_s)**(1./bv_s)
            3051     1   p   fv            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 23
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.11, ITR: 56, MVE: 3, POL: L)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vs, Ds
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 28
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3052     1  pp    v            do n = 1, nbs
            3053     1   p    v               vs(n) = 1.5*av_s*Ds(n)**bv_s * DEXP(-fv_s*Ds(n))
            3054     1   p    v            enddo
            3055                     
            3056                     !..Note values returned from wrf_dm_decomp1d are zero-based, add 1 for
            3057                     !.. fortran indices.  J. Michalakes, 2009Oct30.
            3058                     
            3059                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            3060                           CALL wrf_dm_decomp1d ( ntb_r*ntb_r1, km_s, km_e )
            3061                     #else
            3062                           km_s = 0
            3063                           km_e = ntb_r*ntb_r1 - 1
            3064                     #endif
            3065                     
            3066     1                     do km = km_s, km_e
            3067     1                        m = km / ntb_r1 + 1
            3068     1                        k = mod( km , ntb_r1 ) + 1
            3069     1               
            3070     1                        lam_exp = (N0r_exp(k)*am_r*crg(1)/r_r(m))**ore1
            3071     1                        lamr = lam_exp * (crg(3)*org2*org1)**obmr
            3072     1                        N0_r = N0r_exp(k)/(crg(2)*lam_exp) * lamr**cre(2)
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 44
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.87, ITR: 64, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dtr, Dr, N_r
                                   <<< Loop-information  End >>>
            3073     2  pp    v               do n2 = 1, nbr
            3074     2   p    v                  N_r(n2) = N0_r*Dr(n2)**mu_r * DEXP(-lamr*Dr(n2))*dtr(n2)
            3075     2   p    v               enddo
            3076     1               
            3077     2                        do j = 1, ntb_t
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      (unknown)
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 2
                                   <<<      SIMD&FP   : SPILL 22  FILL 39
                                   <<<      SCALABLE  : SPILL 11  FILL 15
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3078     3                           do i = 1, ntb_s
            3079     3               
            3080     3               !..From the bm_s moment, compute plus one moment.  If we are not
            3081     3               !.. using bm_s=2, then we must transform to the pure 2nd moment
            3082     3               !.. (variable called "second") and then to the bm_s+1 moment.
            3083     3               
            3084     3                              M2 = r_s(i)*oams *1.0d0
            3085     4                              if (bm_s.gt.2.0-1.E-3 .and. bm_s.lt.2.0+1.E-3) then
            3086     4                                 loga_ = sa(1) + sa(2)*Tc(j) + sa(3)*bm_s &
            3087     4                                    + sa(4)*Tc(j)*bm_s + sa(5)*Tc(j)*Tc(j) &
            3088     4                                    + sa(6)*bm_s*bm_s + sa(7)*Tc(j)*Tc(j)*bm_s &
            3089     4                                    + sa(8)*Tc(j)*bm_s*bm_s + sa(9)*Tc(j)*Tc(j)*Tc(j) &
            3090     4                                    + sa(10)*bm_s*bm_s*bm_s
            3091     4                                 a_ = 10.0**loga_
            3092     4                                 b_ = sb(1) + sb(2)*Tc(j) + sb(3)*bm_s &
            3093     4                                    + sb(4)*Tc(j)*bm_s + sb(5)*Tc(j)*Tc(j) &
            3094     4                                    + sb(6)*bm_s*bm_s + sb(7)*Tc(j)*Tc(j)*bm_s &
            3095     4                                    + sb(8)*Tc(j)*bm_s*bm_s + sb(9)*Tc(j)*Tc(j)*Tc(j) &
            3096     4                                    + sb(10)*bm_s*bm_s*bm_s
            3097     4                                 second = (M2/a_)**(1./b_)
            3098     4                              else
            3099     4                                 second = M2
            3100     4                              endif
            3101     3               
            3102     3                              loga_ = sa(1) + sa(2)*Tc(j) + sa(3)*cse(1) &
            3103     3                                 + sa(4)*Tc(j)*cse(1) + sa(5)*Tc(j)*Tc(j) &
            3104     3                                 + sa(6)*cse(1)*cse(1) + sa(7)*Tc(j)*Tc(j)*cse(1) &
            3105     3                                 + sa(8)*Tc(j)*cse(1)*cse(1) + sa(9)*Tc(j)*Tc(j)*Tc(j) &
            3106     3                                 + sa(10)*cse(1)*cse(1)*cse(1)
            3107     3                              a_ = 10.0**loga_
            3108     3                              b_ = sb(1)+sb(2)*Tc(j)+sb(3)*cse(1) + sb(4)*Tc(j)*cse(1) &
            3109     3                                 + sb(5)*Tc(j)*Tc(j) + sb(6)*cse(1)*cse(1) &
            3110     3                                 + sb(7)*Tc(j)*Tc(j)*cse(1) + sb(8)*Tc(j)*cse(1)*cse(1) &
            3111     3                                 + sb(9)*Tc(j)*Tc(j)*Tc(j)+sb(10)*cse(1)*cse(1)*cse(1)
            3112     3                              M3 = a_ * second**b_
            3113     3               
            3114     3                              oM3 = 1./M3
            3115     3                              Mrat = M2*(M2*oM3)*(M2*oM3)*(M2*oM3)
            3116     3                              M0   = (M2*oM3)**mu_s
            3117     3                              slam1 = M2 * oM3 * Lam0
            3118     3                              slam2 = M2 * oM3 * Lam1
            3119     3               
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Ds, dts, N_s
                                   <<< Loop-information  End >>>
            3120     4  pp    v                     do n = 1, nbs
            3121     4   p    v                        N_s(n) = Mrat*(Kap0*DEXP(-slam1*Ds(n)) &
            3122     4                                     + Kap1*M0*Ds(n)**mu_s * DEXP(-slam2*Ds(n)))*dts(n)
            3123     4   p    v                     enddo
            3124     3               
            3125     3                              t1 = 0.0d0
            3126     3                              t2 = 0.0d0
            3127     3                              t3 = 0.0d0
            3128     3                              t4 = 0.0d0
            3129     3                              z1 = 0.0d0
            3130     3                              z2 = 0.0d0
            3131     3                              z3 = 0.0d0
            3132     3                              z4 = 0.0d0
            3133     3                              y1 = 0.0d0
            3134     3                              y2 = 0.0d0
            3135     3                              y3 = 0.0d0
            3136     3                              y4 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<< Loop-information  End >>>
            3137     4  pp                          do n2 = 1, nbr
            3138     4   p                             massr = am_r * Dr(n2)**bm_r
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 134
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Ds, vs
                                   <<< Loop-information  End >>>
            3139     5   p    s                        do n = 1, nbs
            3140     5   p    m                           masss = am_s * Ds(n)**bm_s
            3141     5               
            3142     5   p    v                           dvs = 0.5d0*((vr(n2) - vs(n)) + DABS(vr(n2)-vs(n)))
            3143     5   p    v                           dvr = 0.5d0*((vs(n) - vr(n2)) + DABS(vs(n)-vr(n2)))
            3144     5               
            3145     6   p    v                           if (massr .gt. 1.5*masss) then
            3146     6   p    m                           t1 = t1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3147     6                                        *dvs*masss * N_s(n)* N_r(n2)
            3148     6   p    s                           z1 = z1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3149     6                                        *dvs*massr * N_s(n)* N_r(n2)
            3150     6   p    s                           y1 = y1+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3151     6                                        *dvs       * N_s(n)* N_r(n2)
            3152     6   p                                else
            3153     6   p    s                           t3 = t3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3154     6                                        *dvs*masss * N_s(n)* N_r(n2)
            3155     6   p    s                           z3 = z3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3156     6                                        *dvs*massr * N_s(n)* N_r(n2)
            3157     6   p    s                           y3 = y3+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3158     6                                        *dvs       * N_s(n)* N_r(n2)
            3159     6   p    s                           endif
            3160     5               
            3161     6   p    m                           if (massr .gt. 1.5*masss) then
            3162     6   p    m                           t2 = t2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3163     6                                        *dvr*massr * N_s(n)* N_r(n2)
            3164     6   p    s                           y2 = y2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3165     6                                        *dvr       * N_s(n)* N_r(n2)
            3166     6   p    s                           z2 = z2+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3167     6                                        *dvr*masss * N_s(n)* N_r(n2)
            3168     6   p                                else
            3169     6   p    s                           t4 = t4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3170     6                                        *dvr*massr * N_s(n)* N_r(n2)
            3171     6   p    s                           y4 = y4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3172     6                                        *dvr       * N_s(n)* N_r(n2)
            3173     6   p    s                           z4 = z4+ PI*.25*Ef_rs*(Ds(n)+Dr(n2))*(Ds(n)+Dr(n2)) &
            3174     6                                        *dvr*masss * N_s(n)* N_r(n2)
            3175     6   p    v                           endif
            3176     5               
            3177     5   p    v                        enddo
            3178     4   p                          enddo
            3179     3                              tcs_racs1(i,j,k,m) = t1
            3180     3                              tmr_racs1(i,j,k,m) = DMIN1(z1, r_r(m)*1.0d0)
            3181     3                              tcs_racs2(i,j,k,m) = t3
            3182     3                              tmr_racs2(i,j,k,m) = z3
            3183     3                              tcr_sacr1(i,j,k,m) = t2
            3184     3                              tms_sacr1(i,j,k,m) = z2
            3185     3                              tcr_sacr2(i,j,k,m) = t4
            3186     3                              tms_sacr2(i,j,k,m) = z4
            3187     3                              tnr_racs1(i,j,k,m) = y1
            3188     3                              tnr_racs2(i,j,k,m) = y3
            3189     3                              tnr_sacr1(i,j,k,m) = y2
            3190     3                              tnr_sacr2(i,j,k,m) = y4
            3191     3                           enddo
            3192     2                        enddo
            3193     1                     enddo
            3194                     
            3195                     !..Note wrf_dm_gatherv expects zero-based km_s, km_e (J. Michalakes, 2009Oct30).
            3196                     
            3197                     #if ( defined( DM_PARALLEL ) && ( ! defined( STUBMPI ) ) )
            3198                           CALL wrf_dm_gatherv(tcs_racs1, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3199                           CALL wrf_dm_gatherv(tmr_racs1, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3200                           CALL wrf_dm_gatherv(tcs_racs2, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3201                           CALL wrf_dm_gatherv(tmr_racs2, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3202                           CALL wrf_dm_gatherv(tcr_sacr1, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3203                           CALL wrf_dm_gatherv(tms_sacr1, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3204                           CALL wrf_dm_gatherv(tcr_sacr2, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3205                           CALL wrf_dm_gatherv(tms_sacr2, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3206                           CALL wrf_dm_gatherv(tnr_racs1, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3207                           CALL wrf_dm_gatherv(tnr_racs2, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3208                           CALL wrf_dm_gatherv(tnr_sacr1, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3209                           CALL wrf_dm_gatherv(tnr_sacr2, ntb_s*ntb_t, km_s, km_e, R8SIZE)
            3210                     #endif
            3211                     
            3212                     
            3213                           end subroutine qr_acr_qs
            3214                     !+---+-----------------------------------------------------------------+
            3215                     !
            3216                     !+---+-----------------------------------------------------------------+
            3217                     !..This is a literal adaptation of Bigg (1954) probability of drops of
            3218                     !..a particular volume freezing.  Given this probability, simply freeze
            3219                     !..the proportion of drops summing their masses.
            3220                     !+---+-----------------------------------------------------------------+
            3221                     
            3222                           subroutine freezeH2O
            3223                     
            3224                           implicit none
            3225                     
            3226                     !..Local variables
            3227                           INTEGER:: i, j, k, n, n2
            3228                           DOUBLE PRECISION, DIMENSION(nbr):: N_r, massr
            3229                           DOUBLE PRECISION, DIMENSION(nbc):: N_c, massc
            3230                           DOUBLE PRECISION:: sum1, sum2, sumn1, sumn2, &
            3231                                              prob, vol, Texp, orho_w, &
            3232                                              lam_exp, lamr, N0_r, lamc, N0_c, y
            3233                     
            3234                     !+---+
            3235                     
            3236                           orho_w = 1./rho_w
            3237                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3238     1   s   fv            do n2 = 1, nbr
            3239     1   p   fv               massr(n2) = am_r*Dr(n2)**bm_r
            3240     1   p   fv            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1143
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3241     1   s   fv            do n = 1, nbc
            3242     1   p   fv               massc(n) = am_r*Dc(n)**bm_r
            3243     1   p   fv            enddo
            3244                     
            3245                     !..Freeze water (smallest drops become cloud ice, otherwise graupel).
            3246     1                     do k = 1, 45
            3247     1               !         print*, ' Freezing water for temp = ', -k
            3248     1                        Texp = DEXP( DFLOAT(k) ) - 1.0D0
            3249     2                        do j = 1, ntb_r1
            3250     3                           do i = 1, ntb_r
            3251     3                              lam_exp = (N0r_exp(j)*am_r*crg(1)/r_r(i))**ore1
            3252     3                              lamr = lam_exp * (crg(3)*org2*org1)**obmr
            3253     3                              N0_r = N0r_exp(j)/(crg(2)*lam_exp) * lamr**cre(2)
            3254     3                              sum1 = 0.0d0
            3255     3                              sum2 = 0.0d0
            3256     3                              sumn1 = 0.0d0
            3257     3                              sumn2 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dr, dtr, massr
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3258     4                              do n2 = nbr, 1, -1
            3259     4                                 N_r(n2) = N0_r*Dr(n2)**mu_r*DEXP(-lamr*Dr(n2))*dtr(n2)
            3260     4                                 vol = massr(n2)*orho_w
            3261     4                                 prob = 1.0D0 - DEXP(-120.0D0*vol*5.2D-4 * Texp)
            3262     5                                 if (massr(n2) .lt. xm0g) then
            3263     5                                    sumn1 = sumn1 + prob*N_r(n2)
            3264     5                                    sum1 = sum1 + prob*N_r(n2)*massr(n2)
            3265     5                                 else
            3266     5                                    sumn2 = sumn2 + prob*N_r(n2)
            3267     5                                    sum2 = sum2 + prob*N_r(n2)*massr(n2)
            3268     5                                 endif
            3269     4                                 if ((sum1+sum2) .ge. r_r(i)) EXIT
            3270     4                              enddo
            3271     3                              tpi_qrfz(i,j,k) = sum1
            3272     3                              tni_qrfz(i,j,k) = sumn1
            3273     3                              tpg_qrfz(i,j,k) = sum2
            3274     3                              tnr_qrfz(i,j,k) = sumn2
            3275     3                           enddo
            3276     2                        enddo
            3277     2                        do j = 1, 2  !land and ocean
            3278     3                         do i = 1, ntb_c
            3279     3               !           lamc = 1.0D-6 * (Nt_c*am_r* ccg(2) * ocg1 / r_c(i))**obmr
            3280     3               !            N0_c = 1.0D-18 * Nt_c*ocg1 * lamc**cce(1)
            3281     4                                       if(j==1) then
            3282     4                             lamc = 1.0D-6 * (Nt_cl*am_r* ccg(2,1) * ocg1(1) / r_c(i))**obmr
            3283     4                             N0_c = 1.0D-18 * Nt_cl*ocg1(1) * lamc**cce(1,1)
            3284     4                           else
            3285     4                             lamc = 1.0D-6 * (Nt_co*am_r* ccg(2,2) * ocg1(2) / r_c(i))**obmr
            3286     4                             N0_c = 1.0D-18 * Nt_co*ocg1(2) * lamc**cce(1,2)
            3287     4                           endif
            3288     3                           sum1 = 0.0d0
            3289     3                           sumn2 = 0.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dc, massc, dtc
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 1
                                   <<<      SIMD&FP   : SPILL 3  FILL 8
                                   <<<      SCALABLE  : SPILL 0  FILL 22
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3290     4                           do n = nbc, 1, -1
            3291     4                              y = Dc(n)*1.0D6
            3292     4                              vol = massc(n)*orho_w
            3293     4                              prob = 1.0D0 - DEXP(-120.0D0*vol*5.2D-4 * Texp)
            3294     4               !              N_c(n) = N0_c* y**mu_c * EXP(-lamc*y)*dtc(n)
            3295     5                              if(j==1) then
            3296     5                                N_c(n) = N0_c* y**mu_cl * EXP(-lamc*y)*dtc(n)
            3297     5                              else
            3298     5                                N_c(n) = N0_c* y**mu_co * EXP(-lamc*y)*dtc(n)
            3299     5                              endif
            3300     4                              N_c(n) = 1.0D24 * N_c(n)
            3301     4                              sumn2 = sumn2 + prob*N_c(n)
            3302     4                              sum1 = sum1 + prob*N_c(n)*massc(n)
            3303     4                              if (sum1 .ge. r_c(i)) EXIT
            3304     4                           enddo
            3305     3               !           tpi_qcfz(i,k) = sum1
            3306     3               !           tni_qcfz(i,k) = sumn2
            3307     3                           tpi_qcfz(i,k,j) = sum1
            3308     3                           tni_qcfz(i,k,j) = sumn2
            3309     3                         enddo
            3310     2                        enddo
            3311     1                     enddo
            3312                     
            3313                           end subroutine freezeH2O
            3314                     !+---+-----------------------------------------------------------------+
            3315                     !
            3316                     !+---+-----------------------------------------------------------------+
            3317                     !..Cloud ice converting to snow since portion greater than min snow
            3318                     !.. size.  Given cloud ice content (kg/m**3), number concentration
            3319                     !.. (#/m**3) and gamma shape parameter, mu_i, break the distrib into
            3320                     !.. bins and figure out the mass/number of ice with sizes larger than
            3321                     !.. D0s.  Also, compute incomplete gamma function for the integration
            3322                     !.. of ice depositional growth from diameter=0 to D0s.  Amount of
            3323                     !.. ice depositional growth is this portion of distrib while larger
            3324                     !.. diameters contribute to snow growth (as in Harrington et al. 1995).
            3325                     !+---+-----------------------------------------------------------------+
            3326                     
            3327                           subroutine qi_aut_qs
            3328                     
            3329                           implicit none
            3330                     
            3331                     !..Local variables
            3332                           INTEGER:: i, j, n2
            3333                           DOUBLE PRECISION, DIMENSION(nbi):: N_i
            3334                           DOUBLE PRECISION:: N0_i, lami, Di_mean, t1, t2
            3335                           REAL:: xlimit_intg
            3336                     
            3337                     !+---+
            3338                     
            3339     1                     do j = 1, ntb_i1
            3340     2                        do i = 1, ntb_i
            3341     2                           lami = (am_i*cig(2)*oig1*Nt_i(j)/r_i(i))**obmi
            3342     2                           Di_mean = (bm_i + mu_i + 1.) / lami
            3343     2                           N0_i = Nt_i(j)*oig1 * lami**cie(1)
            3344     2                           t1 = 0.0d0
            3345     2                           t2 = 0.0d0
            3346     3                           if (SNGL(Di_mean) .gt. 5.*D0s) then
            3347     3                            t1 = r_i(i)
            3348     3                            t2 = Nt_i(j)
            3349     3                            tpi_ide(i,j) = 0.0D0
            3350     3                           elseif (SNGL(Di_mean) .lt. D0i) then
            3351     3                            t1 = 0.0D0
            3352     3                            t2 = 0.0D0
            3353     3                            tpi_ide(i,j) = 1.0D0
            3354     3                           else
            3355     3                            xlimit_intg = lami*D0s
            3356     3                            tpi_ide(i,j) = GAMMP(mu_i+2.0, xlimit_intg) * 1.0D0
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 43
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<< Loop-information  End >>>
            3357     4  pp    v                   do n2 = 1, nbi
            3358     4   p    v                     N_i(n2) = N0_i*Di(n2)**mu_i * DEXP(-lami*Di(n2))*dti(n2)
            3359     5   p    v                     if (Di(n2).ge.D0s) then
            3360     5   p    v                        t1 = t1 + N_i(n2) * am_i*Di(n2)**bm_i
            3361     5   p    v                        t2 = t2 + N_i(n2)
            3362     5   p    v                     endif
            3363     4   p    v                   enddo
            3364     3                           endif
            3365     2                           tps_iaus(i,j) = t1
            3366     2                           tni_iaus(i,j) = t2
            3367     2                        enddo
            3368     1                     enddo
            3369                     
            3370                           end subroutine qi_aut_qs
            3371                     !
            3372                     !+---+-----------------------------------------------------------------+
            3373                     !..Variable collision efficiency for rain collecting cloud water using
            3374                     !.. method of Beard and Grover, 1974 if a/A less than 0.25; otherwise
            3375                     !.. uses polynomials to get close match of Pruppacher & Klett Fig 14-9.
            3376                     !+---+-----------------------------------------------------------------+
            3377                     
            3378                           subroutine table_Efrw
            3379                     
            3380                           implicit none
            3381                     
            3382                     !..Local variables
            3383                           DOUBLE PRECISION:: vtr, stokes, reynolds, Ef_rw
            3384                           DOUBLE PRECISION:: p, yc0, F, G, H, z, K0, X
            3385                           INTEGER:: i, j
            3386                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dc, t_Efrw
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 385  FILL 852
                                   <<<      PREDICATE : SPILL 18  FILL 41
                                   <<< Loop-information  End >>>
            3387     1  pp                 do j = 1, nbc
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3388     2   p   fv            do i = 1, nbr
            3389     2   p   fv               Ef_rw = 0.0
            3390     2   p   fv               p = Dc(j)/Dr(i)
            3391     3   p   fv               if (Dr(i).lt.50.E-6 .or. Dc(j).lt.3.E-6) then
            3392     3   p   fv                t_Efrw(i,j) = 0.0
            3393     3   p   fv               elseif (p.gt.0.25) then
            3394     3   p   fv                X = Dc(j)*1.D6
            3395     4   p   fv                if (Dr(i) .lt. 75.e-6) then
            3396     4   p   fv                   Ef_rw = 0.026794*X - 0.20604
            3397     4   p   fv                elseif (Dr(i) .lt. 125.e-6) then
            3398     4   p   fv                   Ef_rw = -0.00066842*X*X + 0.061542*X - 0.37089
            3399     4   p   fv                elseif (Dr(i) .lt. 175.e-6) then
            3400     4   p   fv                   Ef_rw = 4.091e-06*X*X*X*X - 0.00030908*X*X*X               &
            3401     4                                  + 0.0066237*X*X - 0.0013687*X - 0.073022
            3402     4   p   fv                elseif (Dr(i) .lt. 250.e-6) then
            3403     4   p   fv                   Ef_rw = 9.6719e-5*X*X*X - 0.0068901*X*X + 0.17305*X        &
            3404     4                                  - 0.65988
            3405     4   p   fv                elseif (Dr(i) .lt. 350.e-6) then
            3406     4   p   fv                   Ef_rw = 9.0488e-5*X*X*X - 0.006585*X*X + 0.16606*X         &
            3407     4                                  - 0.56125
            3408     4   p   fv                else
            3409     4   p   fv                   Ef_rw = 0.00010721*X*X*X - 0.0072962*X*X + 0.1704*X        &
            3410     4                                  - 0.46929
            3411     4   p   fv                endif
            3412     3   p   fv               else
            3413     3   p   fv                vtr = -0.1021 + 4.932E3*Dr(i) - 0.9551E6*Dr(i)*Dr(i) &
            3414     3                             + 0.07934E9*Dr(i)*Dr(i)*Dr(i) &
            3415     3                             - 0.002362E12*Dr(i)*Dr(i)*Dr(i)*Dr(i)
            3416     3   p   fv                stokes = Dc(j)*Dc(j)*vtr*rho_w/(9.*1.718E-5*Dr(i))
            3417     3   p   fv                reynolds = 9.*stokes/(p*p*rho_w)
            3418     3               
            3419     3   p   fv                F = DLOG(reynolds)
            3420     3   p   fv                G = -0.1007D0 - 0.358D0*F + 0.0261D0*F*F
            3421     3   p   fv                K0 = DEXP(G)
            3422     3   p   fv                z = DLOG(stokes/(K0+1.D-15))
            3423     3   p   fv                H = 0.1465D0 + 1.302D0*z - 0.607D0*z*z + 0.293D0*z*z*z
            3424     3   p   fv                yc0 = 2.0D0/PI * ATAN(H)
            3425     3   p   fv                Ef_rw = (yc0+p)*(yc0+p) / ((1.+p)*(1.+p))
            3426     3               
            3427     3   p   fv               endif
            3428     2               
            3429     2   p   fv               t_Efrw(i,j) = MAX(0.0, MIN(SNGL(Ef_rw), 0.95))
            3430     2               
            3431     2   p   fv            enddo
            3432     1   p                 enddo
            3433                     
            3434                           end subroutine table_Efrw
            3435                     !
            3436                     !+---+-----------------------------------------------------------------+
            3437                     !..Variable collision efficiency for snow collecting cloud water using
            3438                     !.. method of Wang and Ji, 2000 except equate melted snow diameter to
            3439                     !.. their "effective collision cross-section."
            3440                     !+---+-----------------------------------------------------------------+
            3441                     
            3442                           subroutine table_Efsw
            3443                     
            3444                           implicit none
            3445                     
            3446                     !..Local variables
            3447                           DOUBLE PRECISION:: Ds_m, vts, vtc, stokes, reynolds, Ef_sw
            3448                           DOUBLE PRECISION:: p, yc0, F, G, H, z, K0
            3449                           INTEGER:: i, j
            3450                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 2
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      Dc, t_Efsw
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 419  FILL 710
                                   <<<      PREDICATE : SPILL 4  FILL 4
                                   <<< Loop-information  End >>>
            3451     1  pp                 do j = 1, nbc
            3452     1   p                 vtc = 1.19D4 * (1.0D4*Dc(j)*Dc(j)*0.25D0)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
            3453     2   p   fv            do i = 1, nbs
            3454     2   p   fv               vts = av_s*Ds(i)**bv_s * DEXP(-fv_s*Ds(i)) - vtc
            3455     2   p   fv               Ds_m = (am_s*Ds(i)**bm_s / am_r)**obmr
            3456     2   p   fv               p = Dc(j)/Ds_m
            3457     3   p   fv               if (p.gt.0.25 .or. Ds(i).lt.D0s .or. Dc(j).lt.6.E-6 &
            3458     3                              .or. vts.lt.1.E-3) then
            3459     3   p   fv                t_Efsw(i,j) = 0.0
            3460     3   p   fv               else
            3461     3   p   fv                stokes = Dc(j)*Dc(j)*vts*rho_w/(9.*1.718E-5*Ds_m)
            3462     3   p   fv                reynolds = 9.*stokes/(p*p*rho_w)
            3463     3               
            3464     3   p   fv                F = DLOG(reynolds)
            3465     3   p   fv                G = -0.1007D0 - 0.358D0*F + 0.0261D0*F*F
            3466     3   p   fv                K0 = DEXP(G)
            3467     3   p   fv                z = DLOG(stokes/(K0+1.D-15))
            3468     3   p   fv                H = 0.1465D0 + 1.302D0*z - 0.607D0*z*z + 0.293D0*z*z*z
            3469     3   p   fv                yc0 = 2.0D0/PI * ATAN(H)
            3470     3   p   fv                Ef_sw = (yc0+p)*(yc0+p) / ((1.+p)*(1.+p))
            3471     3               
            3472     3   p   fv                t_Efsw(i,j) = MAX(0.0, MIN(SNGL(Ef_sw), 0.95))
            3473     3   p   fv               endif
            3474     2               
            3475     2   p   fv            enddo
            3476     1   p                 enddo
            3477                     
            3478                           end subroutine table_Efsw
            3479                     !
            3480                     !+---+-----------------------------------------------------------------+
            3481                     !..Integrate rain size distribution from zero to D-star to compute the
            3482                     !.. number of drops smaller than D-star that evaporate in a single
            3483                     !.. timestep.  Drops larger than D-star dont evaporate entirely so do
            3484                     !.. not affect number concentration.
            3485                     !+---+-----------------------------------------------------------------+
            3486                     
            3487                           subroutine table_dropEvap
            3488                     
            3489                           implicit none
            3490                     
            3491                     !..Local variables
            3492                           DOUBLE PRECISION:: Nt_r, N0, lam_exp, lam
            3493                           REAL:: xlimit_intg
            3494                           INTEGER:: i, j, k
            3495                     
            3496     1                     do k = 1, ntb_r
            3497     2                     do j = 1, ntb_r1
            3498     2                        lam_exp = (N0r_exp(j)*am_r*crg(1)/r_r(k))**ore1
            3499     2                        lam = lam_exp * (crg(3)*org2*org1)**obmr
            3500     2                        N0 = N0r_exp(j)/(crg(2)*lam_exp) * lam**cre(2)
            3501     2                        Nt_r = N0 * crg(2) / lam**cre(2)

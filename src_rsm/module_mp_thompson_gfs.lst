            1024                     !         'qr: ', qr_max, '(', imax_qr, ',', kmax_qr, ')', &
            1025                     !         'qi: ', qi_max, '(', imax_qi, ',', kmax_qi, ')', &
            1026                     !         'qs: ', qs_max, '(', imax_qs, ',', kmax_qs, ')', &
            1027                     !         'qg: ', qg_max, '(', imax_qg, ',', kmax_qg, ')', &

                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 9
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            3792     1  pp    v            do k = kts, kte
            3793     1   p    v               temp(k) = t1d(k)
            3794     1   p    v               qv(k) = MAX(1.E-10, qv1d(k))
            3795     1   p    v               pres(k) = p1d(k)
            3796     1   p    v               rho(k) = 0.622*pres(k)/(R*temp(k)*(qv(k)+0.622))
            3797     1   p    v               rhof(k) = SQRT(RHO_NOT/rho(k))
            3798     1   p    v               rc(k) = MAX(R1, qc1d(k)*rho(k))
            3799     2   p    v               if (qr1d(k) .gt. R1) then
            3800     2   p    v                  rr(k) = qr1d(k)*rho(k)
            3801     2   p    v                  nr(k) = MAX(R2, nr1d(k)*rho(k))
            3802     2   p    v                  lamr = (am_r*crg(3)*org2*nr(k)/rr(k))**obmr
            3803     2   p    v                  ilamr(k) = 1./lamr
            3804     2   p    v                  N0_r(k) = nr(k)*org2*lamr**cre(2)
            3805     2   p    v                  mvd_r(k) = (3.0 + mu_r + 0.672) * ilamr(k)
            3806     2   p    v                  L_qr(k) = .true.
            3807     2   p    v               else
            3808     2   p    v                  rr(k) = R1
            3809     2   p    v                  nr(k) = R1
            3810     2   p    v                  mvd_r(k) = 50.E-6
            3811     2   p    v                  L_qr(k) = .false.
            3812     2   p    v               endif
            3813     2   p    v               if (qs1d(k) .gt. R2) then
            3814     2   p    v                  rs(k) = qs1d(k)*rho(k)
            3815     2   p    v                  L_qs(k) = .true.
            3816     2   p    v               else
            3817     2   p    v                  rs(k) = R1
            3818     2   p    v                  L_qs(k) = .false.
            3819     2   p    v               endif
            3820     2   p    v               if (qg1d(k) .gt. R2) then
            3821     2   p    v                  rg(k) = qg1d(k)*rho(k)
            3822     2   p    v                  L_qg(k) = .true.
            3823     2   p    v               else
            3824     2   p    v                  rg(k) = R1
            3825     2   p    v                  L_qg(k) = .false.
            3826     2   p    v               endif
            3827     1   p    v            enddo
            3828                     
            3829                     !+---+-----------------------------------------------------------------+
            3830                     !..Calculate y-intercept, slope, and useful moments for snow.
            3831                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rs, temp, smo2, smob, smoc, smoz
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0

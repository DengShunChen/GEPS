             758                     !+---+-----------------------------------------------------------------+
             759                     !..This is a wrapper routine designed to transfer values from 3D to 1D.
             760                     !+---+-----------------------------------------------------------------+
             761                           SUBROUTINE mp_gt_driver(ims,ime,kms,kme,its,ite,kts,kte,        &
             762                     		              qv, qc, qr, qi, qs, qg, ni, nr,         &
             763                                                   tt, p, dz, dt_in,itimestep,             &
             764                                                   RAINNCV,                                &
             765                                                   SR,islmsk,                              &
             766                                                   refl_10cm,lradar,                       &
             767                                                   re_cloud, re_ice, re_snow,me,phii)
             768                     
             769                           implicit none
             770                     
             771                     !..Subroutine arguments
             772                     !     INTEGER, INTENT(IN):: ids,ide, kds,kde
             773                           INTEGER, INTENT(IN):: ims,ime, kms,kme, &
             774                                                 its,ite, kts,kte
             775                           REAL, DIMENSION(ims:ime, kms:kme), INTENT(INOUT)::                        &
             776                                               qv, qc, qr, qi, qs, qg, ni, nr, tt
             777                           REAL, DIMENSION(ims:ime, kms:kme), INTENT(INOUT)::                        &
             778                                               re_cloud, re_ice, re_snow
             779                           REAL, DIMENSION(ims:ime, kms:kme), INTENT(IN)::                           &
             780                                                p, dz
             781                           REAL, DIMENSION(ims:ime, kms:kme+1), INTENT(IN):: phii
             782                           INTEGER, DIMENSION(ims:ime), INTENT(IN):: islmsk !      land and ocean
             783                           REAL, DIMENSION(its:ite), INTENT(INOUT):: &
             784                                               RAINNCV, SR
             785                           REAL, DIMENSION(ims:ime, kms:kme), INTENT(INOUT)::                        &
             786                                               refl_10cm
             787                           REAL, INTENT(IN):: dt_in
             788                           INTEGER, INTENT(IN):: itimestep,me
             789                     
             790                     !..Local variables
             791                           REAL, DIMENSION(kts:kte):: &
             792                                               qv1d, qc1d, qi1d, qr1d, qs1d, qg1d, ni1d, &
             793                                               nr1d, t1d, p1d, dz1d, dBZ, nc1d
             794                           REAL, DIMENSION(kts:kte):: re_qc1d, re_qi1d, re_qs1d
             795                           REAL, DIMENSION(its:ite):: pcp_ra, pcp_sn, pcp_gr, pcp_ic
             796                           REAL:: dt, pptrain, pptsnow, pptgraul, pptice
             797                           REAL:: qc_max, qr_max, qs_max, qi_max, qg_max, ni_max, nr_max
             798                           INTEGER:: i, j, k
             799                           INTEGER:: imax_qc,imax_qr,imax_qi,imax_qs,imax_qg,imax_ni,imax_nr
             800                           INTEGER:: kmax_qc,kmax_qr,kmax_qi,kmax_qs,kmax_qg,kmax_ni,kmax_nr
             801                           INTEGER:: i_start, i_end
             802                           LOGICAL, INTENT(IN) :: lradar
             803                           real :: Nt_c
             804                     
             805                     !+---+
             806                     
             807                           i_start = its
             808                           i_end   = MIN(ite, ime)
             809                     
             810                     !..For idealized testing by developer.
             811                     !     if ( (ide-ids+1).gt.4 .and. (jde-jds+1).lt.4 .and.                &
             812                     !          ids.eq.its.and.ide.eq.ite.and.jds.eq.jts.and.jde.eq.jte) then
             813                     !        i_start = its + 2
             814                     !        i_end   = ite
             815                     !     endif
             816                     
             817                           dt = dt_in
             818                     
             819                           qc_max = 0.
             820                           qr_max = 0.
             821                           qs_max = 0.
             822                           qi_max = 0.
             823                           qg_max = 0
             824                           ni_max = 0.
             825                           nr_max = 0.
             826                           imax_qc = 0
             827                           imax_qr = 0
             828                           imax_qi = 0
             829                           imax_qs = 0
             830                           imax_qg = 0
             831                           imax_ni = 0
             832                           imax_nr = 0
             833                           kmax_qc = 0
             834                           kmax_qr = 0
             835                           kmax_qi = 0
             836                           kmax_qs = 0
             837                           kmax_qg = 0
             838                           kmax_ni = 0
             839                           kmax_nr = 0
             840                     !     do i = 1, 256
             841                     !        mp_debug(i:i) = char(0)
             842                     !     enddo
             843                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ, re_qs1d, re_qi1d, re_qc1d
                                   <<< Loop-information  End >>>
             844     1                     i_loop:  do i = i_start, i_end
             845     1               
             846     1                        pptrain = 0.
             847     1                        pptsnow = 0.
             848     1                        pptgraul = 0.
             849     1                        pptice = 0.
             850     1                        RAINNCV(i) = 0.
             851     1               !         IF ( PRESENT (snowncv) ) THEN
             852     1               !            SNOWNCV(i) = 0.
             853     1               !         ENDIF
             854     1               !         IF ( PRESENT (graupelncv) ) THEN

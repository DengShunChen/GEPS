            2892     2   p    v                 mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            2893     3   p    v                 if (mvd_r(k) .gt. 2.5E-3) then
            2894     3   p    v                    mvd_r(k) = 2.5E-3
            2895     3   p    v                 elseif (mvd_r(k) .lt. D0r*0.75) then
            2896     3   p    v                    mvd_r(k) = D0r*0.75
            2897     3   p    v                 endif
            2898     2   p    v                 lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2899     2   p    v                 nr1d(k) = crg(2)*org3*qr1d(k)*lamr**bm_r / am_r
            2900     2   p    v               endif
            2901     1   p    v               qs1d(k) = qs1d(k) + qsten(k)*DT
            2902     1   p    v               if (qs1d(k) .le. R1) qs1d(k) = 0.0

             489     1                     oams = 1./am_s
             490     1                     obms = 1./bm_s
             491     1                     ocms = oams**obms
             492     1               
             493     1                     cge(1) = bm_g + 1.
             494     1                     cge(2) = mu_g + 1.
             495     1                     cge(3) = bm_g + mu_g + 1.
             496     1                     cge(4) = bm_g*2. + mu_g + 1.
             497     1                     cge(5) = bm_g*2. + mu_g + bv_g + 1.
             498     1                     cge(6) = bm_g + mu_g + bv_g + 1.
             499     1                     cge(7) = bm_g + mu_g + bv_g + 2.
             500     1                     cge(8) = bm_g + mu_g + bv_g + 3.
             501     1                     cge(9) = mu_g + bv_g + 3.
             502     1                     cge(10) = mu_g + 2.
             503     1                     cge(11) = 0.5*(bv_g + 5. + 2.*mu_g)
             504     1                     cge(12) = 0.5*(bv_g + 5.) + mu_g
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FULL UNROLLING
                                   <<< Loop-information  End >>>
             505     2       f             do n = 1, 12
             506     2    i  f                cgg(n) = WGAMMA(cge(n))
             507     2       f             enddo
             508     1                     oamg = 1./am_g
             509     1                     obmg = 1./bm_g
             510     1                     ocmg = oamg**obmg
             511     1                     oge1 = 1./cge(1)
             512     1                     ogg1 = 1./cgg(1)
             513     1                     ogg2 = 1./cgg(2)
             514     1                     ogg3 = 1./cgg(3)
             515     1               
             516     1               !+---+-----------------------------------------------------------------+
             517     1               !..Simplify various rate eqns the best we can now.
             518     1               !+---+-----------------------------------------------------------------+
             519     1               
             520     1               !..Rain collecting cloud water and cloud ice
             521     1                     t1_qr_qc = PI*.25*av_r * crg(9)
             522     1                     t1_qr_qi = PI*.25*av_r * crg(9)
             523     1                     t2_qr_qi = PI*.25*am_r*av_r * crg(8)
             524     1               
             525     1               !..Graupel collecting cloud water
             526     1                     t1_qg_qc = PI*.25*av_g * cgg(9)
             527     1               
             528     1               !..Snow collecting cloud water
             529     1                     t1_qs_qc = PI*.25*av_s
             530     1               
             531     1               !..Snow collecting cloud ice
             532     1                     t1_qs_qi = PI*.25*av_s
             533     1               
             534     1               !..Evaporation of rain; ignore depositional growth of rain.
             535     1                     t1_qr_ev = 0.78 * crg(10)
             536     1                     t2_qr_ev = 0.308*Sc3*SQRT(av_r) * crg(11)
             537     1               
             538     1               !..Sublimation/depositional growth of snow
             539     1                     t1_qs_sd = 0.86
             540     1                     t2_qs_sd = 0.28*Sc3*SQRT(av_s)
             541     1               
             542     1               !..Melting of snow
             543     1                     t1_qs_me = PI*4.*C_sqrd*olfus * 0.86
             544     1                     t2_qs_me = PI*4.*C_sqrd*olfus * 0.28*Sc3*SQRT(av_s)
             545     1               
             546     1               !..Sublimation/depositional growth of graupel
             547     1                     t1_qg_sd = 0.86 * cgg(10)
             548     1                     t2_qg_sd = 0.28*Sc3*SQRT(av_g) * cgg(11)
             549     1               
             550     1               !..Melting of graupel
             551     1                     t1_qg_me = PI*4.*C_cube*olfus * 0.86 * cgg(10)
             552     1                     t2_qg_me = PI*4.*C_cube*olfus * 0.28*Sc3*SQRT(av_g) * cgg(11)
             553     1               
             554     1               !..Constants for helping find lookup table indexes.
             555     1                     nic2 = NINT(DLOG10(r_c(1)))
             556     1                     nii2 = NINT(DLOG10(r_i(1)))
             557     1                     nii3 = NINT(DLOG10(Nt_i(1)))
             558     1                     nir2 = NINT(DLOG10(r_r(1)))
             559     1                     nir3 = NINT(DLOG10(N0r_exp(1)))
             560     1                     nis2 = NINT(DLOG10(r_s(1)))
             561     1                     nig2 = NINT(DLOG10(r_g(1)))
             562     1                     nig3 = NINT(DLOG10(N0g_exp(1)))
             563     1               
             564     1               !..Create bins of cloud water (from min diameter up to 100 microns).
             565     1                     Dc(1) = D0c*1.0d0
             566     1                     dtc(1) = D0c*1.0d0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SOFTWARE PIPELINING(IPC: 0.66, ITR: 6, MVE: 2, POL: S)

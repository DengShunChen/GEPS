            2664     3   p    v                 t2_vts = Kap1*Mrat**mu_s*csg(10)*ils2**cse(10)
            2665     3   p    v                 ils1 = 1./(Mrat*Lam0)
            2666     3   p    v                 ils2 = 1./(Mrat*Lam1)
            2667     3   p    v                 t3_vts = Kap0*csg(1)*ils1**cse(1)
            2668     3   p    v                 t4_vts = Kap1*Mrat**mu_s*csg(7)*ils2**cse(7)
            2669     3   p    v                 vts = rhof(k)*av_s * (t1_vts+t2_vts)/(t3_vts+t4_vts)
            2670     4   p    v                 if (temp(k).gt. T_0) then
            2671     4   m    v                  vtsk(k) = MAX(vts*vts_boost(k), vtrk(k))
            2672     4   p    v                 else
            2673     4   m    v                  vtsk(k) = vts*vts_boost(k)
            2674     4   p    v                 endif
            2675     3   p    v                else
            2676     3   m    s                  vtsk(k) = vtsk(k+1)
            2677     3   p    v                endif

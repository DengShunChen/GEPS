                                   <<<      Dc, dtc
                                   <<< Loop-information  End >>>
             567     2   s   2s            do n = 2, nbc
             568     2   m   2m               Dc(n) = Dc(n-1) + 1.0D-6
             569     2   m   2v               dtc(n) = (Dc(n) - Dc(n-1))
             570     2   p   2v            enddo
             571     1               
             572     1               !..Create bins of cloud ice (from min diameter up to 5x min snow size).
             573     1                     xDx(1) = D0i*1.0d0
             574     1                     xDx(nbi+1) = 5.0d0*D0s
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 15
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

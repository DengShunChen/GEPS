            3739                     !..Compute radar reflectivity assuming 10 cm wavelength radar and using
            3740                     !.. Rayleigh approximation.  Only complication is melted snow/graupel
            3741                     !.. which we treat as water-coated ice spheres and use Uli Blahak's
            3742                     !.. library of routines.  The meltwater fraction is simply the amount
            3743                     !.. of frozen species remaining from what initially existed at the
            3744                     !.. melting level interface.
            3745                     !+---+-----------------------------------------------------------------+
            3746                     
            3747                           subroutine calc_refl10cm (qv1d, qc1d, qr1d, nr1d, qs1d, qg1d,     &
            3748                                               t1d, p1d, dBZ, kts, kte, ii)
            3749                     
            3750                           IMPLICIT NONE
            3751                     
            3752                     !..Sub arguments
            3753                           INTEGER, INTENT(IN):: kts, kte, ii
            3754                           REAL, DIMENSION(kts:kte), INTENT(IN)::                            &
            3755                                               qv1d, qc1d, qr1d, nr1d, qs1d, qg1d, t1d, p1d
            3756                           REAL, DIMENSION(kts:kte), INTENT(INOUT):: dBZ
            3757                     !     REAL, DIMENSION(kts:kte), INTENT(INOUT):: vt_dBZ
            3758                     
            3759                     !..Local variables
            3760                           REAL, DIMENSION(kts:kte):: temp, pres, qv, rho, rhof
            3761                           REAL, DIMENSION(kts:kte):: rc, rr, nr, rs, rg
            3762                     
            3763                           DOUBLE PRECISION, DIMENSION(kts:kte):: ilamr, ilamg, N0_r, N0_g
            3764                           REAL, DIMENSION(kts:kte):: mvd_r
            3765                           REAL, DIMENSION(kts:kte):: smob, smo2, smoc, smoz
            3766                           REAL:: oM3, M0, Mrat, slam1, slam2, xDs
            3767                           REAL:: ils1, ils2, t1_vts, t2_vts, t3_vts, t4_vts
            3768                           REAL:: vtr_dbz_wt, vts_dbz_wt, vtg_dbz_wt
            3769                     
            3770                           REAL, DIMENSION(kts:kte):: ze_rain, ze_snow, ze_graupel
            3771                     
            3772                           DOUBLE PRECISION:: N0_exp, N0_min, lam_exp, lamr, lamg
            3773                           REAL:: a_, b_, loga_, tc0
            3774                           DOUBLE PRECISION:: fmelt_s, fmelt_g
            3775                     
            3776                           INTEGER:: i, k, k_0, kbot, n
            3777                           LOGICAL:: melti
            3778                           LOGICAL, DIMENSION(kts:kte):: L_qr, L_qs, L_qg
            3779                     
            3780                           DOUBLE PRECISION:: cback, x, eta, f_d
            3781                           REAL:: xslw1, ygra1, zans1
            3782                     
            3783                     !+---+
            3784                     
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 1778
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dBZ
                                   <<< Loop-information  End >>>
            3785     1  pp   4v            do k = kts, kte
            3786     1   p   4v               dBZ(k) = -35.0
            3787     1   p   4v            enddo
            3788                     
            3789                     !+---+-----------------------------------------------------------------+
            3790                     !..Put column of data into local arrays.
            3791                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 19
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qg1d, qs1d, qr1d, p1d, pres, L_qg, L_qs
                                   <<<      L_qr, qv1d, t1d, qv, rho, rhof, qc1d, rc
                                   <<<      rr
                                   <<<    PREFETCH(SOFT) : 16
                                   <<<     SEQUENTIAL : 16
                                   <<<      mvd_r: 2, nr1d: 2, ilamr: 2, N0_r: 2
                                   <<<      nr: 2, rs: 2, rg: 2, temp: 2
                                   <<<    SPILLS :

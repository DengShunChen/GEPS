            2378     2  pp    v            do k = kts, kte
            2379     2   p    v               if (.not. L_qs(k)) CYCLE
            2380     2   p    v               tc0 = MIN(-0.1, temp(k)-273.15)
            2381     2   p    v               smob(k) = rs(k)*oams
            2382     2               
            2383     2               !..All other moments based on reference, 2nd moment.  If bm_s.ne.2,
            2384     2               !.. then we must compute actual 2nd moment and use as reference.
            2385     3   p    v               if (bm_s.gt.(2.0-1.e-3) .and. bm_s.lt.(2.0+1.e-3)) then
            2386     3   p    v                  smo2(k) = smob(k)
            2387     3                        else
            2388     3                           loga_ = sa(1) + sa(2)*tc0 + sa(3)*bm_s &
            2389     3                              + sa(4)*tc0*bm_s + sa(5)*tc0*tc0 &
            2390     3                              + sa(6)*bm_s*bm_s + sa(7)*tc0*tc0*bm_s &
            2391     3                              + sa(8)*tc0*bm_s*bm_s + sa(9)*tc0*tc0*tc0 &
            2392     3                              + sa(10)*bm_s*bm_s*bm_s
            2393     3                           a_ = 10.0**loga_
            2394     3                           b_ = sb(1) + sb(2)*tc0 + sb(3)*bm_s &
            2395     3                              + sb(4)*tc0*bm_s + sb(5)*tc0*tc0 &
            2396     3                              + sb(6)*bm_s*bm_s + sb(7)*tc0*tc0*bm_s &
            2397     3                              + sb(8)*tc0*bm_s*bm_s + sb(9)*tc0*tc0*tc0 &
            2398     3                              + sb(10)*bm_s*bm_s*bm_s
            2399     3                           smo2(k) = (smob(k)/a_)**(1./b_)
            2400     3   p    v               endif
            2401     2               
            2402     2               !..Calculate bm_s+1 (th) moment.  Useful for diameter calcs.
            2403     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(1) &
            2404     2                              + sa(4)*tc0*cse(1) + sa(5)*tc0*tc0 &
            2405     2                              + sa(6)*cse(1)*cse(1) + sa(7)*tc0*tc0*cse(1) &
            2406     2                              + sa(8)*tc0*cse(1)*cse(1) + sa(9)*tc0*tc0*tc0 &
            2407     2                              + sa(10)*cse(1)*cse(1)*cse(1)
            2408     2   p    v               a_ = 10.0**loga_
            2409     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(1) + sb(4)*tc0*cse(1) &
            2410     2                             + sb(5)*tc0*tc0 + sb(6)*cse(1)*cse(1) &
            2411     2                             + sb(7)*tc0*tc0*cse(1) + sb(8)*tc0*cse(1)*cse(1) &
            2412     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(1)*cse(1)*cse(1)
            2413     2   p    v               smoc(k) = a_ * smo2(k)**b_
            2414     2               
            2415     2               !..Calculate bm_s+bv_s (th) moment.  Useful for sedimentation.
            2416     2   p    v               loga_ = sa(1) + sa(2)*tc0 + sa(3)*cse(14) &
            2417     2                              + sa(4)*tc0*cse(14) + sa(5)*tc0*tc0 &
            2418     2                              + sa(6)*cse(14)*cse(14) + sa(7)*tc0*tc0*cse(14) &
            2419     2                              + sa(8)*tc0*cse(14)*cse(14) + sa(9)*tc0*tc0*tc0 &
            2420     2                              + sa(10)*cse(14)*cse(14)*cse(14)
            2421     2   p    v               a_ = 10.0**loga_
            2422     2   p    v               b_ = sb(1)+ sb(2)*tc0 + sb(3)*cse(14) + sb(4)*tc0*cse(14) &
            2423     2                             + sb(5)*tc0*tc0 + sb(6)*cse(14)*cse(14) &
            2424     2                             + sb(7)*tc0*tc0*cse(14) + sb(8)*tc0*cse(14)*cse(14) &
            2425     2                             + sb(9)*tc0*tc0*tc0 + sb(10)*cse(14)*cse(14)*cse(14)

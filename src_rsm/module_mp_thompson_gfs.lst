             382     1                     if (micro_init) then
             383     1               
             384     1               !..From Martin et al. (1994), assign gamma shape parameter mu for cloud
             385     1               !.. drops according to general dispersion characteristics (disp=~0.25
             386     1               !.. for Maritime and 0.45 for Continental).
             387     1               !.. disp=SQRT((mu+2)/(mu+1) - 1) so mu varies from 15 for Maritime
             388     1               !.. to 2 for really dirty air.
             389     1               !     mu_c = MIN(15., (1000.E6/Nt_c + 2.))
             390     1                     mu_co = MIN(15., (1000.E6/Nt_co + 2.))
             391     1                     mu_cl = MIN(15., (1000.E6/Nt_cl + 2.))
             392     1               
             393     1               !..Schmidt number to one-third used numerous times.
             394     1                     Sc3 = Sc**(1./3.)
             395     1               
             396     1               !..Compute min ice diam from mass, min snow/graupel mass from diam.
             397     1                     D0i = (xm0i/am_i)**(1./bm_i)
             398     1                     xm0s = am_s * D0s**bm_s
             399     1                     xm0g = am_g * D0g**bm_g
             400     1               
             401     1               !..These constants various exponents and gamma() assoc with cloud,
             402     1               !.. rain, snow, and graupel.
             403     1               !     cce(1) = mu_c + 1.
             404     1               !     cce(2) = bm_r + mu_c + 1.
             405     1               !     cce(3) = bm_r + mu_c + 4.
             406     1               !     ccg(1) = WGAMMA(cce(1))
             407     1               !     ccg(2) = WGAMMA(cce(2))
             408     1               !     ccg(3) = WGAMMA(cce(3))
             409     1               !     ocg1 = 1./ccg(1)
             410     1               !     ocg2 = 1./ccg(2)
             411     1                     cce(1,1) = mu_cl + 1.
             412     1                     cce(1,2) = mu_co + 1.
             413     1                     cce(2,1) = bm_r + mu_cl + 1.
             414     1                     cce(2,2) = bm_r + mu_co + 1.
             415     1                     cce(3,1) = bm_r + mu_cl + 4.
             416     1                     cce(3,2) = bm_r + mu_co + 4.
             417     1    i                ccg(1,1) = WGAMMA(cce(1,1))
             418     1    i                ccg(1,2) = WGAMMA(cce(1,2))
             419     1    i                ccg(2,1) = WGAMMA(cce(2,1))

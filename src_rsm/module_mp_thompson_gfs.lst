            2370     2   p                    endif
            2371     1   p                 enddo
            2372                     
            2373                     !+---+-----------------------------------------------------------------+
            2374                     !..With tendency-updated mixing ratios, recalculate snow moments and
            2375                     !.. intercepts/slopes of graupel and rain.
            2376                     !+---+-----------------------------------------------------------------+
            2377     1                     if (.not. iiwarm) then
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 11
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)

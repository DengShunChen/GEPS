             461     2                     enddo
             462     1                     obmr = 1./bm_r
             463     1                     ore1 = 1./cre(1)
             464     1                     org1 = 1./crg(1)
             465     1                     org2 = 1./crg(2)
             466     1                     org3 = 1./crg(3)
             467     1               
             468     1                     cse(1) = bm_s + 1.
             469     1                     cse(2) = bm_s + 2.
             470     1                     cse(3) = bm_s*2.
             471     1                     cse(4) = bm_s + bv_s + 1.
             472     1                     cse(5) = bm_s*2. + bv_s + 1.
             473     1                     cse(6) = bm_s*2. + 1.
             474     1                     cse(7) = bm_s + mu_s + 1.
             475     1                     cse(8) = bm_s + mu_s + 2.
             476     1                     cse(9) = bm_s + mu_s + 3.
             477     1                     cse(10) = bm_s + mu_s + bv_s + 1.
             478     1                     cse(11) = bm_s*2. + mu_s + bv_s + 1.
             479     1                     cse(12) = bm_s*2. + mu_s + 1.
             480     1                     cse(13) = bv_s + 2.
             481     1                     cse(14) = bm_s + bv_s
             482     1                     cse(15) = mu_s + 1.
             483     1                     cse(16) = 1.0 + (1.0 + bv_s)/2.
             484     1                     cse(17) = cse(16) + mu_s + 1.
             485     1                     cse(18) = bv_s + mu_s + 3.

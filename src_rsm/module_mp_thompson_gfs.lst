            2499     1  pp    v            do k = kts, kte
            2500     2   p    v               if ( (ssatw(k).lt. -eps) .and. L_qr(k) &
            2501     2                                    .and. (.not.(prw_vcd(k).gt. 0.)) ) then
            2502     2   p    v                tempc = temp(k) - 273.15

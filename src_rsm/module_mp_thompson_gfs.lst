                                   <<< Loop-information  End >>>
            2169     1  pp    v            do k = kts, kte
            2170     1   p    v               orho = 1./rho(k)
            2171     1   p    v               lfus2 = lsub - lvap(k)
            2172     1               
            2173     1               !..Water vapor tendency
            2174     1   p    v               qvten(k) = qvten(k) + (-pri_inu(k) - pri_ide(k) &
            2175     1                                     - prs_ide(k) - prs_sde(k) - prg_gde(k)) &
            2176     1                                     * orho
            2177     1               
            2178     1               !..Cloud water tendency
            2179     1   p    v               qcten(k) = qcten(k) + (-prr_wau(k) - pri_wfz(k) &
            2180     1                                     - prr_rcw(k) - prs_scw(k) - prg_scw(k) &
            2181     1                                     - prg_gcw(k)) &
            2182     1                                     * orho
            2183     1               
            2184     1               !..Cloud ice mixing ratio tendency
            2185     1   p    v               qiten(k) = qiten(k) + (pri_inu(k) + pri_ihm(k) &
            2186     1                                     + pri_wfz(k) + pri_rfz(k) + pri_ide(k) &
            2187     1                                     - prs_iau(k) - prs_sci(k) - pri_rci(k)) &
            2188     1                                     * orho
            2189     1               
            2190     1               !..Cloud ice number tendency.
            2191     1   p    v               niten(k) = niten(k) + (pni_inu(k) + pni_ihm(k) &
            2192     1                                     + pni_wfz(k) + pni_rfz(k) + pni_ide(k) &
            2193     1                                     - pni_iau(k) - pni_sci(k) - pni_rci(k)) &
            2194     1                                     * orho
            2195     1               
            2196     1               !..Cloud ice mass/number balance; keep mass-wt mean size between
            2197     1               !.. 20 and 300 microns.  Also no more than 250 xtals per liter.
            2198     1   p    v               xri=MAX(R1,(qi1d(k) + qiten(k)*dtsave)*rho(k))
            2199     1   p    v               xni=MAX(R2,(ni1d(k) + niten(k)*dtsave)*rho(k))
            2200     2   p    v               if (xri.gt. R1) then
            2201     2   p    v                 lami = (am_i*cig(2)*oig1*xni/xri)**obmi
            2202     2   p    v                 ilami = 1./lami
            2203     2   p    v                 xDi = (bm_i + mu_i + 1.) * ilami
            2204     3   p    v                 if (xDi.lt. 20.E-6) then
            2205     3   p    v                  lami = cie(2)/20.E-6
            2206     3   p    v                  xni = MIN(250.D3, cig(1)*oig2*xri/am_i*lami**bm_i)
            2207     3   p    v                  niten(k) = (xni-ni1d(k)*rho(k))*odts*orho
            2208     3   p    v                 elseif (xDi.gt. 300.E-6) then
            2209     3   p    v                  lami = cie(2)/300.E-6
            2210     3   p    v                  xni = cig(1)*oig2*xri/am_i*lami**bm_i
            2211     3   p    v                  niten(k) = (xni-ni1d(k)*rho(k))*odts*orho
            2212     3   p    v                 endif
            2213     2   p    v               else
            2214     2   p    v                niten(k) = -ni1d(k)*odts
            2215     2   p    v               endif
            2216     1   p    v               xni=MAX(0.,(ni1d(k) + niten(k)*dtsave)*rho(k))
            2217     1   p    v               if (xni.gt.250.E3) &
            2218     1                               niten(k) = (250.E3-ni1d(k)*rho(k))*odts*orho
            2219     1               
            2220     1               !..Rain tendency
            2221     1   p    v               qrten(k) = qrten(k) + (prr_wau(k) + prr_rcw(k) &
            2222     1                                     + prr_sml(k) + prr_gml(k) + prr_rcs(k) &
            2223     1                                     + prr_rcg(k) - prg_rfz(k) &
            2224     1                                     - pri_rfz(k) - prr_rci(k)) &
            2225     1                                     * orho
            2226     1               
            2227     1               !..Rain number tendency
            2228     1   p    v               nrten(k) = nrten(k) + (pnr_wau(k) + pnr_sml(k) + pnr_gml(k)    &
            2229     1                                     - (pnr_rfz(k) + pnr_rcr(k) + pnr_rcg(k)           &
            2230     1                                     + pnr_rcs(k) + pnr_rci(k)) )                      &
            2231     1                                     * orho
            2232     1               
            2233     1               !..Rain mass/number balance; keep median volume diameter between
            2234     1               !.. 37 microns (D0r*0.75) and 2.5 mm.
            2235     1   p    v               xrr=MAX(R1,(qr1d(k) + qrten(k)*dtsave)*rho(k))
            2236     1   p    v               xnr=MAX(R2,(nr1d(k) + nrten(k)*dtsave)*rho(k))
            2237     2   p    v               if (xrr.gt. R1) then
            2238     2   p    v                 lamr = (am_r*crg(3)*org2*xnr/xrr)**obmr
            2239     2   p    v                 mvd_r(k) = (3.0 + mu_r + 0.672) / lamr
            2240     3   p    v                 if (mvd_r(k) .gt. 2.5E-3) then
            2241     3   p    v                    mvd_r(k) = 2.5E-3
            2242     3   p    v                    lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2243     3   p    v                    xnr = crg(2)*org3*xrr*lamr**bm_r / am_r
            2244     3   p    v                    nrten(k) = (xnr-nr1d(k)*rho(k))*odts*orho
            2245     3   p    v                 elseif (mvd_r(k) .lt. D0r*0.75) then
            2246     3   p    v                    mvd_r(k) = D0r*0.75
            2247     3   p    v                    lamr = (3.0 + mu_r + 0.672) / mvd_r(k)
            2248     3   p    v                    xnr = crg(2)*org3*xrr*lamr**bm_r / am_r
            2249     3   p    v                    nrten(k) = (xnr-nr1d(k)*rho(k))*odts*orho
            2250     3   p    v                 endif
            2251     2   p    v               else
            2252     2   p    v                 qrten(k) = -qr1d(k)*odts
            2253     2   p    v                 nrten(k) = -nr1d(k)*odts
            2254     2   p    v               endif
            2255     1               
            2256     1               !..Snow tendency
            2257     1   p    v               qsten(k) = qsten(k) + (prs_iau(k) + prs_sde(k) &
            2258     1                                     + prs_sci(k) + prs_scw(k) + prs_rcs(k) &
            2259     1                                     + prs_ide(k) - prs_ihm(k) - prr_sml(k)) &
            2260     1                                     * orho
            2261     1               
            2262     1               !..Graupel tendency
            2263     1   p    v               qgten(k) = qgten(k) + (prg_scw(k) + prg_rfz(k) &
            2264     1                                     + prg_gde(k) + prg_rcg(k) + prg_gcw(k) &
            2265     1                                     + prg_rci(k) + prg_rcs(k) - prg_ihm(k) &
            2266     1                                     - prr_gml(k)) &
            2267     1                                     * orho
            2268     1               
            2269     1               !..Temperature tendency
            2270     2   p    v               if (temp(k).lt.T_0) then
            2271     2   p    v                tten(k) = tten(k) &
            2272     2                                   + ( lsub*ocp(k)*(pri_inu(k) + pri_ide(k) &
            2273     2                                                    + prs_ide(k) + prs_sde(k) &
            2274     2                                                    + prg_gde(k)) &
            2275     2                                    + lfus2*ocp(k)*(pri_wfz(k) + pri_rfz(k) &
            2276     2                                                    + prg_rfz(k) + prs_scw(k) &
            2277     2                                                    + prg_scw(k) + prg_gcw(k) &
            2278     2                                                    + prg_rcs(k) + prs_rcs(k) &
            2279     2                                                    + prr_rci(k) + prg_rcg(k)) &
            2280     2                                      )*orho * (1-IFDRY)
            2281     2   p    v               else
            2282     2   p    v                tten(k) = tten(k) &
            2283     2                                   + ( lfus*ocp(k)*(-prr_sml(k) - prr_gml(k) &
            2284     2                                                    - prr_rcg(k) - prr_rcs(k)) &
            2285     2                                     + lsub*ocp(k)*(prs_sde(k) + prg_gde(k)) &
            2286     2                                      )*orho * (1-IFDRY)
            2287     2   p    v               endif
            2288     1               
            2289     1   p    v            enddo
            2290                     
            2291                     !+---+-----------------------------------------------------------------+
            2292                     !..Update variables for TAU+1 before condensation & sedimention.
            2293                     !+---+-----------------------------------------------------------------+
                                   <<< Loop-information Start >>>
                                   <<<  [PARALLELIZATION]
                                   <<<    Standard iteration count: 38
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.14, ITR: 8, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      temp, tten, t1d, qvten, pres, qv1d, qv

            1017                     !         'qs: ', qs_max, '(', imax_qs, ',', kmax_qs, ')', &
            1018                     !         'qg: ', qg_max, '(', imax_qg, ',', kmax_qg, ')', &
            1019                     !         'ni: ', ni_max, '(', imax_ni, ',', kmax_ni, ')', &
            1020                     !         'nr: ', nr_max, '(', imax_nr, ',', kmax_nr, ')'
            1021                     !      CALL wrf_debug(150, mp_debug)
            1022                     !      write(*,'(a,7(a,e13.6,1x,a,i3,a,i3,a,1x))') 'MP-GT:',         &

                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             869     2  pp    v               do k = kts, kte
             870     2   p    v                  t1d(k) = tt(i,k)
             871     2   p    v                  p1d(k) = p(i,k)
             872     2   p    v                  dz1d (k) = (phii(i,k+1)-phii(i,k)) / g
             873     2               !           qv1d(k) = qv(i,k)
             874     2   p    v                  qv1d(k) = qv(i,k)/(1.-qv(i,k))
             875     2   p    v                  qc1d(k) = qc(i,k)
             876     2   p    v                  qi1d(k) = qi(i,k)
             877     2   p    v                  qr1d(k) = qr(i,k)
             878     2   p    v                  qs1d(k) = qs(i,k)

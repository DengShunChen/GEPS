            2864     1   p    v               t1d(k)  = t1d(k) + tten(k)*DT
            2865     1   p    v               qv1d(k) = MAX(1.E-10, qv1d(k) + qvten(k)*DT)
            2866     1   p    v               qc1d(k) = qc1d(k) + qcten(k)*DT
            2867     1   p    v               if (qc1d(k) .le. R1) qc1d(k) = 0.0
            2868     1   p    v               qi1d(k) = qi1d(k) + qiten(k)*DT
            2869     1   p    v               ni1d(k) = MAX(R2/rho(k), ni1d(k) + niten(k)*DT)
            2870     2   p    v               if (qi1d(k) .le. R1) then
            2871     2   p    v                 qi1d(k) = 0.0
            2872     2   p    v                 ni1d(k) = 0.0
            2873     2   p    v               else
            2874     2   p    v                 lami = (am_i*cig(2)*oig1*ni1d(k)/qi1d(k))**obmi
            2875     2   p    v                 ilami = 1./lami
            2876     2   p    v                 xDi = (bm_i + mu_i + 1.) * ilami
            2877     3   p    v                 if (xDi.lt. 20.E-6) then
            2878     3   p    v                  lami = cie(2)/20.E-6
            2879     3   p    v                 elseif (xDi.gt. 300.E-6) then
            2880     3   p    v                  lami = cie(2)/300.E-6
            2881     3   p    v                 endif
            2882     2   p    v                 ni1d(k) = MIN(cig(1)*oig2*qi1d(k)/am_i*lami**bm_i,           &
            2883     2                                        250.D3/rho(k))
            2884     2   p    v               endif
            2885     1   p    v               qr1d(k) = qr1d(k) + qrten(k)*DT
            2886     1   p    v               nr1d(k) = MAX(R2/rho(k), nr1d(k) + nrten(k)*DT)
            2887     2   p    v               if (qr1d(k) .le. R1) then

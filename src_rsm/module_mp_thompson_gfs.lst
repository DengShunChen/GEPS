                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xDx
                                   <<< Loop-information  End >>>
             575     2  pp    v            do n = 2, nbi
             576     2   p    v               xDx(n) = DEXP(DFLOAT(n-1)/DFLOAT(nbi) &
             577     2                                 *DLOG(xDx(nbi+1)/xDx(1)) +DLOG(xDx(1)))
             578     2   p    v            enddo

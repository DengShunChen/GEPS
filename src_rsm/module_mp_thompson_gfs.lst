            2504     2   p    v                rhof(k) = SQRT(RHO_NOT/rho(k))
            2505     2   p    v                rhof2(k) = SQRT(rhof(k))
            2506     2   p    v                diffu(k) = 2.11E-5*(temp(k)/273.15)**1.94 * (101325./pres(k))
            2507     3   p    v                if (tempc .ge. 0.0) then

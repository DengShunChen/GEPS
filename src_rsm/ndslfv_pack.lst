             106     1                             *(gglat(j+1)-gglat(j-1))*(gglat(j+1)-gglat(j)))
             107     1        v            enddo
             108                           ! over pole
             109                           fa1(2)=((gglati(2)-gglat(1))*(gglati(2)-gglat(2))           &
             110                                 *(gglati(2)-gglat(3)))/((-1.*gglat(1)-gglat(1))       &
             111                                 *(-1.*gglat(1)-gglat(2))*(-1.*gglat(1)-gglat(3)))
             112                           fa4(jm2)=fa1(2)
             113                     
             114                           fa2(2)=((gglati(2)+gglat(1))*(gglati(2)-gglat(2))           &

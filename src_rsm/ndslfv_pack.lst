 External subroutine subprogram "vertical_cell_ppm_intp"
  (inc)(line-no.)(nest)(optimize)
            1571                     !
            1572                     ! ------------------------------------------------------------------------
            1573                           subroutine vertical_cell_ppm_intp(pp,qq,pn,qn,levs,nvars,i)
            1574                     !
            1575                     ! mass conservation in vertical interpolation: interpolate a group
            1576                     ! of grid point  coordiante call pp at interface with quantity qq at
            1577                     ! cell averaged to a group of new grid point coordinate call pn at
            1578                     ! interface with quantity qn at cell average with ppm spline.
            1579                     ! in vertical with mass conservation is under the condition that
            1580                     ! pp(1)=pn(1), pp(levs+1)=pn(levs+1)
            1581                     !
            1582                     ! pp    pressure at interfac level as input
            1583                     ! qq    quantity at layer as input
            1584                     ! pn    pressure at interface of new grid structure as input
            1585                     ! qn    quantity at layer as output
            1586                     ! levs  numer of verical layers
            1587                     !
            1588                     ! author : henry.juang@noaa.gov
            1589                     !
            1590                           use const, only : RTYPE
            1591                     
            1592                           implicit none
            1593                     !
            1594                           real(kind=RTYPE)      pp(levs+1)
            1595                           real(kind=RTYPE)      qq(levs,nvars)
            1596                           real(kind=RTYPE)      pn(levs+1)
            1597                           real(kind=RTYPE)      qn(levs,nvars)
            1598                           integer   levs,nvars
            1599                     !
            1600                           real(kind=RTYPE)      massm,massc,massp,massbot,masstop
            1601                           real(kind=RTYPE)      qmi(levs,nvars),qpi(levs,nvars)
            1602                           real(kind=RTYPE)      dql(nvars),dqh(nvars)
            1603                           real(kind=RTYPE)      hh(levs)
            1604                           real(kind=RTYPE)      dqi,dqimax,dqimin,dqmono(levs,nvars)
            1605                           real(kind=RTYPE)      tl,tl2,tl3,tlp,tlm,tlc
            1606                           real(kind=RTYPE)      th,th2,th3,thp,thm,thc
            1607                           real(kind=RTYPE)      dpp,dqq,c1,c2
            1608                           integer   i,k, kl, kh, kk, kkl, kkh,n
            1609                           integer, parameter :: mono=1
            1610                     !
            1611     1                     if( pp(1).ne.pn(1) .or. pp(levs+1).ne.pn(levs+1) ) then
            1612     1                       print *,' Error in vertical_cell_ppm_intp for domain values '
            1613     1                       print *,' i pp1 pn1 ppt pnt ',i,                            &
            1614     1                               pp(1),pn(1),pp(levs+1),pn(levs+1)
            1615     1                       call abort
            1616     1                     endif
            1617                     !
            1618                     ! prepare thickness for grid
            1619                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.25, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, hh
                                   <<< Loop-information  End >>>
            1620     1       2v            do k=1,levs
            1621     1       2v              hh(k) = pp(k+1)-pp(k)
            1622     1       2v            enddo
            1623                     !
            1624                     ! prepare location with monotonic concerns
            1625                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, hh, dqmono, qmi, qpi
                                   <<< Loop-information  End >>>
            1626     1                     do n=1,nvars
            1627     1                       massbot=(3.*hh(1)+hh(2))*qq(1,n)-2.*hh(1)*qq(2,n)
            1628     1                       massm = massbot/(hh(1)+hh(2))
            1629     1                       massc = qq(1  ,n)
            1630     1                       massp = qq(1+1,n)
            1631     1                       dqi = 0.25*(massp-massm)
            1632     1                       dqimax = max(massm,massc,massp) - massc
            1633     1                       dqimin = massc - min(massm,massc,massp)
            1634     1                       dqmono(1,n) = sign( min( abs(dqi), dqimin, dqimax ), dqi)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.88, ITR: 80, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, dqmono
                                   <<< Loop-information  End >>>
            1635     2        v              do k=2,levs-1
            1636     2        v                massp = qq(k+1,n)
            1637     2        v                massc = qq(k  ,n)
            1638     2        v                massm = qq(k-1,n)
            1639     2        v                dqi = 0.25*(massp-massm)
            1640     2        v                dqimax = max(massm,massc,massp) - massc
            1641     2        v                dqimin = massc - min(massm,massc,massp)
            1642     2        v                dqmono(k,n) = sign( min( abs(dqi), dqimin, dqimax ), dqi)
            1643     2        v              enddo
            1644     1                       masstop=(3.*hh(levs)+hh(levs-1))*qq(levs,n)                  &
            1645     1                                  -2.*hh(levs)*qq(levs-1,n)
            1646     1                       massp = masstop/(hh(levs)+hh(levs-1))
            1647     1                       massc = qq(levs  ,n)
            1648     1                       massm = qq(levs-1,n)
            1649     1                       dqi = 0.25*(massp-massm)
            1650     1                       dqimax = max(massm,massc,massp) - massc
            1651     1                       dqimin = massc - min(massm,massc,massp)
            1652     1                       dqmono(levs,n) = sign( min( abs(dqi), dqimin, dqimax ), dqi)
            1653     1               !
            1654     1               ! compute value at interface with momotone
            1655     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.53, ITR: 24, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hh, qq, dqmono, qmi
                                   <<< Loop-information  End >>>
            1656     2        v              do k=2,levs
            1657     2        v                qmi(k,n)=(qq(k-1,n)*hh(k)+qq(k,n)*hh(k-1))/(hh(k)+hh(k-1)) &
            1658     2                            +(dqmono(k-1,n)-dqmono(k,n))/3.0
            1659     2        v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmi, qpi
                                   <<< Loop-information  End >>>
            1660     2       4v              do k=1,levs-1
            1661     2       4v                qpi(k,n)=qmi(k+1,n)
            1662     2       4v              enddo
            1663     1                       qmi(1,n)=qq(1,n)
            1664     1                       qpi(1,n)=qq(1,n)
            1665     1                       qmi(levs,n)=qq(levs,n)
            1666     1                       qpi(levs,n)=qq(levs,n)
            1667     1                     enddo
            1668                     !
            1669                     ! do monotonicity
            1670                     !
            1671     1                     if( mono.eq.1 ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, qpi, qmi
                                   <<< Loop-information  End >>>
            1672     2                       do n=1,nvars
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.87, ITR: 176, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qpi, qmi, qq
                                   <<< Loop-information  End >>>
            1673     3       2v              do k=1,levs
            1674     3       2v                c1=qpi(k,n)-qq(k,n)
            1675     3       2v                c2=qq(k,n)-qmi(k,n)
            1676     4       2v                if( c1*c2.le.0.0 ) then
            1677     4       2v                  qmi(k,n)=qq(k,n)
            1678     4       2v                  qpi(k,n)=qq(k,n)
            1679     4       2v                endif
            1680     3       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 88, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmi, qpi, qq
                                   <<< Loop-information  End >>>
            1681     3        v              do k=1,levs
            1682     3        v                c1=(qpi(k,n)-qmi(k,n))*(qq(k,n)-0.5*(qpi(k,n)+qmi(k,n)))
            1683     3        v                c2=(qpi(k,n)-qmi(k,n))*(qpi(k,n)-qmi(k,n))/6.
            1684     4        v                if( c1.gt.c2 ) then
            1685     4        v                  qmi(k,n)=3.*qq(k,n)-2.*qpi(k,n)
            1686     4        v                else if( c1.lt.-c2 ) then
            1687     4        v                  qpi(k,n)=3.*qq(k,n)-2.*qmi(k,n)
            1688     4        v                endif
            1689     3        v              enddo
            1690     2                       enddo
            1691     1                     endif
            1692                     !
            1693                     ! start interpolation by integral of ppm spline
            1694                     !
            1695                           kkl = 1
            1696                           tl=0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dql
                                   <<< Loop-information  End >>>
            1697     1       4v            do n=1,nvars
            1698     1       4v              dql(n)=0.0
            1699     1       4v            enddo
            1700                     
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dqh, dql, hh
                                   <<< Loop-information  End >>>
            1701     1                     do k=1,levs
            1702     1               
            1703     1                       kl = k
            1704     1                       kh = k + 1
            1705     1               ! find kkh
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp
                                   <<< Loop-information  End >>>
            1706     2                       do kk=kkl+1,levs+1
            1707     3                         if( pn(kh).ge.pp(kk) ) then
            1708     3                           kkh = kk-1
            1709     3                           go to 100
            1710     3                         endif
            1711     2                       enddo
            1712     1                       print *,' Error in vertical_cell_ppm_intp for no lev found '
            1713     1                       print *,' i kh kl ',i,kh,kl
            1714     1                       print *,' pn ',(pn(kk),kk=1,levs+1)
            1715     1                       print *,' pp ',(pp(kk),kk=1,levs+1)
            1716     1                       call abort
            1717     1                100    continue
            1718     1                       th=(pn(kh)-pp(kkh))/hh(kkh)
            1719     1                       th2=th*th
            1720     1                       th3=th2*th
            1721     1                       thp = th3-th2
            1722     1                       thm = th3-2.*th2+th
            1723     1                       thc = -2.*th3+3.*th2
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dqh
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 10
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1724     2       2v              do n=1,nvars
            1725     2       2v                dqh(n)=thp*qpi(kkh,n)+thm*qmi(kkh,n)+thc*qq(kkh,n)
            1726     2       2v              enddo
            1727     1               ! mass interpolate

             876                           subroutine cyclic_cell_plm_intp(pp,qq,pn,qn,lons,nv,lonp,lonn,sc)
             877                     !
             878                     ! linear quick version of cyclic cell interpolation
             879                     !
             880                     ! pp    location at interfac point as input
             881                     ! qq    quantity at averaged-cell as input
             882                     ! pn    location at interface of new grid structure as input
             883                     ! qn    quantity at averaged-cell as output
             884                     ! lons  numer of cells for dimension
             885                     ! lonp  numer of cells for input
             886                     ! lonn  numer of cells for output
             887                     ! sc    length of the entire circle
             888                     !
             889                     ! author : henry.juang@noaa.gov
             890                     !
             891                     !      use gfs_dyn_layout1
             892                     !
             893                           use const      , only : RTYPE
             894                     
             895                           implicit none
             896                     !
             897                           real(kind=RTYPE)      pp(lons+1)
             898                           real(kind=RTYPE)      qq(lons  ,nv)
             899                           real(kind=RTYPE)      pn(lons+1)
             900                           real(kind=RTYPE)      qn(lons  ,nv)
             901                           integer   lons,lonp,lonn,nv
             902                           real(kind=RTYPE)      sc
             903                     !
             904                           real(kind=RTYPE)      px(lonp+2),ps(lonp+2)
             905                           real(kind=RTYPE)      hfds(lonp+1),rdsi(lonp+1)
             906                           real(kind=RTYPE)      locs(lonp+lonn+3),dp(lonp+lonn+2),dt(lonp+lonn+2)
             907                           real(kind=RTYPE)      qc(0:lonp+2),dq(lonp+1),qmi(lonp+1),qpi(lonp+1)
             908                           real(kind=RTYPE)      vals(lonp+lonn+2)
             909                           real(kind=RTYPE)      rdd(lonn)
             910                           real(kind=RTYPE)      shift,hfsc,dd,check,ss
             911                           integer   js(lonn+1),ix4i(lonp+2),i4j(lonp+lonn+3)
             912                           integer   i,j,n,ip,ix,is,in
             913                     !
             914                           hfsc = 0.5 * sc
             915                     !
             916                     ! arrange input array cover output location with cyclic boundary
             917                     ! condition
             918                     !
             919                     ! bring input location close to output location
             920                     ! and cover output starting point.
             921     1                     if( pp(1).ne.pn(1) ) then
             922     2                       if( pp(1).gt.pn(1) ) then
             923     2                         shift = (int((pn(1)-pp(1))/sc)-1) * sc
             924     2                       else
             925     2                         shift =  int((pn(1)-pp(1))/sc) * sc
             926     2                       endif
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, px
                                   <<< Loop-information  End >>>
             927     2       2v              do i=1,lonp+1
             928     2       2v                px(i)=pp(i) + shift                   !bring pp to left of pn
             929     2       2v              enddo
             930     1                       px(lonp+2) = px(2) + sc
             931     2                       if( pn(1)-px(1) .lt. hfsc ) then        !search start point
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      px
                                   <<< Loop-information  End >>>
             932     3                         forward: do i=1,lonp+1
             933     4                           if( px(i).gt.pn(1) ) then
             934     4                             ix = i - 1
             935     4                             exit forward
             936     4                           endif
             937     3                         enddo forward
             938     2                       else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      px
                                   <<< Loop-information  End >>>
             939     3                         backward: do i=lonp,1,-1
             940     4                           if( px(i).le.pn(1) ) then
             941     4                             ix = i
             942     4                             exit backward
             943     4                           endif
             944     3                         enddo backward
             945     2                       endif
             946     1                       i = 0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 64, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      px, ix4i, ps
                                   <<< Loop-information  End >>>
             947     2       2v              do j=ix,lonp
             948     2       2v                i=i+1
             949     2       2v                ps(i) = px(j)
             950     2       2v                ix4i(i) = j
             951     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.33, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      px, ix4i, ps
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 1  FILL 1
                                   <<<      SIMD&FP   : SPILL 0  FILL 0
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
             952     2       2v              do j=1,ix-1
             953     2       2v                i=i+1
             954     2       2v                ps(i) = px(j) + sc
             955     2       2v                ix4i(i) = j
             956     2       2v              enddo
             957     1                       ps  (lonp+1) = ps(1) + sc
             958     1                       ix4i(lonp+1) = ix
             959     1                       ps  (lonp+2) = ps(2) + sc
             960     1                       ix4i(lonp+2) = ix+1
             961     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, ps
                                   <<< Loop-information  End >>>
             962     2       4v              do i=1,lonp+1
             963     2       4v                ps(i) = pp(i)
             964     2       4v              enddo
             965     1                       ps(lonp+2) = ps(2) + sc
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 16)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.75, ITR: 192, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ix4i
                                   <<< Loop-information  End >>>
             966     2       2v              do i=1,lonp
             967     2       2v                ix4i(i) = i
             968     2       2v              enddo
             969     1                       ix4i(lonp+1) = 1
             970     1                       ix4i(lonp+2) = 2
             971     1                     endif
             972                     
             973                           locs(1) = ps(1)
             974                           is=2
             975                           i4j(1)=1
             976                           in=1
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, pn, i4j
                                   <<< Loop-information  End >>>
             977     1       2s            do j=2,lonp+lonn+1
             978     2       2m              if( ps(is).lt.pn(in) ) then
             979     2       2s                locs(j) = ps(is)
             980     2       2m                is = is + 1
             981     2       2s              else
             982     2       2s                locs(j) = pn(in)
             983     2       2s                js(in) = j
             984     2       2m                in = in + 1
             985     2       2v              endif
             986     1       2s              i4j(j) = is - 1
             987     1       2v            enddo
             988                           locs(lonp+lonn+2) = pn(lonn+1)
             989                           js(lonn+1)        = lonp+lonn+2
             990                           i4j(lonp+lonn+2)  = lonp+1
             991                           locs(lonp+lonn+3) = ps(lonp+2)
             992                     !     if( is.gt.lonp+2) then
             993                     !        print *,' ================================================= '
             994                     !        print *,' --- last j and lonp+lonn+3 sc ',j,lonp+lonn+3,sc
             995                     !        print *,' locs ',(locs(j),j=lonp+lonn,lonp+lonn+3)
             996                     !        print *,' --- last is i4j ',is,i4j(lonp+lonn+2)
             997                     !        print *,' ps ',(ps(i),i=lonp,lonp+2)
             998                     !        print *,' --- last in js ',in,js(in-1)
             999                     !        print *,' pn ',(pn(i),i=lonn,lonn+1)
            1000                     !      endif
            1001                     !
            1002                     ! interpolation coefficient
            1003                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.75, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ps, hfds
                                   <<< Loop-information  End >>>
            1004     1       2v            do i=1,lonp+1
            1005     1       2v              hfds(i) = 0.5*(ps(i+1)-ps(i))
            1006     1       2v            enddo
            1007                           rdsi(1) = 1.0 / (hfds(1)+hfds(lonp))
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.36, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      hfds, rdsi
                                   <<< Loop-information  End >>>
            1008     1       2v            do i=2,lonp+1
            1009     1       2v              rdsi(i) = 1.0 / (hfds(i)+hfds(i-1))
            1010     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs, dp
                                   <<< Loop-information  End >>>
            1011     1                     do i=1,lonn
            1012     1                       dd = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.04, ITR: 192, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs, dp
                                   <<< Loop-information  End >>>
            1013     2       8v              do j=js(i),js(i+1)-1
            1014     2       8v                dp(j) = locs(j+1) - locs(j)
            1015     2       8v                dd    = dd    + dp(j)
            1016     2       8v              enddo
            1017     1                       rdd(i) = 1.0 / dd
            1018     1                     enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.18, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, locs, i4j, dt
                                   <<< Loop-information  End >>>
            1019     1       2v            do j=1,lonp+lonn+2
            1020     1       2v              i = i4j(j)
            1021     1       2v              dt(j) = (locs(j) + 0.5*dp(j)) - (ps(i) + hfds(i))
            1022     1       2v            enddo
            1023                     !
            1024                     ! start interpolation by integral of ppm
            1025                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ix4i, rdsi, qc, qmi, qpi, i4j, dt, dq
                                   <<<      vals
                                   <<< Loop-information  End >>>
            1026     1                     do n=1,nv
            1027     1               
            1028     1               
            1029     1                       qc(0) = qq(ix4i(lonp),n)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1030,1035)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 128, MVE: 6, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      rdsi, ix4i, qc, qmi
                                   <<< Loop-information  End >>>
            1030     2        v              do i=1,lonp+1
            1031     2        v                ix = ix4i(i)
            1032     2        v                qc(i) = qq(ix,n)
            1033     2        v              enddo
            1034     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1035     2                       do i=1,lonp+1
            1036     2                         qmi(i) = (qc(i)-qc(i-1))*rdsi(i)
            1037     2                       enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qmi, qpi
                                   <<< Loop-information  End >>>
            1038     2       4v              do i=1,lonp
            1039     2       4v                qpi(i) = qmi(i+1)
            1040     2       4v              enddo
            1041     1                       qpi(lonp+1) = qmi(2)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 128, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qpi, qmi, dq
                                   <<< Loop-information  End >>>
            1042     2       2v              do i=1,lonp+1
            1043     2       2v                check = qmi(i)*qpi(i)
            1044     3       2v                if( check.lt.0.0 ) then
            1045     3       2v                  dq(i) = 0.0
            1046     3       2v                else
            1047     3       2v                  dq(i)  = 0.5*(qmi(i)+qpi(i))
            1048     3       2v                endif
            1049     2       2v              enddo
            1050     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.42, ITR: 176, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      i4j, dt, vals
                                   <<< Loop-information  End >>>
            1051     2       2v              do j=1,lonp+lonn+2
            1052     2       2v                i = i4j(j)
            1053     2       2v                vals(j) = qc(i) + dq(i)*dt(j)
            1054     2       2v              enddo
            1055     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, vals
                                   <<< Loop-information  End >>>
            1056     2                       do i=1,lonn
            1057     2                         ss = 0.0
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 1.75, ITR: 192, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dp, vals
                                   <<< Loop-information  End >>>
            1058     3       8v                do j=js(i),js(i+1)-1
            1059     3       8v                  ss = ss + vals(j)*dp(j)
            1060     3       8v                enddo
            1061     2                         qn(i,n) = ss * rdd(i)
            1062     2                       enddo
            1063     1               
            1064     1                     enddo
            1065                     !
            1066                           return
            1067                           end subroutine cyclic_cell_plm_intp


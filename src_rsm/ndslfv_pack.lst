             760                     !
             761                     !-------------------------------------------------------------------------------
             762                           subroutine cyclic_cell_intpx(levs,imp,imf,qq)
             763                     !
             764                     ! do  mass conserving interpolation from different grid at given latitude
             765                     !
             766                     ! author: hann-ming henry juang 2008
             767                     !
             768                           use grid      , only : lonfull
             769                     !     use gfs_dyn_layout1
             770                           use const, only : RTYPE
             771                     
             772                           implicit none
             773                     !
             774                           integer	 levs, imp, imf
             775                           real(kind=RTYPE)	 qq(lonfull,levs)
             776                     !
             777                           real(kind=RTYPE)	old(lonfull,levs),new(lonfull,levs)
             778                           real(kind=RTYPE)	xpast(lonfull+1),xnext(lonfull+1)
             779                           real(kind=RTYPE)	two_pi,dxp,dxf,hfdxp,hfdxf,sc,pi
             780                     !
             781                           integer  	i,k,im
             782                     !
             783                           im = lonfull
             784                     
             785                     ! ..................................
             786     1                     if( imp.ne.imf ) then
             787     1               ! ..................................
             788     1                       pi  = 4.0 * atan(1.0)
             789     1                       two_pi = 2.0 * pi
             790     1                       dxp = two_pi / imp
             791     1                       dxf = two_pi / imf
             792     1                       hfdxp = 0.5 * dxp
             793     1                       hfdxf = 0.5 * dxf
             794     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xpast
                                   <<< Loop-information  End >>>
             795     2       2v              do i=1,imp+1
             796     2       2v                xpast(i) = (i-1) * dxp - hfdxp
             797     2       2v              enddo
             798     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      xnext
                                   <<< Loop-information  End >>>
             799     2       2v              do i=1,imf+1
             800     2       2v                xnext(i) = (i-1) * dxf - hfdxf
             801     2       2v              enddo
             802     1               
             803     1                       sc=two_pi
             804     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, old
                                   <<< Loop-information  End >>>
             805     1       4v              old(1:imp,1:levs)=qq(1:imp,1:levs)
             806     1                       call cyclic_cell_ppm_intp(xpast,old,xnext,new,im,levs,imp,imf,sc)
             807     1               !        call cyclic_cell_plm_intp(xpast,old,xnext,new,im,levs,imp,imf,sc)
             808     1               
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.00, ITR: 160, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      new, qq
                                   <<< Loop-information  End >>>
             809     1       4v              qq(1:imf,1:levs)=new(1:imf,1:levs)
             810     1               
             811     1               ! .................
             812     1                     endif
             813                     ! .................
             814                     
             815                           return
             816                           end subroutine cyclic_cell_intpx


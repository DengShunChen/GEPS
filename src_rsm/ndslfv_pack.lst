 External subroutine subprogram "cyclic_cell_massadvy"
  (inc)(line-no.)(nest)(optimize)
             416                     !
             417                     !
             418                     !-------------------------------------------------------------------
             419                           subroutine cyclic_cell_massadvy(jm,lev,nvars,delt,vc,qq,mass)
             420                     !
             421                     ! compute local positive advection with mass conserving
             422                     ! qq will be advect by vc from past to next location with 2*delt
             423                     !
             424                     ! author: hann-ming henry juang 2007
             425                     !
             426                     !
             427                           use grid     , only : gglati,fa1,fa2,fa3,fa4
             428                     !
             429                           use const, only : RTYPE
             430                     
             431                           implicit none
             432                     !
             433                           integer   jm,lev,nvars,mass
             434                           real(kind=RTYPE)      delt
             435                           real(kind=RTYPE)      vc(jm,lev)
             436                           real(kind=RTYPE)      qq(jm,lev,nvars)
             437                     !
             438                           real(kind=RTYPE)      var(jm)
             439                           real(kind=RTYPE)      past(jm,nvars),da(jm,nvars),next(jm,nvars)
             440                           real(kind=RTYPE)      dyfact(jm)
             441                           real(kind=RTYPE)      ypast(jm+1),ynext(jm+1)
             442                           real(kind=RTYPE)      dist (jm+1), ds(jm), step(10), dist_step
             443                           real(kind=RTYPE)      sc
             444                     
             445                           integer   n,k,j,jmh,nv,nst,nstep
             446                     !
             447                     ! preparations ---------------------------
             448                     !
             449                           jmh  = jm / 2
             450                           sc = gglati(jm+1)-gglati(1)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gglati, ds
                                   <<< Loop-information  End >>>
             451     1       2v            do j=1,jm
             452     1       2v              ds(j) = gglati(j+1) - gglati(j)
             453     1       2v            enddo
             454                           nv   = nvars
             455                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var, fa1, fa3, fa2, fa4, dist
                                   <<< Loop-information  End >>>
             456     1                     do k=1,lev
             457     1               !

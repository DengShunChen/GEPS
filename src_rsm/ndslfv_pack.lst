             633                           subroutine fixend_cell_massadvy(jm,jmh,levs,nvars,delt,vc,qq,mass)
             634                     !
             635                     ! compute local positive advection with mass conserving
             636                     ! qq will be advect by vc from past to next location with 2*delt
             637                     !
             638                     ! author: hann-ming henry juang 2007
             639                     !
             640                           use grid     , only : gslati
             641                     !      use gfs_dyn_layout1
             642                     !
             643                           use const, only : RTYPE
             644                     
             645                           implicit none
             646                     !
             647                           integer   jm,jmh,levs,nvars,mass
             648                           real(kind=RTYPE)	delt
             649                           real(kind=RTYPE)	vc(jm,levs)
             650                           real(kind=RTYPE)	qq(jm,levs,nvars)
             651                     !
             652                           real(kind=RTYPE)	var(jmh)
             653                           real(kind=RTYPE)	past(jmh,nvars),da(jmh,nvars),next(jmh,nvars)
             654                           real(kind=RTYPE)	dyfact(jmh)
             655                           real(kind=RTYPE)	ypast(jmh+1),ynext(jmh+1)
             656                           real(kind=RTYPE)	dist (jmh+1), ds(jmh)
             657                           real(kind=RTYPE)	step(10), dist_step
             658                           real(kind=RTYPE) 	hfpi,pi
             659                           real(kind=RTYPE), parameter :: fa1 = 9./16.
             660                           real(kind=RTYPE), parameter :: fa2 = 1./16.
             661                     
             662                           integer  	n,k,j,nv,nst,nstep
             663                     !
             664                     ! preparations ---------------------------
             665                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.50, ITR: 144, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      gslati, ds
                                   <<< Loop-information  End >>>
             666     1       2v            do j=1,jmh
             667     1       2v              ds(j) = gslati(j+1) - gslati(j)
             668     1       2v            enddo
             669                           pi = 4.0 * atan(1.0)
             670                           hfpi = pi * 0.5
             671                           nv   = nvars
             672                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, ds, var, dist
                                   <<< Loop-information  End >>>
             673     1                     do k=1,levs
             674     1               !
             675     1               ! first hemisphere
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.66, ITR: 192, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      vc, var
                                   <<< Loop-information  End >>>
             676     2       2v              do j=1,jmh
             677     2       2v                var(j)     = vc(j    ,k) * delt
             678     2       2v              enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.60, ITR: 48, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      ds, var, dist
                                   <<< Loop-information  End >>>
             679     2       2v              do j=2,jmh
             680     2       2v                dist(j)=(var(j)*ds(j-1)+var(j-1)*ds(j)) / (ds(j-1)+ds(j))
             681     2       2v              enddo
             682     1                       dist(1)=0.0
             683     1                       dist(jmh+1)=0.0
             684     1               !cflx   call def_cfl_max (jmh+1,dist,ds,nstep)
             685     1                       call def_cfl_step(jmh+1,dist,ds,step,nstep,levs+1-k,'advy')
             686     1               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, gslati, ypast, ynext, dyfact
                                   <<< Loop-information  End >>>
             687     2                       do nst = 1, nstep
             688     2               !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.16, ITR: 128, MVE: 4, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      dist, gslati, ypast, ynext
                                   <<< Loop-information  End >>>
             689     3       2v              do j=1,jmh+1
             690     3       2v                dist_step = dist(j)*step(nst)
             691     3       2v                ypast(j) = gslati(j) - dist_step
             692     3       2v                ynext(j) = gslati(j) + dist_step
             693     3       2v              enddo

            1841     2       4v              do i=1,im
            1842     2       4v                fmin=min(fmin,a(i,k))
            1843     2       4v                fmax=max(fmax,a(i,k))
            1844     2       4v              enddo
            1845     1                       print *,' max=',fmax,' min=',fmin,' at k=',k,' for ',ch
            1846     1                     enddo

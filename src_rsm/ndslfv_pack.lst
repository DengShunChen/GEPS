            1282                           subroutine cyclic_cell_ppm_intp(pp,qq,pn,qn,lons,nv,lonp,lonn,sc)
            1283                     !
            1284                     ! mass conservation in cyclic bc interpolation: interpolate a group
            1285                     ! of grid point  coordiante call pp at interface with quantity qq at
            1286                     ! cell averaged to a group of new grid point coordinate call pn at
            1287                     ! interface with quantity qn at cell average with ppm spline.
            1288                     ! in horizontal with mass conservation is under the condition that
            1289                     ! variable value at pp(1)= pp(lons+1)=pn(lons+1)
            1290                     !
            1291                     ! pp    location at interfac point as input
            1292                     ! qq    quantity at averaged-cell as input
            1293                     ! pn    location at interface of new grid structure as input
            1294                     ! qn    quantity at averaged-cell as output
            1295                     ! lons  numer of cells for dimension
            1296                     ! lonp  numer of cells for input
            1297                     ! lonn  numer of cells for output
            1298                     ! levs  number of vertical layers
            1299                     ! mono  monotonicity o:no, 1:yes
            1300                     !
            1301                     ! author : henry.juang@noaa.gov
            1302                     !
            1303                     !
            1304                           use const, only : RTYPE
            1305                           implicit none
            1306                     !
            1307                           real(kind=RTYPE)      pp(lons+1)

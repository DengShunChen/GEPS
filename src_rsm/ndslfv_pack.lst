                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a
                                   <<< Loop-information  End >>>
            1838     1                     do k=1,kx
            1839     1                       fmin=a(1,k)
            1840     1                       fmax=a(1,k)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 0.93, ITR: 96, MVE: 2, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      a

            1192                           subroutine vertical_cell_advect(lons,londim,levs,nvars,           &
            1193                                                           deltim,ssi,wwi,qql,mass)
            1194                     !
            1195                           use const, only : RTYPE
            1196                     
            1197                           implicit none
            1198                     
            1199                           integer 	londim,levs,nvars,lons,mass
            1200                           real(kind=RTYPE) 	deltim
            1201                           real(kind=RTYPE)	ssi(londim,levs+1)
            1202                           real(kind=RTYPE)	wwi(londim,levs+1)
            1203                           real(kind=RTYPE)	qql(londim,levs,nvars)
            1204                     
            1205                           real(kind=RTYPE) ssii(levs+1)

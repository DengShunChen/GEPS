 External subroutine subprogram "cyclic_cell_ppm_intp_dp"
  (inc)(line-no.)(nest)(optimize)
            1897                     
            1898                     !-------------------------------------------------------------------------
            1899                     !CWB2021 note, the double precision is called by reducepick/reduceintp
            1900                     !-------------------------------------------------------------------------
            1901                           subroutine cyclic_cell_ppm_intp_dp(pp,qq,pn,qn,lons,nv,lonp,lonn,sc)
            1902                     !
            1903                     ! mass conservation in cyclic bc interpolation: interpolate a group
            1904                     ! of grid point  coordiante call pp at interface with quantity qq at
            1905                     ! cell averaged to a group of new grid point coordinate call pn at
            1906                     ! interface with quantity qn at cell average with ppm spline.
            1907                     ! in horizontal with mass conservation is under the condition that
            1908                     ! variable value at pp(1)= pp(lons+1)=pn(lons+1)
            1909                     !
            1910                     ! pp    location at interfac point as input
            1911                     ! qq    quantity at averaged-cell as input
            1912                     ! pn    location at interface of new grid structure as input
            1913                     ! qn    quantity at averaged-cell as output
            1914                     ! lons  numer of cells for dimension
            1915                     ! lonp  numer of cells for input
            1916                     ! lonn  numer of cells for output
            1917                     ! levs  number of vertical layers
            1918                     ! mono  monotonicity o:no, 1:yes
            1919                     !
            1920                     ! author : henry.juang@noaa.gov
            1921                     !
            1922                     !
            1923                           implicit none
            1924                     !
            1925                           real      pp(lons+1)
            1926                           real      qq(lons  ,nv)
            1927                           real      pn(lons+1)
            1928                           real      qn(lons  ,nv)
            1929                           integer   lons,lonp,lonn,nv
            1930                           real      sc
            1931                     !
            1932                           real      locs  (3*lonp)
            1933                           real      mass  (3*lonp,nv)
            1934                           real      hh    (3*lonp)
            1935                           real      fm    (3*lonp)
            1936                           real      fn    (3*lonp)
            1937                           real      dqmono(3*lonp,nv)
            1938                           real      qmi   (3*lonp,nv)
            1939                           real      qpi   (3*lonp,nv)
            1940                           real      cyclic_length
            1941                           integer   ik,le,kstr,kend
            1942                           real      pnmin,pnmax,locbndmin,locbndmax
            1943                           real      dqi,dqimax,dqimin
            1944                           real      tl,tl2,tl3,qql,tlp,tlm,tlc
            1945                           real      th,th2,th3,qqh,thp,thm,thc
            1946                           real      dql(nv),dqh(nv)
            1947                           real      dpp,dqq,c1,c2,cc,r3,r6
            1948                           integer   i,k, kl, kh, kk, kkl, kkh, n
            1949                           integer, parameter :: mono=1
            1950                     !
            1951                     !     cyclic_length = pp(lonp+1) - pp(1)
            1952                           cyclic_length = sc
            1953                     !
            1954                     ! arrange input array cover output location with cyclic boundary
            1955                     ! condition
            1956                     !
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pp, locs
                                   <<< Loop-information  End >>>
            1957             2v            locs(lonp+1:2*lonp) = pp(1:lonp)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<< Loop-information  End >>>
            1958     1       2v            do i=1,lonp
            1959     1       2v              locs(i) = locs(i+lonp) - cyclic_length
            1960     1       2v              locs(i+2*lonp) = locs(i+lonp) + cyclic_length
            1961     1       2v            enddo
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED(lines: 1962,1963)
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 2.60, ITR: 96, MVE: 3, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, mass
                                   <<< Loop-information  End >>>
            1962             2v            mass(1       :  lonp,1:nv) = qq(1:lonp,1:nv)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    FUSED
                                   <<< Loop-information  End >>>
            1963                           mass(1+  lonp:2*lonp,1:nv) = qq(1:lonp,1:nv)
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 144, MVE: 5, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      qq, mass
                                   <<< Loop-information  End >>>
            1964             2v            mass(1+2*lonp:3*lonp,1:nv) = qq(1:lonp,1:nv)
            1965                     
            1966                           pnmin = pn(1)
            1967                           pnmax = pn(lonn+1)
            1968                     !!    do i=2,lonn
            1969                     !!      pnmin = min( pnmin, pn(i) )
            1970                     !!      pnmax = max( pnmax, pn(i) )
            1971                     !!    enddo
            1972                     
            1973                           locbndmin=locs(  lonp+4)
            1974                           locbndmax=locs(2*lonp-4)
            1975     1                     if( pnmin.lt.locbndmin-sc ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pn
                                   <<< Loop-information  End >>>
            1976     2       2v              do i=1,lonn+1
            1977     2       2v                pn(i)=pn(i)+int((locbndmin-pnmin)/sc)*sc
            1978     2       2v              enddo
            1979     1                     else if( pnmin.gt.locbndmax ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    SIMD(VL: 8)
                                   <<<    SOFTWARE PIPELINING(IPC: 3.00, ITR: 256, MVE: 9, POL: S)
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      pn
                                   <<< Loop-information  End >>>
            1980     2       2v              do i=1,lonn+1
            1981     2       2v                pn(i)=pn(i)+(int((locbndmax-pnmin)/sc)-1)*sc
            1982     2       2v              enddo
            1983     1                     endif
            1984                     
            1985                           pnmin = pn(1)
            1986                           pnmax = pn(lonn+1)
            1987                     !!    do i=2,lonn
            1988                     !!      pnmin = min( pnmin, pn(i) )
            1989                     !!      pnmax = max( pnmax, pn(i) )
            1990                     !!    enddo
            1991                     
            1992     1                     if( pnmin.lt.locs(lonp+1) ) then
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<<    SPILLS :
                                   <<<      GENERAL   : SPILL 0  FILL 0
                                   <<<      SIMD&FP   : SPILL 0  FILL 2
                                   <<<      SCALABLE  : SPILL 0  FILL 0
                                   <<<      PREDICATE : SPILL 0  FILL 0
                                   <<< Loop-information  End >>>
            1993     2                       do i=lonp,1,-1
            1994     3                         if( pnmin.ge.locs(i) .and. pnmin.lt.locs(i+1) ) then
            1995     3                           kstr = i
            1996     3                           go to 10
            1997     3                         endif
            1998     2                       enddo
            1999     1                     else
                                   <<< Loop-information Start >>>
                                   <<<  [OPTIMIZATION]
                                   <<<    PREFETCH(HARD) Expected by compiler :
                                   <<<      locs
                                   <<<    SPILLS :
